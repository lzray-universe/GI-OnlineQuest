]},{"nodeId":710501402,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1848826074,"text":"You've done me a big favor the past few days. I really don't know how I can repay you.","nextNodeIds":[710501403]},{"nodeId":710501403,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3551534170,"text":"Considering our amiable collaboration so far, it wouldn't be enough to pay you with Mora.","nextNodeIds":[710501404]},{"nodeId":710501404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":539199658,"text":"Actually, if you insist...","nextNodeIds":[710501405]},{"nodeId":710501405,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":308594506,"text":"Be serious! Am I so vulgar as to humiliate you with mere gold?","nextNodeIds":[710501406]},{"nodeId":710501406,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":861842682,"text":"Wouldn't that be a sheer insult to you?","nextNodeIds":[710501407]},{"nodeId":710501407,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":51790610,"text":"Here, take this letter. If you ever run into any trouble or need some help in your future journey in Sumeru, bring it to the House of Purbiruni.","nextNodeIds":[710501408]},{"nodeId":710501408,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3938436682,"text":"We'll spare no effort in helping you.","nextNodeIds":[710501409]},{"nodeId":710501409,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":923783002,"text":"\"Connections are far more precious than gold.\"","nextNodeIds":[710501410]},{"nodeId":710501410,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":4087555754,"text":"This Sumeru saying rings quite true.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7105014,0],"PAINLIBBLDK":"QU