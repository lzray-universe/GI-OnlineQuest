2,"showRandomTalkCount":0},"dialogs":[{"nodeId":220420401,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":95024618,"text":"You have returned. It is strange. Those children suddenly all came back, and they looked mighty frightened, too.","nextNodeIds":[220420402]},{"nodeId":220420402,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1946639602,"text":"Did they meet some hairy churls outside, the ones with the sticks?","nextNodeIds":[220420403]},{"nodeId":220420403,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3461032090,"text":"Still, they did come back... Wait, what is the matter with you?","nextNodeIds":[220420404]},{"nodeId":220420404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1347796282,"text":"Uh, actually, I...","nextNodeIds":[220420405]},{"nodeId":220420405,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":4217052354,"text":"...You... unfathomable human! What possessed you to do that?","nextNodeIds":[220420406]},{"nodeId":220420406,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1984588026,"text":"You could simply have played with these children the normal way...","nextNodeIds":[220420407]},{"nodeId":220420407,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3687866930,"text":"Meow! No wonder they were so frightened... You must go and comfort them.","nextNodeIds":[220420408]},{"nodeId":220420408,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2346601218,"text":"Really, now. I suppose it was a bit much to ask for all humans to be like Hibiki...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2204203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[2204204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"trigger