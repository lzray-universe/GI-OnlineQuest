{"mainQuestId":70542,"title":"","description":"","titleTextMapHash":3799081631,"descTextMapHash":3530296630,"mainQuestExcel":{"mainQuestId":70542,"titleTextMapHash":3799081631,"title":"","descTextMapHash":3530296630,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":5183,"luaPath":"Actor/Quest/WQ70542","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5183,"chapterId":0,"descTextMapHash":3530296630,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70542,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":597699953,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70542","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3799081631,"type":"WQ","unlockDescTextMapHash":738948270}},"flow":[{"subQuestId":7054201,"order":1,"stepDescription":"","stepDescTextMapHash":43114236,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7054201],"talks":[{"talkId":7054201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7054201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7054201,"initDialog":705420101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30521],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7054201","priority":5,"questId":70542,"showRandomTalkCount":0},"dialogs":[{"nodeId":705420101,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":4078852074,"text":"Me... Meow?","nextNodeIds":[705420102]},{"nodeId":705420102,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":2120843994,"text":"Is this really how cats greet one another? I wonder if my pronunciation's on point...?","nextNodeIds":[705420103]},{"nodeId":705420103,"roleType":"TALK_ROLE_NPC","speakerId":30525,"speakerName":"Snowball","textMapHash":3974004354,"text":"Meow?","nextNodeIds":[705420104]},{"nodeId":705420104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":525811330,"text":"Looks like \"Snowball\" didn't understand even a whisker.","nextNodeIds":[705420105]},{"nodeId":705420105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4123295922,"text":"Mona, are you trying to speak \"Cat\"...?","nextNodeIds":[705420106,705420107]},{"nodeId":705420106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3905039834,"text":"Professor Megistus, that is not how you pronounce it.","nextNodeIds":[705420108]},{"nodeId":705420108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":246237874,"text":"Hey! \"Rawr\" sounds more like tigers or lions! That's a good way to frighten a kitty and turn it into a scaredy-cat!","nextNodeIds":[705420109]},{"nodeId":705420109,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":1475730226,"text":"#{NICKNAME}, Paimon! So the rumors were true — you really are working at the Furball Fortress!","nextNodeIds":[705420110]},{"nodeId":705420110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3785909522,"text":"\"Working\" probably isn't the right word. We're helping Valerina and Rosaria out, so we're more like... consultants!","nextNodeIds":[705420111]},{"nodeId":705420111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":95102250,"text":"Yeah, that's it! Being called a \"consultant\" sounds really impressive, hehe!","nextNodeIds":[705420112]},{"nodeId":705420112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2261956770,"text":"By the way, Great Astrologer Mona, are you looking to adopt a cat to assist you in your astronomical observations?","nextNodeIds":[705420113]},{"nodeId":705420113,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":66225218,"text":"Based on my understanding of astrology, it shouldn't be too hard to teach a cat to read the various aspects of the stars. I might even... teach one to help me write manuscripts...?","nextNodeIds":[705420114]},{"nodeId":705420114,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":4070042002,"text":"(Steals a peek at Snowball)","nextNodeIds":[705420115]},{"nodeId":705420115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3158385450,"text":"(Boldly stares straight at Snowball)","nextNodeIds":[705420116]},{"nodeId":705420116,"roleType":"TALK_ROLE_NPC","speakerId":30525,"speakerName":"Snowball","textMapHash":2001186842,"text":"Meow!","nextNodeIds":[705420117]},{"nodeId":705420117,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":1855838082,"text":"*cough* On second thought, maybe not. One who can only read the stars but is ill-versed at stringing words together would not suffice to convey my illuminating insights.","nextNodeIds":[705420118]},{"nodeId":705420118,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":1411896098,"text":"If I really needed an assistant, it would be better to just take a trip to Fontaine and recruit some staff member from The Steambird or find a Melusine who can use a typewriter and bring them back to Mondstadt...","nextNodeIds":[705420119]},{"nodeId":705420119,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":1202286482,"text":"Were I to really adopt a cat, at most it would be to play with it a bit, to relax and relieve the stress from the exhaustion of academic inquiry.","nextNodeIds":[705420120]},{"nodeId":705420120,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":6483050,"text":"One mustn't be a bad owner. When you get tired, it would be best if the cat is tired enough for a cat nap as well.","nextNodeIds":[705420121]},{"nodeId":705420121,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":2895518826,"text":"Before I set foot in here, I never imagined hanging out with cats would be such a joy... Ah, how wonderful life would be if we could always be happy like this!","nextNodeIds":[705420122]},{"nodeId":705420122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":882544850,"text":"Hehe, looks like you're going to be a really conscientious owner! Guess this cat's gonna be in fine hands!","nextNodeIds":[705420123]},{"nodeId":705420123,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":3663348906,"text":"But I've also heard that some cats can be quite rambunctious. Always jumping around, biting, and clawing the furniture...","nextNodeIds":[705420124]},{"nodeId":705420124,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":842687770,"text":"Imagine my manuscripts or astrology tomes, ruined by feline canines — that'd be troublesome indeed!","nextNodeIds":[705420125]},{"nodeId":705420125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3829389506,"text":"Making a snack out of precious books... Paimon can barely imagine something so terrifying!","nextNodeIds":[705420126]},{"nodeId":705420126,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":2992422234,"text":"\"Snowball\" looks quite well-behaved, but seems not to comprehend my meaning... Perhaps we lack that special connection.","nextNodeIds":[705420127]},{"nodeId":705420127,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":3622082370,"text":"So I would like to observe a bit more — you know, keep an eye out for obedient cats.","nextNodeIds":[705420128]},{"nodeId":705420128,"roleType":"TALK_ROLE_NPC","speakerId":30521,"speakerName":"Mona","textMapHash":506543130,"text":"Oh, and I must calculate the cost of a cat bed, cat food, and other expenses. Not too luxurious, but also not so shabby. Wouldn't do to submit the cat to hardship.","nextNodeIds":[705420129,705420130]},{"nodeId":705420129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":227955274,"text":"It's okay, take your time.","nextNodeIds":[705420131]},{"nodeId":705420131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2153809682,"text":"Yeah, Valerina said that she'll adopt even more strays in the future, so even if no cats catch your eye today, you can always come back often to play and have a look!","nextNodeIds":[705420132]},{"nodeId":705420132,"roleType":"TALK_ROLE_NPC","speakerId":30525,"speakerName":"Snowball","textMapHash":2054373450,"text":"Meow~","nextNodeIds":[]},{"nodeId":705420130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1490103122,"text":"There are many more furry felines in this fortress.","nextNodeIds":[705420131]},{"nodeId":705420107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3757059938,"text":"Try roaring at it, like, \"RAWR\"!","nextNodeIds":[705420108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAM