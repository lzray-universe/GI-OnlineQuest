{"mainQuestId":74678,"title":"Blade Dance's Unexpected End!","description":"After experiencing a unique battle on the Blade Dancer's stage, you and Paimon plan to give Costentin some feedback, but discover something has changed...","titleTextMapHash":528687903,"descTextMapHash":1304660854,"mainQuestExcel":{"mainQuestId":74678,"titleTextMapHash":528687903,"title":"Blade Dance's Unexpected End!","descTextMapHash":1304660854,"description":"After experiencing a unique battle on the Blade Dancer's stage, you and Paimon plan to give Costentin some feedback, but discover something has changed...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5172,"luaPath":"Actor/Quest/WQ74678","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5172,"chapterId":0,"descTextMapHash":1304660854,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74678,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":742397177,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74678","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174678],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":528687903,"type":"WQ","unlockDescTextMapHash":930934110}},"flow":[{"subQuestId":7467801,"order":1,"stepDescription":"Talk to Costentin","stepDescTextMapHash":1383531564,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30483"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467801],"talks":[{"talkId":7467801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":true,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7467801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467801,"initDialog":746780101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30421,30483],"performCfg":"QuestDialogue/WQ/GoalChallenge_74678/Q7467801","priority":5,"questId":74678,"showRandomTalkCount":0},"dialogs":[{"nodeId":746780101,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":246553210,"text":"Unauthorized combat, unauthorized combat! Seize them immediately!","nextNodeIds":[746780102]},{"nodeId":746780102,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1681940722,"text":"Upon discovering such a dangerous Domain, you should have reported it straight back to the Maison Gardiennage, not started an unauthorized investigation, let alone used violence... You really are a bloodthirsty one, aren't you?","nextNodeIds":[746780103]},{"nodeId":746780103,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2919382770,"text":"B—B—B—But please! Not only are we not in the Court of Fontaine, but we're beating up monsters! Can we really be arrested for that?","nextNodeIds":[746780104]},{"nodeId":746780104,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":3426337738,"text":"Are you a registered member of the Adventurers' Guild?","nextNodeIds":[746780105]},{"nodeId":746780105,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1846557842,"text":"N—No, I'm not... I didn't have what it takes to pass their physical tests...","nextNodeIds":[746780106]},{"nodeId":746780106,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":3552438730,"text":"Then presumably you informed the Maison Gardiennage in advance that you planned on using weapons within the borders of Fontaine?","nextNodeIds":[746780107]},{"nodeId":746780107,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":445955802,"text":"Huh? You have to declare in advance that you're planning to use weapons?","nextNodeIds":[746780108]},{"nodeId":746780108,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1754336618,"text":"Of course you do! If any old Pierre, Paul, or Jacques could start a fight in Fontaine whenever they wanted, where would that leave the Maison Gardiennage?","nextNodeIds":[746780109]},{"nodeId":746780109,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2958436834,"text":"Waving weapons around like toys without a permit, you're lucky that the Gardemeks didn't treat you like an intruder!","nextNodeIds":[746780110]},{"nodeId":746780110,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1972689362,"text":"Take a good look at yourself! You're practically a fake Fontainian. Do you seriously think us arresting you would be some grave miscarriage of justice?","nextNodeIds":[746780111]},{"nodeId":746780111,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":3976377194,"text":"I've completely misjudged this whole thing! As a writer, I selected my source material poorly, and should have known better than to overlook the basic setting of the story... A complete dereliction of duty!","nextNodeIds":[746780112,746780113]},{"nodeId":746780112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":814157354,"text":"We often investigate Domains on a whim...","nextNodeIds":[746780114]},{"nodeId":746780114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":299984018,"text":"But it's been ages since we became adventurers, so there shouldn't be a problem, right?","nextNodeIds":[746780115]},{"nodeId":746780115,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2998394034,"text":"Oh? It's you two! You're both A-listers!","nextNodeIds":[746780116]},{"nodeId":746780116,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1710689410,"text":"Ahem, my name is Enghiene and I am a veteran member of the Gardes with years of experience out in the wilds. A short time ago, while patrolling nearby, I caught sight of this reckless fellow...","nextNodeIds":[746780117]},{"nodeId":746780117,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1622902418,"text":"He explained the ins and outs of why he's been loitering around here, and showed me this strange Domain. He also informed me that the two of you were taking part in this \"Blade Dance\" of his.","nextNodeIds":[746780118]},{"nodeId":746780118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3425988258,"text":"Eek!","nextNodeIds":[746780119,746780120]},{"nodeId":746780119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1166743210,"text":"We had a \"smashing\" time in there.","nextNodeIds":[746780121]},{"nodeId":746780121,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2223171970,"text":"Of course not! On the contrary, in light of the outstanding pluck and valor that the two of you have shown, I'd say you deserve a handsome reward!","nextNodeIds":[746780122]},{"nodeId":746780122,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2863118674,"text":"Despite the recklessness of his \"undeclared use of dangerous weaponry,\" all we're really talking about here is bringing this rascal in and giving him a verbal warning.","nextNodeIds":[746780123]},{"nodeId":746780123,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1597002818,"text":"Not like he committed any major crimes, so of course he won't be punished too severely.","nextNodeIds":[746780124]},{"nodeId":746780124,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1783847722,"text":"Even if it's just a fine, I'm afraid that I have but little Mora to give you...","nextNodeIds":[746780125]},{"nodeId":746780125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3561727762,"text":"Don't panic, don't panic!","nextNodeIds":[746780126]},{"nodeId":746780126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3171573402,"text":"Though Costentin tends to exaggerate, he's certainly not a bad person... He's just mesmerized by the art and elegance of combat and wants to write a novel, that's all.","nextNodeIds":[746780127]},{"nodeId":746780127,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1618545634,"text":"Do you hear that? The celebrities are interceding on your behalf... Don't let me catch you making the same mistake again, you reckless — albeit thoroughly decent — fellow!","nextNodeIds":[746780128]},{"nodeId":746780128,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1320919682,"text":"Next time, I guarantee you I'll do all the necessary preparation before I start another on-site investigation!","nextNodeIds":[746780129]},{"nodeId":746780129,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":3485226698,"text":"Anyway, I'll do things by the book and take him back to the Maison Gardiennage for a good tongue-lashing.","nextNodeIds":[746780130]},{"nodeId":746780130,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":173674378,"text":"Another member of the Gardes will be over later to get this Domain properly cleaned up...","nextNodeIds":[746780131]},{"nodeId":746780131,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1193667098,"text":"But with you two here, it doesn't really pose a danger anyway.","nextNodeIds":[746780132]},{"nodeId":746780132,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":3528945562,"text":"If you so desire, please feel free to carry on beating up the monsters inside... You'd be doing my colleague a huge favor!","nextNodeIds":[746780133]},{"nodeId":746780133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":168438458,"text":"So... We're now a pair of knights in shining armor who've been doubly rewarded — not only by a sword novelist, but by the Maison Gardiennage too! All in all, not a bad little detour, eh?","nextNodeIds":[]},{"nodeId":746780120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3249487090,"text":"Are we under arrest too?","nextNodeIds":[746780121]},{"nodeId":746780113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":260094674,"text":"...and we've never had to declare anything before?","nextNodeIds":[746780114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30483"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","count":18},{"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174678],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1304660854