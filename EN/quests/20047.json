alkIds":[2004701,2004702],"talks":[{"talkId":2004701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2004701","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2004701,"initDialog":200470101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1591],"performCfg":"","priority":6,"questId":20047,"showRandomTalkCount":0},"dialogs":[{"nodeId":200470101,"roleType":"TALK_ROLE_NPC","speakerId":1589,"speakerName":"Patchi the Curious","textMapHash":3050079657,"text":"There's no such THING as a perfect plan when you're on an adventure! How are you going to make any progress at all if you keep deliberating like this?","nextNodeIds":[200470102]},{"nodeId":200470102,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":2413530873,"text":"If the plan isn't perfect, then we need to be prepared for anything!","nextNodeIds":[200470103]},{"nodeId":200470103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3582328041,"text":"What are you arguing about?","nextNodeIds":[200470104]},{"nodeId":200470104,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":2708679793,"text":"Ah, you see, we are planning to go exploring in the <color=#00E1FFFF>Thousand Winds Temple</color>. But Ms. Patchi here doesn't have any adventuring experience...","nextNodeIds":[200470105]},{"nodeId":200470105,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":1973315801,"text":"The inside of the temple is swarming with monsters these days, not to mention the terrifying Ruin Guard at the entrance... We will only put our lives at risk if we rush into this.","nextNodeIds":[200470106]},{"nodeId":200470106,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":1600351025,"text":"I am only trying to ensure Ms. Patchi's safety— Well, okay... our collective safety.","nextNodeIds":[200470107]},{"nodeId":200470107,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":2506292873,"text":"I am trying to persuade her of the merits of devising a meticulous and foolproof plan for this adventure.","nextNodeIds":[200470108]},{"nodeId":200470108,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":1488581569,"text":"But I fear if we start with some basic reconnaissance near the temple grounds, Patchi will get too excited and go charging in...","nextNodeIds":[200470109]},{"nodeId":200470109,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":3529858713,"text":"I need to stay here and keep an eye on her. Could you go and survey the area for me?","nextNodeIds":[200470110,200470113]},{"nodeId":200470110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2285601041,"text":"Okay.","nextNodeIds":[200470111]},{"nodeId":200470111,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":2952050681,"text":"Wonderful! But be sure to observe everything carefully. A single detail overlooked could spell the failure of our adventure.","nextNodeIds":[200470112]},{"nodeId":200470112,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":2774945377,"text":"Whatever happens out there, I need you to tell me everything about it.","nextNodeIds":[]},{"nodeId":200470113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4170358369,"text":"Why don't I keep an eye on Patchi for you instead?","nextNodeIds":[200470114]},{"nodeId":200470114,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":1465670201,"text":"N—No, that won't work! I, uh— There are all sorts of details in the current plan I still need to go over with her...","nextNodeIds":[200470115]},{"nodeId":200470115,"roleType":"TALK_ROLE_NPC","speakerId":1591,"speakerName":"Doolan","textMapHash":295028897,"text":"Help me go and look for clues. Please!","nextNodeIds":[]}]},{"talkId":2004702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2004701","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2004702","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2004702,"initDialog":200470201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1591],"performCfg":"","priority":6,"questId":20047,"showRandomTalkC