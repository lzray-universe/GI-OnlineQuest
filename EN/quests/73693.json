AULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30348"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369301],"talks":[{"talkId":7369301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7369301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369301,"initDialog":736930101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30348],"performCfg":"QuestDialogue/WQ/Sumeru_73693/Q7369301","priority":5,"questId":73693,"showRandomTalkCount":0},"dialogs":[{"nodeId":736930101,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":2264454314,"text":"How did this fall to me? Couldn't we have assigned this task to a more experienced senior student?","nextNodeIds":[736930102]},{"nodeId":736930102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":74204746,"text":"Hmm? Are you running some event here as well?","nextNodeIds":[736930103]},{"nodeId":736930103,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":2315822858,"text":"Eh!? Oh, Traveler, um... Yes, yes, we are indeed... running an event.","nextNodeIds":[736930104]},{"nodeId":736930104,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":1895244882,"text":"Well, I say it's an event, but really, it's... a Domain that awaits exploration.","nextNodeIds":[736930105]},{"nodeId":736930105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3906439282,"text":"Does this Domain have anything to do with the Gala?","nextNodeIds":[736930106]},{"nodeId":736930106,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":337368770,"text":"*sigh* Oh, let's not even get into that. I only came to be in charge of this affair because of the Gala.","nextNodeIds":[736930107]},{"nodeId":736930107,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":1224789826,"text":"Sorry, I forgot to introduce myself. I'm Bahador from Spantamad, and our research lies in the field of alchemy, the elements, and topics like that...","nextNodeIds":[736930108]},{"nodeId":736930108,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":2823446954,"text":"So, I was assigned this task, but as much as I've thought about it, I couldn't think of a game that our Darshan could run.","nextNodeIds":[736930109]},{"nodeId":736930109,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":387227826,"text":"Putting up a crafting bench to do public alchemical experiments would be too boring...","nextNodeIds":[736930110]},{"nodeId":736930110,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":3798092210,"text":"And there was no way we could run some demonstration of Elemental Reactions. If something went wrong, the whole site might go up in smoke — and what would we do then?","nextNodeIds":[736930111]},{"nodeId":736930111,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":3891786882,"text":"In the end, I had to ask the Adventurers' Guild for help, and it was with their aid that I found this Domain.","nextNodeIds":[736930112]},{"nodeId":736930112,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":3139284538,"text":"Several of my fellow students and I went inside to investigate, and to be honest, it is an utter mess in there.","nextNodeIds":[736930113]},{"nodeId":736930113,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":2378555978,"text":"As such, we developed a few potions specialized for use inside this Domain.","nextNodeIds":[736930114]},{"nodeId":736930114,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":595470922,"text":"And well, that's our Darshan's specialty demonstrated now, eh? Hahaha...","nextNodeIds":[736930115]},{"nodeId":736930115,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":174122882,"text":"So if you're interested, Traveler, take these potions with you and go investigate the Domain. I'll mark its location on your <color=#00E1FFFF>map</color>.","nextNodeIds":[736930116,736930117]},{"nodeId":736930116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":927997650,"text":"Has anyone come to... uh, play this game?","nextNodeIds":[736930118]},{"nodeId":736930117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3338858730,"text":"Has anyone other than me taken part?","nextNodeIds":[736930118]},{"nodeId":736930118,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":2201955442,"text":"Q—Quite a few adventurers did come to give this a go! They were quite excited, too.","nextNodeIds":[736930119]},{"nodeId":736930119,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":1862093802,"text":"But I must say that very few of our fellow students did...","nextNodeIds":[736930120]},{"nodeId":736930120,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":1610186786,"text":"*sigh* Whatever the case may be, you can go in as long as you're interested.","nextNodeIds":[736930121]},{"nodeId":736930121,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":1925130210,"text":"The adventurers who tried this earlier rated it as being \"very challenging.\"","nextNodeIds":[736930122,736930124]},{"nodeId":736930126,"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":1103880602,"text":"Ah, yes, for when you do go, I will have some potions here for you. Stay safe when exploring that Domain, alright?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30348"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1503014866,"text":"In that case, I'll head in as well."},{"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":2705479162,"text":"Really? Sure, then! in that case, please take these potions with you..."},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1681884018,"text":"I've got other things to do at the moment."},{"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","textMapHash":1039923706,"text":"You're going? Well, alright then. As for me, I've got to stick around here..."}],"talkIds":[7369301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30348,"speakerName":"Bahador","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173693],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3320268438,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73693/Q7369301","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":736930101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7369301,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30348],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNK