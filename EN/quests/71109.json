"","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7110906,"initDialog":711090601,"nextRandomTalks":[],"nextTalks":[],"npcId":[2233,2234],"performCfg":"QuestDialogue/WQ/Liyue_71109/Q7110906","priority":5,"questId":71109,"showRandomTalkCount":0},"dialogs":[{"nodeId":711090601,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":222805834,"text":"Huh? This sword seems to have something written on it. Let Paimon see...","nextNodeIds":[711090602]},{"nodeId":711090602,"roleType":"TALK_ROLE_NPC","speakerId":2324,"speakerName":"Ancient Swordsman's Inscriptions","textMapHash":1773376914,"text":"\"...Caressing the blade, singing I go, to cleave dragons and drink their blood. The divine light, like flowing lightning, like a frigid wave, threatens to smash the mountains...\"","nextNodeIds":[711090603]},{"nodeId":711090603,"roleType":"TALK_ROLE_NPC","speakerId":2324,"speakerName":"Ancient Swordsman's Inscriptions","textMapHash":2492679938,"text":"\"...Beneath Mt. Tianheng, I slay tigers, the scaled beast I skewer amidst the Sea of Clouds... When I return crowned in success, we shall live at ease...\"","nextNodeIds":[711090604]},{"nodeId":711090604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4106788858,"text":"There's also a stone tablet next to it... Eh? The handwriting below seems to be different...","nextNodeIds":[711090605]},{"nodeId":711090605,"roleType":"TALK_ROLE_NPC","speakerId":2233,"speakerName":"Ancient Engraving","textMapHash":4270718322,"text":"\"...I originally wanted to leave behind some delicacies here. But the food would inevitably spoil over time, so I left the recipes here for you to cook instead. I assure you, they shall be delicious indeed.\"","nextNodeIds":[711090606]},{"nodeId":711090606,"roleType":"TALK_ROLE_NPC","speakerId":2233,"speakerName":"Ancient Engraving","textMapHash":2120413066,"text":"\"...Apart from these, nothing else remains. Only this sword and the beautiful scenery.\"","nextNodeIds":[711090607]},{"nodeId":711090607,"roleType":"TALK_ROLE_NPC","speakerId":2233,"speakerName":"Ancient Engraving","textMapHash":2037877794,"text":"\"...When faced with a dead end, what should we do? You already know the answer.\"","nextNodeIds":[711090608]},{"nodeId":711090608,"roleType":"TALK_ROLE_NPC","speakerId":2234,"speakerName":"Crooked Engraving","textMapHash":1684973242,"text":"\"...Do not take... treasure, leaving solely one... henceforth...\"","nextNodeIds":[711090609]},{"nodeId":711090609,"roleType":"TALK_ROLE_NPC","speakerId":2234,"speakerName":"Crooked Engraving","textMapHash":2952408442,"text":"May my final stand... be a monument...","nextNodeIds":[711090610]},{"nodeId":711090610,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1337793962,"text":"Whoa... These lines here are so illegible that Paimon can't understand it one bit!","nextNodeIds":[711090611,711090612]},{"nodeId":711090611,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1391046306,"text":"They roughly mean that he didn't take anything with him.","nextNodeIds":[711090613]},{"nodeId":711090613,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3083146994,"text":"*sob* After all this, we didn't find a single valuable treasure. All that hope for nothing...","nextNodeIds":[711090614,711090615]},{"nodeId":711090614,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":421358722,"text":"You're telling me!","nextNodeIds":[711090617]},{"nodeId":711090617,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1662156178,"text":"Paimon never imagined that we'd be able to still see such scenery in a tight spot like this, though... It's something at least, right?","nextNodeIds":[]},{"nodeId":711090615,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1838506098,"text":"It's okay. I'll make you something to eat.","nextNodeIds":[711090616]},{"nodeId":711090616,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2685720306,"text":"#Huh? For real!? Then it's settled, {NICKNAME}!","nextNodeIds":[711090617]},{"nodeId":711090612,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":894557770,"text":"I don't get them either...","nextNodeIds":[711090613]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7110906,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":44010023,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":4401,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["133115022","22001","2251.208:346.695:2188.656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_GADGET"}}}],"unmappedTalks":[{"talkId":7110925,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":