{"mainQuestId":72659,"title":"The Moon Has Risen","description":"The Inazuman angler Kujirai Momiji has something that she wants help with...","titleTextMapHash":2622390759,"descTextMapHash":853526054,"mainQuestExcel":{"mainQuestId":72659,"titleTextMapHash":2622390759,"title":"The Moon Has Risen","descTextMapHash":853526054,"description":"The Inazuman angler Kujirai Momiji has something that she wants help with...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":5041,"luaPath":"Actor/Quest/WQ72659","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5041,"chapterId":0,"descTextMapHash":853526054,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72659,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":95463033,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72659","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172659],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[72661],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2622390759,"type":"WQ","unlockDescTextMapHash":1761213782}},"flow":[{"subQuestId":7265901,"order":1,"stepDescription":"Talk to the Inazuman fisherwoman Kujirai Momiji","stepDescTextMapHash":2079757108,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3200"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7265901],"talks":[{"talkId":7265901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7265901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7265901,"initDialog":726590101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3200,1005],"performCfg":"QuestDialogue/WQ/Daoqi_72659/Q7265901","priority":5,"questId":72659,"showRandomTalkCount":0},"dialogs":[{"nodeId":726590101,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1866982290,"text":"\"Lunar Leviathan\"...","nextNodeIds":[726590102]},{"nodeId":726590102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":158361490,"text":"What \"Lunar Leviathan\"?","nextNodeIds":[726590103]},{"nodeId":726590103,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3606061242,"text":"Oh, hey there! You must be the fisherman sent by the Adventurers' Guild, huh? I'm Kujirai Momiji, an Inazuman fisherwoman.","nextNodeIds":[726590104]},{"nodeId":726590104,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3292327842,"text":"I heard about you from the Fishing Association. Seeing you today, you are indeed as young and promising as they said. I hope I didn't get the wrong person.","nextNodeIds":[726590105]},{"nodeId":726590105,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1137365594,"text":"Recently I have been searching for a fish that is from legends. It's called the \"Lunar Leviathan\". According to the legends, it has the power to grant people's wishes.","nextNodeIds":[726590106]},{"nodeId":726590106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3250141570,"text":"Wowee — a wish-granting fish! Paimon likes these kinds of legends!","nextNodeIds":[726590107]},{"nodeId":726590107,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1066108274,"text":"Hmph, even though everyone believes they are just legends...I believe it's real.","nextNodeIds":[726590108]},{"nodeId":726590108,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":4094277298,"text":"Because a few years ago, I may have personally encountered a \"Lunar Leviathan\"...","nextNodeIds":[726590109]},{"nodeId":726590109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2036924834,"text":"Did it grant your wish?","nextNodeIds":[726590110]},{"nodeId":726590110,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":151815370,"text":"Well... kind of. The story goes like this...","nextNodeIds":[726590111]},{"nodeId":726590111,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":939943466,"text":"A couple of years ago, because of each of our respective wishes, two friends and myself set out to sea to pursue the \"Lunar Leviathan\". One was Jiawei and the other was Nantuck.","nextNodeIds":[726590112]},{"nodeId":726590112,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2919996298,"text":"But the journey was turbulent. We encountered a violent thunderstorm. And although our fishing boat survived, our compass got damaged and we were lost in an unknown patch of ocean.","nextNodeIds":[726590113]},{"nodeId":726590113,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2051732890,"text":"A few days later, we still could not find the way home. We were out of fresh water and though no one said anything, everyone was getting desperate.","nextNodeIds":[726590114]},{"nodeId":726590114,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":4197775322,"text":"To the point where one night, Jiawei wrote a suicide note, put it in a bottle and was about to throw it out to sea.","nextNodeIds":[726590115]},{"nodeId":726590115,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":77962154,"text":"He didn't know but we weren't asleep at the time. We heard him sneaking out and we rushed to grabbed him. And in that moment we all saw a giant shape under the water.","nextNodeIds":[726590116]},{"nodeId":726590116,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2179913210,"text":"The shape glowed faintly, shining little by little, as if pieces of the moon were dropped underwater.","nextNodeIds":[726590117]},{"nodeId":726590117,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2814810042,"text":"Was it a \"Lunar Leviathan\"? We were desperate so we believed so, we asked it to grant us safe return to our homeland.","nextNodeIds":[726590118]},{"nodeId":726590118,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2296404746,"text":"Yep, whether you can believe it or not, we survived. When the magical shape began swimming away, we followed it and it led us back home.","nextNodeIds":[726590119]},{"nodeId":726590119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2650000946,"text":"Aww...That's such a touching legend!","nextNodeIds":[726590120]},{"nodeId":726590120,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2393175850,"text":"No! It's true! Believe me! We can definitely find it again.","nextNodeIds":[726590121]},{"nodeId":726590121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3984999882,"text":"What should we do?","nextNodeIds":[726590122]},{"nodeId":726590122,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":828342250,"text":"Well let's go find my old pals first. They're both seasoned fishermen and having them accompany us would help a great deal.","nextNodeIds":[726590123]},{"nodeId":726590123,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":887706746,"text":"<color=#00E1FFFF>Jiawei is located at Liyue Harbor,</color> I heard once he returned to Liyue he never left again. I'm sure he still reminisces about the \"Lunar Leviathan\" as well.","nextNodeIds":[726590124]},{"nodeId":726590124,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2231977666,"text":"As for Nantuck, I heard he started writing books about marine biology. When you meet Jiawei, you can ask him where he is.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3200"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7265902,"order":2,"stepDescription":"Talk to the Liyue fisherman Jiawei","stepDescTextMapHash":3325083116,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2615"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7265902,7265903],"talks":[{"talkId":7265902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7265902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7265902,"initDialog":726590201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2615,1005],"performCfg":"QuestDialogue/WQ/Daoqi_72659/Q7265902","priority":5,"questId":72659,"showRandomTalkCount":0},"dialogs":[{"nodeId":726590201,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":78447010,"text":"The ocean is like a beautiful woman, only a welcoming sight every so often...","nextNodeIds":[726590202]},{"nodeId":726590202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4146624258,"text":"Are you Jiawei?","nextNodeIds":[726590203]},{"nodeId":726590203,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":1438832234,"text":"Yes, what do you want?","nextNodeIds":[726590204]},{"nodeId":726590204,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":2287322818,"text":"Oh — the \"Lunar Leviathan\"! Of course it's about the \"Lunar Leviathan\"! That experience really stays with you.","nextNodeIds":[726590205]},{"nodeId":726590205,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":2727382922,"text":"As for Kujirai, she also did not forget. Her wish was... Uh... Um, uhh...","nextNodeIds":[726590206]},{"nodeId":726590206,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":1789056170,"text":"Then I will send you off with my best wishes, I hope you guys succeed!","nextNodeIds":[726590207]},{"nodeId":726590207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2353008754,"text":"Huh? We came here to invite you, don't you want to come with us?","nextNodeIds":[726590208]},{"nodeId":726590208,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":470439450,"text":"Ah! I nearly lost my life at that time. The ocean is like a beautiful woman, only a welcoming sight every so often...","nextNodeIds":[726590209]},{"nodeId":726590209,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":1459321154,"text":"Additionally, as a married man, how could I abandon my family? I must take on the role of being head of the household!","nextNodeIds":[726590210]},{"nodeId":726590210,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":3951715682,"text":"After all the hard work and sweat I put in to marry such a generous and wonderful woman! So, I must apologize...","nextNodeIds":[726590211]},{"nodeId":726590211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2682474954,"text":"Your old pal will be disappointed.","nextNodeIds":[726590212]},{"nodeId":726590212,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":3610303834,"text":"Don't talk like that...let me think...","nextNodeIds":[726590213]},{"nodeId":726590213,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":469751426,"text":"Although I cannot accompany you on your journey, I will help in another way. I will pass on my years of fishing experience and knowledge to you.","nextNodeIds":[726590214]},{"nodeId":726590214,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":3646212666,"text":"A legendary creature like the \"Lunar Leviathan\" will not be caught easily.","nextNodeIds":[726590215]},{"nodeId":726590215,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":1738655490,"text":"So, accept my training, inherit my knowledge and then go pursue the legendary fish!","nextNodeIds":[726590216]},{"nodeId":726590216,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":4221600994,"text":"Oh, right? Aren't you guys in a hurry to find Nantuck? Don't worry, that guy's been hibernating like an old sea turtle. He's stayed in Mondstadt all this time, it's said that he's writing a book?","nextNodeIds":[726590217]},{"nodeId":726590217,"roleType":"TALK_ROLE_NPC","speakerId":2615,"speakerName":"Jiawei","textMapHash":1857419594,"text":"Now focus! Jiawei's magical fishing training is about to begin! Once training is over, you can go look for him.","nextNodeIds":[]}]},{"talkId":7265903,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkR