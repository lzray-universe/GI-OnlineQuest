{"mainQuestId":72687,"title":"The Floral Courtyard: Part I","description":"Amidst the Irodori Festival, the florist Fushizome is looking for someone to experience the art of ikebana.","titleTextMapHash":4042630079,"descTextMapHash":3874649598,"mainQuestExcel":{"mainQuestId":72687,"titleTextMapHash":4042630079,"title":"The Floral Courtyard: Part I","descTextMapHash":3874649598,"description":"Amidst the Irodori Festival, the florist Fushizome is looking for someone to experience the art of ikebana.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2012,"luaPath":"Actor/Quest/WQ72687","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2012,"chapterId":0,"descTextMapHash":3874649598,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72687,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1833191793,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72687","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172687],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4042630079,"type":"WQ","unlockDescTextMapHash":4099487094}},"flow":[{"subQuestId":7268701,"order":1,"stepDescription":"Talk to Fushizome","stepDescTextMapHash":2113730292,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30171"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7268701],"talks":[{"talkId":7268701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7268701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268701,"initDialog":726870101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30171],"performCfg":"QuestDialogue/WQ/Inazuma_72687/Q7268701","priority":5,"questId":72687,"showRandomTalkCount":0},"dialogs":[{"nodeId":726870101,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2276414714,"text":"Good day, you two.","nextNodeIds":[726870102]},{"nodeId":726870102,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1555682962,"text":"Ah, a fragrance wafts from the two of you. You must both be connoisseurs of the finer things in life...","nextNodeIds":[726870103]},{"nodeId":726870103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":61421306,"text":"#Huh. Do we smell that nice, {NICKNAME}? Let Paimon try...","nextNodeIds":[726870104]},{"nodeId":726870104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3399967282,"text":"Oooh, you do smell of Matsutake Meat Rolls! Guess this lady's right on the Mora, huh?","nextNodeIds":[726870105,726870106]},{"nodeId":726870105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":864723330,"text":"I don't think she's talking about that kind of fragrance, Paimon...","nextNodeIds":[726870107]},{"nodeId":726870107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2890107842,"text":"That's true. And with this familiar opening... Ooh, Paimon gets it! Is this lady gonna need our help as well?","nextNodeIds":[726870108]},{"nodeId":726870108,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":77157122,"text":"Indeed, I believe that you will serve as dutiful guides and bring more customers in, but I'd prefer that you be able to enjoy this festival as a customer.","nextNodeIds":[726870109]},{"nodeId":726870109,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3188404410,"text":"Would you two like to give it a try if you have time? Creating a \"floral courtyard\" of your very own, that is.","nextNodeIds":[726870110]},{"nodeId":726870110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3835244826,"text":"What's a \"floral courtyard\"?","nextNodeIds":[726870111]},{"nodeId":726870111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3669035002,"text":"Sure, I'd like to find out.","nextNodeIds":[726870112]},{"nodeId":726870112,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2943738026,"text":"As you can see, I am a florist. The arrangement of these flower stands behind me is the \"floral courtyard\" — arranged according to the principles of \"ikebana.\"","nextNodeIds":[726870113]},{"nodeId":726870113,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2169409090,"text":"To place carefully trimmed flowers into their respective vessels and add on various accessories to create a courtyard-like scene on the table. This is the \"floral courtyard\" — the crystallization of the floral arts.","nextNodeIds":[726870114]},{"nodeId":726870114,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":591025466,"text":"With the aid of the Yashiro Commission, I am taking part in the Irodori Festival with a variety of \"floral courtyards,\" in the hopes that we might introduce the beauty of the floral arts to our guests.","nextNodeIds":[726870115]},{"nodeId":726870115,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3733310250,"text":"If you're interested, please feel free to give it a go.","nextNodeIds":[726870116]},{"nodeId":726870116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":232455130,"text":"Huh... These floral artworks really are super pretty, and they look really elegant too. But it looks tough. Can we really do it?","nextNodeIds":[726870117,726870118]},{"nodeId":726870117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3238378498,"text":"Worried about your handicraft skills, Paimon?","nextNodeIds":[726870119]},{"nodeId":726870119,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2222474306,"text":"Please do not worry.","nextNodeIds":[726870120]},{"nodeId":726870120,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2717956850,"text":"To help our guests truly appreciate the charm of this art, I have prepared a great number of items that can simplify the construction process.","nextNodeIds":[726870121]},{"nodeId":726870121,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2654210394,"text":"You just need to select the main flower, the floral scene, and the base, before combining these elements to create your very own \"floral courtyard.\"","nextNodeIds":[726870122]},{"nodeId":726870122,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":913153402,"text":"Of course, the important thing is to experience \"expressing yourself through the floral arts.\" As such, I will give you four \"floral themes\" to test your thinking a little.","nextNodeIds":[726870123]},{"nodeId":726870123,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1262104978,"text":"If you complete the theme on each day, you will be able to take the corresponding \"floral courtyards\" and flowers back with you as mementos, along with some extra prizes.","nextNodeIds":[726870124]},{"nodeId":726870124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1885256218,"text":"Really? That's awesome!","nextNodeIds":[726870125]},{"nodeId":726870125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":316431970,"text":"#Hehe, come on, {NICKNAME}, since this lady's put in so much effort, let's lend her a hand, shall we?","nextNodeIds":[726870126,726870127]},{"nodeId":726870126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":173941210,"text":"We'll do it for the beauty of the floral arts...","nextNodeIds":[726870128]},{"nodeId":726870128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2443453730,"text":"Alright then, let's start now! Let's make our own... Uh, what was it again? Right! Our very own \"floral courtyards\"!","nextNodeIds":[726870129]},{"nodeId":726870129,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":448396682,"text":"Hahaha. You have my thanks for your enthusiasm...","nextNodeIds":[726870130]},{"nodeId":726870130,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3301663282,"text":"Well, then let's begin, shall we? The theme for today is \"The purple sakura lies sparse, the clear sand is fragrant.\"","nextNodeIds":[726870131]},{"nodeId":726870131,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":246268322,"text":"Ponder the meaning of this theme, and focus on the flowers and the various other utensils to create your very own \"floral courtyard.\"","nextNodeIds":[]},{"nodeId":726870127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1676226482,"text":"We'll do it for the extra prizes...","nextNodeIds":[726870128]},{"nodeId":726870118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2949819098,"text":"Too used to doing things in large strides, Paimon?","nextNodeIds":[726870119]},{"nodeId":726870106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":966210674,"text":"Paimon, I think you're missing the point...","nextNodeIds":[726870107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30171"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7268702,"order":2,"stepDescription":"Complete the floral theme","stepDescTextMapHash":3523986284,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_IRODORI_FINISH_FLOWER_COMBINATION","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q72687"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7268705],"talks":[{"talkId":7268705,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7268702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268705,"initDialog":726870201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30171],"performCfg":"QuestDialogue/WQ/Inazuma_72687/Q7268702","priority":5,"questId":72687,"showRandomTalkCount":0},"dialogs":[{"nodeId":726870201,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2434204082,"text":"In the following days, I will continue to stay here and guide those who come for the Irodori Festival, and help them to enjoy the beauty of the \"floral courtyards.\"","nextNodeIds":[726870202]},{"nodeId":726870202,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":151836690,"text":"Don't forget to drop by every day to get another \"theme.\" There will be a total of four such themes for you to figure out.","nextNodeIds":[726870203]},{"nodeId":726870203,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":845616874,"text":"Of course, if you have any other questions, I will do my best to answer them for you.","nextNodeIds":[726870204,726870210,726870222]},{"nodeId":726870204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4206709530,"text":"About the flowers here...","nextNodeIds":[726870205]},{"nodeId":726870205,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":919871594,"text":"The flowers I use are all provided by Sakuya's Flowers. The flowers they grow are of impeccable quality and affordable prices.","nextNodeIds":[726870206]},{"nodeId":726870206,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1719476458,"text":"Perhaps you've met Sakuya as well. We once studied ikebana under the same master.","nextNodeIds":[726870207]},{"nodeId":726870207,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3009817834,"text":"Sakuya is also very well-studied in the floral arts, but when she heard that there would be tons of people at the Irodori Festival, she seemed to have gotten a bit of stage fright. She said that it would be difficult to quiet down and focus on her work in such an environment.","nextNodeIds":[726870208]},{"nodeId":726870208,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2499178986,"text":"In any case, I will advertise Sakuya's Flowers on her behalf.","nextNodeIds":[726870209]},{"nodeId":726870209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2082577922,"text":"We can help too if you need us!","nextNodeIds":[726870219]},{"nodeId":726870219,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1010027682,"text":"Well then, do the two of you have any other questions?","nextNodeIds":[726870220]},{"nodeId":726870220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3067219490,"text":"Thank you, Ms. Fushizome.","nextNodeIds":[726870221]},{"nodeId":726870221,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":139603770,"text":"Think nothing of it. If you have time, you can come and look for me any time.","nextNodeIds":[]},{"nodeId":726870210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1503724594,"text":"About the Yashiro Commission's involvement...","nextNodeIds":[726870211]},{"nodeId":726870211,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2797110330,"text":"The Yashiro Commission has always been very supportive of Inazuma's floral arts. Indeed, the person who sponsored this event is the Shirasagi Himegimi.","nextNodeIds":[726870212]},{"nodeId":726870212,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2496297666,"text":"She has always been incredibly talented in these arts, even from a young age. I saw her perform ikebana once, and even had the honor of exchanging pointers with her.","nextNodeIds":[726870213]},{"nodeId":726870213,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1508383266,"text":"Although I'm older than her, I'm nowhere near her ability in terms of skill in ikebana or understanding of the floral arts.","nextNodeIds":[726870214]},{"nodeId":726870214,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1416659450,"text":"Where circumstances have permitted, she has provided funding to help publicize ikebana every year. I've even heard that she has used her own savings to do so...","nextNodeIds":[726870215]},{"nodeId":726870215,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2580369618,"text":"She once expressed her frank desire for more people to understand ikebana and to drum up more interest in it such that more might want to practice this art.","nextNodeIds":[726870216]},{"nodeId":726870216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1890863482,"text":"Huh. So Ayaka did so much for Inazuma's floral arts...","nextNodeIds":[726870217]},{"nodeId":726870217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3694582458,"text":"I hope her wish comes true.","nextNodeIds":[726870218]},{"nodeId":726870218,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1842969362,"text":"Thank you both. You are indeed good-hearted people.","nextNodeIds":[726870219]},{"nodeId":726870222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1782352058,"text":"I have no further questions at the moment.","nextNodeIds":[726870223]},{"nodeId":726870223,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3508514954,"text":"Alright, then. You can come and look for me any time.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_IRODORI_FINISH_FLOWER_COMBINATION","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q72687"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7268703,"order":3,"stepDescription":"Talk to Fushizome","stepDescTextMapHash":3031970228,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["30171"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":fa