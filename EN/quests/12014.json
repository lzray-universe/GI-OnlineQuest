TYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[1201401],"talks":[{"talkId":1201401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1201401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1201401,"initDialog":120140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1035],"performCfg":"QuestDialogue/LQ/Yoimiya_12014/Q1201401","priority":5,"questId":12014,"showRandomTalkCount":0},"dialogs":[{"nodeId":120140101,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":3996358090,"text":"I think I'll stay here for a bit longer. The show is still not quite over in my heart.","nextNodeIds":[120140102]},{"nodeId":120140102,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2410550458,"text":"Oh, but if you wanted to chat, I'll happily oblige.","nextNodeIds":[120140103,120140108,120140115]},{"nodeId":120140103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2674832570,"text":"What do you want to do afterward?","nextNodeIds":[120140104]},{"nodeId":120140104,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2979679378,"text":"Matsuzaka and the others are still waiting for me so we can go hunt down the Great Mujina Youkai. I'm like a big sister to them, so I can't go back on my word.","nextNodeIds":[120140105]},{"nodeId":120140105,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":150449954,"text":"Also, I want to go and ask everyone what they thought of the fireworks.","nextNodeIds":[120140106]},{"nodeId":120140106,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":1853463090,"text":"And over the next few days, I'd also like to thank everyone for their support.","nextNodeIds":[120140107]},{"nodeId":120140107,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2964349754,"text":"That includes you and Paimon, too, of course.","nextNodeIds":[]},{"nodeId":120140108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2732609802,"text":"Are fireworks expensive?","nextNodeIds":[120140109]},{"nodeId":120140109,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":3914132866,"text":"For you guys...","nextNodeIds":[120140110]},{"nodeId":120140110,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":1603347538,"text":"I'll do it for free!","nextNodeIds":[120140111]},{"nodeId":120140111,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":1564927346,"text":"I did kind of force it on you, after all. Not to mention that I dragged you along with me and gave you all sorts of trouble along the way. Hehe, I'd feel bad if I charged you any Mora.","nextNodeIds":[120140112]},{"nodeId":120140112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":277202938,"text":"Are you sure? I feel bad...","nextNodeIds":[120140113]},{"nodeId":120140113,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":1410313578,"text":"#It's fine. ...Look, how about we make a deal: After you find your {F#brother}{M#sister}, tell {F#him}{M#her} to come to Naganohara Fireworks for all {F#his}{M#her} fireworks needs. That way, I'll get another customer. Sound fair?","nextNodeIds":[120140114]},{"nodeId":120140114,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":264394610,"text":"#Also, it'd be nice to meet {F#him}{M#her}.","nextNodeIds":[]},{"nodeId":120140115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":237810258,"text":"What if the Tenryou Commission causes you more trouble...","nextNodeIds":[120140116]},{"nodeId":120140116,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":3911106858,"text":"I'll kick their butts again!","nextNodeIds":[120140117]},{"nodeId":120140117,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":3997151090,"text":"Hahaha, I'm joking. Didn't I tell you that my family deals with the Commissions quite a bit?","nextNodeIds":[120140118]},{"nodeId":120140118,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2829813130,"text":"We have an easy enough time of it. At the worst, we'd have to apologize, smile, and pay a fine. It wouldn't be the end of the world.","nextNodeIds":[120140119]},{"nodeId":120140119,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2631596474,"text":"You two should be careful, though. Without the same connections, you can't afford to be as reckless as me, hee-hee.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1201401,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[3,40],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q12013_Yoimiya_Finial_Pos"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1201401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/LQ/Yoimiya_12014/Q1201401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJ