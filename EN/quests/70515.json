ndomTalks":[],"nextTalks":[],"npcId":[30217],"performCfg":"QuestDialogue/WQ/Mengde_70515/Q7051501","priority":5,"questId":70515,"showRandomTalkCount":0},"dialogs":[{"nodeId":705150101,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3570973186,"text":"Ah, bravo! All six Evermotion Mechanical Painting parts, now returned to us! Now then, all we need to do is to splice them together again...","nextNodeIds":[705150102]},{"nodeId":705150102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1519533794,"text":"All... of them?","nextNodeIds":[705150103]},{"nodeId":705150103,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2788670794,"text":"Why, of course! All these six smaller parts can be reunited as one!","nextNodeIds":[705150104]},{"nodeId":705150104,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2393212178,"text":"Together, they will form a gigantic and beauteous Evermotion Mechanical Painting.","nextNodeIds":[705150105]},{"nodeId":705150105,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":4147134490,"text":"Come, come, all we need to do now is to join them up!","nextNodeIds":[705150106,705150107]},{"nodeId":705150106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":861756610,"text":"Don't we need to cast it or anything?","nextNodeIds":[705150108]},{"nodeId":705150108,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3422244650,"text":"No, no, not at all. My machine is not some hastily cobbled-together amalgam of scrap!","nextNodeIds":[705150109]},{"nodeId":705150109,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2402638018,"text":"Every part is wonderfully, intricately meshed together like a... like a... Um...","nextNodeIds":[705150110]},{"nodeId":705150110,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2795232010,"text":"Eh, never mind. I've never been the best at analogies. I swear Xavier stole all the talent in rhetoric for himself.","nextNodeIds":[705150111]},{"nodeId":705150111,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3692172354,"text":"Either way, give it a go. It'll be interesting, I guarantee it.","nextNodeIds":[]},{"nodeId":705150107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3566355426,"text":"Is there any other work that needs to be done?","nextNodeIds":[705150108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133004074"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30217"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7051502,"order":2,"stepDescription":"Splice the Evermotion Mechanical Painting together","stepDescTextMapHash":3768036988,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[5082,101],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7051502_guide","0"],"NOCCOBOFKHP