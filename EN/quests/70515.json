ONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7051503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7051502,"initDialog":705150201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30217],"performCfg":"QuestDialogue/WQ/Mengde_70515/Q7051502","priority":5,"questId":70515,"showRandomTalkCount":0},"dialogs":[{"nodeId":705150201,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1846185258,"text":"Perfect! Why, it's lovely! Skilled in both mind and hand, you are, and more so than I could have expected, too!","nextNodeIds":[705150202]},{"nodeId":705150202,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":401218378,"text":"Hah. I do recall that several ludicrous manuscripts from The Steambird described you as... as...","nextNodeIds":[705150203,705150204]},{"nodeId":705150203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2083905346,"text":"As a, uh...","nextNodeIds":[705150205]},{"nodeId":705150205,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1543850154,"text":"Heh... As a straight-shooting knight-errant who prefers to let their blade do the talking.","nextNodeIds":[705150206]},{"nodeId":705150206,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3768401618,"text":"Ah, how ridiculous and foolish those reporters were! How much ado they made about so little! After all, who are you, if not a sharp, smart, humble... and well, straight-shooting knight-errant?","nextNodeIds":[705150207]},{"nodeId":705150207,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2321784482,"text":"When I get the time, they shall hear from me. Oh yes, they will!","nextNodeIds":[705150208]},{"nodeId":705150208,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1520742098,"text":"Ah, right. Please take this particular device. You can take it out for a little leisure, should you, well, be at leisure.","nextNodeIds":[705150209]},{"nodeId":705150209,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1433130242,"text":"As for me, I've got to start raising the Mora I'll need to travel to Liyue...","nextNodeIds":[]},{"nodeId":705150204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":618130098,"text":"Yes, go on...","nextNodeIds":[705150205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUID