GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30487"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7468101],"talks":[{"talkId":7468101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7468101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468101,"initDialog":746810101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30487],"performCfg":"QuestDialogue/WQ/Filmfest_74681/Q7468101","priority":5,"questId":74681,"showRandomTalkCount":0},"dialogs":[{"nodeId":746810101,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3888697458,"text":"Aha, mwahahahahaha... My two radiant guests, you're finally here!","nextNodeIds":[746810102]},{"nodeId":746810102,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3867844906,"text":"#You must be the legendary adventurers of Teyvat and rising superstars, {NICKNAME} and Paimon!","nextNodeIds":[746810103,746810105]},{"nodeId":746810103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2503330154,"text":"That's us alright!","nextNodeIds":[746810104]},{"nodeId":746810104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":41292546,"text":"We're certainly well known among the Adventurers' Guild, but superstars of Teyvat... perhaps just slightly over the top? After all, there are still many people out there that haven't heard of us...","nextNodeIds":[746810107]},{"nodeId":746810107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1238406426,"text":"Paimon feels like everyone we've met who comes straight out with such flattery... ends up asking us to do something for them!","nextNodeIds":[746810108]},{"nodeId":746810108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3707590394,"text":"Out with it then, what do you want?","nextNodeIds":[746810109]},{"nodeId":746810109,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":2463050826,"text":"Oh no-no-no-no, I don't want anything from you! I simply wanted to put forward a win-win proposal...","nextNodeIds":[746810110]},{"nodeId":746810110,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":904233306,"text":"Join forces with me, Fontaine's most talented \"experimental\" film director Melies, to become the next big star of the big screen!","nextNodeIds":[746810111]},{"nodeId":746810111,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3063221602,"text":"Once you've made it, money... connections... it's all yours!","nextNodeIds":[746810112]},{"nodeId":746810112,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":2017339802,"text":"Wherever you go in Teyvat, no one will dare to stand in your way, and you'll find yourself walking down an endless red carpet, rolled out just for you!","nextNodeIds":[746810113,746810114]},{"nodeId":746810113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3675044466,"text":"I'd rather not attract even more unwanted attention...","nextNodeIds":[746810115]},{"nodeId":746810115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3289555098,"text":"But we don't even have much experience acting on Kamera! If it were true that we could get famous just by collaborating with you...","nextNodeIds":[746810116]},{"nodeId":746810116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3913243690,"text":"...Then why aren't you already a super famous director, huh? And where are all the other stars that you've worked with?","nextNodeIds":[746810117]},{"nodeId":746810117,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3558188282,"text":"...","nextNodeIds":[746810118]},{"nodeId":746810118,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":262853970,"text":"Ugh, you saw right through me...","nextNodeIds":[746810119]},{"nodeId":746810119,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":617432666,"text":"If only someone would set up a special training school for actors! I need someone who not only knows how to fight, but also how to control their expressions and inject emotion into their lines. In short, I need someone who can do it all!","nextNodeIds":[746810120]},{"nodeId":746810120,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":1532950114,"text":"But such genius simply doesn't exist! So far, I've only finished planning the regular acting parts of my Avant-garde production. I haven't even started on the action scenes, let alone finished my first film...","nextNodeIds":[746810121]},{"nodeId":746810121,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":2945765986,"text":"I'm worried that I'll have to resort to employing stunt doubles, so that's why you two are such perfect candidates!","nextNodeIds":[746810122,746810123]},{"nodeId":746810122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2394089738,"text":"Does \"stunt doubles\" mean what I think it does?","nextNodeIds":[746810124]},{"nodeId":746810124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2901404370,"text":"You've hit the nail on the head! It's the perfect solution to having actors who can't fight...","nextNodeIds":[746810125]},{"nodeId":746810125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3136153026,"text":"We are pretty good at fighting, but won't people be able to tell that we're not the same people just by looking at our faces?","nextNodeIds":[746810126]},{"nodeId":746810126,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3448695082,"text":"In theory, yes. But the action scenes are absolutely central to my experimental production.","nextNodeIds":[746810127]},{"nodeId":746810127,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":1139039602,"text":"If you do a good enough job, I'll make the regular acting scenes into silhouette shots. There weren't even many lines to begin with...","nextNodeIds":[746810128]},{"nodeId":746810128,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":2061124218,"text":"I'll make the other actors cake themselves in makeup, and adjust their silhouettes so they fit your profiles. With a bit of lighting magic, no one will even know the difference!","nextNodeIds":[746810129]},{"nodeId":746810129,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":1334919106,"text":"In a way, the regular actors would actually be your doubles! Anyway, they aren't as well-known as you two. I'll even pay you royalties!","nextNodeIds":[746810130]},{"nodeId":746810130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1584147810,"text":"So basically, if we help you, we'll be handed the starring roles on a plate... just like that?","nextNodeIds":[746810131]},{"nodeId":746810131,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3245038802,"text":"You'll also receive a large payment, and it'll do wonders for your reputation!","nextNodeIds":[746810132]},{"nodeId":746810132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2872260354,"text":"#Then it really does sound like it'll pay off! What say you, {NICKNAME}?","nextNodeIds":[746810133,746810134]},{"nodeId":746810133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2804812306,"text":"Why pass up such a juicy opportunity?","nextNodeIds":[746810135]},{"nodeId":746810135,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":2619133346,"text":"Thank you so much for lending a hand! What a dream come true!","nextNodeIds":[746810136]},{"nodeId":746810136,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":772405970,"text":"Then without further ado, please head over to my experimental studio right away.","nextNodeIds":[746810137]},{"nodeId":746810137,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3450648066,"text":"There will be four fighting scenes in the film, each with a completely different ambiance. Each scene will also have its very own \"Special Lighting.\"","nextNodeIds":[746810138]},{"nodeId":746810138,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":107393346,"text":"When the \"Special Lighting\" comes on, the action will intensify in line with the corresponding place in the script...","nextNodeIds":[746810139]},{"nodeId":746810139,"roleType":"TALK_ROLE_NPC","speakerId":30487,"speakerName":"Melies","textMapHash":3515172530,"text":"With your experience, I'm sure you'll get the hang of it in no time! Once all the remaining scenes are filmed, we'll finally be able to wrap this thing up.","nextNodeIds":[]},{"nodeId":746810134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":461208730,"text":"Time to put our acting skills to the test...","nextNodeIds":[746810135]},{"nodeId":746810123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":553281370,"text":"You want us to shoot the fighting scenes?","nextNodeIds":[746810124]},{"nodeId":746810114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2714149178,"text":"But I like it when people stand in my way...","nextNodeIds":[746810115]},{"nodeId":746810105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4053460802,"text":"Do you need our help?","nextNodeIds":[746810106]},{"nodeId":746810106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3230427258,"text":"Not just prone to exaggeration, but also a user of strange adjectives...","nextNodeIds":[746810107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468101,0],"PAINLIBBLDK":"QU