re normal after a few drinks. Oh well, everyone loves to write random stuff on the message boards anyway, so...)"}],"talkIds":[1302301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","count":12}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/Q1302301","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":130230101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":1302301,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[1064,1053],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["1302304","2"],"_type":"QUEST_COND_STATE_EQUAL"}],"NIJAPEJKLDI":false,"NMKNFLIHHHE":false,"NMMOKMEKDJO":false,"NPGONNBAOOI":1686330229947519454,"OAIIIMFGNGM":false,"OAOCMNEPKOG":13023,"ODEOIJMOMPL":[],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST","PCCKKGAHFFJ":false,"PNACKFKJJHM":[]}],"IBNCKLKHAKG":0,"IEGCPJALJOA":0,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","ILHDNJDDEOP":13023,"ILICEMABDDI":[130130814649474825],"JAPLGJLDPHJ":[],"JDCIPCDDDPK":0,"JDEFCNEDMLL":0,"KCONOGOIGIH":0,"LEFIHLHODBM":[],"LMCFKPMJGEO":fa