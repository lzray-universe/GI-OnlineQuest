"},"isHidden":false,"talkIds":[1302301],"talks":[{"talkId":1302301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1302304","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1302301,"initDialog":130230101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1064,1053],"performCfg":"QuestDialogue/Q1302301","priority":5,"questId":13023,"showRandomTalkCount":0},"dialogs":[{"nodeId":130230101,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2383653026,"text":"The name Siraj doesn't ring a bell. Was he in your class?","nextNodeIds":[130230102]},{"nodeId":130230102,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":1655591370,"text":"He isn't someone who would leave an impression, so it's expected that you don't remember him.","nextNodeIds":[130230103]},{"nodeId":130230103,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3203631018,"text":"I've always had a hard time appreciating the way that the Akademiya pressures people by labeling them as geniuses.","nextNodeIds":[130230104]},{"nodeId":130230104,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2567110818,"text":"But even so, the Akademiya can't be left to you.","nextNodeIds":[130230105]},{"nodeId":130230105,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1869898442,"text":"Or perhaps I should say that I'm delighted to see that you have a base amount of self-awareness. If the people in the Akademiya haven't gone mad, they'd know that I'm much more suited to be a sage than you.","nextNodeIds":[130230106]},{"nodeId":130230106,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":2809863818,"text":"And I suppose they'd let everyone know that your career as a sage will be as shaky as that painting?","nextNodeIds":[130230107]},{"nodeId":130230107,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1585922850,"text":"Again, that's mighty rich coming from someone about to resign. In a few days, you'll be managing files again. You'll be back at rock bottom.","nextNodeIds":[130230108]},{"nodeId":130230108,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":4058181818,"text":"But my salary will likely stay the same.","nextNodeIds":[130230109]},{"nodeId":130230109,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3802615330,"text":"Wait, what? How come!? Why do you get special treatment!?","nextNodeIds":[130230110]},{"nodeId":130230110,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":463258378,"text":"At least I don't have to be an architectural designer who works himself to death just to get a smile from his client.","nextNodeIds":[130230111]},{"nodeId":130230111,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3086894706,"text":"Y—You...","nextNodeIds":[130230126]},{"nodeId":130230126,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":339135234,"text":"I took time out of my day to clean the living room for you, and this is the thanks I get for it!? I'd have been better off catching up on my work — I still have designs to finish.","nextNodeIds":[130230112]},{"nodeId":130230112,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":1200911738,"text":"Make sure to pay back the rent you owe me. I'm going to buy some furniture with that Mora.","nextNodeIds":[130230113]},{"nodeId":130230113,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":4106710842,"text":"Wha... Are you trying to annoy me to death!? The decorations you buy keep getting uglier and uglier. What's the point of having a boring wood carving in your house?","nextNodeIds":[130230114]},{"nodeId":130230114,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":1966602234,"text":"You'll have to blame that on my financial freedom.","nextNodeIds":[130230115]},{"nodeId":130230115,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3277182786,"text":"Fine, go ahead and hide behind your financial success if you want. But if we forget Mora for a second, do you have anything of true value to boast about?","nextNodeIds":[130230116]},{"nodeId":130230116,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":1742300458,"text":"I think I'd have too many choices, to be honest. You, on the other hand... can you think of any redeeming features at all?","nextNodeIds":[130230117]},{"nodeId":130230117,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":224779754,"text":"Artistry, for sure! You don't know the first thing about interior design. Don't go off buying random furniture unless you take me with you!","nextNodeIds":[130230118]},{"nodeId":130230118,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":321471802,"text":"So I'll have to bring you along and then buy you drinks?","nextNodeIds":[130230119]},{"nodeId":130230119,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1567990026,"text":"Of course!","nextNodeIds":[130230120]},{"nodeId":130230120,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":2687073506,"text":"But why would I do that? It would just be another form of a loan, and you'd have to pay me back eventually.","nextNodeIds":[130230121]},{"nodeId":130230121,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":4071316626,"text":"Can't you just be nice and not ask for the Mora back?","nextNodeIds":[130230122]},{"nodeId":130230122,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":1031726602,"text":"Pretending that you're not in debt is as ridiculous as pretending you're not living in someone else's home. Word will get out sooner or later.","nextNodeIds":[130230123]},{"nodeId":130230123,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2669158890,"text":"Speaking of which, your friends won't say anything, right? Tell them to keep all this a secret.","nextNodeIds":[130230124]},{"nodeId":130230124,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":3343496090,"text":"There's no need to hide it so carefully — I think the truth's already out. You're such a lightweight that a few drinks at the tavern had you spilling all your beans.","nextNodeIds":[130230125]},{"nodeId":130230125,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2994109138,"text":"What? ...No, it can't be...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1079,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":1302303,"order":8,"stepDescription":"","stepDescTextMapHash":1647580956,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1079,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1079,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[3,100],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q1302217_Q1302218_N1053"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_