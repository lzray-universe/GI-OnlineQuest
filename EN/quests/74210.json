ONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7413612,"initDialog":741361201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5257,1005],"performCfg":"QuestDialogue/WQ/Fontaine_74136/Q7413612","priority":3,"questId":74210,"showRandomTalkCount":0},"dialogs":[{"nodeId":741361201,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":934332866,"text":"Any questions? Honorary Senior Researcher?","nextNodeIds":[741361202,741361208,741361220]},{"nodeId":741361202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3001379682,"text":"What will happen to Nacker and Edwin?","nextNodeIds":[741361203]},{"nodeId":741361203,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4140570098,"text":"They will temporarily stay at the Fortress of Meropide where they will repent for their misconduct.","nextNodeIds":[741361204]},{"nodeId":741361204,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2920522338,"text":"That said, the Edwin I know doesn't do \"repent.\"","nextNodeIds":[741361205]},{"nodeId":741361205,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4226080378,"text":"No matter, as long as Edwin is kept away from research equipment and Arkhium.","nextNodeIds":[741361206]},{"nodeId":741361206,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4170706330,"text":"As for Nacker... I don't believe he'll cause more trouble for us.","nextNodeIds":[741361207]},{"nodeId":741361207,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":476871826,"text":"I... I can only hope I don't run into situations that would require their expertise...","nextNodeIds":[]},{"nodeId":741361208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3065523106,"text":"Did Fusilier use to worship Edwin?","nextNodeIds":[741361209]},{"nodeId":741361209,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3881957290,"text":"...Edwin Eastinghouse is a genius. People in the same field either gave up on themselves or became his followers.","nextNodeIds":[741361210]},{"nodeId":741361210,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1856835906,"text":"Miss Fusilier is a very passionate and creative researcher, often achieving great results with minimal resources.","nextNodeIds":[741361211]},{"nodeId":741361211,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":356546618,"text":"After joining the Tech Sect III of the Arkhium Research Project, she was put in charge of the structural design of the suppressor and had frequent run-ins with Edwin.","nextNodeIds":[741361212]},{"nodeId":741361212,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2346774610,"text":"Maybe that's when she started idolizing Edwin. Just like the other followers, Edwin's approval became her only pursuit.","nextNodeIds":[741361213]},{"nodeId":741361213,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2429701066,"text":"After the explosion, she refused to believe that Edwin was the one who caused it, so she applied to join the investigation in an attempt to clear Edwin's name.","nextNodeIds":[741361214]},{"nodeId":741361214,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1201114514,"text":"Now that you've dealt with Edwin, what do you make of him?","nextNodeIds":[741361215]},{"nodeId":741361215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2067712938,"text":"A freak of nature who cares only for his research! He always tries to push the blame to others, and he can't even remember Miss Fusilier's name!","nextNodeIds":[741361216]},{"nodeId":741361216,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":67716146,"text":"That sounds like him, all right. Other than his research, there's rarely anything that's worth a second of his attention.","nextNodeIds":[741361217]},{"nodeId":741361217,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":988550314,"text":"And he cares for nothing else as long as his research runs smoothly. Not even when his own subordinates stole the Institute's assets to sell.","nextNodeIds":[741361218]},{"nodeId":741361218,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1663170906,"text":"I only approved Fusilier's application to join the investigation... so she would come to realize she was chasing an image of him she fabricated.","nextNodeIds":[741361219]},{"nodeId":741361219,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2818778106,"text":"Now that image has finally been shattered, I can only hope she picks herself up soon... The Fontaine Research Institute cannot afford to lose more of its people.","nextNodeIds":[]},{"nodeId":741361220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4117978002,"text":"Goodbye.","nextNodeIds":[741361221]},{"nodeId":741361221,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2657828122,"text":"Goodbye, Honorary Senior Researcher.","nextNodeIds":[]}]},{"talkId":7413613,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7413611","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7413613,"initDialog":741361301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5258],"performCfg":"","priority":3,"questId":74210,"showRandomTalkCount":0},"dialogs":[{"nodeId":741361301,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":1413441202,"text":"Phew... It's okay. It's okay. The nightmare is over.","nextNodeIds":[741361302,741361305,741361309]},{"nodeId":741361302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3459260218,"text":"How do you feel about Edwin's \"coming back to life\"?","nextNodeIds":[741361303]},{"nodeId":741361303,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":2598753674,"text":"Whoa! You scared me! How I feel? Nothing, to be honest. I only hope that irresponsible scoundrel pays for what he's done!","nextNodeIds":[741361304]},{"nodeId":741361304,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":1064487650,"text":"Personally, I'd tie his hands and legs up and blindfold him to stop him from getting his hands on Arkhium if I could!","nextNodeIds":[]},{"nodeId":741361305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1761765362,"text":"Do you feel relieved, now?","nextNodeIds":[741361306]},{"nodeId":741361306,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":109242522,"text":"A bit more relieved, yes, compared to before.","nextNodeIds":[741361307]},{"nodeId":741361307,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":3493594802,"text":"But, to be honest, locking Nacker and Edwin up together? Gosh! I can't even imagine what those two would be up to!","nextNodeIds":[741361308]},{"nodeId":741361308,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":20968810,"text":"Explosion has been past and done. So what's next? Flooding the entire Fontaine with Fonta? I can't even imagine...","nextNodeIds":[]},{"nodeId":741361309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1111882426,"text":"I hope you have a good day.","nextNodeIds":[741361310]},{"nodeId":741361310,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":1625022826,"text":"You too, Honorary Senior Researcher.","nextNodeIds":[]}]},{"talkId":7413614,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7413611","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7413614,"initDialog":741361401,"nextRandomTalks":[],"nextTalks":[],"npcId":[5275,5274,5273,1005],"performCfg":"QuestDialogue/WQ/Fontaine_74136/Q7413614","priority":3,"questId":74210,"showRandomTalkCount":0},"dialogs":[{"nodeId":741361401,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"Fusilier","textMapHash":3825626,"text":"No value... My research has no value...","nextNodeIds":[741361402]},{"nodeId":741361402,"roleType":"TALK_ROLE_NPC","speakerId":5274,"speakerName":"Lemarcq","textMapHash":1407651314,"text":"Miss, please don't think that way. Your invention saved my life.","nextNodeIds":[741361403]},{"nodeId":741361403,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"Fusilier","textMapHash":883481866,"text":"But... But... Mr. Edwin... *whimper* *sob* Edwin said this thing is worthless...","nextNodeIds":[741361404]},{"nodeId":741361404,"roleType":"TALK_ROLE_NPC","speakerId":5273,"speakerName":"Chaussivert","textMapHash":4034891298,"text":"That just means that that Edwin's blind! This thing is a treasure! Worthless? Ha! I'd give an arm to have one for each of my men!","nextNodeIds":[741361405]},{"nodeId":741361405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1886215570,"text":"Edwin's a bad person. He's full of baloney.","nextNodeIds":[741361406]},{"nodeId":741361406,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"Fusilier","textMapHash":1106405298,"text":"Mr. Edwin is not a bad person! He... He... Anyway... He can't even remember my name! I even showed him my designs so many times...","nextNodeIds":[741361407]},{"nodeId":741361407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2501965130,"text":"Miss Fusilier, you are very talented! Why do you let that Edwin guy judge your worth?","nextNodeIds":[741361408]},{"nodeId":741361408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":925418674,"text":"He doesn't see what I see in you!","nextNodeIds":[741361409]},{"nodeId":741361409,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"Fusilier","textMapHash":1855122282,"text":"R—Really?","nextNodeIds":[741361410]},{"nodeId":741361410,"roleType":"TALK_ROLE_NPC","speakerId":5273,"speakerName":"Chaussivert","textMapHash":464102266,"text":"Of course. Take it from all of us.","nextNodeIds":[741361411]},{"nodeId":741361411,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"Fusilier","textMapHash":2304866602,"text":"But... you don't know research... *sobs*","nextNodeIds":[741361412]},{"nodeId":741361412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1955551074,"text":"Miss Fusilier... she's no longer coherent. I think we better leave her alone for a bit...","nextNodeIds":[741361413]},{"nodeId":741361413,"roleType":"TALK_ROLE_NPC","speakerId":5273,"speakerName":"Chaussivert","textMapHash":3669097506,"text":"Okay... Lemarcq and I will be right here. Call us if you need anything.","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7413612,7413613,7413614],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"Fusilier","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":5273,"speakerName":"Chaussivert","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":5274,"speakerName":"Lemarcq","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3545495494,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74136/Q7413612","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":3,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":741361201,"ILHDCGDKKKA":"TALK_HERO_LOCAL","ILHDNJDDEOP":7413612,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGM