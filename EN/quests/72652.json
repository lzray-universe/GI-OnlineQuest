{"mainQuestId":72652,"title":"Voyage Prep","description":"The Chief Technical Officer of the Crux Fleet has something she needs your help with...","titleTextMapHash":2789211351,"descTextMapHash":654642086,"mainQuestExcel":{"mainQuestId":72652,"titleTextMapHash":2789211351,"title":"Voyage Prep","descTextMapHash":654642086,"description":"The Chief Technical Officer of the Crux Fleet has something she needs your help with...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2006,"luaPath":"Actor/Quest/WQ72652","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2006,"chapterId":0,"descTextMapHash":654642086,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72652,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3638591521,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72652","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172652],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2789211351,"type":"WQ","unlockDescTextMapHash":862554150}},"flow":[{"subQuestId":7265201,"order":1,"stepDescription":"Talk to the Crux Fleet crew member","stepDescTextMapHash":2097721236,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3005501"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7265201],"talks":[{"talkId":7265201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7265201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7265201,"initDialog":726520101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3005501],"performCfg":"QuestDialogue/WQ/Daoqi_72652/Q7265201","priority":5,"questId":72652,"showRandomTalkCount":0},"dialogs":[{"nodeId":726520101,"roleType":"TALK_ROLE_NPC","speakerId":3005501,"speakerName":"???","textMapHash":943510650,"text":"Ho there, Traveler! How've you been? Interested in doing some work for the Crux Fleet?","nextNodeIds":[726520102,726520103]},{"nodeId":726520102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2264753290,"text":"The Crux Fleet...?","nextNodeIds":[726520104]},{"nodeId":726520104,"roleType":"TALK_ROLE_NPC","speakerId":3005501,"speakerName":"???","textMapHash":2735474338,"text":"Eh? Oh, right! Haha, my apologies.","nextNodeIds":[726520105]},{"nodeId":726520105,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":901061186,"text":"I'm Muzhen, Chief Technical Officer of the Alcor. I spend most of my time below deck, so it's no surprise that you're not familiar with me.","nextNodeIds":[726520106]},{"nodeId":726520106,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2831034154,"text":"Well, Sea Drake kicked me out and made me come outside, haha.","nextNodeIds":[726520107]},{"nodeId":726520107,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2877079714,"text":"\"Move those lazy bones of yours and go get some sun, it'll do you good!,\" he said. So here I am, on shore, thanks to him...","nextNodeIds":[726520108]},{"nodeId":726520108,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1118744154,"text":"Hah! Not that he'd get off the boat himself though! Why, he'd faint the moment he sets foot on dry land.","nextNodeIds":[726520109,726520110]},{"nodeId":726520109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3670004010,"text":"Oh...","nextNodeIds":[726520111]},{"nodeId":726520111,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1432826,"text":"Ah, yes. How rude of me to forget about the real business while making fun of someone else.","nextNodeIds":[726520112]},{"nodeId":726520112,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1227344858,"text":"Well, I've got some technical preparation-related errands that you can run to help prepare for the next leg of Captain Beidou's journey.","nextNodeIds":[726520113]},{"nodeId":726520113,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":3764707058,"text":"These things are usually handled by the Captain herself. The person in command of The Crux must have the pioneering spirit to explore the unknown...","nextNodeIds":[726520114]},{"nodeId":726520114,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1218731906,"text":"This is our rule, after all, and whoever is the boss will have to take up such duties.","nextNodeIds":[726520115]},{"nodeId":726520115,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":379021690,"text":"Still, the Captain has priority matters she needs to attend to at the moment. Certainly not matters that should be delayed by a few small odd jobs.","nextNodeIds":[726520116]},{"nodeId":726520116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1321584530,"text":"So you're pushing them off to us, then?","nextNodeIds":[726520117]},{"nodeId":726520117,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2713793810,"text":"Well, y'see, I'm a Technical Officer, not a fighter... And it's not as if the rest of the crew don't have things to do. No one's got the time to spare.","nextNodeIds":[726520118]},{"nodeId":726520118,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2347005378,"text":"Well then. That's all for the chit-chat. Here's the skinny...","nextNodeIds":[726520119]},{"nodeId":726520119,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":589932858,"text":"The person who ordered our next shipment wants some samples... Specifically, samples of components from some special Ruin machines.","nextNodeIds":[726520120]},{"nodeId":726520120,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1002387698,"text":"According to the eyewitness reports this particular employer sent us, these machines... or organisms, are hidden throughout the islands of Inazuma. Very fascinating beings.","nextNodeIds":[726520121,726520125,726520130]},{"nodeId":726520121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2790452594,"text":"And who might this employer be...?","nextNodeIds":[726520122]},{"nodeId":726520122,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":3521160826,"text":"Oh ho? Trying to get me to spill the beans on our trade secrets huh?","nextNodeIds":[726520123]},{"nodeId":726520123,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":4024029178,"text":"Haha! Not to worry. I'd be more than happy to tell you if I knew... even though technically speaking, it'd be a capital offense.","nextNodeIds":[726520124]},{"nodeId":726520124,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2436754218,"text":"I don't know who our employer is, anyway, so you'll have to excuse me. It's not something you should be concerned about, anyway.","nextNodeIds":[726520134]},{"nodeId":726520134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4237457850,"text":"So, where do we find them?","nextNodeIds":[726520135]},{"nodeId":726520135,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1107356850,"text":"Hah! See, now you're the asking the right questions.","nextNodeIds":[726520136]},{"nodeId":726520136,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":361086906,"text":"Trouble is that I've got no clue where they are either.","nextNodeIds":[726520137]},{"nodeId":726520137,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2828405418,"text":"However, we've discovered strange Electro phenomena occurring in some regions of the islands. According to my observations, there is a huge gap in frequency between occurrences of such phenomena in these places compared to others across Inazuma.","nextNodeIds":[726520138]},{"nodeId":726520138,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1218171466,"text":"I would hazard a guess that we're most likely to find good leads if we investigate these anomalous areas first.","nextNodeIds":[726520139]},{"nodeId":726520139,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1922475698,"text":"Should you find any by-products from those phenomena, please bring them back here for me to study.","nextNodeIds":[726520140]},{"nodeId":726520140,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2362733426,"text":"As for remuneration, don't worry, I've got you covered on that front.","nextNodeIds":[]},{"nodeId":726520125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1562610066,"text":"Mechanical organisms?","nextNodeIds":[726520126]},{"nodeId":726520126,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1123355674,"text":"Aye. The miners at The Chasm once dug up similar things. Word is that they're related to the disaster that happened five hundred years ago.","nextNodeIds":[726520127]},{"nodeId":726520127,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":276012946,"text":"Whatever the case, they're an ominous bunch, wandering through the ruins as they do. Gets me scared and excited all at once...","nextNodeIds":[726520128]},{"nodeId":726520128,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2782640018,"text":"Just thinking about one of them makes my hands itch. Wish I could pry one open and have a look inside...","nextNodeIds":[726520129]},{"nodeId":726520129,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2832823874,"text":"It's alright if you don't understand. You're not a technician, after all.","nextNodeIds":[726520134]},{"nodeId":726520130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2894306378,"text":"Interesting, you say...","nextNodeIds":[726520131]},{"nodeId":726520131,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":133707266,"text":"Well, I mean... Wouldn't you want to open one up yourself?","nextNodeIds":[726520132]},{"nodeId":726520132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4011626146,"text":"Not... really...?","nextNodeIds":[726520133]},{"nodeId":726520133,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":4257042882,"text":"Hmph. Alright then... I guess only a fellow technician would understand how I feel.","nextNodeIds":[726520134]},{"nodeId":726520110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":577984386,"text":"Do you need a hand with anything?","nextNodeIds":[726520111]},{"nodeId":726520103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3435112562,"text":"Do I know you?","nextNodeIds":[726520104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUES