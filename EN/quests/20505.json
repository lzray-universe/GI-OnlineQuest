performCfg":"","priority":8,"questId":20505,"showRandomTalkCount":0},"dialogs":[{"nodeId":205050201,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3665611401,"text":"You can dispatch someone on an expedition at any time, and they will still be able to join you in your adventures should you need them.","nextNodeIds":[205050202]},{"nodeId":205050202,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2599287169,"text":"You can also choose the length of time for the expedition. After your friend returns, just come here and confirm the outcome.","nextNodeIds":[205050203]},{"nodeId":205050203,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1823606129,"text":"As your Adventure Rank increases, more dangerous expeditions will become available to you.","nextNodeIds":[205050204]},{"nodeId":205050204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":732475521,"text":"After all, with epic power comes epic responsibility!","nextNodeIds":[205050205]},{"nodeId":205050205,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3139861105,"text":"And of course, matching risk with experience is also for everyone's safety.","nextNodeIds":[205050206]},{"nodeId":205050206,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2205268257,"text":"Thanks again for your help. I hope you and your friends can help out with our expeditions as much as possible.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2050502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT",