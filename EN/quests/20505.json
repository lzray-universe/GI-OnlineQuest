{"mainQuestId":20505,"title":"Busy Adventurers' Guild","description":"The Adventurers' Guild is taking on a growing number of commissions, and Katheryne is finding it hard to keep up.","titleTextMapHash":26918801,"descTextMapHash":353487287,"mainQuestExcel":{"mainQuestId":20505,"titleTextMapHash":26918801,"title":"Busy Adventurers' Guild","descTextMapHash":353487287,"description":"The Adventurers' Guild is taking on a growing number of commissions, and Katheryne is finding it hard to keep up.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/IQ20505","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":353487287,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":20505,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2067535799,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ20505","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":26918801,"type":"WQ","unlockDescTextMapHash":2109433875}},"flow":[{"subQuestId":2050501,"order":1,"stepDescription":"Talk to Katheryne","stepDescTextMapHash":1998843192,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2050501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2050501],"talks":[{"talkId":2050501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["2050501","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2050501,"initDialog":205050101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1512],"performCfg":"","priority":8,"questId":20505,"showRandomTalkCount":0},"dialogs":[{"nodeId":205050101,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3273419705,"text":"Sorry to bother you again.","nextNodeIds":[205050102,205050104]},{"nodeId":205050102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1433532009,"text":"No problem, I've been well looked after.","nextNodeIds":[205050103]},{"nodeId":205050103,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2549388633,"text":"I am delighted to hear that. In which case, let me try to make this quick...","nextNodeIds":[205050106]},{"nodeId":205050106,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1887902657,"text":"We are most grateful for your commission completion to date. The guild's reputation has grown stronger as a result.","nextNodeIds":[205050107]},{"nodeId":205050107,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":4133964249,"text":"However, another consequence is that we are receiving an unprecedented number of requests — more than our current numbers can handle.","nextNodeIds":[205050108]},{"nodeId":205050108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":112245489,"text":"You want us to do some recruitment for you?","nextNodeIds":[205050109]},{"nodeId":205050109,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2285333249,"text":"Ahh... No. Although I appreciate the offer — it would be fantastic to have some new members...","nextNodeIds":[205050110]},{"nodeId":205050110,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":507942609,"text":"But scrambling to officially recruit new members at this stage would not really solve our immediate problems.","nextNodeIds":[205050111]},{"nodeId":205050111,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":41270513,"text":"So what I want to ask is — Would your friends have the time to help out?","nextNodeIds":[205050112,205050114]},{"nodeId":205050112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":60050505,"text":"I'll need to check with them.","nextNodeIds":[205050113]},{"nodeId":205050113,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2467986353,"text":"Great, please do. Thank you!","nextNodeIds":[205050117]},{"nodeId":205050117,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3169930217,"text":"Right now, we urgently need to find people for our <color=#00E1FFFF>expeditions</color>.","nextNodeIds":[205050118]},{"nodeId":205050118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":852251953,"text":"Expeditions?","nextNodeIds":[205050119]},{"nodeId":205050119,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1132483873,"text":"We organize expeditions to explore areas around the city and in the wilderness. It is a way to keep ourselves informed of any emerging dangers, unusual activity in the domains, and so on.","nextNodeIds":[205050120]},{"nodeId":205050120,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":959216073,"text":"Since expeditions are not commissioned by a third party, there are no strict deadlines for completion.","nextNodeIds":[205050121]},{"nodeId":205050121,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2059797945,"text":"However, we neglect them at our peril. If trouble were to foment unchecked, it could easily turn into a major disaster.","nextNodeIds":[205050122]},{"nodeId":205050122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":537905937,"text":"Pretty important then!","nextNodeIds":[205050123,205050125]},{"nodeId":205050123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2760593993,"text":"I'm sure my friends will understand.","nextNodeIds":[205050124]},{"nodeId":205050124,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":151333321,"text":"All you need to do is convince them to help. I will take care of all the details.","nextNodeIds":[205050127]},{"nodeId":205050127,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2609024641,"text":"Now, without further ado, let me show you the expeditions that are currently available.","nextNodeIds":[205050128]},{"nodeId":205050128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2832253617,"text":"Check Expeditions","nextNodeIds":[]},{"nodeId":205050125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3383169937,"text":"What about compensation?","nextNodeIds":[205050126]},{"nodeId":205050126,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1542886321,"text":"Rest assured that the Guild does not take a cut of the spoils from expeditions. Everything goes to you and your friends.","nextNodeIds":[205050127]},{"nodeId":205050114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1121040681,"text":"You want me to convince all my friends to join the Guild?","nextNodeIds":[205050115]},{"nodeId":205050115,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":992432145,"text":"No no, that is not what I meant. I know that your friends come from all walks of life, and asking them to become official members may be impractical.","nextNodeIds":[205050116]},{"nodeId":205050116,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1773432257,"text":"My request is of the more presumptuous kind... The Guild needs a favor.","nextNodeIds":[205050117]},{"nodeId":205050104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2065908865,"text":"There's a new reward up for grabs?","nextNodeIds":[205050105]},{"nodeId":205050105,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3995187217,"text":"Hahaha... Bingo! And I presume you are interested.","nextNodeIds":[205050106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2050501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJ