{"mainQuestId":22006,"title":"The Lost Relic","description":"Bao'er claims to have lost a precious relic and is now frantically searching high and low for it. Perhaps she could use a hand...","titleTextMapHash":2682830857,"descTextMapHash":3291343567,"mainQuestExcel":{"mainQuestId":22006,"titleTextMapHash":2682830857,"title":"The Lost Relic","descTextMapHash":3291343567,"description":"Bao'er claims to have lost a precious relic and is now frantically searching high and low for it. Perhaps she could use a hand...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ22006","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3291343567,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":22006,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3899075639,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ22006","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":26801,"titleTextMapHash":2682830857,"type":"IQ","unlockDescTextMapHash":1500476355}},"flow":[{"subQuestId":2200601,"order":1,"stepDescription":"Talk to Bao'er","stepDescTextMapHash":3281793194,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2421"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2200601],"talks":[{"talkId":2200601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200601","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200601,"initDialog":220060101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2421],"performCfg":"","priority":3,"questId":22006,"showRandomTalkCount":0},"dialogs":[{"nodeId":220060101,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":3490881277,"text":"I can't find it anywhere...","nextNodeIds":[220060102]},{"nodeId":220060102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3304728413,"text":"What did you lose this time...","nextNodeIds":[220060103]},{"nodeId":220060103,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":754200077,"text":"Oh, this time I haven't lost anything yet — I'm still looking for it! But I can't find it anywhere...","nextNodeIds":[220060104]},{"nodeId":220060104,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":2471417781,"text":"Where could it be? After all the effort I've gone to to confirm its whereabouts...","nextNodeIds":[220060105]},{"nodeId":220060105,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":930134349,"text":"Help me search for it, would you? We can't let something like this stay lost!","nextNodeIds":[220060106,220060107]},{"nodeId":220060106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2467744589,"text":"Alright...","nextNodeIds":[220060108]},{"nodeId":220060108,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":1483315397,"text":"Okay, you take that side, I'll take this side.","nextNodeIds":[220060109]},{"nodeId":220060109,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":3223162421,"text":"We have to find it!","nextNodeIds":[]},{"nodeId":220060107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2446268597,"text":"What kind of relic is it this time?","nextNodeIds":[220060110]},{"nodeId":220060110,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":1254209797,"text":"It's... uh, it's an... It's really ancient, anyway! Dates back a thousand— no, all the way back to the Archon War, in fact.","nextNodeIds":[220060111]},{"nodeId":220060111,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":3641471629,"text":"Basically, it's a very precious relic and it simply cannot stay lost! So help me find it.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133104502,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,