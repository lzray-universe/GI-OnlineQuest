AL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200606,"initDialog":220060601,"nextRandomTalks":[],"nextTalks":[],"npcId":[2421],"performCfg":"","priority":3,"questId":22006,"showRandomTalkCount":0},"dialogs":[{"nodeId":220060601,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":4182469453,"text":"What took you so long? Did you find anything?","nextNodeIds":[220060602,220060603]},{"nodeId":220060602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3966429765,"text":"I found this.","nextNodeIds":[220060604]},{"nodeId":220060604,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":552865501,"text":"Huh... It's not bad, but... It doesn't look anything like the one I was looking for.","nextNodeIds":[220060605]},{"nodeId":220060605,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":3926668549,"text":"Still, a relic is a relic, so I'll take care of it. Don't worry, I'll see it gets put to good use.","nextNodeIds":[220060609]},{"nodeId":220060609,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":1475318253,"text":"Thanks for your help. In return, take these.","nextNodeIds":[220060610]},{"nodeId":220060610,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":1051101445,"text":"*sigh* But that other lost relic, I hope it's okay...","nextNodeIds":[]},{"nodeId":220060603,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1224920557,"text":"Is this what you were looking for?","nextNodeIds":[220060606]},{"nodeId":220060606,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":820008333,"text":"It's a nice item, but not the one I was looking for.","nextNodeIds":[220060607]},{"nodeId":220060607,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":1693237693,"text":"Wait, you don't know how to take proper care of relics, do you? You might damage it.","nextNodeIds":[220060608]},{"nodeId":220060608,"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","textMapHash":4178895733,"text":"Best if I take care of it. I'll make sure it's put to good use.","nextNodeIds":[220060609]}]},{"talkId":2200607,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200606","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200607,"initDialog":220060701,"nextRandomTalks":[],"nextTalks":[],"npcId":[2211],"performCfg":"","priority":3,"questId":22006,"showRandomTalkCount":0},"dialogs":[{"nodeId":220060701,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":1225904605,"text":"Fortunately, the jade plate is undamaged.","nextNodeIds":[220060702,220060706]},{"nodeId":220060702,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":98132829,"text":"Why didn't you just give it to them?","nextNodeIds":[220060703]},{"nodeId":220060703,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":895928653,"text":"A relic should be for scholars to study, for artists to take inspiration from, for people to admire in an exhibition...","nextNodeIds":[220060704]},{"nodeId":220060704,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":373824117,"text":"It must never be given to thieves to sell for petty cash. As well as dishonoring a precious relic, it's trampling all over history.","nextNodeIds":[220060705]},{"nodeId":220060705,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2399331829,"text":"I refuse to back down before people who treat history, and its relics, like trash.","nextNodeIds":[]},{"nodeId":220060706,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2890348717,"text":"I want to know more about the jade plate.","nextNodeIds":[220060707]},{"nodeId":220060707,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":336395845,"text":"Oh, it's piqued your interest, has it? Well answer me this — are you interested in its cultural value, or its monetary value?","nextNodeIds":[220060708]},{"nodeId":220060708,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":1985369149,"text":"I'm joking. This jade plate records an event from the Archon War — a clash of clans, if I'm not mistaken.","nextNodeIds":[220060709]},{"nodeId":220060709,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2600335981,"text":"If I can decipher it, maybe I can fill in some of the gaps in Sumeru Akademiya's records.","nextNodeIds":[220060710]},{"nodeId":220060710,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":3277139077,"text":"Or maybe those gaps have been filled in already, I'm just not allowed to know about them...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200606,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["26801"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"},{"LNHLPKELCAL":["100500"],"PAINLIBBLDK":"QUEST_EXEC_DEL_ALL_SPECIFIC_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["2421"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2200601,2200602,2200603,2200604,2200605,2200606,2200607],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","count":31},{"roleType":"TALK_ROLE_NPC","speakerId":2421,"speakerName":"Bao'er","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":13}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":true,"CBBBCAKOFGO":3291343567,"CHECNJEMEFE":{"2211":[1070,1260,1280],"2421":[1070,1260,1280]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":3,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":220060101,"ILHDCGDKKKA":"TALK_HERO_LOCAL","ILHDNJDDEOP":2200601,"JGFEJPBPHGJ