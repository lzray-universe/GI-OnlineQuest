"BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q22006SoRaYaInitPos","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1331045022"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q22006SoRaYaInitPos","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":2200604,"order":4,"stepDescription":"Talk to Soraya","stepDescTextMapHash":4274890274,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["2211"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2200603],"talks":[{"talkId":2200603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200604","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200603,"initDialog":220060301,"nextRandomTalks":[],"nextTalks":[],"npcId":[2211],"performCfg":"QuestDialogue/IQ/Liyue_22006/Q2200603","priority":3,"questId":22006,"showRandomTalkCount":0},"dialogs":[{"nodeId":220060301,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":664274317,"text":"Thank you, Traveler! That was terrifying... the Treasure Hoarders are such savages these days.","nextNodeIds":[220060302]},{"nodeId":220060302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3456434709,"text":"Who are you?","nextNodeIds":[220060303]},{"nodeId":220060303,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":412568181,"text":"I'm Soraya, a visiting scholar. I'm actually doing some research as we speak.","nextNodeIds":[220060304]},{"nodeId":220060304,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2945715693,"text":"A few days ago I followed a trail of clues to a ruin, where I found a jade plate that recorded details from the Archon War.","nextNodeIds":[220060305]},{"nodeId":220060305,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":3844498989,"text":"But I was ambushed by the Treasure Hoarders on my way out. I tried to run away, but they caught up with me...","nextNodeIds":[220060306]},{"nodeId":220060306,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":3891714309,"text":"If not for you, both I and the jade plate would have been in big trouble. So thanks again.","nextNodeIds":[220060307]},{"nodeId":220060307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1185402429,"text":"You're a scholar, too?","nextNodeIds":[220060308]},{"nodeId":220060308,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2944780685,"text":"...You mean, you've met other scholars around here? Like who?","nextNodeIds":[220060309]},{"nodeId":220060309,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":1074673285,"text":"Bao'er...? Wait a second... Just now, when I was ambushed by the Treasure Hoarders, I heard someone complaining about Bao'er hogging all the treasure.","nextNodeIds":[220060310]},{"nodeId":220060310,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":506432205,"text":"What a strange coincidence... Could you tell me a little more about the Bao'er you met?","nextNodeIds":[220060311]},{"nodeId":220060311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4289394973,"text":"Here's what I remember...","nextNodeIds":[220060312]},{"nodeId":220060312,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":533161493,"text":"...Hmm. The locations Bao'er pointed out to you are the same ones I was targeting. Maybe this coincidence is not so coincidental after all...","nextNodeIds":[220060313]},{"nodeId":220060313,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":1021544485,"text":"If she really is with the Treasure Hoarders, then I suspect they must have been following me around for some time... Hoping to get at some fresh ruin treasure via me.","nextNodeIds":[220060314]},{"nodeId":220060314,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2012968805,"text":"Bao'er wanted it all for herself, so she split off from the group and tried to get ahead. But this area is much too big for one person to search, so...","nextNodeIds":[220060315]},{"nodeId":220060315,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2498164949,"text":"It seems like she used you, Traveler. And I'll bet that she had her eyes set on this location for a long time — it's just her comrades and I got there before you did.","nextNodeIds":[220060316]},{"nodeId":220060316,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":3615255453,"text":"Don't be alarmed, this is still just guesswork. But Bao'er... it's just a suspicious-sounding name. It could just be a fake name, or maybe a codename.","nextNodeIds":[220060317]},{"nodeId":220060317,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":562153725,"text":"Traveler, could you throw her off the scent? Whatever happens, this jade plate cannot get into the wrong hands.","nextNodeIds":[220060318,220060319]},{"nodeId":220060318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":648639781,"text":"Sure.","nextNodeIds":[220060320]},{"nodeId":220060320,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2182134133,"text":"Thank you. Although, she'd probably sense something was up if you went back empty-handed.","nextNodeIds":[220060321]},{"nodeId":220060321,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2221514045,"text":"How about this — here's a little something you can give her instead.","nextNodeIds":[220060322]},{"nodeId":220060322,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2807631029,"text":"Barely enough for her to make a profit on. But hopefully enough to avoid her suspicion for now.","nextNodeIds":[220060325]},{"nodeId":220060325,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":1133448957,"text":"Okay, you'd best get back. You may have just beaten the living daylights out of her comrades, but if she's traveling alone she shouldn't get word of it right away.","nextNodeIds":[220060326]},{"nodeId":220060326,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":3117612893,"text":"Oh, and if you find something on any of her future treasure hunts, you can bring it to me. I'm usually at the Wangshu Inn.","nextNodeIds":[220060327]},{"nodeId":220060327,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":1038597125,"text":"*sigh* ...I might not be good for a lot of things, but if I can keep a historical relic safe then at least that's something.","nextNodeIds":[]},{"nodeId":220060319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2742489949,"text":"If I return empty-handed, she'll get suspicious...","nextNodeIds":[220060323]},{"nodeId":220060323,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":1539135541,"text":"Good point... In that case, take this. It's nothing of anything value, really.","nextNodeIds":[220060324]},{"nodeId":220060324,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"Soraya","textMapHash":2273625309,"text":"Barely enough for her to make a profit on. But hopefully enough to avoid her suspicion for now.","nextNodeIds":[220060325]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLH