{"mainQuestId":74172,"title":"","description":"","titleTextMapHash":3326649879,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":74172,"titleTextMapHash":3326649879,"title":"","descTextMapHash":3650059142,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ74172","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3650059142,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74172,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1519355873,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74172","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3326649879,"type":"WQ","unlockDescTextMapHash":3462372918}},"flow":[{"subQuestId":7417201,"order":1,"stepDescription":"","stepDescTextMapHash":1528475060,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7417201,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7405389,7405391],"talks":[{"talkId":7405389,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7417201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7405389,"initDialog":740538901,"nextRandomTalks":[],"nextTalks":[],"npcId":[5257],"performCfg":"QuestDialogue/WQ/Fontaine_74053/Q7405389","priority":5,"questId":74172,"showRandomTalkCount":0},"dialogs":[{"nodeId":740538901,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4234452026,"text":"Is there something I can help you with?","nextNodeIds":[740538902,740538917,740538930,740538946,740538949,740538968]},{"nodeId":740538902,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3741893322,"text":"Why do you think that Nacker is still alive?","nextNodeIds":[740538903]},{"nodeId":740538903,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":81710890,"text":"Considering the interests of the Institute and my personal point of view...","nextNodeIds":[740538904]},{"nodeId":740538904,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":349636594,"text":"I do, in fact, hope that both he and that Arkhium Kinetic Core were obliterated in that explosion.","nextNodeIds":[740538905]},{"nodeId":740538905,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3376612346,"text":"That would mean that the last traces of Edwin Eastinghouse's influence here would be gone for good.","nextNodeIds":[740538906]},{"nodeId":740538906,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":858346314,"text":"But like I said earlier, that explosion was actually a small-scale Arkhium fragment resonance.","nextNodeIds":[740538907]},{"nodeId":740538907,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":508015690,"text":"Moreover... most of the Arkhium fragments in the explosion radius were ore waste that have been fully depleted of energy.","nextNodeIds":[740538908]},{"nodeId":740538908,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1353659098,"text":"Logically speaking, even if a large Arkhium chunk had gone out of control, causing the ore waste to resonate, such a violent explosion should not have occurred.","nextNodeIds":[740538909]},{"nodeId":740538909,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1122020058,"text":"The only possibility is that someone specially collected Arkhium that has not been depleted from other areas and piled them here.","nextNodeIds":[740538910]},{"nodeId":740538910,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1706887482,"text":"They then overloaded that large Arkhium chunk on purpose to create an Arkhium resonance, so as to trigger an explosion to cover up certain traces that would've existed otherwise.","nextNodeIds":[740538911]},{"nodeId":740538911,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4284908770,"text":"Nacker has always conducted research with Edwin and has a good understanding of the nature of Arkhium. It wouldn't take him much effort to do something like this.","nextNodeIds":[740538912]},{"nodeId":740538912,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":904033042,"text":"Still, that's just my preliminary conjecture. As for what happens next... we'll need to wait for the research institute to conduct a more detailed investigation.","nextNodeIds":[740538913]},{"nodeId":740538913,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3427219922,"text":"But why did he steal this core?","nextNodeIds":[740538914]},{"nodeId":740538914,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":943573562,"text":"This Arkhium Kinetic Core is the most cutting-edge technology created by the Fontaine Research Institute to date.","nextNodeIds":[740538915]},{"nodeId":740538915,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1401886658,"text":"It wouldn't be a bad idea to sell it or use it in the development of another project, hmph...","nextNodeIds":[740538916]},{"nodeId":740538916,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":951595010,"text":"But considering his level of academic expertise... I would rather he sell this Arkhium Kinetic Core for a good price.","nextNodeIds":[]},{"nodeId":740538917,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2771960226,"text":"About the Arkhium Kinetic Core...","nextNodeIds":[740538918]},{"nodeId":740538918,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":782254442,"text":"Before we discuss this further, I believe Nacker or Ms. Chronie must have mentioned something to you already.","nextNodeIds":[740538919]},{"nodeId":740538919,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":554782650,"text":"They must have told you that my research projects and those of Edwin Eastinghouse had some overlap.","nextNodeIds":[740538920]},{"nodeId":740538920,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1804585530,"text":"But this is not entirely accurate... In fact, this Arkhium Kinetic Core is the fruit of my joint research with him.","nextNodeIds":[740538921]},{"nodeId":740538921,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2866749474,"text":"In theory, if we constantly inject this kinetic core with enough energy, it can easily allow the Experimental Field Generator to run at full power...","nextNodeIds":[740538922]},{"nodeId":740538922,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":197427290,"text":"After creating this core, we both realized a problem. We could barely find any way to keep injecting it with enough energy to keep it at maximum power.","nextNodeIds":[740538923]},{"nodeId":740538923,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2553043818,"text":"Edwin and I tried powering it with a mixture of Pneumousia and Arkhium energy, or by connecting large numbers of Arkhium ores in series to create a super-powered group... but neither worked.","nextNodeIds":[740538924]},{"nodeId":740538924,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4221322682,"text":"That was the situation until we found that giant Arkhium... Although it was always in an inert state, Edwin and I were certain that this ore had unprecedented purity.","nextNodeIds":[740538925]},{"nodeId":740538925,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2285626266,"text":"We believed that with the right treatment, this ore could definitely output the large amount of energy we needed...","nextNodeIds":[740538926]},{"nodeId":740538926,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4132385874,"text":"But then Edwin and I had a disagreement. I offered a up a more conservative proposal, but he wanted... to solve the problem rather more quickly.","nextNodeIds":[740538929]},{"nodeId":740538929,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3014382466,"text":"You should know everything else that happened after that.","nextNodeIds":[]},{"nodeId":740538930,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":786588626,"text":"About Edwin...","nextNodeIds":[740538931]},{"nodeId":740538931,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":208256538,"text":"He was a genius in the field of scientific research. It's no exaggeration to say that his talent was only second to our first director, Alain Guillotin.","nextNodeIds":[740538932]},{"nodeId":740538932,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2394390202,"text":"At the same time, he was an... inhuman monster.","nextNodeIds":[740538933]},{"nodeId":740538933,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3062652322,"text":"Nothing mattered to him other than his scientific research.","nextNodeIds":[740538934]},{"nodeId":740538934,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1988556386,"text":"Edwin was willing to do anything or pay any price to advance his research.","nextNodeIds":[740538935]},{"nodeId":740538935,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3436143810,"text":"He once told me that research results were the only remuneration he needed. He said:","nextNodeIds":[740538936]},{"nodeId":740538936,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2954325050,"text":"\"I don't need any remuneration. To me, research itself is the best reward.\"","nextNodeIds":[740538937]},{"nodeId":740538937,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":934958050,"text":"However, even though Edwin was a pure researcher, the people under him were all experts... in furthering their own interests, that is.","nextNodeIds":[740538938]},{"nodeId":740538938,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2138989722,"text":"Some secretly sold research assets, some plagiarized research results, and some used his name to scam others.","nextNodeIds":[740538939]},{"nodeId":740538939,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":622561442,"text":"They ruined the Fontaine Research Institute's reputation, little by little.","nextNodeIds":[740538940]},{"nodeId":740538940,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2813784066,"text":"Like I said before, as long as his research could advance, Edwin wouldn't do anything about this.","nextNodeIds":[740538941]},{"nodeId":740538941,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2747241250,"text":"In this way, they used Edwin's name to take all the Institute's resources for themselves.","nextNodeIds":[740538942]},{"nodeId":740538942,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2040006186,"text":"The Institute could only continue to conduct detailed reviews on the personnel and funding of Edwin's project team. Mr. Choiseul led many of these review operations personally.","nextNodeIds":[740538943]},{"nodeId":740538943,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1213322794,"text":"However, in the mouths of such people, these actions were construed as bureaucratic arrogance and distrust of researchers.","nextNodeIds":[740538944]},{"nodeId":740538944,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2979502906,"text":"More and more conflicts took place between us... and no one knew how to resolve them.","nextNodeIds":[740538945]},{"nodeId":740538945,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":2194820954,"text":"But now... those conflicts no longer exist.","nextNodeIds":[]},{"nodeId":740538946,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":775817426,"text":"About the current situation...","nextNodeIds":[740538947]},{"nodeId":740538947,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":280360202,"text":"Haha, your question is not a technical one, but rather, an administrative one.","nextNodeIds":[740538948]},{"nodeId":740538948,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3112548554,"text":"I think you should ask Mr. Choiseul about this instead.","nextNodeIds":[]},{"nodeId":740538949,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":777714154,"text":"Why do you think Nacker stole the core?","nextNodeIds":[740538950]},{"nodeId":740538950,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":404261666,"text":"Do you still remember me flipping through the pictures Ms. Chronie took in the ruins?","nextNodeIds":[740538951]},{"nodeId":740538951,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":940786458,"text":"There's one of Nacker working in front of the suppression device. It's quite blurry... but I'm quite certain that his actions are definitely not part of any operational procedure.","nextNodeIds":[740538952]},{"nodeId":740538952,"roleType":"TALK_ROLE_NPC","speakerId":21293,"speakerName":"Paimon","textMapHash":598717946,"text":"That doesn't really mean anything, though. Maybe... maybe a thief came flying across from the nearby mountain and stole the core?","nextNodeIds":[740538953]},{"nodeId":740538953,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3055441866,"text":"Heh, that's most definitely impossible. The energy flow of the Arkhium here is the best anti-theft measure there is. No ordinary person can withstand it.","nextNodeIds":[740538954]},{"nodeId":740538954,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1064141986,"text":"Besides, the timing of the Experimental Field Generator's activation is simply too perfect. It cannot be a mere coincidence...","nextNodeIds":[740538955]},{"nodeId":740538955,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3057340978,"text":"I have a preliminary conjecture. Nacker... or should I say, the one who stole the core likely removed the Arkhium Kinetic Core early on, activating the backup energy source.","nextNodeIds":[740538956]},{"nodeId":740538956,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":251225530,"text":"However, Pneumousia Cores are relatively inefficient energy sources, and they have to keep up a continuous output of energy to reach the activation threshold of this contraption here.","nextNodeIds":[740538957]},{"nodeId":740538957,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":1765231602,"text":"Hence, this person intentionally activated that large Arkhium chunk, creating a modest, but rather noticeable explosion.","nextNodeIds":[740538958]},{"nodeId":740538958,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4077589770,"text":"This way, when the Institute sent someone to investigate, they would be certain to fix the Arkhium Inhibitor first.","nextNodeIds":[740538959]},{"nodeId":740538959,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":378617858,"text":"And by the time they realized that they'd have to go to the Experimental Field Generator to retrieve the backup energy supply, the Generator would have already finished charging.","nextNodeIds":[740538960]},{"nodeId":740538960,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3877242698,"text":"From a technical perspective, such a modus operandi is highly probable, and those within the Institute capable of doing this would only be Edwin, Mr. Nacker, and myself.","nextNodeIds":[740538961]},{"nodeId":740538961,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":16796202,"text":"I doubt Edwin had the opportunity to do anything to that effect... which leaves two remaining suspects. Myself, and Mr. Nacker.","nextNodeIds":[740538962]},{"nodeId":740538962,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3422455954,"text":"Maybe this was all your doing, then.","nextNodeIds":[740538963]},{"nodeId":740538963,"roleType":"TALK_ROLE_NPC","speakerId":21293,"speakerName":"Paimon","textMapHash":555875074,"text":"Yeah! You said that Nacker lied, but you've also been lying all along!","nextNodeIds":[740538964]},{"nodeId":740538964,"roleType":"TALK_ROLE_NPC","speakerId":21293,"speakerName":"Paimon","textMapHash":4163671490,"text":"Maybe this was all just part of your plan, and you tricked us into escorting you here so you could grab whatever it was you wanted.","nextNodeIds":[740538965]},{"nodeId":740538965,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":4271439986,"text":"Your accusation is not entirely baseless. After this, I will also apply for and submit myself to the Institute's credibility review.","nextNodeIds":[740538966]},{"nodeId":740538966,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":170039010,"text":"As far as I'm concerned, though, Mr. Nacker is the one more likely to have committed this act. If this really was his doing, then he should be the one with the most to gain from it.","nextNodeIds":[740538967]},{"nodeId":740538967,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":523912506,"text":"Even if I am listed alongside him as a suspect... his chances of being convicted are certainly greater than mine.","nextNodeIds":[]},{"nodeId":740538968,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":503544882,"text":"Goodbye.","nextNodeIds":[740538969]},{"nodeId":740538969,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","textMapHash":3042663874,"text":"Bye. I hope you have a good day.","nextNodeIds":[]}]},{"talkId":7405391,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7417201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7405391,"initDialog":740539101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5258],"performCfg":"","priority":3,"questId":74172,"showRandomTalkCount":0},"dialogs":[{"nodeId":740539101,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":819958874,"text":"Ah! If it isn't our Honorary Senior Researcher. Welcome!","nextNodeIds":[740539102]},{"nodeId":740539102,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":3977703802,"text":"Can I help you with anything? Or have you come to help me with something instead? Hahaha!","nextNodeIds":[740539103,740539111,740539116]},{"nodeId":740539103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4097687498,"text":"About the Institute's current state...","nextNodeIds":[740539104]},{"nodeId":740539104,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":520509594,"text":"Everything is good! It's better than ever! Now that that egomaniac Edwin is gone, the gang of thieves under him no longer exists either.","nextNodeIds":[740539105]},{"nodeId":740539105,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":835723058,"text":"More importantly, the Institute has a chance to be reborn!","nextNodeIds":[740539106]},{"nodeId":740539106,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":2393783610,"text":"We can take off the shackles and burdens of the past to focus wholeheartedly on building our foundations once again — that is, to work hard for the well-being of all the people of the Court of Fontaine.","nextNodeIds":[740539107]},{"nodeId":740539107,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":4294326810,"text":"I'm currently gathering some people and preparing a Code of Conduct for our organization.","nextNodeIds":[740539108]},{"nodeId":740539108,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":285575562,"text":"It will include principles on the use of funds, research asset management methods... and ethical standards that should be observed in scientific research and work.","nextNodeIds":[740539109]},{"nodeId":740539109,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":3295493850,"text":"All research-related behavior at our Institute will have relevant rules and provisions.","nextNodeIds":[740539110]},{"nodeId":740539110,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":3036696426,"text":"Ah... What a wonderful future! It's simply the best!","nextNodeIds":[]},{"nodeId":740539111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2731987610,"text":"Do you and Raimondo run things together?","nextNodeIds":[740539112]},{"nodeId":740539112,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":3594172306,"text":"No, to be precise, we deal with affairs related to different areas.","nextNodeIds":[740539113]},{"nodeId":740539113,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":3162205482,"text":"Raimondo is responsible for getting scientific work and research back on track, and I'm responsible for everything apart from that.","nextNodeIds":[740539114]},{"nodeId":740539114,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":2782409450,"text":"For example, I'm responsible for arranging funds related to manpower, quarterly budget allocations, re-accommodating visitors, and getting rid of those journalists together with Raimondo.","nextNodeIds":[740539115]},{"nodeId":740539115,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":2461431586,"text":"But our main goal remains the same — to rebuild the Fontaine Research Institute and work hard for the well-being of all the people of the Court of Fontaine.","nextNodeIds":[]},{"nodeId":740539116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2150975250,"text":"See you.","nextNodeIds":[740539117]},{"nodeId":740539117,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","textMapHash":19672770,"text":"You go and do what you need to do. The Institute will always welcome you!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7417201,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7405389,7405391],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"Raimondo","count":56},{"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"Choiseul","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":11},{"roleType":"TALK_ROLE_NPC","