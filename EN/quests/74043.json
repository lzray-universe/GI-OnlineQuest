T_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7404303],"talks":[{"talkId":7404303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7404311","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":7404303,"initDialog":740430301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5254,21028,21091,21092,21105],"performCfg":"QuestDialogue/WQ/Fontaine_74043/Q7404303","priority":5,"questId":74043,"showRandomTalkCount":0},"dialogs":[{"nodeId":740430301,"roleType":"TALK_ROLE_NPC","speakerId":5254,"speakerName":"Henri","textMapHash":2318995002,"text":"Hmm, there we go — seven cores, all told.","nextNodeIds":[740430302]},{"nodeId":740430302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1638601898,"text":"What do you need with them, anyway?","nextNodeIds":[740430303]},{"nodeId":740430303,"roleType":"TALK_ROLE_NPC","speakerId":5254,"speakerName":"Henri","textMapHash":1362065194,"text":"How should I know? My boss just said that seven mysterious cores from these mysterious machines would be needed — and if I can get them, I'll make big Mora.","nextNodeIds":[740430304]},{"nodeId":740430304,"roleType":"TALK_ROLE_NPC","speakerId":5254,"speakerName":"Henri","textMapHash":1192509938,"text":"And well, this'll do! I've arranged to meet him here and report on the situation, so you can just ask him yourself. In any case, I'll need him to settle his bills with me before I can give you your share...","nextNodeIds":[740430305]},{"nodeId":740430305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1906099634,"text":"Ugh, fine, if you say so... We'll wait.","nextNodeIds":[740430306]},{"nodeId":740430306,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":681498426,"text":"You wait for a while...","nextNodeIds":[740430307]},{"nodeId":740430307,"roleType":"TALK_ROLE_NPC","speakerId":21028,"speakerName":"\"Boss\"","textMapHash":2214967866,"text":"Dear Henri, how are things going?","nextNodeIds":[740430308]},{"nodeId":740430308,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":2168247250,"text":"Very well, Boss! I've gathered the seven mysterious cores you asked for. Anyway, let me introduce you to my partner... Um, what's your name again?","nextNodeIds":[740430309]},{"nodeId":740430309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":417549250,"text":"...","nextNodeIds":[740430310]},{"nodeId":740430310,"roleType":"TALK_ROLE_NPC","speakerId":21028,"speakerName":"\"Boss\"","textMapHash":4236337778,"text":"Um...","nextNodeIds":[740430311]},{"nodeId":740430311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3217973858,"text":"Uhh...","nextNodeIds":[740430312]},{"nodeId":740430312,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":1609115386,"text":"Wait? You know each other? Great! So, this is how things went...","nextNodeIds":[740430315]},{"nodeId":740430313,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":4222999018,"text":"#\"Agh! It's {NICKNAME}! Why's {M#he}{F#she} here!?\"\\nThe \"Boss\" turns to flee, but is suddenly captured by Hunter and Turner, who come from out of nowhere.\\n\\n","nextNodeIds":[740430314]},{"nodeId":740430315,"roleType":"TALK_ROLE_NPC","speakerId":21028,"speakerName":"\"Boss\"","textMapHash":648293570,"text":"Agh! Mercy, have mercy!","nextNodeIds":[740430316]},{"nodeId":740430316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2102398594,"text":"Huh, these two are pretty skilled...","nextNodeIds":[740430317]},{"nodeId":740430317,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":3894257354,"text":"Don't worry, Boss! There's no mortal danger here, I'm sure of it!","nextNodeIds":[740430318]},{"nodeId":740430318,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":3231620770,"text":"Indeed, indeed. No one's in any danger at all.","nextNodeIds":[740430319]},{"nodeId":740430319,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":2430657202,"text":"For now, anyway.","nextNodeIds":[740430320]},{"nodeId":740430320,"roleType":"TALK_ROLE_NPC","speakerId":21028,"speakerName":"\"Boss\"","textMapHash":2032702186,"text":"F—For now...!?","nextNodeIds":[740430321]},{"nodeId":740430321,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":3655730546,"text":"As for what comes next...","nextNodeIds":[740430322]},{"nodeId":740430322,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":2372963482,"text":"Whether you wind up as roast chicken or something else altogether... Well, that's all up to you... Boss.","nextNodeIds":[740430323]},{"nodeId":740430323,"roleType":"TALK_ROLE_NPC","speakerId":21028,"speakerName":"\"Boss\"","textMapHash":2514649762,"text":"Eek!","nextNodeIds":[740430324]},{"nodeId":740430324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1725395914,"text":"How did the two of you end up here?","nextNodeIds":[740430325]},{"nodeId":740430325,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":456465762,"text":"After we had the... honor of meeting you previously, we decided to tail Henri.","nextNodeIds":[740430326]},{"nodeId":740430326,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":282782906,"text":"Huh? Wait. Why me?","nextNodeIds":[740430327]},{"nodeId":740430327,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":4128253314,"text":"Actually, why was I the target in the first place? I was just doing my job!","nextNodeIds":[740430328]},{"nodeId":740430328,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":1324101322,"text":"The machines you dismantled were devices used by the Fontaine Research Institute to monitor and optimize water quality.","nextNodeIds":[740430329]},{"nodeId":740430329,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":3009736010,"text":"Huh? Weren't they meant to produce pollution?","nextNodeIds":[740430330]},{"nodeId":740430330,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":4242322082,"text":"The cores you dismantled contained the most advanced central components and hydrological data in Fontaine. As such, we hoped to... acquaint ourselves with your trading partner.","nextNodeIds":[740430331]},{"nodeId":740430331,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":4200721290,"text":"Eh? What? Why?","nextNodeIds":[740430332,740430334]},{"nodeId":740430332,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3614879186,"text":"You lied to me, Henri.","nextNodeIds":[740430333]},{"nodeId":740430334,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":985393170,"text":"Gasp! Shock! We were tricked!","nextNodeIds":[740430335]},{"nodeId":740430333,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":1270657826,"text":"No, no, you're my great benefactor! Why would I ever lie to you?","nextNodeIds":[740430335]},{"nodeId":740430335,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":1146126754,"text":"You lied to me, Boss! Did you know you were making me destroy such important things!?","nextNodeIds":[740430336]},{"nodeId":740430336,"roleType":"TALK_ROLE_NPC","speakerId":21028,"speakerName":"\"Boss\"","textMapHash":884585394,"text":"I—I didn't mean to! I'm only the lowest rung on the...","nextNodeIds":[740430337]},{"nodeId":740430337,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":1342070730,"text":"Hmm? What did I hear about you \"not meaning to\" do something? Could you say that again? I don't think I heard you clearly.","nextNodeIds":[740430338]},{"nodeId":740430338,"roleType":"TALK_ROLE_NPC","speakerId":21028,"speakerName":"\"Boss\"","textMapHash":1136639522,"text":"Eeeee!","nextNodeIds":[740430339]},{"nodeId":740430339,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":2147310818,"text":"Oh dear, this Boss must be tired — he's even fallen asleep with his eyes open.","nextNodeIds":[740430340]},{"nodeId":740430340,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2031021810,"text":"Uhh, th—this wasn't our intention either...","nextNodeIds":[740430341]},{"nodeId":740430341,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":683215058,"text":"Well, about that — we've decided not to pursue the matter.","nextNodeIds":[740430342]},{"nodeId":740430342,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2904852282,"text":"Really? Will things be okay like that?","nextNodeIds":[740430343]},{"nodeId":740430343,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":2767376210,"text":"We just need the cores and the data within them to be whole — the machines themselves are ancillary.","nextNodeIds":[740430344]},{"nodeId":740430344,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":3211379074,"text":"The higher-ups say that it's fine — and that we shouldn't tangle with you regardless.","nextNodeIds":[740430345]},{"nodeId":740430345,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3533069770,"text":"Hmm? What's that about tangling with me?","nextNodeIds":[740430346]},{"nodeId":740430346,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":1620309546,"text":"Oh, nothing, nothing.","nextNodeIds":[740430347]},{"nodeId":740430347,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":4052878514,"text":"I mean, would you look at that — it's us, out on a stroll!","nextNodeIds":[740430348]},{"nodeId":740430348,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":3460660234,"text":"And fancy us meeting you here, huh? What lovely weather, and a lovely coincidence too!","nextNodeIds":[740430349]},{"nodeId":740430349,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":4140597834,"text":"Alas, all encounters must come to an end, and so too will ours. It's time to say goodbye, I fear.","nextNodeIds":[740430350]},{"nodeId":740430350,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":1438456986,"text":"Just allow the beauty of such a meeting to linger in your heart, or perhaps...","nextNodeIds":[740430351]},{"nodeId":740430351,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":720083114,"text":"Forget about it. Who knows? It might be better that way.","nextNodeIds":[740430352]},{"nodeId":740430352,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":539192994,"text":"Huh? ...So we're alright?","nextNodeIds":[740430353]},{"nodeId":740430353,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":2410075410,"text":"Would you prefer things to be otherwise?","nextNodeIds":[740430354]},{"nodeId":740430354,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":3125457138,"text":"Oh, Archons, no! We're alright. Of course we are!","nextNodeIds":[740430355]},{"nodeId":740430355,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":2028231562,"text":"*sigh* I thought I'd met a good person with whom I could turn my life around through labor — alas, people of ill intent remain the dominant majority!","nextNodeIds":[740430356]},{"nodeId":740430356,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":3033301882,"text":"...Hey, Henri. Lend a hand, would you?","nextNodeIds":[740430357]},{"nodeId":740430357,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":4132474642,"text":"Huh?","nextNodeIds":[740430358]},{"nodeId":740430358,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":1107487954,"text":"I mean, it's a mighty shame, but this good-hearted Boss of yours seems to have lost his wits.","nextNodeIds":[740430359]},{"nodeId":740430359,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":3029729130,"text":"We're going to need someone...","nextNodeIds":[740430360]},{"nodeId":740430360,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":1481561338,"text":"Hardworking...","nextNodeIds":[740430361]},{"nodeId":740430361,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":1250025898,"text":"Reliable...","nextNodeIds":[740430362]},{"nodeId":740430362,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":4163451946,"text":"You know, a good friend who hopes to change his life through honest labor.","nextNodeIds":[740430363]},{"nodeId":740430363,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":3467351730,"text":"That's right — we need a good friend to help us take this nice man to our safehouse.","nextNodeIds":[740430364]},{"nodeId":740430364,"roleType":"TALK_ROLE_NPC","speakerId":21091,"speakerName":"Hunter","textMapHash":78796738,"text":"There, we can... speak with him at our leisure.","nextNodeIds":[740430365]},{"nodeId":740430365,"roleType":"TALK_ROLE_NPC","speakerId":21092,"speakerName":"Turner","textMapHash":4150251106,"text":"Of course, we will... express our gratitude — in Mora.","nextNodeIds":[740430366]},{"nodeId":740430366,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":76216802,"text":"Oh... Sure! Count me in, then!","nextNodeIds":[740430367]},{"nodeId":740430367,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":3973048714,"text":"Thank you, thank you both. And thank you too, um...","nextNodeIds":[740430368]},{"nodeId":740430368,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1959656914,"text":"#{NICKNAME}. She's Paimon.","nextNodeIds":[740430369]},{"nodeId":740430369,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":1387338050,"text":"#Thank you both, {NICKNAME}, Paimon. My life really did change after meeting the two of you, it seems!","nextNodeIds":[740430370]},{"nodeId":740430370,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3240976186,"text":"No need to thank us! Just work hard, Henri — and don't get fooled again, alright?","nextNodeIds":[740430371]},{"nodeId":740430371,"roleType":"TALK_ROLE_NPC","speakerId":21105,"speakerName":"Henri","textMapHash":667548114,"text":"Yes, I won't! I'm going to work hard and become a rich man — and then I'll have others working for me!","nextNodeIds":[740430372]},{"nodeId":740430372,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":741462874,"text":"Hunter, Turner, and Henri dig the unconscious Fatuus out and take him away.","nextNodeIds":[740430373]},{"nodeId":740430373,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1381554794,"text":"Well, Paimon sure hopes that Henri's life will turn around...","nextNodeIds":[740430374]},{"nodeId":740430374,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":126768298,"text":"Hang on a minute. What about the pay Henri was supposed to give us!?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7404303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133403307,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["3","133403703,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5254"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","