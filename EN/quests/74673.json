{"mainQuestId":74673,"title":"Treasures Under the Sea","description":"You run into Ulman again in the Court of Fontaine...","titleTextMapHash":2023253583,"descTextMapHash":1673988590,"mainQuestExcel":{"mainQuestId":74673,"titleTextMapHash":2023253583,"title":"Treasures Under the Sea","descTextMapHash":1673988590,"description":"You run into Ulman again in the Court of Fontaine...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5174,"luaPath":"Actor/Quest/WQ74673","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5174,"chapterId":0,"descTextMapHash":1673988590,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74673,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":908448369,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74673","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174673],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2023253583,"type":"WQ","unlockDescTextMapHash":1763248230}},"flow":[{"subQuestId":7467301,"order":1,"stepDescription":"Talk to Ulman","stepDescTextMapHash":3030136924,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30456"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467301],"talks":[{"talkId":7467301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7467301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467301,"initDialog":746730101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30456],"performCfg":"QuestDialogue/WQ/Fontaine_74673/Q7467301","priority":5,"questId":74673,"showRandomTalkCount":0},"dialogs":[{"nodeId":746730101,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":1152278914,"text":"C'mon, little one, I really don't know how to dive. Look! I don't even have a divesuit.","nextNodeIds":[746730102]},{"nodeId":746730102,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":2146648378,"text":"*sigh*... No matter how much you jump and dance, I still can't follow you down there...","nextNodeIds":[746730103,746730104]},{"nodeId":746730103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1523464874,"text":"Ulman! You came to Fontaine too?","nextNodeIds":[746730105]},{"nodeId":746730105,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":498397562,"text":"#{NICKNAME}, Paimon! Fancy meeting you here again, of all places. Quite the coincidence.","nextNodeIds":[746730106]},{"nodeId":746730106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4202860506,"text":"You haven't changed a bit! Still popular with the Seelie. And... it looks like you're getting better and better at communicating with them!","nextNodeIds":[746730107]},{"nodeId":746730107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1368691994,"text":"Translate what the Seelie is saying for me, please.","nextNodeIds":[746730108]},{"nodeId":746730108,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":2090118186,"text":"*sigh* Please don't make fun of me. I don't have a clue what it's trying to say.","nextNodeIds":[746730109]},{"nodeId":746730109,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":1744746034,"text":"I just came here to do some business and decided to take a stroll by the water. Suddenly a Seelie started following me out of nowhere... again.","nextNodeIds":[746730110]},{"nodeId":746730110,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":1953918722,"text":"I'm used to this sort of thing by now, so I followed it. Up hill and down dale, I even had to row a boat for a bit.","nextNodeIds":[746730111]},{"nodeId":746730111,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":4218994410,"text":"Normally, they start bouncing around to tell me \"something's buried here!\"","nextNodeIds":[746730112]},{"nodeId":746730112,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":353212946,"text":"But... It keeps diving into the water, deeper and deeper...","nextNodeIds":[746730113]},{"nodeId":746730113,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":1305233786,"text":"But I haven't got a clue how to dive! I've heard other people saying that the waters here not only have powerful currents, but also all kinds of other dangers... All I can do is sit here on my little boat, waiting for it to return.","nextNodeIds":[746730114]},{"nodeId":746730114,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":1854531786,"text":"But that little guy is still leading me to place after place... I really want it to know that I really don't know how to dive...","nextNodeIds":[746730115,746730117]},{"nodeId":746730115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3112323794,"text":"Ah, so you're enjoying the unique Fontaine experience?","nextNodeIds":[746730116]},{"nodeId":746730116,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":3694394730,"text":"Totally and completely. A friendly, passionate, kind nation that you never ever feel like leaving. Ha. Ha. Ha.","nextNodeIds":[746730119]},{"nodeId":746730119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":346348378,"text":"Sounds like you're about to ask us for help again, aren't you?","nextNodeIds":[746730120]},{"nodeId":746730120,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":238057586,"text":"Yes, yes! Oh, thank the Archons, you haven't yet been influenced by the local customs here too much, you still speak so directly and clearly!","nextNodeIds":[746730121]},{"nodeId":746730121,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":4229364570,"text":"The dramatic, flowery way some Fontainians talk, I just can't take it anymore!","nextNodeIds":[746730122]},{"nodeId":746730122,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":515282218,"text":"Every twenty words, there's two respectful terms of address, three metaphors, and six adjectives...","nextNodeIds":[746730123,746730124]},{"nodeId":746730123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3872980226,"text":"I always get straight to the point.","nextNodeIds":[746730125]},{"nodeId":746730125,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":475249138,"text":"Gah! ...I feel like even I'm starting to get influenced... Come on! Take this notebook, I've marked the spots where the little guy has taken me.","nextNodeIds":[746730126]},{"nodeId":746730126,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":1679422434,"text":"Just like before, find the Ancient Iron Coins, bring them to me, and I'll buy them off of you at an excellent price.","nextNodeIds":[746730127]},{"nodeId":746730127,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":2112079626,"text":"Always a pleasure working with you and Paimon.","nextNodeIds":[]},{"nodeId":746730124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2084691178,"text":"I, being naught but a humble Traveler, have not yet achieved such incredible feats of rhetorical mastery.","nextNodeIds":[746730125]},{"nodeId":746730117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":39236674,"text":"I would have thought you were used to monsters by now.","nextNodeIds":[746730118]},{"nodeId":746730118,"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","textMapHash":692572666,"text":"I am indeed! But at least when I run into them on land, I can turn tail and run. Underwater, I haven't a hope of swimming away!","nextNodeIds":[746730119]},{"nodeId":746730104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3480161050,"text":"Looks like your \"Seelie magnetism\" is as strong as ever.","nextNodeIds":[746730105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30456"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30456,"speakerName":"Ulman","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174673],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1673988590,"CHECNJEMEFE":{"30456":[1110]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIM