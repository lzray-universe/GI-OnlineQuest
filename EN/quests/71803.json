nt":0},"dialogs":[{"nodeId":718030301,"roleType":"TALK_ROLE_NPC","speakerId":20180,"speakerName":"Ash","textMapHash":3803201538,"text":"Meow...","nextNodeIds":[718030302]},{"nodeId":718030302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":949639242,"text":"Huh? Why would there be a cat here?","nextNodeIds":[718030303]},{"nodeId":718030303,"roleType":"TALK_ROLE_NPC","speakerId":20180,"speakerName":"Ash","textMapHash":790421234,"text":"Meow... Meeeow...","nextNodeIds":[718030304,718030308]},{"nodeId":718030304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2187115922,"text":"A gray cat...","nextNodeIds":[718030305]},{"nodeId":718030305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":877858642,"text":"A gray cat, lost in the wild...","nextNodeIds":[718030306]},{"nodeId":718030306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2674985066,"text":"Ah, Lan mentioned a commission to look for a gray cat. Maybe this is the one! Paimon remembers that it was called Ash or something like that...","nextNodeIds":[718030307]},{"nodeId":718030307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3596397338,"text":"Who'd have thought that we'd find it here... Has it been hiding around here all this time?","nextNodeIds":[718030311]},{"nodeId":718030311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2963973866,"text":"Guess the Stonehide Lawachurl prevented anyone from searching for it here, and since it was too scared to leave, it just hid.","nextNodeIds":[718030312]},{"nodeId":718030312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":633384730,"text":"Sure is lucky that we came over, or it might've had to wait for a while longer, huh?","nextNodeIds":[718030313]},{"nodeId":718030313,"roleType":"TALK_ROLE_NPC","speakerId":20180,"speakerName":"Ash","textMapHash":3784454530,"text":"Meow... Meow, meow!","nextNodeIds":[718030314,718030317]},{"nodeId":718030314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3737193930,"text":"Meow... Meeeow...","nextNodeIds":[718030315]},{"nodeId":718030315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3507776698,"text":"Hey, what are you doing? Paimon doesn't think it understands what you're saying anyway...","nextNodeIds":[718030316]},{"nodeId":718030316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2955926018,"text":"Let's just bring it back to Lan, and let her return it to the person who put the commission up.","nextNodeIds":[718030319]},{"nodeId":718030319,"roleType":"TALK_ROLE_NPC","speakerId":20180,"speakerName":"Ash","textMapHash":97903714,"text":"Meow... Meow! Meow!","nextNodeIds":[718030320,718030322]},{"nodeId":718030320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1565508498,"text":"Meow... Meow! Meow!","nextNodeIds":[718030321]},{"nodeId":718030321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3833298082,"text":"Oh, come on! It's not going to understand you no matter how hard you try to copy it. Let's just bring it with us already.","nextNodeIds":[]},{"nodeId":718030322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":524135050,"text":"It seems to agree with us.","nextNodeIds":[718030323]},{"nodeId":718030323,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3147379378,"text":"How did you even— never mind. Let's just bring it back to Lan.","nextNodeIds":[]},{"nodeId":718030317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":731968522,"text":"Let's take the cat back to Lan.","nextNodeIds":[718030318]},{"nodeId":718030318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2710284138,"text":"Yup, guess that's all we can do right now. She'll return it to the person who put that commission up.","nextNodeIds":[718030319]},{"nodeId":718030308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3973803058,"text":"Maybe it's Ash...","nextNodeIds":[718030309]},{"nodeId":718030309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1934317346,"text":"A gray cat, lost in the wild...","nextNodeIds":[718030310]},{"nodeId":718030310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1336288778,"text":"You're right! Lan mentioned that commission earlier, didn't she? Huh. Who'd have thought that we'd find that cat here... Has it been hiding around here all this time?","nextNodeIds":[718030311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7180303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20180"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7180305,"order":5,"stepDescription":"Bring Ash to Lan","stepDescTextMapHash":2122602172,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7180304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYL