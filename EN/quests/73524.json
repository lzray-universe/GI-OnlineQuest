alkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352401,"initDialog":401060101,"nextRandomTalks":[],"nextTalks":[7352402,7352403],"npcId":[1064],"performCfg":"QuestDialogue/EQ/AkaFes_40106/Q7352401","priority":5,"questId":73524,"showRandomTalkCount":0},"dialogs":[{"nodeId":401060101,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1985365026,"text":"Twenty years ago, the Akademiya had just received Sachin's estate. To celebrate the huge investment, the Akademiya Extravaganza that year was grander than usual.","nextNodeIds":[401060102]},{"nodeId":401060102,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":711751706,"text":"I was very young then, and I remember seeing posters for the Interdarshan Championship all over the city. I couldn't help but mention it to my father. I even told him that I really liked the look of the diadem — it was so unique.","nextNodeIds":[401060103]},{"nodeId":401060103,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3777307834,"text":"So he said, \"Why don't I win it, so I can let you play with it for a few days?\"","nextNodeIds":[401060104]},{"nodeId":401060104,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":651381098,"text":"That made me very happy, and I nodded enthusiastically. But to my surprise, he didn't win, and when he got back home, he seemed extremely depressed.","nextNodeIds":[401060105]},{"nodeId":401060105,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3141817938,"text":"Later, he left home, saying that he wanted to do some investigating in the desert... The quicksand got him not long after that...","nextNodeIds":[401060106]},{"nodeId":401060106,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2044309634,"text":"...For many years, I couldn't face up to it at all. If I'd just kept my mouth shut, maybe none of it would have ever happened.","nextNodeIds":[]}]},{"talkId":7352402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7352402,"initDialog":401060107,"nextRandomTalks":[],"nextTalks":[],"npcId":[1064],"performCfg":"QuestDialogue/EQ/AkaFes_40106/Q7352402","priority":5,"questId":73524,"showRandomTalkCount":0},"dialogs":[{"nodeId":401060107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3168201258,"text":"Your father may have seen Sachin that year.","nextNodeIds":[401060108]},{"nodeId":401060108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3440307306,"text":"Wait... So the person we came across in our investigation, who went into the desert twenty years ago... it was...","nextNodeIds":[401060109]},{"nodeId":401060109,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1877773402,"text":"...","nextNodeIds":[401060110]},{"nodeId":401060110,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3502628186,"text":"...Haha... Is that why Sachin thought I looked familiar? I can't believe it...","nextNodeIds":[401060111]},{"nodeId":401060111,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1935816290,"text":"...My father was always too kind for his own good. Sachin's research would have saddened him greatly — he must have gone into the desert when he heard about it to find those who were still suffering... It all makes sense now.","nextNodeIds":[401060112]},{"nodeId":401060112,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":620309506,"text":"...","nextNodeIds":[401060113]},{"nodeId":401060113,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3365314482,"text":"I've tried telling myself so many times over the years that maybe his sudden depression wasn't because he didn't win the competition, maybe something else was going on that I wasn't aware of... But in the end, it all started with me mentioning the competition to him.","nextNodeIds":[401060114]},{"nodeId":401060114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1872000298,"text":"Aw, Kaveh...","nextNodeIds":[401060115]},{"nodeId":401060115,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":377432586,"text":"Don't worry. I... I destroyed the diadem. There will never be another tragedy like this again. Never again...","nextNodeIds":[]}]},{"talkId":7352403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7352403,"initDialog":401060116,"nextRandomTalks":[],"nextTalks":[],"npcId":[1064],"performCfg":"QuestDialogue/EQ/AkaFes_40106/Q7352403","priority":5,"questId":73524,"showRandomTalkCount":0},"dialogs":[{"nodeId":401060116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2405746674,"text":"(Don't mention the results of the investigation.)","nextNodeIds":[401060117]},{"nodeId":401060117,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1769140786,"text":"Sorry... My mind was still on the Championship. Look at me, rambling away.","nextNodeIds":[401060118]},{"nodeId":401060118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2775756026,"text":"You look really upset... Are you sure you're okay?","nextNodeIds":[401060119]},{"nodeId":401060119,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":152423370,"text":"I'm fine. What's past is past — we need to look towards the future.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","I