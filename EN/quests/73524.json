EST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1064"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352404],"talks":[{"talkId":7352404,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352406","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352404,"initDialog":401060201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1064,1053],"performCfg":"QuestDialogue/EQ/AkaFes_40106/Q7352404","priority":5,"questId":73524,"showRandomTalkCount":0},"dialogs":[{"nodeId":401060201,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2898887898,"text":"Where were you while the rest of us were eating together?","nextNodeIds":[401060202]},{"nodeId":401060202,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":1837881130,"text":"I don't recall being obligated to report my whereabouts to you.","nextNodeIds":[401060203]},{"nodeId":401060203,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3591375170,"text":"Did you go find another hidey-hole to read in? You need to change your ways, you know. You can't survive on books alone.","nextNodeIds":[401060204]},{"nodeId":401060204,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":793907146,"text":"Surviving on meals paid for by you would be harder still.","nextNodeIds":[401060205]},{"nodeId":401060205,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1838028394,"text":"You...!","nextNodeIds":[401060206]},{"nodeId":401060206,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1524044562,"text":"Hmph, whatever, it doesn't take a genius to guess what you've been up to... You were investigating Sachin, weren't you? It was obvious from your notes. However, I don't believe his research alone would've been enough to pique your interest.","nextNodeIds":[401060207]},{"nodeId":401060207,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1520969266,"text":"His way of doing things is disturbing, while you... Well, to be fair, your philosophy disgusts me too, but you and Sachin are nothing alike. I don't imagine your views intersect at all. Egoism and nihilism are not the same thing.","nextNodeIds":[401060208]},{"nodeId":401060208,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":719821554,"text":"My personal interest aside, Sachin's legacy is not entirely meaningless — he conducted experiments on a great scale, and left his findings behind.","nextNodeIds":[401060209]},{"nodeId":401060209,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":2151842586,"text":"Also, thanks for the compliment. But I'm actually just passing through — I didn't come here for the conversation. Well, not this one at least.","nextNodeIds":[401060210]},{"nodeId":401060210,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3730534330,"text":"What do you mean? What topic of conversation could be more sacred among scholars than the exploration of differing philosophies?","nextNodeIds":[401060211]},{"nodeId":401060211,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":2109377146,"text":"Well, based on what I've learned, Sachin and his \"disturbing way of doing things\" — as you put it — is very likely to have met your father twenty years ago.","nextNodeIds":[401060212]},{"nodeId":401060212,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2682957594,"text":"...What did you say?","nextNodeIds":[401060213]},{"nodeId":401060213,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":986451010,"text":"...Wait, so... No, surely that doesn't mean...","nextNodeIds":[401060214]},{"nodeId":401060214,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2958237026,"text":"Hah. So that's why he thought I looked familiar. My father must've gone into the desert due to his influence...","nextNodeIds":[401060215]},{"nodeId":401060215,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":3137660306,"text":"I'm afraid so.","nextNodeIds":[401060216]},{"nodeId":401060216,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1102015090,"text":"...","nextNodeIds":[401060217]},{"nodeId":401060217,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":620635226,"text":"Good thing I shattered that diadem. From now on... nothing like that will ever have to happen again.","nextNodeIds":[401060218]},{"nodeId":401060218,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":97744306,"text":"The boundaries of knowledge are ever-expanding. Someone else will inevitably pick up the same line of research one day, and Vahumana regards it as a reasonable research direction.","nextNodeIds":[401060219]},{"nodeId":401060219,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":4230469002,"text":"Oh, not this again... Even if you're right, and people are bound to fall into the same intellectual traps, things won't necessarily go the same way again next time.","nextNodeIds":[401060220]},{"nodeId":401060220,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":4212681186,"text":"You have to admit that the actions of one individual don't always predict the behavior of the group, and vice-versa. Take Sachin, for instance. He's quite an anomaly.","nextNodeIds":[401060221]},{"nodeId":401060221,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":830091722,"text":"And so is the one who stopped him — you. Conflicts of this nature are indeed exceptional, but it will occur again in the future.","nextNodeIds":[401060222]},{"nodeId":401060222,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":1325459146,"text":"You said it yourself — the actions of one individual cannot predict the behavior of a whole group. You know that not everyone would have chosen as you did.","nextNodeIds":[401060223]},{"nodeId":401060223,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":3166860154,"text":"...","nextNodeIds":[401060224]},{"nodeId":401060224,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":2739971882,"text":"...Even so, I stand by my views. You can forget about trying to convince me.","nextNodeIds":[401060225]},{"nodeId":401060225,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":3092281674,"text":"That's fine. We've been arguing over this for years, and I don't hold any hope of you understanding. The issue we're debating has long since moved on from who's right and who's wrong.","nextNodeIds":[401060226]},{"nodeId":401060226,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":4168989858,"text":"...Thanks for letting me know all this.","nextNodeIds":[401060227]},{"nodeId":401060227,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":3785261050,"text":"What?","nextNodeIds":[401060228]},{"nodeId":401060228,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"Kaveh","textMapHash":1576076850,"text":"I said, thanks for letting me know. Hey! Stop acting like you didn't hear me! You're doing this on purpose, aren't you!?","nextNodeIds":[401060229]},{"nodeId":401060229,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"Alhaitham","textMapHash":866058074,"text":"They say that earnest thanks should be given thrice, so... One more time, please.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352404,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1064"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"Q