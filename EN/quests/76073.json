,"isHidden":false,"talkIds":[7607301],"talks":[{"talkId":7607301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7607301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7607301,"initDialog":760730101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21882],"performCfg":"","priority":2,"questId":76073,"showRandomTalkCount":0},"dialogs":[{"nodeId":760730101,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":2320513402,"text":"Can't see Novokitezhgrad from here...","nextNodeIds":[760730102,760730106,760730111]},{"nodeId":760730102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3476683610,"text":"About Novokitezhgrad...","nextNodeIds":[760730103]},{"nodeId":760730103,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":2421083802,"text":"I felt stifled while I lived there, but now that I've left, I find myself missing it... This is the first time I've been so far from home.","nextNodeIds":[760730104]},{"nodeId":760730104,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":4042262522,"text":"I thought there would be plenty of fae living in other places too, like back home. Even Snezhnograd has its fair share of them.","nextNodeIds":[760730105]},{"nodeId":760730105,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":3790021746,"text":"But then I ended up in Nod-Krai and haven't even seen a single one of them. Paimon also said she isn't fae. Hmm... It's got nothing to do with the climate here, right...?","nextNodeIds":[760730113]},{"nodeId":760730113,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":4233809162,"text":"There's no snowstorms here, and you won't be left without options if you're caught without a stove in the wild.","nextNodeIds":[760730114]},{"nodeId":760730114,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":1910008706,"text":"Oh and, I even saw someone drinking liquor from Novokitezhgrad in Nod-Krai. We're known for our liquor industry as much as our mining industry, but still, seeing stuff from home makes me... sentimental?","nextNodeIds":[]},{"nodeId":760730106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2191422138,"text":"About Raskolnikov...","nextNodeIds":[760730107]},{"nodeId":760730107,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":2981868818,"text":"Ah, him... He used to be the best and favorite student of my father's. I guess he's made a name for himself now that he's with the Fatui?","nextNodeIds":[760730108]},{"nodeId":760730108,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":3314678842,"text":"I used to admire him too. I wanted to be like him... but I guess no matter how hard I try, I can never beat him.","nextNodeIds":[760730109]},{"nodeId":760730109,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":4269607642,"text":"Hmm, I used to think he didn't care about me at all, but this time I could feel his hostility. I wonder why?","nextNodeIds":[760730110]},{"nodeId":760730110,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":2839989978,"text":"And that comment about me being \"arrogant\"... No idea where that came from.","nextNodeIds":[]},{"nodeId":760730111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":937570,"text":"See you around!","nextNodeIds":[760730112]},{"nodeId":760730112,"roleType":"TALK_ROLE_NPC","speakerId":21882,"speakerName":"Netochka","textMapHash":2290983018,"text":"Yeah! Until then, good luck to the both of us!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7607302,"order":2,"stepDescription":"","stepDescTextMapHash":72090876,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7600340