{"mainQuestId":79075,"title":"","description":"","titleTextMapHash":4125736199,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":79075,"titleTextMapHash":4125736199,"title":"","descTextMapHash":3914598782,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":2032,"luaPath":"Actor/Quest/WQ79075","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2032,"chapterId":0,"descTextMapHash":3914598782,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":79075,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1627337009,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ79075","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":79060,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4125736199,"type":"WQ","unlockDescTextMapHash":1866968078}},"flow":[{"subQuestId":7907501,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7907501],"talks":[{"talkId":7907501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7907501,"initDialog":790750101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21449],"performCfg":"QuestDialogue/WQ/FairyBook_79075/Q7907501","priority":5,"questId":79075,"showRandomTalkCount":0},"dialogs":[{"nodeId":790750101,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":4050708842,"text":"Just what is Chauvigne thinking? *sigh* He doesn't even want to talk with me.","nextNodeIds":[790750102]},{"nodeId":790750102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":167708266,"text":"About Chauvigne...","nextNodeIds":[790750103]},{"nodeId":790750103,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":1454235954,"text":"Hello there. I'm really sorry, but... It's Chauvigne. He's still angry at me, and refuses to come out and speak with me.","nextNodeIds":[790750104]},{"nodeId":790750104,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":54533434,"text":"*sigh* But the wind and sunlight can't reach him down there. What if he withers? What then!?","nextNodeIds":[790750105]},{"nodeId":790750105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":290967698,"text":"Uhm... Since we're talking about a potted flower...","nextNodeIds":[790750106]},{"nodeId":790750106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":33092570,"text":"We can just scoop him up.","nextNodeIds":[790750107]},{"nodeId":790750107,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":2177166530,"text":"I've tried! But as long as Chauvigne's upset, I can't even get close...","nextNodeIds":[790750108]},{"nodeId":790750108,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":3631905706,"text":"He's in such a stormy mood that I nearly got blown away!","nextNodeIds":[790750109]},{"nodeId":790750109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3283306514,"text":"Wait, how can being angry blow someone away?","nextNodeIds":[790750110,790750111]},{"nodeId":790750110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4172818754,"text":"That's pretty stormy, alright.","nextNodeIds":[790750112]},{"nodeId":790750112,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":1543253554,"text":"Maybe the reason he's so furious with me is because I refused to venture out with him before...","nextNodeIds":[790750113]},{"nodeId":790750113,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":1771299898,"text":"Please, dear guests, can I trouble you to check on Chauvigne? Perhaps you might even be able to reason with him.","nextNodeIds":[790750114]},{"nodeId":790750114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1860444586,"text":"No problem, we'll give it a try.","nextNodeIds":[790750115]},{"nodeId":790750115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":666163466,"text":"Yeah! We've traveled to so many places, and seen so many people, we'll defin... probably be able to convince him!","nextNodeIds":[790750116]},{"nodeId":790750116,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":367465434,"text":"That's wonderful! You can find him in the cavern below this island. Please, if you'll head that way...","nextNodeIds":[790750117]},{"nodeId":790750117,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":3552324818,"text":"I... I must tidy up this place, and find a good place for Chauvigne to soak up some sun.","nextNodeIds":[]},{"nodeId":790750111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":409784322,"text":"That would make it hard to get close, yes.","nextNodeIds":[790750112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100","610008081"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["100","610008150,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["100","610008164,3"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP