{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7907502,"initDialog":790750201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21449],"performCfg":"","priority":5,"questId":79075,"showRandomTalkCount":0},"dialogs":[{"nodeId":790750201,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":2604395970,"text":"I... I must tidy up this place, and find a good place for Chauvigne to soak up some sun.","nextNodeIds":[790750202]},{"nodeId":790750202,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":1330140666,"text":"I leave the matter of persuading Chauvigne in your hands, dear guests.","nextNodeIds":[790750203]},{"nodeId":790750203,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":1040892146,"text":"If I were to see him, he would surely think me clingy, and become even more tempestuous...","nextNodeIds":[]}]},{"talkId":7907503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7907503,"initDialog":790750301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21585],"performCfg":"QuestDialogue/WQ/FairyBook_79075/Q7907503","priority":5,"questId":79075,"showRandomTalkCount":0},"dialogs":[{"nodeId":790750301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3145698618,"text":"Phew... The wind's finally stopped...","nextNodeIds":[790750302,790750303]},{"nodeId":790750302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3282125698,"text":"Listen to us, please.","nextNodeIds":[790750304]},{"nodeId":790750304,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":3580734210,"text":"Fine. I'll listen to what you have to say. But before that...","nextNodeIds":[790750305]},{"nodeId":790750305,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":2204567514,"text":"Look how shocked the two of you are! I'm sure you're dying to ask, \"How can a flower speak?\"","nextNodeIds":[790750306]},{"nodeId":790750306,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":1111859058,"text":"Or perhaps, \"How did you turn into a potted flower?\"","nextNodeIds":[790750307]},{"nodeId":790750307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2113565914,"text":"Do people usually ask that?","nextNodeIds":[790750308]},{"nodeId":790750308,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":301354978,"text":"Outside, yes, many. After I returned home... No, nobody has asked.","nextNodeIds":[790750309]},{"nodeId":790750309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":404696170,"text":"By \"outside,\" do you mean outside this world?","nextNodeIds":[790750310]},{"nodeId":790750310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1494185674,"text":"I've heard that you only became like this after venturing.","nextNodeIds":[790750311]},{"nodeId":790750311,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":307779946,"text":"Well well, look who's so well-informed! I suppose Panuelle must have told you?","nextNodeIds":[790750312]},{"nodeId":790750312,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":3644015738,"text":"That's correct. I became like this while I was venturing. Hehe, to borrow a phrase from that Rozel... This was the \"change\" I chose to make.","nextNodeIds":[790750313]},{"nodeId":790750313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2632886530,"text":"Paimon gets change... But why change into a potted flower?","nextNodeIds":[790750314,790750315]},{"nodeId":790750314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":261899962,"text":"Could it be because you really, really like plants?","nextNodeIds":[790750316]},{"nodeId":790750316,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":2615400682,"text":"No. I just... wanted to find my \"place.\"","nextNodeIds":[790750317]},{"nodeId":790750317,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":239430658,"text":"I met many people outside this world. Some were chefs, others florists, others teachers.","nextNodeIds":[790750318]},{"nodeId":790750318,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":71481002,"text":"Almost everyone had found a \"place\" that made them feel at ease. That was how they'd all managed to establish themselves in life.","nextNodeIds":[790750319]},{"nodeId":790750319,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":2756504626,"text":"And me? All I could do was venture. I had never thought of finding a stable \"place\" for myself.","nextNodeIds":[790750320]},{"nodeId":790750320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2023430898,"text":"This \"flower pot\" is your \"place.\"","nextNodeIds":[790750321]},{"nodeId":790750321,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":458624314,"text":"Exactly. You catch on quick.","nextNodeIds":[790750322]},{"nodeId":790750322,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":1924707762,"text":"As a flower in a pot, I'll always have a \"place\" that puts me at ease.","nextNodeIds":[790750323]},{"nodeId":790750323,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":4075845154,"text":"But... *sigh* Since I've already got myself a pot, and a \"place\" that belongs to me, why do I still want to go out venturing?","nextNodeIds":[790750324]},{"nodeId":790750324,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":1549572426,"text":"I'm a venturer, after all. Without venturing, is there anything else of value I can do?","nextNodeIds":[790750325]},{"nodeId":790750325,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":3013767322,"text":"I don't get it. The more of the outside world I see, the less I understand... Between having a \"place\" and \"venturing,\" which is more important?","nextNodeIds":[790750326]},{"nodeId":790750326,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":2514857090,"text":"The more I think about it, the more my head hurts... And when I talk with Panuelle, I always duck his questions.","nextNodeIds":[790750327]},{"nodeId":790750327,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":999585210,"text":"I'm afraid of misleading him. If he loved venturing, would he grow to hate it after seeing me like this?","nextNodeIds":[790750328]},{"nodeId":790750328,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":106385818,"text":"He is my friend, and always will be. I must be honest with him, and I have answered all that he has asked.","nextNodeIds":[790750329]},{"nodeId":790750329,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":3090923474,"text":"Including... That the reason I became a flower is so I could have a \"place\" that made me feel at ease.","nextNodeIds":[790750330]},{"nodeId":790750330,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":4231772034,"text":"Perhaps my answer upset him... Or perhaps, it's because he doesn't like the way I am now.","nextNodeIds":[790750331]},{"nodeId":790750331,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":976064434,"text":"We are growing apart, but as I am but a potted plant, I cannot go up myself.","nextNodeIds":[790750332]},{"nodeId":790750332,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":128503266,"text":"But it's probably for the best, I'm sure Panuelle doesn't want to see me anyway. He must be angry with me.","nextNodeIds":[790750333]},{"nodeId":790750333,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2987671034,"text":"Oh... So that's what's going on! You both think the other one's angry with you!","nextNodeIds":[790750334]},{"nodeId":790750334,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3942841586,"text":"And so they aren't willing to meet.","nextNodeIds":[790750335]},{"nodeId":790750335,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":207064538,"text":"What? Y—You mean, Panuelle isn't mad at me?","nextNodeIds":[790750336,790750337]},{"nodeId":790750336,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2381670442,"text":"You two are thinking the exact same thing.","nextNodeIds":[790750338]},{"nodeId":790750338,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3352100314,"text":"You tell Chauvigne all about everything Panuelle is thinking...","nextNodeIds":[790750339]},{"nodeId":790750339,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":852368066,"text":"Skies above, how could I ever think such a thing? I have never wanted to see him upset, and even should the corners of his lips twitch downward, my heart would be utterly shattered!","nextNodeIds":[790750340]},{"nodeId":790750340,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":1991126938,"text":"Dear guests! I must ask you to bring me up, I beg it of you! I must see him with all haste! I cannot wait another minute, no, not even another second!","nextNodeIds":[790750341]},{"nodeId":790750341,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1843807546,"text":"I was waiting for you to say that, my potted friend.","nextNodeIds":[790750342]},{"nodeId":790750342,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1023781610,"text":"#Hehe, Paimon was waiting for it too! Off we go, {NICKNAME}!","nextNodeIds":[]},{"nodeId":790750337,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2100235682,"text":"He actually thinks you're the one who's angry at him.","nextNodeIds":[790750338]},{"nodeId":790750315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2578416698,"text":"Your dream is to become a botanist?","nextNodeIds":[790750316]},{"nodeId":790750303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3400171914,"text":"Panuelle has something he'd like to tell you.","nextNodeIds":[790750304]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7907504,"order":4,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7907504"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7907504"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7907505,"order":5,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7907504],"talks":[{"talkId":7907504,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907505","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7907504,"initDialog":790750401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21449,21585],"performCfg":"QuestDialogue/WQ/FairyBook_79075/Q7907504","priority":5,"questId":79075,"showRandomTalkCount":0},"dialogs":[{"nodeId":790750401,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":2813258410,"text":"Chauvigne! Y—You've come. Please, listen to me, I've never been mad at you, and never wanted to leave you.","nextNodeIds":[790750402]},{"nodeId":790750402,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":2214169170,"text":"I was only worried that you didn't want to be friends with me... I know that some venturers change, and I was worried you had too...","nextNodeIds":[790750403]},{"nodeId":790750403,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":1642232642,"text":"I prayed to the goddess, but... But I couldn't find a good enough gift to offer, so she naturally ignored me...","nextNodeIds":[790750404]},{"nodeId":790750404,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":262090034,"text":"No! Panuelle, such a thing could never happen. I will always, always be your friend.","nextNodeIds":[790750405]},{"nodeId":790750405,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":4120938194,"text":"I must apologize to you! I was so focused on my own thoughts that I failed to listen to what you were saying.","nextNodeIds":[790750406]},{"nodeId":790750406,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":776816962,"text":"I assumed... I assumed you never wanted to see me again.","nextNodeIds":[790750407]},{"nodeId":790750407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1752573194,"text":"Seems we've cleared up this misunderstanding.","nextNodeIds":[790750408]},{"nodeId":790750408,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3094140394,"text":"Yeah! Paimon thought you two had some crazy sticking point, and were so super mad you didn't even want to try and understand each other!","nextNodeIds":[790750409,790750410]},{"nodeId":790750409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1813982210,"text":"It definitely was a sticky matter...","nextNodeIds":[790750411]},{"nodeId":790750411,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":2882295506,"text":"Thank you both, my dear guests. Without you, I'd definitely still be holed up in there, refusing to come out.","nextNodeIds":[790750412]},{"nodeId":790750412,"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","textMapHash":320055338,"text":"But now, I can finally share what's in my heart with Panuelle.","nextNodeIds":[790750413]},{"nodeId":790750413,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":341647274,"text":"I am always willing to listen to whatever you have to say, Chauvigne. Whether you wish to speak of venturing, or of flower pots... It's all fine by me.","nextNodeIds":[790750414]},{"nodeId":790750414,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":604001986,"text":"Right, dear guests. Please, take these. I gathered them specially for you.","nextNodeIds":[790750415]},{"nodeId":790750415,"roleType":"TALK_ROLE_NPC","speakerId":21449,"speakerName":"Panuelle","textMapHash":2520804834,"text":"May the goddess bless you, that you may never argue with your friends, and that someone will always be willing to listen to your innermost thoughts.","nextNodeIds":[]},{"nodeId":790750410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3438018538,"text":"But at least it's come unstuck now.","nextNodeIds":[790750411]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100","610008082,3"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["100","610008083,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["100","610008084,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7907501,7907502,7907503,7907504],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21585,"speakerName":"Chauvigne","count":30},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":19},{"roleType"