QuestDialogue/WQ/Sumeru_73697/Q7370201","priority":5,"questId":73702,"showRandomTalkCount":0},"dialogs":[{"nodeId":737020101,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1676657082,"text":"You look much happier than when last we spoke. Seems things have gone well?","nextNodeIds":[737020102]},{"nodeId":737020102,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2961911850,"text":"Hmm. From what I've learned doing these tasks, I have grown. For now...","nextNodeIds":[737020103]},{"nodeId":737020103,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":738289850,"text":"You are worthy of being called Bloomguard?","nextNodeIds":[737020104]},{"nodeId":737020104,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2814434250,"text":"No... not yet. There is still a final portion of the task that I need to complete.","nextNodeIds":[737020105]},{"nodeId":737020105,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1688633586,"text":"Until all the tasks are done, until your respect is earned, I am not finished. Only then can the \"Twin-Horned Chaplet\" truly belong to me.","nextNodeIds":[737020106]},{"nodeId":737020106,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":4089659322,"text":"Oh? Looks like you're actually beyond your rebellious phase after all, just as was claimed.","nextNodeIds":[737020107]},{"nodeId":737020107,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3180208546,"text":"E—Elder, you... still remember that? Forget, I beg of you!","nextNodeIds":[737020108]},{"nodeId":737020108,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2324352194,"text":"Haha. Regardless, it's good to see that your spirits have returned.","nextNodeIds":[737020109]},{"nodeId":737020109,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":4183557666,"text":"#{NICKNAME}. Paimon. Please be witnesses to the truth of whether Sorush is worthy of the Twin-Horned Chaplet.","nextNodeIds":[737020110]},{"nodeId":737020110,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1746476914,"text":"Then I will await you at the end. See you soon.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7370202,"order":6,"stepDescription":"Head to the specified location and complete the trial","stepDescTextMapHash":2360089732,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7370202"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7370202_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7370202"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE