{"mainQuestId":73702,"title":"The Recollector's Path","description":"The training is approaching its conclusion. Zurvan's approval is but a step away...\\n","titleTextMapHash":943463367,"descTextMapHash":4271491078,"mainQuestExcel":{"mainQuestId":73702,"titleTextMapHash":943463367,"title":"The Recollector's Path","descTextMapHash":4271491078,"description":"The training is approaching its conclusion. Zurvan's approval is but a step away...\\n","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5132,"luaPath":"Actor/Quest/WQ73702","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5132,"chapterId":0,"descTextMapHash":4271491078,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73702,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":776403505,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73702","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173702],"series":73697,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":943463367,"type":"WQ","unlockDescTextMapHash":3834484214}},"flow":[{"subQuestId":7370201,"order":5,"stepDescription":"Talk to Zurvan","stepDescTextMapHash":3751725628,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","G