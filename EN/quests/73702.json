nableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7370206","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7323201","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370206,"initDialog":737020601,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7370206","priority":5,"questId":73702,"showRandomTalkCount":0},"dialogs":[{"nodeId":737020601,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2735118042,"text":"The Tunigi Hollow... this was the epicenter of the disaster. Though all seems calm...","nextNodeIds":[737020602]},{"nodeId":737020602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1769041730,"text":"It's not hard to think of how things were then.","nextNodeIds":[737020603]},{"nodeId":737020603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2844837034,"text":"These crystals are huge... A lot bigger than even Wenut! And to think it's Sorush's responsibility to handle future problems here...","nextNodeIds":[737020604]},{"nodeId":737020604,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":3421211946,"text":"Is this not the most essential duty a Bloomguard should uphold? In addition, Sorush should also expect this of herself.","nextNodeIds":[737020605]},{"nodeId":737020605,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1634178098,"text":"That's what they say, anyway...","nextNodeIds":[737020606]},{"nodeId":737020606,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1311485906,"text":"Do you not trust me? Hmph. I did not realize I was at the stage that even the Pale Floater thinks so little of me.","nextNodeIds":[737020607]},{"nodeId":737020607,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":81094634,"text":"Whoa, Sorush's arrogance makes its grand return!","nextNodeIds":[737020608]},{"nodeId":737020608,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3388706450,"text":"Not sure if that's a good thing or a bad thing.","nextNodeIds":[737020609]},{"nodeId":737020609,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1471437378,"text":"Hmph. Why do both of you still harbor such doubt in me after our time together? My pride has never been born of blind arrogance.","nextNodeIds":[737020610]},{"nodeId":737020610,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3401682074,"text":"Hmm. You should be well aware that I fully understand my past mistakes.","nextNodeIds":[737020611]},{"nodeId":737020611,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1567849490,"text":"Before, I placed reputation above action, but now, as I have learned, this is an act of purest neglect.","nextNodeIds":[737020612]},{"nodeId":737020612,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3880409514,"text":"Just as Simurgh became the divine bird through her sacrifice, I will become the Bloomguard by my deeds and hear my name rightfully sung in praise of my service.","nextNodeIds":[737020613]},{"nodeId":737020613,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2830969514,"text":"Additionally, I have completed all the assignments you have given me, Elder. Now, even you must admit that I am one worthy of the title of Bloomguard, worthy of the Twin-Horned Chaplet.","nextNodeIds":[737020614]},{"nodeId":737020614,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":3878562874,"text":"I indeed have no objection to the choice made by the Khvarena.","nextNodeIds":[737020615]},{"nodeId":737020615,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4070910762,"text":"...Hm?","nextNodeIds":[737020616]},{"nodeId":737020616,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2077690378,"text":"What? Did you expect me to object?","nextNodeIds":[737020617]},{"nodeId":737020617,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2851823618,"text":"No... I merely... did not expect you to agree so easily, Elder...","nextNodeIds":[737020618]},{"nodeId":737020618,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":205517538,"text":"I expected a few rough words at least?","nextNodeIds":[737020619]},{"nodeId":737020619,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1550966354,"text":"Ah, I'm not nearly so vicious.","nextNodeIds":[737020620]},{"nodeId":737020620,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":835864274,"text":"About the responsibilities of a Bloomguard... I did not actually gain any knowledge from the Chaplet...","nextNodeIds":[737020621]},{"nodeId":737020621,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":558835394,"text":"Is this because I still do not embody the traits of the Bloomguard fully? Do I still lack training?","nextNodeIds":[737020622]},{"nodeId":737020622,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1061131186,"text":"For this... The title of Bloomguard might be inherited, but the duties are always variable...","nextNodeIds":[737020623]},{"nodeId":737020623,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3518153778,"text":"I see.","nextNodeIds":[737020624]},{"nodeId":737020624,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":947165058,"text":"To state it simply: there are no fixed rules, and even more, there are no specific judging standards. Usually, the Khvarena's choice is final.","nextNodeIds":[737020625]},{"nodeId":737020625,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2990957914,"text":"Huh? So, you're saying...","nextNodeIds":[737020626]},{"nodeId":737020626,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2745701530,"text":"I will not be taking the Twin-Horned Chaplet from you.","nextNodeIds":[737020627,737020629]},{"nodeId":737020627,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4088799578,"text":"Now you don't need to worry about the top of your head getting cold.","nextNodeIds":[737020628]},{"nodeId":737020628,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2819584618,"text":"Missing the point!","nextNodeIds":[737020633]},{"nodeId":737020633,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":99551482,"text":"I understand! This must be part of the test!","nextNodeIds":[737020634]},{"nodeId":737020634,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":771202282,"text":"Seems like Sorush is having an epiphany...","nextNodeIds":[737020635]},{"nodeId":737020635,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":325017786,"text":"You are a forgetful one, Pale Floater. I just said it! To pass these tests, besides competence and observation, the most important thing is understanding my past mistakes.","nextNodeIds":[737020636]},{"nodeId":737020636,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2604177194,"text":"Even if the outcome was already determined, would it not be retreading the path of folly if I cast aside all that I have learned during training? So, I think this must be the last test my elder has left me.","nextNodeIds":[737020637]},{"nodeId":737020637,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":970258714,"text":"To a worthy Bloomguard this is but a simple task. This is a sign of your complete trust in me, Elder.","nextNodeIds":[737020638]},{"nodeId":737020638,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2007875506,"text":"I didn't expect you to see right through me. The Khvarena chose well.","nextNodeIds":[737020639]},{"nodeId":737020639,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2465511362,"text":"#But your changes... I suppose {NICKNAME} and Paimon bear some credit for that.","nextNodeIds":[737020640]},{"nodeId":737020640,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3503149754,"text":"Indeed! My esteemed Yasnapati and the Pale Floater are both beings of merit.","nextNodeIds":[737020641]},{"nodeId":737020641,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2568221098,"text":"Though I wish to say that I am potent enough alone... I believe that with their aid, the extinguishing of the Sign of Apaosha will be no difficult task.","nextNodeIds":[737020642]},{"nodeId":737020642,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":718761114,"text":"How very reliable. Don't forget, Mihir and Rashnu will also be able to assist you.","nextNodeIds":[737020643]},{"nodeId":737020643,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":48739106,"text":"Worry not, Elder! Leave everything to me!","nextNodeIds":[737020644]},{"nodeId":737020644,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3634464482,"text":"Paimon keeps thinking that Zurvan might have planned this... But seeing Sorush this happy, Paimon can't really complain.","nextNodeIds":[]},{"nodeId":737020629,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":12533578,"text":"Will not, or can not.","nextNodeIds":[737020630]},{"nodeId":737020630,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":408795458,"text":"Yeah, as Zurvan said herself, the Khvarena's choice is final. That means that Zurvan can't change it either, right?","nextNodeIds":[737020631]},{"nodeId":737020631,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1992309170,"text":"Oh, ho ho... You really think so?","nextNodeIds":[737020632]},{"nodeId":737020632,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1158550970,"text":"Whoa... That's a little scary...","nextNodeIds":[737020633]}]},{"talkId":7370207,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7370206","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7323201","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370207,"initDialog":737020701,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210,4284],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7370207","priority":5,"questId":73702,"showRandomTalkCount":0},"dialogs":[{"nodeId":737020701,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2831682530,"text":"The Tunigi Hollow from before... the epicenter of the disaster of years past...","nextNodeIds":[737020702]},{"nodeId":737020702,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":828362778,"text":"Wow! Paimon didn't think Sorush would really be able to extinguish the Sign of Apaosha and solve all the trouble happening here...","nextNodeIds":[737020703]},{"nodeId":737020703,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":245162002,"text":"Extinguishing the Sign of Apaosha is but the duty of the Bloomguard. Sorush only did as she should.","nextNodeIds":[737020704]},{"nodeId":737020704,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2332835562,"text":"It was all thanks to Mihir and Rashnu's help.","nextNodeIds":[737020705]},{"nodeId":737020705,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":348901922,"text":"Yeah. And we put in plenty of work too.","nextNodeIds":[737020706]},{"nodeId":737020706,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1107083490,"text":"Splendid! It's so nice of you, my Yasnapati and the Pale Floater, to look beyond the person of greatest importance: me.","nextNodeIds":[737020707]},{"nodeId":737020707,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1973867978,"text":"Whoa, Sorush's arrogance makes its grand return!","nextNodeIds":[737020708]},{"nodeId":737020708,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4166279386,"text":"Hmph. Why do both of you still harbor such doubt in me after our time together? My pride has never been born of blind arrogance.","nextNodeIds":[737020709]},{"nodeId":737020709,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1580175690,"text":"Hmm. You should be well aware that I fully understand my past mistakes.","nextNodeIds":[737020710]},{"nodeId":737020710,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3384853690,"text":"Before, I placed reputation above action, but now, as I have learned, this is an act of purest neglect.","nextNodeIds":[737020711]},{"nodeId":737020711,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3209519666,"text":"Just as Simurgh became the divine bird through her sacrifice, I will become the Bloomguard by my deeds and hear my name rightfully sung in praise of my service.","nextNodeIds":[737020712]},{"nodeId":737020712,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2689261850,"text":"Additionally, I have completed all the assignments you have given me, Elder. Now, even you must admit that I am one worthy of the title of Bloomguard, worthy of the Twin-Horned Chaplet.","nextNodeIds":[737020713]},{"nodeId":737020713,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1451839514,"text":"I indeed have no objection to the choice made by the Khvarena.","nextNodeIds":[737020714]},{"nodeId":737020714,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3918437394,"text":"...Hm?","nextNodeIds":[737020715]},{"nodeId":737020715,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":3666890730,"text":"What? Did you expect me to object?","nextNodeIds":[737020716]},{"nodeId":737020716,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2776622386,"text":"No... I merely... did not expect you to agree so easily, Elder...","nextNodeIds":[737020717]},{"nodeId":737020717,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2673552154,"text":"I expected a few rough words at least?","nextNodeIds":[737020718]},{"nodeId":737020718,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":322544770,"text":"Ah, I'm not nearly so vicious.","nextNodeIds":[737020719]},{"nodeId":737020719,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4004018434,"text":"About the responsibilities of a Bloomguard... I did not actually gain any knowledge from the Chaplet...","nextNodeIds":[737020720]},{"nodeId":737020720,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4059252922,"text":"Is this because I still do not embody the traits of the Bloomguard fully? Do I still lack training?","nextNodeIds":[737020721]},{"nodeId":737020721,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":4115643538,"text":"For this... The title of Bloomguard might be inherited, but the duties are always variable...","nextNodeIds":[737020722]},{"nodeId":737020722,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4230436194,"text":"I see.","nextNodeIds":[737020723]},{"nodeId":737020723,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1997420106,"text":"To state it simply: there are no fixed rules, and even more, there are no specific judging standards. Usually, the Khvarena's choice is final.","nextNodeIds":[737020724]},{"nodeId":737020724,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1401721322,"text":"Huh? So, you're saying...","nextNodeIds":[737020725]},{"nodeId":737020725,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2195181466,"text":"I will not be taking the Twin-Horned Chaplet from you.","nextNodeIds":[737020726,737020728]},{"nodeId":737020726,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3050083234,"text":"Now you don't need to worry about the top of your head getting cold.","nextNodeIds":[737020727]},{"nodeId":737020727,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3011917370,"text":"Missing the point!","nextNodeIds":[737020732]},{"nodeId":737020732,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1640209434,"text":"I understand! This must be part of the test!","nextNodeIds":[737020733]},{"nodeId":737020733,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3336556026,"text":"Seems like Sorush is having an epiphany...","nextNodeIds":[737020734]},{"nodeId":737020734,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1965533874,"text":"You are a forgetful one, Pale Floater. I just said it! To pass these tests, besides competence and observation, the most important thing is understanding my past mistakes.","nextNodeIds":[737020735]},{"nodeId":737020735,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4083907954,"text":"Even if the outcome was already determined, would it not be retreading the path of folly if I cast aside all that I have learned during training? So, I think this must be the last test my elder has left me.","nextNodeIds":[737020736]},{"nodeId":737020736,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2627117234,"text":"To a worthy Bloomguard this is but a simple task. This is a sign of your complete trust in me, Elder.","nextNodeIds":[737020737]},{"nodeId":737020737,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2148458674,"text":"I didn't expect you to see right through me. The Khvarena chose well.","nextNodeIds":[737020738]},{"nodeId":737020738,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":3713167394,"text":"#But your changes... I suppose {NICKNAME} and Paimon bear some credit for that.","nextNodeIds":[737020739]},{"nodeId":737020739,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1891159690,"text":"Indeed! My esteemed Yasnapati and the Pale Floater are both beings of merit.","nextNodeIds":[737020740]},{"nodeId":737020740,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":205115674,"text":"Though I wish to say that I was potent enough alone... I think, truly, that only with their aid could I extinguish the Sign of Apaosha.","nextNodeIds":[737020741]},{"nodeId":737020741,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":3107100226,"text":"I didn't think that, in so short a time, Sorush could become so responsible.","nextNodeIds":[737020742]},{"nodeId":737020742,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3851171882,"text":"Of course! As long as I hold my responsibilities close to heart, then my elder ne