","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"8,12"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7351301,"order":2,"stepDescription":"Talk to the two researchers","stepDescTextMapHash":3340396860,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7351301],"talks":[{"talkId":7351301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351301,"initDialog":735130101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30343,30342],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351301","priority":5,"questId":73513,"showRandomTalkCount":0},"dialogs":[{"nodeId":735130101,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":838661434,"text":"...So why did you order customized rivets? They don't improve performance at all, do they?","nextNodeIds":[735130102]},{"nodeId":735130102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":4230168042,"text":"...Riveted armor is a symbol of romance for us Kshahrewar researchers!","nextNodeIds":[735130103]},{"nodeId":735130103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3913606754,"text":"You guys... have been at it since yesterday?","nextNodeIds":[735130104]},{"nodeId":735130104,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1499491258,"text":"Ah, you're already here! Not exactly. We actually had the debate about funding yesterday.","nextNodeIds":[735130105]},{"nodeId":735130105,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":916515818,"text":"Hmph... We were actually arguing about something else. But before I knew it, we went right back to arguing about funding...","nextNodeIds":[735130106]},{"nodeId":735130106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1149992250,"text":"Something else?","nextNodeIds":[735130107]},{"nodeId":735130107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3809678578,"text":"I've polished the seams of the components until they are shiny and sparkly, but Shriya's trying to abandon the plan!","nextNodeIds":[735130108]},{"nodeId":735130108,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3739384762,"text":"Abandon!? I just want a temporary pause!","nextNodeIds":[735130109]},{"nodeId":735130109,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1292022738,"text":"Didn't you notice that there's something wrong with the environmental parameters? If we continue with the assembly, the charging efficiency of the device will be much lower than expected.","nextNodeIds":[735130110]},{"nodeId":735130110,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1446315498,"text":"We need to figure out what's going on in this area, eliminate all external influences, then proceed with assembly as planned.","nextNodeIds":[735130111]},{"nodeId":735130111,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1869915914,"text":"There are plenty of situations where the ideal and actual circumstances don't match. There's no need to be so fussy.","nextNodeIds":[735130112]},{"nodeId":735130112,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3573436010,"text":"I took the margin of error in consideration when I drafted the blueprint, so it's not a big deal at all.","nextNodeIds":[735130113]},{"nodeId":735130113,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":183511674,"text":"Besides, sometimes you have to test things out before you can figure out what the problem is.","nextNodeIds":[735130114]},{"nodeId":735130114,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3712168946,"text":"...Is that why you tested Experimental Device No. 2 until it exploded that other year?","nextNodeIds":[735130115]},{"nodeId":735130115,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":108758386,"text":"That... that was different! I didn't realize the need to leave room for error back then...","nextNodeIds":[735130116]},{"nodeId":735130116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3332238050,"text":"...Is there a safer way to do this?","nextNodeIds":[735130117]},{"nodeId":735130117,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1785405706,"text":"I'm thinking... Maybe we could first switch off the turret's firing function and just do a simulated experiment of its charging process?","nextNodeIds":[735130118]},{"nodeId":735130118,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1532136010,"text":"...That won't do, I don't trust your judgment on this. Let's get rid of the turret ignition module, and I'll safeguard it for you. You can install the other components however you please.","nextNodeIds":[735130119]},{"nodeId":735130119,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1351158226,"text":"Remove the ignition module!? Then the Wenutslayer Cannon will just be one big paperweight!","nextNodeIds":[735130120]},{"nodeId":735130120,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3141359466,"text":"Didn't you say we'd just do an experimental simulation of the charging process? At the end of the day, you're still thinking about firing that cannon!","nextNodeIds":[735130121]},{"nodeId":735130121,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":622597954,"text":"Uhh...","nextNodeIds":[735130122,735130123]},{"nodeId":735130122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1716359570,"text":"Let's just disable the firing function.","nextNodeIds":[735130124]},{"nodeId":735130124,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":89659178,"text":"Well, all right... Let's think of it as a \"trial assembly.\"","nextNodeIds":[735130125]},{"nodeId":735130125,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3003374154,"text":"If only you'd have said this earlier... I expect a lot of monsters to be attracted during the installation process. When the moment comes, we'll be counting on you, adventurer.","nextNodeIds":[]},{"nodeId":735130123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3022181882,"text":"Maybe start by building the framework?","nextNodeIds":[735130124]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYL