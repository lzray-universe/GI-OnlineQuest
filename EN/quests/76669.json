LCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7666901,7666902],"talks":[{"talkId":7666901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":true,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":4,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7666901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["600201","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["10000119","0","0","",""],"type":"QUEST_COND_PLAYER_TEAM_CONTAINS_AVATAR"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7666901,"initDialog":766690101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7058],"performCfg":"","priority":5,"questId":76669,"showRandomTalkCount":0},"dialogs":[{"nodeId":766690101,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":403711898,"text":"(Perhaps <color=#FFCC33FF>Lauma</color> might like to hear about the Feast of the Moon...)","nextNodeIds":[766690102]},{"nodeId":766690102,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2012478690,"text":"Hello, would you like to— Whoa! Lady Lauma, what brings you here?","nextNodeIds":[766690103]},{"nodeId":766690103,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2002124106,"text":"Thank you for your work, Lyylikki. Has the distribution of the \"Feast of the Moon\" gone well today?","nextNodeIds":[766690104]},{"nodeId":766690104,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2314570794,"text":"Yes, well indeed! Both cooking and handing out the meals went just perfectly!","nextNodeIds":[766690105]},{"nodeId":766690105,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1582519874,"text":"We haven't had any more troublemakers or line-cutters since Miss Jahoda came to help out for a few days. Everyone lines up nicely for their meals now!","nextNodeIds":[766690106]},{"nodeId":766690106,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1534226898,"text":"Before that, there was a big guy who kept causing problems — cutting the queue and grabbing multiple portions... Poor Mr. Kantor tried to stop him, and was hit a few times for his trouble...","nextNodeIds":[766690107]},{"nodeId":766690107,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1715971338,"text":"That day, Miss Jahoda happened to be there getting her meal. When she saw that thug causing trouble, she jumped up and kicked him so hard he fell!","nextNodeIds":[766690108]},{"nodeId":766690108,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1818370970,"text":"Having knocked him flat, she even caught the unopened meal midair — not a thing was spilled! Then she pointed at the man lying on the ground and said...","nextNodeIds":[766690109]},{"nodeId":766690109,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3386978178,"text":"\"If you have no respect for your benefactors or your food, then you can go hungry today. Now outta the way — or was one kick not enough for you?\"","nextNodeIds":[766690110]},{"nodeId":766690110,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1836259042,"text":"After that, she helped me distribute meals for many days... I made her lots of delicious food as thanks for that.","nextNodeIds":[766690111]},{"nodeId":766690111,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":4229601138,"text":"An act that deserves gratitude indeed. Perhaps... I really should hire a guard to assist you, like I mentioned before.","nextNodeIds":[766690112]},{"nodeId":766690112,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1153940306,"text":"Eh? No, there's no need for that! We're already short on manpower. We should just open another distribution point instead.","nextNodeIds":[766690113]},{"nodeId":766690113,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2339702490,"text":"Besides, things are really well organized nowadays. Miss Jahoda still stops by from time to time, and between her and Mr. Kantor, I doubt anyone would stir up further trouble.","nextNodeIds":[766690114]},{"nodeId":766690114,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1987498682,"text":"Let us hope so. In that case, I'll have some friends take turns coming over. If you need help, just tell them.","nextNodeIds":[766690115]},{"nodeId":766690115,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":957738426,"text":"Friends...? They live on the island too, I assume. Do I know them?","nextNodeIds":[766690116]},{"nodeId":766690116,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2413286650,"text":"Hehe, I am sure you do.","nextNodeIds":[766690117]},{"nodeId":766690117,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":57582546,"text":"Well then, I shall leave you to you work. See you again, Lyylikki. May the Moon Goddess guard your path.","nextNodeIds":[766690118]},{"nodeId":766690118,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1055800882,"text":"Goodbye, Lady Lauma!","nextNodeIds":[]}]},{"talkId":7666902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":true,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":4,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7666901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["600201","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["10000119","0","0","",""],"type":"QUEST_COND_PLAYER_TEAM_CONTAINS_AVATAR"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","",