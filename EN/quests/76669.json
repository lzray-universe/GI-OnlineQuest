her trouble.","nextNodeIds":[766690214]},{"nodeId":766690214,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1570445546,"text":"Let us hope so. In that case, I'll have some friends take turns coming over. If you need help, just tell them.","nextNodeIds":[766690215]},{"nodeId":766690215,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2606530298,"text":"Friends...? They live on the island too, I assume. Do I know them?","nextNodeIds":[766690216]},{"nodeId":766690216,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3253140034,"text":"Hehe, I am sure you do.","nextNodeIds":[766690217]},{"nodeId":766690217,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":4131469058,"text":"Well then, I shall leave you to your work. Goodbye, Lyylikki. May the moonlight bless your journey ahead.","nextNodeIds":[766690218]},{"nodeId":766690218,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":52581290,"text":"Goodbye, Lady Lauma!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7666901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7666902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7666701","4"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7666901,7666902],"speakerCounts":[{"roleType":"TALK_R