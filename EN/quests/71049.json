:false,"talkIds":[7104902],"talks":[{"talkId":7104902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7104902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7104902,"initDialog":710490201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1627],"performCfg":"","priority":5,"questId":71049,"showRandomTalkCount":0},"dialogs":[{"nodeId":710490201,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":4144906570,"text":"Again, I apologize for asking this favor of you, but we really are very busy at the moment. If there's any trouble, just come back later and we'll talk then.","nextNodeIds":[710490202,710490207,710490212]},{"nodeId":710490202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4191670434,"text":"Could you tell me more about The Chasm?","nextNodeIds":[710490203]},{"nodeId":710490203,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":1613971858,"text":"Well, uh... Oh, right! Silly me. I can't believe I'm sending you out without even the briefest of introductions to The Chasm.","nextNodeIds":[710490204]},{"nodeId":710490204,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":2778491338,"text":"To be honest, though, I'm not sure I'll do a good job relating the matter to you... I think it was several years ago now when the miners unearthed something strange. What that is, I don't know — nor have I really had the courage to ask around.","nextNodeIds":[710490205]},{"nodeId":710490205,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":2397387794,"text":"Either way, this was reported to the Qixing by the Huishan Hall, and one of Ningguang's secretaries sent out an investigation team that returned and reported that there was some huge threat to everyone's safety, and that the mines must be closed...","nextNodeIds":[710490206]},{"nodeId":710490206,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":416228962,"text":"As a result, the Chasm was rendered into its current state. The people of Shenglu Hall constantly ask when it will be reopened, but the Qixing will not allow it, leaving them to fret...","nextNodeIds":[]},{"nodeId":710490207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3607287818,"text":"Tell me about Muning.","nextNodeIds":[710490208]},{"nodeId":710490208,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":1463173682,"text":"Oh, him? His family is a big name in the porcelain industry. Pretty high up in Shenglu Hall... You know, the works. But he has little interest in the family business, and instead prefers to enjoy a life of leisure, going where the mood strikes him...","nextNodeIds":[710490209]},{"nodeId":710490209,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":3170986674,"text":"He's also absolutely no good with Mora, and he owes quite a few people as a result... For fear that he might ruin their business' reputation, the family had him sent to the Ministry of Civil Affairs as a representative to shape him up a bit...","nextNodeIds":[710490210]},{"nodeId":710490210,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":3743106482,"text":"It just so happened that the Ministry needed a professional from Shenglu Hall to oversee The Chasm, so he was picked as this specialist.","nextNodeIds":[710490211]},{"nodeId":710490211,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":2946545770,"text":"If you ask me, this is a good thing. According to my father, The Chasm is exactly the place to train one's character. Why, he did work there in the mines himself back when he was young...","nextNodeIds":[]},{"nodeId":710490212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1083860466,"text":"See you around, then.","nextNodeIds":[710490213]},{"nodeId":710490213,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":1561566226,"text":"Alright. Stay safe, now!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104405,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7104405,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[800402,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["101697","1"],"PAINLI