XEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7182203","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7182203,"initDialog":718220301,"nextRandomTalks":[],"nextTalks":[],"npcId":[221101],"performCfg":"","priority":5,"questId":71822,"showRandomTalkCount":0},"dialogs":[{"nodeId":718220301,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3176253082,"text":"Have you brought the sample back with you?","nextNodeIds":[718220302]},{"nodeId":718220302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3293529210,"text":"I've brought it.","nextNodeIds":[718220303]},{"nodeId":718220303,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":2027859674,"text":"Thank you very much. Let me have a look.","nextNodeIds":[718220304]},{"nodeId":718220304,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":947791066,"text":"...Hmm, there seems to be nothing special about the soil here.","nextNodeIds":[718220305]},{"nodeId":718220305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":169193570,"text":"What were you hoping to find?","nextNodeIds":[718220306]},{"nodeId":718220306,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":2840857970,"text":"The legends say that Skybracer used their strong antlers to protect Liyue Harbor by preventing Mt. Tianheng from collapsing.","nextNodeIds":[718220307]},{"nodeId":718220307,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":1522484970,"text":"I thought that I could at least find some fragments of those antlers...","nextNodeIds":[718220308]},{"nodeId":718220308,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3816121130,"text":"As I thought, legends are just that, legends... Or has so much time passed since that battle that all traces of it have long since vanished?","nextNodeIds":[718220309]},{"nodeId":718220309,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3223837274,"text":"Still, getting a soil sample is, in and of itself, not a bad result...","nextNodeIds":[718220310]},{"nodeId":718220310,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":2412148770,"text":"Traveler, could you accompany me for a while longer? I'd like to head upwards, it shouldn't be too far.","nextNodeIds":[718220311,718220312]},{"nodeId":718220311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":349003034,"text":"Leave it to me.","nextNodeIds":[718220313]},{"nodeId":718220313,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":962993386,"text":"This time... I want to get to a vantage point from which I can overlook Mt. Tianheng and study its terrain.","nextNodeIds":[718220314]},{"nodeId":718220314,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":4050400578,"text":"The tales say that Rex Lapis and many adepti took part in that battle, and very nearly caused Mt. Tianheng to collapse.","nextNodeIds":[718220315]},{"nodeId":718220315,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":1406282186,"text":"If the battle truly was that fierce, then perhaps we might be able to deduce something from the terrain.","nextNodeIds":[]},{"nodeId":718220312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1681836314,"text":"What are you looking for this time?","nextNodeIds":[718220313]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7182203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100752","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["221101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7182204,"order":5,"stepDescription":"Follow the mountain path","stepDescTextMapHash":2610162636,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7182204,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7182204Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUT