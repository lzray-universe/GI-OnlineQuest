],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7182201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7182201,"initDialog":718220101,"nextRandomTalks":[],"nextTalks":[],"npcId":[221101],"performCfg":"","priority":5,"questId":71822,"showRandomTalkCount":0},"dialogs":[{"nodeId":718220101,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":1025983330,"text":"Mt. Tianheng... Skybracer... Hmm...","nextNodeIds":[718220102]},{"nodeId":718220102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2984716122,"text":"What are you thinking about?","nextNodeIds":[718220103]},{"nodeId":718220103,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":2234914882,"text":"Ah, I'm currently researching the history and legends of Lantern Rite.","nextNodeIds":[718220104]},{"nodeId":718220104,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":1130509002,"text":"I've heard that this year's Mingxiao Lantern is modeled after an adeptus named Skybracer.","nextNodeIds":[718220105]},{"nodeId":718220105,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3588788706,"text":"From what legends I've been able to gather, this adeptus also fought alongside Rex Lapis for a time.","nextNodeIds":[718220106]},{"nodeId":718220106,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3033744290,"text":"The exact times and the enemies they faced have differed from text to ancient text...","nextNodeIds":[718220107]},{"nodeId":718220107,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3443435218,"text":"But all the sources concur that Skybracer has already passed on, and it has been stated that this adeptus once held Mt. Tianheng up with their own antlers.","nextNodeIds":[718220108]},{"nodeId":718220108,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":698113394,"text":"That's why I came to Mt. Tianheng to see for myself, thinking that if I got lucky, I might find something...","nextNodeIds":[718220109]},{"nodeId":718220109,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":2073454674,"text":"But as it turns out, Mt. Tianheng is crawling with monsters. After ascertaining the site for my investigations, I found it to be so full of monsters as to be impassable...","nextNodeIds":[718220110]},{"nodeId":718220110,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":1285269834,"text":"Traveler, if you're willing, could you help me investigate and take some soil samples?","nextNodeIds":[718220111]},{"nodeId":718220111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":539097970,"text":"Soil... samples?","nextNodeIds":[718220112]},{"nodeId":718220112,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":1386188658,"text":"Well, that's what we'd say at the Akademiya, but what we really mean is some soil from the area in question.","nextNodeIds":[718220113]},{"nodeId":718220113,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":1683999050,"text":"Local legends hold that Skybracer held Mt. Tianheng up with their own antlers...","nextNodeIds":[718220114]},{"nodeId":718220114,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3006262050,"text":"From an academic perspective, it stands to reason that the ground here might have an unusual composition.","nextNodeIds":[718220115]},{"nodeId":718220115,"roleType":"TALK_ROLE_NPC","speakerId":221101,"speakerName":"Soraya","textMapHash":3167386930,"text":"So please, help me go there and retrieve a soil sample.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7182201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["221101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7182202,"order":3,"stepDescription":"Retrieve the Soil Sample","stepDescTextMapHash":2105444772,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[71700195,0],"PAINLIBBLDK":"QUEST_CONTENT_INTERACT_GADGET","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEB