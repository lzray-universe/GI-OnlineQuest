{"mainQuestId":74506,"title":"Goal: Counter the \"Phantom Blubberbeast!\"","description":"Since Paimon's in a good mood, she suggests you take a walk around the Court of Fontaine together. You certainly didn't expect to run into an eccentric engineer...","titleTextMapHash":2619910239,"descTextMapHash":586130374,"mainQuestExcel":{"mainQuestId":74506,"titleTextMapHash":2619910239,"title":"Goal: Counter the \"Phantom Blubberbeast!\"","descTextMapHash":586130374,"description":"Since Paimon's in a good mood, she suggests you take a walk around the Court of Fontaine together. You certainly didn't expect to run into an eccentric engineer...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ74506","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":586130374,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74506,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3742269761,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74506","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174506],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2619910239,"type":"WQ","unlockDescTextMapHash":4201020590}},"flow":[{"subQuestId":7450601,"order":1,"stepDescription":"","stepDescTextMapHash":3250451900,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450601,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450601,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7450603,"order":2,"stepDescription":"Take a stroll in the Court of Fontaine's business district","stepDescTextMapHash":3121529276,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450603,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_340100327:3559.953,445.895,4442.229,0.000,251.840,0.000]","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450603,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_340100327:3559.953,445.895,4442.229,0.000,251.840,0.000]","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7450602,"order":3,"stepDescription":"Talk to Lepine-Pauline","stepDescTextMapHash":1182537740,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30423"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7450602],"talks":[{"talkId":7450602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7450602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450602,"initDialog":745060201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30423],"performCfg":"QuestDialogue/WQ/Fontaine_74506/Q7450602","priority":5,"questId":74506,"showRandomTalkCount":0},"dialogs":[{"nodeId":745060201,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":1868829818,"text":"Snappity-snap, printy-printy-printy... Stackity stack stack stack!","nextNodeIds":[745060202]},{"nodeId":745060202,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":1143057346,"text":"Whoa! Those two are kinda big deals!","nextNodeIds":[745060203]},{"nodeId":745060203,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3786069218,"text":"Hey, you two! Can I take your picture?","nextNodeIds":[745060204]},{"nodeId":745060204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1729729042,"text":"Huh...? Does she mean us? Why does she want our picture?","nextNodeIds":[745060205,745060206]},{"nodeId":745060205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3811150722,"text":"She probably just wants a keepsake.","nextNodeIds":[745060207]},{"nodeId":745060207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3804107322,"text":"Hehehe... Guess we'd better get used to the celebrity treatment, huh? Can't blame the fans for wanting a photo of their heroes!","nextNodeIds":[745060208]},{"nodeId":745060208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3137677770,"text":"But if this is for anything besides your own personal use, then we're legally allowed to charge you... Wait, what would they call it here? An appearance fee? Photoshoot fee?","nextNodeIds":[745060209]},{"nodeId":745060209,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2687880426,"text":"Absolutely! It's just an honor to be able to photograph the ace adventurer duo. How does one-and-a-half million Mora sound?","nextNodeIds":[745060210]},{"nodeId":745060210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1344364882,"text":"Sure, that sounds fine!","nextNodeIds":[745060211]},{"nodeId":745060211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1277208778,"text":"...Hold up, how much did you say again? One-and-a-half million!? Did Paimon hear that right?","nextNodeIds":[745060212]},{"nodeId":745060212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":139607554,"text":"That's a lot of Mora for just one photograph... Maybe a little too much? Are we really worth all that?","nextNodeIds":[745060213,745060214]},{"nodeId":745060213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3995687754,"text":"Snap away! Take as many photos as you like!","nextNodeIds":[745060215]},{"nodeId":745060215,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2084023650,"text":"Hah! You guys are overreacting. This measly one-and-a-half mil is just the start!","nextNodeIds":[745060216]},{"nodeId":745060216,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3589084786,"text":"If you're interested in working with me as a photographer, you could potentially be taking home anywhere up to nine-figures! Snap some snaps and stack those stacks!","nextNodeIds":[745060217]},{"nodeId":745060217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":315745978,"text":"Nine figures? That's... wait... every thousand is three figures, plus one for the one... so one million, that's seven, plus two is... ten million, a hundred million... A HUNDRED MILLION!?","nextNodeIds":[745060218,745060219]},{"nodeId":745060218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":674928714,"text":"Now you're just throwing numbers out.","nextNodeIds":[745060220]},{"nodeId":745060220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3622623130,"text":"Yeah! This all sounds too crazy even for Paimon to fall for it!","nextNodeIds":[745060221]},{"nodeId":745060221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":631445474,"text":"What kind of racket are you running here? You planning on flashing a couple of famous faces to con innocent people?","nextNodeIds":[745060222]},{"nodeId":745060222,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2786681298,"text":"Con innocent people! Hah, you took the words right out of my mouth!","nextNodeIds":[745060223]},{"nodeId":745060223,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2782036754,"text":"But you got it back to front — my goal here is to rid Teyvat of everyone out there who's trying to con innocent people. Help me out, and there'll be a big bonus in it for you!","nextNodeIds":[745060224]},{"nodeId":745060224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":316192562,"text":"Whoa, back up a little! Seems you skipped a couple of steps... How did you get from photography to... crime fighting?","nextNodeIds":[745060225]},{"nodeId":745060225,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2604772354,"text":"Well, it all has to do with an important problem in law enforcement that often gets overlooked: target recognition.","nextNodeIds":[745060226]},{"nodeId":745060226,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2699822954,"text":"Common sense says that if Gardemeks want to fight crime, the first thing they need to do is identify who's a criminal and who isn't. Right?","nextNodeIds":[745060227]},{"nodeId":745060227,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":1243595210,"text":"But what happens when a Gardemek mistakes an honest citizen for a criminal? Or sees someone brandishing a weapon in public, but fails to flag them as a potential threat? Then you've got a huge problem!","nextNodeIds":[745060228]},{"nodeId":745060228,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2750304130,"text":"Think of the poor fisherman whose fishing rod gets mistaken for a spear! Or the crafty crook who carries around a metal pipe to club his victims with, but dismissed as a regular plumber!","nextNodeIds":[745060229]},{"nodeId":745060229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1523451634,"text":"Okay... Fair enough, you're kinda making sense now...","nextNodeIds":[745060230]},{"nodeId":745060230,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3172917426,"text":"Great. Okay, so let's say I disguise myself as a cat, or a dog, or a finch, or a pigeon — or maybe even a Blubberbeast, because why the heck not? So I'm walking around the city streets like an escaped amusement park employee, and a Gardemek sees me. How do you think it would respond?","nextNodeIds":[745060231,745060232]},{"nodeId":745060231,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1157285594,"text":"Sorry, how did we get to amusement parks?","nextNodeIds":[745060233]},{"nodeId":745060233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2676471226,"text":"That's cheating!","nextNodeIds":[745060234]},{"nodeId":745060234,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":228070730,"text":"A Gardemek's not gonna do anything to some cute little critter. Also, what kind of Blubberbeast would even want to come to the city anyway...","nextNodeIds":[745060235]},{"nodeId":745060235,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3540088890,"text":"Bingo! Right answer.","nextNodeIds":[745060236]},{"nodeId":745060236,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2445240898,"text":"Gardemeks are incapable of registering cats, dogs, finches, pigeons — and, of course, Blubberbeasts — as potential targets. Their image recognition system actually ignores them completely.","nextNodeIds":[745060237]},{"nodeId":745060237,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3914756946,"text":"It is actually fairly logical, if you think about it. Removing all the near-zero-risk entities from the target database boosts performance in most situations.","nextNodeIds":[745060238]},{"nodeId":745060238,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3737299290,"text":"But here's a quote from a recent report in The Steambird: \"Several keen-eyed thieves who noticed a flaw in the Gardemeks detection systems disguised themselves as Blubberbeasts during the commission of their crimes\"...","nextNodeIds":[745060239]},{"nodeId":745060239,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3767166138,"text":"Completely blind to the would-be-Blubberbeasts, the Gardemeks made no attempt to intervene in the thefts committed by the gang.","nextNodeIds":[745060240,745060241]},{"nodeId":745060240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3477640362,"text":"Those crafty crooks!","nextNodeIds":[745060242]},{"nodeId":745060242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4053914690,"text":"Wait, so this actually happened? And the Gardemeks really didn't catch them?","nextNodeIds":[745060243]},{"nodeId":745060243,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1690019874,"text":"Okay, that's pretty gutsy... But also kinda horrifying. What if they get bored of petty theft, and move to something even worse? They could get away with anything!","nextNodeIds":[745060244]},{"nodeId":745060244,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":213429834,"text":"Exactly. And that's why we have to fight these criminals in the domain of technology. It's turned into an ongoing tug-of-war between their disguises and our image recognition capabilities.","nextNodeIds":[745060245]},{"nodeId":745060245,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":1152438626,"text":"And I, Lepine-Pauline, specialist in Graph Adversarial Technology, am determined to do my part towards a crime-free future for Fontaine!","nextNodeIds":[745060246]},{"nodeId":745060246,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":3550834946,"text":"Currently, I'm in the process of collecting sample images. Once I have a large enough pool, I'll use that to develop a simple but powerful and highly accurate image-recognition algorithm that runs on a small graphical processing module...","nextNodeIds":[745060247]},{"nodeId":745060247,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":281015474,"text":"Any clockwork meka installed with this module will instantly be able to recognize people wearing disguises and accurately assess the criminal threat they pose.","nextNodeIds":[745060248]},{"nodeId":745060248,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":4106265530,"text":"And if all goes to plan, the Palais Mermonia will jump at the chance to have these installed on every Gardemek in the city... It's the business opportunity of a lifetime!","nextNodeIds":[745060249,745060250]},{"nodeId":745060249,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":667802258,"text":"And this all starts with you doing street photography?","nextNodeIds":[745060251]},{"nodeId":745060251,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2002757594,"text":"Paimon's getting deja vu... Lemme guess, you're a homebody researcher who prefers to stick to the city, limiting your potential sample size...","nextNodeIds":[745060252]},{"nodeId":745060252,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3078780226,"text":"And the reason you wanna work with us is because we can go out into the wild and help you get all the other photos you need. Right?","nextNodeIds":[745060253]},{"nodeId":745060253,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":1580769058,"text":"Wow, haha... Right again! Down to the last detail... Sounds like the ace adventurer duo has seen it all before.","nextNodeIds":[745060254]},{"nodeId":745060254,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2883828762,"text":"Whaddaya say? Join my project, become a Graph Adversarial Technology specialist, and together we can expose every costumed offender in Fontaine!","nextNodeIds":[745060255]},{"nodeId":745060255,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":1331166474,"text":"Crucially, with your help, we can build a solid Graph Adversarial tech pipeline and take Fontaine's technology and law enforcement capabilities to the next level! Everybody wins!","nextNodeIds":[745060256]},{"nodeId":745060256,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3905930914,"text":"Hmm... This does sound like it's for a good cause...","nextNodeIds":[745060257]},{"nodeId":745060257,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1920706002,"text":"Forget the Mora — we can't stand by and do nothing... There are criminals out there giving Blubberbeasts a bad name, and that's something Paimon won't stand for!","nextNodeIds":[745060258,745060259]},{"nodeId":745060258,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":47924058,"text":"Justice for Blubberbeasts!","nextNodeIds":[745060260]},{"nodeId":745060260,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2873931666,"text":"Great! And just like that, welcome to the team!","nextNodeIds":[745060261]},{"nodeId":745060261,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":4266807570,"text":"Okay, take this — it's an Image Recognition Sample Collector. It contains recording and analysis equipment that I designed myself, and comes complete with a user guide!","nextNodeIds":[745060262]},{"nodeId":745060262,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":2841735578,"text":"I've already looked through lots of images from all over to determine the key features of the samples I'd like to collect. All you need to do is work your way through the guide, get the pictures, and bring them back to me. Simple!","nextNodeIds":[745060263]},{"nodeId":745060263,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"Lepine-Pauline","textMapHash":116362946,"text":"Let's get this show on the road, everyone. We must win the tug-of-war against evildoers... and score some big-ticket orders from the Palais Mermonia!","nextNodeIds":[]},{"nodeId":745060259,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1969763298,"text":"Nine-figure bonus, here we come!","nextNodeIds":[745060260]},{"nodeId":745060250,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3460047930,"text":"I think you might have some trouble getting enough samples...","nextNodeIds":[745060251]},{"nodeId":745060241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1986759002,"text":"So devious!","nextNodeIds":[745060242]},{"nodeId":745060232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3083478754,"text":"A disguise? Don't you mean a costume?","nextNodeIds":[745060233]},{"nodeId":745060219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3377476706,"text":"I have doubts about your sincerity.","nextNodeIds":[745060220]},{"nodeId":745060214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2373106106,"text":"This sounds too good to be true...","nextNodeIds":[745060215]},{"nodeId":745060206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2265305474,"text":"But if it's for commercial use, we could charge her for it...","nextNodeIds":[745060207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133401172"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["7450601","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_Q