apHash":986099755,"text":"Hair looks different at every place on the body, same applies to wolves. You don't know where it's from...","nextNodeIds":[4530504]},{"nodeId":4530504,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2280988851,"text":"But look at this—","nextNodeIds":[4530505]},{"nodeId":4530505,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2604456755,"text":"Another hair. But what's that stuck to it?","nextNodeIds":[4530506,4530507]},{"nodeId":4530506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4236793803,"text":"A seed.","nextNodeIds":[4530508]},{"nodeId":4530508,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4187951299,"text":"It's the seed of a Wolfhook berry. Look, there are little hooks on the seed.","nextNodeIds":[4530509]},{"nodeId":4530509,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1095650187,"text":"The only places this grows in Mondstadt are Wolvendom and Brightcrown Canyon.","nextNodeIds":[4530510]},{"nodeId":4530510,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":120082003,"text":"So it's Wolvendom wolves after all?","nextNodeIds":[4530511]},{"nodeId":4530511,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3687755419,"text":"From that area, yes, but it could be that there are other wolf packs encroaching on their territory.","nextNodeIds":[4530512]},{"nodeId":4530512,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1552736483,"text":"This doesn't tell us everything, but it does give us a strong lead. Enough to start investigating.","nextNodeIds":[4530513]},{"nodeId":4530513,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2318646499,"text":"I'll go and see to the villagers before we head off.","nextNodeIds":[]},{"nodeId":4530507,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2898163611,"text":"Is there something special about it?","nextNodeIds":[4530508]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[45305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":45306,"order":8,"stepDescription":"Calm the Springvale villagers down","stepDescTextMapHash":140982135,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[45306,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["154301"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[45306],"talks":[{"talkId":45306,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["45306","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":45306,"initDialog":4530601,"nextRandomTalks":[],"nextTalks":[],"npcId":[154301],"performCfg":"QuestDialogue/LQ/Razor1_453/Q45306","priority":0,"questId":453,"showRandomTalkCount":0},"dialogs":[{"nodeId":4530601,"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerName":"Hopkins the Marvelous","textMapHash":2198015179,"text":"How is your investigation coming along?","nextNodeIds":[4530602]},{"nodeId":4530602,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1210616963,"text":"Wha— You're standing!","nextNodeIds":[4530603]},{"nodeId":4530603,"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerName":"Hopkins the Marvelous","textMapHash":2384443363,"text":"I have recovered, thankfully. I managed to claw my way back out of the depths of hell.","nextNodeIds":[4530604]},{"nodeId":4530604,"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerName":"Hopkins the Marvelous","textMapHash":2075860403,"text":"So, Knights of Favonius — what have you found out?","nextNodeIds":[4530605]},{"nodeId":4530605,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1708371619,"text":"From inspecting wolf fur left at the scene, we can tell that the wolves came from Wolvendom. Beyond that, we don't know anything.","nextNodeIds":[4530606]},{"nodeId":4530606,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3419855339,"text":"But please remain calm. I will head to Wolvendom shortly and get to the bottom of this.","nextNodeIds":[4530607]},{"nodeId":4530607,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2992622235,"text":"The Knights of Favonius will not allow this danger to continue any longer.","nextNodeIds":[4530608]},{"nodeId":4530608,"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerName":"Hopkins the Marvelous","textMapHash":69080715,"text":"Good. Better late than never I suppose.","nextNodeIds":[4530609]},{"nodeId":4530609,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1526022611,"text":"How rude!","nextNodeIds":[4530610]},{"nodeId":4530610,"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerName":"Hopkins the Marvelous","textMapHash":3392656627,"text":"In the meantime, we'll just have to keep dealing with this on our own.","nextNodeIds":[4530611]},{"nodeId":4530611,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2166404419,"text":"Please, don't do anything stupid.","nextNodeIds":[4530612]},{"nodeId":4530612,"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerName":"Hopkins the Marvelous","textMapHash":2536406155,"text":"Hah! We do things a bit differently around here, you lot from the order probably aren't used to it. They will pay for what they've done!","nextNodeIds":[4530613]},{"nodeId":4530613,"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerName":"Hopkins the Marvelous","textMapHash":1748825147,"text":"Goodbye!","nextNodeIds":[4530614]},{"nodeId":4530614,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":162187675,"text":"It's awful, it really is...","nextNodeIds":[4530615]},{"nodeId":4530615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2941188803,"text":"What is?","nextNodeIds":[4530616]},{"nodeId":4530616,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":3436556619,"text":"Their future outlook, I mean.","nextNodeIds":[4530617]},{"nodeId":4530617,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3870457523,"text":"I agree.","nextNodeIds":[4530618]},{"nodeId":4530618,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":627194907,"text":"Young people can be so impulsive sometimes. If it's not too much to ask, I hope you can keep an eye on them, stop them from getting into trouble.","nextNodeIds":[4530619]},{"nodeId":4530619,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2841351075,"text":"It's no trouble — that's what we're here for. Even though that guy really isn't much of a charmer.","nextNodeIds":[4530620]},{"nodeId":4530620,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3823943923,"text":"Leave it to us.","nextNodeIds":[4530621]},{"nodeId":4530621,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":605570875,"text":"Off to Wolvendom we go!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[45306,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["154301"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[45301,45305,45306,45307,45308],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":154301,"speakerN