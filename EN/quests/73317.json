NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7331703,"order":3,"stepDescription":"","stepDescTextMapHash":168706684,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7331703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7331702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20987"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7331702,7331703],"talks":[{"talkId":7331702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7331703","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7325103","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7331702,"initDialog":733170201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20987],"performCfg":"QuestDialogue/WQ/Sumeru_73317/Q7331702","priority":5,"questId":73317,"showRandomTalkCount":0},"dialogs":[{"nodeId":733170201,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":2080050050,"text":"Is this how they look like now? How pitiful.","nextNodeIds":[733170202]},{"nodeId":733170202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":951383450,"text":"Sorush, what are you talking about?","nextNodeIds":[733170203]},{"nodeId":733170203,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":2812891642,"text":"Never mind. I just happened to witness the undignified states of my kind, but it's no matter.","nextNodeIds":[733170204]},{"nodeId":733170204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2764892202,"text":"You see, that makes Paimon even more curious!","nextNodeIds":[733170205]},{"nodeId":733170205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":577624826,"text":"Let Paimon have a look... Oh wow, that really is one strange tree! The way it's shaped like a circle looks almost like a door, right?","nextNodeIds":[733170206,733170207]},{"nodeId":733170206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":28523986,"text":"If we walk through it...","nextNodeIds":[733170208]},{"nodeId":733170208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1572720658,"text":"Hehe, Paimon definitely would like to go first!","nextNodeIds":[733170209]},{"nodeId":733170209,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":1578333018,"text":"...The Fravashi Trees are no doors. You'll disturb the residual Pari residing within if you simply barge through them.","nextNodeIds":[733170210]},{"nodeId":733170210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":630666530,"text":"So that's called a Fravashi Tree, huh? But where are the residual Pari... Paimon can't see them at all!","nextNodeIds":[733170211]},{"nodeId":733170211,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":953566794,"text":"Of course Pale Floater can't see them. They are still trapped by obsessions of the past, after all.","nextNodeIds":[733170212]},{"nodeId":733170212,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":1308967946,"text":"It may not be what they wished for, but looking at the sight of them clinging desperately to this world... I can hardly bear this scene.","nextNodeIds":[733170213]},{"nodeId":733170213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1816554674,"text":"Looks pretty lush to Paimon. Doesn't it look nice?","nextNodeIds":[733170214]},{"nodeId":733170214,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":4254430074,"text":"Hmph, as if you understand the situation, Pale Floater. These Fravashi Trees are Pari that fought till the very end against the defilement that had been corrupting the land. Using the last remnants of their power, they transformed into this state that you see now.","nextNodeIds":[733170215]},{"nodeId":733170215,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":594316986,"text":"They exhausted their strength, to the point where they could no longer maintain their form, and were rejected by the Vourukasha Oasis for being tainted.","nextNodeIds":[733170216]},{"nodeId":733170216,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":2741679354,"text":"Legend has it that in ancient times, the Order of Skeptics would hold a ritual of purification for them, so as to bring them all back to the Vourukasha Oasis.","nextNodeIds":[733170217]},{"nodeId":733170217,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3165347370,"text":"But nowadays, there remains no one in the Order of Skeptics who is able to perform such a ritual. The best they can do is but to keep these Fravashi Trees alive.","nextNodeIds":[733170218]},{"nodeId":733170218,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3644071226,"text":"But this only prolongs their suffering. Judging by their current appearance, they seem to have nothing left but the bitter memories they have to endure alone.","nextNodeIds":[733170219,733170220]},{"nodeId":733170219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3206590730,"text":"Looks like we should help them.","nextNodeIds":[733170221]},{"nodeId":733170221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4105262570,"text":"Oh, Paimon can't just leave them here to suffer and endure alone like this!","nextNodeIds":[733170222]},{"nodeId":733170222,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":2385027282,"text":"That said, such is our fate. Perhaps it is their wish to continue guarding this land in such a manner.","nextNodeIds":[733170223]},{"nodeId":733170223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1561201890,"text":"Well, that's what you think. Perhaps they have different ideas, y'know!","nextNodeIds":[733170224]},{"nodeId":733170224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2208787938,"text":"If Paimon was trapped here, Paimon would definitely want to go back home and be with everyone else...","nextNodeIds":[733170225]},{"nodeId":733170225,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":2101230082,"text":"Pale Floater, how dare you underestimate our will!","nextNodeIds":[733170226]},{"nodeId":733170226,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":258911346,"text":"Hmph, fine. I shall wake her up with my power and let you listen to her dimming voice.","nextNodeIds":[]},{"nodeId":733170220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":45662698,"text":"So there is a way to save them.","nextNodeIds":[733170221]},{"nodeId":733170207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2788216594,"text":"It might lead somewhere.","nextNodeIds":[733170208]}]},{"talkId":7331703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7331703","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7325103","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7331703,"initDialog":733170301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20987],"performCfg":"QuestDialogue/WQ/Sumeru_73317/Q7331703","priority":5,"questId":73317,"showRandomTalkCount":0},"dialogs":[{"nodeId":733170301,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3941942234,"text":"Hmph, is this how they look like now? How pathetic.","nextNodeIds":[733170302]},{"nodeId":733170302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1407779618,"text":"Sorush, what are you talking about?","nextNodeIds":[733170303]},{"nodeId":733170303,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3802249074,"text":"Never mind. I just happened to witness the undignified states of my kind. No matter, we shall keep going.","nextNodeIds":[733170304]},{"nodeId":733170304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3378682482,"text":"You see, that makes Paimon even more curious!","nextNodeIds":[733170305]},{"nodeId":733170305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2573034146,"text":"Let Paimon have a look... Oh wow, that really is one strange tree! The way it's shaped like a circle looks almost like a door, right?","nextNodeIds":[733170306,733170307]},{"nodeId":733170306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3606569858,"text":"If we walk through it...","nextNodeIds":[733170308]},{"nodeId":733170308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3272593122,"text":"Hehe, Paimon definitely would like to go first!","nextNodeIds":[733170309]},{"nodeId":733170309,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":1546437202,"text":"...The Fravashi Trees are no doors. You'll disturb the residual Pari residing within if you simply barge through them.","nextNodeIds":[733170310]},{"nodeId":733170310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1428600594,"text":"So that's called a Fravashi Tree, huh? But where are the residual Pari... Paimon can't see them at all!","nextNodeIds":[733170311]},{"nodeId":733170311,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":271901010,"text":"Of course Pale Floater can't see them. They are still trapped by obsessions of the past, after all.","nextNodeIds":[733170312]},{"nodeId":733170312,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":4116301026,"text":"It may not be what they wished for, but looking at the sight of them clinging desperately to this world... How absurd and pathetic.","nextNodeIds":[733170313]},{"nodeId":733170313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1354637482,"text":"They may look a little strange, but calling them pathetic is just mean!","nextNodeIds":[733170314]},{"nodeId":733170314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1491149666,"text":"And looking at you being surrounded by so many plants, Paimon actually thought you'd feel at home.","nextNodeIds":[733170315]},{"nodeId":733170315,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":4196622650,"text":"Hmph, I only feel at home when I'm on a battlefield. Only the battle lasting until the end of time can be perceived as true eternity!","nextNodeIds":[733170316]},{"nodeId":733170316,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3404006338,"text":"Now that you're following me, you'd better grasp that as early as possible, Pale Floater.","nextNodeIds":[733170317]},{"nodeId":733170317,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3703532442,"text":"These Fravashi Trees are Pari that fought till the very end against the defilement that had been corrupting the land. Using the last remnants of their power, they transformed into this state that you see now.","nextNodeIds":[733170318]},{"nodeId":733170318,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":2384455706,"text":"They exhausted their strength, to the point where they could no longer maintain their form, and were rejected by the Vourukasha Oasis for being tainted.","nextNodeIds":[733170319]},{"nodeId":733170319,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":4270660530,"text":"Legend has it that in ancient times, the Order of Skeptics would hold a ritual of purification for them, so as to bring them all back to the Vourukasha Oasis.","nextNodeIds":[733170320]},{"nodeId":733170320,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3739803914,"text":"But nowadays, there remains no one in the Order of Skeptics who is able to perform such a ritual. The best they can do is but to keep these Fravashi Trees alive.","nextNodeIds":[733170321]},{"nodeId":733170321,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":1075003714,"text":"But this only prolongs their suffering. Judging by their current appearance, they seem to have nothing left but the bitter memories they have to endure alone.","nextNodeIds":[733170322]},{"nodeId":733170322,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3478150066,"text":"In a way, they have also fulfilled their mission. But it was all a meaningless act compared to a true sacrifice.","nextNodeIds":[733170323,733170324]},{"nodeId":733170323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2047378434,"text":"Looks like we should help them.","nextNodeIds":[733170325]},{"nodeId":733170325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":637182066,"text":"Oh, Paimon can't just leave them here to suffer and endure alone like this!","nextNodeIds":[733170326]},{"nodeId":733170326,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":1925702458,"text":"You can't? That makes you weak, Pale Floater. Being compassionate is indeed one of the great Simurgh's many noble qualities, but one cannot survive here with merely a kind heart.","nextNodeIds":[733170327]},{"nodeId":733170327,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":2910417242,"text":"Besides, for us Pari, to exhaust our strength in the final stand against evil is already the best ending one can dream of. I see no necessity to change anything.","nextNodeIds":[733170328]},{"nodeId":733170328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2532928978,"text":"Well, that's what you think. Perhaps they have different ideas, y'know!","nextNodeIds":[733170329]},{"nodeId":733170329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2881751658,"text":"If Paimon was trapped here, Paimon would definitely want to go back home and be with everyone else...","nextNodeIds":[733170330]},{"nodeId":733170330,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":3381267266,"text":"We Pari share no such weaknesses!","nextNodeIds":[733170331]},{"nodeId":733170331,"roleType":"TALK_ROLE_NPC","speakerId":20987,"speakerName":"Sorush","textMapHash":1028055170,"text":"Hmph, fine, since even my Yasnapati fancies so. I shall wake her up with my power and let you listen to her dimming voice.","nextNodeIds":[]},{"nodeId":733170324,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2575450970,"text":"So there is a way to save them.","nextNodeIds":[733170325]},{"nodeId":733170307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":788334802,"text":"It might lead somewhere.","nextNodeIds":[733170308]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7331703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7331702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7330701","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20987"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7331708,"order":4,"stepDescription":"","stepDescTextMapHash":348026748,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":