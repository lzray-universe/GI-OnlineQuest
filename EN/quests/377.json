E_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["QuestBarUI"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[37702],"talks":[{"talkId":37702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37704","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["37705","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37702,"initDialog":3770201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1009],"performCfg":"QuestDialogue/AQ/Mengde2_377/Q37702","priority":1,"questId":377,"showRandomTalkCount":0},"dialogs":[{"nodeId":3770201,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2820382187,"text":"You're here.","nextNodeIds":[3770202]},{"nodeId":3770202,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4152603219,"text":"#Wait, you're... {NICKNAME}?","nextNodeIds":[3770203,3770204]},{"nodeId":3770203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2851439299,"text":"...Jean?","nextNodeIds":[3770205]},{"nodeId":3770205,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2370540403,"text":"Well, first of all, I contacted more than one person.","nextNodeIds":[3770206]},{"nodeId":3770206,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2811273235,"text":"Secondly, she came here as \"Jean\" herself, not as the Acting Grand Master.","nextNodeIds":[3770207]},{"nodeId":3770207,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":4193527427,"text":"A Jean you would never see, even as an Honorary Knight.","nextNodeIds":[3770208]},{"nodeId":3770208,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3980181299,"text":"What a surprise.","nextNodeIds":[3770209]},{"nodeId":3770209,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2513242555,"text":"I heard about the Holy Lyre, but I never suspected it was you.","nextNodeIds":[3770210]},{"nodeId":3770210,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1984650835,"text":"So, the sound of the Holy Lyre can purify Stormterror and return it to normal... Is that true?","nextNodeIds":[3770211]},{"nodeId":3770211,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":346844323,"text":"#That's right! {NICKNAME} is putting themselves on the front line to try and resolve this Stormterror issue.","nextNodeIds":[3770212]},{"nodeId":3770212,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":707678459,"text":"Now that's the hotshot of the Knights of Favonius I'm talking about.","nextNodeIds":[3770213]},{"nodeId":3770213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2371980915,"text":"Feels like we're breaking the law though...","nextNodeIds":[3770214]},{"nodeId":3770214,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":4183490499,"text":"I understand this kind of absurd explanation is hard to believe.","nextNodeIds":[3770215]},{"nodeId":3770215,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1770496155,"text":"But, we can ask the bard to play the song again to try and persuade—","nextNodeIds":[3770216]},{"nodeId":3770216,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":175333099,"text":"I believe you.","nextNodeIds":[3770217]},{"nodeId":3770217,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1848302099,"text":"To persuade our stubborn comman— Wait, what?","nextNodeIds":[3770218]},{"nodeId":3770218,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3422642243,"text":"I can't think of any reason for Dvalin's betrayal, given it was once one of The Four Winds.","nextNodeIds":[3770219]},{"nodeId":3770219,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1953927379,"text":"However, if it was poisoned in the battle over Mondstadt all those years ago...","nextNodeIds":[3770220]},{"nodeId":3770220,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1220537083,"text":"And then corrupted by the Abyss Mage after it woke up — we can't really blame it.","nextNodeIds":[3770221]},{"nodeId":3770221,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1048153043,"text":"But as Acting Grand Master I obviously cannot make such a statement publicly.","nextNodeIds":[3770222]},{"nodeId":3770222,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2424007867,"text":"Diplomatic pressure from the Fatui makes it hard for us to seek a peaceful resolution to the Stormterror issue.","nextNodeIds":[3770223]},{"nodeId":3770223,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":729467243,"text":"People would think I've lost grip on the gravity of the situation. That's why I can only do this in private.","nextNodeIds":[3770224]},{"nodeId":3770224,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":993660739,"text":"Hmph.","nextNodeIds":[3770225]},{"nodeId":3770225,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2338407619,"text":"That's one of the reasons I don't like the Knights of Favonius.","nextNodeIds":[3770226]},{"nodeId":3770226,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3050734179,"text":"What surprises me is that you would believe an outlander so easily...","nextNodeIds":[3770227]},{"nodeId":3770227,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4215012083,"text":"#My cautious and meticulous <color=#00E1FFFF>superior</color>, even you trust {M#him}{F#her}. Don't you, sir?","nextNodeIds":[3770228]},{"nodeId":3770228,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2518075939,"text":"I already told you not to call me sir... Never mind. We don't often get to work together after all.","nextNodeIds":[3770229,3770230]},{"nodeId":3770229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2763780259,"text":"Sir?","nextNodeIds":[3770231]},{"nodeId":3770231,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1389728051,"text":"...","nextNodeIds":[3770232]},{"nodeId":3770232,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2231091139,"text":"...","nextNodeIds":[3770233]},{"nodeId":3770233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2951195675,"text":"Wow! Um... This is really awkward...","nextNodeIds":[3770234]},{"nodeId":3770234,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2819103403,"text":"I have a rough idea of where the Holy Lyre der Himmel is.","nextNodeIds":[3770235]},{"nodeId":3770235,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2894356947,"text":"(Nice recovery! She's really talented at changing the subject...)","nextNodeIds":[3770236]},{"nodeId":3770236,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3592039835,"text":"The conflict between Mondstadt and Snezhnaya stems from the conflict between the seven nations and their respective gods.","nextNodeIds":[3770237]},{"nodeId":3770237,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3458640827,"text":"The Cryo God's Fatui seem to be after the Anemo God's power.","nextNodeIds":[3770238]},{"nodeId":3770238,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":137498235,"text":"...","nextNodeIds":[3770239,3770240]},{"nodeId":3770239,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2108651307,"text":"So are they going to take over the defense of Mondstadt?","nextNodeIds":[3770241]},{"nodeId":3770241,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1718908227,"text":"Right.","nextNodeIds":[3770242]},{"nodeId":3770242,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4201366835,"text":"If the Knights of Favonius publicly prevented an attempt on Dvalin's head, then...","nextNodeIds":[3770243]},{"nodeId":3770243,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":783005299,"text":"The only other way to affect the Anemo God's power is to take the Holy Lyre.","nextNodeIds":[3770244]},{"nodeId":3770244,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3603080371,"text":"The number of Fatui that have come to Mondstadt is far from limited.","nextNodeIds":[3770245]},{"nodeId":3770245,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2733219755,"text":"I've already managed to... coerce a few reports out of them.","nextNodeIds":[3770246]},{"nodeId":3770246,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1383296387,"text":"Diluc has determined that the Holy Lyre is not being held in the Goth Grand Hotel.","nextNodeIds":[3770247]},{"nodeId":3770247,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1461510243,"text":"I imagine they don't want to leave something stolen in a place where it could be so easily found.","nextNodeIds":[3770248]},{"nodeId":3770248,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1582099003,"text":"Paimon gets it. If too much of a scene gets made then it becomes a big diplomatic issue.","nextNodeIds":[3770249]},{"nodeId":3770249,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1367275339,"text":"Hmph, such is the diplomacy between the seven nations.","nextNodeIds":[3770250]},{"nodeId":3770250,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3635059107,"text":"Outlander, ready to go?","nextNodeIds":[]},{"nodeId":3770240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1071109643,"text":"So they want to kill Dvalin?","nextNodeIds":[3770241]},{"nodeId":3770230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1490757339,"text":"(Pretend to not have heard anything)","nextNodeIds":[3770231]},{"nodeId":3770204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1585650891,"text":"Why is the Acting Grand Master here?","nextNodeIds":[3770205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37704,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","P