":[20269],"performCfg":"","priority":5,"questId":22026,"showRandomTalkCount":0},"dialogs":[{"nodeId":220260101,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":2454550538,"text":"Hmm... it should be around here.","nextNodeIds":[220260102]},{"nodeId":220260102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2397533970,"text":"Julie? What brings you here?","nextNodeIds":[220260103]},{"nodeId":220260103,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":3548577562,"text":"Huh? Oh, Traveler, it's you! Hehe, never expected to run into you here...","nextNodeIds":[220260104]},{"nodeId":220260104,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":1939312994,"text":"I'm here to look for ingredients. Xudong is working on new dishes, and Parvaneh is giving him ideas.","nextNodeIds":[220260105]},{"nodeId":220260105,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":82682842,"text":"Xudong told me that he wanted to make a sweet and soft dish for dessert based on Inazuma's Tricolor Dango. But it would take several special ingredients to do so.","nextNodeIds":[220260106]},{"nodeId":220260106,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":4062499474,"text":"Uncle Munehisa went into town to buy some Lavender Melons. I'm here to gather what they call Sakura Blooms.","nextNodeIds":[220260107]},{"nodeId":220260107,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":2315772018,"text":"Although I have gathered some, it's still not enough yet. I wanted to go search ahead, but it's crawling with monsters...","nextNodeIds":[220260108]},{"nodeId":220260108,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":753948706,"text":"Traveler, please. Could you please help me bring three Sakura Blooms back?","nextNodeIds":[220260109,220260111]},{"nodeId":220260109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1646361890,"text":"I've got it.","nextNodeIds":[220260110]},{"nodeId":220260110,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":1132410266,"text":"Thank you! I'll treat you to something great when you get back!","nextNodeIds":[]},{"nodeId":220260111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1089577666,"text":"These monsters shouldn't be a trouble for you, right?","nextNodeIds":[220260112]},{"nodeId":220260112,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":3494690746,"text":"Well, that would generally be the case...","nextNodeIds":[220260113]},{"nodeId":220260113,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":1324775986,"text":"But, hmm, how do I put this? If I really have to fight against those monsters, I'll definitely forget about the ingredient-gathering mission.","nextNodeIds":[220260114]},{"nodeId":220260114,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":684221434,"text":"I've been like this ever since I was in Mondstadt. Whenever I was dealing with monsters, I would forget about everything else.","nextNodeIds":[220260115]},{"nodeId":220260115,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":623528418,"text":"Only after I completely defeated the monsters would I remember that I still had an assignment that required my attention... That's how I failed so many assignments...","nextNodeIds":[220260116]},{"nodeId":220260116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2161107882,"text":"You really hate monsters, don't you...","nextNodeIds":[220260117]},{"nodeId":220260117,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":2484380378,"text":"Hate them? No, not really... Actually, I find fighting them really fun...","nextNodeIds":[220260118]},{"nodeId":220260118,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":1148342258,"text":"Have you ever had that feeling, when you don't need to think about anything but defeating monsters? It's amazing.","nextNodeIds":[220260119]},{"nodeId":220260119,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":164817426,"text":"Well, let's not dwell on that. So, please help me out with the Sakura Bloom-gathering mission, thanks!","nextNodeIds":[220260120]},{"nodeId":220260120,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":4221403810,"text":"I'll treat you to something great when you get back!","nextNodeIds":[]}]},{"talkId":2202602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2202601","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2202601","","","",""],"type":"QUEST_COND_ITEM_GIVING_ACTIVED"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":