NE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1408"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2051101],"talks":[{"talkId":2051101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2051101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2051101,"initDialog":205110101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1408],"performCfg":"","priority":5,"questId":20511,"showRandomTalkCount":0},"dialogs":[{"nodeId":205110101,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":2897586290,"text":"Will this prescription really work...?","nextNodeIds":[205110102]},{"nodeId":205110102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":105236226,"text":"What's the matter?","nextNodeIds":[205110103]},{"nodeId":205110103,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":714828554,"text":"Traveler! You've got great timing. I was just in a spot of bother.","nextNodeIds":[205110104]},{"nodeId":205110104,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":471261666,"text":"Here's the thing. You remember my younger sister, Anna, right? She's always been sickly, and nothing's managed to cure her.","nextNodeIds":[205110105]},{"nodeId":205110105,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":2795527890,"text":"But I heard that there's an incredible doctor in Liyue Harbor who is especially skilled at curing the incurable. So, I asked someone to help me get a prescription from him.","nextNodeIds":[205110106]},{"nodeId":205110106,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1707028410,"text":"The ingredients are all very unusual... but I suppose I can only give it a shot.","nextNodeIds":[205110107]},{"nodeId":205110107,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1570492858,"text":"Um, let me see... Could you help me find a Dendro-Processed Berry?","nextNodeIds":[205110108,205110112,205110116]},{"nodeId":205110108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3478175506,"text":"There's such a thing?","nextNodeIds":[205110109]},{"nodeId":205110109,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":352142066,"text":"I have no clue either! Do Dendro Slimes really eat berries...","nextNodeIds":[205110110]},{"nodeId":205110110,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":513872090,"text":"Either way, I'm counting on you! I do know of a place where both Slimes and berries may be found.","nextNodeIds":[205110111]},{"nodeId":205110111,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":3134097450,"text":"Please help me take a look. I hope you'll find it...","nextNodeIds":[]},{"nodeId":205110112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3444677906,"text":"This doctor's a quack.","nextNodeIds":[205110113]},{"nodeId":205110113,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":337223066,"text":"So you think so too, huh? But I don't have any other options.","nextNodeIds":[205110114]},{"nodeId":205110114,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":874478482,"text":"I know of a place where you can find both Slimes and berries. Could you please go have a look for me?","nextNodeIds":[205110115]},{"nodeId":205110115,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":4190175378,"text":"I'll try the medication that we make first. No matter what, I can't let Anna's condition get any worse.","nextNodeIds":[]},{"nodeId":205110116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":306432202,"text":"I could just catch a Dendro Slime for you.","nextNodeIds":[205110117]},{"nodeId":205110117,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":4004830202,"text":"Huh... What? Are you telling me to stuff the berry into the Dendro Slime's mouth myself?","nextNodeIds":[205110118]},{"nodeId":205110118,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1334045114,"text":"Spare me, please! The last time I went picking herbs for Anna's medication, a group of Dendro Slimes chased me all the way to Springvale!","nextNodeIds":[205110119]},{"nodeId":205110119,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1049823146,"text":"I know of a place where you can find both Slimes and berries. Please go have a look for me, will you? I hope you find something...","nextNodeIds":[205110120]},{"nodeId":205110120,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":4277711106,"text":"But... i—if you really can't find anything, then for Anna's sake... J—Just catch a Dendro Slime and bring it back here. I can do it. I... I will do it!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2051101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1408"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2051102,"order":2,"stepDescription":"Check on the state of the berries","stepDescTextMapHash":2709492044,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1330039061"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q20511_ShuMei"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"Q