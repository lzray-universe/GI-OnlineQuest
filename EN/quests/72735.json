:"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7273501],"talks":[{"talkId":7273501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7273501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7273501,"initDialog":727350101,"nextRandomTalks":[],"nextTalks":[],"npcId":[13090],"performCfg":"QuestDialogue/WQ/Daoqi_72735/Q7273501","priority":5,"questId":72735,"showRandomTalkCount":0},"dialogs":[{"nodeId":727350101,"roleType":"TALK_ROLE_NPC","speakerId":13090,"speakerName":"Grand Rook Sennichi","textMapHash":1518530818,"text":"Hey, which one of you's the ringleader? Step up! It's time to fight.","nextNodeIds":[727350102]},{"nodeId":727350102,"roleType":"TALK_ROLE_NPC","speakerId":13090,"speakerName":"Grand Rook Sennichi","textMapHash":2304478898,"text":"I am Grand Rook Sennichi, a giant among giants. Grandmaster Hanakado has demanded the head of the Arataki Gang's leader... and I am here to collect it!","nextNodeIds":[727350103]},{"nodeId":727350103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3939788578,"text":"Whoa, he looks fierce... And sounds it, too! Seems like we're up against a really strong opponent this time...","nextNodeIds":[727350104]},{"nodeId":727350104,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3442215002,"text":"Where do you get off, huh!? And what's the big idea, putting \"Grand\" in your name? You tryin' to steal my limelight, you little punk?","nextNodeIds":[727350105]},{"nodeId":727350105,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2739732754,"text":"Okay, \"giant among giants,\" time to cut you down to size!","nextNodeIds":[727350106]},{"nodeId":727350106,"roleType":"TALK_ROLE_NPC","speakerId":13090,"speakerName":"Grand Rook Sennichi","textMapHash":1846737514,"text":"S—So tall! And you're... you're an oni!","nextNodeIds":[727350107]},{"nodeId":727350107,"roleType":"TALK_ROLE_NPC","speakerId":13090,"speakerName":"Grand Rook Sennichi","textMapHash":1392443394,"text":"Y—You look like you could eat me for breakfast! ...Why is a guy like you into beetle-fighting? It's just a kids' game... Argh, what have I gotten myself into!","nextNodeIds":[727350108]},{"nodeId":727350108,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":144810562,"text":"Uh, excuse me? \"Kids' game\"? Oh, you did NOT just say that!","nextNodeIds":[727350109]},{"nodeId":727350109,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1507322642,"text":"Seems to me like you don't know the first thing about beetle-fighting. Your misconception begs correctin' by a veteran, my dude!","nextNodeIds":[727350110,727350111]},{"nodeId":727350110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":640982074,"text":"School him!","nextNodeIds":[727350112]},{"nodeId":727350112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2966971250,"text":"Yeah! Go take him down a notch! You can do it, Bull-Chucker!","nextNodeIds":[727350113]},{"nodeId":727350113,"roleType":"TALK_ROLE_NPC","speakerId":13090,"speakerName":"Grand Rook Sennichi","textMapHash":1997360802,"text":"Looks like this is happening... Fine, bring it on!","nextNodeIds":[]},{"nodeId":727350111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":822644546,"text":"This guy's overdue for an attitude adjustment!","nextNodeIds":[727350112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7273501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133209115"],"PAINLIBBLDK":"QUEST_EXEC_REGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13090"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7273501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13090,"speakerName":"Grand Rook Sennichi","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Pa