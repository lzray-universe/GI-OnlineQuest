{"mainQuestId":74146,"title":"","description":"","titleTextMapHash":3100824751,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":74146,"titleTextMapHash":3100824751,"title":"","descTextMapHash":2865741334,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ74146","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2865741334,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74146,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":393105961,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74146","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3100824751,"type":"WQ","unlockDescTextMapHash":3533703566}},"flow":[{"subQuestId":7414601,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7414601,1],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_GLOBAL_VAR_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7414601,7414602,7414603],"talks":[{"talkId":7414601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7414601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7414601,"initDialog":741460101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20995],"performCfg":"","priority":5,"questId":74146,"showRandomTalkCount":0},"dialogs":[{"nodeId":741460101,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":4035759626,"text":"#Knight {NICKNAME}...","nextNodeIds":[741460102,741460107,741460114,741460120]},{"nodeId":741460102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2813687474,"text":"About the current situation...","nextNodeIds":[741460103]},{"nodeId":741460103,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1211874162,"text":"I believe I've recalled certain... some very vague feelings. I am not sure they can even be called memories...","nextNodeIds":[741460104]},{"nodeId":741460104,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":609786226,"text":"Though I don't know whether humans keep their memories in their heads or in their heart...","nextNodeIds":[741460105]},{"nodeId":741460105,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":4099518986,"text":"But Oceanids seem to have neither a brain nor heart, just water...","nextNodeIds":[741460106]},{"nodeId":741460106,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":4097061402,"text":"If only I could be like that silly dog, just sit there and mumble stuff like \"Drive Defragmenting\" to recall everything...","nextNodeIds":[]},{"nodeId":741460107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2417540250,"text":"I want to know more about you, Ann...","nextNodeIds":[741460108]},{"nodeId":741460108,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1678163578,"text":"I don't know what else I can tell you...","nextNodeIds":[741460109]},{"nodeId":741460109,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":3906048458,"text":"I'm the part of Mary-Ann that was imagined into being here, but... but she rejected me, and the others as well... I mean, other existences...","nextNodeIds":[741460110]},{"nodeId":741460110,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1854802666,"text":"The Princess Lyris I want to rescue does not exist. \"Mary-Ann\" is also not Mary-Ann, and isn't that silly dog's owner.","nextNodeIds":[741460111]},{"nodeId":741460111,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":2280115090,"text":"I don't know why, but when I see that silly dog, something just swells inside of me... It feels like bubbles! But they burst whenever I get close to remembering...","nextNodeIds":[741460112]},{"nodeId":741460112,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":3416654914,"text":"Caterpillar seems to know something, but he won't say much if he's not 100% sure.","nextNodeIds":[741460113]},{"nodeId":741460113,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":2879823362,"text":"We came to the place with Narzissenkreuz in its name, yet nothing was resolved...","nextNodeIds":[]},{"nodeId":741460114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2126605034,"text":"I want to know more about Princess Lyris...","nextNodeIds":[741460115]},{"nodeId":741460115,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1104154306,"text":"Princess Lyris is kind and courageous. That's why she endangered herself... in order to protect her friends.","nextNodeIds":[741460116]},{"nodeId":741460116,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1170620418,"text":"Before, all I thought was that I must have been a friend of hers and she protected me, so now that's she's in trouble, I have to save her.","nextNodeIds":[741460117]},{"nodeId":741460117,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":4241733410,"text":"Even though she might not want me to do that... because she is too nice, and would rather suffer than let her friends be in danger.","nextNodeIds":[741460118]},{"nodeId":741460118,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":3898899010,"text":"But if I don't save her, how could I be worthy of being her friend or deserve her protection?","nextNodeIds":[741460119]},{"nodeId":741460119,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":2045889202,"text":"\"Memories\"... They're hazy, like whirlpools in water. Emotions and desires, on the other hand, feel so real, despite me realizing she's just a character in a story now...","nextNodeIds":[]},{"nodeId":741460120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2620443818,"text":"It's all right. Just go to bed.","nextNodeIds":[741460121]},{"nodeId":741460121,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1034550138,"text":"#Okay. Good night, Knight {NICKNAME}.","nextNodeIds":[]}]},{"talkId":7414602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7414601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7414602,"initDialog":741460201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5303],"performCfg":"QuestDialogue/WQ/Fontaine_74146/Q7414602","priority":5,"questId":74146,"showRandomTalkCount":0},"dialogs":[{"nodeId":741460201,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":3041233450,"text":"#...Calculation process halted. What are your instructions, {M#Mr.}{F#Ms.} {NICKNAME}?","nextNodeIds":[741460202,741460209,741460214,741460220]},{"nodeId":741460202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2740741442,"text":"About the current situation...","nextNodeIds":[741460203]},{"nodeId":741460203,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":1604488866,"text":"Through communication with Ann the Oceanid and the former Narzissenkreuz Ordo member Caterpillar, some promising information has been obtained.","nextNodeIds":[741460204]},{"nodeId":741460204,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":258396314,"text":"I am Prototype 4ACV07, designed by Guillotin to accompany and protect my master, Ms. Mary-Ann.","nextNodeIds":[741460205]},{"nodeId":741460205,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":2299388954,"text":"Unfortunately, no additional information on Ms. Mary-Ann is currently available.","nextNodeIds":[741460206]},{"nodeId":741460206,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":326662322,"text":"Moreover, Ann the Oceanid was able to provide very little information.","nextNodeIds":[741460207]},{"nodeId":741460207,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":1566930562,"text":"The remaining member of the Narzissenkreuz Ordo Caterpillar did not provide complete information.","nextNodeIds":[741460208]},{"nodeId":741460208,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":3941779410,"text":"More time is required for analysis...","nextNodeIds":[]},{"nodeId":741460209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":352287162,"text":"I want to know more about you, Seymour...","nextNodeIds":[741460210]},{"nodeId":741460210,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":3232990586,"text":"I am Prototype 4ACV07, designed by Guillotin to accompany and protect my master, Ms. Mary-Ann.","nextNodeIds":[741460211]},{"nodeId":741460211,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":3942323962,"text":"I am equipped with the most advanced memory storage unit, logic unit, optics, and various functional modules from the Fontaine Institute of Natural Philosophy.","nextNodeIds":[741460212]},{"nodeId":741460212,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":2621339442,"text":"This allows me to keep a log of Ms. Mary-Ann's daily life and also act as an agent's assistant.","nextNodeIds":[741460213]},{"nodeId":741460213,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":1230230250,"text":"My present top priority is: To locate Ms. Mary-Ann and ensure her safety.","nextNodeIds":[]},{"nodeId":741460214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2046045122,"text":"I want to know more about Mary-Ann...","nextNodeIds":[741460215]},{"nodeId":741460215,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":3385526298,"text":"The purpose of my design and creation is to serve and protect my owner, Ms. Mary-Ann.","nextNodeIds":[741460216]},{"nodeId":741460216,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":1469318554,"text":"My present top priority is: To locate Ms. Mary-Ann and ensure her safety.","nextNodeIds":[741460217]},{"nodeId":741460217,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":2931798834,"text":"Ann the Oceanid exhibited certain behaviors identical to the past behaviors of Ms. Mary-Ann.","nextNodeIds":[741460218]},{"nodeId":741460218,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":2005452866,"text":"But the factors comprising them... (loud mechanical noises)... (loud mechanical noises)...","nextNodeIds":[741460219]},{"nodeId":741460219,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":651120290,"text":"Note: Regular record space collation can decrease the frequency of such issues effectively.","nextNodeIds":[]},{"nodeId":741460220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2623083882,"text":"Oh, nothing. Bye.","nextNodeIds":[741460221]},{"nodeId":741460221,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"Seymour","textMapHash":1908936874,"text":"#Affirmative. Have a nice day, {M#Mr.}{F#Ms.} {NICKNAME}.","nextNodeIds":[]}]},{"talkId":7414603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7414601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7414603,"initDialog":741460301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21048],"performCfg":"","priority":5,"questId":74146,"showRandomTalkCount":0},"dialogs":[{"nodeId":741460301,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":856847906,"text":"Anything else you want to talk about?","nextNodeIds":[741460302,741460311,741460317,741460324]},{"nodeId":741460302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":138989434,"text":"About the current situation...","nextNodeIds":[741460303]},{"nodeId":741460303,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":2573160370,"text":"It's nice that this place is so lively again after several centuries.","nextNodeIds":[741460304]},{"nodeId":741460304,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":612622906,"text":"...Just joking. I think there's a purpose to all this... I mean, to us gathering like this. It's boring and foolish to treat it as simple, sheer coincidence.","nextNodeIds":[741460305]},{"nodeId":741460305,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":1397993570,"text":"Our encounter has to be an omen of a kind of beginning, akin to a repressed seed struggling before fully germinating.","nextNodeIds":[741460306]},{"nodeId":741460306,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":2358404722,"text":"But on the other hand, before the actual apocalypse arrives, just who would try to find meaning in absurdity and be convinced that those signs herald that inevitable solemn moment?","nextNodeIds":[741460307]},{"nodeId":741460307,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":866151434,"text":"Other than Narzissenkreuz, whom I used to call Master. Regardless, he deserved to be called a Grandmaster.","nextNodeIds":[741460308]},{"nodeId":741460308,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3333407330,"text":"Just like our paths crossed here under the Doomsday Clock, if we follow along the woven path together, maybe we can...","nextNodeIds":[741460309]},{"nodeId":741460309,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":373922106,"text":"...","nextNodeIds":[741460310]},{"nodeId":741460310,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":284343466,"text":"...I should save the rest of that thought for the end of the journey.","nextNodeIds":[]},{"nodeId":741460311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3233678554,"text":"I want to know more about you, Caterpillar...","nextNodeIds":[741460312]},{"nodeId":741460312,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":1014919146,"text":"What else is there to say about myself?","nextNodeIds":[741460313]},{"nodeId":741460313,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3861374434,"text":"I often feel mutually exclusive elements in the nature of my existence. Individually, they are pure, but also alien to each other.","nextNodeIds":[741460314]},{"nodeId":741460314,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3901809514,"text":"Therefore, when they interact, they mix with the other and become impure. Can you understand that?","nextNodeIds":[741460315]},{"nodeId":741460315,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":2793947794,"text":"My own identity is not consistent... Sometimes I am a Bloomguard, other times a dragon. My identity is a lie built out of the stories of others...","nextNodeIds":[741460316]},{"nodeId":741460316,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3889696338,"text":"But I believe a definitive answer exists, a singular correct answer. As the hands on the clock move again, I'm ready to take that step.","nextNodeIds":[]},{"nodeId":741460317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2846815266,"text":"I want to know more about Lanoire...","nextNodeIds":[741460318]},{"nodeId":741460318,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3762330714,"text":"Our time together was very short, but I never thought I'd be so committed to playing the role of a protector for her.","nextNodeIds":[741460319]},{"nodeId":741460319,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":1352326074,"text":"It was indeed a very novel experience. Perhaps I was attracted by her purity, because that's a quality I will never possess.","nextNodeIds":[741460320]},{"nodeId":741460320,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":1154984034,"text":"Yet the Fortress of Meropide is what kept her innocent... Somewhere she shouldn't have been in the first place.","nextNodeIds":[741460321]},{"nodeId":741460321,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":2632738386,"text":"To give her an opportunity to choose, the right to choose must be first stripped from her.","nextNodeIds":[741460322]},{"nodeId":741460322,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3146356154,"text":"But whenever I think of how now, the mundane world has finally entered her heart...","nextNodeIds":[741460323]},{"nodeId":741460323,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":1175949626,"text":"...","nextNodeIds":[]},{"nodeId":741460324,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":322850082,"text":"We'll talk about this later.","nextNodeIds":[741460325]},{"nodeId":741460325,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":558811666,"text":"I'll stay here until it's time for us to set out.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7414601,1],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_GLOBAL_VAR_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7414601,7414602,7414603],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","count":17},{"ro