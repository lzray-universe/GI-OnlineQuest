:25035,"showRandomTalkCount":0},"dialogs":[{"nodeId":250350101,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":135967026,"text":"Those bumbling fools... How've they lost another load of packages? I told them not to mess about when they're out delivering things...","nextNodeIds":[250350102]},{"nodeId":250350102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1825554626,"text":"What happened?","nextNodeIds":[250350103]},{"nodeId":250350103,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":2637647058,"text":"A few of our Couriers ignored instructions yet again, and guess what? They've gone and lost a bunch of packages.","nextNodeIds":[250350104]},{"nodeId":250350104,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":2900332866,"text":"*sigh* Don't they realize that such carelessness damages the reputation of the Scions of the Canopy?","nextNodeIds":[250350105]},{"nodeId":250350105,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":1283138170,"text":"When you're out on the job, focus on delivering things! If you're going down a slope, just keep going as you normally would. Why would you suddenly drop into a slide like you're on vacation!?","nextNodeIds":[250350106]},{"nodeId":250350106,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":3945879482,"text":"I've told them so many times, but those youngsters just won't listen. All they care about is chasing cheap thrills...","nextNodeIds":[250350107]},{"nodeId":250350107,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":786890642,"text":"*sigh* Now I'll have to get someone to retrieve those packages. Let me think, who's free right now...","nextNodeIds":[250350108,250350111]},{"nodeId":250350108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1802608050,"text":"I'll lend a hand.","nextNodeIds":[250350109]},{"nodeId":250350109,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":2869979898,"text":"Y—You'd really help me out? That's great!","nextNodeIds":[250350110]},{"nodeId":250350110,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":2949013298,"text":"It would take me quite a while to find someone who could help, and if I went looking myself, there'd be no one here to watch over the Courier's Longhouse.","nextNodeIds":[250350117]},{"nodeId":250350117,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":3229844010,"text":"And don't worry, I wouldn't just leave you to find a needle in a haystack. I know the routes those kids usually take, so I can probably guess where those packages went missing.","nextNodeIds":[250350118]},{"nodeId":250350118,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":2208505642,"text":"I'll mark out those probable locations. Thanks in advance. I'm counting on you!","nextNodeIds":[]},{"nodeId":250350111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1032563842,"text":"Are those packages big?","nextNodeIds":[250350112]},{"nodeId":250350112,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":1027810210,"text":"No, they're not. But that's what makes them a real hassle to find. *sigh* Those careless little...","nextNodeIds":[250350113]},{"nodeId":250350113,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":3613700658,"text":"...So, if you have the time, would you be willing to help me track them down?","nextNodeIds":[250350114]},{"nodeId":250350114,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":43908058,"text":"The Courier's Longhouse is a bit short on manpower right now, so if I went to find them myself, there'd be no one here to man the store.","nextNodeIds":[250350115]},{"nodeId":250350115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1181819202,"text":"No problem, leave it to me.","nextNodeIds":[250350116]},{"nodeId":250350116,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"Michica","textMapHash":2801255858,"text":"That's amazing! Thank you so much!","nextNodeIds":[250350117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2503502,"order":2,"stepDescription":"Track down the missing packages","stepDescTextMapHash":2699370396,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_350200298:-2213.324,204.361,8575.094,0.000,10.661,0.000]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2503502,2503503,2503506,2503511],"talks":[{"talkId":2503502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,