CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7370401,"order":3,"stepDescription":"Head for the Jadeplume Terrorshroom's Lair","stepDescTextMapHash":916178884,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30549"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7370401],"talks":[{"talkId":7370401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7370401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370401,"initDialog":737040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30549],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_73704/Q7370401","priority":5,"questId":73704,"showRandomTalkCount":0},"dialogs":[{"nodeId":737040101,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3513175234,"text":"Haha, and isn't today another day filled with new hope! Ready to head out, friends?","nextNodeIds":[737040102]},{"nodeId":737040102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2329239482,"text":"New hope, eh... We can take that to mean your Primo Geovishap communications broke down, then?","nextNodeIds":[737040103]},{"nodeId":737040103,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":4239683490,"text":"Come now, how could you call it a failure? Mortal combat is also communication of a kind.","nextNodeIds":[737040104]},{"nodeId":737040104,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":80236706,"text":"From that perspective, you could even say that we had an honest, profound exchange, and gained much knowledge about our respective stances in the process.","nextNodeIds":[737040105]},{"nodeId":737040105,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3151786554,"text":"What do they say again? \"No friends without a fight?\"","nextNodeIds":[737040106,737040108]},{"nodeId":737040106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2810871274,"text":"I knew this would happen...","nextNodeIds":[737040107]},{"nodeId":737040107,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3997687754,"text":"Well, you can't know unless you try!","nextNodeIds":[737040110]},{"nodeId":737040110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4236873874,"text":"Not giving up yet, then?","nextNodeIds":[737040111]},{"nodeId":737040111,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3375852794,"text":"Well, I'll be honest with you — it's always been my dream to ride a Jadeplume Terrorshroom all through Sumeru...","nextNodeIds":[737040112]},{"nodeId":737040112,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":1381134146,"text":"But the adults would all tell me to not be silly. When I'd ask the Forest Watchers, they'd make troubled faces, tell me not to snoop in risky places.","nextNodeIds":[737040113]},{"nodeId":737040113,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3045286578,"text":"So I gave up on those unrealistic dreams and grew up normal like the other kids. My only adventures were with my choices for ingredients when cooking...","nextNodeIds":[737040114]},{"nodeId":737040114,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3566351306,"text":"But I'd get to thinking sometimes, and then I'd remember that I did once have such distant, strange dreams, just like the Aranara of legend.","nextNodeIds":[737040115]},{"nodeId":737040115,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":2958478706,"text":"But they truly exist, and I once saw them. When did I stop being able to do so? When did I start forgetting them?","nextNodeIds":[737040116]},{"nodeId":737040116,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":4124267010,"text":"I heard this tale about an unlucky fellow named Kuntur while in Natlan. He became the target of the sun's hatred due to a mistake his father made.","nextNodeIds":[737040117]},{"nodeId":737040117,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3023103074,"text":"\"Kuntur, Unloved of the Sun\" was also ostracized in his tribe, and of course, no Saurian would buddy up with him.","nextNodeIds":[737040118]},{"nodeId":737040118,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3058612026,"text":"But he didn't give up, nor did he blame his father, or fate! Instead, he proved that he was the equal of any valiant warrior in the tribe through hard work and grit!","nextNodeIds":[737040119]},{"nodeId":737040119,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":1752983554,"text":"In the end, he accomplished something great, not only earning the recognition of an Iktomisaurus comrade, but also becoming a hero to his tribe.","nextNodeIds":[737040120]},{"nodeId":737040120,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":1563954922,"text":"When I heard that tale, I, too, gained the courage to pick my childhood dream off the ground where I'd left it.","nextNodeIds":[737040121]},{"nodeId":737040121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1796130738,"text":"Huh, so that's the story...","nextNodeIds":[737040122]},{"nodeId":737040122,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":562217826,"text":"So yes, please do help me with the upcoming Jadeplume Terrorshroom \"negotiations\"!","nextNodeIds":[737040123]},{"nodeId":737040123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":969487442,"text":"...And there you go, dumping it all on us again!","nextNodeIds":[737040124]},{"nodeId":737040124,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":1542260434,"text":"I mean, I'm no match for it as I am now... but I will help support you, so call me whenever you need me!","nextNodeIds":[737040125]},{"nodeId":737040125,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":3929381218,"text":"No need for too much talk. Shall we?","nextNodeIds":[737040126,737040127]},{"nodeId":737040126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3658938202,"text":"Let's go, then.","nextNodeIds":[]},{"nodeId":737040127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":140000890,"text":"I've got other things to handle. See you in a bit.","nextNodeIds":[737040128]},{"nodeId":737040128,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":1355412178,"text":"No worries. I'll wait for you here.","nextNodeIds":[]},{"nodeId":737040108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2465460890,"text":"Well, I was doing the actual fighting...","nextNodeIds":[737040109]},{"nodeId":737040109,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"Ranjit","textMapHash":368542946,"text":"And what fighting it was! Even I could tell that you're an experienced adventurer even amongst adventurers!","nextNodeIds":[737040110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"K