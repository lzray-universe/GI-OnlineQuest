LK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["800801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":800801,"initDialog":80080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[12423],"performCfg":"QuestDialogue/AQ/Twins2_8008/Q800801","priority":5,"questId":8008,"showRandomTalkCount":0},"dialogs":[{"nodeId":80080101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":749205994,"text":"Mr. Miner, we're back and ready to report!","nextNodeIds":[80080102]},{"nodeId":80080102,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":2940108754,"text":"Ah! Am I glad to see you again! I was getting nervous... At first, I figured I'm paying a fair price, and these are professionals. But then I thought... Goodness, I'd hate to send someone off on a strange commission and then for something bad to happen to them...","nextNodeIds":[80080103]},{"nodeId":80080103,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":3021337146,"text":"I'd never be able to forgive myself if you came to any harm!","nextNodeIds":[80080104]},{"nodeId":80080104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":78485682,"text":"Don't you worry, mister, it was nothing we couldn't handle! Anyway, we're back, aren't we? And the good news is, we got to the bottom of what's been going on!","nextNodeIds":[80080105]},{"nodeId":80080105,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":1305717962,"text":"Excellent, excellent! So then, what's the situation down there?","nextNodeIds":[80080106]},{"nodeId":80080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":820591074,"text":"Uh... Heh, well... Ummm...","nextNodeIds":[80080107,80080109]},{"nodeId":80080107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3441764914,"text":"It's like a hilichurl hospice.","nextNodeIds":[80080108]},{"nodeId":80080108,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":2655706298,"text":"Huh? ...Hospice?","nextNodeIds":[80080111]},{"nodeId":80080111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2116149298,"text":"...Uh, basically, the hilichurls down there don't wanna fight anymore. Leave them in peace, and they won't cause you any trouble.","nextNodeIds":[80080112,80080113]},{"nodeId":80080112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2929316378,"text":"What Paimon said.","nextNodeIds":[80080114]},{"nodeId":80080114,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":3133543186,"text":"Well, we certainly wouldn't be going out of our way to provoke them, you can count on that. The last thing any of us miners are looking for is to stir up trouble... All we're looking for is, well, all that glitters.","nextNodeIds":[80080115]},{"nodeId":80080115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3027373450,"text":"Now there's a philosophy that Paimon can get behind.","nextNodeIds":[80080116]},{"nodeId":80080116,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":2253354218,"text":"...I gotta be honest, I didn't really understand the situation you were describing, but having your assurance that everything's okay is the main thing. It means we can get back to work straight away.","nextNodeIds":[80080117]},{"nodeId":80080117,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":4034155170,"text":"I'm very grateful to you both! You came a long way for this. Please take these as compensation.","nextNodeIds":[]},{"nodeId":80080113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2875450378,"text":"You have nothing to worry about.","nextNodeIds":[80080114]},{"nodeId":80080109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":424356258,"text":"Hilichurl utopia. Hili-topia, if you will.","nextNodeIds":[80080110]},{"nodeId":80080110,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"Yuehui","textMapHash":2902708578,"text":"Sorry, hili-topia...?","nextNodeIds":[80080111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[800801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[8