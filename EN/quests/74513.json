{"mainQuestId":74513,"title":"Finches Are Still the Cutest!","description":"Somewhere in Fontaine's Romaritime Harbor, you and Paimon run into a cheerful researcher-merchant who invites you to play a game...","titleTextMapHash":1273275327,"descTextMapHash":2504089558,"mainQuestExcel":{"mainQuestId":74513,"titleTextMapHash":1273275327,"title":"Finches Are Still the Cutest!","descTextMapHash":2504089558,"description":"Somewhere in Fontaine's Romaritime Harbor, you and Paimon run into a cheerful researcher-merchant who invites you to play a game...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5200,"luaPath":"Actor/Quest/WQ74513","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5200,"chapterId":0,"descTextMapHash":2504089558,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74513,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3334150537,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74513","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174513],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1273275327,"type":"WQ","unlockDescTextMapHash":91299430}},"flow":[{"subQuestId":7451301,"order":1,"stepDescription":"Talk to Basima the Fifth","stepDescTextMapHash":2977091092,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30566"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7451301],"talks":[{"talkId":7451301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7451301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451301,"initDialog":745130101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30566],"performCfg":"QuestDialogue/WQ/BirdBall_74513/Q7451301","priority":5,"questId":74513,"showRandomTalkCount":0},"dialogs":[{"nodeId":745130101,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":1007741810,"text":"Passing Travelers, I, Basima the Fifth, Amurta researcher, rising mercantile star of the Grand Bazaar and Romaritime Harbor alike, beseech thee not to leave too hastily...","nextNodeIds":[745130102]},{"nodeId":745130102,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":2059116690,"text":"Please. Relax thy body, clear thy mind, and listen closely, for I have a matter of utmost importance to share with you—","nextNodeIds":[745130103]},{"nodeId":745130103,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":3637421122,"text":"Finches are the cutest!","nextNodeIds":[745130104]},{"nodeId":745130104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1948431170,"text":"?","nextNodeIds":[745130105]},{"nodeId":745130105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4242434098,"text":"?","nextNodeIds":[745130106]},{"nodeId":745130106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2197480442,"text":"Well, sure they are... But Miss Basima, you say you're a researcher... and a merchant, right? You should know saying something like that without any qualifications can lead to serious arguments!","nextNodeIds":[745130107]},{"nodeId":745130107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1888102474,"text":"Researchers are super cautious with their words, and merchants generally don't exaggerate too much, either... At least, that was Paimon's impression...","nextNodeIds":[745130108]},{"nodeId":745130108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":259681962,"text":"If you go around saying, \"My theory is the best\" or \"My product is the greatest,\" isn't that just asking for anyone who doesn't buy it to do their best to discredit you?","nextNodeIds":[745130109]},{"nodeId":745130109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2100966930,"text":"Hang on, Paimon's getting a sense of déjà vu. It feels like we've had this conversation before...","nextNodeIds":[745130110,745130111,745130112]},{"nodeId":745130110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":521787058,"text":"Well, then I've got something to add to that!","nextNodeIds":[745130113]},{"nodeId":745130113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":950546762,"text":"#Wha— {NICKNAME}, that was really unexpected!","nextNodeIds":[745130114]},{"nodeId":745130114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2598004882,"text":"Even if it's not a joke, you shouldn't be so loud...","nextNodeIds":[745130115]},{"nodeId":745130115,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":4080330034,"text":"Hahaha! Now that's the spirit!","nextNodeIds":[745130116]},{"nodeId":745130116,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":1815619042,"text":"Of course I know that! There are no absolute \"bests\" in this world. Any academic theory can be overturned, and all products can be surpassed by new ones.","nextNodeIds":[745130117]},{"nodeId":745130117,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":3171868946,"text":"But no matter how the objective world changes, everyone has... people and things that they prize most highly — that they will hold most dear no matter what others say.","nextNodeIds":[745130118]},{"nodeId":745130118,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":1283552282,"text":"Those who are afraid of disapproval and who lose confidence in themselves will never become their best selves, and they'll never find someone who truly sees them!","nextNodeIds":[745130119]},{"nodeId":745130119,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":177038250,"text":"Once you've tried my tabletop game \"Bing-Bang Finchball\", I'm sure you wouldn't hesitate to shout out \"Finches are the cutest!\"","nextNodeIds":[745130120]},{"nodeId":745130120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2599885010,"text":"Bing-bang... Finchball? You mean those things on the table beside you? Seems kinda familiar, somehow...","nextNodeIds":[745130121]},{"nodeId":745130121,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":1081949234,"text":"That's right, once you've played, you'll see for yourself just how adorable finches are!","nextNodeIds":[745130122]},{"nodeId":745130122,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":1351460394,"text":"I'm currently promoting this tabletop game. Those who get high enough scores can even win rewards!","nextNodeIds":[745130123]},{"nodeId":745130123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2635977010,"text":"Hehe, y'know what, Paimon finds Finches adorable too, so rewards aren't her top priority. The game just needs to be fun!","nextNodeIds":[745130124]},{"nodeId":745130124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2693264138,"text":"#What do you think, {NICKNAME}?","nextNodeIds":[745130125,745130126]},{"nodeId":745130125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1315796306,"text":"I'd like to give it a go, too!","nextNodeIds":[745130127]},{"nodeId":745130127,"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","textMapHash":3623973234,"text":"It seems we're on the same page — in which case, I hope you enjoy your experience to the fullest!","nextNodeIds":[]},{"nodeId":745130126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":109841698,"text":"Let's see just how cute finches really are!","nextNodeIds":[745130127]},{"nodeId":745130111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1843676666,"text":"Paimon's the cutest!","nextNodeIds":[745130113]},{"nodeId":745130112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3110757138,"text":"Period!","nextNodeIds":[745130113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30566"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7451301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30566,"speakerName":"Basima the Fifth","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174513],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2504089558,"CHECNJEMEFE":{"30566":[1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"