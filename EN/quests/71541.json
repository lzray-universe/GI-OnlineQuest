{"mainQuestId":71541,"title":"Drills by Lamplight","description":"A Millelith soldier seems to be troubled by something...","titleTextMapHash":4120893479,"descTextMapHash":2446907302,"mainQuestExcel":{"mainQuestId":71541,"titleTextMapHash":4120893479,"title":"Drills by Lamplight","descTextMapHash":2446907302,"description":"A Millelith soldier seems to be troubled by something...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2036,"luaPath":"Actor/Quest/WQ71541","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2036,"chapterId":0,"descTextMapHash":2446907302,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71541,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1812390177,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71541","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171541],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4120893479,"type":"WQ","unlockDescTextMapHash":1188263358}},"flow":[{"subQuestId":7154101,"order":1,"stepDescription":"Talk to Minglan","stepDescTextMapHash":281714364,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7154101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30708"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7154101],"talks":[{"talkId":7154101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7154101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7154101,"initDialog":715410101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30708],"performCfg":"","priority":5,"questId":71541,"showRandomTalkCount":0},"dialogs":[{"nodeId":715410101,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":386412250,"text":"Surely that Sergeant isn't the one in charge... Well, good luck to them, then, they're gonna need it...","nextNodeIds":[715410102]},{"nodeId":715410102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":512233474,"text":"Is something the matter?","nextNodeIds":[715410103]},{"nodeId":715410103,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":1126788058,"text":"#Huh!? Oh, it's you, {NICKNAME}... Phew...","nextNodeIds":[715410104]},{"nodeId":715410104,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":1259216362,"text":"You scared me there! I thought the Sergeant had come over. If he overheard me, I'd get dragged away for more training...","nextNodeIds":[715410105,715410106]},{"nodeId":715410105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1887749858,"text":"Do you guys... still have to train?","nextNodeIds":[715410107]},{"nodeId":715410107,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":2750909106,"text":"Well, the bigger the festival, the busier we are.","nextNodeIds":[715410108]},{"nodeId":715410108,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":2133623554,"text":"Liyue Harbor is huge, and there are so many tourists coming in from all over the world.","nextNodeIds":[715410109]},{"nodeId":715410109,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":2347929042,"text":"To maintain order and ensure everyone's safety, the Millelith have set up quite a few new mobile units both in the city and in the wilderness.","nextNodeIds":[715410110]},{"nodeId":715410110,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":2923153498,"text":"Do you know what a mobile unit is? Hmm... just think of it as a team of Millelith soldiers who provide help wherever they go.","nextNodeIds":[715410111]},{"nodeId":715410111,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":797075978,"text":"As long as you need help, just run up to a squad and ask for assistance, and they'll lend a hand.","nextNodeIds":[715410112]},{"nodeId":715410112,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":3633287138,"text":"Whether if you're in danger, lost something, or even got lost yourself, just go ask them for help.","nextNodeIds":[715410113]},{"nodeId":715410113,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":1812077314,"text":"But... since we need to cover such a large area, our Sergeant has even pulled out the reserve units that were originally on standby for training.","nextNodeIds":[715410114]},{"nodeId":715410114,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":4141136114,"text":"But those reserve units are all made up of rookies who haven't had much training. So the Sergeant said, why not hold a temporary training event to up their individual skill level?","nextNodeIds":[715410115]},{"nodeId":715410115,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":3976488234,"text":"I heard that... that particular Sergeant is really tough. Anyone who's been trained by him can't help but shiver when hearing his name...","nextNodeIds":[715410116]},{"nodeId":715410116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2333744194,"text":"You've... undergone his training too?","nextNodeIds":[715410117]},{"nodeId":715410117,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":1150417066,"text":"I—I suppose you could say that. His training is actually really effective, but my legs turn into jelly at the mere thought of it...","nextNodeIds":[715410118]},{"nodeId":715410118,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":3406151346,"text":"Want to give it a try? During my training, I heard him mention your name a lot. He said you're not only a master of tactical deployment, but also excel at hand-to-hand combat...","nextNodeIds":[715410119]},{"nodeId":715410119,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":1728442434,"text":"Were it you in the training arena, you'd definitely out-perform all of us.","nextNodeIds":[715410120,715410122]},{"nodeId":715410120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":154019698,"text":"I'd love to give it a try!","nextNodeIds":[715410121]},{"nodeId":715410121,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":3616280554,"text":"Alright. The courage you display... You're indeed the hero of Liyue. Then please, follow me.","nextNodeIds":[]},{"nodeId":715410122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3099716810,"text":"Let me think it over a bit...","nextNodeIds":[715410123]},{"nodeId":715410123,"roleType":"TALK_ROLE_NPC","speakerId":30708,"speakerName":"Minglan","textMapHash":3229999618,"text":"That's alright. Just let me know when you want to give it a whirl. I'm sure the Sergeant would be more than happy to have you.","nextNodeIds":[]},{"nodeId":715410106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4176146410,"text":"Isn't it Lantern Rite now?","nextNodeIds":[715410107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7154101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUID