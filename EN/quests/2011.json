:"TALK_HERO_MAIN","id":201101,"initDialog":20110101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2078],"performCfg":"QuestDialogue/AQ/Inazuma1_2011/Q201101","priority":5,"questId":2011,"showRandomTalkCount":0},"dialogs":[{"nodeId":20110101,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2316965658,"text":"Ad astra abyssosque! What can I do for you, Traveler?","nextNodeIds":[20110102,20110103]},{"nodeId":20110102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3585860362,"text":"About traveling to Inazuma...","nextNodeIds":[20110104]},{"nodeId":20110104,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3762596250,"text":"Ah yes, I've heard that you've already made arrangements with the captain of the Crux Fleet regarding your passage to Inazuma. Is that correct?","nextNodeIds":[20110105]},{"nodeId":20110105,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3542056194,"text":"Now that I think about it, it's been quite some time since I last visited those lands. Unfortunately, I don't have any current intel that would be worth sharing with you.","nextNodeIds":[20110106]},{"nodeId":20110106,"roleType":"TALK_ROLE_NPC","speakerId":2440,"speakerName":"Sea Drake","textMapHash":756017234,"text":"There you are! You're the Traveler that Beidou will be taking to Inazuma, right?","nextNodeIds":[20110107,20110109]},{"nodeId":20110107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4038069626,"text":"I've been waiting all day for you!","nextNodeIds":[20110108]},{"nodeId":20110108,"roleType":"TALK_ROLE_NPC","speakerId":2440,"speakerName":"Sea Drake","textMapHash":1516965098,"text":"Oh, is that right? Hehe... Well, it's an honor to meet you.","nextNodeIds":[20110110]},{"nodeId":20110110,"roleType":"TALK_ROLE_NPC","speakerId":2440,"speakerName":"Sea Drake","textMapHash":3620567034,"text":"The fleet has nearly completed reprovisioning. Once the crews have taken a headcount, we can get underway.","nextNodeIds":[20110111]},{"nodeId":20110111,"roleType":"TALK_ROLE_NPC","speakerId":2440,"speakerName":"Sea Drake","textMapHash":4147150162,"text":"Captain Beidou sent me to come get you. We'll weigh anchor as soon as you're aboard.","nextNodeIds":[20110112]},{"nodeId":20110112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3195617578,"text":"Seems Beidou is a captain of her word.","nextNodeIds":[20110113]},{"nodeId":20110113,"roleType":"TALK_ROLE_NPC","speakerId":2440,"speakerName":"Sea Drake","textMapHash":2310575666,"text":"Of course! There are many things that the Captain insists upon. I'm sure you'll see for yourself once you're on board.","nextNodeIds":[20110114]},{"nodeId":20110114,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3321790314,"text":"So you'll be heading off then? I suppose congratulations are in order.","nextNodeIds":[20110115]},{"nodeId":20110115,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":301341754,"text":"Whether the journey before you leads to the heights of the heavens or the depths of the abyss, each step you take is another achievement.","nextNodeIds":[20110116]},{"nodeId":20110116,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2519812274,"text":"Until we meet again, ad astra abyssosque!","nextNodeIds":[20110117,20110118]},{"nodeId":20110117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3987116346,"text":"Ad astra abyssosque, Katheryne...","nextNodeIds":[20110119]},{"nodeId":20110119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4155787690,"text":"Oh... It's kinda hard to say goodbye now... we practically see each other every day.","nextNodeIds":[20110120]},{"nodeId":20110120,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2152743226,"text":"Hehe, well if that's how you feel, why not come and find me when you arrive? I'll be awaiting you on Narukami Island.","nextNodeIds":[20110121,20110122]},{"nodeId":20110121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":630160090,"text":"...","nextNodeIds":[20110123]},{"nodeId":20110123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1506213594,"text":"So there's another Katheryne in Inazuma!? See, there's no need to get all sappy now...","nextNodeIds":[20110124]},{"nodeId":20110124,"roleType":"TALK_ROLE_NPC","speakerId":2440,"speakerName":"Sea Drake","textMapHash":3584011986,"text":"Haha, well I guess it's time for you to bid farewell to Liyue Harbor. Now that I've delivered my message, I'll be heading back. The ship is currently anchored off of Guyun Stone Forest.","nextNodeIds":[20110125]},{"nodeId":20110125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2550642658,"text":"Okay, thanks for coming all this way to let us know!","nextNodeIds":[20110126]},{"nodeId":20110126,"roleType":"TALK_ROLE_NPC","speakerId":2440,"speakerName":"Sea Drake","textMapHash":2934009498,"text":"Just following orders. I'll see you two aboard the Alcor.","nextNodeIds":[]},{"nodeId":20110122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1025697050,"text":"...I knew it!","nextNodeIds":[20110123]},{"nodeId":20110118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3650460450,"text":"We'll miss you...","nextNodeIds":[20110119]},{"nodeId":20110109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2356809690,"text":"It seems our intel has arrived.","nextNodeIds":[20110110]},{"nodeId":20110103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1862148378,"text":"About the Crux Fleet...","nextNodeIds":[20110104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[201101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2078"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":201102,"order":2,"stepDescription":"Board the Alcor and find Beidou","stepDescTextMapHash":4205351284,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[201102,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1031"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[201102,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1031"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":201103,"order":3,"