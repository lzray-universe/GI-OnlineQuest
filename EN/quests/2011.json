e,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["201107","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":201107,"initDialog":20110701,"nextRandomTalks":[],"nextTalks":[],"npcId":[1033],"performCfg":"QuestDialogue/AQ/Inazuma1_2011/Q201107","priority":5,"questId":2011,"showRandomTalkCount":0},"dialogs":[{"nodeId":20110701,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":951950090,"text":"So, you finally made it. You sure kept me waiting, Captain.","nextNodeIds":[20110702]},{"nodeId":20110702,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":2890577450,"text":"And it appears we have a couple of stowaways... or perhaps I should say — honored guests.","nextNodeIds":[20110703]},{"nodeId":20110703,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1647931698,"text":"Hey! Shush!","nextNodeIds":[20110704]},{"nodeId":20110704,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":1591997170,"text":"You can blame your Almighty Shogun. The tempests around Inazuma have been growing all the more fierce lately.","nextNodeIds":[20110705]},{"nodeId":20110705,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":2541963594,"text":"Though the fleet was fully up to the challenge, the inclement weather still caused some delay.","nextNodeIds":[20110706]},{"nodeId":20110706,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":119140794,"text":"Now then, let me introduce everyone. This is Thoma, a trade partner that I've gotten to know recently.","nextNodeIds":[20110707]},{"nodeId":20110707,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":331225570,"text":"Heh, you don't know how long I've been waiting to see you.","nextNodeIds":[20110708]},{"nodeId":20110708,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":3070421594,"text":"Thoma, these two are—","nextNodeIds":[20110709]},{"nodeId":20110709,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":3465099226,"text":"No need for introductions, their reputation precedes them. Seems even the stormy seas can't keep rumors of these outlanders' sterling deeds at bay.","nextNodeIds":[20110710,20110711]},{"nodeId":20110710,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3599913786,"text":"Nice to meet you, Thoma.","nextNodeIds":[20110712]},{"nodeId":20110712,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1259483010,"text":"Hehe, it's sure nice to hear you say that~","nextNodeIds":[20110713]},{"nodeId":20110713,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":668034754,"text":"Ha, with any luck, it'll give you a head start here.","nextNodeIds":[20110714]},{"nodeId":20110714,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":851745626,"text":"#{NICKNAME}, Thoma's resided on Ritou for quite some time now. It wouldn't be going too far to say he's the fixer around these parts.","nextNodeIds":[20110715]},{"nodeId":20110715,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":840114858,"text":"If you run into any problems here, just talk to Thoma. But if he tries to pull any moves on you, I'll be sure to deal with him personally the next time I'm around.","nextNodeIds":[20110716]},{"nodeId":20110716,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":3025372642,"text":"Hehehe, no need to worry. I'm sure we'll get along just fine.","nextNodeIds":[20110717]},{"nodeId":20110717,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":3433515242,"text":"Good. Then if it's all settled, I'll be going. I wouldn't want to be caught with my sails down here, I do have a wanted fugitive on board, after all.","nextNodeIds":[20110718]},{"nodeId":20110718,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":208428050,"text":"Oh, right. Kazuha...","nextNodeIds":[20110719]},{"nodeId":20110719,"roleType":"TALK_ROLE_NPC","speakerId":1031,"speakerName":"Beidou","textMapHash":3228006842,"text":"Until next time, Traveler. Remember to give it your all, no matter what perilous \"storms\" you may encounter.","nextNodeIds":[20110720,20110721]},{"nodeId":20110720,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4289772338,"text":"We got this.","nextNodeIds":[20110722]},{"nodeId":20110722,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1859770442,"text":"Fair seas, Captain Beidou! Bye-bye!","nextNodeIds":[20110723]},{"nodeId":20110723,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":3262890562,"text":"Now then, first things first, we need to go get you registered at the border checkpoint.","nextNodeIds":[20110724]},{"nodeId":20110724,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4193513346,"text":"Um, Paimon thought we were supposed to be keeping things on the down low... Are we just gonna walk into the government's hands?","nextNodeIds":[20110725]},{"nodeId":20110725,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":3841704234,"text":"Haha, don't underestimate the reaches of the Sakoku Decree. You wouldn't be able to avoid inspection even if you tried.","nextNodeIds":[20110726]},{"nodeId":20110726,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":3220278098,"text":"So we have to play by the rules... even if we're kind of bending them.","nextNodeIds":[20110727,20110728]},{"nodeId":20110727,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":305557234,"text":"Oh... Okay then...","nextNodeIds":[]},{"nodeId":20110728,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2632372042,"text":"Now I'm feeling a bit nervous.","nextNodeIds":[]},{"nodeId":20110721,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1415752002,"text":"Look forward to seeing you again!","nextNodeIds":[20110722]},{"nodeId":20110711,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":118682186,"text":"Surely the rumors exaggerate.","nextNodeIds":[20110712]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[201107,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1033"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unma