{"mainQuestId":73048,"title":"","description":"","titleTextMapHash":3408854103,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":73048,"titleTextMapHash":3408854103,"title":"","descTextMapHash":2313011054,"description":"","chapterId":10076,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ73048","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":10076,"descTextMapHash":2313011054,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73048,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1162860633,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73048","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":73032,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[73032],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3408854103,"type":"WQ","unlockDescTextMapHash":767689854}},"flow":[{"subQuestId":7304801,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7304801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7304801],"talks":[{"talkId":7304801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7304801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7304801,"initDialog":730480101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20711,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73048/Q7304801","priority":5,"questId":73048,"showRandomTalkCount":0},"dialogs":[{"nodeId":730480101,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":3913011754,"text":"How nostalgic. It's been hundreds of years since I last saw such a sight... It's thanks to you that I could see Vanarana's dreamscape again.","nextNodeIds":[730480102]},{"nodeId":730480102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1514354002,"text":"Wow! So you're actually that old...?","nextNodeIds":[730480103,730480104]},{"nodeId":730480103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":335842642,"text":"This is the first time I've heard Aranara use the word \"years\"...","nextNodeIds":[730480105]},{"nodeId":730480105,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":3729580002,"text":"Is that so? Maybe it's because I've absorbed more memories and knowledge. In Vanarana's dreamscape, there is no day and night. Everything is tranquil and peaceful.","nextNodeIds":[730480106]},{"nodeId":730480106,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":744127386,"text":"We have long lifespans too, so we have very little concept of time. We measure the passage of time by the growth of trees, the blooming of flowers, the rising of the moon, and so on.","nextNodeIds":[730480107]},{"nodeId":730480107,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":2166896386,"text":"If we are going to have Festival Utsava, we should bear the Bija soon, right?","nextNodeIds":[730480108]},{"nodeId":730480108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3729868194,"text":"Yes... Speaking of which, what is a Bija? Araja and Arama didn't explain much about it before.","nextNodeIds":[730480109]},{"nodeId":730480109,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":2026273322,"text":"You have become friends with Aranara, so you should have heard about the principle of the Ararakalari. Do you know of it?","nextNodeIds":[730480110]},{"nodeId":730480110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":920756170,"text":"Arana mentioned the power of memory...","nextNodeIds":[730480111]},{"nodeId":730480111,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":1555131522,"text":"Arana, huh? How nostalgic. I hope Arana's alright. A little hotheaded, yes, but I doubt you would have been told about this if that one hadn't considered you a friend.","nextNodeIds":[730480112]},{"nodeId":730480112,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":1261269058,"text":"Bija is a fruit made from extracted dreams and memories — the crystallization of all that is precious to us Aranara. It is a fruit, but it is also a seed of hope.","nextNodeIds":[730480113]},{"nodeId":730480113,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":3227826698,"text":"Bija can help to realize dreams, so long as these dreams are meant to help others. I'm sure that you and the Aranara preparing this Bija do have such wishes, yes?","nextNodeIds":[730480114,730480115]},{"nodeId":730480114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2097839330,"text":"We want to save Rana.","nextNodeIds":[730480116]},{"nodeId":730480116,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":1019634674,"text":"#Yes, then there is no problem. Since Nara {NICKNAME} is a friend to Aranara, please take this.","nextNodeIds":[730480117,730480118]},{"nodeId":730480117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4237346314,"text":"This is...","nextNodeIds":[730480119]},{"nodeId":730480119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":188674946,"text":"A flower... Arana, Aranakin, and the others also gave us flowers...","nextNodeIds":[730480120]},{"nodeId":730480120,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":2821447930,"text":"I see. It seems that this custom has not changed after all these years. I'm glad.","nextNodeIds":[730480121]},{"nodeId":730480121,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":4148218394,"text":"#In the past, Araja, Araji, Arapacati, and I... We all gave flowers to Nara Varuna too. {M#She}{F#He} is a friend we cherish beyond measure.","nextNodeIds":[730480122]},{"nodeId":730480122,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":3424702314,"text":"This type of flower is a symbol of Aranara friendship. Those who take this flower accept Aranara friendship.","nextNodeIds":[730480123]},{"nodeId":730480123,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":2252386898,"text":"We Aranara are not good with words. So it is a point of pride for them that their human friends are willing to accept their flowers.","nextNodeIds":[730480124]},{"nodeId":730480124,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":283783754,"text":"#And having heard many stories of Nara {NICKNAME}, I believe that to me, you are also a cherished friend. It would thus be a great honor for me if you would accept my flower. Thank you.","nextNodeIds":[730480125,730480126]},{"nodeId":730480125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1523939554,"text":"You're too kind.","nextNodeIds":[730480127]},{"nodeId":730480127,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","textMapHash":559864170,"text":"#We will surely meet again. The next time we meet, Nara {NICKNAME}, Paimon, I hope you will come to my house.","nextNodeIds":[730480128]},{"nodeId":730480128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2054808690,"text":"Ah, he disappeared...","nextNodeIds":[730480129]},{"nodeId":730480129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3694610338,"text":"What a strange Aranara! Come on, let's go check on the others!","nextNodeIds":[]},{"nodeId":730480126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1102223802,"text":"Thank you.","nextNodeIds":[730480127]},{"nodeId":730480118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":276557618,"text":"Thank you.","nextNodeIds":[730480119]},{"nodeId":730480115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4060831594,"text":"Arana hopes to save a friend.","nextNodeIds":[730480116]},{"nodeId":730480104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2876224378,"text":"Your concept of time is different from other Aranara...","nextNodeIds":[730480105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7304801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7304801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"Aramuhukunda","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TA