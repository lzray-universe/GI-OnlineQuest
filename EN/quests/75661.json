{"mainQuestId":75661,"title":"","description":"","titleTextMapHash":1934166527,"descTextMapHash":1783673078,"mainQuestExcel":{"mainQuestId":75661,"titleTextMapHash":1934166527,"title":"","descTextMapHash":1783673078,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5240,"luaPath":"Actor/Quest/WQ75661","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5240,"chapterId":0,"descTextMapHash":1783673078,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75661,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":561982657,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75661","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":75659,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1934166527,"type":"WQ","unlockDescTextMapHash":2670435086}},"flow":[{"subQuestId":7566101,"order":1,"stepDescription":"","stepDescTextMapHash":3088572812,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7566101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7566101],"talks":[{"talkId":7566101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7566101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7566101,"initDialog":756610101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1092],"performCfg":"QuestDialogue/WQ/Natlan_75661/Q7566101","priority":5,"questId":75661,"showRandomTalkCount":0},"dialogs":[{"nodeId":756610101,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":1419211738,"text":"No wonder I had a nagging feeling that I should come over and have a look... Well met, \"Tum{RUBY#[D]Hope}aini.\"","nextNodeIds":[756610102]},{"nodeId":756610102,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":765876842,"text":"Let me guess. You're here for the Flower-Feather Clan's warrior trial?","nextNodeIds":[756610103,756610106]},{"nodeId":756610103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2356699162,"text":"That's right. I'm here to certify its difficulty!","nextNodeIds":[756610104]},{"nodeId":756610104,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":639708282,"text":"You won't be disappointed, then. I've got nothing but the highest standards for Qucusaur Riders.","nextNodeIds":[756610105]},{"nodeId":756610105,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":2826506890,"text":"Teaching's not my strong suit, so when I was invited to design these stages, I went with \"recalling tough challenges and piling them in one after the other.\"","nextNodeIds":[756610109]},{"nodeId":756610109,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":2564106250,"text":"The result was... a ninety-nine percent failure rate on the part of our tribe's warriors — on the first stage, no less. As a result... There wasn't any choice but to take Irade's advice and tune the difficulty down a notch.","nextNodeIds":[756610110]},{"nodeId":756610110,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":4008425018,"text":"But I doubt that even the trials as they originally stood would have truly stretched you. If we wanted that... We'd have to go with situations even I would prove helpless in.","nextNodeIds":[756610111,756610112]},{"nodeId":756610111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":469877274,"text":"Thanks for the kind words, but I don't need special treatment!","nextNodeIds":[756610113]},{"nodeId":756610113,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":2470785026,"text":"No, I do believe you worthy of such respect. I'm no teacher, but I've never misjudged the strength of those I meet.","nextNodeIds":[756610114]},{"nodeId":756610114,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":2005060210,"text":"And as far as yours is concerned... only the most trying of challenges would befit you.","nextNodeIds":[756610115,756610116]},{"nodeId":756610115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3210697042,"text":"I need to consider the stages' suitability for ordinary warriors, though...","nextNodeIds":[756610117]},{"nodeId":756610117,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":2513348210,"text":"...Fair enough. You've got a task to complete, and we'll have more opportunities in the future.","nextNodeIds":[756610118]},{"nodeId":756610118,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":36493666,"text":"One day, I'll lay out a banquet table of battle that \"transcends\" the pinnacle of Qucusaur Rider ability, just for you.","nextNodeIds":[]},{"nodeId":756610116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1513092986,"text":"The universality of the stages is not to be overlooked either!","nextNodeIds":[756610117]},{"nodeId":756610112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":53012866,"text":"Haha, don't put me on a pedestal, now!","nextNodeIds":[756610113]},{"nodeId":756610106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3441874882,"text":"I could've come for you, for all you know.","nextNodeIds":[756610107]},{"nodeId":756610107,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":2167255906,"text":"Oh? That so...","nextNodeIds":[756610108]},{"nodeId":756610108,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":1700780618,"text":"So you wanna \"transcend\" my record, then? That's just my speed. I'll have you know that I started by stuffing these stages full of tough challenges that I've faced in the past.","nextNodeIds":[756610109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7566101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7566101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","count":12},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1783673078,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75661/Q7566101","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"H