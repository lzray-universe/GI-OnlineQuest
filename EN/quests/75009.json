,"questId":75009,"showRandomTalkCount":0},"dialogs":[{"nodeId":750090201,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":682158618,"text":"Rawr!","nextNodeIds":[750090202]},{"nodeId":750090202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2678080826,"text":"This little ball... It looks kinda like a component or something. You like it?","nextNodeIds":[750090203]},{"nodeId":750090203,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":4199693714,"text":"Rrrah... Rawr!","nextNodeIds":[750090204]},{"nodeId":750090204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":411698914,"text":"Though we didn't dig it up, since we did find it here... It might be something really valuable!","nextNodeIds":[750090205]},{"nodeId":750090205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2353772490,"text":"Let's ask when we leave!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7500902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133502676"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_9494:-2093.145,88.187,8778.546,0.000,298.553,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7500906,"order":10,"stepDescription":"Go back and ask Quipia","stepDescTextMapHash":2948042900,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7500906,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21485"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7500906,7500908],"talks":[{"talkId":7500906,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":true,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7500906","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7500906,"initDialog":750090601,"nextRandomTalks":[],"nextTalks":[],"npcId":[21485],"performCfg":"QuestDialogue/WQ/Natlan_75009/Q7500906","priority":5,"questId":75009,"showRandomTalkCount":0},"dialogs":[{"nodeId":750090601,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":1888142538,"text":"How did it go?","nextNodeIds":[750090602]},{"nodeId":750090602,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1997508674,"text":"#{REALNAME[ID(2)|SHOWHOST(true)]} found this...","nextNodeIds":[750090603]},{"nodeId":750090603,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":23673242,"text":"Rawr!","nextNodeIds":[750090604]},{"nodeId":750090604,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":79065090,"text":"Let me have a look... Not the most uncommon item, but still, a rare find. It is very well-preserved, with clearly-visible phlogiston flow patterns.","nextNodeIds":[750090605]},{"nodeId":750090605,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":3587635210,"text":"Yes... Would you be willing to part with it if I gave you 10,000 Mora?","nextNodeIds":[750090606]},{"nodeId":750090606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2259805890,"text":"Wha—!? Did we really find a priceless Saurian relic!?","nextNodeIds":[750090607]},{"nodeId":750090607,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4215566410,"text":"#Paimon just knew that {REALNAME[ID(2)|SHOWHOST(true)]} was awesome, and would bring us good luck!","nextNodeIds":[750090608]},{"nodeId":750090608,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":469480802,"text":"No, this isn't nearly as precious as you seem to think. Were you to take it to Association headquarters for appraisal, it'd clock in at around 5,000 Mora at most.","nextNodeIds":[750090609]},{"nodeId":750090609,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1786699954,"text":"Paimon's not falling for that trick! If it's only worth 5,000, why are you willing to pay 10,000 for it?","nextNodeIds":[750090610]},{"nodeId":750090610,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":3348274594,"text":"That's because of the unique patterns on it. I'm quite taken with them. Though it may not be that valuable in the eyes of others, I'm willing to pay a bit extra for it.","nextNodeIds":[750090611]},{"nodeId":750090611,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":852198506,"text":"You may call me eccentric, but you could also say it's just the nature of a collector.","nextNodeIds":[750090612]},{"nodeId":750090612,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3037830050,"text":"Hmm... When you put it like that, Paimon gets you. And 10,000 is quite a lot compared to the entrance fee.","nextNodeIds":[750090613]},{"nodeId":750090613,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1574221986,"text":"So, shall we trade it in for 10,000?","nextNodeIds":[750090614]},{"nodeId":750090614,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2097850674,"text":"Wrroh... Rrrooo...","nextNodeIds":[750090615]},{"nodeId":750090615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2028961698,"text":"#You don't seem too happy about that, {REALNAME[ID(2)|SHOWHOST(true)]}... Do you wanna keep it for yourself?","nextNodeIds":[750090616]},{"nodeId":750090616,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2077555154,"text":"Rrrah... Rawr!","nextNodeIds":[750090617,750090618]},{"nodeId":750090617,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2192343298,"text":"Well, you were the one who found it.","nextNodeIds":[750090619]},{"nodeId":750090619,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4005636930,"text":"#Since {REALNAME[ID(2)|SHOWHOST(true)]} doesn't want to sell, then we'll just have to keep it.","nextNodeIds":[750090620]},{"nodeId":750090620,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3799618554,"text":"Rawr!","nextNodeIds":[750090621]},{"nodeId":750090621,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":3600873274,"text":"#Looks like you value {REALNAME[ID(2)|SHOWHOST(true)]} far more than Mora.","nextNodeIds":[750090622]},{"nodeId":750090622,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3334271162,"text":"Naturally! He's our companion, after all. But if we find something similar in the future...","nextNodeIds":[750090623]},{"nodeId":750090623,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":1235015706,"text":"Thank you, but a collector's passion is as fickle as the tides. It rises as suddenly as it might retreat. Perhaps I'll find myself obsessing over something else in the future, though I can't yet say what my new interest will be.","nextNodeIds":[750090624]},{"nodeId":750090624,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":4086481786,"text":"Rawr! Rawr rawr!","nextNodeIds":[750090625]},{"nodeId":750090625,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":353121490,"text":"#Are you agreeing with her, {REALNAME[ID(2)|SHOWHOST(true)]}? Ohhh, Paimon gets it! This must be the mutual respect and understanding shared by collectors!","nextNodeIds":[750090626]},{"nodeId":750090626,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":1329268274,"text":"It is my honor to have been acknowledged by such a brilliant young Tepetlisaurus. Still, even if we can't do business, that doesn't mean we can't be friends! Feel free to come find me if you ever want to talk about collecting.","nextNodeIds":[750090627]},{"nodeId":750090627,"roleType":"TALK_ROLE_NPC","speakerId":21485,"speakerName":"Quipia","textMapHash":2287505154,"text":"I won't keep you any longer, then. Good luck!","nextNodeIds":[]},{"nodeId":750090618,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3964378826,"text":"Guess you wanna be a collector too, huh?","nextNodeIds":[750090619]}]},{"talkId":7500908,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7500901","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7500906","","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"Q