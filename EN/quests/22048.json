estId":22048,"showRandomTalkCount":0},"dialogs":[{"nodeId":220480101,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1702817898,"text":"The shrine is getting messy again...","nextNodeIds":[220480102]},{"nodeId":220480102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1760312074,"text":"What's wrong?","nextNodeIds":[220480103]},{"nodeId":220480103,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":4191485258,"text":"Meow, it is you again. Well met.","nextNodeIds":[220480104]},{"nodeId":220480104,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2009230754,"text":"Ah, the fallen leaves infest the shrine once again. How unsightly...","nextNodeIds":[220480105]},{"nodeId":220480105,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":801705410,"text":"This is no way to greet those humans coming to pay their respects.","nextNodeIds":[220480106]},{"nodeId":220480106,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3878111986,"text":"Could you aid me in cleaning up the shrine, as you did before?","nextNodeIds":[220480107,220480112]},{"nodeId":220480107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3823613002,"text":"Don't you have Taisuke and Etsuko around?","nextNodeIds":[220480108]},{"nodeId":220480108,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2879393306,"text":"I... will not speak to those two green humans of my own accord.","nextNodeIds":[220480109]},{"nodeId":220480109,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2797346194,"text":"The tall human always looks upon me with a strange gaze...","nextNodeIds":[220480110]},{"nodeId":220480110,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1563676010,"text":"And the other green human never seems particularly... motivated?","nextNodeIds":[220480111]},{"nodeId":220480111,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3239685722,"text":"Meow meow, regardless, they are not reliable humans.","nextNodeIds":[220480115]},{"nodeId":220480115,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1617718490,"text":"Whatever the case, I can only rely on you for this task. Just use the long stick to clean it all up.","nextNodeIds":[220480116,220480117]},{"nodeId":220480116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1540693034,"text":"I've got it.","nextNodeIds":[220480118]},{"nodeId":220480118,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3001943946,"text":"Whatever the case, I shall leave this to you. I...","nextNodeIds":[220480119]},{"nodeId":220480119,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":482900146,"text":"I will wait for you here, meow meow.","nextNodeIds":[]},{"nodeId":220480117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3128225042,"text":"I got you, more or less.","nextNodeIds":[220480118]},{"nodeId":220480112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3132287570,"text":"Well, you could ask Mr. Ooshima...","nextNodeIds":[220480113]},{"nodeId":220480113,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1963852386,"text":"The stone human is always busy with his knock-knock-knocking. Who knows what he is doing.","nextNodeIds":[220480114]},{"nodeId":220480114,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2702889570,"text":"The stone was knocked, after all. What is he knocking this time, I wonder... How annoying...","nextNodeIds":[220480115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2204801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPF