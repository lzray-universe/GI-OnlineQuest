:"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1400302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1400301,"initDialog":140030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1071,1070,1072],"performCfg":"QuestDialogue/LQ/Liney1_14003/Q1400301","priority":5,"questId":14003,"showRandomTalkCount":0},"dialogs":[{"nodeId":140030101,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":4251713706,"text":"I'm very sorry, Charlotte, but my sister and I are quite busy today. I'm afraid we will have to decline this interview...","nextNodeIds":[140030102]},{"nodeId":140030102,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":719449434,"text":"Oh, please, Lyney? I'll only take a moment of your time! If you would be so kind!","nextNodeIds":[140030103]},{"nodeId":140030103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":447577466,"text":"Huh. What's happening here?","nextNodeIds":[140030104]},{"nodeId":140030104,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":1632007930,"text":"I spent all night writing my piece about The Phantom Weasel, and it was going to go to print this morning...","nextNodeIds":[140030105]},{"nodeId":140030105,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":3868767898,"text":"But just as dawn broke, I suddenly received news that Cesar's fiancée, Jemma, had contacted the Gardes and confessed to having been the real Phantom Weasel all along!","nextNodeIds":[140030106]},{"nodeId":140030106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3394241914,"text":"That was quick!","nextNodeIds":[140030107]},{"nodeId":140030107,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":3315158730,"text":"Ahem.","nextNodeIds":[140030108]},{"nodeId":140030108,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":658276850,"text":"Hmm?","nextNodeIds":[140030109]},{"nodeId":140030109,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"Lynette","textMapHash":2188655802,"text":"Too late, bro.","nextNodeIds":[140030110]},{"nodeId":140030110,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":177684546,"text":"Hohoho! \"That was quick,\" you say? It sounds like I've got some catching up to do! Please, fill me in.","nextNodeIds":[140030111]},{"nodeId":140030111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3683238706,"text":"Hehe, whoops!","nextNodeIds":[140030112]},{"nodeId":140030112,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":3431598314,"text":"Aha! My instincts did not lead me astray — you DO have something to hide! Jemma turning herself in must have something to do with Lyney's performance last night!","nextNodeIds":[140030113]},{"nodeId":140030113,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":823186570,"text":"Maybe watching my high-altitude escape trick reminded her of a better time with Cesar, and she could no longer ignore the voice of her conscience.","nextNodeIds":[140030114]},{"nodeId":140030114,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":1234161898,"text":"Huh, okay then... Wait, no no no, there must be more to it! If that's all it took for her to have a change of heart, how did it take her ten whole years?","nextNodeIds":[140030115]},{"nodeId":140030115,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":1370427634,"text":"Umm... Well...","nextNodeIds":[140030116]},{"nodeId":140030116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2050254146,"text":"(Charlotte's journalistic spirit is burning red — we're going to have to distract her somehow...)","nextNodeIds":[140030117]},{"nodeId":140030117,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":2364992946,"text":"Ah, I remember now! You and Jemma were nowhere to be found after the show... What happened between you?","nextNodeIds":[140030118]},{"nodeId":140030118,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":3393065250,"text":"Quickfire question! Where did you all go after the show?","nextNodeIds":[140030119]},{"nodeId":140030119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3610961594,"text":"Oh, we went to the cemetery, and Lyney did a private magic trick, just for us!","nextNodeIds":[140030120]},{"nodeId":140030120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":977571586,"text":"Actually, glad you mentioned it, 'cause that reminds Paimon. Guess what? Lyney's started using Rainbow Roses in his tricks!","nextNodeIds":[140030121]},{"nodeId":140030121,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":3520816186,"text":"*cough*","nextNodeIds":[140030122]},{"nodeId":140030122,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"Lynette","textMapHash":3079313730,"text":"...What?","nextNodeIds":[140030123]},{"nodeId":140030123,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"Lynette","textMapHash":3508381442,"text":"I don't recall ever having received a Rainbow Rose from you myself. Is this supposed to mean that they're more important to you than your own sister?","nextNodeIds":[140030124]},{"nodeId":140030124,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":1265347578,"text":"No! I, I just, uh...","nextNodeIds":[140030125]},{"nodeId":140030125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2878778682,"text":"#What the... What now? Oh, did Paimon say something wrong again, {NICKNAME}?","nextNodeIds":[140030126]},{"nodeId":140030126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":269047602,"text":"#This is getting pretty awkward... What do we do, {NICKNAME}?","nextNodeIds":[140030127]},{"nodeId":140030127,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":94694394,"text":"*sigh* Seems like this interview wasn't meant to be. Well, never mind — there's always next time.","nextNodeIds":[140030128]},{"nodeId":140030128,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":1789349938,"text":"Forgive my persistence, but when there's explosive news waiting to be found, I can't turn away! The news about Jemma has already made waves, and I'll stop at nothing to get to the bottom of it all!","nextNodeIds":[140030129]},{"nodeId":140030129,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":1369043010,"text":"Apparently, one of the things she said to the Gardes was that her \"final wish is to see Lorenzo one last time.\" *sigh* There's clearly a web of complicated relationships there... Can't blame me for being curious.","nextNodeIds":[140030130]},{"nodeId":140030130,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"Charlotte","textMapHash":4214593882,"text":"Alright, I guess I'll leave you to continue the rest of your conversation in peace. Bye for now!","nextNodeIds":[140030131]},{"nodeId":140030131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4286934082,"text":"Um, Lynette, Paimon didn't mean to—","nextNodeIds":[140030132]},{"nodeId":140030132,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"Lynette","textMapHash":1759992546,"text":"Don't worry, I wasn't angry. I was just trying to distract her.","nextNodeIds":[140030133]},{"nodeId":140030133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3574025002,"text":"Oh, really? Thank goodness. You scared Paimon there!","nextNodeIds":[140030134]},{"nodeId":140030134,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":3342832018,"text":"Phew, you and me both, Paimon, you and me both... At least it did the job, right?","nextNodeIds":[140030135]},{"nodeId":140030135,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"Lynette","textMapHash":2766785362,"text":"...Please take good care of that Rainbow Rose.","nextNodeIds":[140030136]},{"nodeId":140030136,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"Lynette","textMapHash":737844762,"text":"I'd be really upset if you lost it.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1400301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1400301","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"N