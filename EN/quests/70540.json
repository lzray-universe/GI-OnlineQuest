c":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7054001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7054001,"initDialog":705400101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30531],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7054001","priority":5,"questId":70540,"showRandomTalkCount":0},"dialogs":[{"nodeId":705400101,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"Sir Pouncelot","textMapHash":3875811266,"text":"*hiss*","nextNodeIds":[705400102]},{"nodeId":705400102,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3462077482,"text":"*whimper*... The cat is hissing at me, Miss Rosaria! I'm scared!","nextNodeIds":[705400103]},{"nodeId":705400103,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2420671050,"text":"You should probably give him some space. Get too close, and all that swatting might catch you in the face.","nextNodeIds":[705400104]},{"nodeId":705400104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3729329010,"text":"Uh oh, seems like Valerina has run into some more cat-sized trouble...","nextNodeIds":[705400105,705400106]},{"nodeId":705400105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3548350410,"text":"Looks like the shelter has a new stray...","nextNodeIds":[705400107]},{"nodeId":705400107,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3379747554,"text":"Honorary Knight! Cat Whisperer! This big cat just barged in here after Snowball! He must have spotted her when she went out for a walk and followed her all the way back here...","nextNodeIds":[705400108]},{"nodeId":705400108,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2993605994,"text":"Easy, easy. No one's going to hurt you here.","nextNodeIds":[705400109]},{"nodeId":705400109,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":451504442,"text":"All those evil things, all those bad people who forced you to do whatever it took to survive... They can't find you here. You're safe within these walls.","nextNodeIds":[705400110]},{"nodeId":705400110,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2030150986,"text":"You're surrounded by good people now. Their constant hovering might get a little annoying, but it's all for your own good. Just relax. A life of leisure isn't a bad thing, you know. You just have to get used to it.","nextNodeIds":[705400111]},{"nodeId":705400111,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"Sir Pouncelot","textMapHash":1608346234,"text":"*hiss*... *whimper*","nextNodeIds":[705400112]},{"nodeId":705400112,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2994002858,"text":"H—He understood all that?","nextNodeIds":[705400113]},{"nodeId":705400113,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":3534784786,"text":"Looks like it worked. Hah, smart cat.","nextNodeIds":[705400114]},{"nodeId":705400114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1732277770,"text":"Woah, this cat is waaay bigger than the others. His coloring looks like fresh-squeezed Bulle Fruit juice! And he's wearing a scarf too! Huh, looks like there's some sort of design on it... Oh! It's the symbol of the Knights of Favonius!","nextNodeIds":[705400115]},{"nodeId":705400115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2848592650,"text":"He deserves a name fit for a knight, then! Hmm, he's pretty feisty. How about \"Sir Pouncelot\"?","nextNodeIds":[705400116]},{"nodeId":705400116,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"Sir Pouncelot","textMapHash":653006634,"text":"Meow!","nextNodeIds":[705400117]},{"nodeId":705400117,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2143436738,"text":"You really do have a way with cats. He looks way more at ease now.","nextNodeIds":[705400118]},{"nodeId":705400118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2334896546,"text":"Paimon thinks you deserve to take the credit this time. Sir Pouncelot seemed to calm right down after everything you said to him!","nextNodeIds":[705400119,705400120]},{"nodeId":705400119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1506672578,"text":"You're getting much better with them, Rosaria!","nextNodeIds":[705400121]},{"nodeId":705400121,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":3800509586,"text":"It doesn't matter to me either way. Although... The fact that they're cute doesn't hurt.","nextNodeIds":[705400122]},{"nodeId":705400122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3434280018,"text":"Let Paimon show you how to put Sir Pouncelot completely at ease! Paimon just needs to work a bit more of her magic, and he'll be as happy as can be!","nextNodeIds":[]},{"nodeId":705400120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3883175386,"text":"Hopefully you're finding this gig a bit more fun, too!","nextNodeIds":[705400121]},{"nodeId":705400106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":940348578,"text":"There's something almost... dignified about him...","nextNodeIds":[705400107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1090","201090006"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[1090_20:0.072,0.000,9.005]"],"NOCCOBOFKHP":1090,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7054001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"Sir Pouncelot","count":3},{"roleType":"TALK_ROLE_NPC","speakerId"