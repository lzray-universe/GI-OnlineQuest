{"mainQuestId":71532,"title":"Iridescent Cloud-Striding","description":"As you pass by a lane in Yilong Wharf, a sincere Storyteller's disciple approaches you and narrates a tale intimately related to you both...","titleTextMapHash":545534439,"descTextMapHash":818197310,"mainQuestExcel":{"mainQuestId":71532,"titleTextMapHash":545534439,"title":"Iridescent Cloud-Striding","descTextMapHash":818197310,"description":"As you pass by a lane in Yilong Wharf, a sincere Storyteller's disciple approaches you and narrates a tale intimately related to you both...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2028,"luaPath":"Actor/Quest/WQ71532","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2028,"chapterId":0,"descTextMapHash":818197310,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71532,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2915729753,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71532","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171532],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":545534439,"type":"WQ","unlockDescTextMapHash":483736366}},"flow":[{"subQuestId":7153201,"order":1,"stepDescription":"Talk to Juanshu","stepDescTextMapHash":2935520356,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30459"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7153201],"talks":[{"talkId":7153201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7153201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7153201,"initDialog":715320101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30459],"performCfg":"QuestDialogue/WQ/Liyue_71532/Q7153201","priority":5,"questId":71532,"showRandomTalkCount":0},"dialogs":[{"nodeId":715320101,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":1392835674,"text":"Esteemed guests, I, the apprentice Storyteller Juanshu, must humbly request you cease your steps for a moment—","nextNodeIds":[715320102]},{"nodeId":715320102,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":3751608378,"text":"Perhaps you have heard a tale that goes something like this? \"In the beautiful night of Lantern Rite, flaming lights once danced across the sky like glowing brushes, like a majestic scroll...\"","nextNodeIds":[715320103]},{"nodeId":715320103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":297810946,"text":"Uh, Paimon didn't quite catch that.","nextNodeIds":[715320104]},{"nodeId":715320104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":168357282,"text":"Flaming lights? Painting in the sky? That's not something ordinary people can do... Even if you had some kinda airship, there's no kind of mysterious paint that can just hang in the air like that.","nextNodeIds":[715320105]},{"nodeId":715320105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":315017042,"text":"Sounds like a seriously exaggerated analogy!","nextNodeIds":[715320106,715320107]},{"nodeId":715320106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1211240842,"text":"Surely not an ordinary painting?","nextNodeIds":[715320108]},{"nodeId":715320108,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":2190613890,"text":"#Anyway! The protagonists of this tale are none other than you two, the renowned {NICKNAME} whose fame has spread throughout the land, and {M#his}{F#her} companion Paimon!","nextNodeIds":[715320109]},{"nodeId":715320109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2697979834,"text":"Huh? Why is it suddenly about us?","nextNodeIds":[715320110]},{"nodeId":715320110,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":4204714218,"text":"Perhaps you have already forgotten, but this time last year, you accepted a commission from the Adventurer Tiantian and participated in a special speedrun challenge.","nextNodeIds":[715320111]},{"nodeId":715320111,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":1406565738,"text":"That speedrun challenge was illuminated by the glow of fireworks! A sight most majestic, a splendorous scene not oft seen!","nextNodeIds":[715320112]},{"nodeId":715320112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4165855970,"text":"Now that you mention it, Paimon kinda remembers that we helped some promoter from the Adventurers' Guild... It was nothing, really...","nextNodeIds":[715320113]},{"nodeId":715320113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":953747754,"text":"She said she wanted to use the event to recruit new members — no idea if it actually worked, though.","nextNodeIds":[715320114,715320115]},{"nodeId":715320114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2045099938,"text":"I guess something like that might've happened?","nextNodeIds":[715320116]},{"nodeId":715320116,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":3512715866,"text":"At the time, I was drowning my sorrows in liquor near the Wangshu Inn, and as I looked up, I saw your silhouettes framed by the fireworks...","nextNodeIds":[715320117]},{"nodeId":715320117,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":1271463210,"text":"In a moment, the sadness from flunking the exam, my confusion about the path that lay before me, it was all dispelled in a flash by your radiant figures blazing bright with vitality!","nextNodeIds":[715320118]},{"nodeId":715320118,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":3617623778,"text":"So I pulled myself together, and continued my research into folktales, and thus came to Chenyu Vale, drinking deep of my favorite subject... I must thank you for the encouragement you gave me!","nextNodeIds":[715320119]},{"nodeId":715320119,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":3879094714,"text":"And it is not just me! Many were moved by your splendid silhouettes, joining the Adventurers' Guild and finding new direction in life!","nextNodeIds":[715320120]},{"nodeId":715320120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3399254226,"text":"P—Paimon never imagined anything like that! We didn't even notice anyone watching at the time, and didn't even think us joining in a little race could inspire other people!","nextNodeIds":[715320121]},{"nodeId":715320121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":573967474,"text":"When you put it like that, it's kinda embarrassing...","nextNodeIds":[715320122,715320123]},{"nodeId":715320122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":377771754,"text":"It's good to see that your spirits have improved.","nextNodeIds":[715320124]},{"nodeId":715320124,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":860884690,"text":"To run into you today is truly my good fortune. There is one thing I would like to ask, in addition to expressing my sincerest gratitude—","nextNodeIds":[715320125]},{"nodeId":715320125,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":942344946,"text":"Please, pass your radiant glory onward, and continue to inspire even more people!","nextNodeIds":[715320126]},{"nodeId":715320126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2922198866,"text":"Though we aren't nearly as great as you say, you've got a good idea going! If we can cheer up more people, we're in!","nextNodeIds":[715320127]},{"nodeId":715320127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1262410010,"text":"Though now that you mention it, just what should we do?","nextNodeIds":[715320128]},{"nodeId":715320128,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":1365102586,"text":"In accordance with usual practices, I used Tiantian's racing challenge as a reference and teamed up with other Adventurers inspired by you. We've planned a brand new activity: \"Iridescent Cloud-Striding.\"","nextNodeIds":[715320129]},{"nodeId":715320129,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":3829496514,"text":"There are many wondrous things here in Chenyu Vale, including a strange carp whose power allows you to travel most swiftly.","nextNodeIds":[715320130]},{"nodeId":715320130,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":1184564682,"text":"All you need to do is vault over valleys and mount the mountaintops with your nimbleness, showing your vibrant dynamism to all and sundry, just as before!","nextNodeIds":[715320131,715320132]},{"nodeId":715320131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":612130186,"text":"Easy-peasy!","nextNodeIds":[715320133]},{"nodeId":715320133,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":4075680018,"text":"Of course, beyond the Mora I have prepared as a token of appreciation, we've prepared a variety of other rewards to express our gratitude.","nextNodeIds":[715320134]},{"nodeId":715320134,"roleType":"TALK_ROLE_NPC","speakerId":30459,"speakerName":"Juanshu","textMapHash":2348737266,"text":"Such paltry gestures pale with the hope you have gifted to so many and the excitement your past deeds inspire! But that is not all. In the future, we will find more chances to repay you!","nextNodeIds":[715320135]},{"nodeId":715320135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2300353322,"text":"Hehe, you're too kind! We'll keep on journeying and helping out those in need along the way, even without any rewards!","nextNodeIds":[715320136]},{"nodeId":715320136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1880470010,"text":"But after hearing you, we're even more inspired to keep on adventuring! Let's give this Iridescent Cloud-Striding a try!","nextNodeIds":[]},{"nodeId":715320132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2052402650,"text":"We're in!","nextNodeIds":[715320133]},{"nodeId":715320123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3905946834,"text":"Congratulations on getting it together.","nextNodeIds":[715320124]},{"nodeId":715320115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":815369106,"text":"So what's your point?","nextNodeIds":[715320116]},{"nodeId":715320107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2055947250,"text":"Could you be talking about fireworks?","nextNodeIds":[715320108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMF