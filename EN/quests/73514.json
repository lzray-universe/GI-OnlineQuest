"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351401,"initDialog":735140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30343,30342],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351401","priority":5,"questId":73514,"showRandomTalkCount":0},"dialogs":[{"nodeId":735140101,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2645364858,"text":"That was close... Even the Wenut have come to mess up our plan...","nextNodeIds":[735140102]},{"nodeId":735140102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3838262354,"text":"Hey! If we hadn't deactivated the ignition, we could have killed it!","nextNodeIds":[735140103]},{"nodeId":735140103,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3759123658,"text":"Now that the Wenut has escaped, it'll be at least one more day before it lets its guard down again.","nextNodeIds":[735140104]},{"nodeId":735140104,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3184773042,"text":"You're not planning to argue over the tiniest detail and let it go again tomorrow, are you?","nextNodeIds":[735140105]},{"nodeId":735140105,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3251250210,"text":"Um, but what about the parameters...","nextNodeIds":[735140106]},{"nodeId":735140106,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3912079730,"text":"I have tested them all, and although the charging speed is a little lower than the calculated value, it does not affect use, and there are no safety risks.","nextNodeIds":[735140107]},{"nodeId":735140107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":543442666,"text":"Shriya, I know you want to consider and analyze everything before acting, but you know, things don't always go according to plan.","nextNodeIds":[735140108]},{"nodeId":735140108,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1032572410,"text":"If you keep getting hung up over the small details, you'll miss the best opportunity to act! Remember that time our mid-term thesis defense got delayed? Hesitating won't get us anywhere.","nextNodeIds":[735140109]},{"nodeId":735140109,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1391284810,"text":"*sigh* Okay. Here's your ignition module.","nextNodeIds":[735140110]},{"nodeId":735140110,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":260284874,"text":"Alright! Tomorrow, we'll finally be able to put the Wenutslayer Cannon into action!","nextNodeIds":[735140111]},{"nodeId":735140111,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2668653874,"text":"I'd like to bring them back to Aaru Village and tinker around with them a little more. We gotta make sure we're properly ready for the Wenutslayer Cannon's first ever official appearance!","nextNodeIds":[735140112]},{"nodeId":735140112,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2231905258,"text":"...But why is there a deviation in the environmental parameters? What caused the Wenut to suddenly act out?","nextNodeIds":[735140113]},{"nodeId":735140113,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1899545466,"text":"#You really can't just let these matters rest... {M#Mr.}{F#Ms.} Adventurer, could you please come back tomorrow?","nextNodeIds":[735140114]},{"nodeId":735140114,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":432304378,"text":"By then, we should be facing the Wenut directly, and hopefully we'll have some sort of clue.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173514],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":410403566,"CHECNJEMEFE":{},"CJPLOBIFHL