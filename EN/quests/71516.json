{"mainQuestId":71516,"title":"Backstage Helpers","description":"Thanks to you, the performance of Homeward, Bravebeard went smoothly, but it seems that Yinggong has something to say to you...","titleTextMapHash":2943465183,"descTextMapHash":2823907286,"mainQuestExcel":{"mainQuestId":71516,"titleTextMapHash":2943465183,"title":"Backstage Helpers","descTextMapHash":2823907286,"description":"Thanks to you, the performance of Homeward, Bravebeard went smoothly, but it seems that Yinggong has something to say to you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2019,"luaPath":"Actor/Quest/WQ71516","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2019,"chapterId":0,"descTextMapHash":2823907286,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71516,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2786046529,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71516","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171516],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2943465183,"type":"WQ","unlockDescTextMapHash":1904384166}},"flow":[{"subQuestId":7151601,"order":1,"stepDescription":"Talk to Yinggong","stepDescTextMapHash":92216620,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30306"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7151601],"talks":[{"talkId":7151601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7151601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7151601,"initDialog":715160101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30306],"performCfg":"","priority":5,"questId":71516,"showRandomTalkCount":0},"dialogs":[{"nodeId":715160101,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":315140754,"text":"Such a great end to the play. You've done well, young one. How did you find it? Was it hard to perform with paper?","nextNodeIds":[715160102,715160104]},{"nodeId":715160102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3781210330,"text":"It was a piece of cake.","nextNodeIds":[715160103]},{"nodeId":715160103,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1063201042,"text":"Paper plays are different from Liyue Operas. Being able to do everything yourself makes things a lot simpler.","nextNodeIds":[715160106]},{"nodeId":715160106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":758790354,"text":"#Paimon thinks {NICKNAME} did pretty well. The script itself for the paper play is also very interesting! Paimon wants to see a new story. Yinggong, when will you perform next time?","nextNodeIds":[715160107]},{"nodeId":715160107,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":4113546290,"text":"Haha, as long as someone enjoys it. As for next time, I don't know.","nextNodeIds":[715160108]},{"nodeId":715160108,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1198091818,"text":"You see, doing paper plays for kids is actually a hobby of mine. After this, I will return to the Yun-Han Opera Troupe to handle the wardrobe and props.","nextNodeIds":[715160109]},{"nodeId":715160109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3937002858,"text":"Eh? You're with the Yun-Han Opera Troupe? So you can also sing Liyue Opera.","nextNodeIds":[715160110]},{"nodeId":715160110,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1579731370,"text":"I can, to some extent. Who wouldn't be able to carry a tune after staying with the Yun-Han Opera Troupe for so long? Of course, I'm nothing when compared to Ms. Yun.","nextNodeIds":[715160111]},{"nodeId":715160111,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1469208098,"text":"I actually work with the people behind the scenes. I'm in charge of the wardrobe and props on stage, such as cannons, flags, costumes, accessories, gadgets... Whatever prop you saw on stage, that was me.","nextNodeIds":[715160112]},{"nodeId":715160112,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3044193194,"text":"Some of the costumes and props that the Yun-Han Opera Troupe uses today are hand-me-downs from the past, and others were bought or made by myself.","nextNodeIds":[715160113]},{"nodeId":715160113,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2343128682,"text":"To perform an entire Liyue Opera, there are a lot of people working on stage and behind the scenes. You can't make it happen with just a few actors and actresses.","nextNodeIds":[715160114]},{"nodeId":715160114,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2763751354,"text":"This year's Lantern Rite, Ms. Yun gave some of us backstage helpers some time off, and all of my colleagues are back home to spend the holidays.","nextNodeIds":[715160115]},{"nodeId":715160115,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3288735818,"text":"I've got all this time on my hands, so I decided to put on a paper play for the people here.","nextNodeIds":[715160116]},{"nodeId":715160116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1259022970,"text":"You didn't go home?","nextNodeIds":[715160117]},{"nodeId":715160117,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":698542506,"text":"No, I didn't go home. My mother and father passed away two years ago, so it's just me now.","nextNodeIds":[715160118,715160119]},{"nodeId":715160118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":131387458,"text":"...","nextNodeIds":[715160120]},{"nodeId":715160120,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3054523970,"text":"Oh, there's nothing to be sorry about. I don't mind.","nextNodeIds":[715160121]},{"nodeId":715160121,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1670001058,"text":"I'm having a good time by myself at the Lantern Rite. As you can see, those kids loved my paper play.","nextNodeIds":[715160122]},{"nodeId":715160122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2937699442,"text":"We also enjoyed it!","nextNodeIds":[715160123]},{"nodeId":715160123,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":558923026,"text":"Of course I enjoyed it myself as well, otherwise I wouldn't have bothered making all the paper characters and paper settings.","nextNodeIds":[715160124]},{"nodeId":715160124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2953967690,"text":"Did you write the story yourself?","nextNodeIds":[715160125]},{"nodeId":715160125,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1268479466,"text":"Not really. Whether it's Liyue Operas, paper plays, or the Tea Master's stories, they all know the tale of the Bravebeard.","nextNodeIds":[715160126]},{"nodeId":715160126,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1214235290,"text":"In their moment of need, when people call for a hero, such heroes will answer the call to save the day.","nextNodeIds":[715160127]},{"nodeId":715160127,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3622352586,"text":"Liyue has no shortage of such heroes. Just put a little spin on their story, and you have something to enjoy.","nextNodeIds":[715160128]},{"nodeId":715160128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3858562874,"text":"Paimon has heard a lot about this before. Is this part of Liyue's traditional culture?","nextNodeIds":[715160129]},{"nodeId":715160129,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":4278990290,"text":"Haha, yeah, that sounds about right.","nextNodeIds":[715160130]},{"nodeId":715160130,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3670325442,"text":"But while there are always heroes who help out in times of crisis, you can't keep relying on others and have to take responsibility for yourself.","nextNodeIds":[715160131]},{"nodeId":715160131,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3584821514,"text":"#Take care of yourself, {M#young man}{F#young lady}. Happy Lantern Rite!","nextNodeIds":[715160132]},{"nodeId":715160132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3624328714,"text":"I will. Happy Lantern Rite!","nextNodeIds":[715160133]},{"nodeId":715160133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":32805290,"text":"Happy Lantern Rite!","nextNodeIds":[715160134]},{"nodeId":715160134,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":4231160586,"text":"If you have time, come see an opera at the Yun-Han Opera Troupe. Maybe we'll see each other again there.","nextNodeIds":[]},{"nodeId":715160119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3505629106,"text":"I'm so sorry.","nextNodeIds":[715160120]},{"nodeId":715160104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":807668362,"text":"It was a little hard.","nextNodeIds":[715160105]},{"nodeId":715160105,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3184628786,"text":"You're not a performer by trade, so of course you'd be bound to make some mistakes on your first try.","nextNodeIds":[715160106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30306"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7151601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","count":22},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171516],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2823907286,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BE