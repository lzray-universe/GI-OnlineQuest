{"mainQuestId":22034,"title":"Bantan Sango Case File: The Search","description":"Ryuuji from the Bantan Sango Detective Agency seems to have something he needs help with...","titleTextMapHash":902614991,"descTextMapHash":2558447926,"mainQuestExcel":{"mainQuestId":22034,"titleTextMapHash":902614991,"title":"Bantan Sango Case File: The Search","descTextMapHash":2558447926,"description":"Ryuuji from the Bantan Sango Detective Agency seems to have something he needs help with...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ22034","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2558447926,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":22034,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3428091009,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ22034","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":41180,"titleTextMapHash":902614991,"type":"IQ","unlockDescTextMapHash":2705575494}},"flow":[{"subQuestId":2203401,"order":1,"stepDescription":"Talk to Ryuuji","stepDescTextMapHash":987313612,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2203401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3042"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2203401],"talks":[{"talkId":2203401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2203401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2203401,"initDialog":220340101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3042],"performCfg":"","priority":5,"questId":22034,"showRandomTalkCount":0},"dialogs":[{"nodeId":220340101,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":1543674634,"text":"Traveler, please wait. Sango would like your help.","nextNodeIds":[220340102]},{"nodeId":220340102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2758714018,"text":"Making progress with the case?","nextNodeIds":[220340103]},{"nodeId":220340103,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2167835930,"text":"She didn't tell me. She just said that she still needed to make some preparations.","nextNodeIds":[220340104]},{"nodeId":220340104,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":67162394,"text":"She also told me to wait for you and ask if you would perform a search in the wilds together with me.","nextNodeIds":[220340105,220340107]},{"nodeId":220340105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":656376554,"text":"What does she intend to accomplish?","nextNodeIds":[220340106]},{"nodeId":220340106,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3872193106,"text":"Well... to be honest, I have no clue either. But if we do what Sango tells us to, we can usually solve the case.","nextNodeIds":[220340112]},{"nodeId":220340112,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2637112666,"text":"Well. On that note, let's talk business.","nextNodeIds":[220340113]},{"nodeId":220340113,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3611668802,"text":"According to Sango, the patrol in the city has indeed been reinforced ever since Amano and Andou reported that incident.","nextNodeIds":[220340114]},{"nodeId":220340114,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":873431162,"text":"But strangely enough, the merchants in the city are still becoming victims of theft. And the perpetrators' intention is very clear. They aren't interested in anything else other than some targeted items.","nextNodeIds":[220340115]},{"nodeId":220340115,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":238600498,"text":"Here is the situation. Sango believes that the probability of the Treasure Hoarders sneaking into town to perform these crimes is very low.","nextNodeIds":[220340116]},{"nodeId":220340116,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":1266655090,"text":"The suspect... or suspects, have a clear objective.","nextNodeIds":[220340117]},{"nodeId":220340117,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":331746946,"text":"It's very likely that there has been a mole inside the city this whole time, passing off information to people outside the city.","nextNodeIds":[220340118]},{"nodeId":220340118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1461894002,"text":"Doesn't that mean the Doushins' actions are futile?","nextNodeIds":[220340119]},{"nodeId":220340119,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2868853082,"text":"Not at all. It's exactly what we want. Because our culprit seems to have realized that he is not the target of the Doushin yet, he will continue committing crimes.","nextNodeIds":[220340120]},{"nodeId":220340120,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":1804918858,"text":"The more crimes he commits, the easier it is for him to give himself away, and greater the chance for Sango to figure out who he really is.","nextNodeIds":[220340121]},{"nodeId":220340121,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":636800890,"text":"Therefore, we still need to keep putting on a show so that our thief will let his guard down.","nextNodeIds":[220340122]},{"nodeId":220340122,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3931654610,"text":"Traveler, that's why I am here asking you to come with me and look for some trouble with those Treasure Hoarders in the wilderness.","nextNodeIds":[220340123]},{"nodeId":220340123,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3426557242,"text":"Of course, there will be payment. Also... when this case is over, there will be an additional gift for you.","nextNodeIds":[220340124]},{"nodeId":220340124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3963788938,"text":"Did Sango ask you to say this stuff too?","nextNodeIds":[220340125]},{"nodeId":220340125,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2735213770,"text":"Hmm... you sensed that? You have quite a sharp intuition...","nextNodeIds":[220340126]},{"nodeId":220340126,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3584498474,"text":"It was indeed Sango who told me to persuade you with these words.","nextNodeIds":[220340127]},{"nodeId":220340127,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2783803474,"text":"But please believe me when I say that I am not lying. I am certainly carrying your payment with me, at least.","nextNodeIds":[220340128]},{"nodeId":220340128,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":178900818,"text":"Therefore, please help us out, Traveler.","nextNodeIds":[220340129]},{"nodeId":220340129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3353307394,"text":"What exactly do you need me to do?","nextNodeIds":[220340130]},{"nodeId":220340130,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3881586282,"text":"It's easy. We just need... to mess with those Treasure Hoarders in the wilderness. The bigger the fracas, the better.","nextNodeIds":[220340131]},{"nodeId":220340131,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":699086986,"text":"Sango has already marked the locations of some Treasure Hoarder camps. I have also marked them on the map for you.","nextNodeIds":[220340132]},{"nodeId":220340132,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":956441746,"text":"Alright, we will rendezvous at this place afterward. Let's get a move on now.","nextNodeIds":[]},{"nodeId":220340107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4102491114,"text":"Why didn't she come along?","nextNodeIds":[220340108]},{"nodeId":220340108,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":1780259562,"text":"It's her habit, really. She said that she... \"is good at thinking, but less so at doing.\"","nextNodeIds":[220340109]},{"nodeId":220340109,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":282447642,"text":"A while ago, a novelist came to interview her, wanting to turn her story into a novel.","nextNodeIds":[220340110]},{"nodeId":220340110,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3881860634,"text":"He even referred to Sango as an \"armchair detective.\" She seems to have taken a liking to this nickname, and has been thinking of buying an armchair since.","nextNodeIds":[220340111]},{"nodeId":220340111,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":466529202,"text":"But because of funding issues, we can't really get an armchair yet.","nextNodeIds":[220340112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2203401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1","1","4"],"PAINLIBBLDK":"QUEST_EXEC_RANDOM_QUEST_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUI