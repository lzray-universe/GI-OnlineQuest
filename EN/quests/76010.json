"","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7601002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7601002,"initDialog":760100201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21840],"performCfg":"QuestDialogue/WQ/NodKrai_76010/Q7601002","priority":5,"questId":76010,"showRandomTalkCount":0},"dialogs":[{"nodeId":760100201,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":1371421434,"text":"Twenty-five... twenty-six...","nextNodeIds":[760100202]},{"nodeId":760100202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3907327362,"text":"Hmm? What are you counting?","nextNodeIds":[760100203]},{"nodeId":760100203,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":3914785162,"text":"Shhh! Keep it down... Ah, forget it. Not like I was gonna catch anything anyway.","nextNodeIds":[760100204]},{"nodeId":760100204,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":3203293298,"text":"Come on, kid, isn't it obvious? I'm timing my cast. What, did you think I was waving this rod around to cast spells or something?","nextNodeIds":[760100205,760100207]},{"nodeId":760100205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":432053714,"text":"Well... you are a member of the Frostmoon Scions, so maybe it's not that far off base...","nextNodeIds":[760100206]},{"nodeId":760100206,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":2547742770,"text":"#Haha, you're giving me too much credit, {M#young man}{F#young lady}. I'm barely half a Frostmoon Scion. Not even an acolyte. Just a regular guy with no kuuvahki power to speak of.","nextNodeIds":[760100210]},{"nodeId":760100210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3985972082,"text":"Anyway, this is the first time Paimon's seen someone time their fishing down to the second...","nextNodeIds":[760100211]},{"nodeId":760100211,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":123261322,"text":"Well, what matters is your fishing technique, not how long you stand on the shore. Old Ilmari never got that — no wonder he never caught anything.","nextNodeIds":[760100212]},{"nodeId":760100212,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":2794560986,"text":"Hmm? So I take it you two must be treasure hunters?","nextNodeIds":[760100213]},{"nodeId":760100213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3430141674,"text":"No, we're adventurers... But we do take on work. Do you need something?","nextNodeIds":[760100214]},{"nodeId":760100214,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":2859432194,"text":"Pretty much. As long as you're up for getting paid to do a job, who you are is all the same to me. I've got something you could help with — if you've got time.","nextNodeIds":[760100215]},{"nodeId":760100215,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":1111647194,"text":"You see, I'm the best angler on Hiisi Island by a long shot. No one, not even successive generations of Moonchanters, could surpass me in fishing...","nextNodeIds":[760100216]},{"nodeId":760100216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1088807554,"text":"Really? That's amazing... Wait, that doesn't mean anything! Fishing isn't even part of a Moonchanter's job!","nextNodeIds":[760100217]},{"nodeId":760100217,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":1001698490,"text":"Still, even with all this skill, I haven't caught a single fish lately. Makes no sense, right?","nextNodeIds":[760100218]},{"nodeId":760100218,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":3037905346,"text":"So obviously, the problem isn't with me, but with the environment. Just as it is with the cursed Eye of Kratti, there must be something underwater affecting the fish.","nextNodeIds":[760100219]},{"nodeId":760100219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2603941146,"text":"Seems like quite the leap in logic...","nextNodeIds":[760100220]},{"nodeId":760100220,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":4292642370,"text":"Anyway, I was hoping you two could check the nearby waters, see what's scaring the fish off. Don't worry, you'll be properly compensated for your efforts.","nextNodeIds":[760100221]},{"nodeId":760100221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4034220466,"text":"Well, since there's a reward involved, we'll take a look around... but no promises we'll actually find anything weird, okay?","nextNodeIds":[]},{"nodeId":760100207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":379773674,"text":"Maybe you're catching a bestest travel companion... Who knows?","nextNodeIds":[760100208]},{"nodeId":760100208,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"Pekkani","textMapHash":3031117746,"text":"Huh...?","nextNodeIds":[760100209]},{"nodeId":760100209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1473956978,"text":"Hey! Don't make it sound like anyone can fish up their bestest travel companion with a casual cast! Wait... That's not even the point here!","nextNodeIds":[760100210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7601002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21840"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7601003,"order":3,"stepDescription":"Investigate nearby disturbances","stepDescTextMapHash":373549300,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7601003"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_11119:18