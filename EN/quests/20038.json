{"mainQuestId":20038,"title":"Grateful to the Gods","description":"Jilliana is looking for someone to clean the Statues of The Seven, since she hasn't had time lately...","titleTextMapHash":1938420777,"descTextMapHash":272883863,"mainQuestExcel":{"mainQuestId":20038,"titleTextMapHash":1938420777,"title":"Grateful to the Gods","descTextMapHash":272883863,"description":"Jilliana is looking for someone to clean the Statues of The Seven, since she hasn't had time lately...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ20038","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":272883863,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":20038,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2150204719,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ20038","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":20900,"titleTextMapHash":1938420777,"type":"IQ","unlockDescTextMapHash":3769825483}},"flow":[{"subQuestId":2003801,"order":1,"stepDescription":"Talk to Jilliana","stepDescTextMapHash":1585747584,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1473"],"NOCCOBOFKHP":1008,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2003801],"talks":[{"talkId":2003801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2003801","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2003801,"initDialog":200380101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1473],"performCfg":"","priority":6,"questId":20038,"showRandomTalkCount":0},"dialogs":[{"nodeId":200380101,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":84244897,"text":"*sigh* I wonder what state the Statues of The Seven must be in by now...","nextNodeIds":[200380102]},{"nodeId":200380102,"roleType":"TALK_ROLE_PLAYER","speakerId":1473,"speakerName":"Traveler","textMapHash":1958686825,"text":"The Statues of The Seven? What's happened to them?","nextNodeIds":[200380103]},{"nodeId":200380103,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":4114449929,"text":"Let me explain... In the past, I would go and pray to a Statue of The Seven every week, and while I was there I would wipe the dust off.","nextNodeIds":[200380104]},{"nodeId":200380104,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":1032584729,"text":"I have the archons to thank for all the blessings in my life — cleaning their statues was my way of giving something back.","nextNodeIds":[200380105]},{"nodeId":200380105,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":3404140241,"text":"But since having Lily, I rarely have the chance to go out.","nextNodeIds":[200380106]},{"nodeId":200380106,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":331367489,"text":"The statues must be filthy with no one cleaning them in so long.","nextNodeIds":[200380107]},{"nodeId":200380107,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":2004544961,"text":"I know this must seem like I'm trying to avoid taking responsibility, but... Do you think you could go and wipe the dust off of the Statues of The Seven for me?","nextNodeIds":[200380109,200380110]},{"nodeId":200380109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2789702545,"text":"Of course!","nextNodeIds":[200380111]},{"nodeId":200380111,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":4062264825,"text":"Thank you ever so much! May the Anemo Archon protect you.","nextNodeIds":[200380115]},{"nodeId":200380115,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":4109960601,"text":"One more thing. The Statues of The Seven are imbued with the power of the archons.","nextNodeIds":[200380116]},{"nodeId":200380116,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":1865831449,"text":"The dust they collect cannot be simply wiped off in the usual manner.","nextNodeIds":[200380117]},{"nodeId":200380117,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":3923771745,"text":"But you have elemental abilities. It should be easy for you.","nextNodeIds":[200380118]},{"nodeId":200380118,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":211037817,"text":"Unlike me — it's a whole day's work for me to clean a single statue.","nextNodeIds":[]},{"nodeId":200380110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":887416193,"text":"Surely the wind would just blow it off?","nextNodeIds":[200380112]},{"nodeId":200380112,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":328765641,"text":"Barbatos and the winds he commands have far too many other things to attend to day-to-day.","nextNodeIds":[200380113]},{"nodeId":200380113,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":2639914337,"text":"In any case, we mustn't rely on the archons to provide for everything while we laze around.","nextNodeIds":[200380114]},{"nodeId":200380114,"roleType":"TALK_ROLE_NPC","speakerId":1473,"speakerName":"Jilliana","textMapHash":1984085985,"text":"Let us work together to lighten our Lord Barbatos' load just a little.","nextNodeIds":[200380115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1473"],"NOCCOBOFKHP":1008,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2003802,"order":2,"stepDescription":"Clean the Statue of The Seven at Starfell Lake","stepDescTextMapHash":421539720,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003802,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PP