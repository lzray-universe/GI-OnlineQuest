"],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7224905","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7224903,"initDialog":722490301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20357,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72249/Q7224903","priority":5,"questId":72249,"showRandomTalkCount":0},"dialogs":[{"nodeId":722490301,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":1791355378,"text":"My name is...","nextNodeIds":[722490302]},{"nodeId":722490302,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":4280038226,"text":"Aberaku, Helios-Forger!","nextNodeIds":[722490303]},{"nodeId":722490303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2876319850,"text":"Um, what's the Helios?","nextNodeIds":[722490304]},{"nodeId":722490304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1144783274,"text":"Is it something very impressive?","nextNodeIds":[722490305]},{"nodeId":722490305,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":266863234,"text":"Verily! T'was I who organized the building of the Helios with the might of an entire nation behind me, that we might resist the Dragonheirs of the Depths.","nextNodeIds":[722490306]},{"nodeId":722490306,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":2403314674,"text":"This unsurpassed deed could have been done by no other in Byakuyakoku — none save I!","nextNodeIds":[722490307]},{"nodeId":722490307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3387888970,"text":"Huh. Guess that is pretty impressive.","nextNodeIds":[722490308]},{"nodeId":722490308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2705405466,"text":"But why would such a great person be sealed in here?","nextNodeIds":[722490309]},{"nodeId":722490309,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":3004618802,"text":"I... I was betrayed...","nextNodeIds":[722490310]},{"nodeId":722490310,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":2288657954,"text":"When the sky kingdom crashed into the bottomless depths, the people were scourged by dragons, and thus did I — yes, 'twas I — begin building the Helios to save us all from our fate.","nextNodeIds":[722490311]},{"nodeId":722490311,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":1667389042,"text":"But... those ravening rogues! The moment their lives were no longer in danger, they began to deceive and lie. They even advocated placing mere infants on the throne. Laughable!","nextNodeIds":[722490312]},{"nodeId":722490312,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":2415996994,"text":"Even I became the target of their schemes, and was left in jail to rot!","nextNodeIds":[722490313]},{"nodeId":722490313,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":248324858,"text":"A pox! A pox upon them all!","nextNodeIds":[722490314]},{"nodeId":722490314,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":1197919962,"text":"...Right. You.","nextNodeIds":[722490315,722490317]},{"nodeId":722490315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":239814354,"text":"Me?","nextNodeIds":[722490316]},{"nodeId":722490316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1130583322,"text":"Yup, that's you!","nextNodeIds":[722490320]},{"nodeId":722490320,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":150755370,"text":"It can only be you!","nextNodeIds":[722490321]},{"nodeId":722490321,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":2479471986,"text":"My sacred robes were once placed here, but they have all but rotted away in the passing of years, and can no longer be relied upon.","nextNodeIds":[722490322]},{"nodeId":722490322,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":798312978,"text":"But if you can pass the test, then I shall hand the offerings, into which I have nested my thoughts, unto you.","nextNodeIds":[722490323]},{"nodeId":722490323,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":1949355506,"text":"I pray for your... success...","nextNodeIds":[722490324]},{"nodeId":722490324,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":1274947890,"text":"This matter is perilous. Tell me once you are ready, O Traveler, and we shall begin.","nextNodeIds":[]},{"nodeId":722490317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3007141706,"text":"Paimon, I think he's talking to you.","nextNodeIds":[722490318]},{"nodeId":722490318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3651636362,"text":"Nah, he's clearly looking at you.","nextNodeIds":[722490319]},{"nodeId":722490319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":480250202,"text":"(With a very heated look in his eyes, too.)","nextNodeIds":[722490320]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7224903,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7224902,"order":3,"stepDescription":"Activate the spirit's trial","stepDescTextMapHash":2226889508,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7224905,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20357","11","2"],"NOCCOBOFKHP":5,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_SHOW_OR_HIDE_NPC"},"isHidden":false,"talkIds":[7224901,7224905,7224906],"talks":[{"talkId":7224901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"