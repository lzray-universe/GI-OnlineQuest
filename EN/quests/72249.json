LE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":848499402,"text":"Take them to the place of enshrining... enjoin the parts of my soul, in order to...","nextNodeIds":[722490208]},{"nodeId":722490208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":871440362,"text":"Hello, Mr. Spirit?","nextNodeIds":[722490209]},{"nodeId":722490209,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":4124340818,"text":"In order to... In order to...","nextNodeIds":[722490210]},{"nodeId":722490210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2115342066,"text":"In order to do what again?","nextNodeIds":[722490211]},{"nodeId":722490211,"roleType":"TALK_ROLE_NPC","speakerId":20357,"speakerName":"Aberaku","textMapHash":698012026,"text":"In order to...","nextNodeIds":[722490212]},{"nodeId":722490212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2871697354,"text":"Ugh, this guy isn't making himself clear at all! But it seems we're supposed to take these offerings somewhere — Paimon got that much.","nextNodeIds":[722490213]},{"nodeId":722490213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1588934794,"text":"These offerings have been here for so long. Who knows if there's anything edible here.","nextNodeIds":[722490214]},{"nodeId":722490214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4214282738,"text":"Best not to eat them all the same.","nextNodeIds":[722490215]},{"nodeId":722490215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3467022250,"text":"H—Hey! Paimon doesn't just eat anything, alright?","nextNodeIds":[722490216]},{"nodeId":722490216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1839379090,"text":"#Well, let's take the offerings with us anyway, {NICKNAME}.","nextNodeIds":[]}]}],"conditions":{"