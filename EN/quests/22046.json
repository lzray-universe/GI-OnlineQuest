uestId":22046,"showRandomTalkCount":0},"dialogs":[{"nodeId":220460101,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3088737658,"text":"The shrine is getting messy again...","nextNodeIds":[220460102]},{"nodeId":220460102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2464410746,"text":"What's wrong?","nextNodeIds":[220460103]},{"nodeId":220460103,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":312943258,"text":"Meow, it is you again. Well met.","nextNodeIds":[220460104]},{"nodeId":220460104,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1764639482,"text":"After a little neglect, the shrine's surroundings have started to collect dirt.","nextNodeIds":[220460105]},{"nodeId":220460105,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3721429074,"text":"This is no way to greet those humans coming to pay their respects.","nextNodeIds":[220460106]},{"nodeId":220460106,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":4150759002,"text":"Could you aid me in cleaning up the shrine, as you did before?","nextNodeIds":[220460107,220460112]},{"nodeId":220460107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3729624586,"text":"Don't you have Taisuke and Etsuko around?","nextNodeIds":[220460108]},{"nodeId":220460108,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":4085850634,"text":"I... will not speak to those two green humans of my own accord.","nextNodeIds":[220460109]},{"nodeId":220460109,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1575044162,"text":"The tall human always looks upon me with a strange gaze...","nextNodeIds":[220460110]},{"nodeId":220460110,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2144223002,"text":"And the other green human never seems particularly... motivated?","nextNodeIds":[220460111]},{"nodeId":220460111,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3532544866,"text":"Meow meow, regardless, they are not reliable humans.","nextNodeIds":[220460115]},{"nodeId":220460115,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2275254658,"text":"Whatever the case, I can only rely on you for this task. Just use the long stick and the water to clean up.","nextNodeIds":[220460116,220460117]},{"nodeId":220460116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4117935330,"text":"I've got it.","nextNodeIds":[220460118]},{"nodeId":220460118,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2599575410,"text":"Whatever the case, I shall leave this to you. I...","nextNodeIds":[220460119]},{"nodeId":220460119,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":76970306,"text":"I will wait for you here, meow meow.","nextNodeIds":[]},{"nodeId":220460117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":230246410,"text":"I got you, more or less.","nextNodeIds":[220460118]},{"nodeId":220460112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3457984050,"text":"Well, you could ask Mr. Ooshima...","nextNodeIds":[220460113]},{"nodeId":220460113,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":800982066,"text":"The stone human is always busy with his knock-knock-knocking. Who knows what he is doing.","nextNodeIds":[220460114]},{"nodeId":220460114,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2513844610,"text":"The stone was knocked, after all. What is he knocking this time, I wonder... How annoying...","nextNodeIds":[220460115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2204601,0],"PAINLIBBLDK":"QUEST_CONTENT_COM