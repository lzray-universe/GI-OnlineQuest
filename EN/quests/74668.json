CCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7466801],"talks":[{"talkId":7466801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7466801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7466801,"initDialog":746680101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"","priority":5,"questId":74668,"showRandomTalkCount":0},"dialogs":[{"nodeId":746680101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1493700050,"text":"Eh? Did light just start flooding from that Statue of The Seven just now...?","nextNodeIds":[746680102]},{"nodeId":746680102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":125560154,"text":"That's so weird! Did anything like this ever happen before?","nextNodeIds":[746680103,746680105]},{"nodeId":746680103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2075154338,"text":"It's normal for a Statue of The Seven to glow.","nextNodeIds":[746680107]},{"nodeId":746680107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":802923466,"text":"#{NICKNAME}, you didn't feel uncomfortable at all?","nextNodeIds":[746680108,746680110]},{"nodeId":746680108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2071583290,"text":"Huh? Water... the water is speaking to me...","nextNodeIds":[746680109]},{"nodeId":746680109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":223829522,"text":"Like Paimon's gonna believe you! If you can crack jokes like that, you must be fine.","nextNodeIds":[746680112]},{"nodeId":746680112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3318021986,"text":"Though, after it lit up like that, the air does feel a lot more humid. Maybe it's because of all that Hydro energy that was released?","nextNodeIds":[746680113]},{"nodeId":746680113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2960864778,"text":"Hehe, Paimon heard that in Fontaine, if you can use Elemental Energy properly, you can even swim underwater! Maybe you can even find sunken treasure!","nextNodeIds":[746680114]},{"nodeId":746680114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1864177794,"text":"Paimon'll leave diving for treasure to you. Paimon will... stand on the shore and wait for you!","nextNodeIds":[746680115,746680116]},{"nodeId":746680115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1431892194,"text":"It'll be lonely, going underwater alone...","nextNodeIds":[746680117]},{"nodeId":746680117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":633047922,"text":"Waaah! But... but... being in the water is scary!","nextNodeIds":[746680118]},{"nodeId":746680118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4248768594,"text":"What if Paimon accidentally gets swept in a current and gets all turned around and dizzy, and then she won't be able to fly away no matter what...","nextNodeIds":[746680119]},{"nodeId":746680119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2784455690,"text":"Just like before Paimon met you, back in Mondstadt...","nextNodeIds":[746680120]},{"nodeId":746680120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":276643378,"text":"Then I'll fish you out again!","nextNodeIds":[746680121]},{"nodeId":746680121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1648194322,"text":"...Really? Th—Then maybe Paimon can try going underwater with you. Hmph! You'd better not go back on your word!","nextNodeIds":[]},{"nodeId":746680116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":129135818,"text":"You could try doing something for once, Paimon.","nextNodeIds":[746680117]},{"nodeId":746680110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4021895186,"text":"Wow, I feel like I'm using gills to breathe...","nextNodeIds":[746680111]},{"nodeId":746680111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3547489938,"text":"Good for you! First try growing a pair of gills and show Paimon! Hmph! Seems like you're feeling pretty good! Paimon can't believe Paimon was actually worried about you for a moment there...","nextNodeIds":[746680112]},{"nodeId":746680105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":959455762,"text":"A rush of water?","nextNodeIds":[746680106]},{"nodeId":746680106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2027074930,"text":"It certainly is the nation of the Hydro Archon! Even the Statues of The Seven are water fountains... YEAH RIGHT! That light wasn't normal at all!","nextNodeIds":[746680107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7466801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7466801,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1"],"PAINLIBBLDK":"QUEST_EXEC_SET_IS_DIVEABLE"},{"LNHLPKELCAL":["7466801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3538026482,"text":"No no no! The way it shone was definitely not normal at all! Hmm... it was like at the same time as there was a flash of brightness, there was also a rush of water, and it felt like something cold got stuck to Paimon..."}],"talkIds":[7466801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC