"",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4121402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":4121401,"initDialog":412140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1018],"performCfg":"QuestDialogue/EQ/Dragonspine1_41214/Q4121401","priority":0,"questId":41214,"showRandomTalkCount":0},"dialogs":[{"nodeId":412140101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":516676074,"text":"We're back! It's us again!","nextNodeIds":[412140102]},{"nodeId":412140102,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4159532754,"text":"Traveler, Paimon, welcome back.","nextNodeIds":[412140103]},{"nodeId":412140103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4186621170,"text":"Paimon's already used to meeting Albedo like that.","nextNodeIds":[412140104,412140105]},{"nodeId":412140104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1705479650,"text":"I've fulfilled your request.","nextNodeIds":[412140106]},{"nodeId":412140106,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3416516682,"text":"Thank you so much. I knew I could count on you.","nextNodeIds":[412140107]},{"nodeId":412140107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3793627746,"text":"Count on me to help you?","nextNodeIds":[412140108]},{"nodeId":412140108,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3860468330,"text":"Naturally, you were crucial to my research.","nextNodeIds":[412140109]},{"nodeId":412140109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3453769562,"text":"Ehehe, glad to hear that~","nextNodeIds":[412140110]},{"nodeId":412140110,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":605182810,"text":"I'll never forget your kindness.","nextNodeIds":[412140111]},{"nodeId":412140111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1020517194,"text":"Now you can take the sword back.","nextNodeIds":[412140112]},{"nodeId":412140112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3342793938,"text":"Should be powerful enough, right?","nextNodeIds":[412140113]},{"nodeId":412140113,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":855934906,"text":"More or less... but tell me... How do you feel?","nextNodeIds":[412140114]},{"nodeId":412140114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":655712218,"text":"Same old.","nextNodeIds":[412140115]},{"nodeId":412140115,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4243690994,"text":"Good. There's no side effects, no corruption or poison.","nextNodeIds":[412140116]},{"nodeId":412140116,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":478343274,"text":"Looks like... I've been correct all along.","nextNodeIds":[412140117]},{"nodeId":412140117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":704929594,"text":"This guy, pretending to be a prophet!","nextNodeIds":[412140118]},{"nodeId":412140118,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3599493762,"text":"How do you like the sword?","nextNodeIds":[412140119,412140120]},{"nodeId":412140119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2336202138,"text":"It's a nice weapon.","nextNodeIds":[412140121]},{"nodeId":412140121,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2094926778,"text":"Is that so? Regardless, it's reached the desired state.","nextNodeIds":[412140122]},{"nodeId":412140122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3830145098,"text":"Why are you holding the sword? Albedo, what're you trying to do? Don't mess around!","nextNodeIds":[412140123]},{"nodeId":412140123,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4187724906,"text":"I want to extract the purified life force from within it.","nextNodeIds":[412140124]},{"nodeId":412140124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3425919026,"text":"Can this force exist outside of the sword?","nextNodeIds":[412140125]},{"nodeId":412140125,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1372258874,"text":"What's impossible for some... might be just within my reach.","nextNodeIds":[412140126]},{"nodeId":412140126,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":45101994,"text":"...All done.","nextNodeIds":[412140127]},{"nodeId":412140127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2288410922,"text":"Wow, this energy looks like a ball of light...","nextNodeIds":[412140128]},{"nodeId":412140128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1773221730,"text":"Ah! You put it into a mysterious bottle!","nextNodeIds":[412140129]},{"nodeId":412140129,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3681001778,"text":"This sword might not be a divine weapon...","nextNodeIds":[412140130]},{"nodeId":412140130,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":807408154,"text":"...But it'll make a fine memento. I hope it can be of some help during your travels.","nextNodeIds":[412140131,412140132]},{"nodeId":412140131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2648804106,"text":"Really?","nextNodeIds":[412140133]},{"nodeId":412140133,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1336790458,"text":"I needed it for the sake of my research. I've already obtained the results of the experiment. This sword belongs to you, a person who knows how to use it.","nextNodeIds":[412140134]},{"nodeId":412140134,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":142363218,"text":"Thank you for your assistance with completing this research. Well then, goodbye.","nextNodeIds":[412140135]},{"nodeId":412140135,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3826471138,"text":"This dragon's life force resonates with me...","nextNodeIds":[412140136]},{"nodeId":412140136,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3147286146,"text":"Not because it's a dragon, but because I am... me.","nextNodeIds":[412140137]},{"nodeId":412140137,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":617100506,"text":"Rhinedottir... Master... Is this your creation, the giant dragon Durin?","nextNodeIds":[412140138]},{"nodeId":412140138,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2569490474,"text":"...","nextNodeIds":[412140139]},{"nodeId":412140139,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2091507106,"text":"Was the two of us meeting really a good thing?","nextNodeIds":[]},{"nodeId":412140132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1984365562,"text":"You don't need it anymore?","nextNodeIds":[412140133]},{"nodeId":412140120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1508958746,"text":"It's no good.","nextNodeIds":[412140121]},{"nodeId":412140105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2496130514,"text":"I've done what you wanted, as promised.","nextNodeIds":[412140106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4121401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133008300"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133008305"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1018"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4121403,"order":3,"stepDescription":"","stepDescTextMapHash":757830900,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4121403,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGP