""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4020702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4020702,"initDialog":402070201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1312],"performCfg":"QuestDialogue/EQ/V6.0ActivityNodKraiTour_40207/Q4020702","priority":5,"questId":40207,"showRandomTalkCount":0},"dialogs":[{"nodeId":402070201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1528357106,"text":"Hey, Ineffa! Oh, Jahoda! You're here, too?","nextNodeIds":[402070202]},{"nodeId":402070202,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3906912994,"text":"Well, after all that hard work, I at least deserve a slice of cake for my efforts, don't you think?","nextNodeIds":[402070203]},{"nodeId":402070203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":367718010,"text":"Wait, there's cake!?","nextNodeIds":[402070204]},{"nodeId":402070204,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3031074578,"text":"Yes. You two are here just in time.","nextNodeIds":[402070205]},{"nodeId":402070205,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":4215006890,"text":"Aino wanted to thank you for your help, so now that Krum-Clank is back safe and sound, she thought it would be nice for everyone to try out his baking.","nextNodeIds":[402070206]},{"nodeId":402070206,"roleType":"TALK_ROLE_NPC","speakerId":15535,"speakerName":"Krum-Clank 70% Sweet","textMapHash":3145259514,"text":"Clank... clank...","nextNodeIds":[402070207]},{"nodeId":402070207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3882807786,"text":"Wow, so this is what Krum-Clank was supposed to look like!","nextNodeIds":[402070208]},{"nodeId":402070208,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1480208170,"text":"Yes. Luckily, the core was still intact, so all Aino had to do was make a new body.","nextNodeIds":[402070209]},{"nodeId":402070209,"roleType":"TALK_ROLE_NPC","speakerId":15535,"speakerName":"Krum-Clank 70% Sweet","textMapHash":2036823506,"text":"Clank... clank...","nextNodeIds":[402070210]},{"nodeId":402070210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1159063370,"text":"Ooh, is it ready?","nextNodeIds":[402070211]},{"nodeId":402070211,"roleType":"TALK_ROLE_NPC","speakerId":15535,"speakerName":"Krum-Clank 70% Sweet","textMapHash":3622329050,"text":"Gulp...","nextNodeIds":[402070212]},{"nodeId":402070212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4058725138,"text":"Hey, he ate it!","nextNodeIds":[402070213]},{"nodeId":402070213,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3601534802,"text":"It's not unusual for a chef to take a few bites before serving a dish.","nextNodeIds":[402070214]},{"nodeId":402070214,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1911166650,"text":"No need to worry. Once he's had his fill, he can get started on the desserts for everyone else. It'll just be a moment.","nextNodeIds":[402070215]},{"nodeId":402070215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":120725938,"text":"Alright... Wait, speaking of desserts, where's Aino?","nextNodeIds":[402070216]},{"nodeId":402070216,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2633803658,"text":"Ah, she thought of a new idea for a robot and shut herself in the workshop to get started. When inspiration strikes, she jumps into action. That's just who she is.","nextNodeIds":[402070217]},{"nodeId":402070217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3183646386,"text":"Why does Aino like building robots so much?","nextNodeIds":[402070218]},{"nodeId":402070218,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1329097002,"text":"Hm... Retrieving historical records from data bank...","nextNodeIds":[402070219]},{"nodeId":402070219,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3369282138,"text":"At first, I believe Aino was just shocked to find something that fascinated her more than desserts.","nextNodeIds":[402070220]},{"nodeId":402070220,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1919602722,"text":"And fortunately, her friends respected her passion — even if, aside from struggling to make ends meet, there was little time for much else.","nextNodeIds":[402070221]},{"nodeId":402070221,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2493496258,"text":"Then, one day, an acclaimed teacher discovered her and recognized her passion for what it truly was... genius.","nextNodeIds":[402070222]},{"nodeId":402070222,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1803043114,"text":"Just like her friends, she finally discovered what she wanted to do. And not only that, she excelled at it.","nextNodeIds":[402070223]},{"nodeId":402070223,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3213142402,"text":"And when genius and passion collide, there's not much that can get in the way.","nextNodeIds":[402070224]},{"nodeId":402070224,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2590310154,"text":"So, Aino left her childhood friends, established the Clink-Clank Krumkake Craftshop, and started making all kinds of robot companions.","nextNodeIds":[402070225]},{"nodeId":402070225,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2385336018,"text":"Perhaps it all comes down to the natural instinct of a genius... the drive to see their imagination come to life.","nextNodeIds":[402070226]},{"nodeId":402070226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1564999666,"text":"Oh... So that's what draws her to robotics?","nextNodeIds":[402070227]},{"nodeId":402070227,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":365005082,"text":"Based on my own experience with Aino, I think there's more to it than that.","nextNodeIds":[402070228]},{"nodeId":402070228,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":300498330,"text":"Long before she took me in, she was already pushing her skills to the limit in an effort to give each robot a distinct personality, and she already treated them like companions.","nextNodeIds":[402070229]},{"nodeId":402070229,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":972649722,"text":"What I mean is, it's not something that started with me, just because I have a unique background.","nextNodeIds":[402070230]},{"nodeId":402070230,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2488019882,"text":"I think, after walking the path of a genius for so long, she looked around and realized there was no one at her side, and it made her feel lonely.","nextNodeIds":[402070231]},{"nodeId":402070231,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1957016658,"text":"So, me, Krum-Clank, and all the other robots Aino has added to the workshop... We're not just proof of her genius.","nextNodeIds":[402070232]},{"nodeId":402070232,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":981533994,"text":"We're her family. We give her the companionship she longs for.","nextNodeIds":[402070233]},{"nodeId":402070233,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":4192680866,"text":"As I see it, that's the true relationship between Aino and her robots.","nextNodeIds":[402070234]},{"nodeId":402070234,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1120779466,"text":"Oh, wow. So, you really mean a lot to her...","nextNodeIds":[402070235]},{"nodeId":402070235,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3714612674,"text":"Yes. And for that reason, it did not matter to Aino how powerful Krum-Clank could become, nor how feared or coveted his technology might be among the factions.","nextNodeIds":[402070236]},{"nodeId":402070236,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":960840306,"text":"And she decided that he would join this family, and that meant she would spare no effort to save him.","nextNodeIds":[402070237]},{"nodeId":402070237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1289302626,"text":"Yeah, that makes sense! But, it makes Paimon wonder why someone like Aino would choose to stay in Nod-Krai...","nextNodeIds":[402070238]},{"nodeId":402070238,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":4133463570,"text":"...I'm afraid my logic unit cannot make sense of that question.","nextNodeIds":[402070239]},{"nodeId":402070239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3915248034,"text":"Well, the way Paimon sees it, Nod-Krai is a dog-eat-dog place full of scheming and scamming. The people that thrive here seem to be built for that kind of thing.","nextNodeIds":[402070240]},{"nodeId":402070240,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1215723330,"text":"Anyone else would use the kind of tech Aino has to make weapons and threaten people.","nextNodeIds":[402070241]},{"nodeId":402070241,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":376379282,"text":"But Aino... she takes something that could be a weapon and turns it into a robot that makes cakes. It just doesn't seem like she fits in...","nextNodeIds":[402070242]},{"nodeId":402070242,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":4019062450,"text":"No, my view is the exact opposite.","nextNodeIds":[402070243]},{"nodeId":402070243,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2391590986,"text":"I've encountered the full spectrum of people that live here in Nod-Krai. But, in my experience, very few of them can be said to represent this place.","nextNodeIds":[402070244]},{"nodeId":402070244,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3542244386,"text":"You say Aino doesn't fit in here, but I believe the opposite. If I were to attempt to define what a person from Nod-Krai should be... no one is a better match than Aino.","nextNodeIds":[402070245]},{"nodeId":402070245,"roleType":"TALK_ROLE_NPC","speakerId":15535,"speakerName":"Krum-Clank 70% Sweet","textMapHash":3260884978,"text":"Ding... Ding...","nextNodeIds":[402070246]},{"nodeId":402070246,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1288512338,"text":"Ooh, the desserts should be done!","nextNodeIds":[402070247]},{"nodeId":402070247,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2483561730,"text":"Yes. One moment. Allow me to serve them.","nextNodeIds":[402070248]},{"nodeId":402070248,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":2452763066,"text":"I want the one with the most frosting!","nextNodeIds":[402070249]},{"nodeId":402070249,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":32457730,"text":"Alright, everyone. Dig in.","nextNodeIds":[402070250]},{"nodeId":402070250,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1726898458,"text":"...Mmm! So worth it!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4020702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133607179","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["4020701","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1312"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4020702],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","count":28},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":14},{