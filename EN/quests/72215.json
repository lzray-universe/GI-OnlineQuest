d":[3189],"performCfg":"","priority":5,"questId":72215,"showRandomTalkCount":0},"dialogs":[{"nodeId":722150101,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2760057466,"text":"Meow meow, when did that stone become the spitting image of me...","nextNodeIds":[722150102]},{"nodeId":722150102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4030925170,"text":"How's the statue?","nextNodeIds":[722150103]},{"nodeId":722150103,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1346972402,"text":"The stone human says that he will finish knocking on this stone soon.","nextNodeIds":[722150104]},{"nodeId":722150104,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":867552762,"text":"Hibiki will be so happy when she returns.","nextNodeIds":[722150105]},{"nodeId":722150105,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":619525738,"text":"Hmm, yes. This stone is good, but we must dress the shrine's surroundings up a bit, yes?","nextNodeIds":[722150106]},{"nodeId":722150106,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3411177850,"text":"Please, help me hang these round, tinkling metal balls around the shrine.","nextNodeIds":[722150107]},{"nodeId":722150107,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":187567394,"text":"These things were prepared by Hibiki. If memory serves, Domeki gave them to her because she loved playing with me and other children. It took quite a lot of effort to find them again.","nextNodeIds":[722150108]},{"nodeId":722150108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1864977530,"text":"Huh. These are... bells?","nextNodeIds":[722150109]},{"nodeId":722150109,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2231353410,"text":"\"Bells?\" I am not sure what those are, but Hibiki used to use these metal balls when playing with me.","nextNodeIds":[722150110]},{"nodeId":722150110,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3973785698,"text":"She would put the metal balls on the ground, and then knock them far away. They would make this tinkling noise whenever they moved.","nextNodeIds":[722150111]},{"nodeId":722150111,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2479737514,"text":"I do not understand what power they possessed, but the sound they made would always attract myself and the other cats to chase them.","nextNodeIds":[722150112]},{"nodeId":722150112,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2961944226,"text":"I came to understand, therefore, that the reason why few people have come to pay respects is because the shrine presently lacks metal balls.","nextNodeIds":[722150113]},{"nodeId":722150113,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":132139626,"text":"Thus, I request your help in hanging these metal balls in high places.","nextNodeIds":[722150114]},{"nodeId":722150114,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2080037754,"text":"That way, humans will hear the tinkling of the metal balls and come to this shrine, and they will not lose their way.","nextNodeIds":[722150115]},{"nodeId":722150115,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2888199362,"text":"The Offering Box will be full of Mora, and the shrine will thrive... and Hibiki will be very happy when she returns.","nextNodeIds":[722150116]},{"nodeId":722150116,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":4178504730,"text":"So, please help me hang these metal balls around the shrine.","nextNodeIds":[722150117]},{"nodeId":722150117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1015326210,"text":"I got it.","nextNodeIds":[722150118]},{"nodeId":722150118,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3907229690,"text":"Thank you, meow meow.","nextNodeIds":[]}]},{"talkId":7221502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7221501","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7221502,"initDialog":722150201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3189],"performCfg":"","priority":1,"questId":72215,"showRandomTalkCount":0},"dialogs":[{"nodeId":722150201,"roleType":"TA