"],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7221503,"initDialog":722150301,"nextRandomTalks":[],"nextTalks":[],"npcId":[3189],"performCfg":"","priority":5,"questId":72215,"showRandomTalkCount":0},"dialogs":[{"nodeId":722150301,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3300988578,"text":"Have you hung them all up?","nextNodeIds":[722150302]},{"nodeId":722150302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1414262890,"text":"All done.","nextNodeIds":[722150303]},{"nodeId":722150303,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2268963202,"text":"Meow meow, wonderful. This will surely make the shrine a livelier place.","nextNodeIds":[722150304]},{"nodeId":722150304,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":217287834,"text":"...","nextNodeIds":[722150305]},{"nodeId":722150305,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2162113138,"text":"Hmm. Why haven't lots of humans come here yet?","nextNodeIds":[722150306,722150307]},{"nodeId":722150306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3798055418,"text":"I don't think they'll come so quickly...","nextNodeIds":[722150308]},{"nodeId":722150308,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":978648802,"text":"Ah, humans are so hard to understand. Well, you are an exception, of course. You are more enlightened.","nextNodeIds":[722150309]},{"nodeId":722150309,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3250191786,"text":"There may not be any people now... But at least those little rascals won't get lost anymore, meow meow.","nextNodeIds":[722150310]},{"nodeId":722150310,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3790827282,"text":"The stone human says that the stone will be ready very soon. Do come and see it.","nextNodeIds":[722150311]},{"nodeId":722150311,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3964883930,"text":"...Hmm, yes, there was one other thing. A strange thing.","nextNodeIds":[722150312]},{"nodeId":722150312,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3905866106,"text":"I went to ask those two green humans about Hibiki and Domeki.","nextNodeIds":[722150313]},{"nodeId":722150313,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":903222730,"text":"Both of them said that they didn't know Hibiki or anything about her.","nextNodeIds":[722150314]},{"nodeId":722150314,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3498787234,"text":"But the tall green human said that he had read about an \"Ako Domeki.\"","nextNodeIds":[722150315]},{"nodeId":722150315,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2821374802,"text":"He talked about... \"bandit\" this and \"bounty\" that... Whatever the case, he was trying to say that Domeki was a bad person.","nextNodeIds":[722150316]},{"nodeId":722150316,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3973722218,"text":"There must be some mistake. Hibiki would always play with him, so Domeki must've been a good person.","nextNodeIds":[722150317]},{"nodeId":722150317,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2960926250,"text":"That human's comprehension must be lacking. You're still the most reliable human after all, it seems...","nextNodeIds":[722150318]},{"nodeId":722150318,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":414597906,"text":"Ah, when will Hibiki come back...","nextNodeIds":[]},{"nodeId":722150307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2097148042,"text":"It's not that simple...","nextNodeIds":[722150308]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3189"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7221501,7221502,7221503],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","count":31},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[172215],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3926553926,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFD