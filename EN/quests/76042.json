{"mainQuestId":76042,"title":"The Haunted Pirate Shipwreck","description":"Treasure hunters attempting to scavenge riches from the wreckage of a pirate ship claim to have been attacked by a ghost. While the Eye of Kratti is no stranger to rumors of haunted sightings, there has never been a documented case of ghosts assaulting the living. Perhaps questioning Ilmari, who often fishes nearby, might reveal more information.","titleTextMapHash":225648287,"descTextMapHash":3841899070,"mainQuestExcel":{"mainQuestId":76042,"titleTextMapHash":225648287,"title":"The Haunted Pirate Shipwreck","descTextMapHash":3841899070,"description":"Treasure hunters attempting to scavenge riches from the wreckage of a pirate ship claim to have been attacked by a ghost. While the Eye of Kratti is no stranger to rumors of haunted sightings, there has never been a documented case of ghosts assaulting the living. Perhaps questioning Ilmari, who often fishes nearby, might reveal more information.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76042","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":3841899070,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76042,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1969570449,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76042","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176042],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":225648287,"type":"WQ","unlockDescTextMapHash":428950}},"flow":[{"subQuestId":7604201,"order":1,"stepDescription":"Visit the Curatorium of Secrets","stepDescTextMapHash":1852808180,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7604201],"talks":[{"talkId":7604201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7604201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7604201,"initDialog":760420101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1316,1317],"performCfg":"QuestDialogue/WQ/NodKrai_76042/Q7604201","priority":5,"questId":76042,"showRandomTalkCount":0},"dialogs":[{"nodeId":760420101,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":375643866,"text":"A bunch of treasure hunters were attacked by a ghost while plundering the wreckage of a pirate ship... Sounds like something straight out of a trashy pulp fiction novel.","nextNodeIds":[760420102]},{"nodeId":760420102,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1788492138,"text":"Not to mention, nothing they say adds up — who knows how much of it is true?","nextNodeIds":[760420103]},{"nodeId":760420103,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3540817026,"text":"You've heard of that pirate ship before, I take it?","nextNodeIds":[760420104]},{"nodeId":760420104,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2839304026,"text":"Sure. I was only little back then, but the Atlas is plenty famous.","nextNodeIds":[760420105]},{"nodeId":760420105,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":543399938,"text":"\"If you don't behave, the 'Shieldmaiden' Lovisa and 'Lunatic' Grettir will feed you to the fishes!\"","nextNodeIds":[760420106]},{"nodeId":760420106,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":485188066,"text":"The grown-ups used to say things like that to scare us. Obviously, I wasn't afraid!","nextNodeIds":[760420107]},{"nodeId":760420107,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":552933234,"text":"Hehe, in that case, you're the perfect candidate for this commission.","nextNodeIds":[760420108]},{"nodeId":760420108,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2139058602,"text":"...Huh!?","nextNodeIds":[760420109]},{"nodeId":760420109,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1541179282,"text":"Alright... It's a little far out, but I'll investigate.","nextNodeIds":[760420110]},{"nodeId":760420110,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2781245218,"text":"(There are more than a few wrecks in that stretch of water. People sometimes find treasure there — maybe this time, I might...)","nextNodeIds":[760420111]},{"nodeId":760420111,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":195655762,"text":"Don't let your lust for treasure get in the way of your work...","nextNodeIds":[760420112]},{"nodeId":760420112,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2492295570,"text":"O—Of course not, Bos Nef! I'll go there, investigate, and come right back!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7604202,"order":2,"stepDescription":"Go to the beach near the Eye of Kratti to investigate","stepDescTextMapHash":321859156,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7604203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360700162:2427.007,200.211,8921.929,0.000,212.566,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7604202,7604203],"talks":[{"talkId":7604202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7604202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7602007","3","","",""],"type":"QUEST_COND_QUEST_STATE_NOT_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7604202,"initDialog":760420201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"QuestDialogue/WQ/NodKrai_76042/Q7604202","priority":5,"questId":76042,"showRandomTalkCount":0},"dialogs":[{"nodeId":760420201,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":161148706,"text":"Judging by your clothes... Another one on the hunt for treasure, huh? You lot never seem to tire of rummaging around these parts.","nextNodeIds":[760420202]},{"nodeId":760420202,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1853337778,"text":"You've got a good eye for people... I heard a few fellow treasure hunters ran into trouble around here. They're running around telling anyone who'll listen they were attacked by ghosts.","nextNodeIds":[760420203]},{"nodeId":760420203,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":234740250,"text":"I don't believe in all that, so I came here to see what the deal is... 'Course, if I happen to stumble across any undiscovered treasure, you won't hear me complaining.","nextNodeIds":[760420204]},{"nodeId":760420204,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3483185218,"text":"So, tell me, this talk of ghosts attacking people, what's all that about?","nextNodeIds":[760420205]},{"nodeId":760420205,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":402252962,"text":"No ghosts attacking people here. It's people getting beaten, and a person's doing the beating. Though, in truth, that one's as ghoulish as they come — he might still be alive, but I think he died inside a long time ago.","nextNodeIds":[760420206]},{"nodeId":760420206,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3361893506,"text":"...Huh? Surely, you're not saying—","nextNodeIds":[760420207]},{"nodeId":760420207,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2176968194,"text":"Don't look at me like I'm crazy. Ever heard of the Atlas?","nextNodeIds":[760420208]},{"nodeId":760420208,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1325376402,"text":"Well duh. But I heard it sank way back when. In fact, didn't it go into the drink somewhere around here?","nextNodeIds":[760420209]},{"nodeId":760420209,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1314544458,"text":"They say the most valuable treasure on it was a token that could lead someone to Reed Miller's \"Great Treasure\" — I've also heard that no one's found it yet.","nextNodeIds":[760420210]},{"nodeId":760420210,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2485451474,"text":"It seems like you've heard quite a lot...","nextNodeIds":[760420211]},{"nodeId":760420211,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":474568994,"text":"Hmph, we call that professional competence. So, you tryin' to say those treasure hunters getting beaten up has something to do with the Atlas?","nextNodeIds":[760420212]},{"nodeId":760420212,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":832598346,"text":"Exactly. It was a tragic shipwreck, but not without survivors. One of those who made it back to shore was Hark, the Crackjaw. He's the last man standing of the Atlas's infamous pirate crew.","nextNodeIds":[760420213]},{"nodeId":760420213,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":1843945042,"text":"I heard he left for Snezhnograd, but recently returned as part of a caravan. Then he must have stirred up some fuss in Nasha Town and forced the caravan to kick him out.","nextNodeIds":[760420214]},{"nodeId":760420214,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":625173458,"text":"That day, those treasure hunters were searching around the wreckage of the Atlas. Crackjaw spotted them and gave them a good hiding.","nextNodeIds":[760420215]},{"nodeId":760420215,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1890960554,"text":"She was his ship — she sank, sure, but that bond must still be strong.","nextNodeIds":[760420216]},{"nodeId":760420216,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":426054802,"text":"Exactly. Folks said he didn't dare sail far again after the Atlas went down. Kinda puts a stop to you being a pirate, that sorta thing. But for someone like that, going straight ain't easy.","nextNodeIds":[760420217]},{"nodeId":760420217,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2133461594,"text":"All those people the Atlas once... \"visited\" aren't gonna just let it go.","nextNodeIds":[760420218]},{"nodeId":760420218,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1072335554,"text":"But that's the life he chose — he only has himself to blame.","nextNodeIds":[760420219]},{"nodeId":760420219,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":1670662010,"text":"Everyone strays from the straight and narrow at some point — what matters is how we set ourselves right. Hark used to be a helmsman himself, but he never corrected his course...","nextNodeIds":[760420220]},{"nodeId":760420220,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":107339906,"text":"So, this Hark guy came back here after causing all that trouble in Nasha Town? I guess this is where it all ended, and where it'll all begin.","nextNodeIds":[760420221]},{"nodeId":760420221,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3897420490,"text":"Chalk another one up on his list of wrong choices.","nextNodeIds":[760420222]},{"nodeId":760420222,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":4241402418,"text":"They say old habits die hard. He hurt a lot of people around these parts, and then, like a slippery eel, he vanished without a trace.","nextNodeIds":[760420223]},{"nodeId":760420223,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3919227178,"text":"Word is that someone's put a bounty on his head over at The Flagship in Nasha Town. Lots of people casting nets, yet each one's coming up empty.","nextNodeIds":[760420224]},{"nodeId":760420224,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2686783490,"text":"You don't catch much fish, but it seems very little else escapes your hook...","nextNodeIds":[760420225]},{"nodeId":760420225,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":313285050,"text":"Sharp tongue, you've got there, little miss... Seeing as I like you, here's something else from my hook — the wreckage of the Atlas is over that way. Feel free to go test your luck there.","nextNodeIds":[760420226]},{"nodeId":760420226,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":998211218,"text":"Test my luck? And when he jumps out from nowhere to attack, I take it you'll have my back?","nextNodeIds":[760420227]},{"nodeId":760420227,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3355477282,"text":"Of course not! I'm just a fisherman — what use would I be in a fight? Look, I'll take you part of the way there and then point you the rest of the way. After all, it's not like I'm catching anything around here.","nextNodeIds":[760420228]},{"nodeId":760420228,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1647376594,"text":"*sigh* Fair enough. It's not like I can't run away if things get too hot to handle — there aren't many people who can catch me in full flight.","nextNodeIds":[]}]},{"talkId":7604203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7604202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7602007","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7604203,"initDialog":760420301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"QuestDialogue/WQ/NodKrai_76042/Q7604203","priority":5,"questId":76042,"showRandomTalkCount":0},"dialogs":[{"nodeId":760420301,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3488607946,"text":"Judging by your clothes... Another one on the hunt for treasure, huh? You lot never seem to tire of rummaging around these parts.","nextNodeIds":[760420302]},{"nodeId":760420302,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3191496930,"text":"You've got a good eye for people... I heard a few fellow treasure hunters ran into trouble around here. They're running around telling anyone who'll listen they were attacked by ghosts.","nextNodeIds":[760420303]},{"nodeId":760420303,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1361869402,"text":"I don't believe in all that, so I came here to see what the deal is... 'Course, if I happen to stumble across any undiscovered treasure, you won't hear me complaining.","nextNodeIds":[760420304]},{"nodeId":760420304,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":413127778,"text":"So, tell me, this talk of ghosts attacking people, what's all that about?","nextNodeIds":[760420305]},{"nodeId":760420305,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":891098898,"text":"There's ghosts here, alright.","nextNodeIds":[760420306]},{"nodeId":760420306,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2490982338,"text":"Huh!? Real ghosts?","nextNodeIds":[760420307]},{"nodeId":760420307,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":93108058,"text":"But I ain't seen them attacking no one. I've sure seen a person attacking people though. In truth, that one's as ghoulish as they come — he might still be alive, but I think he died inside a long time ago.","nextNodeIds":[760420308]},{"nodeId":760420308,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2391267114,"text":"...Huh? Surely, you're not saying—","nextNodeIds":[760420309]},{"nodeId":760420309,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":967028322,"text":"Don't look at me like I'm crazy. Ever heard of the Atlas?","nextNodeIds":[760420310]},{"nodeId":760420310,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1543236234,"text":"Well duh. But I heard it sank way back when. In fact, didn't it go into the drink somewhere around here?","nextNodeIds":[760420311]},{"nodeId":760420311,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2310594882,"text":"I heard the most valuable treasure on it was a token that could lead someone to Reed Miller's \"Great Treasure.\"","nextNodeIds":[760420312]},{"nodeId":760420312,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":46131042,"text":"It seems like you've heard quite a lot... Not long back, there was a traveler with golden hair and a companion dressed in white who passed through here — that token left with them.","nextNodeIds":[760420313]},{"nodeId":760420313,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1270959618,"text":"(Huh? Is he talking about... Forget it, there's work to do.)","nextNodeIds":[760420314]},{"nodeId":760420314,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":449753306,"text":"Hmph, we call that professional competence. So, you tryin' to say those treasure hunters getting beaten up has something to do with the Atlas?","nextNodeIds":[760420315]},{"nodeId":760420315,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2172020362,"text":"Exactly. It was a tragic shipwreck, but not without survivors. One of those who made it back to shore was Hark, the Crackjaw. He's the last man standing of the Atlas's infamous pirate crew.","nextNodeIds":[760420316]},{"nodeId":760420316,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":656451434,"text":"I heard he left for Snezhnograd, but recently returned as part of a caravan. Then he must have stirred up some fuss in Nasha Town and forced the caravan to kick him out.","nextNodeIds":[760420317]},{"nodeId":760420317,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":1868058570,"text":"That day, those treasure hunters were searching around the wreckage of the Atlas. Crackjaw spotted them and gave them a good hiding.","nextNodeIds":[760420318]},{"nodeId":760420318,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":4088209850,"text":"She was his ship — she sank, sure, but that bond must still be strong.","nextNodeIds":[760420319]},{"nodeId":760420319,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":469063642,"text":"Exactly. Folks said he didn't dare sail far again after the Atlas went down. Kinda puts a stop to you being a pirate, that sorta thing. But for someone like that, going straight ain't easy.","nextNodeIds":[760420320]},{"nodeId":760420320,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1525737674,"text":"All those people the Atlas once... \"visited\" aren't gonna just let it go.","nextNodeIds":[760420321]},{"nodeId":760420321,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1845196178,"text":"But that's the life he chose — he only has himself to blame.","nextNodeIds":[760420322]},{"nodeId":760420322,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2369691034,"text":"Everyone strays from the straight and narrow at some point — what matters is how we set ourselves right. Hark used to be a helmsman himself, but he never corrected his course...","nextNodeIds":[760420323]},{"nodeId":760420323,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3242869010,"text":"So, this Hark guy came back here after causing all that trouble in Nasha Town? I guess this is where it all ended, and where it'll all begin.","nextNodeIds":[760420324]},{"nodeId":760420324,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":4137333562,"text":"Chalk another one up on his list of wrong choices.","nextNodeIds":[760420325]},{"nodeId":760420325,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2284528946,"text":"They say old habits die hard. He hurt a lot of people around these parts, and then, like a slippery eel, he vanished without a trace.","nextNodeIds":[760420326]},{"nodeId":760420326,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3547042962,"text":"Word is that someone's put a bounty on his head over at The Flagship in Nasha Town. Lots of people casting nets, yet each one's coming up empty.","nextNodeIds":[760420327]},{"nodeId":760420327,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1801498458,"text":"You don't catch much fish, but it seems very little else escapes your hook...","nextNodeIds":[760420328]},{"nodeId":760420328,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":933115754,"text":"Sharp tongue, you've got there, little miss... Seeing as I like you, here's something else from my hook — the wreckage of the Atlas is over that way. Feel free to go test your luck there.","nextNodeIds":[760420329]},{"nodeId":760420329,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1283767602,"text":"Test my luck? And when he jumps out from nowhere to attack, I take it you'll have my back?","nextNodeIds":[760420330]},{"nodeId":760420330,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3320942346,"text":"Of course not! I'm just a fisherman — what use would I be in a fight? Look, I'll take you part of the way there and then point you the rest of the way. After all, it's not like I'm catching anything around here.","nextNodeIds":[760420331]},{"nodeId":760420331,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":63814682,"text":"*sigh* Fair enough. It's not like I can't run away if things get too hot to handle — there aren't many people who can catch me in full flight.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7604203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360700162:2427.007,200.211,8921.929,0.000,212.566,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7604203,"order":3,"stepDescription":"Investigate the shipwreck","stepDescTextMapHash":3187673876,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360700163:2198.648,