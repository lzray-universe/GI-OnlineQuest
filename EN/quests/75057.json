{"mainQuestId":75057,"title":"","description":"","titleTextMapHash":1324677775,"descTextMapHash":2971526246,"mainQuestExcel":{"mainQuestId":75057,"titleTextMapHash":1324677775,"title":"","descTextMapHash":2971526246,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ75057","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2971526246,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75057,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1788471009,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75057","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1324677775,"type":"WQ","unlockDescTextMapHash":1064059606}},"flow":[{"subQuestId":7505701,"order":1,"stepDescription":"","stepDescTextMapHash":1129691692,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"完成噬能长钉"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"完成噬能长钉"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7505702,"order":2,"stepDescription":"","stepDescTextMapHash":484331740,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7505702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7505703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7505704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7505701,7505702,7505704],"talks":[{"talkId":7505701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":true,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7505702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7505701,"initDialog":750570101,"nextRandomTalks":[],"nextTalks":[7505702,7505704],"npcId":[],"performCfg":"QuestDialogue/WQ/Natlan_75057/Q7505701","priority":5,"questId":75057,"showRandomTalkCount":0},"dialogs":[]},{"talkId":7505702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7505702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7505702,"initDialog":750013201,"nextRandomTalks":[],"nextTalks":[],"npcId":[],"performCfg":"QuestDialogue/WQ/Natlan_75001/Q7500132","priority":5,"questId":75057,"showRandomTalkCount":0},"dialogs":[{"nodeId":750013201,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":4071888090,"text":"I can't believe that worked. That was truly a scene from out of story and song.","nextNodeIds":[750013202]},{"nodeId":750013202,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":638940890,"text":"The cacophony fell silent... and the Pin returned to its original state. Then, its giant form crashed to the ground...","nextNodeIds":[750013203]},{"nodeId":750013203,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":395170218,"text":"Hoo... To think that someone could really accomplish this... This isn't a dream, is it? You're all real, aren't you? Not figments of my imagination?","nextNodeIds":[750013204]},{"nodeId":750013204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":766686090,"text":"Wake up, wake up... You've got to fix this yourself!","nextNodeIds":[750013205]},{"nodeId":750013205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":273081090,"text":"Hey, there's no need to be so mean.","nextNodeIds":[750013206]},{"nodeId":750013206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":370061770,"text":"#But anyway, didn't Paimon tell you? {NICKNAME}'s super strong!","nextNodeIds":[750013207]},{"nodeId":750013207,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3954406522,"text":"Rawr!","nextNodeIds":[750013208]},{"nodeId":750013208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1515450778,"text":"#Hehe, you think so, don'cha, {REALNAME[ID(2)|SHOWHOST(true)]}?","nextNodeIds":[750013209]},{"nodeId":750013209,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":336818538,"text":"#You weren't affected by the Abyss, were you, {NICKNAME}?","nextNodeIds":[750013210,750013211]},{"nodeId":750013210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3891678098,"text":"Relax, it's just the Abyss...","nextNodeIds":[750013212]},{"nodeId":750013212,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":47746706,"text":"#Even our strongest warriors must remain vigilant and then some in the face of the Abyss. You're no ordinary person, {NICKNAME}.","nextNodeIds":[750013213]},{"nodeId":750013213,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1950289850,"text":"Haha, who knows, the story I spin from this material might even surpass those by Sanhaj!","nextNodeIds":[750013214]},{"nodeId":750013214,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":374761546,"text":"Ehrrr?","nextNodeIds":[750013215]},{"nodeId":750013215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1223461146,"text":"Well, that sure sounds impressive, but who's Sanhaj?","nextNodeIds":[750013216]},{"nodeId":750013216,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1845816618,"text":"Haha, for \"those who tell stories in their tribes,\" Sanhaj of the Masters of the Night-Wind is worthy of reverence indeed...","nextNodeIds":[750013217]},{"nodeId":750013217,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":199741338,"text":"Alas, time is short. I'll tell you more about Sanhaj when we've got more time!","nextNodeIds":[750013218]},{"nodeId":750013218,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":375017802,"text":"Alright then. Let's head for the next floating Shadow Pin. I want to fix this issue and start writing by nightfall!","nextNodeIds":[750013219]},{"nodeId":750013219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":178062026,"text":"Woohoo! Let's go, let's go!","nextNodeIds":[750013220]},{"nodeId":750013220,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":633529314,"text":"Rawr!","nextNodeIds":[]},{"nodeId":750013211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3838175554,"text":"I'm alright for now.","nextNodeIds":[750013212]}]},{"talkId":7505704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7505702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7500107","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7505704,"initDialog":750010801,"nextRandomTalks":[],"nextTalks":[],"npcId":[],"performCfg":"","priority":5,"questId":75057,"showRandomTalkCount":0},"dialogs":[{"nodeId":750010801,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":4049480306,"text":"Wow. Here I'd thought to come over and check on the frightening noises I'd heard...","nextNodeIds":[750010802]},{"nodeId":750010802,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3882787258,"text":"Telling myself \"Come on, Titu, it's probably nothing\"... But this is quite something! Quite something indeed!","nextNodeIds":[750010803]},{"nodeId":750010803,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":4223399330,"text":"Rawr!","nextNodeIds":[750010804]},{"nodeId":750010804,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2065495922,"text":"There's even a little Tepetlisaurus here... Was it you who brought these outlanders here, then?","nextNodeIds":[750010805]},{"nodeId":750010805,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1859955674,"text":"And... was it you who brought this Shadow Pin down?","nextNodeIds":[750010806,750010809]},{"nodeId":750010806,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2487428954,"text":"...Should we not have done that?","nextNodeIds":[750010807]},{"nodeId":750010807,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3158071626,"text":"#Eh? Wait, did we do something bad, {NICKNAME}? If we act fast, while there's only one witness...","nextNodeIds":[750010808]},{"nodeId":750010808,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":624416114,"text":"#Haha, come on, no need for that! It's not serious, and if anything, I'd say you've done us a favor! So, you're {NICKNAME}, then? Who's your friend over there?","nextNodeIds":[750010813]},{"nodeId":750010813,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3059334498,"text":"Rawr!","nextNodeIds":[750010814]},{"nodeId":750010814,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2164683186,"text":"#And this is {REALNAME[ID(2)|SHOWHOST(true)]}.","nextNodeIds":[750010815]},{"nodeId":750010815,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3857691746,"text":"And Titu's my name, a teller {RUBY#[D]storyteller}of tales for our tribe. I'm also responsible for \"caring\" for the stone pillars in this valley.","nextNodeIds":[750010816]},{"nodeId":750010816,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1770757434,"text":"And of course, this Shadow Pin you've plunged into the earth is one of three little pins, and its care is within my jurisdiction.","nextNodeIds":[750010817]},{"nodeId":750010817,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3513134346,"text":"J—Jurisdiction... Uh oh, looks like we're going to have to compensate the locals for dropping that stone pillar.","nextNodeIds":[750010818]},{"nodeId":750010818,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1619964186,"text":"Ugh, Paimon wouldn't have used our real name's if she'd known sooner.","nextNodeIds":[750010819]},{"nodeId":750010819,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1829845426,"text":"Compensate... \"Titu had a flash of inspiration. Perhaps he might use this to coerce these people into helping him achieve his goals...\"","nextNodeIds":[750010820]},{"nodeId":750010820,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1448572642,"text":"That's how I'd slot a bit like this into the plot, anyway.","nextNodeIds":[750010821]},{"nodeId":750010821,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3794141450,"text":"Hmm?","nextNodeIds":[750010822]},{"nodeId":750010822,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2621524610,"text":"Ah, sorry, got a bit carried away thinking about stories there. Telling{RUBY#[D]storyteller} tales is my responsibility here in the tribe, and after so many years, it's time for me to come up with some originals.","nextNodeIds":[750010823]},{"nodeId":750010823,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3743147522,"text":"And of course, something just had to go wrong with the Shadow Pin just as I was a few days into my musing... Because why would it ever rain when it could pour?","nextNodeIds":[750010824]},{"nodeId":750010824,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2927875770,"text":"Ahem! Anyway, I'm not gonna blackmail you. I—I mean, I wouldn't have spoken my thoughts aloud if that was the case, right?","nextNodeIds":[750010825]},{"nodeId":750010825,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3160100730,"text":"Look, we exchanged names, but we haven't come to blows, so that makes us friends, yes?","nextNodeIds":[750010826]},{"nodeId":750010826,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":448308002,"text":"In that case... could you listen to a friend's request?","nextNodeIds":[750010827]},{"nodeId":750010827,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4082577274,"text":"Sure... as long as it doesn't involve compensation.","nextNodeIds":[750010828]},{"nodeId":750010828,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3707325186,"text":"No, no, surely not! Hmm, how should I put this? ... When you passed through the valley, did you see some sort of giant block of solid phlogiston with golden patterns carved into it?","nextNodeIds":[750010829]},{"nodeId":750010829,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1832557250,"text":"It's in the center of this place. You can't miss it.","nextNodeIds":[750010830,750010831]},{"nodeId":750010830,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4008633122,"text":"That rings a bell...","nextNodeIds":[750010833]},{"nodeId":750010833,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2528275610,"text":"This whole business I'm talking about has to do with that huge stone pillar. We call it a Shadow Pin... and we've had problems with it recently.","nextNodeIds":[750010834]},{"nodeId":750010834,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2472837338,"text":"To be honest, I'd all but given up before meeting you. I had the line all ready: \"The Shadow Pins could not be saved, dooming the tribe to calamitous destruction\"... It didn't sound too bad.","nextNodeIds":[750010835]},{"nodeId":750010835,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1960865594,"text":"Wait, it's just a stone pillar. How could it destroy the tribe?","nextNodeIds":[750010836]},{"nodeId":750010836,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":166834210,"text":"Also, what's so special about these \"Shadow Pins\" anyway? And the one we dropped, it was a... lesser pin? But it seemed pretty big to Paimon, so why's it called that?","nextNodeIds":[750010837]},{"nodeId":750010837,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3876724722,"text":"Hmm?","nextNodeIds":[750010838]},{"nodeId":750010838,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":52848490,"text":"Hmm... Since you're both outlanders, I suppose a more detailed explanation is in order. This is related to a legend handed down through our tribe.","nextNodeIds":[750010839]},{"nodeId":750010839,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1490394674,"text":"The stories say that the Wayob hung the Pins here to seal the shadow of the Volcano Lord...","nextNodeIds":[750010840]},{"nodeId":750010840,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":186332658,"text":"But that which is sealed beneath them is, in truth, the Abyss.","nextNodeIds":[750010841]},{"nodeId":750010841,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":274510226,"text":"That's how most tales in Natlan are. They're embellished narratives held up as warnings, and all their rhetoric is a kind of metaphor.","nextNodeIds":[750010842]},{"nodeId":750010842,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1065409562,"text":"Wait, so you mean the Abyss is actually sealed below here!?","nextNodeIds":[750010843]},{"nodeId":750010843,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2421282698,"text":"That's right. And recently, two out of the three little Shadow Pins have floated upward. Perhaps if the third floats too, all the evil beneath the earth will come surging up like a tide.","nextNodeIds":[750010844]},{"nodeId":750010844,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3469369106,"text":"So to be honest, it's an unexpected boon that you've managed to push one back in. So, no compensation required.","nextNodeIds":[750010845]},{"nodeId":750010845,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3392557850,"text":"If anything, I was hoping to ask if you'd mind pushing the other one back in as well...","nextNodeIds":[750010846]},{"nodeId":750010846,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2010593098,"text":"#Huh... What do you think, {NICKNAME}...?","nextNodeIds":[750010847,750010848]},{"nodeId":750010847,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4223440458,"text":"...Where the Abyss is involved, we can't stand idle.","nextNodeIds":[750010849]},{"nodeId":750010849,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3864025586,"text":"Rawr!","nextNodeIds":[750010850]},{"nodeId":750010850,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3002387426,"text":"#Even you're up for it, {REALNAME[ID(2)|SHOWHOST(true)]}? Well, alright then.","nextNodeIds":[750010851]},{"nodeId":750010851,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":1165659114,"text":"Ah, like a flame that appears in the darkness, so too will heroes rise up in times of great peril. Human possibility shines through in glory at moments such as this.","nextNodeIds":[750010852]},{"nodeId":750010852,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":236780842,"text":"#You know what? This could make for a great story, too — indeed, {NICKNAME}, you've got some traits that even those storied heroes don't have. I'm looking forward to this, I must say.","nextNodeIds":[750010853]},{"nodeId":750010853,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2307150434,"text":"Let's go, then, dear heroes. Let's go and check on the last floating Pin...","nextNodeIds":[]},{"nodeId":750010848,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3415125148,"text":"Perhaps I could lend a hand?","nextNodeIds":[750010849]},{"nodeId":750010831,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3217435202,"text":"Nope, don't recall anything like that...","nextNodeIds":[750010832]},{"nodeId":750010832,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2150591170,"text":"Huh. I thought it was obvious enough. That's fine, though.","nextNodeIds":[750010833]},{"nodeId":750010809,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3076903066,"text":"Paimon did it. I was just walking over here...","nextNodeIds":[750010810]},{"nodeId":750010810,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2146362362,"text":"Hey! You're always like that! Paimon'll get mad if you don't cut it out!","nextNodeIds":[750010811]},{"nodeId":750010811,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":4174625714,"text":"#Haha, relax. If anything, this is a huge relief. So your name's Paimon, then? In that case, how about this {M#good fellow}{F#good lady} over here?","nextNodeIds":[750010812]},{"nodeId":750010812,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2534202170,"text":"#Call me {NICKNAME}.","nextNodeIds":[750010813]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7505702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7505703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7505704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7500101","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7505701,7505702,7505704],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","count":39},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","count":8}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2971526246,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75057/Q7505701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":true,"DBACCKDPONG":[7505702,7505704],"DIAFFIANKPH":false,"DKOMBM