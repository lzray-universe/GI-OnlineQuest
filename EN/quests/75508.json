:"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550801,"initDialog":755080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1087,1095,1097],"performCfg":"QuestDialogue/WQ/BrickBreakerV2_75508/Q7550801","priority":5,"questId":75508,"showRandomTalkCount":0},"dialogs":[{"nodeId":755080101,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":1597741394,"text":"Hey!","nextNodeIds":[755080102]},{"nodeId":755080102,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":4110050802,"text":"Our guests of honor are here! Now we can really get this party started!","nextNodeIds":[755080103]},{"nodeId":755080103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2539929202,"text":"Hey, Mualani! Oh, and Xilonen's here too!","nextNodeIds":[755080104]},{"nodeId":755080104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":151414290,"text":"And... Mizuki? You're back from Inazuma already!","nextNodeIds":[755080105]},{"nodeId":755080105,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":1367454738,"text":"That's right! My friends in Natlan are like family to me. I like to think of the People of the Springs as my home away from home.","nextNodeIds":[755080106]},{"nodeId":755080106,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":1085686082,"text":"If I want to help people here, I definitely can't neglect the Natlan branch of my practice.","nextNodeIds":[755080107]},{"nodeId":755080107,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1264384994,"text":"Miss Mizuki's work ethic is impeccable.","nextNodeIds":[755080108]},{"nodeId":755080108,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1316797610,"text":"She puts the rest of us service-providers to shame...","nextNodeIds":[755080109,755080110]},{"nodeId":755080109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":336246082,"text":"Wait, so... Are you one of her clients, too?","nextNodeIds":[755080111]},{"nodeId":755080111,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1980649282,"text":"Well, I've had some weird dreams lately... Like, a client expediting a commission from a four-week time-frame to just one.","nextNodeIds":[755080112]},{"nodeId":755080112,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1767236722,"text":"Or, like a rush order for some kind of spherical accessory with an element of danger to it...","nextNodeIds":[755080113,755080114]},{"nodeId":755080113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1682487130,"text":"I know this one. Slimes and Fungi.","nextNodeIds":[755080115]},{"nodeId":755080115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1430722386,"text":"Wow, you made that connection pretty fast, Traveler. Almost as if you're the one sending Xilonen weird commissions through her dreams...","nextNodeIds":[755080116]},{"nodeId":755080116,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":255689418,"text":"Huh, are those creatures... dangerous?","nextNodeIds":[755080117]},{"nodeId":755080117,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2894243674,"text":"Anyway, the expedited time frame isn't even the hardest part. Spherical designs are tricky, and when you rush it, you end up with something that isn't even good.","nextNodeIds":[755080118]},{"nodeId":755080118,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1365129114,"text":"Point being, I've been having nothing but those kinds of dreams. So, I wrapped up all my orders and decided to visit Miss Mizuki for help...","nextNodeIds":[755080119]},{"nodeId":755080119,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3439179922,"text":"And, it worked like a charm! When I took a nap that afternoon, all the weird dreams were gone!","nextNodeIds":[755080120]},{"nodeId":755080120,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3941424122,"text":"It was my pleasure to help, Miss Xilonen.","nextNodeIds":[755080121]},{"nodeId":755080121,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3603477722,"text":"Although, I'm not sure how much credit I can really take for the disappearance of those dreams...","nextNodeIds":[755080122]},{"nodeId":755080122,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":1186857026,"text":"In any case, everyone's feeling good and well-rested now! Which means, it's party time!","nextNodeIds":[755080123]},{"nodeId":755080123,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":1797378730,"text":"A party on the water, to be exact! It's a tradition in my tribe, and we're gonna have a blast!","nextNodeIds":[755080124,755080125]},{"nodeId":755080124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2184431882,"text":"A party on the water, huh...","nextNodeIds":[755080126]},{"nodeId":755080126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2572115082,"text":"Yeah! Let's party!","nextNodeIds":[755080127]},{"nodeId":755080127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1243711946,"text":"...Although, what does that involve, exactly? Obviously, delicious food and drinks are a given...","nextNodeIds":[755080128]},{"nodeId":755080128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1869283450,"text":"But, how do people in Natlan like to party?","nextNodeIds":[755080129,755080130,755080131]},{"nodeId":755080129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2269556290,"text":"High-speed surfing with a Koholasaur?","nextNodeIds":[755080132]},{"nodeId":755080132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1889572778,"text":"Wait... Are you being serious?","nextNodeIds":[755080133]},{"nodeId":755080133,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":2165255858,"text":"Oho, do I spy a fellow extreme sports enthusiast!? To tell you the truth, those activities were where my mind first went to as well!","nextNodeIds":[755080134]},{"nodeId":755080134,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":3864075210,"text":"But, according to Chief Amina... *ahem*... \"Not everyone likes high-adrenaline activities!\"","nextNodeIds":[755080135]},{"nodeId":755080135,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":1845794298,"text":"\"Even beach volleyball can be dangerous. It's all fun and games until you spike the ball straight into your friend!\"","nextNodeIds":[755080136]},{"nodeId":755080136,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":522324698,"text":"\"This event is supposed to be fun, not something that scars people and creates even more work for Miss Mizuki in the process!\"","nextNodeIds":[755080137]},{"nodeId":755080137,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3687484434,"text":"Well, she does have a point. I'm always happy to help, but I'd rather not have a hand in creating my own patients' trauma. It's better if no one gets hurt.","nextNodeIds":[755080138]},{"nodeId":755080138,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":4248031626,"text":"Mhm-hmm, which is why I came to you for advice!","nextNodeIds":[755080139]},{"nodeId":755080139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2109736338,"text":"So, what's the plan?","nextNodeIds":[755080140]},{"nodeId":755080140,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":4118671274,"text":"Well, not everyone has a background in extreme sports, and we don't want that to deter people from participating in this event.","nextNodeIds":[755080141]},{"nodeId":755080141,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3253090250,"text":"As we were chatting, I happened to mention the Mikawa Flower Festival and its more laid-back approach to games, and Miss Mualani really latched onto that idea.","nextNodeIds":[755080142]},{"nodeId":755080142,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":346017906,"text":"So, we decided to give Akitsu Haneasobi a distinctive Natlanese twist! The result is \"Rhythm Ball\" — a relaxing game that doesn't sacrifice on fun.","nextNodeIds":[755080143]},{"nodeId":755080143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2491672706,"text":"An Inazuman game... with a Natlanese twist! What a cool idea!","nextNodeIds":[755080144,755080145]},{"nodeId":755080144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1178214122,"text":"There's the Children of Echoes' Dance-Off Stage.","nextNodeIds":[755080146]},{"nodeId":755080146,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2999435002,"text":"Wow, and you haven't even heard the band at full volume! You must have a good sense of rhythm...","nextNodeIds":[755080147]},{"nodeId":755080147,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":709548602,"text":"Which, as you can imagine, is perfect for \"Rhythm Ball.\" The goal is to smash all the blocks by hitting the balls to the beat of the music.","nextNodeIds":[755080148]},{"nodeId":755080148,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1452003298,"text":"No complex techniques, no safety issues, just instinct. It's a game everyone can enjoy.","nextNodeIds":[755080149]},{"nodeId":755080149,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2439556978,"text":"Oh, of course, with your skill, you could even add extra layers to the music, or bring out a new sense of rhythm.","nextNodeIds":[755080150]},{"nodeId":755080150,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3466977234,"text":"After all, different DJs can give the same song a whole new feel. And, in a game that involves beats, the player can showcase that same creativity!","nextNodeIds":[755080151]},{"nodeId":755080151,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1308831802,"text":"Who knows... In your hands, the background track could go from an easy-listening, chill-out piece to something with a trance or artcore twist!","nextNodeIds":[755080152]},{"nodeId":755080152,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1443971434,"text":"I can't wait to see what you come up with.","nextNodeIds":[755080153]},{"nodeId":755080153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1436443874,"text":"#Uh-huh, yeah, whatever you say... Well, sounds like something you can do, right, {NICKNAME}?","nextNodeIds":[755080154,755080155]},{"nodeId":755080154,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4120223010,"text":"Yeah, music and games! Right up my alley!","nextNodeIds":[755080156]},{"nodeId":755080156,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":1637338834,"text":"Yes! That's the spirit! As long as you and Paimon can play your hearts out, it's mission accomplished!","nextNodeIds":[755080157]},{"nodeId":755080157,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":3365510722,"text":"Oh, and I'll grab some snacks and drinks for the rest of us while we watch!","nextNodeIds":[755080158]},{"nodeId":755080158,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3305289778,"text":"Just remember to pace yourself, okay, Traveler?","nextNodeIds":[755080159]},{"nodeId":755080159,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3880788298,"text":"I'm sure you don't want an endless loop of Dance-Off Stage music stuck in your head before bed tonight.","nextNodeIds":[755080160]},{"nodeId":755080160,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4141965346,"text":"Well, thanks, everyone! This sounds like a blast!","nextNodeIds":[755080161]},{"nodeId":755080161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":223970978,"text":"Plus, if Xilonen's the one DJ-ing, an endless loop of music in our dreams... doesn't sound too bad!","nextNodeIds":[]},{"nodeId":755080155,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3796656466,"text":"Sure! I'll give it my best shot!","nextNodeIds":[755080156]},{"nodeId":755080145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1740649442,"text":"I can really feel the beat of the music.","nextNodeIds":[755080146]},{"nodeId":755080130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":447273610,"text":"Skydiving from the back of a Qucusaur?","nextNodeIds":[755080132]},{"nodeId":755080131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2912545650,"text":"Rope-less bungee jumping with a Yumkasaur... Tried that one, actually.","nextNodeIds":[755080132]},{"nodeId":755080125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3306480434,"text":"Sounds fun.","nextNodeIds":[755080126]},{"nodeId":755080114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":780675314,"text":"Are you talking about Specters and Ball Octopuses?","nextNodeIds":[755080115]},{"nodeId":755080110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":9221794,"text":"Or could it be... that you've worked together before?","nextNodeIds":[755080111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIG