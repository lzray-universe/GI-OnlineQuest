":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2095488331,"text":"...","nextNodeIds":[3830410]},{"nodeId":3830410,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1989947051,"text":"The wind that blows at sea or in high places should be able to carry a bard's words far away.","nextNodeIds":[3830411]},{"nodeId":3830411,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":132986243,"text":"It's never going to work if the air is too dry or suffocating.","nextNodeIds":[3830412]},{"nodeId":3830412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":61980515,"text":"Paimon understands. Sea or high places, right?","nextNodeIds":[3830413]},{"nodeId":3830413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2932517067,"text":"Then the best location to play the lyre would be...","nextNodeIds":[3830414,3830415,3830416]},{"nodeId":3830414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1887115619,"text":"A cliff?","nextNodeIds":[3830418]},{"nodeId":3830418,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3586942899,"text":"If you go east from Starfell Lake, there are mountains south of the beach.","nextNodeIds":[3830419]},{"nodeId":3830419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1459200307,"text":"..Oh! You mean that beach you were snoring away on and Paimon had to wake you?","nextNodeIds":[3830420]},{"nodeId":3830420,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2057478547,"text":"If you head to where the cliff juts out — that place is known as <color=#00E1FFFF>Starsnatch Cliff</color>.","nextNodeIds":[3830421]},{"nodeId":3830421,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1163555659,"text":"What do you think, bard? Meets the requirements, no?","nextNodeIds":[3830422]},{"nodeId":3830422,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1470974187,"text":"Lemme think... Starsnatch Cliff...","nextNodeIds":[3830423]},{"nodeId":3830423,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1847422115,"text":"...Alright, let's do it there.","nextNodeIds":[3830424]},{"nodeId":3830424,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1515383723,"text":"Very well. Then let's meet at Starsnatch Cliff when we are ready.","nextNodeIds":[3830425]},{"nodeId":3830425,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":627149523,"text":"Please don't be late.","nextNodeIds":[3830426]},{"nodeId":3830426,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4166290123,"text":"Hee-hee! Yes, Ma'am!","nextNodeIds":[3830427]},{"nodeId":3830427,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":111952651,"text":"Ah, sorry. I didn't mean to...","nextNodeIds":[]},{"nodeId":3830415,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":715256803,"text":"Near the sea?","nextNodeIds":[3830418]},{"nodeId":3830416,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":637534995,"text":"In the sky? You could play the lyre as you're gliding through the air...","nextNodeIds":[3830417]},{"nodeId":3830417,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":139894971,"text":"Even Amber would never think of doing such a thing...","nextNodeIds":[3830418]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[38304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJ