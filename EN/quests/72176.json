null,"speakerName":"Traveler","textMapHash":1888560882,"text":"One more try!","nextNodeIds":[721760207]},{"nodeId":721760207,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":638789658,"text":"Woohoo! The goal is to find the Temari within the time limit!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7217602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7217603"],"PAINLIBBLDK":"QUEST_EXEC_ROLLBACK_QUEST"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["20338"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7217605,"order":5,"stepDescription":"Talk to Kid Kujirai","stepDescTextMapHash":4084996420,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7217607,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["20338"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7217607],"talks":[{"talkId":7217607,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7217605","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7217607,"initDialog":721760702,"nextRandomTalks":[],"nextTalks":[],"npcId":[20338,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72176/Q7217607","priority":5,"questId":72176,"showRandomTalkCount":0},"dialogs":[{"nodeId":721760702,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":1905345354,"text":"#{F#Big sis}{M#Big bro} is amazing, you found it right away!","nextNodeIds":[721760703]},{"nodeId":721760703,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2843876770,"text":"#Hoho, {NICKNAME} is a seasoned traveler who has been to many nations.","nextNodeIds":[721760704]},{"nodeId":721760704,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":1217058234,"text":"Wow! Have you also been to Mondstadt?","nextNodeIds":[721760705]},{"nodeId":721760705,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":313471202,"text":"Certainly have.","nextNodeIds":[721760706]},{"nodeId":721760706,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":501276130,"text":"That's so cool! I heard from that Big Sister that there are many beautiful places in Mondstadt, like Stormterror's Ruins with super-duper tall towers...","nextNodeIds":[721760707,721760708]},{"nodeId":721760707,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3507546114,"text":"It's Stormterror's Lair.","nextNodeIds":[721760709]},{"nodeId":721760709,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":1510614178,"text":"Yup! I wonder if that tower is taller, or if the Almighty Shogun's Tenshukaku is taller...","nextNodeIds":[721760710]},{"nodeId":721760710,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3669398954,"text":"Kid Kujirai, why are you out alone in the wild?","nextNodeIds":[721760711]},{"nodeId":721760711,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":2583100362,"text":"Because when my sister was fishing, she thought I would scare the fish away, so she let me go out to play.","nextNodeIds":[721760712]},{"nodeId":721760712,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":3942092386,"text":"Once, I met that Big Sister who was an adventurer. She saw that I was bored, so she gave me a lot of Temari, and told me to \"find greedy travelers to play with.\"","nextNodeIds":[721760713]},{"nodeId":721760713,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":983738418,"text":"Greedy travelers...","nextNodeIds":[721760714]},{"nodeId":721760714,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":267052674,"text":"We're not greedy! We're worried! Paimon's worried that you might be bored playing by yourself!","nextNodeIds":[721760715]},{"nodeId":721760715,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":507282434,"text":"#That's right, I think {F#big sis}{M#big bro} is really nice, I'm so happy.","nextNodeIds":[721760716]},{"nodeId":721760716,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1320712786,"text":"Alone in the wilderness...","nextNodeIds":[721760717]},{"nodeId":721760717,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":41704914,"text":"You're a kid alone in the wild, aren't you afraid of running into danger? And you even have \"good stuff\" on you.","nextNodeIds":[721760718]},{"nodeId":721760718,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":3409989850,"text":"#You're really kind, {F#big sis}{M#big bro}. Don't worry, that Big Sister adventurer taught me. As long as I do something to it, the Temari can turn into a bomb.","nextNodeIds":[721760719]},{"nodeId":721760719,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3819223778,"text":"Eek, that's so dangerous!","nextNodeIds":[721760720]},{"nodeId":721760720,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":3905094418,"text":"It's not! I've blasted away a lot of bad guys, like hilichurls and slimes!","nextNodeIds":[721760721]},{"nodeId":721760721,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":769114178,"text":"You're the dangerous one!","nextNodeIds":[721760722]},{"nodeId":721760722,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":3357955410,"text":"#Oh yes, {F#big sis}{M#big bro}, if you want to play a game of Temari with other friends...","nextNodeIds":[721760723]},{"nodeId":721760723,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":3060691754,"text":"I'll leave a Temari here! Here are the rules...","nextNodeIds":[721760724]},{"nodeId":721760724,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":3411336090,"text":"When you hide a Temari, you have to hide it within the time of a Temari song. The person who is looking for it will also find it within a song's time. That will make things fair!","nextNodeIds":[721760725]},{"nodeId":721760725,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1723654178,"text":"Got it.","nextNodeIds":[721760726]},{"nodeId":721760726,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4026958202,"text":"It's so scary to think that we're actually playing with bombs...","nextNodeIds":[721760727]},{"nodeId":721760727,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":549755362,"text":"#Don't be scared, {F#big sis}{M#big bro}. Big Sister adventurer told me \"Only the bad guys will be bombed. Probably.\"","nextNodeIds":[721760728]},{"nodeId":721760728,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2922169650,"text":"\"Probably!?\"","nextNodeIds":[721760729]},{"nodeId":721760729,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":898878082,"text":"#I'm off to play somewhere else! Bye-bye, {F#big sis}{M#big bro}!","nextNodeIds":[]},{"nodeId":721760708,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2260867866,"text":"Is that so?","nextNodeIds":[721760709]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7217607,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","B