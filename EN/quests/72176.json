_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":2449286130,"text":"#Hi, {F#big sis}{M#big bro}! I have some good stuff here...","nextNodeIds":[721760102]},{"nodeId":721760102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":20240546,"text":"Thanks, but I'll pass.","nextNodeIds":[721760103]},{"nodeId":721760103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1277090882,"text":"How pitiful, being forced to do shady business at such a young age.","nextNodeIds":[721760104]},{"nodeId":721760104,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":970728554,"text":"It's not what you're thinking! I wanted to ask if you wanted to play a game of Temari with me.","nextNodeIds":[721760105]},{"nodeId":721760105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3146348010,"text":"Temari?","nextNodeIds":[721760106]},{"nodeId":721760106,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":550971978,"text":"#It's simple, I will hide the Temari somewhere nearby. If {F#big sis}{M#big bro} can find it within the time of a Temari song, you win.","nextNodeIds":[721760107]},{"nodeId":721760107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3536407922,"text":"Is that how Temari is played?","nextNodeIds":[721760108]},{"nodeId":721760108,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":1592852210,"text":"Huh? An awesome Big Sister adventurer taught me. And she said...","nextNodeIds":[721760109]},{"nodeId":721760109,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":2310653154,"text":"\"Kujirai, remember. You must say, 'If you win, you'll get the good stuff.'\"","nextNodeIds":[721760110]},{"nodeId":721760110,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":1208672954,"text":"#So, {F#big sis}{M#big bro}, if you win, you'll get the good stuff.","nextNodeIds":[721760111]},{"nodeId":721760111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3149832194,"text":"#Good stuff! {NICKNAME}, Paimon thinks it's only right to play with children!","nextNodeIds":[721760112,721760115]},{"nodeId":721760112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2534482690,"text":"But I still think Temari isn't played like this...","nextNodeIds":[721760113]},{"nodeId":721760113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3983652170,"text":"It may be a gameplay that only local people know, let's not care about such details.","nextNodeIds":[721760114]},{"nodeId":721760114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1810687570,"text":"You're Kid Kujirai, right? We'll play with you!","nextNodeIds":[721760116]},{"nodeId":721760116,"roleType":"TALK_ROLE_NPC","speakerId":20338,"speakerName":"Kid Kujirai","textMapHash":2335802658,"text":"Yay!","nextNodeIds":[]},{"nodeId":721760115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1234153290,"text":"Alright then.","nextNodeIds":[721760116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7217601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7217603,"order":2,"stepDescription":"","stepDescTextMapHash":1056353028