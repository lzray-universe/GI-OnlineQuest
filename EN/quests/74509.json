FMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30419"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7450901],"talks":[{"talkId":7450901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7450901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450901,"initDialog":745090101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30421,30419],"performCfg":"QuestDialogue/WQ/V4.2FungusFighterV3/Q7450901","priority":5,"questId":74509,"showRandomTalkCount":0},"dialogs":[{"nodeId":745090101,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":687137658,"text":"After a while, you and Paimon arrive at the Lil' Fungi's Fun-Tastic Fiesta booth...","nextNodeIds":[745090102]},{"nodeId":745090102,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2834666986,"text":"Oh, the Twin Stars of Brilliant Valor! Are you back for more of Lil' Fungi's Fun-Tastic Fiesta?","nextNodeIds":[745090103]},{"nodeId":745090103,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2843440386,"text":"Ms. Enghiene received orders to return to the Maison Gardiennage, so I'll be playing against you for now!","nextNodeIds":[745090104]},{"nodeId":745090104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2000855242,"text":"Hey, Souka! You're back!","nextNodeIds":[745090105]},{"nodeId":745090105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1600865194,"text":"Paimon was pretty surprised when we met Haniyyah, but you've taken it to the next level! Your outfit is so... Well, you sure are enthusiastic!","nextNodeIds":[745090106]},{"nodeId":745090106,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":3026159434,"text":"And that's a good thing, because I have a lot of work... I need to stay motivated.","nextNodeIds":[745090107]},{"nodeId":745090107,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":4032363578,"text":"And that's why I'll cut my problems down, one clean axe-swing at a time!","nextNodeIds":[745090108,745090109]},{"nodeId":745090108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1113161170,"text":"How are things at the newspaper?","nextNodeIds":[745090110]},{"nodeId":745090110,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2634722498,"text":"Our plan is progressing steadily. Novel events like these attract a lot of attention, and the paper won't miss any promotion opportunities!","nextNodeIds":[745090111]},{"nodeId":745090111,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2900716122,"text":"We didn't get the most important page, but it's clear that the event's becoming more popular.","nextNodeIds":[745090112]},{"nodeId":745090112,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":1798318810,"text":"That's right. We've seen an increase in ordinary citizens who wanted to give our game a try recently.","nextNodeIds":[745090113]},{"nodeId":745090113,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":2738108218,"text":"Many have been talking about what's the best Fungi team with which to win a round quickly.","nextNodeIds":[745090114]},{"nodeId":745090114,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":3216850322,"text":"I've also heard that people have been looking to play against you two, so they can see how the experts play.","nextNodeIds":[745090115,745090116]},{"nodeId":745090115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":207946346,"text":"We'd like to keep a low profile.","nextNodeIds":[745090117]},{"nodeId":745090117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3605666250,"text":"Unless the two of you play against us, of course. You know our strategies very well already...","nextNodeIds":[745090118]},{"nodeId":745090118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1429487674,"text":"Paimon thinks a match between you and us... will be a real test of technique!","nextNodeIds":[745090119]},{"nodeId":745090119,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2019860834,"text":"Well, you're here now, so why don't we play a friendly round?","nextNodeIds":[745090120]},{"nodeId":745090120,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2715702418,"text":"Come to think of it, the last time we went head-to-head with you was during the first Nilotpala Cup Beast Tamers Tournament, where you beat me most soundly.","nextNodeIds":[745090121]},{"nodeId":745090121,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":1073029386,"text":"How nostalgic. After that, Haniyyah and I went through a lot together, and many things changed. I bet it was the same with you.","nextNodeIds":[745090122]},{"nodeId":745090122,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2147818834,"text":"But your... seasoned courage and fearless aura are still as unwavering and sturdy as crystal.","nextNodeIds":[745090123]},{"nodeId":745090123,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2772709706,"text":"That alone was enough for us to decide that we'd follow you, back when we were preparing Fungus Mechanicus. I think we made the right choice!","nextNodeIds":[745090124]},{"nodeId":745090124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2566579050,"text":"Uh, why are you reminiscing all of a sudden? Is it something that writers do?","nextNodeIds":[745090125,745090126]},{"nodeId":745090125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2181363250,"text":"I miss those times, too.","nextNodeIds":[745090127]},{"nodeId":745090127,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":2733323226,"text":"Yes! What an incredible line!","nextNodeIds":[745090128]},{"nodeId":745090128,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":631079794,"text":"Anyway, as one of the designers of the game, I've got an ace up my sleeve!","nextNodeIds":[745090129]},{"nodeId":745090129,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":265996546,"text":"Are you talking about \"that,\" Souka?","nextNodeIds":[745090130]},{"nodeId":745090130,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"Souka","textMapHash":1538945914,"text":"That's right. I'll get started, and then Haniyyah will control powerful opponents against you. It should make for an exciting match!","nextNodeIds":[745090131]},{"nodeId":745090131,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":2431405842,"text":"Let's do this, Golden Comet, Silver Companion!","nextNodeIds":[745090132,745090133]},{"nodeId":745090132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":891715226,"text":"Alright!","nextNodeIds":[745090134]},{"nodeId":745090134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2660457442,"text":"After all this time, you're going up against Haniyyah again... Ooh, this is so exciting!","nextNodeIds":[745090135]},{"nodeId":745090135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":384484618,"text":"But this is a friendly match, so let's just have fun!","nextNodeIds":[]},{"nodeId":745090133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3840639754,"text":"It's on!","nextNodeIds":[745090134]},{"nodeId":745090126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1860902146,"text":"We can make new memories together.","nextNodeIds":[745090127]},{"nodeId":745090116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3289353866,"text":"Alas, so many people, and such hurry to lose...","nextNodeIds":[745090117]},{"nodeId":745090109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3782345018,"text":"How are the advertisements coming along?","nextNodeIds":[745090110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30419"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7450902,"order":99,"stepDescription":"Wait till 6:00 – 12:00 the next day","stepDescTextMapHash":3456344356,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"6,12"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"6,12"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":