{"mainQuestId":24002,"title":"Tales From the Court","description":"Isadora from the Court of Fontaine seems to have encountered some trouble...","titleTextMapHash":1695513991,"descTextMapHash":3036716686,"mainQuestExcel":{"mainQuestId":24002,"titleTextMapHash":1695513991,"title":"Tales From the Court","descTextMapHash":3036716686,"description":"Isadora from the Court of Fontaine seems to have encountered some trouble...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ24002","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3036716686,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":24002,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4111090329,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ24002","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":43030,"titleTextMapHash":1695513991,"type":"IQ","unlockDescTextMapHash":1344274030}},"flow":[{"subQuestId":2400201,"order":1,"stepDescription":"Talk to Isadora","stepDescTextMapHash":2078034924,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5005"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400201],"talks":[{"talkId":2400201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400201,"initDialog":240020101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5005],"performCfg":"QuestDialogue/IQ/Fontaine_24002/Q2400201","priority":5,"questId":24002,"showRandomTalkCount":0},"dialogs":[{"nodeId":240020101,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":2895888210,"text":"Huh. Where'd it go? What bad luck...","nextNodeIds":[240020102]},{"nodeId":240020102,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1818130210,"text":"Ugh. I won't be able to write another copy either...","nextNodeIds":[240020103]},{"nodeId":240020103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4209582714,"text":"Did you lose something?","nextNodeIds":[240020104]},{"nodeId":240020104,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1661122866,"text":"Well, I do hope that it was *only* lost — I do consider myself an optimist, after all.","nextNodeIds":[240020105,240020106]},{"nodeId":240020105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":672253266,"text":"Is that what you call optimism?","nextNodeIds":[240020107]},{"nodeId":240020107,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3594866386,"text":"Well... It might be when the thing you're looking for is the office semiannual expense ledger.","nextNodeIds":[240020108]},{"nodeId":240020108,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1827550306,"text":"This needed to go to Ms. Keiser sometime soon... But I suddenly discovered that the ledger was missing five pages.","nextNodeIds":[240020109]},{"nodeId":240020109,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":2569334146,"text":"These five pages are from five separate months and contain a great number of expenses.","nextNodeIds":[240020110]},{"nodeId":240020110,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1876660434,"text":"It was only in the final review that I noticed they were gone.","nextNodeIds":[240020111]},{"nodeId":240020111,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3280123770,"text":"If I had not accidentally misplaced them and instead never done them at all... then how did this final amount for our official expenses come about?","nextNodeIds":[240020112]},{"nodeId":240020112,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1839125058,"text":"Ugh, I daren't think about it. If I really did forget to write them, Ms. Cadme will almost certainly force me to dig up the ledgers from the last decade and make me check them again.","nextNodeIds":[240020113]},{"nodeId":240020113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":98651618,"text":"That sounds pretty serious...","nextNodeIds":[240020114]},{"nodeId":240020114,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1854248066,"text":"That's because it is! If the documents were not written or were lost, that means quite a few offices will have funding issues next month.","nextNodeIds":[240020115]},{"nodeId":240020115,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":4137492450,"text":"What rotten luck... I only remember pulling an all-nighter writing the ledger and bringing it to the Palais today.","nextNodeIds":[240020116]},{"nodeId":240020116,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1146242562,"text":"When I reached this spot, I was startled by a large flock of seagulls, and my hands loosened for a moment.","nextNodeIds":[240020117]},{"nodeId":240020117,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":270057170,"text":"*sigh* I might really have lost the documents during that time...","nextNodeIds":[240020118,240020119]},{"nodeId":240020118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3429495450,"text":"I'll help you search.","nextNodeIds":[240020120]},{"nodeId":240020120,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3683987626,"text":"You'd be willing to help? Wonderful! Come, let's follow this road first, then.","nextNodeIds":[240020121]},{"nodeId":240020121,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":2465412714,"text":"The data involved is not top secret or anything, so don't worry about accidentally seeing something when picking the sheets up.","nextNodeIds":[240020122]},{"nodeId":240020122,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1689345194,"text":"Ah, yes, I also met Officer Muirne at that time! She even chased the seagulls away for me.","nextNodeIds":[240020123]},{"nodeId":240020123,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":4109286498,"text":"We can ask her if she saw the ledger.","nextNodeIds":[]},{"nodeId":240020119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":760355426,"text":"Let's search together.","nextNodeIds":[240020120]},{"nodeId":240020106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1603581514,"text":"Is losing things a good thing?","nextNodeIds":[240020107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5005"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2400202,"order":2,"stepDescription":"Talk to Muirne","stepDescTextMapHash":3514423884,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400202],"talks":[{"talkId":2400202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400202,"initDialog":240020201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5045,5005],"performCfg":"QuestDialogue/IQ/Fontaine_24002/Q2400202","priority":5,"questId":24002,"showRandomTalkCount":0},"dialogs":[{"nodeId":240020201,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":1054685994,"text":"Ms. Isadora, is there something I can help you with?","nextNodeIds":[240020202]},{"nodeId":240020202,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3120306130,"text":"Officer Muirne, I have a question for you. Do you remember the stack of accounts I brought to the office this morning?","nextNodeIds":[240020203]},{"nodeId":240020203,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":4259547074,"text":"I remember that. You were attacked by a flock of Violetgold Angler Gulls as well, right?","nextNodeIds":[240020204]},{"nodeId":240020204,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":870305658,"text":"Yes, that's right! Once those annoying gulls flew away, I hurried over to my office.","nextNodeIds":[240020205]},{"nodeId":240020205,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3340570250,"text":"Do you recall if I left any sheets on the ground when I ran off?","nextNodeIds":[240020206]},{"nodeId":240020206,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":2442672498,"text":"Um... I can't remember. I was also busy with other work at the time...","nextNodeIds":[240020207]},{"nodeId":240020207,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":631197978,"text":"But if you need them urgently, we can \"reenact\" your path to the office.","nextNodeIds":[240020208]},{"nodeId":240020208,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1306627994,"text":"Eh? Could you, really? I... don't want to ask too much of you.","nextNodeIds":[240020209]},{"nodeId":240020209,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":2831601626,"text":"We're just looking for things — a much easier task than work at the Palais Mermonia, that's for sure.","nextNodeIds":[240020210]},{"nodeId":240020210,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":1413844490,"text":"I do recall that you had tied the documents you were carrying together into stacks. Is that correct?","nextNodeIds":[240020211]},{"nodeId":240020211,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3867970762,"text":"That's right. We need to be quite precise with our reports for cost review, after all. You've got a good eye, huh?","nextNodeIds":[240020212]},{"nodeId":240020212,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1302601594,"text":"Everything has to be listed, from large tasks like getting artisans to maintain the outer walls of the Palais, to small ones like changing a lock on a desk.","nextNodeIds":[240020213]},{"nodeId":240020213,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3778857090,"text":"That's how every month's expenses come up to a thick bundle that needs rope to tie together.","nextNodeIds":[240020214]},{"nodeId":240020214,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":895598170,"text":"In short, there's no way that a single sheet might have just flown off by itself — even though you had lost documents, you would have lost them stack by stack.","nextNodeIds":[240020215]},{"nodeId":240020215,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":1670300346,"text":"It hasn't been long since you got to the office, so let's set off now.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2400203,"order":3,"stepDescription":"Go and look for the documents Isadora lost","stepDescTextMapHash":2249381108,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400203,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400203,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2400204,"order":4,"stepDescription":"Talk to Isadora","stepDescTextMapHash":1631554348,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400204],"talks":[{"talkId":2400204,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400204,"initDialog":240020401,"nextRandomTalks":[],"nextTalks":[],"npcId":[5005,5045],"performCfg":"QuestDialogue/IQ/Fontaine_24002/Q2400204","priority":5,"questId":24002,"showRandomTalkCount":0},"dialogs":[{"nodeId":240020401,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1714226866,"text":"Ah, these are the documents I need! Oh, thank the Archon, they're all here!","nextNodeIds":[240020402]},{"nodeId":240020402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2710785282,"text":"Why were you doing accounts at the cafe?","nextNodeIds":[240020403]},{"nodeId":240020403,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":476665458,"text":"W—Well, I need lots of coffee to make sure I'm counting it all right.","nextNodeIds":[240020404]},{"nodeId":240020404,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":2473846818,"text":"This is the expenses of all the offices within the Palais, mind you — counting it up's supposed to be five people's work.","nextNodeIds":[240020405]},{"nodeId":240020405,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3236943082,"text":"But apart from me, everyone in the office is often being borrowed by some other office, sent out on work, or is busy with some visitation...","nextNodeIds":[240020406]},{"nodeId":240020406,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":3754943178,"text":"So when it came time to count expenses, it was just me doing it — I haven't slept in days!","nextNodeIds":[240020407]},{"nodeId":240020407,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":2169990010,"text":"Not only did the expenses need counting up, but even the settling of the bills got left to me. My vision's practically swimming over here...","nextNodeIds":[240020408]},{"nodeId":240020408,"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"Muirne","textMapHash":840637418,"text":"Regardless, it's good that we found those accounts. If you'll allow me, Ms. Isadora, I'll accompany you back to the Palais.","nextNodeIds":[240020409]},{"nodeId":240020409,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1985216210,"text":"Thank you, Officer Muirne. *sigh* I swear, you and the Traveler are the only two good souls I've met these last three months.","nextNodeIds":[240020410]},{"nodeId":240020410,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":2768093106,"text":"Everyone else is either yelling at me or pushing me to work.","nextNodeIds":[240020411]},{"nodeId":240020411,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"Isadora","textMapHash":1368515970,"text":"Ugh, no, no, I need to stop complaining. I need to go back, or Ms. Keiser's going to yell at me again...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["43030"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"u