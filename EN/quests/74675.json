{"mainQuestId":74675,"title":"The Arrival of a...!","description":"Mr. Petit Lumiere seems to have a unique understanding of films...","titleTextMapHash":3580318375,"descTextMapHash":3230348238,"mainQuestExcel":{"mainQuestId":74675,"titleTextMapHash":3580318375,"title":"The Arrival of a...!","descTextMapHash":3230348238,"description":"Mr. Petit Lumiere seems to have a unique understanding of films...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2027,"luaPath":"Actor/Quest/WQ74675","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2027,"chapterId":0,"descTextMapHash":3230348238,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74675,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":104879161,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74675","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174675],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3580318375,"type":"WQ","unlockDescTextMapHash":2868016870}},"flow":[{"subQuestId":7467501,"order":1,"stepDescription":"Talk to the staff member","stepDescTextMapHash":1179719156,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30488"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467501],"talks":[{"talkId":7467501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7467501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467501,"initDialog":746750101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30488],"performCfg":"QuestDialogue/WQ/Filmfest_74675/Q7467501","priority":5,"questId":74675,"showRandomTalkCount":0},"dialogs":[{"nodeId":746750101,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":1447441034,"text":"Great day, isn't it?","nextNodeIds":[746750102]},{"nodeId":746750102,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":3448023418,"text":"Someone as famous as you... I bet people are always handing you their business cards.","nextNodeIds":[746750103]},{"nodeId":746750103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":264005962,"text":"#Uh... You know us? {NICKNAME}, this kid's pretty sophisticated.","nextNodeIds":[746750104]},{"nodeId":746750104,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":2873504234,"text":"Holding another in contempt merely on account of their lack of years is a mistake only the most ignorant would make. I suspect the two of you are not quite so shallow as that.","nextNodeIds":[746750105]},{"nodeId":746750105,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":852281610,"text":"I didn't intend to flatter myself, but my elder brother and I are famous local film directors. Everyone calls me Mr. Petit Lumiere.","nextNodeIds":[746750106,746750107]},{"nodeId":746750106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3404232962,"text":"Hello.","nextNodeIds":[746750108]},{"nodeId":746750108,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":499275418,"text":"Correct! I am quite keen on learning more about your adventuring experiences. In my industry, extraordinary stories are always in demand.","nextNodeIds":[746750109]},{"nodeId":746750109,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":2057538922,"text":"As you appear not to be well acquainted with me, allow me to introduce myself.","nextNodeIds":[746750110]},{"nodeId":746750110,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":709172042,"text":"My elder brother and I have been working together to produce films for quite some time, and have already had quite a few blockbuster successes. Perhaps you've seen \"Employees Leaving the Factory\"...?","nextNodeIds":[746750111]},{"nodeId":746750111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2526467026,"text":"Nope.","nextNodeIds":[746750112]},{"nodeId":746750112,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":1445137890,"text":"Oh, that's okay. How about \"The Arrival of an Aquabus\"?","nextNodeIds":[746750113]},{"nodeId":746750113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2658663274,"text":"Haven't seen it either.","nextNodeIds":[746750114]},{"nodeId":746750114,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":1947304698,"text":"...","nextNodeIds":[746750115]},{"nodeId":746750115,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":1221799618,"text":"Ah, I see...","nextNodeIds":[746750116]},{"nodeId":746750116,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":469484458,"text":"...That is nothing too remarkable. The road to fame and stardom upon which we two brothers tread is yet long, and we will certainly make even more popular films in the future.","nextNodeIds":[746750117]},{"nodeId":746750117,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":334299602,"text":"Film production, constructing and planning narratives, the performances of actors, the cooperation between cameraman and director, and post-production and processing... All of it is a truly fascinating process.","nextNodeIds":[746750118]},{"nodeId":746750118,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":1718630146,"text":"And among all these, I believe that the process of filming itself is the most technically demanding.","nextNodeIds":[746750119]},{"nodeId":746750119,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":4191246290,"text":"What you choose to focus on while filming decides the information that will be conveyed to the audience, the atmosphere they will feel...","nextNodeIds":[746750120]},{"nodeId":746750120,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":1071240346,"text":"Of course, the narration is very important, but you cannot expect a story to rely on narration alone.","nextNodeIds":[746750121]},{"nodeId":746750121,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":2568229746,"text":"Four shots! I've always believed that you only need four shots to construct the smallest divisible unit of a story.","nextNodeIds":[746750122]},{"nodeId":746750122,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":3577988514,"text":"Within just these four shots, a genius can work miracles.","nextNodeIds":[746750123]},{"nodeId":746750123,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":2313899170,"text":"Would the two of you like to try? Seize this opportunity to revel in the glamor and charm of filmmaking!","nextNodeIds":[746750124]},{"nodeId":746750124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":495660698,"text":"So, what should we do?","nextNodeIds":[746750125]},{"nodeId":746750125,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":4150783650,"text":"It is simple! I will provide you with a few simple themes that have already been formulated into short scenes.","nextNodeIds":[746750126]},{"nodeId":746750126,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":4211444466,"text":"The important thing is to try out different ways of handling both the narration and the Kamera, and combining them to film a few short scenes. Are the two of you interested?","nextNodeIds":[746750127]},{"nodeId":746750127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":74049770,"text":"Our interest has been piqued.","nextNodeIds":[746750128]},{"nodeId":746750128,"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","textMapHash":389100370,"text":"Marvelous! Then, once the two of you are ready, you may go to the filming locations I have already prepared. I will give you feedback on your finished products.","nextNodeIds":[]},{"nodeId":746750107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2070267754,"text":"Do you plan on giving us your business card as well?","nextNodeIds":[746750108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30488"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30488,"speakerName":"Petit Lumiere","count":21},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174675],"BHCBFLFOGJN":0,"BP