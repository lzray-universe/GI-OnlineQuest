{"mainQuestId":74502,"title":"The Toy War: An Armistice","description":"Will the battle between clockwork workshop and clock shop, the wall between two brothers, dissolve when the two bosses meet? Or will the conflict grow more intense?","titleTextMapHash":2276378919,"descTextMapHash":561469038,"mainQuestExcel":{"mainQuestId":74502,"titleTextMapHash":2276378919,"title":"The Toy War: An Armistice","descTextMapHash":561469038,"description":"Will the battle between clockwork workshop and clock shop, the wall between two brothers, dissolve when the two bosses meet? Or will the conflict grow more intense?","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":2024,"luaPath":"Actor/Quest/WQ74502","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2024,"chapterId":0,"descTextMapHash":561469038,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74502,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3907491369,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74502","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174502],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2276378919,"type":"WQ","unlockDescTextMapHash":3007858598}},"flow":[{"subQuestId":7450203,"order":1,"stepDescription":"Wait until two days later","stepDescTextMapHash":3679404500,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7450201,"order":2,"stepDescription":"Go to Lepaute Horlogerie","stepDescTextMapHash":901109084,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5029"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7450201],"talks":[{"talkId":7450201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7450201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450201,"initDialog":745020101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5029,5024],"performCfg":"QuestDialogue/WQ/Fontaine_74502/Q7450201","priority":5,"questId":74502,"showRandomTalkCount":0},"dialogs":[{"nodeId":745020101,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3759288098,"text":"I see you're doing well, Caron.","nextNodeIds":[745020102]},{"nodeId":745020102,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":540032794,"text":"B—Brother? What are you doing here?","nextNodeIds":[745020103]},{"nodeId":745020103,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3503751954,"text":"We haven't seen each other in so long, and THAT'S what you chose to say?","nextNodeIds":[745020104]},{"nodeId":745020104,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":730649210,"text":"I—I just didn't expect you to come over to see me. I mean, our shops are quite close together, but you never came over. I thought you were still angry with me...","nextNodeIds":[745020105]},{"nodeId":745020105,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3300367154,"text":"I'm not here to talk to you about what happened before. I'm just going to ask you this: that adventurer toy was made because of me, right?","nextNodeIds":[745020106]},{"nodeId":745020106,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":2547279282,"text":"Ah? Uh... *sigh*","nextNodeIds":[745020107]},{"nodeId":745020107,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3887070026,"text":"I knew I wouldn't be able to hide anything from you.","nextNodeIds":[745020108]},{"nodeId":745020108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2352323970,"text":"W—Wait, now Paimon's confused. Wasn't that toy inspired by Bennett?","nextNodeIds":[745020109]},{"nodeId":745020109,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":488336090,"text":"Ah, I see you two have arrived as well... I'm sorry for not explaining previously, but I didn't know where to begin...","nextNodeIds":[745020110]},{"nodeId":745020110,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":1064037018,"text":"Although that adventurer did give me critical inspiration, my brother was the real reason I insisted on having the toy made.","nextNodeIds":[745020111,745020170]},{"nodeId":745020111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4285613170,"text":"I can see why it might be complicated for you.","nextNodeIds":[745020112]},{"nodeId":745020112,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":10510722,"text":"Caron, your mawkishness hasn't changed one bit.","nextNodeIds":[745020113]},{"nodeId":745020113,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3674331850,"text":"You haven't changed either, brother. I'm more and more convinced that you and that adventurer are the same type of person.","nextNodeIds":[745020114]},{"nodeId":745020114,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":2144956666,"text":"I don't have a Vision, nor am I an adventurer.","nextNodeIds":[745020115]},{"nodeId":745020115,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3124873842,"text":"But you have that same adventurous spirit. Bennett lives in an adventure, while you live for adventure.","nextNodeIds":[745020116]},{"nodeId":745020116,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3949761530,"text":"Did you pick that flattery up from me too?","nextNodeIds":[745020117]},{"nodeId":745020117,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":4074721986,"text":"How can that be? You've never been a flatterer — you've never hesitated to tell me that I haven't any fighting spirit. And while the truth is frustrating, it is the truth nonetheless.","nextNodeIds":[745020118]},{"nodeId":745020118,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3090855946,"text":"You've always been trying to be the best toy merchant ever, but I acceded to the family's arrangements, continuing the cycle of clockmaking.","nextNodeIds":[745020119]},{"nodeId":745020119,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":2922746546,"text":"Only people like you and Bennett could turn their passions into their profession. I cannot — it would take a hundred of me to match your courage.","nextNodeIds":[745020120]},{"nodeId":745020120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":182105650,"text":"C'mon, don't say that about yourself!","nextNodeIds":[745020121]},{"nodeId":745020121,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":1299220162,"text":"There's no point in hiding this... When my brother first stated his intentions to move his shop next to mine, my first reaction was to consider moving the shop. Father would be ashamed, and rightly so.","nextNodeIds":[745020122]},{"nodeId":745020122,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":2907428562,"text":"But in the end, the Northland Bank took that spot and separated us. A happy coincidence again, you could say.","nextNodeIds":[745020123]},{"nodeId":745020123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":841610210,"text":"Yeah, Arbon told us about it.","nextNodeIds":[745020124]},{"nodeId":745020124,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1428520882,"text":"Hmph. Do you really think the world is so full of happy coincidences? That the Northland Bank just so happened to come between us at that time?","nextNodeIds":[745020125]},{"nodeId":745020125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4183119786,"text":"What do you mean, Livre?","nextNodeIds":[745020126]},{"nodeId":745020126,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":211586162,"text":"I had reserved that spot long ago, but a new idea struck me, and so I transferred it to them for a low price. This didn't just come out of nowhere, you know.","nextNodeIds":[745020127]},{"nodeId":745020127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3819418418,"text":"So you were the one who got them involved! Huh. Did you think that your previous decision was too impulsive or something?","nextNodeIds":[745020128]},{"nodeId":745020128,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":2096848298,"text":"Ever since I left, my goal has always been to be the greatest toy merchant. But what sort of greatness would that be if the family feud made my brother move away in the process, huh?","nextNodeIds":[745020129]},{"nodeId":745020129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2239131090,"text":"Hehehe, that smells like concern to Paimon! You were just making excuses when you said you wanted Caron to apologize, weren't you?","nextNodeIds":[745020130]},{"nodeId":745020130,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":1425160138,"text":"A—Apologize?","nextNodeIds":[745020131]},{"nodeId":745020131,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1710314642,"text":"What \"apologize\"? Did I ever say that?","nextNodeIds":[745020132]},{"nodeId":745020132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3551334578,"text":"Wow, that's a really earnest denial, considering that you actually did say it!","nextNodeIds":[745020133]},{"nodeId":745020133,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1781506482,"text":"Hmph. I'm here to congratulate you, Caron. That toy... is quite well-made.","nextNodeIds":[745020134]},{"nodeId":745020134,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":4052690154,"text":"Heh. It's been such a long time since I last heard a word of praise from you, brother. I didn't think that...","nextNodeIds":[745020135]},{"nodeId":745020135,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3995311858,"text":"I've also brought you a gift: here's the data I had these two adventurers gather over the last few days. This should help you create something even more interesting.","nextNodeIds":[745020136]},{"nodeId":745020136,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":1319314034,"text":"Huh? But weren't you going to make toy Champion Duelists? That data's important to you, isn't it?","nextNodeIds":[745020137]},{"nodeId":745020137,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3778263490,"text":"That plan's suspended. The market shifted faster than I thought, so some ad-hoc adjustments will be necessary.","nextNodeIds":[745020138]},{"nodeId":745020138,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3394771002,"text":"But... This data... How could I just take it?","nextNodeIds":[745020139]},{"nodeId":745020139,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":413902746,"text":"You take it when I give it to you, obviously!","nextNodeIds":[745020140]},{"nodeId":745020140,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":1455095482,"text":"*sigh* In that case, I'll take it... for safe-keeping. Feel free to reclaim it, should you ever need it again.","nextNodeIds":[745020141]},{"nodeId":745020141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3157044010,"text":"Huh, so Livre's \"other plan\" was to give the data to his brother.","nextNodeIds":[745020142]},{"nodeId":745020142,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1153935234,"text":"I apologize, dear customers, that I did not ask for your suggestions first before doing this.","nextNodeIds":[745020143]},{"nodeId":745020143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1812404322,"text":"#Oh, it's fine. You paid us, didn't you? And this is your personal matter. This was totally worth it if your relationship with your brother can be improved, right, {NICKNAME}?","nextNodeIds":[745020144,745020145]},{"nodeId":745020144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":139327298,"text":"Our thoughts are aligned in this, indeed.","nextNodeIds":[745020146]},{"nodeId":745020146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3677676722,"text":"Hehe. Guess this was a successful third party intervention!","nextNodeIds":[745020147]},{"nodeId":745020147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":634638178,"text":"Oh, right. Livre, Caron, since we're all here...","nextNodeIds":[745020148]},{"nodeId":745020148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1592473114,"text":"Why don't you strike while the iron's hot and work together on something? You're good at making stuff, Caron, and we can have Livre do the advertising! If you do it as a team, it's sure to work out!","nextNodeIds":[745020149]},{"nodeId":745020149,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3557336098,"text":"I appreciate your good intentions, but there's no need.","nextNodeIds":[745020150]},{"nodeId":745020150,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":1545816178,"text":"Hmm... I feel the same way.","nextNodeIds":[745020151]},{"nodeId":745020151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2180903938,"text":"Wait, so this is what you two are gonna agree on!?","nextNodeIds":[745020152]},{"nodeId":745020152,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":217370674,"text":"That Bennett fellow said this too, didn't he? \"The world is full of all sorts of people.\"","nextNodeIds":[745020153]},{"nodeId":745020153,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3558073874,"text":"So you did remember that part.","nextNodeIds":[745020154]},{"nodeId":745020154,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":993201602,"text":"\"The world is full of all sorts of people, and they all have sights that only they can see.\" If I learned anything from him at all, this would be it.","nextNodeIds":[745020155]},{"nodeId":745020155,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3210717274,"text":"Caron and I are just different people, which is why we've set out on different paths. Perhaps he thinks that my path is too adventurous, and I for my part can't stand the kind of placid existence he leads.","nextNodeIds":[745020156]},{"nodeId":745020156,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":200247762,"text":"That's right. If the hour hand does the minute hand's work, it will get fired without compensation the next day.","nextNodeIds":[745020157]},{"nodeId":745020157,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3416782962,"text":"And while intense challenges are an adventure, is a simple life not one as well? Everyone's on their own journey of adventure.","nextNodeIds":[745020158]},{"nodeId":745020158,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1282260522,"text":"So, since we've each chosen our direction, let's walk down that path and seek our own unique sights.","nextNodeIds":[745020159]},{"nodeId":745020159,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3905167338,"text":"And I'll occasionally go meet with you. After all, your road will be quite difficult.","nextNodeIds":[745020160]},{"nodeId":745020160,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":53628074,"text":"Pfft, don't you worry about me. At least I know how to enlist third parties to help me out of jams. I didn't sit around waiting for these adventurers or the Northland Bank, let me tell you that.","nextNodeIds":[745020161]},{"nodeId":745020161,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":1966587546,"text":"And what will you do when there's a problem that even a third-party can't solve? I'm sure you know how the stiffer a gear is, the less durable it will be. I worry that...","nextNodeIds":[745020162]},{"nodeId":745020162,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3088294314,"text":"And if we meet, we'll meet! What else can we do, huh? That's just life.","nextNodeIds":[745020163]},{"nodeId":745020163,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":3785202002,"text":"No. You won't be defeated by life, just like Bennett. And if things prove otherwise...","nextNodeIds":[745020164]},{"nodeId":745020164,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1911612306,"text":"Yeah?","nextNodeIds":[745020165]},{"nodeId":745020165,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":882728842,"text":"I'll send you flying with a knuckle sandwich.","nextNodeIds":[745020166]},{"nodeId":745020166,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3511501002,"text":"Hah, brat, listen to yourself, talking to your big brother like that. Don't get too cocky!","nextNodeIds":[745020167]},{"nodeId":745020167,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1010395450,"text":"Well, if Lady Furina can sit at the judges' desk for a while, then a little brother can borrow his big brother's lines, right?","nextNodeIds":[745020168]},{"nodeId":745020168,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":158234466,"text":"Haha, I see you're figuring us Fontainians out. I'd like to ask you something, so if you're free, let's meet outside my shop later.","nextNodeIds":[745020169]},{"nodeId":745020169,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3726263650,"text":"That's all I have to say today, Caron. I'll be heading back now.","nextNodeIds":[]},{"nodeId":745020145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3251940962,"text":"We're honest businessmen, too.","nextNodeIds":[745020146]},{"nodeId":745020170,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1997145226,"text":"I don't really get what was so difficult about all this.","nextNodeIds":[745020171]},{"nodeId":745020171,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":889927922,"text":"That's on my brother for twisting himself about into loops over everything.","nextNodeIds":[745020113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5029"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7450202,"order":3,"stepDescription":"Talk to Livre, the shop owner","stepDescTextMapHash":1043163244,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5029"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7450202,7450203],"talks":[{"talkId":7450202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7450202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450202,"initDialog":745020201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5029],"performCfg":"QuestDialogue/WQ/Fontaine_74502/Q7450202","priority":5,"questId":74502,"showRandomTalkCount":0},"dialogs":[{"nodeId":745020201,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":550772154,"text":"You're here.","nextNodeIds":[745020202]},{"nodeId":745020202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2517080282,"text":"Well, you seem to be in a good mood.","nextNodeIds":[745020203]},{"nodeId":745020203,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":855134442,"text":"Thanks to your help. Speaking of which, Caron's trip to Mondstadt gave me an idea.","nextNodeIds":[745020204]},{"nodeId":745020204,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3346339794,"text":"Perhaps I should go travel around for a bit and find some inspiration for toys myself.","nextNodeIds":[745020205]},{"nodeId":745020205,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":60625194,"text":"You've traveled the world. You probably know some friends like that Bennett. Do you have any suggestions for me?","nextNodeIds":[745020206]},{"nodeId":745020206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3961270730,"text":"Well, we do have a lot of friends, but when it comes to toy inspiration, that might be a bit tough...","nextNodeIds":[745020207]},{"nodeId":745020207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3915605290,"text":"Why not look for a third party?","nextNodeIds":[745020208]},{"nodeId":745020208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3901901882,"text":"Eh? We're a valid third party, aren't we?","nextNodeIds":[745020209]},{"nodeId":745020209,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":699878338,"text":"Are you referring to... the Northland Bank?","nextNodeIds":[745020210]},{"nodeId":745020210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2390626794,"text":"Oh, you meant the previous third party! Oh, let Paimon think... The Northland Bank's under the Fatui, and the Fatui are under...","nextNodeIds":[745020211]},{"nodeId":745020211,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":3368426330,"text":"Are you referring to a Harbinger? Do you mean that we can make a toy themed after a Harbinger?","nextNodeIds":[745020212]},{"nodeId":745020212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1330706570,"text":"#...Huh! {NICKNAME}, do you mean... Oh, Paimon gets it.","nextNodeIds":[745020213]},{"nodeId":745020213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2458408162,"text":"Hehe, Livre, did you know that there's a very special Harbinger, whom they call the—","nextNodeIds":[745020214]},{"nodeId":745020214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3633305538,"text":"\"The greatest toy salesman in Snezhnaya\"!","nextNodeIds":[745020215]},{"nodeId":745020215,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":545479354,"text":"What? Is there such a person?","nextNodeIds":[745020216]},{"nodeId":745020216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3208460930,"text":"Of course, and he's a real expert, too! Maybe he'll inspire you... and y'know, a toy merchant and a seller would make a pretty awesome combo, don't you think?","nextNodeIds":[745020217]},{"nodeId":745020217,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1638952786,"text":"Thanks for your suggestions — they've been very helpful.","nextNodeIds":[745020218]},{"nodeId":745020218,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":4273706282,"text":"I don't think it would be easy to get in contact with a Harbinger, but I do have some connections at the Northland Bank. I'll see what I can do.","nextNodeIds":[745020219]},{"nodeId":745020219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":634067410,"text":"Hehe. Don't forget to invite us to try whatever new toy you come up with!","nextNodeIds":[745020220]},{"nodeId":745020220,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","textMapHash":1472309770,"text":"I will. Keep an ear out for news from me!","nextNodeIds":[]}]},{"talkId":7450203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7450202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450203,"initDialog":745020301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5024],"performCfg":"QuestDialogue/WQ/Fontaine_74502/Q7450203","priority":5,"questId":74502,"showRandomTalkCount":0},"dialogs":[{"nodeId":745020301,"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","textMapHash":746356826,"text":"Haven't gone back, have you? Well, I must thank you — I'm sure father would be pleased that my brother and I finally spoke.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5029"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7450201,7450202,7450203],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"Livre","count":38},{"roleType":"TALK_ROLE_NPC","speakerId":5024,"speakerName":"Caron","count":26},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":22},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174502],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":561469038,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74502/Q7450201","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHM