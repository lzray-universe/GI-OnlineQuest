{"mainQuestId":71149,"title":"Bright Moon, Lantern Glow","description":"The people in Liyue Harbor are celebrating Lantern Rite, and a Ministry of Civil Affairs employee named Pingxi seems to be responsible for welcoming visitors...","titleTextMapHash":592810823,"descTextMapHash":2852219342,"mainQuestExcel":{"mainQuestId":71149,"titleTextMapHash":592810823,"title":"Bright Moon, Lantern Glow","descTextMapHash":2852219342,"description":"The people in Liyue Harbor are celebrating Lantern Rite, and a Ministry of Civil Affairs employee named Pingxi seems to be responsible for welcoming visitors...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2045,"luaPath":"Actor/Quest/WQ71149","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2045,"chapterId":0,"descTextMapHash":2852219342,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71149,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1595176601,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71149","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171149],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[71168],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":592810823,"type":"WQ","unlockDescTextMapHash":2295924750}},"flow":[{"subQuestId":7114901,"order":1,"stepDescription":"Talk to Pingxi","stepDescTextMapHash":2992598404,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7114901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30924"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7114901],"talks":[{"talkId":7114901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7114901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7114901,"initDialog":711490101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30924],"performCfg":"QuestDialogue/WQ/Liyue_71149/Q7114901","priority":5,"questId":71149,"showRandomTalkCount":0},"dialogs":[{"nodeId":711490101,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3039214682,"text":"The arrangements this year came together pretty nicely. Phew... At least I don't have to trouble Lady Keqing to come and review personally.","nextNodeIds":[711490116]},{"nodeId":711490116,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":211884258,"text":"Ugh! I've got to stop dwelling on these things! I'm the God of Fortune I'm the God of Fortune I'm the God of Fortune...","nextNodeIds":[711490103]},{"nodeId":711490103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":995249258,"text":"And you are...?","nextNodeIds":[711490117]},{"nodeId":711490117,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":2364516922,"text":"I'm the God of Fortune!","nextNodeIds":[711490118,711490119]},{"nodeId":711490118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1274507850,"text":"I... I can tell...","nextNodeIds":[711490120]},{"nodeId":711490120,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":194200570,"text":"#Huh? Isn't this {NICKNAME}? Goodness, if I'd known you were the one coming, I wouldn't have to memorize so many lines...","nextNodeIds":[711490121]},{"nodeId":711490121,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3393560490,"text":"And given the looks of you, I presume that you are here to celebrate Lantern Rite?","nextNodeIds":[711490122]},{"nodeId":711490122,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3315507026,"text":"It's about time you showed up! Look around — it's even more lively than last year's Lantern Rite, isn't it?","nextNodeIds":[711490123,711490124]},{"nodeId":711490123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3985884970,"text":"Every Lantern Rite...","nextNodeIds":[711490125]},{"nodeId":711490125,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3060310074,"text":"Of course! You know what they say, \"Xiao Lanterns soar and fill the night, step by step we seek new heights!\" We've gotta improve in everything we do.","nextNodeIds":[711490126]},{"nodeId":711490126,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":2184119634,"text":"Aiya, let's not dwell on that during the festivities. Come come, let me show you where the fun happens.","nextNodeIds":[711490127]},{"nodeId":711490127,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3540618506,"text":"Let me think... Hm... Got it! First things first — you have to release Xiao Lanterns. It's Lantern Rite after all.","nextNodeIds":[711490128]},{"nodeId":711490128,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":1432741098,"text":"And then, we also set up a bunch of Auspicious Treasure Trees around Liyue Harbor. As long as you prune their branches properly, the Fortune Coins inside are yours.","nextNodeIds":[711490129]},{"nodeId":711490129,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3454300090,"text":"How many trees did we put out again...? Was it 21? Yes, 21 trees.","nextNodeIds":[711490130]},{"nodeId":711490130,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":2835725954,"text":"Actually, there's an Auspicious Treasure Tree not too far away! If you're interested, you can help to prune it. Don't worry, it's very simple.","nextNodeIds":[711490131]},{"nodeId":711490131,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":372023498,"text":"And finally, you can also check out the Bulletin Board. It's right beside me.","nextNodeIds":[711490132]},{"nodeId":711490132,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3465927554,"text":"Many tourists from other nations have joined us for Lantern Rite in the recent years, so the Ministry of Civil Affairs prepared a special Bulletin Board for them.","nextNodeIds":[711490102]},{"nodeId":711490102,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":1482726674,"text":"Whatever issues they run into, or if there's anything they need help with, they can write it down and post it on the Bulletin Board.","nextNodeIds":[711490133]},{"nodeId":711490133,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3003784746,"text":"We at the Ministry of Civil Affairs will make sure everyone who comes to Liyue for Lantern Rite leaves with a smile, hehe!","nextNodeIds":[711490134,711490135]},{"nodeId":711490134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1832684282,"text":"That's the Ministry of Civil Affairs for you.","nextNodeIds":[711490136]},{"nodeId":711490136,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3182100594,"text":"Of course!","nextNodeIds":[711490137]},{"nodeId":711490137,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":4051877554,"text":"#By the way, {NICKNAME}, I remember you're really good at taking pictures, aren't you?","nextNodeIds":[711490138,711490139]},{"nodeId":711490138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":577981330,"text":"I know a little.","nextNodeIds":[711490140]},{"nodeId":711490140,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3798086546,"text":"Hahaha, don't be so modest. I just wanted to... ask you for a little favor.","nextNodeIds":[711490141]},{"nodeId":711490141,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":4102881018,"text":"It's really simple, I promise! All you have to do is take a commemorative photo for some tourists.","nextNodeIds":[711490142]},{"nodeId":711490142,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3898470682,"text":"We originally hired a few photographers to take commemorative photos for everyone, but we didn't expect that there would be so many tourists this year. There suddenly weren't enough photographers to go around.","nextNodeIds":[711490143]},{"nodeId":711490143,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":1742991906,"text":"#It's too late to hire new photographers... You're the only one I can count on, {NICKNAME}!","nextNodeIds":[711490144]},{"nodeId":711490144,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":2854108402,"text":"Please! For the tourists, for Lantern Rite, for Liyue! You're the only one who can help us!","nextNodeIds":[711490145,711490146]},{"nodeId":711490145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3730697514,"text":"Leave it to me!","nextNodeIds":[711490147]},{"nodeId":711490147,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":1428983642,"text":"#You're a lifesaver, {NICKNAME}! I'll tell you the tourists' names and their designated locations right away.","nextNodeIds":[711490148]},{"nodeId":711490148,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":533923610,"text":"I'm counting on you! With your help, this year's Lantern Rite will be flawless.","nextNodeIds":[711490149]},{"nodeId":711490149,"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","textMapHash":3907887074,"text":"Here, these Xiao Lanterns are for you! Hehe, Happy Lantern Rite!","nextNodeIds":[]},{"nodeId":711490146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1371494474,"text":"For Lantern Rite!","nextNodeIds":[711490147]},{"nodeId":711490139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3415274874,"text":"Nope, I'm a complete rookie.","nextNodeIds":[711490140]},{"nodeId":711490135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":452713434,"text":"That's Liyue for you...","nextNodeIds":[711490136]},{"nodeId":711490124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2514588698,"text":"Feels more impressive than the year before...","nextNodeIds":[711490125]},{"nodeId":711490119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1299852058,"text":"That's a very auspicious outfit...","nextNodeIds":[711490120]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7114901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30924"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7114901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30924,"speakerName":"Pingxi","count":26},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":11}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171149],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2852219342,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":