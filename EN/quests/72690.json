{"mainQuestId":72690,"title":"The Floral Courtyard: Part IV","description":"Amidst the Irodori Festival, the florist Fushizome is looking for someone to experience the art of ikebana.","titleTextMapHash":2897568327,"descTextMapHash":698343638,"mainQuestExcel":{"mainQuestId":72690,"titleTextMapHash":2897568327,"title":"The Floral Courtyard: Part IV","descTextMapHash":698343638,"description":"Amidst the Irodori Festival, the florist Fushizome is looking for someone to experience the art of ikebana.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2012,"luaPath":"Actor/Quest/WQ72690","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2012,"chapterId":0,"descTextMapHash":698343638,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72690,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":752176825,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72690","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172690],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2897568327,"type":"WQ","unlockDescTextMapHash":1165920334}},"flow":[{"subQuestId":7269001,"order":1,"stepDescription":"Wait till the next morning (08:00 – 12:00) and talk to Fushizome","stepDescTextMapHash":1189152972,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"8,12"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7269003],"talks":[{"talkId":7269003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7269003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7269001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269003,"initDialog":726870201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30171],"performCfg":"QuestDialogue/WQ/Inazuma_72687/Q7268702","priority":5,"questId":72690,"showRandomTalkCount":0},"dialogs":[{"nodeId":726870201,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2434204082,"text":"In the following days, I will continue to stay here and guide those who come for the Irodori Festival, and help them to enjoy the beauty of the \"floral courtyards.\"","nextNodeIds":[726870202]},{"nodeId":726870202,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":151836690,"text":"Don't forget to drop by every day to get another \"theme.\" There will be a total of four such themes for you to figure out.","nextNodeIds":[726870203]},{"nodeId":726870203,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":845616874,"text":"Of course, if you have any other questions, I will do my best to answer them for you.","nextNodeIds":[726870204,726870210,726870222]},{"nodeId":726870204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4206709530,"text":"About the flowers here...","nextNodeIds":[726870205]},{"nodeId":726870205,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":919871594,"text":"The flowers I use are all provided by Sakuya's Flowers. The flowers they grow are of impeccable quality and affordable prices.","nextNodeIds":[726870206]},{"nodeId":726870206,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1719476458,"text":"Perhaps you've met Sakuya as well. We once studied ikebana under the same master.","nextNodeIds":[726870207]},{"nodeId":726870207,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3009817834,"text":"Sakuya is also very well-studied in the floral arts, but when she heard that there would be tons of people at the Irodori Festival, she seemed to have gotten a bit of stage fright. She said that it would be difficult to quiet down and focus on her work in such an environment.","nextNodeIds":[726870208]},{"nodeId":726870208,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2499178986,"text":"In any case, I will advertise Sakuya's Flowers on her behalf.","nextNodeIds":[726870209]},{"nodeId":726870209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2082577922,"text":"We can help too if you need us!","nextNodeIds":[726870219]},{"nodeId":726870219,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1010027682,"text":"Well then, do the two of you have any other questions?","nextNodeIds":[726870220]},{"nodeId":726870220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3067219490,"text":"Thank you, Ms. Fushizome.","nextNodeIds":[726870221]},{"nodeId":726870221,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":139603770,"text":"Think nothing of it. If you have time, you can come and look for me any time.","nextNodeIds":[]},{"nodeId":726870210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1503724594,"text":"About the Yashiro Commission's involvement...","nextNodeIds":[726870211]},{"nodeId":726870211,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2797110330,"text":"The Yashiro Commission has always been very supportive of Inazuma's floral arts. Indeed, the person who sponsored this event is the Shirasagi Himegimi.","nextNodeIds":[726870212]},{"nodeId":726870212,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2496297666,"text":"She has always been incredibly talented in these arts, even from a young age. I saw her perform ikebana once, and even had the honor of exchanging pointers with her.","nextNodeIds":[726870213]},{"nodeId":726870213,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1508383266,"text":"Although I'm older than her, I'm nowhere near her ability in terms of skill in ikebana or understanding of the floral arts.","nextNodeIds":[726870214]},{"nodeId":726870214,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1416659450,"text":"Where circumstances have permitted, she has provided funding to help publicize ikebana every year. I've even heard that she has used her own savings to do so...","nextNodeIds":[726870215]},{"nodeId":726870215,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2580369618,"text":"She once expressed her frank desire for more people to understand ikebana and to drum up more interest in it such that more might want to practice this art.","nextNodeIds":[726870216]},{"nodeId":726870216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1890863482,"text":"Huh. So Ayaka did so much for Inazuma's floral arts...","nextNodeIds":[726870217]},{"nodeId":726870217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3694582458,"text":"I hope her wish comes true.","nextNodeIds":[726870218]},{"nodeId":726870218,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1842969362,"text":"Thank you both. You are indeed good-hearted people.","nextNodeIds":[726870219]},{"nodeId":726870222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1782352058,"text":"I have no further questions at the moment.","nextNodeIds":[726870223]},{"nodeId":726870223,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3508514954,"text":"Alright, then. You can come and look for me any time.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"8,12"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7269002,"order":2,"stepDescription":"Talk to Fushizome","stepDescTextMapHash":1571320412,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269002,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30171"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7269001],"talks":[{"talkId":7269001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7269002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269001,"initDialog":726900101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30171],"performCfg":"QuestDialogue/WQ/Inazuma_72690/Q7269001","priority":5,"questId":72690,"showRandomTalkCount":0},"dialogs":[{"nodeId":726900101,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3094680970,"text":"The day has finally arrived, you two.","nextNodeIds":[726900102]},{"nodeId":726900102,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":607847922,"text":"You have already grasped the essence of the composition of floral courtyards.","nextNodeIds":[726900103]},{"nodeId":726900103,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1005275050,"text":"Now, it's time for a real test of your floral art mastery.","nextNodeIds":[726900104]},{"nodeId":726900104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2585777826,"text":"Eh? We've already grasped the essence of it?","nextNodeIds":[726900105]},{"nodeId":726900105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3569534130,"text":"And \"real test,\" you say... So this is gonna be the hardest theme, right? Ohh, Paimon's getting kinda worried.","nextNodeIds":[726900106]},{"nodeId":726900106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":435802410,"text":"We haven't spent that long doing ikebana, to be honest.","nextNodeIds":[726900107]},{"nodeId":726900107,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2783220962,"text":"Yes, it is true that the act of processing the flowers must be practiced over a great length of time. However, the planning and structuring of floral courtyards is more dependent on awareness and inspiration.","nextNodeIds":[726900108]},{"nodeId":726900108,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1299154442,"text":"If we're merely talking about the latter, the two of you have displayed stunning talent. I do not believe that you need any further refinement via thematic quizzes.","nextNodeIds":[726900109]},{"nodeId":726900109,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2139881282,"text":"Or perhaps I should say that it must be your fascinating travels and the sights you've seen, the likes of which I could never imagine, that has conferred this unique mindscape upon you.","nextNodeIds":[726900110]},{"nodeId":726900110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3808922658,"text":"Huh. Is... is that so...","nextNodeIds":[726900111]},{"nodeId":726900111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3101593130,"text":"#Speaking of which, {NICKNAME}, we really have been to lots of places and seen loads of things. To think that would've given us so much inspiration...","nextNodeIds":[726900112]},{"nodeId":726900112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2756778786,"text":"Paimon wonders how much of it we've spent on learning this art?","nextNodeIds":[726900113,726900114]},{"nodeId":726900113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3907299690,"text":"Don't worry, our journey will continue.","nextNodeIds":[726900115]},{"nodeId":726900115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2073126634,"text":"Ooh, that's true.","nextNodeIds":[726900116]},{"nodeId":726900116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1947795882,"text":"Thanks so much, Ms. Fushizome! If it wasn't for your guidance, we wouldn't have discovered this hidden talent of ours at all!","nextNodeIds":[726900117]},{"nodeId":726900117,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1112072930,"text":"Haha. You're too kind. Well then, let us close this journey off with the loveliest floral courtyard of them all.","nextNodeIds":[726900118,726900122]},{"nodeId":726900118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3556382538,"text":"Alright, hit us with the topic.","nextNodeIds":[726900119]},{"nodeId":726900119,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3120222042,"text":"Indeed. Today's theme is...","nextNodeIds":[726900120]},{"nodeId":726900120,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":4265833466,"text":"\"The branches, curved like rainbows, are dyed in myriad colors.\"","nextNodeIds":[726900121]},{"nodeId":726900121,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1857415210,"text":"Well then, I look forward to your greatest work.","nextNodeIds":[]},{"nodeId":726900122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":862395922,"text":"I've got some other things to do at the moment...","nextNodeIds":[726900123]},{"nodeId":726900123,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":496379146,"text":"That's alright. Ikebana requires one's full attention, after all.","nextNodeIds":[726900124]},{"nodeId":726900124,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3358082306,"text":"Once you have completed the various tasks you have on hand, rendering yourself free of disturbances, I'm certain that your floral courtyard shall be all the more perfect for it.","nextNodeIds":[]},{"nodeId":726900114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":363469474,"text":"Inspiration will keep on coming.","nextNodeIds":[726900115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269002,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30171"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7269003,"order":3,"stepDescription":"Complete the floral theme","stepDescTextMapHash":1464156892,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4,0],"PAINLIBBLDK":"QUEST_CONTENT_IRODORI_FINISH_FLOWER_COMBINATION","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q72690"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7269003],"talks":[{"talkId":7269003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7269003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7269001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269003,"initDialog":726870201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30171],"performCfg":"QuestDialogue/WQ/Inazuma_72687/Q7268702","priority":5,"questId":72690,"showRandomTalkCount":0},"dialogs":[{"nodeId":726870201,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2434204082,"text":"In the following days, I will continue to stay here and guide those who come for the Irodori Festival, and help them to enjoy the beauty of the \"floral courtyards.\"","nextNodeIds":[726870202]},{"nodeId":726870202,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":151836690,"text":"Don't forget to drop by every day to get another \"theme.\" There will be a total of four such themes for you to figure out.","nextNodeIds":[726870203]},{"nodeId":726870203,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":845616874,"text":"Of course, if you have any other questions, I will do my best to answer them for you.","nextNodeIds":[726870204,726870210,726870222]},{"nodeId":726870204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4206709530,"text":"About the flowers here...","nextNodeIds":[726870205]},{"nodeId":726870205,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":919871594,"text":"The flowers I use are all provided by Sakuya's Flowers. The flowers they grow are of impeccable quality and affordable prices.","nextNodeIds":[726870206]},{"nodeId":726870206,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1719476458,"text":"Perhaps you've met Sakuya as well. We once studied ikebana under the same master.","nextNodeIds":[726870207]},{"nodeId":726870207,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3009817834,"text":"Sakuya is also very well-studied in the floral arts, but when she heard that there would be tons of people at the Irodori Festival, she seemed to have gotten a bit of stage fright. She said that it would be difficult to quiet down and focus on her work in such an environment.","nextNodeIds":[726870208]},{"nodeId":726870208,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2499178986,"text":"In any case, I will advertise Sakuya's Flowers on her behalf.","nextNodeIds":[726870209]},{"nodeId":726870209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2082577922,"text":"We can help too if you need us!","nextNodeIds":[726870219]},{"nodeId":726870219,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1010027682,"text":"Well then, do the two of you have any other questions?","nextNodeIds":[726870220]},{"nodeId":726870220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3067219490,"text":"Thank you, Ms. Fushizome.","nextNodeIds":[726870221]},{"nodeId":726870221,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":139603770,"text":"Think nothing of it. If you have time, you can come and look for me any time.","nextNodeIds":[]},{"nodeId":726870210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1503724594,"text":"About the Yashiro Commission's involvement...","nextNodeIds":[726870211]},{"nodeId":726870211,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2797110330,"text":"The Yashiro Commission has always been very supportive of Inazuma's floral arts. Indeed, the person who sponsored this event is the Shirasagi Himegimi.","nextNodeIds":[726870212]},{"nodeId":726870212,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2496297666,"text":"She has always been incredibly talented in these arts, even from a young age. I saw her perform ikebana once, and even had the honor of exchanging pointers with her.","nextNodeIds":[726870213]},{"nodeId":726870213,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1508383266,"text":"Although I'm older than her, I'm nowhere near her ability in terms of skill in ikebana or understanding of the floral arts.","nextNodeIds":[726870214]},{"nodeId":726870214,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1416659450,"text":"Where circumstances have permitted, she has provided funding to help publicize ikebana every year. I've even heard that she has used her own savings to do so...","nextNodeIds":[726870215]},{"nodeId":726870215,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2580369618,"text":"She once expressed her frank desire for more people to understand ikebana and to drum up more interest in it such that more might want to practice this art.","nextNodeIds":[726870216]},{"nodeId":726870216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1890863482,"text":"Huh. So Ayaka did so much for Inazuma's floral arts...","nextNodeIds":[726870217]},{"nodeId":726870217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3694582458,"text":"I hope her wish comes true.","nextNodeIds":[726870218]},{"nodeId":726870218,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1842969362,"text":"Thank you both. You are indeed good-hearted people.","nextNodeIds":[726870219]},{"nodeId":726870222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1782352058,"text":"I have no further questions at the moment.","nextNodeIds":[726870223]},{"nodeId":726870223,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3508514954,"text":"Alright, then. You can come and look for me any time.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4,0],"PAINLIBBLDK":"QUEST_CONTENT_IRODORI_FINISH_FLOWER_COMBINATION","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["