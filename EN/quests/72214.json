priority":5,"questId":72214,"showRandomTalkCount":0},"dialogs":[{"nodeId":722140101,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1852419514,"text":"This is... quite incredible...","nextNodeIds":[722140102]},{"nodeId":722140102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2350781626,"text":"Is the stone carving done?","nextNodeIds":[722140103]},{"nodeId":722140103,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2735670018,"text":"When we began, that stone did not look a thing like me. But with each passing glance, it becomes more and more so.","nextNodeIds":[722140104]},{"nodeId":722140104,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":630283906,"text":"You humans really are incredible.","nextNodeIds":[722140105]},{"nodeId":722140105,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":203369010,"text":"It is very noisy, yes, but I am the provisional head priestess. Such trivial matters are not worth complaining about.","nextNodeIds":[722140106]},{"nodeId":722140106,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3609003426,"text":"Bring these fish to that tall human.","nextNodeIds":[722140107]},{"nodeId":722140107,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":49919018,"text":"They are good things, and may be considered his... \"celery.\"","nextNodeIds":[722140108,722140111]},{"nodeId":722140108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2242303890,"text":"Just fish?","nextNodeIds":[722140109]},{"nodeId":722140109,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1091404082,"text":"Meow, I did get Konbumaru to lead those children to try to catch some finches, but it did not turn out very well.","nextNodeIds":[722140110]},{"nodeId":722140110,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3137650802,"text":"For them, catching fish is still simpler.","nextNodeIds":[]},{"nodeId":722140111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1876076962,"text":"It's \"salary.\"","nextNodeIds":[722140112]},{"nodeId":722140112,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2494549610,"text":"Meow meow meow, how bothersome of you.","nextNodeIds":[722140113]},{"nodeId":722140113,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3494388050,"text":"Just give them to him — they are good things, after all.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7221402,"order":2,"stepDescription":"Bring the Fish to Ooshima Junpei","stepDescTextMapHash":3416857916,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3182"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7221402],"talks":[{"talkId":7221402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7221402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7221402,"initDialog":722140201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3182],"performCfg":"","priority":5,"questId":72214,"showRandomTalkCount":0},"dialogs":[{"nodeId":722140201,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":2681167970,"text":"Well, this certainly looks the part now...","nextNodeIds":[722140202]},{"nodeId":722140202,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":2318432474,"text":"Haha, it's you. Do you think it looks a bit more like the Lady Priestess now?","nextNodeIds":[722140203,722140205]},{"nodeId":722140203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2659502930,"text":"It sure does.","nextNodeIds":[722140204]},{"nodeId":722140204,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3950445738,"text":"Right? Ah, I spent a few days burning the midnight oil on this, too...","nextNodeIds":[722140207]},{"nodeId":722140207,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":543167330,"text":"Ah, I'm pretty hungry, I think... Time to go look for something to eat again...","nextNodeIds":[722140208]},{"nodeId":722140208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3601411906,"text":"Neko sends you some fish.","nextNodeIds":[722140209]},{"nodeId":722140209,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":2704795978,"text":"Hmm, well, the Lady Priestess has my thanks, but uh... I think I'll look for food on my own...","nextNodeIds":[722140210]},{"nodeId":722140210,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":25764754,"text":"I've eaten fish for several straight days now. I don't think I could eat any more...","nextNodeIds":[722140211]},{"nodeId":722140211,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1014473498,"text":"I've been heading out to forage for food. When I'm lucky, I can grab a finch or a pigeon...","nextNodeIds":[722140212]},{"nodeId":722140212,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1697535530,"text":"*sigh* But what I'd like to have is some meat, you know? Some firm, juicy meat...","nextNodeIds":[722140213]},{"nodeId":722140213,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3451755098,"text":"So, uh, Traveler...","nextNodeIds":[722140214]},{"nodeId":722140214,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1189494050,"text":"If you don't mind, could you get me three servings of Raw Meat?","nextNodeIds":[722140215]},{"nodeId":722140215,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":2082477282,"text":"I'm no good at hunting, so I haven't been able to get any meat these past few days... So please, give me a hand!","nextNodeIds":[722140216,722140217]},{"nodeId":722140216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2608910402,"text":"Alright...","nextNodeIds":[722140220]},{"nodeId":722140220,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":2458711426,"text":"Please help me out. Just three servings will do!","nextNodeIds":[]},{"nodeId":722140217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1513065402,"text":"Did you think of going back to Narukami Island to have a meal?","nextNodeIds":[722140218]},{"nodeId":722140218,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":417594354,"text":"Well, it's really far away, for one thing. And for another... I was just getting the hang of this carving. If I'd left at this point, the journey might have deprived me of that \"feeling,\" see.","nextNodeIds":[722140219]},{"nodeId":722140219,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3074117874,"text":"I'd prefer to eat a quick meal here before continuing to carve.","nextNodeIds":[722140220]},{"nodeId":722140205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3445381978,"text":"It's a lot larger, that's for sure.","nextNodeIds":[722140206]},{"nodeId":722140206,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":753346890,"text":"Well, of course. The Lady Priestess is quite a bit larger than your average cat, but if you want a more majestic statue, then it's got to be even larger still. This is a shrine statue, after all!","nextNodeIds":[722140207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3182"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7221404,"order":3,"stepDescription":"Give Ooshima Junpei three servings of Raw Meat","stepDescTextMapHash":3987855908,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221404,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3182"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7221403],"talks":[{"talkId":7221403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":[