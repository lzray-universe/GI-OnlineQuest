GUIDE_NONE"},"isHidden":false,"talkIds":[7054501],"talks":[{"talkId":7054501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7054501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7054501,"initDialog":705450101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30523],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7054501","priority":5,"questId":70545,"showRandomTalkCount":0},"dialogs":[{"nodeId":705450101,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":2482161322,"text":"Meow, meow meow—meooooow~~","nextNodeIds":[705450102]},{"nodeId":705450102,"roleType":"TALK_ROLE_NPC","speakerId":30528,"speakerName":"Bunny","textMapHash":3820162842,"text":"Meow! Meow meow meow!","nextNodeIds":[705450103]},{"nodeId":705450103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":235560834,"text":"Hmmm... Both Bunny and Amber have a point...","nextNodeIds":[705450104]},{"nodeId":705450104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4800530,"text":"Oh, so that's it...","nextNodeIds":[705450105,705450106]},{"nodeId":705450105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3105690690,"text":"A most astute observation.","nextNodeIds":[705450107]},{"nodeId":705450107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1013287482,"text":"Actually, Paimon doesn't really get it either, but she can tell that Amber and Bunny have reached an understanding!","nextNodeIds":[705450108]},{"nodeId":705450108,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":1183067050,"text":"#{NICKNAME}, Paimon! You're here! I was just thinking about going to look for you!","nextNodeIds":[705450109]},{"nodeId":705450109,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":709686826,"text":"I've already heard all about how you're helping Valerina with the Furball Fortress!","nextNodeIds":[705450110]},{"nodeId":705450110,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":344253914,"text":"#That's {NICKNAME} and Paimon for you! The second you're back in Mondstadt, you're already being such a huge help!","nextNodeIds":[705450111,705450112]},{"nodeId":705450111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2285289562,"text":"I, the Honorary Knight, will fulfill my mission, no matter its nature.","nextNodeIds":[705450113]},{"nodeId":705450113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":780454770,"text":"Speaking of which, what were you and Bunny discussing just now? You seemed to be having a really fun conversation.","nextNodeIds":[705450114]},{"nodeId":705450114,"roleType":"TALK_ROLE_NPC","speakerId":30528,"speakerName":"Bunny","textMapHash":114689178,"text":"Meow, meow meow?","nextNodeIds":[705450115]},{"nodeId":705450115,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":680357674,"text":"Oh! I was just asking Bunny about the weather, and whether or not it would rain.","nextNodeIds":[705450116]},{"nodeId":705450116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":615854642,"text":"Huh? Do cats know that kind of thing?","nextNodeIds":[705450117]},{"nodeId":705450117,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":1690068898,"text":"Hehe, Lisa said something about that!","nextNodeIds":[705450118]},{"nodeId":705450118,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":681831122,"text":"According to a book she read, cats are very sensitive to humidity, and don't like the feeling of being wet.","nextNodeIds":[705450119]},{"nodeId":705450119,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":188258666,"text":"So, if they notice a sudden increase in the humidity, they'll start nervously pawing their faces and licking their fur.","nextNodeIds":[705450120]},{"nodeId":705450120,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":3353625370,"text":"Once a cat does something like that, it's a sign that a large rainstorm is likely on its way.","nextNodeIds":[705450121]},{"nodeId":705450121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2514328730,"text":"Whoa, Paimon had no idea, that's so cool! Guess we just learned something amazing by accident!","nextNodeIds":[705450122]},{"nodeId":705450122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4041736562,"text":"#In that case, {NICKNAME}, let's pay more attention to cats during our travels! That way, we won't... keep getting soaked by huge downpours from those big black clouds!","nextNodeIds":[705450123,705450124]},{"nodeId":705450123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1500099474,"text":"I suppose we'll have to pay more attention going forward.","nextNodeIds":[705450125]},{"nodeId":705450125,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":4089684122,"text":"I originally came here to ask Valerina about something.","nextNodeIds":[705450126]},{"nodeId":705450126,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":249152202,"text":"But just as I was talking to her, this little kitty snuggled up close to me and yawned so loudly! It was just too cute!","nextNodeIds":[705450127]},{"nodeId":705450127,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":2846625954,"text":"Since she was so affectionate towards me, then... Well, then I need to show how friendly I am, too!","nextNodeIds":[705450128]},{"nodeId":705450128,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":858585490,"text":"That's when I remembered what Lisa told me, so I went ahead and asked Bunny about the weather.","nextNodeIds":[705450129]},{"nodeId":705450129,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":4040575690,"text":"But she responded by rubbing her face, then wagging her tail, then lying on the ground snuggling against my hand...","nextNodeIds":[705450130]},{"nodeId":705450130,"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","textMapHash":471911578,"text":"*sigh* So is it actually going to rain or not over the next few days...?","nextNodeIds":[]},{"nodeId":705450124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2549137322,"text":"Since when haven't I paid close attention to cute kitties?","nextNodeIds":[705450125]},{"nodeId":705450112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3408563658,"text":"The defense of the cats of Mondstadt is one of my many responsibilities.","nextNodeIds":[705450113]},{"nodeId":705450106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3799866626,"text":"Hold on, I'm a bit lost.","nextNodeIds":[705450107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7054501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30523,"speakerName":"Amber","count":15},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":30528,"speakerName":"Bunny","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":479432542,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIM