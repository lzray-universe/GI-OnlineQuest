{"mainQuestId":3013,"title":"Dawn","description":"In the end, Nilou's dance ushered in the dawn. If memory serves, you seemed to have seen Dunyarzad in front of the stage...","titleTextMapHash":929335511,"descTextMapHash":565559678,"mainQuestExcel":{"mainQuestId":3013,"titleTextMapHash":929335511,"title":"Dawn","descTextMapHash":565559678,"description":"In the end, Nilou's dance ushered in the dawn. If memory serves, you seemed to have seen Dunyarzad in front of the stage...","chapterId":1306,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/AQ3013","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":1306,"descTextMapHash":565559678,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":3013,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":20389289,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/AQ3013","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":1015,"rewardIdList":[103013],"series":1302,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":929335511,"type":"AQ","unlockDescTextMapHash":2034161574}},"flow":[{"subQuestId":301302,"order":1,"stepDescription":"Talk to \"Katheryne\"","stepDescTextMapHash":1111020964,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[301304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12913"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[301304],"talks":[{"talkId":301304,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["301302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":301304,"initDialog":30130401,"nextRandomTalks":[],"nextTalks":[],"npcId":[12913],"performCfg":"QuestDialogue/AQ/Sumeru1_3013/Q301304","priority":5,"questId":3013,"showRandomTalkCount":0},"dialogs":[{"nodeId":30130401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3768401994,"text":"You're actually Nahida, aren't you! Paimon felt like Katheryne was acting weird when we met at the Sabzeruz Festival.","nextNodeIds":[30130402]},{"nodeId":30130402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":870143130,"text":"And Dunyarzad... Did you save her?","nextNodeIds":[30130403]},{"nodeId":30130403,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":591733458,"text":"It's a really long story. We shouldn't disturb her. Her consciousness is still weakened.","nextNodeIds":[30130404]},{"nodeId":30130404,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":809743938,"text":"Let's chat somewhere else. How about by the Traveler's favorite bench?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[301304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12913"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":301301,"order":2,"stepDescription":"Talk to Nahida","stepDescTextMapHash":1891765036,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[301301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12913"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[301301,301302],"talks":[{"talkId":301301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["301301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":301301,"initDialog":30130101,"nextRandomTalks":[],"nextTalks":[],"npcId":[12913],"performCfg":"QuestDialogue/AQ/Sumeru1_3013/Q301301","priority":5,"questId":3013,"showRandomTalkCount":0},"dialogs":[{"nodeId":30130101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":731299890,"text":"Let's talk about Dunyarzad first. It's such a relief that she's all right!","nextNodeIds":[30130102]},{"nodeId":30130102,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3594346,"text":"Hmm-hmm. After we parted on the last day of the Sabzeruz Festival, I left the city and saw what the Traveler had described.","nextNodeIds":[30130103]},{"nodeId":30130103,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3033575730,"text":"Among the countless dreams, I found one that was growing fainter and fainter. This proved my suspicion.","nextNodeIds":[30130104]},{"nodeId":30130104,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1008393890,"text":"Once Dunyarzad could no longer bear the Akasha harvesting her dreams, her consciousness began to dissipate — but this also meant it escaped the Akasha's control.","nextNodeIds":[30130105]},{"nodeId":30130105,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":889546218,"text":"Such a small fragment of consciousness can't last for very long, though. It will return to its original dream...","nextNodeIds":[30130106]},{"nodeId":30130106,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":280007154,"text":"Where both will gradually fade until they completely disappear.","nextNodeIds":[30130107]},{"nodeId":30130107,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1926086066,"text":"I used all the power I had to keep her dying dream alive as long as possible, but it still wouldn't have lasted for much longer if it hadn't been for you two breaking the samsara.","nextNodeIds":[30130108]},{"nodeId":30130108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":452468170,"text":"So it looks like we did manage to save Dunyarzad in the end. And not a moment too soon!","nextNodeIds":[30130109,30130110]},{"nodeId":30130109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1637217810,"text":"A very happy ending.","nextNodeIds":[30130111]},{"nodeId":30130111,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3457400218,"text":"Oh? Why are you two smiling so happily? I thought you'd be so moved that you'd start crying... Hmm... I need to spend more time observing human emotions.","nextNodeIds":[30130112]},{"nodeId":30130112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3244073714,"text":"Both are fine! Everyone reacts differently!","nextNodeIds":[30130113]},{"nodeId":30130113,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2783298778,"text":"Alright, you two must have a lot of other questions for me, right? After all, you saved my faithful believer. As your reward, I'll answer any and all questions.","nextNodeIds":[30130114,30130132,30130151,30130159,30130169]},{"nodeId":30130114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2040205162,"text":"About what I saw in that dream at the Avidya Forest...","nextNodeIds":[30130115]},{"nodeId":30130115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3469508818,"text":"At the Avidya Forest, there was this incense that made the Traveler fall unconscious and dream of a huge tree and a red sky...","nextNodeIds":[30130116]},{"nodeId":30130116,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":971687874,"text":"You also heard someone's voice, right? It said \"world\" and \"forget me\"?","nextNodeIds":[30130117]},{"nodeId":30130117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":407941378,"text":"Yeah! So you DO know! We've been wanting to ask you what that was about, and if the red sky was related to Khaenri'ah...","nextNodeIds":[30130118]},{"nodeId":30130118,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":714326170,"text":"Hmm, it seems like the Traveler established a connection to Irminsul. That was a message left by Greater Lord Rukkhadevata's residual consciousness in Irminsul... perhaps her last memory before she died.","nextNodeIds":[30130119]},{"nodeId":30130119,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3546734466,"text":"As you two probably know, Greater Lord Rukkhadevata disappeared after the disaster in Khaenri'ah. The timings of these events do line up, so your suspicions are reasonable.","nextNodeIds":[30130120]},{"nodeId":30130120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2960171090,"text":"A message from Greater Lord Rukkhadevata? We thought it was from King Deshret!","nextNodeIds":[30130121]},{"nodeId":30130121,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2501098090,"text":"King Deshret... That god who died even longer ago? Some present-day desert-dwellers still worship him. You probably just heard some of their conspiracies.","nextNodeIds":[30130122]},{"nodeId":30130122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":488577066,"text":"Okay... So, what does the message mean?","nextNodeIds":[30130123]},{"nodeId":30130123,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1300551522,"text":"...I still haven't managed to decipher it. Even the Akasha isn't currently capable of doing that.","nextNodeIds":[30130124]},{"nodeId":30130124,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2146845434,"text":"Greater Lord Rukkhadevata's residual consciousness in Irminsul seems to be contaminated with something that has a very dangerous aura to it.","nextNodeIds":[30130125]},{"nodeId":30130125,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3742841362,"text":"Many devoted scholars go mad as soon as they connect their consciousness... I've warned the Akademiya about this many times, but people still keep falling victim to it.","nextNodeIds":[30130126]},{"nodeId":30130126,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":4041411746,"text":"But I believe this is the key to saving Irminsul. That's why I've kept trying to decipher it.","nextNodeIds":[30130127]},{"nodeId":30130127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2640149450,"text":"So the tree in the vision was Irminsul... Oh, Tighnari also said that Irminsul is sick. Is it because of the contaminated consciousness?","nextNodeIds":[30130128]},{"nodeId":30130128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":450062762,"text":"But if even you can't figure out what that vision was all about, it seems like our search for you was all in vain...","nextNodeIds":[30130129]},{"nodeId":30130129,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3202268962,"text":"The Traveler wasn't affected after coming in contact with that consciousness. I've never seen anyone like that. With you here, we may have a chance at deciphering it...","nextNodeIds":[30130130]},{"nodeId":30130130,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1054942522,"text":"No, we MUST decipher its secrets. I've already eliminated all other factors that might affect Irminsul. This is the only one left.","nextNodeIds":[30130131]},{"nodeId":30130131,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3418023546,"text":"This puzzle has life and death at stake... It could determine Irminsul's fate... as well as Teyvat's...","nextNodeIds":[30130132,30130151,30130159,30130169]},{"nodeId":30130132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":458722770,"text":"Why do you look like Katheryne?","nextNodeIds":[30130133]},{"nodeId":30130133,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3049004978,"text":"To be accurate, I'm using the Akasha as a medium to occupy Katheryne's consciousness.","nextNodeIds":[30130134]},{"nodeId":30130134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3392864194,"text":"H—How did you do that!? Poor Katheryne! Uh, does this mean you can also occupy other people's consciousnesses?","nextNodeIds":[30130135]},{"nodeId":30130135,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3284265354,"text":"Theoretically, I can enter anyone's mind as long as they're wearing their Akasha Terminal.","nextNodeIds":[30130136]},{"nodeId":30130136,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":914929650,"text":"The Akasha is the legacy of Greater Lord Rukkhadevata. As Lesser Lord Kusanali and The First Akasha Terminal, my consciousness has always been linked to the Akasha.","nextNodeIds":[30130137]},{"nodeId":30130137,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1729258730,"text":"I've always respected my people's free will, so I've never actually occupied their consciousness. When necessary, I just borrow this bionic Snezhnayan puppet.","nextNodeIds":[30130138]},{"nodeId":30130138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1673078634,"text":"Oh... Uhh, hold on, did we just learn some deep, dark secret? So Katheryne is... No wonder Paimon felt something was off about her...","nextNodeIds":[30130139]},{"nodeId":30130139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":387751282,"text":"What about your own body? Why do you need to borrow other people's? Don't you live in the Sanctuary of Surasthana?","nextNodeIds":[30130140]},{"nodeId":30130140,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":4279582298,"text":"...That story begins a long time ago. After Greater Lord Rukkhadevata disappeared, the Sages found my newly born self and took me back to Sumeru.","nextNodeIds":[30130141]},{"nodeId":30130141,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1327411234,"text":"At that time, I was young and weak. The sages kept me in the Sanctuary of Surasthana, ostensibly for the sake of \"protecting\" me, but I've hardly heard from them since.","nextNodeIds":[30130142]},{"nodeId":30130142,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3617066122,"text":"However, I do understand that they had hoped to find Greater Lord Rukkhadevata instead of me, a symbol of her passing.","nextNodeIds":[30130143]},{"nodeId":30130143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2478358498,"text":"So... the sages basically put their new archon under house arrest? How dare they... Why don't you teach them a lesson, Nahida!?","nextNodeIds":[30130144]},{"nodeId":30130144,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2744707338,"text":"In some ways, they aren't wrong. Greater Lord Rukkhadevata was omniscient and omnipotent. Even after her death, the Akasha is still empowering this nation.","nextNodeIds":[30130145]},{"nodeId":30130145,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1109509978,"text":"And I... I'm still really far away from being able to call myself the God of Wisdom. Moreover, the Akademiya is also far more proficient at governing this country. My existence has little meaning.","nextNodeIds":[30130146]},{"nodeId":30130146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2471177906,"text":"To me, you're already an excellent archon.","nextNodeIds":[30130147]},{"nodeId":30130147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1064568026,"text":"Yeah! You've got a lot of believers. Just look at the Sabzeruz Festival! Everyone who showed up truly loves you.","nextNodeIds":[30130148]},{"nodeId":30130148,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":724980562,"text":"Hehe, thank you for the kind words, but I honestly don't need physical freedom as long as I can connect my consciousness to the Akasha.","nextNodeIds":[30130149]},{"nodeId":30130149,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2216190130,"text":"Trying to find a way to save Irminsul is my life's mission and top priority. I will work on that, and try to live up to being a deity in the meantime...","nextNodeIds":[30130150]},{"nodeId":30130150,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2761446698,"text":"...Every once in a while, I will also take up the duties of the God of Wisdom, and enlighten a lost soul here and there. Doing all that... should be enough.","nextNodeIds":[30130114,30130151,30130159,30130169]},{"nodeId":30130151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":846809226,"text":"About the sages' plan...","nextNodeIds":[30130152]},{"nodeId":30130152,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":866992826,"text":"There's never been any big problems with the Akademiya's governance of Sumeru. This is the first time I've seen them step out of line.","nextNodeIds":[30130153]},{"nodeId":30130153,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2752252594,"text":"I wonder what caused them to go down this path, and what they hope to achieve...","nextNodeIds":[30130154]},{"nodeId":30130154,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":891875218,"text":"Even though the city's residents haven't noticed anything strange, if the Traveler hadn't broken the Sabzeruz samsara, the situation could've become dire.","nextNodeIds":[30130155]},{"nodeId":30130155,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2981816474,"text":"I tried to do some investigating in the Akasha, but I couldn't find anything suspicious, and all the people of interest seem to purposely avoid wearing their Akasha Terminals...","nextNodeIds":[30130156]},{"nodeId":30130156,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2938377130,"text":"I think they're deliberately trying to hide something.","nextNodeIds":[30130157]},{"nodeId":30130157,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3766693778,"text":"Oh, that reminds Paimon... In Gandharva Ville, there was a sage who had invited Tighnari to join some kind of project... Could it be related?","nextNodeIds":[30130158]},{"nodeId":30130158,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":156107122,"text":"Regardless, I need to first investigate the sages' motives, make things right, and punish them if needed... But I'll have to be discreet, or they'll see me coming.","nextNodeIds":[30130114,30130132,30130159,30130169]},{"nodeId":30130159,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4604450,"text":"No one has realized the issue with the Akasha?","nextNodeIds":[30130160]},{"nodeId":30130160,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":407359346,"text":"You mean how the Akasha stops you from having dreams?","nextNodeIds":[30130161]},{"nodeId":30130161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2455581370,"text":"Yeah, it's been such a long time. No one's noticed something's up?","nextNodeIds":[30130162]},{"nodeId":30130162,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1786164386,"text":"It's not that no one noticed — it's more like no one cared. Ultimately, it's all rooted in the sages' misdirection.","nextNodeIds":[30130163]},{"nodeId":30130163,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2953945418,"text":"Misdirection?","nextNodeIds":[30130164]},{"nodeId":30130164,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":4189905482,"text":"The sages convinced everyone to believe that being unable to dream is a sign of rationality and wisdom. Not dreaming is a badge of honor in Sumeru...","nextNodeIds":[30130165]},{"nodeId":30130165,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3338990346,"text":"...Even if the truth is that their dreams are reaped by the Akasha.","nextNodeIds":[30130166]},{"nodeId":30130166,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":3396862002,"text":"With their propaganda in place, the sages can maximize their use of the Akasha to facilitate their research.","nextNodeIds":[30130175]},{"nodeId":30130175,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":828505242,"text":"Besides, Greater Lord Rukkhadevata must have created the Akasha in the hopes that it could be used to its full potential. That's why I've never come out strongly against this.","nextNodeIds":[30130167]},{"nodeId":30130167,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1061879682,"text":"Anyway, the perspective advocated by the sages drowned out any voices of doubt.","nextNodeIds":[30130168]},{"nodeId":30130168,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":354856714,"text":"By now, even those who never use Akasha Terminals find it too shameful and embarrassing to talk about their dreams.","nextNodeIds":[30130114,30130132,30130151,30130169]},{"nodeId":30130169,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2587305330,"text":"I don't have any other questions.","nextNodeIds":[30130170]},{"nodeId":30130170,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1431664610,"text":"Got it. I hope my answers were satisfactory, seekers of knowledge.","nextNodeIds":[30130171]},{"nodeId":30130171,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":1291590522,"text":"To be honest, maintaining Dunyarzad's fading dream took a lot of mental energy... I think I may need to rest for a while.","nextNodeIds":[30130172]},{"nodeId":30130172,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":4007593722,"text":"Oh, and you don't need to worry too much about the Sages' activities for now. The Akasha won't be able to conduct another project on the scale of the Sabzeruz samsara in the immediate future.","nextNodeIds":[30130173]},{"nodeId":30130173,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":962322226,"text":"Go and get some sleep. Leave everything to us!","nextNodeIds":[30130174]},{"nodeId":30130174,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":2436663306,"text":"Hehe, what a relief. *yawn* This is truly the most exhausting birthday I've ever had.","nextNodeIds":[30130301]},{"nodeId":30130301,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":762678210,"text":"Hmm... Traveler? Paimon? Why am I here? Do either of you know?","nextNodeIds":[30130302]},{"nodeId":30130302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3898369026,"text":"Uhh... Maybe you were sleepwalking? You know, you can't wake up a sleepwalker. We, uh... We happened to walk by, so we thought we'd wait for you to wake up!","nextNodeIds":[30130303]},{"nodeId":30130303,"roleType":"TALK_ROLE_NPC","speakerId":12913,"speakerName":"Katheryne","textMapHash":86325274,"text":"I see. Huh... I should visit my maintenance personnel sometime. Oh, I'm fine. I better go. Thank you.","nextNodeIds":[]},{"nodeId":30130110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2653862610,"text":"This is truly a miracle.","nextNodeIds":[30130111]}]},{"talkId":301302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["301301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","",""