extTalks":[],"npcId":[30181],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7151001","priority":15,"questId":71510,"showRandomTalkCount":0},"dialogs":[{"nodeId":715100101,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1047648242,"text":"How did it go? Did you manage to operate the Spike successfully?","nextNodeIds":[715100102,715100103]},{"nodeId":715100102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2541885874,"text":"Yes. It went well.","nextNodeIds":[715100104]},{"nodeId":715100104,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2228847970,"text":"Good, good. Though the Pursina's Spike cannot seal the opening in one go, as long as it is successful once, continued operation should not be an issue.","nextNodeIds":[715100105]},{"nodeId":715100105,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1386290226,"text":"This means that it's really just a matter of time before the opening closes completely.","nextNodeIds":[715100106]},{"nodeId":715100106,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":713304922,"text":"Our problem is, therefore, solved.","nextNodeIds":[715100107]},{"nodeId":715100107,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1211992562,"text":"I must record this... For all I know, I may yet become a figure of some influence in the Akademiya once the full research report on the Pursina's Spikes is submitted.","nextNodeIds":[715100108]},{"nodeId":715100108,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2958419002,"text":"#I might even write it into my future memoirs. I can see it now: \"My Experiments With the Preternaturally Skilled {NICKNAME} at The Chasm...\"","nextNodeIds":[715100109]},{"nodeId":715100109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":122293274,"text":"I'll be waiting eagerly for that day to come.","nextNodeIds":[715100110]},{"nodeId":715100110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2877700722,"text":"Haha! Well, I fear I'm not hardly as good at writing stories as I am at reports.","nextNodeIds":[715100111]},{"nodeId":715100111,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1180509514,"text":"I can only hope that you'll forgive any flaws in my work.","nextNodeIds":[]},{"nodeId":715100103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4259214442,"text":"Most of the dark mud is gone.","nextNodeIds":[715100104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7151001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":863191990,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/TheChas