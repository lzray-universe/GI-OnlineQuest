{"mainQuestId":71530,"title":"Just Wushou Dance!","description":"During the Lantern Rite Festival, you and Paimon run into Gaming and another friend practicing the Wushou Dance together. He has prepared an endlessly fascinating event, and is waiting for guests to come and experience it...","titleTextMapHash":2689617631,"descTextMapHash":912702366,"mainQuestExcel":{"mainQuestId":71530,"titleTextMapHash":2689617631,"title":"Just Wushou Dance!","descTextMapHash":912702366,"description":"During the Lantern Rite Festival, you and Paimon run into Gaming and another friend practicing the Wushou Dance together. He has prepared an endlessly fascinating event, and is waiting for guests to come and experience it...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2028,"luaPath":"Actor/Quest/WQ71530","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2028,"chapterId":0,"descTextMapHash":912702366,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71530,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1907035105,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71530","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171530],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2689617631,"type":"WQ","unlockDescTextMapHash":3874521518}},"flow":[{"subQuestId":7153001,"order":1,"stepDescription":"Talk to Xiaqing","stepDescTextMapHash":1318456876,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30457"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7153001],"talks":[{"talkId":7153001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7153001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7153001,"initDialog":715300101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30457],"performCfg":"QuestDialogue/WQ/Liyue_71530/Q7153001","priority":5,"questId":71530,"showRandomTalkCount":0},"dialogs":[{"nodeId":715300101,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":1685367306,"text":"#Yo, Happy Lantern Rite, {M#my dude and dudette!}{F#dudettes!}","nextNodeIds":[715300102]},{"nodeId":715300102,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":245051002,"text":"Say, you two wouldn't happen to be the bigshots who came looking for Gaming, would you?","nextNodeIds":[715300103]},{"nodeId":715300103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":485372346,"text":"We saw you before! You were hanging out with Gaming, right?","nextNodeIds":[715300104]},{"nodeId":715300104,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":1256748850,"text":"Totally! Hot diggity, you remember me! My luck's on fire!","nextNodeIds":[715300105]},{"nodeId":715300105,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":2728763986,"text":"I heard you two are the best of the best, and there ain't nothing you can't do! I pop on over to Chihu Rock to buy groceries every day, and even though it's so close by, I still always hear people singing your praises along the way.","nextNodeIds":[715300106,715300107]},{"nodeId":715300106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3127069826,"text":"That's right, we're the cream of the crop!","nextNodeIds":[715300108]},{"nodeId":715300108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":539058922,"text":"H—Hey! Paimon's good at stuff besides eating, too!","nextNodeIds":[715300109]},{"nodeId":715300109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2392825386,"text":"Wait, let Paimon think for a moment... What else is she good at...","nextNodeIds":[715300110]},{"nodeId":715300110,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":2765710370,"text":"I've got it! Can ordinary people float? You're so white and light and fluffy, like a pigeon adeptus!","nextNodeIds":[715300111]},{"nodeId":715300111,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":411253194,"text":"Flying alone is amazing. I mean, it should be super easy to carry stuff, and makes work a cinch! You should help your friend more.","nextNodeIds":[715300112,715300113]},{"nodeId":715300112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2699650410,"text":"Gasp! You're the Pigeon Adeptus, Paimon?","nextNodeIds":[715300114]},{"nodeId":715300114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3836042618,"text":"#Let's just ignore whether it's even possible for a pigeon to turn into an adeptus for now. Paimon just wants to point out that she's always been helping {NICKNAME}!","nextNodeIds":[715300115]},{"nodeId":715300115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2213016098,"text":"#For example, if {NICKNAME} falls from a really high place, Paimon will grab onto {M#him}{F#her} and make sure the fall isn't too painful...","nextNodeIds":[715300116]},{"nodeId":715300116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2832804050,"text":"#Even though Paimon's not strong enough to actually do much lifting... If Paimon really was a Pigeon Adeptus, she'd give {NICKNAME} a boost while {M#he's}{F#she's} using the wind glider and help {M#him}{F#her} fly higher and farther!","nextNodeIds":[715300117]},{"nodeId":715300117,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":1547805786,"text":"You two gotta practice more! Just like when I practice Wushou with Gaming. The more you practice, the better you'll work together! Rapport ain't easy to build.","nextNodeIds":[715300118]},{"nodeId":715300118,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":1915773194,"text":"It just so happens I've created a fresh new game, hot off the press! It's called \"Just Wushou Dance!\" Wanna have a go?","nextNodeIds":[715300119]},{"nodeId":715300119,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":1880244162,"text":"Not only can you work on your teamwork, you can learn all about Wushou Dance!","nextNodeIds":[715300120]},{"nodeId":715300120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4026357818,"text":"\"Just Wushou Dance!\"? You wouldn't happen to be talking about that big ol' doll next to you, right?","nextNodeIds":[715300121]},{"nodeId":715300121,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":837780586,"text":"Bingo!","nextNodeIds":[715300122]},{"nodeId":715300122,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":1979589138,"text":"Authentic Wushou Dance is downright devilish to learn! Even if you've got a pro showing you the ropes, you won't be able to stick with it unless you love it and have got the perseverance to match.","nextNodeIds":[715300123]},{"nodeId":715300123,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":1816870754,"text":"So, I changed the rules for one style of Wushou Dance, switched out some props, and boom! This game was born.","nextNodeIds":[715300124]},{"nodeId":715300124,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":970601554,"text":"And it's also Lantern Rite now, yeah? Perfect for helping everyone enjoy themselves, and work up an appetite or work off the extra calories!","nextNodeIds":[715300125]},{"nodeId":715300125,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":51572818,"text":"Just put on your dancing shoes... well, the dancing outfit, and see who can grab the most teabricks! You can dance and bump all over the shop, it's a hoot and a half!","nextNodeIds":[715300126]},{"nodeId":715300126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3147388442,"text":"It sure sounds fun, but Paimon doesn't think she's strong enough to wear such a big outfit and play with other people...","nextNodeIds":[715300127]},{"nodeId":715300127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2182356370,"text":"#But {NICKNAME} is really good at games like this! Paimon'll watch and learn from the sidelines first.","nextNodeIds":[715300128,715300129]},{"nodeId":715300128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2886240570,"text":"#Bring it! I'm the dancing {M#king}{F#queen}!","nextNodeIds":[715300130]},{"nodeId":715300130,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":857998634,"text":"Huh? Pigeon Adeptus, will you not personally participate? A pity...","nextNodeIds":[715300131]},{"nodeId":715300131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":762744722,"text":"#Aw, it's not a problem! {NICKNAME} and Paimon will be traveling together for a long time to come! We'll have plenty of chances to level up our teamwork!","nextNodeIds":[715300132]},{"nodeId":715300132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4134969170,"text":"#Also, who's to say Paimon won't learn a bunch about working with {NICKNAME} just from watching?","nextNodeIds":[715300133]},{"nodeId":715300133,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":3117143794,"text":"Haha! You two are so close, I'm starting to get a bit jelly!","nextNodeIds":[715300134]},{"nodeId":715300134,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","textMapHash":573913610,"text":"#Then please, right this way! Let the {M#dude}{F#dudette} of legendary deeds step right up and \"Just Wushou Dance!\" Pigeon Adeptus, you just sit back and enjoy the show!","nextNodeIds":[]},{"nodeId":715300129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2260397522,"text":"Tea-riffic! Those Teacakes will be a piece of cake!","nextNodeIds":[715300130]},{"nodeId":715300113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":210958218,"text":"Here comes another strange nickname for Paimon!","nextNodeIds":[715300114]},{"nodeId":715300107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":720202698,"text":"Paimon's the best at eating, ain't nothing she can't swallow!","nextNodeIds":[715300108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30457"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7153001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"Xiaqing","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCM