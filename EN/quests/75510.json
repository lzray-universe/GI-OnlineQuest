aram":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7551001,"initDialog":755100101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30837,30838,30836],"performCfg":"QuestDialogue/WQ/Saurus1V3_75510/Q7551001","priority":5,"questId":75510,"showRandomTalkCount":0},"dialogs":[{"nodeId":755100101,"roleType":"TALK_ROLE_NPC","speakerId":30837,"speakerName":"Little Pinecone","textMapHash":3981514634,"text":"Although the Masked Warrior can't fly about like the Peacemaker, all she has to do to win is time her charges right!","nextNodeIds":[755100102]},{"nodeId":755100102,"roleType":"TALK_ROLE_NPC","speakerId":30838,"speakerName":"Flammabomb Wood Figure","textMapHash":111239970,"text":"You blithering idiot! You can't just think of how fast she can run in a straight line — if she can't turn or hit anything, it won't make any difference!","nextNodeIds":[755100103]},{"nodeId":755100103,"roleType":"TALK_ROLE_NPC","speakerId":30836,"speakerName":"Vigee","textMapHash":1686129050,"text":"That's enough, children. We can have a civilized discussion, can't we?","nextNodeIds":[755100104]},{"nodeId":755100104,"roleType":"TALK_ROLE_NPC","speakerId":30838,"speakerName":"Flammabomb Wood Figure","textMapHash":3783907034,"text":"We're being civilized...! It's just, well, when we talk about great warriors, we get pumped up!","nextNodeIds":[755100105]},{"nodeId":755100105,"roleType":"TALK_ROLE_NPC","speakerId":30837,"speakerName":"Little Pinecone","textMapHash":1636282146,"text":"Don'cha worry none, Miss Vigee! We might be at war, but we're gonna fight with reason and evidence!","nextNodeIds":[755100106]},{"nodeId":755100106,"roleType":"TALK_ROLE_NPC","speakerId":30838,"speakerName":"Flammabomb Wood Figure","textMapHash":4293439890,"text":"...Oho! I just thought of a new strategy. I challenge you again!","nextNodeIds":[755100107]},{"nodeId":755100107,"roleType":"TALK_ROLE_NPC","speakerId":30837,"speakerName":"Little Pinecone","textMapHash":2780663298,"text":"Rematch, rematch!","nextNodeIds":[755100108,755100109]},{"nodeId":755100108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3545140034,"text":"...Sure is lively here.","nextNodeIds":[755100110]},{"nodeId":755100110,"roleType":"TALK_ROLE_NPC","speakerId":30836,"speakerName":"Vigee","textMapHash":281808570,"text":"A new customer! Hello there!","nextNodeIds":[755100111]},{"nodeId":755100111,"roleType":"TALK_ROLE_NPC","speakerId":30836,"speakerName":"Vigee","textMapHash":4274118138,"text":"Judging by your attire, you're a traveler, aren't you? We've got that in common!","nextNodeIds":[755100112]},{"nodeId":755100112,"roleType":"TALK_ROLE_NPC","speakerId":30836,"speakerName":"Vigee","textMapHash":1149011882,"text":"Do you want to try out this interactive woven scroll I've created with the children?","nextNodeIds":[755100113,755100114]},{"nodeId":755100113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2387032754,"text":"\"Interactive woven scroll\"?","nextNodeIds":[755100115]},{"nodeId":755100115,"roleType":"TALK_ROLE_NPC","speakerId":30836,"speakerName":"Vigee","textMapHash":3718349146,"text":"Simply put, it's a game that combines Liyue's paper theater, Inazuma's comics, and Fontaine's film technology.","nextNodeIds":[755100116]},{"nodeId":755100116,"roleType":"TALK_ROLE_NPC","speakerId":30836,"speakerName":"Vigee","textMapHash":913899618,"text":"It's inspired by our local heroes, and adds the concept of \"crossover challenges\" to create a novel story.","nextNodeIds":[755100117]},{"nodeId":755100117,"roleType":"TALK_ROLE_NPC","speakerId":30836,"speakerName":"Vigee","textMapHash":2209555546,"text":"Give it a try! Who knows, it might be a new experience for you.","nextNodeIds":[755100118]},{"nodeId":755100118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":558021818,"text":"With pleasure!","nextNodeIds":[75510