{"mainQuestId":76077,"title":"The Man Who Once Lied","description":"Nefer seems to have issued a certain commission at the Adventurers' Guild...","titleTextMapHash":3035352423,"descTextMapHash":715919662,"mainQuestExcel":{"mainQuestId":76077,"titleTextMapHash":3035352423,"title":"The Man Who Once Lied","descTextMapHash":715919662,"description":"Nefer seems to have issued a certain commission at the Adventurers' Guild...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76077","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":715919662,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76077,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":621019049,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76077","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176077],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[29019],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3035352423,"type":"WQ","unlockDescTextMapHash":254994358}},"flow":[{"subQuestId":7607701,"order":1,"stepDescription":"Talk to Nefer","stepDescTextMapHash":2881413412,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7607701],"talks":[{"talkId":7607701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7607701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7607701,"initDialog":760770101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1316],"performCfg":"QuestDialogue/WQ/NodKrai_76077/Q7607701","priority":5,"questId":76077,"showRandomTalkCount":0},"dialogs":[{"nodeId":760770101,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":805258986,"text":"Here you go, Lady Nefer — the book you were looking for.","nextNodeIds":[760770102]},{"nodeId":760770102,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":484114,"text":"Let me see... Ha, would you look at that? Finally, an actual copy of \"The Man Who Became a Mule.\"","nextNodeIds":[760770103]},{"nodeId":760770103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1623399370,"text":"Is that... Nefer? Surely she can't be here for a commission?","nextNodeIds":[760770104]},{"nodeId":760770104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":964840522,"text":"Yeah, Nefer doesn't seem like the kind of person who \"takes\" commissions... More like the kind who dishes them out.","nextNodeIds":[760770105,760770106]},{"nodeId":760770105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2190560218,"text":"Yeah... exactly.","nextNodeIds":[760770107]},{"nodeId":760770107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1091772258,"text":"Hey, if you start taking work from Nefer, there'll be none left for Jahoda...","nextNodeIds":[760770108]},{"nodeId":760770108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2089427938,"text":"Still, what sort of job is Nefer delegating to the Adventurers' Guild? Paimon's kinda curious...","nextNodeIds":[760770109,760770110]},{"nodeId":760770109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1463172250,"text":"Let's ask about it later.","nextNodeIds":[760770111]},{"nodeId":760770111,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1640583506,"text":"Not bad... This is exactly what I was looking for. The Adventurers' Guild must have quite the impressive network, tracking down a long-lost story like this...","nextNodeIds":[760770112]},{"nodeId":760770112,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":675688274,"text":"Haha, well, that's all thanks to our hardworking adventurers.","nextNodeIds":[760770113]},{"nodeId":760770113,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":4081846946,"text":"There were quite a few setbacks along the way, but in the end, we managed to find a collector in Snezhnaya who had a copy.","nextNodeIds":[760770114]},{"nodeId":760770114,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1286008218,"text":"How ironic that a story about the desert would end up somewhere like Snezhnaya...","nextNodeIds":[760770115]},{"nodeId":760770115,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1324934354,"text":"Well, thank you for your efforts. I'll send over the payment as promised.","nextNodeIds":[760770116]},{"nodeId":760770116,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":619670090,"text":"Also, Mr. Sarin — please keep this commission active, and raise its priority level. I'll cover the additional fee as well.","nextNodeIds":[760770117]},{"nodeId":760770117,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":2547748906,"text":"Not a problem. It's our honor to do business with you, Lady Nefer. If you'll excuse me, I'll go get everything sorted.","nextNodeIds":[760770118]},{"nodeId":760770118,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2600179322,"text":"My business is done, you two. You can come out and ask your questions. I know you're \"curious\"...","nextNodeIds":[760770119,760770120]},{"nodeId":760770119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":734738186,"text":"You knew we were here?","nextNodeIds":[760770121]},{"nodeId":760770121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1969831026,"text":"You even heard what Paimon said!? Huh. Guess that's what makes you the boss...","nextNodeIds":[760770122]},{"nodeId":760770122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3695790682,"text":"So, you're posting a commission?","nextNodeIds":[760770123]},{"nodeId":760770123,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3986691066,"text":"Something like that. It's more like a long-term partnership I have with the Adventurers' Guild.","nextNodeIds":[760770124]},{"nodeId":760770124,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2061468722,"text":"Come, let's head back to the Curatorium for a cup of tea. This isn't the best place for sharing stories...","nextNodeIds":[]},{"nodeId":760770120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2935712794,"text":"Talk about eagle-eyed...","nextNodeIds":[760770121]},{"nodeId":760770110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2864846914,"text":"Better not bother Nefer right now.","nextNodeIds":[760770111]},{"nodeId":760770106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":558787954,"text":"Maybe I should have her give me some easy ones.","nextNodeIds":[760770107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7607702,"order":2,"stepDescription":"Return to the Curatorium of Secrets with Nefer","stepDescTextMapHash":4224573932,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[1205_32:-5.423,0.291,-48.909,0.000,238.763,0.000]","10"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7607702],"talks":[{"talkId":7607702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7607702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7607702,"initDialog":760770201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1316],"performCfg":"QuestDialogue/WQ/NodKrai_76077/Q7607702","priority":5,"questId":76077,"showRandomTalkCount":0},"dialogs":[{"nodeId":760770201,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3636772210,"text":"...Huh, looks like Jahoda's not back yet.","nextNodeIds":[760770202]},{"nodeId":760770202,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3112291154,"text":"Wait here. I'll go brew some tea.","nextNodeIds":[760770203]},{"nodeId":760770203,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"Ashru","textMapHash":2193588122,"text":"Meow...","nextNodeIds":[760770204]},{"nodeId":760770204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2525204026,"text":"Here, kitty kitty...","nextNodeIds":[760770205]},{"nodeId":760770205,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"Ashru","textMapHash":2435645554,"text":"Meow, meow meow!","nextNodeIds":[760770206]},{"nodeId":760770206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":129460466,"text":"Hehe, who's a good kitty... C'mon, shake!","nextNodeIds":[760770207]},{"nodeId":760770207,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"Ashru","textMapHash":651994746,"text":"Meow?","nextNodeIds":[760770208]},{"nodeId":760770208,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":919355882,"text":"Alright, help yourselves. Cream and sugar is over there if you need it.","nextNodeIds":[760770209]},{"nodeId":760770209,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2540045218,"text":"Looks like Ashru's taken a real liking to you. Back when I first brought him home, he was as fierce as a little lion.","nextNodeIds":[760770210]},{"nodeId":760770210,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1149936602,"text":"He didn't let anyone get close except for me. Anybody else who tried would have his little fangs and claws to contend with...","nextNodeIds":[760770211]},{"nodeId":760770211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2599082626,"text":"Seriously? You'd never guess he used to be aggressive...","nextNodeIds":[760770212]},{"nodeId":760770212,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"Ashru","textMapHash":471692786,"text":"Meow, meow meow? Meow...","nextNodeIds":[760770213]},{"nodeId":760770213,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1608214274,"text":"That was a long time ago, when the two of us had just arrived in Nod-Krai.","nextNodeIds":[760770214]},{"nodeId":760770214,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":389426186,"text":"Back then, we had no one to rely on but ourselves. And to survive in a place like Nod-Krai... We had no choice but to bare our claws and teeth.","nextNodeIds":[760770215]},{"nodeId":760770215,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1376449818,"text":"...Of course, things are different now.","nextNodeIds":[760770216]},{"nodeId":760770216,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2377405746,"text":"Anyway, it's about time we satisfied that curiosity of yours. I'm guessing you want to know more about my \"long-term partnership\" with the Adventurers' Guild?","nextNodeIds":[760770217,760770218]},{"nodeId":760770217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2937223866,"text":"I still can't believe you would need to post a commission...","nextNodeIds":[760770219]},{"nodeId":760770219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2733291762,"text":"You mean like, some kind of extra special treasure even Nefer can't get her hands on?","nextNodeIds":[760770220]},{"nodeId":760770220,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1427762802,"text":"It's special, no doubt about that. But whether it counts as \"treasure\"... Well, that depends on how you see it.","nextNodeIds":[760770221]},{"nodeId":760770221,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1376546362,"text":"Here, this is the book I asked the Adventurers' Guild to find for me. Take a look.","nextNodeIds":[760770222]},{"nodeId":760770222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3332532258,"text":"Oh, it's like a... fairytale from Sumeru!","nextNodeIds":[760770223,760770224]},{"nodeId":760770223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2094238178,"text":"Is it a clue to finding hidden treasure?","nextNodeIds":[760770225]},{"nodeId":760770225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3548106882,"text":"Uh oh, not another riddle-filled treasure hunt! Well, uh... have fun! Paimon's gonna sit this one out...","nextNodeIds":[760770226]},{"nodeId":760770226,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2074587754,"text":"Relax, it's just a story passed down among the desert-dwellers of Sumeru. There's no secret treasure, and no hidden riddles.","nextNodeIds":[760770227]},{"nodeId":760770227,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1260771106,"text":"The only reason I went to such lengths to find it... is because it has to do with my father.","nextNodeIds":[760770228]},{"nodeId":760770228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2948257538,"text":"Your father...","nextNodeIds":[760770229]},{"nodeId":760770229,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1191345082,"text":"That's right. From what you've seen before... you no doubt remember the fate that befell us.","nextNodeIds":[760770230]},{"nodeId":760770230,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":848800706,"text":"Before he brought back those so-called \"spoils of war,\" before our little village ended up buried under the desert sands... He used to tell me stories.","nextNodeIds":[760770231]},{"nodeId":760770231,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3910017482,"text":"You know what Sumeru was like back then. Tales like these, stories full of wisdom and warmth, were something only the lucky few living in the rainforests got to hear.","nextNodeIds":[760770232]},{"nodeId":760770232,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2419844962,"text":"But for the desert-dwellers, cut off from \"civilization\" by the Wall of Samiel... wisdom and warmth were luxuries we couldn't afford.","nextNodeIds":[760770233]},{"nodeId":760770233,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3928765322,"text":"The stories passed down in the desert had one purpose, and one alone — to teach children how to survive.","nextNodeIds":[760770234]},{"nodeId":760770234,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3528764562,"text":"In desert tales, people who waste food get turned into scorpions, those who waste water end up losing their tongues...","nextNodeIds":[760770235]},{"nodeId":760770235,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1407071258,"text":"The stories taught us to be kind, but to be scarce with our trust... to lie and deceive, as long as we didn't get caught.","nextNodeIds":[760770236]},{"nodeId":760770236,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2245138,"text":"But, I suppose my father didn't want me to turn out like everyone else.","nextNodeIds":[760770237]},{"nodeId":760770237,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1666777866,"text":"He would take these stories and change them... imbue them with more... warmth.","nextNodeIds":[760770238]},{"nodeId":760770238,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":4245814202,"text":"In the versions he told, liars turned into mules, killers fell off cliffs... But, picky children... ended up with a toothache, at most.","nextNodeIds":[760770239]},{"nodeId":760770239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1780548722,"text":"Paimon kinda gets where he was coming from. After all, who doesn't wanna see their kids grow up with the right values...","nextNodeIds":[760770240]},{"nodeId":760770240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":493510682,"text":"So, what did you think of those stories, Nefer?","nextNodeIds":[760770241]},{"nodeId":760770241,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":229238962,"text":"Me?","nextNodeIds":[760770242]},{"nodeId":760770242,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3394825618,"text":"I couldn't get enough of them. I'd spend my days counting down the minutes to nightfall, when Dad would lull me to sleep with another one of his stories.","nextNodeIds":[760770243]},{"nodeId":760770243,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":15464890,"text":"Then, come daytime, I'd grab his storybook and go tell them to the other kids.","nextNodeIds":[760770244]},{"nodeId":760770244,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":384469466,"text":"They were so envious of me. No matter where I went, there was always a line of kids trailing behind me. They would do whatever I asked, just for the chance to hear a story.","nextNodeIds":[760770245]},{"nodeId":760770245,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":4206608762,"text":"And then, one day, it all came to an end, and now, all that remains of those times is buried under the sand. My father, my friends, my tribe... and all those stories, too.","nextNodeIds":[760770246]},{"nodeId":760770246,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1981079034,"text":"...","nextNodeIds":[760770247]},{"nodeId":760770247,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1096307514,"text":"After that, I went to the Akademiya. It was there that I first discovered the \"original versions\" of some of his stories.","nextNodeIds":[760770248]},{"nodeId":760770248,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3827660746,"text":"In those versions, the liars were never punished, the murderers walked free... After all, if you fall for a lie, you deserve to be deceived. If the blade is in your hand, you get to write the rules...","nextNodeIds":[760770249]},{"nodeId":760770249,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1037584738,"text":"And picky children? They ended up just like the ones who wasted water — turned into lizards, doomed to spend the rest of their days crawling under the rocks.","nextNodeIds":[760770250]},{"nodeId":760770250,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":913855554,"text":"Only then did I realize that it was my father who'd been \"deceiving\" me all along, weaving a false world of warmth to shelter me from the harsh realities of the world.","nextNodeIds":[760770251]},{"nodeId":760770251,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3648758114,"text":"But once my father was gone, that world collapsed with him, and I had no choice but to face the truth.","nextNodeIds":[760770252]},{"nodeId":760770252,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1950112450,"text":"Luckily, though, I was a quick learner. Before long, I'd turned into exactly the kind of \"desert-dweller\" he'd worked so hard to keep me from becoming.","nextNodeIds":[760770253]},{"nodeId":760770253,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":4252547658,"text":"After that, it was all lies, deceit, revenge, and ruin — themes that have played out in the desert a thousand times over. But I'm sure you know that all too well.","nextNodeIds":[760770254,760770255]},{"nodeId":760770254,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1881401922,"text":"So the reason you started collecting these stories...","nextNodeIds":[760770256]},{"nodeId":760770256,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":781095730,"text":"More or less. I just want to know exactly how many lies a father might tell his own daughter.","nextNodeIds":[760770257]},{"nodeId":760770257,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2630249418,"text":"As the only person in this world he ever deceived so completely, I suppose I owe it to him to make an equally comprehensive record of his distortions. Besides, anonymity seems a cruel fate for such a prolific twister of the truth.","nextNodeIds":[760770258]},{"nodeId":760770258,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3992121754,"text":"Anyway... Hmph, I'm sure Thoth, the Ibis King, would approve of what I'm doing.","nextNodeIds":[760770259]},{"nodeId":760770259,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1534779410,"text":"After all, he was the one who sent me in search of something that could \"discern truth from falsehood.\"","nextNodeIds":[760770260]},{"nodeId":760770260,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1906477410,"text":"When I was young, the stories my father told me shaped my understanding of the world.","nextNodeIds":[760770261]},{"nodeId":760770261,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2281672018,"text":"Whereas their original endings... Heh, well, they taught me what this world is really like.","nextNodeIds":[760770262]},{"nodeId":760770262,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":4035294242,"text":"And it's true — for me, they really did help me \"discern truth from falsehood.\"","nextNodeIds":[760770263]},{"nodeId":760770263,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2546851674,"text":"I figured that gathering them up might be the key to finding the answer the Ibis King was looking for.","nextNodeIds":[760770264]},{"nodeId":760770264,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1573129538,"text":"So, after I established myself in Nod-Krai, I started using every available channel to track down the stories my father once told me.","nextNodeIds":[760770265]},{"nodeId":760770265,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2083200330,"text":"The problem was, nearly all of them were folk tales, parables passed down in the desert through word of mouth. Very few were ever written down.","nextNodeIds":[760770266]},{"nodeId":760770266,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":733834370,"text":"But living all the way out here in Nod-Krai, it wasn't like I could just go wandering around the desert to find those who still remembered them.","nextNodeIds":[760770267]},{"nodeId":760770267,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2986496994,"text":"As for Jahoda... Well, I was short on manpower as it was, so I needed a different plan.","nextNodeIds":[760770268]},{"nodeId":760770268,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1213038450,"text":"And, considering the countless adventurers at their disposal, I decided to strike up a long-term partnership with the Adventurers' Guild.","nextNodeIds":[760770269]},{"nodeId":760770269,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2394349290,"text":"They bring me stories passed down among the desert people, I pay them accordingly, and sometimes, even do them a little favor in return.","nextNodeIds":[760770270]},{"nodeId":760770270,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":4103532218,"text":"Mr. Sarin was more than happy with my terms, so we soon came to an understanding. And from the way things have been going, I'd say our arrangement has worked out rather well.","nextNodeIds":[760770271]},{"nodeId":760770271,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3122977850,"text":"So... What's special about the story you just got your hands on?","nextNodeIds":[760770272]},{"nodeId":760770272,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3030358322,"text":"Ah, well... This was the very last story my father ever told me — the only one whose ending he left unchanged.","nextNodeIds":[760770274]},{"nodeId":760770274,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":772914522,"text":"A man who spent his life distorting the truth... Buried under the desert sand the one time he chose not to lie.","nextNodeIds":[760770288]},{"nodeId":760770288,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":420507538,"text":"Hah... and look, it even says: \"Deep down, his was a heart of gold — and that is the greatest wisdom of all.\" How ironic is that?","nextNodeIds":[760770275]},{"nodeId":760770275,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3839964698,"text":"Anyway, I can make a copy of this story if you're interested.","nextNodeIds":[760770276]},{"nodeId":760770276,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3088892226,"text":"#Ah, and I just realized... You're an adventurer too, aren't you, {NICKNAME}?","nextNodeIds":[760770277,760770278]},{"nodeId":760770277,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1390936234,"text":"Uh... Y—Yeah, I am...","nextNodeIds":[760770279]},{"nodeId":760770279,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3720588250,"text":"Well, being an adventurer means you've traveled far and wide and seen many things...","nextNodeIds":[760770280]},{"nodeId":760770280,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":4204850818,"text":"I was just thinking... We could sign an agreement for a long-term partnership of our own.","nextNodeIds":[760770281]},{"nodeId":760770281,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2465178178,"text":"If you ever come across any stories about the desert-dwellers of Sumeru, bring them to me, and I'll make it worth your while.","nextNodeIds":[760770282]},{"nodeId":760770282,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3346376514,"text":"Wait, was that your goal this whole time? Just to ask us that?","nextNodeIds":[760770283,760770284]},{"nodeId":760770283,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2914881162,"text":"So, there was a commission at the end of this, after all...","nextNodeIds":[760770285]},{"nodeId":760770285,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1544954186,"text":"Wonderful! Then, here's to a long and fruitful partnership.","nextNodeIds":[760770286]},{"nodeId":760770286,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":91195754,"text":"And speaking of partnerships... Why isn't Jahoda back yet?","nextNodeIds":[760770287]},{"nodeId":760770287,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3652191882,"text":"Was that job I gave her really that difficult?","nextNodeIds":[]},{"nodeId":760770284,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3499682770,"text":"Well, taking commissions is what I do, so... Okay!","nextNodeIds":[760770285]},{"nodeId":760770278,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2745042642,"text":"What makes you ask?","nextNodeIds":[760770279]},{"nodeId":760770255,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2218942690,"text":"Was to find out what the originals were really like?","nextNodeIds":[760770256]},{"nodeId":760770224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3491494954,"text":"Is there some kind of riddle hidden inside?","nextNodeIds":[760770225]},{"nodeId":760770218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3412524930,"text":"It must be for something really important.","nextNodeIds":[760770219]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[1205_32:-5.423,0.291,-48.909,0.000,238.763,0.000]","10"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7607701,7607702],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","count":69},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":23},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"Ashru","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[176077],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":715919662,"CHECNJEMEFE":{"1316":[1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[29019],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/NodKrai_76077/Q7607701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":760770101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7607701,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[1316],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["7607701","2"],"_type":"QUEST_COND_STATE_EQUAL"}],"NIJAPEJKLDI":false,"NMKNFLIHHHE":true,"NMMOKMEKDJO":false,"NPGONNBAOOI":14112499974564549362,"OAIIIMFGNGM":true,"OAOCMNEPKOG":76077,"ODEOIJMOMPL":["[3_13810:1655.414,226.555,9457.649,0.000,51.933,0.000]","[3_13811:1662.969,227.930,9462.413,0.000,48.455,0.000]","[3_13812:1663.046,227.924,9463.444,0.000,104.086,0.000]","[3_13813:1655.291,226.772,9458.246,0.000,86.599,0.000]"],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST","PCCKKGAHFFJ":false,"PNACKFKJJHM":[]},{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/NodKrai_76077/Q7607702","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":760770201,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7607702,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":true,"KINCAGMDMHH":[1316],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["7607702","2"],"_type":"QUEST_COND_STATE_EQUAL"}],"NIJAPEJKLDI":false,"NMKNFLIHHHE":true,"NMMOKMEKDJO":false,"NPGONNBAOOI":17254646086807169330,"OAIIIMFGNGM":true,"OAOCMNEPKOG":76077,"ODEOIJMOMPL":["[1205_55:-6.533,0.281,-50.163,0.000,351.715,0.000]","[1205_56:-7.450,0.286,-48.342,0.000,181.039,0.000]","[1205_57:-6.807,1.047,-49.282,0.000,156.451,0.000]","[1205_58:-8.057,0.287,-50.160,0.000,18.081,0.000]"],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST","PCCKKGAHFFJ":false,"PNACKFKJJHM":[]}],"IBNCKLKHAKG":0,"IEGCPJALJOA":0,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","ILHDNJDDEOP":76077,"ILICEMABDDI":[],"JAPLGJLDPHJ":[],"JDCIPCDDDPK":0,"JDEFCNEDMLL":0,"KCONOGOIGIH":0,"LEFIHLHODBM":[],"LMCFKPMJGEO":false,"MEJIMPLKPHN":0,"MHHFFHCLDKI":true,"MMOEEOFGHHG":3035352423,"NJGLJLODPBN":false,"NKAKCKAJCLD":0,"NOCNCPAGOPC":"Actor/Quest/WQ76077","OPIDGNOCOHD":"QUEST_SHOW","PAINLIBBLDK":"WQ","PEDANLIDLGE":0,"PEFIFLDHPEE":true,"PIGICJKACHG":[],"PPJLLGCPCOL":{"HDHKBHOLGIM":{}}},"meta":{"questType":"WQ","series":0,"mainQuestTag":"MAINQUEST_TAG_NONE","showType":"QUEST_SHOW","repeatable":false,"recommendLevel":0,"chapterId":0,"chapterTitle":"","chapterNum":"","needPlayerLevel":null,"cityId":null,"cityName":"","unlockDesc":"","preMainQuestIds":[],"nextMainQuestIds":[76129],"rewardIdList":[176077],"rewards":[{"rewardId":176077,"items":[{"itemId":102,"name":"Adventure EXP","count":150,"itemType":"ITEM_VIRTUAL","rank":13},{"itemId":202,"name":"Mora","count":20000,"itemType":"ITEM_VIRTUAL","rank":10},{"itemId":104003,"name":"Hero's Wit","count":3,"itemType":"ITEM_MATERIAL","rank":100},{"itemId":121401,"name":"The Man Who Became a Mule","count":1,"itemType":"ITEM_MATERIAL","rank":10}],"playerExp":0,"hcoin":0,"scoin":0}]},"cutscenes":[]}