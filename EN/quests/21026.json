MGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2411"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2102601,2102609],"talks":[{"talkId":2102601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2102601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2102601,"initDialog":210260101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2411],"performCfg":"QuestDialogue/IQ/Liyue_21026/Q2102601","priority":5,"questId":21026,"showRandomTalkCount":0},"dialogs":[{"nodeId":210260101,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":4268481514,"text":"The handwriting in this bottled letter seems to belong to a child...","nextNodeIds":[210260102]},{"nodeId":210260102,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":3305159874,"text":"\"Little Meng\"? Who's that?","nextNodeIds":[210260103]},{"nodeId":210260103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4192367226,"text":"Huh? Is that drifting bottle...","nextNodeIds":[210260104]},{"nodeId":210260104,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1230522810,"text":"Traveler? Judging from your tone, you know the person who wrote this letter, don't you?","nextNodeIds":[210260105,210260106]},{"nodeId":210260105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1133938170,"text":"I guess...","nextNodeIds":[210260107]},{"nodeId":210260107,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":267741570,"text":"Ah, so that's how it is. Quite the thinker too, this kid. Wanting to become mature...","nextNodeIds":[210260108]},{"nodeId":210260108,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":4135804834,"text":"You know what? I think he'd gain a lot from taking a little trip outside to broaden his horizons.","nextNodeIds":[210260109]},{"nodeId":210260109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2678765642,"text":"Huh. Little Meng did say that he'd like to travel outside Liyue Harbor...","nextNodeIds":[210260110]},{"nodeId":210260110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2675121986,"text":"But we invited him that time, didn't we? Why didn't he just agree then?","nextNodeIds":[210260111]},{"nodeId":210260111,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":3774122602,"text":"Hahaha, I suppose that's a wee bit of what you might call a boy's \"stubbornness.\"","nextNodeIds":[210260112]},{"nodeId":210260112,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":3079504010,"text":"It's his troubles, and he wants to solve them himself, you know? Can't be relying on others all the time.","nextNodeIds":[210260113]},{"nodeId":210260113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":550301410,"text":"But he's not going to solve this problem by floating a bottle downstream...","nextNodeIds":[210260114]},{"nodeId":210260114,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":997954130,"text":"Well, yes. And that's where a reliable adult comes in, no?","nextNodeIds":[210260115]},{"nodeId":210260115,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1154461386,"text":"Come on, Traveler. Let's write this kid a letter together, shall we?","nextNodeIds":[210260116]},{"nodeId":210260116,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1177040466,"text":"Let's tell the kid about all the fascinating things waiting for him in the outside world.","nextNodeIds":[210260117]},{"nodeId":210260117,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":3177015922,"text":"That said... Well, it's not like I've been to too many places, so you're in charge of the details, Traveler.","nextNodeIds":[210260118,210260119,210260120]},{"nodeId":210260118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1407307026,"text":"Let's write about the towering ruins shrouded in raging winds...","nextNodeIds":[210260121]},{"nodeId":210260121,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":2327186738,"text":"Whoa, whoa there. Slow down, I'm still writing over here...","nextNodeIds":[210260122]},{"nodeId":210260122,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":3488640250,"text":"Hmm... This goes here... and we write that there...","nextNodeIds":[210260123]},{"nodeId":210260123,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":137433946,"text":"Alright! That's a wrap — wow, we sure wound up writing a lot...","nextNodeIds":[210260124]},{"nodeId":210260124,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":315109330,"text":"Honestly, just listening to you talk about your travels makes me want to travel myself!","nextNodeIds":[210260125]},{"nodeId":210260125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2243305194,"text":"It's not bad at all.","nextNodeIds":[210260126]},{"nodeId":210260126,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":2760774946,"text":"Ah, but at my age, there's too much business to attend to. Traveling willy-nilly is just not something I can do.","nextNodeIds":[210260127]},{"nodeId":210260127,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":2764299522,"text":"Well, I've put this letter into the drifting bottle. Send it down the river.","nextNodeIds":[]},{"nodeId":210260119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1481105602,"text":"Let's mention the archipelago surrounded by thundering storms...","nextNodeIds":[210260121]},{"nodeId":210260120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3928017914,"text":"Let's talk about the island that the Electro Archon split in two...","nextNodeIds":[210260121]},{"nodeId":210260106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1439654586,"text":"It's a kid from Liyue Harbor...","nextNodeIds":[210260107]}]},{"talkId":2102609,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2102601","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2102602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2102609,"initDialog":210260901,"nextRandomTalks":[],"nextTalks":[],"npcId":[2411],"performCfg":"","priority":5,"questId":21026,"showRandomTalkCount":0},"dialogs":[{"nodeId":210260901,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1283226426,"text":"Well, I've put this letter into the drifting bottle. Send 