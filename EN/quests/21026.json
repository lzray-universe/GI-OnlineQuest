ALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2102601","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2102602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2102609,"initDialog":210260901,"nextRandomTalks":[],"nextTalks":[],"npcId":[2411],"performCfg":"","priority":5,"questId":21026,"showRandomTalkCount":0},"dialogs":[{"nodeId":210260901,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1283226426,"text":"Well, I've put this letter into the drifting bottle. Send it down the river.","nextNodeIds":[]}]},{"talkId":2102610,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2102602","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2102603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2102610,"initDialog":210261001,"nextRandomTalks":[],"nextTalks":[],"npcId":[2411],"performCfg":"","priority":5,"questId":21026,"showRandomTalkCount":0},"dialogs":[{"nodeId":210261001,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":4073130122,"text":"How did it go? Have you sent the bottle off on its way?","nextNodeIds":[210261002]},{"nodeId":210261002,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1572615162,"text":"Will Little Meng really receive it?","nextNodeIds":[210261003]},{"nodeId":210261003,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1561801530,"text":"Heh. Usually, it would be a difficult thing. Impossible, even.","nextNodeIds":[210261004]},{"nodeId":210261004,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2113242194,"text":"Then what was the point of us doing all that?","nextNodeIds":[210261005]},{"nodeId":210261005,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1051598370,"text":"Haha, relax. I did say that a certain responsible adult would help him.","nextNodeIds":[210261006]},{"nodeId":210261006,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":243266162,"text":"Do you know of a place called Sumeru?","nextNodeIds":[210261007]},{"nodeId":210261007,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":892927162,"text":"I have a few friends who are businessmen. They are currently planning to get into the mushroom market, so they're going there to perform market surveys.","nextNodeIds":[210261008]},{"nodeId":210261008,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":3459799530,"text":"But as you know, \"market surveys\" tend to also leave much time open for leisure.","nextNodeIds":[210261009]},{"nodeId":210261009,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":2519832050,"text":"Since that kid called Little Meng wants to travel, I can ask those friends of mine if they can bring another person along.","nextNodeIds":[210261010]},{"nodeId":210261010,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1269544314,"text":"Don't worry about it. I'll handle all the arrangements.","nextNodeIds":[210261011]},{"nodeId":210261011,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":2402224634,"text":"I've made another copy of the letter for other purposes. As for the bottle... Let it go on its way, though I doubt anyone will pick it up.","nextNodeIds":[210261012,210261013]},{"nodeId":210261012,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":989452570,"text":"Thanks for helping.","nextNodeIds":[210261014]},{"nodeId":210261014,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":917607282,"text":"Isn't fulfilling the dreams of children something adults should do? Relax, you can leave this matter to me.","nextNodeIds":[210261015]},{"nodeId":210261015,"roleType":"TALK_ROLE_NPC","speakerId":2411,"speakerName":"Yue Chuan","textMapHash":1919547658,"text":"Ah, yes. I should ask those friends of mine to dress a bit better. Scaring people just won't do...","nextNodeIds":[]},{"nodeId":210261013,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":381657106,"text":"Why are you so willing to help Little Meng?","nextNodeIds":[210261014]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1331050691"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["101645"],"PAINLIBBLDK":"QUEST_EXEC_DEL_ALL_SPECIFIC_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2102605"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":2102603,"order":3,"stepDescription":"Talk to Yue Chuan","stepDescTextMapHash":2493900468,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2102610,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["2411"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2102610,2102611],"talks":[{"