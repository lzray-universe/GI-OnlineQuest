ALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7607804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","1","76078","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7607802,"initDialog":760780201,"nextRandomTalks":[],"nextTalks":[],"npcId":[22183],"performCfg":"QuestDialogue/WQ/NodKrai_76078/Q7607802","priority":10,"questId":76078,"showRandomTalkCount":0},"dialogs":[{"nodeId":760780201,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":1970262746,"text":"Ah, a lantern. This is something that all Lightkeepers carry with them, and is a key tool in dispersing the Wild Hunt...","nextNodeIds":[760780202]},{"nodeId":760780202,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":3830884666,"text":"The lantern remains, and on its cover lingers the scent of the Wild Hunt's permeation. The bearer, however, is nowhere to be found.","nextNodeIds":[760780203]},{"nodeId":760780203,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":1120690050,"text":"I see. Though perplexing, it's not hard to conclude what happened here.","nextNodeIds":[760780204]},{"nodeId":760780204,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":528295898,"text":"The sacrifices of our Lightkeeper brethren are sometimes silent as a whisper. Finding out my colleagues have passed in this way is... always a shame.","nextNodeIds":[760780205]},{"nodeId":760780205,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":414508482,"text":"...Allow me to carry the lantern you left behind, nameless one.","nextNodeIds":[760780206]},{"nodeId":760780206,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":3521098394,"text":"Its body will be cleansed, its light, rekindled. It will find a new home in the arms of another Lightkeeper who vows to protect Nod-Krai.","nextNodeIds":[760780207]},{"nodeId":760780207,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3463130026,"text":"Flins cleans the lantern, then carefully puts it away.","nextNodeIds":[760780208]},{"nodeId":760780208,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":3762269458,"text":"This lantern must be why the Wild Hunt didn't completely disappear. I'll hold on to it until someone from headquarters can come to retrieve it.","nextNodeIds":[760780209]},{"nodeId":760780209,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":2680806146,"text":"...Hold on, there's something underneath the lantern.","nextNodeIds":[760780210]},{"nodeId":760780210,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":4052067394,"text":"This must be a relic left behind by that same colleague. It should be kept together with their lantern.","nextNodeIds":[]}]},{"talkId":7607805,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7608102","2","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7607804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","2","76078","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7607805,"initDialog":760780501,"nextRandomTalks":[],"nextTalks":[],"npcId":[22183],"performCfg":"QuestDialogue/WQ/NodKrai_76078/Q7607805","priority":10,"questId":76078,"showRandomTalkCount":0},"dialogs":[{"nodeId":760780501,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":2156779562,"text":"There's an Oath Lantern here as well. It must have belonged to someone who came before us...","nextNodeIds":[760780502]},{"nodeId":760780502,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":1412541730,"text":"The lantern is still stained with the Wild Hunt's corruption. It's not hard to imagine what happened...","nextNodeIds":[760780503]},{"nodeId":760780503,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":2731052834,"text":"From the day we take up the Oath Lantern, our lives are bound to the flame within it, until the moment our rightful mission is fulfilled.","nextNodeIds":[760780504]},{"nodeId":760780504,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":880782418,"text":"To you, who fought to your last breath for the peace and safety of Nod-Krai, I offer my deepest respect.","nextNodeIds":[760780505]},{"nodeId":760780505,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":1775778402,"text":"I will take your lantern for now. Rest assured, the crown of the honored fallen will keep your legacy safe.","nextNodeIds":[760780506]},{"nodeId":760780506,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":434604530,"text":"I'll bring it back to headquarters, rekindle its flame, and entrust it to someone worthy of carrying your will forward.","nextNodeIds":[760780507]},{"nodeId":760780507,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3865410402,"text":"Illuga cleans the lantern, then carefully puts it away.","nextNodeIds":[760780508]},{"nodeId":760780508,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":461565882,"text":"With that, the Wild Hunt has been wiped out from this place, and our predecessor's spirit has finally found its rest.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7607805,0],"PAINLIBBLDK":"QUEST_C