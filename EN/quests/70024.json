1,"nextRandomTalks":[],"nextTalks":[],"npcId":[151201],"performCfg":"","priority":5,"questId":70024,"showRandomTalkCount":0},"dialogs":[{"nodeId":700240101,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":2634319250,"text":"Traveler! Please, over here.","nextNodeIds":[700240102]},{"nodeId":700240102,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":1978235250,"text":"Apologies, but I need a moment of your time. Would you be interested in taking on a new commission?","nextNodeIds":[700240103,700240104]},{"nodeId":700240103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1504523794,"text":"Can't hurt to learn more about it.","nextNodeIds":[700240105]},{"nodeId":700240105,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":425472866,"text":"The situation is this. The Guild has recently received several reports that the hilichurls in the wild are once again starting to band together and disrupt the merchant route.","nextNodeIds":[700240106]},{"nodeId":700240106,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":1526305770,"text":"We have dispatched a significant number of adventurers to investigate...","nextNodeIds":[700240107]},{"nodeId":700240107,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":3770450482,"text":"All of whom have reported a strange phenomenon — that whenever they discover a group of hilichurls gathering together, there is always a certain unusual hilichurl in their midst...","nextNodeIds":[700240108]},{"nodeId":700240108,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":3872327922,"text":"We believe that this \"Unusual Hilichurl\" could be a key factor in the recent disturbances.","nextNodeIds":[700240114]},{"nodeId":700240114,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":1623612274,"text":"So, we require someone to capture the Unusual Hilichurl, or at the very least chase it away.","nextNodeIds":[700240109]},{"nodeId":700240109,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":459599826,"text":"Traveler, are you interested in accepting this commission?","nextNodeIds":[700240110,700240111]},{"nodeId":700240110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1641453858,"text":"Sure.","nextNodeIds":[700240112]},{"nodeId":700240112,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":1637389930,"text":"Thank you! I have marked some locations for you on your Map.","nextNodeIds":[700240113]},{"nodeId":700240113,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":3458331282,"text":"Hilichurl activity has been reported in each of these areas. Please begin your investigation by visiting them.","nextNodeIds":[700240115]},{"nodeId":700240115,"roleType":"TALK_ROLE_NPC","speakerId":151201,"speakerName":"Katheryne","textMapHash":668150994,"text":"Should you encounter the Unusual Hilichurl... Please exercise due caution.","nextNodeIds":[]},{"nodeId":700240111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4063300602,"text":"I will keep my eyes open when I'm out and about.","nextNodeIds":[700240112]},{"nodeId":700240104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4032640010,"text":"What kind of commission?","nextNodeIds":[700240105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDC