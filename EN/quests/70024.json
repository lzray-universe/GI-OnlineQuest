EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7002404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7002402,"initDialog":700240201,"nextRandomTalks":[],"nextTalks":[],"npcId":[156501,1005],"performCfg":"QuestDialogue/WQ/MimiTomo_70024/Q700240201","priority":5,"questId":70024,"showRandomTalkCount":0},"dialogs":[{"nodeId":700240202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1620496578,"text":"I'll say...","nextNodeIds":[700240204]},{"nodeId":700240203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":814998138,"text":"Are you alright...?","nextNodeIds":[700240204]},{"nodeId":700240201,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":1775923706,"text":"Phew... That was close. Good thing you came when you did...","nextNodeIds":[700240202,700240203]},{"nodeId":700240204,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":2757503786,"text":"*sigh*...","nextNodeIds":[700240205]},{"nodeId":700240205,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":3651678586,"text":"I don't understand, everything was going so well... What was it that I said?","nextNodeIds":[700240206]},{"nodeId":700240206,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":3698582514,"text":"Well, anyway... Thank you for saving me...","nextNodeIds":[700240207]},{"nodeId":700240207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":86069722,"text":"She looks really upset...","nextNodeIds":[700240208]},{"nodeId":700240208,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":3964289722,"text":"Well... You saw what happened.","nextNodeIds":[700240223]},{"nodeId":700240223,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":1987194986,"text":"My previous strategy of attempting to interact with hilichurls on my own is manifestly too risky...","nextNodeIds":[700240209]},{"nodeId":700240210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2448728698,"text":"I see...","nextNodeIds":[700240212]},{"nodeId":700240211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2400990298,"text":"Is there anything I can do?","nextNodeIds":[700240212]},{"nodeId":700240209,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":488563914,"text":"But still... It's a shame for a golden opportunity to converse with a hilichurl to just go to waste...","nextNodeIds":[700240210,700240211]},{"nodeId":700240212,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":2044423138,"text":"It looks like my vocabulary compilation work for the dictionary is going to have to be postponed once again...","nextNodeIds":[700240224]},{"nodeId":700240213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1836806874,"text":"I can help.","nextNodeIds":[700240214]},{"nodeId":700240224,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":1862631194,"text":"If only I had someone who could verify the accuracy of the book's contents on my behalf...","nextNodeIds":[700240213]},{"nodeId":700240214,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":2999302138,"text":"R—Really? That's great! ...Right then, be sure to take this book with you!","nextNodeIds":[700240215]},{"nodeId":700240215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2834021266,"text":"Wow... That was a fast transition from sulking to bossing us around...","nextNodeIds":[700240216]},{"nodeId":700240217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1080304770,"text":"...In principle?","nextNodeIds":[700240218]},{"nodeId":700240216,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":1439024514,"text":"If you encounter any communication difficulties, you'll be able to resolve them simply by consulting this book! ...In principle, at least.","nextNodeIds":[700240217]},{"nodeId":700240218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":902162554,"text":"You mean you don't even know what you wrote in your own book!?","nextNodeIds":[700240219]},{"nodeId":700240219,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":2535686498,"text":"You only find out where the problems in your research lie through real-world application! Without putting them through their paces, how am I supposed to know for sure whether my theories hold water?","nextNodeIds":[700240225]},{"nodeId":700240225,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":455858290,"text":"Hmm... Nope, never mind, you probably wouldn't understand what I was about to say anyway. But that aside... thank you, once again, for saving me.","nextNodeIds":[700240220]},{"nodeId":700240221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3919982610,"text":"Welcome to the crew!","nextNodeIds":[]},{"nodeId":700240222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":757903594,"text":"Since we've come this far already...","nextNodeIds":[]},{"nodeId":700240220,"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","textMapHash":4285675114,"text":"Now, if you don't mind, I will join you. Let's go find a hilichurl to interact with.","nextNodeIds":[700240220,700240221]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133001927"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["7002404","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["156501","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7002401,7002402],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":156501,"speakerName":"Ella Musk","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Travel