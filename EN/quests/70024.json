{"mainQuestId":70024,"title":"Mimi Tomo","description":"The Adventurers' Guild has issued a new commission, and it seems to be related to a certain \"Unusual Hilichurl\"...?","titleTextMapHash":144620183,"descTextMapHash":3081597382,"mainQuestExcel":{"mainQuestId":70024,"titleTextMapHash":144620183,"title":"Mimi Tomo","descTextMapHash":3081597382,"description":"The Adventurers' Guild has issued a new commission, and it seems to be related to a certain \"Unusual Hilichurl\"...?","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":5024,"luaPath":"Actor/Quest/WQ70024","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5024,"chapterId":0,"descTextMapHash":3081597382,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70024,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3181317193,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70024","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170024],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":144620183,"type":"WQ","unlockDescTextMapHash":3435863494}},"flow":[{"subQuestId":7002401,"order":1,"stepDescription":"Go to the Adventurers' Guild","stepDescTextMapHash":817643876,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA