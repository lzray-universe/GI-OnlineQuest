"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7604907,"initDialog":760490701,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76049/Q7604907","priority":5,"questId":76049,"showRandomTalkCount":0},"dialogs":[{"nodeId":760490702,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3665717202,"text":"Oh, it's over already? I could listen to that forever...","nextNodeIds":[760490703]},{"nodeId":760490703,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4231912434,"text":"As I once told you, this is the only lullaby I can remember.","nextNodeIds":[760490704]},{"nodeId":760490704,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2258584194,"text":"Although I have yet to discern the meaning behind it, after hearing you play, I feel like whatever answer is waiting for me, up there on the moon... at the very least, it must be a beautiful one.","nextNodeIds":[760490705]},{"nodeId":760490705,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1034048802,"text":"Here, give me your hand.","nextNodeIds":[760490706]},{"nodeId":760490706,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1030996010,"text":"It's okay. Seriously, you don't need to give us anything in return.","nextNodeIds":[760490707]},{"nodeId":760490707,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2155818994,"text":"Ah, that wasn't my intention... I only wished to adorn your melody with a ray of gentle moonlight.","nextNodeIds":[]},{"nodeId":760490709