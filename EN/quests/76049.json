","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7604901,"initDialog":760490101,"nextRandomTalks":[],"nextTalks":[7604902,7604908],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76049/Q7604901","priority":5,"questId":76049,"showRandomTalkCount":0},"dialogs":[{"nodeId":760490101,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2583249722,"text":"...Hmm, a half-step too high, perhaps. Let's try that again, shall we?","nextNodeIds":[760490102]},{"nodeId":760490102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3884135914,"text":"Hey there, Columbina!","nextNodeIds":[760490103]},{"nodeId":760490103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4255991026,"text":"Wait, are you... teaching the kuuhenki how to play the lyre?","nextNodeIds":[760490104]},{"nodeId":760490104,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2032782714,"text":"Yes. They were so happy to have it fixed, they practically haven't left my side.","nextNodeIds":[760490105]},{"nodeId":760490105,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4231228626,"text":"Playing the lyre has never been my forte, though. I'm more accustomed to hearing others play.","nextNodeIds":[760490106]},{"nodeId":760490106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1483949650,"text":"Ohhh, right! If you had a band, you'd totally be in charge of vocals, huh...","nextNodeIds":[760490107]},{"nodeId":760490107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2757995074,"text":"#When it comes to instruments, though... {NICKNAME}'s pretty much a prodigy! From the lyre to the Djem Djem Drum, this one can do it all!","nextNodeIds":[760490108,760490109]},{"nodeId":760490108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2611621042,"text":"I'm nothing special, honestly...","nextNodeIds":[760490110]},{"nodeId":760490110,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2227962578,"text":"Oh, is that so? In that case... Perhaps you could teach them instead?","nextNodeIds":[760490111,760490112]},{"nodeId":760490111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4271829218,"text":"Alright then, why not?","nextNodeIds":[760490113]},{"nodeId":760490113,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3716100202,"text":"I was having them practice the song I usually sing. Perhaps you remember how it goes...","nextNodeIds":[760490114]},{"nodeId":760490114,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3185965738,"text":"Or... A different tune works as well. Rarely do the kuuhenki get to hear music from other places. I would be quite interested to hear something like that too.","nextNodeIds":[760490115]},{"nodeId":760490115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3005180010,"text":"(Hmm, what should I play...)","nextNodeIds":[760490202,760490801]},{"nodeId":760490202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2586285570,"text":"Let's try the one Columbina always sings...","nextNodeIds":[760490201]},{"nodeId":760490201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3578998170,"text":"(But what tone should I go for...)","nextNodeIds":[760490603,760490701]},{"nodeId":760490603,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3424614634,"text":"Let's try calm and gentle...","nextNodeIds":[760490604]},{"nodeId":760490604,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2355375010,"text":"That was lovely. So you really did memorize my tune.","nextNodeIds":[760490605]},{"nodeId":760490605,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3927378426,"text":"Hehe, only 'cause you're such a great singer! Whenever we hear your voice, sometimes we stop for a bit just to listen...","nextNodeIds":[760490606]},{"nodeId":760490606,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3181297618,"text":"Hm, the kuuhenki seemed quite enraptured with your performance as well. Perhaps they picked up a few things...","nextNodeIds":[760490607]},{"nodeId":760490607,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2745433354,"text":"I might require your educational assistance again in the future.","nextNodeIds":[760490608]},{"nodeId":760490608,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1978945250,"text":"Come, give me your hand.","nextNodeIds":[760490609]},{"nodeId":760490609,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3175521098,"text":"Huh? No, no, this was a free performance. No tuition fee required!","nextNodeIds":[760490610]},{"nodeId":760490610,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2567891362,"text":"Hmm? Tuition fee?","nextNodeIds":[760490611]},{"nodeId":760490611,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2274589514,"text":"I only thought... the gentle glow of moonlight would make a fitting accompaniment for such a beautiful melody.","nextNodeIds":[]},{"nodeId":760490701,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":890029826,"text":"Let's make it cheerful...","nextNodeIds":[760490702]},{"nodeId":760490702,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3665717202,"text":"Oh, it's over already? I could listen to that forever...","nextNodeIds":[760490703]},{"nodeId":760490703,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4231912434,"text":"As I once told you, this is the only lullaby I can remember.","nextNodeIds":[760490704]},{"nodeId":760490704,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2258584194,"text":"Although I have yet to discern the meaning behind it, after hearing you play, I feel like whatever answer is waiting for me, up there on the moon... at the very least, it must be a beautiful one.","nextNodeIds":[760490705]},{"nodeId":760490705,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1034048802,"text":"Here, give me your hand.","nextNodeIds":[760490706]},{"nodeId":760490706,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1030996010,"text":"It's okay. Seriously, you don't need to give us anything in return.","nextNodeIds":[760490707]},{"nodeId":760490707,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2155818994,"text":"Ah, that wasn't my intention... I only wished to adorn your melody with a ray of gentle moonlight.","nextNodeIds":[]},{"nodeId":760490801,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":254943778,"text":"Let's try something from another nation...","nextNodeIds":[760490802]},{"nodeId":760490802,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3628717402,"text":"How curious... I have heard melodies like this before, but your playing lends a whole new dimension...","nextNodeIds":[760490803]},{"nodeId":760490803,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1848598698,"text":"#Ah, maybe because {NICKNAME} was channeling {M#his}{F#her} emotional connection to that place...","nextNodeIds":[760490804]},{"nodeId":760490804,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3641150514,"text":"What's curious is that... I feel as if I can picture the landscape just by listening to the melody. I wonder how the real thing compares to my imagination...","nextNodeIds":[760490805]},{"nodeId":760490805,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":528610962,"text":"You should just go see it someday! We can be your tour guides!","nextNodeIds":[760490806]},{"nodeId":760490806,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":704765010,"text":"Mm... Perhaps. If that day ever comes.","nextNodeIds":[]},{"nodeId":760490112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2208896746,"text":"But what should I play?","nextNodeIds":[760490113]},{"nodeId":760490109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3585898402,"text":"Though I have been known to dabble...","nextNodeIds":[760490110]}]},{"talkId":7604902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideL