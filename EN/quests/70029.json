{"mainQuestId":70029,"title":"Autonomous Mechanical Energy Source: Conclusion","description":"With Hosseini's help, you successfully defeated that unique autonomous machine. Inform him of the good news.","titleTextMapHash":1445670327,"descTextMapHash":1485314318,"mainQuestExcel":{"mainQuestId":70029,"titleTextMapHash":1445670327,"title":"Autonomous Mechanical Energy Source: Conclusion","descTextMapHash":1485314318,"description":"With Hosseini's help, you successfully defeated that unique autonomous machine. Inform him of the good news.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ70029","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":1485314318,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70029,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":926181537,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70029","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170029],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1445670327,"type":"WQ","unlockDescTextMapHash":1105271782}},"flow":[{"subQuestId":7002901,"order":1,"stepDescription":"Chat with Hosseini","stepDescTextMapHash":3376063132,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30068"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7002901],"talks":[{"talkId":7002901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7002901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7002901,"initDialog":700290101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30068],"performCfg":"","priority":5,"questId":70029,"showRandomTalkCount":0},"dialogs":[{"nodeId":700290101,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":832006018,"text":"How did it go, Traveler? Did Pursina's Spikes come in handy?","nextNodeIds":[700290102,700290103]},{"nodeId":700290102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3934708258,"text":"They were a big help.","nextNodeIds":[700290104]},{"nodeId":700290104,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1181336770,"text":"Very good! We did not labor in vain, then. I suppose this commission has also drawn to a close.","nextNodeIds":[700290105]},{"nodeId":700290105,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3732065834,"text":"As for this anomalous Ruin Grader model, its functions seem vastly different from your ordinary wandering Ruin Guards or Ruin Hunters. The entire thought process behind their design was superior by leaps and bounds.","nextNodeIds":[700290106]},{"nodeId":700290106,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1870282226,"text":"However, similar machines are not common. My guess is that this might have been some sort of experimental model.","nextNodeIds":[700290107]},{"nodeId":700290107,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":190889626,"text":"Why did its initial creator make it in the first place?","nextNodeIds":[700290108]},{"nodeId":700290108,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2606230514,"text":"Does this mean that the ancients' skill in making autonomous machines is greater than we estimated? How very fascinating.","nextNodeIds":[700290109]},{"nodeId":700290109,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3214533882,"text":"If I could take it apart, we'd be sure to make some revolutionary discoveries...","nextNodeIds":[700290110]},{"nodeId":700290110,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":719388234,"text":"Traveler, if you have the time, could you take me to see the remains of that anomalous model?","nextNodeIds":[700290111]},{"nodeId":700290111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2911431370,"text":"There's not much left of it.","nextNodeIds":[700290112]},{"nodeId":700290112,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1931569290,"text":"What? Did you destroy its frame completely?","nextNodeIds":[700290113]},{"nodeId":700290113,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1747431946,"text":"Agh, Archon... What a colossal waste! No, it's a colossal error!","nextNodeIds":[700290114]},{"nodeId":700290114,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":205839474,"text":"*sigh* It's all my fault. I should have reminded you beforehand...","nextNodeIds":[700290115]},{"nodeId":700290115,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1951555818,"text":"Ah, what a shame, what a shame! It could have been a historical find in the field of ancient technical studies... And now there's nothing left to even take back as samples.","nextNodeIds":[700290116,700290119]},{"nodeId":700290116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":775254010,"text":"I'm sorry.","nextNodeIds":[700290117]},{"nodeId":700290117,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":4186561858,"text":"No, no, it's alright. You weren't aware of the academic value it held in the first place, so you can't be blamed for acting as you did.","nextNodeIds":[700290118]},{"nodeId":700290118,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2582454194,"text":"It was I who, as the person who knew its value, should've reminded you, but did not. I was remiss in my duties, not you in yours.","nextNodeIds":[700290121]},{"nodeId":700290121,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1604965122,"text":"This trip really was a struggle from start to finish. First, I couldn't secure long-term residence in Ritou... and now I've allowed such a momentous discovery to go to waste...","nextNodeIds":[700290122]},{"nodeId":700290122,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2178352018,"text":"Ah, it's all water under the bridge now. Let's be positive, shall we? At the very least, I did manage to repair my set of Pursina's Spikes, and even managed to test their functionality.","nextNodeIds":[700290123]},{"nodeId":700290123,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1694417106,"text":"Ah, I truly do look up to Pursina and Ayesha, who were able to make such precise instruments. Their wonderful creations should never have been allowed to waste away inside our storehouses.","nextNodeIds":[700290124]},{"nodeId":700290124,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2031083178,"text":"...You know what? If my research here in Inazuma really can't proceed, I might as well change my research topic to Pursina's Spikes.","nextNodeIds":[700290125]},{"nodeId":700290125,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2079374474,"text":"If the Akademiya ends up taking notice of this subject of study, and if my research paper does end up being published...","nextNodeIds":[700290126]},{"nodeId":700290126,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2429971082,"text":"Haha, I'll definitely write your name into the acknowledgments.","nextNodeIds":[700290127]},{"nodeId":700290127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":843287570,"text":"Let's hope I actually understand your report.","nextNodeIds":[700290128]},{"nodeId":700290128,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1550206402,"text":"Well, we'll see, won't we?","nextNodeIds":[700290129]},{"nodeId":700290129,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3820890058,"text":"I hope that your future travels will avail you as much as our cooperation this time has.","nextNodeIds":[]},{"nodeId":700290119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2003372154,"text":"Well, if you had told me earlier...","nextNodeIds":[700290120]},{"nodeId":700290120,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":720784154,"text":"Indeed, this problem arose from my failure to consider all the possibilities. Alas, it is all too late now.","nextNodeIds":[700290121]},{"nodeId":700290103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":575376058,"text":"Our problem has been solved.","nextNodeIds":[700290104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30068"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7002901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","sp