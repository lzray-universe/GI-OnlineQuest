{"mainQuestId":73691,"title":"Gathering of Stars","description":"Farbal from Rtawahist seems to be busy with something...","titleTextMapHash":1023523383,"descTextMapHash":3086209902,"mainQuestExcel":{"mainQuestId":73691,"titleTextMapHash":1023523383,"title":"Gathering of Stars","descTextMapHash":3086209902,"description":"Farbal from Rtawahist seems to be busy with something...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2021,"luaPath":"Actor/Quest/WQ73691","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2021,"chapterId":0,"descTextMapHash":3086209902,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73691,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1593358857,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73691","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173691],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1023523383,"type":"WQ","unlockDescTextMapHash":1560383438}},"flow":[{"subQuestId":7369101,"order":1,"stepDescription":"Talk to Farbal","stepDescTextMapHash":3958764156,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30347"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369101],"talks":[{"talkId":7369101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7369101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369101,"initDialog":736910101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30347],"performCfg":"QuestDialogue/WQ/Sumeru_73691/Q7369101","priority":5,"questId":73691,"showRandomTalkCount":0},"dialogs":[{"nodeId":736910101,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":4090866002,"text":"I hope everyone will enjoy this little gadget...","nextNodeIds":[736910102]},{"nodeId":736910102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4164960706,"text":"What's there to play over here?","nextNodeIds":[736910103]},{"nodeId":736910103,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":4282956570,"text":"You're... the Traveler, aren't you? I'm Farbal, from Rtawahist.","nextNodeIds":[736910104]},{"nodeId":736910104,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":631090562,"text":"Um, I don't suppose you know what it is we study here, do you?","nextNodeIds":[736910105]},{"nodeId":736910105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3453294730,"text":"Huh. Well, I think it was...","nextNodeIds":[736910106]},{"nodeId":736910106,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":123555570,"text":"We study the stars... though that's not a very precise way of putting it. We do have a lot of specializations within the Darshan itself.","nextNodeIds":[736910107]},{"nodeId":736910107,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":3186616058,"text":"Unfortunately, a lot of things about our research wouldn't make much sense to the average person if we just explained it as-is... In fact, the chances of them even being interested are slim.","nextNodeIds":[736910108]},{"nodeId":736910108,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":2237387938,"text":"And I was concerned that setting up an astrology booth would just end in the involved students getting into academic discussions and not manning the stall.","nextNodeIds":[736910109]},{"nodeId":736910109,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":2497094722,"text":"As such, after much discussion, we decided on a middle-of-the-road option.","nextNodeIds":[736910110]},{"nodeId":736910110,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":2290994394,"text":"See this special astrolabe? Many stars have been placed on it, and what you need to do is arrange them into a specified image.","nextNodeIds":[736910111]},{"nodeId":736910111,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":1645446882,"text":"These images will not be particularly complicated, and they will not involve any ongoing and as-yet-unresolved academic disputes.","nextNodeIds":[736910112]},{"nodeId":736910112,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":2923685106,"text":"Ahem... So, uh... A simple, fun, and definitely not divisive pictorial puzzle!","nextNodeIds":[736910113]},{"nodeId":736910113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3955222282,"text":"You strike me as being really nervous.","nextNodeIds":[736910114]},{"nodeId":736910114,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":3832691290,"text":"Well, this game does have to do with the stars, after all. Some of our students get the sweats the moment they hear that word.","nextNodeIds":[736910115]},{"nodeId":736910115,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":4127218,"text":"You don't know how many people I had to tell that this is just a toy and has nothing to do with academic research...","nextNodeIds":[736910116]},{"nodeId":736910116,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":260320490,"text":"Never mind that. If you're interested, feel free to give it a go.","nextNodeIds":[736910117,736910119]},{"nodeId":736910117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2336902514,"text":"I'd like to give this a try.","nextNodeIds":[736910118]},{"nodeId":736910118,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":2391322122,"text":"Sure. The astrolabe is over here.","nextNodeIds":[]},{"nodeId":736910119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1641287778,"text":"I've got other matters to attend to at the moment.","nextNodeIds":[736910120]},{"nodeId":736910120,"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","textMapHash":964434146,"text":"Well, I'll be here at the booth throughout the Gala. If you're of a mind to play, just hit me up.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30347"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7369101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30347,"speakerName":"Farbal","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173691],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3086209902,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Su