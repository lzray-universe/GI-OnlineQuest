NoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7410003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7410025,"initDialog":741002501,"nextRandomTalks":[],"nextTalks":[],"npcId":[20997,20996],"performCfg":"QuestDialogue/WQ/Fontaine_74100/Q7410025","priority":3,"questId":74100,"showRandomTalkCount":0},"dialogs":[{"nodeId":741002501,"roleType":"TALK_ROLE_NPC","speakerId":20997,"speakerName":"Al","textMapHash":89162074,"text":"If we can recover Princess Lyris's treasure, the forces of justice will grow ever mightier with the passage of time! The day of our victory over Narcissus grows near!","nextNodeIds":[741002502]},{"nodeId":741002502,"roleType":"TALK_ROLE_NPC","speakerId":20997,"speakerName":"Al","textMapHash":1792075554,"text":"...This is why we cannot forget Ney's heroic sacrifice. Had he not hidden the treasure, Narcissus would surely have already breached the tower where the princess resides.","nextNodeIds":[741002503]},{"nodeId":741002503,"roleType":"TALK_ROLE_NPC","speakerId":20996,"speakerName":"Petit Chou","textMapHash":3914652002,"text":"Yeah! Ney is super amazing!","nextNodeIds":[741002504]},{"nodeId":741002504,"roleType":"TALK_ROLE_NPC","speakerId":20997,"speakerName":"Al","textMapHash":4154161418,"text":"#We will not let Ney's efforts be in vain, nor will we fail to honor {NICKNAME}'s extraordinary contributions! This time, with all of your help, we will save Princess Lyris!","nextNodeIds":[741002505]},{"nodeId":741002505,"roleType":"TALK_ROLE_NPC","speakerId":20996,"speakerName":"Petit Chou","textMapHash":2914226242,"text":"Yeah! We'll save Princess Lyris, and then, and then...","nextNodeIds":[741002506]},{"nodeId":741002506,"roleType":"TALK_ROLE_NPC","speakerId":20997,"speakerName":"Al","textMapHash":98937178,"text":"And then the Narzissenkreuz Kingdom will be restored to its former radiant glory! The Princess shall hold you in her arms, groom your feathers, and gently pat your tiny little forehead!","nextNodeIds":[741002507]},{"nodeId":741002507,"roleType":"TALK_ROLE_NPC","speakerId":20997,"speakerName":"Al","textMapHash":654339290,"text":"The memories lost in the waters will resurface, and all our friends will surround the princess and laugh together! It will be a scene filled with beauteous joy, and never again will disputes or trouble cloud the horizon.","nextNodeIds":[741002508]},{"nodeId":741002508,"roleType":"TALK_ROLE_NPC","speakerId":20996,"speakerName":"Petit Chou","textMapHash":2311227570,"text":"Just like before!","nextNodeIds":[741002509]},{"nodeId":741002509,"roleType":"TALK_ROLE_NPC","speakerId":20997,"speakerName":"Al","textMapHash":1450570818,"text":"...That's right, just like before.","nextNodeIds":[]}]},{"talkId":7410026,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7410003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7410026,"initDialog":741002601,"nextRandomTalks":[],"nextTalks":[],"npcId":[20998],"performCfg":"QuestDialogue/WQ/Fontaine_74100/Q7410026","priority":3,"questId":74100,"showRandomTalkCount":0},"dialogs":[{"nodeId":741002601,"roleType":"TALK_ROLE_NPC","speakerId":20998,"speakerName":"Jak","textMapHash":948492178,"text":"#{NICKNAME}, it's you! Once we retrieve Ms. Lyris's treasure, the key to victory shall be ours.","nextNodeIds":[741002602]},{"nodeId":741002602,"roleType":"TALK_ROLE_NPC","speakerId":20998,"speakerName":"Jak","textMapHash":3621014202,"text":"We will finally have a chance to defeat the invaders from without and save Ms. Lyris! Thus shall Orchestre Jak perform...","nextNodeIds":[741002603]},{"nodeId":741002603,"roleType":"TALK_ROLE_NPC","speakerId":20998,"speakerName":"Jak","textMapHash":1965926674,"text":"The last movement of the overture!","nextNodeIds":[741002604,741002605]},{"nodeId":741002604,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2456097914,"text":"Seriously? Just the overture...?","nextNodeIds":[741002606]},{"nodeId":741002606,"roleType":"TALK_ROLE_NPC","speakerId":20998,"speakerName":"Jak","textMapHash":4284537650,"text":"Oh? You really think that everything would just come to an end after saving Ms. Lyris and rebuilding the kingdom? Hah! The real world is no simple little fairytale!","nextNodeIds":[741002607]},{"nodeId":741002607,"roleType":"TALK_ROLE_NPC","speakerId":20998,"speakerName":"Jak","textMapHash":4226758026,"text":"It's because the world is full of naive simpletons that think like you that history always repeats itself! The next step is obviously to overthrow the deeply entrenched class structure and methods of distributing society's wealth.","nextNodeIds":[741002608]},{"nodeId":741002608,"roleType":"TALK_ROLE_NPC","speakerId":20998,"speakerName":"Jak","textMapHash":3454447658,"text":"In a world that is reasonably equal, equality must be the reasonable state, and this is certainly what Ms. Lyris strives for. Now, consideration for present circumstances has led to the due juxtaposition of...","nextNodeIds":[741002609]},{"nodeId":741002609,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2918672994,"text":"That's my cue to leave...","nextNodeIds":[741002610]},{"nodeId":741002610,"roleType":"TALK_ROLE_NPC","speakerId":20998,"speakerName":"Jak","textMapHash":2904440474,"text":"First, naturally based upon... we should... construct... overturn...","nextNodeIds":[]},{"nodeId":741002605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1199542314,"text":"I would have thought it was the climax of the symphony.","nextNodeIds":[741002606]}]}],"conditions":{"finishCond":[{"BFGALAINLMD"