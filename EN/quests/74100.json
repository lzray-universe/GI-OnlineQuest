k you, good person!","nextNodeIds":[]},{"nodeId":741003106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4255627506,"text":"I'll pet you more next time, Mori.","nextNodeIds":[741003107]},{"nodeId":741003107,"roleType":"TALK_ROLE_NPC","speakerId":20999,"speakerName":"Mori","textMapHash":3924790618,"text":"Wooof... Mori bad, so no pet?","nextNodeIds":[741003108]},{"nodeId":741003108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3559352978,"text":"What does that have to do with being good or bad?","nextNodeIds":[741003109]},{"nodeId":741003109,"roleType":"TALK_ROLE_NPC","speakerId":20999,"speakerName":"Mori","textMapHash":3417925226,"text":"Woof woof! Good dogs get scritches. Bad dogs get... fixed.","nextNodeIds":[741003110]},{"nodeId":741003110,"roleType":"TALK_ROLE_NPC","speakerId":20999,"speakerName":"Mori","textMapHash":3295364122,"text":"*whimpering*","nextNodeIds":[741003111]},{"nodeId":741003111,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1790699730,"text":"Seeing Mori sad, you reach out a hand to pet Mori.\\nAs Mori is a (hound) made of water, it's quite wet.\\nMori's blue eyes begin shining once again.","nextNodeIds":[741003112]},{"nodeId":741003112,"roleType":"TALK_ROLE_NPC","speakerId":20999,"speakerName":"Mori","textMapHash":3686448114,"text":"Woof woof! Thank you for the pets!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7400208,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,