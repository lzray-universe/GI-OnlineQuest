"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4134101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4134101,"initDialog":413410101,"nextRandomTalks":[],"nextTalks":[],"npcId":[211801],"performCfg":"QuestDialogue/WQ/Liyue_41341/Q4134101","priority":5,"questId":41341,"showRandomTalkCount":0},"dialogs":[{"nodeId":413410101,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":947476602,"text":"Xiao Lanterns are soooo hard to make...","nextNodeIds":[413410102]},{"nodeId":413410102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1976113170,"text":"What's wrong?","nextNodeIds":[413410103]},{"nodeId":413410103,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":3270419522,"text":"Do you know how to make Xiao Lanterns? I keep trying but I can't do it...","nextNodeIds":[413410104]},{"nodeId":413410104,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":841087162,"text":"Through the hole, then back around, and then... I drop it. Or it breaks.","nextNodeIds":[413410105]},{"nodeId":413410105,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":2850098218,"text":"I really wanted to make a Xiao Lantern for Yu...","nextNodeIds":[413410106]},{"nodeId":413410106,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":1833712906,"text":"Yu always has to look after the tea shop, so he never has any time to play or to make a lantern.","nextNodeIds":[413410107]},{"nodeId":413410107,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":2910097066,"text":"But I bet he still has a wish. So I wanna make a lantern for him...","nextNodeIds":[413410108,413410109]},{"nodeId":413410108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2023964498,"text":"I can make one for you.","nextNodeIds":[413410110]},{"nodeId":413410110,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":817864002,"text":"But, but... I wanted to be the one to make it for him...","nextNodeIds":[413410111]},{"nodeId":413410111,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":2545128226,"text":"And, and... I wanna know the secrets to making them so I can tell Yu, too.","nextNodeIds":[413410112]},{"nodeId":413410112,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":1374859034,"text":"Could you... teach me how to make them?","nextNodeIds":[413410113]},{"nodeId":413410113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3112362850,"text":"Sure.","nextNodeIds":[413410114]},{"nodeId":413410114,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":916445442,"text":"Yay!","nextNodeIds":[413410115]},{"nodeId":413410115,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":1083350410,"text":"So, so... Then the Xiao Lantern is ready, right?","nextNodeIds":[413410116]},{"nodeId":413410116,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":3535436746,"text":"Thanks! I'm gonna go make one for Yu now!","nextNodeIds":[]},{"nodeId":413410109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":487287490,"text":"I'll make one for him.","nextNodeIds":[413410110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4134101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["211801"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4134102,"order":3,"stepDescription":"Follow Mengmeng to meet Yu","stepDescTextMapHash":1546583620,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4134102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["211901"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4134102],"talks":[{"talkId":4134102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"ex