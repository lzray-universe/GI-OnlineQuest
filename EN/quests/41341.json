ceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4134104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4134104,"initDialog":413410401,"nextRandomTalks":[],"nextTalks":[],"npcId":[211901],"performCfg":"QuestDialogue/WQ/Liyue_41341/Q4134104","priority":5,"questId":41341,"showRandomTalkCount":0},"dialogs":[{"nodeId":413410401,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":3398110234,"text":"#This Xiao Lantern looks so pretty! Thanks so much, {M#Sir}{F#Ma'am}!","nextNodeIds":[413410402]},{"nodeId":413410402,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":2868448330,"text":"Come on, Yu... Let's go and play. I know a great place with the prettiest flowers.","nextNodeIds":[413410403]},{"nodeId":413410403,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":573483258,"text":"#This {M#nice man}{F#nice lady} taught me how to make Xiao Lanterns, and when we get there I can teach you, too. C'mon, wouldn't that be great?","nextNodeIds":[413410404]},{"nodeId":413410404,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":3485511114,"text":"I, uh... I can't. I need to watch the shop. Even though there's no customers, I've gotta keep the place spick and span, just like my dad always says.","nextNodeIds":[413410405]},{"nodeId":413410405,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":3346230322,"text":"Okay, well... Scrap the Xiao Lanterns, how about we just go there, have a quick chat, then come back straight away? That way, it won't waste too much of your time.","nextNodeIds":[413410406]},{"nodeId":413410406,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":4288587730,"text":"But...","nextNodeIds":[413410407,413410408]},{"nodeId":413410407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":212064122,"text":"I can clean the shop for you.","nextNodeIds":[413410409]},{"nodeId":413410409,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":1124780162,"text":"...Oh? Y—You sure? That, uh... That's asking a lot of you...","nextNodeIds":[413410410]},{"nodeId":413410410,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":188821474,"text":"We'll be really quick, we'll just go straight there and come straight back. Promise it won't take too long!","nextNodeIds":[413410411]},{"nodeId":413410411,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":690756466,"text":"Thanks soooo much!","nextNodeIds":[]},{"nodeId":413410408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1831823618,"text":"Leave the cleaning to me.","nextNodeIds":[413410409]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4134104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActi