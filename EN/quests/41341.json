{"talkId":4134107,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4134107","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4134107,"initDialog":413410701,"nextRandomTalks":[],"nextTalks":[],"npcId":[211901],"performCfg":"QuestDialogue/WQ/Liyue_41341/Q4134107","priority":5,"questId":41341,"showRandomTalkCount":0},"dialogs":[{"nodeId":413410701,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2925860706,"text":"It looks like the two of them are still playing. Guess we don't have to worry.","nextNodeIds":[413410702]},{"nodeId":413410702,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2164627826,"text":"But given the atmosphere... Maybe we shouldn't disturb them.","nextNodeIds":[413410703,413410704]},{"nodeId":413410703,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2357661410,"text":"I wanna eavesdrop on them...","nextNodeIds":[413410705]},{"nodeId":413410705,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":3535274554,"text":"If we made a garland for your dad, do you think he'd get better quicker?","nextNodeIds":[413410706]},{"nodeId":413410706,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":1558761562,"text":"I... I don't know...","nextNodeIds":[413410707]},{"nodeId":413410707,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":1569456242,"text":"I read in a book that if you stay happy, even if you get sick, you'll get better really quickly.","nextNodeIds":[413410708]},{"nodeId":413410708,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":2680621554,"text":"I think that you're so grown-up, the way you help your dad watch the shop every day... And I'm sure that must make him very happy.","nextNodeIds":[413410709]},{"nodeId":413410709,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":679932746,"text":"But sometimes he tells me off... \"Stop lounging around in the shop, go off and play\"...","nextNodeIds":[413410710]},{"nodeId":413410710,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":2079089378,"text":"\"If you don't go and play with Mengmeng, she'll pick the whole neighborhood bare of flowers\"...","nextNodeIds":[413410711]},{"nodeId":413410711,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":3187536842,"text":"That would never happen, there's soooo many flowers around here... Wait a second, I'll make a garland for you.","nextNodeIds":[413410712]},{"nodeId":413410712,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":2362247914,"text":"Thanks, Mengmeng. I should be getting back.","nextNodeIds":[413410713]},{"nodeId":413410713,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":4057718530,"text":"Huh, okay... Well, once your dad's recovered, you'll have more time, right? Then I can come play with you again...","nextNodeIds":[413410714]},{"nodeId":413410714,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":536082394,"text":"Yep, I'm sure dad will make a quick recovery...","nextNodeIds":[413410715]},{"nodeId":413410715,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":192451314,"text":"What the...!? Wh—When did you get here?","nextNodeIds":[413410716,413410717]},{"nodeId":413410716,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3419327978,"text":"Only just arrived.","nextNodeIds":[413410718]},{"nodeId":413410718,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":3821231354,"text":"Uhh... Uhhhh... I—I...","nextNodeIds":[413410719]},{"nodeId":413410719,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":796914818,"text":"Happy Lantern Rite.","nextNodeIds":[413410720]},{"nodeId":413410720,"roleType":"TALK_ROLE_NPC","speakerId":211801,"speakerName":"Mengmeng","textMapHash":2675552186,"text":"Happy Lantern Rite to you, too!","nextNodeIds":[413410721]},{"nodeId":413410721,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":1338701906,"text":"Ha—Happy Lantern Rite...","nextNodeIds":[413410722]},{"nodeId":413410722,"roleType":"TALK_ROLE_NPC","speakerId":211901,"speakerName":"Yu","textMapHash":3653720914,"text":"Um, well, thanks for your help. Please take these as a thank-you. Dad says tha