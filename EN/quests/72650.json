{"mainQuestId":72650,"title":"Phantom Flow: Phantasmal Blade","description":"There is a rather unique martial arts school in Inazuma, and its name is \"Shinryuu.\"","titleTextMapHash":2822337335,"descTextMapHash":2026450582,"mainQuestExcel":{"mainQuestId":72650,"titleTextMapHash":2822337335,"title":"Phantom Flow: Phantasmal Blade","descTextMapHash":2026450582,"description":"There is a rather unique martial arts school in Inazuma, and its name is \"Shinryuu.\"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5034,"luaPath":"Actor/Quest/WQ72650","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5034,"chapterId":0,"descTextMapHash":2026450582,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72650,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3291970825,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72650","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172650],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2822337335,"type":"WQ","unlockDescTextMapHash":1097260502}},"flow":[{"subQuestId":7265001,"order":1,"stepDescription":"Talk to Shousen","stepDescTextMapHash":429131908,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30054","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7265001],"talks":[{"talkId":7265001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7265001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7265001,"initDialog":726500101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30054],"performCfg":"QuestDialogue/WQ/Daoqi_72650/Q7265001","priority":5,"questId":72650,"showRandomTalkCount":0},"dialogs":[{"nodeId":726500101,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":797513266,"text":"Hello. My name is Shousen. I'm the master of Shinryuu.","nextNodeIds":[726500102]},{"nodeId":726500102,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":4203649058,"text":"From your appearance, you must be a traveler from afar. What do you say? Are you interested in learning this art?","nextNodeIds":[726500103,726500104]},{"nodeId":726500103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3724280458,"text":"\"Shinryuu\"...?","nextNodeIds":[726500106]},{"nodeId":726500106,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":401189658,"text":"This is an original skill that I invented. It's different from the Iwakura and Kitain Arts — or even the Favonius Bladework from overseas — which all require weapons for combat, in the sense that the essence of my technique is exercising one's heart to hone one's combat skills.","nextNodeIds":[726500107]},{"nodeId":726500107,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":1225072026,"text":"In my early years, I traveled abroad to study martial arts. There, I observed Natlan's boxing arts. When they practiced, they would fight with an imaginary opponent.","nextNodeIds":[726500108]},{"nodeId":726500108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1932800674,"text":"Imaginary opponent?","nextNodeIds":[726500109]},{"nodeId":726500109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3988305026,"text":"So you fight with your imaginary friend?","nextNodeIds":[726500110]},{"nodeId":726500110,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":2670607466,"text":"Precisely. You imagine your opponent's actions and react based on your own imagination. This practice, which the locals there call \"shadow boxing,\" appeared to be a rather lofty skill to me.","nextNodeIds":[726500111]},{"nodeId":726500111,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":2602842634,"text":"As such, Shinryuu is an unrestricted school of fighting that makes use of this practice method. Under my guidance, you can recreate all manner of imaginary opponents.","nextNodeIds":[726500112]},{"nodeId":726500112,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":2386158698,"text":"From slimes to ochimusha, and even to those outlander warriors from Snezhnaya. So long as you are well-versed in the art of Shinryuu, you can easily recreate a battle with them to hone your combat skills.","nextNodeIds":[726500113]},{"nodeId":726500113,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":3037284546,"text":"By the way, I'm afraid that the mightiest creature in the world is the Electro Crystalfly. Eiin, the previous Iwakura successor, once tried to challenge a human-shaped Electro Crystalfly using Shinryuu. He barely lasted ten seconds.","nextNodeIds":[726500114]},{"nodeId":726500114,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":1639501586,"text":"This art is not limited to opponents alone. I can even simulate the wind direction, weather, mechanisms and even Ley Line Disorders using Shinryuu. It is a truly practical skill.","nextNodeIds":[726500115]},{"nodeId":726500115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":613132802,"text":"Paimon's gotta ask, if Shinryuu is already so strong, why do you still need to ask people to join yourself, Mr. Shousen?","nextNodeIds":[726500116]},{"nodeId":726500116,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":2949348218,"text":"My Shinryuu is a little too... real, to the point where my disciples can become injured when fighting their imaginary foes.","nextNodeIds":[726500128]},{"nodeId":726500128,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":648034298,"text":"Even an imaginary blade created by Shinryuu can slice your hands and feet. A musket so imagined can also shoot through your body.","nextNodeIds":[726500117]},{"nodeId":726500117,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":584092250,"text":"As time goes by, people who are not devoted to the martial arts will leave Shinryuu out of fear. As for some others, I judged that they were manic martial desperados, unsuited to mastering this art, and so I kicked them out.","nextNodeIds":[726500118,726500119]},{"nodeId":726500118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1629025994,"text":"Wow, that good, huh?","nextNodeIds":[726500120]},{"nodeId":726500120,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":668924338,"text":"Indeed. However, I believe that you are most suitable for the art of Shinryuu. Perhaps fated to use it, even. Would you like to give it a go?","nextNodeIds":[726500121,726500122]},{"nodeId":726500121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":21026890,"text":"Seems interesting...","nextNodeIds":[726500124]},{"nodeId":726500124,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":2702895338,"text":"Well, if you are interested, just imagine the platform in front of you as the Shinryuu arena.","nextNodeIds":[726500125]},{"nodeId":726500125,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":1191767826,"text":"I will then tailor-make the most suitable battlefield for you by the power of Shinryuu.","nextNodeIds":[726500126]},{"nodeId":726500126,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":1466940258,"text":"Be careful, and mind you don't get hurt. After all..","nextNodeIds":[726500127]},{"nodeId":726500127,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":207760450,"text":"Shinryuu can be truly ruthless.","nextNodeIds":[]},{"nodeId":726500122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3355951890,"text":"I'll pass.","nextNodeIds":[726500123]},{"nodeId":726500123,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":3660972290,"text":"I see. That's a shame.","nextNodeIds":[726500124]},{"nodeId":726500119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":268630682,"text":"Wow, that scary, huh?","nextNodeIds":[726500120]},{"nodeId":726500104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4097065890,"text":"Gotta say that I'll pass.","nextNodeIds":[726500105]},{"nodeId":726500105,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"Shousen","textMapHash":2571883522,"text":"#Come now, {F#girl}{M#boy}. Your stride is steady, you stand upright and straight, and your breathing is flawless. You are surely a veteran martial artist.","nextNodeIds":[726500106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30054","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarratio