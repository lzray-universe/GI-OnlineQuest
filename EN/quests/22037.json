riority":5,"questId":22037,"showRandomTalkCount":0},"dialogs":[{"nodeId":220370101,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":3286188818,"text":"Oh no... how did this happen?","nextNodeIds":[220370102]},{"nodeId":220370102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1941637546,"text":"What's the matter?","nextNodeIds":[220370103]},{"nodeId":220370103,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":3898894162,"text":"Traveler, I was just looking for you!","nextNodeIds":[220370104]},{"nodeId":220370104,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":4257717946,"text":"Do you still remember Konda Densuke? He came to the store several days ago, asking about the fertilizers.","nextNodeIds":[220370105]},{"nodeId":220370105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1976488402,"text":"Is he satisfied with the fertilizers?","nextNodeIds":[220370106]},{"nodeId":220370106,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":3696478578,"text":"I wouldn't put it in those terms. Strictly speaking, I think Mr. Konda Densuke is feeling lost.","nextNodeIds":[220370107]},{"nodeId":220370107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2889793666,"text":"Lost?","nextNodeIds":[220370108]},{"nodeId":220370108,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":31875794,"text":"Well, here's the thing. After your previous promotion, Mr. Densuke did use our fertilizers according to your instructions.","nextNodeIds":[220370109]},{"nodeId":220370109,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":1117235754,"text":"However, although the crops did grow well, at the same time... a lot of mushrooms came out of nowhere...","nextNodeIds":[220370110]},{"nodeId":220370110,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":52096418,"text":"To be honest, after Mr. Konda told me about it, I am also feeling a bit lost.","nextNodeIds":[220370111]},{"nodeId":220370111,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":3402898738,"text":"But anyway, it definitely has something to do with the fertilizers.","nextNodeIds":[220370112]},{"nodeId":220370112,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":2272679642,"text":"Traveler, could you please go to Konda Village and help Mr. Konda clear those mushrooms out of his fields?","nextNodeIds":[220370113,220370116]},{"nodeId":220370113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":443846594,"text":"You can count on me.","nextNodeIds":[220370114]},{"nodeId":220370114,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":4111709130,"text":"That I will. I will be doing some research in the store to see what exactly caused this...","nextNodeIds":[220370115]},{"nodeId":220370115,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":3586787706,"text":"*sigh* If only Alrani were here. She would definitely have found the cause already.","nextNodeIds":[]},{"nodeId":220370116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":860367914,"text":"How about we ask Alrani to work on this issue?","nextNodeIds":[220370117]},{"nodeId":220370117,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":2019489650,"text":"If she was here, we would have figured it out quite quickly.","nextNodeIds":[220370118]},{"nodeId":220370118,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":584806674,"text":"But she hasn't returned yet, and I have no idea where she went.","nextNodeIds":[220370119]},{"nodeId":220370119,"roleType":"TALK_ROLE_NPC","speakerId":3080,"speakerName":"Vahid","textMapHash":1812139786,"text":"I can only count on you, Traveler. I will be doing some research in the store to see what exactly caused this...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2203701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3080"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2203702,"order":2,"stepDescription":"Talk to Konda Densuke","stepDescTextMapHash":2623104868,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2203702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3151"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2203702],"talks":[{"talkId":2203702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"her