EC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166301,"initDialog":716630101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30159],"performCfg":"QuestDialogue/WQ/Liyue_71663/Q7166301","priority":8,"questId":71663,"showRandomTalkCount":0},"dialogs":[{"nodeId":716630101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2048994290,"text":"Hello there. Is something wrong?","nextNodeIds":[716630102]},{"nodeId":716630102,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1629219514,"text":"Oh, by Lesser Lord Kusanali, I have indeed met with disaster!","nextNodeIds":[716630103]},{"nodeId":716630103,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1583082858,"text":"Kusanali be blessed. Are you two the great heroes who have come to rescue poor Nazafarin?","nextNodeIds":[716630104]},{"nodeId":716630104,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1972210010,"text":"Ah, this is indeed what they call... Uh, what do they call it again? \"A blanket on a cold day?\" \"A gift of charcoal in the rain?\"","nextNodeIds":[716630105]},{"nodeId":716630105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3420734434,"text":"Um, are those things that people from Sumeru say, or what?","nextNodeIds":[716630106,716630107]},{"nodeId":716630106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3567523642,"text":"I suspect that those are things only she says...","nextNodeIds":[716630108]},{"nodeId":716630108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3592793194,"text":"That's true. Also, pretty sure rain's not a good time for charcoal. \"A gift of charcoal in the snow,\" maybe?","nextNodeIds":[716630109]},{"nodeId":716630109,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3176497818,"text":"Yes, that's right. Indeed, you are a gift of charcoal amidst the snow.","nextNodeIds":[716630110]},{"nodeId":716630110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3608607410,"text":"Well, never mind that for now. So, you're called Nazafarin, right? Well, then, Nazafarin, what can we do to help you?","nextNodeIds":[716630111]},{"nodeId":716630111,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2166306866,"text":"Ah, what a bright one you are, and to the point, too! In truth, I, Nazafarin, am facing the greatest crisis of my existence, O great heroes!","nextNodeIds":[716630112]},{"nodeId":716630112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2067593930,"text":"#Just Paimon will do, thanks! And this is {NICKNAME}.","nextNodeIds":[716630113]},{"nodeId":716630113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2770362034,"text":"#Yes, I'm {NICKNAME}, at your service.","nextNodeIds":[716630114]},{"nodeId":716630114,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2708987970,"text":"And what a pleasure it is to meet you both! I'm Nazafarin!","nextNodeIds":[716630115]},{"nodeId":716630115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":966087578,"text":"It's fine, you've mentioned your name before... Anyway, what trouble are you in?","nextNodeIds":[716630116]},{"nodeId":716630116,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3472455506,"text":"So here's what happened: I have a very ambitious friend named Parvaneh. She once told me that she would manufacture a seasoning that would bring happiness to all people.","nextNodeIds":[716630117]},{"nodeId":716630117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1298930890,"text":"Eh? How's a seasoning supposed to do that?","nextNodeIds":[716630118]},{"nodeId":716630118,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1652848826,"text":"Um, Nazafarin isn't sure either.","nextNodeIds":[716630119]},{"nodeId":716630119,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1224587562,"text":"Still, Parvaneh said that this seasoning would make any dish especially delicious!","nextNodeIds":[716630155]},{"nodeId":716630155,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":4001029242,"text":"I am certain that happiness may be found through especially delicious food.","nextNodeIds":[716630120]},{"nodeId":716630120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":104426818,"text":"Ooh! So that's how it would work!","nextNodeIds":[716630121]},{"nodeId":716630121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1553559338,"text":"You didn't take much convincing.","nextNodeIds":[716630122]},{"nodeId":716630122,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2421918818,"text":"She went on a trip overseas just so she might be able to create that seasoning...","nextNodeIds":[716630123]},{"nodeId":716630123,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1310559314,"text":"But she has been incredibly busy with work, what with her traveling and doing research at the same time. And I, her friend, could do little from the sidelines in Sumeru...","nextNodeIds":[716630124]},{"nodeId":716630124,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1786602378,"text":"So I decided that I must help her somehow! I've given the matter some thought based on the direction of the conversations we had beforehand. I was so grieved that I did not eat or drink...","nextNodeIds":[716630156]},{"nodeId":716630156,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1834407802,"text":"After \"grieving to the point of neither eating nor drinking,\" I finally realized what it was that I could do!","nextNodeIds":[716630125]},{"nodeId":716630125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1485860410,"text":"Uh, \"grieved\" might not be the right word to use here.","nextNodeIds":[716630126]},{"nodeId":716630126,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3103026626,"text":"Ah, yes, thank you for the reminder. Liyue's aphorisms really are hard to use. I need to study them more.","nextNodeIds":[716630127]},{"nodeId":716630127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3229330842,"text":"Come on, let's get back on topic. What did you think of?","nextNodeIds":[716630128]},{"nodeId":716630128,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2265666250,"text":"Ah, yes! So I came up with an idea.","nextNodeIds":[716630157]},{"nodeId":716630157,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":212018578,"text":"Essentially, I could follow Parvaneh's train of thought to create some seasoning recipes before adding them to dishes and asking people what they think of them.","nextNodeIds":[716630129]},{"nodeId":716630129,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2672314786,"text":"I mean to help Parvaneh conduct a market study and send her the data that we obtain from it.","nextNodeIds":[716630130]},{"nodeId":716630130,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2860880474,"text":"As you know, practical studies are a very important aspect of doing research. This is as much as I can do for my most busy friend.","nextNodeIds":[716630131]},{"nodeId":716630131,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2013257514,"text":"While I don't think that the seasoning recipes that I've come up with are what she's looking for, necessarily...","nextNodeIds":[716630132]},{"nodeId":716630132,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3364211122,"text":"I believe that the feedback that people will give regarding these seasonings shall help Parvaneh to create the seasoning of her dreams!","nextNodeIds":[716630133]},{"nodeId":716630133,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2509879186,"text":"That's why I've come to Liyue, famous as it is for gourmet food! It is said that the people here truly love food. I'm sure they'll give me just the inspiration I need!","nextNodeIds":[716630134]},{"nodeId":716630134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2158681298,"text":"So, uh, have you figured out what seasonings you wanna use yet? Or do you need us to help with that, too?","nextNodeIds":[716630135]},{"nodeId":716630135,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3944234538,"text":"No, no. Blessed Kusanali above, don't you worry. Leave the pondering about the recipe to me, the one from Sumeru.","nextNodeIds":[716630136]},{"nodeId":716630136,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":4058842986,"text":"We are most adept at seasoning our food. In fact, I have already come up with something in the time we were talking.","nextNodeIds":[716630137]},{"nodeId":716630137,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1992530026,"text":"So, yes, thank you so much! You two are indeed the great saviors of poor Nazafarin, yes, indeed!","nextNodeIds":[716630138]},{"nodeId":716630138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":439586146,"text":"Um, sure? You're welcome?","nextNodeIds":[716630139]},{"nodeId":716630139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3205990250,"text":"So what do you need our help with, actually?","nextNodeIds":[716630140]},{"nodeId":716630140,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2754228650,"text":"In truth... though I, Nazafarin, have indeed thought of the seasoning, I know not a soul here in Liyue.","nextNodeIds":[716630141]},{"nodeId":716630141,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3014086482,"text":"Nor am I some manner of professional adventurer who can gather my own ingredients. It shall be too difficult — oh yes, as difficult as it would be for a rookie wet behind the ears to enter the Eremites' headquarters by themselves...","nextNodeIds":[716630142]},{"nodeId":716630142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":563633242,"text":"Who are the Eremites?","nextNodeIds":[716630143]},{"nodeId":716630143,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":145057458,"text":"They are an organization of warriors-for-hire in Sumeru. They are true soldiers of fortune who will do anything for money. There are some among them who even use bizarre yet formidable powers.","nextNodeIds":[716630144]},{"nodeId":716630144,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":441514426,"text":"I shudder even to think about it... Let us amble back to our previous topic, please.","nextNodeIds":[716630145]},{"nodeId":716630145,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3686706962,"text":"#Now then, Nazafarin would like the good Paimon and {NICKNAME} to help gather ingredients according to the recipes and create said seasonings!","nextNodeIds":[716630146]},{"nodeId":716630146,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1069572938,"text":"Then we shall add them to food, bring said dishes before people you know, and record their feedback for later perusal.","nextNodeIds":[716630147,716630148]},{"nodeId":716630147,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1118997882,"text":"Ah, so that's the task...","nextNodeIds":[716630149]},{"nodeId":716630149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3596955354,"text":"Ooh, Paimon gets it! C'mon, you could have just said so. Alrighty then, we've got your back, easy! We know tons of people!","nextNodeIds":[716630150]},{"nodeId":716630150,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3304771730,"text":"Ah, Kusanali be praised! Bless both your good hearts! I will continue to dream up recipes in the meantime, and shall tell you once I have finalized them.","nextNodeIds":[716630151]},{"nodeId":716630151,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":168647178,"text":"Please, take this pot that I had specially made by an artisan in Sumeru. I am certain that the seasonings we make shall bring happiness to all!","nextNodeIds":[716630152]},{"nodeId":716630152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":222287954,"text":"#Woohoo! Let's go, {NICKNAME}! Paimon volunteers as taste tester number one, by the way!","nextNodeIds":[716630153]},{"nodeId":716630153,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3645658178,"text":"Well, that certainly explains your enthusiasm...","nextNodeIds":[716630154]},{"nodeId":716630154,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4171248810,"text":"Hehehe... Come on, come on! Let's get a move on!","nextNodeIds":[]},{"nodeId":716630148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":327368666,"text":"Ah, so you need taste-testers.","nextNodeIds":[716630149]},{"nodeId":716630107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2879878522,"text":"Nobody from Sumeru we've met before has said anything remotely like that...","nextNodeIds":[716630108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH"