UEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30404"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352701],"talks":[{"talkId":7352701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7352701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352701,"initDialog":735270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30404],"performCfg":"QuestDialogue/WQ/Sumeru_73527/Q7352701","priority":5,"questId":73527,"showRandomTalkCount":0},"dialogs":[{"nodeId":735270101,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":231847946,"text":"I never imagined that you two would follow the sound of the broadcast here, especially after being warned!","nextNodeIds":[735270102]},{"nodeId":735270102,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":898740586,"text":"Pardon me, but this attraction isn't officially open to the public yet. Please wait a few minutes for me to make some final adjustments...","nextNodeIds":[735270103,735270104]},{"nodeId":735270103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":619592938,"text":"What are you planning?","nextNodeIds":[735270105]},{"nodeId":735270105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2594704546,"text":"Paimon heard words that sounded super scary! Water cannons! Must be that huge thing over there...","nextNodeIds":[735270106]},{"nodeId":735270106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2669958218,"text":"Whoa, it's scary just to look at!","nextNodeIds":[735270107]},{"nodeId":735270107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2959141818,"text":"Just what are you trying to do here!? We won't let you get away with it!","nextNodeIds":[735270108]},{"nodeId":735270108,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":953627234,"text":"No, no, you misunderstand!","nextNodeIds":[735270109]},{"nodeId":735270109,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":2376443754,"text":"I'm Chatillon, head of project \"Spino Blaster\"! This project simulates naval battles, but much more fun and casual!","nextNodeIds":[735270110]},{"nodeId":735270110,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":185357106,"text":"\"Spino Blaster\" is approved by Lady Idyia, so you know it's safe!","nextNodeIds":[735270111]},{"nodeId":735270111,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":1024874490,"text":"If you wish to verify the truth of that, please see this document signed by Lady Idyia herself.","nextNodeIds":[735270112]},{"nodeId":735270112,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":458065818,"text":"The suspicious engineer offers proof in the form of official documents written in obtuse legalese, all with Idyia's distinct signature.\\nThe margins even contain a few remarks and well-wishes from Idyia in her inimitable style...","nextNodeIds":[735270113]},{"nodeId":735270113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1575426994,"text":"So it's a project approved by Idyia... you scared us half to death!","nextNodeIds":[735270114]},{"nodeId":735270114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3926711650,"text":"So, what's the deal with the water cannons?","nextNodeIds":[735270115]},{"nodeId":735270115,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":4205371866,"text":"That's just a simplified nickname! Its full name is so long that I'm pretty sure most people would go for something shorter based on its appearance.","nextNodeIds":[735270116]},{"nodeId":735270116,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":473990010,"text":"Anyway, its water bullets are completely harmless! At most, they might soak the guests standing near their target.","nextNodeIds":[735270117]},{"nodeId":735270117,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":2974301762,"text":"Some guests enjoy the sudden coolness from being splashed, but some hate how their clothes stick to their body afterward, and we don't want anyone to have a bad experience!","nextNodeIds":[735270118]},{"nodeId":735270118,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":2841952354,"text":"So if possible, I would like to post warning signs around the area.","nextNodeIds":[735270119]},{"nodeId":735270119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":438210850,"text":"Paimon didn't think you were so considerate, that's a great idea!","nextNodeIds":[735270120,735270121]},{"nodeId":735270120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3557558874,"text":"Now I'm curious...","nextNodeIds":[735270122]},{"nodeId":735270122,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":1446956250,"text":"It's called the Crocomorph Vortex-Based Crocodilian-Armored Heavy Naval Battleship-Style Recreational Water Blasting Cannon! The name accurately reflects both the appearance and its underlying principles!","nextNodeIds":[735270123]},{"nodeId":735270123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2171441642,"text":"Wow, you weren't kidding! Paimon can't even repeat it, much less understand it...","nextNodeIds":[735270124]},{"nodeId":735270124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3390410082,"text":"But just calling it a water cannon kinda misses the point, right? Why not call it a Crococannon?","nextNodeIds":[735270125]},{"nodeId":735270125,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":3162110346,"text":"The... the alliteration...","nextNodeIds":[735270126]},{"nodeId":735270126,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":2660094698,"text":"That's perfect! Simple and easy to remember, yet it captures the sound of shells whizzing by your eyes in a simulated naval battle! I love it!","nextNodeIds":[735270127]},{"nodeId":735270127,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":2938929154,"text":"Crococannon, fire away!","nextNodeIds":[735270128]},{"nodeId":735270128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":273316370,"text":"Crococannon bubbleball away!","nextNodeIds":[735270129,735270130]},{"nodeId":735270129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1939088042,"text":"Are you serious?","nextNodeIds":[735270131]},{"nodeId":735270131,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":1188902506,"text":"After all, not only do we have great chemistry, but you'll get to enjoy the one-of-a-kind fun!","nextNodeIds":[735270132]},{"nodeId":735270132,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":4287316706,"text":"Say, how about you two be the first to try out \"Spino Blaster\"?","nextNodeIds":[735270133]},{"nodeId":735270133,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":3095819890,"text":"The rules are simple. Adjust the Crococannon and hit balloon targets with bubbleballs to earn points! When you earn a high enough score, you can win prizes!","nextNodeIds":[735270134]},{"nodeId":735270134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":908649370,"text":"Well, after all this hype, Paimon kinda does want to see what it's like to use a Crococannon!","nextNodeIds":[735270135,735270136]},{"nodeId":735270135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2646407626,"text":"All right, count me in!","nextNodeIds":[735270137]},{"nodeId":735270137,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":3305463746,"text":"Perfect! Let me finish a few final adjustments, and then you can get started!","nextNodeIds":[735270138]},{"nodeId":735270138,"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","textMapHash":1321892762,"text":"Enjoy yourselves!","nextNodeIds":[]},{"nodeId":735270136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1922109914,"text":"Crococannon, open fi— water!","nextNodeIds":[735270137]},{"nodeId":735270130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":363431098,"text":"Paimon doesn't like being made fun of...","nextNodeIds":[735270131]},{"nodeId":735270121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":357306746,"text":"What's its full name?","nextNodeIds":[735270122]},{"nodeId":735270104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1680876218,"text":"Stop it, now!","nextNodeIds":[735270105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30404"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7352701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30404,"speakerName":"Chatillon","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen"