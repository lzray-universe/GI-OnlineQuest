Mode":"PLAY_MODE_ALL","beginCond":[{"param":["7108903","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7108902,"initDialog":710890201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2616],"performCfg":"QuestDialogue/WQ/Liyue_71089/Q7108902","priority":5,"questId":71089,"showRandomTalkCount":0},"dialogs":[{"nodeId":710890201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3939788546,"text":"Jinwu, we found this!","nextNodeIds":[710890202]},{"nodeId":710890202,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":607909874,"text":"Alright, alright, relax. What did you find? Does it have anything to do with Zhiqiong's whereabouts?","nextNodeIds":[710890203]},{"nodeId":710890203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1158113298,"text":"It's a letter she left behind. She says she's gone deeper into The Chasm.","nextNodeIds":[710890204]},{"nodeId":710890204,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":2315225642,"text":"Thank you. Let me see what she's written real quick.","nextNodeIds":[710890205]},{"nodeId":710890205,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1124388074,"text":"Jinwu reads the letter carefully.","nextNodeIds":[710890206]},{"nodeId":710890206,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":3922435522,"text":"This girl... I've never really considered issues this big, so I can't really criticize her life choices. But perhaps...","nextNodeIds":[710890207]},{"nodeId":710890207,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":1887948234,"text":"Perhaps I didn't acknowledge her discoveries in time, or give her as much respect or understanding as I should've.","nextNodeIds":[710890208]},{"nodeId":710890208,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":3800980602,"text":"It would've been immeasurably more difficult to complete our exploration without her maps... But I only showed concern for her health instead of focusing on her hard work and what she'd done so much to achieve...","nextNodeIds":[710890209]},{"nodeId":710890209,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":2874029594,"text":"Agh, how did I not realize how her work was always different from that of us miners...","nextNodeIds":[710890210]},{"nodeId":710890210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":837054626,"text":"She just doesn't want to be forgotten.","nextNodeIds":[710890211]},{"nodeId":710890211,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":2910788978,"text":"Well, don't we all, as people who aren't favored by the gods...","nextNodeIds":[710890212]},{"nodeId":710890212,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":1737010962,"text":"Don't we all... But has anyone been as obsessed as her?","nextNodeIds":[710890213]},{"nodeId":710890213,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":3533257570,"text":"And yet, when I think about the moment when I gave up any thoughts of becoming great... when I realize that I've gotten to used to living day to ordinary day...","nextNodeIds":[710890214]},{"nodeId":710890214,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":812083154,"text":"I feel like I just don't have the right to judge Zhiqiong...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7108902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7108901,7108902],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3077642894,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":710890101,"ILHDCGDKKKA":"T