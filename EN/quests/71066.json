"],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7106601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7106607,"initDialog":710660701,"nextRandomTalks":[],"nextTalks":[],"npcId":[2154,1005],"performCfg":"QuestDialogue/WQ/Liyue_71066/Q7106607","priority":10,"questId":71066,"showRandomTalkCount":0},"dialogs":[{"nodeId":710660701,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":4284263906,"text":"Ahem... My bad. As a poet, I have a propensity for dramatic language and novel tales.","nextNodeIds":[710660702]},{"nodeId":710660702,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":1588098866,"text":"Hehe, truth be told, I found the ring in a Weasel Thieves' nest... It was well-preserved and eye-pleasing, so I kept it.","nextNodeIds":[710660703]},{"nodeId":710660703,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1579813122,"text":"Hmph, so you're a thief too, you just stole from thieves!","nextNodeIds":[710660704]},{"nodeId":710660704,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":70911466,"text":"Don't say that... I chanced upon it! That's right, it was chance! And though chance it be, the ring is quite precious to me all the same.","nextNodeIds":[710660705]},{"nodeId":710660705,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1618424346,"text":"Do you have any clue concerning the ring's whereabouts?","nextNodeIds":[710660706]},{"nodeId":710660706,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":2144422938,"text":"Yeah... I've heard that Weasel Thieves are often spotted around here. They might've stolen my ring while I was sleeping.","nextNodeIds":[710660707]},{"nodeId":710660707,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2924597722,"text":"Huh, so there really are people who take their rings off before going to bed...","nextNodeIds":[710660708]},{"nodeId":710660708,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3408998090,"text":"I'd never heard of such people before, either.","nextNodeIds":[710660709]},{"nodeId":710660709,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":444258714,"text":"Anyway, Paimon doesn't have that habit! You need to think about where to put the ring once you take it off, or you'll be wasting good beauty sleep.","nextNodeIds":[710660710]},{"nodeId":710660710,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2901496626,"text":"Do they even make rings tiny enough for you, Paimon?","nextNodeIds":[710660711]},{"nodeId":710660711,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2995314114,"text":"Hmph, of course they do! There's much you still don't know!","nextNodeIds":[710660712]},{"nodeId":710660712,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":3156424602,"text":"Enough. Please refrain from judging other people's way of living before proceeding to ramble on about your own! It's very rude!","nextNodeIds":[710660713]},{"nodeId":710660713,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":2988351114,"text":"...Anyway, if you want to help out... Please keep an eye out for Weasel Thief nests.","nextNodeIds":[710660714]},{"nodeId":710660714,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":2885835130,"text":"I've heard that there is a camp of suspicious Treasure Hoarders around here on the map... I've marked the location out for you.","nextNodeIds":[710660715]},{"nodeId":710660715,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":174859522,"text":"It's said that Weasel Thieves are often spotted around here. Those sneaky Treasure Hoarders probably have something to do with them... Anyway, please take a look there.","nextNodeIds":[710660716]},{"nodeId":710660716,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4288306274,"text":"Hmph... A ring stolen from the Weasel Thieves, which was then stolen again by other Weasel Thieves. Paimon'd say it has gone back to its rightful owner!","nextNodeIds":[710660717]},{"nodeId":710660717,"roleType":"TALK_ROLE_NPC","speakerId":2154,"speakerName":"Taliesin","textMapHash":54754834,"text":"Oh, come on, just stop it already!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7106607,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_