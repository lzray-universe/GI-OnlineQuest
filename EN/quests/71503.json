m":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150301,"initDialog":715030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181,30183,30184],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150301","priority":15,"questId":71503,"showRandomTalkCount":0},"dialogs":[{"nodeId":715030101,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4227011106,"text":"#You're just in time, {NICKNAME}. We were just discussing how to move the Pursina's Spike in...","nextNodeIds":[715030102]},{"nodeId":715030102,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4128952346,"text":"I must say, however, that the situation is far more serious than we anticipated.","nextNodeIds":[715030103]},{"nodeId":715030103,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":3848545250,"text":"*cough* This is bad, there's too much dark mud here, and it's crawling with monsters attracted by the mud. We can't move the Spike in.","nextNodeIds":[715030104]},{"nodeId":715030104,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":3247480082,"text":"We can't find any path forward at all...","nextNodeIds":[715030105]},{"nodeId":715030105,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"Tu","textMapHash":1695323162,"text":"We're still a long way off from the mining tunnels. C'mon, we've got to try again.","nextNodeIds":[715030106]},{"nodeId":715030106,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"Tu","textMapHash":4058090378,"text":"If it still doesn't work out, let's go back out there and grab a few more buddies to help out!","nextNodeIds":[715030107]},{"nodeId":715030107,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"Tu","textMapHash":694883098,"text":"I mean, am I not Tu the Mining Superstar? I can carve through a mountain with but a few swings of my pickaxe! These monsters are no match for me. Let's get moving!","nextNodeIds":[715030108]},{"nodeId":715030108,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":631405954,"text":"Bah, keep on faking, we'll see how much redder your face can get from all that coughing.","nextNodeIds":[715030109]},{"nodeId":715030109,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"Tu","textMapHash":1672234978,"text":"Nonsense, I... *cough*","nextNodeIds":[715030110]},{"nodeId":715030110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1406059130,"text":"We can't proceed any further in.","nextNodeIds":[715030111]},{"nodeId":715030111,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3395780658,"text":"Long-term exposure to this mud will have severe consequences. The large number of monsters makes things even more dangerous.","nextNodeIds":[715030112]},{"nodeId":715030112,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"Tu","textMapHash":3408133250,"text":"But we all saw it, didn't we? We put the machine in the mining complex, and it was cleaned up just like that.","nextNodeIds":[715030113]},{"nodeId":715030113,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"Tu","textMapHash":2334467386,"text":"If... *cough* if we could just get rid of all this mud sooner...","nextNodeIds":[715030114]},{"nodeId":715030114,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2998317258,"text":"This isn't the time to be prizing speedy solutions. Whether it be in experiments or in problem-solving, proceeding without preparation and proper examination is too rash. One mistake could cost lives!","nextNodeIds":[715030115]},{"nodeId":715030115,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2276159538,"text":"\"Your own life is of utmost importance.\" This is one of the basic axioms of the Akademiya's lab manual.","nextNodeIds":[715030116]},{"nodeId":715030116,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":881094010,"text":"As a researcher from the Akademiya, I cannot simply stand by and allow such foolhardiness.","nextNodeIds":[715030117]},{"nodeId":715030117,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":70350970,"text":"But if we stop... Who's going to do something about all this mud?","nextNodeIds":[715030118]},{"nodeId":715030118,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":448761362,"text":"If it continues to attract these monsters, it wouldn't matter if we brought another 20 people... *cough* We wouldn't make any headway.","nextNodeIds":[715030119]},{"nodeId":715030119,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":82975170,"text":"Let me think...","nextNodeIds":[715030120]},{"nodeId":715030120,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3463630754,"text":"If this really is unworkable, we could activate the Spike once more over here first...","nextNodeIds":[715030121]},{"nodeId":715030121,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":586103522,"text":"Here?","nextNodeIds":[715030122]},{"nodeId":715030122,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2607813106,"text":"That's right. I just gave the dark mud emissions a once-over, and though they are faster than how they were the day before in the mining complex, this is not yet the heart of the problem, so the purification rate should be quicker than the rate at which the dark mud can flow out.","nextNodeIds":[715030123]},{"nodeId":715030123,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2711807314,"text":"Those monsters in The Chasm were attracted by the dark mud. I suspect that they must be affected by its energies.","nextNodeIds":[715030124]},{"nodeId":715030124,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3765818490,"text":"#So setting the Spike up here and decreasing the mud's influence in the vicinity should also be of help to you, {NICKNAME}.","nextNodeIds":[715030125]},{"nodeId":715030125,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1365272194,"text":"If we clear the mud out, the monsters should stop congregating. Once that's happened, we can try moving the Spike further in.","nextNodeIds":[715030126]},{"nodeId":715030126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2518152410,"text":"Then let's do this.","nextNodeIds":[715030127]},{"nodeId":715030127,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2080625362,"text":"You two, head back to camp and rest first. We'll have need of you later.","nextNodeIds":[715030128]},{"nodeId":715030128,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"Tu","textMapHash":1590143650,"text":"Come on, I don't need rest yet! We just... *cough* It's not time for the Mining Superstar to lay his pickaxe down just yet! If it's clearing monsters, I can help out too!","nextNodeIds":[715030129]},{"nodeId":715030129,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":824291250,"text":"Quit the tough-guy act already! I've seen this pattern of yours before...","nextNodeIds":[715030130]},{"nodeId":715030130,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":3415570706,"text":"#This is {NICKNAME} we're talking about. Where {F#she}{M#he} gets to fixing things, there's little people like you and I have to fear.","nextNodeIds":[715030131]},{"nodeId":715030131,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"Hao","textMapHash":3658525970,"text":"#We'll leave the dark mud in this area to you, {NICKNAME}.","nextNodeIds":[715030132,715030133]},{"nodeId":715030132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2383528210,"text":"Got it.","nextNodeIds":[715030134]},{"nodeId":715030134,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2292977554,"text":"#Ah yes, {NICKNAME}, this entire area is covered in mud. The situation is far worse than I thought...","nextNodeIds":[715030135]},{"nodeId":715030135,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4090987506,"text":"There are also a lot of monsters nearby. Stay on your toes...","nextNodeIds":[715030136]},{"nodeId":715030136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1539748770,"text":"I'll take care of myself.","nextNodeIds":[715030137]},{"nodeId":715030137,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":991872874,"text":"No, no, I mean \"stay on your toes regarding the Pursina's Spike.\"","nextNodeIds":[715030138]},{"nodeId":715030138,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3027142554,"text":"I have full confidence in your abilities, but less so in the awesome yet fragile Spike.","nextNodeIds":[715030139]},{"nodeId":715030139,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":934381042,"text":"Please make sure that the Spike makes it through unscathed.","nextNodeIds":[]},{"nodeId":715030133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2368851242,"text":"Leave it to me. Just relax.","nextNodeIds":[715030134]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["166001689","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7150302,"order":3,"stepDescription":"Activate the Pursina's Spike","stepDescTextMapHash":1674178724,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q71503"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AR