{"mainQuestId":76655,"title":"The Sun Rises Once More","description":"The sun will always pierce the darkness and shine hope down...","titleTextMapHash":330154791,"descTextMapHash":1519591262,"mainQuestExcel":{"mainQuestId":76655,"titleTextMapHash":330154791,"title":"The Sun Rises Once More","descTextMapHash":1519591262,"description":"The sun will always pierce the darkness and shine hope down...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_THESPIA","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76655","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":1519591262,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76655,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3995200073,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76655","mainQuestTag":"MAINQUEST_TAG_THESPIA","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176655],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":330154791,"type":"WQ","unlockDescTextMapHash":1421492470}},"flow":[{"subQuestId":7665501,"order":1,"stepDescription":"Talk to Flins","stepDescTextMapHash":1551049804,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360100036:3719.103,234.117,9185.111,0.000,285.030,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7665501],"talks":[{"talkId":7665501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7665501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7665501,"initDialog":766550101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1314],"performCfg":"QuestDialogue/WQ/MDZJC_76655/Q7665501","priority":5,"questId":76655,"showRandomTalkCount":0},"dialogs":[{"nodeId":766550101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2940128466,"text":"Flins! You made it!","nextNodeIds":[766550102]},{"nodeId":766550102,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":3999534538,"text":"Why, of course. I owe you both my thanks — this lighthouse looks a fair sight better now that it's being maintained.","nextNodeIds":[766550103]},{"nodeId":766550103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2616307266,"text":"Hehe, our pleasure! Although, it seems like even with a functioning lighthouse, this whole place is still really dark. There are some places the light doesn't even reach.","nextNodeIds":[766550104]},{"nodeId":766550104,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":2129759074,"text":"Indeed. In the graveyard, it seemed as if even time itself had forever paused at the close of the battle that night.","nextNodeIds":[766550105]},{"nodeId":766550105,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":384312106,"text":"I never had any intention of changing this, but it seems that by lighting the lighthouse, you have set time in motion once again.","nextNodeIds":[766550106,766550108]},{"nodeId":766550106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":260031490,"text":"Will this affect your life?","nextNodeIds":[766550107]},{"nodeId":766550107,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":4261119386,"text":"If you mean to ask whether I shall be inconvenienced in any way, the answer is no.","nextNodeIds":[766550110]},{"nodeId":766550110,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":996515274,"text":"Life comes in cycles. Even without us, the ghosts that linger here would slowly disappear and return to the Ley Lines.","nextNodeIds":[766550111]},{"nodeId":766550111,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":475039466,"text":"So do not worry that this lighthouse cannot shine upon every last corner of the island. As the ghosts gradually leave, so too will the fog that envelops the area.","nextNodeIds":[766550112]},{"nodeId":766550112,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":1059588690,"text":"The sun must rise eventually.","nextNodeIds":[]},{"nodeId":766550108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1623308466,"text":"Sorry, we didn't mean to.","nextNodeIds":[766550109]},{"nodeId":766550109,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":1904914162,"text":"Oh, don't apologize, I am not against the change.","nextNodeIds":[766550110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360100036:3719.103,234.117,9185.111,0.000,285.030,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7665501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":2},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[176655],