d":715340104,"roleType":"TALK_ROLE_NPC","speakerId":30680,"speakerName":"Kujou Sara","textMapHash":3321209586,"text":"To see a warrior like me enjoying Lantern Rite?","nextNodeIds":[715340105]},{"nodeId":715340105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1211986706,"text":"I don't think I've ever seen you relax...","nextNodeIds":[715340106]},{"nodeId":715340106,"roleType":"TALK_ROLE_NPC","speakerId":30680,"speakerName":"Kujou Sara","textMapHash":1852014922,"text":"The Tenryou Commission bears a great responsibility to the people. As a member, I cannot afford to relax most of the time.","nextNodeIds":[715340107]},{"nodeId":715340107,"roleType":"TALK_ROLE_NPC","speakerId":30680,"speakerName":"Kujou Sara","textMapHash":3610927706,"text":"Perhaps people think of me as a single-minded warrior, completely out of place in a festive and refined neighborhood like Hanamizaka.","nextNodeIds":[715340108]},{"nodeId":715340108,"roleType":"TALK_ROLE_NPC","speakerId":30680,"speakerName":"Kujou Sara","textMapHash":1205530322,"text":"But, letting down my guard means allowing crime to slip through... That is not only a detriment to my duty but to the atmosphere of Hanamizaka as a whole.","nextNodeIds":[715340109]},{"nodeId":715340109,"roleType":"TALK_ROLE_NPC","speakerId":30680,"speakerName":"Kujou Sara","textMapHash":1500845194,"text":"The most I can do is take advantage of any spare moment that comes my way.","nextNodeIds":[715340110]},{"nodeId":715340110,"roleType":"TALK_ROLE_NPC","speakerId":30680,"speakerName":"Kujou Sara","textMapHash":762183762,"text":"Ah, apologies. I shouldn't talk about such serious matters during the holidays.","nextNodeIds":[715340111]},{"nodeId":715340111,"roleType":"TALK_ROLE_NPC","speakerId":30680,"speakerName":"Kujou Sara","textMapHash":2178988986,"text":"I'm trying to make a gift envelope, but it's not quite coming together. Perhaps you could give me some advice?","nextNodeIds":[715340112]},{"nodeId":715340112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1009658514,"text":"Sure, let me think about it for a second...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30680"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7153403,"order":3,"stepDescription":"Complete the Gift Envelope with Kujou Sara","stepDescTextMapHash":3254130492,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2036,71534],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30680"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7153402],"talks":[{"talkId":7153402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NO