"Albedo","textMapHash":865417186,"text":"Some of us would be unable to stand the icy waters... Others might find the whole thing rather refreshing.","nextNodeIds":[110430110]},{"nodeId":110430110,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4152136738,"text":"No matter what choice you make, it's all a part of the experiment. For me, every detail is invaluable to the research.","nextNodeIds":[110430111,110430112]},{"nodeId":110430111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2475670650,"text":"My kind of experiment.","nextNodeIds":[110430113]},{"nodeId":110430113,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1010840154,"text":"Then if you would, please. I eagerly await the results.","nextNodeIds":[]},{"nodeId":110430112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3635234490,"text":"This is actually less stressful than the superpower part.","nextNodeIds":[110430113]},{"nodeId":110430104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2036665314,"text":"That's not very reassuring.","nextNodeIds":[110430105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1104301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q11043Albedo1"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1104305,"order":2,"stepDescription":"","stepDescTextMapHash":2677370716,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1104305,0],"PAINLIB