ST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1018"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1104303],"talks":[{"talkId":1104303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1104303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":1104303,"initDialog":110430301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1018],"performCfg":"QuestDialogue/LQ/Albedo1_11043/Q1104303","priority":0,"questId":11043,"showRandomTalkCount":0},"dialogs":[{"nodeId":110430301,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":565865730,"text":"Great work, I've never seen a performance quite like it.","nextNodeIds":[110430302]},{"nodeId":110430302,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3719973722,"text":"Your reputation precedes you, Traveler. The data shows that you're easily outperforming the average citizen in Mondstadt.","nextNodeIds":[110430303]},{"nodeId":110430303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":487364834,"text":"But you followed us the whole way without breaking a sweat!","nextNodeIds":[110430304]},{"nodeId":110430304,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":704148498,"text":"Me? Actually, I used alchemy to cheat a little, but anyway.","nextNodeIds":[110430305]},{"nodeId":110430305,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1162510770,"text":"If it turns out that the natural laws of Teyvat do not affect you, I should be able to make various inferences about the otherworldly civilization you belong to.","nextNodeIds":[110430306]},{"nodeId":110430306,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":179965258,"text":"If the natural laws of Teyvat do affect you, then I shall be able to make inferences into the kind of evolution that would occur under the absence of such effects.","nextNodeIds":[110430307]},{"nodeId":110430307,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1679937954,"text":"The innumerable possibilities that this could present, the captivating insights... It will be something to savor again and agai—","nextNodeIds":[110430308]},{"nodeId":110430308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1253538,"text":"Buuuut how does this help your RESEARCH?","nextNodeIds":[110430309]},{"nodeId":110430309,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2399098530,"text":"You've helped me to unravel many of the problems that were holding it back. When we return to the campsite, I should be able to show you something interesting.","nextNodeIds":[110430310]},{"nodeId":110430310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2755244690,"text":"What else have you researched this thoroughly?","nextNodeIds":[110430311]},{"nodeId":110430311,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1160096186,"text":"I may be about to make some analogies between you and a few... unusual specimens. I hope you won't be offended.","nextNodeIds":[110430312]},{"nodeId":110430312,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":535218226,"text":"Gold, Petrified Trees, a sun eight times the size of our own...","nextNodeIds":[110430313]},{"nodeId":110430313,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1245435586,"text":"The essence of the investigative process is enthralling, but such feelings are inevitably fleeting in nature.","nextNodeIds":[110430314]},{"nodeId":110430314,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3432455130,"text":"I'm willing to pour all my energy into research, and yet specimens are finite. As the unknown transitions into the realm of scientific understanding, the feeling of enlightenment is lost.","nextNodeIds":[110430315]},{"nodeId":110430315,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":447258994,"text":"All these things that start out as objects of fascination end up possessing the prosaic mundanity of a Sunsettia or a Sweet Flower. They cease to be noteworthy.","nextNodeIds":[110430316]},{"nodeId":110430316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4126166266,"text":"Oh... So that's why you wanted to paint those hilichurls? Because you got to see something new and interesting in the differences between them?","nextNodeIds":[110430317]},{"nodeId":110430317,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2013470570,"text":"Precisely. To quote my exact words from earlier, these creatures are, for the most part, \"quite boring... not worth closer inspection.\" There is precious little about them that serves to pique my curiosity now.","nextNodeIds":[110430318]},{"nodeId":110430318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3775875746,"text":"So after all these experiments, are we gonna be, like, boring to you? Like some basic draft of a sketch?","nextNodeIds":[110430319]},{"nodeId":110430319,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4190853074,"text":"Of course not. You have been of great assistance to me, and I will remember this friendship for a lifetime.","nextNodeIds":[110430320]},{"nodeId":110430320,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":190302394,"text":"Now, before we head back to the campsite, there's one more experiment: intelligence.","nextNodeIds":[110430321]},{"nodeId":110430321,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1328257034,"text":"Follow me, there are some other ruins nearby.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1104303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133002929"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLP