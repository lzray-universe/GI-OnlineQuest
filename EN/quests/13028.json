COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1302801,"initDialog":130280113,"nextRandomTalks":[],"nextTalks":[],"npcId":[13164,13163],"performCfg":"QuestDialogue/WQ/Sumeru_13028/Q1302801","priority":5,"questId":13028,"showRandomTalkCount":0},"dialogs":[{"nodeId":130280113,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":744282114,"text":"They've been here for a very long time...","nextNodeIds":[130280101]},{"nodeId":130280101,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":686040978,"text":"I really want to do something for them so that they'll have a chance to meet again...","nextNodeIds":[130280102]},{"nodeId":130280102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2794918586,"text":"Yeah, and apart from these two Fungi, Paimon's also a little worried about the Floating Anemo Fungus's camp.","nextNodeIds":[130280103]},{"nodeId":130280103,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3978665930,"text":"Mm-hmm. I feel the same.","nextNodeIds":[130280104]},{"nodeId":130280104,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1192040738,"text":"I have an idea. Why don't we bring them over to live with the other Fungi?","nextNodeIds":[130280105]},{"nodeId":130280105,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2219845802,"text":"Both sides have previously lived in the presence of an elemental life-form, so their habits should be similar.","nextNodeIds":[130280106]},{"nodeId":130280106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4216139418,"text":"Yeah, so they can look out for each other!","nextNodeIds":[130280107]},{"nodeId":130280107,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":777591706,"text":"Would you like to come with us?","nextNodeIds":[130280108]},{"nodeId":130280108,"roleType":"TALK_ROLE_NPC","speakerId":13164,"speakerName":"Floating Hydro Fungus","textMapHash":842545938,"text":"...?","nextNodeIds":[130280109]},{"nodeId":130280109,"roleType":"TALK_ROLE_NPC","speakerId":13163,"speakerName":"Floating Hydro Fungus","textMapHash":3116825762,"text":"♪~","nextNodeIds":[130280110]},{"nodeId":130280110,"roleType":"TALK_ROLE_NPC","speakerId":13164,"speakerName":"Floating Hydro Fungus","textMapHash":1726377794,"text":"...","nextNodeIds":[130280111]},{"nodeId":130280111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3986880826,"text":"Looks like it's been convinced.","nextNodeIds":[130280112]},{"nodeId":130280112,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2802684530,"text":"Okay, let's go.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1302801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["13027","0"],"PAINLIBBLDK":"QUEST_EXEC_CLEAR_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q13019Monster1Met","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1302802,"order":2,"stepDescription":"Take the Fungi to their new home","stepDescTextMapHash":3423158948,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1302802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q13019Mon2FlowerPos"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[1302802],"talks":[{"talkId":1302802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1302802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1302802,"initDialog":130280201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1056],"performCfg":"QuestDialogue/WQ/Sumeru_13028/Q1302802","priority":5,"questId":13028,"showRandomTalkCount":0},"dialogs":[{"nodeId":130280201,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1193860738,"text":"After arriving at the camp, the two Fungi receive a warm welcome.","nextNodeIds":[130280202]},{"nodeId":130280202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3549831562,"text":"Ooh, seems like the Fungi here recognize us. They're so friendly and gentle.","nextNodeIds":[130280203]},{"nodeId":130280203,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1518535690,"text":"That elemental life-form must've been held in high regard by everyone living here.","nextNodeIds":[130280204]},{"nodeId":130280204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2425176850,"text":"Huh? Are you trying to play with Paimon?","nextNodeIds":[130280205]},{"nodeId":130280205,"roleType":"TALK_ROLE_NPC","speakerId":13214,"speakerName":"Floating Anemo Fungus","textMapHash":2909908002,"text":"♩~♩~","nextNodeIds":[130280206]},{"nodeId":130280206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2287734850,"text":"#Well, okay then! {NICKNAME}, Paimon'll be over there playing with the Fungi!","nextNodeIds":[130280207,130280208]},{"nodeId":130280207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":592757306,"text":"Off you go.","nextNodeIds":[130280209]},{"nodeId":130280209,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2664558346,"text":"I owe you an apology. When the Fire Seed shattered while we were inside Apep... I had planned to sacrifice my power.","nextNodeIds":[130280210]},{"nodeId":130280210,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":475745282,"text":"Did Paimon tell you that?","nextNodeIds":[130280211,130280212]},{"nodeId":130280211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":725380730,"text":"Yeah, and I was a little worried.","nextNodeIds":[130280213]},{"nodeId":130280213,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2720395554,"text":"I wasn't calm enough. I should've given it some more thought and made a better judgment of the situation.","nextNodeIds":[130280214]},{"nodeId":130280214,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3649137330,"text":"When I realized that the Dendro Dragon was in danger and that Sumeru's safety was being threatened, I couldn't help feeling anxious and scared.","nextNodeIds":[130280215]},{"nodeId":130280215,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1050278666,"text":"If I decided not to take action when things can still be done, or if time ran out before I've used up all my energy...","nextNodeIds":[130280216]},{"nodeId":130280216,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4178865682,"text":"Using my powers may be the easiest way out, but it's also the most difficult.","nextNodeIds":[130280217]},{"nodeId":130280217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1328470354,"text":"You still have room for \"growth.\"","nextNodeIds":[130280218]},{"nodeId":130280218,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4142030162,"text":"Yes, and I think I learned a lot from them.","nextNodeIds":[130280219]},{"nodeId":130280219,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":973071706,"text":"I understand what it means to have their wishes come true, but I'm still unable to accept it.","nextNodeIds":[130280220]},{"nodeId":130280220,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3695505602,"text":"Why did it sound so peacefully content when it was doing something that just... makes you want to cry?","nextNodeIds":[130280221]},{"nodeId":130280221,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1760987778,"text":"Looks like I still haven't fully grasped the concept of \"empathy\" yet...","nextNodeIds":[130280222,130280223]},{"nodeId":130280222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":135328882,"text":"This isn't your fault.","nextNodeIds":[130280224]},{"nodeId":130280224,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3428075650,"text":"Thank you for comforting me...","nextNodeIds":[130280225]},{"nodeId":130280225,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":855643218,"text":"Feelings are really complex things, and there is still a lot for me to learn.","nextNodeIds":[130280226]},{"nodeId":130280226,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1184994058,"text":"Huh?","nextNodeIds":[130280227]},{"nodeId":130280227,"roleType":"TALK_ROLE_NPC","speakerId":13163,"speakerName":"Floating Hydro Fungus","textMapHash":1397768738,"text":"♪~","nextNodeIds":[130280228]},{"nodeId":130280228,"roleType":"TALK_ROLE_NPC","speakerId":13164,"speakerName":"Floating Hydro Fungus","textMapHash":3593542594,"text":"♪~♪~","nextNodeIds":[130280229]},{"nodeId":130280229,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1041998170,"text":"They're even taking care of the crops... Are they simply mirroring the elemental life-forms' behaviors?","nextNodeIds":[130280230]},{"nodeId":130280230,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4178829658,"text":"But since that Fungus even learned to speak, all of this might be due to the long-term effects of elemental power.","nextNodeIds":[130280231]},{"nodeId":130280231,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":695367306,"text":"Time is a powerful thing.","nextNodeIds":[130280232]},{"nodeId":130280232,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3517803002,"text":"That's right. And now, we don't have to worry about the safety of these two Fungi anymore.","nextNodeIds":[130280233]},{"nodeId":130280233,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2482108754,"text":"From now on, I'll be keeping an eye on this Fungi camp and come check on them once in a while.","nextNodeIds":[130280234]},{"nodeId":130280234,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2097357162,"text":"I want to preserve the traces they left behind in order to create an opportunity for them to meet in the future.","nextNodeIds":[130280235]},{"nodeId":130280235,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3062797938,"text":"After all, that Fungus remembered the name \"Nur.\" Its memories came back.","nextNodeIds":[130280236,130280237]},{"nodeId":130280236,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2447947378,"text":"I believe in their bonds as a family.","nextNodeIds":[130280238]},{"nodeId":130280238,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1826723306,"text":"Mm. Let's think of it as a beautiful wish then.","nextNodeIds":[130280239]},{"nodeId":130280239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2012214154,"text":"Nahida, the Fungi brought over some fruit! Come and have some!","nextNodeIds":[130280240]},{"nodeId":130280240,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3542668074,"text":"Okay, I'm coming!","nextNodeIds":[]},{"nodeId":130280237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1844