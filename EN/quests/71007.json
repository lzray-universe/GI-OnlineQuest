GUIDE_NPC"},"isHidden":false,"talkIds":[7100701],"talks":[{"talkId":7100701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":true,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7100701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7100701,"initDialog":710070101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2409],"performCfg":"","priority":5,"questId":71007,"showRandomTalkCount":0},"dialogs":[{"nodeId":710070101,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":477366674,"text":"How's the painting going?","nextNodeIds":[710070102]},{"nodeId":710070102,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":1783142970,"text":"I've been painting here at the side of those two statues since their eyes lit up.","nextNodeIds":[710070103]},{"nodeId":710070103,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":802884690,"text":"But... How should I say this? I just feel like I haven't been able to paint that perfect picture.","nextNodeIds":[710070104]},{"nodeId":710070104,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":2219537146,"text":"It just feels like there's something missing, you know what I mean?","nextNodeIds":[710070105]},{"nodeId":710070105,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":1414891770,"text":"It's like a dish that uses good ingredients and is cooked well, but... but something's just not there...","nextNodeIds":[710070106]},{"nodeId":710070106,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":410989562,"text":"I don't know how to express this feeling, and I can't grasp it, either. All I can do is continue to paint.","nextNodeIds":[710070107]},{"nodeId":710070107,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":272088482,"text":"Don't worry, you can laugh. Really, all this drawing is making me a little woozy. And I would have taken a short break, too...","nextNodeIds":[710070108]},{"nodeId":710070108,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":1450233258,"text":"But every time I close my eyes, I can suddenly see the shining eyes of those statues before me. It's as if they've come alive and are staring right at me...","nextNodeIds":[710070109]},{"nodeId":710070109,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":1215894178,"text":"Which is why I came back here to take a break. I shouldn't be able to see the statues' eyes from here...","nextNodeIds":[710070110]},{"nodeId":710070110,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":3490371898,"text":"Ah, yes. Why don't you take this painting? It's the best one I've done so far.","nextNodeIds":[710070111]},{"nodeId":710070111,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":955899946,"text":"Now, if you don't mind, I'm really tired. I need a break.","nextNodeIds":[710070112]},{"nodeId":710070112,"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","textMapHash":830188226,"text":"Still, what are my paintings missing... What are they missing...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7100701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2409"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7100701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2409,"speakerName":"Vermeer","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":137823246,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPII