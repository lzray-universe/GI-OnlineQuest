false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37302","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37302,"initDialog":3730201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/AQ/Mengde2_373/Q37302","priority":0,"questId":373,"showRandomTalkCount":0},"dialogs":[{"nodeId":3730201,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1392953003,"text":"Oh? What are you doing here?","nextNodeIds":[3730202]},{"nodeId":3730202,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4191278163,"text":"Though I was just wondering if you would happen to follow me...","nextNodeIds":[3730203]},{"nodeId":3730203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3898285419,"text":"I want to know more about the Anemo God.","nextNodeIds":[3730204]},{"nodeId":3730204,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":887035659,"text":"You speak of the God of Anemo, Barbatos? He already disappeared from Mondstadt a long time ago.","nextNodeIds":[3730205]},{"nodeId":3730205,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4148901347,"text":"Liyue and Inazuma's respective gods of Geo and Electro are still present, but Mondstadt has seen many a moon since they last saw their own god.","nextNodeIds":[3730206]},{"nodeId":3730206,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":253958859,"text":"Why do you wish to know about the God of Anemo? Does it have something to do with Dvalin?","nextNodeIds":[3730207]},{"nodeId":3730207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1369131387,"text":"Oh... ahhh... it's because gods...","nextNodeIds":[3730208]},{"nodeId":3730208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1889113515,"text":"Yes, someone told me about Dvalin's past.","nextNodeIds":[3730209]},{"nodeId":3730209,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1722412875,"text":"Just how is it that everyone sees Stormterror? I'm quite curious.","nextNodeIds":[3730210]},{"nodeId":3730210,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3295397963,"text":"That said, there's no need to rush...","nextNodeIds":[3730211]},{"nodeId":3730211,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3132547059,"text":"I have not been back in a while, it seems there are a few who are unhappy with my arrival.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37302,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":37303,"order":3,"stepDescription":"Defeat the creature","stepDescTextMapHash":1791029543,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[133001305,0],"PAINLIBBLDK":"QUEST_CONT