:false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37304","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37304,"initDialog":3730401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/AQ/Mengde2_373/Q37304","priority":0,"questId":373,"showRandomTalkCount":0},"dialogs":[{"nodeId":3730401,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1537163995,"text":"Seems the dragon wasn't the only thing affected by this change in the wind...","nextNodeIds":[3730402]},{"nodeId":3730402,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2002684955,"text":"Now then, you were saying someone had told you about the dragon?","nextNodeIds":[]},{"nodeId":3730405,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1792472179,"text":"Is that so? Quite the scholar I must say, that Lisa.","nextNodeIds":[3730406]},{"nodeId":3730406,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":575537787,"text":"She's not wrong. The conflict has reached this point, only because both sides have resorted to the use of force.","nextNodeIds":[3730407]},{"nodeId":3730407,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1544381259,"text":"His hate, however, did not arise from the people not making tribute to The Four Winds.","nextNodeIds":[3730408]},{"nodeId":3730408,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4177956579,"text":"Nor was it born from his own nature, but instead came about as a product of his degradation.","nextNodeIds":[3730409]},{"nodeId":3730409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1200805195,"text":"Degra... dation?","nextNodeIds":[3730410]},{"nodeId":3730410,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":520152603,"text":"The black blood flowing through his heart has been torturing him for years.","nextNodeIds":[3730411]},{"nodeId":3730412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":123812747,"text":"Abyss Mage? Never heard such a name.","nextNodeIds":[3730413]},{"nodeId":3730414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1916335859,"text":"I think I've heard of them before in Mondstadt...","nextNodeIds":[3730415]},{"nodeId":3730411,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2496011467,"text":"That's what has allowed him to be led astray by the lies of the Abyss Mage.","nextNodeIds":[3730412,3730414]},{"nodeId":3730413,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3733915779,"text":"They are from the Abyss Order, an organization comprised of non-human beings. They despise mankind.","nextNodeIds":[3730416]},{"nodeId":3730415,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1789544035,"text":"Correct. They are from the Abyss Order, an organization comprised of non-human beings. They despise mankind.","nextNodeIds":[3730416]},{"nodeId":3730416,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2601009187,"text":"I don't know where they come from. All I know is that they hold deep hatred towards the human world.","nextNodeIds":[3730417]},{"nodeId":3730417,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3399386235,"text":"Many hilichurls out in the wild take orders from them and act as their weapons.","nextNodeIds":[3730418]},{"nodeId":3730418,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3001524547,"text":"Before arriving here, I too was like Dvalin, cursed and left to waste.","nextNodeIds":[3730419]},{"nodeId":3730419,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3049045003,"text":"But now, before us stands the Symbol of Mondstadt's Hero, the place from which Mondstadt rose.","nextNodeIds":[3730420]},{"nodeId":3730420,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2383464955,"text":"The wind amongst the branches is good, I love the way it smells...","nextNodeIds":[3730421]},{"nodeId":3730421,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3847405563,"text":"Being here with you beneath this great tree feels like when the tear was purified earlier. Like the poison is leaving my body...","nextNodeIds":[3730422]},{"nodeId":3730423,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1064696867,"text":"Mmmmmmm... Feels much better.","nextNodeIds":[3730424]},{"nodeId":3730424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2011665659,"text":"So... how exactly did you get poisoned?","nextNodeIds":[3730425]},{"nodeId":3730425,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2043402147,"text":"Ahh... that would be because I tried to communicate with Dvalin earlier, but was... interrupted...","nextNodeIds":[3730426]},{"nodeId":3730427,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3433874515,"text":"Oh, ah... that...","nextNodeIds":[3730429]},{"nodeId":3730428,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3810667275,"text":"That was ...me?","nextNodeIds":[3730429]},{"nodeId":3730426,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":840548875,"text":"As a result, not only did I not manage to help Dvalin break his curse, but instead, was also infected myself!","nextNodeIds":[3730427,3730428]},{"nodeId":3730429,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3802853107,"text":"Yes, it was you!","nextNodeIds":[3730430]},{"nodeId":3730431,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4255240643,"text":"#So, to make up for it, {NICKNAME}, you're coming with me to the Cathedral!","nextNodeIds":[3730432]},{"nodeId":3730432,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4189129195,"text":"The Mondstadt Cathedral? To do what exactly?","nextNodeIds":[3730433]},{"nodeId":3730433,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":259506507,"text":"To claim a certain \"Holy Lyre der Himmel.\"","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["1001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[3