:"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7052802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7052804,"initDialog":705280401,"nextRandomTalks":[],"nextTalks":[],"npcId":[30047],"performCfg":"","priority":4,"questId":70528,"showRandomTalkCount":0},"dialogs":[{"nodeId":705280401,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":193710690,"text":"*sigh* Can the Guild really manage this amount of work...","nextNodeIds":[705280402]},{"nodeId":705280402,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":2584988122,"text":"Ah, Traveler! My apologies for not noticing you sooner. I had some Guild affairs on my mind...","nextNodeIds":[705280403]},{"nodeId":705280403,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":839452474,"text":"You must be here in Mondstadt for the Windblume Festival, I presume?","nextNodeIds":[705280404]},{"nodeId":705280404,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":1985500002,"text":"You're just in time: The Guild has just come up with a little game — a guaranteed romp with prizes to be won!","nextNodeIds":[705280405]},{"nodeId":705280405,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":695993602,"text":"How about it? Wanna give it a go?","nextNodeIds":[705280406]},{"nodeId":705280406,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":3631224498,"text":"Let me introduce this little game to you first. The person who designed it calls it \"Floral Chess.\"","nextNodeIds":[705280407]},{"nodeId":705280407,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":2478643858,"text":"He said that his inspiration came from the billowing petals and the wind that pursues them...","nextNodeIds":[705280408]},{"nodeId":705280408,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":1004767882,"text":"And the game is meant to imitate the... romanticism of pursuing these flower petals...","nextNodeIds":[705280409,705280410]},{"nodeId":705280409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":453564466,"text":"That's, uh, quite the story...","nextNodeIds":[705280411]},{"nodeId":705280411,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":2897846714,"text":"Well, this inventor is a bard, so he has more of... You know, an imagination.","nextNodeIds":[705280412]},{"nodeId":705280412,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":1605534298,"text":"Basically, when you're playing this form of chess, you need to collect as many Bloom Balloons within the chessboard as possible.","nextNodeIds":[705280413]},{"nodeId":705280413,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":3834075746,"text":"You'll have to avoid various obstacles in the process... and there'll be some tools on hand to lend you some support...","nextNodeIds":[705280414]},{"nodeId":705280414,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":1800555746,"text":"That fellow even wrote an entire manual for this game, which I'll let you have a look at later.","nextNodeIds":[705280415]},{"nodeId":705280415,"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","textMapHash":2902923482,"text":"If you're interested, you're welcome to play. Remember, prizes are guaranteed just for participating!","nextNodeIds":[]},{"nodeId":705280410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3033672642,"text":"That's, ah, kinda complicated...","nextNodeIds":[705280411]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052804,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30047"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7052804],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30047,"speakerName":"Plauen","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[170528],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1562106558,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0