182],"performCfg":"","priority":5,"questId":22045,"showRandomTalkCount":0},"dialogs":[{"nodeId":220450101,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3279294586,"text":"Hmm, this still doesn't feel quite right...","nextNodeIds":[220450102]},{"nodeId":220450102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3408566386,"text":"What's wrong?","nextNodeIds":[220450103]},{"nodeId":220450103,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1110237338,"text":"Ah, Traveler, you're here! Just the person I wanted to see.","nextNodeIds":[220450104]},{"nodeId":220450104,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":151641346,"text":"Recently, I've gotten the feeling that the wood carvings I've been making... don't have... you know, life.","nextNodeIds":[220450105,220450107]},{"nodeId":220450105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2800772562,"text":"Well, they are made of wood.","nextNodeIds":[220450106]},{"nodeId":220450106,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1081941978,"text":"Oh, that's not what I mean...","nextNodeIds":[220450108]},{"nodeId":220450108,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1063991650,"text":"Hmm. How do I explain this? What I'm looking for is...","nextNodeIds":[220450109]},{"nodeId":220450109,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3015885394,"text":"You see, our provisional head priestess is mostly asleep, but at times, she will wake and wander about.","nextNodeIds":[220450110]},{"nodeId":220450110,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":203949946,"text":"While on her walks, she will hop or jump, pounce at some fallen leaves, or stretch, and things like that...","nextNodeIds":[220450111]},{"nodeId":220450111,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3516602042,"text":"I want to capture that in motion. I want to make carvings using these actions as a basis. That's what I mean by \"life.\"","nextNodeIds":[220450112,220450113]},{"nodeId":220450112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1678740258,"text":"Well, go see for yourself, then...","nextNodeIds":[220450114]},{"nodeId":220450114,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":841690218,"text":"Well, I, uh... I'm a little embarrassed to do that.","nextNodeIds":[220450115]},{"nodeId":220450115,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3928858554,"text":"Whatever we say, she is my boss. I feel like if I were to squat beside her and observe, I might make her unhappy...","nextNodeIds":[220450116]},{"nodeId":220450116,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3952770930,"text":"Your relationship, on the other hand, should be way better. So, could you help me take a few pictures to use as reference material?","nextNodeIds":[220450117,220450118]},{"nodeId":220450117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":45942218,"text":"Alright, alright, I got it...","nextNodeIds":[220450121]},{"nodeId":220450121,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3263713234,"text":"Alright, thanks so much, Traveler. Just bring me those pictures once you're done taking them.","nextNodeIds":[]},{"nodeId":220450118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":187060826,"text":"No guarantees on capturing the actions you want...","nextNodeIds":[220450119]},{"nodeId":220450119,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1874952778,"text":"No problem. You don't have to go for those big movements. I don't think my carving technique could keep up with that at the moment...","nextNodeIds":[220450120]},{"nodeId":220450120,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3421839146,"text":"Just capture a few poses. I think that'll do for now.","nextNodeIds":[220450121]},{"nodeId":220450113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":594266146,"text":"Well, she's right over there...","nextNodeIds":[220450114]},{"nodeId":220450107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2535881546,"text":"What sort of \"life\" are you looking to inject into your art?","nextNodeIds":[220450108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2204501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3182"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2204502,"order":2,"stepDescription":"Take a picture of Neko from the right side","stepDescTextMapHash":2553849692,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2204502,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUES