e":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7114403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7114403,"initDialog":711440301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30601],"performCfg":"QuestDialogue/WQ/4.7_guaiwuduitui_71144/Q7114403","priority":5,"questId":71144,"showRandomTalkCount":0},"dialogs":[{"nodeId":711440301,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":450417874,"text":"#The chiseled face, as though a classical sculpture come to life, and an unrivaled aura that surpasses common folk... You must be the commander {NICKNAME} of whom the rumors speak, no?","nextNodeIds":[711440302]},{"nodeId":711440302,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":2628317458,"text":"Your reputation precedes you! I was just thinking of entrusting the Adventurers' Guild with sending you a letter, extending an invitation to you to join our meeting, but you somehow seem to have foreseen this!","nextNodeIds":[711440303,711440304]},{"nodeId":711440303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1775311922,"text":"Commander?","nextNodeIds":[711440305]},{"nodeId":711440305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2773735242,"text":"#You're being so formal! It feels like you're treating {NICKNAME} like some kinda... super professional warrior?","nextNodeIds":[711440306]},{"nodeId":711440306,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":858647930,"text":"Oh, but you have been far more than mere warriors! You have crossed blades with countless monsters and formidable foes during your journey across five nations, and your exploits have been painstakingly recorded and repeatedly analyzed by the armed forces of each nation.","nextNodeIds":[711440307]},{"nodeId":711440307,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":1125170466,"text":"Whether it's the Knights of Favonius, Millelith, Shogunate Samurai, Corps of Thirty, or Maison Gardiennage, each and every one of the armed services has given nothing but the very highest of marks to your combat abilities and stratagems—","nextNodeIds":[711440308]},{"nodeId":711440308,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":3685538370,"text":"#\"{NICKNAME} has the capability to lead from the front or command from the rear. If possible, active cooperation must be established with {M#him}{F#her}.\"","nextNodeIds":[711440309]},{"nodeId":711440309,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":4030456290,"text":"Therefore, I, Staff Officer Su Ding of the Millelith, hereby formally invite you to participate in the Wargame of Five Armies and assume the post of senior consultant therein. What say you to this proposal?","nextNodeIds":[711440310]},{"nodeId":711440310,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":701592210,"text":"The remuneration package for senior consultants is quite considerable, and their total daily compensation for the duration of the event will be on par with that of a Millelith Sergeant.","nextNodeIds":[711440311]},{"nodeId":711440311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1453887202,"text":"That's the Millelith for you, straight to the point... A Sergeant's pay, eh? Now that sounds tempting...","nextNodeIds":[711440312,711440313]},{"nodeId":711440312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":964288930,"text":"But we still don't know what the deal is.","nextNodeIds":[711440314]},{"nodeId":711440314,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":3515378226,"text":"Do not be concerned about that. I shall now present a detailed introduction of the event for your benefit.","nextNodeIds":[711440315]},{"nodeId":711440315,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":4158268338,"text":"As you have seen, large numbers of monsters still roam the wilderness of Teyvat, and they cannot be eradicated in any sort of short timeframe.","nextNodeIds":[711440316]},{"nodeId":711440316,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":4134994394,"text":"In order to effectively deal with the monster threat, the armed services of our neighboring nations are compiling intel regarding commonly encountered monsters, seeking to analyze the threat they pose and share knowledge amongst ourselves.","nextNodeIds":[711440317]},{"nodeId":711440317,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":2404352778,"text":"To this end, the Millelith General Staff has created tabletop gamepieces based on all kinds of monsters in order to simulate hostile confrontations, and from this, analyze their combat capabilities to the best of our ability.","nextNodeIds":[711440318]},{"nodeId":711440318,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":1088260458,"text":"For this iteration of the Wargame, we've invited members serving in various combat units to utilize their own radically different mindsets and perspectives to control the gamepieces, finding the optimal method to suppress the monster threat.","nextNodeIds":[711440319]},{"nodeId":711440319,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":588955306,"text":"And as you are not a part of any of the armies, and are a rare tactical genius, you can provide an especially valuable analytical angle, greatly increasing the scope and efficiency of our Wargame.","nextNodeIds":[711440320]},{"nodeId":711440320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":663834194,"text":"Paimon thinks she gets it... So you guys are having a meeting to discuss... the most convenient and safest way to deal with monsters?","nextNodeIds":[711440321]},{"nodeId":711440321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2188328386,"text":"Now you're talking Paimon's language! After all, we've got first-hand experience dealing with dangerous baddies from all over, and we've also played lots of chess-like board games before!","nextNodeIds":[711440322]},{"nodeId":711440322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":586317986,"text":"If we can help a bunch of countries keep the peace just by playing games like we did before, and also get a pile of Mora while we're at it... Does that count as a whole flock of birds with one stone?","nextNodeIds":[711440323,711440325]},{"nodeId":711440323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1516459386,"text":"Casually game some war, save the day!","nextNodeIds":[711440324]},{"nodeId":711440324,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":2306776170,"text":"That is precisely the enthusiasm, the ability to calmly rise to any challenge, displaying your awesome skills and solving crises as easily and naturally as breathing...","nextNodeIds":[711440327]},{"nodeId":711440327,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":1741240898,"text":"The board is ready, and we can begin the simulation at any time. Let us witness the unique strategic prowess possessed only by a genius commander such as yourself!","nextNodeIds":[]},{"nodeId":711440325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":559713978,"text":"Looks like this time I might want to take things a bit more seriously...","nextNodeIds":[711440326]},{"nodeId":711440326,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":411487698,"text":"Please, relax, and just use the same mentality as you do when you usually confront monsters. You've earned yourself a reputation for being utterly unflappable among the soldiers of every nation.","nextNodeIds":[711440327]},{"nodeId":711440313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3603823066,"text":"We don't know anything about Wargaming...","nextNodeIds":[711440314]},{"nodeId":711440304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2337603306,"text":"Join what meeting now?","nextNodeIds":[711440305]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7114403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30601"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7114403],"speakerCo