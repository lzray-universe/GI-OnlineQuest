{"mainQuestId":74511,"title":"The Gardes' Inventor","description":"Two Gardes stop you. Just what are they doing...","titleTextMapHash":3859221391,"descTextMapHash":3147378662,"mainQuestExcel":{"mainQuestId":74511,"titleTextMapHash":3859221391,"title":"The Gardes' Inventor","descTextMapHash":3147378662,"description":"Two Gardes stop you. Just what are they doing...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5184,"luaPath":"Actor/Quest/WQ74511","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5184,"chapterId":0,"descTextMapHash":3147378662,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74511,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2708396401,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74511","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174511],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3859221391,"type":"WQ","unlockDescTextMapHash":4007181654}},"flow":[{"subQuestId":7451101,"order":1,"stepDescription":"Talk to the Gardes","stepDescTextMapHash":706368956,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30509"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7451101],"talks":[{"talkId":7451101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7451101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451101,"initDialog":745110101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30509,30534],"performCfg":"QuestDialogue/WQ/SlimeCannon_74511/Q7451101","priority":5,"questId":74511,"showRandomTalkCount":0},"dialogs":[{"nodeId":745110101,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":3215238098,"text":"Hello, friends.","nextNodeIds":[745110102]},{"nodeId":745110102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1754570026,"text":"Um, what business do the Gardes have with us?","nextNodeIds":[745110103]},{"nodeId":745110103,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3493087626,"text":"Hehe. Why don't you take a guess?","nextNodeIds":[745110104,745110105]},{"nodeId":745110104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3688742290,"text":"Is this about us flying around the city and scaling its walls?","nextNodeIds":[745110106]},{"nodeId":745110106,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2241808634,"text":"Ah, so you've done that too, have you? Hang on, let me add it to the list of charges.","nextNodeIds":[745110107]},{"nodeId":745110107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2492573306,"text":"Wait, you're trying to trick us!","nextNodeIds":[745110108]},{"nodeId":745110108,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3714348682,"text":"No, I'm just joking. Introductions are in order, I suppose. I'm Chenee, and this is my senior, Frejus.","nextNodeIds":[745110109]},{"nodeId":745110109,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3008921490,"text":"My senior's come up with a new invention that needs testing. Would the two of you be interested in helping?","nextNodeIds":[745110110]},{"nodeId":745110110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1647836178,"text":"A new invention? What sort of thing is it?","nextNodeIds":[745110111]},{"nodeId":745110111,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":3689025458,"text":"A remote-controlled cannon.","nextNodeIds":[745110112]},{"nodeId":745110112,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":526492538,"text":"As you can see, earlier turret models require an operator nearby, in which case, an enemy just needs to aim at the cannon to get rid of both. But if such weapons can be controlled remotely...","nextNodeIds":[745110113]},{"nodeId":745110113,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":587772362,"text":"That way, we can minimize casualties.","nextNodeIds":[745110114]},{"nodeId":745110114,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":31543810,"text":"You invented it so easily, too! I mean, that's why they call you \"the Garde who rejected the Fontaine Research Institute's invitation three times\"!","nextNodeIds":[745110115]},{"nodeId":745110115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":183619330,"text":"Three times rejected? The Institute?","nextNodeIds":[745110116]},{"nodeId":745110116,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2893416834,"text":"Well...","nextNodeIds":[745110117]},{"nodeId":745110117,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":4132031274,"text":"Exactly! Let me tell you, they had their eye on him, alright — they would've paid out the nose to have him do high-end research for 'em.","nextNodeIds":[745110118]},{"nodeId":745110118,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":39712130,"text":"But he's stayed all this time because he loves his work! Ah, such moving sentiment!","nextNodeIds":[745110119]},{"nodeId":745110119,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":1614839146,"text":"Even so, he could not bear to let his talents go to waste, and so he creates new inventions from time to time to help with our work!","nextNodeIds":[745110120]},{"nodeId":745110120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":705321346,"text":"Sounds awesome!","nextNodeIds":[745110121]},{"nodeId":745110121,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2101203090,"text":"Ahem, you flatter me, Chenee. Do you still remember what I said before? The smarter you are, the more important it is to be humble.","nextNodeIds":[745110122]},{"nodeId":745110122,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":220375538,"text":"Yessir!","nextNodeIds":[745110123]},{"nodeId":745110123,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":3083384306,"text":"In any case, I'd like the two of you to help us verify the feasibility of this remote-controlled cannon. We've already prepped the \"field\" and the \"targets,\" and rest assured that you will be well paid.","nextNodeIds":[745110124]},{"nodeId":745110124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2245189074,"text":"Hehe, in that case, you've come to the right adventurers!","nextNodeIds":[745110125]},{"nodeId":745110125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2708404618,"text":"The two of us have seen all sorts of stuff during our travels. We can help you figure out if your invention's good to go or not!","nextNodeIds":[745110126]},{"nodeId":745110126,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":4293307330,"text":"Nice! In that case, good luck, all!","nextNodeIds":[745110127]},{"nodeId":745110127,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":807222770,"text":"Well... This way, if you would.","nextNodeIds":[]},{"nodeId":745110105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3352926874,"text":"Is this about me practicing swordplay in the city?","nextNodeIds":[745110106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30509"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7451101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174511],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3147378662,"CHECNJEMEFE":{"30509":[1170],"30534":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/SlimeCannon_74511/Q7451101","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":745110101,"ILHDCGDKKKA"