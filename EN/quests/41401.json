AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4140101],"talks":[{"talkId":4140101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4140101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4140101,"initDialog":414010101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30044],"performCfg":"","priority":5,"questId":41401,"showRandomTalkCount":0},"dialogs":[{"nodeId":414010101,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1048732026,"text":"How very strange... What is the matter with this Kamera?","nextNodeIds":[414010102]},{"nodeId":414010102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2222812106,"text":"What's wrong with your Kamera?","nextNodeIds":[414010103]},{"nodeId":414010103,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":704219722,"text":"I think it's broken... Well, maybe not broken, but it's certainly not working like it's supposed to.","nextNodeIds":[414010104]},{"nodeId":414010104,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1493375082,"text":"I ordered a batch from Fontaine a while back.","nextNodeIds":[414010105]},{"nodeId":414010105,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3067527730,"text":"The person who sold it to me said that this particular kind of Kamera features the very latest technology from Fontaine.","nextNodeIds":[414010106]},{"nodeId":414010106,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3134008722,"text":"Supposedly, it can print photos in a special hue and add in some special effects, or something. So I bought one to try it out.","nextNodeIds":[414010107]},{"nodeId":414010107,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3693525506,"text":"But try as I might, I can't get it to print out photos properly. I don't know whether I'm using it wrong, or if it's just faulty.","nextNodeIds":[414010108]},{"nodeId":414010108,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":492204002,"text":"Maybe there's some trick to it that I'm not getting...","nextNodeIds":[414010109]},{"nodeId":414010109,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":39913410,"text":"So, how about you? Much of a Kamera Konnoisseur yourself?","nextNodeIds":[414010110,414010112]},{"nodeId":414010110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":88594634,"text":"I dabble.","nextNodeIds":[414010111]},{"nodeId":414010111,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1018396922,"text":"I'll take that as a yes! So, could I get you to help?","nextNodeIds":[414010114]},{"nodeId":414010114,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2040041778,"text":"I'm guessing you're a traveler? You must have a lot of experiences under your belt.","nextNodeIds":[414010115]},{"nodeId":414010115,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3204320082,"text":"What I'd like you to do is use this Kamera to take a picture of something with a strong color.","nextNodeIds":[414010116]},{"nodeId":414010116,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3031453226,"text":"Once you've taken a snap, if you could please bring me the photo. I want to see if I can isolate the source of the issue...","nextNodeIds":[414010117]},{"nodeId":414010117,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":148875146,"text":"And if I can't, I'll take the photos to the seller and see what he has to say. With the photos as hard evidence, he won't be able to dismiss the issue.","nextNodeIds":[414010118,414010120]},{"nodeId":414010118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2098223290,"text":"I'll do it.","nextNodeIds":[414010119]},{"nodeId":414010119,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2731273522,"text":"Great. Thanks!","nextNodeIds":[]},{"nodeId":414010120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":245681434,"text":"What do you mean by strong color?","nextNodeIds":[414010121]},{"nodeId":414010121,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2993476818,"text":"Oh, you know... Really bright colors, like red Jueyun Chilis, blue Mist Flower...","nextNodeIds":[414010122]},{"nodeId":414010122,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1435027274,"text":"Once you've taken a good shot, bring me the photo.","nextNodeIds":[]},{"nodeId":414010112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1361018658,"text":"Never heard of a \"Kamera\" in my life.","nextNodeIds":[414010113]},{"nodeId":414010113,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2779217626,"text":"Oh, I see... Well, never mind, it's simple enough to use... Would you mind giving me a hand anyway?","nextNodeIds":[414010114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4140101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4140101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[141401],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":606014230,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHN