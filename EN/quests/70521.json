{"mainQuestId":70521,"title":"Charity Event! A Great Success!","description":"The charity event is coming to an end. Hope all the effort has paid off...","titleTextMapHash":479438695,"descTextMapHash":2281817710,"mainQuestExcel":{"mainQuestId":70521,"titleTextMapHash":479438695,"title":"Charity Event! A Great Success!","descTextMapHash":2281817710,"description":"The charity event is coming to an end. Hope all the effort has paid off...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2016,"luaPath":"Actor/Quest/WQ70521","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2016,"chapterId":0,"descTextMapHash":2281817710,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70521,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2171095337,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70521","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170521],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":479438695,"type":"WQ","unlockDescTextMapHash":3647263526}},"flow":[{"subQuestId":7052101,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7052102,"order":2,"stepDescription":"Go back to the shop and check how the charity event is going","stepDescTextMapHash":1744393252,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7052101_N1002","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7052101],"talks":[{"talkId":7052101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7052102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7052101,"initDialog":705210101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1029,1002,30234],"performCfg":"QuestDialogue/WQ/Vintage_70521/Q7052101","priority":5,"questId":70521,"showRandomTalkCount":0},"dialogs":[{"nodeId":705210101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3272326050,"text":"Eula, Amber, you're here!","nextNodeIds":[705210102]},{"nodeId":705210102,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":229870354,"text":"Ah. Found you.","nextNodeIds":[705210103]},{"nodeId":705210103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2346829666,"text":"Huh? Wait, you came here looking for us?","nextNodeIds":[705210104]},{"nodeId":705210104,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":941401114,"text":"Of course! Do you have any idea how popular your charity stall is? Everyone's been talking about it...","nextNodeIds":[705210105]},{"nodeId":705210105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2723324498,"text":"\"Favonian Goodies and Buddies, run by the Honorary Knight and their sidekick, is selling all kinds of fantastic treasures — and even giving away some wonderful others for FREE! Don't miss out!\"","nextNodeIds":[705210106]},{"nodeId":705210106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2366287322,"text":"Ugh, so after all that, Paimon's back to being the sidekick? Hmm... Still, Paimon's really happy to hear that people are giving good reviews!","nextNodeIds":[705210107,705210108]},{"nodeId":705210107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3566364866,"text":"It's all thanks to our customers.","nextNodeIds":[705210109]},{"nodeId":705210109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1443686826,"text":"Anyway, what have you two been up to these days? Did you go off on a trip or something? We haven't seen you around all festival.","nextNodeIds":[705210110]},{"nodeId":705210110,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1971780402,"text":"Haha, that's because we're still working.","nextNodeIds":[705210111]},{"nodeId":705210111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":212578298,"text":"Huh? You still have to work?","nextNodeIds":[705210112,705210113]},{"nodeId":705210112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2596110338,"text":"You don't get any time off during the festival?","nextNodeIds":[705210114]},{"nodeId":705210114,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3987747882,"text":"Technically, Amber and I are on a \"vacation schedule.\"","nextNodeIds":[705210115]},{"nodeId":705210115,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":65968138,"text":"There are more merchant caravans than usual traveling the route between Dornman Port and Mondstadt City during the festival. Extra traffic means extra security is required.","nextNodeIds":[705210116]},{"nodeId":705210116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":614382482,"text":"Because of monsters and bandits and stuff?","nextNodeIds":[705210117]},{"nodeId":705210117,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1958502442,"text":"Yes. The Reconnaissance Company is tasked with patrolling this route during the festive period...","nextNodeIds":[705210118]},{"nodeId":705210118,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3984353162,"text":"As well as traveling with the caravans to ensure essential goods are delivered without incident, we have to investigate suspicious locations to eliminate any emerging threats.","nextNodeIds":[705210119]},{"nodeId":705210119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":214556098,"text":"Whew, that seems like a lot of work... sounds like you'll be working non-stop around the clock right up until the end of the Weinlesefest!","nextNodeIds":[705210120]},{"nodeId":705210120,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2669454194,"text":"Of course not. We take shifts.","nextNodeIds":[705210121]},{"nodeId":705210121,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":853553570,"text":"While one team is on duty, another is resting, and a third team is on standby in case of emergencies.","nextNodeIds":[705210122]},{"nodeId":705210122,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3617545330,"text":"These three teams rotate periodically.","nextNodeIds":[705210123]},{"nodeId":705210123,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2665522874,"text":"Eula's such an experienced captain. She arranged everything this way so that the Reconnaissance Company can meet the intense demand during the festival, while still giving everyone a chance to take some time off. Gotta say, great organizing, Eula!","nextNodeIds":[705210124]},{"nodeId":705210124,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":47854170,"text":"Yes, alright, Amber. I did my job, like I always do. I really don't see what the fuss is all about...","nextNodeIds":[705210125,705210127]},{"nodeId":705210125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2523913074,"text":"Quite the glowing review, Outrider.","nextNodeIds":[705210126]},{"nodeId":705210126,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1092008586,"text":"Hehehe, that's not the half of it. When you've got the time, I should tell you the story of when Eula got made captain. Now that's a good one.","nextNodeIds":[705210129]},{"nodeId":705210129,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3304096474,"text":"Ahem... Anyway, we didn't come here just to chit-chat... I'll let Eula do the honors.","nextNodeIds":[705210130]},{"nodeId":705210130,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2990957666,"text":"Okay. I need 40 portions of Knights' Special Northern Smoked Chicken, and 40 of Favonius-Favored Pile 'Em Up...","nextNodeIds":[705210131]},{"nodeId":705210131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4101246314,"text":"That's such a huge order! What's the occasion?","nextNodeIds":[705210132]},{"nodeId":705210132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2283184306,"text":"Wait... are the Knights of Favonius having an official feast? How come nobody told us about it...","nextNodeIds":[705210133]},{"nodeId":705210133,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2824577306,"text":"Haha, nothing quite as glamorous as all that. Captain Eula wants some supplies to reward her team members with.","nextNodeIds":[705210134]},{"nodeId":705210134,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1483961346,"text":"Correct. Scouts use up an enormous amount of energy in a single day. Each meal, they eat enough to feed, hmm... four to five normal people.","nextNodeIds":[705210135]},{"nodeId":705210135,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3465875074,"text":"Plus, a long-standing member has recently returned to our ranks after a long absence. I thought it would be fitting to celebrate the occasion.","nextNodeIds":[705210136]},{"nodeId":705210136,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1894227594,"text":"Of all the things I could have bought, I thought it would be best to have the money go to you. That way, I can support a charitable cause while I'm at it.","nextNodeIds":[705210137]},{"nodeId":705210137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":986234506,"text":"Paimon agrees! You made the right decision, Eula! It's what we business owners call a win-win situation!","nextNodeIds":[705210138]},{"nodeId":705210138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2090142538,"text":"Thank you for your generous contribution!","nextNodeIds":[705210139]},{"nodeId":705210139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1346677778,"text":"Also, about this \"long-standing member\" you mentioned... Is it that guy we met recently...?","nextNodeIds":[705210140]},{"nodeId":705210140,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2076614746,"text":"Mika, the front-line land surveyor. He was a vital member of our team before the Grand Master borrowed him for the expedition.","nextNodeIds":[705210141]},{"nodeId":705210141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":269742650,"text":"Mika, yeah, that's the one! Paimon never would've thought that shy little guy was such a strong knight!","nextNodeIds":[705210142,705210143]},{"nodeId":705210142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1700670154,"text":"But he seemed scared of us.","nextNodeIds":[705210144]},{"nodeId":705210144,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1301836554,"text":"Mika's not afraid of you guys. That was his way of showing respect to you... although admittedly it is kind of a roundabout way of doing it.","nextNodeIds":[705210145]},{"nodeId":705210145,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1207754674,"text":"He thinks all mighty people have unique personalities, and prefers to understand what makes them tick and the way they think before properly interacting with them.","nextNodeIds":[705210146]},{"nodeId":705210146,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3290065450,"text":"He says it makes it easier to communicate that way.","nextNodeIds":[705210147]},{"nodeId":705210147,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3906214130,"text":"He was the same way toward me and Amber at first. As we gradually got to know each other, he started acting more naturally.","nextNodeIds":[705210148]},{"nodeId":705210148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":124105762,"text":"Interesting... sounds like Mika's the one with the unique personality.","nextNodeIds":[705210149,705210150]},{"nodeId":705210149,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4099738258,"text":"I'll remember that.","nextNodeIds":[705210151]},{"nodeId":705210151,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":917722562,"text":"Mm-hmm. It'll just take a little time, that's all.","nextNodeIds":[705210152]},{"nodeId":705210152,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":64171010,"text":"You are a high-profile figure within the Knights of Favonius. As his commanding officer, I have a duty to make sure no misunderstandings arise between you.","nextNodeIds":[705210153]},{"nodeId":705210153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3396614498,"text":"Heh, it's alright, Eula, we get it. You're just looking after him.","nextNodeIds":[705210154]},{"nodeId":705210154,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3661996122,"text":"Wait! Eula, did you just pay for my portion, too?","nextNodeIds":[705210155]},{"nodeId":705210155,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3360047114,"text":"I was supposed to pay for mine separately... I'm not an official member of the Reconnaissance Company.","nextNodeIds":[705210156]},{"nodeId":705210156,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":420973666,"text":"If you want to get official about it, then fine: it's officially my treat. There, now stop worrying.","nextNodeIds":[705210157]},{"nodeId":705210157,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":319352698,"text":"You hand Eula and Amber the meals they purchased. They thank you and leave.","nextNodeIds":[705210158]},{"nodeId":705210158,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4018315994,"text":"Ooh, thanks to Eula and Amber, we made a whole day's worth of Mora in one fell swoop!","nextNodeIds":[705210159]},{"nodeId":705210159,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":2290445482,"text":"Honorary Knight, Paimon! I have the most wonderful news—","nextNodeIds":[705210160]},{"nodeId":705210160,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":3723835346,"text":"Thanks to your sterling efforts, the funds we've raised in this charity sale have blown our original predictions right out of the water! It's a phenomenal success!","nextNodeIds":[705210161]},{"nodeId":705210161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":829311690,"text":"Paimon told you so! We're good at this stuff.","nextNodeIds":[705210162,705210163]},{"nodeId":705210162,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2053550954,"text":"Great work, everyone.","nextNodeIds":[705210164]},{"nodeId":705210164,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":2379434098,"text":"Ah, but you two deserve all the credit. It's your expert management that made this event what it was.","nextNodeIds":[705210165]},{"nodeId":705210165,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":171802058,"text":"I've handed over all the revenue to the person responsible for managing our charitable funds. And with that, the event finally comes to a close.","nextNodeIds":[705210166]},{"nodeId":705210166,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":3138400178,"text":"As a gesture of our appreciation, we'd like to give you both a fee for all your hard work. You've more than earned it!","nextNodeIds":[705210167]},{"nodeId":705210167,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":3289815522,"text":"After this, I feel like I could even run a shop of my own in the future! Haha, maybe we'll get the chance to work together one day!","nextNodeIds":[705210168]},{"nodeId":705210168,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2946741698,"text":"It feels like we accomplished a lot together!","nextNodeIds":[705210169]},{"nodeId":705210169,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1325875946,"text":"If the chance ever comes up, let's do it again!","nextNodeIds":[]},{"nodeId":705210163,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3106160274,"text":"You did great as well, Bernhard.","nextNodeIds":[705210164]},{"nodeId":705210150,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1043089634,"text":"I'm sure we'll get along just fine.","nextNodeIds":[705210151]},{"nodeId":705210143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":41319874,"text":"He barely said two words before running away...","nextNodeIds":[705210144]},{"nodeId":705210127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1099563970,"text":"Captain Eula, you are an inspiration to us all.","nextNodeIds":[705210128]},{"nodeId":705210128,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2610775210,"text":"Enough. Both of you. The festive spirit is turning you into giddy little children.","nextNodeIds":[705210129]},{"nodeId":705210113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2576674770,"text":"You got stuck with the holiday shift, huh?","nextNodeIds":[705210114]},{"nodeId":705210108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2824844674,"text":"We owe everything to them.","nextNodeIds":[705210109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7052102","1"],"PAINLIBBLDK":"