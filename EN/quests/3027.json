NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":302701,"order":3,"stepDescription":"","stepDescTextMapHash":1197900004,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1075,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[302701],"talks":[{"talkId":302701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["302701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":302701,"initDialog":30261705,"nextRandomTalks":[],"nextTalks":[],"npcId":[1056],"performCfg":"QuestDialogue/AQ/Sumeru3_3027/Q302701","priority":5,"questId":3027,"showRandomTalkCount":0},"dialogs":[{"nodeId":30261705,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1539638066,"text":"Is there anything you want to know?","nextNodeIds":[30261706,30261717,30261729,30261735,30261743]},{"nodeId":30261706,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":560912282,"text":"About the Akasha...","nextNodeIds":[30261707]},{"nodeId":30261717,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1387859394,"text":"About what happened after I fell asleep that day...","nextNodeIds":[30261718]},{"nodeId":30261729,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4225652578,"text":"About The Balladeer...","nextNodeIds":[30261730]},{"nodeId":30261735,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":842355658,"text":"About Fontaine, the next stop on my journey...","nextNodeIds":[30261736]},{"nodeId":30261790,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2909874106,"text":"#About my {M#sister}{F#brother}...","nextNodeIds":[30261762]},{"nodeId":30261743,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2843474954,"text":"I've got nothing else to say.","nextNodeIds":[30261744]},{"nodeId":30261707,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":752336170,"text":"After recent events, the Akasha can no longer function as it used to.","nextNodeIds":[30261708]},{"nodeId":30261708,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":155694394,"text":"I've given it some thought, and have decided to shut it down permanently.","nextNodeIds":[30261709]},{"nodeId":30261709,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2950690250,"text":"But this is definitely not a bad thing. Even from the beginning, I've been planning to shut it down.","nextNodeIds":[30261710]},{"nodeId":30261710,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4210711186,"text":"The Akasha's centralized administration of knowledge has always restrained people's curiosity and curtailed the number of paths available to them. I don't think this is good for Sumeru.","nextNodeIds":[30261711]},{"nodeId":30261711,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":83229050,"text":"Although people may initially feel a little uncomfortable with the loss of the Akasha, they will soon understand that this life is more suitable for them.","nextNodeIds":[30261712]},{"nodeId":30261712,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":666758402,"text":"And as for the future of Sumeru... I'm preparing to regain control of the Akademiya.","nextNodeIds":[30261713]},{"nodeId":30261713,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3565869058,"text":"The former sages have received their punishment, but the new sages have yet to be selected. I will oversee the process personally.","nextNodeIds":[30261714]},{"nodeId":30261714,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3050279850,"text":"I hope that the new Six Great Sages will be more focused on academics. Sumeru needs such leaders more than ever.","nextNodeIds":[30261715]},{"nodeId":30261715,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1446747218,"text":"The other big issue is the people of King Deshret — all the residents of the desert, in fact. They have been mistreated for far too long.","nextNodeIds":[30261716]},{"nodeId":30261716,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1579411026,"text":"I've already taken some measures to address this. It will take some time to rebuild everything, but no matter if it's culture, friendship, or trust... we will rebuild it.","nextNodeIds":[30261705]},{"nodeId":30261718,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2917615394,"text":"You mean, what happened after The Doctor put you to sleep?","nextNodeIds":[30261719]},{"nodeId":30261719,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2503658474,"text":"Did he take the Gnoses?","nextNodeIds":[30261720]},{"nodeId":30261720,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2369259618,"text":"You guessed correctly... The top-ranked Fatui Harbingers, up to No. 3, possess power comparable to that of gods. I was no match for him in that kind of situation.","nextNodeIds":[30261721]},{"nodeId":30261721,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1943480962,"text":"However, in spite of the bad situation, I still managed to make a fair deal with The Doctor.","nextNodeIds":[30261722]},{"nodeId":30261722,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":399703730,"text":"I'm sure you remember the entity that changed your fate — the Heavenly Principles.","nextNodeIds":[30261723]},{"nodeId":30261723,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4222373458,"text":"In fact, the Heavenly Principles has been quiet since the Khaenri'ah disaster five hundred years ago. I used this point as leverage against The Doctor.","nextNodeIds":[30261724]},{"nodeId":30261724,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2597870698,"text":"I told him that the Heavenly Principles may be awakened if I destroyed a Gnosis. Although it was just a bluff, he still fell for it.","nextNodeIds":[30261725]},{"nodeId":30261725,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":680908338,"text":"I assumed that the Heavenly Principles wouldn't just stand by and let such extensive damage to its \"laws\" take place.","nextNodeIds":[30261726]},{"nodeId":30261726,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3811627250,"text":"And as for what I exchanged for the Gnoses...","nextNodeIds":[30261727]},{"nodeId":30261727,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4223440154,"text":"The exchange served as both punishment for The Doctor, as well as a boon of new knowledge that I couldn't refuse as the God of Wisdom.","nextNodeIds":[30261728]},{"nodeId":30261730,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3200851226,"text":"He's still in a coma. I've hidden him like how one would hide a feather.","nextNodeIds":[30261731]},{"nodeId":30261731,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":327326226,"text":"I know you have many misgivings about him, but as someone who had \"become a god,\" he has retained a number of very useful features.","nextNodeIds":[30261732]},{"nodeId":30261732,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3229860666,"text":"Don't worry, I'll keep an eye on him and make sure he doesn't do any evil.","nextNodeIds":[30261733]},{"nodeId":30261733,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2230137426,"text":"In addition, there are still some mysteries left in him. Some things may be very clear from my perspective, but he has still yet to understand them himself.","nextNodeIds":[30261734]},{"nodeId":30261734,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3447985322,"text":"His future will be determined by fate.","nextNodeIds":[30261705]},{"nodeId":30261736,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1872061594,"text":"Is that where you're headed next? Fontaine, the nation of justice.","nextNodeIds":[30261737]},{"nodeId":30261737,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1050040002,"text":"As far as I know, that nation operates on a judicial system.","nextNodeIds":[30261738]},{"nodeId":30261738,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":384465242,"text":"Does their archon personally judge people?","nextNodeIds":[30261739]},{"nodeId":30261739,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4170810834,"text":"No, there's a Chief Justice in Fontaine. Generally speaking, the Hydro Archon, Focalors, won't preside over individual trials.","nextNodeIds":[30261740]},{"nodeId":30261740,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4026092762,"text":"However... even then, Focalors will still make herself present at just about every trial. It seems that she just likes to immerse herself in that sort of atmosphere.","nextNodeIds":[30261741]},{"nodeId":30261741,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":996597418,"text":"As archon, she still reserves the right to influence the final verdict.","nextNodeIds":[30261742]},{"nodeId":30261742,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2289502194,"text":"Anyway, let's just say she's got... hmm... a very unique personality.","nextNodeIds":[30261705]},{"nodeId":30261784,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":179923178,"text":"And soon, you'll also begin your journey anew, and depart from Sumeru.","nextNodeIds":[30261785]},{"nodeId":30261785,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":555216802,"text":"I'm very interested in your future. It's a journey that can't be observed or recorded by this world...","nextNodeIds":[30261786]},{"nodeId":30261786,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1976260626,"text":"If fate is the ultimate knowledge, then your future will be the ultimate fate.","nextNodeIds":[30261787]},{"nodeId":30261787,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2148857114,"text":"Paimon's sure glad we got to meet you, Nahida.","nextNodeIds":[30261788]},{"nodeId":30261788,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3819746434,"text":"The pleasure is all mine... I can't thank you enough.","nextNodeIds":[30261789]},{"nodeId":30261789,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":128130106,"text":"All right, that's enough talk for today. If you ever miss me, just close your eyes — and maybe I'll appear in your dreams~","nextNodeIds":[]},{"nodeId":30261762,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3656964946,"text":"According to the records I was able to access, your sibling suddenly appeared in Khaenri'ah...","nextNodeIds":[30261763]},{"nodeId":30261763,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3177834378,"text":"#After the Khaenri'ah disaster, {M#she}{F#he} began {M#her}{F#his} journey through the seven nations of Teyvat.","nextNodeIds":[30261764]},{"nodeId":30261764,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2510074002,"text":"#But just as {M#her}{F#his} journey was about to reach its conclusion, the Irminsul records on {M#her}{F#him} suddenly become fuzzy...","nextNodeIds":[30261765]},{"nodeId":30261765,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3537841202,"text":"#What do you mean, \"fuzzy\"? Did something happen to {M#her}{F#him}?","nextNodeIds":[30261766]},{"nodeId":30261766,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4050065602,"text":"#All I know for sure is that somebody, for reasons only they can know, is deliberately obfuscating {F#his}{M#her} fate...","nextNodeIds":[30261767]},{"nodeId":30261767,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2835325226,"text":"And whoever it is... if they can do that, who knows what else they're capable of.","nextNodeIds":[30261768]},{"nodeId":30261768,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4014414242,"text":"Could it be related to... the Abyss?","nextNodeIds":[30261769]},{"nodeId":30261769,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":44559058,"text":"#But even that wouldn't explain how {F#he}{M#she} somehow comes from this world...","nextNodeIds":[30261770]},{"nodeId":30261770,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3949662554,"text":"Something else I noticed was that according to these records, the Fatui have not classified your sibling as one of the \"Descenders.\"","nextNodeIds":[30261771]},{"nodeId":30261771,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":594784674,"text":"Descenders?","nextNodeIds":[30261772]},{"nodeId":30261772,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2399150362,"text":"...What's a Descender? Paimon's never heard of it...","nextNodeIds":[30261773]},{"nodeId":30261773,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":3947722970,"text":"Look, I'm sure you must be curious about the information I received from the Fatui in return for my Gnosis, right?","nextNodeIds":[30261774]},{"nodeId":30261774,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1884115202,"text":"A very important part of the intel was about this world's Descenders... external beings, ones that don't belong to this world.","nextNodeIds":[30261775]},{"nodeId":30261775,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1640309442,"text":"#{NICKNAME}, you are Teyvat's \"Fourth Descender.\"","nextNodeIds":[30261776]},{"nodeId":30261776,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2231106442,"text":"Fourth...?","nextNodeIds":[30261777]},{"nodeId":30261777,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1357191266,"text":"#Huh!? So the Fatui count three other Descenders before {NICKNAME}? And {M#his sister}{F#her brother} isn't even one of them?","nextNodeIds":[30261778]},{"nodeId":30261778,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":216889738,"text":"That's right. My current hypothesis is that the \"First Descender\" was likely what we now call the Heavenly Principles.","nextNodeIds":[30261779]},{"nodeId":30261779,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":1763480082,"text":"As for the other Descenders... I still need to verify their existence. It could take me some time.","nextNodeIds":[30261780]},{"nodeId":30261780,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1232377322,"text":"Whew... Paimon's head's about to burst from all this crazy new information...","nextNodeIds":[30261781]},{"nodeId":30261781,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":4087723378,"text":"And yet, even knowing all this, I'm sure you must still have a lot of unanswered questions. I must say, I truly regret that I can't help you more as the God of Wisdom...","nextNodeIds":[30261782]},{"nodeId":30261782,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","textMapHash":2628015674,"text":"There are many questions in my heart as well. I will need some time to go through each one of them.","nextNodeIds":[30261783]},{"nodeId":30261783,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2128879242,"text":"Same here... I'll need some time to reflect on what you've said.","nextNodeIds":[30261705]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1075,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[302701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"Nahida","count":49},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3885672502,"CHECNJEMEFE":{"12952":[4121]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/AQ/Sumeru3_3027/Q302701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[]