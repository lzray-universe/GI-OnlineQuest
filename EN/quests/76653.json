INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7665302],"talks":[{"talkId":7665302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7665302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7665302,"initDialog":766530201,"nextRandomTalks":[],"nextTalks":[],"npcId":[7048],"performCfg":"QuestDialogue/EQ/V6.0ActivityNodKraiTour_76653/Q7665302","priority":5,"questId":76653,"showRandomTalkCount":0},"dialogs":[{"nodeId":766530201,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":851171682,"text":"Where did I go wrong? If only I had more than theoretical knowledge...","nextNodeIds":[766530202]},{"nodeId":766530202,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1801550658,"text":"Okay, no need to confirm this order... This is Ginette, a Fontainian engineer. Of all the orders I got, this one was the most interesting!","nextNodeIds":[766530203]},{"nodeId":766530203,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":2569374426,"text":"You're finally here! So there's still hope...","nextNodeIds":[766530204]},{"nodeId":766530204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1366265234,"text":"Hi there! We're Aino's assistants... Or, well, Paimon thinks you can call us that. Whaddya need help with?","nextNodeIds":[766530205]},{"nodeId":766530205,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1481916434,"text":"She's made a type of robot that can use kuuvahki to achieve long-distance communication... which sounds super fun! But she's run into a whole bunch of malfunctions, and so she wants me to help her troubleshoot her stuff.","nextNodeIds":[766530206]},{"nodeId":766530206,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":4233020602,"text":"I'm ashamed to admit that trial-and-error curiosity won't yield any results. In the end, it still boils down to practice...","nextNodeIds":[766530207]},{"nodeId":766530207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3253622170,"text":"Doesn't sound that hard... Just leave it to us!","nextNodeIds":[766530208]},{"nodeId":766530208,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":185305242,"text":"This is a bit embarrassing, but... I'd like to modify my order. While waiting for your reply, I... Well, I ended up making another mess of things...","nextNodeIds":[766530209]},{"nodeId":766530209,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":386753218,"text":"I was suddenly curious if a change of environment could solve the issue. So I conducted more tests in areas with different kuuvahki concentrations.","nextNodeIds":[766530210]},{"nodeId":766530210,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":4187991770,"text":"...But the malfunctions still happened, and I ended up losing those robots. Sooo... apart from the agreed-upon debugging... Could you help me retrieve the robots as well...?","nextNodeIds":[766530211]},{"nodeId":766530211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1033455850,"text":"You lost the robots? All of them?","nextNodeIds":[766530212]},{"nodeId":766530212,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":2771210154,"text":"If you need me to compensate with extra pay, I'll think of something, I promise!","nextNodeIds":[766530213]},{"nodeId":766530213,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":714511354,"text":"Hmm.... But there should be many ways to track them down. Since the robots are all powered by kuuvahki, they should leave behind kuuvahki remnants wherever they go.","nextNodeIds":[766530214]},{"nodeId":766530214,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":3022220202,"text":"I'll prep a special device for you. Once you use it to collect enough kuuvahki remnants, you'll be able to track down whichever robot left 'em behind.","nextNodeIds":[766530215]},{"nodeId":766530215,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":4090517082,"text":"Hmm-hmm... Well, this sounds fun! And since it does, I won't ask for extra pay!","nextNodeIds":[766530216]},{"nodeId":766530216,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":3725076306,"text":"Really? Thank you, thank you!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7665301,"order":2,"stepDescription":"","stepDescTextMapHash":945074812,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665301,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665301,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOH