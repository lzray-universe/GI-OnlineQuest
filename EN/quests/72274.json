idden":false,"talkIds":[7227401,7227402],"talks":[{"talkId":7227401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7227401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7227401,"initDialog":722740110,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005,10324,12212],"performCfg":"QuestDialogue/WQ/Inazuma_72274/Q7227401","priority":5,"questId":72274,"showRandomTalkCount":0},"dialogs":[{"nodeId":722740110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2891276746,"text":"This place seems to have its secrets after all...","nextNodeIds":[722740111]},{"nodeId":722740111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2887409922,"text":"Shh! Listen. There are people talking over there.","nextNodeIds":[722740101]},{"nodeId":722740101,"roleType":"TALK_ROLE_NPC","speakerId":10324,"speakerName":"Fatui Skirmisher","textMapHash":805759434,"text":"Gah. Never expected that woman's lips to be sealed up so tight. Not a peep from her at all!","nextNodeIds":[722740102]},{"nodeId":722740102,"roleType":"TALK_ROLE_NPC","speakerId":12212,"speakerName":"Ronin: Anbu","textMapHash":3815758450,"text":"Not to worry, sirs. Interrogation is our specialty. Take a break. We'll take care of this in a moment!","nextNodeIds":[722740103]},{"nodeId":722740103,"roleType":"TALK_ROLE_NPC","speakerId":10324,"speakerName":"Fatui Skirmisher","textMapHash":2174615762,"text":"We haven't much time left. The Teacher wants to know how much she knows about our plans, and he wants to know now — or we'll be in hot soup too!","nextNodeIds":[722740104]},{"nodeId":722740104,"roleType":"TALK_ROLE_NPC","speakerId":12212,"speakerName":"Ronin: Anbu","textMapHash":2049177162,"text":"Gah. His temper is really... something. What in the world did that woman do to anger him so?","nextNodeIds":[722740105]},{"nodeId":722740105,"roleType":"TALK_ROLE_NPC","speakerId":10324,"speakerName":"Fatui Skirmisher","textMapHash":1646634370,"text":"The Teacher's latest plans have this person named Lyudochka as a critical piece. But this Shuumatsuban woman took her out!","nextNodeIds":[722740106]},{"nodeId":722740106,"roleType":"TALK_ROLE_NPC","speakerId":10324,"speakerName":"Fatui Skirmisher","textMapHash":1065661666,"text":"Fortunately, the fire hadn't quite gone out when we rushed in. The Teacher, sharp-eyed as he is, identified Lyudochka from her clothes right away and recognized that our plans might be at risk.","nextNodeIds":[722740107]},{"nodeId":722740107,"roleType":"TALK_ROLE_NPC","speakerId":12212,"speakerName":"Ronin: Anbu","textMapHash":1731462786,"text":"Bad as that might have been, he really salvaged things, huh?","nextNodeIds":[722740108]},{"nodeId":722740108,"roleType":"TALK_ROLE_NPC","speakerId":10324,"speakerName":"Fatui Skirmisher","textMapHash":4136511978,"text":"Still, we don't know how much of our plans this woman is privy to, or if she's informed anyone else in the Shuumatsuban yet.","nextNodeIds":[722740109]},{"nodeId":722740109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":33048042,"text":"It looks like Momoyo is locked up in an underground cell. Let's get her outta there!","nextNodeIds":[]}]},{"talkId":7227402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7227401","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7227402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",