{"mainQuestId":76009,"title":"The Tale of the Gate Stone","description":"In the center of the Frostmoon Enclave, you discover a strange large stone...","titleTextMapHash":4070697351,"descTextMapHash":3571344854,"mainQuestExcel":{"mainQuestId":76009,"titleTextMapHash":4070697351,"title":"The Tale of the Gate Stone","descTextMapHash":3571344854,"description":"In the center of the Frostmoon Enclave, you discover a strange large stone...","chapterId":10241,"mainQuestTag":"MAINQUEST_TAG_RANK_ZERO_WQ","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ76009","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":10241,"descTextMapHash":3571344854,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76009,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":163165329,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76009","mainQuestTag":"MAINQUEST_TAG_RANK_ZERO_WQ","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176009],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[0],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4070697351,"type":"WQ","unlockDescTextMapHash":2460675398}},"flow":[{"subQuestId":7600902,"order":1,"stepDescription":"","stepDescTextMapHash":3863857412,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7600902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["21839"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7600902],"talks":[{"talkId":7600902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7600902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":7600902,"initDialog":760090201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21839],"performCfg":"QuestDialogue/WQ/NodKrai_76009/Q7600902","priority":5,"questId":76009,"showRandomTalkCount":0},"dialogs":[{"nodeId":760090201,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3864058282,"text":"Hmm... Doesn't seem to be this one either...","nextNodeIds":[760090202]},{"nodeId":760090202,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":1575533906,"text":"#Oh, hello there, {M#Big Bro}{F#Big Sis}. I don't think I've seen you before... or the white fae lady next to you.","nextNodeIds":[760090203]},{"nodeId":760090203,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":927814642,"text":"Welcome to the Frostmoon Enclave! Is there anything I can help you with?","nextNodeIds":[760090204]},{"nodeId":760090204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1110910106,"text":"#Nope, we just got curious, seeing you out here all alone like this. By the way, Paimon's Paimon, and this is {NICKNAME}!","nextNodeIds":[760090205]},{"nodeId":760090205,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3987811898,"text":"#So it's {M#Mr.}{F#Miss} {NICKNAME} and Miss Paimon! Hmm... Y'know, you two don't look like you're from Nasha Town.","nextNodeIds":[760090206,760090208]},{"nodeId":760090206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4250418,"text":"We're adventurers.","nextNodeIds":[760090207]},{"nodeId":760090207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1857764266,"text":"Yup! Super awesome adventurers, at that!","nextNodeIds":[760090211]},{"nodeId":760090211,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3539076962,"text":"Must be nice though — traveling around with your best friend, seeing the world together...","nextNodeIds":[760090212]},{"nodeId":760090212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1162229530,"text":"It really is! We've been to so many places already! What about you? What were you doing out here just now?","nextNodeIds":[760090213]},{"nodeId":760090213,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":2294417938,"text":"I was looking for pretty stones.","nextNodeIds":[760090214]},{"nodeId":760090214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3609706066,"text":"Oh, Paimon gets it! You collect them, right? You're not the only one — some grown-ups are super into that too!","nextNodeIds":[760090215]},{"nodeId":760090215,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":1002801402,"text":"Nope! I'm gonna use the pretty stones to bribe Mai into kidnapping me.","nextNodeIds":[760090216]},{"nodeId":760090216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":49841506,"text":"Okay, that makes sen— wait, what!?","nextNodeIds":[760090217,760090218]},{"nodeId":760090217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":878703682,"text":"That's... definitely not what I was expecting...","nextNodeIds":[760090220]},{"nodeId":760090220,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":499103650,"text":"Hmm? You've never heard the story of the legendary thief Reed Miller and the fae princess? But Mai told me it's super famous outside...","nextNodeIds":[760090221]},{"nodeId":760090221,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3288348842,"text":"\"Come, lady with moonlit eyes, let me steal your heart with this jewel that matches your gaze, and whisk you away from this gilded cage...\"","nextNodeIds":[760090222]},{"nodeId":760090222,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3902634130,"text":"I'm not really sure what it means, but... if you give someone something they like, that means you can go on an adventure with them, right?","nextNodeIds":[760090223,760090225]},{"nodeId":760090223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3010212634,"text":"That's not what it means at all...","nextNodeIds":[760090224]},{"nodeId":760090224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1155046242,"text":"Y—Yeah... It actually means... Uh... anyway, it's not exactly a story for kids!","nextNodeIds":[760090227]},{"nodeId":760090227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":188492690,"text":"By the way, who is this Mai you're talking about? Telling kids strange stories like that... That sounds kinda questionable!","nextNodeIds":[760090228]},{"nodeId":760090228,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":2725700066,"text":"She's not a bad person! And she's about the same age as me.","nextNodeIds":[760090229]},{"nodeId":760090229,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":728360194,"text":"She's an adventurer too, just like you two! I caught her sneaking around near camp once, so I made her tell me a story.","nextNodeIds":[760090230]},{"nodeId":760090230,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":2858277322,"text":"For some reason, she seemed to think we were some scary cult of weirdos who sacrifice kidnapped kids to the Moon Goddess. She tried to act all calm while begging me not to kill her...","nextNodeIds":[760090231]},{"nodeId":760090231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2692477010,"text":"What kind of weird misunderstanding is that...?","nextNodeIds":[760090232]},{"nodeId":760090232,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":1253385370,"text":"Right? I have no idea where she even heard something like that. It's so strange. But since it sounded kinda funny, I didn't bother correcting her.","nextNodeIds":[760090233]},{"nodeId":760090233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1314126354,"text":"That's exactly why you should've corrected her!","nextNodeIds":[760090234]},{"nodeId":760090234,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":714815386,"text":"Anyway, in exchange, she promised to be my best friend and told me lots and lots of stories about the outside world.","nextNodeIds":[760090235]},{"nodeId":760090235,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":935663402,"text":"Mom and Dad never let me read stories from the outside world, saying only non-believers would like such worthless things... But Mai's stories were really interesting!","nextNodeIds":[760090236]},{"nodeId":760090236,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":682111682,"text":"Like the fisherman who fell in love with a fae, the thief who died three times but escaped from the Lady of the Underworld thrice, and the changeling who longed to become human...","nextNodeIds":[760090237]},{"nodeId":760090237,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3993237594,"text":"There were kind people, not-so-kind people, and really, really bad people. Rich or poor, good or evil... in the end, everyone dies in misery.","nextNodeIds":[760090238,760090240]},{"nodeId":760090238,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3145977210,"text":"Okay, yeah, your parents have a point... those are pretty messed up.","nextNodeIds":[760090239]},{"nodeId":760090239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2617973242,"text":"Yeah, definitely not the kind of stories you tell kids...","nextNodeIds":[760090243]},{"nodeId":760090243,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3061882810,"text":"But I'm not a kid anymore. Mai also said that the outside world's way too dangerous for someone like me...","nextNodeIds":[760090244]},{"nodeId":760090244,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":934383594,"text":"Which is kinda rich from her. She can't even use the bless{RUBY#[S]kuuvahki}ing of the Moon Goddess, and she's about the same age as me.","nextNodeIds":[760090245]},{"nodeId":760090245,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3986410138,"text":"Still, it's fine! I'm super smart, anyway. Before I caught her, she kept muttering about some \"stone\"... That means she must be looking for pretty stones, right?","nextNodeIds":[760090246]},{"nodeId":760090246,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":4247605242,"text":"If I find some <color=#00E1FFFF>pretty stones</color>, I bet I can bribe her with ease! Just like how Reed Miller lured the fae lady away, she'll take me away from here, right?","nextNodeIds":[760090247]},{"nodeId":760090247,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":721117554,"text":"Can you not say \"bribe\" like that? You're just giving your friend a nice gift — that's totally normal! No need to make it sound weird!","nextNodeIds":[760090248]},{"nodeId":760090248,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3345522,"text":"Well, we'll be looking around this area anyway, so if we find any pretty pieces, we'll bring them back to you.","nextNodeIds":[760090249]},{"nodeId":760090249,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":3619545146,"text":"Wow, really? Thank you so much!","nextNodeIds":[]},{"nodeId":760090240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4227959050,"text":"Wow... I really wanna hear the whole thing. Could you tell me more?","nextNodeIds":[760090241]},{"nodeId":760090241,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":2607020602,"text":"Okay. For example, Reed Miller's companion, the \"Shadow Weasel\" who swore to never step into the moonlight again...","nextNodeIds":[760090242]},{"nodeId":760090242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3171906826,"text":"Huh!? Now's not the time for stories like that! And anyway... those aren't exactly stories for kids!","nextNodeIds":[760090243]},{"nodeId":760090225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1145555722,"text":"That's right, that's how I lured Paimon onto this path...","nextNodeIds":[760090226]},{"nodeId":760090226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3430417882,"text":"Hey, don't teach kids weird things! Just because Paimon loves your cooking doesn't mean our friendship started with a \"kidnapping\"!","nextNodeIds":[760090227]},{"nodeId":760090218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":384554690,"text":"Seems normal enough for Nod-Krai...","nextNodeIds":[760090219]},{"nodeId":760090219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2199709002,"text":"No, this is not normal, even here!","nextNodeIds":[760090220]},{"nodeId":760090208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2654616154,"text":"Actually... I'm the real mastermind behind the scenes in Nasha Town...","nextNodeIds":[760090209]},{"nodeId":760090209,"roleType":"TALK_ROLE_NPC","speakerId":21839,"speakerName":"Kasha","textMapHash":1385414842,"text":"#Whoa, seriously? That sounds so cool! Can I be your follower then, {NICKNAME}? You know, like in one of those epic stories?","nextNodeIds":[760090210]},{"nodeId":760090210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1528216706,"text":"Hey, quit messing around! We're just regular adventurers passing through, okay!? No way we're secretly pulling all the strings in Nasha Town or anything... at least, not that Paimon knows of...","nextNodeIds":[760090211]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7600902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["21839"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7600903,"order":2,"stepDescription":"Find \"pretty stones\" nearby","stepDescTextMapHash":1855353404,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7600903Finish"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_11117:1802.089,224.694,10414.930]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7600901],"talks":[{"talkId":7600901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param