{"mainQuestId":23035,"title":"Next Time, On King of Invokations...","description":"Something seems to be bothering the novelist, Fukumoto...","titleTextMapHash":438014359,"descTextMapHash":3742687318,"mainQuestExcel":{"mainQuestId":23035,"titleTextMapHash":438014359,"title":"Next Time, On King of Invokations...","descTextMapHash":3742687318,"description":"Something seems to be bothering the novelist, Fukumoto...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ23035","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3742687318,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":23035,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3570682209,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ23035","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[123035],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":438014359,"type":"WQ","unlockDescTextMapHash":538384958}},"flow":[{"subQuestId":2303501,"order":1,"stepDescription":"Talk to Fukumoto","stepDescTextMapHash":2857215084,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12717"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2303501],"talks":[{"talkId":2303501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2303501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2303501,"initDialog":230350101,"nextRandomTalks":[],"nextTalks":[],"npcId":[12717],"performCfg":"","priority":5,"questId":23035,"showRandomTalkCount":0},"dialogs":[{"nodeId":230350101,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":3673531074,"text":"*sigh* I want to go back to Inazuma... How could this happen to me...","nextNodeIds":[230350102,230350103]},{"nodeId":230350102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1992588274,"text":"What's wrong?","nextNodeIds":[230350104]},{"nodeId":230350104,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":4046588210,"text":"Traveler? *sigh* Don't even mention the novel. Those researchers working on Genius Invokation TCG are barely holding it together.","nextNodeIds":[230350105]},{"nodeId":230350105,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":1299009706,"text":"According to a researcher I know quite well, the team encountered all kinds of problems that could only be described as baffling...","nextNodeIds":[230350106]},{"nodeId":230350106,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":1616645050,"text":"For example, a Haravatat researcher suddenly asked a question one day.","nextNodeIds":[230350107]},{"nodeId":230350107,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2626911018,"text":"He said that if the effect descriptions on the cards are too long, it might discourage people who aren't used to reading long blocks of text from playing the game.","nextNodeIds":[230350108]},{"nodeId":230350108,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2498233690,"text":"Researchers are used to reading large chunks of text and aren't affected by this issue, but the long descriptions could very well turn potential players away.","nextNodeIds":[230350109]},{"nodeId":230350109,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":3185088986,"text":"So he suggested cutting the amount of text on some cards in half to make them easier to read.","nextNodeIds":[230350110,230350111]},{"nodeId":230350110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":373463890,"text":"Is that really necessary?","nextNodeIds":[230350112]},{"nodeId":230350112,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":4002387530,"text":"It's not a problem to me... But the researchers are still working hard on this issue. After all, it's about the player's experience, and the fewer problems, the better.","nextNodeIds":[230350113]},{"nodeId":230350113,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":3799126562,"text":"Anyway... There's an even bigger problem. They promised to help me find models for my novel, but something went wrong with that, too.","nextNodeIds":[230350114]},{"nodeId":230350114,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":588865170,"text":"Remember? I told you earlier about a researcher who said they'd introduce me to Tighnari and Cyno, and ask them to be the inspirations for my novel.","nextNodeIds":[230350115]},{"nodeId":230350115,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":4036075378,"text":"But they're so busy. I don't think I can count on them for a while...","nextNodeIds":[230350116,230350117]},{"nodeId":230350116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3463067946,"text":"What will you do?","nextNodeIds":[230350118]},{"nodeId":230350118,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2510639442,"text":"The researcher who received me was not able to help me with this, but he gave me an idea.","nextNodeIds":[230350119]},{"nodeId":230350119,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":1670937178,"text":"He said Cyno sometimes goes to Puspa Café to play cards.","nextNodeIds":[230350120]},{"nodeId":230350120,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":34925298,"text":"If I want... I can try my luck there first. Or maybe they'll help me get in touch when they're free.","nextNodeIds":[230350121]},{"nodeId":230350121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2863881394,"text":"And... what are your thoughts?","nextNodeIds":[230350122]},{"nodeId":230350122,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":1862225786,"text":"*sigh* By the time they're free, I'll have finished writing the novel.","nextNodeIds":[230350123]},{"nodeId":230350123,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":3416746434,"text":"I guess I'll go myself and see if I can find Cyno.","nextNodeIds":[230350124]},{"nodeId":230350124,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":19965354,"text":"But if I'm lucky enough to meet Cyno at the café, how should I even introduce myself to him? What a dilemma...","nextNodeIds":[230350128,230350129]},{"nodeId":230350128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3792344906,"text":"I can help.","nextNodeIds":[230350130]},{"nodeId":230350130,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":1241977250,"text":"Really!? That's amazing! But how did you... Uh, you know what? I'm not gonna pry further.","nextNodeIds":[230350131]},{"nodeId":230350131,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2855553930,"text":"What are we waiting for then? Let's head to Puspa Café right now! Hope we'll be able to catch Cyno...","nextNodeIds":[]},{"nodeId":230350129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3915256194,"text":"I know Cyno pretty well.","nextNodeIds":[230350130]},{"nodeId":230350117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1033490002,"text":"How will you get in touch?","nextNodeIds":[230350118]},{"nodeId":230350111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3599131210,"text":"Is it really that long...?","nextNodeIds":[230350112]},{"nodeId":230350103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2275742058,"text":"Got writer's block?","nextNodeIds":[230350104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12717"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2303502,"order":2,"stepDescription":"Go to Puspa Café","stepDescTextMapHash":3844272780,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303502,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12717"],"NOCCOBOFKHP":1074,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303502,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"e