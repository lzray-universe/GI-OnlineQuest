mTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2303503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2303503,"initDialog":230350301,"nextRandomTalks":[],"nextTalks":[],"npcId":[12717],"performCfg":"","priority":5,"questId":23035,"showRandomTalkCount":0},"dialogs":[{"nodeId":230350301,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":1183102034,"text":"Shh... I—Isn't that Cyno?","nextNodeIds":[230350302]},{"nodeId":230350302,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":464450962,"text":"Look at his outfit, his hairstyle, and that hair color... This is exactly what a protagonist in a card game novel should look like!","nextNodeIds":[230350303,230350305]},{"nodeId":230350303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4179624538,"text":"This has no rhyme nor reason...","nextNodeIds":[230350304]},{"nodeId":230350304,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2995930434,"text":"Heh, just trust my instincts on the market. But now's not a good time to explain...","nextNodeIds":[230350309]},{"nodeId":230350309,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":247767026,"text":"Traveler, please ask Cyno to be the model for my novel... I'm counting on you!","nextNodeIds":[]},{"nodeId":230350305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1335016138,"text":"I actually know quite a lot of people who can fit into this category...","nextNodeIds":[230350306]},{"nodeId":230350306,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":3100979522,"text":"Really? That's great. I'm working on the third book of \"King of Invokations,\" and this time, I'm not going to base it on the gameplay mechanics of Genius Invokation TCG.","nextNodeIds":[230350307]},{"nodeId":230350307,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2276007778,"text":"I'm going to create an all-new way of playing. For instance... I could get all cards to be suspended mid-air on the field. Players will have to collect cards as they consider their next move, all the while preventing their opponent from collecting cards themselves...","nextNodeIds":[230350308]},{"nodeId":230350308,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":716330626,"text":"Hahaha! I'm getting excited just thinking about it! But we don't have time for this right now...","nextNodeIds":[230350309]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12717"],"NOCCOBOFKHP":1074,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2303504,"order":4,"stepDescription":"Talk to Cyno","stepDescTextMapHash":1863272164,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1058"],"NOCCOBOFKHP":1074,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2303504],"talks":[{"talkId":2303504,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2303504","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2303504,"initDialog":230350401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1058],"performCfg":"QuestDialogue/IQ/Xumi_23035/Q2303504","priority":5,"questId":23035,"showRandomTalkCount":0},"dialogs":[{"nodeId":230350401,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":3555280418,"text":"...Hmm, this combination of cards isn't so bad.","nextNodeIds":[230350402]},{"nodeId":230350402,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":2667568610,"text":"But they're not strong enough to deal with quick attacks...","nextNodeIds":[230350403]},{"nodeId":230350403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2379019090,"text":"What are you up to, Cyno?","nextNodeIds":[230350404]},{"nodeId":230350404,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":927707530,"text":"#{NICKNAME}? I didn't expect to see you here.","nextNodeIds":[230350405]},{"nodeId":230350405,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":4254710474,"text":"I'm in the middle of trying to build a Genius Invokation deck with a relatively slow attack speed.","nextNodeIds":[230350406]},{"nodeId":230350406,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":3366813330,"text":"I'm hoping that the deck would allow the player to obtain an abundance of resources and plenty of powerful cards...","nextNodeIds":[230350407]},{"nodeId":230350407,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":3606674202,"text":"But to be honest, it's hard to build a deck like that...","nextNodeIds":[230350408]},{"nodeId":230350408,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":1601297634,"text":"Currently, in the Genius Invokation TCG community, some players prefer to use cards with fast attack speeds.","nextNodeIds":[230350409]},{"nodeId":230350409,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":2496315242,"text":"At the beginning of the game, they play a large number of cards in one go in order to swiftly defeat their opponent.","nextNodeIds":[230350410]},{"nodeId":230350410,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":2550347570,"text":"But I'm no fan of this tactic. I prefer to continuously accumulate resources in different ways...","nextNodeIds":[230350411]},{"nodeId":230350411,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":1411972634,"text":"Seizing every possible opportunity, building up my advantage, and eventually securing the victory...","nextNodeIds":[230350412]},{"nodeId":230350412,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2594627170,"text":"Yes, yes! Wonderful! You're just like the main character in my novel!","nextNodeIds":[230350413]},{"nodeId":230350413,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":1102980386,"text":"Sorry! Uh... I'm...","nextNodeIds":[230350414,230350415]},{"nodeId":230350414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2759456418,"text":"This is Fukumoto.","nextNodeIds":[230350416]},{"nodeId":230350415,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1341127866,"text":"This is the author of \"King of Invokations.\"","nextNodeIds":[230350416]},{"nodeId":230350416,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":4086520938,"text":"Hello, General Mahamatra. I don't suppose you've heard of me...","nextNodeIds":[230350417]},{"nodeId":230350417,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":1522758850,"text":"I've read your novel. It's very good.","nextNodeIds":[230350418]},{"nodeId":230350418,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2643941874,"text":"I'm truly honored!","nextNodeIds":[230350419]},{"nodeId":230350419,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":1985144930,"text":"In the novel, every time the protagonist is at a disadvantage, he always manages to get a card that wasn't in his deck through various means, then defeats his opponent. This left a lasting impression on me.","nextNodeIds":[230350420]},{"nodeId":230350420,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":3540017146,"text":"I understand that writing novels requires taking a creative license, but this way of winning is a departure from the fundamental mechanics of Genius Invokation TCG.","nextNodeIds":[230350421]},{"nodeId":230350421,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":2379221018,"text":"About that, well... Although I do play Genius Invokation TCG a lot, I'm not really good at it... And if you write about the duels with a competitive mindset, it wouldn't make for an interesting story.","nextNodeIds":[230350422]},{"nodeId":230350422,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":1071082522,"text":"Hmm, is that so? Well, as luck would have it, I've just built two decks of cards, so we can play a few rounds of Genius Invokation TCG here. Maybe you'll find some inspiration.","nextNodeIds":[230350423,230350424]},{"nodeId":230350423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3151422090,"text":"(Now they are about to play cards...)","nextNodeIds":[230350425]},{"nodeId":230350424,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":356604218,"text":"(This guy simply wants to play cards...)","nextNodeIds":[230350425]},{"nodeId":230350425,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":3574861746,"text":"Eh? Playing with... with you? I'd love to, but the truth is...","nextNodeIds":[230350426,230350427]},{"nodeId":230350426,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":26098370,"text":"I'll explain.","nextNodeIds":[]},{"nodeId":230350427,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2629247450,"text":"About Fukumoto's request...","nextNodeIds":[]},{"nodeId":230350428,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3546276378,"text":"You tell Cyno about Fukumoto's request...","nextNodeIds":[]},{"nodeId":230350429,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"Cyno","textMapHash":3033522498,"text":"You're asking me to model for the illustrations in \"King of Invokations\"? That's certainly no problem.","nextNodeIds":[230350430]},{"nodeId":230350430,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"Fukumoto","textMapHash":4121263770,"text":"Great! Traveler, quickly! Help me take some pictures!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1058"],"NOCCOBOFKHP":1074,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2303505,"order":5,"stepDescription":"Take some pictures of Cyno","stepDescTextMapHash":3914653348,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303505,0],"PAINLIBBLDK":"QU