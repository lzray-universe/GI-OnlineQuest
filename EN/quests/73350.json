{"mainQuestId":73350,"title":"Recollections of a Fontainian","description":"You encounter an anxious man from Fontaine in Sumeru City...","titleTextMapHash":4236405839,"descTextMapHash":3454689670,"mainQuestExcel":{"mainQuestId":73350,"titleTextMapHash":4236405839,"title":"Recollections of a Fontainian","descTextMapHash":3454689670,"description":"You encounter an anxious man from Fontaine in Sumeru City...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ73350","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":3454689670,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73350,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3886848809,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73350","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173350],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4236405839,"type":"WQ","unlockDescTextMapHash":3845793230}},"flow":[{"subQuestId":7335001,"order":1,"stepDescription":"Talk to Augustus","stepDescTextMapHash":1452460028,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7335005,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4456"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7335001,7335005],"talks":[{"talkId":7335001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7335001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7228724","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7335001,"initDialog":733500101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4456],"performCfg":"","priority":5,"questId":73350,"showRandomTalkCount":0},"dialogs":[{"nodeId":733500101,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3005114306,"text":"A-Achoo! The smell of these spices is just too... A-ACHOO!","nextNodeIds":[733500102]},{"nodeId":733500102,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":2144371962,"text":"I should just take a picture and go hide in my room...","nextNodeIds":[733500103]},{"nodeId":733500103,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1661055226,"text":"Traveler! Hey! Traveler! Hold on a second!","nextNodeIds":[733500104,733500105]},{"nodeId":733500104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3041555194,"text":"Who, me?","nextNodeIds":[733500106]},{"nodeId":733500106,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1638644154,"text":"I'd like your help with taking a picture, just one. It won't take long.","nextNodeIds":[733500109]},{"nodeId":733500109,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":4114130146,"text":"*sigh* It's embarrassing to admit, but the aroma of the spices here is a little too strong for me...","nextNodeIds":[733500110]},{"nodeId":733500110,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":993191634,"text":"During my time in Fontaine, I never had food with even just a hint of spiciness, a pinch of salt is as much as I can take.","nextNodeIds":[733500111]},{"nodeId":733500111,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":260444946,"text":"Here, I'm sneezing so much that— ACHOO! I can't even hold the Kamera steadily...","nextNodeIds":[733500112]},{"nodeId":733500112,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1632171594,"text":"So, all I can do... is ask someone else to take a photo for me.","nextNodeIds":[733500113]},{"nodeId":733500113,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3096478578,"text":"You certainly seem to be a kind person, so... I'd like to ask for your help.","nextNodeIds":[733500114]},{"nodeId":733500114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3330905866,"text":"You're from Fontaine?","nextNodeIds":[733500115]},{"nodeId":733500115,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3870354066,"text":"Indeed. I'm very sorry that I forgot to introduce myself...","nextNodeIds":[733500116]},{"nodeId":733500116,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1850981890,"text":"I'm Augustus Lovelace, a researcher from Fontaine Research Institute of Kinetic Energy Engineering.","nextNodeIds":[733500117,733500118]},{"nodeId":733500117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3648555338,"text":"Fontaine Research Institute of Kinetic Energy Engineering?","nextNodeIds":[733500119]},{"nodeId":733500119,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":2898315842,"text":"It's a mouthful, isn't it? You can call it the Fontaine Research Institute, as most people in Fontaine do.","nextNodeIds":[733500120]},{"nodeId":733500120,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3090723474,"text":"The Fontaine Research Institute used to be a paradise for researchers in Fontaine and where most mechanical creations originated.","nextNodeIds":[733500121]},{"nodeId":733500121,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3987228010,"text":"But thanks to Mr. Edwin, most buildings in the Fontaine Research Institute are lying in ruin now...","nextNodeIds":[733500122]},{"nodeId":733500122,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":4044131938,"text":"And ever since Raimondo and Mr. Choiseul took over the reconstruction project, the spirit of research at the institute has been in freefall.","nextNodeIds":[733500123]},{"nodeId":733500123,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":2129683146,"text":"I have standards and prefer a tidy environment. I refuse to live in a pile of rubble, and so I've been traveling around.","nextNodeIds":[733500124]},{"nodeId":733500124,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3225400882,"text":"Don't let my troubles spoil your mood, they have nothing to do with you.","nextNodeIds":[733500125]},{"nodeId":733500125,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":565937618,"text":"Come on, please hurry and snap a photo for me. Once Xavier sees the beauty of Sumeru, there's no way he'll stay in Inazuma!","nextNodeIds":[733500126]},{"nodeId":733500126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3500182554,"text":"About Xavier...","nextNodeIds":[733500127]},{"nodeId":733500127,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3369621058,"text":"Xavier is a researcher from the Fontaine Research Institute. We used to work in the same laboratory, and he once gave me quite a bit of help.","nextNodeIds":[733500128]},{"nodeId":733500128,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":4057475034,"text":"He insisted on shooting a film and being the director. That wasn't a very popular idea in Fontaine Research Institute at the time.","nextNodeIds":[733500129]},{"nodeId":733500129,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3195526930,"text":"Even after being assigned to other projects, he still continued shooting \"dokumentari films\" in the name of recording their research process.","nextNodeIds":[733500132]},{"nodeId":733500132,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1242486506,"text":"Just like that, he went back and forth between projects and the laboratory until he was finally sent to Inazuma...","nextNodeIds":[733500130]},{"nodeId":733500130,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":622219930,"text":"He's a very resourceful person. I'm certain that had he been born in the past, when funding was abundant and more fields of research were accepted, or been born in a brighter future, he would have accomplished great things...","nextNodeIds":[733500131]},{"nodeId":733500131,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":921268378,"text":"That's enough of that. Come and take a photo of me. Right here will do.","nextNodeIds":[]},{"nodeId":733500118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1662420978,"text":"What kind of place is that?","nextNodeIds":[733500119]},{"nodeId":733500105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2502576938,"text":"What can I do for you?","nextNodeIds":[733500106]}]},{"talkId":7335005,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNot