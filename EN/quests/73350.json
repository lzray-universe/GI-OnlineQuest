INIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4456"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7335003],"talks":[{"talkId":7335003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7335003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7335003,"initDialog":733500301,"nextRandomTalks":[],"nextTalks":[],"npcId":[4456],"performCfg":"","priority":5,"questId":73350,"showRandomTalkCount":0},"dialogs":[{"nodeId":733500301,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1256116666,"text":"Not bad indeed. You have a gift.","nextNodeIds":[733500302]},{"nodeId":733500302,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":635301314,"text":"It's the first time in my travels that I've met someone with such control over composition and color.","nextNodeIds":[733500303]},{"nodeId":733500303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2297669018,"text":"Where have your travels taken you?","nextNodeIds":[733500304]},{"nodeId":733500304,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":493108978,"text":"Ah, that, well... I could have come directly to Sumeru from Fontaine... after all, there's a line going straight to the Bayda Harbor in Sumeru.","nextNodeIds":[733500312]},{"nodeId":733500312,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":2614400770,"text":"But as they say, it's about the journey, not the destination. So I chose a... more interesting route.","nextNodeIds":[733500313]},{"nodeId":733500313,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":823115114,"text":"First, I went from Lumidouce Harbor to Chenyu Vale, and then passed through Qingce Village on my way to the Stone Gate that separates Mondstadt from Liyue.","nextNodeIds":[733500310]},{"nodeId":733500310,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3767356026,"text":"After stopping by Dawn Winery, I decided to head south and visit Liyue Harbor.","nextNodeIds":[733500305]},{"nodeId":733500305,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":2383429458,"text":"I embarked on a ferry to Port Ormos from Liyue Harbor, traveled northward along the river, and here I am standing before you.","nextNodeIds":[733500306]},{"nodeId":733500306,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":2862584890,"text":"After all, my goal is to relax. Were I a brave warrior with a passion for adventure...","nextNodeIds":[733500311]},{"nodeId":733500311,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":3771595458,"text":"...I might have decided to set out from Romaritime Harbor and followed the ancient path of the pilgrims, heading southward into the desert.","nextNodeIds":[733500307]},{"nodeId":733500307,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1654127882,"text":"Who knows? Maybe I'll try to cross the desert on the way back. Anyway, I've still got extra Mora to spend, and paying a visit to Natlan on the other side of the desert sounds nice too...","nextNodeIds":[733500308]},{"nodeId":733500308,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":1837668186,"text":"Alright, I won't keep you any longer. Thank you for helping me with the photo, please accept this as a token of my gratitude.","nextNodeIds":[733500309]},{"nodeId":733500309,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"Augustus Lovelace","textMapHash":4080936258,"text":"I'm off to write to Xavier. If he still won't come to Sumeru, then I might as well go back to Fontaine...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4456"],"NOCCOBOFKH