{"mainQuestId":72275,"title":"The Three Great Martial Trials","description":"Having heard Eboshi's introduction, you decide that it should be alright to head to the three corners of Enkanomiya to take part in the trials.","titleTextMapHash":2050852655,"descTextMapHash":534744278,"mainQuestExcel":{"mainQuestId":72275,"titleTextMapHash":2050852655,"title":"The Three Great Martial Trials","descTextMapHash":534744278,"description":"Having heard Eboshi's introduction, you decide that it should be alright to head to the three corners of Enkanomiya to take part in the trials.","chapterId":10059,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ72275","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":10059,"descTextMapHash":534744278,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72275,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3887242889,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72275","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172275],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2050852655,"type":"WQ","unlockDescTextMapHash":3045828502}},"flow":[{"subQuestId":7227501,"order":1,"stepDescription":"","stepDescTextMapHash":580943092,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7227501],"talks":[{"talkId":7227501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7227501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7227501,"initDialog":722750101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20341,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72275/Q7227501","priority":5,"questId":72275,"showRandomTalkCount":0},"dialogs":[{"nodeId":722750101,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1113887354,"text":"That I have appeared before you must mean that the Bloodbranch Coral is in Watatsumi's hands. And a most comforting thought that is.","nextNodeIds":[722750102]},{"nodeId":722750102,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":823589898,"text":"My name is Erebos. In the Inazuman tongue, that would be Eboshi. I am an auxiliary of Sangonomiya, one of the shrine maidens of Enkanomiya.","nextNodeIds":[722750103]},{"nodeId":722750103,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":4207984338,"text":"You must be the hero who obtained the coral, I suppose?","nextNodeIds":[722750104]},{"nodeId":722750104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":955596354,"text":"That would be me.","nextNodeIds":[722750105]},{"nodeId":722750105,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3492708546,"text":"My apologies, but that which I shall shortly speak of is a most complicated matter. In truth, I do not know where to begin.","nextNodeIds":[722750106]},{"nodeId":722750106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2360248490,"text":"Just start from the start! We'll listen!","nextNodeIds":[722750107]},{"nodeId":722750107,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3491936834,"text":"You have my gratitude. In that case, allow me to introduce such matters as I may to you. We must begin with Watatsumi Omikami opening the gate to the depths.","nextNodeIds":[722750108]},{"nodeId":722750108,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":4174620194,"text":"The depths of Enkanomiya play host to a natural cave system that leads to Watatsumi Island. This is the paradise that was promised to us by Watatsumi Omikami.","nextNodeIds":[722750109]},{"nodeId":722750109,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1274601586,"text":"At Omikami's instruction, we learned the culture of Narukami, and we established foreign relations with many different nations.","nextNodeIds":[722750110]},{"nodeId":722750110,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1923767466,"text":"Narukami Island even knew us as the \"beauties of Watatsumi,\" renowned for our soft skin, which would conceal seven types of skin blemish...","nextNodeIds":[722750111]},{"nodeId":722750111,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":4201826026,"text":"...This, of course, being mostly a consequence of our ancestors' lack of sunlight in the depths of Enkanomiya...","nextNodeIds":[722750112,722750113]},{"nodeId":722750112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3657608002,"text":"Uh, could we get to the point?","nextNodeIds":[722750114]},{"nodeId":722750114,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3973761898,"text":"Ah, sorry. During the process of establishing foreign relations, I would give guided tours to visitors in my role as a Sangonomiya auxiliary, so I just...","nextNodeIds":[722750115]},{"nodeId":722750115,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":826265714,"text":"Right. Back to the point. Lady Sangonomiya and I had a disagreement, which resulted in the current arrangement, following Watatsumi Omikami's mediation.","nextNodeIds":[722750116]},{"nodeId":722750116,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":269381962,"text":"Due to the phenomenon known as Sinshades, the \"past,\" \"history,\" and \"truth\" of Enkanomiya would endure even if left to their own devices.","nextNodeIds":[722750117]},{"nodeId":722750117,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1427333066,"text":"As such, great effort was expended, not that we might remember, but that we might \"forget.\" Lady Sangonomiya was of this view.","nextNodeIds":[722750118]},{"nodeId":722750118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1747347594,"text":"(The Sangonomiya she's talking about must've been from a real long time ago...)","nextNodeIds":[722750119]},{"nodeId":722750119,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1837523066,"text":"The trial to obtain the branch was intended to limit the number of people coming after us who could know the whole truth of the matter.","nextNodeIds":[722750120]},{"nodeId":722750120,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":169952522,"text":"As for me, I supported leaving records of the truth. As such, Watatsumi Omikami permitted me to add another trial path that, if passed, would lead to knowledge of our secrets.","nextNodeIds":[722750121]},{"nodeId":722750121,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1147897690,"text":"Please accept this challenge.","nextNodeIds":[722750122,722750123]},{"nodeId":722750122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2826523074,"text":"I accept your challenge.","nextNodeIds":[722750124]},{"nodeId":722750124,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3878634498,"text":"That is well. In that case, allow me to open that path for you.","nextNodeIds":[]},{"nodeId":722750123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1284206330,"text":"Oh, secrets. I like secrets.","nextNodeIds":[722750124]},{"nodeId":722750113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":999087410,"text":"This feels like old news. Could we get to the point?","nextNodeIds":[722750114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7227507,"order":2,"stepDescription":"","stepDescTextMapHash":246682476,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227507,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227507,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["5","121"],"PAINLIBBLDK":"QUEST_EXEC_ADD_SCENE_TAG"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE