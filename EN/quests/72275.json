_GUIDE_NONE"}}},{"subQuestId":7227506,"order":8,"stepDescription":"Talk to Eboshi","stepDescTextMapHash":1853315484,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["20341","11","2"],"NOCCOBOFKHP":5,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_SHOW_OR_HIDE_NPC"},"isHidden":false,"talkIds":[7227502],"talks":[{"talkId":7227502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7227506","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7227502,"initDialog":722750201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20341],"performCfg":"","priority":5,"questId":72275,"showRandomTalkCount":0},"dialogs":[{"nodeId":722750201,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":2688283874,"text":"Ah, you have been recognized by all the Jibashiri. They represent the will of Watatsumi, and so have you obtained the right to learn everything.","nextNodeIds":[722750202]},{"nodeId":722750202,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1402093674,"text":"You are the savior of the people of Watatsumi, and are one acknowledged by Watatsumi also. Thus, you have earned the right to ask and to be answered.","nextNodeIds":[722750203]},{"nodeId":722750203,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":2407644906,"text":"Still, I ask that you follow the rules and not take the truth beyond this ocean abyss.","nextNodeIds":[722750204]},{"nodeId":722750204,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":2713528890,"text":"What else do you wish to know?","nextNodeIds":[722750205,722750206,722750207,722750208,722750209]},{"nodeId":722750205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3614039186,"text":"Tell me about the Bathysmal Vishaps...","nextNodeIds":[722750210]},{"nodeId":722750210,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":4144132338,"text":"They are primordial elemental beings, unbent and unbowed by the power that came from the heavens owing to their living deep underwater.","nextNodeIds":[722750211]},{"nodeId":722750211,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1940622514,"text":"They are actually very intelligent, and they are adept at evolving. They would even evolve into different elemental forms throughout the history of their war against us.","nextNodeIds":[722750212]},{"nodeId":722750212,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":612884154,"text":"I would not be surprised at all if they have learned language or perhaps even evolved into lizard-people of a sort.","nextNodeIds":[722750213]},{"nodeId":722750213,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":929019386,"text":"The Holy Soil phenomenon is, in fact, the expansion of their habitat. That means that the primordial elemental power of the three realms is growing stronger.","nextNodeIds":[722750214]},{"nodeId":722750214,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1527416474,"text":"Only by using Watatsumi Omikami's life force to awaken its second servant could we convert this raw, raging elemental power.","nextNodeIds":[722750204]},{"nodeId":722750206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3725404210,"text":"Tell me about Watatsumi Omikami...","nextNodeIds":[722750215]},{"nodeId":722750215,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":826127170,"text":"Watatsumi Omikami, due to ill-fortune, fell into this place, beyond the jurisdiction of the heavenly order.","nextNodeIds":[722750216]},{"nodeId":722750216,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1403955194,"text":"This was undoubtedly to the good fortune of us, the people of Byakuyakoku. It has done a great many things for us.","nextNodeIds":[722750217]},{"nodeId":722750217,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3139090794,"text":"Unfortunately, by making contact with us, it also grasped a truth that came before its own existence. Thus, it was forced by heaven to sacrifice itself.","nextNodeIds":[722750218]},{"nodeId":722750218,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1033837434,"text":"The truth behind this sacrifice had to remain unknown to all. Only thus could the people of Byakuyakoku be allowed to live under the rule of The Seven.","nextNodeIds":[722750204]},{"nodeId":722750207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2392151866,"text":"So, what were things like before the sun and moon?","nextNodeIds":[722750219]},{"nodeId":722750219,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":890699938,"text":"Before Byakuyakoku fell into the deep sea, the whole world had a single unified culture.","nextNodeIds":[722750220]},{"nodeId":722750220,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":636993162,"text":"Later, a great war broke out, in which the heavens capsized and the earth was ripped asunder. This land was then plunged into the dark ocean depths.","nextNodeIds":[722750221]},{"nodeId":722750221,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":4073834458,"text":"However, the heavenly order seemed to not wish for those who remembered all this to remain on the earth. We searched and searched for a road of return, but there was none to be found.","nextNodeIds":[722750222]},{"nodeId":722750222,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3689325898,"text":"Much, much later, heaven's powers of prohibition would gradually weaken. Thus did Watatsumi Omikami manage to fall into this place.","nextNodeIds":[722750204]},{"nodeId":722750208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4267552946,"text":"Tell me about the Dainichi Mikoshi.","nextNodeIds":[722750223]},{"nodeId":722750223,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1937468786,"text":"The Dainichi Mikoshi was constructed by the Sage Abrax. It has the power to bring light to the dark depths.","nextNodeIds":[722750224]},{"nodeId":722750224,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1825335338,"text":"It has quite a few other functions, to boot.","nextNodeIds":[722750225]},{"nodeId":722750225,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3723495618,"text":"All in all, it is a very powerful device.","nextNodeIds":[722750204]},{"nodeId":722750209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1466376762,"text":"I've got nothing else to ask.","nextNodeIds":[722750226]},{"nodeId":722750226,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":386556218,"text":"Fair enough. Again, please remember to keep all that you have seen here in Enkanomiya an eternal secret.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7219816","2"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["20341","11","2"],"NOCCOBOFKHP":5,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_SHOW_OR_HIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7227501,7227502,7227503,7227504],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerNam