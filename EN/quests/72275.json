":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7227504,"initDialog":722750401,"nextRandomTalks":[],"nextTalks":[],"npcId":[20341,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72275/Q7227504","priority":5,"questId":72275,"showRandomTalkCount":0},"dialogs":[{"nodeId":722750401,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3016817794,"text":"The three trial areas have been prepared.","nextNodeIds":[722750402]},{"nodeId":722750402,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":797165730,"text":"Now, allow me to give you the clues to clearing them.","nextNodeIds":[722750403]},{"nodeId":722750403,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1551068754,"text":"Now, in this Evernight, gaze upon the borders of Byakuyakoku.","nextNodeIds":[722750404]},{"nodeId":722750404,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3861842090,"text":"\"In the faintness of everlasting night, beyond the rushing of the river Styx, within the sinless flow of heavenly light.\"","nextNodeIds":[722750405]},{"nodeId":722750405,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":4155856498,"text":"Release the seal on The Emanant Skylight. Then, you may ascend to the Gate of Heaven and access the site of the trial.","nextNodeIds":[722750406]},{"nodeId":722750406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":852088322,"text":"The Emanant Skylight?","nextNodeIds":[722750408]},{"nodeId":722750408,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":1899100418,"text":"At night, you can see three pillars of light that descend from the dome above. These pillars point unto The Emanant Skylight.","nextNodeIds":[722750410]},{"nodeId":722750410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2214485626,"text":"You're speaking in riddles!","nextNodeIds":[722750411]},{"nodeId":722750411,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":2156024482,"text":"Sorry, this is how the script written by Watatsumi Omikami reads. And I mean, aren't unclear instructions also part of the tradition of such trials?","nextNodeIds":[722750412]},{"nodeId":722750412,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3133721554,"text":"Whatever the case may be. All the Jibashiri at the trial area are weirdos. If you don't pass through the teleporter to get there, they won't speak gently to you.","nextNodeIds":[722750413]},{"nodeId":722750413,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"Eboshi","textMapHash":3332842154,"text":"Either way, I can only stay here and hope that you will conquer all the obstacles set before you, and that you will return crowned in recognition.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["16","1"],"PAINLIBBLDK":"QUEST_EXEC_CHANGE_MAP_AREA_STATE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[