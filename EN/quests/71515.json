{"mainQuestId":71515,"title":"A Few Words in the Foreground","description":"There's a performance going on at the North Wharf. Don't hesitate to come along if you're interested.","titleTextMapHash":421072983,"descTextMapHash":1492941654,"mainQuestExcel":{"mainQuestId":71515,"titleTextMapHash":421072983,"title":"A Few Words in the Foreground","descTextMapHash":1492941654,"description":"There's a performance going on at the North Wharf. Don't hesitate to come along if you're interested.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2019,"luaPath":"Actor/Quest/WQ71515","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2019,"chapterId":0,"descTextMapHash":1492941654,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71515,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2548715553,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71515","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171515],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":421072983,"type":"WQ","unlockDescTextMapHash":1745536974}},"flow":[{"subQuestId":7151501,"order":1,"stepDescription":"Go to the North Wharf","stepDescTextMapHash":430981300,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7151501_guide","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7151501],"talks":[{"talkId":7151501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7151501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7151501,"initDialog":715150101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30307],"performCfg":"QuestDialogue/WQ/SeaLampV3_71515/Q7151501","priority":5,"questId":71515,"showRandomTalkCount":0},"dialogs":[{"nodeId":715150101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3971943378,"text":"\"A performance going on at the North Wharf.\" Hmm... this notice is so vague. It doesn't say what the show is or who's gonna perform in it.","nextNodeIds":[715150102]},{"nodeId":715150102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1969934626,"text":"Paimon wonders where the location is. But if we can't find it, we could always ask people on the street.","nextNodeIds":[715150103]},{"nodeId":715150103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":575482338,"text":"There's a lot of people there.","nextNodeIds":[715150104]},{"nodeId":715150104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2956304770,"text":"Ah, Paimon also sees it. Whoa, so many people are gathered there, maybe just for the show!","nextNodeIds":[715150105]},{"nodeId":715150105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2768646290,"text":"Let's ask around.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7151501_guide","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7151502,"order":2,"stepDescription":"Ask passersby","stepDescTextMapHash":3830258388,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30308"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7151502],"talks":[{"talkId":7151502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7151502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7151502,"initDialog":715150201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30308],"performCfg":"QuestDialogue/WQ/SeaLampV3_71515/Q7151502","priority":5,"questId":71515,"showRandomTalkCount":0},"dialogs":[{"nodeId":715150201,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":1381449050,"text":"\"Fortune and health, peace and wealth...♪\"","nextNodeIds":[715150202]},{"nodeId":715150202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1639575754,"text":"Hello.","nextNodeIds":[715150203]},{"nodeId":715150203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1922307082,"text":"Is there going to be a performance here soon?","nextNodeIds":[715150204]},{"nodeId":715150204,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":1456088498,"text":"Yes, there's going to be a paper play. Are you guys here for it, too?","nextNodeIds":[715150205,715150206]},{"nodeId":715150205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4256857762,"text":"So this opera is called \"Paper Play.\"","nextNodeIds":[715150207]},{"nodeId":715150207,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":2813500874,"text":"No, paper plays and Liyue Operas are not the same thing...","nextNodeIds":[715150208]},{"nodeId":715150208,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":2974948242,"text":"Qingxing! The show is about to begin. Be quiet, or you'll affect the performance.","nextNodeIds":[715150209]},{"nodeId":715150209,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":1674373042,"text":"Sorry! As for the paper play, you'll know it when you see it.","nextNodeIds":[715150210]},{"nodeId":715150210,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3690661058,"text":"Honored guests, we will be performing \"Bravebeard\" today.","nextNodeIds":[715150211]},{"nodeId":715150211,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1981161378,"text":"Before the show, if you want to head to the restroom, or grab a beverage, now's a good time. We will wait for no one when the show begins.","nextNodeIds":[715150212]},{"nodeId":715150212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3550661114,"text":"(So this performance is actually called \"Bravebeard.\" But Paimon has never heard of this story.)","nextNodeIds":[715150213]},{"nodeId":715150213,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":2037573490,"text":"Shh! We can still hear you even at a whisper. Keep it down. You can talk during intermission-selection.","nextNodeIds":[715150214]},{"nodeId":715150214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":485913234,"text":"Uh... sorry.","nextNodeIds":[715150215]},{"nodeId":715150215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":899119602,"text":"Intermission-selection?","nextNodeIds":[715150216]},{"nodeId":715150216,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":2902928450,"text":"The story of the Bravebeard is quite long. In fact, it'd be too long to do it all in one go, so Yinggong will let the audience pick which scene they want to see during an intermission...","nextNodeIds":[715150217]},{"nodeId":715150217,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":1226363466,"text":"Qingxing! I'm trying to listen to the play!","nextNodeIds":[715150218]},{"nodeId":715150218,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":328984458,"text":"Oh, I won't butt in anymore, I promise.","nextNodeIds":[715150219]},{"nodeId":715150219,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1746868314,"text":"...so, dear guests, what part of the Bravebeard's story would you like to see today?","nextNodeIds":[715150220]},{"nodeId":715150220,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3932893482,"text":"Would you like to see \"Mountain-Bound\" or \"Worshiping Adepti\"? Maybe \"Exorcising Demons\"? Or \"Ascension\"?","nextNodeIds":[715150221]},{"nodeId":715150221,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2811220098,"text":"As long as you can name it, I can perform it!","nextNodeIds":[715150222]},{"nodeId":715150222,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":3460413554,"text":"I want to see the Bravebeard fight monsters! He is so handsome and wins every time.","nextNodeIds":[715150223]},{"nodeId":715150223,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":367803066,"text":"You've seen \"Worshiping Adepti\" and \"Exorcising Demons\" so many times already. Haven't you got tired of it? I want to see the part where the Bravebeard goes home to see his sister.","nextNodeIds":[715150224]},{"nodeId":715150224,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":389930546,"text":"The Bravebeard has a sister? How have I not heard of this? I definitely haven't seen that before.","nextNodeIds":[715150225]},{"nodeId":715150225,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1034494266,"text":"How impressive! Not many people would request \"Homecoming.\" After all, only the real fans know about it.","nextNodeIds":[715150226]},{"nodeId":715150226,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2384800306,"text":"Alright, just in time for Lantern Rite, we will not perform the plots featuring monsters. We shall spin a tale of how lovers end up together.","nextNodeIds":[715150227]},{"nodeId":715150227,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1250559218,"text":"There are three characters who shall appear in this scene. Aside from our Bravebeard, with whom you are familiar, of course. There is also a lonely girl named Yibing and an honest gentleman named Nanfeng.","nextNodeIds":[715150228]},{"nodeId":715150228,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2501711050,"text":"#Do you understand any of this, {NICKNAME}? Paimon's still confused...","nextNodeIds":[715150229]},{"nodeId":715150229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2001895074,"text":"So this is a story about a guy called the \"Bravebeard,\" right? It looks like there's a lot of supporting characters as well.","nextNodeIds":[715150230]},{"nodeId":715150230,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1932701370,"text":"But so far there's only one performer on stage. Uh, and there's a... folding screen? How's it gonna work?","nextNodeIds":[715150231]},{"nodeId":715150231,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":1986778442,"text":"Hey, someone here has never seen a paper play before.","nextNodeIds":[715150232]},{"nodeId":715150232,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2011719914,"text":"Eh? Someone in the back asked how I, a lone performer, can be in different places at once and make this performance work?","nextNodeIds":[715150233]},{"nodeId":715150233,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3341883722,"text":"Well, our paper plays may not be as exquisite as Liyue Operas, but we certainly have our own distinctive flavors.","nextNodeIds":[715150234]},{"nodeId":715150234,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":687980298,"text":"As you may know, the characters in Liyue Operas are portrayed by real people in the flesh, the actors in our performances, however, are portrayed with paper figures pasted on silk.","nextNodeIds":[715150235]},{"nodeId":715150235,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2706748402,"text":"And Liyue Operas take place on a large wooden stage, the stage for our performances, however, is but a paper screen on a wooden shelf. Our actors and stages are all made of paper, that's why we call it a paper play!","nextNodeIds":[715150236]},{"nodeId":715150236,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":945378682,"text":"I am the narrator, but I am no actor. You will meet the three paper actors in just a moment.","nextNodeIds":[715150237]},{"nodeId":715150237,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":1596536930,"text":"Yinggong, I don't think they know about the Bravebeard either. Would it be okay if you introduce them to his story? You know, the one you always start with...","nextNodeIds":[715150238]},{"nodeId":715150238,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":900134610,"text":"That's called the establishing moment. I've always enjoyed that, too. Please perform it for us, Yinggong.","nextNodeIds":[715150239]},{"nodeId":715150239,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":2712502594,"text":"Establishing moment! Establishing moment!","nextNodeIds":[715150240]},{"nodeId":715150240,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1671420234,"text":"It is said that the sky's the limit, but the woes of the world are also limitless.","nextNodeIds":[715150241]},{"nodeId":715150241,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3218235434,"text":"There was once a man named Huanguang, suffering from human injustice, who resorted to dwelling amongst the mountains and rivers.","nextNodeIds":[715150242]},{"nodeId":715150242,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1930190818,"text":"By chance, he became a disciple of an adeptus, changed his appearance, and grew a black beard. Thus, he is known as the \"Bravebeard.\"","nextNodeIds":[715150243]},{"nodeId":715150243,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1143776658,"text":"At the behest of the adeptus, he struck down monsters and scared off demons with his sword.","nextNodeIds":[715150244]},{"nodeId":715150244,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1109182794,"text":"The Bravebeard trained for many years and finally acquired the philosophy of the adeptus. Right before he returned to the adeptal abode, he was summoned to recall the past.","nextNodeIds":[715150245]},{"nodeId":715150245,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":4281685210,"text":"It turned out that he still had an attachment to the common folk's society, where he had a sister at home. The poor sister, Yibing, was now alone and helpless.","nextNodeIds":[715150246]},{"nodeId":715150246,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2572234010,"text":"She thought that her brother had lived a miserable life, and never imagined that he would return home. As to what happened next...","nextNodeIds":[715150247]},{"nodeId":715150247,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":212725522,"text":"I shall show you, right away!","nextNodeIds":[715150248]},{"nodeId":715150248,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":2510867058,"text":"Hey, don't just stand there. Clap!","nextNodeIds":[715150249,715150250]},{"nodeId":715150249,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3325888762,"text":"Bravo!","nextNodeIds":[715150251]},{"nodeId":715150251,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3707555882,"text":"I—Is there a rule about when we should clap? Ah, okay!","nextNodeIds":[715150252]},{"nodeId":715150252,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2705152794,"text":"Thank you all. We are supposed to continue the show, but I can tell that these two guests are still a little perplexed.","nextNodeIds":[715150253]},{"nodeId":715150253,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":2239656378,"text":"I think it would be better if I ask these two to volunteer from the audience by coming forward and assisting me in directing the scene.","nextNodeIds":[715150254]},{"nodeId":715150254,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":1678533842,"text":"It will give you both a good look, and it will help the actors move forward on this stage. What do you think?","nextNodeIds":[715150255]},{"nodeId":715150255,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","textMapHash":4033107338,"text":"Hey, why didn't you invite me? I know all about paper plays! You gotta remember to invite me, you just gotta!","nextNodeIds":[715150256]},{"nodeId":715150256,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","textMapHash":2408220154,"text":"You have been up there too many times already. Quit making a fuss and enjoy the show!","nextNodeIds":[715150257]},{"nodeId":715150257,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3710897770,"text":"That's fine by me.","nextNodeIds":[715150258]},{"nodeId":715150258,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4211036362,"text":"Help direct the scene? That sounds so novel. It's also fine by Paimon!","nextNodeIds":[715150259]},{"nodeId":715150259,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","textMapHash":3609484938,"text":"Then I shall ask you two to prepare. As soon as you two are in position, the performance will begin.","nextNodeIds":[]},{"nodeId":715150250,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":591822914,"text":"(Clap along)","nextNodeIds":[715150251]},{"nodeId":715150206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3726174874,"text":"Is it a Liyue Opera?","nextNodeIds":[715150207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30308"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7151501,7151502],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"Yinggong","count":25},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"Qingxing","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"Hesheng","count":9}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171515],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1492941654,"CHECNJEMEFE":{"30