{"mainQuestId":70046,"title":"A Very Fishy Encounter","description":"In waters south of Lumidouce Harbor, you encounter a rather peculiar individual who calls herself an \"Unchained Hunter.\" She's currently in the midst of doing everything she can to contain an impending ecological crisis...","titleTextMapHash":700181343,"descTextMapHash":2503710502,"mainQuestExcel":{"mainQuestId":70046,"titleTextMapHash":700181343,"title":"A Very Fishy Encounter","descTextMapHash":2503710502,"description":"In waters south of Lumidouce Harbor, you encounter a rather peculiar individual who calls herself an \"Unchained Hunter.\" She's currently in the midst of doing everything she can to contain an impending ecological crisis...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5251,"luaPath":"Actor/Quest/WQ70046","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5251,"chapterId":0,"descTextMapHash":2503710502,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70046,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2686162185,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70046","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170046],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":700181343,"type":"WQ","unlockDescTextMapHash":43235630}},"flow":[{"subQuestId":7004601,"order":1,"stepDescription":"Talk to the strange fisherman","stepDescTextMapHash":2989854676,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7004601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30773"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7004601],"talks":[{"talkId":7004601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7004601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7004601,"initDialog":700460101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30773],"performCfg":"QuestDialogue/WQ/FishingJoy_70046/Q7004601","priority":5,"questId":70046,"showRandomTalkCount":0},"dialogs":[{"nodeId":700460101,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":1612615066,"text":"Perfect, it looks like I'm all set...","nextNodeIds":[700460102]},{"nodeId":700460102,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":55516322,"text":"Put your back into it, Jala! You'll round 'em all up in a few days!","nextNodeIds":[700460103,700460104]},{"nodeId":700460103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3742811538,"text":"R—Round up?","nextNodeIds":[700460105]},{"nodeId":700460105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3564764794,"text":"Eek! A poacher in Fontaine... Does animal trafficking make so much money nowadays?","nextNodeIds":[700460106]},{"nodeId":700460106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1330600298,"text":"Not on Paimon's watch! You're coming to the Maison Gardiennage with us!","nextNodeIds":[700460107]},{"nodeId":700460107,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":2438766754,"text":"...Huh. It's you two.","nextNodeIds":[700460108]},{"nodeId":700460108,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":2102157538,"text":"Well, sure. I just came from the Maison, in fact. Need me to show you the way?","nextNodeIds":[700460109]},{"nodeId":700460109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3056367354,"text":"?","nextNodeIds":[700460110,700460112]},{"nodeId":700460110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1887611634,"text":"Good. I like straightforward people!","nextNodeIds":[700460111]},{"nodeId":700460111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3724561114,"text":"Wait, something's not right... You're not scared by the thought of being arrested at all. You must be a regular offender... Or maybe...","nextNodeIds":[700460114]},{"nodeId":700460114,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":1269660098,"text":"I could be standing on the right side of the law, eh?","nextNodeIds":[700460115]},{"nodeId":700460115,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":3074224026,"text":"More accurately, the Maison has hired me as a special environmental protection consultant — an \"Unchained Hunter.\"","nextNodeIds":[700460116]},{"nodeId":700460116,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":3449025274,"text":"Specifically, I'm hunting invasive species of fish that have made their way into Fontaine's waters.","nextNodeIds":[700460117]},{"nodeId":700460117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":560350162,"text":"Invasive... species?","nextNodeIds":[700460118,700460120]},{"nodeId":700460118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1606571442,"text":"That sounds familiar.","nextNodeIds":[700460119]},{"nodeId":700460119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3548747858,"text":"Right! Paimon thinks we heard about something like that back in Mondstadt...","nextNodeIds":[700460122]},{"nodeId":700460122,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":1809566290,"text":"Well, let's not dwell on the past. What matters is the here and now.","nextNodeIds":[700460123]},{"nodeId":700460123,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":2605872106,"text":"These invasive species were let loose by some merchants who hold strange beliefs.","nextNodeIds":[700460124]},{"nodeId":700460124,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":3802545818,"text":"Some of the fish are extremely aggressive, others reproduce incredibly fast, and others were raised on special feed. All told, they're a huge problem for all the local aquatic life.","nextNodeIds":[700460125]},{"nodeId":700460125,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":443023314,"text":"If these fish occupy the habitats of local creatures and mess up the ecosystem, Fontaine's water quality might be affected.","nextNodeIds":[700460126]},{"nodeId":700460126,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":2858838786,"text":"The impact on Fontainians' health might be something we'd only feel in the future. But the flavor of a drink like Fonta could change instantly, and that'll spell untold trouble for the economy.","nextNodeIds":[700460127,700460128]},{"nodeId":700460127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":170678954,"text":"Fonta shall not fall! Not today!","nextNodeIds":[700460129]},{"nodeId":700460129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":321176834,"text":"All this understatement makes the problem sound worse! We can't just sit back and do nothing!","nextNodeIds":[700460130]},{"nodeId":700460130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2907654618,"text":"Now, we're old hands at catching fish, so why don't we help you out?","nextNodeIds":[700460131]},{"nodeId":700460131,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":168542410,"text":"Yes! I've been waiting for you to say that!","nextNodeIds":[700460132]},{"nodeId":700460132,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":2454757474,"text":"I've already set up a capture zone into which we can lure all those invasive fish using bait...","nextNodeIds":[700460133]},{"nodeId":700460133,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":195902162,"text":"So it's time to strut your stuff, Honorary Knight and Helper in White! As for me, I'll support you from the rear!","nextNodeIds":[700460134]},{"nodeId":700460134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3536218202,"text":"Is it just Paimon, or does she... understand us really well?","nextNodeIds":[]},{"nodeId":700460128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3734462154,"text":"I don't really drink Fonta, but I understand its importance.","nextNodeIds":[700460129]},{"nodeId":700460120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":426528922,"text":"What's that?","nextNodeIds":[700460121]},{"nodeId":700460121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1286665242,"text":"Paimon's memory is fuzzy, but we heard about something like that in Mondstadt ages ago, she's sure of it...","nextNodeIds":[700460122]},{"nodeId":700460112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2118010146,"text":"Maybe... there's been a misunderstanding?","nextNodeIds":[700460113]},{"nodeId":700460113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3614193234,"text":"True. She's not scared by the thought of being arrested at all. She must be a regular offender... Or maybe...","nextNodeIds":[700460114]},{"nodeId":700460104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3685953602,"text":"A p—poacher?","nextNodeIds":[700460105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7004601,0],"PAINLIBBLD