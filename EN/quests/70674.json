{"mainQuestId":70674,"title":"Divine Ingenuity: Collector's Chapter","description":"You once again encounter Honglang in the outskirts of Mondstadt. He appears to still be investigating that strange Domain...","titleTextMapHash":252999167,"descTextMapHash":663224662,"mainQuestExcel":{"mainQuestId":70674,"titleTextMapHash":252999167,"title":"Divine Ingenuity: Collector's Chapter","descTextMapHash":663224662,"description":"You once again encounter Honglang in the outskirts of Mondstadt. He appears to still be investigating that strange Domain...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5133,"luaPath":"Actor/Quest/WQ70674","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5133,"chapterId":0,"descTextMapHash":663224662,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70674,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4105139793,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70674","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170674],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":252999167,"type":"WQ","unlockDescTextMapHash":811325270}},"flow":[{"subQuestId":7067401,"order":1,"stepDescription":"Talk to Honglang","stepDescTextMapHash":417731540,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30153"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7067401],"talks":[{"talkId":7067401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7067401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067401,"initDialog":706740101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30153],"performCfg":"","priority":5,"questId":70674,"showRandomTalkCount":0},"dialogs":[{"nodeId":706740101,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":4044708114,"text":"Why is it in Mondstadt this time...","nextNodeIds":[706740102,706740103]},{"nodeId":706740102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1321104658,"text":"Honglang?","nextNodeIds":[706740104]},{"nodeId":706740104,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2754312882,"text":"Traveler? What a coincidence! I didn't expect you to be here...","nextNodeIds":[706740105]},{"nodeId":706740105,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2992605882,"text":"As for the present situation... Well, just look at this door next to me. I suppose you already understand.","nextNodeIds":[706740106,706740107]},{"nodeId":706740106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":334960586,"text":"So a Domain of that kind has appeared again?","nextNodeIds":[706740108]},{"nodeId":706740108,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3814674402,"text":"That's right. Thanks to your help in investigating that other Domain, we were able to obtain all manner of important data.","nextNodeIds":[706740109]},{"nodeId":706740109,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":564814210,"text":"However, there wasn't any way of getting more useful information on that Domain from the outside. Not for lack of trying by the Guild, but still.","nextNodeIds":[706740110]},{"nodeId":706740110,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1603979362,"text":"As such, we were getting ready to send more people into it. We'd even called people from other Guilds in... but then it vanished.","nextNodeIds":[706740111]},{"nodeId":706740111,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3328403642,"text":"And that was the last we heard of it until it showed up today in Mondstadt. I only got here in time thanks to timely notice from our colleagues in Mondstadt.","nextNodeIds":[706740112]},{"nodeId":706740112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":202551458,"text":"Have you started exploring it?","nextNodeIds":[706740113]},{"nodeId":706740113,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":990303378,"text":"Of course. Why would I fall back with the prize before me?","nextNodeIds":[706740114]},{"nodeId":706740114,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1326549250,"text":"The rules of this Domain haven't changed a great deal. It still creates various things based on the imaginations of those who enter it.","nextNodeIds":[706740115]},{"nodeId":706740115,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2835851986,"text":"But as we plumbed its depths, we found that this Domain is now able to create certain \"enemies.\"","nextNodeIds":[706740116]},{"nodeId":706740116,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":854752522,"text":"They would attack us, and we actually felt real pain when they did.","nextNodeIds":[706740117]},{"nodeId":706740117,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3466970530,"text":"How should I put this... It was no different from a real battle, which the other adventurers found rather interesting.","nextNodeIds":[706740118]},{"nodeId":706740118,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1958852194,"text":"However, some of them conjured foes they could not beat, and wound up needing help to beat them...","nextNodeIds":[706740119]},{"nodeId":706740119,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":315575170,"text":"*cough* But never mind that. If you're willing, Traveler, could you explore this Domain together with us once again?","nextNodeIds":[706740120,706740122]},{"nodeId":706740120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1719189818,"text":"No problem.","nextNodeIds":[706740121]},{"nodeId":706740121,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3677906042,"text":"Hahaha, wonderful, then! With your help, I'm sure that progress will be smooth indeed.","nextNodeIds":[]},{"nodeId":706740122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":247125722,"text":"It won't be too dangerous, will it...","nextNodeIds":[706740123]},{"nodeId":706740123,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2738815938,"text":"Um, I reckon you'll be fine. Just be cautious!","nextNodeIds":[706740124]},{"nodeId":706740124,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3589135394,"text":"Regardless, if you're willing to explore this Domain with us, I'm sure that progress will be smooth indeed.","nextNodeIds":[]},{"nodeId":706740107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3112788746,"text":"Is this the same sort of Domain as that other one you were investigating?","nextNodeIds":[706740108]},{"nodeId":706740103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2492312586,"text":"This is...","nextNodeIds":[706740104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_