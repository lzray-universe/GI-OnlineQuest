,"id":7370001,"initDialog":737000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4284],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7370001","priority":5,"questId":73700,"showRandomTalkCount":0},"dialogs":[{"nodeId":737000101,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1518682538,"text":"Without knowing, the training has progressed to its latter half. How are things going?","nextNodeIds":[737000102,737000103]},{"nodeId":737000102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2441691874,"text":"You can say we're hitting our stride.","nextNodeIds":[737000104]},{"nodeId":737000104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2944661546,"text":"Though when Sorush tells us stories, there really seems to be some self-reflection happening...","nextNodeIds":[737000105]},{"nodeId":737000105,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":4198108890,"text":"Dialogue is a good way for Sorush to learn, especially as the people she's talking to are more interesting than those of the Order of Skeptics.","nextNodeIds":[737000106]},{"nodeId":737000106,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3410619818,"text":"#Elder, you are being arbitrary... {NICKNAME} is a remarkable Yasnapati, but not all of the Order of Skeptics's members are...","nextNodeIds":[737000107]},{"nodeId":737000107,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2611248050,"text":"Perhaps they do have momentary instances of virtue between sessions of flattery and deception.","nextNodeIds":[737000108]},{"nodeId":737000108,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3395573810,"text":"Ugh...","nextNodeIds":[737000109]},{"nodeId":737000109,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":3049802010,"text":"#I see you still need convincing. We will let our witnesses, {NICKNAME} and Paimon, give a review regarding your performance. Of course, that is after you finish your recounting.","nextNodeIds":[]},{"nodeId":737000103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1075498810,"text":"There's still some room for improvement.","nextNodeIds":[737000104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7370002,"order":6,"stepDescription":"Head to the specified location and complete the trial","stepDescTextMapHash":385703788,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7370002"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7370002_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7370002"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDIC