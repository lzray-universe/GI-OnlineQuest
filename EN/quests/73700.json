{"mainQuestId":73700,"title":"The Recollector's Path","description":"After speaking of Mihir and the Oceanids, Sorush seemed to be at a loss. Zurvan's training has now progressed beyond its midpoint...\\n","titleTextMapHash":2837429423,"descTextMapHash":904683118,"mainQuestExcel":{"mainQuestId":73700,"titleTextMapHash":2837429423,"title":"The Recollector's Path","descTextMapHash":904683118,"description":"After speaking of Mihir and the Oceanids, Sorush seemed to be at a loss. Zurvan's training has now progressed beyond its midpoint...\\n","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5132,"luaPath":"Actor/Quest/WQ73700","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5132,"chapterId":0,"descTextMapHash":904683118,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73700,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":510968969,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73700","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173700],"series":73697,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[73701],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2837429423,"type":"WQ","unlockDescTextMapHash":383539054}},"flow":[{"subQuestId":7370001,"order":5,"stepDescription":"Talk to Zurvan","stepDescTextMapHash":4187807692,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE