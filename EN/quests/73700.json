IFY","PPFLKMOMKAI":"7370005"}],"triggerCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"737000501"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7370006,"order":10,"stepDescription":"Talk to Sorush","stepDescTextMapHash":3286216372,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370006,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7370006_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7370006],"talks":[{"talkId":7370006,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7370006","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370006,"initDialog":737000601,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7370006","priority":5,"questId":73700,"showRandomTalkCount":0},"dialogs":[{"nodeId":737000601,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1996814290,"text":"It's so quiet. No one's here.","nextNodeIds":[737000602]},{"nodeId":737000602,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3782890458,"text":"Even if Rashnu was here, it should still be quite quiet...","nextNodeIds":[737000603]},{"nodeId":737000603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2485706306,"text":"Yeah, but if she was here, we would need to talk softer. She always has that sleepy look on her face, and she didn't seem too happy when we woke her using the Kory Drums.","nextNodeIds":[737000604]},{"nodeId":737000604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3898012386,"text":"Paimon heard that the quieter someone is, the worse it gets when they get angry. Who knows what Rashnu is like when she's enraged...","nextNodeIds":[737000605]},{"nodeId":737000605,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2493694610,"text":"Then, should that be true, my Yasnapati is the one we should fear the most, yes?","nextNodeIds":[737000606]},{"nodeId":737000606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3469568002,"text":"#Huh? Oh, Paimon knows {M#him}{F#her} the best. Though {NICKNAME} isn't one for talking, {M#he}{F#she} is still super nice. Right?","nextNodeIds":[737000607,737000609]},{"nodeId":737000607,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":72672338,"text":"I am about to get mad for real. Rawr.","nextNodeIds":[737000608]},{"nodeId":737000608,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":338430874,"text":"See. Not scary at all.","nextNodeIds":[737000611]},{"nodeId":737000611,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1207589226,"text":"Very well. Let us refocus.","nextNodeIds":[737000612]},{"nodeId":737000612,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3572510474,"text":"As you behold, this tree is called Barsom, and Rashnu is its familiar, though she is absent right now.","nextNodeIds":[737000613]},{"nodeId":737000613,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":806555930,"text":"And?","nextNodeIds":[737000614]},{"nodeId":737000614,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1842673930,"text":"And? And nothing. There's nothing more to say of Rashnu and the Barsom.","nextNodeIds":[737000615]},{"nodeId":737000615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4085563674,"text":"Feels like you are hiding something... Right, about the Kory Drums...","nextNodeIds":[737000616]},{"nodeId":737000616,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2527608266,"text":"H—Hiding? Absurd. As for the drums... Haven't you already seen them in use?","nextNodeIds":[737000617]},{"nodeId":737000617,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2111386834,"text":"Speaking of which, Paimon remembers Rashnu saying that she's the one who threw the Kory Drums elsewhere. That really surprised Nasejuna.","nextNodeIds":[737000618]},{"nodeId":737000618,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":578541842,"text":"If Paimon recalls, you were really nervous then, and didn't respond to Nasejuna's questioning.","nextNodeIds":[737000619]},{"nodeId":737000619,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1299699778,"text":"The way it looks now, the Order of Skeptics's archives were reaaallly off the mark.","nextNodeIds":[737000620]},{"nodeId":737000620,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3681789994,"text":"Though playing the drums did wake Rashnu.","nextNodeIds":[737000621]},{"nodeId":737000621,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1109985642,"text":"Paimon seems to understand why Zurvan doesn't trust the current Order of Skeptics. Think, Sorush. Did they really help? The clues they gave are half-truths at best...","nextNodeIds":[737000622]},{"nodeId":737000622,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":301766690,"text":"Umm...","nextNodeIds":[737000623]},{"nodeId":737000623,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1857164138,"text":"The current generation of the Order of Skeptics indeed does have some lacking members, but like a tree, no matter how many leaves flourish, there will always be some that will shrivel and dry.","nextNodeIds":[737000624]},{"nodeId":737000624,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2761566466,"text":"Once these dry leaves break and scatter, those that will remain... They will be the ones that can be relied upon... Yes.","nextNodeIds":[737000625]},{"nodeId":737000625,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":51779186,"text":"...How did the Order of Skeptics become like this?","nextNodeIds":[737000626]},{"nodeId":737000626,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1067116250,"text":"I also want to know that.","nextNodeIds":[737000627]},{"nodeId":737000627,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3988114938,"text":"It is because I have been with the Order of Skeptics too long that I grew unable to discern their gradual changes...","nextNodeIds":[737000628]},{"nodeId":737000628,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2648244090,"text":"Only when I began to speak with you and other outsiders did I realize the Order of Skeptics had changed.","nextNodeIds":[737000629]},{"nodeId":737000629,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3457618018,"text":"It has been a few hundred years. Besides their name being the same, they must've cycled through a few generations of different members already.","nextNodeIds":[737000630]},{"nodeId":737000630,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3140754914,"text":"Will the fame I seek, the fame I wish for the Yasnapati to eulogize for me, also erode into this... with everything changed, carrying only a hollow title for others to recall?","nextNodeIds":[737000631]},{"nodeId":737000631,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2666207210,"text":"Is that what my elder wishes that I learn? No, it shouldn't be... But...","nextNodeIds":[737000632]},{"nodeId":737000632,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2854574482,"text":"...Sorush, there's no need to be down! Maybe... Maybe Zurvan didn't mean that...","nextNodeIds":[737000633]},{"nodeId":737000633,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2379895410,"text":"Seeing Sorush so depressed makes Paimon feel like she did something wrong... Maybe we should have Zurvan cheer her up.","nextNodeIds":[]},{"nodeId":737000609,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2584576626,"text":"...","nextNodeIds":[737000610]},{"nodeId":737000610,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1977997138,"text":"#...Okay, {NICKNAME}, you gotta say something! The silence IS actually making Paimon nervous...","nextNodeIds":[737000611]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370006,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7370006_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7370001,7370006],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMM