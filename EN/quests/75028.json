alse,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7502807","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7502801,"initDialog":750280101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21564],"performCfg":"QuestDialogue/WQ/Natlan_75028/Q7502801","priority":5,"questId":75028,"showRandomTalkCount":0},"dialogs":[{"nodeId":750280101,"roleType":"TALK_ROLE_NPC","speakerId":21564,"speakerName":"Mouse","textMapHash":2015827362,"text":"Ugh, you're... tougher than you look...","nextNodeIds":[750280102]},{"nodeId":750280102,"roleType":"TALK_ROLE_NPC","speakerId":21565,"speakerName":"Night Owl","textMapHash":1562190610,"text":"Gah. Who did we offend... Who'd send someone on this day, of all days, to come whack us...","nextNodeIds":[750280103]},{"nodeId":750280103,"roleType":"TALK_ROLE_NPC","speakerId":21565,"speakerName":"Night Owl","textMapHash":3469655250,"text":"#Please, {M#Big Bro}{F#Big Sis}. How have we offended you? Just... let us know. We won't do it again.","nextNodeIds":[750280104]},{"nodeId":750280104,"roleType":"TALK_ROLE_NPC","speakerId":21564,"speakerName":"Mouse","textMapHash":727017626,"text":"Hey, you little rascal! You're really gonna grovel before this piece of work?","nextNodeIds":[750280105]},{"nodeId":750280105,"roleType":"TALK_ROLE_NPC","speakerId":21565,"speakerName":"Night Owl","textMapHash":741131802,"text":"You think talking tough's going to make us a living? I can see it now, I tell you. We're just living like thieves and crooks. There's nothing special about trafficking Saurians, is there?","nextNodeIds":[750280106]},{"nodeId":750280106,"roleType":"TALK_ROLE_NPC","speakerId":21565,"speakerName":"Night Owl","textMapHash":3034902458,"text":"If the only alternative's being robbed by a stronger crook, why shouldn't I go with them instead?","nextNodeIds":[750280107]},{"nodeId":750280107,"roleType":"TALK_ROLE_NPC","speakerId":21565,"speakerName":"Night Owl","textMapHash":4169549234,"text":"#And not to brag, {M#Big Bro}{F#Big Sis}, but I'm sure I'd be way more useful to you than these two. Just call me if you need anything. I'll settle it, nice and clean.","nextNodeIds":[750280108]},{"nodeId":750280108,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":488070154,"text":"Hmm?","nextNodeIds":[750280109,750280111]},{"nodeId":750280109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1796246090,"text":"Well, I do happen to be shopping about for a sidekick.","nextNodeIds":[750280110]},{"nodeId":750280110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2994300090,"text":"Are you serious!? No way! Paimon vetoes this motion!","nextNodeIds":[750280112]},{"nodeId":750280112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1350248346,"text":"Also, you're a bunch of bad eggs anyway! No way good guys like us would team up with Saurian traffickers like you!","nextNodeIds":[750280113,750280114]},{"nodeId":750280113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1832358090,"text":"Yup, there's no one good-er than me.","nextNodeIds":[750280117]},{"nodeId":750280117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4028250498,"text":"#Ahem! Anyway, whatever designs you have on the Saurians, better stop now, or we'll... Well, {NICKNAME} will show you what's what.","nextNodeIds":[750280118]},{"nodeId":750280118,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1866978970,"text":"Rawr!","nextNodeIds":[750280119]},{"nodeId":750280119,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3726590186,"text":"The two traffickers leave amidst a cloud of resentment...","nextNodeIds":[750280120]},{"nodeId":750280120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3905977242,"text":"Paimon wonders how that Qucusaurus is doing. Shall we go see to it?","nextNodeIds":[]},{"nodeId":750280114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3958169738,"text":"Well, there's always room for accommodation.","nextNodeIds":[750280115]},{"nodeId":750280115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2608974834,"text":"#Hey, you're gonna be a bad influence on {REALNAME[ID(2)|SHOWHOST(true)]}! Don't worry, little guy, there's no way we're teaming up with this lot!","nextNodeIds":[750280116]},{"nodeId":750280116,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1933711530,"text":"Rrrah... Rawr!","nextNodeIds":[750280117]},{"nodeId":750280111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":711064186,"text":"Thanks for your consideration, but no need.","nextNodeIds":[750280112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7502801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_8676:-2072.388,346.052,8182.798,0.000,329.076,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7502802,"order":3,"stepDescription":"Check on the injured Saurian","stepDescTextMapHash":811936812,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7502802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21499"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7502802],"talks":[{"talkId":7502802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{