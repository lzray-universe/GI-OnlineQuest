{"mainQuestId":73520,"title":"\"That Incident From Twenty Years Ago\"","description":"Dori says that she has the latest update on the Akademiya Extravaganza. Why not go and hear it?","titleTextMapHash":3021423519,"descTextMapHash":3043547926,"mainQuestExcel":{"mainQuestId":73520,"titleTextMapHash":3021423519,"title":"\"That Incident From Twenty Years Ago\"","descTextMapHash":3043547926,"description":"Dori says that she has the latest update on the Akademiya Extravaganza. Why not go and hear it?","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":2021,"luaPath":"Actor/Quest/WQ73520","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2021,"chapterId":0,"descTextMapHash":3043547926,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73520,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3204106073,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73520","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173520],"series":73520,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[73521],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3021423519,"type":"WQ","unlockDescTextMapHash":227037926}},"flow":[{"subQuestId":7352001,"order":1,"stepDescription":"Ask Dori for information","stepDescTextMapHash":2053630756,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1055"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352001],"talks":[{"talkId":7352001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352001,"initDialog":735200101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1055],"performCfg":"QuestDialogue/WQ/Sumeru_73520/Q7352001","priority":5,"questId":73520,"showRandomTalkCount":0},"dialogs":[{"nodeId":735200101,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":3143880690,"text":"Have you decided to buy information from me?","nextNodeIds":[735200102]},{"nodeId":735200102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":253302714,"text":"Hmmm... Paimon's a little curious about your exclusive information, but we need to hear the price first! If it's too expensive, then forget it.","nextNodeIds":[735200103]},{"nodeId":735200103,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":151783346,"text":"I'll sell it to you for the fixed price of one million Mora!","nextNodeIds":[735200104]},{"nodeId":735200104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1559274794,"text":"That's a lot! Never mind, one million Mora can buy lots and lots of tasty food!","nextNodeIds":[735200105]},{"nodeId":735200105,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":4145799762,"text":"Wait a sec... Let me see... Eh? Paimon is customer number 1,001 for today. The original cost of the information was one million Mora, but for you the price is now free!","nextNodeIds":[735200106]},{"nodeId":735200106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":198592538,"text":"Eh!? Paimon didn't know such luck exists!","nextNodeIds":[735200107]},{"nodeId":735200107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2198225682,"text":"Wait, you're not baiting us into spending, are you? Maybe the first sentence is free, but not the next sentence...","nextNodeIds":[735200108]},{"nodeId":735200108,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":696574402,"text":"If you don't want it, fine! Next!","nextNodeIds":[735200109]},{"nodeId":735200109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1879870786,"text":"Wait, wait, wait, forget what Paimon said. We'll listen!","nextNodeIds":[735200110]},{"nodeId":735200110,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":743183410,"text":"Dori's exclusive scoop number one! Do you remember the Diadem of Knowledge?","nextNodeIds":[735200111]},{"nodeId":735200111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3328519330,"text":"Paimon remembers that only the champion was entitled to wear the diadem. It seemed very valuable!","nextNodeIds":[735200112]},{"nodeId":735200112,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":3022844466,"text":"Exactly. The diadem that Sachin gave the Akademiya was a rather expensive antique.","nextNodeIds":[735200113]},{"nodeId":735200113,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":1687646298,"text":"Yet this very diadem, after it was donated to the Akademiya, was lost by them once before!","nextNodeIds":[735200114]},{"nodeId":735200114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":363141282,"text":"Eh? Why didn't we hear about this?","nextNodeIds":[735200115]},{"nodeId":735200115,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":3600343282,"text":"Hehe... if everyone knew about this, would my information still be considered \"exclusive\"?","nextNodeIds":[735200116]},{"nodeId":735200116,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":466449202,"text":"Of course, this information doesn't come from nowhere. I've got witnesses, too.","nextNodeIds":[735200117]},{"nodeId":735200117,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":383312378,"text":"There's a young fellow named Kashmer from the suburbs. If you're interested in delving further, you could ask him.","nextNodeIds":[735200118]},{"nodeId":735200118,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"Dori","textMapHash":801183074,"text":"The password is \"that incident from twenty years ago\"!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1055"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7352002,"order":2,"stepDescription":"Talk to Kashmer","stepDescTextMapHash":235315140,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352032,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30353"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352002,7352022,7352032,7352033],"talks":[{"talkId":7352002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE