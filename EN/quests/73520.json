ONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7352032,"initDialog":735200203,"nextRandomTalks":[],"nextTalks":[],"npcId":[30353],"performCfg":"QuestDialogue/WQ/Sumeru_73520/Q7352032","priority":5,"questId":73520,"showRandomTalkCount":0},"dialogs":[{"nodeId":735200203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1923186874,"text":"\"That Incident From Twenty Years Ago\"","nextNodeIds":[735200204]},{"nodeId":735200204,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":4071403906,"text":"... I guess I shouldn't have told anyone. Last time I had too much to drink and blabbered a little too much, and now people are seeking me out.","nextNodeIds":[735200205]},{"nodeId":735200205,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":397066178,"text":"Since you're curious, I guess I'll tell you.","nextNodeIds":[735200206]},{"nodeId":735200206,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":1774771338,"text":"I was just six years old twenty years ago, so I can't remember clearly what happened at the time. But recently, I read the diary I kept when I was a child, and vaguely recalled the situation back then.","nextNodeIds":[735200207]},{"nodeId":735200207,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":3317060378,"text":"The Interdarshan Championship was also held that year. There were three rounds, the last of which was outside the city. I begged my mom to take me out of town to see it, and when she refused, I snuck out.","nextNodeIds":[735200208]},{"nodeId":735200208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2184917634,"text":"And then?","nextNodeIds":[735200209]},{"nodeId":735200209,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":3547535074,"text":"I ended up getting lost outside the city. In the middle of nowhere, there was no one around. I grew more and more frightened and began to cry.","nextNodeIds":[735200210]},{"nodeId":735200210,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":1487340074,"text":"That's when I saw some strange creatures... I can't remember what they looked like. I only remember how, as a child, I stopped crying at the sight of them.","nextNodeIds":[735200211]},{"nodeId":735200211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3234834322,"text":"Strange creatures... they must be...","nextNodeIds":[735200212]},{"nodeId":735200212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1015957610,"text":"(The Aranara.)","nextNodeIds":[735200213]},{"nodeId":735200213,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":2826334378,"text":"They took me to the competition. Unfortunately, by the time we got there, it was too late. It was already over.","nextNodeIds":[735200214]},{"nodeId":735200214,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":3238851530,"text":"Just when I was disheartened, I suddenly saw one of those strange creatures slowly dragging a crown along.","nextNodeIds":[735200215]},{"nodeId":735200215,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":2594230642,"text":"It was a beautiful crown, shining in the moonlight, and I could not help but follow it. I saw the little fellow hide the crown in a hollow tree before disappearing.","nextNodeIds":[735200216]},{"nodeId":735200216,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":725316698,"text":"I wanted to touch that crown. But at the moment, I could hear the distant cries of my mother. It turns out, she figured out I was lost, and got her neighbors to go looking for me.","nextNodeIds":[735200217]},{"nodeId":735200217,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":1270820242,"text":"I never got to touch it. It wasn't until I was older, when I saw the \"Diadem of Knowledge\" at the Interdarshan Championship that I realized it was the same thing.","nextNodeIds":[735200218]},{"nodeId":735200218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4130251594,"text":"Alright... do you remember where that diadem ended up?","nextNodeIds":[735200219]},{"nodeId":735200219,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":2225368306,"text":"It's probably in the Avidya Forest, but I've been back a few times, and I haven't found anything.","nextNodeIds":[735200220]},{"nodeId":735200220,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"Kashmer","textMapHash":606135994,"text":"No one would believe me, even if I told them. Alas, even I can't remember it clearly. Perhaps, it was a dream I had when I was a child.","nextNodeIds":[735200221]},{"nodeId":735200221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4185204930,"text":"#Well... should we go look for it, {NICKNAME}?","nextNodeIds":[]}]},{"talkId":7352033,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352033,"initDialog":735203301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1055],"performCfg":"QuestDialogue/WQ/