{"mainQuestId":74686,"title":"A Time-Tested Friendship","description":"Aside from filming, there are other things we can do together, like meeting for a meal. Good Hunter, Wanmin Restaurant, Lambad's Tavern, Hotel Debord, and the like... Coffee at Café Lutece might not be a bad idea either.","titleTextMapHash":1915253455,"descTextMapHash":1114793846,"mainQuestExcel":{"mainQuestId":74686,"titleTextMapHash":1915253455,"title":"A Time-Tested Friendship","descTextMapHash":1114793846,"description":"Aside from filming, there are other things we can do together, like meeting for a meal. Good Hunter, Wanmin Restaurant, Lambad's Tavern, Hotel Debord, and the like... Coffee at Café Lutece might not be a bad idea either.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5254,"luaPath":"Actor/Quest/WQ74686","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5254,"chapterId":0,"descTextMapHash":1114793846,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74686,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3792869441,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74686","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174686],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1915253455,"type":"WQ","unlockDescTextMapHash":2026164510}},"flow":[{"subQuestId":7468601,"order":1,"stepDescription":"Talk to Xavier","stepDescTextMapHash":2542151300,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30771"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7468601],"talks":[{"talkId":7468601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7468601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468601,"initDialog":746860101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30771],"performCfg":"QuestDialogue/WQ/Fontaine_74686/Q7468601","priority":5,"questId":74686,"showRandomTalkCount":0},"dialogs":[{"nodeId":746860101,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3665259402,"text":"Hello, my gallant adventurer friend!","nextNodeIds":[746860102]},{"nodeId":746860102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":416994474,"text":"Call me the Great Editor, good sir!","nextNodeIds":[746860103]},{"nodeId":746860103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1390754378,"text":"That's the Commercial Auteur to you, my friend!","nextNodeIds":[746860104]},{"nodeId":746860104,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3074731130,"text":"Haha, I'm glad you didn't find the filming boring! Some self-reflection would have been in order otherwise, for spending our precious time together on something dull.","nextNodeIds":[746860105]},{"nodeId":746860105,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1868463642,"text":"I mean, we don't get many chances to meet. Tracking down a world-walker like yourself is no less challenging than pulling stars out of the sky.","nextNodeIds":[746860106]},{"nodeId":746860106,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":2660468050,"text":"Sometimes, like now, I could bump into you in a cafe. But other times, I could ask everyone about your whereabouts and still come up empty-handed.","nextNodeIds":[746860107]},{"nodeId":746860107,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":4053383642,"text":"The good news is that I'm sure to hear a new, thrilling tale of your travels every time we meet, so our encounters are never boring. But the bad... Well, we can never know if any given meeting might be our last.","nextNodeIds":[746860108,746860109]},{"nodeId":746860108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3109948922,"text":"C'mon, I'm not that incorrigible, am I?","nextNodeIds":[746860110]},{"nodeId":746860110,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1655412338,"text":"Haha, alright, whatever you say. Any more grousing and I'll turn into one of those empty nesters you see in public service announcements.","nextNodeIds":[746860111]},{"nodeId":746860111,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":66566218,"text":"I'm almost done working with these commercials. After this, it's \"nose to the grindstone\" — I'll start work on my next film. Let's keep chasing our dreams even as we go our separate ways, eh?","nextNodeIds":[746860112]},{"nodeId":746860112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1566943994,"text":"I will.","nextNodeIds":[746860113]},{"nodeId":746860113,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1714875250,"text":"Ah, but still, let's have a meal somewhere together, should you have the time! If you'd prefer not to dine in Fontaine, that's fine too!","nextNodeIds":[746860114]},{"nodeId":746860114,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1434766410,"text":"Good Hunter, Wanmin Restaurant, Lambad's Tavern, and the like... And if you want to go picnicking or big-game hunting, I'll find a way to keep up somehow... Anyway, please keep in touch!","nextNodeIds":[]},{"nodeId":746860109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2404937530,"text":"I'll swing by to see you more often.","nextNodeIds":[746860110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30771"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174686],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1114793846,"CHECNJEMEFE":{"30771":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74686/Q7468601","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":746860101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7468601,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30771],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDD