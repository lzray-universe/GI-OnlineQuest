lse,"talkIds":[7212601],"talks":[{"talkId":7212601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7212601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7212601,"initDialog":721260101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3165],"performCfg":"","priority":5,"questId":72126,"showRandomTalkCount":0},"dialogs":[{"nodeId":721260101,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1984127178,"text":"Oh no...what now...","nextNodeIds":[721260102]},{"nodeId":721260102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":496182890,"text":"What happened?","nextNodeIds":[721260103]},{"nodeId":721260103,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3678483602,"text":"Hey...I'm so glad you're here... It's like this, after you gave me the flower seeds, I started planting flowers.","nextNodeIds":[721260104]},{"nodeId":721260104,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2623291146,"text":"But before I could plant much, a group of monsters suddenly appeared and kept loitering around the place where I was going to plant the flowers. I no longer dare to go over to plant them.","nextNodeIds":[721260105]},{"nodeId":721260105,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3453884306,"text":"If they continue to remain here, they may destroy the place where the flowers were planted...","nextNodeIds":[721260106]},{"nodeId":721260106,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":88839658,"text":"If you don't mind, could you go and get rid of those monsters for me? I... I just want to plant flowers...","nextNodeIds":[721260107,721260109]},{"nodeId":721260107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2586934386,"text":"I'll take care of it.","nextNodeIds":[721260108]},{"nodeId":721260108,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1965923906,"text":"You said yes? Thank you so much! I'm counting on you!","nextNodeIds":[]},{"nodeId":721260109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1751019962,"text":"Why are you so determined on growing flowers?","nextNodeIds":[721260110]},{"nodeId":721260110,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":229417114,"text":"I was thinking, the reason why people don't want to come back to Tatarasuna is because they are worried that this place is no longer suitable for living after the Mikage Furnace incident happened...","nextNodeIds":[721260111]},{"nodeId":721260111,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":4157752378,"text":"I can't persuade everyone one by one, but if I can plant a lot of beautiful flowers here again...","nextNodeIds":[721260112]},{"nodeId":721260112,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2608117202,"text":"Maybe it will be enough to convince everyone that Tatarasuna is already safe.","nextNodeIds":[721260113]},{"nodeId":721260113,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":199368810,"text":"And...heh, besides planting flowers, I have no other means to convince people...","nextNodeIds":[721260114]},{"nodeId":721260114,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1830830730,"text":"So please, please help me to chase away those monsters!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7212601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7212602,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7212602_end"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFM