ARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1918705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1918719,"initDialog":191871901,"nextRandomTalks":[],"nextTalks":[],"npcId":[1081],"performCfg":"QuestDialogue/COOP/CoopLynette/Q1918719","priority":5,"questId":19187,"showRandomTalkCount":0},"dialogs":[{"nodeId":191871901,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"Chevreuse","textMapHash":4207680626,"text":"You can leave the rest of this to me — the other Gardes will be joining me shortly. Don't worry, they won't have another chance to escape.","nextNodeIds":[191871902,191871903]},{"nodeId":191871902,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2660995970,"text":"There are still a few things I'm curious about...","nextNodeIds":[191871904]},{"nodeId":191871904,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"Chevreuse","textMapHash":2142908538,"text":"Hmm... The materials have many other regular uses outside of being used to make Imitation Sinthe, so they're not immediately subject to being confiscated or destroyed.","nextNodeIds":[191871905]},{"nodeId":191871905,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"Chevreuse","textMapHash":3789637426,"text":"The harbor would usually just seize them for some time while the customs paperwork is filled out and approved. If approved, they'd be let through, and if not, they'd be returned to sender. Elodie probably used her position to replace a portion of the shipment with something else before sending the whole shipment back to sender.","nextNodeIds":[191871906]},{"nodeId":191871906,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"Chevreuse","textMapHash":4173566394,"text":"Given that the foreign merchants who sent in the shipments were probably working with her in the first place, they likely just never reported the difference in what they sent and what they received.","nextNodeIds":[191871907]},{"nodeId":191871907,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"Chevreuse","textMapHash":1050113786,"text":"We will, of course, continue to investigate the rest of the details of this case. Now that we've caught Elodie, figuring out the whole scheme should just be a matter of time.","nextNodeIds":[]},{"nodeId":191871903,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1994344026,"text":"How did Elodie get her hands on the raw materials?","nextNodeIds":[191871904]}]},{"talkId":1918720,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1918705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1918720,"initDialog":191872001,"nextRandomTalks":[],"nextTalks":[],"npcId":[1071],"performCfg":"QuestDialogue/COOP/CoopLynette/Q1918720","priority":5,"questId":19187,"showRandomTalkCount":0},"dialogs":[{"nodeId":191872001,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":849462658,"text":"Lynette must have spent a record-breaking amount of time in serious mode today. I can't remember the last time I've seen her like that... Could it be because of a special someone?","nextNodeIds":[191872002,191872003]},{"nodeId":191872002,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":802831186,"text":"There are still a few things I'm curious about...","nextNodeIds":[191872004]},{"nodeId":191872004,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":4010511914,"text":"Hmm... Based on information that we found before, Imitation Sinthe was first circulated on a small scale in Fontaine, before becoming a large-scale smuggling scheme.","nextNodeIds":[191872005]},{"nodeId":191872005,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":573231882,"text":"I'd assume that the first offerings of Imitation Sinthe came from what Pierre made in his early days. But since he was not experienced with running a clandestine operation, he was soon discovered by Garde Elodie.","nextNodeIds":[191872006]},{"nodeId":191872006,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":4112574410,"text":"Elodie saw the opportunity to make a great profit in his work and perhaps even the chance of making a new life for herself, so she decided to cover his tracks...","nextNodeIds":[191872007]},{"nodeId":191872007,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":1224538170,"text":"She started writing to him in Bernard's name, using what evidence she had compiled and the promise of enormous profits to blackmail him into cooperating with her.","nextNodeIds":[191872008]},{"nodeId":191872008,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":2321732754,"text":"Unfortunately for her, she ran into Lynette. Even though my sister doesn't like to focus too much on a regular day, \"serious mode\" Lynette is one of the most perceptive people I've ever known.","nextNodeIds":[191872009]},{"nodeId":191872009,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":725724610,"text":"...Still, all of that thinking really saps her energy. I need to go give some statements on her behalf, so I'll leave the recharging to you.","nextNodeIds":[]},{"nodeId":191872003,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3171043650,"text":"How did Pierre get recruited into the scheme?","nextNodeIds":[191872004]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[108301,191870501],"PAINLIBBLDK":"QUEST_CONTENT_MAIN_COOP_ENTER_SAVE_POINT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133401830"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","ID