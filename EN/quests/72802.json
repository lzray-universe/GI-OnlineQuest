cement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7280202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7280202,"initDialog":728020201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3049,3050],"performCfg":"","priority":5,"questId":72802,"showRandomTalkCount":0},"dialogs":[{"nodeId":728020201,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":3522359570,"text":"How many dishes should we make for lunch tomorrow?","nextNodeIds":[728020202]},{"nodeId":728020202,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":1216142482,"text":"Our kids can eat a lot these days. Let's just cook more.","nextNodeIds":[728020203]},{"nodeId":728020203,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":980415178,"text":"Hmm? Who might you be...","nextNodeIds":[728020204,728020205]},{"nodeId":728020204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2796066466,"text":"May I ask if this is Atsuko's house?","nextNodeIds":[728020206]},{"nodeId":728020206,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":4013777882,"text":"Yes, we are. What can I do for you?","nextNodeIds":[728020207]},{"nodeId":728020207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3649821170,"text":"Atsuko asked me to bring you this letter.","nextNodeIds":[728020208]},{"nodeId":728020208,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":4108861346,"text":"Letter? Why would that child suddenly want to write a letter to us?","nextNodeIds":[728020209]},{"nodeId":728020209,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":1088332850,"text":"The letter is quite long... I mean, she's back at home already, so if she wants to say something, she should just say it to us directly.","nextNodeIds":[728020210,728020211]},{"nodeId":728020210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1298373010,"text":"...Pardon?","nextNodeIds":[728020212]},{"nodeId":728020212,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":2775445522,"text":"...Traveler, it sounds like you're surprised? It's true that Atsuko was traveling abroad before, but she's come back now.","nextNodeIds":[728020213]},{"nodeId":728020213,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":1198843322,"text":"Why does she want to send a letter to us when she's already back home with us? Did you mistake us for someone else?","nextNodeIds":[728020214]},{"nodeId":728020214,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3937254874,"text":"Wait a minute, dear. I had a brief scan of the letter. The handwriting and the way it's written, it's definitely from our daughter.","nextNodeIds":[728020215]},{"nodeId":728020215,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":2172933810,"text":"The letter also says that she doesn't plan to come back in the near future, and tells us to take care of ourselves.","nextNodeIds":[728020216]},{"nodeId":728020216,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":2981205826,"text":"What does this all mean? Could it be that she came back on her own while getting this Traveler to deliver this letter to us?","nextNodeIds":[728020217]},{"nodeId":728020217,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3026066698,"text":"I feel there might be a misunderstanding. After that child comes home, we'll ask her.","nextNodeIds":[728020218]},{"nodeId":728020218,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":2947770,"text":"Unfortunately, Atsuko had matters to attend to today. After she's back, we'll ask her for clarification.","nextNodeIds":[728020219]},{"nodeId":728020219,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3314946618,"text":"If it's okay with you, please find us tomorrow evening. We'll get that child to explain everything to you.","nextNodeIds":[728020220,728020222]},{"nodeId":728020220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2686473058,"text":"Where is she now?","nextNodeIds":[728020221]},{"nodeId":728020221,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":2808526634,"text":"That child said she's busy working. After breakfast, she left the house in a hurry.","nextNodeIds":[728020224]},{"nodeId":728020224,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":3564863450,"text":"Yeah, every day, she leaves early and comes back late. We only get to see her in the evening, so we aren't sure what she's really up to.","nextNodeIds":[728020225]},{"nodeId":728020225,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":1075664858,"text":"Anyway, please come over tomorrow evening. If that child has done something wrong, we'll make sure she apologizes to you in person.","nextNodeIds":[728020226]},{"nodeId":728020226,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":2803493714,"text":"We're really sorry that you had to travel such a long way.","nextNodeIds":[728020227]},{"nodeId":728020227,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":471521610,"text":"That Atsuko, if only she was more well behaved...","nextNodeIds":[]},{"nodeId":728020222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3200929514,"text":"Why only the evening?","nextNodeIds":[728020223]},{"nodeId":728020223,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":2184041634,"text":"That child said she's busy working. She leaves the house for the entire day after breakfast.","nextNodeIds":[728020224]},{"nodeId":728020211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3683773962,"text":"Atsuko... is back?","nextNodeIds":[728020212]},{"nodeId":728020205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3655188458,"text":"Would you happen to be Atsuko's parents?","nextNodeIds":[728020206]}]},{"talkId":7280251,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TA