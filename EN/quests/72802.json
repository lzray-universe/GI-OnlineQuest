2802House"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7280205],"talks":[{"talkId":7280205,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7280205","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7280205,"initDialog":728020501,"nextRandomTalks":[],"nextTalks":[],"npcId":[20307],"performCfg":"QuestDialogue/WQ/Inazuma_72802/Q7280205","priority":5,"questId":72802,"showRandomTalkCount":0},"dialogs":[{"nodeId":728020501,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1494448338,"text":"Atsuko should be back now. Let's knock on the door.","nextNodeIds":[728020502]},{"nodeId":728020502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2974804194,"text":"They seem to be talking about something.","nextNodeIds":[728020503]},{"nodeId":728020503,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":1682751802,"text":"That being said, I wonder what happened to the Tanuki that we rescued before.","nextNodeIds":[728020504]},{"nodeId":728020504,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3091674226,"text":"You're too kind. That Tanuki only had a minor scrape on its leg. If you let it be in the bushes, it would've recovered by itself.","nextNodeIds":[728020505]},{"nodeId":728020505,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":89046962,"text":"I couldn't help it. It was looking at me with tears in its eyes. It looked very pitiful. My conscience just wouldn't let me.","nextNodeIds":[728020506]},{"nodeId":728020506,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3347263690,"text":"Forget it. It's never wrong to do good deeds. It's just that it ate a bit too much, nearly as much as me...","nextNodeIds":[728020507]},{"nodeId":728020507,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2005939298,"text":"Knocking on the door","nextNodeIds":[728020508]},{"nodeId":728020508,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3039264658,"text":"Who is it?","nextNodeIds":[728020509]},{"nodeId":728020509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1951363066,"text":"I'm the Traveler that came here before.","nextNodeIds":[728020510]},{"nodeId":728020510,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":776641114,"text":"Ahh, I remember you. Please wait here.","nextNodeIds":[728020511]},{"nodeId":728020511,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":2117573098,"text":"He—Hello! I'm Atsuko, first... no... nice to see you again!","nextNodeIds":[728020512]},{"nodeId":728020512,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":2157220898,"text":"Sorry, I was homesick. After I gave you the letter, I changed my mind and took a ship back to Inazuma.","nextNodeIds":[728020513]},{"nodeId":728020513,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":307787282,"text":"Ahaha... Sorry for not clarifying things before, and making you travel so far.","nextNodeIds":[728020514]},{"nodeId":728020514,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3099505722,"text":"How did you return to Inazuma?","nextNodeIds":[728020515]},{"nodeId":728020515,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":759433714,"text":"...Ah, I had my ways, haha. You don't have to worry about that.","nextNodeIds":[728020516]},{"nodeId":728020516,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":2444654642,"text":"Um, I've prepared the payment for you. Please take it. Thanks for your help. Hurry... uh, hurry up and go about the rest of your day.","nextNodeIds":[728020517]},{"nodeId":728020517,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3697796274,"text":"How come the things that Atsuko are telling us now are different from what it was before? If returning to Inazuma was so easy, why did you ask us for help in the first place?","nextNodeIds":[728020518,728020520]},{"nodeId":728020518,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2224309658,"text":"What happened to your business in Liyue?","nextNodeIds":[728020519]},{"nodeId":728020519,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":2871335938,"text":"Business? What business? I had a business in Liyue!?","nextNodeIds":[728020522]},{"nodeId":728020522,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":1712833186,"text":"...Ah, that kind of stuff is unimportant. Nothing is more important than family. I already entrusted it all to someone else, ah... haha.","nextNodeIds":[728020523]},{"nodeId":728020523,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1551669538,"text":"Hang on! The real Atsuko had trouble finding a job in Liyue, there's no way that she'd suddenly become rich!","nextNodeIds":[728020524]},{"nodeId":728020524,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3547157250,"text":"Who are you?","nextNodeIds":[728020525]},{"nodeId":728020525,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":3190225762,"text":"I—I'm Atsuko, of course! I look like Atsuko and sound like Atsuko. What's there to be suspicious about?","nextNodeIds":[728020526]},{"nodeId":728020526,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":2407957114,"text":"Look here! Stop being so persistent... forget it. I won't talk to you anymore. I've got work tomorrow. I'm heading off now.","nextNodeIds":[728020527]},{"nodeId":728020527,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":1740261850,"text":"Atsuko! That child... Why did she get angry all of a sudden...","nextNodeIds":[728020528]},{"nodeId":728020528,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":647858514,"text":"Sorry about that, Traveler. That child must be too tired from her work.","nextNodeIds":[728020529]},{"nodeId":728020529,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3245963178,"text":"But you saw her for yourselves. That's our daughter. That letter... Maybe that child forgot about it.","nextNodeIds":[728020530]},{"nodeId":728020530,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":4128481466,"text":"But in any case, we'd still like to thank you for the trouble you went through. As for the payment... Would you be able to wait a little longer?","nextNodeIds":[728020531,728020532]},{"nodeId":728020531,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":520610458,"text":"Is there anything wrong?","nextNodeIds":[728020533]},{"nodeId":728020533,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":1586845986,"text":"Nothing of that sort. We can still afford the payment.","nextNodeIds":[728020534]},{"nodeId":728020534,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":978760298,"text":"You know how we told you that Atsuko goes to work during the day? The payment that she receives has always been strange.","nextNodeIds":[728020535]},{"nodeId":728020535,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":1727330482,"text":"She always brings back weird seeds or some wild fruits, but she never brings back Mora.","nextNodeIds":[728020536]},{"nodeId":728020536,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3616974306,"text":"Even though things like that do have some value, we have to sell them first.","nextNodeIds":[728020537]},{"nodeId":728020537,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":2179959634,"text":"For a traveler like you, I guess Mora would be more convenient.","nextNodeIds":[728020538]},{"nodeId":728020538,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":2721704802,"text":"Please come here again tomorrow. By then, we should be able to give you the Mora.","nextNodeIds":[]},{"nodeId":728020532,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2602258442,"text":"If there are any issues...","nextNodeIds":[728020533]},{"nodeId":728020520,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2910253826,"text":"What about your mansion?","nextNodeIds":[728020521]},{"nodeId":728020521,"roleType":"TALK_ROLE_NPC","speakerId":20307,"speakerName":"Atsuko","textMapHash":1263879722,"text":"Mansion? What? I even had a mansion in Liyue!?","nextNodeIds":[728020522]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280205,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q72802House"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7280206,"order":6,"stepDescription":"Wait until the following day","stepDescTextMapHash":3993272852,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7280207,"order":7,"stepDescription":"Talk to Atsuko's parents again","stepDescTextMapHash":3558542076,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3050"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7280206],"talks":[{"talkId":7280206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7280207","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7280206,"initDialog":728020601,"nextRandomTalks":[],"nextTalks":[],"npcId":[3049,3050],"performCfg":"","priority":5,"questId":72802,"showRandomTalkCount":0},"dialogs":[{"nodeId":728020601,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":1898525026,"text":"Where did our daughter run off to...","nextNodeIds":[728020602,728020603]},{"nodeId":728020602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2568022274,"text":"What's the matter?","nextNodeIds":[728020604]},{"nodeId":728020604,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":1016358026,"text":"Even if she's working the next day, Atsuko usually says something to us before leaving. But today, she left without saying anything.","nextNodeIds":[728020605]},{"nodeId":728020605,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":4221694050,"text":"After you left yesterday, Atsuko said she was tired and went straight to her room to sleep.","nextNodeIds":[728020606]},{"nodeId":728020606,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":2123429754,"text":"By the time we got up the next day, she wasn't in bed anymore.","nextNodeIds":[728020607]},{"nodeId":728020607,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":2003075738,"text":"We tried looking everywhere for her. My husband searched far and wide.","nextNodeIds":[728020608]},{"nodeId":728020608,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":858346394,"text":"However, even after half a day, we still couldn't find any traces of our daughter.","nextNodeIds":[728020609]},{"nodeId":728020609,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":2132427538,"text":"*sigh* Did that child go off on another journey again? What a troublesome child...","nextNodeIds":[728020610]},{"nodeId":728020610,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":1286787474,"text":"Calm down, dear. I'll look for her again. Please sweep Atsuko's room first.","nextNodeIds":[728020611]},{"nodeId":728020611,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":521939386,"text":"After that child left, she didn't close the window properly. A lot of leaves blew into the room.","nextNodeIds":[728020612]},{"nodeId":728020612,"roleType":"TALK_ROLE_NPC","speakerId":3050,"speakerName":"Yoh","textMapHash":3841221706,"text":"Before I forget. Here's the payment. Please take it.","nextNodeIds":[728020613]},{"nodeId":728020613,"roleType":"TALK_ROLE_NPC","speakerId":3049,"speakerName":"Michiru","textMapHash":2964406866,"text":"*sigh* That child, Atsuko... Where is she off to this time...","nextNodeIds":[]},{"nodeId":728020603,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4121180842,"text":"Has Atsuko gone off to work again?","nextNodeIds":[728020604]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["72802","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"gui