{"mainQuestId":75662,"title":"","description":"","titleTextMapHash":1835796455,"descTextMapHash":4116994974,"mainQuestExcel":{"mainQuestId":75662,"titleTextMapHash":1835796455,"title":"","descTextMapHash":4116994974,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5240,"luaPath":"Actor/Quest/WQ75662","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5240,"chapterId":0,"descTextMapHash":4116994974,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75662,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2244169193,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75662","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":75659,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1835796455,"type":"WQ","unlockDescTextMapHash":485764190}},"flow":[{"subQuestId":7566201,"order":1,"stepDescription":"","stepDescTextMapHash":1724181308,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7566201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7566201],"talks":[{"talkId":7566201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7566201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7566201,"initDialog":756620101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1088],"performCfg":"QuestDialogue/WQ/Natlan_75662/Q7566201","priority":5,"questId":75662,"showRandomTalkCount":0},"dialogs":[{"nodeId":756620101,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":3318876018,"text":"A courier told me that our combat readiness liaison found an excellent certification officer.","nextNodeIds":[756620102]},{"nodeId":756620102,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":929515754,"text":"Turns out that it's you. An encouraging sign.","nextNodeIds":[756620103]},{"nodeId":756620103,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":3914985938,"text":"Tsk, so they've even gone to YOU, of all people? Hey, Kinich, looks like freaks of a feather do flock together — this commission-freak never learned to say no either!","nextNodeIds":[756620104]},{"nodeId":756620104,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":1948442866,"text":"Oh, look. A new commission notification — \"to shut a noisy dragon up.\"","nextNodeIds":[756620105,756620107]},{"nodeId":756620105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2198929066,"text":"Oh, that? I just posted it.","nextNodeIds":[756620106]},{"nodeId":756620106,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":4214022410,"text":"You... You... So that's how it's gonna be, huh? Ganging up on the Almighty Dragonlord... Just you wait!","nextNodeIds":[756620109]},{"nodeId":756620109,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":1320397642,"text":"#Anyway, back on topic, {NICKNAME}. We'd like your help certifying these stages. Their difficulty and balance should be up to par.","nextNodeIds":[756620110]},{"nodeId":756620110,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":1969570730,"text":"Difficulty? Where? Pfft! Don't be ridiculous.","nextNodeIds":[756620111]},{"nodeId":756620111,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":2094735634,"text":"And what would you consider difficult? \"Have them randomly pick some halfwit partner before rappelling down a mountain blindfolded\"?","nextNodeIds":[756620112]},{"nodeId":756620112,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":421470418,"text":"And perhaps you'd also make it so that they'd only have a ten-percent chance of getting a Yumkasaur buddy, with their other options being Avatars of Lava or Geo Slimes?","nextNodeIds":[756620113,756620116]},{"nodeId":756620113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4239182338,"text":"That's practically begging for death.","nextNodeIds":[756620114]},{"nodeId":756620114,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":580096418,"text":"Hah, haven't you been tagging along with my little lackey long enough to know that that's just what the Scions of the Canopy love doing? My suggestion's perfect for them.","nextNodeIds":[756620115]},{"nodeId":756620115,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":2223067842,"text":"Perhaps you'd like to give us a demonstration, then?","nextNodeIds":[756620120]},{"nodeId":756620120,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":2978177242,"text":"...Such trivial challenges are far beneath the Almighty Dragonlord's dignity. Just amuse yourselves however you please, peons!","nextNodeIds":[756620121]},{"nodeId":756620121,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":3242112770,"text":"In any case, Irade offered me a good rate. Here's to you finding enjoyment in the challenge — and receiving satisfactory payment.","nextNodeIds":[756620122,756620123]},{"nodeId":756620122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3129446218,"text":"I'm looking forward to it!","nextNodeIds":[756620124]},{"nodeId":756620124,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":3015034402,"text":"I wish you well.","nextNodeIds":[]},{"nodeId":756620123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2393358338,"text":"Leave it to me, Kinich!","nextNodeIds":[756620124]},{"nodeId":756620116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2334468610,"text":"Oooh, now we're really talking...","nextNodeIds":[756620117]},{"nodeId":756620117,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":3412678570,"text":"Hark! Hark! Now here's a person of refined tastes — way better than yours, at least!","nextNodeIds":[756620118]},{"nodeId":756620118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4261142778,"text":"But I'd love to watch Ajaw show us how a pro does it first.","nextNodeIds":[756620119]},{"nodeId":756620119,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":3024862562,"text":"I second that motion, Ajaw. You are much more agile than the average challenger. And even if a monster gets lucky and lands a hit, not like you'll get smacked straight into an Ajaw-shaped hole in the ground, right?","nextNodeIds":[756620120]},{"nodeId":756620107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3772710594,"text":"Oh, don't worry, you can handle that one later.","nextNodeIds":[756620108]},{"nodeId":756620108,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":2813290642,"text":"Hmph! Do you think such paltry flattery means that the Almighty Dragonlord will owe you one or something?","nextNodeIds":[756620109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7566201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUE