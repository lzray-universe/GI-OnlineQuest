aram":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7212009","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7212003,"initDialog":721200301,"nextRandomTalks":[],"nextTalks":[],"npcId":[3162],"performCfg":"","priority":5,"questId":72120,"showRandomTalkCount":0},"dialogs":[{"nodeId":721200301,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":569968490,"text":"Alright, then. Have you checked our roads?","nextNodeIds":[721200302]},{"nodeId":721200302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1820363098,"text":"They're as smooth as can be now.","nextNodeIds":[721200303]},{"nodeId":721200303,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2327314258,"text":"Alright. Th—Then let us set off after a brief wait...","nextNodeIds":[721200304]},{"nodeId":721200304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1074281210,"text":"Hey. Are you...","nextNodeIds":[721200305]},{"nodeId":721200305,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2412940698,"text":"I... I'm thinking! I'm thinking of all the things that could possibly happen, you understand?","nextNodeIds":[721200306]},{"nodeId":721200306,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":770962402,"text":"For example, what we'll do if those masked lunatics have already extracted the core when we enter.","nextNodeIds":[721200307]},{"nodeId":721200307,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":309778562,"text":"They might shove it into some Ruin Guard, causing it to go berserk and send us all flying.","nextNodeIds":[721200308]},{"nodeId":721200308,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":134721530,"text":"Or maybe, some sort of elemental creature might emerge as we are purifying the Mikage Furnace, and might devour the core in a single bite.","nextNodeIds":[721200309]},{"nodeId":721200309,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1715426882,"text":"And in the worst case scenario, that legendary serpent might use this opportunity to resurrect itself. Then we'd be doomed! It'd be game over! Game over!","nextNodeIds":[721200310,721200311]},{"nodeId":721200310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3456653818,"text":"Get a hold of yourself, Xavier...","nextNodeIds":[721200312]},{"nodeId":721200312,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2042254170,"text":"Ah! Um, sorry, I... My old habits are acting up again. I always envisage the worst case scenarios...","nextNodeIds":[721200313]},{"nodeId":721200313,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":597191874,"text":"I'll make some plans, and once the time comes, let us go and put an end to this.","nextNodeIds":[721200314]},{"nodeId":721200314,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2907743658,"text":"Please go well, please go well, please go well...","nextNodeIds":[]},{"nodeId":721200311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":84984266,"text":"It won't be that dramatic.","nextNodeIds":[721200312]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7212003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3162","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7212001,7212002,7212003,7212004],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","count":19},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[172120],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":862024214,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_RANK_ZERO_WQ","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAF