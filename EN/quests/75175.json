LKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[101_42:53.188,699.191,292.512]"],"NOCCOBOFKHP":101,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7517501],"talks":[{"talkId":7517501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7517515","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7517501,"initDialog":751750101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21806],"performCfg":"QuestDialogue/WQ/Natlan_75175/Q7517501","priority":5,"questId":75175,"showRandomTalkCount":0},"dialogs":[{"nodeId":751750101,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2012132306,"text":"As you immerse yourself in the liquid Phlogiston, images flash through your mind like warm memories.","nextNodeIds":[751750102]},{"nodeId":751750102,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2218178610,"text":"Beside the flaming pool, the silver-white and ash-covered shadows converse as such...","nextNodeIds":[751750103]},{"nodeId":751750103,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":2058759554,"text":"\"...Phase Two experimental verification is complete. I name the thing that shall purify all and evolve all 'Huitzilopochtli,' or the 'Sweeping Skyfire'...\"","nextNodeIds":[751750104]},{"nodeId":751750104,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":1527871298,"text":"\"Not that this matters. Names shall lose meaning in this place very soon, after all.\"","nextNodeIds":[751750105]},{"nodeId":751750105,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":21029050,"text":"\"The Astral Assemblages must be activated and actively attached to serve as countermeasures against corruption. Before they are completely warped by the Abyss, they will self-destruct and eliminate its influence...\"","nextNodeIds":[751750106]},{"nodeId":751750106,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":3882950530,"text":"But how will you accurately identify targets as having been corrupted? A controllable specimen...","nextNodeIds":[751750107]},{"nodeId":751750107,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":1967770970,"text":"Self-experimentation? Has sanity deserted you?","nextNodeIds":[751750108]},{"nodeId":751750108,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":3169478754,"text":"\"Hah. This too, is well. If nothing else, this decrepit body may still serve in this manner.\"","nextNodeIds":[751750109]},{"nodeId":751750109,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":4083762170,"text":"So, you shall be the least likely to survive once this system is activated, then?","nextNodeIds":[751750110]},{"nodeId":751750110,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":1932229674,"text":"Has the Abyss at last rotted your mind? Or... do you simply wish for all your kin to be martyred upon your funeral pyre?","nextNodeIds":[751750111]},{"nodeId":751750111,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":3302877242,"text":"\"Such little faith you have in your people! All the lords have consented to this, save you.\"","nextNodeIds":[751750112]},{"nodeId":751750112,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":3433378890,"text":"They merely follow your plan as though blind, never once considering the true meaning behind the scheme... This action does not have my consent.","nextNodeIds":[751750113]},{"nodeId":751750113,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":3162285994,"text":"\"...That matters little. Destruction... shall also be rebirth. I have made my mind up as such.\"","nextNodeIds":[751750114]},{"nodeId":751750114,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":3931167722,"text":"\"Hah... I fear this is as much time as I can spend awake each day. In any case, I shall activate it once all is prepared.\"","nextNodeIds":[751750115]},{"nodeId":751750115,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":769638482,"text":"Is there no room for a different course? I am still searching for another way... Are you certain that you are not bathing the world in flame over some personal grudge?","nextNodeIds":[751750116]},{"nodeId":751750116,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":4229670994,"text":"\"Perhaps! I will do anything it takes to keep our shadow-foe beyond the circles of this world.\"","nextNodeIds":[751750117]},{"nodeId":751750117,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":3330724882,"text":"\"Hah. Besides, 'another way,' you say... Will you really find what you seek from those 'humans' of yours? You are in too deep already. I see it...\"","nextNodeIds":[751750118]},{"nodeId":751750118,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":82306738,"text":"\"I once tried to make you understand... But just as it was with those of our line who sought wisdom through the pools of flame, knowledge and acceptance are two different things.\"","nextNodeIds":[751750119]},{"nodeId":751750119,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":94018594,"text":"...","nextNodeIds":[751750120]},{"nodeId":751750120,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":3347344962,"text":"\"If you believe that I simply wish for 'destruction,' whereas you have a world you wish to construct... Then stop me. Slay me. Prove yourself to me!\"","nextNodeIds":[751750121]},{"nodeId":751750121,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":344891018,"text":"\"But know this, Kukulkan, though it be not prophecy — simply advice from one who once walked this path. A day shall come...\"","nextNodeIds":[751750122]},{"nodeId":751750122,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","textMapHash":802566682,"text":"\"...When you shall tread the same road as I.\"","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7517501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["101","610101019,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["101","610101007"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["101","610102175"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["610101156","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["101","610101170,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[101_42:53.188,699.191,292.512]"],"NOCCOBOFKHP":101,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7517501],"speakerCounts":[{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":21806,"speakerName":"","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","count":8},{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1228369254,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_RANK_ZERO_WQ","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENN