UEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7418603,"initDialog":741860301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21338,21346,1005],"performCfg":"QuestDialogue/WQ/Fontaine_74186/Q7418603","priority":5,"questId":74186,"showRandomTalkCount":0},"dialogs":[{"nodeId":741860301,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":1324034410,"text":"Dominus Cassiodor! Dominus Cassiodor... Is that you?","nextNodeIds":[741860302]},{"nodeId":741860302,"roleType":"TALK_ROLE_NPC","speakerId":21338,"speakerName":"Osse","textMapHash":3375899658,"text":"...","nextNodeIds":[741860303]},{"nodeId":741860303,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":3592379010,"text":"It is you! Just as I thought! You've finally returned...","nextNodeIds":[741860304]},{"nodeId":741860304,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":3296081666,"text":"I was ordered to guard this fortress, but the cruel Vishaps and attacks of the barbarians were simply too much for me, so I was forced back step by step until I arrived here.","nextNodeIds":[741860305]},{"nodeId":741860305,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":925779114,"text":"It seems as though many, many years have passed since then... What tidings from beyond? Were we victorious?","nextNodeIds":[741860306]},{"nodeId":741860306,"roleType":"TALK_ROLE_NPC","speakerId":21338,"speakerName":"Osse","textMapHash":3084165162,"text":"...","nextNodeIds":[741860307]},{"nodeId":741860307,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":3561324738,"text":"...Is that so? Then we lost.","nextNodeIds":[741860308]},{"nodeId":741860308,"roleType":"TALK_ROLE_NPC","speakerId":21338,"speakerName":"Osse","textMapHash":229607514,"text":"I am sorry...","nextNodeIds":[741860309]},{"nodeId":741860309,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":2037339210,"text":"Do not say such things, Honored Dominus. I had already imagined this day might come when I joined the Sebastos's legions.","nextNodeIds":[741860310]},{"nodeId":741860310,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":3701301050,"text":"Did the Sebastos not say that he wanted to lead us to break the shackles of \"Fortuna\"? But is doing so that simple?","nextNodeIds":[741860311]},{"nodeId":741860311,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":590214274,"text":"After all, what we struggle against is fate itself, and defying fate is a feat beyond even the greatest of the gods.","nextNodeIds":[741860312]},{"nodeId":741860312,"roleType":"TALK_ROLE_NPC","speakerId":21338,"speakerName":"Osse","textMapHash":3483881202,"text":"In the end, all our efforts were in vain...","nextNodeIds":[741860313]},{"nodeId":741860313,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":671767442,"text":"Nay, say not so, Dominus. We took up arms against divine destiny, and our deeds challenged the laws of heaven. We resisted that prophecy, resisted it most valiantly...","nextNodeIds":[741860314]},{"nodeId":741860314,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":1177784730,"text":"Though we failed in the end... Someone must have betrayed us, led us astray...","nextNodeIds":[741860315]},{"nodeId":741860315,"roleType":"TALK_ROLE_NPC","speakerId":21346,"speakerName":"Nameless Golem","textMapHash":3944747698,"text":"Still, the outcome no longer matters. Come what may, our deeds shall be carved into this world's \"history\"...","nextNodeIds":[741860316]},{"nodeId":741860316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1978731506,"text":"Hey! Why did he just fall over like that? Can stone people also just... suddenly faint?","nextNodeIds":[741860317]},{"nodeId":741860317,"roleType":"TALK_ROLE_NPC","speakerId":21338,"speakerName":"Osse","textMapHash":2758921186,"text":"I still do not know his name... It appears his \"history\" has now reached its conclusion.","nextNodeIds":[741860318]},{"nodeId":741860318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3078845570,"text":"Wait, that's so sad! Has he just been fighting here, all these thousands of years?","nextNodeIds":[741860319]},{"nodeId":741860319,"roleType":"TALK_ROLE_NPC","speakerId":21338,"speakerName":"Osse","textMapHash":3098964522,"text":"But now, he is finally at peace. Let us continue onward.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7418603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["11","511010138,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":11,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7418604,"order":4,"stepDescription":"","stepDescTextMapHash":114156476,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7418604"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFN