{"mainQuestId":76508,"title":"Dance Exchanges — A Beautiful Start","description":"You encounter a group of unusual visitors from Sumeru at the People of the Springs...","titleTextMapHash":267043935,"descTextMapHash":1305911790,"mainQuestExcel":{"mainQuestId":76508,"titleTextMapHash":267043935,"title":"Dance Exchanges — A Beautiful Start","descTextMapHash":1305911790,"description":"You encounter a group of unusual visitors from Sumeru at the People of the Springs...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5296,"luaPath":"Actor/Quest/WQ76508","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5296,"chapterId":0,"descTextMapHash":1305911790,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76508,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1638203889,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76508","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176508],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":267043935,"type":"WQ","unlockDescTextMapHash":3954309254}},"flow":[{"subQuestId":7650801,"order":1,"stepDescription":"Go to the People of the Springs","stepDescTextMapHash":1392929284,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_350200532:-2836.322,213.719,9054.345,0.000,265.916,0.000]","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7650801],"talks":[{"talkId":7650801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7650801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7650801,"initDialog":765080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30891],"performCfg":"QuestDialogue/WQ/Natlan_76508/Q7650801","priority":5,"questId":76508,"showRandomTalkCount":0},"dialogs":[{"nodeId":765080101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1455176402,"text":"Are the People of the Springs holding some kind of event? Seems like there's more visitors around here...","nextNodeIds":[765080102]},{"nodeId":765080102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3977064010,"text":"Paimon sees someone from Sumeru over there, too... and they're putting on some kind of dance performance?","nextNodeIds":[765080103]},{"nodeId":765080103,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":4167486106,"text":"Ay-yai-yai! I see that our dazzling hero and the adorable Advisor Paimon are here too!","nextNodeIds":[765080104]},{"nodeId":765080104,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":4168183578,"text":"To the warrior I respect most, champion of both the martial and dance arts, and connoisseur of life — I extend to you my most sincere greetings!","nextNodeIds":[765080105]},{"nodeId":765080105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3140329314,"text":"Mmm, you look kinda familiar, Miss...","nextNodeIds":[765080106]},{"nodeId":765080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":774612178,"text":"#Also, how is it you know that dancing makes {NICKNAME} really happy?","nextNodeIds":[765080107]},{"nodeId":765080107,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1063101722,"text":"#That's because I saw {M#him}{F#her} having such a good time dancing at the Stadium of the Sacred Flame!","nextNodeIds":[765080108]},{"nodeId":765080108,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2640550042,"text":"#After we took a picture together, I went off to an inconspicuous corner to watch {NICKNAME} dance while munching on my Saurus Crackers.","nextNodeIds":[765080109]},{"nodeId":765080109,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1763405178,"text":"Dancing is all about relaxing and letting yourself go! I had to stop myself from jumping up there to play backup dancer!","nextNodeIds":[765080110,765080112]},{"nodeId":765080110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2618502978,"text":"Ah, I remember you now!","nextNodeIds":[765080111]},{"nodeId":765080111,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":4037753082,"text":"And I'm most honored that you do!","nextNodeIds":[765080114]},{"nodeId":765080114,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1465311954,"text":"Jokes aside, as you can see, we have a few friends from Sumeru here with us.","nextNodeIds":[765080115]},{"nodeId":765080115,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":3152362114,"text":"Mutota, Amina, Pacal, and Mualani came together, and it was decided that the Flower-Feather Clan would host them together with the Children of Echoes and People of the Springs.","nextNodeIds":[765080116]},{"nodeId":765080116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1027482954,"text":"Looks like there are quite a few Eremite mercenaries here too...","nextNodeIds":[765080117]},{"nodeId":765080117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1962087322,"text":"Let me guess, you folks became friends with them after some sort of fight or skirmish?","nextNodeIds":[765080118]},{"nodeId":765080118,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2298940914,"text":"Heh, sort of! But we didn't fight each other, if that's what you're thinking.","nextNodeIds":[765080119]},{"nodeId":765080119,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2221785866,"text":"So, we were having a barbecue party at the southern edge of the Desert of Hadramaveth when this bunch of vicious red vultures showed up and attacked us, right when we were too stuffed to even move...","nextNodeIds":[765080120]},{"nodeId":765080120,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2017832634,"text":"And they were using all these really sneaky tactics. We tried to fight them the best we could, but they eventually wore us down with their use of the terrain there. In the end, we were so exhausted we had no choice but to beat a retreat.","nextNodeIds":[765080121]},{"nodeId":765080121,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2819744938,"text":"To our surprise, we ran into a group of mercenaries while pulling back, and they started up this mysterious war-dance right in front of the vultures...","nextNodeIds":[765080122]},{"nodeId":765080122,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":3579153874,"text":"That must have sent some kind of message to the vultures, because they actually backed off after that!","nextNodeIds":[765080123]},{"nodeId":765080123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2487541530,"text":"Did you just say that they shooed off the red vultures with a... war-dance?","nextNodeIds":[765080124,765080125]},{"nodeId":765080124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1221859186,"text":"I can't imagine how terrifyingly odd those dance moves must've been...","nextNodeIds":[765080126]},{"nodeId":765080126,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1602368906,"text":"Totally incredible, isn't it? We were really curious about the secret of that dance too!","nextNodeIds":[765080127]},{"nodeId":765080127,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":3237700866,"text":"After tidying up the camp, we ate and drank to our hearts' content, and it was only after we were done that we started swapping pointers on dance techniques...","nextNodeIds":[765080128]},{"nodeId":765080128,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2440773562,"text":"After that, whenever we were interrupted by other monsters or wild beasts, we'd simply grab our weapons and let them have it!","nextNodeIds":[765080129]},{"nodeId":765080129,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1279979178,"text":"In less than two weeks, we became ironclad battle buddies *and* dance buddies for life!","nextNodeIds":[765080130]},{"nodeId":765080130,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1145791146,"text":"And before we said our goodbyes, we agreed to formally visit each other's camps in the future to keep the \"dance exchange\" going. This is the beginning of that.","nextNodeIds":[765080131]},{"nodeId":765080131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":367016322,"text":"#Wait, {NICKNAME} — Paimon doesn't think we've ever taken part in this sort of... dance exchange between the peoples of Sumeru and Natlan before, have we?","nextNodeIds":[765080132,765080133]},{"nodeId":765080132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3652107194,"text":"Nope. It does sound pretty novel to me.","nextNodeIds":[765080134]},{"nodeId":765080134,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1282260122,"text":"Since we have such a special opportunity, how about you give us a masterclass while you're with us?","nextNodeIds":[765080135]},{"nodeId":765080135,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2850077842,"text":"Mualani's here too, by the way. Definitely the most joyful dance rep among us.","nextNodeIds":[765080136]},{"nodeId":765080136,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2809622282,"text":"Besides, our friends from The Eremites have gone all out and hired one of their famous local dancers to lead and advise the Sumeru group.","nextNodeIds":[765080137]},{"nodeId":765080137,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1250276098,"text":"I'm sure you two know that dancer too!","nextNodeIds":[765080138]},{"nodeId":765080138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4005405770,"text":"Paimon thinks she knows who you're talking about. Heh, we should give her a big surprise later...","nextNodeIds":[765080139,765080140]},{"nodeId":765080139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2392445530,"text":"Ha! Count me in!","nextNodeIds":[765080141]},{"nodeId":765080141,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2605459154,"text":"Haha! This day just keeps getting better! As Mualani would say, the vibe is now absolutely vibing!","nextNodeIds":[765080142]},{"nodeId":765080142,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1599138426,"text":"Come, come, let's go look for lil' Taraneh!","nextNodeIds":[]},{"nodeId":765080140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3538773346,"text":"I refuse to miss out on something like this!","nextNodeIds":[765080141]},{"nodeId":765080133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2912261754,"text":"I'd love to see it for myself.","nextNodeIds":[765080134]},{"nodeId":765080125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3086322786,"text":"Are you sure those vultures weren't already acquainted with the mercenaries or something?","nextNodeIds":[765080126]},{"nodeId":765080112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":744958474,"text":"I definitely won't forget you from now on.","nextNodeIds":[765080113]},{"nodeId":765080113,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":3796490650,"text":"Haha! That's exactly the kick in the rear I need. Guess I've gotta push myself harder and do something truly remarkable!","nextNodeIds":[765080114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_350200532:-2836.322,213.719,9054.345,0.000,265.916,0.000]","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7650802,"order":2,"stepDescription":"Talk to Taraneh","stepDescTextMapHash":1728454068,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["4170"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7650803],"talks":[{"talkId":7650803,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7650802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7650803,"initDialog":765080301,"nextRandomTalks":[],"nextTalks":[],"npcId":[4170],"performCfg":"QuestDialogue/WQ/Natlan_76508/Q7650803","priority":5,"questId":76508,"showRandomTalkCount":0},"dialogs":[{"nodeId":765080301,"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","textMapHash":2537405066,"text":"#Oh my, oh my! If it isn't the famous {NICKNAME}?","nextNodeIds":[765080302]},{"nodeId":765080302,"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","textMapHash":3519318122,"text":"And here I thought we were already exceptionally fortunate to have Miss Nilou with us. Now, we have the ultimate pro here too!","nextNodeIds":[765080303]},{"nodeId":765080303,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":2762693938,"text":"#Oh, yeah, keep going, keep complimenting {NICKNAME}. It's music to my ears!","nextNodeIds":[765080304]},{"nodeId":765080304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3655195122,"text":"Huh? Wasn't Paimon the one who was supposed to say that?","nextNodeIds":[765080305]},{"nodeId":765080305,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":3906023130,"text":"That's right! Ah, when Advisor Paimon says the same words, they sound so light and nimble, like the soft, bouncy sound of a ukulele...","nextNodeIds":[765080306]},{"nodeId":765080306,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":4041816490,"text":"And when I say those very words, the words come out like the riffs of a drummer half a barrel deep in drink — punchy and steeped in rhythm.","nextNodeIds":[765080307]},{"nodeId":765080307,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":1843043434,"text":"Of course, I've learned from Master Iansan that double-kicking the bass drum is always better. Ideally, it should roll nonstop like an automatic gun.","nextNodeIds":[765080308]},{"nodeId":765080308,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","textMapHash":3732099794,"text":"So, it doesn't really matter if we share the same lines, because we complement each other with our voices anyway, like in a chorus. Besides, we can even help you nail the rhythm.","nextNodeIds":[765080309]},{"nodeId":765080309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2395045666,"text":"H—Huh? What in the world are you going on about...?","nextNodeIds":[765080310]},{"nodeId":765080310,"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","textMapHash":451470714,"text":"I think Nusta got straight to the heart of the matter — rhythm.","nextNodeIds":[765080311]},{"nodeId":765080311,"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","textMapHash":3368033306,"text":"Just because our dance is free and expressive doesn't mean we can do whatever we want. At the very least, we still have to make sure our key movements land right on the beat.","nextNodeIds":[765080312]},{"nodeId":765080312,"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","textMapHash":1995151218,"text":"We already have the new choreography in place, but our newcomers and... the new saurians who have come to try it out are struggling to find their rhythm.","nextNodeIds":[765080313]},{"nodeId":765080313,"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","textMapHash":1097427722,"text":"#Since you're here, {NICKNAME}, would you mind helping us out as a rhythm coach?","nextNodeIds":[765080314]},{"nodeId":765080314,"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","textMapHash":1644729426,"text":"I bet that our newcomers and new saurians will be able to focus up and learn quickly with you around!","nextNodeIds":[765080315,765080316]},{"nodeId":765080315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3074157458,"text":"Sure! My rhythm's rock solid.","nextNodeIds":[765080317]},{"nodeId":765080317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":730706066,"text":"Um... Then... Paimon'll cheer you on from the sidelines...?","nextNodeIds":[765080318]},{"nodeId":765080318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2974511906,"text":"And... she'll also send everyone you're leading her moral support!","nextNodeIds":[]},{"nodeId":765080316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3802433370,"text":"I may not be a professional, but I'm confident I can pull this off.","nextNodeIds":[765080317]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7650801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["4170"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7650801,7650803],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"Nusta","count":30},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":4170,"speakerName":"Taraneh","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[176508],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1305911790,"CHECNJEMEFE":{"30891":[1230],"4170":[4402,1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_76508/Q7650801","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],