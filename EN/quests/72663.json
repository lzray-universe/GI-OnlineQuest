e/WQ/Daoqi_72663/Q7266301","priority":5,"questId":72663,"showRandomTalkCount":0},"dialogs":[{"nodeId":726630101,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":592406282,"text":"There you are, sorry to bother you again.","nextNodeIds":[726630102]},{"nodeId":726630102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1002743482,"text":"You look well.","nextNodeIds":[726630103]},{"nodeId":726630103,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1866920866,"text":"Haha, thanks for the compliment. I kind of thought it through.","nextNodeIds":[726630104]},{"nodeId":726630104,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3766597050,"text":"Perhaps, some things just can't be forced.","nextNodeIds":[726630105]},{"nodeId":726630105,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2725544226,"text":"Can you accompany me to the western beach tonight? I have something for you.","nextNodeIds":[726630106]},{"nodeId":726630106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2450369426,"text":"Wow, is it some kind of sea treasure!","nextNodeIds":[726630107]},{"nodeId":726630107,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":169294018,"text":"You'll see.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3200"],"NOCCOBOFKHP":3,"O