0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"19,22"}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266305,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7266304,"order":20,"stepDescription":"Talk to Kujirai Momiji","stepDescTextMapHash":2168527100,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3200"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7266302],"talks":[{"talkId":7266302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7266304","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7266302,"initDialog":726630201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3200,1005],"performCfg":"QuestDialogue/WQ/Daoqi_72663/Q7266302","priority":5,"questId":72663,"showRandomTalkCount":0},"dialogs":[{"nodeId":726630201,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":814390578,"text":"We're here. This is where my father went to sea for the last time that year. It was a night like this too, and I never saw him again after that.","nextNodeIds":[726630202]},{"nodeId":726630202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3776552514,"text":"You miss him a lot, don't you? Is your wish to see your father again?","nextNodeIds":[726630203]},{"nodeId":726630203,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":147213042,"text":"Haha, I do miss him, but the people of the sea will have to return to the sea one day.","nextNodeIds":[726630204]},{"nodeId":726630204,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1828568562,"text":"But my wish is to become a fisherman who surpasses my father.","nextNodeIds":[726630205]},{"nodeId":726630205,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3430108074,"text":"When I was young, I always wanted to sail with my father, but he would only let my mother take me back. He sometimes even took the neighbor's son, and was not willing to take me.","nextNodeIds":[726630206]},{"nodeId":726630206,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3459029802,"text":"He always said, \"Momiji, don't hang around on the beach, go do something girls should do.\" Or he would say, \"Take the money and buy a dress, don't run to the boat all the time.\" ...","nextNodeIds":[726630207]},{"nodeId":726630207,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1788925626,"text":"But I didn't understand. Why? What are things that girls should do?","nextNodeIds":[726630208]},{"nodeId":726630208,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2817105186,"text":"I can buy candy, pick flowers, and be a little princess.","nextNodeIds":[726630209]},{"nodeId":726630209,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1897737386,"text":"But can't I go on an adventure, go far out to sea, or explore the ocean?","nextNodeIds":[726630210]},{"nodeId":726630210,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1513559458,"text":"The more my father didn't want me to do it, the more I wanted to. After my father left, I became a fisherman.","nextNodeIds":[726630211]},{"nodeId":726630211,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":121225514,"text":"Those seas he couldn't explore, I'll explore then. Those large fishes he couldn't catch, I'll catch them.","nextNodeIds":[726630212]},{"nodeId":726630212,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":4223995418,"text":"I will inherit the fishing methods of the Kujirai family. I will carry on the name of the Kujirai family of fishermen.","nextNodeIds":[726630213]},{"nodeId":726630213,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":526251338,"text":"Even if the legend of the \"Lunar Leviathan\" is just a legend, I won't stop there.","nextNodeIds":[726630214]},{"nodeId":726630214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3837962834,"text":"I believe you will succeed.","nextNodeIds":[726630215]},{"nodeId":726630215,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2159589082,"text":"Thank you.","nextNodeIds":[726630216]},{"nodeId":726630216,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3631455722,"text":"Since the divine fish is not here, I will pour my wishes into the sea. I think my father will see it.","nextNodeIds":[726630217]},{"nodeId":726630217,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":517712746,"text":"Do you have any wishes? Let's do this together, write down your wishes, stuff them into a drifting bottle, and throw it out with all your might. They will come true one day.","nextNodeIds":[726630218]},{"nodeId":726630218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3203827802,"text":"Wow— Does this really work?","nextNodeIds":[726630219]},{"nodeId":726630219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4216172634,"text":"But Paimon has so many wishes, which one to write... Paimon's so torn!","nextNodeIds":[726630220]},{"nodeId":726630220,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":988451226,"text":"Sorry for bothering you during this time! I don't even know how to thank you. Here are some gifts, I hope you don't mind...","nextNodeIds":[726630221]},{"nodeId":726630221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4235705682,"text":"Wow— Look, what's that!","nextNodeIds":[726630222]},{"nodeId":726630222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2470561786,"text":"What a big school of fish! They're glowing, they seem to like our drifting bottles!","nextNodeIds":[726630223]},{"nodeId":726630223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2332700378,"text":"When these guys gather together, it's like a big moon in the sea!","nextNodeIds":[726630224]},{"nodeId":726630224,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":951427762,"text":"These...these fish, they are \"Moonfins\"...","nextNodeIds":[726630225]},{"nodeId":726630225,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":591649682,"text":"Oh! I know...I know! So this is the \"Lunar Leviathan!\"","nextNodeIds":[726630226]},{"nodeId":726630226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":719724826,"text":"Eh? This is the \"Lunar Leviathan?\"","nextNodeIds":[726630227]},{"nodeId":726630227,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3683202354,"text":"That's right, I would never forget the way it looked. Its starry moonlit dots...That year that \"Lunar Leviathan\" also appeared under Jiawei when he dropped the drift bottle.","nextNodeIds":[726630228]},{"nodeId":726630228,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":340308098,"text":"No wonder, after all these years, no one's been really able to catch the \"Lunar Leviathan!\"","nextNodeIds":[726630229]},{"nodeId":726630229,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":580257794,"text":"Because it turns out, it is just composed of a school of \"Moonfins.\"","nextNodeIds":[726630230]},{"nodeId":726630230,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":130480850,"text":"Those \"Moonfins\"...Who would have thought they would like an ordinary drifting bottle?","nextNodeIds":[726630231]},{"nodeId":726630231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":832017474,"text":"Hehe, maybe they like the wishes that people pour into the bottles.","nextNodeIds":[726630232]},{"nodeId":726630232,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1316661682,"text":"Haha! Perhaps, well then watch me Kujirai Momiji catch them all!","nextNodeIds":[726630233]},{"nodeId":726630233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2128839514,"text":"We want to come too! Let us help!","nextNodeIds":[726630234]},{"nodeId":726630234,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3479050298,"text":"In that case, allow me to give you this fishing rod. It was specially made by the Kujirai family in pursuit of the \"Lunar Leviathan\".","nextNodeIds":[726630235]},{"nodeId":726630235,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3804031386,"text":"Although it is far from being able to express my gratitude to you, but it is a small token of my appreciation.","nextNodeIds":[726630236]},{"nodeId":726630236,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2039469530,"text":"Let's use it to catch all the \"Moonfins\"!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133213365","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133212564","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["3","401"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3200"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7266303,"order":21,"stepDescription":"","stepDescTextMapHash":4206432396,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266303,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q72662_jingjinghua2","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266303,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133213365,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJ