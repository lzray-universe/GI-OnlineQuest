716663106]},{"nodeId":716663106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":633487738,"text":"Looks like Buttercup of Terror has a real knack for this... Kinda terrifying!","nextNodeIds":[716663107]},{"nodeId":716663107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2647194890,"text":"Hey, Bull-Chucker, if you had this kind of talent, you could probably have learned how to communicate with shelled creatures just by listening to Guoba talk to Crystal Tornado.","nextNodeIds":[716663108]},{"nodeId":716663108,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3670803490,"text":"Hah... Haha, hah... Yeah, I wish!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166631,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7166630,7166631,7166633],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":30472,"speakerName":"Buttercup of Terror","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":414579134,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA