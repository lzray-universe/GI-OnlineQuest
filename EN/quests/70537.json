kerId":30415,"speakerName":"Suspicious Wooden Chest","textMapHash":3320307178,"text":"A suspicious wooden box, never seen before. A piece of paper is lodged in the cracks between the boards on the lid. Written on it is \"Property of the Investigation Team. Materials of the highest grade of danger are within. Handle with care.\"","nextNodeIds":[]}]},{"talkId":7053711,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["5160","5160001","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["7053701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7053711,"initDialog":705371101,"nextRandomTalks":[],"nextTalks":[7053712,7053713],"npcId":[30415],"performCfg":"QuestDialogue/WQ/Fishblaster_70537/Q7053711","priority":5,"questId":70537,"showRandomTalkCount":0},"dialogs":[{"nodeId":705371101,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2877493274,"text":"Seems like it's worth \"investigating\"...","nextNodeIds":[705371102]},{"nodeId":705371102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4239971682,"text":"That note on the box sounds... terrifying!","nextNodeIds":[705371103]},{"nodeId":705371103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3523451618,"text":"Why would something so obviously dangerous be left right by Cider Lake? Could it belong to those two knights over there?","nextNodeIds":[705371104]},{"nodeId":705371104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2795951178,"text":"It looks like there's a wide gap between the planks! We should be able to see inside!","nextNodeIds":[705371105]},{"nodeId":705371105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1365122186,"text":"Let Paimon have a look... It appears to be filled with... lots of round, red objects, much larger than Sunsettias...","nextNodeIds":[705371106]},{"nodeId":705371106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":413360690,"text":"Waitasec, could they be... bombs!?","nextNodeIds":[705371107]},{"nodeId":705371107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1624857906,"text":"Why would the Knights of Favonius leave a box of explosives by the lake? Are they planning to blow up... those invasive fish that Lisa mentioned?","nextNodeIds":[]}]},{"talkId":7053712,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["5160","5160001","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["7053701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7053712,"initDialog":705371201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30415],"performCfg":"QuestDialogue/WQ/Fishblaster_70537/Q7053712","priority":5,"questId":70537,"showRandomTalkCount":0},"dialogs":[{"nodeId":705371201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2517505074,"text":"Haha! Explosives! My kind of fun!","nextNodeIds":[705371202]},{"nodeId":705371202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2728965938,"text":"Why are you suddenly so excited? We don't even know how powerful these explosives are! What if we hurt innocent bystanders?","nextNodeIds":[705371203,705371204]},{"nodeId":705371203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2352464162,"text":"Blasting fish is blasting fish, just toss 'em into the lake.","nextNodeIds":[705371205]},{"nodeId":705371205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1885428898,"text":"Eek!","nextNodeIds":[705371206]},{"nodeId":705371206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3615389578,"text":"But when you put it like that... Paimon really does want to try...","nextNodeIds":[705371207]},{"nodeId":705371207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":75145282,"text":"Normally we're always hearing about how Klee wants to blast fish, is blasting fish, or is getting punished for doing it...","nextNodeIds":[705371208]},{"nodeId":705371208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2803676002,"text":"But now that Paimon is here, by the lakeside, with a box of explosives beside her... Paimon really wants to try it, too!","nextNodeIds":[705371209]},{"nodeId":705371209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":236455226,"text":"Throwing just one should be... no big deal, right?","nextNodeIds":[705371210,705371211]},{"nodeId":705371210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":891905250,"text":"One for each of us!","nextNodeIds":[705371212]},{"nodeId":705371212,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":342085114,"text":"Together with Paimon, you open the suspicious wooden box and each take out a bomb. After studying how to ignite the fuses, both of you count down \"3, 2, 1\" and set the detonators, and both of you throw the bombs far into Cider Lake...","nextNodeIds":[705371213]},{"nodeId":705371213,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1439248722,"text":"A low rumble comes from underwater, and two giant spouts of water explode from the surface of the lake, sending a few Anglers spinning high into the sky...\\nYou and Paimon give each other a high-five with big smiles on your faces, and get ready to high-tail it out of there...","nextNodeIds":[705371214]},{"nodeId":705371214,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":237714194,"text":"But \"Operation Impulsively Secretly Blast Fish\" did not go as swimmingly as it appeared. Almost as soon as the bombs exploded, you were exposed...","nextNodeIds":[705371215]},{"nodeId":705371215,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":3064271786,"text":"Aaaaaaahhhhh!","nextNodeIds":[705371216]},{"nodeId":705371216,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":2067823674,"text":"My ears!!!","nextNodeIds":[705371217]},{"nodeId":705371217,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":1663187010,"text":"That scared me half to death! How are you, Phonia, are you okay?","nextNodeIds":[705371218]},{"nodeId":705371218,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":3372292658,"text":"A sudden underwater explosion... It almost deafened me! Judging by the sonic signature of that explosion... It must have been one of your bombs, Ematol!","nextNodeIds":[705371219]},{"nodeId":705371219,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":2925826394,"text":"Ha? Really? Have I not been standing obendiently by your side this whole time, doing nothing? Do I look like I have bombs in my hands?","nextNodeIds":[705371220]},{"nodeId":705371220,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":3253450370,"text":"You! You must've set timed bombs into the lake beforehand, just to see me in this awful state!","nextNodeIds":[705371221]},{"nodeId":705371221,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":1709237242,"text":"If that were true, then shouldn't I also have set up Kameras to capture the sight of you holding your head crying on the ground like a baby? Would be a great shame not to have such photos for posterity!","nextNodeIds":[705371222]},{"nodeId":705371222,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":307775530,"text":"You! Don't expect any discount from me for your next month's rent! And the water bill, furniture, and all that food you mooched... I let it all slide before, but now it's time to pay up!","nextNodeIds":[705371223]},{"nodeId":705371223,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":1364387530,"text":"Wait, wait, wait, no, no! I shouldn't have laughed! Phonia, my dearest sister, even if I was responsible for the last few dozen pranks... It really wasn't me this time! I swear!","nextNodeIds":[705371224]},{"nodeId":705371224,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":684493682,"text":"If I really could make... timed detonators that were extremely reliable despite staying submerged for a long time...","nextNodeIds":[705371225]},{"nodeId":705371225,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":2619932482,"text":"We wouldn't have needed to risk our lives to manually detonate the bombs when we ambushed the Hilichurls last time, would we?","nextNodeIds":[705371226]},{"nodeId":705371226,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":3352252106,"text":"...Right. You're too simple-minded to use timed fuses to pull a prank on me.","nextNodeIds":[705371227]},{"nodeId":705371227,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":779637970,"text":"You!","nextNodeIds":[705371228]},{"nodeId":705371228,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":2372241482,"text":"You tricked me, too! Didn't you say that any loud noises would damage your hearing while you're using that detection equipment?","nextNodeIds":[705371229]},{"nodeId":705371229,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":1552512530,"text":"Since you seem to have no difficulties arguing, you don't seem to have gone deaf!","nextNodeIds":[705371230]},{"nodeId":705371230,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":3130820522,"text":"You don't get it! Hearing damage is accumulative and only manifests in stages! By shouting and talking back at me so loudly right now, you're increasing the damage!","nextNodeIds":[705371231]},{"nodeId":705371231,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":2890166666,"text":"Maybe one day, I won't be able to distinguish the signature patterns of soundwaves anymore! And then I'd lose my job!","nextNodeIds":[705371232]},{"nodeId":705371232,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":661330778,"text":"And then, you won't have a place to stay either, because I would have to rent the whole house to someone who can afford higher rent! And then... then ... I'll become a fisherwoman! Anyway, I won't take of you, that's for sure!","nextNodeIds":[705371233]},{"nodeId":705371233,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":3792378802,"text":"Then... Then I'll argue with you more quietly... I'll keep it quiet...","nextNodeIds":[705371234]},{"nodeId":705371234,"roleType":"TALK_ROLE_NPC","speakerId":30401,"speakerName":"Ematol","textMapHash":205249930,"text":"...","nextNodeIds":[705371235]},{"nodeId":705371235,"roleType":"TALK_ROLE_NPC","speakerId":30400,"speakerName":"Phonia","textMapHash":2376772866,"text":"...","nextNodeIds":[705371236]},{"nodeId":705371236,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2291576610,"text":"Paimon can't make out what they're saying... All they care about is arguing with each other.","nextNodeIds":[705371237,705371238]},{"nodeId":705371237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1838577490,"text":"Yeah! That was super fun!","nextNodeIds":[705371239]},{"nodeId":705371239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":24265906,"text":"It was really fun! Maybe if we just toss one more...","nextNodeIds":[705371240]},{"nodeId":705371240,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1614403290,"text":"No, no! Once was enough. If we throw any more, those two will definitely come to investigate. We can't get caught!","nextNodeIds":[705371241]},{"nodeId":705371241,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1350976348,"text":"Though it feels like we caused... a mess, but not an overly large one, at least Paimon's curiosity has been completely satisfied!","nextNodeIds":[]},{"nodeId":705371238,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":671003162,"text":"And nothing too bad happened!","nextNodeIds":[705371239]},{"nodeId":705371211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1025537378,"text":"Now, give it all you've got!","nextNodeIds":[705371212]},{"nodeId":705371204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2117285962,"text":"Don't you want to know what it's like to chuck some bombs?","nextNodeIds":[705371205]}]},{"talkId":7053713,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishEx