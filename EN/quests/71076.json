",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7106231,"initDialog":710621201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20536],"performCfg":"","priority":11,"questId":71076,"showRandomTalkCount":0},"dialogs":[{"nodeId":710621201,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":144000954,"text":"We'll leave soon. My apologies if we've disturbed your adventure.","nextNodeIds":[710621202,710621210,710621213,710621221]},{"nodeId":710621202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2715419634,"text":"About the collaboration with the Millelith...","nextNodeIds":[710621203]},{"nodeId":710621203,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":4093442978,"text":"That was a long time ago. Shortly after this place was locked down, we contacted the Liyue Qixing.","nextNodeIds":[710621204]},{"nodeId":710621204,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":1262788602,"text":"At first, things went smoothly... Signora even nailed a few mutually beneficial trade agreements.","nextNodeIds":[710621205]},{"nodeId":710621205,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":1924370154,"text":"And one of the additional conditions was that Liyue would allow the Fatui to send an advance team into The Chasm... We came to investigate and eradicate the source of the anomalies.","nextNodeIds":[710621206]},{"nodeId":710621206,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":798149298,"text":"As agreed, Snezhnaya and Liyue would share whatever we were to find down here.","nextNodeIds":[710621207]},{"nodeId":710621207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1866982474,"text":"Don't you have other purposes?","nextNodeIds":[710621208]},{"nodeId":710621208,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":693982306,"text":"At least none that I'm aware of. When we entered The Chasm, the local citizens even sent us their best wishes. We all thought... that we would be heroes, sacrificing ourselves for the sake of others.","nextNodeIds":[710621209]},{"nodeId":710621209,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":2254263650,"text":"*sigh*... Who'd have thought things would turn out like this?","nextNodeIds":[]},{"nodeId":710621210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3657292042,"text":"About the \"Dark Calamity\"...","nextNodeIds":[710621211]},{"nodeId":710621211,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":2807672138,"text":"\"Dark Calamity,\" \"the Calamity of Darkness,\" or whatever you call it... They all mean the great disaster that occurred five hundred years ago.","nextNodeIds":[710621212]},{"nodeId":710621212,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":2407545514,"text":"Anyway, it's the eternal enemy of Snezhnaya... For five hundred years, the calamity has been lurking in the dark and we'll be on guard forever.","nextNodeIds":[]},{"nodeId":710621213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3240294858,"text":"About you...","nextNodeIds":[710621214]},{"nodeId":710621214,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":401491578,"text":"About us? There's nothing much to talk about... We fought hard and we failed. That's all.","nextNodeIds":[710621215]},{"nodeId":710621215,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":2072004634,"text":"When we first came down, we were the Ninth Company, a company of 64 soldiers. But now, I guess half of our men including our commander have either gone missing or died... Well, maybe not yet half of us...","nextNodeIds":[710621216]},{"nodeId":710621216,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":4167379818,"text":"But anyway, it's around that figure. We've been scattered and lost contact with each other... We lost this battle and should've retreated long ago.","nextNodeIds":[710621217]},{"nodeId":710621217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":141830394,"text":"But your people on the ground attacked Liyue Harbor.","nextNodeIds":[710621218]},{"nodeId":710621218,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":1207320698,"text":"...It's surprising but I think I can understand why.","nextNodeIds":[710621219]},{"nodeId":710621219,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":2433037354,"text":"To assist in endeavors of greater meaning, Lord Pulcinella won't hesitate to dispense with less valuable assets. That's his logic.","nextNodeIds":[710621220]},{"nodeId":710621220,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":1711327178,"text":"As his direct subordinate, I have no objections to his cause of action...","nextNodeIds":[]},{"nodeId":710621221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":396190234,"text":"About Katarina...","nextNodeIds":[710621222]},{"nodeId":710621222,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":351634498,"text":"Did you meet her? Is she still alive? I hope she can forgive me.","nextNodeIds":[710621223]},{"nodeId":710621223,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":1276056034,"text":"Katarina and her younger brother, Kapral Nikolay, were brought up in the House of the Hearth. They are the children of Her Majesty the Tsaritsa.","nextNodeIds":[710621224]},{"nodeId":710621224,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":7627482,"text":"She told me that she was going to find her brother. I thought she lost her mind having stayed in the environment down here... There's no way that her brother could live.","nextNodeIds":[710621225,710621230]},{"nodeId":710621225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3240409258,"text":"So you abandoned her?","nextNodeIds":[710621226]},{"nodeId":710621226,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":3534936474,"text":"Abandon? No, she... she volunteered to stay. After all, unnecessary obsessions only slow the whole team down.","nextNodeIds":[710621227]},{"nodeId":710621227,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":1416414250,"text":"We... We're prepared to sacrifice our lives or the lives of our loved ones for all... This is the resolution of the Fatui.","nextNodeIds":[710621228]},{"nodeId":710621228,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":505403218,"text":"Katya is no exception, nor is Kolya.","nextNodeIds":[710621229]},{"nodeId":710621229,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":4132463402,"text":"I wouldn't blame them if they did the same to me.","nextNodeIds":[]},{"nodeId":710621230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3390575322,"text":"The situation she's in is not so bad as you think.","nextNodeIds":[710621231]},{"nodeId":710621231,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":2345514810,"text":"You're an outsider. The Fatui can't and shouldn't get sentimental in front of civilians.","nextNodeIds":[710621232]},{"nodeId":710621232,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":3262758858,"text":"But to her, we're family. She's — she was — also our family.","nextNodeIds":[710621233]},{"nodeId":710621233,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"Anton","textMapHash":654081194,"text":"But she insisted on looking for Kolya... I hope she can forgive me.","nextNodeIds":[]}]},{"talkId":7106232,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7106207","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7105802","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7106232,"initDialog":710622601,"nextRandomTalks":[],"nextTalks":[],"