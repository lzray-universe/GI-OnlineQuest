{"mainQuestId":79074,"title":"\"Brave Northerly Wind\"","description":"In the Forest of Blessings lives a particularly passionate flying squirrel...","titleTextMapHash":908186871,"descTextMapHash":1990336934,"mainQuestExcel":{"mainQuestId":79074,"titleTextMapHash":908186871,"title":"\"Brave Northerly Wind\"","descTextMapHash":1990336934,"description":"In the Forest of Blessings lives a particularly passionate flying squirrel...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2032,"luaPath":"Actor/Quest/WQ79074","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2032,"chapterId":0,"descTextMapHash":1990336934,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":79074,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2213502513,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ79074","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[179074],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":908186871,"type":"WQ","unlockDescTextMapHash":3726983366}},"flow":[{"subQuestId":7907401,"order":1,"stepDescription":"Talk to Clanche","stepDescTextMapHash":3462943740,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30605"],"NOCCOBOFKHP":100,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7907401],"talks":[{"talkId":7907401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7907401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7907401,"initDialog":790740101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30605],"performCfg":"QuestDialogue/WQ/Island_79074/Q7907401","priority":5,"questId":79074,"showRandomTalkCount":0},"dialogs":[{"nodeId":790740101,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":1469203394,"text":"Ah, two more brave warriors step up to the plate! Are you here to play Boreal Flurry?","nextNodeIds":[790740102]},{"nodeId":790740102,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":3567144890,"text":"Come then, right this way! I'm looking forward to witnessing your unmatched powers of flight!","nextNodeIds":[790740103,790740104]},{"nodeId":790740103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3363978466,"text":"Whoa, cool it!","nextNodeIds":[790740105]},{"nodeId":790740105,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":917539914,"text":"One needn't keep cool to fly, dear guest, not at all!","nextNodeIds":[790740106]},{"nodeId":790740106,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":3159117202,"text":"A cool head will merely dull your sense of the wind — only one who faces the wild wind utterly unprepared may uncover their true potential.","nextNodeIds":[790740107]},{"nodeId":790740107,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":1947108402,"text":"Flying squirrels nowadays are far too timid! They've utterly forgotten the lessons taught by the \"Brave Northerly Wind\"!","nextNodeIds":[790740108]},{"nodeId":790740108,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":589242802,"text":"They stand in safe spots and declaim the courage of leaves that dance in the wind, yet are far too frightened to leap into its embrace themselves.","nextNodeIds":[790740109]},{"nodeId":790740109,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":2411540650,"text":"How can we protect the kingdom alongside Her Highness if things keep going this way? Ludicrous! Ludicrous, I say!","nextNodeIds":[790740110]},{"nodeId":790740110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2128913834,"text":"Man, this flying squirrel sure is the energetic type...","nextNodeIds":[790740111]},{"nodeId":790740111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1374939098,"text":"Looks like he really loves flying.","nextNodeIds":[790740112]},{"nodeId":790740112,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":1422581378,"text":"And that's why I found myself a passage with especially intense wind currents, and set up all sorts of devices inside it.","nextNodeIds":[790740113]},{"nodeId":790740113,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":4055912202,"text":"Only the bravest, the boldest, and the most bellicose in flight shall best its course.","nextNodeIds":[790740114]},{"nodeId":790740114,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":530596666,"text":"Do you have the required courage, dear guests?","nextNodeIds":[790740115,790740117]},{"nodeId":790740115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2107026354,"text":"I'll have a right go at it!","nextNodeIds":[790740116]},{"nodeId":790740116,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":1898853226,"text":"Excellent! Follow me, then! The passage is not far from here!","nextNodeIds":[]},{"nodeId":790740117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1742734298,"text":"Well... I've got other things to do...","nextNodeIds":[790740118]},{"nodeId":790740118,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":3234588882,"text":"Oh? Still need some time to prepare, then? Fret not, I shall wait here.","nextNodeIds":[790740119]},{"nodeId":790740119,"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","textMapHash":2374035210,"text":"Come back whenever you'd like to brave this windy passage.","nextNodeIds":[]},{"nodeId":790740104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4157120242,"text":"I haven't said anything yet!","nextNodeIds":[790740105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30605"],"NOCCOBOFKHP":100,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7907401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30605,"speakerName":"Clanche","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[179074],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1990336934,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Island_79074/Q7907401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHG