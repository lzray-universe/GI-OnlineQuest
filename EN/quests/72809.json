HP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["3083"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7280902],"talks":[{"talkId":7280902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7280907","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7280902,"initDialog":728090204,"nextRandomTalks":[],"nextTalks":[],"npcId":[3083],"performCfg":"","priority":5,"questId":72809,"showRandomTalkCount":0},"dialogs":[{"nodeId":728090204,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":2617243986,"text":"Thank you, Traveler, thank you so much for your help...","nextNodeIds":[728090205]},{"nodeId":728090205,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":3982704346,"text":"If not for you, this place would have been my grave today...","nextNodeIds":[728090206,728090208]},{"nodeId":728090206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":349381202,"text":"You set this camp up?","nextNodeIds":[728090207]},{"nodeId":728090207,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":1927570050,"text":"Um, you could say so.","nextNodeIds":[728090210]},{"nodeId":728090210,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":1727720754,"text":"I mean, you know that doing business is hard here on Ritou. This camp is... well, you can consider it a little trick of mine.","nextNodeIds":[728090211]},{"nodeId":728090211,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":350951978,"text":"Some days back, I commissioned a... friend to ship me some alcohol-making ingredients from Mondstadt.","nextNodeIds":[728090212]},{"nodeId":728090212,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":2494622802,"text":"He then got a test batch of new product from the Dawn Winery, which was just shipped here.","nextNodeIds":[728090213]},{"nodeId":728090213,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":3618451290,"text":"But he hasn't been all that careful, so some of the boxes are broken, and the cap on a bottle of alcohol-making ingredients was loosened.","nextNodeIds":[728090214]},{"nodeId":728090214,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":3796140834,"text":"I decided to unscrew it so that I could then reinstall it.","nextNodeIds":[728090215]},{"nodeId":728090215,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":26647346,"text":"But I never expected that a whole bunch of slimes would come jumping out of the unscrewed cap. What a strange occurrence.","nextNodeIds":[728090216]},{"nodeId":728090216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2740749042,"text":"Brewing ingredients from the Dawn Winery, huh...","nextNodeIds":[728090217]},{"nodeId":728090217,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":842012658,"text":"Ah, it doesn't matter right now. As for the ingredients, I'll settle with that fellow the next time he comes by.","nextNodeIds":[728090218]},{"nodeId":728090218,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":3423149306,"text":"You've saved my life, and I owe you something for it. Take these first, then.","nextNodeIds":[728090219]},{"nodeId":728090219,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":640826258,"text":"That aside, you see that small boat over there? That's another one of my little tricks.","nextNodeIds":[728090220]},{"nodeId":728090220,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":142163258,"text":"Using that boat, you can sneak over to Narukami Island from here. Convenient, huh?","nextNodeIds":[728090221]},{"nodeId":728090221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2262830738,"text":"And why would I need to \"sneak\"...","nextNodeIds":[728090222]},{"nodeId":728090222,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":3801958178,"text":"Ah, you see, this is what they call \"expecting the unexpected.\"","nextNodeIds":[728090223]},{"nodeId":728090223,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":1515478210,"text":"Well, I need to go back and take stock of those goods, so I can't stay here long. Once again, thank you so much, Traveler.","nextNodeIds":[728090224]},{"nodeId":728090224,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":336760946,"text":"Looks like I'll have to change up my pick-up spot.","nextNodeIds":[]},{"nodeId":728090208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":894507786,"text":"What are you up to here?","nextNodeIds":[728090209]},{"nodeId":728090209,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":23007746,"text":"I'm, ah, moving goods! Moving goods...","nextNodeIds":[728090210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133209046,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["3083"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7280901,7280902],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","count":25},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[172809],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1234327766,"CHECNJEMEFE":{"3083":[4190,1300]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k_