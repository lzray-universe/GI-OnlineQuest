,"textMapHash":1221432986,"text":"Took them long enough...","nextNodeIds":[728090110]},{"nodeId":728090110,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":2458453794,"text":"Agh, and this box is broken on one side, too!","nextNodeIds":[728090111]},{"nodeId":728090111,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":197164962,"text":"Come on! I told him to be careful. Let's just hope nothing inside is broken...","nextNodeIds":[728090112]},{"nodeId":728090112,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":2884844578,"text":"Phew, looks like none of the bottles broke...","nextNodeIds":[728090113]},{"nodeId":728090113,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":1312693290,"text":"Eh? Why's this bottle's cap loose? You have to unscrew it first before installing it, come on...","nextNodeIds":[728090114]},{"nodeId":728090114,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":3979510866,"text":"*cough* And these alcohol-making ingredients have too strong a flavor, let's move them out first...","nextNodeIds":[728090115]},{"nodeId":728090115,"roleType":"TALK_ROLE_NPC","speakerId":3083,"speakerName":"Harrison","textMapHash":3505155586,"text":"Eh!? What are all these slimes doing here?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3083"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_N