erId":4042,"speakerName":"Ahangar","textMapHash":1258965882,"text":"Now that we have the Iron Chunks, I'm going back to work. You, back off!","nextNodeIds":[230150304]},{"nodeId":230150304,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":189954578,"text":"Ahangar swings his hammer so fiercely that Garcia has to back away from him...","nextNodeIds":[230150305]},{"nodeId":230150305,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1929728082,"text":"Let's leave Mr. Ahangar to his work. Here's your payment.","nextNodeIds":[230150306]},{"nodeId":230150306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1605358522,"text":"I hope you will succeed this time.","nextNodeIds":[230150307]},{"nodeId":230150307,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":3049218754,"text":"That means so much. Thank you, Traveler.","nextNodeIds":[230150308]},{"nodeId":230150308,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":46851194,"text":"I am... cautiously pessimistic about this.","nextNodeIds":[230150309]},{"nodeId":230150309,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":294382626,"text":"Mr. Garcia is a genius with machines. That much is beyond doubt.","nextNodeIds":[230150310]},{"nodeId":230150310,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":3836291690,"text":"But if you ask me, the machine that Mr. Garcia envisions requires much more than just one \"genius.\"","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["42022","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_DAILY_TASK_VAR"},{"LNHLPKELCAL":["42022"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCEN