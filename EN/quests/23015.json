5,"questId":23015,"showRandomTalkCount":0},"dialogs":[{"nodeId":230150101,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3289608706,"text":"This bearing is too large. It wouldn't fit...","nextNodeIds":[230150102]},{"nodeId":230150102,"roleType":"TALK_ROLE_NPC","speakerId":4042,"speakerName":"Ahangar","textMapHash":505420658,"text":"Too small last time, and too big now! You're going to use up all my Iron Chunks!","nextNodeIds":[230150103]},{"nodeId":230150103,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":3672523098,"text":"In fact, we are also about to use up all our Mora.","nextNodeIds":[230150104]},{"nodeId":230150104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3716223906,"text":"What are you arguing about?","nextNodeIds":[230150105]},{"nodeId":230150105,"roleType":"TALK_ROLE_NPC","speakerId":4042,"speakerName":"Ahangar","textMapHash":4070253666,"text":"This man asked me to forge lots of iron tubes and gears, with different requirements for each and every one of them.","nextNodeIds":[230150106]},{"nodeId":230150106,"roleType":"TALK_ROLE_NPC","speakerId":4042,"speakerName":"Ahangar","textMapHash":3775769642,"text":"I'm already using up all my Iron Chunks to forge these... things for him!","nextNodeIds":[230150107]},{"nodeId":230150107,"roleType":"TALK_ROLE_NPC","speakerId":4042,"speakerName":"Ahangar","textMapHash":3051020730,"text":"But he doesn't think that's enough, he wants even more gears.","nextNodeIds":[230150108]},{"nodeId":230150108,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":4270070826,"text":"Please allow me to explain my work again, I'm sure you will understand...","nextNodeIds":[230150109]},{"nodeId":230150109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":263361802,"text":"What are you doing here?","nextNodeIds":[230150110]},{"nodeId":230150110,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":557092666,"text":"Just let Mr. Garcia explain all this to Mr. Ahangar.","nextNodeIds":[230150111]},{"nodeId":230150111,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":2658569546,"text":"Traveler, I... Well, Mr. Garcia needs a favor. Will you collect some Iron Chunks for us?","nextNodeIds":[230150112,230150113]},{"nodeId":230150112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1369916962,"text":"I do have the time, but...","nextNodeIds":[230150114]},{"nodeId":230150114,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":497949466,"text":"About that... We have encountered some challenges, which were expected. Mr. Garcia is still pondering a solution.","nextNodeIds":[230150115]},{"nodeId":230150115,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":441625522,"text":"If this should interest you at some point in the future, feel free to ask Mr. Garcia for more information.","nextNodeIds":[230150116]},{"nodeId":230150116,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":242612234,"text":"I fear that no one really understands the exact mechanisms behind the machine, save him.","nextNodeIds":[230150117]},{"nodeId":230150117,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1189586386,"text":"But before that, please bring some Iron Chunks back here.","nextNodeIds":[]},{"nodeId":230150113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2385188802,"text":"How are the modifications to his machine going?","nextNodeIds":[230150114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDI