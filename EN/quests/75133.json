aram":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7513303,"initDialog":751330301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21460,21583,21602],"performCfg":"QuestDialogue/WQ/Natlan_75048/Q7504819","priority":5,"questId":75133,"showRandomTalkCount":0},"dialogs":[{"nodeId":751330301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1173872882,"text":"#It's open! You're awesome, {REALNAME[ID(2)|SHOWHOST(true)]}! We wouldn't have found the mechanism without you!","nextNodeIds":[751330302]},{"nodeId":751330302,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2507494242,"text":"Rawr!","nextNodeIds":[751330303]},{"nodeId":751330303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2877354410,"text":"#I knew you could do it, {REALNAME[ID(2)|SHOWHOST(true)]}.","nextNodeIds":[751330304]},{"nodeId":751330304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4129763754,"text":"But don't get ahead of yourself. Plenty of challenges await us!","nextNodeIds":[751330305]},{"nodeId":751330305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3517142546,"text":"Now that the entrance is open, there's no reason to give up halfway.","nextNodeIds":[751330306]},{"nodeId":751330306,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":954926010,"text":"I concur, Paimon.","nextNodeIds":[751330307]},{"nodeId":751330307,"roleType":"TALK_ROLE_NPC","speakerId":21602,"speakerName":"Cocouik","textMapHash":4156822122,"text":"Cheep... Cheep!","nextNodeIds":[751330308]},{"nodeId":751330308,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":1654230250,"text":"What's wrong? Why don't you want to go in? Are you scared? We're halfway through our journey — there's no turning back now!","nextNodeIds":[751330309]},{"nodeId":751330309,"roleType":"TALK_ROLE_NPC","speakerId":21602,"speakerName":"Cocouik","textMapHash":3557528218,"text":"Ku...","nextNodeIds":[751330310]},{"nodeId":751330310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1373523146,"text":"You shouldn't force the issue, Bona. It really does look super scared. Could there be something super dangerous down there?","nextNodeIds":[751330311]},{"nodeId":751330311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1784008754,"text":"I'm scared too!","nextNodeIds":[751330312]},{"nodeId":751330312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3608586346,"text":"#Now, really? C'mon, pull yourself together like {REALNAME[ID(2)|SHOWHOST(true)]}, why don't you?","nextNodeIds":[751330313]},{"nodeId":751330313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":276374626,"text":"This is kind of exciting.","nextNodeIds":[751330314]},{"nodeId":751330314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":399970178,"text":"Paimon didn't think you'd be so pumped up. But you can probably take on anyone we find down there, so...","nextNodeIds":[751330315]},{"nodeId":751330315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":311408914,"text":"Don't worry, our little Saurian's a brave soul.","nextNodeIds":[751330316]},{"nodeId":751330316,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2351210786,"text":"Rawr... Rawr!","nextNodeIds":[751330317]},{"nodeId":751330317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":29530122,"text":"If Coco really is afraid, maybe we should have it stay behind... But not alone. That wouldn't work...","nextNodeIds":[751330318]},{"nodeId":751330318,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":3409566354,"text":"I guess there's no other way. I'll stay with Coco up here. You can have the Pyrophosphorite.","nextNodeIds":[751330319]},{"nodeId":751330319,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":3455368906,"text":"But, whatever you find down there, you have to come back and find me, alright!","nextNodeIds":[751330320]},{"nodeId":751330320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1852644266,"text":"We don't leave anyone behind.","nextNodeIds":[751330321]},{"nodeId":751330321,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":327515842,"text":"I believe in you. We'll wait for you here.","nextNodeIds":[751330322]},{"nodeId":751330322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":168060994,"text":"Don't worry, just wait here until we come back.","nextNodeIds":[751330323]},{"nodeId":751330323,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1896174250,"text":"Rawr!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3490201","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_MAP_LAYER_UNLOCK_STATE"},{"LNHLPKELCAL":["3","133508094"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["3","133508099"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMC