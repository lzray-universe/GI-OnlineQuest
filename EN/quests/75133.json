L":["[3_8636:-138.219,453.002,10018.030]","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7513301],"talks":[{"talkId":7513301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7513302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7513301,"initDialog":751330101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005,21583,21602],"performCfg":"QuestDialogue/WQ/Natlan_75048/Q7504818","priority":5,"questId":75133,"showRandomTalkCount":0},"dialogs":[{"nodeId":751330101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2170519466,"text":"Paimon didn't expect Coco to lead us here. This strange fortress looks just like the place where we met you, Bona.","nextNodeIds":[751330102]},{"nodeId":751330102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2815748178,"text":"Look, it even has the same mural! Minus the smear marks, though. Is it because we're higher up?","nextNodeIds":[751330103]},{"nodeId":751330103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":710216226,"text":"#Look, {NICKNAME}! This must be the Python King that Bona mentioned. He sure looks mean!","nextNodeIds":[751330104]},{"nodeId":751330104,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":2979740074,"text":"Yes, that's the Python King Och-Kan. Legend has it that he abused and oppressed his people to get the Tonatiuh built, and eventually attracted the Abyss, which led to his death and the downfall of the kingdom.","nextNodeIds":[751330105]},{"nodeId":751330105,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":1243232418,"text":"But that's just a legend. After all, the storytellers in my tribe have told different tales about what happened to him.","nextNodeIds":[751330106]},{"nodeId":751330106,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":771747274,"text":"Maybe he's still roaming the Tonatiuh and feasting on his treasure. Or maybe the evil dragon that's been trying to stop us is his ghost!","nextNodeIds":[751330107]},{"nodeId":751330107,"roleType":"TALK_ROLE_NPC","speakerId":21602,"speakerName":"Cocouik","textMapHash":1877908730,"text":"Kuchi...","nextNodeIds":[751330108]},{"nodeId":751330108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3782356298,"text":"Please stop with the stories! You're scaring Coco!","nextNodeIds":[751330109]},{"nodeId":751330109,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3411351594,"text":"Rawr! Rawr!","nextNodeIds":[751330110]},{"nodeId":751330110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3141732218,"text":"#{REALNAME[ID(2)|SHOWHOST(true)]} sure has been eager to do something since we defeated the dragon. Is he in some kind of secret contest with Coco?","nextNodeIds":[751330111]},{"nodeId":751330111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1232355138,"text":"Anyway, where's this Altar we're looking for?","nextNodeIds":[751330112]},{"nodeId":751330112,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":697909050,"text":"If Coco was right, it should be below us... Wait, I thought it'd be somewhere higher up.","nextNodeIds":[751330113]},{"nodeId":751330113,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":2783979562,"text":"Did we mess up? The Altar of Primal Flame can't be inside the mountain, can it? How would we be transported into the sky then, unless the mountain itself collapses?","nextNodeIds":[751330114]},{"nodeId":751330114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3655633802,"text":"There could be a special transportation mode at play...","nextNodeIds":[751330115]},{"nodeId":751330115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1055006442,"text":"Well, what now, then? You were so sure while we were down there. And we can't understand what Coco is trying to say, either.","nextNodeIds":[751330116]},{"nodeId":751330116,"roleType":"TALK_ROLE_NPC","speakerId":21602,"speakerName":"Cocouik","textMapHash":2425747186,"text":"Kulu...","nextNodeIds":[751330117]},{"nodeId":751330117,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1931882698,"text":"Rawr! Rawr!","nextNodeIds":[751330118]},{"nodeId":751330118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1722081834,"text":"#Any ideas, {REALNAME[ID(2)|SHOWHOST(true)]}?","nextNodeIds":[751330119]},{"nodeId":751330119,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":1978083138,"text":"I think I get it now. It's trying to tell us that following rigid logic won't get us anywhere!","nextNodeIds":[751330120]},{"nodeId":751330120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1974356074,"text":"Wait, you made that up, didn't you?","nextNodeIds":[751330121]},{"nodeId":751330121,"roleType":"TALK_ROLE_NPC","speakerId":21583,"speakerName":"Bona","textMapHash":3558115386,"text":"Well, regardless of what's below us, I say we go check it out. I mean, we're on an adventure, aren't we?","nextNodeIds":[751330122]},{"nodeId":751330122,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":791937754,"text":"Rawr!","nextNodeIds":[751330123]},{"nodeId":751330123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1239933122,"text":"#Huh, you sure are excited, {REALNAME[ID(2)|SHOWHOST(true)]}. Well, time to figure out how to get down there.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_8636:-138.219,453.002,10018.030]","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUE