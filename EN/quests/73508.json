{"mainQuestId":73508,"title":"Parting Arrangement","description":"Fungus Mechanicus's testing phase is coming to a close. It's time to give Haniyyah and Balfour some feedback...","titleTextMapHash":4115886423,"descTextMapHash":2331045286,"mainQuestExcel":{"mainQuestId":73508,"titleTextMapHash":4115886423,"title":"Parting Arrangement","descTextMapHash":2331045286,"description":"Fungus Mechanicus's testing phase is coming to a close. It's time to give Haniyyah and Balfour some feedback...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":5120,"luaPath":"Actor/Quest/WQ73508","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5120,"chapterId":0,"descTextMapHash":2331045286,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73508,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1805208137,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73508","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173508],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4115886423,"type":"WQ","unlockDescTextMapHash":3705492710}},"flow":[{"subQuestId":7350802,"order":1,"stepDescription":"Wait until the following day (08:00 – 12:00)","stepDescTextMapHash":2902012748,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"8,12"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"8,12"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7350801,"order":2,"stepDescription":"Talk to Haniyyah and Balfour","stepDescTextMapHash":3961880748,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7350801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30319"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7350801],"talks":[{"talkId":7350801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7350801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7350801,"initDialog":735080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30319,30318],"performCfg":"QuestDialogue/WQ/V3.5FungusFighterV2_73507/Q7350801","priority":5,"questId":73508,"showRandomTalkCount":0},"dialogs":[{"nodeId":735080101,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":3537469050,"text":"#Thank you for your work these past few days, Golden Comet {NICKNAME} and Silver Companion!","nextNodeIds":[735080102]},{"nodeId":735080102,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":1623394218,"text":"I've logged all your games, and we've been able to gather lots of data from your game records.","nextNodeIds":[735080103]},{"nodeId":735080103,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":1250165122,"text":"You fall under the category we call \"pinnacle-class\" players, and I believe that between you and normal testers, we'll be able to come up with some stable improvement directives.","nextNodeIds":[735080104]},{"nodeId":735080104,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":832701658,"text":"Of course, we'd also like to hear what you thought of the game overall, and if you have any suggestions in that regard.","nextNodeIds":[735080105]},{"nodeId":735080105,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":1945042874,"text":"Your feedback will not only have a positive impact on Fungus Mechanicus, but will also affect the next tournament to some extent.","nextNodeIds":[735080106]},{"nodeId":735080106,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":2187100882,"text":"Finally, we'd like to hear about your general preferences... Would you prefer novelty, or more competitive aspects?","nextNodeIds":[735080107,735080112,735080117]},{"nodeId":735080107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3068390914,"text":"I'd prefer to emphasize cooperation between companions.","nextNodeIds":[735080108]},{"nodeId":735080108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4207139218,"text":"Right! Competitive clashes are really important, sure, but we'd prefer that future challenges test the bonds between us and our Fungi friends!","nextNodeIds":[735080109]},{"nodeId":735080109,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":35266986,"text":"Bonds, huh... Alright, I understand.","nextNodeIds":[735080110]},{"nodeId":735080110,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":2430368242,"text":"Mr. Balfour. Do you remember what I told you about the most important idea?","nextNodeIds":[735080111]},{"nodeId":735080111,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":2078590314,"text":"Understood! I shall endeavor to design more challenges that will test your coordination with one another, where effective communication will allow you and your Fungi friends to unleash your true potential!","nextNodeIds":[735080121]},{"nodeId":735080121,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":851265290,"text":"Same as always, huh, you two...","nextNodeIds":[735080122]},{"nodeId":735080122,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":4042746138,"text":"Regardless, that's it for this round of Fungus Mechanicus tests.","nextNodeIds":[735080123,735080125]},{"nodeId":735080123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1746085970,"text":"Thanks for your hard work!","nextNodeIds":[735080124]},{"nodeId":735080124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3480874458,"text":"Nice! Now that we're done with work, it's time to collect our pay and get some food to reward ourselves, hehe!","nextNodeIds":[735080127]},{"nodeId":735080127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":483080146,"text":"Wait... That's not right! We're the organizers of the next tournament, while Haniyyah and Balfour are making preparations for it...","nextNodeIds":[735080128]},{"nodeId":735080128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":569281266,"text":"Haniyyah's our awesome assistant, and Balfour's also being employed by us.","nextNodeIds":[735080129]},{"nodeId":735080129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":766189530,"text":"Does that mean we'll have to, uh... pay our employees for their hard work... and stuff?","nextNodeIds":[735080130]},{"nodeId":735080130,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":3626356850,"text":"Oh, no, that's not necessary. In fact, that's too kind of you! I volunteered to do this job, and I learned a lot from it, too!","nextNodeIds":[735080131]},{"nodeId":735080131,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":1611863298,"text":"I mean, I'm someone from the mercantile industry as well, so the experience of managing Fungus Mechanicus has been quite valuable to me.","nextNodeIds":[735080132]},{"nodeId":735080132,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":407438786,"text":"If this work were to be open to the public, I'm quite sure you'd have no lack of offers from people who'd like to buy the rights to it, to be honest!","nextNodeIds":[735080133]},{"nodeId":735080133,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":3677416674,"text":"And once Fungus Mechanicus starts turning a profit, Mr. Balfour should make his investment back and a large portion of the profits will go to me.","nextNodeIds":[735080134]},{"nodeId":735080134,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":1806430506,"text":"I will then set a portion of that aside for use as funds for the next tournament, and another portion will be used to take care of our shroom friends.","nextNodeIds":[735080135]},{"nodeId":735080135,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":4056020770,"text":"And by that I don't just mean Bongo-Head, but also the Fungi that the other contestants have entrusted to me, like Stormstress.","nextNodeIds":[735080136]},{"nodeId":735080136,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":743565194,"text":"In other words, the improvements you're helping us make to Fungus Mechanicus will not only make us all a tidy profit, but will also go into securing welfare for the Fungi.","nextNodeIds":[735080137]},{"nodeId":735080137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3629149394,"text":"Ooh, so that's it... Well, Paimon doesn't get all this profit and earnings stuff, but it sounds like everyone wins, huh?","nextNodeIds":[735080138]},{"nodeId":735080138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":658711474,"text":"Hehe, Paimon's feeling that sense of accomplishment already!","nextNodeIds":[735080139]},{"nodeId":735080139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3561713802,"text":"#If we get the chance, {NICKNAME}, we should tell our friends in Sumeru about Fungus Mechanicus. Gotta spread the word and everything!","nextNodeIds":[735080140]},{"nodeId":735080140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2016891746,"text":"Of course, of course.","nextNodeIds":[735080141]},{"nodeId":735080141,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":2547485810,"text":"I'll be heading out of the city with our Fungi friends to meet up with my assistant, and then we'll return to our campsite.","nextNodeIds":[735080142]},{"nodeId":735080142,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":1410217930,"text":"The Fungi who stay at the campsite will get worried if we're away for too long.","nextNodeIds":[735080143]},{"nodeId":735080143,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":2948407714,"text":"Mr. Balfour will stay here to promote the test version of Fungus Mechanicus, so if you've not yet had your fill of fun, you can keep playing.","nextNodeIds":[735080144]},{"nodeId":735080144,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":4183410938,"text":"Indeed! Play to your heart's content!","nextNodeIds":[735080145]},{"nodeId":735080145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1908653666,"text":"Oh, you're going already, Haniyyah? With Bongo-Head and the rest?","nextNodeIds":[735080146]},{"nodeId":735080146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3477022834,"text":"Paimon still wants to play with Bongo-Head...","nextNodeIds":[735080147]},{"nodeId":735080147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1842383818,"text":"But meeting you again has definitely put Paimon at ease!","nextNodeIds":[735080148]},{"nodeId":735080148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3901836962,"text":"It was especially great to see that our shroom buddies are all right as rain, and that we're just as tight as we used to be!","nextNodeIds":[735080149]},{"nodeId":735080149,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":586428210,"text":"Don't worry. I believe we'll meet again soon.","nextNodeIds":[735080150]},{"nodeId":735080150,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":125979786,"text":"Though the two of you are constantly traveling, I do have some means of contacting you — for example, we can send you letters through the Adventurers' Guild.","nextNodeIds":[735080151]},{"nodeId":735080151,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":123208170,"text":"I'm sure that when we next meet, our friends will be both healthy and hearty!","nextNodeIds":[735080152]},{"nodeId":735080152,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":3347280210,"text":"Just hang tight and wait for good news from me.","nextNodeIds":[735080153]},{"nodeId":735080153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1326773578,"text":"Yup! We believe in you, Haniyyah!","nextNodeIds":[735080154,735080155,735080156]},{"nodeId":735080154,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4048919090,"text":"Keep up the good work, Haniyyah.","nextNodeIds":[735080157]},{"nodeId":735080157,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":3989328962,"text":"We'll see you next time then, Golden Comet and Silver Companion!","nextNodeIds":[]},{"nodeId":735080155,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":443595338,"text":"Take care of our friends.","nextNodeIds":[735080157]},{"nodeId":735080156,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3949012250,"text":"And don't forget to take care of yourself.","nextNodeIds":[735080157]},{"nodeId":735080125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1078538538,"text":"Don't forget our salary.","nextNodeIds":[735080126]},{"nodeId":735080126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4150520786,"text":"Right, right. Hehe, food bought with hard-earned Mora tastes so much better!","nextNodeIds":[735080127]},{"nodeId":735080112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3193152562,"text":"I'm partial towards the elegance and thrill of combat.","nextNodeIds":[735080113]},{"nodeId":735080113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2842942634,"text":"Yeah! Paimon's also sure that our bonds with our shroom buddies will only become stronger, and won't weaken with time!","nextNodeIds":[735080114]},{"nodeId":735080114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3964775962,"text":"Who knows how well we'll work together the next time we compete? There's no doubt that we'll need the coolest battles to put that on display!","nextNodeIds":[735080115]},{"nodeId":735080115,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":1254318754,"text":"I see. So you're of a mind that suitable challenges can display the full strength of the Fungi.","nextNodeIds":[735080116]},{"nodeId":735080116,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":2565424482,"text":"In that case, we'll increase the number of challenging events available during the next competition!","nextNodeIds":[735080121]},{"nodeId":735080117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3349015714,"text":"I'm not partial to anything. Let's just do something enjoyable!","nextNodeIds":[735080118]},{"nodeId":735080118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1102426378,"text":"That's right. No matter what happens, we'll be happy so long as we can play with our shroom buddies, clear challenges with them, and overcome difficulties together!","nextNodeIds":[735080119]},{"nodeId":735080119,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"Haniyyah","textMapHash":2820162354,"text":"Understood. So we'd want a mix of fun and challenge, huh? It sounds simple, but might be harder to execute...","nextNodeIds":[735080120]},{"nodeId":735080120,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"Balfour","textMapHash":3701486154,"text":"Leave it to me. I shall do my best to satisfy your requirements!","nextNodeIds":[735080121]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7350801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["