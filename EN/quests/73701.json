EDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7370106,"order":11,"stepDescription":"Talk to Sorush","stepDescTextMapHash":225034188,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7370106_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7370106],"talks":[{"talkId":7370106,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7370106","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370106,"initDialog":737010601,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7370106","priority":5,"questId":73701,"showRandomTalkCount":0},"dialogs":[{"nodeId":737010601,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3145003690,"text":"It has long been a familiar sight to me, but now I feel only conflicted thinking about it...","nextNodeIds":[737010602]},{"nodeId":737010602,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2093457050,"text":"Huh... On the bright side, this maybe means that Sorush has matured?","nextNodeIds":[737010603]},{"nodeId":737010603,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2617629826,"text":"I know not if this is growth or a decline instead...","nextNodeIds":[737010604]},{"nodeId":737010604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3332695130,"text":"Cheer up, Sorush! It's not like you to get so down.","nextNodeIds":[737010605]},{"nodeId":737010605,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":687660474,"text":"Right! Since we're already here, why don't you tell us about the early history of the Order of Skeptics?","nextNodeIds":[737010606]},{"nodeId":737010606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1044602818,"text":"Although things are the way they are now... there must've been a point to their establishment, right? Otherwise Zurvan wouldn't have helped them and you wouldn't have been drawn to them.","nextNodeIds":[737010607]},{"nodeId":737010607,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":521889626,"text":"Very well, if you wish to listen, I will speak... However, you must know that my birth came after the Order of Skeptics was formed. What happened prior is but hearsay to me as well.","nextNodeIds":[737010608]},{"nodeId":737010608,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":364342226,"text":"It was said that, before all that transpired, there were some of absolute purity and virtue who attempted to spread the word that catastrophe was imminent.","nextNodeIds":[737010609]},{"nodeId":737010609,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1290483882,"text":"But carrying a message does not halt the coming of ruin. Soon, darkness washed over the lands as roiling tides, drowning all that lived in fear.","nextNodeIds":[737010610]},{"nodeId":737010610,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4173235706,"text":"Just as we saw of the Setekh Wenut, even the strongest creatures were crystallized, perishing during the event.","nextNodeIds":[737010611]},{"nodeId":737010611,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3533886722,"text":"Comparatively, with how soft and weak humans are, their resulting scouring cannot be considered a personal failing.","nextNodeIds":[737010612]},{"nodeId":737010612,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1511773330,"text":"But some individuals arrived, rushing into the maelstrom that was the calamity.","nextNodeIds":[737010613]},{"nodeId":737010613,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1885598346,"text":"Were these people the first Order of Skeptics?","nextNodeIds":[737010614]},{"nodeId":737010614,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2600444362,"text":"Indeed. Their leader was Nagarjuna. He once was a researcher who worked in the depths of the woods, but he put roots down here to help alleviate the aftershocks of the catastrophe.","nextNodeIds":[737010615]},{"nodeId":737010615,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3585524810,"text":"Yes, and there was another one with golden hair... Though my elder spoke little of him, he should count as an \"interesting\" individual, I think?","nextNodeIds":[737010616]},{"nodeId":737010616,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3289887362,"text":"#*sigh*... It's a real shame that he only lived a few hundred years ago. If he was still here, Paimon would love to see him meet {NICKNAME}. Then we can see who's more \"interesting.\"","nextNodeIds":[737010617,737010618]},{"nodeId":737010617,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3057555138,"text":"Why are we competing...","nextNodeIds":[737010619]},{"nodeId":737010619,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3496157514,"text":"Following this, after my birth, the aftereffects of the catastrophe stabilized.","nextNodeIds":[737010620]},{"nodeId":737010620,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1668556226,"text":"So Sorush had nothing to do then?","nextNodeIds":[737010621]},{"nodeId":737010621,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3495091842,"text":"Hmph... Not entirely, as the filth will never be fully eradicated. It's just that... noble sacrifices like the one made by the divine bird, Simurgh, were no longer needed.","nextNodeIds":[737010622]},{"nodeId":737010622,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2777648178,"text":"What's more, such duties have already been performed by Mihir, Rashnu, and other Pari predating me.","nextNodeIds":[737010623]},{"nodeId":737010623,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2857729722,"text":"After Nagarjuna, the Elder slowly broke off contact with the Order of Skeptics. However, the Skeptics themselves remained ever-interested in us Pari.","nextNodeIds":[737010624]},{"nodeId":737010624,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4224676138,"text":"But I suppose this is nothing strange. To them, after all, we Pari are heroes worthy of songs and odes. The strong feelings of admiration we inspire are more than deserved.","nextNodeIds":[737010625]},{"nodeId":737010625,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2735473922,"text":"During that time, I often heard them loudly singing their poems and odes, and with the passing of time, the scenes of the divine bird's sacrifice grew ever more vivid. Yet, my elder treats this as if it is a paltry thing...","nextNodeIds":[737010626]},{"nodeId":737010626,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3824183554,"text":"It sounds like...","nextNodeIds":[737010627]},{"nodeId":737010627,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3763187866,"text":"Sorush got buttered up by honeyed words...","nextNodeIds":[737010628]},{"nodeId":737010628,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2753816610,"text":"What? No, impossible! I clearly wanted to imitate the divine bird because I was moved by its passion and will.","nextNodeIds":[737010629]},{"nodeId":737010629,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3730527970,"text":"The only reason why I associated with the Order of Skeptics was because they would tell me about the happenings of years past... O—Of course, it wasn't like they didn't heap an appropriate amount of praise on me.","nextNodeIds":[737010630]},{"nodeId":737010630,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3880788650,"text":"It's the same story, but told in an exaggerated way to get people's attention. Even Paimon likes listening to exciting stories!","nextNodeIds":[737010631]},{"nodeId":737010631,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1673337002,"text":"Oh! But if their intention was to record actual history, then they definitely did something wrong.","nextNodeIds":[737010632]},{"nodeId":737010632,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3047254778,"text":"Indeed. Regardless if it is I or the humans of the Order of Skeptics, those who condition themselves to accept hyperbole as ordinary will see themselves become like this.","nextNodeIds":[737010633]},{"nodeId":737010633,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3508008298,"text":"The Order of Skeptics's archives were no longer simple truthful records. Instead, they were filled with all manner of embellishments and subjective opinions.","nextNodeIds":[737010634]},{"nodeId":737010634,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2090838506,"text":"...And, unknowingly, I began to put renown beyond action itself.","nextNodeIds":[737010635]},{"nodeId":737010635,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3216879178,"text":"Looks like you finally get it?","nextNodeIds":[737010636]},{"nodeId":737010636,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1092025802,"text":"She seems more energetic than she was when she came here.","nextNodeIds":[737010637]},{"nodeId":737010637,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3978321394,"text":"Isn't this a good thing? Hehe, now Zurvan won't be asking to take the Chaplet, will she?","nextNodeIds":[737010638]},{"nodeId":737010638,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":489530082,"text":"Your training is almost at its end. You'll definitely win Zurvan's approval!","nextNodeIds":[]},{"nodeId":737010618,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":650986898,"text":"Well, my victory's assured.","nextNodeIds":[737010619]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7370106_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7370101,7370106],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","count":22},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173701],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2902207326,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[73702],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<