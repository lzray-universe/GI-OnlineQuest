{"mainQuestId":71506,"title":"A Muddy Bizarre Adventure","description":"The Sumeru researcher Khedive, who is conducting research as part of the exploration team, seems to be troubled about the environment within The Chasm.","titleTextMapHash":3386708599,"descTextMapHash":38530598,"mainQuestExcel":{"mainQuestId":71506,"titleTextMapHash":3386708599,"title":"A Muddy Bizarre Adventure","descTextMapHash":38530598,"description":"The Sumeru researcher Khedive, who is conducting research as part of the exploration team, seems to be troubled about the environment within The Chasm.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":5079,"luaPath":"Actor/Quest/WQ71506","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5079,"chapterId":0,"descTextMapHash":38530598,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71506,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3043404657,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71506","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[71502],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3386708599,"type":"WQ","unlockDescTextMapHash":313235494}},"flow":[{"subQuestId":7150601,"order":1,"stepDescription":"Talk to Hosseini","stepDescTextMapHash":3281784148,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7150601],"talks":[{"talkId":7150601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150601,"initDialog":715060101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150601","priority":15,"questId":71506,"showRandomTalkCount":0},"dialogs":[{"nodeId":715060101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1765455410,"text":"Didn't you say that theoretically, there wouldn't be any problems?","nextNodeIds":[715060102]},{"nodeId":715060102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":810104290,"text":"The Spike wound up causing the dark mud to gush out instead...","nextNodeIds":[715060103]},{"nodeId":715060103,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":780271762,"text":"Ah, is that how it is... Agh, to think that I did not factor the ground into my calculations. Ah, what an error.","nextNodeIds":[715060104]},{"nodeId":715060104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3842713986,"text":"Factor the ground into your calculations?","nextNodeIds":[715060105]},{"nodeId":715060105,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2945803330,"text":"That's right. Our previous experiments all took place on softer soil.","nextNodeIds":[715060106]},{"nodeId":715060106,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":673721274,"text":"But within The Chasm, the medium through which the Spike's energy travels is not soil but rock, which has very different properties. This caused a major discrepancy between the earlier calculations and the actual results.","nextNodeIds":[715060107]},{"nodeId":715060107,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2694967082,"text":"Indeed, theory is not a mere matter of imagination. Instead, it must be grounded and proven in reality.","nextNodeIds":[715060108]},{"nodeId":715060108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":252480274,"text":"This proving process seems kinda dangerous, though. Also, why did so much mud come out all at once?","nextNodeIds":[715060109]},{"nodeId":715060109,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2963575026,"text":"Indeed, this place is quite far from the mining complex, so the mud really shouldn't be flowing all the way here... The situation must be more urgent than we imagined.","nextNodeIds":[715060110]},{"nodeId":715060110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2761216514,"text":"Also, the Pursina's Spike has a definite effect on environments affected by the dark mud. This shows that the mud's proliferation is, as I guessed, an issue that stems from the Ley Lines.","nextNodeIds":[715060111]},{"nodeId":715060111,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2266584002,"text":"This proves the need for experimentation and proof, does it not?","nextNodeIds":[715060112]},{"nodeId":715060112,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":600926730,"text":"Of course, if I had done the experiment myself, I would have wound up being attacked by the monsters.","nextNodeIds":[715060113]},{"nodeId":715060113,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1030380250,"text":"Not that I worry about being injured — that would be a small loss compared to any damage that might be done to the Pursina's Spike. How would I answer to our great tutor Firnas or my fellow researchers in the Kshahrewar...","nextNodeIds":[715060114]},{"nodeId":715060114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4176411450,"text":"You should pay more attention to your own safety nonetheless.","nextNodeIds":[715060115]},{"nodeId":715060115,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2622665210,"text":"True. The data we've collected can be used to adjust the results of our calculations. Now, the solutions to these interfering parameters... I believe there are four such methods, though there should be only one that will prove most effective.","nextNodeIds":[715060116]},{"nodeId":715060116,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2022799010,"text":"#Thank you so much for helping me with this test run, {NICKNAME}. I will make some adjustments to the Pursina's Spike.","nextNodeIds":[715060117]},{"nodeId":715060117,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1693640450,"text":"Later, it can be moved into the mining complex, where operations can then begin.","nextNodeIds":[715060118,715060119]},{"nodeId":715060118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1240851634,"text":"You're moving it into the mining complex?","nextNodeIds":[715060120]},{"nodeId":715060120,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3431345754,"text":"Well, no. I had agreed with Khedive to hire some of the local miners here to move it.","nextNodeIds":[715060121]},{"nodeId":715060121,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4045337690,"text":"But when they heard that my objective was to resolve the issue of the dark mud, they refused any payment.","nextNodeIds":[715060122]},{"nodeId":715060122,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4218233298,"text":"I've spoken to Khedive and Muning from the Ministry of Civil Affairs, however. The Mora will still go to them as compensation.","nextNodeIds":[715060123]},{"nodeId":715060123,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":789470970,"text":"Of course, I'll need you to help start the machine up once it reaches its destination.","nextNodeIds":[]},{"nodeId":715060119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3320435346,"text":"By yourself?","nextNodeIds":[715060120]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7150601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":38530598,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[71502],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/TheChasmChallenge/Q7150601","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":15,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJ