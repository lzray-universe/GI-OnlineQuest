DE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7650601,7650604,7650607,7650608],"talks":[{"talkId":7650601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7650601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","0","76506","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["220122","1","","",""],"type":"QUEST_COND_PACK_HAVE_ITEM_WITH_ID"},{"param":["5285","5285010","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7650601,"initDialog":765060101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4479],"performCfg":"QuestDialogue/WQ/NodKrai_76506/Q7650601","priority":5,"questId":76506,"showRandomTalkCount":0},"dialogs":[{"nodeId":765060101,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":3845058842,"text":"#Oh me, oh my, if it isn't {NICKNAME} and Paimon? Fancy meeting you here — my luck must be turning, I just know it.","nextNodeIds":[765060102]},{"nodeId":765060102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2892885970,"text":"Dori? What are you doing here all alone? Planning to set up shop? ... Hmm, don't see you carrying any goods, though...","nextNodeIds":[765060103]},{"nodeId":765060103,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":4069011434,"text":"Ah, my sincerest apologies, but the renowned traveling merchant Dori is taking the day off.","nextNodeIds":[765060104]},{"nodeId":765060104,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":4125419562,"text":"You can say I'm taking a page out of the locals' books and enjoying a normal, carefree day in this Elysium we call Nod-Krai!","nextNodeIds":[765060105]},{"nodeId":765060105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":23352002,"text":"Huh? Seriously? You, not busy making Mora? Next you'll say it's been raining all year in the desert...","nextNodeIds":[765060106]},{"nodeId":765060106,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":2579241762,"text":"Hehe, I'll tell you what — even if I myself take a break, my assiduous, adept employees are still constantly growing our revenue streams!","nextNodeIds":[765060107]},{"nodeId":765060107,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":378423810,"text":"So there's nothing to worry about — so long as the account numbers go up, of course.","nextNodeIds":[765060108]},{"nodeId":765060108,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":3095546586,"text":"Speaking of that... Might you two be having some trouble? I might be on vacation, but far be it from me to reject any business that comes knocking at my door.","nextNodeIds":[765060109,765060110]},{"nodeId":765060109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3517670786,"text":"We're just looking around.","nextNodeIds":[765060111]},{"nodeId":765060111,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":1540421586,"text":"Ahh, so you're here to take pictures of Nod-Krai's unique scenery, hmm? Well, then, you've come to the right person!","nextNodeIds":[765060112]},{"nodeId":765060112,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":3977562442,"text":"I know this place like the back of my hand — not quite as well as the locals, certainly, but if it's recommendations you need, I have them right here!","nextNodeIds":[765060113]},{"nodeId":765060113,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":2160780050,"text":"And since we're friends, I'll personally serve as your guide, with a hefty friend discount to boot. Soooo... how does 500,000 Mora a day sound, mmm?","nextNodeIds":[765060114]},{"nodeId":765060114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2534142570,"text":"Wow, that's Dori for you. Never a few phrases away from helping yourself to the Mora in our pockets.","nextNodeIds":[765060115]},{"nodeId":765060115,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":3332859650,"text":"Oh no, no, I'm doing this so that you, my dear valued customers, can have a lovely, wonderful, unforgettable time here in Nod-Krai!","nextNodeIds":[765060116,765060117]},{"nodeId":765060116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":516780834,"text":"Well, if you're so passionate about helping us out...","nextNodeIds":[765060118]},{"nodeId":765060118,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":2581641866,"text":"Hmm? An interesting idea, to be sure. But mind you, such photos can't be used in for-profit advertisements. The rights to my likeness are most valuable, I'll have you know!","nextNodeIds":[765060119]},{"nodeId":765060119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1067133714,"text":"Oh, don't worry, it's just a photo of an old friend — y'know, for old times' sake!","nextNodeIds":[765060120]},{"nodeId":765060120,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":1357453186,"text":"#Ah! Of course, of course! Since it's you who've requested this personally, {NICKNAME}, I'll make an exception. Just one — and make sure I look splendid, that's all I ask!","nextNodeIds":[765060121]},{"nodeId":765060121,"roleType":"TALK_ROLE_NPC","speakerId":4479,"speakerName":"Dori","textMapHash":2230676290,"text":"Let me think... How's \"Dori, Lord Sangemah Bay, and Her Paradise Vacation\" sound for a caption? Brilliant, no?","nextNodeIds":[]},{"nodeId":765060117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":583397538,"text":"Could we take a picture of you?","nextNodeIds":[765060118]},{"nodeId":765060110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":513025866,"text":"And looking for some photo-op material while we're at it.","nextNodeIds":[765060111]}]},{"talkId":7650604,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":f