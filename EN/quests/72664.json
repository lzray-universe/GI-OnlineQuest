_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30066"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7266401],"talks":[{"talkId":7266401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7266401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7266401,"initDialog":726640101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30066],"performCfg":"","priority":5,"questId":72664,"showRandomTalkCount":0},"dialogs":[{"nodeId":726640101,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":3628053098,"text":"Hmm... I need to place another batch of treasure chests, don't I...","nextNodeIds":[726640102]},{"nodeId":726640102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1887110538,"text":"Did I hear someone mention treasure chests?","nextNodeIds":[726640103]},{"nodeId":726640103,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":3697061722,"text":"Eh!? Oh, it's... it's you, Traveler! Are you here to take part in the Moonchase Festival as well?","nextNodeIds":[726640104]},{"nodeId":726640104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2300099282,"text":"You could say that.","nextNodeIds":[726640105]},{"nodeId":726640105,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":1335087154,"text":"Then you've come at the right time! The Adventurers' Guild is currently organizing an event to celebrate the festival.","nextNodeIds":[726640106]},{"nodeId":726640106,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":288724354,"text":"Would you like to know more?","nextNodeIds":[726640107,726640108]},{"nodeId":726640107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":156259818,"text":"What activities are we talking about here?","nextNodeIds":[726640110]},{"nodeId":726640110,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":4149346978,"text":"During the Moonchase Festival, the Guild has placed Moonchase Charms in various places.","nextNodeIds":[726640111]},{"nodeId":726640111,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":680816514,"text":"Those who find these Charms can bring them back to us in exchange for various rewards.","nextNodeIds":[726640112]},{"nodeId":726640112,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":4086291586,"text":"We've also dispatched a group of adventurers to place a large batch of special treasure chests out in the wild.","nextNodeIds":[726640113]},{"nodeId":726640113,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":3116588410,"text":"These special treasure chests will come filled with all manner of goodies, which we've prepared just for this occasion!","nextNodeIds":[726640114]},{"nodeId":726640114,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":3949331954,"text":"Other than these two activities, we've also got some tough challenges lined up for elite adventurers!","nextNodeIds":[726640115]},{"nodeId":726640115,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":865690258,"text":"As for the details, it's... Well, it involves invading a series of monster camps...","nextNodeIds":[726640116,726640117]},{"nodeId":726640116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2639858114,"text":"And what does that have to do with the festival?","nextNodeIds":[726640118]},{"nodeId":726640118,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":1958271298,"text":"Aha... Ahaha... I mean, uh, you don't have to put it like that...","nextNodeIds":[726640119]},{"nodeId":726640119,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":3040213402,"text":"There's prizes to be had for beating those monsters!","nextNodeIds":[726640120]},{"nodeId":726640120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2222299098,"text":"That's not all that different from normal commissions, come on...","nextNodeIds":[726640121]},{"nodeId":726640121,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":1284294538,"text":"...Please, just help us out! Most of our adventurers have left to go enjoy the festival, and many of our commissions are just sitting there with no one to take them up.","nextNodeIds":[726640122]},{"nodeId":726640122,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":1191172826,"text":"Just lend us a hand! With your skills, it'll be a breeze, won't it?","nextNodeIds":[726640123,726640124]},{"nodeId":726640123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2102113298,"text":"Oh, fine...","nextNodeIds":[726640125]},{"nodeId":726640125,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":2181353178,"text":"O—Of course, you'll be compensated fairly, Traveler, don't worry!","nextNodeIds":[726640126]},{"nodeId":726640126,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":1441297362,"text":"I'll be here throughout the Moonchase Festival. If you have any questions, just ask me directly.","nextNodeIds":[726640127]},{"nodeId":726640127,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":2019828954,"text":"We're counting on you, Traveler. Well then... enjoy the festival!","nextNodeIds":[]},{"nodeId":726640124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1446482978,"text":"Better have that payment ready.","nextNodeIds":[726640125]},{"nodeId":726640117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2591686890,"text":"That's got nothing to do with the Moonchase Festival at all!","nextNodeIds":[726640118]},{"nodeId":726640108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2905364986,"text":"Oh no, not the dailies again. Anything but that...","nextNodeIds":[726640109]},{"nodeId":726640109,"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","textMapHash":3448308986,"text":"No, no! This activity is super adventurer-like!","nextNodeIds":[726640110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30066"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7266401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30066,"speakerName":"Linyang","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3481020606,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":726640101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7266401,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30066],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[1160,1171,1172,1