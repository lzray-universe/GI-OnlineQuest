{"mainQuestId":73652,"title":"Controllable Explosion","description":"The testing on the \"Remelting Tablets\" is progressing smoothly. It is time to report back to Hajanad...","titleTextMapHash":675979351,"descTextMapHash":3261056198,"mainQuestExcel":{"mainQuestId":73652,"titleTextMapHash":675979351,"title":"Controllable Explosion","descTextMapHash":3261056198,"description":"The testing on the \"Remelting Tablets\" is progressing smoothly. It is time to report back to Hajanad...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5087,"luaPath":"Actor/Quest/WQ73652","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5087,"chapterId":0,"descTextMapHash":3261056198,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73652,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2087707409,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73652","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173652],"series":5087,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":675979351,"type":"WQ","unlockDescTextMapHash":3907878334}},"flow":[{"subQuestId":7365201,"order":1,"stepDescription":"Talk to Hajanad","stepDescTextMapHash":1614175892,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7365201],"talks":[{"talkId":7365201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7365201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7365201,"initDialog":736520101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30226,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73652/Q7365201","priority":5,"questId":73652,"showRandomTalkCount":0},"dialogs":[{"nodeId":736520101,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3354823818,"text":"You're back! Ah, I've waited here for so long!","nextNodeIds":[736520102]},{"nodeId":736520102,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2998252234,"text":"Come, tell me how the \"Remelting Tablets\" did in detail.","nextNodeIds":[736520103]},{"nodeId":736520103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":425613922,"text":"Hajanad seems excited.","nextNodeIds":[736520104]},{"nodeId":736520104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":951549602,"text":"Then we'll start with the shortcomings first! Clench your teeth!","nextNodeIds":[736520105]},{"nodeId":736520105,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2748443922,"text":"You describe the pros and cons of \"Remelting Tablets\" to Hajanad in detail.","nextNodeIds":[736520106]},{"nodeId":736520106,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2867531218,"text":"I see... I understand now.","nextNodeIds":[736520107]},{"nodeId":736520107,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":278120330,"text":"The current explosion is not accurate enough to control the exact potion mix, so the effects can be unstable.","nextNodeIds":[736520108]},{"nodeId":736520108,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2028021738,"text":"What I need to do is to make a shield for the explosive, focus the resultant shockwave, and also modify the arrangement of preset tablets...","nextNodeIds":[736520109]},{"nodeId":736520109,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":591841906,"text":"Yes, it won't take long to make these modifications. The problem is funding...","nextNodeIds":[736520110]},{"nodeId":736520110,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2273919754,"text":"Fortunately, I still have my emergency funds! It should be enough if I sell the old equipment and eat once a day from now on.","nextNodeIds":[736520111]},{"nodeId":736520111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2591380850,"text":"You're going to eat only once a day?","nextNodeIds":[736520112]},{"nodeId":736520112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2721595570,"text":"No, no! That's unacceptable! Why didn't you mention that you don't have enough funds?","nextNodeIds":[736520113]},{"nodeId":736520113,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":602837618,"text":"Oh, rest assured. Your payment is guaranteed. I had it all budgeted out.","nextNodeIds":[736520114]},{"nodeId":736520114,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1394456354,"text":"I'm used to eating once a day by now. Sometimes I only have three meals in a week, so this shouldn't be a problem.","nextNodeIds":[736520115]},{"nodeId":736520115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1205098218,"text":"You don't have to try so hard...","nextNodeIds":[736520116]},{"nodeId":736520116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3408920042,"text":"Now Paimon's really curious...","nextNodeIds":[736520117]},{"nodeId":736520117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1863057554,"text":"Why do you want to become a famous researcher so bad, Ms. Hajanad?","nextNodeIds":[736520118]},{"nodeId":736520118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":387802642,"text":"Are you really that into academic research? Do you want to prove your worth by doing this? Or are you planning to make a lot of Mora with alchemy?","nextNodeIds":[736520119]},{"nodeId":736520119,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3820723234,"text":"Hmm...","nextNodeIds":[736520120]},{"nodeId":736520120,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2129813738,"text":"This is so out of the blue that I'm not sure either... Maybe it's just because I was bullied in the past that I got obsessed.","nextNodeIds":[736520121]},{"nodeId":736520121,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3027111346,"text":"If I can prove my worth, then I can live a better life.","nextNodeIds":[736520122]},{"nodeId":736520122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2665350818,"text":"So you're doing this for that reason...","nextNodeIds":[736520123]},{"nodeId":736520123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3392239994,"text":"So that's why you started to do academic research?","nextNodeIds":[736520124]},{"nodeId":736520124,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3907927690,"text":"Yes. Knowledge is everything in this country, and so the only way up is through one's academic abilities.","nextNodeIds":[736520125]},{"nodeId":736520125,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3817666706,"text":"I don't have much talent or high intellect, so my breakthroughs are limited to unpopular subjects that no one wants to take up.","nextNodeIds":[736520126]},{"nodeId":736520126,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1288693346,"text":"I've been delving into my research for so long that I forgot how to act around people. Perhaps my temper's suffered for it too...","nextNodeIds":[736520127,736520128]},{"nodeId":736520127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3121392394,"text":"Most people out there are good folks.","nextNodeIds":[736520129]},{"nodeId":736520129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":53151210,"text":"Yeah! You already have an impressive goal now. You should try to enjoy your life!","nextNodeIds":[736520130]},{"nodeId":736520130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3141892106,"text":"If you keep a normal heart and make normal conversations with people, there will definitely be those who'd like to help you with your research!","nextNodeIds":[736520131]},{"nodeId":736520131,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2257963274,"text":"I know, I know. Still, thank you for the advice.","nextNodeIds":[736520132]},{"nodeId":736520132,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3193932826,"text":"I realized that it's much easier and more interesting to study alchemy compared to studying what to eat or what to say to others.","nextNodeIds":[736520133]},{"nodeId":736520133,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3078611626,"text":"But since I've met you guys, I've been doing some self-reflection, and I believe that I should really work on my emotions and expressions.","nextNodeIds":[736520134]},{"nodeId":736520134,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":842167906,"text":"Anyway, thanks for helping me test out the \"Remelting Tablets.\" I should go back and write my papers now.","nextNodeIds":[736520135]},{"nodeId":736520135,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4064751090,"text":"In addition to the promised payment, this, too, is for you.","nextNodeIds":[736520136]},{"nodeId":736520136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1807607058,"text":"What is this?","nextNodeIds":[736520137]},{"nodeId":736520137,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3514801082,"text":"My best alchemy cauldron. It cost me a great deal back then, but I treasured it so much that I never got the chance to use it.","nextNodeIds":[736520138]},{"nodeId":736520138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1120933450,"text":"Hey! Why are you suddenly giving up your most precious tool?","nextNodeIds":[736520139]},{"nodeId":736520139,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2792131754,"text":"\"Remelting Tablets\" are different from traditional potions. They need the equipment I newly designed to produce them, so I won't be using this cauldron anyway.","nextNodeIds":[736520140]},{"nodeId":736520140,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3150387330,"text":"I did also make a promise to you, after all. Let this be a keepsake of that promise.","nextNodeIds":[736520141]},{"nodeId":736520141,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3961400586,"text":"You can try using it to make... tea or soup, I guess? Whatever comes out of it should taste better due to its extraordinary extraction functions.","nextNodeIds":[736520142]},{"nodeId":736520142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1681587722,"text":"Since you put it that way... It would be rude of us to refuse you.","nextNodeIds":[736520143]},{"nodeId":736520143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3314624610,"text":"You can do this, Hajanad!","nextNodeIds":[736520144]},{"nodeId":736520144,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2800807994,"text":"Of course! Just you wait!","nextNodeIds":[736520145]},{"nodeId":736520145,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3467802458,"text":"Hajanad leaves.","nextNodeIds":[736520146]},{"nodeId":736520146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1052119570,"text":"#Say, {NICKNAME}...","nextNodeIds":[736520147]},{"nodeId":736520147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":93951066,"text":"We did a good deed this time, right?","nextNodeIds":[736520148,736520149]},{"nodeId":736520148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4045534754,"text":"Just another day in our adventures.","nextNodeIds":[736520150]},{"nodeId":736520150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2431358098,"text":"Right... It's too early for us to come to any conclusions just yet.","nextNodeIds":[736520151]},{"nodeId":736520151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":612115458,"text":"Maybe a day will come when we'll have forgotten about this event and boom! Hajanad suddenly becomes a famous researcher and invites us to visit her!","nextNodeIds":[736520152]},{"nodeId":736520152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2527730082,"text":"Okay, enough of that! Let's go and make some tea with this alchemy cauldron!","nextNodeIds":[]},{"nodeId":736520149,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1426205066,"text":"We should steady our hearts as well.","nextNodeIds":[736520150]},{"nodeId":736520128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":838060410,"text":"Don't dwell on the past.","nextNodeIds":[736520129]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","P