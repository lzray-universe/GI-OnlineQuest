{"mainQuestId":74683,"title":"Filmmaking Notes","description":"Reunite with an old friend at Café Lutece...","titleTextMapHash":268413159,"descTextMapHash":2168605358,"mainQuestExcel":{"mainQuestId":74683,"titleTextMapHash":268413159,"title":"Filmmaking Notes","descTextMapHash":2168605358,"description":"Reunite with an old friend at Café Lutece...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5254,"luaPath":"Actor/Quest/WQ74683","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5254,"chapterId":0,"descTextMapHash":2168605358,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74683,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2153794489,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74683","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174683],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":268413159,"type":"WQ","unlockDescTextMapHash":2439659862}},"flow":[{"subQuestId":7468301,"order":1,"stepDescription":"Talk to Xavier","stepDescTextMapHash":922858828,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30771"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7468301],"talks":[{"talkId":7468301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7468301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468301,"initDialog":746830101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30771],"performCfg":"QuestDialogue/WQ/Fontaine_74683/Q7468301","priority":5,"questId":74683,"showRandomTalkCount":0},"dialogs":[{"nodeId":746830101,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1394427674,"text":"Ho, we meet again, my gallant adventurer friend!","nextNodeIds":[746830102,746830103]},{"nodeId":746830102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2224358778,"text":"Hello, my gallant film producer friend.","nextNodeIds":[746830104]},{"nodeId":746830104,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":2517158506,"text":"How've you been recently?","nextNodeIds":[746830105]},{"nodeId":746830105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1264213858,"text":"How've you been recently?","nextNodeIds":[746830106]},{"nodeId":746830106,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3030884506,"text":"Oho, we're in sync! The mark of a friendship that has withstood the test of time, surely? But since I was a little faster, why don't we start with you?","nextNodeIds":[746830107,746830108]},{"nodeId":746830107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3349366722,"text":"Same as always, working for the Adventurers' Guild.","nextNodeIds":[746830109]},{"nodeId":746830109,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3402491186,"text":"#Haha, composed as always, I see. Were it anyone else, I'd call {M#him}{F#her} out for pulling my leg. But with you, I know it's all true.","nextNodeIds":[746830110]},{"nodeId":746830110,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1633864274,"text":"As for me, things are the same as always — wrap shooting for one film, and it's time to start prepping for the next...","nextNodeIds":[746830111]},{"nodeId":746830111,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1660962802,"text":"Recently, I've had this idea for an adventure plot — a group of people who start as strangers, but are forced to travel together after an accident to overcome a slew of trials and thrills...","nextNodeIds":[746830112]},{"nodeId":746830112,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":278897522,"text":"Hmm, I haven't decided what sorts of thrills exactly, but things will go well enough for them to grow into heroes. As for the ending...","nextNodeIds":[746830113]},{"nodeId":746830113,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3640081954,"text":"...It's also undecided! Maybe our heroes shall go their separate ways, or blaze a trail into the realm of sequels.","nextNodeIds":[746830114]},{"nodeId":746830114,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3179743642,"text":"I've got a few plot ideas besides that one. Frankly, I feel like I have a whole sea of them in my head that tips over every time I lie down at night, drowning me in inspiration.","nextNodeIds":[746830115]},{"nodeId":746830115,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":4206737690,"text":"On the one hand, I am sleep-deprived. But on the other, I'll never run out of great ideas for as long as I live.","nextNodeIds":[746830116]},{"nodeId":746830116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1266201498,"text":"Sounds like everything's going smoothly.","nextNodeIds":[746830117]},{"nodeId":746830117,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":393272898,"text":"Well, not everything. There's always funding and sponsorships...","nextNodeIds":[746830118]},{"nodeId":746830118,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1667772538,"text":"Sometimes, I'll run into generous sponsors with great taste or get opportunities like the Fontinalia Film Festival, but those big breaks are few and far between, so I've had to think of my own solutions.","nextNodeIds":[746830119]},{"nodeId":746830119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":576212538,"text":"Do you need any help?","nextNodeIds":[746830120]},{"nodeId":746830120,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3181802322,"text":"Oho? Thanks for the concern — but no, I'm in no dire need of special assistance.","nextNodeIds":[746830121]},{"nodeId":746830121,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1045954682,"text":"I'd avoid resorting to a friend's kindness to achieve my dream as much as possible. All I need from a friend are their kind regards, and to keep in touch.","nextNodeIds":[746830122]},{"nodeId":746830122,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":511409586,"text":"I'll figure out some way to solve my financial problems. For instance, I'm helping my sponsors shoot some commercials. It doesn't pay very much, but it's a good source of stable income.","nextNodeIds":[746830123]},{"nodeId":746830123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3281447058,"text":"Commercials?","nextNodeIds":[746830124]},{"nodeId":746830124,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3082597314,"text":"Yes, ever since film became popular, many merchants and organizations have developed a taste for this new innovative marketing method. They'll go to someone with a plan, and have them help shoot the film.","nextNodeIds":[746830125]},{"nodeId":746830125,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1972271258,"text":"Rather than focusing on narrative elements, a commercial needs to capture the audience's attention quickly, so they are faster-paced, and we filmmakers need to be more creative with our methods.","nextNodeIds":[746830126]},{"nodeId":746830126,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":2307007842,"text":"Oh... and the sponsors themselves are full of ideas, not all of them good. Some give contradictory suggestions, while others are befuddlingly unreasonable...","nextNodeIds":[746830127]},{"nodeId":746830127,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":591062266,"text":"Ha, don't let anyone else hear a word of that, though.","nextNodeIds":[746830128]},{"nodeId":746830128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":595515554,"text":"That sounds rough.","nextNodeIds":[746830129]},{"nodeId":746830129,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":2794118746,"text":"It's alright. There's a price to be paid for creating the stories I truly want to. It's like eating seafood — can't get at that sweet meat within without cracking the shell, can you? Don't worry about me.","nextNodeIds":[746830130]},{"nodeId":746830130,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1236570762,"text":"Also, if you thought my previous examples were absurd, you should've seen the sponsor who insisted that I have my thriller film protagonist, a tough, no-nonsense guy, show up in the film's opening chugging a carton of their baby milk...","nextNodeIds":[746830131]},{"nodeId":746830131,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3239868330,"text":"More commercials shot on the side means fewer product placements in my films... Put that way, commercial shootings seem like a much more pleasant option.","nextNodeIds":[746830132]},{"nodeId":746830132,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":3029100194,"text":"Ah, yes. Now that I think about it, there is a little something I could use your help with. Interested?","nextNodeIds":[746830133]},{"nodeId":746830133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1489139714,"text":"What is it?","nextNodeIds":[746830134]},{"nodeId":746830134,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":1754545378,"text":"Well, it's been an age and a half since we last worked together. We shot tons of good films then, and if memory serves, you quite enjoyed the process too!","nextNodeIds":[746830135]},{"nodeId":746830135,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":591561010,"text":"Want to try making a commercial together this time? They're quite different from films, but they have charms all their own.","nextNodeIds":[746830136]},{"nodeId":746830136,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":2972087026,"text":"I shot all the needed material beforehand, so you won't have to run around filming new scenes. All we need to do is add a little creative spice to the editing...","nextNodeIds":[746830137,746830138]},{"nodeId":746830137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":299804442,"text":"So this is post-production and editing?","nextNodeIds":[746830139]},{"nodeId":746830139,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":175238674,"text":"Great! In that case, come find me when you have time. Don't worry about the final product. I just want to do something meaningful with an old friend, and if anything comes up with the sponsors, I'll handle it.","nextNodeIds":[746830140]},{"nodeId":746830140,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","textMapHash":2713526970,"text":"Besides, commercials are meant to be interesting! Let us follow our muses and go with the flow. Who knows? Things might turn out better than we think!","nextNodeIds":[]},{"nodeId":746830138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2262539122,"text":"If you need creative spice, you've come to the right person!","nextNodeIds":[746830139]},{"nodeId":746830108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":796822930,"text":"With a little bit of saving the world on the side.","nextNodeIds":[746830109]},{"nodeId":746830103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":572910922,"text":"Long time no see, Xavier.","nextNodeIds":[746830104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30771"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"Xavier","count":28},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":12}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174683],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2168605358,"CHECNJEMEFE":{"30771":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74683/Q7468301","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],