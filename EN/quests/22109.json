{"mainQuestId":22109,"title":"Where Is the Unseen Razor?","description":"Lan has been looking for a certain sword. Her search has not been fruitful, so she's decided to widen her search range.","titleTextMapHash":196837769,"descTextMapHash":627518431,"mainQuestExcel":{"mainQuestId":22109,"titleTextMapHash":196837769,"title":"Where Is the Unseen Razor?","descTextMapHash":627518431,"description":"Lan has been looking for a certain sword. Her search has not been fruitful, so she's decided to widen her search range.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":627518431,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":22109,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3541938439,"LEFIHLHODBM":[],"luaPath":"","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":25001,"titleTextMapHash":196837769,"type":"IQ","unlockDescTextMapHash":1761523227}},"flow":[{"subQuestId":2210901,"order":1,"stepDescription":"Talk to Lan","stepDescTextMapHash":4139612742,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2210901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2016"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2210901,2210902],"talks":[{"talkId":2210901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2210901","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2210901,"initDialog":221090101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2016],"performCfg":"","priority":6,"questId":22109,"showRandomTalkCount":0},"dialogs":[{"nodeId":221090101,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":158090536,"text":"*sigh* Still nothing...","nextNodeIds":[221090102]},{"nodeId":221090102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4006075472,"text":"What's wrong?","nextNodeIds":[221090103]},{"nodeId":221090103,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2730662056,"text":"Oh, it's you two again. Clearly there aren't enough guild quests to keep you occupied.","nextNodeIds":[221090104]},{"nodeId":221090104,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":4050489232,"text":"If you are interested, I have another Commission you could take?","nextNodeIds":[221090105]},{"nodeId":221090105,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":74919088,"text":"A group of Hilichurl Shooters has congregated in the middle of Guili Plains and are threatening passers-by.","nextNodeIds":[221090106]},{"nodeId":221090106,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1143343624,"text":"They may only be hilichurls, but there are a lot of them and they have the higher ground. The average adventurer would be helpless against them.","nextNodeIds":[221090107]},{"nodeId":221090107,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":458769560,"text":"I need you to dispose of them, quickly and efficiently. Afterwards, there will be ample compensation waiting for you.","nextNodeIds":[221090108]},{"nodeId":221090108,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1164964896,"text":"Also — if you come across anything to do with a sword, anything at all, please bring it back to me.","nextNodeIds":[221090109,221090110]},{"nodeId":221090109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1774654296,"text":"I'll take it.","nextNodeIds":[221090111]},{"nodeId":221090111,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1897537992,"text":"I can't tell whether your eagerness to take this on is born out of youthful naivety or boundless courage...","nextNodeIds":[221090112]},{"nodeId":221090112,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1517441168,"text":"But if I'm sure about one thing, it's that you truly have an Adventurer's spirit.","nextNodeIds":[221090115]},{"nodeId":221090115,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2433948600,"text":"That's all I have to say. It's time for you to get ready.","nextNodeIds":[]},{"nodeId":221090110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":764301936,"text":"What does the sword mean to these hilichurls?","nextNodeIds":[221090113]},{"nodeId":221090113,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":651061552,"text":"Nothing, the two are unrelated. All I need you to do is keep an eye out for it — if you find something, bring it back. If not, it's no problem.","nextNodeIds":[221090114]},{"nodeId":221090114,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1536255640,"text":"The objective of this Commission is to defeat the hilichurls. Defeat them, and you will get your reward.","nextNodeIds":[221090115]}]},{"talkId":2210902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2210901","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2210902","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2210902,"initDialog":221090201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2016],"performCfg":"","priority":6,"questId":22109,"showRandomTalkCount":0},"dialogs":[{"nodeId":221090201,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1875225480,"text":"Have you 