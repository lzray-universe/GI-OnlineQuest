70201,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":2598887570,"text":"#Over here, {NICKNAME}, over here!","nextNodeIds":[756570202]},{"nodeId":756570202,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":829803778,"text":"Remember this place? It's where our journey began.","nextNodeIds":[756570203]},{"nodeId":756570203,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":3105372146,"text":"We've been to so many places since then! Time really flies, huh... Just thinking about it makes Paimon kinda emotional. Ooh, she could write a poem right now!","nextNodeIds":[756570204,756570205]},{"nodeId":756570204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4208363994,"text":"Please, go right ahead, O great bard Paimon~","nextNodeIds":[756570207]},{"nodeId":756570205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1483774922,"text":"Pfft.","nextNodeIds":[756570206]},{"nodeId":756570206,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":4078168698,"text":"Oh, don't interrupt. Let Paimon think...","nextNodeIds":[756570207]},{"nodeId":756570207,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":2587584026,"text":"Ah, vast Teyvat!","nextNodeIds":[756570208]},{"nodeId":756570208,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":3216259858,"text":"How far have we traveled, yet not seen your full breadth!","nextNodeIds":[756570209,756570210]},{"nodeId":756570209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2492179962,"text":"(Remain silent.)","nextNodeIds":[756570211]},{"nodeId":756570210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2752188122,"text":"That didn't rhyme at all.","nextNodeIds":[756570211]},{"nodeId":756570211,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":1919306666,"text":"Ah! Ah... Huh, and the thought's gone.","nextNodeIds":[756570212,756570214]},{"nodeId":756570212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3181479258,"text":"Hahahaha!","nextNodeIds":[756570213]},{"nodeId":756570214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1001354394,"text":"Do you mean to reflect on how tough this journey's been?","nextNodeIds":[756570215]},{"nodeId":756570213,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":3925951922,"text":"Yeah, yeah, laugh it up. Paimon's used to it by now.","nextNodeIds":[756570216]},{"nodeId":756570215,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":3233595546,"text":"That's right! Hehe, you sure know Paimon well.","nextNodeIds":[756570216]},{"nodeId":756570216,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":1601334626,"text":"But seriously, it's easy to forget where we started after all this traveling.","nextNodeIds":[756570217]},{"nodeId":756570217,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":376411138,"text":"For example, Paimon can't quite remember what Sweet Madames taste like nowadays, and that was one of her favorite dishes, too...","nextNodeIds":[756570218]},{"nodeId":756570218,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":350694946,"text":"That's why Paimon bought this album in the first place, to take pictures of the places we've been and the people we've met.","nextNodeIds":[756570219]},{"nodeId":756570219,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":4215602954,"text":"\"The end is close once we get back to where we started.\" That happens pretty often in light novels and films, doesn't it?","nextNodeIds":[756570220]},{"nodeId":756570220,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":2763086346,"text":"That's why we're taking a picture here. Not to feel all sad and stuff, but 'cause we hope to always remember the road we've taken, all the better to tread the road ahead...","nextNodeIds":[756570221,756570222]},{"nodeId":756570221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1140891986,"text":"Have you been eavesdropping on my conversations with Kazuha?","nextNodeIds":[756570224]},{"nodeId":756570222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4209708578,"text":"What? Paimon is evolving!","nextNodeIds":[756570223]},{"nodeId":756570223,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":4191397890,"text":"Well... Yeah, Paimon was listening when you and Kazuha were chatting.","nextNodeIds":[756570224]},{"nodeId":756570224,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":3254051354,"text":"C'mon, we were trying to create an atmosphere here — and now it's all gone.","nextNodeIds":[756570225]},{"nodeId":756570225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4277272354,"text":"Don't worry, I understand what you mean.","nextNodeIds":[756570226]},{"nodeId":756570226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1453054610,"text":"We'll forge ahead.","nextNodeIds":[756570227]},{"nodeId":756570227,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":2107689714,"text":"Hehe, sure, as long as you get it.","nextNodeIds":[756570228]},{"nodeId":756570228,"roleType":"TALK_ROLE_NPC","speakerId":30632,"speakerName":"Paimon","textMapHash":1599298642,"text":"Alright! Your model for this picture is going to be Teyvat's number one guide! So, what pose would you like to go for?","nextNodeIds":[756570229,756570230,756570231]},{"nodeId"