{"mainQuestId":72688,"title":"The Floral Courtyard: Part II","description":"Amidst the Irodori Festival, the florist Fushizome is looking for someone to experience the art of ikebana.","titleTextMapHash":184470111,"descTextMapHash":3945856758,"mainQuestExcel":{"mainQuestId":72688,"titleTextMapHash":184470111,"title":"The Floral Courtyard: Part II","descTextMapHash":3945856758,"description":"Amidst the Irodori Festival, the florist Fushizome is looking for someone to experience the art of ikebana.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2012,"luaPath":"Actor/Quest/WQ72688","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2012,"chapterId":0,"descTextMapHash":3945856758,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72688,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1580496969,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72688","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172688],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":184470111,"type":"WQ","unlockDescTextMapHash":3810011134}},"flow":[{"subQuestId":7268801,"order":1,"stepDescription":"Wait till the next morning (08:00 – 12:00) and talk to Fushizome","stepDescTextMapHash":3575593644,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"8,12"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7268803],"talks":[{"talkId":7268803,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7268801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7268803","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268803,"initDialog":726870201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30171],"performCfg":"QuestDialogue/WQ/Inazuma_72687/Q7268702","priority":5,"questId":72688,"showRandomTalkCount":0},"dialogs":[{"nodeId":726870201,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2434204082,"text":"In the following days, I will continue to stay here and guide those who come for the Irodori Festival, and help them to enjoy the beauty of the \"floral courtyards.\"","nextNodeIds":[726870202]},{"nodeId":726870202,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":151836690,"text":"Don't forget to drop by every day to get another \"theme.\" There will be a total of four such themes for you to figure out.","nextNodeIds":[726870203]},{"nodeId":726870203,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":845616874,"text":"Of course, if you have any other questions, I will do my best to answer them for you.","nextNodeIds":[726870204,726870210,726870222]},{"nodeId":726870204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4206709530,"text":"About the flowers here...","nextNodeIds":[726870205]},{"nodeId":726870205,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":919871594,"text":"The flowers I use are all provided by Sakuya's Flowers. The flowers they grow are of impeccable quality and affordable prices.","nextNodeIds":[726870206]},{"nodeId":726870206,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1719476458,"text":"Perhaps you've met Sakuya as well. We once studied ikebana under the same master.","nextNodeIds":[726870207]},{"nodeId":726870207,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3009817834,"text":"Sakuya is also very well-studied in the floral arts, but when she heard that there would be tons of people at the Irodori Festival, she seemed to have gotten a bit of stage fright. She said that it would be difficult to quiet down and focus on her work in such an environment.","nextNodeIds":[726870208]},{"nodeId":726870208,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2499178986,"text":"In any case, I will advertise Sakuya's Flowers on her behalf.","nextNodeIds":[726870209]},{"nodeId":726870209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2082577922,"text":"We can help too if you need us!","nextNodeIds":[726870219]},{"nodeId":726870219,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1010027682,"text":"Well then, do the two of you have any other questions?","nextNodeIds":[726870220]},{"nodeId":726870220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3067219490,"text":"Thank you, Ms. Fushizome.","nextNodeIds":[726870221]},{"nodeId":726870221,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":139603770,"text":"Think nothing of it. If you have time, you can come and look for me any time.","nextNodeIds":[]},{"nodeId":726870210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1503724594,"text":"About the Yashiro Commission's involvement...","nextNodeIds":[726870211]},{"nodeId":726870211,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2797110330,"text":"The Yashiro Commission has always been very supportive of Inazuma's floral arts. Indeed, the person who sponsored this event is the Shirasagi Himegimi.","nextNodeIds":[726870212]},{"nodeId":726870212,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2496297666,"text":"She has always been incredibly talented in these arts, even from a young age. I saw her perform ikebana once, and even had the honor of exchanging pointers with her.","nextNodeIds":[726870213]},{"nodeId":726870213,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1508383266,"text":"Although I'm older than her, I'm nowhere near her ability in terms of skill in ikebana or understanding of the floral arts.","nextNodeIds":[726870214]},{"nodeId":726870214,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1416659450,"text":"Where circumstances have permitted, she has provided funding to help publicize ikebana every year. I've even heard that she has used her own savings to do so...","nextNodeIds":[726870215]},{"nodeId":726870215,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2580369618,"text":"She once expressed her frank desire for more people to understand ikebana and to drum up more interest in it such that more might want to practice this art.","nextNodeIds":[726870216]},{"nodeId":726870216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1890863482,"text":"Huh. So Ayaka did so much for Inazuma's floral arts...","nextNodeIds":[726870217]},{"nodeId":726870217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3694582458,"text":"I hope her wish comes true.","nextNodeIds":[726870218]},{"nodeId":726870218,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1842969362,"text":"Thank you both. You are indeed good-hearted people.","nextNodeIds":[726870219]},{"nodeId":726870222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1782352058,"text":"I have no further questions at the moment.","nextNodeIds":[726870223]},{"nodeId":726870223,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3508514954,"text":"Alright, then. You can come and look for me any time.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMO