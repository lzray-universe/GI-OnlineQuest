kPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7268802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268801,"initDialog":726880101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30171],"performCfg":"QuestDialogue/WQ/Inazuma_72688/Q7268801","priority":5,"questId":72688,"showRandomTalkCount":0},"dialogs":[{"nodeId":726880101,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":966049714,"text":"We meet again, you two.","nextNodeIds":[726880102]},{"nodeId":726880102,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":4029772818,"text":"The previous \"floral courtyard\" was a pleasure to behold indeed. You are both most talented, to have grasped the essence of the art so quickly.","nextNodeIds":[726880103]},{"nodeId":726880103,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":1687069266,"text":"The new theme awaits your perusal.","nextNodeIds":[726880104,726880110]},{"nodeId":726880104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1030896258,"text":"Well, let's begin, then.","nextNodeIds":[726880105]},{"nodeId":726880105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1689995074,"text":"Yup! We're ready as can be!","nextNodeIds":[726880106]},{"nodeId":726880106,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2463926658,"text":"Haha, such a vivid sparkle there in your eyes, almost like they reflect a radiant sea of flowers. Most lovely indeed...","nextNodeIds":[726880107]},{"nodeId":726880107,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2580659418,"text":"In that case, today's theme is slightly harder than the last one, all the better for you to refine your craft with...","nextNodeIds":[726880108]},{"nodeId":726880108,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2563227306,"text":"\"Silken and sturdy, the lotus in the pond.\"","nextNodeIds":[726880109]},{"nodeId":726880109,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":3594955122,"text":"Ponder the meaning of this theme and select your flowers carefully to form a most special \"floral courtyard.\"","nextNodeIds":[]},{"nodeId":726880110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1263278754,"text":"I've got some other things to do at the moment...","nextNodeIds":[726880111]},{"nodeId":726880111,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":599818586,"text":"That's alright. Ikebana requires one's full attention, after all.","nextNodeIds":[726880112]},{"nodeId":726880112,"roleType":"TALK_ROLE_NPC","speakerId":30171,"speakerName":"Fushizome","textMapHash":2132517626,"text":"Once you have completed the various tasks you have on hand, rendering yourself free of disturbances, I'm certain that your floral courtyard shall be all the more perfect for it.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268802,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPI