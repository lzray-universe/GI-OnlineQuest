kMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7050303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7050302,"initDialog":705030201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1029],"performCfg":"QuestDialogue/WQ/Mengde_70503/Q7050302","priority":5,"questId":70503,"showRandomTalkCount":0},"dialogs":[{"nodeId":705030238,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3322561298,"text":"Following Paimon's instructions, you mix water into the coffee...","nextNodeIds":[]},{"nodeId":705030201,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":551106170,"text":"This tastes pretty good...","nextNodeIds":[705030202]},{"nodeId":705030202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3793339186,"text":"Wow, she didn't even notice how much water we added. She must've had a lot to drink.","nextNodeIds":[705030203]},{"nodeId":705030203,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2850106202,"text":"One more, bartender... Huh? W—Wait, it's you guys?","nextNodeIds":[705030204,705030205]},{"nodeId":705030204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2278333066,"text":"We're learning to become bartenders...","nextNodeIds":[705030206]},{"nodeId":705030205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":110689314,"text":"You only just now noticed us?","nextNodeIds":[705030206]},{"nodeId":705030206,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2765594298,"text":"Ugh...","nextNodeIds":[705030207]},{"nodeId":705030207,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1573705306,"text":"Sorry. I just came here from The Cat's Tail. Perhaps I had a little too much to drink...","nextNodeIds":[705030208,705030209]},{"nodeId":705030208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4281693018,"text":"Is something troubling you?","nextNodeIds":[705030210]},{"nodeId":705030209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2886764346,"text":"I'm here if you want to talk.","nextNodeIds":[705030210]},{"nodeId":705030210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2390706946,"text":"Yeah. It's pretty lonely to drink by yourself. You'll feel better if you talk to us!","nextNodeIds":[705030211]},{"nodeId":705030211,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1837682010,"text":"...","nextNodeIds":[705030212]},{"nodeId":705030212,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2092722522,"text":"I suppose I always do drink alone.","nextNodeIds":[705030213]},{"nodeId":705030213,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1879208218,"text":"As long as I'm in Mondstadt, I'll never be welcome at taverns. I was actually feeling good today and wanted a drink, but they still wouldn't get off my back...","nextNodeIds":[705030214]},{"nodeId":705030214,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3086812306,"text":"#Tell me, {NICKNAME}, how did you manage to make so many friends?","nextNodeIds":[705030215]},{"nodeId":705030215,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1159541330,"text":"People always sound so appreciative and are always smiling when they talk about you.","nextNodeIds":[705030216]},{"nodeId":705030216,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3820780866,"text":"But as for me, just mentioning my family name is enough to make everyone...","nextNodeIds":[705030217]},{"nodeId":705030217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1254022810,"text":"Hey, don't think like that.","nextNodeIds":[705030218]},{"nodeId":705030218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1812313594,"text":"You didn't choose to be born into the Lawrence clan, and we don't care about that kind of thing. The Eula we know is a great person!","nextNodeIds":[705030219]},{"nodeId":705030219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":803050634,"text":"But you don't like being straightforward. You always pretend to hold a grudge, and you try to hide your tenderness away from everyone...","nextNodeIds":[705030220]},{"nodeId":705030220,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":3193886026,"text":"Hey, who said I was pretending.","nextNodeIds":[705030221,705030222]},{"nodeId":705030221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1820367298,"text":"Others will accept you, Eula...","nextNodeIds":[705030223]},{"nodeId":705030222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1666847650,"text":"There will be many people who accept you one day, Eula...","nextNodeIds":[705030223]},{"nodeId":705030223,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1544185834,"text":"Do you think so? Heh, it's impossible to imagine, even when I'm this drunk...","nextNodeIds":[705030224]},{"nodeId":705030224,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1564749370,"text":"Even after being a Knight of Favonius for all this time, people still... whatever.","nextNodeIds":[705030225]},{"nodeId":705030225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":587334058,"text":"Winds always change their course.","nextNodeIds":[705030226]},{"nodeId":705030226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":212991226,"text":"Oh, right! Tone-Deaf Bard said something wise like that, too.","nextNodeIds":[705030227]},{"nodeId":705030227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2349835986,"text":"Just be yourself, Eula... and keep moving forward.","nextNodeIds":[705030228]},{"nodeId":705030228,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1041182842,"text":"Sooner or later you'll change what people think about the Lawrence clan!","nextNodeIds":[705030229]},{"nodeId":705030229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4035747146,"text":"Yes, just be patient.","nextNodeIds":[705030230]},{"nodeId":705030230,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":4038937698,"text":"Okay, thank you...","nextNodeIds":[705030231]},{"nodeId":705030231,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2222342362,"text":"I... ahem! I should go now.","nextNodeIds":[705030232]},{"nodeId":705030232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1062157442,"text":"Would you like me to walk you back?","nextNodeIds":[705030233]},{"nodeId":705030233,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2857902754,"text":"No need. I want to remember what you said, and I won't be able to think about anything else until I write everything down.","nextNodeIds":[705030234]},{"nodeId":705030234,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":933193698,"text":"Eula sure is a lot more open after a few drinks.","nextNodeIds":[705030235]},{"nodeId":705030235,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3115114242,"text":"But it does feel like something's missing without her signature revenge line.","nextNodeIds":[705030236]},{"nodeId":705030236,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2594517674,"text":"Uh-oh... When she wakes up in the morning, do you think she'll come threatening us to forget about what happened today?","nextNodeIds":[705030237]},{"nodeId":705030237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3990139506,"text":"Hmm, maybe.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,50],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[{"LNHLPKELCAL":["1068","201068004"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["1068","201068005"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1029"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7050301,7050302],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":13},{"roleType":"TALK_ROLE_NP