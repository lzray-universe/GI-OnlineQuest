"BFGALAINLMD":0,"LNHLPKELCAL":[7506605,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7506601,7506602,7506603,7506604,7506605],"talks":[{"talkId":7506601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","2","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506601,"initDialog":750660101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21681],"performCfg":"QuestDialogue/WQ/Natlan_75066/Q7506601","priority":5,"questId":75066,"showRandomTalkCount":0},"dialogs":[{"nodeId":750660101,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3336601394,"text":"These inhuman creatures are truly tough adversaries... inhuman monsters, I should say. Greetings, brave warrior... I am Quenin, a member of this adventure team. My duty is...","nextNodeIds":[750660102]},{"nodeId":750660102,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1530469514,"text":"My duty... is to eliminate these monsters. Yes, I am a warrior of the adventure team. Be careful, brave warrior...","nextNodeIds":[750660103]},{"nodeId":750660103,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2975310834,"text":"These monsters... they are extremely cunning — capable of disguising themselves in different forms.","nextNodeIds":[750660104]},{"nodeId":750660104,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2952191258,"text":"Every night, before I fall asleep, I hear... the sounds they make from their hiding spots in these ancient ruins. This... is why I cannot sleep at the encampment.","nextNodeIds":[750660105]},{"nodeId":750660105,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3304711090,"text":"This place is filled with these monsters. You... must be careful, too.","nextNodeIds":[]}]},{"talkId":7506602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","3","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","2","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506602,"initDialog":750660201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21681],"performCfg":"QuestDialogue/WQ/Natlan_75066/Q7506602","priority":5,"questId":75066,"showRandomTalkCount":0},"dialogs":[{"nodeId":750660201,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1291931762,"text":"Ah, this place really is cursed...","nextNodeIds":[750660202]},{"nodeId":750660202,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":647196474,"text":"Do not tarry here too long. You must leave, and quickly... Yes, you must leave before the coming of the pitch-black tide.","nextNodeIds":[750660203]},{"nodeId":750660203,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":508933234,"text":"Yes, the pitch-black tide. Its vast shadow is almost upon us. We must... Must ensure that everyone gets to safety. That everyone... is safely evacuated.","nextNodeIds":[]}]},{"talkId":7506603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","4","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","3","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506603,"initDialog":750660301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21681],"performCfg":"QuestDialogue/WQ/Natlan_75066/Q7506603","priority":5,"questId":75066,"showRandomTalkCount":0},"dialogs":[{"nodeId":750660301,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":333988842,"text":"Why do you linger here still...?","nextNodeIds":[750660302]},{"nodeId":750660302,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":824881258,"text":"Our adventure team's leader, the hero who wore a falcon's mask, is already... We cannot hold out against them any longer...","nextNodeIds":[750660303]},{"nodeId":750660303,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1520949906,"text":"You must leave as soon as possible. This place is cursed, brave warrior. It is not somewhere that people should stay.","nextNodeIds":[]}]},{"talkId":7506604,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","5","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","4","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506604,"initDialog":750660401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21681],"performCfg":"QuestDialogue/WQ/Natlan_75066/Q7506604","priority":5,"questId":75066,"showRandomTalkCount":0},"dialogs":[{"nodeId":750660401,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1061543482,"text":"So you are still here, brave warrior.","nextNodeIds":[750660402]},{"nodeId":750660402,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":869844122,"text":"Once upon a time, so the scholars say, the ancient and tyrannical Lord of this Cinder City knew... a way to prevent Abyssal corrosion. So we...","nextNodeIds":[750660403]},{"nodeId":750660403,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3545095186,"text":"But there really is something ominous about this place, brave warrior. Lately, I too have begun to feel a little... strange.","nextNodeIds":[750660404]},{"nodeId":750660404,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3487644842,"text":"Sometimes, after waking, you'll find that a road that was perfectly intact just the day before has now become broken and dilapidated... And were those stone houses like that there to begin with? It feels like they should be more... complete.","nextNodeIds":[750660405]},{"nodeId":750660405,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":165172002,"text":"But sometimes, when I wake, I see friends who should not be here anymore... Are they monsters? That must be it... They're monsters that have taken the form of my friends.","nextNodeIds":[750660406]},{"nodeId":750660406,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3702014826,"text":"My... My duty here is to eliminate those monsters, but... why? Why do I have to do that?","nextNodeIds":[750660407]},{"nodeId":750660407,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2373014546,"text":"Anyway, all things said and done, this is a very strange place. You should leave... as soon as possible.","nextNodeIds":[]}]},{"talkId":7506605,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","6","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","5","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506605,"initDialog":750660501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21681],"performCfg":"QuestDialogue/WQ/Natlan_75066/Q7506605","priority":5,"questId":75066,"showRandomTalkCount":0},"dialogs":[{"nodeId":750660501,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":159676290,"text":"You'd better leave at once. If you stay any longer, it'll be too late...","nextNodeIds":[750660502]},{"nodeId":750660502,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3692300442,"text":"Why will it be too late, you ask? Because... because our entire adventure team has been wiped out. That giant, pitch-black beast... They were all...","nextNodeIds":[750660503]},{"nodeId":750660503,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1208060714,"text":"They tasked me with protecting the evacuees, and at the very least, to ensure that they left the city. As we speak, a rescue team from the Flower-Feather Clan is on their way...","nextNodeIds":[750660504]},{"nodeId":750660504,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2664240330,"text":"I must eliminate these evil monsters, so that the survivors can return to a land upon which the sun shines... Huh, but... Why am I here again?","nextNodeIds":[750660505]},{"nodeId":750660505,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":555143146,"text":"That sound in my ears... Ahh, it's getting louder and louder. I... I have to go back to the waterfall. Yes, I must... return to the waterfall.","nextNodeIds":[750660506]},{"nodeId":750660506,"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":747921562,"text":"Brave warrior, you too should leave... as soon as possible.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7506601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506604,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506605,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3219422058,"text":"These inhuman creatures are truly tough adversaries... inhuman monsters, I should say. Greetings, brave warrior... I am Quenin, a member of this adventure team. My duty is..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3303415866,"text":"My duty... is to eliminate these monsters. Yes, I am a warrior of the adventure team. Be careful, brave warrior..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":4281776186,"text":"These monsters... they are extremely cunning — capable of disguising themselves in different forms."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":154028930,"text":"Every night, before I fall asleep, I hear... the sounds they make from their hiding spots in these ancient ruins. This... is why I cannot sleep at the encampment."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":175372314,"text":"This place is filled with these monsters. You... must be careful, too."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1849380922,"text":"Ah, this place really is cursed..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2893857290,"text":"Do not tarry here too long. You must leave, and quickly... Yes, you must leave before the coming of the pitch-black tide."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":873672426,"text":"Yes, the pitch-black tide. Its vast shadow is almost upon us. We must... Must ensure that everyone gets to safety. That everyone... is safely evacuated."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3929413482,"text":"Why do you linger here still...?"},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2876469082,"text":"Our adventure team's leader, the hero who wore a falcon's mask, is already... We cannot hold out against them any longer..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":640878266,"text":"You must leave as soon as possible. This place is cursed, brave warrior. It is not somewhere that people should stay."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1721108354,"text":"So you are still here, brave warrior."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2083877858,"text":"Once upon a time, so the scholars say, the ancient and tyrannical Lord of this Cinder City knew... a way to prevent Abyssal corrosion. So we..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1479117330,"text":"But there really is something ominous about this place, brave warrior. Lately, I too have begun to feel a little... strange."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2315920658,"text":"Sometimes, after waking, you'll find that a road that was perfectly intact just the day before has now become broken and dilapidated... And were those stone houses like that there to begin with? It feels like they should be more... complete."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2547380138,"text":"But sometimes, when I wake, I see friends who should not be here anymore... Are they monsters? That must be it... They're monsters that have taken the form of my friends."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":1765047778,"text":"My... My duty here is to eliminate those monsters, but... why? Why do I have to do that?"},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":844658562,"text":"Anyway, all things said and done, this is a very strange place. You should leave... as soon as possible."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":577629162,"text":"You'd better leave at once. If you stay any longer, it'll be too late..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":3210257506,"text":"Why will it be too late, you ask? Because... because our entire adventure team has been wiped out. That giant, pitch-black beast... They were all..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2051312610,"text":"They tasked me with protecting the evacuees, and at the very least, to ensure that they left the city. As we speak, a rescue team from the Flower-Feather Clan is on their way..."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":4021511442,"text":"I must eliminate these evil monsters, so that the survivors can return to a land upon which the sun shines... Huh, but... Why am I here again?"},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":2601919602,"text":"That sound in my ears... Ahh, it's getting louder and louder. I... I have to go back to the waterfall. Yes, I must... return to the waterfall."},{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","textMapHash":4205324434,"text":"Brave warrior, you too should leave... as soon as possible."}],"talkIds":[7506601,7506602,7506603,7506604,7506605],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21681,"speakerName":"Quenin","count":48}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2755629326,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75066/Q7506601","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[{"LNHLPKELCAL":["7504101","2"],"PAINLIBBLDK":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"}],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_AND","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":750660101,"ILHDCGDKKKA":"TALK_HERO_LOCAL","ILHDNJDDEOP":7506601,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[21681],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOEL