formCfg":"","priority":5,"questId":41402,"showRandomTalkCount":0},"dialogs":[{"nodeId":414020101,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2161172266,"text":"Ah, hello. Just the person I wanted to speak to.","nextNodeIds":[414020102,414020103]},{"nodeId":414020102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3311024730,"text":"About what?","nextNodeIds":[414020104]},{"nodeId":414020104,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3622973722,"text":"Nope, no need. I've figured out what it was.","nextNodeIds":[414020105]},{"nodeId":414020105,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3933947058,"text":"I finally managed to track down the merchant the other day. The one who sold it to me in the first place.","nextNodeIds":[414020106]},{"nodeId":414020106,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2393302290,"text":"I told him there was a problem with the Kamera he sold me, but he was having none of it.","nextNodeIds":[414020107]},{"nodeId":414020107,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":486781082,"text":"Luckily I had all the photos you took for me. Without them, I'd have had no way of convincing him.","nextNodeIds":[414020108]},{"nodeId":414020108,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3222406850,"text":"After taking a look at your photos, he finally agreed to take a look at the Kamera he sold to me.","nextNodeIds":[414020109]},{"nodeId":414020109,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1560874306,"text":"Yesterday, he came to see me and brought a bottle of some sort of potion with him.","nextNodeIds":[414020110]},{"nodeId":414020110,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2987430994,"text":"He explained that this Kamera works differently from regular models. You need to add some of this potion to it to make sure the photos turn out normal.","nextNodeIds":[414020111]},{"nodeId":414020111,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1828584506,"text":"If you don't add any, the photos turn out just like yours did. Just pages of color, rather than clear images.","nextNodeIds":[414020112,414020113]},{"nodeId":414020112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":742312770,"text":"Good thing that your Kamera's not broken, then.","nextNodeIds":[414020114]},{"nodeId":414020114,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3052615170,"text":"Well... To be honest, I'm less interested in the Kamera itself now. This potion is what intrigues me...","nextNodeIds":[414020115]},{"nodeId":414020115,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1238218890,"text":"Think about it. Most people will just buy the Kamera, right? Buy it once, use it forever.","nextNodeIds":[414020116]},{"nodeId":414020116,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1250502034,"text":"But this potion is a consumable. So, once you've used it up, you have to buy more if you want to keep using it.","nextNodeIds":[414020117]},{"nodeId":414020117,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":773152610,"text":"Also, the guy says that different potions will produce photos with different effects. He's currently developing more types...","nextNodeIds":[414020118]},{"nodeId":414020118,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":294069666,"text":"Maybe... Just maybe, those bottles of potion are where the big business opportunity is.","nextNodeIds":[414020119]},{"nodeId":414020119,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":988492122,"text":"Ah, sorry. I'm rambling.","nextNodeIds":[414020120]},{"nodeId":414020120,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2541755066,"text":"Thanks for all your help. Hand me this Kamera, I'll add some potion in for you...","nextNodeIds":[]},{"nodeId":414020113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2350669698,"text":"So... problem sorted?","nextNodeIds":[414020114]},{"nodeId":414020103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3633977698,"text":"About strong-color photography?","nextNodeIds":[414020104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4140201,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4140202,"order":2,"stepDescription":"Talk to Ji Tong","stepDescTextMapHash":2147397724,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4140202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4140202],"talks":[{"talkId":4140202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4140202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["220019","1","","",""],"type":"QUEST_COND_ITEM_NUM_LESS_THAN"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4140202,"initDialog":414020201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30044],"performCfg":"","priority":4,"questId":41402,"showRandomTalkCount":0},"dialogs":[{"nodeId":414020201,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":680781162,"text":"Traveler, hold on a second.","nextNodeIds":[414020202]},{"nodeId":414020202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4177073010,"text":"What's up?","nextNodeIds":[414020203]},{"nodeId":414020203,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1567791226,"text":"I know this is a bit sudden, but... Do you have any interest in Kameras?","nextNodeIds":[414020204,414020205]},{"nodeId":414020204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2686370898,"text":"Sure, a little.","nextNodeIds":[414020206]},{"nodeId":414020206,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":3621029906,"text":"Well, this Kamera here is no ordinary Kamera. It uses the latest technology from Fontaine.","nextNodeIds":[414020207]},{"nodeId":414020207,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1552216458,"text":"The photos printed by this model all come with a unique effect not offered by standard Kameras.","nextNodeIds":[414020208,414020209]},{"nodeId":414020208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":226267434,"text":"How does it do that?","nextNodeIds":[414020210]},{"nodeId":414020210,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2696111746,"text":"Hey! I'm telling the absolute truth here. If you don't believe me, you can ask about it at the Adventurers' Guild.","nextNodeIds":[414020211]},{"nodeId":414020211,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2991752554,"text":"I was skeptical at first, too. I played around with it for ages, but couldn't get it working. Eventually, one of the adventurers from the Guild gave me a hand.","nextNodeIds":[414020212]},{"nodeId":414020212,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":658305802,"text":"Now. You must be wondering, what makes this Kamera so different? Well, it's to do with the internal design.","nextNodeIds":[414020213]},{"nodeId":414020213,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":4199432906,"text":"It takes a certain kind of potion that adds a special effect during the printing process, making the photos look much better than those printed by your average Kamera.","nextNodeIds":[414020214]},{"nodeId":414020214,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":204470834,"text":"What do you think? If you're interested, I can let you play around with this one for a while. It has a limited variety of potions, but enough for you to get a feel for how it works.","nextNodeIds":[414020215]},{"nodeId":414020215,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":2589404338,"text":"I plan to make a trip to Fontaine at some point and purchase some new varieties of potions. So, if you're interested, I hope to have your custom then.","nextNodeIds":[414020216,414020217]},{"nodeId":414020216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4177115690,"text":"Alright then... Thanks...","nextNodeIds":[414020219]},{"nodeId":414020219,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":662768746,"text":"Please, keep this Kamera as a token of my esteem. If you enjoy using it, I'd appreciate your business in the future.","nextNodeIds":[]},{"nodeId":414020217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":448413026,"text":"How much do they cost?","nextNodeIds":[414020218]},{"nodeId":414020218,"roleType":"TALK_ROLE_NPC","speakerId":30044,"speakerName":"Ji Tong","textMapHash":1565857122,"text":"Oh, heh, don't you worry about that side of things. They're already very cheap when purchased individually, and if you plan on buying in bulk, we can discuss discounts...","nextNodeIds":[414020219]},{"nodeId":414020209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4105025794,"text":"...For real?","nextNodeIds":[414020210]},{"nodeId":414020205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":389527682,"text":"Not interested, sorry.","nextNodeIds":[414020206]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4140202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4140201,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["4140204","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4140203,"order":3,"stepDescription":"Talk to Ji Tong","stepDescTextMapHash":1966198652,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4140203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4140203],"talks":[{"talkId":4140203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param"