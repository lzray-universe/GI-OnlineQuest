"],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7280002,"initDialog":728000201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20329,20269,20270,20268],"performCfg":"QuestDialogue/WQ/Inazuma_72800/Q7280002","priority":5,"questId":72800,"showRandomTalkCount":0},"dialogs":[{"nodeId":728000201,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":1286020090,"text":"What can I do for you?","nextNodeIds":[728000202]},{"nodeId":728000202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":135268658,"text":"Excuse me, you are...","nextNodeIds":[728000203]},{"nodeId":728000203,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":4103253618,"text":"I'm Kamei Munehisa, I am just passing by.","nextNodeIds":[728000204]},{"nodeId":728000204,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":1036865706,"text":"Wow... This guy dresses like a samurai...","nextNodeIds":[728000205]},{"nodeId":728000205,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"Parvaneh","textMapHash":3428407786,"text":"S...samurai? Is he the samurai from the Shogunate... I heard that the Shogunate's attitude towards outlanders is quite... subtle...","nextNodeIds":[728000206]},{"nodeId":728000206,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":2416828450,"text":"...","nextNodeIds":[728000207]},{"nodeId":728000207,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":3774620946,"text":"Don't worry. I've left the Shogunate. I'm no longer a samurai.","nextNodeIds":[728000208]},{"nodeId":728000208,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":3461743058,"text":"I often come here to look for food. But today, I noticed monsters wandering around.","nextNodeIds":[728000209]},{"nodeId":728000209,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":3393629586,"text":"They've taken all the food around here. So I had to destroy them.","nextNodeIds":[728000210,728000212,728000214]},{"nodeId":728000210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":789286298,"text":"How often do you come here?","nextNodeIds":[728000211]},{"nodeId":728000211,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":2552767426,"text":"There are not many monsters around here usually. I often come here to pick fruits or hunt.","nextNodeIds":[728000217]},{"nodeId":728000217,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":2957415722,"text":"Well, that's all I have to say. After killing these monsters, the other ones around here won't dare to come here for a while.","nextNodeIds":[728000218]},{"nodeId":728000218,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":898404722,"text":"If you are also looking for food, you can look around. I only took what I need. There should be something left.","nextNodeIds":[728000219]},{"nodeId":728000219,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":1893660466,"text":"Well, goodbye.","nextNodeIds":[728000220]},{"nodeId":728000220,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":2347992114,"text":"Did he just leave just like that? His behavior is exactly like the samurai I heard about before...","nextNodeIds":[728000221]},{"nodeId":728000221,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"Parvaneh","textMapHash":2971860002,"text":"But what does he mean he's left the Shogunate? Samurai who have left the Shogunate are...","nextNodeIds":[728000222,728000223]},{"nodeId":728000222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1895158242,"text":"They are like the enemies we met before.","nextNodeIds":[728000224]},{"nodeId":728000224,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"Parvaneh","textMapHash":1901106914,"text":"Yes, I also heard that some samurai who have left the Shogunate wander around and rob people in the streets for a living...","nextNodeIds":[728000225]},{"nodeId":728000225,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"Parvaneh","textMapHash":4149726050,"text":"Although he doesn't look like a bad guy, we'd better stay vigilant.","nextNodeIds":[728000226]},{"nodeId":728000226,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":1994834346,"text":"All right, all right. Aren't we here to look for ingredients? But judging from the current situation, we'd better not go any further, in case it gets dangerous.","nextNodeIds":[728000227]},{"nodeId":728000227,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":2684175626,"text":"This traveler has been escorting us for such a long time. Let's cook something here, have a short break and then we'll head back to town.","nextNodeIds":[728000228]},{"nodeId":728000228,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":3491448346,"text":"The guy said there are still ingredients left behind, right? Let's look around.","nextNodeIds":[]},{"nodeId":728000223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":73224122,"text":"Like the Kairagi.","nextNodeIds":[728000224]},{"nodeId":728000212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":968091354,"text":"Did you kill all these monsters?","nextNodeIds":[728000213]},{"nodeId":728000213,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":3857371754,"text":"Yes, they are just ordinary monsters. They're easy to deal with.","nextNodeIds":[728000217]},{"nodeId":728000214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2266706034,"text":"Why are you looking for food in the wild?","nextNodeIds":[728000215]},{"nodeId":728000215,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":3833856218,"text":"...","nextNodeIds":[728000216]},{"nodeId":728000216,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"???","textMapHash":3174292698,"text":"I have my own reasons.","nextNodeIds":[728000217]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20329","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7280005,"order":5,"stepDescription":"Look for cooking ingredients","stepDescTextMapHash":4128518652,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7280001"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7280005","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7280001"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7280008","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUE