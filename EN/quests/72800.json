 it.","nextNodeIds":[728000319]},{"nodeId":728000319,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":30472378,"text":"By the way, traveler, thank you for spending all this time running around with us. Thank you.","nextNodeIds":[728000320]},{"nodeId":728000320,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":3488911434,"text":"I'll prepare a takeaway for you. You've got to have enough food when you are adventuring out there.","nextNodeIds":[728000321]},{"nodeId":728000321,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":1582032090,"text":"Next time we meet, I will treat you to a nice meal.","nextNodeIds":[]},{"nodeId":728000306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3458793386,"text":"I'll find you to cook me a feast next time.","nextNodeIds":[728000307]},{"nodeId":728000307,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":1026433898,"text":"Hahaha, okay. I'll make a note of this. I'll make sure to treat you to something nice next time...","nextNodeIds":[728000308]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133209005","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133209004","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["41130","1","100"],"PAINLIBBLDK":"QUEST_EXEC_SET_DAILY_TASK_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["20268","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUI