{"mainQuestId":74679,"title":"Spread Out Less Than an Arcminute!","description":"During the Fontinalia Film Festival, you and Paimon encounter a special member of the Gardes, she seems to be looking for guests to partake in an event test...","titleTextMapHash":66108303,"descTextMapHash":2268063006,"mainQuestExcel":{"mainQuestId":74679,"titleTextMapHash":66108303,"title":"Spread Out Less Than an Arcminute!","descTextMapHash":2268063006,"description":"During the Fontinalia Film Festival, you and Paimon encounter a special member of the Gardes, she seems to be looking for guests to partake in an event test...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2027,"luaPath":"Actor/Quest/WQ74679","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2027,"chapterId":0,"descTextMapHash":2268063006,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74679,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4091039721,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74679","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174679],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":66108303,"type":"WQ","unlockDescTextMapHash":1122498758}},"flow":[{"subQuestId":7467901,"order":1,"stepDescription":"Talk to the staff member","stepDescTextMapHash":458712868,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30485"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467901],"talks":[{"talkId":7467901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7467901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7467901,"initDialog":746790101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30485],"performCfg":"QuestDialogue/WQ/Filmfest_74679/Q7467901","priority":5,"questId":74679,"showRandomTalkCount":0},"dialogs":[{"nodeId":746790101,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":3643548002,"text":"Take your positions, form ranks, muskets up, take aim, and fire! Repel the enemy advance!","nextNodeIds":[746790102]},{"nodeId":746790102,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":2772074994,"text":"Come take part in the Special Security and Surveillance Patrol's special event, and experience the joy of being a musket sharpshooter!","nextNodeIds":[746790103,746790104]},{"nodeId":746790103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":805944586,"text":"Musket?","nextNodeIds":[746790105]},{"nodeId":746790105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3054944578,"text":"Not a concept we're too familiar with...","nextNodeIds":[746790106]},{"nodeId":746790106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1726485562,"text":"Looking at the stall this Garde set up, Paimon can't help but wonder what the event she mentioned could possibly have to do with the Fontinalia Film Festival...?","nextNodeIds":[746790107]},{"nodeId":746790107,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":1545847282,"text":"Ah, it's the Super Zenith Boss-Level Forces! What in the blazes are you doing here?","nextNodeIds":[746790108]},{"nodeId":746790108,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":80591666,"text":"If you two help me promote my booth, I'll be able to hit my quota for sure!","nextNodeIds":[746790109,746790110]},{"nodeId":746790109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2726832586,"text":"Who in the what now?","nextNodeIds":[746790111]},{"nodeId":746790111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":555604994,"text":"#Uhhh, that blah blah blah Forces thing isn't another weird nickname for Paimon and {NICKNAME}, is it?","nextNodeIds":[746790112]},{"nodeId":746790112,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":1854292642,"text":"That's right! It's a title for you two that's becoming popular among some members of the Gardes.","nextNodeIds":[746790113]},{"nodeId":746790113,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":3726444546,"text":"You might not remember, but we've actually met before... But considering how ordinary-looking I am, and the fact that I'm just a mediocre sharpshooter, I'm not surprised that I didn't leave much of an impression.","nextNodeIds":[746790114]},{"nodeId":746790114,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":3676315122,"text":"Anyway, let's just pretend that this is our first meeting! I'm Turenna, a Special Security and Surveillance Patrol Trainee, and I'm in charge of handling all sorts of odd jobs for the Patrol.","nextNodeIds":[746790115]},{"nodeId":746790115,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":4178881594,"text":"Given how popular the Film Festival is, the Special Patrol is hoping to ride on its coattails by running a publicity campaign, with the aim of spotting hidden talent among the citizenry.","nextNodeIds":[746790116]},{"nodeId":746790116,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":3897165362,"text":"So, ta-da! Behold the shooting simulator on the table in front of you, known as the \"Thousand-Pace Interdiction Arcminute Sharpshooting Zone\"!","nextNodeIds":[746790117]},{"nodeId":746790117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2540904586,"text":"This thing... looks like a little model of the Court of Fontaine?","nextNodeIds":[746790118]},{"nodeId":746790118,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":1153665810,"text":"Aha, but not just the Court of Fontaine! This sand table allows you to change the area, so you can switch to wilderness scenery if you want. Much less spectacular than the Court of Fontaine though...","nextNodeIds":[746790119]},{"nodeId":746790119,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":1415715778,"text":"Combined with a special pair of optical goggles that the Fontaine Research Institute developed for us, it lets you simulate taking out enemies from on high, just like a real Special Patrol sharpshooter!","nextNodeIds":[746790120]},{"nodeId":746790120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3665813874,"text":"Basically, it's a game where you simulate using a musket to aim and fire at targets, right?","nextNodeIds":[746790121]},{"nodeId":746790121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3588426,"text":"But the name is so hard to wrap your head around. What are \"Interdiction\" and \"Arcminute\" supposed to mean...","nextNodeIds":[746790122]},{"nodeId":746790122,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":2671436994,"text":"*cough* I came up with the event name based on a famous line that Captain Chevreuse once exhorted us with, which aptly expresses our lofty aspirations!","nextNodeIds":[746790123]},{"nodeId":746790123,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":811975026,"text":"\"An outstanding musket sharpshooter always strives for pinpoint accuracy. At a distance of a thousand paces, your shot grouping should be less than an arcminute!\"","nextNodeIds":[746790124]},{"nodeId":746790124,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":317172466,"text":"In reality though, based on the current processing precision of mass-produced muskets and the eyesight of our sharpshooters, achieving a dispersion of less than a single arcminute when firing from any further than a hundred paces away — let alone a thousand — is wishful thinking, to put it mildly...","nextNodeIds":[746790125]},{"nodeId":746790125,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":1382137258,"text":"But if we're talking about Captain Chevreuse, I wouldn't put it past her!","nextNodeIds":[746790126]},{"nodeId":746790126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3690232482,"text":"Whoa, slow down a second, you're making Paimon dizzy...","nextNodeIds":[746790127,746790128]},{"nodeId":746790127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1702491954,"text":"Don't get too hung up on technical terms.","nextNodeIds":[746790129]},{"nodeId":746790129,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":3798558730,"text":"Super Zenith Boss-Level Force is right! Sometimes it's not worth overthinking things, just give it a go!","nextNodeIds":[746790130]},{"nodeId":746790130,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":3191422746,"text":"When I first joined the Patrol, Captain Chevreuse told me that too!","nextNodeIds":[746790131]},{"nodeId":746790131,"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","textMapHash":3935597994,"text":"Anyway, please take these goggles, and when you're ready you can start playing with the simulator on the table!","nextNodeIds":[746790132]},{"nodeId":746790132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2562826858,"text":"Well, after talking so much, why don't we try it out?","nextNodeIds":[746790133]},{"nodeId":746790133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2784626914,"text":"Paimon was curious what it felt like to fire a musket anyway... Looks like it might be fun!","nextNodeIds":[]},{"nodeId":746790128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":969065978,"text":"All we need to do is have fun.","nextNodeIds":[746790129]},{"nodeId":746790110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":984065754,"text":"I'm confused.","nextNodeIds":[746790111]},{"nodeId":746790104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3204157466,"text":"Sharpshooter?","nextNodeIds":[746790105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30485"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30485,"speakerName":"Turenna","count":18},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174679],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2268063006,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMEN