{"mainQuestId":72658,"title":"Dreams of Bloom","description":"Something seems to be troubling Sakuya the florist...","titleTextMapHash":3928138383,"descTextMapHash":185337478,"mainQuestExcel":{"mainQuestId":72658,"titleTextMapHash":3928138383,"title":"Dreams of Bloom","descTextMapHash":185337478,"description":"Something seems to be troubling Sakuya the florist...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5047,"luaPath":"Actor/Quest/WQ72658","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5047,"chapterId":0,"descTextMapHash":185337478,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72658,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":253554561,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72658","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3928138383,"type":"WQ","unlockDescTextMapHash":3890216022}},"flow":[{"subQuestId":7265801,"order":1,"stepDescription":"Talk to Sakuya","stepDescTextMapHash":2154266732,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q72658_NPC_Pos","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7265801],"talks":[{"talkId":7265801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7265801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7265801,"initDialog":726580101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30083],"performCfg":"QuestDialogue/WQ/Inazuma_72658/Q7265801","priority":5,"questId":72658,"showRandomTalkCount":0},"dialogs":[{"nodeId":726580101,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":3594548082,"text":"Hello there! How would you like to grow some flowers of your very own?","nextNodeIds":[726580102]},{"nodeId":726580102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2659328698,"text":"What sort of flowers?","nextNodeIds":[726580103]},{"nodeId":726580103,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":138899874,"text":"Oh, interested, are we? Don't worry about not understanding everything at first, let me explain it to you in brief.","nextNodeIds":[726580104]},{"nodeId":726580104,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":2041572642,"text":"My name is Sakuya, and I'm a gardener who also runs a little business regarding flowers on the side.","nextNodeIds":[726580105]},{"nodeId":726580105,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":838461130,"text":"Well, I call it a business, but really, I just send people flowers most of the time, or I help some store with ikebana...","nextNodeIds":[726580106]},{"nodeId":726580106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1234590746,"text":"What's ikebana?","nextNodeIds":[726580107]},{"nodeId":726580107,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":106033234,"text":"Oh, you're not familiar? Ikebana is a very important art in Inazuma.","nextNodeIds":[726580108]},{"nodeId":726580108,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":56153658,"text":"In simple terms, you can consider ikebana the act of carefully cutting and processing flowers and other plants before arranging them in a suitable fashion...","nextNodeIds":[726580109]},{"nodeId":726580109,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":2627266794,"text":"In specific, however, you need to take care to grasp the current state of the plants and trim the less presentable parts of them away...","nextNodeIds":[726580110]},{"nodeId":726580110,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":2164211626,"text":"Moreover, your arrangement and placement must be suited to their environment, even down to the angle at which the flowers extend outward...","nextNodeIds":[726580111]},{"nodeId":726580111,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":386171882,"text":"These details must be given fastidious consideration, and can be a cumbersome process indeed.","nextNodeIds":[726580112]},{"nodeId":726580112,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":2951310114,"text":"Even for someone who loves ikebana like me, it is a most tiring job...","nextNodeIds":[726580113]},{"nodeId":726580113,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":1531463002,"text":"I used to have a storefront in the city, but the streets were far too noisy for me to concentrate on my work.","nextNodeIds":[726580114]},{"nodeId":726580114,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":1267282722,"text":"So I closed the shop, and now I just receive customers next to my flower field.","nextNodeIds":[726580115]},{"nodeId":726580115,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":1501820362,"text":"It's a quieter spot for sure, though I do get less business...","nextNodeIds":[726580116]},{"nodeId":726580116,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":3907703106,"text":"Which is why I've specially devised a promotion plan to advertise my shop, \"Sakuya's Flowers.\"","nextNodeIds":[726580117]},{"nodeId":726580117,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":2308090778,"text":"I call this plan... \"Dreams of Bloom\"!","nextNodeIds":[726580118]},{"nodeId":726580118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4055454754,"text":"And what does this plan entail, exactly?","nextNodeIds":[726580119]},{"nodeId":726580119,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":3625971170,"text":"Specifically, it is about allowing customers to grow their own flowers and then create their own unique flower arrangements.","nextNodeIds":[726580120]},{"nodeId":726580120,"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","textMapHash":7890986,"text":"If you're interested in giving it a try, just let me know. Growing and arranging flowers are both very interesting indeed, you know?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["72658","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q72658_NPC_Pos","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7265801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30083,"speakerName":"Sakuya","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":185337478,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHN