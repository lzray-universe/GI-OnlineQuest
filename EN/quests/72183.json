ay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7218301,"initDialog":721830101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3098],"performCfg":"QuestDialogue/WQ/Inazuma_72183/Q7218301","priority":5,"questId":72183,"showRandomTalkCount":0},"dialogs":[{"nodeId":721830101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2717604034,"text":"These are... seeds?","nextNodeIds":[721830102]},{"nodeId":721830102,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":1369741874,"text":"These are Naku Weed seeds.","nextNodeIds":[721830103]},{"nodeId":721830103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":769430146,"text":"You know about this plant?","nextNodeIds":[721830104]},{"nodeId":721830104,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":4068286346,"text":"Well, I kind of know about it. I've seen this plant before and I've heard people talk about its wonders.","nextNodeIds":[721830105]},{"nodeId":721830105,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":3897573338,"text":"I remember that... even in the absence of wind, this plant will tremble slightly to the sound of thunder...","nextNodeIds":[721830106]},{"nodeId":721830106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":510205130,"text":"Does it look good when grown?","nextNodeIds":[721830107]},{"nodeId":721830107,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":1678980930,"text":"If we're talking about appearance alone... I daresay it looks rather nice indeed.","nextNodeIds":[721830108]},{"nodeId":721830108,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":335211034,"text":"Would you like to try growing some Naku Weeds? But I don't believe there to be any suitable land hereabouts...","nextNodeIds":[721830109]},{"nodeId":721830109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4258844826,"text":"I have my own plot of land.","nextNodeIds":[721830110]},{"nodeId":721830110,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":1863683858,"text":"Oh, is that so? As expected of you... So, you have even been gifted land already?","nextNodeIds":[721830111]},{"nodeId":721830111,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":2589101498,"text":"Pardon me for asking, but is your land...","nextNodeIds":[721830112,721830115]},{"nodeId":721830112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":843537194,"text":"It's not in Inazuma.","nextNodeIds":[721830113]},{"nodeId":721830113,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":1561351674,"text":"#Oh! I have also heard tell of your feats in Mondstadt and Liyue, {F#Madam}{M#Sir}.","nextNodeIds":[721830114]},{"nodeId":721830114,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":2530815266,"text":"Indeed, it would be more surprising if you were not gifted land for such deeds!","nextNodeIds":[721830120]},{"nodeId":721830120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":63008058,"text":"#Hey, {NICKNAME}, the land you're talking about is the Serenitea Pot that Granny gave us, right?","nextNodeIds":[721830121]},{"nodeId":721830121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2841629402,"text":"Can you really grow things in there? Granny didn't say anything about it before...","nextNodeIds":[721830122,721830124]},{"nodeId":721830122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3653251354,"text":"Let's go back and ask her.","nextNodeIds":[721830123]},{"nodeId":721830123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":816051938,"text":"Okay then, let's go back and ask Granny.","nextNodeIds":[]},{"nodeId":721830124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3213242498,"text":"The adepti are very powerful after all.","nextNodeIds":[721830125]},{"nodeId":721830125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3247674066,"text":"Is that so? But Granny really is very strong, so...","nextNodeIds":[721830126]},{"nodeId":721830126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2782860546,"text":"Okay then, let's go back and ask Granny.","nextNodeIds":[]},{"nodeId":721830115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1458517650,"text":"It's actually in a teapot.","nextNodeIds":[721830116]},{"nodeId":721830116,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":973740882,"text":"#A t—teapot? {F#Madam}{M#Sir}, please don't play such a joke on me.","nextNodeIds":[721830117]},{"nodeId":721830117,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":3084818146,"text":"I have also heard tell of your feats in Mondstadt and Liyue.","nextNodeIds":[721830118]},{"nodeId":721830118,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":372123138,"text":"So I guess that your land is either in Liyue or in Mondstadt.","nextNodeIds":[721830119]},{"nodeId":721830119,"roleType":"TALK_ROLE_NPC","speakerId":3098,"speakerName":"Madarame Hyakubei","textMapHash":2887527938,"text":"#As expected of you, {F#Madam}{M#Sir}.","nextNodeIds":[721830120]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7218301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDG