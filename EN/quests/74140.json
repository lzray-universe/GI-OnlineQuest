"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5311"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7414013],"talks":[{"talkId":7414013,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7414013","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7414013,"initDialog":741401301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5311],"performCfg":"QuestDialogue/WQ/Fontaine_74140/Q7414013","priority":5,"questId":74140,"showRandomTalkCount":0},"dialogs":[{"nodeId":741401301,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":1620821810,"text":"Well. Here we are again...","nextNodeIds":[741401302]},{"nodeId":741401302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3798907626,"text":"What is it?","nextNodeIds":[741401303]},{"nodeId":741401303,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":3027695834,"text":"I feel really bad for saying this since everyone's so nice to me, all of you, but...","nextNodeIds":[741401304]},{"nodeId":741401304,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":3590944474,"text":"Don't you feel the real world is so frighteningly dull? Don't you think the world in the Book is far more beautiful?","nextNodeIds":[741401305,741401307,741401309]},{"nodeId":741401305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":425830266,"text":"I think so, too.","nextNodeIds":[741401306]},{"nodeId":741401306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4114914258,"text":"Really? You think so too, huh?","nextNodeIds":[741401311]},{"nodeId":741401311,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":3483529170,"text":"I still feel the world in the Book of Revealing is much more appealing. There are dew-covered petals everywhere, and I've finally made friends with the puppy.","nextNodeIds":[741401312]},{"nodeId":741401312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1034559954,"text":"That puppy... Uh, Canotila, can you communicate with dogs?","nextNodeIds":[741401313]},{"nodeId":741401313,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":2945408658,"text":"Hm? Of course not. However, the puppy in the Book of Revealing is special. Or maybe, I'm special?","nextNodeIds":[741401314]},{"nodeId":741401314,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":2926728706,"text":"I've been meditating to travel to the world in the Book, and then one day, the puppy's usual barking turned into something I could understand.","nextNodeIds":[741401315]},{"nodeId":741401315,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":2482763674,"text":"As for what we talked about... He asked me to go and never come back.","nextNodeIds":[741401316]},{"nodeId":741401316,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":1862211218,"text":"But... I still want to see the sunflowers bloom...","nextNodeIds":[741401317]},{"nodeId":741401317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3509444570,"text":"...","nextNodeIds":[741401318]},{"nodeId":741401318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2996915906,"text":"I—Is that so... Take care, Canotila! We'll be going!","nextNodeIds":[]},{"nodeId":741401307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3943164234,"text":"I don't think so.","nextNodeIds":[741401308]},{"nodeId":741401308,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":1035685106,"text":"Is that so...? Maybe that's right. I'm not normal.","nextNodeIds":[741401311]},{"nodeId":741401309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":963869674,"text":"There's no difference to me.","nextNodeIds":[741401310]},{"nodeId":741401310,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":2386897362,"text":"#Looks like {M#Mr.}{F#Ms.} {NICKNAME} is the toughest of all.","nextNodeIds":[741401311]}]}],"conditions":{"finishCon