nodeId":741401105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2684754778,"text":"Hmm... Talking to Canotila is as confusing as ever.","nextNodeIds":[741401106]},{"nodeId":741401106,"roleType":"TALK_ROLE_NPC","speakerId":21098,"speakerName":"","textMapHash":1001535506,"text":"Woof!","nextNodeIds":[741401107]},{"nodeId":741401107,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":347729690,"text":"Hmm? But...","nextNodeIds":[741401108]},{"nodeId":741401108,"roleType":"TALK_ROLE_NPC","speakerId":21098,"speakerName":"","textMapHash":3575257506,"text":"Woof, woof!","nextNodeIds":[741401109]},{"nodeId":741401109,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":1827618946,"text":"Okay, okay! I hear you.","nextNodeIds":[741401110]},{"nodeId":741401110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2723913738,"text":"(Hmm...? She's talking to the puppy? Could it be that Melusine can generally communicate with dogs?)","nextNodeIds":[741401111]},{"nodeId":741401111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1116090290,"text":"(How incredible.)","nextNodeIds":[741401112]},{"nodeId":741401112,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":2591383834,"text":"Well, I guess that's that. I'll see you next time. Hmph! Even if you said that, I'm still coming back to play with you.","nextNodeIds":[741401113]},{"nodeId":741401113,"roleType":"TALK_ROLE_NPC","speakerId":5311,"speakerName":"Canotila","textMapHash":139643530,"text":"#Let's go, {M#Mr.}{F#Ms.} {NICKNAME}, Paimon!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7414011,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNL