 plan on taking the shell back with you, Miss Sangonomiya?","nextNodeIds":[401251102]},{"nodeId":401251102,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":3114953098,"text":"No, I think it's better if it stays here with Idyia.","nextNodeIds":[401251103]},{"nodeId":401251103,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":3054970770,"text":"Watatsumi Island has something new to treasure now, and slowly but surely, people are seeing progress in pursuing their aspirations.","nextNodeIds":[401251104]},{"nodeId":401251104,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":2602563922,"text":"It'll be of more use here, where it can protect this bottle domain, and the dreams of all who journey through here.","nextNodeIds":[]}]},{"talkId":4012512,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4012501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},