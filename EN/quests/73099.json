D_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7309903,"initDialog":730990301,"nextRandomTalks":[],"nextTalks":[],"npcId":[4246,1005,20840],"performCfg":"QuestDialogue/WQ/Sumeru_73099/Q7309903","priority":5,"questId":73099,"showRandomTalkCount":0},"dialogs":[{"nodeId":730990301,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":1706188930,"text":"Eek! It's the Golden Nara! There is the taste of the wind, the taste of earth, and the taste of Aranara!","nextNodeIds":[730990302]},{"nodeId":730990302,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":2538139098,"text":"Golden Nara has figured out the Ararakalari of Arayama?","nextNodeIds":[730990303]},{"nodeId":730990303,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":2188064066,"text":"How dreadful! Obstructions are useless, anyone can break in, and the \"happy nest\" of Araminali will be \"broken!\"","nextNodeIds":[730990304]},{"nodeId":730990304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1033778034,"text":"Wow, don't worry, we mean no harm.","nextNodeIds":[730990305]},{"nodeId":730990305,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":4141534466,"text":"What does \"no harm\" mean? Do you mean \"no greed\"?","nextNodeIds":[730990306]},{"nodeId":730990306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2329837594,"text":"#Um... Paimon guesses so! {NICKNAME} and Paimon are on Aranara's side. We want to be Aranara's good friends.","nextNodeIds":[730990307]},{"nodeId":730990307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":505403314,"text":"Paimon is gluttonous, but not bad in nature.","nextNodeIds":[730990308]},{"nodeId":730990308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2567547242,"text":"Hey! That's technically not wrong, though...","nextNodeIds":[730990309]},{"nodeId":730990309,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":3896015034,"text":"Aranara's best friend... The Golden Nara smells like Aranara, a familiar smell, but I haven't smelled it for a long time...","nextNodeIds":[730990310]},{"nodeId":730990310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1969330874,"text":"#Ah, by the way, that strange seed! {NICKNAME}, show the seeds to Araminali. Maybe he knows something.","nextNodeIds":[730990311]},{"nodeId":730990311,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":2178097386,"text":"Uhh! He is thirsty! He needs to drink a lot of water before he can change back to what he was. Come... there's a lot of water here. Let him drink enough to recover.","nextNodeIds":[730990312]},{"nodeId":730990312,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2343042034,"text":"You put the seed in the water...","nextNodeIds":[730990313]},{"nodeId":730990313,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":617404018,"text":"...Wow! It's changing back!","nextNodeIds":[730990314]},{"nodeId":730990314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2892447490,"text":"#Wow! The seed has become an Aranara! We found it, \"the trapped Aranara\"! You see, is Paimon right, {NICKNAME}?","nextNodeIds":[730990315,730990316]},{"nodeId":730990315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":772476834,"text":"I can't believe \"the trapped Aranara\" does exist...","nextNodeIds":[730990317]},{"nodeId":730990317,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":1922937354,"text":"It's Aranimba! Unlike Araminali, Aranimba likes to travel around. Before, he would draw the scenery he saw from afar and send it back to Vanarana, but later...","nextNodeIds":[730990318]},{"nodeId":730990318,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":4026004674,"text":"Later, Aranimba went to a very hard and dark place, with little dirt, but a lot of stones... Under the soil, there was little grass and few trees, but a lot of mushrooms!","nextNodeIds":[730990319]},{"nodeId":730990319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":327839458,"text":"Um... Sounds like The Chasm. But, Aranimba, as an Aranara, traveled so far that he even left Sumeru...","nextNodeIds":[730990320]},{"nodeId":730990320,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":2329070362,"text":"Yes! It was a long way, and dangerous. Aranimba met the dark and dangerous Nara! However, Aranimba was protected by Aramuhukunda, and turned into a seed and \"got away with it.\"","nextNodeIds":[730990321]},{"nodeId":730990321,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":4248402706,"text":"Now Aranimba is back safely, thanks to Golden Nara and White Floaty.","nextNodeIds":[730990322]},{"nodeId":730990322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3908169322,"text":"#It's {NICKNAME} and Paimon!","nextNodeIds":[730990323]},{"nodeId":730990323,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":3637150410,"text":"#Yes! Nara {NICKNAME} and Paimon, Aranara's friends!","nextNodeIds":[730990324]},{"nodeId":730990324,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":478143802,"text":"#Araminali is Aranimba's \"good friend,\" so Nara {NICKNAME} and Paimon are also Aranimba's \"good friends\". Aranimba gets it now!","nextNodeIds":[730990325]},{"nodeId":730990325,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":2455104794,"text":"Aranimba is going to leave, this time, not only painting, Aranimba will send back \"gift\" to Araminali, put it in the \"chest.\"","nextNodeIds":[730990326]},{"nodeId":730990326,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":3475829994,"text":"All the \"chests\" here belong to Araminali. Araminali is the owner of the \"treasure chests.\"","nextNodeIds":[730990327]},{"nodeId":730990327,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":3039316418,"text":"For good friends of Aranara who helped a lot of Aranara... Aranara will be \"grateful,\" and will put the \"treasure\" into the \"chest.\"","nextNodeIds":[730990328]},{"nodeId":730990328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2193519690,"text":"So the chest was empty!?","nextNodeIds":[730990329]},{"nodeId":730990329,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":3255505498,"text":"Aranara knew everything about Vana when they were born, but when \"chests\" were born, they were empty! Araminali doesn't know why.","nextNodeIds":[730990330]},{"nodeId":730990330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2533396810,"text":"Paimon doesn't understand too...","nextNodeIds":[730990331]},{"nodeId":730990331,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":2092709322,"text":"#...When Araminali has filled the \"treasure chests,\" Nara {NICKNAME} can open it. Sometimes Nara {NICKNAME} will cheer with \"Oh yeah\" and sometimes sigh with \"Ah...\" just as the green Nara does.","nextNodeIds":[730990332]},{"nodeId":730990332,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3139224914,"text":"Why bother? Araminali and Aranimba can directly give us what you're about to put in the treasure chests as the payment.","nextNodeIds":[730990333]},{"nodeId":730990333,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":3298844242,"text":"#Araminali knows that the green Nara likes to go into the cave or in the house and open the \"treasure chest.\" Nara {NICKNAME}, and Paimon, don't like it?","nextNodeIds":[730990334]},{"nodeId":730990334,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2032002546,"text":"Oh... It's not like Paimon doesn't like it... It feels like... there is an inexplicable attraction?","nextNodeIds":[730990335]},{"nodeId":730990335,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":1001387842,"text":"Well, Nara likes \"treasure chests,\" and so does Araminali. Araminali allows the good Nara who had helped Aranara to open the \"treasure chests.\"","nextNodeIds":[730990336]},{"nodeId":730990336,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":2391922458,"text":"Vana has a lot of Aranara, some in need of help, and some want to play with Nara. Nara who realizes their wishes is Aranara's friend.","nextNodeIds":[730990337]},{"nodeId":730990337,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":675171986,"text":"Such Nara can open the \"treasure chests\" prepared by Araminali.","nextNodeIds":[730990338]},{"nodeId":730990338,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":3074593042,"text":"So Aranimba should leave now, to fill the \"treasure chests.\"","nextNodeIds":[730990339]},{"nodeId":730990339,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3087896714,"text":"Hey? But didn't Aranimba just come back? Are you leaving again? You are really in a rush... like running from a fire with the headwind...","nextNodeIds":[730990340]},{"nodeId":730990340,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":2249107466,"text":"Eek! It's nice to have wind, but not fire. Getting too close to the fire makes Aranimba thirsty again.","nextNodeIds":[730990341]},{"nodeId":730990341,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4087314466,"text":"Ah, Paimon means, how could Aranimba be in such a hurry? Aranimba could stay for a while and catch up with Araminali.","nextNodeIds":[730990342]},{"nodeId":730990342,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":109049762,"text":"Araminali, you haven't seen Aranimba for a long time. Don't you have a lot to say to Aranimba?","nextNodeIds":[730990343]},{"nodeId":730990343,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":3450011322,"text":"Aranimba is the Aranara that will never stop so Aranimba can't be the owner of the \"treasure chests.\"","nextNodeIds":[730990344]},{"nodeId":730990344,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":1116571970,"text":"Regarding the whereabouts of Aranimba, as long as Vana knows, wind knows, flowers and grass know, Araminali will know.","nextNodeIds":[730990345]},{"nodeId":730990345,"roleType":"TALK_ROLE_NPC","speakerId":4246,"speakerName":"Araminali","textMapHash":2815332834,"text":"So, it's fine. Don't need to say much. Araminali will listen so long as Aranimba wants to say.","nextNodeIds":[730990346]},{"nodeId":730990346,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2327420506,"text":"#Um... Is this Aranara's friendship? If it were Paimon, Paimon would have a lot to share with {NICKNAME}.","nextNodeIds":[]},{"nodeId":730990316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":964420698,"text":"Are you alright?","nextNodeIds":[730990317]}]},{"talkId":7309905,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7309905","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7309905,"initDialog":730990501,"nextRandomTalks":[],"nextTalks":[],"npcId":[20840],"performCfg":"","priority":5,"questId":73099,"showRandomTalkCount":0},"dialogs":[{"nodeId":730990501,"roleType":"TALK_ROLE_NPC","speakerId":20840,"speakerName":"Aranimba","textMapHash":4171120626,"text":"#Th