se,"talkIds":[7228301],"talks":[{"talkId":7228301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7228301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7228301,"initDialog":722830101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20345],"performCfg":"","priority":5,"questId":72283,"showRandomTalkCount":0},"dialogs":[{"nodeId":722830101,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3387986066,"text":"Ugh. Guess this just isn't my day.","nextNodeIds":[722830102]},{"nodeId":722830102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4197608738,"text":"What's wrong?","nextNodeIds":[722830103]},{"nodeId":722830103,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":1363787338,"text":"The results of my shooting training have been getting worse and worse. One of these days, I swear I'll end up hitting myself in the knee!","nextNodeIds":[722830104]},{"nodeId":722830104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1360312562,"text":"Why are you practicing archery in a place like this?","nextNodeIds":[722830105]},{"nodeId":722830105,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":2647901114,"text":"Bah! It's all the fault of that Jibashiri — he suggested I do this! ...You know what? I wonder if all of them aren't just a bunch of sadists...","nextNodeIds":[722830106]},{"nodeId":722830106,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":2400604546,"text":"By the way, do you know anything about Unagi farming? I feel like there isn't much of a future for my archery, so you know, might as well do something else.","nextNodeIds":[722830107]},{"nodeId":722830107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":628117850,"text":"Do those two things have anything in common?","nextNodeIds":[722830108]},{"nodeId":722830108,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3422309466,"text":"Oh, right, never mind. Looks like you don't know the first thing about unagi farming.","nextNodeIds":[722830109]},{"nodeId":722830109,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3987688698,"text":"You need to catch some unagi fry first, for starters, but they're so small that you can barely see them with the naked eye.","nextNodeIds":[722830110]},{"nodeId":722830110,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":2012001018,"text":"So I got to thinking that since archers can hit targets from very far away, they must have good eyes. As such, I went to ask some experienced Jibashiri about how to train my eyesight.","nextNodeIds":[722830111]},{"nodeId":722830111,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":1212905170,"text":"\"Akashi, you have to take training slowly. You can only make steadier progress once you've laid a good foundation.\"","nextNodeIds":[722830112]},{"nodeId":722830112,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3596635154,"text":"\"Unagi fry are small and move about wildly, so you need to start with static targets. And not ones that are too close, either — if you want to do things right, you've got to do things seriously.\"","nextNodeIds":[722830113]},{"nodeId":722830113,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":230083466,"text":"So I followed his instructions, practicing archery here. But I haven't hit the target even once... Is it even possible, anyway?","nextNodeIds":[722830114]},{"nodeId":722830114,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3738941922,"text":"Actually, do you wanna give it a go? If you stand on that stone platform, you can see the targets. Hit them all, and it'll be considered a success.","nextNodeIds":[722830115]},{"nodeId":722830115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3262345946,"text":"Sure, leave it to me.","nextNodeIds":[722830116]},{"nodeId":722830116,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":1179528018,"text":"Alright then, let me see your true abilities. Don't forget to come find me when you're done!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7228301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7228302,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"72283_Success"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7228302],"talks":[{"talkId":7228302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRand