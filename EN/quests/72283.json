m":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7228303,"initDialog":722830301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20345],"performCfg":"","priority":5,"questId":72283,"showRandomTalkCount":0},"dialogs":[{"nodeId":722830301,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":4039648218,"text":"Wow! You got it!","nextNodeIds":[722830302]},{"nodeId":722830302,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":2280231626,"text":"*sigh* You looked like a real pro out there, though. I doubt someone without proper training like myself could reach your standards — not even if I trained for a few years more.","nextNodeIds":[722830303]},{"nodeId":722830303,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":62245538,"text":"And I haven't seen a live, jumping unagi for a long time either, what with coming here every day to train and all.","nextNodeIds":[722830304]},{"nodeId":722830304,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":1870939882,"text":"Do you like unagi, by the way?","nextNodeIds":[722830305,722830306]},{"nodeId":722830305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1315918538,"text":"I do.","nextNodeIds":[722830307]},{"nodeId":722830307,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3281053330,"text":"Is that so? As for me, I love them — so much so that I'd love to try raising some one day. Don't you think they look cute?","nextNodeIds":[722830308]},{"nodeId":722830308,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3637281610,"text":"Well, unagi on a dinner platter are best of course. Lovely to look at and to taste — one heck of a combination!","nextNodeIds":[722830309]},{"nodeId":722830309,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":3380708434,"text":"Speaking of which, do you think I've got my priorities wrong? I mean, I'm only practicing archery because I want to raise unagi, but I only want to do that because I love them.","nextNodeIds":[722830310]},{"nodeId":722830310,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":161237074,"text":"In the end, I love them when they're living free. So there's probably no point trying to raise them, you know?","nextNodeIds":[722830311]},{"nodeId":722830311,"roleType":"TALK_ROLE_NPC","speakerId":20345,"speakerName":"Akashi","textMapHash":2790099322,"text":"In any case, thanks for the demonstration. Please take these. Good luck!","nextNodeIds":[]},{"nodeId":722830306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":150982570,"text":"Not exactly my thing.","nextNodeIds":[722830307]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7228303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["5","155006018"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarrati