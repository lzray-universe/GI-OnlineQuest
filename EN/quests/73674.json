IEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7367401,7367403],"talks":[{"talkId":7367401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7367402","","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7367402","1","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7367402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7367402","4","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_A_AND_ETCOR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367401,"initDialog":736740101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30038],"performCfg":"QuestDialogue/WQ/TreasureHunt_73674/Q7367401","priority":5,"questId":73674,"showRandomTalkCount":0},"dialogs":[{"nodeId":736740101,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3602028362,"text":"Didn't you bring me here, little one? Keep moving!","nextNodeIds":[736740102]},{"nodeId":736740102,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1694749394,"text":"Never mind, you better stay put...","nextNodeIds":[736740103,736740104]},{"nodeId":736740103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3078478098,"text":"What are you up to?","nextNodeIds":[736740106]},{"nodeId":736740106,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":738571218,"text":"I'm duped by it, again... Let me give you a rundown from the beginning.","nextNodeIds":[736740107]},{"nodeId":736740107,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2579562266,"text":"For starters, you may not believe Seelie are somehow easily drawn to me.","nextNodeIds":[736740108]},{"nodeId":736740108,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1267286802,"text":"Among the Seelie that came to follow me, I found one kind that is particularly keen on treasure-seeking.","nextNodeIds":[736740109]},{"nodeId":736740109,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":362311314,"text":"I'm not good at naming. I'll just call them Treasure-Seeking Seelie.","nextNodeIds":[736740110]},{"nodeId":736740110,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1209996098,"text":"They excel at treasure-seeking. With their help, I dug up a lot of treasures and made a profit with them.","nextNodeIds":[736740111]},{"nodeId":736740111,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":620942914,"text":"But sometimes they suddenly tune out on me. I don't know if they're tired of the seeking, or just think I'm too boring...","nextNodeIds":[736740112]},{"nodeId":736740112,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":7509794,"text":"Then I'd find a helper favored by the Seelie.","nextNodeIds":[736740113]},{"nodeId":736740113,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2968987234,"text":"The helper takes Treasure-Seeking Seelie to locate the treasures, and I sell them for a fair price.","nextNodeIds":[736740114]},{"nodeId":736740114,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3764186802,"text":"They say ruins and antiques are everywhere in Sumeru. So I came to look for my fortune.","nextNodeIds":[736740115]},{"nodeId":736740115,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":4012313018,"text":"And I attracted a bunch of Seelie here, of course. Some Treasure-Seeking Seelie brought me here.","nextNodeIds":[736740116]},{"nodeId":736740116,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2695938994,"text":"But they ignored me again not long after I scooped up some dirt...","nextNodeIds":[736740117]},{"nodeId":736740117,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":4070332042,"text":"Eh? Why did it suddenly start to move? Could it be...","nextNodeIds":[736740118]},{"nodeId":736740118,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1106509378,"text":"Traveler, are you interested in treasure-seeking with Seelie?","nextNodeIds":[736740119,736740120]},{"nodeId":736740119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3571347370,"text":"Me?","nextNodeIds":[736740121]},{"nodeId":736740121,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2437879162,"text":"That won't be necessary. Just follow it and dig where it stops.","nextNodeIds":[736740122]},{"nodeId":736740122,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3605320458,"text":"How's that sound? Just give it a try... If you scoop up some treasure, I'll only want the \"Ancient Iron Coins\" if there is any. The rest is all yours!","nextNodeIds":[736740123]},{"nodeId":736740123,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":769376722,"text":"And say you do help me find some of those coins, I'll pay you for them at a fair price.","nextNodeIds":[736740124,736740126]},{"nodeId":736740124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4283814426,"text":"I could give it a go...","nextNodeIds":[736740125]},{"nodeId":736740125,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":144789074,"text":"That's the spirit! I like you!","nextNodeIds":[736740130]},{"nodeId":736740130,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2904946714,"text":"Anyways, we are partners now!","nextNodeIds":[736740131]},{"nodeId":736740131,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2534556418,"text":"Take this notebook. I recorded on it some hidden treasure sites I found before but haven't had a chance for a dig.","nextNodeIds":[736740132]},{"nodeId":736740132,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2443193058,"text":"I'm counting on you then, Traveler. Come back and bring me the \"Ancient Iron Coins\" if you find any.","nextNodeIds":[]},{"nodeId":736740126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3765375282,"text":"What are \"Ancient Iron Coins\"?","nextNodeIds":[736740127]},{"nodeId":736740127,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":697612538,"text":"Simply put, it's a kind of antique.","nextNodeIds":[736740128]},{"nodeId":736740128,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":242433842,"text":"With good connections, I'll be able to exchange the coins for some decent stuff.","nextNodeIds":[736740129]},{"nodeId":736740129,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3395136922,"text":"I haven't found any good connections though...","nextNodeIds":[736740130]},{"nodeId":736740120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":127084162,"text":"I don't know their language...","nextNodeIds":[736740121]},{"nodeId":736740104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3193341018,"text":"Is this... a Seelie?","nextNodeIds":[736740105]},{"nodeId":736740105,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1521978690,"text":"You mean the little one? Ugh, sort of...","nextNodeIds":[736740106]}]},{"talkId":7367403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7367402","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367403,"initDialog":736740301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30038],"performCfg":"QuestDialogue/WQ/TreasureHunt_73674/Q7367403","priority":5,"questId":73674,"showRandomTalkCount":0},"dialogs":[{"nodeId":736740301,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1994834770,"text":"Didn't you bring me here, little one? Keep moving!","nextNodeIds":[736740302]},{"nodeId":736740302,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3014080802,"text":"Never mind, you better stay put...","nextNodeIds":[736740303,736740304]},{"nodeId":736740303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4239822882,"text":"Ulman?","nextNodeIds":[736740305]},{"nodeId":736740305,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1789300066,"text":"Traveler? It's been a while.","nextNodeIds":[736740306]},{"nodeId":736740306,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2804290922,"text":"Are you still bumming around the world? I've heard many amazing stories about you. You're really phenomenal.","nextNodeIds":[736740307]},{"nodeId":736740307,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":1537319722,"text":"What troubles are you gonna fix this time in Sumeru?","nextNodeIds":[736740308,736740310]},{"nodeId":736740308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":412779706,"text":"Don't jinx me.","nextNodeIds":[736740309]},{"nodeId":736740309,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":821656786,"text":"Right, back to business, Traveler. How about another team-up action?","nextNodeIds":[736740313]},{"nodeId":736740313,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":4203373842,"text":"The land of Sumeru is strewn with treasures. Mora everywhere.","nextNodeIds":[736740314]},{"nodeId":736740314,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2746300042,"text":"Seelie are drawn to me as usual. And the Treasure-Seeking Seelie we got so familiar with are among them too.","nextNodeIds":[736740315]},{"nodeId":736740315,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2389034538,"text":"Same as before. You and the Seelie look for treasures, and I'll prepare your payment.","nextNodeIds":[736740316]},{"nodeId":736740316,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3626597794,"text":"We'll surely rake it in as a team!","nextNodeIds":[736740317,736740321]},{"nodeId":736740317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":962982578,"text":"\"Iron Coins\" again?","nextNodeIds":[736740318]},{"nodeId":736740318,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":815862858,"text":"No. This time I'm looking for \"Ancient Iron Coins,\" which are worth more.","nextNodeIds":[736740319]},{"nodeId":736740319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1649505898,"text":"It's just another coin!","nextNodeIds":[736740320]},{"nodeId":736740320,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2297782250,"text":"It's not! The antique ones sell for more Mora.","nextNodeIds":[736740326]},{"nodeId":736740326,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3508083978,"text":"So it's a deal then. Let's make a pile as a team like we used to!","nextNodeIds":[]},{"nodeId":736740321,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1203260538,"text":"Can't you find someone else?","nextNodeIds":[736740322]},{"nodeId":736740322,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":88662058,"text":"Well, you always team up with the one you are familiar with.","nextNodeIds":[736740323]},{"nodeId":736740323,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2901105530,"text":"And we're friends! I look out for my friends.","nextNodeIds":[736740324]},{"nodeId":736740324,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2288527146,"text":"Last time we met, you didn't have that silver tongue.","nextNodeIds":[736740325]},{"nodeId":736740325,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":2407752906,"text":"Hehe, that's what you must have to persuade your buyers.","nextNodeIds":[736740326]},{"nodeId":736740310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3310919034,"text":"Not before I \"fix\" you first.","nextNodeIds":[736740311]},{"nodeId":736740311,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":378247530,"text":"Haha, better not. I wouldn't be strong enough to take your fixing punches.","nextNodeIds":[736740312]},{"nodeId":736740312,"roleType":"TALK_ROLE_NPC","speakerId":30038,"speakerName":"Ulman","textMapHash":3547308034,"text":"Seriously, Traveler. How about we team up again?","nextNodeIds":[736740313]},{"nodeId":736740304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2594668506,"text":"What are you doing here?","nextNodeIds":[736740305]}]}],"condition