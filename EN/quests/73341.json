{"mainQuestId":73341,"title":"Heart of Amrita","description":"Farther inside the Vourukasha Oasis, a mysterious Pari is waiting for you...","titleTextMapHash":147620983,"descTextMapHash":2976689518,"mainQuestExcel":{"mainQuestId":73341,"titleTextMapHash":147620983,"title":"Heart of Amrita","descTextMapHash":2976689518,"description":"Farther inside the Vourukasha Oasis, a mysterious Pari is waiting for you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ73341","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2976689518,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73341,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":890069049,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73341","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173341],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":147620983,"type":"WQ","unlockDescTextMapHash":1224594782}},"flow":[{"subQuestId":7334101,"order":1,"stepDescription":"Talk to Fedhri","stepDescTextMapHash":3867623460,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7334101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4443"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7334101],"talks":[{"talkId":7334101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7334101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7334101,"initDialog":733410101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4443],"performCfg":"","priority":5,"questId":73341,"showRandomTalkCount":0},"dialogs":[{"nodeId":733410101,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":2534821250,"text":"Hello there, are you the outlander offerer they spoke of?","nextNodeIds":[733410102]},{"nodeId":733410102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":459964906,"text":"The outlander offerer?","nextNodeIds":[733410103]},{"nodeId":733410103,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":143011242,"text":"Yes, I have heard of a valiant human who is bonded to a Pari. It has been centuries since this land last witnessed something so wondrous!","nextNodeIds":[733410104]},{"nodeId":733410104,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":3744245450,"text":"We Pari used to walk with humans, and we would both build our homes in this Vourukasha Oasis.","nextNodeIds":[733410105]},{"nodeId":733410105,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":1697475562,"text":"Despite the threat of the darkness, its corrosion never once stained the Oasis thanks to the protection of the Harvisptokhm and Khvarena.","nextNodeIds":[733410106]},{"nodeId":733410106,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":2343170530,"text":"Though centuries have passed, those years remain my most cherished memories.","nextNodeIds":[733410107,733410108]},{"nodeId":733410107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1778219722,"text":"Sorry, but who are you?","nextNodeIds":[733410110]},{"nodeId":733410110,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":1377305538,"text":"I'm in charge of looking after the Amrita Pool. I have not set foot outside this place since Lady Zurvan sealed the Oasis.","nextNodeIds":[733410111]},{"nodeId":733410111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":243568986,"text":"The Amrita Pool?","nextNodeIds":[733410112]},{"nodeId":733410112,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":2753578242,"text":"The Amrita Pool is where we Pari were granted life. In it flows the primordial water left behind by our god.","nextNodeIds":[733410113]},{"nodeId":733410113,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":1290710010,"text":"It's all thanks to the Amrita that countless motes of Khvarena have gained power and life.","nextNodeIds":[733410114]},{"nodeId":733410114,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":361288410,"text":"We will turn into Plumes of Purifying Light after exhausting our strength, leaving behind nothing but pure memories.","nextNodeIds":[733410115]},{"nodeId":733410115,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":2513174554,"text":"And memories that belong to the Khvarena will return to the Harvisptokhm through the Amrita Pool.","nextNodeIds":[733410116]},{"nodeId":733410116,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":3966433218,"text":"The Amrita is all that is needed to wash away the deepest sadness and sorrow. With its nourishment, one shall regain their pristine form as the Khvarena's familiar.","nextNodeIds":[733410117]},{"nodeId":733410117,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":959733610,"text":"And the offerer is the one who will help those familiars of Khvarena return to the sea of flowers.","nextNodeIds":[733410118]},{"nodeId":733410118,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":1517965538,"text":"But ever since human warriors ceased performing that duty, Pari who have drained their strength while resisting the defilement have not been able to return to the sea of flowers.","nextNodeIds":[733410119]},{"nodeId":733410119,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":3625074058,"text":"Fortunately, now that we've been visited by a human warrior once again, the scattered Plumes of Purifying Light shall return to this place eventually.","nextNodeIds":[733410120]},{"nodeId":733410120,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":264035074,"text":"The Amrita Pool will accept all remembrances so long as an offering is made, and the waters and the tree will bestow blessings upon you.","nextNodeIds":[733410121]},{"nodeId":733410121,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":132358202,"text":"This is also the mercy of the divine.","nextNodeIds":[]},{"nodeId":733410108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4223388554,"text":"I didn't quite get you...","nextNodeIds":[733410109]},{"nodeId":733410109,"roleType":"TALK_ROLE_NPC","speakerId":4443,"speakerName":"Fedhri","textMapHash":1154998314,"text":"I can feel that you are indeed the one who has forged a Lau{RUBY#[S]connection}pa with a Pari.","nextNodeIds":[733410110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7334101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133317140"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["7334101","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4443"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7334101],"speakerCounts":[{"roleType":"TAL