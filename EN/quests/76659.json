{"mainQuestId":76659,"title":"Unwritten Rules","description":"You and Paimon both hope to see Ginette's research bear fruit. However, the actors in this play turn out to be much more than they seem...","titleTextMapHash":2539708487,"descTextMapHash":456356254,"mainQuestExcel":{"mainQuestId":76659,"titleTextMapHash":2539708487,"title":"Unwritten Rules","descTextMapHash":456356254,"description":"You and Paimon both hope to see Ginette's research bear fruit. However, the actors in this play turn out to be much more than they seem...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":2042,"luaPath":"Actor/Quest/WQ76659","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2042,"chapterId":0,"descTextMapHash":456356254,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76659,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":888635817,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76659","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176659],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2539708487,"type":"WQ","unlockDescTextMapHash":739148838}},"flow":[{"subQuestId":7665901,"order":1,"stepDescription":"Talk to Ginette and find out what's going on","stepDescTextMapHash":1199721052,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7665901],"talks":[{"talkId":7665901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7665901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7665901,"initDialog":766590101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1312,7016,7048,7053],"performCfg":"QuestDialogue/EQ/V6.0ActivityNodKraiTour_76659/Q7665901","priority":5,"questId":76659,"showRandomTalkCount":0},"dialogs":[{"nodeId":766590101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":444806146,"text":"Hey, now that Paimon thinks about it, we still don't know what happened to the robots once they got all fixed up. Let's go ask Ginette!","nextNodeIds":[766590102]},{"nodeId":766590102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":519507186,"text":"Huh, what's going on over there?","nextNodeIds":[766590103]},{"nodeId":766590103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3834380482,"text":"Everyone's crowded around, and then there's Gaudenty...","nextNodeIds":[766590104]},{"nodeId":766590104,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":1591890690,"text":"Gaudenty tried to steal the robots I made! If Ineffa and Sarin hadn't tipped me off...","nextNodeIds":[766590105]},{"nodeId":766590105,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":2867386610,"text":"Steal? Nonsense, I was just trying to see if they were worth investing in!","nextNodeIds":[766590106]},{"nodeId":766590106,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2837963554,"text":"Analysis of your history renders your current claims difficult to believe.","nextNodeIds":[766590107]},{"nodeId":766590107,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":408097562,"text":"My... history? Don't spout rubbish...","nextNodeIds":[766590108]},{"nodeId":766590108,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2111564746,"text":"Aino values all items in her workshop, and has established a comprehensive surveillance system through her robots.","nextNodeIds":[766590109]},{"nodeId":766590109,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2609047282,"text":"It is almost impossible for an outsider to steal from the workshop without being detected, unless the culprit is assisted from within.","nextNodeIds":[766590110]},{"nodeId":766590110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":135092882,"text":"Wait, you don't mean...","nextNodeIds":[766590111]},{"nodeId":766590111,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":826951146,"text":"While I was here, I swept every corner of the workshop meticulously. As expected, I discovered a few destroyed surveillance robots.","nextNodeIds":[766590112]},{"nodeId":766590112,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1677856970,"text":"I had Aino repair them. The recovered records make it clear that the \"assistant\" we are looking for is indeed Gaudenty.","nextNodeIds":[766590113]},{"nodeId":766590113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2428550882,"text":"So he's been working with that receptionist all along?","nextNodeIds":[766590114]},{"nodeId":766590114,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3841345538,"text":"You two were attacked when retrieving the last of the robots, right? I'm afraid those assailants may also have ties to him.","nextNodeIds":[766590115]},{"nodeId":766590115,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":1380182794,"text":"I... I'm an expatriate representative of the Kuuvahki Experimental Design Bureau! You have no right to lay your hands on me!","nextNodeIds":[766590116]},{"nodeId":766590116,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3061348762,"text":"Give it up. You think we haven't figured out who you are? You're no \"representative\" of anything.","nextNodeIds":[766590117]},{"nodeId":766590117,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3519017706,"text":"This man was once a member of the Adventurers' Guild, but was expelled due to misconduct, before turning to bounty hunting instead.","nextNodeIds":[766590118]},{"nodeId":766590118,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3368329354,"text":"I've heard that he still hadn't kicked his old habits at that point, which cost him his certification from the Voynich Guild, so now he's stuck scraping by on shady gigs... like this one.","nextNodeIds":[766590119]},{"nodeId":766590119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3838488322,"text":"Aha! When Paimon first laid eyes on him, she could just tell he was a big, lousy liar! Now, what are we gonna do with him?","nextNodeIds":[766590120]},{"nodeId":766590120,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":2109349362,"text":"Excuse me. With all due respect, might I take the liberty of handling this individual?","nextNodeIds":[766590121]},{"nodeId":766590121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2539831634,"text":"Hmm... Hey, aren't you the merchant we saw back at the black market?","nextNodeIds":[766590122]},{"nodeId":766590122,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":2745423018,"text":"To be honest, there's an unsettled debt between this bounty hunter and I. According to my Agent, he's been hiding in the workshop for quite a long time.","nextNodeIds":[766590123]},{"nodeId":766590123,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":185091010,"text":"Out of respect for the workshop owner, my Agent never pressed for repayment — so I've come personally to... negotiate this matter in a more civil manner.","nextNodeIds":[766590124]},{"nodeId":766590124,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":3813399426,"text":"Asikko, my good sir! Please help me! All that I've done has been to repay the Mora you lent to me!","nextNodeIds":[766590125]},{"nodeId":766590125,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1511474034,"text":"Mr. Gaudenty, if I didn't want to help you, why would I have \"overlooked\" your disastrous business reputation to secure a subcontract from the Design Bureau for you?","nextNodeIds":[766590126]},{"nodeId":766590126,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":2791617770,"text":"*sigh*... This was an excellent opportunity for you, but your sheer incompetence forced you to re-outsource the job... to the workshop's owner.","nextNodeIds":[766590127]},{"nodeId":766590127,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":2680385482,"text":"To make matters worse, you've ignored your employer's demands and allowed decommissioned recon bots to flood the black market... I'm afraid I must re-evaluate your ability to pay off your debts.","nextNodeIds":[766590128]},{"nodeId":766590128,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":223878298,"text":"The information I have indicates that you are deliberately excising your influence on this series of events.","nextNodeIds":[766590129]},{"nodeId":766590129,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1575654938,"text":"Oh? How so?","nextNodeIds":[766590130]},{"nodeId":766590130,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2238111722,"text":"To my understanding, you previously posted a notice, naming a high price for which you would purchase any of Aino's creations. Excessive amounts of Mora can have a strong influence on certain individuals.","nextNodeIds":[766590131]},{"nodeId":766590131,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2597845922,"text":"My hypothesis is that, be it this bounty hunter or the receptionist, their behavior can be regarded as having been \"influenced\" by said notice.","nextNodeIds":[766590132]},{"nodeId":766590132,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":425070418,"text":"I'm afraid I can't stand for such criticism, Miss Robot. From the beginning, I've only done two things.","nextNodeIds":[766590133]},{"nodeId":766590133,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":295427274,"text":"Firstly, I expressed admiration for the technology Aino has developed. Secondly, I used my own funds to endorse the commercial viability of said technology.","nextNodeIds":[766590134]},{"nodeId":766590134,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1227355354,"text":"If greed causes someone to fall out of line, then that is their responsibility to bear.","nextNodeIds":[766590135]},{"nodeId":766590135,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3528888314,"text":"Indeed. I cannot find any evidence to prove that you directly influenced their actions, and I cannot refute your claim logically. However... there are things in this world more important than logic.","nextNodeIds":[766590136]},{"nodeId":766590136,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1434465754,"text":"In any case, I request that you remove that notice. Aino treasures each and every one of her robot companions. We do not desire that a price be put on any of them.","nextNodeIds":[766590137]},{"nodeId":766590137,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1112623066,"text":"Ah, that... According to my informant's intel, those constructs are, at their core, rather... childish. Hardly something a grown man like myself should find intriguing.","nextNodeIds":[766590138]},{"nodeId":766590138,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":3094117098,"text":"Nevertheless, I still hope to be compensated for my initial investment — just through alternative means. To that end, I've prepared a contingency plan...","nextNodeIds":[766590139]},{"nodeId":766590139,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1917128090,"text":"Now, I did not expect others besides the workshop owner to be capable of designing similar constructs, such as this Fontainian engineer. I admire your talents. May I interest you in a potential collaboration?","nextNodeIds":[766590140]},{"nodeId":766590140,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":3087914362,"text":"Who, me?","nextNodeIds":[766590141]},{"nodeId":766590141,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1532981306,"text":"Indeed. If my intel is correct, then your work has the potential, albeit through sheer luck, to be perfected as a product, yes?","nextNodeIds":[766590142]},{"nodeId":766590142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3208239042,"text":"Is he talking about the combat abilities that the robots picked up?","nextNodeIds":[766590143]},{"nodeId":766590143,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":2331541970,"text":"Umm... I'm sorry, but I'm afraid my work is just as you described Aino's. It's quite \"childish,\" so I doubt you'd be interested...","nextNodeIds":[766590144]},{"nodeId":766590144,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1996827810,"text":"Huh?","nextNodeIds":[766590145]},{"nodeId":766590145,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":1397919474,"text":"I wasn't thinking about making them into different kuuvahki weapon types while designing them.","nextNodeIds":[766590146]},{"nodeId":766590146,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":1793768778,"text":"What I wanted to invent was a robot that could use the interactive powers of kuuvahki to gain a certain level of intelligence.","nextNodeIds":[766590147]},{"nodeId":766590147,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":3459404626,"text":"But during my testing, I came to learn that the kuuvahki in the system I designed was not so much \"logic\" as a type of \"emotion.\"","nextNodeIds":[766590148]},{"nodeId":766590148,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":3761562946,"text":"And that's why the robots were more prone to malfunctioning when tests got more stressful.","nextNodeIds":[766590149]},{"nodeId":766590149,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":2610561042,"text":"But if you give the robots enough friends and let them have fun, the systems run smooth as butter.","nextNodeIds":[766590150]},{"nodeId":766590150,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":3440554714,"text":"#The combat abilities they awakened were essentially meant to protect their favorite playmate, {NICKNAME}.","nextNodeIds":[766590151]},{"nodeId":766590151,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":3136352658,"text":"They sound like a group of kids, don't you think? They can't become the weapons you want them to be, because children won't listen to orders.","nextNodeIds":[766590152]},{"nodeId":766590152,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":3222554642,"text":"Hmm... But there is a possibility, no? Perhaps all they need is to be whipped into shape.","nextNodeIds":[766590153]},{"nodeId":766590153,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":1187070130,"text":"You...","nextNodeIds":[766590154]},{"nodeId":766590154,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":919134666,"text":"I dare you to try.","nextNodeIds":[766590155]},{"nodeId":766590155,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":910338194,"text":"Both Miss Aino and Miss Ginette's research has been invaluable to the Adventurers' Guild here in Nod-Krai. I'd strongly advise against stirring up... unnecessary disputes.","nextNodeIds":[766590156]},{"nodeId":766590156,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":834403658,"text":"Or else, the Guild will have to step in. Are we clear?","nextNodeIds":[766590157]},{"nodeId":766590157,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":1163670770,"text":"The Adventurers' Guild... So, you've had an eye on this place then? Fine. Business is business. I'm not in the mood to make trouble I didn't ask for.","nextNodeIds":[766590158]},{"nodeId":766590158,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":3196169452,"text":"And, as per Miss Robot's request, I shan't make any further commercial demands for Aino's work.","nextNodeIds":[766590159]},{"nodeId":766590159,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","textMapHash":2532192890,"text":"In exchange, I'll take this bounty hunter with me. He'll make up for my losses.","nextNodeIds":[766590160]},{"nodeId":766590160,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3158989410,"text":"...Of course. Please take him away.","nextNodeIds":[766590161]},{"nodeId":766590161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1750508978,"text":"Is this really okay, Ineffa? We can't guarantee he wasn't trying to cover for this guy...","nextNodeIds":[766590162]},{"nodeId":766590162,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2604160682,"text":"There are many unwritten rules in Nod-Krai's shadows. I do not agree with them. I just don't want them to affect Aino's life.","nextNodeIds":[766590163]},{"nodeId":766590163,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2660283578,"text":"Some things are best settled outside the workshop.","nextNodeIds":[766590164]},{"nodeId":766590164,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":423467978,"text":"Hmm... If you say so.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7665901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"Asikko","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[176659],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":456356254,"CHECNJEMEFE":{"1312":[1120],"7016":[1230],"7048":[1060],"7053":[1283]},"CJPLOBIFHL