","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["1","3","72693","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269305,"initDialog":726930501,"nextRandomTalks":[],"nextTalks":[7269306],"npcId":[30173],"performCfg":"QuestDialogue/WQ/Inazuma_72693/Q7269305","priority":5,"questId":72693,"showRandomTalkCount":0},"dialogs":[{"nodeId":726930501,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":1002031770,"text":"The wild fruit in here must be alluding to some painful experiences. It is not a purely joyful memory, like the first taste of alcohol or the first reading of a poem, but it nonetheless leaves a deep impression.","nextNodeIds":[]}]},{"talkId":7269306,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7269305","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7269306,"initDialog":726930601,"nextRandomTalks":[],"nextTalks":[],"npcId":[30173,30172],"performCfg":"QuestDialogue/WQ/Inazuma_72693/Q7269306","priority":5,"questId":72693,"showRandomTalkCount":0},"dialogs":[{"nodeId":726930601,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":4002744770,"text":"Ootomo's poem has really broken through the usual form of the Inazuman poem, yet it also uses its ancient style to depict all manner of unforgettable human experiences.","nextNodeIds":[726930602]},{"nodeId":726930602,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":1213581042,"text":"Perhaps he means to say that although Mondstadt and Inazuma may seem greatly different, they do share some common aesthetics — just as how the two of us, despite being from these different nations, were able to bond as poets.","nextNodeIds":[726930603]},{"nodeId":726930603,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":1081249530,"text":"Ah, to think that you were able to grasp the feelings behind this verse so quickly, despite being so young...","nextNodeIds":[726930604]},{"nodeId":726930604,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":2725681810,"text":"I didn't believe in the idea of making friends of disparate ages from yourself before, but now I know that it is true. What a joyful truth it is!","nextNodeIds":[726930605]},{"nodeId":726930605,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":2469335306,"text":"#And you too, learned {F#young lady}{M#young man} — that we three should have met here... There must be some destiny at play.","nextNodeIds":[726930606]},{"nodeId":726930606,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":2991202138,"text":"Indeed. The trip to Inazuma was a pretty bumpy one, but none of that matters now. Even when I return to Mondstadt, I will remember everything I've seen here in Inazuma.","nextNodeIds":[726930607]},{"nodeId":726930607,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":2904685330,"text":"This is also thanks to the pictures you brought.","nextNodeIds":[726930608]},{"nodeId":726930608,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":2791293474,"text":"I hope that someday, we three shall meet once again.","nextNodeIds":[726930609]},{"nodeId":726930609,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":1757739866,"text":"We will!","nextNodeIds":[]}]},{"talkId":7269307,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","