,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4016401","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7907303,"initDialog":790730301,"nextRandomTalks":[],"nextTalks":[7907305],"npcId":[30604],"performCfg":"QuestDialogue/WQ/Island_79073/Q7907303","priority":5,"questId":79073,"showRandomTalkCount":0},"dialogs":[{"nodeId":790730301,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":1864351914,"text":"Do remember to avoid the giant dragon, who can come knocking at any time! Don't let him get in the way of your travels!","nextNodeIds":[790730302]},{"nodeId":790730302,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":315282482,"text":"*sigh* Truth be told, I wanted to give him some Paper Models. Thought it might improve his mood, perhaps keep him from blowing my shelves over again...","nextNodeIds":[790730303]},{"nodeId":790730303,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":179355770,"text":"But he doesn't seem the least bit interested in listening to me, simply flying off as he pleases, just as always...","nextNodeIds":[]}]},{"talkId":7907304,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4016401","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7907304,"initDialog":790730401,"nextRandomTalks":[],"nextTalks":[7907305],"npcId":[30604],"performCfg":"QuestDialogue/WQ/Island_79073/Q7907304","priority":5,"questId":79073,"showRandomTalkCount":0},"dialogs":[{"nodeId":790730401,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3972952578,"text":"Fortunately, a sudden visit of the draconic variety isn't on the menu anymore. If anything, I'd say that you've come at just the right time!","nextNodeIds":[790730402]},{"nodeId":790730402,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":2254090458,"text":"Word is that the dragon's having a bout of good temper.","nextNodeIds":[790730403]},{"nodeId":790730403,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":2963332834,"text":"I was just about to bring some Paper Models over to see him. Hope he likes them.","nextNodeIds":[]}]},{"talkId":7907305,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7907305,"initDialog":790730501,"nextRandomTalks":[],"nextTalks":[],"npcId":[30604],"performCfg":"QuestDialogue/WQ/Island_79073/Q7907305","priority":5,"questId":79073,"showRandomTalkCount":0},"dialogs":[{"nodeId":790730501,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":1724990714,"text":"Oh my, I forgot to introduce you to my masterpiece, as well as this outstanding frame.","nextNodeIds":[790730502]},{"nodeId":790730502,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3282519154,"text":"Please, look over here! Have a look at this Fantastical Fabricator. Every Paper Model I've made up to this moment is inside.","nextNodeIds":[790730503]},{"nodeId":790730503,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":4247554714,"text":"I've walked... well, \"jumped\" across the entire world, and made countless friends in my journey to craft them.","nextNodeIds":[790730504]},{"nodeId":790730504,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3577825466,"text":"For example, the flying squirrel Clanche, who would often drag me into wind currents to try flying, Devitt, who loves paper models as I do, and of course, Alof, ever the stone-faced fellow.","nextNodeIds":[790730505]},{"nodeId":790730505,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":224827994,"text":"They were all generous enough to let me make paper models based off them, so that I might share these interesting toys with everyone!","nextNodeIds":[790730506]},{"nodeId":790730506,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":2732687186,"text":"Alright then. Grab these Starsail Coins — consider them a welcome gift. Then stuff them into the Fabricator, and finally, turn this handle. Let's see what the dewdrops shall bring you today.","nextNodeIds":[790730507]},{"nodeId":790730507,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3240181738,"text":"Once you use these coins up, though, you'll have to find a way to get some more on your own — if you want to continue turning that Fabricator handle, that is.","nextNodeIds":[790730508]},{"nodeId":790730508,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3465607082,"text":"As to just how to get more... Well, you can ask those good friends of mine. I'm sure they'll have an idea or two.","nextNodeIds":[790730509]},{"nodeId":790730509,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":1697020130,"text":"After you get the present, you can exhibit them on the shelf behind me.","nextNodeIds":[790730510]},{"nodeId":790730510,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3288304762,"text":"Strictly speaking, it is this shelf that was the true impetus for my creation of the Fantastical Fabricator and Paper Models...","nextNodeIds":[790730511]},{"nodeId":790730511,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3484053426,"text":"But that telling of that tale is no simple thing... Should you so wish, I would be glad to share it with you.","nextNodeIds":[790730512]},{"nodeId":790730512,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","textMapHash":3398267266,"text":"But for now, just start the Fabricator up. Dreamy dewdrops above willing, may you gain the gift you desire, and may your mood be uplifted for the rest of the day.","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7907301,7907303,7907304,7907305],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"Xudi","count":20}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[179073],"BHCBFLFOGJN":0,"BPEIDGP