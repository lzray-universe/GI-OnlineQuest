erName":"Lisa","textMapHash":983440798,"text":"Oh wait a moment... Actually, Charles here was wondering—","nextNodeIds":[4880005]},{"nodeId":4880005,"roleType":"TALK_ROLE_NPC","speakerId":10030,"speakerName":"Charles","textMapHash":284418422,"text":"Please, allow me, ma'am.","nextNodeIds":[4880006]},{"nodeId":4880006,"roleType":"TALK_ROLE_NPC","speakerId":10030,"speakerName":"Charles","textMapHash":1924909422,"text":"I just took a rather important order, but unfortunately we've run completely dry and the delivery from the winery is behind schedule.","nextNodeIds":[4880007]},{"nodeId":4880007,"roleType":"TALK_ROLE_NPC","speakerId":10030,"speakerName":"Charles","textMapHash":2805709470,"text":"If it's not too much trouble, could you go and <color=#00E1FFFF>do something about this logistical nuisance</color>?","nextNodeIds":[4880008]},{"nodeId":4880008,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3906510254,"text":"What's so urgent about this order?","nextNodeIds":[4880009]},{"nodeId":4880009,"roleType":"TALK_ROLE_NPC","speakerId":10030,"speakerName":"Charles","textMapHash":513388838,"text":"*sigh* It came in at the last minute. Literally, just a few seconds ago.","nextNodeIds":[4880010]},{"nodeId":4880010,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":470640366,"text":"Exactly, hence the urgency.","nextNodeIds":[4880011]},{"nodeId":4880011,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3018364886,"text":"Okay, I'll see what I can do.","nextNodeIds":[4880012]},{"nodeId":4880012,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2814507366,"text":"Okay, but my next drink here had better be on the house!","nextNodeIds":[4880013]},{"nodeId":4880013,"roleType":"TALK_ROLE_NPC","speakerId":10030,"speakerName":"Charles","textMapHash":998184302,"text":"Heh... I'm positive that next time my boss Master Diluc is here, he'll pick up the tab for you.","nextNodeIds":[4880014]},{"nodeId":4880014,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1209971030,"text":"Sounds about right!","nextNodeIds":[]}]},{"talkId":48804,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["48800","3"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["48802","3",""],"type":"QUEST_COND_STATE_NOT_EQUAL"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":48804,"initDialog":4880401,"nextRandomTalks":[],"nextTalks":[],"npcId":[10030],"performCfg":"","priority":5,"questId":488,"showRandomTalkCount":0},"dialogs":[{"nodeId":4880401,"roleType":"TALK_ROLE_NPC","speakerId":10030,"speakerName":"Charles","textMapHash":3282556070,"text":"It's not uncommon for delivery workers to take a couple of bottles for themselves and make a bit of extra cash on the side. But obviously you don't seem like the type.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48800,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST