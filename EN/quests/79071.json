{"mainQuestId":79071,"title":"\"Owl Musician\"","description":"You encounter a serious guard in Constellation Metropole...","titleTextMapHash":2545920167,"descTextMapHash":1031507350,"mainQuestExcel":{"mainQuestId":79071,"titleTextMapHash":2545920167,"title":"\"Owl Musician\"","descTextMapHash":1031507350,"description":"You encounter a serious guard in Constellation Metropole...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2032,"luaPath":"Actor/Quest/WQ79071","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2032,"chapterId":0,"descTextMapHash":1031507350,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":79071,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3503722297,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ79071","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[179071],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2545920167,"type":"WQ","unlockDescTextMapHash":3771692398}},"flow":[{"subQuestId":7907101,"order":1,"stepDescription":"Talk to Alof","stepDescTextMapHash":2858193980,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30606"],"NOCCOBOFKHP":100,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7907101],"talks":[{"talkId":7907101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7907101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7907101,"initDialog":790710101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30606],"performCfg":"QuestDialogue/WQ/Island_79071/Q7907101","priority":5,"questId":79071,"showRandomTalkCount":0},"dialogs":[{"nodeId":790710101,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":3479375850,"text":"#Welcome to Constellation Metropole, {NICKNAME}, Ms. Paimon.","nextNodeIds":[790710102]},{"nodeId":790710102,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":1301979522,"text":"My colleagues have apprised me of your names and deeds, and have confirmed that you are valiant indeed.","nextNodeIds":[790710103]},{"nodeId":790710103,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":3211887842,"text":"Were I not in charge of training the guards, I should have liked to spar with you.","nextNodeIds":[790710104]},{"nodeId":790710104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3726225474,"text":"So you're a guard yourself, then?","nextNodeIds":[790710105]},{"nodeId":790710105,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":1194426994,"text":"In sooth, I am. On the orders of our liege, we are to defend Constellation Metropole and keep the peace.","nextNodeIds":[790710106]},{"nodeId":790710106,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":3428377562,"text":"My work, specifically, is to train the guards, that their skills may prove worthy of their duty.","nextNodeIds":[790710107]},{"nodeId":790710107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":910535282,"text":"So the door behind leads to the training grounds?","nextNodeIds":[790710108]},{"nodeId":790710108,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":3951491626,"text":"Keen-eyed indeed! It leads to a Domain that we just finished remodeling.","nextNodeIds":[790710109]},{"nodeId":790710109,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":3463295682,"text":"Within those grounds, the trainee must swing their blade to a specific rhythm, and the arena's lighting will constantly change throughout the battle.","nextNodeIds":[790710110]},{"nodeId":790710110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1939353826,"text":"Sounds like some pretty rigorous training...","nextNodeIds":[790710111]},{"nodeId":790710111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1804763450,"text":"Sounds complicated, more like... Do you have to follow that specific rhythm while fighting as well?","nextNodeIds":[790710112]},{"nodeId":790710112,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":1079407074,"text":"This part of the regimen is actually derived from a story titled \"The Owl Musician.\"","nextNodeIds":[790710113]},{"nodeId":790710113,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":2966125794,"text":"It was popular amongst the guards some time back. Many enjoyed it to the point where they'd forget to take part in training, and their daily patrols were delayed.","nextNodeIds":[790710114]},{"nodeId":790710114,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":1702874482,"text":"But I had a thought. Since everyone liked it so much, adding elements of the story into our training would make it more enjoyable.","nextNodeIds":[790710115]},{"nodeId":790710115,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":57213994,"text":"It has had a visible effect on training... if nothing else, there have been no further delays in our patrols due to personal reasons.","nextNodeIds":[790710116]},{"nodeId":790710116,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":896912818,"text":"Hehe... Would the two of you be interested in said training?","nextNodeIds":[790710117]},{"nodeId":790710117,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":2045919042,"text":"The challenges within should be a piece of cake for those with valor such as yours.","nextNodeIds":[790710118,790710120]},{"nodeId":790710118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":193661714,"text":"I'd love to give it a try!","nextNodeIds":[790710119]},{"nodeId":790710119,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":3887384322,"text":"Such commendable courage! Excellent. Please, then, step into the Domain.","nextNodeIds":[]},{"nodeId":790710120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3943971810,"text":"I've got other things going on right now...","nextNodeIds":[790710121]},{"nodeId":790710121,"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","textMapHash":4172797858,"text":"Understandable. Come back whenever you have the time — I will be standing guard here.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30606"],"NOCCOBOFKHP":100,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7907101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30606,"speakerName":"Alof","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[179071],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":103150