pHash":1593123426,"text":"C'mon out, little seed~","nextNodeIds":[750360802]},{"nodeId":750360802,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1553070058,"text":"C'mon out, little flower~","nextNodeIds":[750360803]},{"nodeId":750360803,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":785055738,"text":"...Huh?","nextNodeIds":[750360804]},{"nodeId":750360804,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3086310002,"text":"Huh...","nextNodeIds":[750360805]},{"nodeId":750360805,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4145614730,"text":"#Ah, {NICKNAME}, the Phlogiston's energy has faded. It must've been absorbed by the seed, but... There was no reaction.","nextNodeIds":[750360806]},{"nodeId":750360806,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2648444730,"text":"Errh?","nextNodeIds":[750360807,750360811]},{"nodeId":750360807,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3793141882,"text":"Perhaps it just needs time to grow.","nextNodeIds":[750360808]},{"nodeId":750360808,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1084205162,"text":"You really think so? You might have a point...","nextNodeIds":[750360809]},{"nodeId":750360809,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3637338914,"text":"Dandelion seeds go flying off like little umbrellas if you just blow lightly on 'em, Wolfhooks attach themselves to little wolves, and run off with them to faraway places...","nextNodeIds":[750360810]},{"nodeId":750360810,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2252276098,"text":"Seeds are tenacious little things!","nextNodeIds":[750360815]},{"nodeId":750360815,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4290882690,"text":"Well, in that case, let's leave it alone for now — there'll be time to come back later!","nextNodeIds":[750360816]},{"nodeId":750360816,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2874118866,"text":"Rawr!","nextNodeIds":[]},{"nodeId":750360811,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3596410210,"text":"Maybe the seed's got stage fright...","nextNodeIds":[750360812]},{"nodeId":750360812,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":371820762,"text":"R—Really? Hmm, yeah, maybe Paimon's just being too impatient...","nextNodeIds":[750360813]},{"nodeId":750360813,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":765157642,"text":"#The seed got dug up by {REALNAME[ID(2)|SHOWHOST(true)]}, had its nutrients stolen by flying insects, and was even disturbed by some monsters barging in...","nextNodeIds":[750360814]},{"nodeId":750360814,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":677420570,"text":"That fight must've sounded like a horrible thunderstorm to a seed — guess it's only natural that it would hide in the soil, not daring to move.","nextNodeIds":[750360815]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7503608,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"},{"LNHLPKELCAL":["133501050","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21567"],