Rule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7104602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":7104602,"initDialog":710460201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2151],"performCfg":"QuestDialogue/WQ/Liyue_71046/Q7104602","priority":5,"questId":71046,"showRandomTalkCount":0},"dialogs":[{"nodeId":710460201,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":859874450,"text":"Halt! The Chasm is sealed off. If you're an outsider, please... Oh, it's you!","nextNodeIds":[710460202]},{"nodeId":710460202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":308280658,"text":"Oh no, run!","nextNodeIds":[710460203,710460204,710460205]},{"nodeId":710460203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4012986970,"text":"Paimon, come on now.","nextNodeIds":[710460206]},{"nodeId":710460206,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":4082501370,"text":"Hahaha! Sorry for scaring you. Of course I remember you. How could I forget the person who saved my life?","nextNodeIds":[710460207]},{"nodeId":710460207,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":2186190954,"text":"I was only recently transferred here myself... Didn't think I'd meet you here. Guess I'm a lucky guy, eh?","nextNodeIds":[710460208]},{"nodeId":710460208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":175897450,"text":"We saved you? Did we do that?","nextNodeIds":[710460209]},{"nodeId":710460209,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":3487415642,"text":"Oh, come now! I was at the Jade Chamber when we fought that sea monster together. I was lightly injured and only returned to my post recently...","nextNodeIds":[710460210]},{"nodeId":710460210,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":3658357602,"text":"You might not remember me, but I'll never forget you. All our comrades who fought that day witnessed what you did for Liyue.","nextNodeIds":[710460211]},{"nodeId":710460211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":405905530,"text":"Could you tell me a bit about The Chasm?","nextNodeIds":[710460212]},{"nodeId":710460212,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":2688910274,"text":"Two years ago, an unknown incident occurred deep within the caverns and the Qixing gave the order to close the place. The miners were largely evacuated to safety.","nextNodeIds":[710460213]},{"nodeId":710460213,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":2978982554,"text":"It's just a shame that such a huge mine ceased production, just like that. The workers took their compensation and went their separate ways... Once such a gathering of people is dispersed, I fear it may be difficult to get them back together again.","nextNodeIds":[710460214]},{"nodeId":710460214,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":281619954,"text":"...Um, sorry, got a bit off-topic there. I believe that you must be here on important business, so I won't bother you any further. If you have any questions, just ask Muning directly. He should be at the campsite at the mine entrance.","nextNodeIds":[710460215]},{"nodeId":710460215,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"Tie Hong","textMapHash":1167848010,"text":"Also, uh, it's not that I don't trust you or anything, but it's my job to remind you not to do anything that breaks the law!","nextNodeIds":[710460216]},{"nodeId":710460216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3069211386,"text":"Don't worry, you can trust us, come on!","nextNodeIds":[]},{"nodeId":710460204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3989286306,"text":"You know me?","nextNodeIds":[710460206]},{"nodeId":710460205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1222473026,"text":"We've been recognized! Time to scoot!","nextNodeIds":[710460206]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7104603,"order":3,"stepDescription":"","stepDescTextMapHash":140748068,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104429,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_S