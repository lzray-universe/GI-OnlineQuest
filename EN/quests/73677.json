:{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30245"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7367701],"talks":[{"talkId":7367701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2016","2016015","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367701,"initDialog":736770101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30245],"performCfg":"QuestDialogue/WQ/Mengde_73677/Q7367701","priority":5,"questId":73677,"showRandomTalkCount":0},"dialogs":[{"nodeId":736770101,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":1733942754,"text":"Mr. Hunter, please! Take me with you! I'll be helpful! I promise!","nextNodeIds":[736770102]},{"nodeId":736770102,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":4124894242,"text":"Hey, calm down! We're recruiting to hunt Forest Boars now, yes, but we can't hire someone who doesn't have any hunting experience.","nextNodeIds":[736770103]},{"nodeId":736770103,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":2878715874,"text":"Ah, what shall I do? My paper... Is my paper gone together with the Forest Boars disappearing into the woods?","nextNodeIds":[736770104]},{"nodeId":736770104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1911937370,"text":"What's with the long faces, you two? What happened?","nextNodeIds":[736770105]},{"nodeId":736770105,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":2065580722,"text":"Oh, if it isn't the legendary Traveler? Cheer up, lad. This person right here might have a solution for you.","nextNodeIds":[736770106,736770108]},{"nodeId":736770106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4073431658,"text":"Solutions for you, trouble for me, I'll bet.","nextNodeIds":[736770107]},{"nodeId":736770107,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":979323266,"text":"Haha, don't say that! Everyone knows that the Honorary Knight of Mondstadt is both capable and happy to help.","nextNodeIds":[736770110]},{"nodeId":736770110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2426180162,"text":"So what do you need our help with?","nextNodeIds":[736770111]},{"nodeId":736770111,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":1510474946,"text":"Well, Forest Boars have been appearing very often recently, and there aren't enough of us hunters to deal with them, so we are recruiting volunteers who are willing to capture the Forest Boars.","nextNodeIds":[736770112]},{"nodeId":736770112,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":2556573410,"text":"This student from Sumeru wants to join too, but judging by his feeble look, he's not physically suitable for such a task.","nextNodeIds":[736770113]},{"nodeId":736770113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3451462906,"text":"Aren't you a student? Why do you want to join the hunt?","nextNodeIds":[736770133]},{"nodeId":736770133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2220417866,"text":"#Forest Boars may appear lovely with their round shape, but they're very dangerous when charging towards you. I'd advise against approaching them unless you're as agile as {NICKNAME}.","nextNodeIds":[736770114]},{"nodeId":736770114,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":1282775202,"text":"I know, I know, but a creature of legend has appeared around here after all!","nextNodeIds":[736770115]},{"nodeId":736770115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1016950090,"text":"Hold on, \"a creature of legend\"?","nextNodeIds":[736770116]},{"nodeId":736770116,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":2377791098,"text":"Yeah. He's probably talking about a white-maned Forest Boar species that I happened upon a few days ago. I happened to mention it when I was chatting with him earlier.","nextNodeIds":[736770117]},{"nodeId":736770117,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":4041069570,"text":"I've never seen that type of Forest Boar before, but are they really that special?","nextNodeIds":[736770118]},{"nodeId":736770118,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":3812753426,"text":"Of course! As far as I know, the type of Forest Boar you saw is a breed that has been extinct for over a hundred years — the Snowboar.","nextNodeIds":[736770119]},{"nodeId":736770119,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":2890120106,"text":"Some adventurers recently claimed to have found traces of them in Dragonspine, but the academic world at large did not believe them due to inconsistent sighting reports.","nextNodeIds":[736770120]},{"nodeId":736770120,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":360849362,"text":"I won't hide it from you. I'm an Amurta student from the Sumeru Akademiya. I have not decided on the topic of my graduation paper, so I came here to take a break and attend the Weinlesefest.","nextNodeIds":[736770121]},{"nodeId":736770121,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":463342874,"text":"It would be a great academic discovery if I were to find conclusive evidence that the Snowboar species is still extant. I'm sure it'll make my paper writing process a lot easier too!","nextNodeIds":[736770122]},{"nodeId":736770122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2237424938,"text":"#I see. {NICKNAME}, is it just me, or do you also find that many Akademiya researchers we met have similar worries?","nextNodeIds":[736770123]},{"nodeId":736770123,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":3610963922,"text":"Studying is important indeed, but good health is the foundation for everything. So for the sake of his safety, I really can't bring him along.","nextNodeIds":[736770134]},{"nodeId":736770134,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":1475051722,"text":"Traveler, would you be willing to join the capture team in his place?","nextNodeIds":[736770124]},{"nodeId":736770124,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":142071842,"text":"If we have someone like you join us, we'll be able to catch Forest Boars much more efficiently for sure — and we can also free up some time to help look for traces of the Snowboar.","nextNodeIds":[736770125]},{"nodeId":736770125,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":1713574562,"text":"R—Really? Don't worry, I have funds for research. I can definitely offer payment that would satisfy everyone!","nextNodeIds":[736770126,736770127]},{"nodeId":736770126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1554507066,"text":"Okay, let's do this for scientific research.","nextNodeIds":[736770128]},{"nodeId":736770128,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":248821098,"text":"It's settled then! Traveler, I'm heading out to catch Forest Boars soon. I've seen Snowboars in that place before, so you should come too.","nextNodeIds":[736770129]},{"nodeId":736770129,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":3578806570,"text":"I set up some common hunting tools in the forest. I'll teach you how to use them later. We can set off once you're ready.","nextNodeIds":[736770130,736770131]},{"nodeId":736770130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1414963586,"text":"I'm ready. Let's go.","nextNodeIds":[]},{"nodeId":736770131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":93195258,"text":"Let me get myself ready.","nextNodeIds":[736770132]},{"nodeId":736770132,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":3060521058,"text":"No problem, come back to me once you're ready.","nextNodeIds":[]},{"nodeId":736770127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":297383834,"text":"Alright, let's get that research funding.","nextNodeIds":[736770128]},{"nodeId":736770108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2898633866,"text":"Looks like it's time for me to shine.","nextNodeIds":[736770109]},{"nodeId":736770109,"roleType":"TALK_ROLE_NPC","speakerId":30245,"speakerName":"Edmund","textMapHash":2020044866,"text":"Haha, you truly are Mondstadt's Honorary Knight. You are not only capable but also helpful.","nextNodeIds":[736770110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30245"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7367702,"order":2,"stepDescription":"Participate in the hunt near Springvale","stepDescTextMapHash":113249884,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2016,101],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":