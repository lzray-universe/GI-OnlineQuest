D0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7211802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7211801,"initDialog":721180101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3162],"performCfg":"","priority":5,"questId":72118,"showRandomTalkCount":0},"dialogs":[{"nodeId":721180101,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":670596130,"text":"Finally! At long last, it is done! Fortunately, I remember these specifications...","nextNodeIds":[721180102]},{"nodeId":721180102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1594202826,"text":"So, we're going in to purify the Tatarigami energy, then?","nextNodeIds":[721180103]},{"nodeId":721180103,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3006489450,"text":"Well, as much as I would love to get in there and wrap this up, we must not act so rashly when faced with the Tatarigami.","nextNodeIds":[721180104]},{"nodeId":721180104,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1818546346,"text":"Moreover, some of the required materials I simply could not find, so I had to make do with some last-minute substitutions. The result being that the reliability of this device is somewhat...","nextNodeIds":[721180105]},{"nodeId":721180105,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1588892874,"text":"Hmm. Well, let me just say that \"in some circumstances, it may not achieve the desired efficacy.\"","nextNodeIds":[721180106]},{"nodeId":721180106,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3244669682,"text":"It can be used normally just fine, yes, but I doubt that it can withstand any accidents. The slightest jolt will likely knock some of the components out of place...","nextNodeIds":[721180107]},{"nodeId":721180107,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3280542858,"text":"As such, we still require a little more preparation before we can put our new friend here to work.","nextNodeIds":[721180108]},{"nodeId":721180108,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":459254794,"text":"I'd like you to go near the Mikage Furnace and record some data for me.","nextNodeIds":[721180109,721180111]},{"nodeId":721180109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":32316514,"text":"Consider it done.","nextNodeIds":[721180110]},{"nodeId":721180110,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2620273322,"text":"Thank you very much. I'll be waiting for you here.","nextNodeIds":[]},{"nodeId":721180111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":527993090,"text":"Do we really need to be so cautious?","nextNodeIds":[721180112]},{"nodeId":721180112,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":984712242,"text":"Of course we do. To tell you the truth, I'm already cutting out quite a few steps here compared to the proper protocol. If Mr. Flois were here, it would be another week before we'd finish working through his process.","nextNodeIds":[721180113]},{"nodeId":721180113,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3121691034,"text":"Anyway, desperate times call for desperate measures, and as representative of the project review panel, technically this is my call... so, I hereby authorize us to adapt our approach to suit the situation.","nextNodeIds":[]}]},{"talkId":7211802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCo