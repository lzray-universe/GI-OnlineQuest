_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20657"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2301401,2301455],"talks":[{"talkId":2301401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2301401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2301401,"initDialog":230140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20658,20657],"performCfg":"QuestDialogue/IQ/Sumeru_23014/Q2301401","priority":5,"questId":23014,"showRandomTalkCount":0},"dialogs":[{"nodeId":230140101,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1801467698,"text":"Sir, I most sincerely suggest that we find a way to pay.","nextNodeIds":[230140102]},{"nodeId":230140102,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3587957898,"text":"They were more like bandits than merchants! How could they ask for such a high price for just a couple of insignias?","nextNodeIds":[230140103]},{"nodeId":230140103,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1887480690,"text":"Perhaps they noticed how your eyes lit up when you saw their goods.","nextNodeIds":[230140104]},{"nodeId":230140104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3184943506,"text":"What do you want the insignias for?","nextNodeIds":[230140105]},{"nodeId":230140105,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3700294818,"text":"Traveler! Your timing is always most opportune...","nextNodeIds":[230140106]},{"nodeId":230140106,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":2855775770,"text":"Thanks to your help last time, I have basically produced an acceptable lubricant.","nextNodeIds":[230140107]},{"nodeId":230140107,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":4238036418,"text":"However, I encountered another problem soon after that. While reproducing some of the parts, I found that... their excessively hard material will damage the other parts.","nextNodeIds":[230140108]},{"nodeId":230140108,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":4071830258,"text":"Moreover, these excessively hard parts would crack, to different extents, upon even the slightest impact...","nextNodeIds":[230140109]},{"nodeId":230140109,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3189167074,"text":"Thus, I began searching for a material that is both hard and flexible.","nextNodeIds":[230140110]},{"nodeId":230140110,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":594789178,"text":"After relentless research...","nextNodeIds":[230140111]},{"nodeId":230140111,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":2648744658,"text":"...And after relentlessly hassling Mr. Ahangar.","nextNodeIds":[230140112]},{"nodeId":230140112,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":1636222082,"text":"I thought that I could find the material I sought in the insignias that the Treasure Hoarders carry around with them.","nextNodeIds":[230140113]},{"nodeId":230140113,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":2294821234,"text":"But those merchants may as well have been Treasure Hoarders, the way they were robbing me!","nextNodeIds":[230140114,230140115]},{"nodeId":230140114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2636042746,"text":"So this is where I come in, yes?","nextNodeIds":[230140116]},{"nodeId":230140116,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":83614610,"text":"I should carve your name on the main bearing of my Numbering Machine! I can't express my gratitude enough!","nextNodeIds":[]},{"nodeId":230140115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3320541042,"text":"Eh, I'll help you find some.","nextNodeIds":[230140116]}]},{"talkId":2301455,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2301401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["42024","0","2","",""],"type":"QUEST_COND_DAILY_TASK_VAR_EQ"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2301455,"initDialog":230145501,"nextRandomTalks":[],"nextTalks":[],"npcId":[20657,20658],"performCfg":"QuestDialogue/IQ/Sumeru_23014/Q2301455","priority":6,"questId":23014,"showRandomTalkCount":0},"dialogs":[{"nodeId":230145501,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3640667154,"text":"Ugh... Lutong, I need a hand...","nextNodeIds":[230145502]},{"nodeId":230145502,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1844159602,"text":"Sir, you'd better go back and get some sleep.","nextNodeIds":[230145503]},{"nodeId":230145503,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1690413202,"text":"Traveler, perfect timing! Come over here. I would like to ask a favor of you.","nextNodeIds":[230145504]},{"nodeId":230145504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2686331058,"text":"What's wrong with him?","nextNodeIds":[230145505]},{"nodeId":230145505,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":289069722,"text":"Well, in a word... Mr. Garcia had too much coffee and too little sleep.","nextNodeIds":[230145506]},{"nodeId":230145506,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1850686266,"text":"Fortunately, it's coffee he drank, not wine.","nextNodeIds":[230145507]},{"nodeId":230145507,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":2335107826,"text":"Lutong, uh... We have to find some more insignias... You know, the ones that the Treasure Hoarders carry around with them...","nextNodeIds":[230145508]},{"nodeId":230145508,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":1449664746,"text":"Traveler! You are here. Sorry, I didn't see you there.","nextNodeIds":[230145509]},{"nodeId":230145509,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3315990490,"text":"Would you like to get me some of those insignias? Just a few will do.","nextNodeIds":[230145510,230145512]},{"nodeId":230145510,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1033029050,"text":"You should take a break.","nextNodeIds":[230145511]},{"nodeId":230145511,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3927843922,"text":"It's okay. I'm fine. I know what I'm doing. It's just that my hands play tricks on me.","nextNodeIds":[230145514]},{"nodeId":230145514,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":616421794,"text":"Anyway, please bring back some insignias, and you will get paid.","nextNodeIds":[230145515]},{"nodeId":230145515,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":1353947850,"text":"Once you've got it, just bring it to me. I want to take a closer look. A perfect bearing must be made this time...","nextNodeIds":[]},{"nodeId":230145512,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1047716042,"text":"Never thought coffee was that effective.","nextNodeIds":[230145513]},{"nodeId":230145513,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":2817521106,"text":"It's not the coffee. Mr. Garcia doesn't want to sleep...","nextNodeIds":[230145514]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[2301455,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["2301402"],"PAINLIBBLDK":"QUEST_EXEC_ACTIVE_ITEM_GIVING"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20657"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2301402,"order":2,"stepDescription":"Obtain Treasures Hoarders' insignias for Garcia","stepDescTextMapHash":182573220,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301402,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAP