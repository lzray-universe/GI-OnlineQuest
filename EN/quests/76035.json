{"mainQuestId":76035,"title":"Her Past","description":"The Damselette appears to have some interesting things to share at the Silvermoon Hall...","titleTextMapHash":3061513399,"descTextMapHash":358387574,"mainQuestExcel":{"mainQuestId":76035,"titleTextMapHash":3061513399,"title":"Her Past","descTextMapHash":358387574,"description":"The Damselette appears to have some interesting things to share at the Silvermoon Hall...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76035","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":358387574,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"UI_QuestSign_FlowerLand","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76035,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":550499609,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76035","mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3061513399,"type":"WQ","unlockDescTextMapHash":3770862062}},"flow":[{"subQuestId":7603501,"order":1,"stepDescription":"Meet The Damselette","stepDescTextMapHash":1689101268,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_12018:2137.634,108.790,11210.050,0.000,236.791,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7603501],"talks":[{"talkId":7603501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7603501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7603501,"initDialog":760350101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76035/Q7603501","priority":5,"questId":76035,"showRandomTalkCount":0},"dialogs":[{"nodeId":760350101,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":182811738,"text":"(Is Columbina... not in?)","nextNodeIds":[760350102]},{"nodeId":760350102,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2937254682,"text":"Looking for me?","nextNodeIds":[760350103]},{"nodeId":760350103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3120347586,"text":"Waaah!","nextNodeIds":[760350104,760350105]},{"nodeId":760350104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":843542242,"text":"You scared me...","nextNodeIds":[760350106]},{"nodeId":760350106,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1565822514,"text":"After sensing your arrival, I wanted to see how close I could get to you from behind.","nextNodeIds":[760350107]},{"nodeId":760350107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2035160250,"text":"Because you have nothing better to do, or...?","nextNodeIds":[760350108]},{"nodeId":760350108,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3034950114,"text":"Hm... Is that how it seems? No different than when I was with the Fatui, then... There was never much for me to do.","nextNodeIds":[760350109]},{"nodeId":760350109,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4235009698,"text":"The Tsaritsa only sought the power of the Moon Goddesses. I was never dispatched to seize a Gnosis or anything like that.","nextNodeIds":[760350110]},{"nodeId":760350110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1171460962,"text":"So what would you do to pass the time?","nextNodeIds":[760350111]},{"nodeId":760350111,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1601644106,"text":"Take walks, watch the moon, sometimes sing... But, I came to do that last one less and less after Sandrone forbade it.","nextNodeIds":[760350112]},{"nodeId":760350112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3963517762,"text":"Hmm? She didn't like your singing?","nextNodeIds":[760350113]},{"nodeId":760350113,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2509595066,"text":"No. She praised it, actually. But, I had only recently joined the Fatui then, and she said my singing set the others on edge.","nextNodeIds":[760350114]},{"nodeId":760350114,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":827036170,"text":"Because, for those not in the know, it seemed like I was about to use... some sort of power.","nextNodeIds":[760350115]},{"nodeId":760350115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4225279098,"text":"Oh, huh... Paimon can sort of understand that.","nextNodeIds":[760350116]},{"nodeId":760350116,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2728954122,"text":"Oh, and there was another reason. She said she did most of her research at night, so if I sang during the day, it would disturb her attempts to catch up on sleep.","nextNodeIds":[760350117]},{"nodeId":760350117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3226057746,"text":"(This was the main reason, I'll bet!)","nextNodeIds":[760350118]},{"nodeId":760350118,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2944223186,"text":"So, I used to just sing outside her door at night instead. But, still. She always chased me away...","nextNodeIds":[760350119]},{"nodeId":760350119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1685862690,"text":"...","nextNodeIds":[760350120]},{"nodeId":760350120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3484568274,"text":"Did you get along with the others?","nextNodeIds":[760350121]},{"nodeId":760350121,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2165102474,"text":"\"Get along\"? Hmm... When we first met, Arlecchino did seem eager to \"get along\" with me.","nextNodeIds":[760350122]},{"nodeId":760350122,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1495001986,"text":"She often showed up behind me without making a sound, like I did to you earlier. She said it was an attempt to \"test\" me, I believe.","nextNodeIds":[760350123]},{"nodeId":760350123,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":576087938,"text":"I, too, attempted to join in on the game, but she always managed to spot me before I even got close.","nextNodeIds":[760350124]},{"nodeId":760350124,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3079510842,"text":"Eventually, I resorted to using kuuvahki and managed to give her quite a scare from behind. But, she never played that game with me again after that.","nextNodeIds":[760350125]},{"nodeId":760350125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1766098362,"text":"(Yeah, Paimon doubts that was a \"game\" to the Knave at all...)","nextNodeIds":[760350126]},{"nodeId":760350126,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":636011266,"text":"What else... Oh, The Doctor often asked me to assist in his Light Realm-related research.","nextNodeIds":[760350127]},{"nodeId":760350127,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2793171042,"text":"I obliged him a few times, but it was so dull. \"Use kuuvahki to strike this,\" \"use kuuvahki to control that\"... I stopped going after a while.","nextNodeIds":[760350128,760350129]},{"nodeId":760350128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1214052466,"text":"Looks like you're in a good mood today...","nextNodeIds":[760350130]},{"nodeId":760350130,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1166764490,"text":"Yes. Even though I've \"run away from home,\" I do have some fond memories of it all the same.","nextNodeIds":[760350131]},{"nodeId":760350131,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3860236482,"text":"Arlecchino and Sandrone treated me quite well, along with...","nextNodeIds":[760350132]},{"nodeId":760350132,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1624128794,"text":"...","nextNodeIds":[760350133]},{"nodeId":760350133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2645559778,"text":"(That expression... I wonder who she's thinking about...)","nextNodeIds":[760350134]},{"nodeId":760350134,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2220397410,"text":"Give me your hand.","nextNodeIds":[760350135,760350136]},{"nodeId":760350135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2665292034,"text":"...Huh?","nextNodeIds":[760350137]},{"nodeId":760350137,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":397924530,"text":"Rosalyne taught me... It's important to always express gratitude to others.","nextNodeIds":[760350138]},{"nodeId":760350138,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1745719394,"text":"So, thank you for listening to me.","nextNodeIds":[760350139]},{"nodeId":760350139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2707063138,"text":"Don't mention it...","nextNodeIds":[760350140]},{"nodeId":760350140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":721342298,"text":"(Is this... the Moon Goddess's Favor?)","nextNodeIds":[760350141]},{"nodeId":760350141,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2760163482,"text":"I believe that's enough for today.","nextNodeIds":[760350142]},{"nodeId":760350142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":60421554,"text":"Whoa, that was sudden!","nextNodeIds":[760350143,760350144]},{"nodeId":760350143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":124903866,"text":"Shh... Paimon...","nextNodeIds":[760350145]},{"nodeId":760350145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1787113538,"text":"Yeah, guess you're right. Well, let's not bother her, then.","nextNodeIds":[]},{"nodeId":760350144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2636940178,"text":"She's remembering certain things from her past, I think...","nextNodeIds":[760350145]},{"nodeId":760350136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":458575002,"text":"...Why?","nextNodeIds":[760350137]},{"nodeId":760350129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2168507218,"text":"You spoke quite a bit about your past...","nextNodeIds":[760350130]},{"nodeId":760350105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2662881002,"text":"You really had to pop up from behind like that...?","nextNodeIds":[760350106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}]