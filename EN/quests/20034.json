ly was fortunate that you were there to bar their path.","nextNodeIds":[200340218]},{"nodeId":200340218,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":2813067778,"text":"Looks like my luck's pretty good today, huh!","nextNodeIds":[200340219]},{"nodeId":200340219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3800945218,"text":"Glad I could help.","nextNodeIds":[200340220]},{"nodeId":200340220,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":3606836690,"text":"Hehe. Well then, guess we'll haul these Treasure Hoarders back to the Guild. Be careful now — and don't forget to watch your step!","nextNodeIds":[]}]},{"talkId":2003403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2003406","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2003407","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","",""