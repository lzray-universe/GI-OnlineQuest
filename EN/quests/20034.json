3405,"order":5,"stepDescription":"Proceed onward and check the situation out","stepDescTextMapHash":2252669964,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003405,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2003405_N10000005"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2003402],"talks":[{"talkId":2003402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2003405","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2003406","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2003402,"initDialog":200340201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1024,10011,1700,10012],"performCfg":"QuestDialogue/IQ/Mengde_20034/Q2003402","priority":5,"questId":20034,"showRandomTalkCount":0},"dialogs":[{"nodeId":200340201,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":596310234,"text":"Fischl. You ran off too quickly! That was really risky...","nextNodeIds":[200340202]},{"nodeId":200340202,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":1196411698,"text":"Hah! Mine thundering retribution spares not any evildoers...","nextNodeIds":[200340203]},{"nodeId":200340203,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":450330058,"text":"Oh, it's Fischl and Bennett! Hello there!","nextNodeIds":[200340204]},{"nodeId":200340204,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":1890610994,"text":"Oh, it's you, Anna. And the Traveler, too! Are you on a commission?","nextNodeIds":[200340205]},{"nodeId":200340205,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":2612232234,"text":"Ah, you have arrived, O you who art blessed by the Prinzessin! Surely were you led here by the weft of fate.","nextNodeIds":[200340206]},{"nodeId":200340206,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":2536315898,"text":"Mein Fräulein wishes to say that she is pleased to have met you by chance.","nextNodeIds":[200340207]},{"nodeId":200340207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":393385314,"text":"I'm accompanying Anna on her commission.","nextNodeIds":[200340208]},{"nodeId":200340208,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":164748290,"text":"That's right. The Traveler and I were just escorting this transport balloon.","nextNodeIds":[200340209]},{"nodeId":200340209,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":4231661058,"text":"But all of a sudden, a whole bunch of Treasure Hoarders came charging at us...","nextNodeIds":[200340210]},{"nodeId":200340210,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":3575167850,"text":"Uh, I'm terribly sorry about that. That was my fault.","nextNodeIds":[200340211]},{"nodeId":200340211,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":1234242322,"text":"Fischl and I accepted a commission to investigate the whereabouts of a certain band of Treasure Hoarders.","nextNodeIds":[200340212]},{"nodeId":200340212,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":3289926594,"text":"Oz managed to catch their trail, and we were about to capture them... And then I tripped over a branch and fell over.","nextNodeIds":[200340213]},{"nodeId":200340213,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":1432029634,"text":"The noise startled those Treasure Hoarders, who turned and fled. We had no choice but to keep chasing them...","nextNodeIds":[200340214]},{"nodeId":200340214,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":3011931242,"text":"There was never any reason to fret. The violet light of conviction was ever fated to sever the destinies of those foul rogues.","nextNodeIds":[200340215]},{"nodeId":200340215,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":430681402,"text":"But Mein Fräulein, was it not the Traveler who ultimately apprehended them?","nextNodeIds":[200340216]},{"nodeId":200340216,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":3312873786,"text":"O—Oz!","nextNodeIds":[200340217]},{"nodeId":200340217,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":1933448738,"text":"W—Well, anyway, thanks for your help this time. It really was fortunate that you were there to bar their path.","nextNodeIds":[200340218]},{"nodeId":200340218,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":2813067778,"text":"Looks like my luck's pretty good today, huh!","nextNodeIds":[200340219]},{"nodeId":200340219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3800945218,"text":"Glad I could help.","nextNodeIds":[200340220]},{"nodeId":200340220,"roleType":"TALK_ROLE_NPC","speakerId":1024,"speakerName":"Bennett","textMapHash":3606836690,"text":"Hehe. Well then, guess we'll haul these Treasure Hoarders back to the Guild. Be careful now — and don't forget to watch your step!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003405,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2003405_N10000005"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":2003406,"order":6,"stepDescription":"Proceed onward and check the situation out","stepDescTextMapHash":2312693820,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST