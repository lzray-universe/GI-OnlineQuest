param":["7216804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":7216803,"initDialog":721680301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20268],"performCfg":"","priority":5,"questId":72168,"showRandomTalkCount":0},"dialogs":[{"nodeId":721680301,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":171698858,"text":"It goes like this... and this...","nextNodeIds":[721680302]},{"nodeId":721680302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":902913586,"text":"Have you finished it yet?","nextNodeIds":[721680303]},{"nodeId":721680303,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":2893796850,"text":"Just hold on a moment... wrap it up in flour, put it in to dry...","nextNodeIds":[721680304]},{"nodeId":721680304,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":204929514,"text":"And there we go! Sakura Tempura — try it while it's hot!","nextNodeIds":[721680305]},{"nodeId":721680305,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"Julie","textMapHash":1285742154,"text":"I—It's delicious! ... If a bit too hot...","nextNodeIds":[721680306]},{"nodeId":721680306,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"Parvaneh","textMapHash":2468763202,"text":"Xudong, I believe that this \"tempura\" also needs to be served with a special dipping sauce...","nextNodeIds":[721680307]},{"nodeId":721680307,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":1446796674,"text":"A dipping sauce? Well, I must say that I haven't prepared one of those yet. I'll look into it next time should we get the chance.","nextNodeIds":[721680308]},{"nodeId":721680308,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":3280817562,"text":"This serving of Sakura Tempura is yours, Traveler. Please take it as thanks for your help.","nextNodeIds":[721680309]},{"nodeId":721680309,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":2705330554,"text":"Ah yes, I'll give you a copy of the recipe too. Just give me a moment to write it down...","nextNodeIds":[721680310]},{"nodeId":721680310,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":3059321650,"text":"Try it yourself if you get the chance! Cooking is really fun, you know?","nextNodeIds":[721680311,721680313]},{"nodeId":721680311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":339372178,"text":"Thank you.","nextNodeIds":[721680312]},{"nodeId":721680312,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":397265898,"text":"Don't mention it!","nextNodeIds":[721680314]},{"nodeId":721680314,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":3237053290,"text":"We'll be in Inazuma for a while, so I suspect that we might head to <color=#00E1FFFF>Kannazuka</color> later.","nextNodeIds":[721680316]},{"nodeId":721680316,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":789127474,"text":"Julie says that she also wants to see that Sacred Sakura Tree at the Grand Narukami Shrine.","nextNodeIds":[721680317]},{"nodeId":721680317,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":2042772618,"text":"They say that all the Sakura Blooms on this island fell from that huge tree.","nextNodeIds":[721680318]},{"nodeId":721680318,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":802905218,"text":"I wonder, how large must that tree have been to have so many leaves fall from it...","nextNodeIds":[721680319]},{"nodeId":721680319,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":1951330354,"text":"You should pay it a visit if it takes your fancy, too.","nextNodeIds":[721680320]},{"nodeId":721680320,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"Xudong","textMapHash":55010138,"text":"Thank you for your help once again, Traveler. Well, I'm going to have a bite too. I'm starving...","nextNodeIds":[]},{"nodeId":721680313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":314654994,"text":"Where will you all be going next?","nextNodeIds":[721680314]}]},{"talkId":7216807,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7216804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"para