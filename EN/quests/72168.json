1680404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1301454794,"text":"Could you repeat that method of yours to me again?","nextNodeIds":[721680405]},{"nodeId":721680405,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"Parvaneh","textMapHash":767094482,"text":"Eh, allow me. Basically, you need to search for something nearby known as a Thunder Sakura Bough and touch it.","nextNodeIds":[721680406]},{"nodeId":721680406,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"Parvaneh","textMapHash":3548657178,"text":"After that, something known as an Electrogranum will attach itself to you, and that will allow you to pass through the barrier.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[101517,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133220211,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["WQ72168_LeiYingHuaBan","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7216803,"order":3,"stepDescription":"Give the Special Sakura Bloom to Xudong","stepDescTextMapHash":3898682380,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7216802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJA