"","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7153502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7153502,"initDialog":715350201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30681],"performCfg":"QuestDialogue/WQ/Liyue_71535/Q7153502","priority":5,"questId":71535,"showRandomTalkCount":0},"dialogs":[{"nodeId":715350201,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":1973819466,"text":"#Fancy seeing you in these parts, {NICKNAME}. You must be here for Lantern Rite, too!","nextNodeIds":[715350202]},{"nodeId":715350202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2297428538,"text":"Are you making a gift envelope?","nextNodeIds":[715350203]},{"nodeId":715350203,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":3839112066,"text":"Yeah, I'm trying make one for Candace, but I'm not happy with the result so far. I was just about to start from scratch.","nextNodeIds":[715350204]},{"nodeId":715350204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2529592330,"text":"Did Candace not come with you?","nextNodeIds":[715350205]},{"nodeId":715350205,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":2435413250,"text":"Not yet, but she'll be here.","nextNodeIds":[715350206]},{"nodeId":715350206,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":3292551986,"text":"She didn't agree to come with me to Liyue at first. Said she had to stay behind to protect the village.","nextNodeIds":[715350207]},{"nodeId":715350207,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":2349744458,"text":"I told her everyone deserves to let loose at the end of the year. I had to escort a caravan to Liyue, anyway, so she might as well come along.","nextNodeIds":[715350208]},{"nodeId":715350208,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":955436818,"text":"I even offered for some of my guys to look after the village in the meantime.","nextNodeIds":[715350209]},{"nodeId":715350209,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":1384722634,"text":"But, I couldn't convince her. In the end, she only changed her mind because the people in the village pestered her to take time off.","nextNodeIds":[715350210]},{"nodeId":715350210,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":103900666,"text":"Even then, she still insisted on wrapping up some work first.","nextNodeIds":[715350211]},{"nodeId":715350211,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":3239600738,"text":"But, the caravan waits for no one... So, I'm here on my own for now.","nextNodeIds":[715350212]},{"nodeId":715350212,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":773434538,"text":"It was so hard to pick out a gift — there are just too many nice things to choose from around here!","nextNodeIds":[715350213]},{"nodeId":715350213,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":1436460026,"text":"I ended up getting her a necklace, but then I heard about the whole gift envelope tradition during Lantern Rite, so I decided to try making one.","nextNodeIds":[715350214]},{"nodeId":715350214,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":205401154,"text":"And, well... Like I said, it hasn't been going great.","nextNodeIds":[715350215]},{"nodeId":715350215,"roleType":"TALK_ROLE_NPC","speakerId":30681,"speakerName":"Dehya","textMapHash":1634600946,"text":"#I'm sure you know more about this than me, {NICKNAME}. Can you give me some tips?","nextNodeIds":[715350216]},{"nodeId":715350216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":752936186,"text":"No problem, let me take a look...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30681"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7153503,"order":3,"stepDescription":"Complete the Gift Envelope with Dehya","stepDescTextMapHash":4034823828,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2036,71535],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_IN