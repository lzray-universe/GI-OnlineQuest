e,"talkIds":[7267901],"talks":[{"talkId":7267901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["72675","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267901,"initDialog":726759801,"nextRandomTalks":[],"nextTalks":[],"npcId":[3159],"performCfg":"QuestDialogue/WQ/Inazuma_72675/Q7267598","priority":5,"questId":72679,"showRandomTalkCount":0},"dialogs":[{"nodeId":726759801,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1334624266,"text":"Ooh, it's you. I must confess that this Kimera of yours is very impressive indeed. A true shame it is that you are not a tanuki, or you would be a most great one indeed.","nextNodeIds":[726759802]},{"nodeId":726759802,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1078226860,"text":"Well, perhaps only half as great as me, though.","nextNodeIds":[726759803,726759809,726759814]},{"nodeId":726759803,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1193274362,"text":"About scents...","nextNodeIds":[726759804]},{"nodeId":726759804,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3164503482,"text":"When you first came here, you were aided by a certain someone giving you a bake-danuki meal, yes?","nextNodeIds":[726759805]},{"nodeId":726759805,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2322746450,"text":"We bake-danuki are skilled at transforming into just about anything. Back when I was competing with that sneaky kitsune, I once transformed myself into Hanamizaka — yes, the whole street! She saw through me, though.","nextNodeIds":[726759806]},{"nodeId":726759806,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3078291234,"text":"The people of that time knew this as the False Hanamizaka Incident, and even wrote it into a text known as \"Kakushin Oobayashi.\" It should be a most famous tale... Do people nowadays no longer know of it?","nextNodeIds":[726759807]},{"nodeId":726759807,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3561204562,"text":"Whatever the case, we are too skilled at transforming, and so must rely on scents — auras — to identify each other. There might be cases of mistaken identity otherwise.","nextNodeIds":[726759808]},{"nodeId":726759808,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2954762082,"text":"That's why I said, how could it not have been that sneaky kitsune who made that meal for you? To be so familiar with us tanuki and even know our magic... There are precious few who can do such things!","nextNodeIds":[]},{"nodeId":726759809,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1088920682,"text":"About training...","nextNodeIds":[726759810]},{"nodeId":726759810,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3266424202,"text":"When I was around Kichiboushi's age, I traced the footsteps of the great bake-danuki Tsukumo across eighteen famous sites — it was in those places that he showed forth the might of the tanuki, once upon a time.","nextNodeIds":[726759811]},{"nodeId":726759811,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":302273282,"text":"For example, it is said that he once turned into a festive float team on the path of pilgrimage up Mt. Yougou, singing and dancing as he went. He even transformed himself into Her Excellency. Ah, that was quite the story!","nextNodeIds":[726759812]},{"nodeId":726759812,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3642363178,"text":"As for the other sites... Tsukumo once transformed into the mighty ancient general, Akuou, at the Mouun Shrine. He called for this shrine maiden... whatever her name was... to come out and see him, making trouble everywhere.","nextNodeIds":[726759813]},{"nodeId":726759813,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":168364626,"text":"Whatever the case, the little tanuki must not stray from our path — they must train hard to become strong and independent big bake-danuki!","nextNodeIds":[]},{"nodeId":726759814,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2212622986,"text":"See you.","nextNodeIds":[726759815]},{"nodeId":726759815,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":912449418,"text":"Take care of yourselves. I leave Kichiboushi in your hands.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267805,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7267901,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267901,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267901,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["72264","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["5055","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["72675","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_ARE