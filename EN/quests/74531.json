LK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30920"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7453101],"talks":[{"talkId":7453101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7453101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7453101,"initDialog":745310101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30920,30965],"performCfg":"QuestDialogue/WQ/Fontaine_74531/Q7453101","priority":5,"questId":74531,"showRandomTalkCount":0},"dialogs":[{"nodeId":745310101,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":248444738,"text":"#{NICKNAME}, Paimon, you're back!","nextNodeIds":[745310102,745310103]},{"nodeId":745310102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2273790138,"text":"Took quite a few photos this time.","nextNodeIds":[745310104]},{"nodeId":745310104,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":3534912122,"text":"That's wonderful! Thank you so much for your help!","nextNodeIds":[745310105]},{"nodeId":745310105,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2955958186,"text":"While you were busy taking those photos, I started thinking I can't just stand by and do nothing, or I'll never make any progress...","nextNodeIds":[745310106]},{"nodeId":745310106,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":3503192770,"text":"So I worked up the courage to ask a few passersby for help, and I even managed to take quite a few shots myself! I think that should be plenty of data for testing.","nextNodeIds":[745310107]},{"nodeId":745310107,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"Lepine-Pauline","textMapHash":3881116506,"text":"#Heh, I knew you wouldn't let me down! Thanks to {NICKNAME} for stepping in as well.","nextNodeIds":[745310108]},{"nodeId":745310108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":768406074,"text":"Lepine-Pauline! When did you get back? Ninette said you've been busy with something else lately.","nextNodeIds":[745310109]},{"nodeId":745310109,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"Lepine-Pauline","textMapHash":582952074,"text":"Well obviously, it's a massive deal — enough to fill my pockets to the brim!","nextNodeIds":[745310110]},{"nodeId":745310110,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"Lepine-Pauline","textMapHash":1846266074,"text":"Things got pretty busy for me lately, so I'm really glad you were there to help Ninette out.","nextNodeIds":[745310111]},{"nodeId":745310111,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"Lepine-Pauline","textMapHash":3611724970,"text":"She's got the talent and the taste, that's for sure. She's just a bit shy. But with your help, she's really taken an important step forward.","nextNodeIds":[745310112]},{"nodeId":745310112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2356208050,"text":"So, what's this \"massive deal\" you've been so mysterious about? Don't tell Paimon you heard another wild rumor and went all in again!","nextNodeIds":[745310113]},{"nodeId":745310113,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"Lepine-Pauline","textMapHash":204256970,"text":"What? Of course not! I've learned my lesson. This time it's the real deal — safe and sure to make a fortune!","nextNodeIds":[745310114]},{"nodeId":745310114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1820785458,"text":"(That doesn't sound entirely convincing...)","nextNodeIds":[745310115]},{"nodeId":745310115,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"Lepine-Pauline","textMapHash":2761713778,"text":"Hmph, if I tell you now, it'll ruin the surprise. Once it's done, you'll be the first to try it out!","nextNodeIds":[]},{"nodeId":745310103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2658125130,"text":"The \"Shutterflash\" lens worked great.","nextNodeIds":[745310104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":