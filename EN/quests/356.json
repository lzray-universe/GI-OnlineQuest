eIds":[3560104]},{"nodeId":3560104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2740214923,"text":"But... the city folk don't look too cheery.","nextNodeIds":[3560105]},{"nodeId":3560105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":20068931,"text":"Everyone's been put out of place by Stormterror recently.","nextNodeIds":[3560106]},{"nodeId":3560106,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2807516923,"text":"But everything will turn out fine as long as Jean's with us!","nextNodeIds":[3560107]},{"nodeId":3560107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":477647923,"text":"Jean?","nextNodeIds":[3560108]},{"nodeId":3560108,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3756949251,"text":"Acting Grand Master of the Knights of Favonius — Jean, Defender of Mondstadt.","nextNodeIds":[3560109]},{"nodeId":3560109,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3211958787,"text":"With Jean on our side, surely even the vicious Stormterror will be no match for us.","nextNodeIds":[3560110,3560111]},{"nodeId":3560110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1601029163,"text":"(Sounds like someone pretty impressive...)","nextNodeIds":[3560112]},{"nodeId":3560112,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2243134491,"text":"#Before I take you guys to the Knights of Favonius Headquarters, I have a present for you, {NICKNAME}.","nextNodeIds":[3560113]},{"nodeId":3560113,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4157181707,"text":"It's a reward for helping me clear out that hilichurl camp.","nextNodeIds":[3560114]},{"nodeId":3560114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2213050403,"text":"He-Hey! Why doesn't Paimon get a reward?","nextNodeIds":[3560115]},{"nodeId":3560115,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2749265635,"text":"Ahh... Because this reward is useless to you, Paimon.","nextNodeIds":[3560116]},{"nodeId":3560116,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2708618795,"text":"But I'll treat you to a traditional Mondstadt delicacy — Sticky Honey Roast.","nextNodeIds":[3560117]},{"nodeId":3560117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2300624755,"text":"Sticky Honey Roast!","nextNodeIds":[3560118]},{"nodeId":3560118,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1534912411,"text":"Come with me, we'll head to the city's ahh... <color=#00E1FFFF>high ground</color>.","nextNodeIds":[]},{"nodeId":3560111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3745604035,"text":"(I hope she knows something about the God of Anemo)","nextNodeIds":[3560112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[35601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":35602,"order":2,"stepDescription":"","stepDescTextMapHash":1567184279,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1126,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA"