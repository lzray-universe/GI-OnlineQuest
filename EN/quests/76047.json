Talks":[],"npcId":[7042],"performCfg":"QuestDialogue/WQ/NodKrai_76047/Q7604701","priority":5,"questId":76047,"showRandomTalkCount":0},"dialogs":[{"nodeId":760470101,"roleType":"TALK_ROLE_NPC","speakerId":7042,"speakerName":"Pechna","textMapHash":1185084522,"text":"Uh... So, I've been observing you two for a while now, and...","nextNodeIds":[760470102]},{"nodeId":760470102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2306933266,"text":"Ooh. Spying on us, you mean?","nextNodeIds":[760470103]},{"nodeId":760470103,"roleType":"TALK_ROLE_NPC","speakerId":7042,"speakerName":"Pechna","textMapHash":2715346354,"text":"Oh, no, I just... I'm often here looking for books, and just happened to notice that you two were very interested in investing. I... must advise against it.","nextNodeIds":[760470104]},{"nodeId":760470104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":932552930,"text":"Well, we haven't exactly been earning big, that's true... but why would you advise against trying at all?","nextNodeIds":[760470105]},{"nodeId":760470105,"roleType":"TALK_ROLE_NPC","speakerId":7042,"speakerName":"Pechna","textMapHash":2099745666,"text":"Because I suspect there can be no \"generous returns\" at all. The boss still has many debts to pay off, and likely won't risk taking any losses.","nextNodeIds":[760470106]},{"nodeId":760470106,"roleType":"TALK_ROLE_NPC","speakerId":7042,"speakerName":"Pechna","textMapHash":1640833882,"text":"My friend was once caught in a similar scam, so it would be best if the two of you didn't continue.","nextNodeIds":[760470107]},{"nodeId":760470107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3758139218,"text":"#Wait, could it really be a scam...? {NICKNAME}, we've gotta find that guy and get to the bottom of this!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7042"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7604702,"order":2,"stepDescription":"Talk to Dhabit","stepDescTextMapHash":1907132404,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7008"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7604702],"talks":[{"talkId":7604702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7604702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7604702,"initDialog":760470201,"nextRandomTalks":[],"nextTalks":[],"npcId":[7008],"performCfg":"QuestDialogue/WQ/NodKrai_76047/Q7604702","priority":5,"questId":76047,"showRandomTalkCount":0},"dialogs":[{"nodeId":760470201,"roleType":"TALK_ROLE_NPC","speakerId":7008,"speakerName":"Dhabit","textMapHash":3574305850,"text":"Well, well, if it isn't our regulars! Here to invest again, are we?","nextNodeIds":[760470202]},{"nodeId":760470202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1406020162,"text":"A little bird told me your investment coupons are a scam...","nextNodeIds":[760470203]},{"nodeId":760470203,"roleType":"TALK_ROLE_NPC","speakerId":7008,"speakerName":"Dhabit","textMapHash":702335090,"text":"Really now? You sure you're not just letting your imagination run wild because you've been running at a loss so far?","nextNodeIds":[760470204]},{"nodeId":760470204,"roleType":"TALK_ROLE_NPC","speakerId":7008,"speakerName":"Dhabit","textMapHash":3616536010,"text":"Think about it. How could there be any business that only earns but never costs any capital? Some will win, and some will lose. Why, back when I was in Sumeru City... Ahem. I mean, I've been unlucky for a while now, but we can never know when that might change.","nextNodeIds":[760470205]},{"nodeId":760470205,"roleType":"TALK_ROLE_NPC","speakerId":7008,"speakerName":"Dhabit","textMapHash":987129330,"text":"\"Hope\" can only be seized by the persistent. You've gotta keep investing if you ever wanna see any return!","nextNodeIds":[760470206,760470208]},{"nodeId":760470206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2270179938,"text":"Alright. Guess I'll come back again.","nextNodeIds":[760470207]},{"nodeId":760470207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1105537290,"text":"Wait, you can't be serious. You're gonna accept it, just like that?","nextNodeIds":[760470209]},{"nodeId":760470209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":865672210,"text":"#That's not gonna end well for you, buddy. We're... Right, we're the famous {NICKNAME} and Paimon. We've got plenty of friends here in Nasha Town!","nextNodeIds":[760470210]},{"nodeId":760470210,"roleType":"TALK_ROLE_NPC","speakerId":7008,"speakerName":"Dhabit","textMapHash":108803010,"text":"\"Friends\"... What do you mean— Wait. Do you mean \"that\" kind of friends!?","nextNodeIds":[760470211]},{"nodeId":760470211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1885831562,"text":"...Huh? Uh, yeah, right! They're exactly the kind you're thinking about — and we've got lots and lots of 'em!","nextNodeIds":[760470212]},{"nodeId":760470212,"roleType":"TALK_ROLE_NPC","speakerId":7008,"speakerName":"Dhabit","textMapHash":1289414570,"text":"What!? Wh—Why didn't you say so before!? I... Uh. Look. I'm sorry, alright? I'll leave you both alone. Just... take this. All of it. Take it and go, and don't come around for coupons again — not that I'd sell you any, either...","nextNodeIds":[]},{"nodeId":760470208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3197392378,"text":"Trying to pull the wool over my eyes, huh?","nextNodeIds":[760470209]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7604701","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7008"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7604703,"order":3,"stepDescription":"","stepDescTextMapHash":1287035380,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604799,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604799,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604703,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","I