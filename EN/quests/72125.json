:false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7212217,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7212501,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7212501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7212501],"talks":[{"talkId":7212501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7212501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7212501,"initDialog":721250102,"nextRandomTalks":[],"nextTalks":[],"npcId":[3165],"performCfg":"","priority":5,"questId":72125,"showRandomTalkCount":0},"dialogs":[{"nodeId":721250102,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":368172402,"text":"If only I could plant more flowers...","nextNodeIds":[721250103]},{"nodeId":721250103,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":830258594,"text":"Ah, hello! Nice to meet you... Excuse me, are you a returning resident, too? I'm sorry, I don't think I've seen you before...","nextNodeIds":[721250104,721250109]},{"nodeId":721250104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2137525730,"text":"Returning resident?","nextNodeIds":[721250105]},{"nodeId":721250105,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1169876554,"text":"Mm-hmm, the residents of Tatarasuna were evacuated to other places because of the Mikage Furnace incident.","nextNodeIds":[721250106]},{"nodeId":721250106,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1778909146,"text":"Some time ago, I heard that everything was now alright with the Mikage Furnace and that Tatarasuna was safe, so I went to ask if I could come back.","nextNodeIds":[721250107]},{"nodeId":721250107,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1873125874,"text":"After I got the approval, I packed up all my things and moved back here.","nextNodeIds":[721250108]},{"nodeId":721250108,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":217160842,"text":"But... apart from me, there don't seem to be many other people willing to move back...","nextNodeIds":[721250115]},{"nodeId":721250115,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3162021594,"text":"But that can't be helped.","nextNodeIds":[721250116]},{"nodeId":721250116,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2913816002,"text":"After all, what happened to the Mikage Furnace was very serious. Everyone's worried that it could happen again.","nextNodeIds":[721250117]},{"nodeId":721250117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1991906690,"text":"Aren't you worried, too?","nextNodeIds":[721250118]},{"nodeId":721250118,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2081081858,"text":"Of course I am... but I'm the sort of person who gets very homesick when I'm away too long. I couldn't stop worrying about my flowers, hehe. So despite everything, I just had to come back.","nextNodeIds":[721250119]},{"nodeId":721250119,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1441228098,"text":"Unfortunately, the flowers I planted around here before have all withered. It's a pity I can't find any more flower seeds right now...","nextNodeIds":[721250120]},{"nodeId":721250120,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1203601754,"text":"This place is very suitable for planting flowers. No matter what seeds you sow, before you know it they'll bloom into a sea of blossoms.","nextNodeIds":[721250121]},{"nodeId":721250121,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3584455338,"text":"I've grown flowers from overseas before, too. Mondstadt's Small Lamp Grass, Windwheel Asters and Dandelions, as well as Liyue's Silk Flowers.","nextNodeIds":[721250122]},{"nodeId":721250122,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":570535322,"text":"Small Lamp Grass looks really pretty at night. It needs to be planted in the shade, watered a lot, and the tips of the dead leaves need to be pruned.","nextNodeIds":[721250123]},{"nodeId":721250123,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3382074298,"text":"I've heard that Windwheel Asters grow well where there is wind. We get wind in Inazuma, but I doubt that it's as strong as the wind in Mondstadt... So I'll often go over and fan them with a paper fan. I'm not sure if it really helps, though.","nextNodeIds":[721250124]},{"nodeId":721250124,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2791681554,"text":"Dandelions are the least of your worries — they basically take care of themselves... sometimes a little too well, in fact. Leave them to their own devices, and they end up growing all over the place...","nextNodeIds":[721250125]},{"nodeId":721250125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4272557442,"text":"So true! Anyway, I—","nextNodeIds":[721250126]},{"nodeId":721250126,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":4231049218,"text":"Liyue's Silk Flowers, on the other hand, now they're a lot of work. Onikabuto love to crawl inside their petals, and I have to pick them out one by one.","nextNodeIds":[721250127]},{"nodeId":721250127,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2256309794,"text":"I tried growing Qingxin, too, but those were a complete failure. The ones that I planted either didn't grow at all, or withered quickly. Ahh... I wonder if there's a magical land somewhere in this world where flowers of every kind can grow smoothly...","nextNodeIds":[721250128]},{"nodeId":721250128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":210871434,"text":"Who can say. Now, I—","nextNodeIds":[721250129]},{"nodeId":721250129,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2344389730,"text":"Oh, and did you know that there's a type of flower called \"Violetgrass\" in Liyue? It's really hard to find. I've asked a lot of people for help, but—","nextNodeIds":[721250130]},{"nodeId":721250130,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3504063010,"text":"Ahem...","nextNodeIds":[721250131]},{"nodeId":721250131,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3623677098,"text":"Ah! I'm sorry! I get like this whenever I talk about flowers, I'm really sorry!","nextNodeIds":[721250132]},{"nodeId":721250132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3691806738,"text":"You're quite the flower connoisseur...","nextNodeIds":[721250133]},{"nodeId":721250133,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":606525210,"text":"I'm just an amateur flower lover, really, hehehe... but I don't even have any seeds right now, so I can't grow any flowers at all...","nextNodeIds":[]},{"nodeId":721250109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2957040218,"text":"I'm not a resident here.","nextNodeIds":[721250110]},{"nodeId":721250110,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3817110386,"text":"Oh? Is that so? I thought maybe I'd found someone else like me who was willing to move back...","nextNodeIds":[721250111]},{"nodeId":721250111,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3924458010,"text":"The population of Tatarasuna was evacuated to other places because of the Mikage Furnace incident.","nextNodeIds":[721250112]},{"nodeId":721250112,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":2312939570,"text":"Some time ago, I heard that everything was now alright with the Mikage Furnace and that Tatarasuna was safe, so I went to ask if I could come back.","nextNodeIds":[721250113]},{"nodeId":721250113,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":1285960754,"text":"After I got the approval, I packed up all my things and moved back here.","nextNodeIds":[721250114]},{"nodeId":721250114,"roleType":"TALK_ROLE_NPC","speakerId":3165,"speakerName":"Hanayama Kaoru","textMapHash":3931522114,"text":"Apart from me... there don't seem to be many other people willing to move back...","nextNodeIds":[721250115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7212501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NON