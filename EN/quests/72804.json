NE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20332"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7280403],"talks":[{"talkId":7280403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7280405","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7280403,"initDialog":728040301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20332],"performCfg":"QuestDialogue/WQ/Inazuma_72804/Q7280403","priority":5,"questId":72804,"showRandomTalkCount":0},"dialogs":[{"nodeId":728040301,"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","textMapHash":2137408666,"text":"You? Hah, aren't you that brat from before? What, are you here to add something to my collection again?","nextNodeIds":[728040302]},{"nodeId":728040302,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2354682714,"text":"No. I am here for my weapon!","nextNodeIds":[728040303]},{"nodeId":728040303,"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","textMapHash":3849831626,"text":"Heh, well, at least you've got some guts. But only one ally, really? You must really take me for a sucker, huh?","nextNodeIds":[728040304]},{"nodeId":728040304,"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","textMapHash":3125718802,"text":"But you know what? I'll give you a chance on account of your bravery, at least. Come on! Let's settle this somewhere else.","nextNodeIds":[728040305]},{"nodeId":728040305,"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","textMapHash":2179572922,"text":"Still... it wouldn't be good to leave my boys here with nothing to do, would it? I know! Why don't you ask your little helper to play with them a bit?","nextNodeIds":[728040306,728040307]},{"nodeId":728040306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2551100754,"text":"Any time they're ready.","nextNodeIds":[728040308]},{"nodeId":728040308,"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","textMapHash":3333562714,"text":"Hahaha. You've got some lip! Well then, boys, you heard 'em. Let 'em have it!","nextNodeIds":[728040309]},{"nodeId":728040309,"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","textMapHash":508747266,"text":"As for you, let's go over there.","nextNodeIds":[728040310]},{"nodeId":728040310,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":4217681714,"text":"I leave this in your hands...","nextNodeIds":[728040311]},{"nodeId":728040311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4238031562,"text":"I'll take care of it.","nextNodeIds":[728040312]},{"nodeId":728040312,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3691613714,"text":"You have my utmost thanks. I will slay him quickly and come to your aid.","nextNodeIds":[728040313]},{"nodeId":728040313,"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","textMapHash":618865554,"text":"Well, aren't you a talker yourself? You're welcome to try!","nextNodeIds":[]},{"nodeId":728040307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3776711906,"text":"Let's hope that their A-game is passable, at least.","nextNodeIds":[728040308]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133221010"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20332"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7280406,"order":6,"stepDescription":"Defeat the subordinates of the Kairagi Leader","stepDescTextMapHash":34081