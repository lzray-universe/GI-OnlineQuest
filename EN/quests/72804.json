beginCond":[{"param":["7280404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7280402,"initDialog":728040206,"nextRandomTalks":[],"nextTalks":[],"npcId":[20331,3060],"performCfg":"QuestDialogue/WQ/Inazuma_72804/Q7280402","priority":5,"questId":72804,"showRandomTalkCount":0},"dialogs":[{"nodeId":728040206,"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","textMapHash":483615834,"text":"Agh! P—Please, spare me! Where did you get this kind of help...","nextNodeIds":[728040207]},{"nodeId":728040207,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3518755970,"text":"Foul villain! Hand my weapon over at once!","nextNodeIds":[728040208]},{"nodeId":728040208,"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","textMapHash":3909983186,"text":"You... You're still all hung up about that...","nextNodeIds":[728040209]},{"nodeId":728040209,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":513036594,"text":"I am only here to retrieve my weapon. If you tell me where it is, I'll spare you.","nextNodeIds":[728040210]},{"nodeId":728040210,"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","textMapHash":3656377378,"text":"This...","nextNodeIds":[728040211,728040212]},{"nodeId":728040211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2674152738,"text":"Don't waste any more words with him.","nextNodeIds":[728040213]},{"nodeId":728040213,"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","textMapHash":2056747834,"text":"N—No, please! Please stop! I—I didn't say I wouldn't say anything! We don't have to get this violent!","nextNodeIds":[728040214]},{"nodeId":728040214,"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","textMapHash":1846186642,"text":"Th—That weapon was taken by our boss as part of his collection. If you want it, you can just go to the camp over there to get it from him!","nextNodeIds":[728040215]},{"nodeId":728040215,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1280747986,"text":"Well, at least you have some sense.","nextNodeIds":[728040216]},{"nodeId":728040216,"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","textMapHash":705135570,"text":"P—Please, good sirs, I've told you...","nextNodeIds":[728040217]},{"nodeId":728040217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":910754090,"text":"Out of my sight!","nextNodeIds":[728040218]},{"nodeId":728040218,"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","textMapHash":1136491146,"text":"At once!","nextNodeIds":[728040219]},{"nodeId":728040219,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1442946786,"text":"Not much martial skill to speak of, but he was quite the runner.","nextNodeIds":[728040220]},{"nodeId":728040220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1656641602,"text":"Not to mention pretty quick to sell his buddies out, too.","nextNodeIds":[728040221]},{"nodeId":728040221,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1878859394,"text":"The Kairagi are ultimately a motley band who've banded together for their own selfish gain. Loyalty plays no part here, nor does conviction.","nextNodeIds":[728040222]},{"nodeId":728040222,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2410997346,"text":"The moment trouble starts brewing on the horizon, they will pack up and leave. This is all too common.","nextNodeIds":[728040223]},{"nodeId":728040223,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3841711690,"text":"But fortunately, I had you here to help me. I doubt that they would have capitulated so easily otherwise.","nextNodeIds":[728040224]},{"nodeId":728040224,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3164578586,"text":"However, our next stop is their main encampment.","nextNodeIds":[728040225]},{"nodeId":728040225,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2415841794,"text":"We will follow our original stratagem. I will take their leader on, and leave the small fry to you.","nextNodeIds":[728040226,728040227]},{"nodeId":728040226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":81214122,"text":"I'll take care of it.","nextNodeIds":[728040228]},{"nodeId":728040228,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":642444106,"text":"Much obliged!","nextNodeIds":[]},{"nodeId":728040227,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":742950354,"text":"I can take ten of them at once, no problem!","nextNodeIds":[728040228]},{"nodeId":728040212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":922603226,"text":"Come on, let's find someone else...","nextNodeIds":[728040213]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133221005"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_N