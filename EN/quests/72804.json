PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7280404],"talks":[{"talkId":7280404,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":true,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7280407","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7280404,"initDialog":728040406,"nextRandomTalks":[],"nextTalks":[],"npcId":[3060],"performCfg":"","priority":5,"questId":72804,"showRandomTalkCount":0},"dialogs":[{"nodeId":728040406,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":272564010,"text":"From your steady breathing, it seems that those Kairagi were no match for you.","nextNodeIds":[728040407]},{"nodeId":728040407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2979300034,"text":"And it seems that you were victorious as well.","nextNodeIds":[728040408]},{"nodeId":728040408,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":659950738,"text":"That is indeed the case. Though I must admit that to my shame, I allowed him to escape with but a single stab from my spear due to a feint on his part.","nextNodeIds":[728040409]},{"nodeId":728040409,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2082312378,"text":"Still, his wound was very severe. I do not believe that he will emerge to do much ill for at least a few years.","nextNodeIds":[728040410]},{"nodeId":728040410,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1564288602,"text":"More importantly, I have defeated him myself and reclaimed my weapon. I am henceforth free from the stain of that humiliation.","nextNodeIds":[728040411]},{"nodeId":728040411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":76162882,"text":"Congratulations, Asakura.","nextNodeIds":[728040412]},{"nodeId":728040412,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2611524378,"text":"Indeed, I owe you thanks, but I cannot rest yet.","nextNodeIds":[728040413]},{"nodeId":728040413,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3366479794,"text":"The reason for this whole incident was my lack of training. I will continue to train hard and refine my skills.","nextNodeIds":[728040414]},{"nodeId":728040414,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2715894178,"text":"As such... I shall be counting on you in the future as well to spar with me!","nextNodeIds":[728040415]},{"nodeId":728040415,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":439519322,"text":"Ah, yes. Please take these as a token of my thanks. It isn't much, but do accept it.","nextNodeIds":[728040416]},{"nodeId":728040416,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2594463786,"text":"Thank you once again!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280404,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["41150","1","2"],"PAINLIBBLDK":"QUEST_EXEC_SET_DAILY_TASK_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3060"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7280402,7280403,7280404],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","count":22},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":20331,"speakerName":"\"Kairagi\"","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":20332,"speakerName":"\"Kairagi\" Leader","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[172804],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1333281446,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Inazuma_72804/Q7280402","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENC