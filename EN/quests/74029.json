{"mainQuestId":74029,"title":"","description":"","titleTextMapHash":1627447783,"descTextMapHash":1288141430,"mainQuestExcel":{"mainQuestId":74029,"titleTextMapHash":1627447783,"title":"","descTextMapHash":1288141430,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ74029","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":1288141430,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74029,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2433557433,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74029","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174029],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[174029],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1627447783,"type":"WQ","unlockDescTextMapHash":2621771398}},"flow":[{"subQuestId":7402901,"order":1,"stepDescription":"","stepDescTextMapHash":155032236,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7402901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5321"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7402901],"talks":[{"talkId":7402901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7402901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7402901,"initDialog":740290101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5321],"performCfg":"QuestDialogue/WQ/Fontaine_74029/Q7402901","priority":5,"questId":74029,"showRandomTalkCount":0},"dialogs":[{"nodeId":740290101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3847040594,"text":"Why have you got your fishing rod out over here? Are you really fishing?","nextNodeIds":[740290102]},{"nodeId":740290102,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2660336026,"text":"There's water, and a rod... of course I'm fishing. To think that you outsiders don't even know that... What's this world coming to, seriously?","nextNodeIds":[740290103,740290105]},{"nodeId":740290103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1305257706,"text":"I don't think this has anything to do with global trends...","nextNodeIds":[740290104]},{"nodeId":740290104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1462602298,"text":"That's right! We're not complete amateurs at fishing either, y'know!","nextNodeIds":[740290107]},{"nodeId":740290107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3276291330,"text":"What Paimon meant to say is... Y'know, that it's kinda weird for a Melusine to be using a fishing rod. Paimon didn't think you fished like that.","nextNodeIds":[740290108]},{"nodeId":740290108,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":3579748130,"text":"I—I'm not being weird! I learned this from an outsider. Delaroche is a great person. She not only taught me how to fish, but she also gave me a rod too!","nextNodeIds":[740290109]},{"nodeId":740290109,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":1113510490,"text":"Hers looked nicer, of course, but that's fine — she's a \"professional,\" and I'm just a \"hobbyist.\"","nextNodeIds":[740290110]},{"nodeId":740290110,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":723647802,"text":"Still... I've been waiting here for so long. Why haven't I gotten a bite yet?","nextNodeIds":[740290111]},{"nodeId":740290111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2048283962,"text":"Hehe, in that case, why don't you let us pros help you figure out where you're going wrong!","nextNodeIds":[740290112]},{"nodeId":740290112,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":1742500970,"text":"Huh? Are the two of you really better than Delaroche? She's a professional with a very pretty fishing rod...","nextNodeIds":[740290113]},{"nodeId":740290113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":844679258,"text":"Hmph! Looks like we might have to prove our skills, eh?","nextNodeIds":[740290114]},{"nodeId":740290114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":554329586,"text":"But are there actually any fish here?","nextNodeIds":[740290115]},{"nodeId":740290115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":635976898,"text":"Huh. Now that you mention it, there really aren't any! Paimon thought that was weird right from the get-go, too.","nextNodeIds":[740290116]},{"nodeId":740290116,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2461541978,"text":"Fish... Delaroche did say that not all waters have fish in them. Um, does \"that\" count as a fish?","nextNodeIds":[740290117]},{"nodeId":740290117,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":552972658,"text":"If \"that\" isn't a fish, could it be the reason I can't \"fish\" it up in the first place?","nextNodeIds":[740290118]},{"nodeId":740290118,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":1275566322,"text":"#Master {NICKNAME}, Master Paimon, please, tell me. What must I do to fish \"that\" up?","nextNodeIds":[740290119]},{"nodeId":740290119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3195254282,"text":"Um, you... sure are polite! Well, of course we'll help you — but first off, what's \"that\" thing you're referring to?","nextNodeIds":[740290120]},{"nodeId":740290120,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2153407954,"text":"It moves very quickly in the water, and it's so slippery that it's really hard to catch.","nextNodeIds":[740290121,740290123]},{"nodeId":740290121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":956044026,"text":"That does sound like a fish.","nextNodeIds":[740290122]},{"nodeId":740290122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1245869866,"text":"But it could also be some other underwater creature, right?","nextNodeIds":[740290125]},{"nodeId":740290125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3859270522,"text":"Well, whatever the case, we can be sure that it's something that lives in the water, but since we can't really see its silhouette, it must be hiding deep down.","nextNodeIds":[740290126]},{"nodeId":740290126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2222323674,"text":"The way Paimon sees it, we need to spread some bait out and get it to come to the surface...","nextNodeIds":[740290127]},{"nodeId":740290127,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2292749682,"text":"But it ate so much bait already... I'm not sure if switching baits will help.","nextNodeIds":[740290128]},{"nodeId":740290128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4186894330,"text":"Well, let's just spread some out first and prepare our rod, then wait for it to bite. We don't know what it is yet, but oh well.","nextNodeIds":[740290129]},{"nodeId":740290129,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":11916210,"text":"#What beautiful technique... Let me try again. I'll give you the bait, Master {NICKNAME}, Master Paimon, and then I'll ready my rod... Even though it's not a professional's pretty rod...","nextNodeIds":[740290130]},{"nodeId":740290130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3967424610,"text":"Oh, that's not a problem. Just leave spreading the bait out to us!","nextNodeIds":[]},{"nodeId":740290123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2208901810,"text":"Sounds like a Melusine, really.","nextNodeIds":[740290124]},{"nodeId":740290124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2424886954,"text":"Seriously? Wouldn't it be weird if Iara and other Melusines were to play pretend fishing games together?","nextNodeIds":[740290125]},{"nodeId":740290105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":376627018,"text":"I'm sure Paimon knows what fishing is.","nextNodeIds":[740290106]},{"nodeId":740290106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2219572194,"text":"That's true, you did fish Paimon out of the water back then, didn't you... Wait a minute, that's not the problem here!","nextNodeIds":[740290107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7402901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7400605,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7400716,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_NOT_EQUAL","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5321"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7402902,"or