ST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7402902,"initDialog":740290201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5321],"performCfg":"","priority":5,"questId":74029,"showRandomTalkCount":0},"dialogs":[{"nodeId":740290201,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2575254810,"text":"...Will it still be attracted to bait?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7402902"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133403163"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7402905,"order":3,"stepDescription":"","stepDescTextMapHash":304847956,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7402903,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5321"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7402903],"talks":[{"talkId":7402903,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7402905","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7402903,"initDialog":740290301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5321],"performCfg":"QuestDialogue/WQ/Fontaine_74029/Q7402903","priority":5,"questId":74029,"showRandomTalkCount":0},"dialogs":[{"nodeId":740290301,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2251427538,"text":"Iara places the weakened Ball Octopus into a waiting bucket...","nextNodeIds":[740290302]},{"nodeId":740290302,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":964507130,"text":"What lovely fishing technique... But this creature is now no longer beautiful. How did this happen?","nextNodeIds":[740290303]},{"nodeId":740290303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1422691090,"text":"Sorry... We didn't think the \"thing\" you were talking about was a Ball Octopus, so we, err...","nextNodeIds":[740290304,740290306]},{"nodeId":740290304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1049237066,"text":"It's my fault.","nextNodeIds":[740290305]},{"nodeId":740290305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":509663882,"text":"Yeah, you were way too hasty! Well, Paimon didn't stop you either...","nextNodeIds":[740290308]},{"nodeId":740290308,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":248057378,"text":"Don't apologize. It is in the bucket now, and that's enough for me.","nextNodeIds":[740290309]},{"nodeId":740290309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1546867666,"text":"If you say so... But seriously, how did a Ball Octopus end up here? Did it follow the flow and then fall in by accident?","nextNodeIds":[740290310]},{"nodeId":740290310,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2048801842,"text":"I caught it outside.","nextNodeIds":[740290311]},{"nodeId":740290311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3005178042,"text":"Wait, what?","nextNodeIds":[740290312]},{"nodeId":740290312,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":3065102114,"text":"I wanted to be sure of my skills at using the fishing rod, which is why I went to go catch that... \"Ball Octopus,\" I think you called it.","nextNodeIds":[740290313]},{"nodeId":740290313,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":1169196650,"text":"If I put it in here, I'd be able to fish it up whenever I wanted.","nextNodeIds":[740290314]},{"nodeId":740290314,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2964687122,"text":"...Or that was the plan, anyway. But I waited and waited, and it wouldn't bite no matter what.","nextNodeIds":[740290315]},{"nodeId":740290315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3246610242,"text":"It's kinda concerning how you captured one and put it in a pool to practice fishing with a rod...","nextNodeIds":[740290316]},{"nodeId":740290316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1991414874,"text":"But we just spread some bait out into the water, and it came out just like that. Didn't you think of doing something like that, Iara?","nextNodeIds":[740290317]},{"nodeId":740290317,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":474337258,"text":"I tried many different types of bait, like minced meat, bread crumbs, worms, mints, components... It would just eat them and then disappear. I was even starting to think that bait had no effect on it!","nextNodeIds":[740290318]},{"nodeId":740290318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1180530322,"text":"Components!? That, err, doesn't sound like bait...","nextNodeIds":[740290319,740290321]},{"nodeId":740290319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":460446754,"text":"Best not to feed strange things to aquatic products...","nextNodeIds":[740290320]},{"nodeId":740290320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2705465874,"text":"That's right— Hang on, what kinda name is \"aquatic products\"?","nextNodeIds":[740290323]},{"nodeId":740290323,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":3790971642,"text":"Hmm. Components are very, very important. Since they're not meant to be used as bait, I need to find a way to get them back.","nextNodeIds":[740290324]},{"nodeId":740290324,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2535257658,"text":"#Anyway, Master {NICKNAME} and Master Paimon, please take this component as thanks for your help!","nextNodeIds":[740290325]},{"nodeId":740290325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1214857618,"text":"Oh, it's fine, we didn't do all that much, anyway...","nextNodeIds":[740290326]},{"nodeId":740290326,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":2646331602,"text":"Eh? But Delaroche said that you need to call people \"Master\" when you ask them for help, and that they will like it when you pay them \"consultation fees.\" Is that not the case?","nextNodeIds":[740290327]},{"nodeId":740290327,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":3144399514,"text":"Please, take this dry component. It will be very useful to you in Merusea Village.","nextNodeIds":[740290328]},{"nodeId":740290328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":683938218,"text":"Well, if you say so, Iara... Thanks a lot!","nextNodeIds":[740290329]},{"nodeId":740290329,"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","textMapHash":1210154642,"text":"Yes. I hope that I can learn more beautiful fishing techniques from you two in the future as well.","nextNodeIds":[]},{"nodeId":740290321,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4211272850,"text":"So Ball Octopuses can actually eat mechanical components...","nextNodeIds":[740290322]},{"nodeId":740290322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4009389858,"text":"Isn't this more like \"eaten by mistake\"?","nextNodeIds":[740290323]},{"nodeId":740290306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3597152082,"text":"I was concerned that it might attack us...","nextNodeIds":[740290307]},{"nodeId":740290307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2013074522,"text":"Yeah... When there's danger at hand, you've gotta strike first, y'know. But, well...","nextNodeIds":[740290308]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7402903,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133403235"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["7404401","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["7402901","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5321"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":67418906,"text":"Iara places the weakened Ball Octopus into a waiting bucket..."}],"talkIds":[7402901,7402902,7402903],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":26},{"roleType":"TALK_ROLE_NPC","speakerId":5321,"speakerName":"Iara","count":24},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJK