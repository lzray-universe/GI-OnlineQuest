UEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7054301],"talks":[{"talkId":7054301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7054301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7054301,"initDialog":705430101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30522],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7054301","priority":5,"questId":70543,"showRandomTalkCount":0},"dialogs":[{"nodeId":705430101,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":2056307610,"text":"...","nextNodeIds":[705430102]},{"nodeId":705430102,"roleType":"TALK_ROLE_NPC","speakerId":30526,"speakerName":"Dustball","textMapHash":1963444730,"text":"...Meow.","nextNodeIds":[705430103]},{"nodeId":705430103,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":483714698,"text":"...It's you. Me, I'm talking.","nextNodeIds":[705430104]},{"nodeId":705430104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":961883314,"text":"Talking... Razor, are you talking to Dustball?","nextNodeIds":[705430105]},{"nodeId":705430105,"roleType":"TALK_ROLE_NPC","speakerId":30526,"speakerName":"Dustball","textMapHash":1154193386,"text":"Meow, meow-meow.","nextNodeIds":[705430106]},{"nodeId":705430106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2477251370,"text":"It seems like Dustball is trying to say... \"That's right\"?","nextNodeIds":[705430107]},{"nodeId":705430107,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":2947607394,"text":"A familiar scent, looking for friends.","nextNodeIds":[705430108]},{"nodeId":705430108,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":3083030154,"text":"It is good. Happy.","nextNodeIds":[705430109]},{"nodeId":705430109,"roleType":"TALK_ROLE_NPC","speakerId":30526,"speakerName":"Dustball","textMapHash":2953395490,"text":"Meow, meow.","nextNodeIds":[705430110]},{"nodeId":705430110,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":113212826,"text":"Friends followed the scent. You came too, happy. On your body, the smell of wind and rain, very familiar... The scent of cats, also familiar.","nextNodeIds":[705430111]},{"nodeId":705430111,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":2679778738,"text":"Paimon, very sweet scent. Smell good.","nextNodeIds":[705430112]},{"nodeId":705430112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1811189346,"text":"Eh!? Sweet... Could that be the flavor of the pancakes Valerina gave us? D—Did Paimon eat that many?","nextNodeIds":[705430113,705430114]},{"nodeId":705430113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1286508642,"text":"I gave you half of my portion, remember?","nextNodeIds":[705430115]},{"nodeId":705430115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":360740538,"text":"Really? Paimon didn't even notice... Mmm, it's all the pancake's fault for being so delicious!","nextNodeIds":[705430116]},{"nodeId":705430116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4212966506,"text":"Hehe, and Paimon also wants to eat Sweet Madames, Steaks, and Hash Browns... oh, and drink some Apple Cider!","nextNodeIds":[705430117]},{"nodeId":705430117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":610128402,"text":"#Okay, that's the menu for the next meal then! C'mon, {NICKNAME}, let's go place our order with Valerina! You come too, Razor!","nextNodeIds":[705430118]},{"nodeId":705430118,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":2416255994,"text":"Thank... Thank you...","nextNodeIds":[705430119]},{"nodeId":705430119,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":1658800514,"text":"Dustball has brought me lots of... nuts...","nextNodeIds":[705430120]},{"nodeId":705430120,"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","textMapHash":270893834,"text":"And, meat boxes... I am very full.","nextNodeIds":[705430121]},{"nodeId":705430121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1827738594,"text":"Sounds like Valerina ordered delivery, then? Did Dustball deliver the food to you, Razor?","nextNodeIds":[705430122]},{"nodeId":705430122,"roleType":"TALK_ROLE_NPC","speakerId":30526,"speakerName":"Dustball","textMapHash":2985813818,"text":"Meow-meow. Meow!","nextNodeIds":[705430123]},{"nodeId":705430123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2088173426,"text":"Paimon never imagined that the cats would actually end up taking care of the customers here in the Furball Fortress!","nextNodeIds":[705430124]},{"nodeId":705430124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":375036234,"text":"Looks like you really are the cat's meow, eh, Razor?","nextNodeIds":[]},{"nodeId":705430114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1583744970,"text":"No sweat, you can still eat triple what you ate before.","nextNodeIds":[705430115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7054301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30522,"speakerName":"Razor","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":30526,"speakerName":"Dustball","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3014656750,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOA