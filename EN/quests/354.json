eNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["35402","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":35404,"initDialog":3540401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/AQ/Mengde1_354/Q35404","priority":5,"questId":354,"showRandomTalkCount":0},"dialogs":[{"nodeId":3540401,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4001772707,"text":"May the Anemo God protect you, stranger!","nextNodeIds":[3540402]},{"nodeId":3540402,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3781784827,"text":"I am Amber, Outrider for the Knights of Favonius.","nextNodeIds":[3540403]},{"nodeId":3540403,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3388850747,"text":"You don't look like citizens of Mondstadt. Explain yourselves!","nextNodeIds":[3540404]},{"nodeId":3540404,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2779458283,"text":"We're not looking for trouble.","nextNodeIds":[3540405]},{"nodeId":3540405,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3196155651,"text":"That's what all the troublemakers say.","nextNodeIds":[3540406]},{"nodeId":3540406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3285089795,"text":"#Hello, I'm {NICKNAME}.","nextNodeIds":[3540407]},{"nodeId":3540407,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3410027571,"text":"...Doesn't sound like a local name to me.","nextNodeIds":[3540408]},{"nodeId":3540408,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3773048955,"text":"And this... mascot, what's the deal with it?","nextNodeIds":[3540409,3540412]},{"nodeId":3540409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3881322179,"text":"We're friends.","nextNodeIds":[3540410]},{"nodeId":3540410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3407843555,"text":"We've only been traveling partners for two months, but...","nextNodeIds":[3540411]},{"nodeId":3540411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3942338307,"text":"We've already become the very best of friends!","nextNodeIds":[3540414]},{"nodeId":3540414,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3181252627,"text":"So to sum it up, you're traveling partners, right?","nextNodeIds":[3540415]},{"nodeId":3540415,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2185194371,"text":"Well look, there's been a large dragon sighted around Mondstadt recently. Best you get inside the city as soon as possible.","nextNodeIds":[3540416]},{"nodeId":3540416,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2545848859,"text":"It's not far from here, I'll escort you there.","nextNodeIds":[3540417]},{"nodeId":3540417,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1911594883,"text":"Oh? Aren't you out here for some other reason?","nextNodeIds":[3540418]},{"nodeId":3540418,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1630285931,"text":"I am. But not to worry, I can keep you both safe while doing that too.","nextNodeIds":[3540419]},{"nodeId":3540419,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2178821083,"text":"Besides... I'm still not sure if I can trust you two just yet!","nextNodeIds":[3540420,3540421]},{"nodeId":3540420,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1886106027,"text":"Why so suspicious?","nextNodeIds":[3540422]},{"nodeId":3540422,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3209472851,"text":"Oh, ahh... I'm sorry. Probably not something I should say as a knight.","nextNodeIds":[3540423]},{"nodeId":3540423,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1352643683,"text":"I give you my apologies, uh... strange yet... respectable travelers.","nextNodeIds":[3540424]},{"nodeId":3540424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1590989395,"text":"That sounded so fake!","nextNodeIds":[3540425]},{"nodeId":3540425,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1834197027,"text":"Do you have something against the type of language usage prescribed by the Knights of Favonius Handbook!?","nextNodeIds":[]},{"nodeId":3540421,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3310473819,"text":"That's a rather rude way to speak to guests.","nextNodeIds":[3540422]},{"nodeId":3540412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":19456491,"text":"Emergency food.","nextNodeIds":[3540413]},{"nodeId":3540413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":526819275,"text":"Hey! That's even worse than being a mascot!","nextNodeIds":[3540414]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[35404,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execA