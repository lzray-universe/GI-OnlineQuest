["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7250102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7250102,"initDialog":725010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30160],"performCfg":"QuestDialogue/WQ/Inazuma_72501/Q7250102","priority":10,"questId":72501,"showRandomTalkCount":0},"dialogs":[{"nodeId":725010201,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":1138128250,"text":"Why does Miss Moriko always give me these weird commissions?","nextNodeIds":[725010202,725010203]},{"nodeId":725010202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1942481306,"text":"Are you still drawing illustrations?","nextNodeIds":[725010204]},{"nodeId":725010203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":455306082,"text":"You ran out of inspiration again?","nextNodeIds":[725010204]},{"nodeId":725010204,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":251765050,"text":"Ah, Traveler, what brings you here? It's been a while, and I thought you'd traveled to other nations.","nextNodeIds":[725010205]},{"nodeId":725010205,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2451953154,"text":"*sigh* How I wish I was in a better condition. Then I could travel as freely as you do.","nextNodeIds":[725010206]},{"nodeId":725010206,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3825559690,"text":"And Miss Moriko wouldn't be able to come and nag me on work progress every day...","nextNodeIds":[725010207]},{"nodeId":725010207,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2294678186,"text":"My illustrations last time were well received. Many novelists have since been requesting my works.","nextNodeIds":[725010230]},{"nodeId":725010230,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2813081114,"text":"Although Miss Moriko has rejected many jobs for me, the remaining commissions are still overwhelming...","nextNodeIds":[725010209]},{"nodeId":725010208,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2301728314,"text":"On top of that, Yae Publishing House's novelists are getting... more and more creative with their themes...","nextNodeIds":[725010209]},{"nodeId":725010209,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":1901097290,"text":"At first, I thought outside of Inazuma, Liyue and Mondstadt would be the furthest stages for their stories to unfold...","nextNodeIds":[725010210]},{"nodeId":725010210,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2959708890,"text":"Yet they now have protagonists adventuring in Sumeru, and Fontaine even.","nextNodeIds":[725010216]},{"nodeId":725010216,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3641223602,"text":"Well, enough of my complaints. Traveler, is your Kamera still functional?","nextNodeIds":[725010217,725010218]},{"nodeId":725010217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4088272906,"text":"It's working alright...","nextNodeIds":[725010219]},{"nodeId":725010218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1884341138,"text":"Do you want me to take more pictures?","nextNodeIds":[725010219]},{"nodeId":725010219,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2718078010,"text":"Well, my payment last time was quite decent, wasn't it?","nextNodeIds":[725010220]},{"nodeId":725010220,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2817760242,"text":"So, Traveler, please take more pictures throughout the world for me!","nextNodeIds":[725010221,725010224]},{"nodeId":725010221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1483162930,"text":"*sigh* Fine, leave it to me...","nextNodeIds":[725010222]},{"nodeId":725010224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":945159314,"text":"You know you can just put up a request at the Adventurers' Guild, right?","nextNodeIds":[725010225]},{"nodeId":725010222,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":4071271682,"text":"I'll be counting on you then! Hehe, I've got my notebook ready!","nextNodeIds":[725010223]},{"nodeId":725010223,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3689462898,"text":"If you hadn't shown up, I'd ask Miss Moriko to look for you...","nextNodeIds":[]},{"nodeId":725010225,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2941236298,"text":"Whoa! That won't do! Please, please, please help me! I've put up commissions but just couldn't find someone savvy enough to handle the Kamera.","nextNodeIds":[725010226]},{"nodeId":725010226,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3751776258,"text":"Just help me this time, will you? If I so much as missed another deadline, Miss Moriko'd definitely knock on my door, threatening to move in!","nextNodeIds":[725010227]},{"nodeId":725010227,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":1291015922,"text":"My stomach is already telling me that it doesn't want the Sakura Chazuke she'll make! Traveler, you have to help me!","nextNodeIds":[725010228]},{"nodeId":725010228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1959340482,"text":"Okay, okay, I got it...","nextNodeIds":[725010229]},{"nodeId":725010229,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2215159290,"text":"Phew... What a relief. Wait a bit. Let me look for my notebook...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7250102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7250102],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Trav