GJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[502701,502702],"talks":[{"talkId":502701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["502701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":502701,"initDialog":50270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1087,1088,14221,1086,1096],"performCfg":"QuestDialogue/LQ/Mavuika_5027/Q502701","priority":5,"questId":5027,"showRandomTalkCount":0},"dialogs":[{"nodeId":50270101,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":220960066,"text":"Whoa, our Archon really is amazing! And super brave, too. She even went toe to toe with Lord Xbalanque!","nextNodeIds":[50270102]},{"nodeId":50270102,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":294491570,"text":"Don't be so modest. You'd have done the same.","nextNodeIds":[50270103]},{"nodeId":50270103,"roleType":"TALK_ROLE_NPC","speakerId":14221,"speakerName":"Ajaw","textMapHash":3426938330,"text":"Hah, like any of us wouldn't! I'd have jumped at the chance! What about you?","nextNodeIds":[50270104]},{"nodeId":50270104,"roleType":"TALK_ROLE_NPC","speakerId":1086,"speakerName":"Kachina","textMapHash":83006170,"text":"I... I wouldn't dare!","nextNodeIds":[50270105]},{"nodeId":50270105,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":3584197602,"text":"Fighting is in a warrior's nature. If the opportunity was presented to you, I'm sure your instincts would make that choice for you.","nextNodeIds":[50270106]},{"nodeId":50270106,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","textMapHash":2193291866,"text":"*sigh* I swear, you're all just brimming with energy over here... This is Lord Xbalanque we're talking about. Our greatest ancestor! Are you really that into sparring with your elders?","nextNodeIds":[50270107]},{"nodeId":50270107,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":3569735570,"text":"Granny Citlali! Let's spar sometime, too!","nextNodeIds":[50270108]},{"nodeId":50270108,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","textMapHash":464205522,"text":"No, no, we're absolutely not doing that.","nextNodeIds":[]}]},{"talkId":502702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["502701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":502702,"initDialog":50270201,"nextRandomTalks":[],"nextTalks":[],"npcId":[14985,1094,1091],"performCfg":"QuestDialogue/LQ/Mavuika_5027/Q502702","priority":5,"questId":5027,"showRandomTalkCount":0},"dialogs":[{"nodeId":50270201,"roleType":"TALK_ROLE_NPC","speakerId":14985,"speakerName":"Mausau","textMapHash":3934044554,"text":"Say, what kind of vegetable do you think I'll become? A red one, or... a green one?","nextNodeIds":[50270202]},{"nodeId":50270202,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":3534366562,"text":"You? I have a feeling... that you might turn into an onion.","nextNodeIds":[50270203]},{"nodeId":50270203,"roleType":"TALK_ROLE_NPC","speakerId":14985,"speakerName":"Mausau","textMapHash":2784004266,"text":"An onion?","nextNodeIds":[50270204]},{"nodeId":50270204,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1332458634,"text":"Someone who looks ordinary, but who can make anyone who attacks you break down and weep.","nextNodeIds":[50270205]},{"nodeId":50270205,"roleType":"TALK_ROLE_NPC","speakerId":14985,"speakerName":"Mausau","textMapHash":737866450,"text":"Really? That sounds super strong...","nextNodeIds":[50270206]},{"nodeId":50270206,"roleType":"TALK_ROLE_NPC","speakerId":1091,"speakerName":"Iansan","textMapHash":3486039682,"text":"What are those two even talking about...","nextNodeIds":[50270207]},{"nodeId":50270207,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":2085992794,"text":"Onions are super powerful. One of my friends happened to be cutting onions when I came over to his house. He began to cry, and the Saurians also began to cry, and eventually, nearly every living creature in the room was crying.","nextNodeIds":[50270208]},{"nodeId":50270208,"roleType":"TALK_ROLE_NPC","speakerId":1091,"speakerName":"Iansan","textMapHash":2592984138,"text":"What about you? Did you cry too?","nextNodeIds":[50270209]},{"nodeId":50270209,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":2077440610,"text":"I was also in the room, but I shielded my eyes with my cloak just in time. Cacucu and Ifa couldn't see my face, so they thought I cried too.","nextNodeIds":[50270210]},{"nodeId":50270210,"roleType":"TALK_ROLE_NPC","speakerId":14985,"speakerName":"Mausau","textMapHash":197243226,"text":"I'd like to become an onion-man, and make people cry too!","nextNodeIds":[50270211]},{"nodeId":50270211,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1127981146,"text":"Sure, no problem.","nextNodeIds":[50270212]},{"nodeId":50270212,"roleType":"TALK_ROLE_NPC","speakerId":1091,"speakerName":"Iansan","textMapHash":2896989346,"text":"I really want to interrupt you, but I have no clue what to say to derail this line of conversation...","nextNodeIds":[50270213]},{"nodeId":50270213,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":3461141730,"text":"Well, Iansan, you're a tiny... mushroom. Yes.","nextNodeIds":[50270214]},{"nodeId":50270214,"roleType":"TALK_ROLE_NPC","speakerId":1091,"speakerName":"Iansan","textMapHash":547867618,"text":"No one asked you!","nextNodeIds":[50270215]},{"nodeId":50270215,"roleType":"TALK_ROLE_NPC","speakerId":1091,"speakerName":"Iansan","textMapHash":3295376898,"text":"Although... mushrooms are pretty resilient, I guess... Okay, I approve.","nextNodeIds":[50270216]},{"nodeId":50270216,"roleType":"TALK_ROLE_NPC","speakerId":14985,"speakerName":"Mausau","textMapHash":226553330,"text":"Then you must be full of life too, right, Miss?","nextNodeIds":[50270217]},{"nodeId":50270217,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":3913003402,"text":"Yes she is.","nextNodeIds":[50270218]},{"nodeId":50270218,"roleType":"TALK_ROLE_NPC","speakerId":1091,"speakerName":"Iansan","textMapHash":423303882,"text":"Yeah... Sure, why not?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[3,90],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"[3_9783:-1851.636,118.884,8710.501]"},{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_ANY_MANUAL_TRANSPORT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[502701,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLB