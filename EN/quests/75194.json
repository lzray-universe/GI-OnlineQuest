"textMapHash":2385781986,"text":"Ugh, what am I gonna do? I can't even afford to hire anyone anymore... and our volcano project budget is just about drained. I need to come up with something...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7519409,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7519401"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0"],"PAINLIBBLDK":"QUEST_EXEC_EXIT_VEHICLE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7519401,"order":2,"stepDescription":"","stepDescTextMapHash":2011138492,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7519401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6459"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7519401],"talks":[{"talkId":7519401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7519401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7519401,"initDialog":751940101,"nextRandomTalks":[],"nextTalks":[],"npcId":[6459,1005],"performCfg":"QuestDialogue/WQ/Natlan_75194/Q7519401","priority":5,"questId":75194,"showRandomTalkCount":0},"dialogs":[{"nodeId":751940101,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":1217420234,"text":"Hey, hey, hey! This stuff's for selling. If you're not buying, you're not touchi— Huh... Hey, you! Yeah, you with the blonde hair — hold on a sec, don't rush off. Let me get a better look at you.","nextNodeIds":[751940102]},{"nodeId":751940102,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":4207451578,"text":"Hmm, just as I thought. That hair, glowing like the sun, and those eyes, as deep as the Night Kingdom... I can tell — no, I'm sure — that you're going to become someone incredible one day.","nextNodeIds":[751940103]},{"nodeId":751940103,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":3589076466,"text":"Here, I've got a set of wondrous jade ornaments, each containing a different melody. Perfect for a real hero like you!","nextNodeIds":[751940104]},{"nodeId":751940104,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":1867737898,"text":"Mind you, these are nothing short of priceless treasures. If anyone else wanted to buy them, I'd be asking for at least 10 million Mora. But I see you're meant to have them, so you can have them at just one-tenth of the price. What do you say?","nextNodeIds":[751940105]},{"nodeId":751940105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2482719610,"text":"Whoa, one-tenth!? That's a steal! But wait, isn't that still at least... a million Mora? That's a bit much, don't you think?","nextNodeIds":[751940106]},{"nodeId":751940106,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":1639378706,"text":"Yeah, well... this is basically cost price. Small-time sellers like me don't make a ton of profit, you know?","nextNodeIds":[751940107,751940108]},{"nodeId":751940107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1177472522,"text":"You really shouldn't be making money like that...","nextNodeIds":[751940109]},{"nodeId":751940109,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":4129646026,"text":"Ah, so you heard all that, huh? Haha, guess I've got a habit of talking to myself...","nextNodeIds":[751940110]},{"nodeId":751940110,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":27546194,"text":"*sigh* Fine, since you caught me, I'll be real with you. I found this jade ornament by accident. It's not worth anywhere near that price.","nextNodeIds":[751940111]},{"nodeId":751940111,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":1978287642,"text":"But well, as you heard, we're kinda strapped for cash — so much so that we can't even pay anyone to collect the buoy data.","nextNodeIds":[751940112]},{"nodeId":751940112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1100028066,"text":"Well, then just forget the buoy collection! Better than ripping people off, right?","nextNodeIds":[751940113]},{"nodeId":751940113,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":1801723890,"text":"That won't do... Other organizations can just stop operating if they lack the funds, but our volunteer work also includes volcano observation.","nextNodeIds":[751940114]},{"nodeId":751940114,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":3395364314,"text":"We planted those buoys to measure volcanic activity by collecting data on water temperature and the like.","nextNodeIds":[751940115]},{"nodeId":751940115,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":2664366322,"text":"With the volcano becoming more active, we need to recover those buoys fast, or there could be serious consequences.","nextNodeIds":[751940116]},{"nodeId":751940116,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":1196032474,"text":"Injured as I am, I can't break the buoys, let alone retrieve the data from them...","nextNodeIds":[751940117]},{"nodeId":751940117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3001035642,"text":"#What do you think, {NICKNAME}? Why don't we help her out? This volcano stuff affects everyone, so we can't just ignore it...","nextNodeIds":[751940118]},{"nodeId":751940118,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":3481379354,"text":"R—Really? If you're willing to help, these jade ornaments are all yours, for free! Consider it your reward. Sounds good?","nextNodeIds":[751940119,751940120]},{"nodeId":751940119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":115914562,"text":"Didn't you mention a million Mora...?","nextNodeIds":[751940121]},{"nodeId":751940121,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":1204176346,"text":"Don't worry. We haven't got much, but we certainly have more to give you than just these jade ornaments.","nextNodeIds":[751940122]},{"nodeId":751940122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4111208250,"text":"Hehe, they're enough for us! After all, we're doing this for the safety of everyone near the volcano! So don't worry, we've got this.","nextNodeIds":[751940123,751940124]},{"nodeId":751940123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2803169626,"text":"Well, let's begin, then.","nextNodeIds":[]},{"nodeId":751940124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1048251434,"text":"I'll need a moment to prepare.","nextNodeIds":[751940125]},{"nodeId":751940125,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"Kulemana","textMapHash":4270318634,"text":"I'm good to go anytime.","nextNodeIds":[]},{"nodeId":751940120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1101481202,"text":"Oh, so this is all I get for a reward, huh?","nextNodeIds":[751940121]},{"nodeId":751940108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2468512578,"text":"Weren't you the one who said that a helper's worth a million Mora?","nextNodeIds":[751940109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7519401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133515117"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6459"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7519402,"order":3,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,1],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_VAR_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6459"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7519406,7519407,7519408],"talks":[{"talkId":7519406,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participa