LE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5084"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2401901],"talks":[{"talkId":2401901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2401901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2401901,"initDialog":240190101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5084],"performCfg":"QuestDialogue/IQ/Fontaine_24019/Q2401901","priority":5,"questId":24019,"showRandomTalkCount":0},"dialogs":[{"nodeId":240190101,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":4121402122,"text":"Well, that's all the feed I got. Hope they're all full...","nextNodeIds":[240190102]},{"nodeId":240190102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3993500114,"text":"What are you up to?","nextNodeIds":[240190103]},{"nodeId":240190103,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":2969984602,"text":"I'm feeding these gulls. See, they've almost had their fill.","nextNodeIds":[240190104]},{"nodeId":240190104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1933181850,"text":"Whoa... When did you and them grow so close?","nextNodeIds":[240190105]},{"nodeId":240190105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2402584770,"text":"They didn't steal your fries?","nextNodeIds":[240190106]},{"nodeId":240190106,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":1376083834,"text":"No. It seems that people specifically come here to feed the gulls, so they've no interest in my fries.","nextNodeIds":[240190107]},{"nodeId":240190107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1657834306,"text":"But didn't you say that if you got too far from your workplace, you might miss work?","nextNodeIds":[240190108]},{"nodeId":240190108,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":2598165698,"text":"Hahaha, it's alright. Today's my day off.","nextNodeIds":[240190109]},{"nodeId":240190109,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":3262989010,"text":"No colleagues here to drag me into work-related chat, and no one or animal to steal my fries... Yes, this is a most suitable place.","nextNodeIds":[240190110]},{"nodeId":240190110,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":4227400266,"text":"The gulls are a friendly lot. They won't steal my fries, nor will they come charging into me to cause a riot.","nextNodeIds":[240190111]},{"nodeId":240190111,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":365197226,"text":"Ever since I fed them personally a few times, they seem to recognize me. They don't seem to resist even when I touch their feathers.","nextNodeIds":[240190112]},{"nodeId":240190112,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":2838085266,"text":"I'd go so far as to call them perfect gentlemen compared to the ilk at the Palais Mermonia.","nextNodeIds":[240190113]},{"nodeId":240190113,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":2062468714,"text":"If they could use their talons to write using typewriters, why, they'd nearly put us out of work.","nextNodeIds":[240190114,240190116]},{"nodeId":240190114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1702729714,"text":"Violetgold Angler Gulls won't help with human business.","nextNodeIds":[240190115]},{"nodeId":240190115,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":816909850,"text":"But at least they don't make things worse, either. And everyone knows that some things are simply too hard for them.","nextNodeIds":[240190118]},{"nodeId":240190118,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":2650220282,"text":"But let's leave that aside first. Would you like to try making friends with these gentle-gulls?","nextNodeIds":[240190119]},{"nodeId":240190119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":12331434,"text":"Whew, they're already gentle-birdies in your eyes, huh...","nextNodeIds":[240190120,240190122]},{"nodeId":240190120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1353301578,"text":"Would it be rude of me to just go up to them?","nextNodeIds":[240190121]},{"nodeId":240190121,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":672728122,"text":"No, they are a tolerant sort. As long as you don't ruffle their feathers, you'll be fine.","nextNodeIds":[240190124]},{"nodeId":240190124,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":222403362,"text":"Come, let me give you this fish I've specially processed. Just take it and put it in that bowl over there.","nextNodeIds":[240190125]},{"nodeId":240190125,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":2096117706,"text":"Just relax. Violetgold Angler Gulls are a tolerant lot. They like whoever feeds them, and they ask no questions about where you got your fish or how it was made.","nextNodeIds":[]},{"nodeId":240190122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3039969618,"text":"Is there anything I need to look out for when befriending them?","nextNodeIds":[240190123]},{"nodeId":240190123,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":3490044642,"text":"Not much, not really. Just don't attempt to ruffle their feathers directly.","nextNodeIds":[240190124]},{"nodeId":240190116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1297421642,"text":"Violetgold Angler Gulls don't speak our language.","nextNodeIds":[240190117]},{"nodeId":240190117,"roleType":"TALK_ROLE_NPC","speakerId":5084,"speakerName":"Iaune","textMapHash":1396808618,"text":"I wouldn't be so sure. Perhaps they simply pretend so that they may live more comfortable lives.","nextNodeIds":[240190118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2401901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCE