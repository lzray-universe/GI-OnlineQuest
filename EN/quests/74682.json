DuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7468201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468201,"initDialog":746820101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30551],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_74682/Q7468201","priority":5,"questId":74682,"showRandomTalkCount":0},"dialogs":[{"nodeId":746820101,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":868130290,"text":"So we're here in the end...","nextNodeIds":[746820102]},{"nodeId":746820102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2603661170,"text":"What about your childhood dream?","nextNodeIds":[746820103]},{"nodeId":746820103,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":2502148290,"text":"When I became an adult, I finally understood why the Forest Watchers had made those faces they did...","nextNodeIds":[746820104]},{"nodeId":746820104,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":2520063978,"text":"*cough* But anyway, I gave it my best shot.","nextNodeIds":[746820105]},{"nodeId":746820105,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":1849200050,"text":"I also learned that you should never bring unprocessed Pyro Regisvine fruit near a Jadeplume Terrorshroom...","nextNodeIds":[746820106]},{"nodeId":746820106,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":3518266858,"text":"By the time I smelled something burning, it was already too late. Barely avoided drowning in the spores it poured forth.","nextNodeIds":[746820107]},{"nodeId":746820107,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":3257629514,"text":"It's easy to forget, sometimes, that Fungi are a completely different species from Shroomboars.","nextNodeIds":[746820108]},{"nodeId":746820108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3228044570,"text":"Anyway, speaking of which, they actually are a type of fungus, right?","nextNodeIds":[746820109]},{"nodeId":746820109,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":3981775570,"text":"That's right, and they taste especially delicious in soups.","nextNodeIds":[746820110]},{"nodeId":746820110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":651554330,"text":"But anyway, let's get back to today's challenge.","nextNodeIds":[746820111]},{"nodeId":746820111,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":3434755498,"text":"Well, I haven't figured out what to cook ye... Oh! Right, uh, you mean the \"negotiations.\" Sorry.","nextNodeIds":[746820112]},{"nodeId":746820112,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":3293838482,"text":"Perhaps you've heard the story of the two Fontemer Aberrant overlords? It speaks of how the Millennial Pearl Seahorse is described as being \"proud\" and \"noble.\"","nextNodeIds":[746820113]},{"nodeId":746820113,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":826122090,"text":"By contrast, the Emperor of Fire and Iron seems to be a fierce, cruel being, strong but brutal.","nextNodeIds":[746820114]},{"nodeId":746820114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":463229306,"text":"And here Paimon thought you'd pick the tougher opponent. After all, wouldn't a stronger opponent make for a cooler story?","nextNodeIds":[746820115]},{"nodeId":746820115,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":2547332850,"text":"That is true, but the Emperor is a heavily-armored crab... While the other party's a seahorse that flies!","nextNodeIds":[746820116,746820118]},{"nodeId":746820116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2851719770,"text":"I wonder, would you call a flying seahorse a Pegasus instead?","nextNodeIds":[746820117]},{"nodeId":746820117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3479125602,"text":"Wait, is that the question we should be asking right now?","nextNodeIds":[746820119]},{"nodeId":746820119,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":2148320618,"text":"Still, if I could only ride it, even once...","nextNodeIds":[746820120]},{"nodeId":746820120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1224035314,"text":"Well, sure then. Looks like you're sticking this one out to the end.","nextNodeIds":[746820121]},{"nodeId":746820121,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":4017276762,"text":"Well, we are here, aren't we? Surely we can't leave empty-handed? Anyway, let's head out once you're ready.","nextNodeIds":[746820122,746820123]},{"nodeId":746820122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3131991698,"text":"I'm ready.","nextNodeIds":[]},{"nodeId":746820123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":930747978,"text":"I've got other things to handle. See you in a bit.","nextNodeIds":[746820124]},{"nodeId":746820124,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","textMapHash":3565268042,"text":"No worries. I'll wait for you here.","nextNodeIds":[]},{"nodeId":746820118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1805984954,"text":"Makes no difference to me...","nextNodeIds":[746820119]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30551"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"Ranjit","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174682],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2451815366,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/EffigyChallenge_V5_74682/Q7468201","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC