{"mainQuestId":71528,"title":"Provisionally Perpetual Beetle Battle!","description":"After having gone through the Arataki Blazing Armor Beetle Battle Boot Camp, Arataki Itto seems to have realized that the strength of Onikabuto is ultimately limited, and a bold new plan is hatched within his mind...","titleTextMapHash":1608931031,"descTextMapHash":3630935926,"mainQuestExcel":{"mainQuestId":71528,"titleTextMapHash":1608931031,"title":"Provisionally Perpetual Beetle Battle!","descTextMapHash":3630935926,"description":"After having gone through the Arataki Blazing Armor Beetle Battle Boot Camp, Arataki Itto seems to have realized that the strength of Onikabuto is ultimately limited, and a bold new plan is hatched within his mind...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":5173,"luaPath":"Actor/Quest/WQ71528","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5173,"chapterId":0,"descTextMapHash":3630935926,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71528,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3483673297,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71528","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171528],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1608931031,"type":"WQ","unlockDescTextMapHash":545855134}},"flow":[{"subQuestId":7152801,"order":1,"stepDescription":"Fight Calamitous Colossus Count Crushmore","stepDescTextMapHash":3407094132,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166660,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30470"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166660],"talks":[{"talkId":7166660,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["5173","5173008","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["7152801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166660,"initDialog":716666001,"nextRandomTalks":[],"nextTalks":[],"npcId":[30470],"performCfg":"QuestDialogue/WQ/ElectroherculesBattleV2_71666/Q7166660","priority":5,"questId":71528,"showRandomTalkCount":0},"dialogs":[{"nodeId":716666001,"roleType":"TALK_ROLE_NPC","speakerId":30469,"speakerName":"Count Crushmore's Companion God of Cookery","textMapHash":2462272034,"text":"Hey! Good to see everyone! How's it going? Having fun?","nextNodeIds":[716666002]},{"nodeId":716666002,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1661982402,"text":"Xiangling, Guoba! You finally made it! Well, Bull-Chuc{RUBY#[S]\"Bona-Fide Beetle Battle King\"}ker's certainly having a blast.","nextNodeIds":[716666003]},{"nodeId":716666003,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4124360914,"text":"The day has finally come!","nextNodeIds":[716666004]},{"nodeId":716666004,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1228581194,"text":"Guoba-san! I've been training hard at the Arataki Blazing Armor Beetle Battle Boot Camp, and now I wanna show you just how far I've come! ...Uh, and Crimson Staff too!","nextNodeIds":[716666005]},{"nodeId":716666005,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":270545418,"text":"If my progress satisfies you, then please, teach me! Show me the way to communicate with Crimson Staff, Crystal Tornado, and all the shelled organisms of this world!","nextNodeIds":[716666006]},{"nodeId":716666006,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3836052482,"text":"Do that, and I swear, once I become the reigning champion of the beetle-fighting world, I will build a mighty statue in your image at the Arataki Gang's beetle-fighting headquarters!","nextNodeIds":[716666007]},{"nodeId":716666007,"roleType":"TALK_ROLE_NPC","speakerId":30470,"speakerName":"Calamitous Colossus Count Crushmore","textMapHash":1945013170,"text":"♪~","nextNodeIds":[716666008]},{"nodeId":716666008,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4021172178,"text":"What the...! Guoba-san got a brand new Onikabuto?","nextNodeIds":[716666009]},{"nodeId":716666009,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2368626922,"text":"That does not look normal!","nextNodeIds":[716666010]},{"nodeId":716666010,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":1579209226,"text":"It appears to be not a typical Onikabuto shell, but one built of resilient wood... Is it wearing a suit of armor?","nextNodeIds":[716666011]},{"nodeId":716666011,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"Yanfei","textMapHash":1690131146,"text":"We told Granny all about your Onikabuto boot camp. It really piqued her interest when she heard that Guoba was getting a disciple...","nextNodeIds":[716666012]},{"nodeId":716666012,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"Yanfei","textMapHash":2285872594,"text":"As it turned out, a friend of hers had made her a whole bunch of gardening and landscaping machines to look after the Silk Flowers on the terrace. They're called Bloom Pruners.","nextNodeIds":[716666013]},{"nodeId":716666013,"roleType":"TALK_ROLE_NPC","speakerId":30469,"speakerName":"Count Crushmore's Companion God of Cookery","textMapHash":3933131370,"text":"The Bloom Pruner can transform into the shape of any creature to blend into its environment. Squirrels, Butterflies, Finches, you name it. And of course, Onikabuto too.","nextNodeIds":[716666014]},{"nodeId":716666014,"roleType":"TALK_ROLE_NPC","speakerId":30469,"speakerName":"Count Crushmore's Companion God of Cookery","textMapHash":3612125570,"text":"So Master gave Guoba a Bloom Pruner and got it to take the form of an Onikabuto so it can battle against you.","nextNodeIds":[716666015]},{"nodeId":716666015,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":344853634,"text":"...That's pretty hi-tech for a gardening appliance.","nextNodeIds":[716666016]},{"nodeId":716666016,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2496317378,"text":"Xiangling's master is Madame Ping, so Madame Ping's friend... Aha! Of course!","nextNodeIds":[716666017,716666018]},{"nodeId":716666017,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3313299690,"text":"Remind me who that is again?","nextNodeIds":[716666019]},{"nodeId":716666019,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1453464298,"text":"No machine can compare to a real, live Onikabuto warrior! Did Guoba-san pick a dumbed-down enemy on purpose so we can showcase all our awesome skills?","nextNodeIds":[716666020]},{"nodeId":716666020,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":42835042,"text":"You may be wise to temper your optimism, Oni King... My beetle senses are failing to detect this Onikabuto's might. Or perhaps... it's too profound for me to fathom.","nextNodeIds":[716666021]},{"nodeId":716666021,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2811851674,"text":"Eh, it's not even alive. There's nothing for you to sense.","nextNodeIds":[716666022]},{"nodeId":716666022,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":653356290,"text":"Uhh anyway, Guoba-san may possess limitless power, but a warrior needs to be one with his weapon. The bond between Onikabuto and trainer is forged through blood, sweat, and tears, not wood, mesh, and gears! Crimson Staff and I are like glove and fist.","nextNodeIds":[716666023]},{"nodeId":716666023,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4206847762,"text":"Let's get this duel going. It's time for Guoba-san to witness my true potential once and for all!","nextNodeIds":[716666024]},{"nodeId":716666024,"roleType":"TALK_ROLE_NPC","speakerId":30470,"speakerName":"Calamitous Colossus Count Crushmore","textMapHash":2402237930,"text":"♪...","nextNodeIds":[]},{"nodeId":716666018,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1911752594,"text":"Zip it! Don't spoil it!","nextNodeIds":[716666019]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166660,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30470"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7152802,"order":2,"stepDescription":"Fight Calamitous Colossus Count Crushmore","stepDescTextMapHash":3461095476,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152803,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30470"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","P