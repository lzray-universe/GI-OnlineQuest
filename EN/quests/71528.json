Talk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7152803","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7152801,"initDialog":715280101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1044,1043,1030,1012,1049],"performCfg":"QuestDialogue/WQ/ElectroherculesBattleV2_71528/Q7152801","priority":5,"questId":71528,"showRandomTalkCount":0},"dialogs":[{"nodeId":715280101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2394828490,"text":"Whoa! Bull-Chu{RUBY#[S]\"Bona-Fide Beetle Battle King\"}cker sure made short work of the Bloom Pruner!","nextNodeIds":[715280102]},{"nodeId":715280102,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2664589610,"text":"I won! Victory is mine! With my trusty Crimson Staff, I have defeated the mighty Guoba{RUBY#[S]\"Calamitous Colossus Count Crushmore\"}-san!","nextNodeIds":[715280103]},{"nodeId":715280103,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2250807178,"text":"Alrighty then... Hoo-hoo, the moment I've been waiting for!","nextNodeIds":[715280104]},{"nodeId":715280104,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2630433554,"text":"Ahem... Guoba-san, if I have earned your recognition, I humbly ask you to teach me the ways of shelled-organism communication...","nextNodeIds":[715280105]},{"nodeId":715280105,"roleType":"TALK_ROLE_NPC","speakerId":1043,"speakerName":"Guoba","textMapHash":4280930978,"text":"♪~","nextNodeIds":[715280106]},{"nodeId":715280106,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":420093202,"text":"...Huh? Guoba-san, you look... pleased? But you just lost to me in battle...","nextNodeIds":[715280107]},{"nodeId":715280107,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3272250890,"text":"Does this mean you're... proud of me for my swift progress?","nextNodeIds":[715280108]},{"nodeId":715280108,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1706398626,"text":"Aw, shucks, I dunno what to say! Hahahahaha, you're too kind, Guoba-san! ...Ah, you're just being modest, I know you were going easy on me...","nextNodeIds":[715280109]},{"nodeId":715280109,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"Yanfei","textMapHash":3502631042,"text":"It looks like Guoba's all warmed up now. The Bloom Pruner is ready to operate at full power.","nextNodeIds":[715280110]},{"nodeId":715280110,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2625306346,"text":"Guoba, remember the plan? In this round, we wanna increase the Bloom Pruner's power output from a tenth of a percent to one percent, okay?","nextNodeIds":[715280111]},{"nodeId":715280111,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":712428386,"text":"Any higher, and you'll risk knocking Itto's Onikabuto out cold.","nextNodeIds":[715280112]},{"nodeId":715280112,"roleType":"TALK_ROLE_NPC","speakerId":1043,"speakerName":"Guoba","textMapHash":1862262602,"text":"♪!","nextNodeIds":[715280113]},{"nodeId":715280113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2753014794,"text":"Okay, there it is. Paimon knew something was up.","nextNodeIds":[715280114,715280115]},{"nodeId":715280114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2072112642,"text":"What? A tenth of a percent!?","nextNodeIds":[715280116]},{"nodeId":715280116,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":356740562,"text":"As I feared... We've barely scratched the surface...","nextNodeIds":[715280117]},{"nodeId":715280117,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3678680114,"text":"Wait! Hold on a minute!","nextNodeIds":[715280118]},{"nodeId":715280118,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1486106290,"text":"A tenth of one percent? As in... zero-point-one percent? As in... one one-thousandth!?","nextNodeIds":[715280119]},{"nodeId":715280119,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2852231946,"text":"You've got... You've gotta be kidding me! All that... was just one ONE-THOUSANDTH of its top power?","nextNodeIds":[715280120]},{"nodeId":715280120,"roleType":"TALK_ROLE_NPC","speakerId":1043,"speakerName":"Guoba","textMapHash":2110093018,"text":"♪?","nextNodeIds":[715280121]},{"nodeId":715280121,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"Yanfei","textMapHash":1910869650,"text":"Guoba's a little confused. You did say you wanted to train your Onikabuto to defeat Crystal Tornado, correct?","nextNodeIds":[715280122]},{"nodeId":715280122,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1542303642,"text":"I thought it would go without saying given the size... The Bloom Pruner has to shift rocks the size of casserole dishes, so obviously it has to be pretty strong.","nextNodeIds":[715280123]},{"nodeId":715280123,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":616025602,"text":"Even then, Crystal Tornado is bigger still... It dwarfs me and Guoba, and it's even taller than you!","nextNodeIds":[715280124]},{"nodeId":715280124,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2763709970,"text":"That's impossible... If we were talking twice as strong as the last fight, I think I'd have a shot. Ten times as strong, and we're already looking at losing most, if not all, of the time...","nextNodeIds":[715280125]},{"nodeId":715280125,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":650640210,"text":"But a thousand times stronger? Who am I kidding... It's hopeless!","nextNodeIds":[715280126]},{"nodeId":715280126,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":172456378,"text":"...","nextNodeIds":[715280127]},{"nodeId":715280127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3025936434,"text":"\"When your tactics fail, you have to change your point of view. In our journeys far and wide, we often have to think on our feet!\"","nextNodeIds":[715280128]},{"nodeId":715280128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2728163234,"text":"\"Clinging to old methods can never solve the problem, no matter how hard you try!\"","nextNodeIds":[715280129]},{"nodeId":715280129,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4097685210,"text":"...Of course, Guoba-san! This is what you've been trying to tell me all along!","nextNodeIds":[715280130]},{"nodeId":715280130,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1210302178,"text":"I gotta study mechanics! Then build a suit of armor for Crimson Staff that'll take his abilities to a whole new level!","nextNodeIds":[715280131]},{"nodeId":715280131,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1328617074,"text":"Or maybe... Heck, I could build a bigger, stronger, mechanical Onikabuto! Piloted by Crimson Staff under my direction!","nextNodeIds":[715280132]},{"nodeId":715280132,"roleType":"TALK_ROLE_NPC","speakerId":1043,"speakerName":"Guoba","textMapHash":101464634,"text":"!?","nextNodeIds":[715280133]},{"nodeId":715280133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2597373826,"text":"An Onikabuto piloting a mechanical Onikabuto? How do you expect to pull that off? And does that even still count as a beetle battle?","nextNodeIds":[715280134,715280135]},{"nodeId":715280134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3603724970,"text":"Dare to dream!","nextNodeIds":[715280136]},{"nodeId":715280136,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":443952394,"text":"Seeing the power of Bloom Pruner has made me realize something... There's a natural limit to Onikabuto's strength.","nextNodeIds":[715280137]},{"nodeId":715280137,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4094206354,"text":"People have tried to tell me this before. Shinobu, the grandmaster... especially Skycleaving White-Iron Lavender Melon. Admitting defeat is shameful, but not even trying to mix up your tactics one time — that's just plain stupid!","nextNodeIds":[715280138]},{"nodeId":715280138,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4086125626,"text":"Guoba-san has shown me a new path: Mechanically modified Onikabuto!","nextNodeIds":[715280139]},{"nodeId":715280139,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3573327762,"text":"With this new technique in my arsenal, size will be no obstacle to me and my valiant beetle warriors as we set out to beat Crystal Tornado once and for all!","nextNodeIds":[715280140]},{"nodeId":715280140,"roleType":"TALK_ROLE_NPC","speakerId":1043,"speakerName":"Guoba","textMapHash":1749575138,"text":"♪♪?","nextNodeIds":[715280141]},{"nodeId":715280141,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"Yanfei","textMapHash":307062130,"text":"Heh... Looks like Guoba's not too sure about all that...","nextNodeIds":[715280142]},{"nodeId":715280142,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":620452794,"text":"Mechanics, huh? Hmm, I'd have to get my master to see if her friend would be willing to help. She's the expert...","nextNodeIds":[715280143]},{"nodeId":715280143,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2015088490,"text":"Did you say expert!? Please, Guoba-san, Chef-sama, my savior! Introduce me!","nextNodeIds":[715280144]},{"nodeId":715280144,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":843096498,"text":"Uh-huh...?","nextNodeIds":[715280145]},{"nodeId":715280145,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":3200813778,"text":"Thinking of becoming the second Arataki Gang member to study in Liyue are you, Boss?","nextNodeIds":[715280146]},{"nodeId":715280146,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1927054890,"text":"Shinobu!? When'd you get back?","nextNodeIds":[715280147]},{"nodeId":715280147,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":1750836922,"text":"Time's up. We spent our last Mora on these boat tickets, and if we don't get to the harbor pronto, they'll go to waste.","nextNodeIds":[715280148]},{"nodeId":715280148,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4059437842,"text":"But, but, but... Gimme a minute, okay? We're in the middle of an extremely important discussion here!","nextNodeIds":[715280149]},{"nodeId":715280149,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":950710370,"text":"Yeah, I heard.","nextNodeIds":[715280150]},{"nodeId":715280150,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":796116234,"text":"I was actually very pleased to hear the suggestion of you doing some sort of studying coming out of your own mouth. I have some relevant experience, so I can write a little booklet to get you started.","nextNodeIds":[715280151]},{"nodeId":715280151,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":1859027378,"text":"But unfortunately, studying in Liyue is very expensive. The Arataki Gang's typical expenditures are a drop in the ocean by comparison. So what do you intend to do about it?","nextNodeIds":[715280152]},{"nodeId":715280152,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3439626898,"text":"It'll be fine! I'll just, uhhhh... I'll work like a horse when I get back to Inazuma!","nextNodeIds":[715280153]},{"nodeId":715280153,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2849477154,"text":"I know what I'm getting into here, alright? I got it all planned out in my head. It's not like I've never gotten paid work before. Soon as I get earnin', we'll all have cash for the burnin', haha!","nextNodeIds":[715280154]},{"nodeId":715280154,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3333634794,"text":"And don't think for one second I'll be abandoning you or the rest of the Arataki Gang neither! I ain't the kind of head honcho that runs off to go study and leaves his gang behind!","nextNodeIds":[715280155]},{"nodeId":715280155,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4167654290,"text":"If we're gonna study, we do it as a team! Once I've got enough Mora for everyone's tuition fees, the whole Arataki Gang is coming to Liyue! We'll study together, learn some epic new skills together, and come out the other side as the stronger, smarter Invincible Arataki Gang!","nextNodeIds":[715280156]},{"nodeId":715280156,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":4069426330,"text":"You're saying all of the right things... Who are you, and what have you done with Boss?","nextNodeIds":[715280157]},{"nodeId":715280157,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1387731346,"text":"Wow, Bull-Chu{RUBY#[S]\"Bona-Fide Beetle Battle King\"}cker! Those were some bold words. You'd better make sure you follow through!","nextNodeIds":[715280158,715280159]},{"nodeId":715280158,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1571822778,"text":"Arataki Itto is a man of his word!","nextNodeIds":[715280160]},{"nodeId":715280160,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4228203378,"text":"Hehehe! Of course I, uh, still need to iron out some deets in terms of what kind of work I can get and how much I can rake in per day...","nextNodeIds":[715280161]},{"nodeId":715280161,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":482347850,"text":"In that case, Oni King... I'll stay here in Liyue. Firstly, this will enable me to follow up with Chef-sama and discuss our study plans in detail.","nextNodeIds":[715280162]},{"nodeId":715280162,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":3299021306,"text":"Secondly, now that word of the Arataki Blazing Armor Beetle Battle Boot Camp has begun to spread, I'll be able to scout for talented warriors and continue optimizing the Onikabuto training diet.","nextNodeIds":[715280163]},{"nodeId":715280163,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":1922512058,"text":"Also, if the Oni King's Right Hand and Skycleaving White-Iron Lavender Melon wish to continue battling, or analyze the battles so far, I'll be here to support them.","nextNodeIds":[715280164]},{"nodeId":715280164,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3133735346,"text":"Awesome! Good thinking, grandmaster!","nextNodeIds":[715280165]},{"nodeId":715280165,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3384107882,"text":"Okay, standard procedure applies — I'll let your grandpops know what you're up to so he won't worry about you.","nextNodeIds":[715280166]},{"nodeId":715280166,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2620194338,"text":"Hoo-hoo, man, I am so pumped to see what you'll have for us next time I see you!","nextNodeIds":[715280167]},{"nodeId":715280167,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1914891154,"text":"I do need to make one thing clear, though. I can't promise that we'll be able to talk an adeptus into taking you on as students. Yanfei and I will do our best, but we'll just have to see how it goes.","nextNodeIds":[715280168]},{"nodeId":715280168,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":3085314786,"text":"The great master of whom you speak boasts a skill others can only dream of — their pride and prestige don't faze us! The important thing is that I, on behalf of the Oni King and the Arataki Gang, can find a way to show them we're serious and sincere in our quest to master the mechanical arts...","nextNodeIds":[715280169]},{"nodeId":715280169,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":4205776858,"text":"So I'll need to do some research to find out what kind of gift we should offer if we are to be seen as worthy of learning the mysteries behind the manufacture of the Bloom Pruner.","nextNodeIds":[715280170]},{"nodeId":715280170,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":862471418,"text":"Boss, we gotta leave right now, or we're not gonna make it in time.","nextNodeIds":[715280171]},{"nodeId":715280171,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2717841226,"text":"*sigh* Alright, I guess this is it...","nextNodeIds":[715280172]},{"nodeId":715280172,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":986722234,"text":"#{NICKNAME}, Paimon, Yanfei senpai, Miss Xiangling, Guoba... You've all been a huge help to Boss with this beetle battle event. I really can't thank you enough...","nextNodeIds":[715280173]},{"nodeId":715280173,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":4055433242,"text":"Please take this as a token of my gratitude. I hope you can find some use for it in your future endeavors.","nextNodeIds":[715280174]},{"nodeId":715280174,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2997405082,"text":"Wow, you got us a gift! ...Thanks, Shinobu. You're so thoughtful!","nextNodeIds":[715280175,715280176]},{"nodeId":715280175,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3069207378,"text":"Woohoo!","nextNodeIds":[715280177]},{"nodeId":715280177,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3199158474,"text":"The time has come... Adios, compadre. See ya, Skycleaving White-Iron Lavender Melon. Goodbye, Guoba-san and Chef-sama... and farewell, my savior!","nextNodeIds":[715280178]},{"nodeId":715280178,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1911953378,"text":"I'll be back real soon, I promise! We'll meet again!","nextNodeIds":[715280179]},{"nodeId":715280179,"roleType":"TALK_ROLE_NPC","speakerId":1043,"speakerName":"Guoba","textMapHash":1061911090,"text":"♪♫♩♪♬~","nextNodeIds":[715280180]},{"nodeId":715280180,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1527695882,"text":"Don't make promises you can't keep, Bull-Chu{RUBY#[S]\"Bona-Fide Beetle Battle King\"}cker!","nextNodeIds":[715280181]},{"nodeId":715280181,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2132560338,"text":"It's good to have ambitions, but don't let yourself get carried away in the heat of the moment. Do what Shinobu tells you, be realistic about what you can achieve, and make sure you pace yourself!","nextNodeIds":[715280182]},{"nodeId":715280182,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1972861354,"text":"...But of course, if everything works out, Paimon can't wait to see Crimson Staff driving a GINORMOUS mechanical Onikabuto the next time we meet!","nextNodeIds":[715280183]},{"nodeId":715280183,"roleType":"TALK_ROLE_NPC","speakerId":13852,"speakerName":"\"Crystal Tornado\"","textMapHash":931459826,"text":"...","nextNodeIds":[715280184]},{"nodeId":715280184,"roleType":"TALK_ROLE_NPC","speakerId":13852,"speakerName":"\"Crystal Tornado\"","textMapHash":3011337066,"text":"?","nextNodeIds":[]},{"nodeId":715280176,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1449138418,"text":"Freebies for the win!","nextNodeIds":[715280177]},{"nodeId":715280159,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3327784058,"text":"Don't rely on someone else when you can do it yourself!","nextNodeIds":[715280160]},{"nodeId":715280135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3977159018,"text":"I believe in Itto!","nextNodeIds":[715280136]},{"nodeId":715280115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1111127330,"text":"That's nothing!","nextNodeIds":[715280116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHL