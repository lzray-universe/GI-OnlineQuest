_NPC"},"isHidden":false,"talkIds":[1100304,1100396,1100397],"talks":[{"talkId":1100304,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100304","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["108021","1",""],"type":"QUEST_COND_PACK_HAVE_ITEM"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100304,"initDialog":110030401,"nextRandomTalks":[],"nextTalks":[],"npcId":[163001],"performCfg":"QuestDialogue/LQ/Xiangling1_11003/Q1100304","priority":5,"questId":11003,"showRandomTalkCount":0},"dialogs":[{"nodeId":110030401,"roleType":"TALK_ROLE_NPC","speakerId":163001,"speakerName":"Olaf","textMapHash":3615288262,"text":"Mmm... That is better... That is better...","nextNodeIds":[110030402]},{"nodeId":110030402,"roleType":"TALK_ROLE_NPC","speakerId":163001,"speakerName":"Olaf","textMapHash":2100605566,"text":"Thank you. That soup really did the trick.","nextNodeIds":[110030403]},{"nodeId":110030403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3199465710,"text":"What happened, did you get frozen?","nextNodeIds":[110030404]},{"nodeId":110030404,"roleType":"TALK_ROLE_NPC","speakerId":163001,"speakerName":"Olaf","textMapHash":221878270,"text":"Yes. I was chasing a boar, and after chasing him all this way he slipped into those underground ruins over there.","nextNodeIds":[110030405]},{"nodeId":110030405,"roleType":"TALK_ROLE_NPC","speakerId":163001,"speakerName":"Olaf","textMapHash":44585662,"text":"I followed him inside, but ran into a Cryo Regisvine.","nextNodeIds":[110030406]},{"nodeId":110030406,"roleType":"TALK_ROLE_NPC","speakerId":163001,"speakerName":"Olaf","textMapHash":683696670,"text":"It froze me instantly. When I woke up I ran straight outside, but... I only made it this far before my strength failed me.","nextNodeIds":[110030407]},{"nodeId":110030407,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2471052030,"text":"Cryo Regisvine? Vines... attack people?","nextNodeIds":[110030408]},{"nodeId":110030408,"roleType":"TALK_ROLE_NPC","speakerId":163001,"speakerName":"Olaf","textMapHash":3436708630,"text":"They do now! I'd heard of them before from others, but this was the first time seeing one with my own eyes.","nextNodeIds":[110030409]},{"nodeId":110030409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1355498046,"text":"Yikes, we should definitely keep our distance from the ruins... It sounds dangerous.","nextNodeIds":[110030410]},{"nodeId":110030410,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1461811158,"text":"It sounds delicious!","nextNodeIds":[110030411,110030412]},{"nodeId":110030411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2112891342,"text":"...Seriously?","nextNodeIds":[110030413]},{"nodeId":110030413,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1585706886,"text":"That's it! The missing ingredient! The icing on the cake!","nextNodeIds":[110030414]},{"nodeId":110030414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3999297902,"text":"Calm down. Can we really eat a tree that's that aggressive?","nextNodeIds":[110030415]},{"nodeId":110030415,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3848935742,"text":"Only one way to find out — let's go!","nextNodeIds":[110030416]},{"nodeId":110030416,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2774219062,"text":"*sigh* Off she goes again...","nextNodeIds":[110030417,110030418]},{"nodeId":110030417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1536685846,"text":"We need to go.","nextNodeIds":[110030419]},{"nodeId":110030419,"roleType":"TALK_ROLE_NPC","speakerId":163001,"speakerName":"Olaf","textMapHash":955994998,"text":"Do not worry about me, I'll be fine. But you must stop her, she is putting herself in grave danger.","nextNodeIds":[]},{"nodeId":110030418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2427798430,"text":"You should get back to Springvale.","nextNodeIds":[110030419]},{"nodeId":110030412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1422811990,"text":"Does anything NOT make you think about food?","nextNodeIds":[110030413]}]},{"talkId":1100396,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100304","2"],"type":"QUEST_CO