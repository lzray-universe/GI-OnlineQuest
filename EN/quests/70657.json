","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7065701,"initDialog":706570101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30046],"performCfg":"","priority":5,"questId":70657,"showRandomTalkCount":0},"dialogs":[{"nodeId":706570101,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":3189100354,"text":"Hello, I'm Lizzie of the Knights of Favonius. I'm sure you've heard this already, but Mondstadt holds all kinds of fun activities during the Windblume Festival!","nextNodeIds":[706570102,706570103]},{"nodeId":706570102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":617666666,"text":"Rings a bell...","nextNodeIds":[706570104]},{"nodeId":706570104,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":1121765218,"text":"I'm in charge of receiving all guests coming to Mondstadt in order to assure that everyone can get the most fun out of this festival!","nextNodeIds":[706570105]},{"nodeId":706570105,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":1302925298,"text":"Because some festival events take place outside of the city walls, someone needs to introduce all the available activities to the visitors. It'd be a shame if they missed the abundance of wonderful games that we've prepared.","nextNodeIds":[706570106]},{"nodeId":706570106,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":3099813194,"text":"Now, allow me to wholeheartedly recommend our \"Bullseye Balloons\"!","nextNodeIds":[706570107]},{"nodeId":706570107,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":3138260442,"text":"The name itself is pretty self-explanatory, isn't it? Shoot the targets as quickly and as accurately as you can to reach a high score.","nextNodeIds":[706570108,706570109]},{"nodeId":706570108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":497960066,"text":"Sounds enticing.","nextNodeIds":[706570110]},{"nodeId":706570110,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":2705060066,"text":"No worries, let me mark the location for you. You won't know unless you try it yourself.","nextNodeIds":[706570111]},{"nodeId":706570111,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":3156444266,"text":"Besides, based on your score, you can win valuable rewards! No matter if you are a casual player or a perfectionist, it's fun all the same!","nextNodeIds":[706570112,706570113]},{"nodeId":706570112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":817369386,"text":"I wouldn't say no to that.","nextNodeIds":[706570114]},{"nodeId":706570114,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":1015869906,"text":"Sure, you should definitely try it! If you want to learn more about other fun events, come find me!","nextNodeIds":[706570115]},{"nodeId":706570115,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":443185314,"text":"Have fun!","nextNodeIds":[]},{"nodeId":706570113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1065617114,"text":"Thank you for your explanation.","nextNodeIds":[706570114]},{"nodeId":706570109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":735261434,"text":"Sounds quite challenging.","nextNodeIds":[706570110]},{"nodeId":706570103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2470262370,"text":"First I've heard of it.","nextNodeIds":[706570104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7065701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[