":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7216302,"initDialog":721630201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3005],"performCfg":"","priority":9,"questId":72163,"showRandomTalkCount":0},"dialogs":[{"nodeId":721630201,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":3626535754,"text":"Hmm, this is quite the headache...","nextNodeIds":[721630202]},{"nodeId":721630202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2903238122,"text":"Would you know anything about this map...","nextNodeIds":[721630203]},{"nodeId":721630203,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":137061378,"text":"Judging by the topography, I'd say that this is some place on Seirai Island...","nextNodeIds":[721630204]},{"nodeId":721630204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2105937282,"text":"How could you tell?","nextNodeIds":[721630205]},{"nodeId":721630205,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":2571980410,"text":"The Guild has commissioned several expeditions to Seirai Island in the past.","nextNodeIds":[721630206]},{"nodeId":721630206,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":1314460058,"text":"The adventurers who accepted those commissions would bring us intel on the island in the form of reports.","nextNodeIds":[721630207]},{"nodeId":721630207,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":4010086898,"text":"Unfortunately, manpower issues have prevented us from launching large-scale expeditions, so we're stuck sending a few adventurers at a time to explore the area.","nextNodeIds":[721630208]},{"nodeId":721630208,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":1702623634,"text":"I'm afraid that this limits the extent to which I can continue helping you to analyze this map.","nextNodeIds":[721630209]},{"nodeId":721630209,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":1611449530,"text":"However, I do know someone who might have more to do with Seirai Island than me.","nextNodeIds":[721630210]},{"nodeId":721630210,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":894025450,"text":"His name's Oda Tarou. I've heard that his ancestors used to live on Seirai Island before migrating here for various reasons.","nextNodeIds":[721630211]},{"nodeId":721630211,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":558606474,"text":"Speaking of which, he did come to the Guild some time back to hire some adventurers who would accompany him to Seirai Island to see the place...","nextNodeIds":[721630212]},{"nodeId":721630212,"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","textMapHash":1236649610,"text":"You can ask him about this map. With any luck, he might know something about it.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7216302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL"