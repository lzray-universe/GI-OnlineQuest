_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7216304,"initDialog":721630401,"nextRandomTalks":[],"nextTalks":[],"npcId":[3062],"performCfg":"","priority":9,"questId":72163,"showRandomTalkCount":0},"dialogs":[{"nodeId":721630401,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":717887394,"text":"You're back. How's it going? Did you manage to get those pictures?","nextNodeIds":[721630402]},{"nodeId":721630402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3834804434,"text":"Of course.","nextNodeIds":[721630403]},{"nodeId":721630403,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1697396658,"text":"Wonderful. Please, let me see them...","nextNodeIds":[721630404]},{"nodeId":721630404,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1740606538,"text":"Um... Well...","nextNodeIds":[721630405]},{"nodeId":721630405,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":760722826,"text":"Ahaha! I can't tell where these places are at all...","nextNodeIds":[721630406]},{"nodeId":721630406,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":2070017954,"text":"It does seem that those three locations have changed a lot since our family left.","nextNodeIds":[721630407]},{"nodeId":721630407,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":4129409002,"text":"I wonder if Miss Fujiwara Toshiko will be able to recognize them.","nextNodeIds":[721630408]},{"nodeId":721630408,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3590575618,"text":"Well, actually... I doubt it.","nextNodeIds":[721630409]},{"nodeId":721630409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":875401610,"text":"She's also from Seirai Island?","nextNodeIds":[721630410]},{"nodeId":721630410,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":134150770,"text":"More accurately, she's in the same boat as me — our ancestors both lived there.","nextNodeIds":[721630411]},{"nodeId":721630411,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":499633418,"text":"Actually, there's a lot of us here in Inazuma City whose ancestors were once natives of the island, you know?","nextNodeIds":[721630412]},{"nodeId":721630412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2721089050,"text":"So why did you all move away?","nextNodeIds":[721630413]},{"nodeId":721630413,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":2357979698,"text":"I don't really remember anymore... It was a very long time ago.","nextNodeIds":[721630414]},{"nodeId":721630414,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1032660490,"text":"I think it might have been the crazy storms, or to prevent smuggling and illegal border crossings...","nextNodeIds":[721630415]},{"nodeId":721630415,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1063085962,"text":"Whatever the case, the Shogunate arranged for the inhabitants of the island to come to Narukami Island.","nextNodeIds":[721630416]},{"nodeId":721630416,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3419098266,"text":"Well, that's neither here nor there. This is for you. Take it as thanks for running this errand for me.","nextNodeIds":[721630417]},{"nodeId":721630417,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":2407287178,"text":"*sigh* Ah, I do wish that I could go to Seirai Island in person sometime...","nextNodeIds":[721630418]},{"nodeId":721630418,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":997553706,"text":"But I've got all this business to take care of...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7216304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100988","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"},{"LNHLPKELCAL":["100989","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"},{"LNHLPKELCAL":["100990","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"},{"LNHLPKELCAL":["100991","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3062"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7216302,7216303,7216304,7216305],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","count":38},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":14},{"roleType":"TALK_ROLE_NPC","speakerId":3005,"speakerName":"Furuya Noboru","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[172163],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2334057478,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":9,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH"