pe":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7216303,"initDialog":721630301,"nextRandomTalks":[],"nextTalks":[],"npcId":[3062],"performCfg":"","priority":9,"questId":72163,"showRandomTalkCount":0},"dialogs":[{"nodeId":721630301,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":699070274,"text":"*sigh* When will I find someone who'll accompany me back there...","nextNodeIds":[721630302]},{"nodeId":721630302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2710962930,"text":"Would you know anything about this map...","nextNodeIds":[721630303]},{"nodeId":721630303,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":332410090,"text":"Are you... an adventurer with the Guild? Can they finally spare the people?","nextNodeIds":[721630304]},{"nodeId":721630304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":264424938,"text":"Uh, I'm just a passing traveler.","nextNodeIds":[721630305]},{"nodeId":721630305,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":2821578650,"text":"Hmm, fine, then... What's this map you spoke of?","nextNodeIds":[721630306]},{"nodeId":721630306,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1027655050,"text":"Now, let me see...","nextNodeIds":[721630307]},{"nodeId":721630307,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1754256610,"text":"Th—This! Could it be...","nextNodeIds":[721630308,721630309]},{"nodeId":721630308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3552990114,"text":"What did you see?","nextNodeIds":[721630310]},{"nodeId":721630310,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":2462414434,"text":"Isn't this Seirai Island!?","nextNodeIds":[721630311,721630312]},{"nodeId":721630311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3738274874,"text":"That it is.","nextNodeIds":[721630313]},{"nodeId":721630313,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1733242058,"text":"Haha, is it really? I just guessed.","nextNodeIds":[721630314]},{"nodeId":721630314,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3041218122,"text":"Although my ancestors once lived on Seirai Island, that was a very long time ago now.","nextNodeIds":[721630315]},{"nodeId":721630315,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":57845906,"text":"By the time we came to my generation, we no longer had any impression of our old home.","nextNodeIds":[721630316]},{"nodeId":721630316,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3415959354,"text":"All we have left in the house to remind us of it are three landscape paintings of the island.","nextNodeIds":[721630317]},{"nodeId":721630317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2577165418,"text":"So why do you want to go back?","nextNodeIds":[721630318]},{"nodeId":721630318,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3082228746,"text":"Well... It is still my \"hometown,\" is it not?","nextNodeIds":[721630319]},{"nodeId":721630319,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3440655562,"text":"I feel like... I have to go see it no matter what.","nextNodeIds":[721630320]},{"nodeId":721630320,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":916667602,"text":"Unfortunately, I'm pretty busy running my business at the moment, so I haven't the time to go.","nextNodeIds":[721630321]},{"nodeId":721630321,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3294274322,"text":"Additionally, I had some trouble finding adventurers willing to escort me to Seirai Island...","nextNodeIds":[721630322]},{"nodeId":721630322,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":678904642,"text":"So I went with Option B: putting up a commission at the Adventurers' Guild.","nextNodeIds":[721630323]},{"nodeId":721630323,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1991190186,"text":"Hopefully, some adventurers can help me go to Seirai Island, find the three places shown in those paintings, take a few pictures with a Kamera, and bring those pictures back to me.","nextNodeIds":[721630324]},{"nodeId":721630324,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":3462724058,"text":"But no one's picked up that commission thus far...","nextNodeIds":[721630325,721630326]},{"nodeId":721630325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1499954930,"text":"Leave it to me.","nextNodeIds":[721630327]},{"nodeId":721630327,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":639262210,"text":"W—Would you really? That would be amazing!","nextNodeIds":[721630328]},{"nodeId":721630328,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":1512952482,"text":"As for payment, you need not worry. I will have it ready for you for sure.","nextNodeIds":[721630329]},{"nodeId":721630329,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":908774018,"text":"Well then, Traveler, I'll be counting on you. Including the map you brought, that would make four locations to take pictures of...","nextNodeIds":[721630330]},{"nodeId":721630330,"roleType":"TALK_ROLE_NPC","speakerId":3062,"speakerName":"Oda Tarou","textMapHash":697251298,"text":"Well then, Traveler, please head to these four locations and snap a picture of each of them for me.","nextNodeIds":[]},{"nodeId":721630326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1657012338,"text":"I can go there for you.","nextNodeIds":[721630327]},{"nodeId":721630312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":735643442,"text":"Ding ding, correct answer...","nextNodeIds":[721630313]},{"nodeId":721630309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2349025882,"text":"Is this your home?","nextNodeIds":[721630310]}]},{"talkId":7216305,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7216302","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"t