{"mainQuestId":11020,"title":"Shadow of Yore","description":"You and Paimon recognize a familiar face as you come aboard the Pearl Galley...","titleTextMapHash":1200452703,"descTextMapHash":2313028750,"mainQuestExcel":{"mainQuestId":11020,"titleTextMapHash":1200452703,"title":"Shadow of Yore","descTextMapHash":2313028750,"description":"You and Paimon recognize a familiar face as you come aboard the Pearl Galley...","chapterId":2014,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/LQ11020","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":2014,"descTextMapHash":2313028750,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":11020,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1490667353,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/LQ11020","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":2014,"rewardIdList":[111020],"series":2014,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[11021],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1200452703,"type":"LQ","unlockDescTextMapHash":3711471126}},"flow":[{"subQuestId":1102001,"order":1,"stepDescription":"Go to the Pearl Galley","stepDescTextMapHash":3211786620,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q11020ZL1","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q11020ZL1","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1102002,"order":2,"stepDescription":"Meet Zhongli at the tableside","stepDescTextMapHash":4254518508,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1102002],"talks":[{"talkId":1102002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1102002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":1102002,"initDialog":110200201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/LQ/Zhongli1_11020/Q1102002","priority":0,"questId":11020,"showRandomTalkCount":0},"dialogs":[{"nodeId":110200201,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2026195554,"text":"Oh? I didn't think I would see you here.","nextNodeIds":[110200202]},{"nodeId":110200202,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":3862121506,"text":"Are these two your friends?","nextNodeIds":[110200203]},{"nodeId":110200203,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3093253810,"text":"#Yes, we had the fortune of meeting {NICKNAME} not too long ago. They are quite a knowledgeable and talented pair, and a pleasure to be around.","nextNodeIds":[110200204]},{"nodeId":110200204,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2702160754,"text":"#{NICKNAME}, we were just discussing the history of Rex Lapis. Would you like to listen?","nextNodeIds":[110200205]},{"nodeId":110200205,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":2655527098,"text":"This good sir seems not to appreciate the almighty power of the Lord of Geo. As a professional archaeologist, I am inclined to correct some of his erroneous views.","nextNodeIds":[110200206,110200207]},{"nodeId":110200206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3264123978,"text":"Actually, he is...","nextNodeIds":[110200208]},{"nodeId":110200208,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":3935008346,"text":"We are discussing the whereabouts of the first Mora.","nextNodeIds":[110200209]},{"nodeId":110200209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1852284626,"text":"The first Mora?","nextNodeIds":[110200210]},{"nodeId":110200210,"roleType":"TALK_ROLE_NPC","speakerId":10308,"speakerName":"Yixuan","textMapHash":1547461162,"text":"As everyone knows, the Lord of Geo taught the ancient people of Liyue the craft of smelting, creating goods that allowed them to develop trade with the early nations of that time.","nextNodeIds":[110200211]},{"nodeId":110200211,"roleType":"TALK_ROLE_NPC","speakerId":10308,"speakerName":"Yixuan","textMapHash":710196586,"text":"Today, Liyue holds the sole right to cast Mora in the entire continent of Teyvat. The world's very first Mora should have been cast by the hands of the Lord of Geo himself thousands of years ago.","nextNodeIds":[110200212]},{"nodeId":110200212,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":3806605578,"text":"According to my research — as well as my own hypothesis — I believe that this coin of unique historical significance has been passed down secretly through the years as a kind of token.","nextNodeIds":[110200213]},{"nodeId":110200213,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":1211302882,"text":"For example, perhaps the Qixing who control Liyue use it in some kind of unknown ceremony they hold when they come to power...","nextNodeIds":[110200214]},{"nodeId":110200214,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":757186906,"text":"No, no, no... My research indicates that the first Mora coin is not such a simple thing.","nextNodeIds":[110200215]},{"nodeId":110200215,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":1134857658,"text":"Mora is a catalyst — this we all know. Even today, Mora is used in the mystic arts for its curious properties of weapon enhancement.","nextNodeIds":[110200216]},{"nodeId":110200216,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":2944440778,"text":"The world's first Mora would no doubt possess the strongest power. My next historical treatise will boldly expound on the newest findings from my intense, decade-long research!","nextNodeIds":[110200217]},{"nodeId":110200217,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":2515079474,"text":"That is, that the Lord of Geo used this original Mora as a catalyst to enhance a dagger and a sword.","nextNodeIds":[110200218]},{"nodeId":110200218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2184217154,"text":"\"A dagger and a sword\"?","nextNodeIds":[110200219]},{"nodeId":110200219,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":3423058130,"text":"Well, buy the book when it comes out to read the full story. For now, I will only reveal this: the one who finds the dagger shall become supreme in Liyue, and the one who finds the sword may be crowned Liyue's sovereign—","nextNodeIds":[110200220]},{"nodeId":110200220,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2100077778,"text":"I... can't say I agree.","nextNodeIds":[110200221]},{"nodeId":110200221,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":3775479402,"text":"Hmm?","nextNodeIds":[110200222]},{"nodeId":110200222,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1951204938,"text":"Let us not speak of the authenticity of the dagger and sword first... But Mora and money came about simply because they are a convenient measure of a contract's value.","nextNodeIds":[110200223]},{"nodeId":110200223,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1435035890,"text":"Rex Lapis just meant for Mora to serve as a \"catalyst\" for people to exchange and trade.","nextNodeIds":[110200224]},{"nodeId":110200224,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1591938962,"text":"The world's first Mora is probably just an ordinary coin created by Rex Lapis. As for its fate? The same as all Mora, I suspect — it was simply spent somewhere.","nextNodeIds":[110200225]},{"nodeId":110200225,"roleType":"TALK_ROLE_NPC","speakerId":10308,"speakerName":"Yixuan","textMapHash":4015499794,"text":"Hmm... I think that Mr. Hanxue's hypothesis seems reasonable. Mr. Zhongli's argument, on the other hand, lacks any evidence. How can you so easily dismiss the Lord of Geo's profound foresight?","nextNodeIds":[110200226]},{"nodeId":110200226,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":4203227642,"text":"No — no, I am not debating right or wrong. I am simply stating a fact.","nextNodeIds":[110200227]},{"nodeId":110200227,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":3152563290,"text":"Enough! Do you think you understand the Lord of Geo more than me?","nextNodeIds":[110200228,110200229]},{"nodeId":110200228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3749739242,"text":"Actually, he is...","nextNodeIds":[110200230]},{"nodeId":110200230,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":366469962,"text":"I know but little about history and I wouldn't dare to brag. But discussion is meaningless if everyone has the same opinion, no?","nextNodeIds":[110200231]},{"nodeId":110200231,"roleType":"TALK_ROLE_NPC","speakerId":10308,"speakerName":"Yixuan","textMapHash":3071131706,"text":"Well then, answer me this: Long ago, when Liyue Harbor was being constructed, the Lord of Geo taught the people how to build houses. The model home he used to teach them was completely cast from Mora, correct?","nextNodeIds":[110200232]},{"nodeId":110200232,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1113316386,"text":"That is correct, indeed.","nextNodeIds":[110200233]},{"nodeId":110200233,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":1095434370,"text":"Okay then, tell me: Why would the Lord of Geo do something so extravagant if not because of the mystical power that Mora contains?","nextNodeIds":[110200234]},{"nodeId":110200234,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3543532530,"text":"There's a simple explanation, really. To the God of Wealth and Commerce, what material is easier to get than Mora?","nextNodeIds":[110200235]},{"nodeId":110200235,"roleType":"TALK_ROLE_NPC","speakerId":10309,"speakerName":"Hanxue","textMapHash":2800060562,"text":"Oh... Huh...","nextNodeIds":[110200236]},{"nodeId":110200236,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4027153698,"text":"It's like you're telling someone else's tale.","nextNodeIds":[110200237]},{"nodeId":110200237,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":99008098,"text":"Hehe, I mean... I am talking about Rex Lapis.","nextNodeIds":[110200238]},{"nodeId":110200238,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":1676683586,"text":"...","nextNodeIds":[110200239]},{"nodeId":110200239,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2008941554,"text":"Excuse me, sir! Uh... I have some questions about archaeology. Can we find somewhere quiet to chat? I mean, if it's okay with you.","nextNodeIds":[110200240]},{"nodeId":110200240,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2325785834,"text":"Oh, it's no problem at all. But may my friend accompany us? Perhaps they could be of some help.","nextNodeIds":[110200241,110200242]},{"nodeId":110200241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1602939522,"text":"Who, me?","nextNodeIds":[110200243]},{"nodeId":110200243,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2202666690,"text":"Of course. They can come if that's what pleases you, sir. Let's go.","nextNodeIds":[]},{"nodeId":110200242,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2969254738,"text":"I'm just here for a good story.","nextNodeIds":[110200243]},{"nodeId":110200229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":474790834,"text":"No one knows better than him...","nextNodeIds":[110200230]},{"nodeId":110200207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4166461994,"text":"No one knows better than him...","nextNodeIds":[110200208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1102003,"order":3,"stepDescription":"Head to the stern and ask Wanyan about her problem","stepDescTextMapHash":2217512356,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10303"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1102003,1102004,1102005],"talks":[{"talkId":1102003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1102003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1102003,"initDialog":110200301,"nextRandomTalks":[],"nextTalks":[],"npcId":[10303],"performCfg":"QuestDialogue/LQ/Zhongli1_11020/Q1102003","priority":0,"questId":11020,"showRandomTalkCount":0},"dialogs":[{"nodeId":110200301,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":141981954,"text":"What I'm about to say is a bit disrespectful of the Lord of Geo and would draw a lot of angry looks... so it's best to discuss this somewhere quiet.","nextNodeIds":[110200302]},{"nodeId":110200302,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":3947460930,"text":"Your argument just now exhibited acuteness of speech and thought. Most importantly, you don't fall for the boasting and acting of the others. You remain objective.","nextNodeIds":[110200303]},{"nodeId":110200303,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":345221898,"text":"So I have a question for you, perhaps you will answer differently from other scholars... Do you think that all the gods that the Geo Archon killed were evil?","nextNodeIds":[110200304]},{"nodeId":110200304,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":4022250466,"text":"...Let's not analyze it in terms of good versus evil. Rex Lapis placed great importance on the integrity of contracts, so any gods he killed certainly must have broken some kind of contract.","nextNodeIds":[110200305]},{"nodeId":110200305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4239602682,"text":"Right, the Lord of Geo wouldn't kill the innocent.","nextNodeIds":[110200306]},{"nodeId":110200306,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":755735482,"text":"But when I was doing some research, I learned about the legend of the God of Salt.","nextNodeIds":[110200307]},{"nodeId":110200307,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":4061490730,"text":"The God of Salt, Havria, was a very kind god, but she encountered Morax one day in battle...","nextNodeIds":[110200308]},{"nodeId":110200308,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2518015554,"text":"Morax used a rather underhanded trick to... assassinate her.","nextNodeIds":[110200309]},{"nodeId":110200309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":755752554,"text":"What!? No way!","nextNodeIds":[110200310]},{"nodeId":110200310,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3171980474,"text":"This... this bit of history is a long story. But you may not like the truth when you hear it.","nextNodeIds":[110200311]},{"nodeId":110200311,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":1715520162,"text":"Don't worry, please tell me what you know! This event... I have already searched for answers for a long time.","nextNodeIds":[110200312,110200314]},{"nodeId":110200312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2190778954,"text":"You look a bit embarrassed, Zhongli.","nextNodeIds":[110200313]},{"nodeId":110200313,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":278276906,"text":"No, it's just... Where should I begin?","nextNodeIds":[110200316]},{"nodeId":110200316,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":3909372114,"text":"Over here! Mr. Zhongli, I've been looking for you! Ah, so you're over here all this time.","nextNodeIds":[110200317,110200318]},{"nodeId":110200317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2060804378,"text":"The Fatui?","nextNodeIds":[110200319]},{"nodeId":110200319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3249187258,"text":"Put down your weapon and stay back! Otherwise... Ah... Paimon's reporting you to the Millelith!","nextNodeIds":[110200320]},{"nodeId":110200320,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":3143664258,"text":"First of all, I'm not holding a weapon!","nextNodeIds":[110200321]},{"nodeId":110200321,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2243224034,"text":"Ugh... There's no need to overreact, now. I'm simply an archaeological researcher from Snezhnaya, I'm not here for trouble.","nextNodeIds":[110200322]},{"nodeId":110200322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4233313410,"text":"The Fatui say that every time.","nextNodeIds":[110200323]},{"nodeId":110200323,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2173249074,"text":"But this time, I registered with the Liyue Ministry of Civil Affairs. I could show you the official documentation if you want to see it.","nextNodeIds":[110200324]},{"nodeId":110200324,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":3666565970,"text":"I will be conducting an archaeological survey here, the results of which will all be shared with the Ministry.","nextNodeIds":[110200325]},{"nodeId":110200325,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2009805802,"text":"I heard that Wangsheng Funeral Parlor had a consultant named Zhongli with immense knowledge of ancient history and archaeology. So I paid Wangsheng Funeral Parlor a handsome amount to hire Zhongli as my own consultant while I'm in town.","nextNodeIds":[110200326]},{"nodeId":110200326,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2892162098,"text":"So you mean to say that this is work for the Wangsheng Funeral Parlor, yes?","nextNodeIds":[110200327,110200328]},{"nodeId":110200327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3934146370,"text":"What should we do?","nextNodeIds":[110200329]},{"nodeId":110200329,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2110220746,"text":"Well since it's work, I don't have a choice. A consultant of the Wangsheng Funeral Parlor must respect their duty.","nextNodeIds":[110200330]},{"nodeId":110200330,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1115252586,"text":"Of course you would be such a reasonable man! Well then, let's head out now, shall we?","nextNodeIds":[110200331]},{"nodeId":110200331,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":454643722,"text":"Wait, if you are studying archaeology, can I go too? I am also a scholar in this field, so I can help.","nextNodeIds":[110200332]},{"nodeId":110200332,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3936443450,"text":"#That will give us a chance to continue the topic we were just discussing. Oh, and you should tag along too, {NICKNAME}.","nextNodeIds":[110200333,110200334]},{"nodeId":110200333,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3698461410,"text":"Why?","nextNodeIds":[110200335]},{"nodeId":110200335,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1521668922,"text":"This experience may be of help to you on your future adventures.","nextNodeIds":[110200336]},{"nodeId":110200336,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1331867154,"text":"It is a story from before the rise of The Seven... Although the God of Salt has already perished, it will still be a meaningful experience for your journey.","nextNodeIds":[110200337]},{"nodeId":110200337,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2870855866,"text":"This is— Wait, this is an archaeological expedition, not a tour group! That's too many people.","nextNodeIds":[110200338]},{"nodeId":110200338,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2683914354,"text":"But this friend of mine has a treasure-finding talent surpassed by no one. It will surely be of great help to us.","nextNodeIds":[110200339]},{"nodeId":110200339,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2998669298,"text":"Oh? What talent?","nextNodeIds":[110200340]},{"nodeId":110200340,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":137001666,"text":"If my friend espies a treasure chest, they will absolutely find a way to open it.","nextNodeIds":[110200341]},{"nodeId":110200341,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":258950226,"text":"Hey, Paimon's good at that, too!","nextNodeIds":[110200342]},{"nodeId":110200342,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2468121362,"text":"Well... That is quite enticing. Alright then.","nextNodeIds":[110200343]},{"nodeId":110200343,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1140610714,"text":"Well, let's go. There's no time to waste. When the Overlord of the Vortex was crushed by the Jade Chamber recently, perhaps something of interest was washed ashore...","nextNodeIds":[110200344]},{"nodeId":110200344,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2454612154,"text":"An ancient artifact would be good, traces of ancient activity would be great, but a piece of the god's limb would be even better... Who knows what surprises we may find...?","nextNodeIds":[]},{"nodeId":110200334,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":606101914,"text":"I don't really know anything about archaeology.","nextNodeIds":[110200335]},{"nodeId":110200328,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4080159370,"text":"I think it's best to be cautious.","nextNodeIds":[110200329]},{"nodeId":110200318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4034341642,"text":"What do you want!? Spit it out!","nextNodeIds":[110200319]},{"nodeId":110200314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":692484954,"text":"Is the story that complicated?","nextNodeIds":[110200315]},{"nodeId":110200315,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":523192770,"text":"Quite so. I don't know where to begin.","nextNodeIds":[110200316]}]},{"talkId":1102004,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehavi