:716662106,"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","textMapHash":1137582490,"text":"I extend my gratitude to you too, Don Arataki. I intend to stay here and watch a while longer to further enrich my writing. Please, pay no regard — just pretend I'm not here.","nextNodeIds":[716662107]},{"nodeId":716662107,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4292146306,"text":"Man, I've never fought against someone so... cultured before! My mind's buzzing from all those fancy words. What's that buzzy feeling called again? Oh yeah — learning!","nextNodeIds":[716662108]},{"nodeId":716662108,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1606014522,"text":"Looks like the Arataki Blazing Armor Beetle Battle Boot Camp is getting off to a good start!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166621,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7166620,7166621,7166623],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SING