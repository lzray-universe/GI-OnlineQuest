K":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7166620],"talks":[{"talkId":7166620,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["5173","5173003","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["7152501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166620,"initDialog":716662001,"nextRandomTalks":[],"nextTalks":[],"npcId":[30471],"performCfg":"QuestDialogue/WQ/ElectroherculesBattleV2_71666/Q7166620","priority":5,"questId":71525,"showRandomTalkCount":0},"dialogs":[{"nodeId":716662001,"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","textMapHash":1960038594,"text":"Hello, all. I am Iron Tongue Tian, here with an official signboard for the Arataki Blazing Armor Beetle Battle Boot Camp. It also doubles as your permit to run the event.","nextNodeIds":[716662002]},{"nodeId":716662002,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1288972530,"text":"Whoa! Is this supposed to be... Bull-Chucker and Crimson Staff? It's so over the top!","nextNodeIds":[716662003]},{"nodeId":716662003,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":101168346,"text":"Oh, sweet! Sadly, it's not my own original artwork... But check out that design! And that linework!","nextNodeIds":[716662004]},{"nodeId":716662004,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3417736866,"text":"It's so cool! It's epic! It captures exactly how awesome I look as a pro beetle-fighter in the heat of battle!","nextNodeIds":[716662005]},{"nodeId":716662005,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3791633850,"text":"Dude! ...Wait, not that — how do they usually address strangers in this part of the world?","nextNodeIds":[716662006]},{"nodeId":716662006,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":2932877714,"text":"Maybe... \"esquire\"?","nextNodeIds":[716662007]},{"nodeId":716662007,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3660226410,"text":"That's the one! Tian Esquire, your artwork is incredible! Words cannot express the Arataki Gang's gratitude!","nextNodeIds":[716662008]},{"nodeId":716662008,"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","textMapHash":1467629474,"text":"You can drop the \"esquire,\" Don Arataki. Also, I'm no artist — just a storyteller.","nextNodeIds":[716662009]},{"nodeId":716662009,"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","textMapHash":3831286810,"text":"This promotional artwork was done by a young lady at the Ministry of Civil Affairs. Yanfei looks out for her a lot, so when she heard about your event, she offered to contribute some artwork.","nextNodeIds":[716662010]},{"nodeId":716662010,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1238185130,"text":"Ohh, so this is Yanfei's doing! Man, she really thought of everything... This is exactly what we needed!","nextNodeIds":[716662011]},{"nodeId":716662011,"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","textMapHash":4232251738,"text":"Young Grandmaster Hanakado here tells me that your boot camp is an ambitious training program that could shape the future of beetle-fighting.","nextNodeIds":[716662012]},{"nodeId":716662012,"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","textMapHash":78463378,"text":"I'm no beetle-fighter myself, but I've heard a lot about it, and have always wanted to try it out for myself.","nextNodeIds":[716662013]},{"nodeId":716662013,"roleType":"TALK_ROLE_NPC","speakerId":30471,"speakerName":"Listen to the Next Breakdown","textMapHash":1899904194,"text":"Who knows — it might just give me the inspiration for a great new story to tell in the neighborhood.","nextNodeIds":[716662014]},{"nodeId":716662014,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":401523178,"text":"Beetle fighting is something you have to have a natural affinity for. Take Skycleaving White-Iron Lavender Melon for instance: She battled with great prowess on her first time after only a short demonstration.","nextNodeIds":[716662015]},{"nodeId":716662015,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":3525728698,"text":"Once Tian Esquire has grasped the basics of beetle-fighting and understands the appeal, we might get a lot of free publicity from his storytelling.","nextNodeIds":[716662016]},{"nodeId":716662016,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1333532418,"text":"Dude! That would be awesome!","nextNodeIds":[716662017]},{"nodeId":716662017,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2177409218,"text":"Alright, Squirt! Squat! Squire! ESQUIRE! Ahehehehehem... Uh... m—may the best man win!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166620,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7152502,"order":2,"stepDescription":"","stepDescTextMapHash":3068312972,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152503,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7166623],"talks":[{"talkId":7166623,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCamera