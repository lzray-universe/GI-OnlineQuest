20715,"speakerName":"Aranishat","textMapHash":3271864882,"text":"Our Nara friend wins. Awesome! Please take our flowers!","nextNodeIds":[730410611]},{"nodeId":730410611,"roleType":"TALK_ROLE_NPC","speakerId":20714,"speakerName":"Aralila","textMapHash":1263752474,"text":"Thank you, good Nara! You are a good friend!","nextNodeIds":[]},{"nodeId":730410607,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1325880962,"text":"Better luck next time.","nextNodeIds":[730410608]},{"nodeId":730410608,"roleType":"TALK_ROLE_NPC","speakerId":20715,"speakerName":"Aranishat","textMapHash":1073296258,"text":"Yeah! I won't lose next time!","nextNodeIds":[730410609]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7304106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20715"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7304101,7304102,7304103,7304104,7304105,7304106],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20714,"speakerName":"Aralila","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":20715,"speakerName":"Aranishat","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173041],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1202911054,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHE