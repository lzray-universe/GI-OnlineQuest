false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7513201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7513201,"initDialog":751320101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21755,21756],"performCfg":"QuestDialogue/WQ/3509_75132/Q7513201","priority":5,"questId":75132,"showRandomTalkCount":0},"dialogs":[{"nodeId":751320101,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":4031381466,"text":"...Ah... Hero from a distant land...","nextNodeIds":[751320102]},{"nodeId":751320102,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":292669834,"text":"Please, heed my words. I am the guiding night-raven, both a memory of our Lord of the Night's poetic musings... and merely one of a billion notions amidst the moonlight.","nextNodeIds":[751320103]},{"nodeId":751320103,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":3037813826,"text":"Incline your ear unto me, for the spirit river beneath the earth has been shattered, and I can only speak to you via this image, to urge you — beware the pitch-black foe.","nextNodeIds":[751320104]},{"nodeId":751320104,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":660487458,"text":"That broken mirror once beamed forth reflections bright. But now, dark smoke has gradually spread into three areas. Remember them well:","nextNodeIds":[751320105]},{"nodeId":751320105,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":4035201506,"text":"First, the east, where shadows have emerged from where they once hid, within the murals of legendary heroes.","nextNodeIds":[751320106]},{"nodeId":751320106,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":1476676706,"text":"The west is second, where, upon a sea of mystery, darkness manifests, affecting a galling parody of the lord of deepest night.","nextNodeIds":[751320107]},{"nodeId":751320107,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":571441666,"text":"Third lies beneath the cliffs, where a pale fog that should have dissipated now spreads as Cinder City stirs...","nextNodeIds":[751320108]},{"nodeId":751320108,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":1334099458,"text":"O outlander hero, be wary... Tread lightly where our pitch-black enemy roams. Beware the all-corroding foe.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133509454"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUES