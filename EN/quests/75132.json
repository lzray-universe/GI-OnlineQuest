"",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7513205,"initDialog":751320501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21755,21756],"performCfg":"QuestDialogue/WQ/3509_75132/Q7513205","priority":3,"questId":75132,"showRandomTalkCount":0},"dialogs":[{"nodeId":751320501,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":3506726322,"text":"Tread lightly where our pitch-black enemy roams. Beware the all-corroding foe.","nextNodeIds":[751320502]},{"nodeId":751320502,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":242923122,"text":"Is there anything you wish to know, O outlander hero?","nextNodeIds":[751320503,751320506,751320509,751320512]},{"nodeId":751320503,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1087601458,"text":"Tell me about the murals with the heroes...","nextNodeIds":[751320504]},{"nodeId":751320504,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":3769305546,"text":"Find them in the east, within a cavern where glowing trees sway and flutter. There, just as storytellers holding their woven scrolls say, lies also a terror hidden in stories from the past.","nextNodeIds":[751320505]},{"nodeId":751320505,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":359078586,"text":"Perhaps that shadow seeks to escape its imprisonment through those very stories...","nextNodeIds":[751320502]},{"nodeId":751320506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1124480610,"text":"Tell me what lies atop the sea of mystery...","nextNodeIds":[751320507]},{"nodeId":751320507,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":1063170426,"text":"To the west, an island lies obscured by fog. Once, it was a sacred ritual sanctuary, populated by those who made a pact with the Iktomisaurs long ago.","nextNodeIds":[751320508]},{"nodeId":751320508,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":2579655306,"text":"But oozing filth emerged therein, and the holy site became a dark cesspit, sealed away and forgotten... Ah, but our cunning foe would never give up quite so easily...","nextNodeIds":[751320502]},{"nodeId":751320509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":931920114,"text":"Tell me of the pale fog...","nextNodeIds":[751320510]},{"nodeId":751320510,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":2093750090,"text":"That defiled fog was first created when the ancient city, Ochkanatlan, was destroyed. It should have been sealed away... But time and memory are against us...","nextNodeIds":[751320511]},{"nodeId":751320511,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":1993403274,"text":"If only... Alas... If only someone could dispel the pale fog once more...","nextNodeIds":[751320502]},{"nodeId":751320512,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2540609986,"text":"No, I don't need to know anything at the moment.","nextNodeIds":[751320513]},{"nodeId":751320513,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"Will of the Mysterious Graffiti","textMapHash":3985095410,"text":"Ah... Remember, remember... Be wary, be vigilant...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513206,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21755"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7513206,"order":7,"stepDescription":"","stepDescTextMapHash":1956559236,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["21755"],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7513206],"talks":[{"talkId":7513206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRu