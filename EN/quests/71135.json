se,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7113501"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["2223","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_WEATHER_GADGET"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7113502,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7113502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7113502],"talks":[{"talkId":7113502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7113502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7113502,"initDialog":711350201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21094],"performCfg":"QuestDialogue/WQ/Liyue_71135/Q7113502","priority":5,"questId":71135,"showRandomTalkCount":0},"dialogs":[{"nodeId":711350201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2802060450,"text":"Wow! What do you know? We've already collected so much adeptal energy already!","nextNodeIds":[711350202,711350203]},{"nodeId":711350202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2885452026,"text":"Well done me.","nextNodeIds":[711350205]},{"nodeId":711350205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1283425410,"text":"According to what Fujin said before, all this adeptal energy should be used on the Votive Rainjade. That way, Qiaoying Village can reap the results next year!","nextNodeIds":[711350206]},{"nodeId":711350206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4245958258,"text":"When that happens, Paimon'll have Uncle Luo prepare all kinds of amazing food for her! Let Paimon think... Mmm, like teacakes, squab, braised meatball, honey char siu, oooh, and, and...","nextNodeIds":[711350207]},{"nodeId":711350207,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":2821019338,"text":"Tea brew, perhaps?","nextNodeIds":[711350208]},{"nodeId":711350208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2556507658,"text":"Oh right! And Chenyu Brew, of course! Paimon's gotta write all this down... eh? Wait, who's there?","nextNodeIds":[711350209]},{"nodeId":711350209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2546695354,"text":"F—Fujin!?","nextNodeIds":[711350210]},{"nodeId":711350210,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":110046154,"text":"Hehe, sorry about that. I didn't scare you, did I?","nextNodeIds":[711350211]},{"nodeId":711350211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3070037370,"text":"You can assume human form again!","nextNodeIds":[711350212]},{"nodeId":711350212,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":1061953450,"text":"Yes! Did one not say that one was not seriously injured, and needed merely the briefest of rests to return to my favored form?","nextNodeIds":[711350213]},{"nodeId":711350213,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":3216589650,"text":"Thank you both for gathering all that adeptal energy for the Rainjade as I rested. Next year's bountiful harvest will in no small way be thanks to your efforts.","nextNodeIds":[711350214,711350215]},{"nodeId":711350214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1499645434,"text":"#Hehe, 'tis but a piffling trifle for one such as I, the {M#Young Master}{F#Young Lady}!","nextNodeIds":[711350216]},{"nodeId":711350216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":391821546,"text":"Though, now that you're back to your human form and don't need to lock yourself in that super-dark place anymore, what do you plan to do next?","nextNodeIds":[711350217]},{"nodeId":711350217,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":3792668050,"text":"Yes... I haven't given much thought to that yet. Perhaps I should just walk around and have a look?","nextNodeIds":[711350218]},{"nodeId":711350218,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":804588114,"text":"Have a taste of today's teas, listen to today's operas, see the people of today... *ahem* I am sorry. I keep emphasizing \"today,\" as though I'm some sort of horrid antique...","nextNodeIds":[711350219]},{"nodeId":711350219,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":54343234,"text":"Though, I really do like that word. The things I couldn't do in the past, I can do \"today.\" The things that couldn't be achieved before, all those promises that couldn't be kept, they can all be made real \"today.\"","nextNodeIds":[711350220]},{"nodeId":711350220,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":446108562,"text":"And then, I'd like to go to the Guili Assembly and have a look, and then to Liyue Harbor to see the people there, meet all those lovely folks they described, and of course, I'd like to see Herblord again...","nextNodeIds":[711350221]},{"nodeId":711350221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3496895850,"text":"Want me to bring you around?","nextNodeIds":[711350222]},{"nodeId":711350222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2824144082,"text":"Yeah! Paimon remembers that you said something about \"not leaving clear water for too long\" and \"needing to use the adeptal realms in teapots to travel long distances.\"","nextNodeIds":[711350223]},{"nodeId":711350223,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":977770242,"text":"Hehe... Thank you for remembering that, and thank you for being willing to help me. However, I would still like to stay in Chenyu Vale a bit longer and enjoy the sights and sounds of my home.","nextNodeIds":[711350224]},{"nodeId":711350224,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":1304035274,"text":"As for long-distance travel, let me think... Hmm, perhaps I should wait until Little Mao is all grown?","nextNodeIds":[711350225]},{"nodeId":711350225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1866392562,"text":"That's way too long!","nextNodeIds":[711350226]},{"nodeId":711350226,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":1438365458,"text":"I'm joking! Anyway, I do plan to stay here for a bit, and see if I can convince Lingyuan to go on the trip with me.","nextNodeIds":[711350227]},{"nodeId":711350227,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":2826542370,"text":"#Oh, right! {NICKNAME}, one more thing before you go...","nextNodeIds":[711350228]},{"nodeId":711350228,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":365124418,"text":"You went through quite a lot on account of both myself, as well as Lingyuan. My adeptal energy is slowly recovering, so please allow me to give you a genuine blessing of protection for the road ahead.","nextNodeIds":[711350229]},{"nodeId":711350229,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":114741578,"text":"\"Pluck your best teas and toast me, as the dew hangs on the sedges, as smoke swirls amidst the leaves.\"\\n\"The times wear on, yet the years grow peaceful. Such thoughts I nurse in my heart and vow to never forget.\"\\n\"On our times together I ponder, in comfort and happiness, and on my zither I play, till you shall return.\"","nextNodeIds":[711350230]},{"nodeId":711350230,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":534333762,"text":"Hehe, that should do it! All set now!","nextNodeIds":[711350231,711350232]},{"nodeId":711350231,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1648428498,"text":"Thank you.","nextNodeIds":[711350234]},{"nodeId":711350234,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":1544426154,"text":"#Well then, once again... Thank you, {NICKNAME} and Paimon. Thank you for everything you've done for me, and for Chenyu Vale.","nextNodeIds":[]},{"nodeId":711350232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":532382074,"text":"I don't really feel any different...","nextNodeIds":[711350233]},{"nodeId":711350233,"roleType":"TALK_ROLE_NPC","speakerId":21094,"speakerName":"Fujin","textMapHash":1543481346,"text":"Well, the skeins of fortune aren't to be read at a glance, you know!","nextNodeIds":[711350234]},{"nodeId":711350215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1196807402,"text":"I'm glad I could help.","nextNodeIds":[711350216]},{"nodeId":711350203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1989009082,"text":"#No more than to be expected of one such as I, the {M#Young Master}{F#Young Lady}!","nextNodeIds":[711350204]},{"nodeId":711350204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3980560098,"text":"Hey! That bit's long since over, quit talking like that!","nextNodeIds":[711350205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7113502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"B