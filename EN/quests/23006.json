howRandomTalkCount":0},"dialogs":[{"nodeId":230060101,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":430759314,"text":"*sigh* How will we find anyone who will help at this hour...","nextNodeIds":[230060102]},{"nodeId":230060102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2759364994,"text":"What's wrong?","nextNodeIds":[230060103]},{"nodeId":230060103,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":211340834,"text":"Oh! H—Hello there, Traveler. Are you here for treatment?","nextNodeIds":[230060104,230060105]},{"nodeId":230060104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3665041898,"text":"I'm just passing through...","nextNodeIds":[230060106]},{"nodeId":230060106,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":3718349018,"text":"Hehe... Was it that obvious? Well, you are right. I am worried about something.","nextNodeIds":[230060107]},{"nodeId":230060107,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":1752264834,"text":"I don't know why, but there's been an increasing number of people seeking treatment here at Bimarstan lately. Our staff have their hands full taking care of the patients.","nextNodeIds":[230060108]},{"nodeId":230060108,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":1502129370,"text":"Still, Dr. Zakariya insisted that I find ways to keep the surrounding area clean...","nextNodeIds":[230060109]},{"nodeId":230060109,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":2402148170,"text":"He said that only if the hospital and patients were kept clean, then they could more easily receive the blessing of the Dendro Archon.","nextNodeIds":[230060110]},{"nodeId":230060110,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":1907794386,"text":"*sigh* But we can't spare any hands at the moment, and it's not like I can ask the patients with mild symptoms to help out...","nextNodeIds":[230060111,230060113]},{"nodeId":230060111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2074686106,"text":"How about you leave the cleaning to me?","nextNodeIds":[230060112]},{"nodeId":230060112,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":2290369418,"text":"You'll help? That's very kind of you! I'll have the payment ready. It's just that... you might have to lower your expectations in that regard.","nextNodeIds":[230060123]},{"nodeId":230060123,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":3059965794,"text":"*sigh* May the Dendro Archon keep people safe from sickness...","nextNodeIds":[]},{"nodeId":230060113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2319568962,"text":"Can't you just hire someone?","nextNodeIds":[230060114]},{"nodeId":230060114,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":1322433402,"text":"Few would volunteer to work in a place full of patients. Besides, we don't have the budget to hire that many people.","nextNodeIds":[230060115]},{"nodeId":230060115,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":3310186690,"text":"Normally we would split the cleaning into shifts, but no one is available right now.","nextNodeIds":[230060116]},{"nodeId":230060116,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":2990399586,"text":"So, Traveler, could... could you help out?","nextNodeIds":[230060117]},{"nodeId":230060117,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":27244442,"text":"We will pay you! It won't be too much though...","nextNodeIds":[230060118]},{"nodeId":230060118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3126393074,"text":"What's with the patients here, anyway...","nextNodeIds":[230060119]},{"nodeId":230060119,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":669017370,"text":"Most of our patients only suffer from minor ailments, such as headaches.","nextNodeIds":[230060120]},{"nodeId":230060120,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":1713771610,"text":"Dr. Zakariya has told people many times that these conditions are not as scary as they think, but no one buys his explanations.","nextNodeIds":[230060121]},{"nodeId":230060121,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":2266512210,"text":"I suppose that it might not be the disease they're afraid of, it's getting sick itself...","nextNodeIds":[230060122]},{"nodeId":230060122,"roleType":"TALK_ROLE_NPC","speakerId":4072,"speakerName":"Golshan","textMapHash":3030529066,"text":"I'll leave the cleaning to you then, Traveler.","nextNodeIds":[230060123]},{"nodeId":230060105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1823980642,"text":"I just noticed that you looked so worried...","nextNodeIds":[230060106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2300601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["4072"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2300602,"order":2,"stepDescription":"Clean up the stains near \"Bimarstan\"","stepDescTextMapHash":1508642068,"finishConds":[{