EJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1324"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7667201],"talks":[{"talkId":7667201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7667201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7667201,"initDialog":766720101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1324],"performCfg":"QuestDialogue/WQ/NodKrai_76671/Q7667201","priority":5,"questId":76672,"showRandomTalkCount":0},"dialogs":[{"nodeId":766720101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3429221938,"text":"Mission accomplished! Heh, looks like a whole new camp.","nextNodeIds":[766720102]},{"nodeId":766720102,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3462190850,"text":"Yup! Even the fortifications are complete, too. Any attackers, be they monsters or otherwise, will have a hard time overcoming our defenses now.","nextNodeIds":[766720103]},{"nodeId":766720103,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":1311645738,"text":"The lighthouse has half a month's worth of fuel supplies, so even in the event of some massive Wild Hunt assault, we should be able to hold out until reinforcements arrive.","nextNodeIds":[766720104]},{"nodeId":766720104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1672108786,"text":"Thinking that far ahead, huh?","nextNodeIds":[766720105]},{"nodeId":766720105,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":2483405346,"text":"Haha, I just... It always pays to be prepared for the worst, y'know.","nextNodeIds":[766720106]},{"nodeId":766720106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3841931698,"text":"Either way, guess you can take a bit of a break now that it's all done.","nextNodeIds":[766720107]},{"nodeId":766720107,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3141437834,"text":"Right, and that's why I'll be taking a trip home first. I mean, it's been a while since I've seen my old pops.","nextNodeIds":[766720108]},{"nodeId":766720108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":954574330,"text":"Home? Ohhh, yeah. Paimon's gotten so used to seeing you here, she almost forgot you're actually from Piramida.","nextNodeIds":[766720109]},{"nodeId":766720109,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":1548559674,"text":"Why don't you come along? If you wouldn't mind, I'd like to host you at our place.","nextNodeIds":[766720110]},{"nodeId":766720110,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3679112258,"text":"We've set up a food truck here as per Paimon's suggestion, but cooking at home is more convenient all the same.","nextNodeIds":[766720111]},{"nodeId":766720111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1300220658,"text":"Ooh, so you'll be cooking? Well, you're in luck — 'cause Paimon never says no to a tasty meal!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7667201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1324"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7667202,"order":2,"stepDescription":"Head to Illuga's home in Piramida","stepDescTextMapHash":89719196,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7667202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_361100040:5225.431,340.113,9401.865,0.000,156.440,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7667202],"talks":[{"talkId":7667202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7667202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7667202,"initDialog":766720202,"nextRandomTalks":[],"nextTalks":[],"npcId":[15526],"performCfg":"QuestDialogue/WQ/NodKrai_76671/Q7667202","priority":5,"questId":76672,"showRandomTalkCount":0},"dialogs":[{"nodeId":766720202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":460420970,"text":"Lakkaberry Krumkakes, Smoked Fish Steak, Berries and Fried Meat, and Nightwatch Soup... There's so much here — almost too much, even for Paimon!","nextNodeIds":[766720203]},{"nodeId":766720203,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":837862954,"text":"Hmm... I made this according to the amount we'd usually cook for our troops at dinner. So yeah... it might be a bit much for three.","nextNodeIds":[766720204]},{"nodeId":766720204,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3910846266,"text":"No worries, though, just take your time. I'll need to go see my old pops in a bit, so feel free to stay until evening.","nextNodeIds":[766720205,766720206]},{"nodeId":766720205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":294435050,"text":"Didn't realize you were such a talented chef!","nextNodeIds":[766720208]},{"nodeId":766720208,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":2951901418,"text":"Well, I did cook for everyone a lot before taking up my current post. It's just that I haven't had the time recently.","nextNodeIds":[766720209]},{"nodeId":766720209,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3246539586,"text":"The people of Piramida come from every corner of the world, so there's a wide variety of palates to cater for. In other words, it pays to dabble.","nextNodeIds":[766720210]},{"nodeId":766720210,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3815853178,"text":"But since I'm not yet familiar with your preferences, I just made a bit of everything. If there's anything here you particularly like, don't hesitate to say so.","nextNodeIds":[766720211,766720214]},{"nodeId":766720211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4010979770,"text":"If Paimon likes it, so do I.","nextNodeIds":[766720212]},{"nodeId":766720212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1497999994,"text":"What's that supposed to mean! Let's get this straight — Paimon's got her eye on the Berries and Fried Meat, so don't even try fighting her for that one!","nextNodeIds":[766720213]},{"nodeId":766720213,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":2466048666,"text":"Haha, you won't have to fight. I'll just make some more. Couldn't have my squadmates go hungry, could I?","nextNodeIds":[766720216]},{"nodeId":766720216,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":1019748442,"text":"People can say what they want, but the look on someone's face when they eat something they enjoy never lies.","nextNodeIds":[766720217]},{"nodeId":766720217,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3212016514,"text":"As far as I'm concerned, nothing makes me happier than seeing people happy.","nextNodeIds":[766720218]},{"nodeId":766720218,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":1888820058,"text":"And whether as a Lightkeeper or a chef, I'll do whatever it takes to keep them smiling.","nextNodeIds":[766720219]},{"nodeId":766720219,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3630858250,"text":"That might sound trivial to you, but deep down, that's all I've ever really wanted...","nextNodeIds":[766720220,766720221]},{"nodeId":766720220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3801903586,"text":"Hey, don't undersell yourself.","nextNodeIds":[766720222]},{"nodeId":766720222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3975301066,"text":"Exactly! There's no way the people around you aren't grateful for what you do. Heck, they'd probably get mad hearing you talk yourself down like that!","nextNodeIds":[766720223]},{"nodeId":766720223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1365466826,"text":"Besides, they'd have to get in line behind the two of us!","nextNodeIds":[766720224]},{"nodeId":766720224,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3197504138,"text":"Thank you, hehe... Alright, I'll refrain from saying anything else unrelated to dinner. Please, enjoy your meal.","nextNodeIds":[]},{"nodeId":766720221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":506292898,"text":"You're doing great as it is.","nextNodeIds":[766720222]},{"nodeId":766720214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1298697082,"text":"As long as you're making it, I'm a fan.","nextNodeIds":[766720215]},{"nodeId":766720215,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":2155350610,"text":"Heh, there's no need for flattery. If anything, that just makes me want to find the dish you'll like the most even more.","nextNodeIds":[766720216]},{"nodeId":766720206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":566449050,"text":"Don't worry, I think Paimon's got this.","nextNodeIds":[766720207]},{"nodeId":766720207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":155335306,"text":"Well of course, hehe, that goes without saying! Can't just let a good friend's efforts go to waste! Still, Paimon didn't expect you'd be such a good cook either, Illuga.","nextNodeIds":[766720208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7667202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133611065","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["7667201","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}