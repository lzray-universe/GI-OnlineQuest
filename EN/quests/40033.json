ck to Ryuuji","stepDescTextMapHash":971768060,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4003303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3042"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4003303],"talks":[{"talkId":4003303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4003303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4003303,"initDialog":400330301,"nextRandomTalks":[],"nextTalks":[],"npcId":[3042],"performCfg":"QuestDialogue/EQ/Dog1_40033/Q4003303","priority":5,"questId":40033,"showRandomTalkCount":0},"dialogs":[{"nodeId":400330301,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3008866138,"text":"Ah. Wonderful! This should be all of them now...","nextNodeIds":[400330302]},{"nodeId":400330302,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":106610946,"text":"...Wait. Why *isn't* it all of them?","nextNodeIds":[400330303]},{"nodeId":400330303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2456384650,"text":"Uh-oh... Why does Paimon feel like this is just dragging out?","nextNodeIds":[400330304]},{"nodeId":400330304,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2959777866,"text":"It is true that resolving cases sometimes requires a great deal of patience. Going the wrong way could end with you finding nothing at all.","nextNodeIds":[400330305]},{"nodeId":400330305,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":1348719162,"text":"We have found a great deal of these little animals, so we are at least headed in the right direction.","nextNodeIds":[400330306]},{"nodeId":400330306,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":25496610,"text":"We might just have missed a few clues along the way or left a few locations un-searched, thus leading to our current impasse. It will be a temporary one, I believe.","nextNodeIds":[400330307]},{"nodeId":400330307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3445495874,"text":"Ooh, Paimon gets it! You're saying that we'll need a bit of boom shaka-laka to finally clear this up!","nextNodeIds":[400330308]},{"nodeId":400330308,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2559358474,"text":"Mm, yes, you could say that we are presently boom shaka-lacking. But not by much, I would say — we have been making great progress thanks to the two of you.","nextNodeIds":[400330309,400330310]},{"nodeId":400330309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2975378418,"text":"(He... actually understood you, Paimon.)","nextNodeIds":[400330311]},{"nodeId":400330311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4167579066,"text":"That makes a ton of sense, Ryuuji!","nextNodeIds":[400330312]},{"nodeId":400330312,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":753277322,"text":"You flatter me. This is merely experience talking.","nextNodeIds":[400330313]},{"nodeId":400330313,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2450296922,"text":"The further down the truth is buried, the more value there is in uncovering it.","nextNodeIds":[400330314]},{"nodeId":400330314,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":3093612914,"text":"It's just a shame that we don't have any additional information at the moment. Hmm...","nextNodeIds":[400330315]},{"nodeId":400330315,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":1286247194,"text":"I suppose I'll simply report our present status to Sango.","nextNodeIds":[400330316]},{"nodeId":400330316,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2844779170,"text":"She should be able to consider some angles that haven't come to mind yet.","nextNodeIds":[400330317]},{"nodeId":400330317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2062737762,"text":"Sure! Paimon has faith in your good sense, after all!","nextNodeIds":[400330318]},{"nodeId":400330318,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2903319154,"text":"Then it's decided. Let's meet at the usual place once more clues emerge.","nextNodeIds":[400330319]},{"nodeId":400330319,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","textMapHash":2995959794,"text":"If I am otherwise occupied at the time, you can just look for Sango directly.","nextNodeIds":[]},{"nodeId":400330310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1732494858,"text":"(It feels like he already understands you pretty well, Paimon...)","nextNodeIds":[400330311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4003303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3042"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4003301,4003303,4003351,4003352],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"Ryuuji","count":28},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":503723374,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIV