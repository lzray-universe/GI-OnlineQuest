"Miitoboru","textMapHash":1341632434,"text":"I am certain that there's treasure up there this time. It's... What did I call it again? It's the intuition of a mighty pirate ship!","nextNodeIds":[790270611]},{"nodeId":790270611,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":335291570,"text":"Wait a minute... You said you had two things to tell us, right? And the first one was that you'd remembered your name. What was the other one?","nextNodeIds":[790270612]},{"nodeId":790270612,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":2830122866,"text":"Hahaha, I thought you'd already forgotten. I'll tell you when you come back!","nextNodeIds":[]},{"nodeId":790270605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":393309194,"text":"You're too kind.","nextNodeIds":[790270607]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7902706,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["199002009"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7902706_N2003051","5"],"NOCCOBOFKHP":9,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7902713,"order":10,"stepDescription":"Go collect the treasure","stepDescTextMapHash":1011200708,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7902713finished"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJ