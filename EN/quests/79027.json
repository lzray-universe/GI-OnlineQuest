{"mainQuestId":79027,"title":"The Final Treasure","description":"Miitoboru seems to have some request. Time to ask him about the details...","titleTextMapHash":2798700983,"descTextMapHash":2314330006,"mainQuestExcel":{"mainQuestId":79027,"titleTextMapHash":2798700983,"title":"The Final Treasure","descTextMapHash":2314330006,"description":"Miitoboru seems to have some request. Time to ask him about the details...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":5084,"luaPath":"Actor/Quest/WQ79027","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5084,"chapterId":0,"descTextMapHash":2314330006,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":79027,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3196708145,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ79027","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[179027],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2798700983,"type":"WQ","unlockDescTextMapHash":3478224094}},"flow":[{"subQuestId":7902701,"order":1,"stepDescription":"Talk to Miitoboru","stepDescTextMapHash":1697156780,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7902701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7902701_guide","0"],"NOCCOBOFKHP":9,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7902701],"talks":[{"talkId":7902701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7902701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7902701,"initDialog":790270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20729],"performCfg":"QuestDialogue/WQ/Island_79027/Q7902701","priority":5,"questId":79027,"showRandomTalkCount":0},"dialogs":[{"nodeId":790270101,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":44819050,"text":"Ahoy, here you are. I thought you'd be too busy flying around the islands with those wings o' yours.","nextNodeIds":[790270102]},{"nodeId":790270102,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":3659448674,"text":"Bet you've long forgotten your old mate Miitoboru, sitting there slowly soaking away in the ocean.","nextNodeIds":[790270103]},{"nodeId":790270103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":324613714,"text":"We're here now, aren't we!","nextNodeIds":[790270104]},{"nodeId":790270104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4143654474,"text":"So, you said you needed our help. What's up?","nextNodeIds":[790270105]},{"nodeId":790270105,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":1090392978,"text":"It's not that important... Remember when you helped me find the missing pieces of my body?","nextNodeIds":[790270106]},{"nodeId":790270106,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":1455150282,"text":"How can I put it... I'm not sure if it's because I've fulfilled my wishes, or if these waters are slowly diminishing my ability to talk...","nextNodeIds":[790270107]},{"nodeId":790270107,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":2419430386,"text":"Recently, I find myself sleeping most of the time rather than staying conscious...","nextNodeIds":[790270108,790270109]},{"nodeId":790270108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2533052426,"text":"Is it because the machine was turned off...","nextNodeIds":[790270110]},{"nodeId":790270110,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":2647186570,"text":"#I see... So it's because of some contraption that I became your Waverider and could communicate with you, {NICKNAME}...","nextNodeIds":[790270111]},{"nodeId":790270111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2052673426,"text":"Oh... Does that mean that once the effects of the machine wear off, Miitoboru won't be able to talk anymore?","nextNodeIds":[790270112]},{"nodeId":790270112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":454185122,"text":"#We gotta do something before it's too late, {NICKNAME}...","nextNodeIds":[790270113]},{"nodeId":790270113,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":334324058,"text":"Haha, there'll be no need for that, Paimon... I am quite content that I had the chance to talk to you at all.","nextNodeIds":[790270114]},{"nodeId":790270114,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":861536434,"text":"Argh... The more I think about it, for me, as a ship, to have gotten to talk to you in the past few days... It really is a wondrous thing, the stuff dreams are made of...","nextNodeIds":[790270115]},{"nodeId":790270115,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":4170931386,"text":"But now, I need to ask you for one more favor...","nextNodeIds":[790270116]},{"nodeId":790270116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":441660546,"text":"Tell us.","nextNodeIds":[790270117]},{"nodeId":790270117,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":3349578986,"text":"Remember when I told you that once we found my body, I'd take you for a cruise? Well, it seems my body was reduced to a slew of sorry shipwrecks...","nextNodeIds":[790270125]},{"nodeId":790270125,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":2490969130,"text":"And most of the treasure was taken away, leaving nothing good for you...","nextNodeIds":[790270118]},{"nodeId":790270118,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":1805656490,"text":"But this time, I swear as a mighty pirate ship, there be treasure ahoy, and a fine treasure at that! Or else may I be strangled by seagrass and fed to the fish! Just trust me one last time!","nextNodeIds":[790270119]},{"nodeId":790270119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3793559522,"text":"#Well, {NICKNAME}, since Miitoboru probably won't be able to speak soon...","nextNodeIds":[790270120]},{"nodeId":790270120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2975218554,"text":"#And... Since there really is treasure this time... Let's go, {NICKNAME}!","nextNodeIds":[790270121,790270122]},{"nodeId":790270121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2235297394,"text":"Paimon, you never change.","nextNodeIds":[790270123]},{"nodeId":790270123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1265256978,"text":"Time to set sail!","nextNodeIds":[790270124]},{"nodeId":790270124,"roleType":"TALK_ROLE_NPC","speakerId":20729,"speakerName":"Miitoboru","textMapHash":3897605138,"text":"Argh! Come on then, me hearties! Time to come aboard!","nextNodeIds":[]},{"nodeId":790270122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3829148306,"text":"Oh, go on then...","nextNodeIds":[790270123]},{"nodeId":790270109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2303056106,"text":"Is Miitoboru also affected by the machine...","nextNodeIds":[790270110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7902701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],