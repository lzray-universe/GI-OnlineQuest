{"mainQuestId":40204,"title":"Those Strange and Intriguing Questions","description":"You seem to have caught wind of some Akademiya researchers arguing in Port Ormos. Might as well listen in and find out what's going on, right?","titleTextMapHash":182532167,"descTextMapHash":1321395774,"mainQuestExcel":{"mainQuestId":40204,"titleTextMapHash":182532167,"title":"Those Strange and Intriguing Questions","descTextMapHash":1321395774,"description":"You seem to have caught wind of some Akademiya researchers arguing in Port Ormos. Might as well listen in and find out what's going on, right?","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2040,"luaPath":"Actor/Quest/WQ40204","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2040,"chapterId":0,"descTextMapHash":1321395774,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":40204,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3983617265,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ40204","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[140204],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":182532167,"type":"WQ","unlockDescTextMapHash":3786625318}},"flow":[{"subQuestId":4020401,"order":1,"stepDescription":"Approach the arguing researchers","stepDescTextMapHash":1118611980,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4020401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30857"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4020401],"talks":[{"talkId":4020401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4020401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4020401,"initDialog":402040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30858,30859,30857],"performCfg":"QuestDialogue/EQ/V5.7AutoChess_40204/Q4020401","priority":5,"questId":40204,"showRandomTalkCount":0},"dialogs":[{"nodeId":402040101,"roleType":"TALK_ROLE_NPC","speakerId":30858,"speakerName":"Fadaweh","textMapHash":1655815074,"text":"Atashye! I've tried my best to remain calm, but these reports you keep handing in are useless!","nextNodeIds":[402040102]},{"nodeId":402040102,"roleType":"TALK_ROLE_NPC","speakerId":30858,"speakerName":"Fadaweh","textMapHash":3257048314,"text":"Just look at the things you write! \"Possibly,\" \"probably,\" \"roughly\"... How am I supposed to build a mathematical model based on uncertainties!?","nextNodeIds":[402040103]},{"nodeId":402040103,"roleType":"TALK_ROLE_NPC","speakerId":30859,"speakerName":"Atashye","textMapHash":543795146,"text":"Th—Th—That's... I don't have enough time! Not to mention, I'm from Kshahrewar! How am I supposed to know how to measure the impacts on living organisms? T—T—Take Fungi as an example...","nextNodeIds":[402040104]},{"nodeId":402040104,"roleType":"TALK_ROLE_NPC","speakerId":30859,"speakerName":"Atashye","textMapHash":975665538,"text":"Wh—Wh—What am I supposed to do with Fungi? Do you want me to stick my hand in one's mouth and let it bite me so I can write down something like \"Hmm, that is a surprisingly powerful bite\"?","nextNodeIds":[402040105]},{"nodeId":402040105,"roleType":"TALK_ROLE_NPC","speakerId":30859,"speakerName":"Atashye","textMapHash":2482709026,"text":"Darwish, you're from the Amurta Darshan, back me up here, will you?","nextNodeIds":[402040106]},{"nodeId":402040106,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":2012402706,"text":"Haha, if you really want me to get involved, I'd have to start by saying that your grasp of basic biology is shockingly poor — surely everyone knows that most Fungi don't have mouths...","nextNodeIds":[402040107]},{"nodeId":402040107,"roleType":"TALK_ROLE_NPC","speakerId":30858,"speakerName":"Fadaweh","textMapHash":2808118578,"text":"Ha!","nextNodeIds":[402040108]},{"nodeId":402040108,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":4102462370,"text":"However, Fadaweh, we don't require an exceedingly precise model this time. Our research isn't aimed at those stuffy old scholars at the Akademiya...","nextNodeIds":[402040109]},{"nodeId":402040109,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":895589762,"text":"The purpose of this little project is to provide knowledge to children. It's supposed to be engaging. A little imagination is hardly unwarranted.","nextNodeIds":[402040110]},{"nodeId":402040110,"roleType":"TALK_ROLE_NPC","speakerId":30858,"speakerName":"Fadaweh","textMapHash":3842811202,"text":"O—Oh... I see. Well, if you say so...","nextNodeIds":[402040111]},{"nodeId":402040111,"roleType":"TALK_ROLE_NPC","speakerId":30859,"speakerName":"Atashye","textMapHash":2716418266,"text":"Hmph! Honestly, Fadaweh. The way you speak to Darwish... You're a whole different person from when you talk to me!","nextNodeIds":[402040112]},{"nodeId":402040112,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":2695869842,"text":"Alright, alright, no need to argue. I've pretty much finished everything I was working on, and I've reviewed Atashye's conclusions.","nextNodeIds":[402040113]},{"nodeId":402040113,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":3391212282,"text":"Besides, the data can be adjusted once the test has concluded. That's the whole point of testing.","nextNodeIds":[402040114]},{"nodeId":402040114,"roleType":"TALK_ROLE_NPC","speakerId":30858,"speakerName":"Fadaweh","textMapHash":3019036266,"text":"A—Ah, of course, Darwish... Clear-headed and organized as always! Unlike a certain someone...","nextNodeIds":[402040115]},{"nodeId":402040115,"roleType":"TALK_ROLE_NPC","speakerId":30859,"speakerName":"Atashye","textMapHash":1518812578,"text":"Indeed, indeed... And no, I'm not asking who that \"certain someone\" is.","nextNodeIds":[402040116]},{"nodeId":402040116,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":876907570,"text":"Can you two please knock it off? We've got final preparations to make!","nextNodeIds":[402040117]},{"nodeId":402040117,"roleType":"TALK_ROLE_NPC","speakerId":30858,"speakerName":"Fadaweh","textMapHash":3724144154,"text":"A—As you say!","nextNodeIds":[402040118]},{"nodeId":402040118,"roleType":"TALK_ROLE_NPC","speakerId":30859,"speakerName":"Atashye","textMapHash":2299613074,"text":"And I'll go check if the paint's dried...","nextNodeIds":[402040119]},{"nodeId":402040119,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":1563686986,"text":"Speaking of the test... and test subjects... I don't suppose you two would be interested in helping out?","nextNodeIds":[402040120]},{"nodeId":402040120,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":5387570,"text":"I mean, you've been standing there watching us for a while now.","nextNodeIds":[402040121]},{"nodeId":402040121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2678393890,"text":"Huh? Us?","nextNodeIds":[402040122]},{"nodeId":402040122,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":1801707738,"text":"Yes, you. Do you want to take part in our test? You'll get to eat all the fruit you want!","nextNodeIds":[402040123,402040125]},{"nodeId":402040123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3121145434,"text":"Are you asking us to test new varieties of fruit?","nextNodeIds":[402040124]},{"nodeId":402040124,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":480274346,"text":"Not quite... Hmm. How best to explain...","nextNodeIds":[402040130]},{"nodeId":402040130,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":985119802,"text":"How about this — I'll start by asking you a question... Let's see... \"Who would win in a fight between a sliding Stretchy Pyro Fungus and a Rishboland Tiger?\"","nextNodeIds":[402040131,402040134,402040137]},{"nodeId":402040131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":396049090,"text":"The sliding Stretchy Pyro Fungus...","nextNodeIds":[402040132]},{"nodeId":402040132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":816871514,"text":"You sure? Paimon feels like the Rishboland Tiger would have the advantage. Y'know, with those long, sharp claws...","nextNodeIds":[402040133]},{"nodeId":402040133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1209319794,"text":"That's a very peculiar question...","nextNodeIds":[402040140]},{"nodeId":402040140,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":927040626,"text":"Wait... there's more. \"Who's stronger, a Floating Anemo Fungus or an Anemo Slime?\" \"Who are the better fighters, the Eremites or Natlan's Saurian Warriors? What about the Kairagi?\"...","nextNodeIds":[402040141]},{"nodeId":402040141,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":427630458,"text":"These are the sort of questions that children always ask when we teach them.","nextNodeIds":[402040142]},{"nodeId":402040142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2661716578,"text":"Little minds love asking those sorts of questions!","nextNodeIds":[402040143]},{"nodeId":402040143,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":1103390234,"text":"Haha, but child-like curiosity is the foundation of learning! They \"want to know\"... and that's why we're doing all this!","nextNodeIds":[402040144]},{"nodeId":402040144,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":3787906626,"text":"Observe — the \"Companion Caper Chronicles,\" based on genuine real-world deductions! The children can build their own simulated adventure teams, then use them to battle each other!","nextNodeIds":[402040145]},{"nodeId":402040145,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":912646418,"text":"Atashye is researching the effects of diet and environment on all kinds of creatures, while Fadaweh is constructing the \"simulated development\" model.","nextNodeIds":[402040146]},{"nodeId":402040146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3454206346,"text":"Simulated development?","nextNodeIds":[402040147]},{"nodeId":402040147,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":772131994,"text":"Yes, precisely! I mean, we cannot simply let children freely interact with real-world Fungi, Eremites, and such...","nextNodeIds":[402040148]},{"nodeId":402040148,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":879753042,"text":"So, what do you say? If you can spare the time, come take part in the test — you'll be helping with my research and gaining valuable academic experience all at once!","nextNodeIds":[402040149]},{"nodeId":402040149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3109035602,"text":"#Hmm, that does sound good, doesn't it, {NICKNAME}?","nextNodeIds":[402040150]},{"nodeId":402040150,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3157194482,"text":"Alright then! \"Wise Old Paimon\" could do with some academic experience...","nextNodeIds":[402040151]},{"nodeId":402040151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2816727282,"text":"Hmph! Don't you make fun of Paimon! Paimon's very smart, she'll have you know — and soon she'll be even smarter! Let's go do some research!","nextNodeIds":[402040152]},{"nodeId":402040152,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":700150746,"text":"#You're more than welcome to help out, {NICKNAME}. Of course, so is Paimon — a sage in the making if I ever saw one!","nextNodeIds":[402040153]},{"nodeId":402040153,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":3855987482,"text":"Just let me know when you want to give it a go, and I'll run you through our \"simulated development\" rules.","nextNodeIds":[]},{"nodeId":402040134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":631526754,"text":"The Rishboland Tiger, obviously!","nextNodeIds":[402040135]},{"nodeId":402040135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2314220226,"text":"Aha! Paimon would've gone for the tiger, too!","nextNodeIds":[402040136]},{"nodeId":402040136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3151869010,"text":"That's a very peculiar question...","nextNodeIds":[402040140]},{"nodeId":402040137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":35112058,"text":"A sliding Rishboland Tiger would win!","nextNodeIds":[402040138]},{"nodeId":402040138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1543170978,"text":"Not an option! What's a sliding Rishboland Tiger anyway?","nextNodeIds":[402040139]},{"nodeId":402040139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2422800282,"text":"Who asks crazy questions like that?","nextNodeIds":[402040140]},{"nodeId":402040125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2684248554,"text":"Sorry, we're only interested in watching those two argue...","nextNodeIds":[402040126]},{"nodeId":402040126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4131360634,"text":"Don't say that! You make it sound like we're a couple of passing weirdos.","nextNodeIds":[402040127]},{"nodeId":402040127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":857594706,"text":"Maybe we should hear them out before deciding? Paimon wants to learn more about the fresh fru— Ahem, about this project...","nextNodeIds":[402040128]},{"nodeId":402040128,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":481061562,"text":"Such an inquisitive mind! I'm sure your travels have been blessed by luck.","nextNodeIds":[402040129]},{"nodeId":402040129,"roleType":"TALK_ROLE_NPC","speakerId":30857,"speakerName":"Darwish","textMapHash":3176869234,"text":"Now, let me introduce our research here. Hmm, how best to explain...","nextNodeIds":[402040130]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4020401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30857"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4020402,"order":2,"stepDescription":"Talk to Darwish","stepDescTextMapHash":267469932,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2040,99],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,