{"mainQuestId":73706,"title":"Crisis Management Unit, Fully Operational!","description":"Thanks to everyone's combined efforts, the Fieldwise Center has been fully developed and is running smoothly. At last, this period of relentless work has come to a close...","titleTextMapHash":4084524767,"descTextMapHash":242907958,"mainQuestExcel":{"mainQuestId":73706,"titleTextMapHash":4084524767,"title":"Crisis Management Unit, Fully Operational!","descTextMapHash":242907958,"description":"Thanks to everyone's combined efforts, the Fieldwise Center has been fully developed and is running smoothly. At last, this period of relentless work has come to a close...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2043,"luaPath":"Actor/Quest/WQ73706","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2043,"chapterId":0,"descTextMapHash":242907958,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73706,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":527249449,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73706","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173706],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4084524767,"type":"WQ","unlockDescTextMapHash":3928309366}},"flow":[{"subQuestId":7370601,"order":1,"stepDescription":"Talk to Collei","stepDescTextMapHash":3136853660,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1051"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7370601],"talks":[{"talkId":7370601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7370601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370601,"initDialog":737060101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1051,1002,1067,1052,1059],"performCfg":"QuestDialogue/WQ/SumeruAdventureTraining_73706/Q7370601","priority":5,"questId":73706,"showRandomTalkCount":0},"dialogs":[{"nodeId":737060101,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":1945744794,"text":"Good news, everyone!","nextNodeIds":[737060102]},{"nodeId":737060102,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":1984510274,"text":"The Fieldwise center is getting a lot of praise from important scholars all throughout the Akademiya...","nextNodeIds":[737060103]},{"nodeId":737060103,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":2535002362,"text":"Soon, they'll send a team of specialists to take over the management of this place based on our recommendations!","nextNodeIds":[737060104]},{"nodeId":737060104,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":222113466,"text":"So, thank you for all the support!","nextNodeIds":[737060105]},{"nodeId":737060105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4264777562,"text":"Wow, sounds like your hard work paid off, Collei!","nextNodeIds":[737060106]},{"nodeId":737060106,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":672326890,"text":"And you're overseeing the transition yourself... Well done.","nextNodeIds":[737060107]},{"nodeId":737060107,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":2509868482,"text":"The young students today could learn a thing or two from you, Collei. Your confidence, your proactiveness, your leadership... It's admirable.","nextNodeIds":[737060108]},{"nodeId":737060108,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":3251172386,"text":"Not like some of the ones I teach, so focused on theses and research, with no practical skills to speak of.","nextNodeIds":[737060109]},{"nodeId":737060109,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":2857661090,"text":"T—To be honest, I don't feel all that confident. Being the go-between for all the different Darshans, coordinating everything... I still can't quite believe I managed it.","nextNodeIds":[737060110]},{"nodeId":737060110,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":3550132682,"text":"#Oh, but {NICKNAME} and Paimon played a huge role in that too. I can't thank you both enough...","nextNodeIds":[737060111,737060112]},{"nodeId":737060111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3330296682,"text":"It was nothing!","nextNodeIds":[737060113]},{"nodeId":737060113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1857354634,"text":"Yeah, we're used to this kinda work. So, for us, this was more like... a super special camping trip with friends!","nextNodeIds":[737060114]},{"nodeId":737060114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2510389202,"text":"Y'know, a few puzzles here, a little exercise there... It was super fun! Pretty much a piece of cake!","nextNodeIds":[737060115]},{"nodeId":737060115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3426139490,"text":"Aw, man... Now Paimon's hungry...","nextNodeIds":[737060116]},{"nodeId":737060116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2912372362,"text":"Hey, now that we're all done, why don't we go get some food to celebrate?","nextNodeIds":[737060117]},{"nodeId":737060117,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":2917807490,"text":"Hah, Candace and I are two steps ahead of you!","nextNodeIds":[737060118]},{"nodeId":737060118,"roleType":"TALK_ROLE_NPC","speakerId":1059,"speakerName":"Candace","textMapHash":688552418,"text":"This way, everyone.","nextNodeIds":[737060119]},{"nodeId":737060119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2036920834,"text":"Woohoo! A feast!","nextNodeIds":[737060120]},{"nodeId":737060120,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4125910098,"text":"Mm! Perfect timing!","nextNodeIds":[737060121]},{"nodeId":737060121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2610679626,"text":"Aww, it's been a while since we've had such a delicious spread of dishes from Sumeru... Paimon feels like she could eat twice as much... No, three times as much as normal!","nextNodeIds":[737060122,737060123]},{"nodeId":737060122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2880911858,"text":"We should come around more often then.","nextNodeIds":[737060124]},{"nodeId":737060124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2591555266,"text":"Hah, is that a challenge?","nextNodeIds":[737060125]},{"nodeId":737060125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":537804874,"text":"Careful what you wish for. We have your wallet to think about.","nextNodeIds":[737060126]},{"nodeId":737060126,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":2963745378,"text":"Mmm! It's been a while since I've had food from the desert region...","nextNodeIds":[737060127]},{"nodeId":737060127,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":2862952034,"text":"It's nothing like I remember...","nextNodeIds":[737060128]},{"nodeId":737060128,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":2724958666,"text":"Now, this is the real deal. Everything I've tried before pales in comparison.","nextNodeIds":[737060129]},{"nodeId":737060129,"roleType":"TALK_ROLE_NPC","speakerId":1059,"speakerName":"Candace","textMapHash":3998002466,"text":"That means a lot, Madam Faruzan.","nextNodeIds":[737060130]},{"nodeId":737060130,"roleType":"TALK_ROLE_NPC","speakerId":1059,"speakerName":"Candace","textMapHash":3378583434,"text":"If all the researchers who came to our village were so polite, we would have an occasion to offer feasts like this more often.","nextNodeIds":[737060131]},{"nodeId":737060131,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":3178434202,"text":"By the way... You planning on doing any sight-seeing, Miss Amber? You came all this way, after all.","nextNodeIds":[737060132]},{"nodeId":737060132,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3206788090,"text":"Oh, for sure!","nextNodeIds":[737060133]},{"nodeId":737060133,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4198465722,"text":"I hear that there's a forest full of gigantic trees northwest of Port Ormos, with trunks bigger than the entire width of the Good Hunter restaurant...","nextNodeIds":[737060134]},{"nodeId":737060134,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2217294378,"text":"I'd love to see it for myself.","nextNodeIds":[737060135]},{"nodeId":737060135,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2560571898,"text":"Ooh, and I bet I could climb up and then glide down from the tree tops! That sounds so fun!","nextNodeIds":[737060136]},{"nodeId":737060136,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":3173871330,"text":"In that case, I'll give you some snacks to take with you... like a dense cake or some dumplings.","nextNodeIds":[737060137]},{"nodeId":737060137,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":3863728298,"text":"The wind's strong up there, so you don't want anything too crumbly. Oh, and you'll need a thicker water skin, so it doesn't break if it drops...","nextNodeIds":[737060138]},{"nodeId":737060138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3749973178,"text":"Ooh, dumplings sound great... so soft and chewy. Great thinking, Collei!","nextNodeIds":[737060139]},{"nodeId":737060139,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2351425802,"text":"As for the desert, I'd love to check out some of the ruins, like that giant one shaped like an hourglass!","nextNodeIds":[737060140]},{"nodeId":737060140,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2022674402,"text":"I'll just observe from a distance, though. Your ruins could be protected sites, so... better to not barge in.","nextNodeIds":[737060141]},{"nodeId":737060141,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2138946242,"text":"Besides, there could be someone sleeping in there, haha.","nextNodeIds":[737060142]},{"nodeId":737060142,"roleType":"TALK_ROLE_NPC","speakerId":1059,"speakerName":"Candace","textMapHash":2320863370,"text":"I'm glad to hear that, Miss Amber. It's for the best...","nextNodeIds":[737060143]},{"nodeId":737060143,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":2777997570,"text":"Hm, your body won't be used to the desert environment, though, so traveling could be tough.","nextNodeIds":[737060144]},{"nodeId":737060144,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":2451791618,"text":"You'll need to bring moisturizing ointment, and essential oils for the skin...","nextNodeIds":[737060145,737060146]},{"nodeId":737060145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2697502586,"text":"So, we're even thinking about skin care...","nextNodeIds":[737060147]},{"nodeId":737060147,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3909642122,"text":"Honestly, though, helping set up the Fieldwise Center was the real highlight of this trip.","nextNodeIds":[737060148]},{"nodeId":737060148,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1963095290,"text":"And thanks to you, Collei, I got to make some new friends, too! So, I couldn't be happier!","nextNodeIds":[737060149]},{"nodeId":737060149,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3872266898,"text":"Feel free to drop in on me in Mondstadt any time! I'll show you the best our city has to offer!","nextNodeIds":[737060150]},{"nodeId":737060150,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":3708038826,"text":"Don't mind if I do!","nextNodeIds":[737060151]},{"nodeId":737060151,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":1629763146,"text":"I had some Dandelion Wine while I was in Fontaine, and man... that was the stuff. So sweet and fragrant... Not a single bitter note in there at all!","nextNodeIds":[737060152]},{"nodeId":737060152,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":807985586,"text":"And that was the imported stuff! I bet the taste is even better when it's fresh!","nextNodeIds":[737060153]},{"nodeId":737060153,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":1799012298,"text":"I'm looking forward to downing a couple of barrels already!","nextNodeIds":[737060154]},{"nodeId":737060154,"roleType":"TALK_ROLE_NPC","speakerId":1059,"speakerName":"Candace","textMapHash":3586397570,"text":"Ahem... It couldn't hurt to take a break from wine, either. Those children gave you some Henna Berry thorn powder, remember? You could make some tea...","nextNodeIds":[737060155]},{"nodeId":737060155,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":3600783050,"text":"Aha... Ahaha... C—Come on, Candace, it's just a taste. The barrels aren't even that big... We're talking, like, three to five cups per, tops.","nextNodeIds":[737060156]},{"nodeId":737060156,"roleType":"TALK_ROLE_NPC","speakerId":1052,"speakerName":"Dehya","textMapHash":2218757874,"text":"And, don't worry, I'd make sure to bring back souvenirs for everyone!","nextNodeIds":[737060157]},{"nodeId":737060157,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":224211914,"text":"Well, I've heard the Knights of Favonius Library has quite the collection.","nextNodeIds":[737060158]},{"nodeId":737060158,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":2519887954,"text":"I wonder if there are tomes that approach engineering from a different angle — could be worth perusing...","nextNodeIds":[737060159]},{"nodeId":737060159,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":716565122,"text":"I'm not sure about the exact number, but the library's pretty huge, alright.","nextNodeIds":[737060160]},{"nodeId":737060160,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3946254538,"text":"What kind of books are you interested in, Madam Faruzan? I can write them down and have Lisa get them ready for you.","nextNodeIds":[737060161]},{"nodeId":737060161,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3877572930,"text":"Either way, just leave your Mondstadt travel plans to me!","nextNodeIds":[737060162]},{"nodeId":737060162,"roleType":"TALK_ROLE_NPC","speakerId":1067,"speakerName":"Faruzan","textMapHash":4221747338,"text":"Lisa... Lisa Minci? Cyrus's prized student, who he never stops bragging about...? So, that's where she's hiding!","nextNodeIds":[737060163]},{"nodeId":737060163,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3154859082,"text":"Ahhh, this is kinda nice, isn't it?","nextNodeIds":[737060164]},{"nodeId":737060164,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":333514818,"text":"Friends of ours meeting other friends of ours, then becoming friends in their own right...","nextNodeIds":[737060165,737060166]},{"nodeId":737060165,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1631724458,"text":"The world doesn't stand still, after all.","nextNodeIds":[737060167]},{"nodeId":737060167,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1565269906,"text":"Yeah! Maybe we should start introducing our friends to each other! Paimon can think of a few who might get along...","nextNodeIds":[737060168]},{"nodeId":737060168,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":705238402,"text":"Not a bad idea, right? Just imagine all the fun we could have, hehe!","nextNodeIds":[]},{"nodeId":737060166,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":269382866,"text":"It's nice to have friends all over, don't you think?","nextNodeIds":[737060167]},{"nodeId":737060146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4178420658,"text":"This is a whole new level of thoughtfulness...","nextNodeIds":[737060147]},{"nodeId":737060123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1658031818,"text":"I'm still waiting for the day you clean out an entire restaurant.","nextNodeIds":[737060124]},{"nodeId":737060112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":132962906,"text":"A total team effort!","nextNodeIds":[737060113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR