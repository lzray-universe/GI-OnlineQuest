deId":413350104,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":1763764226,"text":"Given that the Lantern Rite festival is already in full swing, I was thinking about how I could create a painting that depicts Liyue Harbor during the festival.","nextNodeIds":[413350105]},{"nodeId":413350105,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":1701341434,"text":"*sigh* Maybe it's a problem with my technique or something, but no matter what I do, the painting just doesn't feel right.","nextNodeIds":[413350106]},{"nodeId":413350106,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":2166227434,"text":"Maybe a change of scenery would give me more inspiration, but I can't seem to find anywhere better...","nextNodeIds":[413350107]},{"nodeId":413350107,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":3411740498,"text":"Traveler, do you know of any scenic spots that would be suitable for painting?","nextNodeIds":[413350108]},{"nodeId":413350108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2600748402,"text":"We'll have a look around!","nextNodeIds":[413350109]},{"nodeId":413350109,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":3632007394,"text":"Oh, good. Let's have a look together then. Maybe we'll be able to find a nice scenic spot.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4133501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["240901"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4133502,"order":3,"stepDescription":"Look for suitable scenery","stepDescTextMapHash":3667549148,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4133502,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4133503QingZhou"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4133502,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4133503QingZhou"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4133503,"order":4,"stepDescription":"Talk to Qingzhou","stepDescTextMapHash":4161870332,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4133503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["220501"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4133503],"talks":[{"talkId":4133503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4133503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4133503,"initDialog":413350301,"nextRandomTalks":[],"nextTalks":[],"npcId":[220501],"performCfg":"QuestDialogue/WQ/Liyue_41335/Q4133503","priority":5,"questId":41335,"showRandomTalkCount":0},"dialogs":[{"nodeId":413350301,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":4026913634,"text":"Now here's a good view of the landscape... Oh, who's this?","nextNodeIds":[413350302]},{"nodeId":413350302,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":2701133634,"text":"My name is Qingzhou, my liege. I might add that I consider myself a poet, if I may be so bold. And you are...","nextNodeIds":[413350303]},{"nodeId":413350303,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":2661067706,"text":"Ah, so you're a poet? Haha. Well, I'm a painter and I'm looking for some scenic spots nearby to help give me some inspiration.","nextNodeIds":[413350304]},{"nodeId":413350304,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":2718242658,"text":"Inspiration, you say? Why, this is quite a coincidence. I myself am also seeking a stroke of inspiration. May I be so bold as to ask the purpose for which you seek to be inspired?","nextNodeIds":[413350305]},{"nodeId":413350305,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":992722458,"text":"Certainly. I intend to paint a scene of Liyue Harbor during the Lantern Rite. This traveler here was assisting me in my search for a suitable landscape.","nextNodeIds":[413350306]},{"nodeId":413350306,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":3431038202,"text":"And may I ask what you are seeking inspiration for?","nextNodeIds":[413350307]},{"nodeId":413350307,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":3194693002,"text":"Yes, quite the coincidence indeed. I also intend to write a poem about Liyue Harbor during the Lantern Rite. I'm seeking inspiration, just as you are.","nextNodeIds":[413350308]},{"nodeId":413350308,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":1853761690,"text":"I see...","nextNodeIds":[413350309]},{"nodeId":413350309,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":3431475090,"text":"Hmm...","nextNodeIds":[413350310]},{"nodeId":413350310,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":3593646050,"text":"Wouldn't a poem be a little too simple? How could an amazing festival like the Lantern Rite and Liyue Harbor itself possibly fit into a few lines of poetry?","nextNodeIds":[413350311]},{"nodeId":413350311,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":2182877386,"text":"Hah, if you ask me, only a great painting could properly capture the essence of the festival.","nextNodeIds":[413350312]},{"nodeId":413350312,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":1319593570,"text":"A great painting, you say? Hehe, I fear that such a work would only be a waste of good brush and ink. A painting could never truly capture the subtle charm of the Lantern Rite and would fail to accurately render the spirit of Liyue.","nextNodeIds":[413350313]},{"nodeId":413350313,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":1069278034,"text":"Furthermore, could the grandeur of a land as magnificent as Liyue ever possibly be captured in a painting?","nextNodeIds":[413350314]},{"nodeId":413350314,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":1754895050,"text":"Haha, I think a painting would be better.","nextNodeIds":[413350315]},{"nodeId":413350315,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":741388794,"text":"Hehe, and I think a poem would be better suited.","nextNodeIds":[413350316]},{"nodeId":413350316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1811266554,"text":"Whoa, calm down you two.","nextNodeIds":[413350317]},{"nodeId":413350317,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":3182266002,"text":"Arguing like this won't solve anything. I propose we each create a work depicting Liyue Harbor during the Lantern Rite...","nextNodeIds":[413350318]},{"nodeId":413350318,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":491676194,"text":"Once we've both finished our works, we can put them on display and invite someone to judge them. What do you say?","nextNodeIds":[413350319]},{"nodeId":413350319,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":2589270642,"text":"Your proposition is acceptable. I shall await your presence at Wangshu Inn once you have completed your... painting. Then we shall entreat an impartial judge to critique our work.","nextNodeIds":[413350320]},{"nodeId":413350320,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":162391042,"text":"Good, you have a deal.","nextNodeIds":[413350321]},{"nodeId":413350321,"roleType":"TALK_ROLE_NPC","speakerId":220501,"speakerName":"Qingzhou","textMapHash":561721938,"text":"It's settled then. If you would excuse me, I shall take my leave now.","nextNodeIds":[413350322]},{"nodeId":413350322,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":3859218834,"text":"He sure does talk big for a poet. And to think he actually believes that the Lantern Rite and Liyue Harbor can be expressed with a few lines of poetry, hah!","nextNodeIds":[413350323]},{"nodeId":413350323,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":4142689218,"text":"I'll show him! He won't even stand a chance once I finish my painting.","nextNodeIds":[413350324]},{"nodeId":413350324,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":1002285386,"text":"I'll need to pour all my creativity into this one. In fact, I should even specially prepare some paints and brushes for this particular piece.","nextNodeIds":[413350325]},{"nodeId":413350325,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":516779026,"text":"Traveler, could I trouble you to help me collect some special materials?","nextNodeIds":[413350326,413350328]},{"nodeId":413350326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2625950058,"text":"Leave it to me.","nextNodeIds":[413350327]},{"nodeId":413350327,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":293781610,"text":"Good, I'm counting on you. Now let me think...","nextNodeIds":[413350329]},{"nodeId":413350329,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":1960692474,"text":"Oh, I'll need you to collect Whopperflower Nectar from a Pyro Whopperflower.","nextNodeIds":[413350330]},{"nodeId":413350330,"roleType":"TALK_ROLE_NPC","speakerId":240901,"speakerName":"Vermeer","textMapHash":2455551490,"text":"With that, I'll be able to make mix some special paint.","nextNodeIds":[]},{"nodeId":413350328,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1000737386,"text":"What kind of materials do you need?","nextNodeIds":[413350329]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4133503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["220501"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4133506,"order":5,"stepDescription":"Collect Pyro Whopperflower Nectar","stepDescTextMapHash":1344047740,"