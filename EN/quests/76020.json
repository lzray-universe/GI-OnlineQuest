HEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_11410:2189.326,200.406,8783.789,0.000,136.912,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7602001,7602007],"talks":[{"talkId":7602001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7602007","","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7602006","2","","",""],"type":"QUEST_COND_QUEST_STATE_NOT_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7602001,"initDialog":760200101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"","priority":5,"questId":76020,"showRandomTalkCount":0},"dialogs":[{"nodeId":760200101,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":893968442,"text":"Another day, another empty bucket.","nextNodeIds":[760200102,760200105,760200112,760200117]},{"nodeId":760200102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2313546954,"text":"What are you doing here?","nextNodeIds":[760200103]},{"nodeId":760200103,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3239447466,"text":"Fishing. Though so far, I've only caught things that aren't fish.","nextNodeIds":[760200104]},{"nodeId":760200104,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2250973218,"text":"If it were knick-knacks from shipwrecks, that'd be fine, 'cause traveling merchants would buy those. I once pulled up a boot with half a... *sigh* Forget it. Talking about stuff like that will scare the fish off.","nextNodeIds":[]},{"nodeId":760200105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3068970674,"text":"Is there anything of note nearby?","nextNodeIds":[760200106]},{"nodeId":760200106,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":839518914,"text":"Treasure hunting, huh? That \"Great Treasure\" they say lies east of the moon and west of the sun... Doesn't take much to know this isn't the place to find it.","nextNodeIds":[760200107]},{"nodeId":760200107,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":1391488618,"text":"Though saying that, there've been a good few shipwrecks in these waters. There may well be treasure beneath the waves, not that you'd find it easy to get at.","nextNodeIds":[760200108]},{"nodeId":760200108,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2449804538,"text":"I heard talk at the tavern, too, from sailors who escaped their sinking ship. Said it happened on a moonless night, yet something was glowing among the towering waves.","nextNodeIds":[760200109]},{"nodeId":760200109,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2717346370,"text":"They swore it was one-eyed Kratti, a monster that could swallow the moon. It was fighting a giant sea serpent for the right to rule its territory.","nextNodeIds":[760200110]},{"nodeId":760200110,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3214614602,"text":"For a long time after that, this whole stretch of ocean stayed as dark as ink. No ships dared pass through — they all feared the lost souls beneath the waves would drag them down.","nextNodeIds":[760200111]},{"nodeId":760200111,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":1244830394,"text":"People claim those lost souls still wander nearby, but I say it's all just stories meant to frighten kids. I don't buy that nonsense.","nextNodeIds":[]},{"nodeId":760200112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1568061426,"text":"About this tree...","nextNodeIds":[760200113]},{"nodeId":760200113,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3773493490,"text":"It's cursed. There used to be a whirlpool here — the sailors called it the Eye of Kratti. Then one day, this tree just started growing right out of it.","nextNodeIds":[760200114]},{"nodeId":760200114,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3268231482,"text":"And that wasn't the only strange thing that happened around that time. Tracing it back, it all started with those rocks falling from the sky... Who knows? Maybe this tree's from the same place.","nextNodeIds":[760200115]},{"nodeId":760200115,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":27765986,"text":"Then there are those little shiny things that appear every now and then, rare as you like, those are. I figured there might be new kinds of fish, too. That's why I came out here — to try my luck.","nextNodeIds":[760200116]},{"nodeId":760200116,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":438149858,"text":"I used to have a fishing buddy who came out here, too, but he said he kept hearing strange singing. It spooked him so bad, he never came back. Hah, only half a Frostmoon Scion that one, but he inherited every one of their odd little habits.","nextNodeIds":[]},{"nodeId":760200117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1349485634,"text":"Sorry to bother you.","nextNodeIds":[760200118]},{"nodeId":760200118,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3711303042,"text":"No worries. There's not a single fish in sight anyway.","nextNodeIds":[]}]},{"talkId":7602007,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7602007","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7602007,"initDialog":760200701,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"QuestDialogue/WQ/NodKrai_76020/Q7602007","priority":5,"questId":76020,"showRandomTalkCount":0},"dialogs":[{"nodeId":760200701,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3621538282,"text":"Now that's strange...","nextNodeIds":[760200702]},{"nodeId":760200702,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3683210226,"text":"Did you see that? The tree just lit up all of a sudden, and these little things... Too bad they're not fish.","nextNodeIds":[760200703]},{"nodeId":760200703,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4115830298,"text":"So that thing in the center must be its root, huh? Paimon doesn't understand how it works, but now that it's all shiny, it looks way better than when it was dull.","nextNodeIds":[760200704]},{"nodeId":760200704,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1915828482,"text":"You explain what happened earlier...","nextNodeIds":[760200705]},{"nodeId":760200705,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2747866450,"text":"It's pretty hard to believe... But you've got no reason to spin me a yarn. Looks like that fishing buddy of mine, that half-Frostmoon Scion, was right after all.","nextNodeIds":[760200706]},{"nodeId":760200706,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":3302812394,"text":"But so what? They're just remnants of the past. Whatever they sing or say, it's not gonna stop us living folks from catching living fish.","nextNodeIds":[760200707]},{"nodeId":760200707,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":2617216834,"text":"Anyway, you folks are treasure hunters, aren't you? That thing you picked up earlier...","nextNodeIds":[760200708]},{"nodeId":760200708,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1381854570,"text":"This is the <color=#00E1FFFF>Proof of the Cognoscenti</color>? It looks like an ordinary feather...","nextNodeIds":[760200709]},{"nodeId":760200709,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":1345427578,"text":"A trader I know once said that if you collect five <color=#00E1FFFF>Proofs of the Cognoscenti</color>, you'll uncover that \"Great Treasure\" east of the moon and west of the sun. Who knows if it's true?","nextNodeIds":[760200710]},{"nodeId":760200710,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":4127112986,"text":"Still, a lot of treasure hunters seem to believe the stories. They're all rushing after it like crazy.","nextNodeIds":[760200711]},{"nodeId":760200711,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2824878178,"text":"Well, it's treasure, after all! If you ask Paimon, she's kinda curious too.","nextNodeIds":[760200712]},{"nodeId":760200712,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"Ilmari","textMapHash":470720378,"text":"If I were 20 years younger... Nah, even then, I'd still be out here fishing. That said, another day, another empty bucket...","nextNodeIds":[]}]}],"condi