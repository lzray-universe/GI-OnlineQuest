",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7052702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7052701,"initDialog":705270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30159,1419],"performCfg":"QuestDialogue/WQ/Mengde_70527/Q7052701","priority":5,"questId":70527,"showRandomTalkCount":0},"dialogs":[{"nodeId":705270101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4218013794,"text":"Why, hello there! Are you talking about stuff to eat?","nextNodeIds":[705270102,705270103]},{"nodeId":705270102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1473084714,"text":"Hello, Sara, Nazafarin.","nextNodeIds":[705270107]},{"nodeId":705270107,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"Sara","textMapHash":1740716674,"text":"Ah, we meet again, you two. Indeed, one might say that our conversation did concern food, but... *sigh*","nextNodeIds":[705270108]},{"nodeId":705270108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2899869594,"text":"What happened? Don't worry, you can tell us. Maybe we can even help!","nextNodeIds":[705270109]},{"nodeId":705270109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":608795674,"text":"#If it's about food, we'll definitely help! Isn't that right, {NICKNAME}?","nextNodeIds":[705270110,705270111]},{"nodeId":705270110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2521971282,"text":"Will work for good food!","nextNodeIds":[705270112]},{"nodeId":705270112,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2990036226,"text":"Ah, by Lesser Lord Kusanali, the two of you are as warm-hearted as ever!","nextNodeIds":[705270113]},{"nodeId":705270113,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1475915690,"text":"So this is the issue. After you rescued me previously, I returned to Sumeru and wrote a report about the condiment market in Liyue.","nextNodeIds":[705270114]},{"nodeId":705270114,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":133712314,"text":"Unexpectedly, I was approached by Lord Sangemah Bay, who expressed interest in purchasing the condiments that were the results of my research.","nextNodeIds":[705270115]},{"nodeId":705270115,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3184547954,"text":"This most charitable merchant even offered to support any further research on my part! Ah, such good fortune! I signed right away, if you must know...","nextNodeIds":[705270116]},{"nodeId":705270116,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1080086042,"text":"I then sent my dear friend Parvaneh a letter regarding this, and she gave me her full support.","nextNodeIds":[705270117]},{"nodeId":705270117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3564114922,"text":"So you're here in Mondstadt to start research into condiments?","nextNodeIds":[705270118]},{"nodeId":705270118,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1080580570,"text":"That is precisely right, my good Paimon. In truth, I should've already begun this research, but...","nextNodeIds":[705270119]},{"nodeId":705270119,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"Sara","textMapHash":2129142506,"text":"Nazafarin wants to work with us by adding her secret condiments to our dishes and letting our customers try them.","nextNodeIds":[705270120]},{"nodeId":705270120,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"Sara","textMapHash":1382775098,"text":"However, we have restaurant standards that we must maintain, lest we face complaints from long-time customers, so we can't take her up on that offer.","nextNodeIds":[705270121]},{"nodeId":705270121,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"Sara","textMapHash":2801935426,"text":"*sigh* We've actually been having this chat for a while now, but we haven't been able to come up with any better ideas.","nextNodeIds":[705270122]},{"nodeId":705270122,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"Sara","textMapHash":3806745258,"text":"I've been thinking that perhaps we could ask Jean to help. I'm sure she could find the best solution to this problem!","nextNodeIds":[705270123]},{"nodeId":705270123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":20029578,"text":"Seriously!? Jean's super busy all the time, you know! So, uh, could we not make her come down just for this? We'll help out!","nextNodeIds":[705270124]},{"nodeId":705270124,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3925512770,"text":"Aha, you see, what did I say? The two of you are Nazafarin's saviors, as always!","nextNodeIds":[705270125]},{"nodeId":705270125,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":3092262298,"text":"Right, then, there's no time to lose. Please, take this pot with you.","nextNodeIds":[705270126]},{"nodeId":705270126,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2548008154,"text":"We shall do it as we did previously. We will make the condiments, add them to dishes, and invite your friends to try them!","nextNodeIds":[705270127]},{"nodeId":705270127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2697237842,"text":"Hehe. That's right, we'll do it just like before. Paimon volunteers to be the first taste-tester, by the way!","nextNodeIds":[]},{"nodeId":705270111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3483200154,"text":"Eh, we'll do this for Paimon, I guess.","nextNodeIds":[705270112]},{"nodeId":705270103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2616321770,"text":"Hello there. And you are...","nextNodeIds":[705270104]},{"nodeId":705270104,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":827580746,"text":"Ah, by Lesser Lord Kusanali! Do you not recognize me anymore?","nextNodeIds":[705270105]},{"nodeId":705270105,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":2134486642,"text":"Perhaps my presence is too weak, like a speck of dust that might be blown away by a gust at any time...","nextNodeIds":[705270106]},{"nodeId":705270106,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","textMapHash":1087573602,"text":"But I, for my part, remember your great deed in helping me develop seasonings and inviting all and sundry to try them!","nextNodeIds":[705270107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30159"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7052701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"Nazafarin","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"Sara","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170527],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2954578566,"CHECNJEMEFE":{"30159":[1170]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70527/Q7052701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":705270101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7052701,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDM