ialogue/AQ/Mengde2_372/Q37201pre","priority":0,"questId":372,"showRandomTalkCount":0},"dialogs":[]},{"talkId":37203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["37203","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":37203,"initDialog":3720101,"nextRandomTalks":[],"nextTalks":[3720301],"npcId":[1160],"performCfg":"QuestDialogue/AQ/Mengde2_372/Q37201","priority":0,"questId":372,"showRandomTalkCount":0},"dialogs":[{"nodeId":3720101,"roleType":"TALK_ROLE_NPC","speakerId":1160,"speakerName":"Green Fellow","textMapHash":1479485675,"text":"Wait, you guys are...","nextNodeIds":[3720102]},{"nodeId":3720102,"roleType":"TALK_ROLE_NPC","speakerId":1160,"speakerName":"Green Fellow","textMapHash":908010499,"text":"Oh, that's right! You're the ones that scared Dvalin away.","nextNodeIds":[3720103]},{"nodeId":3720103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3553287539,"text":"Dvalin? Who's that?","nextNodeIds":[3720104,3720105]},{"nodeId":3720104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":62099963,"text":"That's Stormterror's real name.","nextNodeIds":[3720106]},{"nodeId":3720106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":808429787,"text":"Huh? ...Oh, right. Most people seem to call him \"Stormterror.\"","nextNodeIds":[3720107]},{"nodeId":3720107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1805715235,"text":"Why do you call him that... are you two meant to be close or something?","nextNodeIds":[3720108]},{"nodeId":3720108,"roleType":"TALK_ROLE_NPC","speakerId":1160,"speakerName":"Green Fellow","textMapHash":3283914387,"text":"Oh, so close...","nextNodeIds":[3720109]},{"nodeId":3720109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1933355915,"text":"#Hey, {NICKNAME}. Paimon thinks this guy has a screw loose...","nextNodeIds":[3720110,3720112]},{"nodeId":3720110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":60961563,"text":"Ahh... hi.","nextNodeIds":[3720111]},{"nodeId":3720111,"roleType":"TALK_ROLE_NPC","speakerId":1160,"speakerName":"Green Fellow","textMapHash":1770722091,"text":"Good day, outlander. Seems we meet again.","nextNodeIds":[3720113]},{"nodeId":3720113,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2507980395,"text":"I'm Venti the bard.","nextNodeIds":[3720114]},{"nodeId":3720114,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2850313339,"text":"Three-time winner of the \"Most Popular Bard of Mondstadt,\" to be precise.","nextNodeIds":[3720115]},{"nodeId":3720115,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":473549731,"text":"So, what do you need from me?","nextNodeIds":[3720116]},{"nodeId":3720116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3620806731,"text":"Given you recognize us, Paimon doesn't believe we need to explain any further.","nextNodeIds":[3720117]},{"nodeId":3720117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3255466627,"text":"Of course it's about Stormterror.","nextNodeIds":[3720118]},{"nodeId":3720118,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1252128627,"text":"Storm...?","nextNodeIds":[3720119]},{"nodeId":3720119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2163794747,"text":"Hey! Cut it with the amnesia act!","nextNodeIds":[3720120]},{"nodeId":3720120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":701226019,"text":"#{NICKNAME}, show it to him.","nextNodeIds":[3720121]},{"nodeId":3720121,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2093779283,"text":"Oh! Isn't this—","nextNodeIds":[3720122]},{"nodeId":3720122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3117584187,"text":"What!? The crystal has been purified!? When?","nextNodeIds":[3720123,3720124]},{"nodeId":3720123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":479028163,"text":"Not sure how this happened.","nextNodeIds":[3720125]},{"nodeId":3720125,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3923671651,"text":"Dvalin, he...","nextNodeIds":[3720126]},{"nodeId":3720126,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1344784851,"text":"The anguish he feels... has brought him to tears...","nextNodeIds":[3720127]},{"nodeId":3720127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3491356475,"text":"Tears...?","nextNodeIds":[]},{"nodeId":3720124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1772341523,"text":"The last time I checked, it was full of impurities.","nextNodeIds":[3720125]},{"nodeId":3720112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2858213651,"text":"I'm sorry, you are...?","nextNodeIds":[3720113]},{"nodeId":3720105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2089834899,"text":"Lisa told us already, weren't you listening?","nextNodeIds":[3720106]}]},{"talkId":3720301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["37203","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":3720301,"initDialog":3720101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1160],"performCfg":"QuestDialogue/AQ/Mengde2_372/Q37205","priority":0,"questId":372,"showRandomTalkCount":0},"dialogs":[{"nodeId":3720501,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":388681419,"text":"Ehhhh!?","nextNodeIds":[3720502]},{"nodeId":3720502,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4277719755,"text":"You... really do have some wonderful abilities...","nextNodeIds":[3720503]},{"nodeId":3720503,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4205941123,"text":"Someone like you is going to end up getting written into a bard's poem.","nextNodeIds":[3720504]},{"nodeId":3720504,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1118860251,"text":"#Oh, a hero so bright, should {M#he}{F#she} stand in the light. Though stand in the shade, and you'll be met by a blade...","nextNodeIds":[3720505]},{"nodeId":3720505,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2234416179,"text":"Alas... I've really not the time to compose a melody for you at this moment.","nextNodeIds":[3720506]},{"nodeId":3720506,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1223099811,"text":"Anyway, even if Dvalin is not taken down, his life will still wither away in the breeze...","nextNodeIds":[3720507]},{"nodeId":3720508,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2956696571,"text":"I also feel sorry for Dvalin.","nextNodeIds":[3720509]},{"nodeId":3720511,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4125855643,"text":"Is there anything I can do to help?","nextNodeIds":[3720512]},{"nodeId":3720514,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2196651243,"text":"As a knight, I suggest you turn yourself in along with the dragon.","nextNodeIds":[3720515]},{"nodeId":3720507,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":901216491,"text":"He'll burn himself out in the flames of anger...","nextNodeIds":[3720508,3720511,3720514]},{"nodeId":3720509,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3119345043,"text":"Thank you for that, and you for purifying the Teardrop Crystal.","nextNodeIds":[3720510]},{"nodeId":3720510,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1586177027,"text":"But I have my own plans for what is to follow.","nextNodeIds":[3720517]},{"nodeId":3720512,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1014468211,"text":"I really must thank you for purifying the Teardrop Crystal, it has helped me greatly.","nextNodeIds":[3720513]},{"nodeId":3720513,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":517804787,"text":"But I've already come to devise my own plan.","nextNodeIds":[3720517]},{"nodeId":3720515,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3199399811,"text":"Do you really deem that necessary?","nextNodeIds":[3720516]},{"nodeId":3720516,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1261269971,"text":"You can forget about me turning us in for now... I have another plan.","nextNodeIds":[3720517]},{"nodeId":3720517,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3206419403,"text":"Oh? And what plan would that be?","nextNodeIds":[3720518]},{"nodeId":3720518,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":217127691,"text":"Seeing this tear has brought to mind a friend so dear.","nextNodeIds":[3720519]},{"nodeId":3720519,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1576281579,"text":"Friend?","nextNodeIds":[3720520]},{"nodeId":3720520,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2623645067,"text":"Heh-heh, one must be going.","nextNodeIds":[3720521]},{"nodeId":3720521,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2771464403,"text":"Hey! Where're you running off to!?","nextNodeIds":[3720522]},{"nodeId":3720522,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":187136803,"text":"To the \"Symbol of Mondstadt's Hero.\" Bye-bye~","nextNodeIds":[3720523]},{"nodeId":3720524,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2514734147,"text":"This \"weirdo\" as you put it — we need to keep an eye on him...","nextNodeIds":[3720525]},{"nodeId":3720523,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2587380563,"text":"#Huh... {NICKNAME}, what do you make of that?","nextNodeIds":[3720524]},{"nodeId":3720526,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4172759691,"text":"You know...","nextNodeIds":[3720527]},{"nodeId":3720525,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1456755675,"text":"As far as he's concerned, you're a weirdo too ya know...","nextNodeIds":[3720526]},{"nodeId":3720528,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":427782331,"text":"His voice seems familiar...","nextNodeIds":[]},{"nodeId":3720527,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3460889931,"text":"Know what?","nextNodeIds":[3720528]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[3720301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100135","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[37201,37203,3720301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","count":22},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":17},{"roleType":"TALK_ROLE_PLAYER","spe