ePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7507113","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7507113,"initDialog":750711321,"nextRandomTalks":[],"nextTalks":[],"npcId":[21586,21460],"performCfg":"QuestDialogue/WQ/Natlan_75071/Q7507113","priority":5,"questId":75071,"showRandomTalkCount":0},"dialogs":[{"nodeId":750711321,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":854197066,"text":"You defeat the enemy and smash open the cage imprisoning the little Sumpter Beast. It leaps out of the cage and sends a happy cry your way.","nextNodeIds":[750711301]},{"nodeId":750711301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":83151794,"text":"Wow... Phew! Well, that's over. What a rush!","nextNodeIds":[750711302]},{"nodeId":750711302,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":2950427538,"text":"Shh—! Look...","nextNodeIds":[750711303]},{"nodeId":750711303,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":1514431754,"text":"*click*","nextNodeIds":[750711304]},{"nodeId":750711304,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":123902738,"text":"Perfect.","nextNodeIds":[750711305]},{"nodeId":750711305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":659717458,"text":"Whoa, they're getting along so well... And here Paimon thought that the Sumpter Beast might get eaten... or something.","nextNodeIds":[750711306]},{"nodeId":750711306,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":2980550162,"text":"Hehe, now, now. Tepetlisaurs might look fierce, but they're actually gentle souls.","nextNodeIds":[750711307]},{"nodeId":750711307,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":4021726826,"text":"Well, that's the photo taken, and here's your copy. Ah, yes, and your payment... here.","nextNodeIds":[750711308]},{"nodeId":750711308,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":3284754850,"text":"*sigh* Here I thought we might capture an intimate moment between a Tepetlisaur whelp and an adult — but it seems the Sumpter Beast was one step ahead!","nextNodeIds":[750711309]},{"nodeId":750711309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1078895970,"text":"Hehe, c'mon, Sumpter Beasts aren't that annoying. Paimon's sure you think so too!","nextNodeIds":[750711310]},{"nodeId":750711310,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":1704157386,"text":"Well, it doesn't matter what I think — it's the photography judging committee's opinion that counts!","nextNodeIds":[750711311]},{"nodeId":750711311,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":1032688586,"text":"Still... It might be too dangerous for our lil' Sumpter Beast to wander about in Natlan's unfamiliar environs. And I happen to need a partner to help carry some things...","nextNodeIds":[750711312]},{"nodeId":750711312,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":364054898,"text":"Why, I suppose I'll just have to take it in.","nextNodeIds":[750711313]},{"nodeId":750711313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3794244114,"text":"What about its original owner, then...?","nextNodeIds":[750711314]},{"nodeId":750711314,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":1931912146,"text":"Hmph. His own fault for leaving the little beastie out here in such a dangerous spot!","nextNodeIds":[750711317]},{"nodeId":750711317,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":1304152234,"text":"But anyway, enough of that! Fontaine's photo galleries, here I come! Haha... I trust you'll visit when the time comes as well, alright?","nextNodeIds":[750711318]},{"nodeId":750711318,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":3725681082,"text":"#My apologies, but I must leave this nation now. Farewell, {NICKNAME}, Paimon! Farewell, my little fellow!","nextNodeIds":[750711319]},{"nodeId":750711319,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1668082602,"text":"Rawr!","nextNodeIds":[750711320]},{"nodeId":750711320,"roleType":"TALK_ROLE_NPC","speakerId":21586,"speakerName":"Magnifico","textMapHash":3165205138,"text":"Also... catch! A memento, so you don't forget me, little ones!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7507113,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133509276,133509098"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["133509464"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133509174","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["3","133509018,4"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_G