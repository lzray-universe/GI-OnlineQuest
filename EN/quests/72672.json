nt":0},"dialogs":[{"nodeId":726720101,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":1385103226,"text":"Ugh, that Wakamurasaki... I shouldn't have let her know about Kageroumaru...","nextNodeIds":[726720102]},{"nodeId":726720102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":274952802,"text":"What's wrong?","nextNodeIds":[726720103]},{"nodeId":726720103,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3291471858,"text":"Oh, hello there, Traveler. Do you still remember the Ubiquity Net, by any chance?","nextNodeIds":[726720104]},{"nodeId":726720104,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":1969467346,"text":"After we settled the previous incident, I explained all that happened to a friend of mine.","nextNodeIds":[726720105]},{"nodeId":726720105,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":2056349658,"text":"Her name is Wakamurasaki, and she's... Well, she calls herself a \"designer.\"","nextNodeIds":[726720106]},{"nodeId":726720106,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":2995634642,"text":"She was quite inspired by the manner in which you used the net.","nextNodeIds":[726720107]},{"nodeId":726720107,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":2599513122,"text":"So she's been badgering me this whole time to help her look up new techniques with which she can continue modifying the Ubiquity Net...","nextNodeIds":[726720108]},{"nodeId":726720108,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":2726670378,"text":"I couldn't deal with all that nagging, so I did find her something new in that ancient collection of mine...","nextNodeIds":[726720109]},{"nodeId":726720109,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3444336962,"text":"If the fancy takes you, Traveler, go to her place. If I don't miss my guess, she's probably finished her modifications by now.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["3041"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7267202,"order":2,"stepDescription":"Look for Wakamurasaki","stepDescTextMapHash":2372351596,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["3226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7267202,7267251],"talks":[{"talkId":7267202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267202,"initDialog":726720201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3226],"performCfg":"","priority":5,"questId":72672,"showRandomTalkCount":0},"dialogs":[{"nodeId":726720201,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":2004966690,"text":"Well, that should certainly do it...","nextNodeIds":[726720202]},{"nodeId":726720202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1897633610,"text":"Hello there, are you Wakamurasaki?","nextNodeIds":[726720203]},{"nodeId":726720203,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":3166210258,"text":"That's me! What do you need?","nextNodeIds":[726720204]},{"nodeId":726720204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1794132802,"text":"Well, I'm here about the Ubiquity Net...","nextNodeIds":[726720205]},{"nodeId":726720205,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":4244701442,"text":"Oh, are you? ...Ohh, I remember now. You must be that Traveler! Sango told me about you.","nextNodeIds":[726720206]},{"nodeId":726720206,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":4213747826,"text":"The way in which you operated that Net was truly impressive. Inspiring, in fact!","nextNodeIds":[726720207]},{"nodeId":726720207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":444694778,"text":"I've heard that you've been modifying it.","nextNodeIds":[726720208]},{"nodeId":726720208,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":3870371538,"text":"Aye, that's right! Hehe... Sango dug up an all-new Onmyou technique for me and all!","nextNodeIds":[726720209]},{"nodeId":726720209,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":23091402,"text":"I used that technique to modify this net once again, and I name this new model the \"Omni-Ubiquity Net\"!","nextNodeIds":[726720210]},{"nodeId":726720210,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":3195860042,"text":"According to Sango, this technique is able to detain the essence of living creatures before using certain objects as media to recreate the shape of that living being.","nextNodeIds":[726720211]},{"nodeId":726720211,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":2662559802,"text":"She even says that the utmost achievement of such an Onmyoudou technique is to recreate a human essence!","nextNodeIds":[726720212]},{"nodeId":726720212,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":2181398546,"text":"Such essences can answer questions and will never lie.","nextNodeIds":[726720213]},{"nodeId":726720213,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":629102266,"text":"I must say that such a technique would be of unbelievable help to a detective like Sango!","nextNodeIds":[726720214]},{"nodeId":726720214,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":556523626,"text":"You know what? I actually think that's why she told me about that technique and allowed me to make changes to the net...","nextNodeIds":[726720215]},{"nodeId":726720215,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":4164271882,"text":"Ah, ah! But don't you go around telling anyone that. I'm only telling you this because you and Sango are friends, alright?","nextNodeIds":[726720216,726720217]},{"nodeId":726720216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3197014642,"text":"I—Is it really that amazing?","nextNodeIds":[726720218]},{"nodeId":726720218,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":3558083994,"text":"Um, not yet...","nextNodeIds":[726720219]},{"nodeId":726720219,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":2554665682,"text":"No matter how I modify it, this net can only be used to recreate the essences of small creatures. It has no effect on humans whatsoever.","nextNodeIds":[726720220]},{"nodeId":726720220,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":1940400906,"text":"You know what, Traveler? Take this net with you. Who knows, seeing you in action might give me some inspiration again!","nextNodeIds":[726720221]},{"nodeId":726720221,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":1018417522,"text":"Here, take it with you — and remember, it's the Omni-Ubiquity Net now, not just the Ubiquity Net!","nextNodeIds":[726720222]},{"nodeId":726720222,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":1244459770,"text":"Go on, then, go catch a few lil' animals to test it out!","nextNodeIds":[]},{"nodeId":726720217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1549907098,"text":"Were your modifications successful?","nextNodeIds":[726720218]}]},{"talkId":7267251,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267251,"initDialog":726725101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3041],"performCfg":"","