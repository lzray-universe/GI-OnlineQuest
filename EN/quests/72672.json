lse,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267204,"initDialog":726720401,"nextRandomTalks":[],"nextTalks":[],"npcId":[3226],"performCfg":"","priority":5,"questId":72672,"showRandomTalkCount":0},"dialogs":[{"nodeId":726720401,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":4161949258,"text":"How did it go? Well?","nextNodeIds":[726720402]},{"nodeId":726720402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2608296394,"text":"It was a one-and-done...","nextNodeIds":[726720403]},{"nodeId":726720403,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":3308419450,"text":"Hmm... I suppose that was inevitable...","nextNodeIds":[726720404]},{"nodeId":726720404,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":1191128706,"text":"Like I said before, this technique can detain the essence of a small animal, but if you want to retain that essence and recreate that animal, you will need a separate medium.","nextNodeIds":[726720405]},{"nodeId":726720405,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":3854452946,"text":"I integrated those techniques into the Net, such that it is also the essence-retention device and the recreation medium.","nextNodeIds":[726720406]},{"nodeId":726720406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2408102114,"text":"That sounds... complicated...","nextNodeIds":[726720407]},{"nodeId":726720407,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":2907223650,"text":"Well, basically, each net can only be used once.","nextNodeIds":[726720408]},{"nodeId":726720408,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":1879759890,"text":"This is an issue that I haven't been able to solve yet, either. If the medium can't stand repeated use, the cost of this device will be way too high...","nextNodeIds":[726720409]},{"nodeId":726720409,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":4142670898,"text":"I'll continue doing research into this net and try to fix the problem as soon as possible.","nextNodeIds":[726720410]},{"nodeId":726720410,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":4073374282,"text":"If you still need Omni-Ubiquity Nets, you can come find me.","nextNodeIds":[726720411]},{"nodeId":726720411,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":4010696618,"text":"And uh... even though these nets can catch small animals, they're a bit of a fuss to put together...","nextNodeIds":[726720412]},{"nodeId":726720412,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":1242898218,"text":"So, next time you want one of these nets, you'll have to pay me a nominal fee.","nextNodeIds":[726720413]},{"nodeId":726720413,"roleType":"TALK_ROLE_NPC","speakerId":3226,"speakerName":"Wakamurasaki","textMapHash":3992224458,"text":"Relax! You're Sango's friend, I won't charge you too much. You'll get a good rate, I promise!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7267204","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["3","429"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["3226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7267205,"order":5,"stepDescription":"Talk to Sango","stepDescTextMapHash":1027391124,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267205,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["3041"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7267205],"talks":[{"talkId":7267205,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267205","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267205,"initDialog":726720501,"nextRandomTalks":[],"nextTalks":[],"npcId":[3041],"performCfg":"","priority":5,"questId":72672,"showRandomTalkCount":0},"dialogs":[{"nodeId":726720501,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3608100410,"text":"Did you find Wakamurasaki?","nextNodeIds":[726720502]},{"nodeId":726720502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2543175994,"text":"So, here's the deal with the Omni-Ubiquity Net...","nextNodeIds":[726720503]},{"nodeId":726720503,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":1670350770,"text":"\"Omni-Ubiquity Net\"... You know what? It's not a bad name. Still, that technique...","nextNodeIds":[726720504]},{"nodeId":726720504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2985834610,"text":"Can that technique really detain a human's essence?","nextNodeIds":[726720505]},{"nodeId":726720505,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":4213260122,"text":"Uh, no. That's not possible.","nextNodeIds":[726720506]},{"nodeId":726720506,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":966252138,"text":"There are only records of such an onmyoudou technique existing. Any practicum has long disappeared into the mists of time.","nextNodeIds":[726720507]},{"nodeId":726720507,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3007501722,"text":"The technique that I taught Wakamurasaki can only do that for small animals.","nextNodeIds":[726720508]},{"nodeId":726720508,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":699005306,"text":"Wait, then why didn't you tell her?","nextNodeIds":[726720509]},{"nodeId":726720509,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":1750140330,"text":"Oh, that? I just wanted Wakamurasaki to help me spread a certain something around.","nextNodeIds":[726720510]},{"nodeId":726720510,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":72863002,"text":"\"Bantan Sango Detective Agency's president is currently asking someone to create a net using Kamuna Onmyoudou that can make people tell the truth.\"","nextNodeIds":[726720511]},{"nodeId":726720511,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3551646426,"text":"The long-lost Kamuna Onmyoudou, the Bantan Sango Detective Agency, and a net that can indeed detain the essences of small creatures.","nextNodeIds":[726720512]},{"nodeId":726720512,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":2757489202,"text":"Put all three together, and you have an urban legend that both sounds impressive, and that actually has a grain of truth to it.","nextNodeIds":[726720513]},{"nodeId":726720513,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3082084586,"text":"For most people, these urban legends are just little stories... But for criminals who already have the seed of fear in their hands, such tales are not so simple.","nextNodeIds":[726720514]},{"nodeId":726720514,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2520868834,"text":"Ah, so that's how it is...","nextNodeIds":[726720515]},{"nodeId":726720515,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3983803042,"text":"The other side of it is... Well, Wakamurasaki was starting to get on my nerves with that whole \"find me the strongest onmyoudou technique ever!\" nonsense.","nextNodeIds":[726720516]},{"nodeId":726720516,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":1488672930,"text":"I told her many, many times that such things don't exist, but she wouldn't listen! So I had no choice but to give her *something* to work with so she'd get off my back.","nextNodeIds":[726720517]},{"nodeId":726720517,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3939054610,"text":"What if Wakamurasaki doesn't tell anyone about this?","nextNodeIds":[726720518]},{"nodeId":726720518,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":3953243786,"text":"Im-possible. She couldn't keep a secret to save her life. Trust me, I know her waaay too well...","nextNodeIds":[726720519]},{"nodeId":726720519,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":1275087946,"text":"Either way, thanks for making the trip on my behalf. Take this. Consider it payment for the errand run.","nextNodeIds":[726720520]},{"nodeId":726720520,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"Sango","textMapHash":1074806002,"text":"Archon, I hope she doesn't come to bother me again