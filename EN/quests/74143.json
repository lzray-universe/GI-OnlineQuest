mTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7414304","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7414304,"initDialog":741430401,"nextRandomTalks":[],"nextTalks":[7414305],"npcId":[1005,21034,21172],"performCfg":"QuestDialogue/WQ/Fontaine_74143/Q7414304","priority":5,"questId":74143,"showRandomTalkCount":0},"dialogs":[{"nodeId":741430401,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":1815582418,"text":"Ah, it's you two.","nextNodeIds":[741430402]},{"nodeId":741430402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3266888882,"text":"Geez, so it's you, Caterpillar! You had Paimon worried there...","nextNodeIds":[741430403]},{"nodeId":741430403,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3935393554,"text":"#Whoa! It's {M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon! Oh, this is such fun! My favorite people are all here!","nextNodeIds":[741430404]},{"nodeId":741430404,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3136024834,"text":"And Grandpa made a big and sweet birthday cake for me, too!","nextNodeIds":[741430405]},{"nodeId":741430405,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":342846578,"text":"Oh, so today's your birthday! Happy birthday! Um... is there any cake left?","nextNodeIds":[741430406]},{"nodeId":741430406,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":975509922,"text":"Hmm... We already finished it!","nextNodeIds":[741430407]},{"nodeId":741430407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":241356642,"text":"What? Are you serious? C'mon...","nextNodeIds":[741430408]},{"nodeId":741430408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":452438962,"text":"Caterpillar...","nextNodeIds":[741430409]},{"nodeId":741430409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3149934370,"text":"Are you alright?","nextNodeIds":[741430410]},{"nodeId":741430410,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2395973290,"text":"Don't worry about me. Today's a happy day, so let's not talk about anything that might dampen the mood...","nextNodeIds":[741430411]},{"nodeId":741430411,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2332360090,"text":"#Anyway, thanks, {NICKNAME}.","nextNodeIds":[741430412]},{"nodeId":741430412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1166325914,"text":"What are you talking about?","nextNodeIds":[741430413]},{"nodeId":741430413,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3016633418,"text":"Haha, it's nothing. I just feel like the last time the members of the Kids Team got together was... a long, long time ago.","nextNodeIds":[741430414]},{"nodeId":741430414,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3870762242,"text":"But why did you bring me here, Cater? That was weird, not to mention how Grandpa Earnshaw was scared when he saw you. Even Hero, Prince, and Princess were scared!","nextNodeIds":[741430415]},{"nodeId":741430415,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":2237477562,"text":"Whenever Grandpa hears me talking about you, he always says that he'd love to invite you to our place as a guest.","nextNodeIds":[741430416]},{"nodeId":741430416,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1641241682,"text":"Well, considering his appearance... Caterpillar, why didn't you want to transform into a human, y'know, like before?","nextNodeIds":[741430417]},{"nodeId":741430417,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2809119738,"text":"It's not that I don't want to. It's just...","nextNodeIds":[741430418]},{"nodeId":741430418,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1081698874,"text":"?","nextNodeIds":[741430419]},{"nodeId":741430419,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":1803624226,"text":"He's great just the way he is! Just a moment ago, I was sitting on his shoulder, and I easily picked some Bulle Fruits. Also, it's amazing how he runs like the wind!","nextNodeIds":[741430420]},{"nodeId":741430420,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":389844434,"text":"Lanoire, you must remember what I'm about to tell you: If you ever come across someone who looks like me, do not approach them. Run away quickly. Such individuals are very dangerous.","nextNodeIds":[741430421]},{"nodeId":741430421,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3725493570,"text":"Really? But you're not bad at all.","nextNodeIds":[741430422]},{"nodeId":741430422,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":831193258,"text":"Lanoire, give me your word, promise me.","nextNodeIds":[741430423]},{"nodeId":741430423,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":570497130,"text":"Initially, you thought that Caterpillar might use his \"tricks\" to influence Lanoire.\\nHowever, he doesn't do that, and instead, simply waits earnestly for Lanoire's response.","nextNodeIds":[741430424]},{"nodeId":741430424,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3969937642,"text":"But... okay. I promise, Cater.","nextNodeIds":[741430425]},{"nodeId":741430425,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":1984284522,"text":"But... but if I do so, how will I be able to recognize you in the future?","nextNodeIds":[741430426]},{"nodeId":741430426,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":832249034,"text":"Oh, right! You know, Cater, I didn't realize how big the world was until I left the Fortress of Meropide. Every day, I walk in different directions, but I still haven't seen any walls yet.","nextNodeIds":[741430427]},{"nodeId":741430427,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":2614477098,"text":"When the sun is out, it's hot, and when there's no sun at night, it gets cool. Oh, and at night, there's also a breeze blowing towards the lake, and it feels chilly, not like a fan at all. Why is that?","nextNodeIds":[741430428]},{"nodeId":741430428,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":665765122,"text":"Also, Hero always looks up at me and Grandpa when he's lying next to us, and he sometimes kicks stuff with his hind legs when he's sleeping. It's so funny!","nextNodeIds":[741430429]},{"nodeId":741430429,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3743411210,"text":"And... and when I walk on the grass without wearing shoes, the little blades of grass tickle between my toes and it feels kinda prickly. I thought that grass would be soft like they describe in books!","nextNodeIds":[741430430]},{"nodeId":741430430,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":1099608818,"text":"Oh, and the flowers that Estienne gave me? There are so many of them outside. But those flowers have roots that firmly grow into the ground. Why is that?","nextNodeIds":[741430431]},{"nodeId":741430431,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3132743250,"text":"This world is so big and strange, and there are so many different colors of light. I have soooo many things I want to tell you and so-so-so many more things that I want to hear you tell me, too.","nextNodeIds":[741430432]},{"nodeId":741430432,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":1236566050,"text":"But how can I find you? Ugh, I feel like the mage's apprentice who wanted to find the little fish so badly.","nextNodeIds":[741430433]},{"nodeId":741430433,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2455465146,"text":"So you still remember that story.","nextNodeIds":[741430434]},{"nodeId":741430434,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":705706834,"text":"Of course. There's no way I would forget! I've been waiting for you to come back and finish telling me the whole thing! So, in the end, did the apprentice find the little fish?","nextNodeIds":[741430435]},{"nodeId":741430435,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":4077373802,"text":"Well, many, many years later...","nextNodeIds":[741430436]},{"nodeId":741430436,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":4197696234,"text":"The foolish apprentice plucked up the courage to bid farewell to the great mage, left the workshop, and embarked on a journey to find the little fish.","nextNodeIds":[741430437]},{"nodeId":741430437,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3631635242,"text":"But he had never seen the vast ocean before, so he had no idea what the little fish's homeland was like. Therefore, he had to ask for directions along the way...","nextNodeIds":[741430438]},{"nodeId":741430438,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":898620282,"text":"He asked the reeds by the river, and upon hearing his story, the reeds laughed so hard that they bent over at the waist.","nextNodeIds":[741430439]},{"nodeId":741430439,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":4005408546,"text":"\"You are looking for the ocean,\" said the reeds. \"It is a place much wider and grander than any river, the destination where rivers flow into.\"","nextNodeIds":[741430440]},{"nodeId":741430440,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3840511802,"text":"He followed the flowing river and eventually reached the vast ocean. However, the ocean was so vast that he didn't even know where to begin.","nextNodeIds":[741430441]},{"nodeId":741430441,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":1720957874,"text":"So he asked the Violetgold Angler Gull resting on the pier. It was astonished by his story and dropped the fries it was holding in its beak in surprise.","nextNodeIds":[741430442]},{"nodeId":741430442,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":1791924658,"text":"\"Buddy, this is an impossible task,\" the gull said. \"No one has ever, and I mean EVER, tried to find a common little fish in the vast ocean. Besides, who knows, it might have already...\"","nextNodeIds":[741430443]},{"nodeId":741430443,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":1728607658,"text":"The apprentice silenced the seagull by stuffing its mouth with bread, disregarding it and its noisy companions. Then, he continued along the coastline, asking and searching as he went.","nextNodeIds":[741430444]},{"nodeId":741430444,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3829495866,"text":"Since he was a foolish apprentice, he only knew how to search in the most foolish way. He spent a lot of time learning how to dive, and again and again, he swam further and deeper into the ocean...","nextNodeIds":[741430445]},{"nodeId":741430445,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":1102857610,"text":"He must've found it in the end! If you wish hard enough and you don't give up, your wish will definitely come true! That's what Grandpa told me.","nextNodeIds":[741430446]},{"nodeId":741430446,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2263737210,"text":"You like stories with happy endings... Well, Grandpa Earnshaw is right. Despite being a foolish apprentice, he finally managed to find that little fish in the most foolish way.","nextNodeIds":[741430447]},{"nodeId":741430447,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2776759954,"text":"When he found it, the little fish was swimming freely in the water with its family amidst an ever-shifting school of fish. But the apprentice recognized it at first glance, even among countless others of its kind.","nextNodeIds":[741430448]},{"nodeId":741430448,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":269526762,"text":"\"Finally, I found you...\" The apprentice had fulfilled his wish, but his emotions were not as jubilant as he had imagined. Instead, he felt somewhat bewildered.","nextNodeIds":[741430449]},{"nodeId":741430449,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3428531034,"text":"The school of fish curiously surrounded him, urging him to explain the whole story. He clumsily explained everything, and finally, as if relieved of a burden, he released a long stream of bubbles into the water.","nextNodeIds":[741430450]},{"nodeId":741430450,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":485748882,"text":"\"I must apologize twice,\" the apprentice said. \"Once for not summoning the courage to help you when you sought my assistance in the past, and once for the abruptness of my visit here...\"","nextNodeIds":[741430451]},{"nodeId":741430451,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3301887378,"text":"\"After finally seeing you again, I realized how selfish I have been... I thought that if I could apologize to you in person, I could forgive my past self.\"","nextNodeIds":[741430452]},{"nodeId":741430452,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":4158904138,"text":"\"What does it matter?\" The little fish's response surprised the apprentice. \"You see, in the past, you couldn't help me, but I have still returned to my homeland, back to the embrace of my family.\"","nextNodeIds":[741430453]},{"nodeId":741430453,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":969037474,"text":"\"I haven't been harmed, so you don't need to seek anyone's forgiveness.\"","nextNodeIds":[741430454]},{"nodeId":741430454,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3057478922,"text":"\"You have spent so much time and effort over such a trivial matter. I can't decide whether to call you upright or foolish. But even if you are foolish, we don't mind being friends with foolish humans...\"","nextNodeIds":[741430455]},{"nodeId":741430455,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":4090843306,"text":"Wah! So, does that mean they finally became friends? What happens then?","nextNodeIds":[741430456]},{"nodeId":741430456,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3423218714,"text":"Then? Well, they became the very best of friends.","nextNodeIds":[741430457]},{"nodeId":741430457,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1729473666,"text":"Huh? That's it?","nextNodeIds":[741430458]},{"nodeId":741430458,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":743214738,"text":"So, Cater, is that how the story ends...?","nextNodeIds":[741430459]},{"nodeId":741430459,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":1810960498,"text":"Mm-hmm, that's the end of my story. If a good story doesn't end in the right place, it will lose the fun. Heroes will become evil dragons.","nextNodeIds":[741430460]},{"nodeId":741430460,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2190064738,"text":"I've heard of stories that didn't want to end. And when they finally did, they were with but horrible endings, and everyone in these stories had their hearts broken. Those were bad stories.","nextNodeIds":[741430461]},{"nodeId":741430461,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":643259930,"text":"But, dear Lanoire, the story of you and your adventure is still ongoing. Happy birthday. And one day, you'll have to share your story with me, won't you?","nextNodeIds":[741430462]},{"nodeId":741430462,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":3533986682,"text":"Mm-hmm... I promise I will, Cater.","nextNodeIds":[741430463]},{"nodeId":741430463,"roleType":"TALK_ROLE_NPC","speakerId":21034,"speakerName":"Lanoire","textMapHash":4108307658,"text":"I'll find you, and then I'll tell you tons of stories! Then, I'll make you the biggest, yummiest birthday cake ever.","nextNodeIds":[741430464]},{"nodeId":741430464,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":3461779018,"text":"Ahaha, I think we can skip the cake. I don't even know my birthday, just the day I woke up.","nextNodeIds":[741430465]},{"nodeId":741430465,"roleType":"TALK_ROLE_NPC","speakerId":21172,"speakerName":"Caterpillar","textMapHash":2167564154,"text":"...Thank you, Lanoire. It's because—","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7414305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133401641,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["133408939","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21034"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":7414305,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7414305,"initDialog":741430501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21033,5203,5061],"performCfg":"QuestDialogue/WQ/Fontaine_74143/Q7414305","priority":0,"questId":74143,"showRandomTalkCount":0},"dialogs":[{"nodeId":741430501,"roleType":"TALK_ROLE_NPC","speakerId":21033,"speakerName":"Earnshaw","textMapHash":3586136154,"text":"Lanoire! Lanoire! Are you alright?","nextNodeIds":[741430502]},{"nodeId":741430502,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":2052013234,"text":"Grandpa! I...","nextNodeIds":[741430503]},{"nodeId":741430503,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3167015970,"text":"Ah...","nextNodeIds":[741430504]},{"nodeId":741430504,"roleType":"TALK_ROLE_NPC","speakerId":21033,"speakerName":"Earnshaw","textMapHash":355760490,"text":"#Ahh, that's great. Thank you, {NICKNAME}, Paimon. Thanks to both of you...","nextNodeIds":[741430505,741430506]},{"nodeId":741430505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1402036930,"text":"...","nextNodeIds":[741430507]},{"nodeId":741430507,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1379806826,"text":"But... Well, it was just...","nextNodeIds":[741430508]},{"nodeId":741430508,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1894440018,"text":"Paimon.","nextNodeIds":[741430509]},{"nodeId":741430509,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4227861754,"text":"...Um, but... Well, Paimon gets it! Oh, thank goodness you're okay, Lanoire! That's such a relief!","nextNodeIds":[741430510]},{"nodeId":741430510,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":3266853082,"text":"#...Thank you, Grandpa. And thank you, {M#Mr.}{F#Ms.} {NICKNAME} and Paimon!","nextNodeIds":[741430511]},{"nodeId":741430511,"roleType":"TALK_ROLE_NPC","speakerId":21033,"speakerName":"Earnshaw","textMapHash":603672858,"text":"Please don't run off like that anymore! I was so worried...","nextNodeIds":[741430512]},{"nodeId":741430512,"roleType":"TALK_ROLE_NPC","speakerId":21033,"speakerName":"Earnshaw","textMapHash":3559228130,"text":"I'm so sorry for having you go through all this trouble.","nextNodeIds":[741430513]},{"nodeId":741430513,"roleType":"TALK_ROLE_NPC","speakerId":5061,"speakerName":"Charlene","textMapHash":1878415290,"text":"It's fine, as long as she's okay...","nextNodeIds":[741430514]},{"nodeId":741430514,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":784076754,"text":"(Are you really okay, though, Lanoire...)","nextNodeIds":[741430515]},{"nodeId":741430515,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":2493995234,"text":"#(Now I get it — what Cater said, and why {M#Mr.}{F#Ms.} {NICKNAME} didn't say anything to Grandpa.)","nextNodeIds":[741430516]},{"nodeId":741430516,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":2534696178,"text":"(So, I won't tell Grandpa either. I won't make Grandpa worry, because I'm a good girl.)","nextNodeIds":[741430517]},{"nodeId":741430517,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1999317850,"text":"(You're a clever girl, Lanoire.)","nextNodeIds":[741430518]},{"nodeId":741430518,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":1854243882,"text":"(...)","nextNodeIds":[741430519]},{"nodeId":741430519,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":720315746,"text":"(No, I'm not. I don't understand what Cater meant in the end, and why he thanked me. I mean, he's the one who's been helping me all along.)","nextNodeIds":[741430520]},{"nodeId":741430520,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":1651737034,"text":"(When I grow a little older, I'm going to find him, and I'm gonna ask him. Then, I'm going to say lots and lots of things to him, and feed him the yummiest birthday cake.)","nextNodeIds":[741430521]},{"nodeId":741430521,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":3105841946,"text":"#({M#Mr.}{F#Ms.} {NICKNAME}, Ms. Paimon, when I grow up, can we go find Cater together, please?)","nextNodeIds":[741430522,741430523]},{"nodeId":741430522,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2980882730,"text":"We'll talk about it when you grow up.","nextNodeIds":[741430524]},{"nodeId":741430524,"roleType":"TALK_ROLE_NPC","speakerId":5203,"speakerName":"Lanoire","textMapHash":325861346,"text":"Okay, deal.","nextNodeIds":[741430525]},{"nodeId":741430525,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2241610970,"text":"They leave.","nextNodeIds":[]},{"nodeId":741430523,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1698649162,"text":"Fine...","nextNodeIds":[741430524]},{"nodeId":741430506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2140061770,"text":"You don't need to thank us.","nextNodeIds":[741430507]}]}],"qu