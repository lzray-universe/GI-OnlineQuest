],"NOCCOBOFKHP":20005,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1100403],"talks":[{"talkId":1100403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100403","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100403,"initDialog":110040301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1012],"performCfg":"QuestDialogue/LQ/Xiangling1_11004/Q1100403","priority":5,"questId":11004,"showRandomTalkCount":0},"dialogs":[{"nodeId":110040301,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3434978758,"text":"♪ Got myself a Cryo Regisvine, cook it up for dinner time... ♪","nextNodeIds":[110040302]},{"nodeId":110040302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3269059062,"text":"♪ Even better if it's paired with a bit of swine... ♪","nextNodeIds":[110040303,110040305]},{"nodeId":110040303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1238859206,"text":"Stop encouraging her!","nextNodeIds":[110040304]},{"nodeId":110040304,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1785979038,"text":"Lighten up a little! What in the world could bring more joy than finding rare ingredients?","nextNodeIds":[110040307]},{"nodeId":110040307,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3081107358,"text":"Wait, there's something else here too!","nextNodeIds":[110040308]},{"nodeId":110040308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3068387454,"text":"This must be the boar that hunter was chasing.","nextNodeIds":[110040309]},{"nodeId":110040309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3306680750,"text":"But Paimon's never seen one with this pattern before.","nextNodeIds":[110040310]},{"nodeId":110040310,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1336515446,"text":"Where have I seen this before? Hmm... Aha! It was in the \"Historia Naturalis Liyue\"!","nextNodeIds":[110040311]},{"nodeId":110040311,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1574727206,"text":"This pattern is unmistakable. It belongs to a breed of boar that went extinct 300 years ago!","nextNodeIds":[110040312]},{"nodeId":110040312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3078188886,"text":"Wow! How is this one still alive after so long!?","nextNodeIds":[110040313,110040315]},{"nodeId":110040313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2208491350,"text":"Accidental cryopreservation?","nextNodeIds":[110040314]},{"nodeId":110040314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1383497670,"text":"Could be...","nextNodeIds":[110040317]},{"nodeId":110040317,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3563760294,"text":"I read that this boar was hunted to extinction because its meat was so highly prized.","nextNodeIds":[110040318]},{"nodeId":110040318,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3170030550,"text":"Cryo Regisvine and extinct boar. Not one, but two priceless treasures!","nextNodeIds":[110040319]},{"nodeId":110040319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1132666926,"text":"This'll be our winning ticket.","nextNodeIds":[110040320]},{"nodeId":110040320,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3484003550,"text":"Right. Now let's get back to Springvale!","nextNodeIds":[]},{"nodeId":110040315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1219891366,"text":"Won the genetic lottery?","nextNodeIds":[110040316]},{"nodeId":110040316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4156148014,"text":"Paimon's pretty sure that's not really possible...","nextNodeIds":[110040317]},{"nodeId":110040305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2679130190,"text":"♪ Wash 'em down with a glass of wine... ♪","nextNodeIds":[110040306]},{"nodeId":110040306,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1472872806,"text":"Hee-hee... Your version just ruins it.","nextNodeIds":[110040307]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1010,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[3,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_MY_WORLD","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["3","125"],"PAINLIBBLDK":"QUEST_EXEC_LOCK_POINT"},{"LNHLPKELCAL":["13"],"PAINLIBBLDK":"QUEST_EXEC_REMOVE_TRIAL_AVATAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE"