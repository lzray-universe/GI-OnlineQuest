{"mainQuestId":73529,"title":"Determined and Elegant Battle Dance?","description":"In the main area of the Pavilion of Hermits, a strange \"Blade Dancer\" seems to have sensed something important from you...","titleTextMapHash":739231271,"descTextMapHash":2984557598,"mainQuestExcel":{"mainQuestId":73529,"titleTextMapHash":739231271,"title":"Determined and Elegant Battle Dance?","descTextMapHash":2984557598,"description":"In the main area of the Pavilion of Hermits, a strange \"Blade Dancer\" seems to have sensed something important from you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2023,"luaPath":"Actor/Quest/WQ73529","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2023,"chapterId":0,"descTextMapHash":2984557598,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73529,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2689747801,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73529","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173529],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":739231271,"type":"WQ","unlockDescTextMapHash":1124496070}},"flow":[{"subQuestId":7352901,"order":1,"stepDescription":"Talk to the strange \"dancer\"","stepDescTextMapHash":1568822300,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30407"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352901],"talks":[{"talkId":7352901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7352901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352901,"initDialog":735290101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30407],"performCfg":"QuestDialogue/WQ/Sumeru_73529/Q7352901","priority":5,"questId":73529,"showRandomTalkCount":0},"dialogs":[{"nodeId":735290101,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":1805354650,"text":"I felt it.","nextNodeIds":[735290102]},{"nodeId":735290102,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":1896036810,"text":"Every step you take is overflowing with an intoxicating aura, as though you were performing a dazzling battle dance.","nextNodeIds":[735290103]},{"nodeId":735290103,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":1972830834,"text":"As the incandescent edge flashes across your face, the reflections in your eyes form a radiant golden flame...","nextNodeIds":[735290104]},{"nodeId":735290104,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":253079634,"text":"As you dance gracefully around the forbidding fortress of ice, your steps weave an enchanting rhythm...","nextNodeIds":[735290105]},{"nodeId":735290105,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":1709101738,"text":"And as the wooden walls of cities come crashing down, or as you face down armies of iron giants, you nimbly catch every fleeting figure, even those that the fastest Kamera lens or pen could not hope to capture...","nextNodeIds":[735290106,735290107]},{"nodeId":735290106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3162739066,"text":"No idea what you're saying!","nextNodeIds":[735290108]},{"nodeId":735290108,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":270396898,"text":"Such fervor and courage, what an admirable, indomitable spirit! No mistake, we are kindred spirits bound by destiny!","nextNodeIds":[735290109]},{"nodeId":735290109,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":3485718418,"text":"I am Lafeinte, the Blade Dancer. Might I be so bold as to inquire by which esteemed names you are known?","nextNodeIds":[735290110]},{"nodeId":735290110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1167702170,"text":"Geez, he sure loves drama...","nextNodeIds":[735290111]},{"nodeId":735290111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2769315002,"text":"#Paimon is Paimon, and this is {NICKNAME}...","nextNodeIds":[735290112]},{"nodeId":735290112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":628556378,"text":"Paimon is well aware just how awesome we are! But Mr. Lafeinte, Paimon has no idea what you were trying to say!","nextNodeIds":[735290113]},{"nodeId":735290113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1152278650,"text":"Why call yourself the Blade Dancer? Paimon doesn't see a sword, and you don't look much like a dancer either...","nextNodeIds":[735290114]},{"nodeId":735290114,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":2439684042,"text":"Such an outrageous question! Surely Her Excellency Paimon is merely seeking to test my mental fortitude!","nextNodeIds":[735290115]},{"nodeId":735290115,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":967473850,"text":"Rather than relying on the limited capabilities of a steel sword, the blade should be concealed in one's heart. When the time comes, your inner determination can be infused into any object, freeing your tactics from mundane shackles and restrictions.","nextNodeIds":[735290116]},{"nodeId":735290116,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":3153748826,"text":"Never care too much for the clothes one wears! The moment one steps onto the battlefield, victory can only be obtained and control maintained through one's graceful stances and elegant skills...","nextNodeIds":[735290117,735290118,735290119]},{"nodeId":735290117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4196015370,"text":"He seems to be saying...","nextNodeIds":[735290120]},{"nodeId":735290120,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":1589675418,"text":"Precisely so! But do not forget that \"determination\" and \"elegance\" are the key words that will set the tone for the entire dance.","nextNodeIds":[735290121]},{"nodeId":735290121,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":4016487994,"text":"Hold...! I see it now! You two have reached a level of being that far transcends me, and you have completely embodied these two critical concepts.","nextNodeIds":[735290122]},{"nodeId":735290122,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":506347322,"text":"Now please, enter through this gateway, and set foot about the storied stage of the \"Dance of Flashing Thought\"! Exhibit the exalted stage of dance you have achieved!","nextNodeIds":[735290123]},{"nodeId":735290123,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":4264300258,"text":"Thanks to Miss Idyia, during the \"Dance of Flashing Thought,\" various opponents will appear as Phantoms, trying to smash you into pieces.","nextNodeIds":[735290124]},{"nodeId":735290124,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":367644914,"text":"The moment the \"determination\" within your heart is finally fully expressed, you will be able to unsheathe that greatest of blades from the depths of your heart, and use your honed will to defeat even the strongest of foes.","nextNodeIds":[735290125,735290126]},{"nodeId":735290125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1312352530,"text":"I think I get it!","nextNodeIds":[735290127]},{"nodeId":735290127,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":1168034538,"text":"Just so! This has been a harmonious interaction between kindred souls indeed!","nextNodeIds":[735290128]},{"nodeId":735290128,"roleType":"TALK_ROLE_NPC","speakerId":30407,"speakerName":"Lafeinte","textMapHash":360330162,"text":"I shall meditate in contemplative silence here! May you experience true bliss during this unique battle dance!","nextNodeIds":[735290129]},{"nodeId":735290129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1815052058,"text":"Uh, why does it seem like you two eventually... agreed on something?","nextNodeIds":[735290130]},{"nodeId":735290130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2931686178,"text":"And Paimon just realized that Mr. Lafeinte seemed to be talking about how much we kick butt, right?","nextNodeIds":[735290131]},{"nodeId":735290131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":139768970,"text":"Is he just running a combat domain and wants to see us fight?","nextNodeIds":[735290132]},{"nodeId":735290132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3286565650,"text":"Paimon thinks that at least he doesn't have any bad intentions... Mr. Lafeinte just has a unique way of thinking, comparing fighting to dancing.","nextNodeIds":[735290133]},{"nodeId":735290133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2269080458,"text":"He can make even the simplest thing sound really deep! That's a skill too... With that ability, he probably bluffs anyone he meets!","nextNodeIds":[735290134,735290135]},{"nodeId":735290134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":931830690,"text":"I'm good at bluffing, too.","nextNodeIds":[735290136]},{"nodeId":735290136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2673421978,"text":"Hehe! That's just another one of his skills! If you talked with him more, you'd see right through him, like Paimon!","nextNodeIds":[735290137]},{"nodeId":735290137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2604443738,"text":"So, uh, let's give him a good show and show off our skills in this... Dance of Flashing Thought, was it?","nextNodeIds":[735290138]},{"nodeId":735290138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3395117938,"text":"#Given how much Mr. Lafeinte has already complimented us, Paimon wonders just what he'll say once he's actually seen us fight... {NICKNAME}, keep notes when he talks, maybe we can use his words someday!","nextNodeIds":[]},{"nodeId":735290135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2835115130,"text":"Doesn't matter, he showered us with compliments.","nextNodeIds":[735290136]},{"nodeId":735290126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3213623074,"text":"It's a hearty combat trial!","nextNodeIds":[735290127]},{"nodeId":735290118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3385810890,"text":"Clothes don't matter?","nextNodeIds":[735290120]},{"nodeId":735290119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3699217578,"text":"And anything can be a weapon?","nextNodeIds":[735290120]},{"nodeId":735290107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":714593410,"text":"But it sounds like a compliment, so keep going!","nextNodeIds":[735290108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC