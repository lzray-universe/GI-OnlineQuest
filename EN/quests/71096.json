riority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7109602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7109602,"initDialog":710960201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2061,1005],"performCfg":"QuestDialogue/WQ/Liyue_71096/Q7109602","priority":6,"questId":71096,"showRandomTalkCount":0},"dialogs":[{"nodeId":710960201,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3180836970,"text":"Three more.","nextNodeIds":[710960202]},{"nodeId":710960202,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2205570730,"text":"I shall gratefully take the Archaic Stones submitted by our two \"civic-minded citizens.\"","nextNodeIds":[710960203]},{"nodeId":710960203,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":4033041418,"text":"I didn't expect you to find three of them so quickly. And they are much better in quality than the ones I've previously seen.","nextNodeIds":[710960204]},{"nodeId":710960204,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3659997186,"text":"*sigh*... They remind me of the one that I used to have.","nextNodeIds":[710960205]},{"nodeId":710960205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2939494850,"text":"You have an Archaic Stone?","nextNodeIds":[710960206,710960207]},{"nodeId":710960206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4213311226,"text":"Then why send us to look for it?","nextNodeIds":[710960208]},{"nodeId":710960208,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3145754762,"text":"I mean I USED to have one.","nextNodeIds":[710960209]},{"nodeId":710960209,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3822815154,"text":"My old man once handled a batch of ores at Shenglu Hall. That stone was just a leftover remnant and its quality was poor, so he gave it to me as a toy.","nextNodeIds":[710960210]},{"nodeId":710960210,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2036174906,"text":"We had been arguing all the time back then. I never had a job, and to make it worse, I spent most of my time at Yanshang Teahouse. As such, I ended up in heavy debt — and in distress too...","nextNodeIds":[710960211]},{"nodeId":710960211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3983554786,"text":"Ah...","nextNodeIds":[710960212]},{"nodeId":710960212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1378386634,"text":"That feels a bit wrong...","nextNodeIds":[710960213]},{"nodeId":710960213,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":4257097394,"text":"Well, who hasn't done a stupid thing or two when they were young? Anyway, when I was helpless...","nextNodeIds":[710960214]},{"nodeId":710960214,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3592181642,"text":"Someone recognized my Archaic Stone and offered a good price. To me, it was no big deal — a stone in exchange for some Mora to get me out of my immediate predicament. A fair trade I'd say.","nextNodeIds":[710960215]},{"nodeId":710960215,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1833681658,"text":"Yet my father brought this up the other day and asked, \"Muning, where did you put the stone that I gave you?\"","nextNodeIds":[710960216]},{"nodeId":710960216,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3257136474,"text":"All I could tell him was, \"It's just a stone. I've long lost it.\"","nextNodeIds":[710960217]},{"nodeId":710960217,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":436724306,"text":"Though I said so, I couldn't help wondering what if I hadn't sold the stone — then I could show it to Father when he mentioned it...","nextNodeIds":[710960218]},{"nodeId":710960218,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2304396138,"text":"...Forget it. It's no use wondering about the what-if now.","nextNodeIds":[710960219]},{"nodeId":710960219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2960017010,"text":"At least the prodigal son has returned.","nextNodeIds":[710960220]},{"nodeId":710960220,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":938982138,"text":"You are right... It's just that I still have a long way to go before I can clear my debt.","nextNodeIds":[710960221]},{"nodeId":710960221,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2734874234,"text":"I've digressed. If you find more, please bring them to me.","nextNodeIds":[710960222,710960223]},{"nodeId":710960222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2593536634,"text":"Aren't these enough?","nextNodeIds":[710960224]},{"nodeId":710960224,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":953378194,"text":"Bring me three more. Three more would be enough.","nextNodeIds":[710960225]},{"nodeId":710960225,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3064326018,"text":"Archaic Stone is a rare ore. If Huishan Hall wants more, I seriously doubt if I can find any here in The Chasm.","nextNodeIds":[]},{"nodeId":710960223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3673378066,"text":"Just how many do you need?","nextNodeIds":[710960224]},{"nodeId":710960207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1453217666,"text":"C'mon, hand in yours first.","nextNodeIds":[710960208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7109602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[{"talkId":7109601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority"