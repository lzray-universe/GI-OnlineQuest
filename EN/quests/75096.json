{"mainQuestId":75096,"title":"","description":"","titleTextMapHash":1690897879,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":75096,"titleTextMapHash":1690897879,"title":"","descTextMapHash":2639138630,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ75096","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2639138630,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75096,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4068215873,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75096","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175096],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1690897879,"type":"WQ","unlockDescTextMapHash":2417322254}},"flow":[{"subQuestId":7509601,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7509601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7509601,7509602],"talks":[{"talkId":7509601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7509601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7509601,"initDialog":750960101,"nextRandomTalks":[],"nextTalks":[],"npcId":[6133],"performCfg":"QuestDialogue/WQ/Natlan_75096/Q7509601","priority":5,"questId":75096,"showRandomTalkCount":0},"dialogs":[{"nodeId":750960101,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":1051857282,"text":"You're back! You were gone quite a while, too. So, how did it go? Run into any problems?","nextNodeIds":[750960102]},{"nodeId":750960102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1739026906,"text":"Well, we sure got a lot done down there...","nextNodeIds":[750960103]},{"nodeId":750960103,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3048677362,"text":"You tell Poca what happened down by the roots of the Flamegranate Tree...","nextNodeIds":[750960104]},{"nodeId":750960104,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":3037300466,"text":"So he really pulled it off... Brilliant. Now we can tell Wayna that we won't be needing to trouble the Masters of the Night-Wind or the Collective of Plenty about this matter.","nextNodeIds":[750960105]},{"nodeId":750960105,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":3179467354,"text":"What did I tell you? I knew he could do it.","nextNodeIds":[750960106]},{"nodeId":750960106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4160899218,"text":"Huh, so you're saying that Wayna already knew there was something wrong with the Flamegranate Tree's roots...?","nextNodeIds":[750960107]},{"nodeId":750960107,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":784551570,"text":"Of course! We're all well aware of what's been going on with the Mother Flamegranate Tree. Tisoc's the only one who'd think that no one else had noticed and go about trying to solve the problem all by himself...","nextNodeIds":[750960108]},{"nodeId":750960108,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":2754112650,"text":"Anyway, despite being so set in his way of thinking, there's something quite endearing about his obstinacy.","nextNodeIds":[750960109]},{"nodeId":750960109,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":428451466,"text":"#Haha, and once again, thanks to the two of you, {NICKNAME} and Paimon! In truth though, I'd heard your names a long time ago — after all, as couriers, staying in the loop is how we make a living!","nextNodeIds":[750960110]},{"nodeId":750960110,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":3553056682,"text":"So I simply gave you a little nudge along the way... by leaving that pass somewhere you'd come across it.","nextNodeIds":[750960111]},{"nodeId":750960111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3035389146,"text":"Oh, so that was you!","nextNodeIds":[750960112]},{"nodeId":750960112,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":713065290,"text":"Haha, indeed. Well, I'm guessing that blockhead already rewarded you, so what kind of person would I be if I gave you any less than he did? Here, take these!","nextNodeIds":[750960113]},{"nodeId":750960113,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","textMapHash":3106373530,"text":"And please, with this reward, let our... past grievances be forgotten, eh?","nextNodeIds":[]}]},{"talkId":7509602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7509601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7509602,"initDialog":750960201,"nextRandomTalks":[],"nextTalks":[],"npcId":[6132],"performCfg":"","priority":5,"questId":75096,"showRandomTalkCount":0},"dialogs":[{"nodeId":750960201,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":3416728674,"text":"Ah, looks like the Mountain King Flamegranates have finally ripened up. What a relief!","nextNodeIds":[750960202]},{"nodeId":750960202,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":2828251018,"text":"Oh, it's you two! What's up? If you're planning on going in, be quick about it. Don't let anyone from the tribe see you!","nextNodeIds":[750960203,750960208,750960212]},{"nodeId":750960203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4120880570,"text":"About the Mountain King...","nextNodeIds":[750960204]},{"nodeId":750960204,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":1434730858,"text":"Oh, you want to hear more about the Mountain King?","nextNodeIds":[750960205]},{"nodeId":750960205,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":922942162,"text":"The Mountain King Kongamato is an extraordinary Saurian who once fought the Abyss, side-by-side with a legendary hero. Thus, he has the tribe's unanimous respect.","nextNodeIds":[750960206]},{"nodeId":750960206,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":3867097434,"text":"There are people whose job it is to pick and offer up these Flamegranates for the Mountain King's consumption. However, some say that in secret, other Yumkasaurs bring them to the Mountain King too...","nextNodeIds":[750960207]},{"nodeId":750960207,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":865863570,"text":"Which is why the Mountain King is so much more, uhh... \"Robustly built,\" shall we say?","nextNodeIds":[]},{"nodeId":750960208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2033668802,"text":"About the Flamegranates...","nextNodeIds":[750960209]},{"nodeId":750960209,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":1721109594,"text":"Well, you've certainly come to the right person. Flamegranates are phlogiston plants, and truly remarkable ones at that. The courage it must take for a plant to extend its roots down into liquid phlogiston... simply boggles the mind.","nextNodeIds":[750960210]},{"nodeId":750960210,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":1574897098,"text":"And the fruit they produce is full of phlogiston, so they make great food for Yumkasaurs... As long as they don't chuck them around, that is...","nextNodeIds":[750960211]},{"nodeId":750960211,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":3249947674,"text":"They do tend to explode on heavy impact, after all...","nextNodeIds":[]},{"nodeId":750960212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3432126810,"text":"Just passing through...","nextNodeIds":[750960213]},{"nodeId":750960213,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","textMapHash":119590482,"text":"Oh, is that so? Sure you don't want to go in and take a look at the Mountain King Flamegranates... even just a little peek? I always feel much better after taking a good, long look at them... so if you ever feel troubled, I'd recommend you do the same.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7509601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7509601,7509602],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"Tisoc","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"Poca","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3},{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[175096],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75096/Q7509601","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":f