ame":"Paimon","textMapHash":1212137386,"text":"#{NICKNAME}, should we rearrange it? Just like how Salsa taught us!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7402302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["QTravel06_Salsa_Dicheng"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7402302,"order":3,"stepDescription":"Place the Hydro Elemental Monument again","stepDescTextMapHash":1889841972,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"wq7402302"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["QTravel06_Salsa_Dicheng","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"wq7402302"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["QTravel06_Salsa_Dicheng","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7402303,"order":4,"stepDescription":"Talk to the person in green","stepDescTextMapHash":3776739916,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7402301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21036"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7402301,7402303],"talks":[{"talkId":7402301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7402303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7402301,"initDialog":740230101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21035,21036],"performCfg":"QuestDialogue/WQ/Fontaine_74016/Q7402301","priority":5,"questId":74023,"showRandomTalkCount":0},"dialogs":[{"nodeId":740230101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2773107266,"text":"Phew, this looks so much better. Salsa would be proud of us if she saw this, don't you think so, Traveler?","nextNodeIds":[740230102]},{"nodeId":740230102,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":3687210818,"text":"Robbers! A robbery in broad daylight!","nextNodeIds":[740230103]},{"nodeId":740230103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1505075442,"text":"Huh!? Robbers? Where?","nextNodeIds":[740230104]},{"nodeId":740230104,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":244232154,"text":"I'm talking about you two! Not only did you destroy my masterpiece, you even took the chest...","nextNodeIds":[740230105,740230107]},{"nodeId":740230105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3187680002,"text":"So it really was the work of an Adventurers' Guild member...","nextNodeIds":[740230106]},{"nodeId":740230106,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":3139306410,"text":"What work on earth? I should be asking you guys about what you did!","nextNodeIds":[740230109]},{"nodeId":740230109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":111658562,"text":"So, these ugly things are your \"masterpieces\"?","nextNodeIds":[740230110]},{"nodeId":740230110,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":4268027186,"text":"The audacity! What do you mean \"ugly things\"? Haven't you heard of installation art?","nextNodeIds":[740230111]},{"nodeId":740230111,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":1828330914,"text":"Looks like Fontaine's art education still has a long way to go... Oh, but you two don't look like you're from Fontaine.","nextNodeIds":[740230112]},{"nodeId":740230112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1642524938,"text":"#That's because we are not from Fontaine. Paimon's Paimon, and {M#he}{F#she} is {NICKNAME}. We are also members of the Adventurers' Guild.","nextNodeIds":[740230113,740230115]},{"nodeId":740230113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":781850602,"text":"We are members of an evil organization... *sob*","nextNodeIds":[740230114]},{"nodeId":740230114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2460252218,"text":"Yeah, but we don't have to wear uniforms. So we're not bad guys in green, yay!","nextNodeIds":[740230117]},{"nodeId":740230117,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":349889602,"text":"I'm Ubu, an adventurer and installation artist. Seeing how you guys are making zero sense, I'm guessing you're often up to crazy shenanigans... I won't pursue this matter this time.","nextNodeIds":[740230118]},{"nodeId":740230118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1738807714,"text":"Huh? Actually...","nextNodeIds":[740230119]},{"nodeId":740230119,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":787174890,"text":"What? I need to restore the work, so if you want to say thank you, do it quickly.","nextNodeIds":[740230120]},{"nodeId":740230120,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":602151250,"text":"I have nothing to thank you for, but I sure have a million things I wanna yell at you for!","nextNodeIds":[740230121]},{"nodeId":740230121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2226202778,"text":"Salsa!","nextNodeIds":[740230122]},{"nodeId":740230122,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":455946570,"text":"With me around, you don't have to be scared, Paimon!","nextNodeIds":[740230123]},{"nodeId":740230123,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":3161811682,"text":"Evil green guy, we have destroyed all of the traps laid by you! Stop trying to ruin our beautiful Fontaine with your sinister traps!","nextNodeIds":[740230124]},{"nodeId":740230124,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":3231924714,"text":"Ruin? Wait, \"destroyed all\"? ...You destroyed all of my artworks!?","nextNodeIds":[740230125]},{"nodeId":740230125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2761087338,"text":"Umm, we didn't exactly destroy them... We just rearranged them to suit the surrounding scenery...","nextNodeIds":[740230126]},{"nodeId":740230126,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":2365225194,"text":"You...! You brats and plebeians! How could you hope to understand art! To turn my installation art, my works into something so mediocre and mundane...","nextNodeIds":[740230127]},{"nodeId":740230127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1440709330,"text":"But is it really art? Paimon doesn't know much about it, but can you really call something that looks so out of place art?","nextNodeIds":[740230128]},{"nodeId":740230128,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":2229464674,"text":"Of course, the boundaries of art are set by the artist. A work created by an artist is naturally called a work of art.","nextNodeIds":[740230129]},{"nodeId":740230129,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":445634450,"text":"Who's the artist?","nextNodeIds":[740230130]},{"nodeId":740230130,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":4049688258,"text":"It is I, Ubu, the extraordinary installation artist.","nextNodeIds":[740230131]},{"nodeId":740230131,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":3766914810,"text":"In that case, as the founder of the \"Alliance of Artists to Overthrow the Evil Organization and Protect the Future of Fontaine,\" I declare that I do not recognize it as art.","nextNodeIds":[740230132]},{"nodeId":740230132,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":2434400930,"text":"\"Overthrow the E—\" ...What?","nextNodeIds":[740230133,740230135]},{"nodeId":740230133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4134269418,"text":"Overthrow the Evil Organization.","nextNodeIds":[740230134]},{"nodeId":740230134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1923882610,"text":"It refers to the Adventurers' Guild that is ruining the scenery with, umm, installation art...","nextNodeIds":[740230136]},{"nodeId":740230136,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":3384379970,"text":"What a joke, I've never heard of such an alliance. Kid, what gives you the right to say that my work isn't art?","nextNodeIds":[740230137]},{"nodeId":740230137,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":3674501906,"text":"I'm a painter, so you could say I'm an artist. Of course I'm qualified.","nextNodeIds":[740230138]},{"nodeId":740230138,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":1900172642,"text":"Huh? Look, kid, being an artist isn't some child's play. You can't say you're an artist just because you want to become one. You gotta have works that are recognized by people...","nextNodeIds":[740230139]},{"nodeId":740230139,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":3842940394,"text":"So what makes you qualified? Your works, the installation art you speak of... Those evil traps? Do people clap when they see them?","nextNodeIds":[740230140]},{"nodeId":740230140,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":2036593762,"text":"That's because there are too many plebeians who can't comprehend the charm of my works. True art is always the least understood...","nextNodeIds":[740230141,740230143]},{"nodeId":740230141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":650414826,"text":"You should start from making art that people can actually understand.","nextNodeIds":[740230142]},{"nodeId":740230142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3951085378,"text":"Yeah, if no one understands, it's either too avant-garde, or simply...","nextNodeIds":[740230145]},{"nodeId":740230145,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":1145764986,"text":"No... It can't be! My works are perfect! There is absolutely nothing wrong with them! You guys just don't understand, people just don't understand...","nextNodeIds":[740230146]},{"nodeId":740230146,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":3619582946,"text":"Darn it, I'm not giving up! This isn't over!","nextNodeIds":[740230147]},{"nodeId":740230147,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":631692978,"text":"Ubu stumbles away...","nextNodeIds":[740230148]},{"nodeId":740230148,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapHash":1266283370,"text":"What a stubborn enemy! But I'm not giving up either! The future of Fontaine's art rests on my shoulders!","nextNodeIds":[740230149]},{"nodeId":740230149,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1975796162,"text":"We all have a goal to work towards.","nextNodeIds":[740230150]},{"nodeId":740230150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4093969002,"text":"Is this a good thing? It probably is, right?","nextNodeIds":[]},{"nodeId":740230143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3070027986,"text":"Simply put, no one understands it at all.","nextNodeIds":[740230144]},{"nodeId":740230144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3536852458,"text":"Which sounds like a failure...","nextNodeIds":[740230145]},{"nodeId":740230135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":440382562,"text":"Basically, we have to take you down.","nextNodeIds":[740230136]},{"nodeId":740230115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3858963394,"text":"Well hello there, buddy.","nextNodeIds":[740230116]},{"nodeId":740230116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":627501458,"text":"Paimon doesn't think you can call someone buddy when you don't even know their name...","nextNodeIds":[740230117]},{"nodeId":740230107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":730529050,"text":"Wait, it's the evil green guy!","nextNodeIds":[740230108]},{"nodeId":740230108,"roleType":"TALK_ROLE_NPC","speakerId":21036,"speakerName":"Ubu","textMapHash":4153463322,"text":"Hah, a robber who is spouting nonsense. What a day it is today!","nextNodeIds":[740230109]}]},{"talkId":7402303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7402303","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7402303,"initDialog":740230301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21035],"performCfg":"QuestDialogue/WQ/Fontaine_74023/Q7402303","priority":5,"questId":74023,"showRandomTalkCount":0},"dialogs":[{"nodeId":740230301,"roleType":"TALK_ROLE_NPC","speakerId":21035,"speakerName":"Salsa","textMapH