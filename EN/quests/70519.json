{"mainQuestId":70519,"title":"Favonian Goodies","description":"After going through a fair bit of effort, the starting capital for your charitable activities has been obtained. It's time to open for business...","titleTextMapHash":2426874303,"descTextMapHash":2511319918,"mainQuestExcel":{"mainQuestId":70519,"titleTextMapHash":2426874303,"title":"Favonian Goodies","descTextMapHash":2511319918,"description":"After going through a fair bit of effort, the starting capital for your charitable activities has been obtained. It's time to open for business...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2016,"luaPath":"Actor/Quest/WQ70519","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2016,"chapterId":0,"descTextMapHash":2511319918,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70519,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2209646681,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70519","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170519],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2426874303,"type":"WQ","unlockDescTextMapHash":578392054}},"flow":[{"subQuestId":7051901,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051901,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051901,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7051902,"order":2,"stepDescription":"Go back to the shop","stepDescTextMapHash":222305844,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30234"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7051902,7051903],"talks":[{"talkId":7051902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7051902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7051902,"initDialog":705190201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30234,10095,10011],"performCfg":"QuestDialogue/WQ/Vintage_70519/Q7051902","priority":5,"questId":70519,"showRandomTalkCount":0},"dialogs":[{"nodeId":705190201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":196311442,"text":"Bernhard, we've got all the funds you need!","nextNodeIds":[705190202]},{"nodeId":705190202,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":2868244274,"text":"Already? Wow, you sure work fast!","nextNodeIds":[705190203]},{"nodeId":705190203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2037739138,"text":"Everything's in place, we just need to open shop now.","nextNodeIds":[705190204]},{"nodeId":705190204,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":1570904266,"text":"Alright, our suppliers are ready and waiting — just give me a moment.","nextNodeIds":[705190205]},{"nodeId":705190205,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2248374514,"text":"Bernhard pays the suppliers with Fairbrew Jellies, and before long the shop is complete.","nextNodeIds":[705190206]},{"nodeId":705190206,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":3955040386,"text":"What do you think? Not bad, huh? Of course, if you're in a creative mood at any point, feel free to redecorate the place however you want.","nextNodeIds":[705190207]},{"nodeId":705190207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3029737122,"text":"It's great! Really looks the part!","nextNodeIds":[705190208]},{"nodeId":705190208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":385930154,"text":"The shop definitely needs a name though! Hmm, how about... \"Favonian Goodies\"?","nextNodeIds":[705190209,705190211]},{"nodeId":705190209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1524226218,"text":"Indubitably Paimonial.","nextNodeIds":[705190210]},{"nodeId":705190210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1349718322,"text":"...Paimon will take that as a compliment! Okay, Bernhard, so what do you need us to do next?","nextNodeIds":[705190213]},{"nodeId":705190213,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":1514810482,"text":"Gathering the funds was a monumental task. It must have been very demanding. So don't worry about all the other menial things that need doing — I'll handle those.","nextNodeIds":[705190214]},{"nodeId":705190214,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":2951391522,"text":"You both have more experience than me. It'd be great if you could figure out the more managerial-level things like our sales strategy, SOPs, USPs, QC principles, KPIs...","nextNodeIds":[705190215]},{"nodeId":705190215,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":1919073778,"text":"I've gotta be honest — I hear other store owners using these terms, but I can't say I really know what they mean. I just know they're important... which means they're probably best dealt with by you.","nextNodeIds":[705190216]},{"nodeId":705190216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3128235426,"text":"So in other words, we'll be the shop owners who make the big business decisions, and you'll be the shop assistant doing all the actual day-to-day work?","nextNodeIds":[705190217]},{"nodeId":705190217,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":1683440146,"text":"Yep, my strength is in execution. Your shop, your rules! I am but a tool to be used however you see fit!","nextNodeIds":[705190218]},{"nodeId":705190218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3578487170,"text":"Very selfless...","nextNodeIds":[705190219]},{"nodeId":705190219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2676898050,"text":"Umm... That sounds a little extreme. This is for charity, remember? We're not some cutthroat business executives...","nextNodeIds":[705190220]},{"nodeId":705190220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1663783714,"text":"Alright, why don't you go ahead and take a tight five, Bernhard? The two of us need to touch base on strategy.","nextNodeIds":[705190221]},{"nodeId":705190221,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":513229746,"text":"You and Paimon analyze the product offering and hash out some core strategic action points...","nextNodeIds":[705190222]},{"nodeId":705190222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3667061794,"text":"Okay, we have a clear corporate mission statement: Our goal is to become the best darn snack shop in the whole festival market!","nextNodeIds":[705190223]},{"nodeId":705190223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2547740114,"text":"Now, let's all prepare to give 110% as we receive our first customers...","nextNodeIds":[705190224]},{"nodeId":705190224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3631534730,"text":"We're open for business!","nextNodeIds":[705190225]},{"nodeId":705190225,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2547616842,"text":"#{NICKNAME}? Paimon? What a surprise!","nextNodeIds":[705190226]},{"nodeId":705190226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2199311954,"text":"Mona and Fischl! You came to check out the market, huh?","nextNodeIds":[705190227]},{"nodeId":705190227,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":2555991834,"text":"Hm! One was wise to follow one's intuition, and ask Lady Megistus to join the Prinzessin on a tour of this folk festival...","nextNodeIds":[705190228]},{"nodeId":705190228,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":1427115786,"text":"Extraordinary events may yet unfold even on this unexceptional autumn day... Splendid, most splendid!","nextNodeIds":[705190229]},{"nodeId":705190229,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":1611183042,"text":"Mein Fräulein is battling hard to suppress the euphoria in her voice. Seeing you here has put her in the most wonderful mood...","nextNodeIds":[705190230]},{"nodeId":705190230,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":1571803618,"text":"O—Oz! Spare us your gratuitous embellishments!","nextNodeIds":[705190231]},{"nodeId":705190231,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":169815018,"text":"Hehehe, maybe you should leave me to do the explaining.","nextNodeIds":[705190232]},{"nodeId":705190232,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2979736866,"text":"Not long ago, Her Highness had a very nice dream, and took it as an sign that something good was about to happen. Naturally, Her Highness' first thought was to come to me for some astrological guidance on the matter.","nextNodeIds":[705190233]},{"nodeId":705190233,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":3967120138,"text":"She also noticed that the Weinlesefest was in full flow, and asked if I was interested in checking it out with her.","nextNodeIds":[705190234]},{"nodeId":705190234,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1094991866,"text":"I, of course, agreed. I can take advantage of the festival-period discounts to purchase some bulk supplies for my present column-writing spree.","nextNodeIds":[705190235]},{"nodeId":705190235,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1428450058,"text":"I must admit, without Her Highness' reminder, the Weinlesefest may well have completely passed me by...","nextNodeIds":[705190236]},{"nodeId":705190236,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":2293041282,"text":"Lady Megistus, might Her Highness remind you that the dream of which you speak occurred no less than nine days ago...","nextNodeIds":[705190237]},{"nodeId":705190237,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":2632619314,"text":"And that only after awaiting Lady Megistus's return letter in vain for all this time did one have no recourse but to rap most furiously upon the door to thy abode...","nextNodeIds":[705190238]},{"nodeId":705190238,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1575047050,"text":"Wait... it's been nine days already? NINE DAYS!? Where did the time go!","nextNodeIds":[705190239]},{"nodeId":705190239,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":1794532178,"text":"In light of the great importance this manuscript has to you, Lady Megistus, one shall not hold thy inattentiveness to the passage of time against thee.","nextNodeIds":[705190240]},{"nodeId":705190240,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":652837186,"text":"But I would implore you, Lady Megistus, to be attentive at least to the nigh-overflowing mailbox outside your door. There appear to be many others whose letters go unanswered.","nextNodeIds":[705190241]},{"nodeId":705190241,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":600436922,"text":"Wow, Mona... you were so immersed in your research that you forgot all about the time, stopped checking your mail, and almost missed out on a huge festival.","nextNodeIds":[705190242,705190243]},{"nodeId":705190242,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":446207202,"text":"Sometimes, it's very important to not be disturbed.","nextNodeIds":[705190244]},{"nodeId":705190244,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2999171090,"text":"Ahem! Anyway! Time is of the essence, I have a lot of bulk-buying to do!","nextNodeIds":[705190245]},{"nodeId":705190245,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1358627802,"text":"Speaking of which — it's quite a surprise to see you running your own shop. And a snack shop at that, the most important kind!","nextNodeIds":[705190246]},{"nodeId":705190246,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":937215554,"text":"Oh, actually, we're just helping someone else out, hehe. Feel free to browse around!","nextNodeIds":[705190247]},{"nodeId":705190247,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1549335770,"text":"Is there anything you'd like to purchase?","nextNodeIds":[705190248]},{"nodeId":705190248,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":3844041594,"text":"Let me think... Can you recommend anything that, um... goes well with a drink?","nextNodeIds":[705190249]},{"nodeId":705190249,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":926718834,"text":"Sure can! If you've got the hangries, then look no further! Just let Paimon check the menu...","nextNodeIds":[705190250]},{"nodeId":705190250,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":433912146,"text":"Wait a sec... \"goes well with a drink\"?","nextNodeIds":[705190251]},{"nodeId":705190251,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":569901466,"text":"Uh-oh... is the writing going that badly? You know drinking isn't gonna solve your problems, right?","nextNodeIds":[705190252]},{"nodeId":705190252,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":861985474,"text":"As it happens, mein Fräulein has been visiting Mona quite frequently as of late. It is possible that Lady Megistus is feeling the pressure from the constant interruptions.","nextNodeIds":[705190253,705190255]},{"nodeId":705190253,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1923585394,"text":"Hang in there, Mona!","nextNodeIds":[705190254]},{"nodeId":705190254,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":527320138,"text":"...","nextNodeIds":[705190257]},{"nodeId":705190257,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2331236130,"text":"No, no, it's nothing like that. This has nothing to do with drinking or with Fischl's visits, you all need to calm down...","nextNodeIds":[705190258]},{"nodeId":705190258,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":3226579826,"text":"Recently, Her Highness invited me to try her signature cold cut platter... Sorry, I mean Die Heilige Sinfonie!","nextNodeIds":[705190259]},{"nodeId":705190259,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2220103514,"text":"It had such a unique taste and every bite was so sumptuous, before I realized it, I had finished the entire plate...","nextNodeIds":[705190260]},{"nodeId":705190260,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2998631106,"text":"Wow... Well, an empty plate is the highest compliment you can give to the chef.","nextNodeIds":[705190261]},{"nodeId":705190261,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":92830394,"text":"Die Heilige Sinfonie is an excellent dish. It's filling, full of energy, and has a long shelf life. And if I'm not mistaken, it's often paired with alcohol, yes?","nextNodeIds":[705190262]},{"nodeId":705190262,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2611909794,"text":"It is in almost every respect a far superior dish to the so-called \"Satisfying Salad,\" the sole exception being the steep price...","nextNodeIds":[705190263]},{"nodeId":705190263,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":199855370,"text":"Fortunately, however, the Weinlesefest is upon us. A festival during which not only are wines sold at discounted prices, but also wine-related food products.","nextNodeIds":[705190264]},{"nodeId":705190264,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":629046426,"text":"This opportunity is a godsend. I cannot let it slip by.","nextNodeIds":[705190265]},{"nodeId":705190265,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":3330759442,"text":"Rejoice, Lady Megistus! That dish was but a spontaneous creation hastily made in a moment of need while on a royal excursion. You shall have many opportunities to enjoy far finer culinary delights than this...","nextNodeIds":[705190266]},{"nodeId":705190266,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":2593798362,"text":"Mein Fräulein means to say that this dish represents a mere fraction of her full capabilities.","nextNodeIds":[705190267]},{"nodeId":705190267,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1134583354,"text":"But of course! Far be it from me to suggest that the true breadth of Her Highness' culinary brilliance can be displayed in a single dish...","nextNodeIds":[705190268]},{"nodeId":705190268,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":75489810,"text":"However, I cannot expect the sovereign to serve her subject... Ugh, what I mean is, I can't keep letting you cook for me when you're a guest in my home...","nextNodeIds":[705190269]},{"nodeId":705190269,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1620513378,"text":"At the very least, I should have something more than salad in store for when people come around... With any luck, I'll be able to find something to your taste here...","nextNodeIds":[705190270]},{"nodeId":705190270,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":1295886562,"text":"Huh? Mona... is that really what this is all about?","nextNodeIds":[705190271]},{"nodeId":705190271,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":2354403202,"text":"Mein Fräulein, might I suggest alternative phrasing that would be more faithful to your style? Perhaps \"long had I foreseen this,\" or \"thou needst not fret over thy affinity for salad.\"","nextNodeIds":[705190272]},{"nodeId":705190272,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":57610714,"text":"Ahem! ...Most indeed! Lady Megistus!","nextNodeIds":[705190273]},{"nodeId":705190273,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":2063572050,"text":"You have long since earned the recognition of your Prinzessin... Devote yourself to deciphering the secrets of the starry sky. You need not spend precious hours in search of additional ways to delight me.","nextNodeIds":[705190274]},{"nodeId":705190274,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":3332790578,"text":"Don't worry, I won't always be as busy as this... it'll be quite nice to work on some other skills when I have the time.","nextNodeIds":[705190275]},{"nodeId":705190275,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":507340538,"text":"In that case...","nextNodeIds":[705190276]},{"nodeId":705190276,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1753276346,"text":"...Allow Favonian Goodies to be the solution to your troubles!","nextNodeIds":[705190277]},{"nodeId":705190277,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1703758634,"text":"In addition to our range of ready-to-eat drinking snacks, we also have a wide variety of semi-prepped dishes for sale. Why not get a few of each kind?","nextNodeIds":[705190278]},{"nodeId":705190278,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1174885554,"text":"Finishing off these ready-to-cook meals at home is easy as pie, takes no time at all, and can help you improve your cooking skills.","nextNodeIds":[705190279]},{"nodeId":705190279,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2824525706,"text":"Then, once you have more time on your hands, you'll be ready to challenge yourself with some trickier dishes!","nextNodeIds":[705190280]},{"nodeId":705190280,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2698266522,"text":"#We can even come and help, if you want! {NICKNAME} is really good at cooking, it'd be no problem.","nextNodeIds":[705190281]},{"nodeId":705190281,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4119052682,"text":"Yeah, piece of cake.","nextNodeIds":[705190282]},{"nodeId":705190282,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2045295794,"text":"Haha, that's a great idea! I'm almost tempted to increase my budget now...","nextNodeIds":[705190283]},{"nodeId":705190283,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":789237386,"text":"Lady Megistus, your Prinzessin awaits your culinary masterpiece with great anticipation.","nextNodeIds":[705190284]},{"nodeId":705190284,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":250158650,"text":"But please keep Paimon's suggestion in mind and allocate your time wisely.","nextNodeIds":[705190285]},{"nodeId":705190285,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1612571826,"text":"Hmm-hmm, oh, you just wait. The next time you dine at my home, I'm sure you will be pleasantly surprised!","nextNodeIds":[705190286]},{"nodeId":705190286,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":626498146,"text":"Mona buys some supplies, thanks you profusely, and leaves with Fischl and Oz, feeling very satisfied...","nextNodeIds":[705190287]},{"nodeId":705190287,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3202900354,"text":"Hehehe, Favonian Goodies has just completed its first sale!","nextNodeIds":[705190288,705190289]},{"nodeId":705190288,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3209817762,"text":"A small sale...","nextNodeIds":[705190290]},{"nodeId":705190290,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1393576586,"text":"That's right! And it makes Paimon so happy to see a delighted customer find something that they really like.","nextNodeIds":[705190291]},{"nodeId":705190291,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2656790874,"text":"Paimon never knew that selling things to people who need them could feel so fulfilling. Looks like being a shop owner is a pretty cool job after all.","nextNodeIds":[705190292]},{"nodeId":705190292,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3615493058,"text":"#Alright, {NICKNAME}, let's keep up the momentum and get our name out there!","nextNodeIds":[]},{"nodeId":705190289,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4121198074,"text":"...but a major milestone.","nextNodeIds":[705190290]},{"nodeId":705190255,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3939803378,"text":"Restrain yourself, Your Highness!","nextNodeIds":[705190256]},{"nodeId":705190256,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":2658089482,"text":"H—Huh!?","nextNodeIds":[705190257]},{"nodeId":705190243,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2376846714,"text":"Your ability to focus is admirable.","nextNodeIds":[705190244]},{"nodeId":705190211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2625439850,"text":"What do we need to do next?","nextNodeIds":[705190212]},{"nodeId":705190212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1187547202,"text":"Hey! A little feedback on the name, please? A nod of the head, perhaps!?","nextNodeIds":[705190213]}]},{"talkId":7051903,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7051902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7051903,"initDialog":705190301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30234],"performCfg":"QuestDialogue/WQ/Vintage_70519/Q7051903","priority":7,"questId":70519,"showRandomTalkCount":0},"dialogs":[{"nodeId":705190301,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"Bernhard","textMapHash":3