{"mainQuestId":71501,"title":"A Muddy Bizarre Adventure","description":"Katheryne seems to be having some trouble with a commission that concerns The Chasm...","titleTextMapHash":1503959927,"descTextMapHash":3448737662,"mainQuestExcel":{"mainQuestId":71501,"titleTextMapHash":1503959927,"title":"A Muddy Bizarre Adventure","descTextMapHash":3448737662,"description":"Katheryne seems to be having some trouble with a commission that concerns The Chasm...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":5079,"luaPath":"Actor/Quest/WQ71501","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5079,"chapterId":0,"descTextMapHash":3448737662,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71501,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1601456969,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71501","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[71506],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1503959927,"type":"WQ","unlockDescTextMapHash":2042587190}},"flow":[{"subQuestId":7150101,"order":1,"stepDescription":"Go to the Liyue Adventurers' Guild and talk to Katheryne","stepDescTextMapHash":78370308,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2078"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7150101],"talks":[{"talkId":7150101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150101,"initDialog":715010101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2078],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150101","priority":15,"questId":71501,"showRandomTalkCount":0},"dialogs":[{"nodeId":715010101,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2336339850,"text":"Hmm... It seems that the situation has been getting worse over the last two days. The exploration team's movements will be limited as a result...","nextNodeIds":[715010102]},{"nodeId":715010102,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2692719962,"text":"Who can I get to take this commission up...","nextNodeIds":[715010103,715010104]},{"nodeId":715010103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3163396458,"text":"What's going on?","nextNodeIds":[715010105]},{"nodeId":715010105,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":499613074,"text":"#Ah! {NICKNAME} and Paimon. Your timing truly is impeccable.","nextNodeIds":[715010106]},{"nodeId":715010106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1609946,"text":"Impeccable, you say?","nextNodeIds":[715010107]},{"nodeId":715010107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1355294730,"text":"Sounds like we've got trouble on our hands again.","nextNodeIds":[715010108]},{"nodeId":715010108,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":4198802610,"text":"For reasons unknown, some dark mud-like substance has come pouring out of the caverns and mines of The Chasm lately.","nextNodeIds":[715010109]},{"nodeId":715010109,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":461537602,"text":"It is a very sudden affair, and the exploration team has yet to come up with any countermeasure, and so investigations there have started and stopped several times. As such, Khedive has asked the Adventurers' Guild to send help...","nextNodeIds":[715010110]},{"nodeId":715010110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4261427506,"text":"Eh? Dark mud stuff? Isn't that thing from beneath The Chasm...","nextNodeIds":[715010111]},{"nodeId":715010111,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1445382106,"text":"That's exactly the substance I speak of. I do not know why it has reached the caverns and mines, but either way, the exploration team's progress has been stymied, and even their day-to-day movements have been affected...","nextNodeIds":[715010112]},{"nodeId":715010112,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":129135178,"text":"After all, they rely heavily on the mining tunnels for the transportation of goods and materials.","nextNodeIds":[715010113]},{"nodeId":715010113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1944566978,"text":"How long has this been going on?","nextNodeIds":[715010114]},{"nodeId":715010114,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1114192050,"text":"For some time now. Khedive says that he's found a researcher from Sumeru who can help him out, but that researcher seems to need help themselves...","nextNodeIds":[715010115]},{"nodeId":715010115,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2236867410,"text":"I must admit that this has been troubling me ever since.","nextNodeIds":[715010116]},{"nodeId":715010116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2662259354,"text":"Hmm, y'know, Khedive probably pays pretty well.","nextNodeIds":[715010117]},{"nodeId":715010117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3678401858,"text":"Has no one stepped forward?","nextNodeIds":[715010118]},{"nodeId":715010118,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2027985338,"text":"No, I'm afraid, mostly owing to the extreme danger that the dark mud poses. Quite a few people actually came on account of the reward...","nextNodeIds":[715010119]},{"nodeId":715010119,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1852774202,"text":"But the moment they heard it was The Chasm, they quickly declined.","nextNodeIds":[715010120]},{"nodeId":715010120,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":473633602,"text":"To make things trickier, most adventurers are not very familiar with The Chasm's layout.","nextNodeIds":[715010121]},{"nodeId":715010121,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1065088282,"text":"So the one who accepts this commission will have to be someone with no fear of danger and who knows The Chasm like the back of their hand...","nextNodeIds":[715010122]},{"nodeId":715010122,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1489881546,"text":"And just as I was puzzling over this matter, you two dropped by.","nextNodeIds":[715010123]},{"nodeId":715010123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1381641258,"text":"#So that's how it is. Things do seem quite serious, {NICKNAME}...","nextNodeIds":[715010124,715010125]},{"nodeId":715010124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1176437554,"text":"Right. Let's go have a look.","nextNodeIds":[715010126]},{"nodeId":715010126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":567859810,"text":"Then let's go now, shall we?","nextNodeIds":[715010127]},{"nodeId":715010127,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":989083722,"text":"Ah, about that... Khedive did say that you just have to look for that other researcher from Sumeru.","nextNodeIds":[715010128]},{"nodeId":715010128,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2442236426,"text":"Or, to quote him verbatim, \"If anyone's willing to help, tell them to go to the campsite at The Chasm. That guy will be there prepping, just as usual.\"","nextNodeIds":[715010129]},{"nodeId":715010129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3991166618,"text":"Alright, then we'll be off.","nextNodeIds":[715010130]},{"nodeId":715010130,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2041892314,"text":"Thank you. The Chasm's safety is in your hands!","nextNodeIds":[]},{"nodeId":715010125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3572111354,"text":"I suppose we can help Khedive out.","nextNodeIds":[715010126]},{"nodeId":715010104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":567660266,"text":"Has something happened?","nextNodeIds":[715010105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2078"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7150102,"order":2,"stepDescription":"Go to the mining camp to look for the Sumeru researcher","stepDescTextMapHash":1021999060,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7150102],"talks":[{"talkId":7150102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150102,"initDialog":715010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150102","priority":15,"questId":71501,"showRandomTalkCount":0},"dialogs":[{"nodeId":715010201,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1849449626,"text":"Hmm, I didn't think that the environment here would be so unique. In that case, the energy system of the Pursina's Spike will...","nextNodeIds":[715010202]},{"nodeId":715010202,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2546270306,"text":"#Hmm? Ah, {NICKNAME} and Paimon! It has been a while! Why are the two of you here at The Chasm?","nextNodeIds":[715010203]},{"nodeId":715010203,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3871004706,"text":"Actually, I do recall Khedive saying that you'd helped the exploration team out a lot.","nextNodeIds":[715010204]},{"nodeId":715010204,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2838248098,"text":"That said, the situation in The Chasm has been worsening. It's no place for a walk in the park.","nextNodeIds":[715010205]},{"nodeId":715010205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1982370162,"text":"Wait, you are...?","nextNodeIds":[715010206]},{"nodeId":715010206,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4032829026,"text":"Oh, come on, didn't we just meet a short while ago?","nextNodeIds":[715010207]},{"nodeId":715010207,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4032018386,"text":"I mean, I do always end up asking you for help, but that's no reason to pretend that you don't recognize me...","nextNodeIds":[715010208]},{"nodeId":715010208,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":454930178,"text":"Ah, forget it. In that case, allow me to introduce myself once again. I am Hosseini, a researcher at the Akademiya. I've been working on a device known as the Energy Amplifier, and I even went to Inazuma to do some reference work there.","nextNodeIds":[715010209]},{"nodeId":715010209,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2004434314,"text":"However, I've run out of operating funds for my research, and so I have to return to Sumeru...","nextNodeIds":[715010210]},{"nodeId":715010210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3488482986,"text":"Ah, okay, Paimon thinks she remembers you now...","nextNodeIds":[715010211]},{"nodeId":715010211,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3146996994,"text":"You do?","nextNodeIds":[715010212]},{"nodeId":715010212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3249328770,"text":"You're Amplifier Man!","nextNodeIds":[715010213]},{"nodeId":715010213,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1057883898,"text":"...I'm quite sure that I've never introduced myself as such.","nextNodeIds":[715010214]},{"nodeId":715010214,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1545813266,"text":"Whatever the case, I received a request from a fellow researcher named Khedive. I owe him a favor regarding research funds from way back...","nextNodeIds":[715010215]},{"nodeId":715010215,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1993151354,"text":"So I'm here at The Chasm to help him solve this problem.","nextNodeIds":[715010216]},{"nodeId":715010216,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3601108930,"text":"Well, I hope that explanation's clear enough. In which case, let me ask the question: Why are you two here at The Chasm?","nextNodeIds":[715010217,715010218]},{"nodeId":715010217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2316248522,"text":"Well, we also just so happen to have received a commission from Khedive...","nextNodeIds":[715010219]},{"nodeId":715010219,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":873450594,"text":"Ah, so that's you! And to think I was worried when Khedive mentioned that he was going to get some people to help out.","nextNodeIds":[715010220]},{"nodeId":715010220,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":4270355290,"text":"Since it's you, I guess there's nothing to worry about.","nextNodeIds":[715010221]},{"nodeId":715010221,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1725517210,"text":"I must admit that if I were to attempt to resolve the dark mud issue here at The Chasm myself, it would take a lot of time and energy. But with your help, our odds are... well, higher.","nextNodeIds":[715010222]},{"nodeId":715010222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2503845362,"text":"What do you need us to do?","nextNodeIds":[715010223]},{"nodeId":715010223,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2821250138,"text":"You've heard of the Pursina's Spike, right? A device that can release energy that disrupts the Ley Lines.","nextNodeIds":[715010224]},{"nodeId":715010224,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3391406954,"text":"According to my hypothesis, we can place the Spike at points where the dark mud is pouring out to disrupt the Ley Line movements and clear it away.","nextNodeIds":[715010225]},{"nodeId":715010225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":922094626,"text":"Is the dark mud even related to the Ley Lines?","nextNodeIds":[715010226]},{"nodeId":715010226,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2806249386,"text":"Well, they did appear based on anomalies in the Ley Lines, so it is very likely that they are related. That's what Khedive and I have discussed, anyway.","nextNodeIds":[715010227]},{"nodeId":715010227,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2331444290,"text":"So, we can use the Spike to disrupt or even close the openings that allow the Ley Lines here to access external elements, which will stop the dark mud.","nextNodeIds":[715010228]},{"nodeId":715010228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2054199626,"text":"I see...","nextNodeIds":[715010229]},{"nodeId":715010229,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":918537722,"text":"However, we were previously just using the Spikes to \"disrupt\" the Ley Lines. This is the first time I'm using the Spikes to \"seal\" them.","nextNodeIds":[715010230]},{"nodeId":715010230,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3494786394,"text":"I have done some estimations and adjusted some of the Spike's parameters. In theory, nothing should go wrong.","nextNodeIds":[715010231]},{"nodeId":715010231,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1634684378,"text":"But theory is, as you know, ultimately theory, and theories must all be tested. I was just thinking of beginning the initialization process, in fact, but it has some risks...","nextNodeIds":[715010232]},{"nodeId":715010232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":623770522,"text":"Well, allow me, then...","nextNodeIds":[715010233]},{"nodeId":715010233,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3976561154,"text":"Hmm, alright, I'll leave it to you.","nextNodeIds":[715010234]},{"nodeId":715010234,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":201503762,"text":"I will observe from the sides.","nextNodeIds":[]},{"nodeId":715010218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3073638706,"text":"We're your backup.","nextNodeIds":[715010219]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["166001687","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7150103,"order":3,"stepDescription":"Activate the Pursina's Spike","stepDescTextMapHash":3379606260,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q71501"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[6_600100133:1004.282,1015.533,881.803,0.000,284.580,0.000]","30"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q71