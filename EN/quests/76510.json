{"mainQuestId":76510,"title":"End of a Leisurely Holiday","description":"After days of intense \"sparing,\" the moment of parting quietly arrives...","titleTextMapHash":966945799,"descTextMapHash":993302110,"mainQuestExcel":{"mainQuestId":76510,"titleTextMapHash":966945799,"title":"End of a Leisurely Holiday","descTextMapHash":993302110,"description":"After days of intense \"sparing,\" the moment of parting quietly arrives...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5305,"luaPath":"Actor/Quest/WQ76510","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5305,"chapterId":0,"descTextMapHash":993302110,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76510,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2124144817,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76510","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176510],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":966945799,"type":"WQ","unlockDescTextMapHash":3337149798}},"flow":[{"subQuestId":7651001,"order":1,"stepDescription":"Talk to Edler and Wislawa","stepDescTextMapHash":473508204,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7651001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_14842:3384.346,234.467,9606.934]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7651001],"talks":[{"talkId":7651001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7651001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7651001,"initDialog":765100101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30956,30928],"performCfg":"QuestDialogue/WQ/NodKrai_76510/Q7651001","priority":5,"questId":76510,"showRandomTalkCount":0},"dialogs":[{"nodeId":765100101,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":168063418,"text":"...That should be enough to prove this isn't some sort of secret weapon.","nextNodeIds":[765100102]},{"nodeId":765100102,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":3501285562,"text":"Hmm... Sure does. Now you just need to make it a little tougher, and it might pose a challenge to adults as well.","nextNodeIds":[765100103]},{"nodeId":765100103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":965372850,"text":"Whoa! The atmosphere's getting all tense again, you don't think they're going to...","nextNodeIds":[765100104]},{"nodeId":765100104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1769363882,"text":"Come to blows?","nextNodeIds":[765100105]},{"nodeId":765100105,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":3077883506,"text":"#You're not far wrong... Hey, {NICKNAME}, since you're here, why not help us referee a fair fight?","nextNodeIds":[765100106]},{"nodeId":765100106,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":1383380178,"text":"*sigh* I don't know where this obsession with sparing has come from. Is it because I beat you so easily the last time? If that's what this is about, then let's just get it over with.","nextNodeIds":[765100107]},{"nodeId":765100107,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":1150203322,"text":"#{NICKNAME}, keep your eyes peeled and see who blinks first!","nextNodeIds":[765100108]},{"nodeId":765100108,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":1312385914,"text":"Hmph! All those empty words aren't going to save you!","nextNodeIds":[765100109,765100110]},{"nodeId":765100109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":414198234,"text":"Edler looks stronger...","nextNodeIds":[765100111]},{"nodeId":765100111,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":1640058130,"text":"...","nextNodeIds":[765100112]},{"nodeId":765100112,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":2664760362,"text":"...","nextNodeIds":[765100113]},{"nodeId":765100113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2909786626,"text":"...!","nextNodeIds":[765100114]},{"nodeId":765100114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1200379874,"text":"Whoa! Aren't they only supposed to be sparring!?","nextNodeIds":[765100115]},{"nodeId":765100115,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":3067164218,"text":"It's not too late to admit defeat! I'll give you three seconds...","nextNodeIds":[765100116]},{"nodeId":765100116,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":3197816482,"text":"Three, two, one...","nextNodeIds":[765100117]},{"nodeId":765100117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3347080914,"text":"Whoa!","nextNodeIds":[765100118]},{"nodeId":765100118,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":836754250,"text":"There is a loud, metallic clack followed by calm silence...","nextNodeIds":[765100119]},{"nodeId":765100119,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":3400687618,"text":"It's alright, Paimon, you can open your eyes.","nextNodeIds":[765100120]},{"nodeId":765100120,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":1993693098,"text":"It turns out the most \"tense\" person here was you...","nextNodeIds":[765100121]},{"nodeId":765100121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1579855898,"text":"Wh—What? Wislawa, you're not hurt!?","nextNodeIds":[765100122,765100123]},{"nodeId":765100122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1979329986,"text":"Edler only fired a warning shot.","nextNodeIds":[765100124]},{"nodeId":765100124,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":3948754554,"text":"Of course. I don't want to end up stuck in some foreign prison...","nextNodeIds":[765100125]},{"nodeId":765100125,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":2017403554,"text":"I had to put on a show. Let her know I'm not some cowardly merchant she can just push around.","nextNodeIds":[765100126]},{"nodeId":765100126,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":2561615130,"text":"This way, the next time we meet, she'll think twice before causing me trouble.","nextNodeIds":[765100127]},{"nodeId":765100127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":149839522,"text":"#But, {NICKNAME}, how did you know what was going on? You're not tense at all!","nextNodeIds":[765100128,765100129]},{"nodeId":765100128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3127681274,"text":"Edler's expression was too relaxed.","nextNodeIds":[765100130]},{"nodeId":765100130,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":178944786,"text":"You're sharp. A well-placed threat's the fastest way to make someone surrender. It's just a shame that shortcuts are seldom so easy to take.","nextNodeIds":[765100131]},{"nodeId":765100131,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":3611284642,"text":"#Not to mention, {NICKNAME} is here... Anyway, I'm still standing.","nextNodeIds":[765100132]},{"nodeId":765100132,"roleType":"TALK_ROLE_NPC","speakerId":30928,"speakerName":"Wislawa","textMapHash":462412458,"text":"I just hope the next time we meet, I get a chance to...","nextNodeIds":[765100133]},{"nodeId":765100133,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":1265211554,"text":"Don't start with all that again. How many chances do you think we'll have to meet?","nextNodeIds":[765100134]},{"nodeId":765100134,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":2854313106,"text":"If the next time I see you, you happen to be on duty, I'll be forced to respond appropriately to any actions you take.","nextNodeIds":[765100135]},{"nodeId":765100135,"roleType":"TALK_ROLE_NPC","speakerId":30956,"speakerName":"Edler","textMapHash":2283332250,"text":"But if you're on holiday again, let's play another wargame or two — for the sake of my business.","nextNodeIds":[]},{"nodeId":765100129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2611491986,"text":"Edler said it herself — \"see who blinks first.\"","nextNodeIds":[765100130]},{"nodeId":765100123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1819618538,"text":"There were no bullets in the musket.","nextNodeIds":[765100124]},{"nodeId":765100110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2898030642,"text":"Wislawa looks bigger...","nextNodeIds":[765100111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7651001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7651001","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJ