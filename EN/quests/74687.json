{"mainQuestId":74687,"title":"The Cannon Has Ears","description":"The Gardes are facing an emergency in the south of Fontaine. It appears they need assistance...","titleTextMapHash":342864575,"descTextMapHash":1819328902,"mainQuestExcel":{"mainQuestId":74687,"titleTextMapHash":342864575,"title":"The Cannon Has Ears","descTextMapHash":1819328902,"description":"The Gardes are facing an emergency in the south of Fontaine. It appears they need assistance...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5270,"luaPath":"Actor/Quest/WQ74687","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5270,"chapterId":0,"descTextMapHash":1819328902,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74687,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":490781721,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74687","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174687],"series":74687,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":342864575,"type":"WQ","unlockDescTextMapHash":2972450718}},"flow":[{"subQuestId":7468701,"order":1,"stepDescription":"Talk to the Gardes","stepDescTextMapHash":3689517388,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30534"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7468701,7468703],"talks":[{"talkId":7468701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":true,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7468701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468701,"initDialog":746870101,"nextRandomTalks":[],"nextTalks":[7468703],"npcId":[30534],"performCfg":"QuestDialogue/WQ/Fontaine_74687/Q7468701","priority":5,"questId":74687,"showRandomTalkCount":0},"dialogs":[{"nodeId":746870101,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3865200858,"text":"We've been at this for half a day now, and the monsters aren't showing any signs of thinning out...","nextNodeIds":[746870102]},{"nodeId":746870102,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2457403778,"text":"Maybe I should call for reinforcements?","nextNodeIds":[746870103]},{"nodeId":746870103,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2432697402,"text":"There's no need to panic. Trust in the cannon and our plainclothes colleague!","nextNodeIds":[746870104]},{"nodeId":746870104,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1655373026,"text":"Besides, there's an adventurer with a nose for danger and a certain officer who are sure to turn up should we find ourselves in a crisis...","nextNodeIds":[746870105,746870106]},{"nodeId":746870105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2439584930,"text":"What's all this about a crisis?","nextNodeIds":[746870107]},{"nodeId":746870107,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":652115066,"text":"#Wow, here they are... Proto-Boss and {M#his}{F#her} little assistant really have shown up!","nextNodeIds":[746870108]},{"nodeId":746870108,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2850917626,"text":"Hello, you two. Please allow me to explain the situation...","nextNodeIds":[746870109]},{"nodeId":746870109,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":418964402,"text":"Why don't you take a breather? I can brief these two.","nextNodeIds":[746870110]},{"nodeId":746870110,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3334458522,"text":"Hey! Want to have a go on the cannon? Opportunities like this don't roll around often, at least, not since the fleet was destroyed. It'll be a blast from centuries past!","nextNodeIds":[746870111]},{"nodeId":746870111,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":1484677466,"text":"Blowing monsters to smithereens with these specially made projectiles is the perfect way to unwind — and the Gardes will even reward you for it!","nextNodeIds":[746870112]},{"nodeId":746870112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":302716058,"text":"Blasting monsters with a massive cannon... That's right up our alley!","nextNodeIds":[746870113,746870114]},{"nodeId":746870113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1665008434,"text":"It certainly sounds straightforward enough.","nextNodeIds":[746870115]},{"nodeId":746870115,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3916472490,"text":"I understand your excitement, Proto-Boss, but we're still on a knife's edge here. Let me fill you in on what's happening.","nextNodeIds":[746870116]},{"nodeId":746870116,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2044267386,"text":"Recently, a group of workers unexpectedly unearthed some ruins nearby, disturbing the monsters slumbering within...","nextNodeIds":[746870117]},{"nodeId":746870117,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":1436236242,"text":"We Gardes have set up a containment zone to prevent their escape.","nextNodeIds":[746870118]},{"nodeId":746870118,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":1938772010,"text":"Well, I say \"containment zone\"... At the moment, it's just the two of us and a Melusine agent who happened to be here on holiday... Oh, and our customized cannon, of course!","nextNodeIds":[746870119]},{"nodeId":746870119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1104334258,"text":"Eek! That sounds dangerous! Paimon hopes that Melusine agent isn't in any danger...","nextNodeIds":[746870120]},{"nodeId":746870120,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":427460610,"text":"Don't worry about her. The cannon at the entrance to the ruins is operated remotely — she can keep most of the monsters in check without getting anywhere near them.","nextNodeIds":[746870121]},{"nodeId":746870121,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":773297242,"text":"She's very reliable, but this operation's dragging on now, and she must be exhausted.","nextNodeIds":[746870122]},{"nodeId":746870122,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2074895754,"text":"Will you help us out, Proto-Boss? If the situation doesn't improve soon, I'll have to call for reinforcements.","nextNodeIds":[746870123]},{"nodeId":746870123,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1711444810,"text":"#What are you talking about, Chenee? You know how capable our Proto-Boss is — with {M#him}{F#her} in control, my cannon will wipe out those monsters in no time flat!","nextNodeIds":[746870124,746870125]},{"nodeId":746870124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":499598522,"text":"Say no more. I'd love to give this cannon a blast...","nextNodeIds":[746870126]},{"nodeId":746870126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1492530994,"text":"It's not our style to walk away from danger!","nextNodeIds":[746870127]},{"nodeId":746870127,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1139951210,"text":"Fantastic! We're very grateful for your help.","nextNodeIds":[746870128]},{"nodeId":746870128,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2918376842,"text":"After our last experiment, I made some adjustments to my invention — I hope you'll find it easy to operate.","nextNodeIds":[746870129]},{"nodeId":746870129,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2217304290,"text":"*sigh* Now, if only we could get it to aim and fire automatically... What do you think?","nextNodeIds":[746870130]},{"nodeId":746870130,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1691067178,"text":"That's a great idea! Next time, I can try fitting it with a Gardemek's target identification module! That way, it should be able to operate autonomously.","nextNodeIds":[746870131]},{"nodeId":746870131,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2009802202,"text":"How clever — you really are a genius!","nextNodeIds":[]},{"nodeId":746870125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1309499946,"text":"I'm willing to help no matter the situation!","nextNodeIds":[746870126]},{"nodeId":746870114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4237071778,"text":"Is there a particular reason for blowing these monsters up?","nextNodeIds":[746870115]},{"nodeId":746870106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2484359250,"text":"We got here in time, I hope?","nextNodeIds":[746870107]}]},{"talkId":7468703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":true,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7468701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7468703,"initDialog":746870301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30839],"performCfg":"QuestDialogue/WQ/Fontaine_74687/Q7468703","priority":5,"questId":74687,"showRandomTalkCount":0},"dialogs":[{"nodeId":746870301,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":1717999682,"text":"Hey-ho! Here comes the relief force...","nextNodeIds":[746870302]},{"nodeId":746870302,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":525835098,"text":"Huh? What are you two doing here?","nextNodeIds":[746870303,746870307]},{"nodeId":746870303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":457743242,"text":"I—Is there something wrong?","nextNodeIds":[746870304]},{"nodeId":746870304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2413579026,"text":"Have we met before?","nextNodeIds":[746870305]},{"nodeId":746870305,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":1568189706,"text":"Nothing wrong at all! It's good to see such famously strong heroes here to help!","nextNodeIds":[746870306]},{"nodeId":746870306,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":3570437130,"text":"Back in the unit — and after I returned to the village, too — everyone said you two could take care of anything.","nextNodeIds":[746870311]},{"nodeId":746870311,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":248332018,"text":"On the other hand, those two over there are reliable enough, but there's something a little... awkward between them.","nextNodeIds":[746870312]},{"nodeId":746870312,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":3459280066,"text":"Human emotions are complicated... I think maybe they could do with a little push.","nextNodeIds":[746870313]},{"nodeId":746870313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":788805362,"text":"Awkward?","nextNodeIds":[746870314]},{"nodeId":746870314,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":2096105546,"text":"Forget it. There are more important things to focus on.","nextNodeIds":[746870315]},{"nodeId":746870315,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":805781090,"text":"Anyway, I have faith in you. The cannon's easy enough to operate. I'm sure you'll have those monsters cleared up in short order.","nextNodeIds":[]},{"nodeId":746870307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2608306194,"text":"I feel like we've met before...","nextNodeIds":[746870308]},{"nodeId":746870308,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":3823412234,"text":"So you do remember me! I applied for a position at the Chevalmarin Film Fantasyland.","nextNodeIds":[746870309]},{"nodeId":746870309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3311937914,"text":"Paimon thinks she maybe remembers that...","nextNodeIds":[746870310]},{"nodeId":746870310,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":587860578,"text":"I'm well aware of your deeds, and I know I can trust you with anything.","nextNodeIds":[746870311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30534"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468701,7468703],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","count":14},{"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174687],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1819328902,"CHECNJEMEFE":{"30509":[1170],"30839":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBO