6572749,"text":"What are you doing?","nextNodeIds":[220020105]},{"nodeId":220020105,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":1902045093,"text":"We're playing a game!","nextNodeIds":[220020106]},{"nodeId":220020106,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":4084863501,"text":"Meng is the captain, Fei is first mate and I'm a rich merchant.","nextNodeIds":[220020107]},{"nodeId":220020107,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":2259370445,"text":"All we're missing is the pirate. The pirate's supposed to come and rob us.","nextNodeIds":[220020108]},{"nodeId":220020108,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":1947523005,"text":"You can be the pirate if you wanna play with us?","nextNodeIds":[220020109,220020111]},{"nodeId":220020109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2522247773,"text":"...Ahoy, me hearties!","nextNodeIds":[220020110]},{"nodeId":220020110,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":3067485525,"text":"Yay!","nextNodeIds":[220020113]},{"nodeId":220020113,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":890939445,"text":"Okay, come and let us know when you're ready.","nextNodeIds":[]},{"nodeId":220020111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":936572053,"text":"I wanna be one of the good guys...","nextNodeIds":[220020112]},{"nodeId":220020112,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":3904989117,"text":"It's just a game! Don't worry, I know you're a good person in real life.","nextNodeIds":[220020113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"