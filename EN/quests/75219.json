_GUIDE_NONE"},"isHidden":false,"talkIds":[7521901],"talks":[{"talkId":7521901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_BILLBOARD_ONLY","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7521901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7521901,"initDialog":752190101,"nextRandomTalks":[],"nextTalks":[],"npcId":[6476],"performCfg":"QuestDialogue/WQ/Furniture_75219/Q7521901","priority":5,"questId":75219,"showRandomTalkCount":0},"dialogs":[{"nodeId":752190101,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":2722099258,"text":"#Ah, it's {NICKNAME}! Please, wait!","nextNodeIds":[752190102]},{"nodeId":752190102,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":1846806202,"text":"Here you are...","nextNodeIds":[752190103]},{"nodeId":752190103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":524035610,"text":"Oh hey! Do you need help with something?","nextNodeIds":[752190104]},{"nodeId":752190104,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":2869484898,"text":"Haha, not quite. I was just passing by with a package for the two of you. And there I was wondering how I'd track you down...","nextNodeIds":[752190105]},{"nodeId":752190105,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":3802946130,"text":"Speak of the devil, or make that devils, huh?","nextNodeIds":[752190106]},{"nodeId":752190106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4142054890,"text":"A package! Who's it from?","nextNodeIds":[752190107]},{"nodeId":752190107,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":2841419682,"text":"Well, it's had quite a journey. It first turned up in the Adventurers' Guild, then after changing hands many times, finally got picked up by the Scions of the Canopy's couriers...","nextNodeIds":[752190108]},{"nodeId":752190108,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":1367528858,"text":"Considering Natlan's recent state of affairs, normal caravans haven't been up and running for a while. The sender didn't leave their name on the package, but judging by the signature... it seems to be from Fontaine.","nextNodeIds":[752190109]},{"nodeId":752190109,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":3185898746,"text":"Seems like you've got friends all the way in Fontaine, huh?","nextNodeIds":[752190110,752190111]},{"nodeId":752190110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3988186506,"text":"Received with thanks.","nextNodeIds":[752190112]},{"nodeId":752190112,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":127493698,"text":"Whew, today's work sure is off to a great start. No sooner do I get the package than I run into its recipient. Praised be the Pyro Archon!","nextNodeIds":[752190113]},{"nodeId":752190113,"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","textMapHash":2549760194,"text":"Alright, I'm gonna go get more deliveries done. Have a good day!","nextNodeIds":[752190114]},{"nodeId":752190114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2707190954,"text":"Yeah, good luck with your work!","nextNodeIds":[752190115]},{"nodeId":752190115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3752947682,"text":"From Fontaine, huh... He called it a package, but it's so small! Looks more like a letter to Paimon.","nextNodeIds":[752190116]},{"nodeId":752190116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2483508194,"text":"Let's open it and see!","nextNodeIds":[752190117]},{"nodeId":752190117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1670366114,"text":"Oh, it's from Charlotte! It's the photo we took when we were leaving Fontaine...","nextNodeIds":[752190118]},{"nodeId":752190118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3378028114,"text":"It hasn't been that long since we took the photo, but it sure feels like forever!","nextNodeIds":[752190119]},{"nodeId":752190119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1959084290,"text":"Hehe, let's keep this photo someplace safe!","nextNodeIds":[]},{"nodeId":752190111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2116555506,"text":"Great! I'll take that off your hands, then.","nextNodeIds":[752190112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7521901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7521601","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7521901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":6476,"speakerName":"Huqiru","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[175219],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":317765342,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Furniture_75219/Q7521901","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":752190101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7521901,"JG