_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7268201],"talks":[{"talkId":7268201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7268201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268201,"initDialog":726820101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30065],"performCfg":"","priority":5,"questId":72682,"showRandomTalkCount":0},"dialogs":[{"nodeId":726820101,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1125034058,"text":"Hello there, blond-haired outlander...","nextNodeIds":[726820102,726820103]},{"nodeId":726820102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3913901274,"text":"We meet again.","nextNodeIds":[726820104]},{"nodeId":726820104,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":3350139810,"text":"Um, your blond hair looks familiar... Are you...","nextNodeIds":[726820105]},{"nodeId":726820105,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":3880946570,"text":"Ah yes! You are the eye-catching Golden Whirlwind from the Hyakunin Ikki last time...","nextNodeIds":[726820106]},{"nodeId":726820106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3313579210,"text":"G—Golden Whirlwind...?","nextNodeIds":[726820107]},{"nodeId":726820107,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":694874194,"text":"Previously, I was watching the excellent performances of the participants in a corner of the tournament venue, seeking to be inspired by the most thrilling fighting scenes. And there you were, taking out opponents like a golden whirlwind sweeping away weeds and grass...","nextNodeIds":[726820108,726820109]},{"nodeId":726820108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3161473842,"text":"Ugh, please, spare me the flattery.","nextNodeIds":[726820113]},{"nodeId":726820113,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1467893722,"text":"Anyway, some people have organized another Hyakunin Ikki recently.","nextNodeIds":[726820114,726820118]},{"nodeId":726820114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":438507546,"text":"What is this Hyakunin Ikki?","nextNodeIds":[726820115]},{"nodeId":726820115,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":713302682,"text":"It's a free-for-all tournament whereby people engage in a hearty fight to celebrate, or simply to eliminate bad luck. It's a festival where both martial artists and monsters put their grievances aside and forget their identities, just to enjoy the sheer excitement of fighting.","nextNodeIds":[726820116]},{"nodeId":726820116,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1701822170,"text":"They say that those who stand out from the crowd will be awarded various treasures.","nextNodeIds":[726820117]},{"nodeId":726820117,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":4171258562,"text":"The identities of the organizers and sponsors are still shrouded in mystery though.","nextNodeIds":[726820119]},{"nodeId":726820119,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":3265274818,"text":"Whatever the case, this is not a topic to be discussed out in the open. Follow me...","nextNodeIds":[]},{"nodeId":726820118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":255603818,"text":"I see...","nextNodeIds":[726820119]},{"nodeId":726820109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1751227610,"text":"...Go on, don't stop.","nextNodeIds":[726820110]},{"nodeId":726820110,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1099502858,"text":"Ahem... \"Spectators with the keen eyes of a swordmaster must have noticed it — the blond-haired outsider was unleashing Kouranka Daitatsumaki, a technique that was deemed forbidden even amongst ancient martial arts...!\"","nextNodeIds":[726820111]},{"nodeId":726820111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2460652034,"text":"?","nextNodeIds":[726820112]},{"nodeId":726820112,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":589300698,"text":"Having been inspired by your marvelous fight, I wrote this story.","nextNodeIds":[726820113]},{"nodeId":726820103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2956227730,"text":"Do you have a commission for me?","nextNodeIds":[726820104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7268202,"order":2,"stepDescription":"Talk to Kayabuki","stepDescTextMapHash":66610988,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7268202],"talks":[{"talkId":7268202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"d