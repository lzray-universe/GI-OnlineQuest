{"mainQuestId":22117,"title":"Visiting a Friend in Jueyun","description":"Madame Ping recently visited Mt. Hulao to see an old friend, but seems to have dropped something along the way...","titleTextMapHash":2046160977,"descTextMapHash":3153693575,"mainQuestExcel":{"mainQuestId":22117,"titleTextMapHash":2046160977,"title":"Visiting a Friend in Jueyun","descTextMapHash":3153693575,"description":"Madame Ping recently visited Mt. Hulao to see an old friend, but seems to have dropped something along the way...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ22117","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3153693575,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":22117,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3205657063,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ22117","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":28300,"titleTextMapHash":2046160977,"type":"IQ","unlockDescTextMapHash":3196977419}},"flow":[{"subQuestId":2211701,"order":1,"stepDescription":"Talk to Madame Ping","stepDescTextMapHash":542960442,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2093"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2211701],"talks":[{"talkId":2211701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211701","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2211701,"initDialog":221170101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2093],"performCfg":"","priority":3,"questId":22117,"showRandomTalkCount":0},"dialogs":[{"nodeId":221170101,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":306668661,"text":"Oh, please tell me I didn't leave it at the top of the mountain...","nextNodeIds":[221170102]},{"nodeId":221170102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":151030797,"text":"Hey granny, fancy meeting you here.","nextNodeIds":[221170103]},{"nodeId":221170103,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":2055505013,"text":"Well! Fancy running into you youngsters at a place like this! What are the chances... But, you should have put on more layers, you know. It's windy up there, you'll catch a cold.","nextNodeIds":[221170104]},{"nodeId":221170104,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3377311885,"text":"I was just on my way back to the city from Mt. Hulao. I went up there to see an old friend of mine, and we had a delightful chat about the old times.","nextNodeIds":[221170105]},{"nodeId":221170105,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3564816901,"text":"But halfway back, I've suddenly realized I've forgotten something. *sigh* I must have left it up on the mountain...","nextNodeIds":[221170106]},{"nodeId":221170106,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3413959325,"text":"At my age, I don't think I could make it all the way up there a second time in one day... It's such a long distance, and there's all that bothersome amber up there.","nextNodeIds":[221170107]},{"nodeId":221170107,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":4236544413,"text":"Youngsters... Could you fetch it back from the mountain top for me? I'd be ever so grateful...","nextNodeIds":[221170108,221170111]},{"nodeId":221170108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1140459557,"text":"Who is this old friend?","nextNodeIds":[221170109]},{"nodeId":221170109,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":2383576405,"text":"You know, the one who lives on Mt. Hulao. You must have met him. That amber of his is a real nuisance...","nextNodeIds":[221170110]},{"nodeId":221170110,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":4254565877,"text":"My memory must be going. Honestly, how could I forget to put the box in my teapot before I left...","nextNodeIds":[]},{"nodeId":221170111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3549163621,"text":"What did you leave up there?","nextNodeIds":[221170112]},{"nodeId":221170112,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":1675856229,"text":"A box... I think. My memory is not what it once was... Why didn't I just put it in my teapot straight away? Would've saved me so much hassle.","nextNodeIds":[221170113]},{"nodeId":221170113,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3998577205,"text":"At least if it is up in the mountains, the chances are it will have become trapped in amber. So finding it once you're up there shouldn't be too difficult.","nextNodeIds":[221170114]},{"nodeId":221170114,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":809792765,"text":"Youngsters, please make a poor old lady's day. Fetch it back from Mt. Hulao for me, would you? The part where all that amber is.","nextNodeIds":[221170115]},{"nodeId":221170115,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3162332317,"text":"Mind yourselves, though. Who knows what else might be encased in amber after all these years...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2093"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2211702,"order":2,"stepDescription":"Smash the amber and find Madame Ping's box","stepDescTextMapHash":218333786,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[100512,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22117Target","40"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2211704],"talks":[{"talkId":2211704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211702","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2211704,"initDialog":221170401,"nextRandomTalks":[],"nextTalks":[],"npcId":[2093],"performCfg":"","priority":3,"questId":22117,"showRandomTalkCount":0},"dialogs":[{"nodeId":221170401,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":754313797,"text":"Silly child, why ever didn't you wrap up warm before you came out? I'd feel terrible if you were to catch a cold.","nextNodeIds":[221170402,221170406]},{"nodeId":221170402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2534638533,"text":"Tell me about the amber.","nextNodeIds":[221170403]},{"nodeId":221170403,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":1463935485,"text":"My old friend makes it. He says it catches monsters and bandits on their way up the mountain.","nextNodeIds":[221170404]},{"nodeId":221170404,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3841516605,"text":"It's been around a very long time indeed. Honestly, that amber has trapped some very peculiar things over the years...","nextNodeIds":[221170405]},{"nodeId":221170405,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":1159698157,"text":"It really is a ghastly substance...","nextNodeIds":[]},{"nodeId":221170406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1118169973,"text":"How's the teapot these days...","nextNodeIds":[221170407]},{"nodeId":221170407,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":2817085157,"text":"Oh, it's spick and span once again now. All thanks to you, of course!","nextNodeIds":[221170408]},{"nodeId":221170408,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3729248565,"text":"In fact, the whole reason I came all this way to collect that thing was to spruce up my teapot a little further.","nextNodeIds":[221170409]},{"nodeId":221170409,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"Madame Ping","textMapHash":3263743101,"text":"Once it's both spick and span and in tip-top condition, I'll finally be able to treat my guests to tea again...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[100512,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUES