{"mainQuestId":73650,"title":"Thesis Proposal: He Shall not Pass","description":"Strange rumors are spreading in Port Ormos about a \"groaning Akademiya researcher.\" You wonder what happened...","titleTextMapHash":1153369135,"descTextMapHash":3771824502,"mainQuestExcel":{"mainQuestId":73650,"titleTextMapHash":1153369135,"title":"Thesis Proposal: He Shall not Pass","descTextMapHash":3771824502,"description":"Strange rumors are spreading in Port Ormos about a \"groaning Akademiya researcher.\" You wonder what happened...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5090,"luaPath":"Actor/Quest/WQ73650","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5090,"chapterId":0,"descTextMapHash":3771824502,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73650,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3468967857,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73650","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173650],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1153369135,"type":"WQ","unlockDescTextMapHash":3343618822}},"flow":[{"subQuestId":7365001,"order":1,"stepDescription":"Talk to the groaning researcher","stepDescTextMapHash":3401287556,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7365001],"talks":[{"talkId":7365001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7365001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7365001,"initDialog":736500101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30225],"performCfg":"QuestDialogue/WQ/Sumeru_73650/Q7365001","priority":5,"questId":73650,"showRandomTalkCount":0},"dialogs":[{"nodeId":736500101,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1463982466,"text":"Ugh... My academic career has been sunk before it could even start...","nextNodeIds":[736500102]},{"nodeId":736500102,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3402903730,"text":"A scholar? Why bother being a scholar? If I had learned to draw in the Akademiya and became an illustrator, I wouldn't have ended up here... Haha... Hahahaha!","nextNodeIds":[736500103]},{"nodeId":736500103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3170528250,"text":"Y'know, when we first heard that there was an Akademiya researcher in Port Ormos who groans all day... Paimon thought it was some kind of strange tale.","nextNodeIds":[736500104]},{"nodeId":736500104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2613055658,"text":"But hey, guess he's real. Hey, \"groaning Akademiya researcher\"!","nextNodeIds":[736500105]},{"nodeId":736500105,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3907025418,"text":"What...? \"Groaning Akademiya researcher\"? Are you talking about me?","nextNodeIds":[736500106]},{"nodeId":736500106,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1085613802,"text":"*sigh* If you'd met me in the past, I would debate the veracity of such a slanderous title. But now... forget it.","nextNodeIds":[736500107]},{"nodeId":736500107,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3549293322,"text":"Go back to where you came from, little one. Don't disturb a young man, mired, adrift, without a future. People like me should just shrivel like a silent mushroom in the dark corner of the forest...","nextNodeIds":[736500108]},{"nodeId":736500108,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":766792682,"text":"At least the Akademiya's resources wouldn't be wasted then. I might even be taken back there as some special mushroom sample to be dissected by some real scholar...","nextNodeIds":[736500109]},{"nodeId":736500109,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":518934554,"text":"\"Jami the Mushroom Sample.\" Wouldn't it be funny if that's how I wound up being remembered by history...","nextNodeIds":[736500110]},{"nodeId":736500110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":574860042,"text":"Jami? Oh, so that's your name.","nextNodeIds":[736500111]},{"nodeId":736500111,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4120952738,"text":"Yeah. What about it, little one?","nextNodeIds":[736500112]},{"nodeId":736500112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3531912186,"text":"The name's Paimon! Not \"little one\"!","nextNodeIds":[736500113]},{"nodeId":736500113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2045672962,"text":"#And I'm {NICKNAME}.","nextNodeIds":[736500114]},{"nodeId":736500114,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":302722778,"text":"#{NICKNAME} and Paimon. Right, noted. So, how may I help you...?","nextNodeIds":[736500115]},{"nodeId":736500115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":608544850,"text":"Well, we just heard about the rumors of \"groaning Akademiya researcher\" in Port Ormos and wanted to know what was going on.","nextNodeIds":[736500116]},{"nodeId":736500116,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1966105818,"text":"*sigh*... What's going on, you say? Well, have you heard of this thing that happens for us researchers called \"publishing our research\"?","nextNodeIds":[736500117]},{"nodeId":736500117,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2287604258,"text":"Publishing independent research is how we prove that we are capable, self-sufficient scholars. That's how we graduate from under our mentor's tutelage and enter the academic world, where we can then gain renown...","nextNodeIds":[736500118]},{"nodeId":736500118,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3242224874,"text":"That way, we can travel to places in Teyvat in the name of collecting research material, with research grants sufficient to cover even fine food and drink!","nextNodeIds":[736500119]},{"nodeId":736500119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":377572218,"text":"Fine food and drink, huh... Say, you wouldn't mind elaborating on that, would you?","nextNodeIds":[736500120,736500121]},{"nodeId":736500120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2854711874,"text":"Hmm...","nextNodeIds":[736500122]},{"nodeId":736500122,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1696304290,"text":"Uh, I was just saying... In truth, I dream of doing great things in the academic world.","nextNodeIds":[736500123]},{"nodeId":736500123,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3706732786,"text":"Good food, traveling, fame, things like these are just side benefits. I wouldn't reject them, of course, but... *cough* Either way, we're getting off topic.","nextNodeIds":[736500124]},{"nodeId":736500124,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":842405194,"text":"Anyway, I'm stuck at the \"publish your research\" part. The courses at Akademiya have a tight schedule already, and I have to get my thesis proposal passed in time.","nextNodeIds":[736500125]},{"nodeId":736500125,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3144836042,"text":"My proposals have been rejected twice. \"The Edibleness of Mushrooms on the Back of Shroomboars\" was the first one. I actually thought that one was pretty good...","nextNodeIds":[736500126]},{"nodeId":736500126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2471310578,"text":"Well, it certainly sounds like a good subject. One that warrants a couple hundred experiments, for sure!","nextNodeIds":[736500127]},{"nodeId":736500127,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":254978834,"text":"I know, right? But my mentor just said \"is this even worth looking into?\" and refused my request... Absolutely ridiculous.","nextNodeIds":[736500128]},{"nodeId":736500128,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1042505362,"text":"The second time, I applied to research \"The Ecological Environment and Aquaculture of Floating Hydro Fungi,\" but got rejected again by my mentor, who called the topic too unambitious...","nextNodeIds":[736500129]},{"nodeId":736500129,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":314248930,"text":"The deadline for submitting the thesis proposal was drawing near, and so I wrote up a very ambitious proposal in a fit of pique... You know, as a way of saying \"you old man, how dare you call me unambitious!\"","nextNodeIds":[736500130]},{"nodeId":736500130,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3795882402,"text":"I didn't think that my mentor would let it pass or that it would get praise in the Akademiya. But there was no way back from there, so my report became...","nextNodeIds":[736500131]},{"nodeId":736500131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":890605178,"text":"Became what?","nextNodeIds":[736500132]},{"nodeId":736500132,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1875877218,"text":"Heh... a \"Study on the Defense Deficiencies of Biological Structures in Response to Hostile Stressors\"...","nextNodeIds":[736500133,736500134]},{"nodeId":736500133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4149913290,"text":"Sorry, Hostile Stressor-what again?","nextNodeIds":[736500135]},{"nodeId":736500135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2511833066,"text":"Nope, Paimon doesn't know what you're talking about. Doesn't sound delicious or interesting either.","nextNodeIds":[736500136]},{"nodeId":736500136,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1309460450,"text":"The research topic of your study should ideally be a bit obscure. To put it in simple terms, creatures in combat will more or less reveal some weaknesses in their defenses.","nextNodeIds":[736500137]},{"nodeId":736500137,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3089590730,"text":"Some weak spots, which should have been well protected, will end up exposed when they make certain movements. And those are the Weaknesses I'm collecting for my research.","nextNodeIds":[736500138]},{"nodeId":736500138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1343676850,"text":"It's still kinda hard to understand... but it sounds awesome!","nextNodeIds":[736500139]},{"nodeId":736500139,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3232764018,"text":"Well, being awesome doesn't help you fight monsters or take pictures of research materials. I'm just a fragile researcher. This subject is way too dangerous for me!","nextNodeIds":[736500140]},{"nodeId":736500140,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3508048322,"text":"How am I supposed to finish this whole thing...? And with an unfinished thesis, I won't be able to graduate...","nextNodeIds":[736500141]},{"nodeId":736500141,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3935802194,"text":"Fighting monsters... Hah, whatever. Let's just do it. I might get heavily injured, but maybe my mentor might take pity on me and grant a pass to this poor student...","nextNodeIds":[736500142]},{"nodeId":736500142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2049498402,"text":"Please don't do that!","nextNodeIds":[736500143]},{"nodeId":736500143,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2128373418,"text":"But my thesis proposal has already been submitted. There's no time to switch topics. What can I do?","nextNodeIds":[736500144]},{"nodeId":736500144,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1516243810,"text":"I was too impulsive for my own good. Some researcher I am! I should just go feed myself to a Rishboland Tiger! Wait, no. That might hurt. Maybe I should drown myself in the river near Vimara Village instead. The water's cool and clean there...","nextNodeIds":[736500145]},{"nodeId":736500145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1512149794,"text":"Whoa, poor guy! It's partially his fault for ending up like this, but still...","nextNodeIds":[736500146]},{"nodeId":736500146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2789027210,"text":"#{NICKNAME}, let's just help him, shall we?","nextNodeIds":[736500147]},{"nodeId":736500147,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3704481282,"text":"Well, now that you've said this much...","nextNodeIds":[736500148]},{"nodeId":736500148,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":596493682,"text":"R—Really? But it's a very dangerous job...","nextNodeIds":[736500149]},{"nodeId":736500149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4053721354,"text":"No worries! We're pretty good at fighting monsters!","nextNodeIds":[736500150]},{"nodeId":736500150,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3555135666,"text":"Ah, thank you! Thank you! Does this mean I can finish my thesis now? I'd even sell myself to you if you can help me do that!","nextNodeIds":[736500151]},{"nodeId":736500151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3019967010,"text":"Uh, you totally don't have to! And we don't wanna buy you, anyway...","nextNodeIds":[736500152]},{"nodeId":736500152,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1080875346,"text":"Sorry... apologies for my lack of composure. How about this, then? Let's go to the testing ground I've prepared.","nextNodeIds":[]},{"nodeId":736500134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2915680714,"text":"Defense... Deficiencies...?","nextNodeIds":[736500135]},{"nodeId":736500121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2262172226,"text":"Looks like he has some ulterior motives...","nextNodeIds":[736500122]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7365002,"order":2,"stepDescription":"Talk to Jami","stepDescTextMapHash":465502364,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7365002],"talks":[{"talkId":7365002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7365002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7365002,"initDialog":736500201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30225],"performCfg":"QuestDialogue/WQ/Sumeru_73650/Q7365002","priority":5,"questId":73650,"showRandomTalkCount":0},"dialogs":[{"nodeId":736500201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3291723490,"text":"Paimon didn't realize that we had walked all this way here...","nextNodeIds":[736500202]},{"nodeId":736500202,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2097429162,"text":"There's no other way around, I fear.","nextNodeIds":[736500203]},{"nodeId":736500203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1187813930,"text":"This is too far from Port Ormos...","nextNodeIds":[736500204]},{"nodeId":736500204,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3356415578,"text":"Well, this is about my test subjects after all. You know, my mentor wanted me to observe every living being in Teyvat. An impossible task, I tell you!","nextNodeIds":[736500205]},{"nodeId":736500205,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3555093354,"text":"And that's why I started by researching creatures from Sumeru and Liyue...","nextNodeIds":[736500206]},{"nodeId":736500206,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3143101954,"text":"By the way, please hold this. It's a special potion for my research that works within the testing grounds.","nextNodeIds":[736500207]},{"nodeId":736500207,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3154284026,"text":"It's called the \"Fayz Potion,\" and it was formulated by my seniors at Amurta. It's expensive and complicated to make, so I've only managed to make a few...","nextNodeIds":[736500208]},{"nodeId":736500208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1172614338,"text":"What's this potion gotta do with your experiment?","nextNodeIds":[736500209]},{"nodeId":736500209,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2968990658,"text":"Here's how it works: you will subjectively feel that time will slow down in a very extreme manner after taking the \"Fayz Potion.\" It'll feel like one moment is eternal.","nextNodeIds":[736500210]},{"nodeId":736500210,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1088168562,"text":"This way, you can do more detailed photography and observations!","nextNodeIds":[736500211]},{"nodeId":736500211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2978869642,"text":"Wait a moment, couldn't you just do that yourself?","nextNodeIds":[736500212]},{"nodeId":736500212,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4187913426,"text":"I thought so too, but it's not that simple.","nextNodeIds":[736500213]},{"nodeId":736500213,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2425626602,"text":"As I said, you will subjectively feel time slowing down... But your body may not be able to keep up if you aren't agile enough...","nextNodeIds":[736500214]},{"nodeId":736500214,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3772864586,"text":"For example, if you quaff a Fayz Potion as a Spinocrocodile pounces on you but you aren't agile enough to dodge its lunging attack...","nextNodeIds":[736500215]},{"nodeId":736500215,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1277811986,"text":"Then you will see how its claws are ever so close to your face, yet your body just won't move out of the way...","nextNodeIds":[736500216]},{"nodeId":736500216,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":960474514,"text":"\"Why can't I move my body!?\" You may think to yourself. But it will be of no use. The paws will still stay so close to you that you can even see the dirty water and mud-stains on it.","nextNodeIds":[736500217]},{"nodeId":736500217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3657788858,"text":"Yikes...","nextNodeIds":[736500218]},{"nodeId":736500218,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":10178418,"text":"So, don't underestimate your opponents just because you feel that time is moving slowly.","nextNodeIds":[736500219]},{"nodeId":736500219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1897446202,"text":"Will do!","nextNodeIds":[736500220]},{"nodeId":736500220,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3498364722,"text":"The fate of my research is in your hands...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7365001,7365002],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","count":45},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"s