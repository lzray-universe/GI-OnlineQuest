NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7225001],"talks":[{"talkId":7225001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7225001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7225001,"initDialog":722500101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20358,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72249/Q7225001","priority":5,"questId":72250,"showRandomTalkCount":0},"dialogs":[{"nodeId":722500101,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":1110917458,"text":"Help! Help me!","nextNodeIds":[722500102]},{"nodeId":722500102,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":3938904154,"text":"I heard that our leaders were struggling to cope with Supada no Hiko's rebellion, and that the Dainichi Mikoshi was undefended, so I got to thinking a thought that I shouldn't have...","nextNodeIds":[722500103]},{"nodeId":722500103,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":4289081042,"text":"Please, good warden, please spare my unworthy life! I have a sickly mother to feed and 12 orphans to bring up! Please have mercy, treat me as but a mere fart to be ignored!","nextNodeIds":[722500104]},{"nodeId":722500104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2604187074,"text":"Ahem...","nextNodeIds":[722500105]},{"nodeId":722500105,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":1980419402,"text":"Eh? Oh, so you're not one of the guards around the Dainichi Mikoshi.","nextNodeIds":[722500106]},{"nodeId":722500106,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":1142266442,"text":"By the looks of your unusual garments... Might you be someone in the same line of work as me — you know, just from someplace else?","nextNodeIds":[722500107]},{"nodeId":722500107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2029149450,"text":"Who'd want to be in your line of work!?","nextNodeIds":[722500108]},{"nodeId":722500108,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":1571559218,"text":"Oh, come now, there's no need to play pretend. *sigh* I must be the unluckiest person ever. It took me so much effort to get into the Dainichi Mikoshi, and just as I was planning to make a real fortune... I wound up being caught in a mechanical trap.","nextNodeIds":[722500109]},{"nodeId":722500109,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":1580955794,"text":"I guess this just isn't the day for \"robbing the rich to pay the poor.\"","nextNodeIds":[722500110]},{"nodeId":722500110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1525595698,"text":"Bah, call a spade a spade, call a thief a thief!","nextNodeIds":[722500111]},{"nodeId":722500111,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":3999117330,"text":"And what would you know about that? The big shots listen to decadent music, eat well, and drink lavishly, while we bottom-dwellers work ourselves to the bone tossing out their chamber pots and warming their sandals! Where's the logic in that?","nextNodeIds":[722500112]},{"nodeId":722500112,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":2476584130,"text":"Let me tell you a secret — consider it repayment for saving my life. I gave the artisans maintaining this place a little something to loosen their tongues, and they told me that there are two more rooms in this place that are used to store treasure.","nextNodeIds":[722500113]},{"nodeId":722500113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":733278930,"text":"Two more!","nextNodeIds":[722500114]},{"nodeId":722500114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4108863298,"text":"#Well, uh, {NICKNAME}, what say you and Paimon do some \"robbing the rich to pay the poor\" ourselves, eh?","nextNodeIds":[722500115]},{"nodeId":722500115,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":1238997354,"text":"However, I don't know where these rooms are. Those artisans didn't dare to tell me anything more.","nextNodeIds":[722500116]},{"nodeId":722500116,"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","textMapHash":1358566642,"text":"Consider that intel my gift to you!","nextNodeIds":[722500117]},{"nodeId":722500117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3465338026,"text":"Well, no one's in Enkanomiya right now, so let's go see what ancient relics we can find in those rooms, shall we?","nextNodeIds":[722500118]},{"nodeId":722500118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2003977026,"text":"#C'mon, {NICKNAME}, let's have a little sneaky look around!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7224108,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7224113,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7225001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20358,"speakerName":"Gama","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3544167734,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Inazuma_72249/Q72