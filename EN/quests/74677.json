{"mainQuestId":74677,"title":"The Art of the Elegant Blade Dance?","description":"In a nondescript corner of Belleau Region, you and Paimon discover the entrance to a Domain. A Blade Dancer in high spirits extends a special invitation to you...","titleTextMapHash":2535885047,"descTextMapHash":2816982646,"mainQuestExcel":{"mainQuestId":74677,"titleTextMapHash":2535885047,"title":"The Art of the Elegant Blade Dance?","descTextMapHash":2816982646,"description":"In a nondescript corner of Belleau Region, you and Paimon discover the entrance to a Domain. A Blade Dancer in high spirits extends a special invitation to you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5172,"luaPath":"Actor/Quest/WQ74677","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5172,"chapterId":0,"descTextMapHash":2816982646,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74677,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":298809113,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74677","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174677],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2535885047,"type":"WQ","unlockDescTextMapHash":3742815622}},"flow":[{"subQuestId":7467701,"order":1,"stepDescription":"Talk to the strange \"swordsman\"","stepDescTextMapHash":981363300,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30483"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467701],"talks":[{"talkId":7467701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7467701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467701,"initDialog":746770101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30483],"performCfg":"QuestDialogue/WQ/GoalChallenge_74677/Q7467701","priority":5,"questId":74677,"showRandomTalkCount":0},"dialogs":[{"nodeId":746770101,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":348341122,"text":"Haha! What luck that two fine-looking adventurers such as yourselves have run into me, Costentin, here today. It must be fate...","nextNodeIds":[746770102]},{"nodeId":746770102,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":3917472826,"text":"So tell me, the pair of you — do you wish to revel in glorious combat?","nextNodeIds":[746770103]},{"nodeId":746770103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":964023570,"text":"Talk about out of the blue! Do you usually start conversations like this?","nextNodeIds":[746770104,746770105]},{"nodeId":746770104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3149530418,"text":"Are you looking to pick a quarrel?","nextNodeIds":[746770106]},{"nodeId":746770106,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2793665786,"text":"No no, I'm not challenging you two to a fight...","nextNodeIds":[746770107]},{"nodeId":746770107,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2153831378,"text":"By \"combat,\" I don't mean some frivolous venting of pent-up anger, nor some kind of highway robbery.","nextNodeIds":[746770108]},{"nodeId":746770108,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1426601258,"text":"I'm talking about an ode to your inner passion, an artistic appreciation of the expression of your natural instincts!","nextNodeIds":[746770109]},{"nodeId":746770109,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":3993118634,"text":"Evolution has given us hands with which to grip our swords, so it's our duty to use them for their purpose: clenching a blade most beautiful and wielding it in an elegant dance of death!","nextNodeIds":[746770110]},{"nodeId":746770110,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":569179282,"text":"As a pair of intrepid adventurers, I have no doubt that you'll be masters of this art!","nextNodeIds":[746770111]},{"nodeId":746770111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1704808706,"text":"Uhh, you seem to be grasping the wrong end of the stick when it comes to combat... you're making it sound like the best thing since sliced bread!","nextNodeIds":[746770112]},{"nodeId":746770112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2617114874,"text":"#Even though Paimon doesn't usually get involved, just seeing how {NICKNAME} deals with enemies is enough for her to know that fighting's really tough!","nextNodeIds":[746770113]},{"nodeId":746770113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":438288442,"text":"That's another thing, we haven't even told you who we are! How can you be so sure we're good at fighting?","nextNodeIds":[746770114]},{"nodeId":746770114,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2705754402,"text":"Well, we're already quite some distance from the Court of Fontaine. How else could you have gotten here, if not by slaughtering every monster obstructing your path? By dropping out of the sky?","nextNodeIds":[746770115,746770116]},{"nodeId":746770115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3667509482,"text":"Wrong! I know an even better way to travel!","nextNodeIds":[746770117]},{"nodeId":746770117,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1124918674,"text":"Anyway, the aura emanating from you betrays how strong you are! I'm sure you've vanquished many powerful foes, and equally certain that you'll be very interested to hear about the one that resides in the Domain behind me...","nextNodeIds":[746770118]},{"nodeId":746770118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2968538394,"text":"Hey, now we're back to familiar territory! Let Paimon guess, you were about to ask... \"Would the two of you please demonstrate your prowess in combat for me?\"","nextNodeIds":[746770119]},{"nodeId":746770119,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":4168299130,"text":"That's right! Would the two of you please demonstrate your prowess in combat for me? Pretty please?","nextNodeIds":[746770120]},{"nodeId":746770120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":435867090,"text":"Then our response is — Why don't you go do it yourself, huh?","nextNodeIds":[746770121]},{"nodeId":746770121,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":3297619034,"text":"Because when I went inside just now, I got beaten black and blue! Only you can't tell because I covered it up with makeup as quickly as I could.","nextNodeIds":[746770122]},{"nodeId":746770122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2953526994,"text":"Paimon didn't expect you to just admit it like that!","nextNodeIds":[746770123,746770124]},{"nodeId":746770123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3432233098,"text":"Awww, poor you!","nextNodeIds":[746770125]},{"nodeId":746770125,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":44262578,"text":"There's no shame in defeat. After all, I'm only a writer, so naturally I'm not an expert fighter. I haven't been practicing for nearly long enough.","nextNodeIds":[746770126]},{"nodeId":746770126,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1185392474,"text":"I only got the urge to put myself to the test after coming across stories about a certain \"Blade Dancer\" called Lafeinte while reading through some reference materials.","nextNodeIds":[746770127]},{"nodeId":746770127,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2557441770,"text":"He likened combat to a dance of blades, and with the help of a certain talented engineer, had multiple arenas built where exquisite performances were held...","nextNodeIds":[746770128]},{"nodeId":746770128,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2888184666,"text":"Such... consummate elegance!","nextNodeIds":[746770129]},{"nodeId":746770129,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":4256409962,"text":"Though he ended up in the Maison Gardiennage's bad books and had to flee Fontaine, stories of such legendary deeds make for gripping reading. I couldn't just let such top-notch source material go completely to waste!","nextNodeIds":[746770130]},{"nodeId":746770130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2120821970,"text":"So what you're saying is, you were trying to imitate a legendary figure...?","nextNodeIds":[746770131]},{"nodeId":746770131,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2492215130,"text":"Exactly! I wanted to get into his head and understand his frame of mind. It took years of painstaking searching before I finally found this Domain.","nextNodeIds":[746770132]},{"nodeId":746770132,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1569920522,"text":"It seems luck is with me! This must have been one of the arenas that the \"Blade Dancer\" built back in the day. If only someone could perform such a blade dance in the flesh and let me bear witness to the spectacle...","nextNodeIds":[746770133]},{"nodeId":746770133,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1863498666,"text":"I'd be able to write a novel about a legendary swordsman, modeled after the \"Blade Dancer\" himself, and in so doing keep his elegance alive for posterity!","nextNodeIds":[746770134]},{"nodeId":746770134,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1748421594,"text":"Of course, the two of you will certainly be richly rewarded for your trouble.","nextNodeIds":[746770135]},{"nodeId":746770135,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":4092092546,"text":"My writings would also be a written record of your hard work, which would itself become the stuff of legend, passed down far into the future... At least among novel enthusiasts...","nextNodeIds":[746770136]},{"nodeId":746770136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3609935106,"text":"#When you put it all fancy like that, Paimon's starting to feel curious... {NICKNAME}, whaddya say?","nextNodeIds":[746770137,746770138]},{"nodeId":746770137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4115669986,"text":"I get to fight, and even get paid for it?","nextNodeIds":[746770139]},{"nodeId":746770139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2121550218,"text":"Good point... That means we're agreeing to help this swashbuckling novelist, right?","nextNodeIds":[746770140]},{"nodeId":746770140,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":3425047794,"text":"Woohoo! I knew you'd agree!","nextNodeIds":[746770141]},{"nodeId":746770141,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":1392065402,"text":"Then I'll leave it to you two! And don't you worry, I've hidden a Kamera in the Domain that will capture all of your heroics.","nextNodeIds":[746770142]},{"nodeId":746770142,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","textMapHash":2815381130,"text":"Your promised reward will be waiting for you upon your triumphant return!","nextNodeIds":[]},{"nodeId":746770138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2600701610,"text":"That's basically free money!","nextNodeIds":[746770139]},{"nodeId":746770124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3927286762,"text":"Great job with the makeup, you nailed it!","nextNodeIds":[746770125]},{"nodeId":746770116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3014615410,"text":"Wrong! We jumped off the aquabus!","nextNodeIds":[746770117]},{"nodeId":746770105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1765650466,"text":"...Or just hungry for a knuckle sandwich?","nextNodeIds":[746770106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30483"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"Costentin","count":24},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_R