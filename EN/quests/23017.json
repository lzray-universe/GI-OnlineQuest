0201,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":4287029658,"text":"Did you get the insignias?","nextNodeIds":[]}]},{"talkId":2301750,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2301702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2301750,"initDialog":230175001,"nextRandomTalks":[],"nextTalks":[],"npcId":[12700],"performCfg":"","priority":5,"questId":23017,"showRandomTalkCount":0},"dialogs":[{"nodeId":230175001,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":3542525690,"text":"Hello? Um... What would you like to know?","nextNodeIds":[230175002]},{"nodeId":230175002,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":504762858,"text":"How did you get to know Mr. Garcia?","nextNodeIds":[230175003]},{"nodeId":230175003,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":632265842,"text":"Cutting straight to the chase, huh? As befits an adventurer, I suppose.","nextNodeIds":[230175004]},{"nodeId":230175004,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":794943978,"text":"I got to meet Garcia because... our troupe director hired him as an accountant.","nextNodeIds":[230175005]},{"nodeId":230175005,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":4049889586,"text":"Haha, to be honest, I have never seen anyone quite so incompatible with our troupe.","nextNodeIds":[230175006]},{"nodeId":230175006,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":3640082970,"text":"We were playing music, dancing, drinking, and singing, and there he was on the sidelines, doing his calculations in silence with Lutong.","nextNodeIds":[230175007]},{"nodeId":230175007,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2780729594,"text":"There was a time when I saw him in strange clothes that had some drawings on it.","nextNodeIds":[230175008]},{"nodeId":230175008,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2439047890,"text":"I was curious and asked about the drawing. He said that it was the blueprint of a machine.","nextNodeIds":[230175009]},{"nodeId":230175009,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":3044283690,"text":"He said he drew on his outfit because he happened to have neither pen nor paper when he was telling someone about the machine.","nextNodeIds":[230175010]},{"nodeId":230175010,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2283668314,"text":"As such, he used coal to draw on his own outfit to demonstrate and explain the blueprint.","nextNodeIds":[230175011]},{"nodeId":230175011,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2350178154,"text":"Then we spent a lot of time talking about that outfit and his machine... And, of course, he did most of the talking, while I was the listener.","nextNodeIds":[230175012]},{"nodeId":230175012,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":1203417234,"text":"Hehe, he really is a weirdo but... he is also quite the charmer.","nextNodeIds":[]}]},{"talkId":2301751,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2301702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUES