:"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":2301752,"initDialog":230175001,"nextRandomTalks":[],"nextTalks":[],"npcId":[12700],"performCfg":"","priority":5,"questId":23017,"showRandomTalkCount":0},"dialogs":[{"nodeId":230175001,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":3542525690,"text":"Hello? Um... What would you like to know?","nextNodeIds":[230175002]},{"nodeId":230175002,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":504762858,"text":"How did you get to know Mr. Garcia?","nextNodeIds":[230175003]},{"nodeId":230175003,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":632265842,"text":"Cutting straight to the chase, huh? As befits an adventurer, I suppose.","nextNodeIds":[230175004]},{"nodeId":230175004,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":794943978,"text":"I got to meet Garcia because... our troupe director hired him as an accountant.","nextNodeIds":[230175005]},{"nodeId":230175005,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":4049889586,"text":"Haha, to be honest, I have never seen anyone quite so incompatible with our troupe.","nextNodeIds":[230175006]},{"nodeId":230175006,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":3640082970,"text":"We were playing music, dancing, drinking, and singing, and there he was on the sidelines, doing his calculations in silence with Lutong.","nextNodeIds":[230175007]},{"nodeId":230175007,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2780729594,"text":"There was a time when I saw him in strange clothes that had some drawings on it.","nextNodeIds":[230175008]},{"nodeId":230175008,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2439047890,"text":"I was curious and asked about the drawing. He said that it was the blueprint of a machine.","nextNodeIds":[230175009]},{"nodeId":230175009,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":3044283690,"text":"He said he drew on his outfit because he happened to have neither pen nor paper when he was telling someone about the machine.","nextNodeIds":[230175010]},{"nodeId":230175010,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2283668314,"text":"As such, he used coal to draw on his own outfit to demonstrate and explain the blueprint.","nextNodeIds":[230175011]},{"nodeId":230175011,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2350178154,"text":"Then we spent a lot of time talking about that outfit and his machine... And, of course, he did most of the talking, while I was the listener.","nextNodeIds":[230175012]},{"nodeId":230175012,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":1203417234,"text":"Hehe, he really is a weirdo but... he is also quite the charmer.","nextNodeIds":[]}]}],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":3500298162,"text":"(Etiquette, etiquette! For goodness' sake, don't forget your etiquette!)"},{"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":910290258,"text":"(Should I tell Mr. Garcia that his features are contorted...?)"}],"talkIds":[2301701,2301702,2301703,2301704,2301750,2301751,2301752],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","count":25},{"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","count":14},{"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":true,"CBBBCAKOFGO":615864270,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/IQ/Sumeru_23017/Q2301701","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":230170101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":2301701,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[20657,20658],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["2301701","2"],"_type":"QUEST_COND_STATE_EQUAL"}],"NIJAPEJKLDI":false,"NMKNFLIHHHE":