T","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20657"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2301701],"talks":[{"talkId":2301701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2301701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2301701,"initDialog":230170101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20657,20658],"performCfg":"QuestDialogue/IQ/Sumeru_23017/Q2301701","priority":5,"questId":23017,"showRandomTalkCount":0},"dialogs":[{"nodeId":230170101,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":751232042,"text":"T—Traveler! You're just in time. I was just about to go back to work after this coffee break with Ms. Kaia. Allow me to introduce you...","nextNodeIds":[230170102]},{"nodeId":230170102,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":3792754386,"text":"Ah, so you must be the Traveler Garcia's been talking about. It's a pleasure to meet you, I'm Kaia, a... um... well, I dance.","nextNodeIds":[230170104]},{"nodeId":230170104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3639283714,"text":"Hello, Garcia mentioned you before, I believe.","nextNodeIds":[230170105]},{"nodeId":230170105,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2289106682,"text":"Hehe, is that so? I'm happy to hear that. I was beginning to think that he commits nothing but his machine and Lutong to memory.","nextNodeIds":[230170106]},{"nodeId":230170106,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":2947005778,"text":"You can safely exclude me from this, Ma'am. I believe that this shall be to Mr. Garcia's liking, too.","nextNodeIds":[230170107]},{"nodeId":230170107,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"Kaia","textMapHash":2657514850,"text":"Now, that wouldn't do. Without you, Garcia would surely find himself penniless in the end.","nextNodeIds":[230170108]},{"nodeId":230170108,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":2882477418,"text":"Forgive me, Ma'am, if I must disagree. I am certain that Mr. Garcia would save up for two cups of coffee, no matter what.","nextNodeIds":[230170109]},{"nodeId":230170109,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":1423077490,"text":"Make that three cups!","nextNodeIds":[230170110]},{"nodeId":230170110,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"Lutong","textMapHash":1819570642,"text":"You display most astonishing empathy, Mr. Garcia.","nextNodeIds":[230170111]},{"nodeId":230170111,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":1143415914,"text":"Well, b—back to business! Now, Traveler, I am still in need of the insignias that the Treasure Hoarders carry with them. Should you find any, do consider selling them to me.","nextNodeIds":[230170112]},{"nodeId":230170112,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"Garcia","textMapHash":2205984282,"text":"I have... earned some Mora recently. So you need not fret about your payment.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["2301402"],"PAINLIBBLDK":"QUEST_EXEC_ACTIVE_ITEM_GIVING"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20657"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2301702,"order":2,"stepDescription":"Obtain Treasures Hoarders' insignias for Garcia","stepDescTextMapHash":1790910876,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301402,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJ