":[],"nextTalks":[2203102],"npcId":[3060],"performCfg":"","priority":5,"questId":22031,"showRandomTalkCount":0},"dialogs":[{"nodeId":220310101,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1227937810,"text":"Straight lance, straight line... Hah!","nextNodeIds":[220310102]},{"nodeId":220310102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":574193178,"text":"I'm here to spar again.","nextNodeIds":[220310103]},{"nodeId":220310103,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2526358458,"text":"Oh! It's you. Did you take my commission again? Much obliged!","nextNodeIds":[220310104]},{"nodeId":220310104,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1037991026,"text":"It's truly great to have someone as formidable as you to practice with me.","nextNodeIds":[220310105,220310110]},{"nodeId":220310105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3865295514,"text":"Your skill with a lance has improved a lot.","nextNodeIds":[220310106]},{"nodeId":220310106,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1379757418,"text":"Haha... You jest too much.","nextNodeIds":[220310107]},{"nodeId":220310107,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":501418010,"text":"From what I have heard, one of the reasons why the lance was invented was that it allows someone who doesn't really know how to wield a weapon such as myself to fight with ease.","nextNodeIds":[220310108]},{"nodeId":220310108,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2152482778,"text":"After all, this type of weapon is long and sharp. Even if the wielder doesn't know how to use it, simply stabbing and swinging with it at least appears strong.","nextNodeIds":[220310109]},{"nodeId":220310109,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2795463394,"text":"However, by this rule... I actually think the humble garden fork with its three sharp tips has greater power...","nextNodeIds":[]},{"nodeId":220310110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":153067146,"text":"Haven't you already taken your weapon back?","nextNodeIds":[220310111]},{"nodeId":220310111,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":506728258,"text":"I did retrieve my weapon, yes, but that doesn't mean that my training is over.","nextNodeIds":[220310112]},{"nodeId":220310112,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3184822418,"text":"I had a run-in with the Kairagi before. It would be presumptuous to say that I will not run into even stronger enemies in the future.","nextNodeIds":[220310113]},{"nodeId":220310113,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":221035906,"text":"I shall never let my weapon fall into the hands of the enemy again, thus allowing my honor as a samurai be desecrated. That's the way of samurai I wish to pursue.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2203101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3060"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2203102,"order":2,"stepDescription":"Talk to Asakura","stepDescTextMapHash":201647540,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2203105,0],"PAINLIBBLDK":"QUEST_CON