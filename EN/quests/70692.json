{"mainQuestId":70692,"title":"Let's Go, Saury-Saury Scout!","description":"Thanks to recent exchanges with friends from different nations, Mika from the Reconnaissance Company has reached a new milestone...","titleTextMapHash":92271679,"descTextMapHash":2082636758,"mainQuestExcel":{"mainQuestId":70692,"titleTextMapHash":92271679,"title":"Let's Go, Saury-Saury Scout!","descTextMapHash":2082636758,"description":"Thanks to recent exchanges with friends from different nations, Mika from the Reconnaissance Company has reached a new milestone...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2044,"luaPath":"Actor/Quest/WQ70692","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2044,"chapterId":0,"descTextMapHash":2082636758,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70692,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":3045495585,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70692","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170692],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":92271679,"type":"WQ","unlockDescTextMapHash":2161989246}},"flow":[{"subQuestId":7069201,"order":1,"stepDescription":"Talk to Mika","stepDescTextMapHash":1664563836,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1060"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7069201],"talks":[{"talkId":7069201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7069201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7069201,"initDialog":706920101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1060,30894],"performCfg":"QuestDialogue/WQ/DPEQ_70692/Q7069201","priority":5,"questId":70692,"showRandomTalkCount":0},"dialogs":[{"nodeId":706920101,"roleType":"TALK_ROLE_NPC","speakerId":30894,"speakerName":"\"Mural Maniac\"","textMapHash":261171218,"text":"Wow, young Knight, looks like you've brought our great hero over!","nextNodeIds":[706920102]},{"nodeId":706920102,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":4107932250,"text":"It's our Honorary Knight and the Helper in White! Greetings!","nextNodeIds":[706920103]},{"nodeId":706920103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1124227090,"text":"Mika and... a friend from Natlan? What are you guys doing here?","nextNodeIds":[706920104]},{"nodeId":706920104,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":1220129962,"text":"We're here to get the word out about something called the Saury-Saury Scout. We think it's something adventurers will find really useful.","nextNodeIds":[706920105]},{"nodeId":706920105,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3640072314,"text":"It combines the mechanical core of the Scouting Buddy that Amber brought back from Sumeru with the adorable appearance of the little saurian toy my friends from Natlan gave me.","nextNodeIds":[706920106]},{"nodeId":706920106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3458973914,"text":"Scouting Buddy... Oh, yeah, Paimon remembers!","nextNodeIds":[706920107]},{"nodeId":706920107,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":1350212794,"text":"Just like the Scouting Buddies from Sumeru, the Saury-Saury Scout can be used to perform monster recon and survey unfamiliar terrain.","nextNodeIds":[706920108]},{"nodeId":706920108,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":2880178650,"text":"But due to our focus being on the latter, the Saury-Saury Scout is designed with a greater emphasis on controllability and precision of movement.","nextNodeIds":[706920109]},{"nodeId":706920109,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3282704498,"text":"...Are you interested in taking it on a test flight, Honorary Knight?","nextNodeIds":[706920110,706920111]},{"nodeId":706920110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":421569178,"text":"That was a very serious introduction.","nextNodeIds":[706920112]},{"nodeId":706920112,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":404846906,"text":"Huh? Perhaps I was a little bit nervous just now...","nextNodeIds":[706920113]},{"nodeId":706920113,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":4038019922,"text":"That must be it... I could swear I was more relaxed around you before.","nextNodeIds":[706920114]},{"nodeId":706920114,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":531933498,"text":"It's just that I've been hearing so many stories about you from friends in other nations lately — your deeds are getting more and more exceptional...","nextNodeIds":[706920115]},{"nodeId":706920115,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3188010586,"text":"Every time I think about how I need to be helpful and not get in your way, I can't help but tense up again.","nextNodeIds":[706920116]},{"nodeId":706920116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":299121634,"text":"That's such a Mika thing to say...","nextNodeIds":[706920117]},{"nodeId":706920117,"roleType":"TALK_ROLE_NPC","speakerId":30894,"speakerName":"\"Mural Maniac\"","textMapHash":18149258,"text":"You're doing very well, young Knight!","nextNodeIds":[706920118]},{"nodeId":706920118,"roleType":"TALK_ROLE_NPC","speakerId":30894,"speakerName":"\"Mural Maniac\"","textMapHash":2088374082,"text":"#Sometimes, in Natlan, when a warrior from our tribe runs into {NICKNAME}, they get so excited they just start blabbering. I've even seen folks get so overwhelmed, they can't get a single word out!","nextNodeIds":[706920119]},{"nodeId":706920119,"roleType":"TALK_ROLE_NPC","speakerId":30894,"speakerName":"\"Mural Maniac\"","textMapHash":2857814282,"text":"#As someone who works alongside {NICKNAME}, you're basically a legend yourself. There's no need for you to be nervous, even when talking to our chief!","nextNodeIds":[706920120]},{"nodeId":706920120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3719056346,"text":"That's right! You should have more faith in yourself, Mika!","nextNodeIds":[706920121]},{"nodeId":706920121,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3309025978,"text":"Hmm... I've never really thought about it from that point of view before...","nextNodeIds":[706920122]},{"nodeId":706920122,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3765412682,"text":"#Anyway, {NICKNAME}, if you test out the Saury-Saury Scout and find it makes the grade, then we'll know for sure that it's a reliable, adorable mechanism that can be a big help to all sorts of adventurers!","nextNodeIds":[706920123,706920124]},{"nodeId":706920123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":395049874,"text":"I'm a bit of a testing expert!","nextNodeIds":[706920125]},{"nodeId":706920125,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":1268253266,"text":"Fantastic! Let me just make a few final tweaks, and then you're good to go!","nextNodeIds":[]},{"nodeId":706920124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":118701746,"text":"Let's see what this Saury-Saury can do!","nextNodeIds":[706920125]},{"nodeId":706920111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3045417866,"text":"There's no need to be so formal.","nextNodeIds":[706920112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1060"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7069201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":30894,"speakerName":"\"Mural Maniac\"","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170692],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2082636758,"CHECNJEMEFE":{"30894":[1190],"1060":[1180]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/DPEQ_70692/Q7069201","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNK