m":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7424601,"initDialog":742460101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2625,2506],"performCfg":"QuestDialogue/WQ/Liyue_74246/Q7424601","priority":5,"questId":74246,"showRandomTalkCount":0},"dialogs":[{"nodeId":742460101,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":2604558618,"text":"Right, there you are! All your Xiao Lantern parts, crafted to order, and every piece individually waterproofed.","nextNodeIds":[742460102]},{"nodeId":742460102,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":2155084842,"text":"Each is wrapped in five to six layers of oilpaper, so you could toss 'em in a pond to soak for a week or so and they'd still be fine.","nextNodeIds":[742460103]},{"nodeId":742460103,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":2107830458,"text":"Thank you for your diligence. Rest assured, I shall compensate you for your labor and expenditures in full. After all, procuring all this when it isn't Lantern Rite must be quite the hassle.","nextNodeIds":[742460104]},{"nodeId":742460104,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":2566794794,"text":"It was nothing, really! No need to be so polite! Doing business means always putting the customer's needs first and foremost!","nextNodeIds":[742460105]},{"nodeId":742460105,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":610006738,"text":"Oh, right!