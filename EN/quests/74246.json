Hidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7424601,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7424602,"order":2,"stepDescription":"","stepDescTextMapHash":2292147196,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7424602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7424602],"talks":[{"talkId":7424602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7424602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7424602,"initDialog":742460201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2506,2625],"performCfg":"QuestDialogue/WQ/Liyue_74246/Q7424602","priority":5,"questId":74246,"showRandomTalkCount":0},"dialogs":[{"nodeId":742460201,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":1080829018,"text":"Right, there you are! All your Xiao Lantern parts, crafted to order, and every piece individually waterproofed.","nextNodeIds":[742460202]},{"nodeId":742460202,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":3483871218,"text":"Each is wrapped in five to six layers of oilpaper, so you could toss 'em in a pond to soak for a week or so and they'd still be fine.","nextNodeIds":[742460203]},{"nodeId":742460203,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":3123313586,"text":"My thanks for your diligence. Rest assured, I shall compensate you for your labor and expenditures in full.","nextNodeIds":[742460204]},{"nodeId":742460204,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":637079546,"text":"Come on, my good fellow! No need to be so polite! Doing business means always putting the customer's needs first and foremost!","nextNodeIds":[742460205]},{"nodeId":742460205,"roleType":"TALK_ROLE_NPC","speakerId":2506,"speakerName":"Fengtai","textMapHash":982613186,"text":"Oh, right! How did you find the tea you bought last time? Could I interest you in some Chenyu Adeptea as well? We just got a new batch in, freshly dried! Top-notch stuff, every leaf!","nextNodeIds":[742460206]},{"nodeId":742460206,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":1286167626,"text":"I see. If there's a discount, then...","nextNodeIds":[742460207]},{"nodeId":742460207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":527621042,"text":"Hold it right there, Neuvillette! You can't go buying stuff just 'cause they say there's a discount!","nextNodeIds":[742460208]},{"nodeId":742460208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":931215426,"text":"You didn't even finish the tea you bought last time!","nextNodeIds":[742460209]},{"nodeId":742460209,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":807656234,"text":"#{NICKNAME}? Paimon? Now this is a coincidence. I had just been wondering if you would come to Liyue Harbor for the festival. I wish you a happy Lantern Rite.","nextNodeIds":[742460210]},{"nodeId":742460210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2028617474,"text":"Hey, were you buying Xiao Lantern parts just now? And you even had him waterproof them, so does that mean...","nextNodeIds":[742460211]},{"nodeId":742460211,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":2650031978,"text":"Yes. I intend to gift these to the Melusines. They have never seen such lanterns before, and I'm sure they'll enjoy them.","nextNodeIds":[742460212]},{"nodeId":742460212,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":3168370242,"text":"I would still like to buy a few more to hang outside the Palais Mermonia. However, doing so would create a dilemma: Would it not be unfair that the Palais Mermonia is the only place with Xiao Lanterns?","nextNodeIds":[742460213]},{"nodeId":742460213,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":1061548418,"text":"Perhaps I should return and have the Gestionnaires make a bulk purchase, so Xiao Lanterns can be hung over the entire Court of Fontaine and Fortress of Meropide.","nextNodeIds":[742460214]},{"nodeId":742460214,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":2304136882,"text":"If you let the Gestionnaires handle it, we'll be lucky to hang up any Lanterns they buy before next year's Lantern Rite rolls around.","nextNodeIds":[742460215]},{"nodeId":742460215,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":1669739658,"text":"Also, point of caution, Your Honor — it might not be the best idea to hang them in Meropide.","nextNodeIds":[742460216]},{"nodeId":742460216,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":3896226914,"text":"They won't fly high within our walls, and I doubt many of the wishes the inmates'll write will have a chance of coming true.","nextNodeIds":[742460217]},{"nodeId":742460217,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":2891073506,"text":"They're unlikely to wish for anything in the public interest, anyway. Let's try and keep the Lanterns' reputation clean, yeah?","nextNodeIds":[742460218]},{"nodeId":742460218,"roleType":"TALK_ROLE_NPC","speakerId":1079,"speakerName":"Sigewinne","textMapHash":566094250,"text":"And as for the \"good wishes\" worth making, I've already sent them soaring on the inmates' behalf.","nextNodeIds":[742460219]},{"nodeId":742460219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3103323890,"text":"Heh, Lantern Festival's positively packed this year!","nextNodeIds":[742460220]},{"nodeId":742460220,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":1851801306,"text":"Oh, right. Happy Lantern Rite, everyone. Don't mind if I address you as a group, it's the thought that counts anyway.","nextNodeIds":[742460221,742460222,742460223,742460224,742460225]},{"nodeId":742460221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1457271474,"text":"Now, now, tradition dictates and all.","nextNodeIds":[742460226]},{"nodeId":742460226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":931768018,"text":"Hey! What's up with the \"too\" that Paimon got?","nextNodeIds":[742460227]},{"nodeId":742460227,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":2487382258,"text":"#Heh, Wriothesley, Miss Sigewinne, {NICKNAME}, Paimon. Allow me to wish you all a happy Lantern Rite as well.","nextNodeIds":[742460228]},{"nodeId":742460228,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":1739599610,"text":"This festival is wonderful indeed, to have brought us all together.","nextNodeIds":[742460229]},{"nodeId":742460229,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":1192487050,"text":"#Whoa, now this really feels like a party. Shame I didn't buy any of those Fortune Coin packets — otherwise, Liyue custom would've obliged us to hand one each to {NICKNAME} and Paimon.","nextNodeIds":[742460230]},{"nodeId":742460230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":342165186,"text":"A direct Mora injection into my coffers wouldn't hurt...","nextNodeIds":[742460231]},{"nodeId":742460231,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":354313946,"text":"Hahaha, fine by me! Let's go grab something good later, I'm sure Paimon can lead the way!","nextNodeIds":[742460232]},{"nodeId":742460232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2861263730,"text":"Really? Haha, then Paimon's gonna go all out on the menu!","nextNodeIds":[742460233]},{"nodeId":742460233,"roleType":"TALK_ROLE_NPC","speakerId":1079,"speakerName":"Sigewinne","textMapHash":1780934370,"text":"Won't you please join us as well, Monsieur Neuvillette?","nextNodeIds":[742460234]},{"nodeId":742460234,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":315315794,"text":"Of course, I'm more than willing.","nextNodeIds":[742460235]},{"nodeId":742460235,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":3865493954,"text":"Hey, I just noticed... That's a sharp new outfit you've got there. Goes perfectly with the holiday cheer... and that relaxed expression you're wearing.","nextNodeIds":[742460236]},{"nodeId":742460236,"roleType":"TALK_ROLE_NPC","speakerId":1079,"speakerName":"Sigewinne","textMapHash":2318549554,"text":"Hmm, Monsieur Neuvillette, looking at the weave and the ornamentation... If I'm not mistaken, this is Melusine handiwork.","nextNodeIds":[742460237]},{"nodeId":742460237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2953606258,"text":"Huh? You can tell?","nextNodeIds":[742460238]},{"nodeId":742460238,"roleType":"TALK_ROLE_NPC","speakerId":1079,"speakerName":"Sigewinne","textMapHash":3447309234,"text":"Yep! Looking at the design, I'd say it's one of Flo's creations. Laume probably contributed a lot, too.","nextNodeIds":[742460239]},{"nodeId":742460239,"roleType":"TALK_ROLE_NPC","speakerId":1079,"speakerName":"Sigewinne","textMapHash":4204722674,"text":"Anyway, it's dashing and elegant, and suits Monsieur Neuvillette well.","nextNodeIds":[742460240]},{"nodeId":742460240,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":2073098218,"text":"Indeed. This is a most precious gift the Melusines have given me.","nextNodeIds":[742460241]},{"nodeId":742460241,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2058762394,"text":"Neuvillette recounts how the Melusines gave him his new outfit...","nextNodeIds":[742460242]},{"nodeId":742460242,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":502545106,"text":"So, you're planning to give them Xiao Lanterns as a thank-you?","nextNodeIds":[742460243]},{"nodeId":742460243,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":4234166802,"text":"Yes. It is only polite to do so.","nextNodeIds":[742460244]},{"nodeId":742460244,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":1265144882,"text":"You can expect another thank-you gift from them, then.","nextNodeIds":[742460245]},{"nodeId":742460245,"roleType":"TALK_ROLE_NPC","speakerId":2625,"speakerName":"Neuvillette","textMapHash":1420788146,"text":"Yes, I suppose they will do that.","nextNodeIds":[742460246]},{"nodeId":742460246,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":2922440954,"text":"Fair enough, gifts are gifts, after all. If your office starts drowning in them, though, you can send the overflow my way.","nextNodeIds":[742460247]},{"nodeId":742460247,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":2355894258,"text":"My head nurse here is excellent at taking care of Melusine gifts.","nextNodeIds":[742460248]},{"nodeId":742460248,"roleType":"TALK_ROLE_NPC","speakerId":1079,"speakerName":"Sigewinne","textMapHash":3674559650,"text":"Hehe, leave it to me! I'll preserve their sentiments perfectly.","nextNodeIds":[742460249]},{"nodeId":742460249,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":2360186882,"text":"But first, why don't we find another place to stretch our legs?","nextNodeIds":[742460250]},{"nodeId":742460250,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":3362993442,"text":"Liyue's a beautiful place, and has a flavor completely unlike anything we're used to in Fontaine.","nextNodeIds":[742460251]},{"nodeId":742460251,"roleType":"TALK_ROLE_NPC","speakerId":1078,"speakerName":"Wriothesley","textMapHash":2483073490,"text":"And I'm not just talking about the tea, mind you.","nextNodeIds":[]},{"nodeId":742460222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1445452522,"text":"Happy Lantern Rite, Sigewinne.","nextNodeIds":[742460226]},{"nodeId":742460223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1272643162,"text":"Happy Lantern Rite, Wriothesley.","nextNodeIds":[742460226]},{"nodeId":742460224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":25675874,"text":"Happy Lantern Rite, Neuvillette!","nextNodeIds":[742460226]},{"nodeId":742460225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1080279474,"text":"Happy Lantern Rite to you too, Paimon!","nextNodeIds":[742460226]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7424602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7424603,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["7424601","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_