initDialog":716620301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30153],"performCfg":"QuestDialogue/WQ/Liyue_71662/Q7166203","priority":5,"questId":71662,"showRandomTalkCount":0},"dialogs":[{"nodeId":716620301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4015716314,"text":"This...","nextNodeIds":[716620302]},{"nodeId":716620302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":46053954,"text":"You sure this is the same place as that \"empty room\" you talked about?","nextNodeIds":[716620303,716620304]},{"nodeId":716620303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1058657874,"text":"This just looks like a normal Domain...","nextNodeIds":[716620305]},{"nodeId":716620305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3994560450,"text":"Exactly! Isn't this just an ordinary ruin? Y'know, the ones we visit all the time?","nextNodeIds":[716620306]},{"nodeId":716620306,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1299132706,"text":"This is indeed the Domain we mean to explore.","nextNodeIds":[716620307]},{"nodeId":716620307,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":825857058,"text":"And as for the reason why it looks like this...","nextNodeIds":[716620308]},{"nodeId":716620308,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2144261170,"text":"That's because this Domain changed its form not long ago.","nextNodeIds":[716620309]},{"nodeId":716620309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3713049338,"text":"Eh?","nextNodeIds":[716620310]},{"nodeId":716620310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2594482930,"text":"It \"changed its form\"? Into this?","nextNodeIds":[716620311]},{"nodeId":716620311,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2353270450,"text":"That's right. This Domain transforms based on people's wishes.","nextNodeIds":[716620312]},{"nodeId":716620312,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":190142922,"text":"According to the leader of the adventure team at that time, they'd started to lose patience with this place after exploring it for some time to no avail.","nextNodeIds":[716620313]},{"nodeId":716620313,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":644405146,"text":"One of their members began to grumble under their breath.","nextNodeIds":[716620314]},{"nodeId":716620314,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3192196714,"text":"\"If this was an ordinary Domain, we would've finished exploring it long ago.\"","nextNodeIds":[716620315]},{"nodeId":716620315,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":455862098,"text":"Hungry and tired as they were, the rest of the team expressed approval of that member's view.","nextNodeIds":[716620316]},{"nodeId":716620316,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2639343778,"text":"And as more people began to concur, the team suddenly found themselves in \"an ordinary Domain.\"","nextNodeIds":[716620317]},{"nodeId":716620317,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3205234546,"text":"This \"ordinary Domain\" contained mechanisms, paths, treasure... even torches that were still burning.","nextNodeIds":[716620318]},{"nodeId":716620318,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1830828146,"text":"The adventure team judged themselves unable to deal with such a situation, and thus reported back to the Guild immediately.","nextNodeIds":[716620319]},{"nodeId":716620319,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":950759314,"text":"In response, we quickly sent people to conduct further investigations.","nextNodeIds":[716620320]},{"nodeId":716620320,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2327648282,"text":"However, all we know even now is that this Domain can change according to a person's will.","nextNodeIds":[716620321]},{"nodeId":716620321,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2463674690,"text":"If many people enter the Domain at once, then it will react to the person with the strongest thoughts.","nextNodeIds":[716620322]},{"nodeId":716620322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3036899098,"text":"Wow! Does this mean that it could create, say, the entire Liyue Harbor in here?","nextNodeIds":[716620323]},{"nodeId":716620323,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1043048258,"text":"We've tried this, but to no avail. Perhaps our desire to create Liyue Harbor just wasn't strong enough.","nextNodeIds":[716620324]},{"nodeId":716620324,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2761835690,"text":"Whatever the case, we are currently gathering adventurers to enter this Domain and cause all manner of changes according to their desires.","nextNodeIds":[716620325]},{"nodeId":716620325,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":599478578,"text":"We hope that we might be able to figure out some of the rules and principles behind the changes this Domain undergoes, and thus get answers from there.","nextNodeIds":[716620326,716620327]},{"nodeId":716620326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1792932202,"text":"In that case, how should I operate this place?","nextNodeIds":[716620328]},{"nodeId":716620328,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":4078371162,"text":"Well, you see that mechanism over there? That's a \"trigger\" that we put in place. One of our adventurers dreamed this one up, in fact.","nextNodeIds":[716620329]},{"nodeId":716620329,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2746935042,"text":"In simple terms, his desire was \"to be able to change this Domain only when we touch this mechanism.\"","nextNodeIds":[716620330]},{"nodeId":716620330,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":4073373794,"text":"The Domain answered these wishes, but to ensure that this mechanism remains here, we have to periodically invite him back...","nextNodeIds":[716620331]},{"nodeId":716620331,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1542809922,"text":"Huh, to think that you could do something like that...","nextNodeIds":[716620332]},{"nodeId":716620332,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1254181826,"text":"If not for some of these contingencies, this Domain would keep changing all the time...","nextNodeIds":[716620333]},{"nodeId":716620333,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2558257170,"text":"But if you look at it from a different angle, this Domain really is quite suited to training adventurers. I mean, just one thought, and all sorts of mechanisms and terrain can emerge in a blink of an eye!","nextNodeIds":[716620334]},{"nodeId":716620334,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2109338314,"text":"Well, talk is cheap, though... So why don't you give it a go yourself?","nextNodeIds":[716620335]},{"nodeId":716620335,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3760605682,"text":"See that golden \"Adventure Coin\" over there? That's a little something we created using our willpower as well.","nextNodeIds":[716620336]},{"nodeId":716620336,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3171472850,"text":"Try getting ahold of that coin, would you?","nextNodeIds":[]},{"nodeId":716620327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2108458762,"text":"Is there some special method to all this?","nextNodeIds":[716620328]},{"nodeId":716620304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":557721154,"text":"Well, this place looks familiar...","nextNodeIds":[716620305]}]},{"talkId":7166206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166204","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7166206","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"