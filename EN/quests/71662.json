d":71662,"showRandomTalkCount":0},"dialogs":[{"nodeId":716620101,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1343709018,"text":"Hello there, Traveler. Great timing: we have a commission that I believe would best be taken up by you.","nextNodeIds":[716620102,716620103]},{"nodeId":716620102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1111881418,"text":"Is it a dangerous commission?","nextNodeIds":[716620104]},{"nodeId":716620104,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":618224194,"text":"Well, it involves a hitherto unknown Domain.","nextNodeIds":[716620105]},{"nodeId":716620105,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":4268258226,"text":"Though the Guild has undertaken extensive investigations into that Domain, we have yet to achieve results of any particular value.","nextNodeIds":[716620106]},{"nodeId":716620106,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2183313722,"text":"Honglang, who is in charge of this investigation, says that he needs the assistance of a highly adaptable adventurer.","nextNodeIds":[716620107]},{"nodeId":716620107,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3554659650,"text":"You were the first person I thought of, Traveler.","nextNodeIds":[716620108]},{"nodeId":716620108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3240531914,"text":"What sort of Domain is this...","nextNodeIds":[716620109]},{"nodeId":716620109,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3196140722,"text":"Honglang is at the entrance to this Domain. If you're willing to help, you can go ask him what he needs.","nextNodeIds":[716620110]},{"nodeId":716620110,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3263863186,"text":"We're counting on you, Traveler.","nextNodeIds":[]},{"nodeId":716620103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3718420530,"text":"Will it be difficult?","nextNodeIds":[716620104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2078"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7166202,"order":2,"stepDescription":"Talk to Honglang","stepDescTextMapHash":3323141612,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30153"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166202],"talks":[{"talkId":7166202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166202,"initDialog":716620201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30153],"performCfg":"QuestDialogue/WQ/Liyue_71662/Q7166202","priority":5,"questId":71662,"showRandomTalkCount":0},"dialogs":[{"nodeId":716620201,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1630437634,"text":"What's with this Domain...","nextNodeIds":[716620202]},{"nodeId":716620202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":478102242,"text":"Hey there, about the commission...","nextNodeIds":[716620203]},{"nodeId":716620203,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":987736570,"text":"Eh? You... Oh, so you're the one Ms. Katheryne called in?","nextNodeIds":[716620204]},{"nodeId":716620204,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":490872450,"text":"I've heard that you're flexible, highly experienced, and one of our top adventurers to boot...","nextNodeIds":[716620205,716620206]},{"nodeId":716620205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2382982570,"text":"That's about right.","nextNodeIds":[716620207]},{"nodeId":716620207,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":667955442,"text":"Wonderful! That's very reassuring indeed.","nextNodeIds":[716620208]},{"nodeId":716620208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1473187434,"text":"Still, could you tell me about this Domain...?","nextNodeIds":[716620209]},{"nodeId":716620209,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2029495290,"text":"Ah, yes, right. Sorry. Let me fill you in...","nextNodeIds":[716620210]},{"nodeId":716620210,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":8763626,"text":"Well, here's what happened: some time back, a team of adventurers found this strange, large door out in the wild... You're looking at it right now, naturally.","nextNodeIds":[716620211]},{"nodeId":716620211,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3747168282,"text":"Once they had passed through this gate, the team entered an unknown Domain.","nextNodeIds":[716620212]},{"nodeId":716620212,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2518411378,"text":"According to the first batch of adventurers, the Domain was just an \"empty room\" when they first entered it.","nextNodeIds":[716620213,716620214]},{"nodeId":716620213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":410145370,"text":"One moment. What do you mean?","nextNodeIds":[716620215]},{"nodeId":716620215,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2133620794,"text":"I'm just giving an example. To be precise, it was an area \"about 52 paces in length, 52 paces in breadth, and of unknown height.\"","nextNodeIds":[716620216]},{"nodeId":716620216,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1296756498,"text":"For 52 paces either way, the area was an ordinary stone-tiled floor, but all the areas beyond were filled with a deep gray smoke.","nextNodeIds":[716620217]},{"nodeId":716620217,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":36044210,"text":"Also, when someone tried to cross over the border into the area beyond the first 52 paces...","nextNodeIds":[716620218]},{"nodeId":716620218,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":4136663026,"text":"They would either mysteriously change direction and start walking the opposite way, or suddenly disappear and appear behind everyone else.","nextNodeIds":[716620219]},{"nodeId":716620219,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1647412586,"text":"Whatever the case, it was impossible to cross this 52-pace area.","nextNodeIds":[716620220]},{"nodeId":716620220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3003893138,"text":"Did they try using any other tools to explore the place?","nextNodeIds":[716620221]},{"nodeId":716620221,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3573056234,"text":"They did, of course. But thrown objects would return to their original places, and even the light of torches could not penetrate further than 52 paces away.","nextNodeIds":[716620222]},{"nodeId":716620222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3352140650,"text":"So, you'd like our help in investigating this place?","nextNodeIds":[716620223]},{"nodeId":716620223,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3920227394,"text":"That is the case. However... you won't just be doing \"exploration.\"","nextNodeIds":[716620224]},{"nodeId":716620224,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":573275874,"text":"I don't think it's possible to explain out here. Let's continue inside.","nextNodeIds":[]},{"nodeId":716620214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2336905650,"text":"An empty... room?","nextNodeIds":[716620215]},{"nodeId":716620206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2894546610,"text":"I guess you could say that...","nextNodeIds":[716620207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30153"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7166203,"order":3,"stepDescription":"Enter the Domain","stepDescTextMapHash":4012528316,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2122,512],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7166203"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QU