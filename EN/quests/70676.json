w":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7067602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067601,"initDialog":706760101,"nextRandomTalks":[],"nextTalks":[],"npcId":[9500],"performCfg":"QuestDialogue/WQ/Wolf_70676/Q7067601","priority":5,"questId":70676,"showRandomTalkCount":0},"dialogs":[{"nodeId":706760101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2917159226,"text":"Huh. What's a place like this doing in a library? Could this be the Restricted Section Lisa mentioned?","nextNodeIds":[706760102]},{"nodeId":706760102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2012471506,"text":"Hmm, doesn't quite feel like it, though...","nextNodeIds":[706760103]},{"nodeId":706760103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1920397906,"text":"...You don't think this place is hiding some terrible secret, do you? Like those rooms you always hear about in scary stories? Y'know, the ones that are usually totally off limits?","nextNodeIds":[706760104]},{"nodeId":706760104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2510040514,"text":"Surely it would be locked if that were the case.","nextNodeIds":[706760105]},{"nodeId":706760105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":86550354,"text":"That's true... We just kinda waltzed in here. And it didn't seem like the lock had been broken or anything...","nextNodeIds":[706760106]},{"nodeId":706760106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3982295714,"text":"Wait, hang on a minute! This isn't the door we came in through! Are we even in the library anymore?","nextNodeIds":[706760107,706760109]},{"nodeId":706760107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1521037546,"text":"We could be underneath Cider Lake?","nextNodeIds":[706760108]},{"nodeId":706760108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3375271706,"text":"You think? Wow. That's pretty impressive, building all this under the lake... Wait, no, that's ridiculous! No way is that where we are.","nextNodeIds":[706760111]},{"nodeId":706760111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1047150802,"text":"Hmm... Too bad Lisa's not working today, otherwise we could ask her... Well, we're here anyhow, and this place doesn't look too dangerous. Why don't we take a look around?","nextNodeIds":[706760112]},{"nodeId":706760112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":181253730,"text":"New places are meant for exploring, after all! You've gotta try all kinds of new things to become a good and experienced guide.","nextNodeIds":[706760113]},{"nodeId":706760113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1362856514,"text":"Ooh, look, a stuffed wolf toy! So cute!","nextNodeIds":[706760114]},{"nodeId":706760114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1547816234,"text":"It's so fluffy and soft! Huh, wonder who left it here...","nextNodeIds":[706760115,706760117]},{"nodeId":706760115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3916181546,"text":"For all you know, that toy might be this room's real master.","nextNodeIds":[706760116]},{"nodeId":706760116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":619907362,"text":"\"Awoooo! Foolish Traveler! You dare enter this fortress of doom without invitation! Prepare to be eaten alive!\"","nextNodeIds":[706760120]},{"nodeId":706760120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":512572882,"text":"...We should probably just leave it here for now. This place is huge, so let's keep on exploring!","nextNodeIds":[]},{"nodeId":706760117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3783864666,"text":"Or it might be the guardian of this mysterious room.","nextNodeIds":[706760118]},{"nodeId":706760118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3583793722,"text":"What sorta guardian would be dozing away on the sofa like this?","nextNodeIds":[706760119]},{"nodeId":706760119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":970789410,"text":"\"*snore* No danger in sight... Saw nothing, means nothing happened... *snore*\"","nextNodeIds":[706760120]},{"nodeId":706760109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3871690962,"text":"Perhaps we've reached another world...","nextNodeIds":[706760110]},{"nodeId":706760110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2351723754,"text":"And what world would that be, huh?","nextNodeIds":[706760111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[156,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[48000,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["3","1218"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"},{"LNHLPKELCAL":["1004","2"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"},{"LNHLPKELCAL":["48000","248000001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7067601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4073489574,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":5003,"IBEGAHMEABP":[{"<DLGBBM