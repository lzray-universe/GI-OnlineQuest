se,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2503404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2503405,"initDialog":250340501,"nextRandomTalks":[],"nextTalks":[],"npcId":[14371],"performCfg":"QuestDialogue/IQ/HookWalker_25034/Q2503405","priority":5,"questId":25034,"showRandomTalkCount":0},"dialogs":[{"nodeId":250340501,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":3720979722,"text":"#Thanks for saving us, {M#Big Bro}{F#Big Sis}.","nextNodeIds":[250340502]},{"nodeId":250340502,"roleType":"TALK_ROLE_NPC","speakerId":14372,"speakerName":"Qica","textMapHash":2447315090,"text":"Hrroo, roooh...","nextNodeIds":[250340503]},{"nodeId":250340503,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":468645730,"text":"This place was too far from the tribe — if you hadn't shown up, there's no way I'd have been able to alert Illapa before Qica got caught.","nextNodeIds":[250340504]},{"nodeId":250340504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2398939962,"text":"What are you two doing over here, anyway?","nextNodeIds":[250340505]},{"nodeId":250340505,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":2544005130,"text":"Climbing practice, as always — but we got hungry halfway through.","nextNodeIds":[250340506]},{"nodeId":250340506,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":1323589738,"text":"So the two of us went foraging... But before we knew it, we'd wandered off pretty far...","nextNodeIds":[250340507]},{"nodeId":250340507,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":1174690498,"text":"By the time we'd had our fill, we were a long, long way out. Mom's going to give it to me for sure when we get back...","nextNodeIds":[250340508]},{"nodeId":250340508,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":2234569058,"text":"Thanks again for saving us. Take these Cacahuatls — I only just plucked 'em!","nextNodeIds":[250340509]},{"nodeId":250340509,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":371625666,"text":"We'll head back as quick as we can. Come on, Qica!","nextNodeIds":[250340510]},{"nodeId":250340510,"roleType":"TALK_ROLE_NPC","speakerId":14372,"speakerName":"Qica","textMapHash":2423943714,"text":"Rawr! Rawrrr! Rawr!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503405,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["2503401","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["2503402","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["44230"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2503401_N14371"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[250