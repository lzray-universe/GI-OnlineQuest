R_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["14371"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2503401],"talks":[{"talkId":2503401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2503401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2503401,"initDialog":250340101,"nextRandomTalks":[],"nextTalks":[],"npcId":[14371,14373,14374],"performCfg":"QuestDialogue/IQ/HookWalker_25034/Q2503401","priority":5,"questId":25034,"showRandomTalkCount":0},"dialogs":[{"nodeId":250340101,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":1979734514,"text":"He doesn't like you, so scram!","nextNodeIds":[250340102]},{"nodeId":250340102,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":3778832858,"text":"Little runt... What's with you and the Saurian? You know him or something?","nextNodeIds":[250340103]},{"nodeId":250340103,"roleType":"TALK_ROLE_NPC","speakerId":14372,"speakerName":"Qica","textMapHash":99044290,"text":"Roar... Rawrrrr!","nextNodeIds":[250340104]},{"nodeId":250340104,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":1025342154,"text":"Oh, look, he's getting impatient. Alright then, whelp, stand aside. We don't hit kids.","nextNodeIds":[250340105]},{"nodeId":250340105,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":703169002,"text":"Bring the bag, boys. Bet you this Saurian'll sell for a good price.","nextNodeIds":[250340106]},{"nodeId":250340106,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":2419392474,"text":"Don't come any closer! And don't blame me if you get hurt!","nextNodeIds":[250340107]},{"nodeId":250340107,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":2503353026,"text":"W—Wait, you mean you're going to hit us? Hahahaha! You hear that, boys? He's gonna take us on!","nextNodeIds":[250340108]},{"nodeId":250340108,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":3909133514,"text":"Ooh, kiddo, I'm sho scared, I'm twembling in my bwoots. But if you say so... don't blame me if you get hurt.","nextNodeIds":[250340109]},{"nodeId":250340109,"roleType":"TALK_ROLE_NPC","speakerId":14372,"speakerName":"Qica","textMapHash":1611875730,"text":"Rawr! Rawrrr! Rawr!","nextNodeIds":[250340110]},{"nodeId":250340110,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":4237925578,"text":"Tch... Isn't this Saurian a noisy one. Alright, kid, just go have a nap over—","nextNodeIds":[250340111,250340112]},{"nodeId":250340111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":513476210,"text":"You're the ones who could use a nap.","nextNodeIds":[250340113]},{"nodeId":250340113,"roleType":"TALK_ROLE_NPC","speakerId":14371,"speakerName":"Tlatem","textMapHash":1107093618,"text":"#{M#Big Bro}{F#Big Sis}! They're trying to take Qica!","nextNodeIds":[250340114]},{"nodeId":250340114,"roleType":"TALK_ROLE_NPC","speakerId":14372,"speakerName":"Qica","textMapHash":666636202,"text":"Rroo! Wrroo!","nextNodeIds":[250340115]},{"nodeId":250340115,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":1712067130,"text":"...Hey, you. How about you step aside? We won't hurt you. Heck, we'll give you a share. How's that sound?","nextNodeIds":[250340116,250340117]},{"nodeId":250340116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1846046666,"text":"No hurting Qica.","nextNodeIds":[250340118]},{"nodeId":250340118,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":2111570706,"text":"Huh. Guess that's that, then. Well, I'm sure you know the rules. Let's get dangerous!","nextNodeIds":[250340119]},{"nodeId":250340119,"roleType":"TALK_ROLE_NPC","speakerId":14373,"speakerName":"Impatient Thief","textMapHash":4204787354,"text":"Let's go, lads!","nextNodeIds":[]},{"nodeId":250340117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4211463442,"text":"Who died and made you king?","nextNodeIds":[250340118]},{"nodeId":250340112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":961545770,"text":"Hope you don't mind if I chip in.","nextNodeIds":[250340113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["14371"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2503403,"order":2,"stepDescription":"Defeat all opponents","stepDescTextMapHash":126588708,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1335041091"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_8632:-1904.006,161.658,8057.434,0.000,305.941,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1335041091"}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[3,20],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"[3_8632:-1904.006,161.658,8057.434,0.000,305.941,0.000]"}],"execActions":[{"LNHLPKELCAL":["133504109"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE",