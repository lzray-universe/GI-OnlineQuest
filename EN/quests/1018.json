ETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10200"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[100397],"talks":[{"talkId":100397,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["101801","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":100397,"initDialog":10031801,"nextRandomTalks":[],"nextTalks":[],"npcId":[10200],"performCfg":"QuestDialogue/AQ/Liyue1_1003/Q100397","priority":5,"questId":1018,"showRandomTalkCount":0},"dialogs":[{"nodeId":10031801,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1482614153,"text":"You've finally returned. How was your journey to Jueyun Karst?","nextNodeIds":[10031802]},{"nodeId":10031802,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3113963737,"text":"...I see.","nextNodeIds":[]},{"nodeId":10031803,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":842460017,"text":"Moon Carver, Mountain Shaper, Cloud Retainer, Conqueror of Demons...","nextNodeIds":[10031804]},{"nodeId":10031804,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1986325985,"text":"Some of these names have never come up in the intel the Fatui gets hold of.","nextNodeIds":[10031805]},{"nodeId":10031805,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3656478145,"text":"As a returning gift, I too have information for you.","nextNodeIds":[10031809]},{"nodeId":10031809,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1020370953,"text":"Regarding the archon's passing... The Liyue Qixing's response really has given me food for thought...","nextNodeIds":[10031810]},{"nodeId":10031810,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3037589409,"text":"They've announced that, as the true killer has not yet been found, they are not allowing anyone to pay their respects to the Exuvia.","nextNodeIds":[10031811]},{"nodeId":10031811,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3417603945,"text":"They've even gone so far as to try and cut off information... But with the Rite of Descension and all, even the Qixing isn't able to keep a lid on things.","nextNodeIds":[10031812]},{"nodeId":10031812,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1685336473,"text":"Exuvia?","nextNodeIds":[10031813]},{"nodeId":10031813,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":41767649,"text":"It's common knowledge in Liyue that Rex Lapis is also an adeptus.","nextNodeIds":[10031814]},{"nodeId":10031814,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":723278161,"text":"The Geo Archon is also the God of Contracts, and is also known as the Exuvia, Prime of the Adepti.","nextNodeIds":[10031815]},{"nodeId":10031815,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2743583657,"text":"The mighty and illuminated adepti of today all signed contracts to protect Liyue way back then.","nextNodeIds":[10031816]},{"nodeId":10031816,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3821870617,"text":"Guess that explains why they're all so focused on Liyue's well-being.","nextNodeIds":[10031817]},{"nodeId":10031817,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":593784641,"text":"Naturally. They both have the responsibility and the aptitude for the job.","nextNodeIds":[10031818]},{"nodeId":10031818,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3257669969,"text":"If the ruling Qixing became unable to perform their duty properly, the adepti have the right to take corrective action.","nextNodeIds":[10031819]},{"nodeId":10031820,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2198281505,"text":"This makes things difficult for me too.","nextNodeIds":[10031822]},{"nodeId":10031821,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2588936033,"text":"I agree, something is definitely not right.","nextNodeIds":[10031822]},{"nodeId":10031819,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3977923161,"text":"The Geo Archon's spirit has risen, so why would the Qixing hide his vessel? Truly suspicious.","nextNodeIds":[10031820,10031821]},{"nodeId":10031822,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1999560681,"text":"Oh! Right! He's the whole reason we came here!","nextNodeIds":[10031823]},{"nodeId":10031823,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3225940577,"text":"If the Liyue Qixing has locked up Exuvia and won't let anyone near...","nextNodeIds":[10031824]},{"nodeId":10031824,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3303942057,"text":"#Then {NICKNAME}'s quest to find The Seven is already over!","nextNodeIds":[10031825]},{"nodeId":10031826,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3063903993,"text":"Nothing to do with you.","nextNodeIds":[10031828]},{"nodeId":10031827,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":251457617,"text":"No comment.","nextNodeIds":[10031828]},{"nodeId":10031825,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2614927329,"text":"Oh? You're trying to find The Seven? And just why might that be, pray tell?","nextNodeIds":[10031826,10031827]},{"nodeId":10031828,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3677177913,"text":"Heh... nice answer.","nextNodeIds":[10031829]},{"nodeId":10031829,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2230005609,"text":"A knight that gets duped by the Fatui would really be no knight at all now, would they?","nextNodeIds":[10031830]},{"nodeId":10031830,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3739075585,"text":"But, I can help you with that too you know.","nextNodeIds":[10031831]},{"nodeId":10031831,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2894123297,"text":"Hmm? Really?","nextNodeIds":[10031832]},{"nodeId":10031832,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2692718721,"text":"Give me some time.","nextNodeIds":[10031833]},{"nodeId":10031833,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2798587681,"text":"Time... to find someone.","nextNodeIds":[10031834]},{"nodeId":10031834,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2441440073,"text":"Someone who can help you break through this stalemate.","nextNodeIds":[10031835]},{"nodeId":10031835,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3327131145,"text":"Truly fascinating. The harder they try to silence the situation, the greater the chaos that erupts...","nextNodeIds":[10031836]},{"nodeId":10031836,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2798969745,"text":"If you want to be around to see it all come crashing down, best you stay alive until we next meet, yes?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[100397,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[100396,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["10004","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["100403","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10200"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":100396,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL