:"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7350201],"talks":[{"talkId":7350201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7350201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7350201,"initDialog":735020101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20834],"performCfg":"QuestDialogue/WQ/Sumeru_73502/Q7350201","priority":5,"questId":73502,"showRandomTalkCount":0},"dialogs":[{"nodeId":735020101,"roleType":"TALK_ROLE_NPC","speakerId":20834,"speakerName":"Investigate","textMapHash":3800455914,"text":"\"In the light of alternating day cycles, one can see the homeward figure of the lighthouse on the bridge.\"","nextNodeIds":[735020102]},{"nodeId":735020102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1777372130,"text":"Wh—What is this...? A riddle? Or a proverb or something...?","nextNodeIds":[735020103]},{"nodeId":735020103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2930095146,"text":"Alternating day cycles? Homeward figure...","nextNodeIds":[735020104]},{"nodeId":735020104,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":1284883018,"text":"Hello, traveler. Are you interested in Drusus's riddle too?","nextNodeIds":[735020105,735020106]},{"nodeId":735020105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":55959882,"text":"Is it really a riddle?","nextNodeIds":[735020107]},{"nodeId":735020107,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":1878044386,"text":"It was set up by an Akademiya researcher named Drusus.","nextNodeIds":[735020108]},{"nodeId":735020108,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":950665058,"text":"As far as I know, he's an eccentric even among the Akademiya crowd.","nextNodeIds":[735020109]},{"nodeId":735020109,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":3199754146,"text":"He loves to talk about riddles with anyone, as well as research all kinds of encryption methods.","nextNodeIds":[735020110]},{"nodeId":735020110,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":742037970,"text":"But some of his riddles are too incomprehensible, so not many people are willing to deal with him.","nextNodeIds":[735020111]},{"nodeId":735020111,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":2431578162,"text":"So he came up with the \"solve riddles for prizes\" idea.","nextNodeIds":[735020112]},{"nodeId":735020112,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":958671258,"text":"Simply put, this riddle actually hints at a treasure trove.","nextNodeIds":[735020113]},{"nodeId":735020113,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":206646106,"text":"You just have to show up at the right place at the right time using the right method and you'll get the treasure.","nextNodeIds":[735020114]},{"nodeId":735020114,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":3466360202,"text":"Drusus also gave a hint, saying that the locations are all within Sumeru City.","nextNodeIds":[735020115]},{"nodeId":735020115,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":723947234,"text":"But as you can see, no adventurer has been able to succeed.","nextNodeIds":[735020116]},{"nodeId":735020116,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":3121981538,"text":"You can certainly try if you're interested.","nextNodeIds":[735020117]},{"nodeId":735020117,"roleType":"TALK_ROLE_NPC","speakerId":4022,"speakerName":"Kamal","textMapHash":2424363282,"text":"But if you ask me, I'd tell you to do something else more productive...","nextNodeIds":[]},{"nodeId":735020106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2571802178,"text":"Do you know who set it up?","nextNodeIds":[735020107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7350201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133302264"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["133302433"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GU