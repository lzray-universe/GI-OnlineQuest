{"mainQuestId":73687,"title":"The Sight of the Divine Emissary","description":"The voting results for Ayaka's outfit will soon be revealed...","titleTextMapHash":1344538527,"descTextMapHash":1957650438,"mainQuestExcel":{"mainQuestId":73687,"titleTextMapHash":1344538527,"title":"The Sight of the Divine Emissary","descTextMapHash":1957650438,"description":"The voting results for Ayaka's outfit will soon be revealed...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5117,"luaPath":"Actor/Quest/WQ73687","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5117,"chapterId":0,"descTextMapHash":1957650438,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73687,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":548386377,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73687","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173687],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1344538527,"type":"WQ","unlockDescTextMapHash":1645472286}},"flow":[{"subQuestId":7368703,"order":1,"stepDescription":"Check out the results of the vote","stepDescTextMapHash":2523495140,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[47302,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7368701BillboardPos"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[47302,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7368701BillboardPos"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7368701,"order":2,"stepDescription":"Check out the results of the vote","stepDescTextMapHash":861084332,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7368701BillboardPos","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7368701],"talks":[{"talkId":7368701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7368701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7368701,"initDialog":736870101,"nextRandomTalks":[],"nextTalks":[],"npcId":[13073,13074],"performCfg":"QuestDialogue/WQ/Pindao_73687/Q7368701","priority":5,"questId":73687,"showRandomTalkCount":0},"dialogs":[{"nodeId":736870101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1734514730,"text":"Whoa, there's already a crowd gathering in front of the Bulletin Board. Let Paimon see! Coming through!","nextNodeIds":[736870102]},{"nodeId":736870102,"roleType":"TALK_ROLE_NPC","speakerId":13073,"speakerName":"Yuu","textMapHash":1020081154,"text":"Oh, I didn't expect the votes to differ by that much. I thought for sure that Masako would win, given that Warrior's Spirit is a competition unique to Inazuma!","nextNodeIds":[736870103]},{"nodeId":736870103,"roleType":"TALK_ROLE_NPC","speakerId":13074,"speakerName":"Tetsuya","textMapHash":27684482,"text":"Just as I predicted. After all, \"The Case Files of Miss Orith\" is a recent bestseller. Not only is the story interesting, but the book's illustrations of Fontaine outfits are also really unique.","nextNodeIds":[736870104]},{"nodeId":736870104,"roleType":"TALK_ROLE_NPC","speakerId":13074,"speakerName":"Tetsuya","textMapHash":2265062378,"text":"Besides, don't you think that Miss Orith's character is a good fit for Miss Kamisato?","nextNodeIds":[736870105]},{"nodeId":736870105,"roleType":"TALK_ROLE_NPC","speakerId":13073,"speakerName":"Yuu","textMapHash":3645273346,"text":"Well... Miss Orith is fiercely competitive, but loves to play pranks on others, which is nearly the complete opposite of Miss Kamisato. However, it'll be interesting to see Miss Kamisato in a Fontaine outfit.","nextNodeIds":[736870106]},{"nodeId":736870106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2231335562,"text":"Huh, what're they talking about? Paimon's kinda confused.","nextNodeIds":[736870107]},{"nodeId":736870107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1222049098,"text":"Oh, look! There are some options for the outfits... \"Pretty Please, Kitsune Guuji\"? \"The Case Files of Miss Orith\"?","nextNodeIds":[736870108]},{"nodeId":736870108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2089218250,"text":"Hold on, didn't they say the choices were gonna be between the four seasons of Inazuma? When did they switch to cosplay outfits from light novels?","nextNodeIds":[736870109,736870110]},{"nodeId":736870109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1111953970,"text":"Maybe they had a change in plans?","nextNodeIds":[736870111]},{"nodeId":736870111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1263483698,"text":"Paimon thinks we need to find out what happened. C'mon, let's find Ayaka at the Yashiro Commission!","nextNodeIds":[]},{"nodeId":736870110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3491906042,"text":"Maybe something went wrong with the poll?","nextNodeIds":[736870111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7368701BillboardPos","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7368702,"order":3,"stepDescription":"Go to the Kamisato Estate","stepDescTextMapHash":4195211252,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1013"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7368702,7368703],"talks":[{"talkId":7368702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7368702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7368702,"initDialog":736870201,"nextRandomTalks":[],"nextTalks":[],"npcId":[13082,30139,1013],"performCfg":"QuestDialogue/WQ/Pindao_73687/Q7368702","priority":5,"questId":73687,"showRandomTalkCount":0},"dialogs":[{"nodeId":736870201,"roleType":"TALK_ROLE_NPC","speakerId":13082,"speakerName":"Mizuta","textMapHash":3891697130,"text":"I'm terribly sorry, I was the one who mixed up the two voting boxes! By the time Mr. Onodera came back from his business trip, the results had already been announced...","nextNodeIds":[736870202]},{"nodeId":736870202,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":3198733546,"text":"*sigh* In an effort to keep things confidential, we specifically didn't mark the ballots with the title of the poll. I regret that decision now that everything's gotten mixed up.","nextNodeIds":[736870203]},{"nodeId":736870203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":959809666,"text":"No way... something did go wrong with the outfit voting.","nextNodeIds":[736870204]},{"nodeId":736870204,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":1515632922,"text":"Traveler, Paimon, it seems you've also heard about the results.","nextNodeIds":[736870205]},{"nodeId":736870205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3531746610,"text":"Yeah, and we're not the only ones... It felt like everyone we saw on the way here was talking about it. What are you going to do?","nextNodeIds":[736870206]},{"nodeId":736870206,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":3803644274,"text":"Miss Kamisato, we're the ones responsible for this blunder. I'll go reorganize a vote right now and we'll set things straight.","nextNodeIds":[736870207]},{"nodeId":736870207,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":3611666258,"text":"Please wait, Onodera. There might be yet another solution.","nextNodeIds":[736870208]},{"nodeId":736870208,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":3931622106,"text":"The poll error is something that only the competition organizers are aware of. The public didn't seem to notice anything wrong with the ballots.","nextNodeIds":[736870209]},{"nodeId":736870209,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":2474943666,"text":"Moreover, there were no complaints when people thought that outfits from popular works would make an appearance in the exhibition match. On the contrary, everyone seemed to think it was a special surprise.","nextNodeIds":[736870210]},{"nodeId":736870210,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":3838680882,"text":"Since our goal was to generate interest in the competition, the consequences of this mistake shouldn't be viewed a \"blunder.\"","nextNodeIds":[736870211]},{"nodeId":736870211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1164673298,"text":"Wait, Ayaka, so do you mean that—","nextNodeIds":[736870212]},{"nodeId":736870212,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":2965022722,"text":"Yes, I think we should just make the best of this mistake. In the final exhibition match, I'll simply wear whichever outfit accumulated the most votes.","nextNodeIds":[736870213]},{"nodeId":736870213,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":973513042,"text":"Yes, but... that will make things difficult for you, Miss Kamisato. Unlike outfits tailored for martial arts, the outfits from the novels aren't designed for combat.","nextNodeIds":[736870214]},{"nodeId":736870214,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":2729993434,"text":"It won't be a problem. The Fontaine-style dress from the novel shouldn't be too heavy, so it won't affect my abilities.","nextNodeIds":[736870215]},{"nodeId":736870215,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":2465761770,"text":"I'll try to get used to it, even if it's quite different than something I'm accustomed to wearing.","nextNodeIds":[736870216]},{"nodeId":736870216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2533266370,"text":"Wow, Ayaka is speaking calmly, but Paimon can still feel her courage!","nextNodeIds":[736870217]},{"nodeId":736870217,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":972266770,"text":"Alright, I understand. In that case, we'll proceed with Miss Kamisato's proposal.","nextNodeIds":[736870218]},{"nodeId":736870218,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":2777546578,"text":"The outfit we prepared for the readers' meet and greet will be tailored and adjusted according to Miss Kamisato's figure. We'll ensure that the outfit is completely ready for the exhibition match!","nextNodeIds":[736870219]},{"nodeId":736870219,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":797537466,"text":"Thank you. It's a lot to handle, but I'm sure you can manage.","nextNodeIds":[736870220]},{"nodeId":736870220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":968360562,"text":"Ayaka, will you really be okay wearing some character's cosplay in the exhibition match? You're not pushing yourself because we're here, are you?","nextNodeIds":[736870221]},{"nodeId":736870221,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":2518766098,"text":"No, please don't worry. I actually feel relaxed and even a little joyful at the moment.","nextNodeIds":[736870222]},{"nodeId":736870222,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":1843768730,"text":"Before, the thought of wearing a fancy dress on the stage of the exhibition match had me worried. I was concerned about whether I would be presentable enough to meet the audience's expectations.","nextNodeIds":[736870223]},{"nodeId":736870223,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":1325322010,"text":"However, if I'm wearing the same clothes as a fictional character, then it shouldn't be too big of an issue. The detective in the novel is known for being mischievous and doing things her own way.","nextNodeIds":[736870224]},{"nodeId":736870224,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":452761546,"text":"Everyone watching the exhibition match will be able to experience something new in a traditional form.","nextNodeIds":[736870225]},{"nodeId":736870225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":67785162,"text":"(So that's what Ayaka was thinking...)","nextNodeIds":[736870226]},{"nodeId":736870226,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":4038276978,"text":"And that's not all... Deep down, I've always been looking forward to the day I could wear something different from what I normally do.","nextNodeIds":[736870227]},{"nodeId":736870227,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":1247659442,"text":"Traveler, not long after we met, I remember you mentioning that Liyue, Mondstadt... and every nation has their own unique fashion.","nextNodeIds":[736870228]},{"nodeId":736870228,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":1960376282,"text":"At that time, I couldn't imagine that one day I would be able to experience all these foreign places. But now, all those wishes that were once impossible don't seem so far out of reach.","nextNodeIds":[736870229]},{"nodeId":736870229,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":45364090,"text":"Besides, my mother was always curious about outfits from other countries when she was alive. This time, I will be able to fulfill my mother's dream.","nextNodeIds":[736870230]},{"nodeId":736870230,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":128310314,"text":"Thinking about it that way, this special outfit can indeed be called a surprise.","nextNodeIds":[736870231]},{"nodeId":736870231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3515876962,"text":"Huh, in that case, this whole accident with the vote turned out to be a good thing, hehe. Well, now that this is all settled, let's get ready to go to the arena.","nextNodeIds":[736870232]},{"nodeId":736870232,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":1286268690,"text":"Yes, I know you will do great, Traveler.","nextNodeIds":[736870233]},{"nodeId":736870233,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":224948738,"text":"Onodera and I will also head to the arena to watch your fight once we've confirmed my outfit's measurements.","nextNodeIds":[]}]},{"talkId":7368703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7368702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"para