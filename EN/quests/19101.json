oop103901SimpleTalk/Q1910101","priority":5,"questId":19101,"showRandomTalkCount":0},"dialogs":[{"nodeId":191010101,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":3992807682,"text":"Mmm... drinks at The Cat's Tail. Not bad... not bad at all...","nextNodeIds":[191010102]},{"nodeId":191010102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2623997098,"text":"The Cat's Tail?","nextNodeIds":[191010103]},{"nodeId":191010103,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":476545122,"text":"Oh hey, it's you, Traveler. ...Huh? Y—You've never heard of The Cat's Tail?","nextNodeIds":[191010104]},{"nodeId":191010104,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":1121650450,"text":"Judging from your expression, seems like you really don't know the place. Boy, have you been missing out...","nextNodeIds":[191010105]},{"nodeId":191010105,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":1941763746,"text":"The Cat's Tail is renowned for its incredible specialty drinks. I'm talking drinks you've definitely never tasted before.","nextNodeIds":[191010106]},{"nodeId":191010106,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":2581272978,"text":"And just as its name suggests, there are loads of cute kitties at The Cat's Tail.","nextNodeIds":[191010107]},{"nodeId":191010107,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":1854483314,"text":"Time simply starts slipping away when you're enjoying a delicious specialty cocktail and surrounded by a bunch of cute kitties...","nextNodeIds":[191010108,191010109]},{"nodeId":191010108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":32825474,"text":"Is The Cat's Tail still open right now?","nextNodeIds":[191010110]},{"nodeId":191010110,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":3879179346,"text":"Uh, but you don't seem of age to drink yet.","nextNodeIds":[191010111]},{"nodeId":191010111,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":113700866,"text":"Well, that shouldn't be a problem, Diona will be there. She's the best bartender in all of Mondstadt!","nextNodeIds":[191010112]},{"nodeId":191010112,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":2218568818,"text":"It should be a piece of cake for her to whip you up a drink with no alcohol in it.","nextNodeIds":[191010113]},{"nodeId":191010113,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":1303543426,"text":"Oh, and not to mention, Diona is also pretty cute... just like a little kitty.","nextNodeIds":[191010114]},{"nodeId":191010114,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":3848669242,"text":"*hic* Oh no... did I say that out loud? Uh, please don't tell her I said that!","nextNodeIds":[191010115]},{"nodeId":191010115,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":4207406266,"text":"Anyway, if you want to check out The Cat's Tail for yourself, the entrance is just around the back.","nextNodeIds":[191010116]},{"nodeId":191010116,"roleType":"TALK_ROLE_NPC","speakerId":146101,"speakerName":"Nimrod","textMapHash":888197962,"text":"I'm gonna... *hic* go over there and sober up a bit, I don't think I can handle a fifth round quite yet... I drank way too much already.","nextNodeIds":[0]},{"nodeId":191010109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4006036418,"text":"I'd like to go check it out...","nextNodeIds":[191010110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1910101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_I