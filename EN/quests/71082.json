aram":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7108202,"initDialog":710820201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20552,20553,1005],"performCfg":"QuestDialogue/WQ/Liyue_71082/Q7108202","priority":5,"questId":71082,"showRandomTalkCount":0},"dialogs":[{"nodeId":710820201,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":1787308050,"text":"You Treasure Hoarder dreg... *pants* If I wasn't so exhausted from lacking any... mushrooms to eat lately...","nextNodeIds":[710820202]},{"nodeId":710820202,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":1481991714,"text":"I would have beaten you black and blue already!","nextNodeIds":[710820203]},{"nodeId":710820203,"roleType":"TALK_ROLE_NPC","speakerId":20552,"speakerName":"Claims to be \"Tang Wuchou\"","textMapHash":615763290,"text":"You old thief! How dare you call my Glaze L... I mean, Qingxin! How dare you call them mushrooms and just... pick and eat them!","nextNodeIds":[710820204]},{"nodeId":710820204,"roleType":"TALK_ROLE_NPC","speakerId":20552,"speakerName":"Claims to be \"Tang Wuchou\"","textMapHash":1849711930,"text":"*cough* By what right do you get to do that?","nextNodeIds":[710820205]},{"nodeId":710820205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1958607106,"text":"Uh, why are you two fighting?","nextNodeIds":[710820206]},{"nodeId":710820206,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":2548287314,"text":"I—I was looking for mushroom-meat! Haha, yes, mushroom-meat! But they wouldn't let me back into the mines, no! So I—I came here looking for some.","nextNodeIds":[710820207]},{"nodeId":710820207,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":4011022090,"text":"And after searching and searching, I finally found that there were mushrooms here! But just as I was reaching for them, this cad attacked me out of nowhere!","nextNodeIds":[710820208]},{"nodeId":710820208,"roleType":"TALK_ROLE_NPC","speakerId":20552,"speakerName":"Claims to be \"Tang Wuchou\"","textMapHash":1179096898,"text":"#Hah! A cad? He's the one who violated our Guhua training grounds! And what's more, these flowers belong to me... and the heroic {NICKNAME}...","nextNodeIds":[710820209]},{"nodeId":710820209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4253838002,"text":"And the heroic Paimon!","nextNodeIds":[710820210]},{"nodeId":710820210,"roleType":"TALK_ROLE_NPC","speakerId":20552,"speakerName":"Claims to be \"Tang Wuchou\"","textMapHash":1680721306,"text":"Yes, and the heroic Paimon! Other than the three of us, none may touch these sacred grounds!","nextNodeIds":[710820211]},{"nodeId":710820211,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":1920107770,"text":"Treasure Hoarder dreg!","nextNodeIds":[710820212]},{"nodeId":710820212,"roleType":"TALK_ROLE_NPC","speakerId":20552,"speakerName":"Claims to be \"Tang Wuchou\"","textMapHash":3457668018,"text":"Scandalous old crook!","nextNodeIds":[710820213]},{"nodeId":710820213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3168972138,"text":"Okay, okay, Uncle He, Tang Wuchou has stopped being a Treasure Hoarder already. Also, the stuff he planted are flowers, not mushrooms.","nextNodeIds":[710820214]},{"nodeId":710820214,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":587013890,"text":"Eh? Is that so?","nextNodeIds":[710820215]},{"nodeId":710820215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1091461154,"text":"C'mon, have a closer look. These are Qingxin for sure!","nextNodeIds":[710820216]},{"nodeId":710820216,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":1531887562,"text":"Ah! Indeed, they are Qingxin! It appears that I'm still a little dizzy...","nextNodeIds":[710820217]},{"nodeId":710820217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":725186450,"text":"And you, Tang Wuchou, are you seriously still dreaming of growing that \"great Glaze Lily garden\" of yours?","nextNodeIds":[710820218]},{"nodeId":710820218,"roleType":"TALK_ROLE_NPC","speakerId":20552,"speakerName":"Claims to be \"Tang Wuchou\"","textMapHash":2252893242,"text":"Well, it would be a most beautiful sight to see, wouldn't you say?","nextNodeIds":[710820219]},{"nodeId":710820219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2883069922,"text":"Whatever the problem is, stop fighting!","nextNodeIds":[710820220]},{"nodeId":710820220,"roleType":"TALK_ROLE_NPC","speakerId":20553,"speakerName":"Uncle He","textMapHash":1230430818,"text":"*sigh* No mushrooms. Goodbye, I go.","nextNodeIds":[710820221]},{"nodeId":710820221,"roleType":"TALK_ROLE_NPC","speakerId":20552,"speakerName":"Claims to be \"Tang Wuchou\"","textMapHash":426174850,"text":"Now that that troublesome old geezer is gone, I can finally look into planting some flowers...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7108202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["71082","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["3","133106616"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE