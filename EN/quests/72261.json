talks":[{"talkId":7226102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7226104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7226102,"initDialog":722610201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005,3160],"performCfg":"QuestDialogue/WQ/Inazuma_72261/Q7226102","priority":5,"questId":72261,"showRandomTalkCount":0},"dialogs":[{"nodeId":722610201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2857475930,"text":"That was a great shot!","nextNodeIds":[722610202]},{"nodeId":722610202,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3271481690,"text":"Mmhaha! Kichiboushi, handsome!","nextNodeIds":[722610203]},{"nodeId":722610203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1158507762,"text":"This kid's got zero humility...","nextNodeIds":[722610204]},{"nodeId":722610204,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3101208906,"text":"Ooh. Paimon, adepti use what magic?","nextNodeIds":[722610205]},{"nodeId":722610205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3303797858,"text":"The adepti are super powerful. For example...","nextNodeIds":[722610206]},{"nodeId":722610206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":946271042,"text":"Let's start with the amber around here.","nextNodeIds":[722610207]},{"nodeId":722610207,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3918562906,"text":"What is amber?","nextNodeIds":[722610208]},{"nodeId":722610208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4095954122,"text":"Oh, Paimon remembers this one. Mountain Shaper has flowers that can create amber to trap bad things that invade his land inside them.","nextNodeIds":[722610209]},{"nodeId":722610209,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2897762138,"text":"Mon-Mon, very powerful. Defends Liyue by trapping bad things.","nextNodeIds":[722610210]},{"nodeId":722610210,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3769191026,"text":"Long ago, the very, very bad Four Oni of Ogata came into the forest and bullied many bake-danuki. Ioroi transformed into an official, gave them bake-danuki food to eat.","nextNodeIds":[722610211]},{"nodeId":722610211,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":353169650,"text":"Later, Ioroi and Otogi King threw them into paper and sealed them.","nextNodeIds":[722610212]},{"nodeId":722610212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":557360418,"text":"Huh, so there's that sort of story too. No wonder Ioroi panicked when he saw that picture of Kichiboushi.","nextNodeIds":[722610213]},{"nodeId":722610213,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3500271834,"text":"Ioroi is not adeptus, not defending Liyue. But Ioroi protects the forest. He protects tanuki.","nextNodeIds":[722610214]},{"nodeId":722610214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":95209226,"text":"Different people have different things they need to defend.","nextNodeIds":[722610215]},{"nodeId":722610215,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2360310450,"text":"Mm?","nextNodeIds":[722610216]},{"nodeId":722610216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1690951114,"text":"You'll figure it out once you're older, Kichiboushi.","nextNodeIds":[722610217]},{"nodeId":722610217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":176822298,"text":"That's why you've gotta train hard and become a super strong bake-danuki!","nextNodeIds":[722610218]},{"nodeId":722610218,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1752661146,"text":"Mm! Of course! The world-famous bake-danuki, Kichiboushi!","nextNodeIds":[722610219]},{"nodeId":722610219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2282585530,"text":"Paimon's really curious to know what Ioroi used to look like before he was sealed. He was probably a ball of fun!","nextNodeIds":[722610220]},{"nodeId":722610220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2843745218,"text":"Huh, Paimon's suddenly reminded of those Treasure Hoarders who were trapped in amber...","nextNodeIds":[722610221]},{"nodeId":722610221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1570567298,"text":"They even took us for adepti messengers...","nextNodeIds":[722610222]},{"nodeId":722610222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":9780866,"text":"That feels like it was so long ago now. But at the same time, it wasn't, right?","nextNodeIds":[722610223]},{"nodeId":722610223,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":543107194,"text":"Mm?","nextNodeIds":[722610224]},{"nodeId":722610224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1359998274,"text":"Ahem. Well, when we came to Liyue...","nextNodeIds":[722610225]},{"nodeId":722610225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3221360514,"text":"#\"The Rite of Descension only happens once a year! Ahaha, I, {NICKNAME}, am gonna have all that delicious food! Come on, Paimon, let's go!\"","nextNodeIds":[722610226]},{"nodeId":722610226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":301901354,"text":"\"And all the offerings, too! Paimon's flying over there right now!\"","nextNodeIds":[722610227]},{"nodeId":722610227,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2001276762,"text":"??","nextNodeIds":[722610228]},{"nodeId":722610228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4268322050,"text":"Best we stop misrepresenting events...","nextNodeIds":[722610229]},{"nodeId":722610229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1425116490,"text":"Okay, okay...","nextNodeIds":[722610230]},{"nodeId":722610230,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3294076378,"text":"You explain what happened in Liyue in simpler terms.\\nYou stop at the point where you went to seek the adepti out in Minlin.","nextNodeIds":[722610231]},{"nodeId":722610231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3719706162,"text":"#...As for what happened next, {NICKNAME} and Paimon went to that Liuli Pavilion place we were at earlier.","nextNodeIds":[722610232]},{"nodeId":722610232,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3663605242,"text":"Mon-Mon and Clow-Clow, very powerful! They built a moving house!","nextNodeIds":[722610233]},{"nodeId":722610233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3048775378,"text":"Clow-Cl— Cloud Retainer really loves gourmet food as well! We had to make lots of delicious stuff before we could meet with her.","nextNodeIds":[722610234]},{"nodeId":722610234,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3919331434,"text":"Greedy, like Paimon.","nextNodeIds":[722610235,722610236]},{"nodeId":722610235,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2932309826,"text":"Like Paimon indeed.","nextNodeIds":[722610237]},{"nodeId":722610237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1570959778,"text":"Hey!","nextNodeIds":[722610238]},{"nodeId":722610238,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3962383418,"text":"Is Paimon adeptus? Paimon is very powerful.","nextNodeIds":[722610239]},{"nodeId":722610239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3702733330,"text":"Uhh, this is kinda complicated. That was praise, sure, but Paimon doesn't feel so good about it...","nextNodeIds":[722610240]},{"nodeId":722610240,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":266676034,"text":"But either way, Paimon isn't an adeptus!","nextNodeIds":[722610241]},{"nodeId":722610241,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":544521330,"text":"Want to play with adepti!","nextNodeIds":[722610242]},{"nodeId":722610242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1036901986,"text":"The adepti don't generally appear before people. But we can have a look around. It's pretty nice here.","nextNodeIds":[722610243]},{"nodeId":722610243,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":4012400666,"text":"Kichiboushi, go!","nextNodeIds":[]},{"nodeId":722610236,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3958634394,"text":"She can fly, too.","nextNodeIds":[722610237]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7226102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7226105,"order":5,"stepDescription":"Follow Kichiboushi","stepDescTextMapHash":3544700884,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7226105"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QU