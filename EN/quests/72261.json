ide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q3_72261_FindArea","50"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7226107,"order":7,"stepDescription":"Talk to Kichiboushi","stepDescTextMapHash":3579484860,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7226104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7226104],"talks":[{"talkId":7226104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7226107","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7226104,"initDialog":722610401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005,3160],"performCfg":"QuestDialogue/WQ/Inazuma_72261/Q7226104","priority":5,"questId":72261,"showRandomTalkCount":0},"dialogs":[{"nodeId":722610401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4049330618,"text":"Thank goodness we found you! Are you alright, Kichiboushi?","nextNodeIds":[722610402]},{"nodeId":722610402,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":479105170,"text":"*whimpers*","nextNodeIds":[722610403]},{"nodeId":722610403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3964432738,"text":"Don't worry, it's okay. But don't run off by yourself next time, alright?","nextNodeIds":[722610404,722610408,722610410]},{"nodeId":722610404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":777679674,"text":"You're like his big sister, Paimon.","nextNodeIds":[722610405]},{"nodeId":722610405,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1436542050,"text":"Paimon's older than Kichiboushi. Of course Paimon's the big sister!","nextNodeIds":[722610406]},{"nodeId":722610406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3917406338,"text":"Though I could hardly tell...","nextNodeIds":[722610407]},{"nodeId":722610407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1839205434,"text":"Hey!","nextNodeIds":[722610412]},{"nodeId":722610412,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3402577090,"text":"#Mm-mm! Thank you, {NICKNAME}. Thank you, Paimon.","nextNodeIds":[722610413]},{"nodeId":722610413,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2665960858,"text":"Kichiboushi, almost sealed! Very scary. But Paimon calling Kichiboushi, so not so scary.","nextNodeIds":[722610414]},{"nodeId":722610414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3906324602,"text":"Ah, right, Ioroi did say that some smaller tanuki were also sealed...","nextNodeIds":[722610415]},{"nodeId":722610415,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1551936658,"text":"Inside amber, very scary. Dark, cannot see. Cannot talk. Cannot move. Cannot \"kapow\"! Like becoming stone.","nextNodeIds":[722610416]},{"nodeId":722610416,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1934060994,"text":"Ioroi is stone, but still very powerful. Can talk, can see. But cannot move.","nextNodeIds":[722610417,722610420]},{"nodeId":722610417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2351312674,"text":"Would you like to help Ioroi, Kichiboushi?","nextNodeIds":[722610418]},{"nodeId":722610418,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2732622898,"text":"Mm. Then, help other stone tanuki too!","nextNodeIds":[722610419]},{"nodeId":722610419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":377338378,"text":"But we're here with you right now, Kichiboushi. We won't let you be sealed!","nextNodeIds":[722610422]},{"nodeId":722610422,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2605979818,"text":"Yey!","nextNodeIds":[722610423]},{"nodeId":722610423,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1493140986,"text":"But you mustn't be too naughty, either!","nextNodeIds":[722610424]},{"nodeId":722610424,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3135526842,"text":"Mm. Yes.","nextNodeIds":[722610425]},{"nodeId":722610425,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3329766834,"text":"That's a good boy! Shall we stop here for now? You must need some rest too, Kichiboushi.","nextNodeIds":[722610426]},{"nodeId":722610426,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1664363954,"text":"Not tired!","nextNodeIds":[722610427]},{"nodeId":722610427,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3860933610,"text":"Ooh, isn't this a pickle. If Kichiboushi won't be good, then Paimon doesn't know where we should go next...","nextNodeIds":[722610428]},{"nodeId":722610428,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3113282826,"text":"Mm...","nextNodeIds":[722610429]},{"nodeId":722610429,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3196350562,"text":"Kichiboushi begrudgingly admits to being tired...","nextNodeIds":[722610430]},{"nodeId":722610430,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1780283346,"text":"Phew! Kichiboushi really is like a child.","nextNodeIds":[722610431]},{"nodeId":722610431,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":410424650,"text":"And you're getting better at dealing with then, eh, Paimon?","nextNodeIds":[722610432]},{"nodeId":722610432,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1968492850,"text":"Really? Maybe that's because Paimon's been traveling with you for so long! Hehe.","nextNodeIds":[722610433,722610435]},{"nodeId":722610433,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":210127906,"text":"Oh, treating me like a kid now, are we?","nextNodeIds":[722610434]},{"nodeId":722610434,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3157761978,"text":"No, no! Haven't we been accompanying kids a lot? You know, like Dusky Ming and Changchang...","nextNodeIds":[722610437]},{"nodeId":722610437,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2362326914,"text":"Paimon's definitely learned a lot from traveling with you.","nextNodeIds":[722610438]},{"nodeId":722610438,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4237008498,"text":"And this time, the lesson is... Bake-danuki and adepti might not get along.","nextNodeIds":[722610439]},{"nodeId":722610439,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1971094490,"text":"We've got to give our next destination some thought...","nextNodeIds":[]},{"nodeId":722610435,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":425681266,"text":"Hmm, come to think of it, we have had to take care of many children...","nextNodeIds":[722610436]},{"nodeId":722610436,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":188967650,"text":"Exactly! Like Dusky Ming and Changchang...","nextNodeIds":[722610437]},{"nodeId":722610420,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3925779930,"text":"Aye, we'll protect you.","nextNodeIds":[722610421]},{"nodeId":722610421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":120063242,"text":"That's right! With us around, there's no way you'll be sealed, Kichiboushi!","nextNodeIds":[722610422]},{"nodeId":722610408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4015197042,"text":"You're like his mom, Paimon.","nextNodeIds":[722610409]},{"nodeId":722610409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":314379634,"text":"What!?","nextNodeIds":[722610412]},{"nodeId":722610410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3527996266,"text":"Paimon's like his granny.","nextNodeIds":[722610411]},{"nodeId":722610411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1148269458,"text":"#\"Ooh, {NICKNAME}, you've got to eat more. You're still growing! How will you grow unless you eat more?\"","nextNodeIds":[722610412]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7226104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7226101,7226102,7226104,7226105],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":47},{"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","count":33},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":19},{"roleType":"TALK_ROLE_BLACK_SCREEN","sp