"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351201,"initDialog":735120101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342,30343],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351201","priority":5,"questId":73512,"showRandomTalkCount":0},"dialogs":[{"nodeId":735120101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":405861882,"text":"Oh... thank you, brave Traveler!","nextNodeIds":[735120102]},{"nodeId":735120102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":790633026,"text":"Oh, phew! It hasn't been too long and the parts are still in good condition... Just a few more adjustments...","nextNodeIds":[735120103]},{"nodeId":735120103,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":793770,"text":"Vinayak starts tinkering with the machinery...","nextNodeIds":[735120104]},{"nodeId":735120104,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":450743322,"text":"...Vinayak?","nextNodeIds":[735120105]},{"nodeId":735120105,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":823908290,"text":"Almost done... I'm almost done!","nextNodeIds":[735120106]},{"nodeId":735120106,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3823300522,"text":"Vi-na-yak!","nextNodeIds":[735120107]},{"nodeId":735120107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1476075410,"text":"Whoa! Shriya? When did you get here?","nextNodeIds":[735120108]},{"nodeId":735120108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2399252218,"text":"When you were fiddling with the components...","nextNodeIds":[735120109]},{"nodeId":735120109,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3495412642,"text":"Didn't you say that this place was dangerous and full of monsters? Why are you even here?","nextNodeIds":[735120110]},{"nodeId":735120110,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2116802722,"text":"...I'm just worried about our components. If we can't finish this assignment, even I can't return to the Akademiya!","nextNodeIds":[735120111]},{"nodeId":735120111,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2895224418,"text":"Ha, I knew it. Look, I have everything here. Once we go back and make some more adjustments, we can finally start assembling.","nextNodeIds":[735120112]},{"nodeId":735120112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1187309522,"text":"So, what are all these components for?","nextNodeIds":[735120113]},{"nodeId":735120113,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3133278650,"text":"Ah, I forgot to tell you. They're for the Wenutslayer Cannon, our graduation project.","nextNodeIds":[735120114]},{"nodeId":735120114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1639739226,"text":"Why such an obscure topic?","nextNodeIds":[735120115]},{"nodeId":735120115,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3423501002,"text":"If you'd applied for graduation, you'd understand why... Well, not that any of this matters now.","nextNodeIds":[735120116]},{"nodeId":735120116,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1751090450,"text":"Allow me to formally introduce myself. I am Shriya, an Amurta graduate with a specialization in desert biology and ecology.","nextNodeIds":[735120117]},{"nodeId":735120117,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2092375018,"text":"This machine-obsessed doofus over here is a Kshahrewar researcher with a specialization in applied mechanics.","nextNodeIds":[735120118]},{"nodeId":735120118,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2534405402,"text":"...I'm Vinayak. Thanks a lot for earlier.","nextNodeIds":[735120119]},{"nodeId":735120119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3871760082,"text":"Can people with completely different fields of study... work together?","nextNodeIds":[735120120]},{"nodeId":735120120,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3042753586,"text":"Don't get me started... Working with him on our graduation proposal was definitely the biggest mistake I've ever made as a student...","nextNodeIds":[735120121]},{"nodeId":735120121,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3101547578,"text":"You can't really say that. We both managed to graduate in the end anyway.","nextNodeIds":[735120122]},{"nodeId":735120122,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1902824146,"text":"We did, yes, but did you forget how many extra years it took?","nextNodeIds":[735120123]},{"nodeId":735120123,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1123465434,"text":"Whatever the case, we graduated, right? I heard some of our classmates just completed their thesis proposal last year.","nextNodeIds":[735120124]},{"nodeId":735120124,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":4031506578,"text":"Ugh... enough! We're not students anymore, so can we just move on from these pointless discussions?","nextNodeIds":[735120125]},{"nodeId":735120125,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":4132167650,"text":"You're the one who always starts it...","nextNodeIds":[735120126]},{"nodeId":735120126,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":527638266,"text":"Nonsense! When we were building the first prototype...","nextNodeIds":[735120127,735120128]},{"nodeId":735120127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2074963826,"text":"Hey, hey!","nextNodeIds":[735120129]},{"nodeId":735120129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":320315194,"text":"Wow... you guys have it out for each other. How could the Akademiya even think of sending you two together to handle this...","nextNodeIds":[735120130]},{"nodeId":735120130,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3065049954,"text":"*sigh* Actually, the Akademiya didn't send us... A person named Kunar was supposed to take care of this matter.","nextNodeIds":[735120160]},{"nodeId":735120160,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3094283362,"text":"You could call him my mentor's mentor... He was there during our thesis defense.","nextNodeIds":[735120161]},{"nodeId":735120161,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":755740914,"text":"I guess that was how he got the impression that \"some young students in the Akademiya had designed a Wenutslayer Cannon,\" or something like that.","nextNodeIds":[735120162]},{"nodeId":735120162,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1764982978,"text":"So this time, he simply kicked the two of us back here to deal with the problem, saying that \"the Akademiya needs to give youngsters more opportunities to shine!\"","nextNodeIds":[735120163]},{"nodeId":735120163,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3544108106,"text":"But he obviously didn't consider the fact that the two of us have barely talked to each other since graduation...","nextNodeIds":[735120131]},{"nodeId":735120131,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1310520706,"text":"He even convinced my mentor... Ahem, anyway, this is an opportunity for me to get the Wenutslayer Cannon back out in the open!","nextNodeIds":[735120132]},{"nodeId":735120132,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3742966522,"text":"Once it's assembled, we'll show those vermin what it can do!","nextNodeIds":[735120133]},{"nodeId":735120133,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":880784618,"text":"There that mechanical idiot goes again... From my point of view, I also want to investigate the cause of the Wenut rampage to maintain the ecological balance of the desert.","nextNodeIds":[735120134]},{"nodeId":735120134,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3252475666,"text":"#{M#Mr.}{F#Ms.} Adventurer, you look like someone of impressive skill. May I ask you to keep us safe while we're in the desert?","nextNodeIds":[735120135,735120136]},{"nodeId":735120135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1531039826,"text":"I'll do it for the right price.","nextNodeIds":[735120137]},{"nodeId":735120137,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":148965138,"text":"Rest assured. There isn't a lot of support from the Akademiya, but at least we're well-funded. ...Although someone here has spent most of it on upgrading the machinery.","nextNodeIds":[735120138]},{"nodeId":735120138,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3091404858,"text":"Th—The improvements were necessary! ...And since you're capable of speaking politely, can't you be a little nicer to me?","nextNodeIds":[735120139]},{"nodeId":735120139,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1398669738,"text":"That depends on whether the person I'm talking to is worthy of my patience!","nextNodeIds":[735120140]},{"nodeId":735120140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2521601714,"text":"Oh no... here they go again...","nextNodeIds":[735120141,735120142]},{"nodeId":735120141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4239121258,"text":"Maybe leave the arguing for later?","nextNodeIds":[735120143]},{"nodeId":735120143,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1654185402,"text":"*sigh* Sorry... It's an old habit from my Akademiya days...","nextNodeIds":[735120144]},{"nodeId":735120144,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3982325410,"text":"This batch of components has to be brought back to Aaru Village for further adjustment. By all accounts, we can't start assembling until tomorrow.","nextNodeIds":[735120145]},{"nodeId":735120145,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":417934314,"text":"We had previously planned to install the Wenutslayer Cannon in nearby areas where Wenut have been spotted.","nextNodeIds":[735120146]},{"nodeId":735120146,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":4036453154,"text":"When the time comes, there may be other creatures attracted by the noise we make. We'll be counting on you.","nextNodeIds":[735120147,735120148]},{"nodeId":735120147,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1727504794,"text":"No problem.","nextNodeIds":[735120149]},{"nodeId":735120149,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2299061010,"text":"We can continue our debate now, right? I'm telling you, all my expenses are justified.","nextNodeIds":[735120150]},{"nodeId":735120150,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1404099922,"text":"You...! Fine, you asked for it. Let's go over the details and see where all that Mora went!","nextNodeIds":[]},{"nodeId":735120148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3334094602,"text":"See you tomorrow.","nextNodeIds":[735120149]},{"nodeId":735120142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":471150994,"text":"Can we start with the actual work?","nextNodeIds":[735120143]},{"nodeId":735120136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3127676834,"text":"It'll be a walk in a park for me.","nextNodeIds":[735120137]},{"nodeId":735120128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2214799546,"text":"Arguing isn't gonna get you anywhere.","nextNodeIds":[735120129]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133309822","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","count":23},{"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173512],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3753878366,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/V3.6SandSworm/Q7351201","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":735120101,"ILHDCGDKKKA":"TALK_HERO_MAIN"