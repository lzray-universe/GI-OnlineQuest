,"","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7416505","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["402501","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7416502,"initDialog":741650201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21263,20995],"performCfg":"QuestDialogue/WQ/Fontaine_74165/Q7416502","priority":10,"questId":74165,"showRandomTalkCount":0},"dialogs":[{"nodeId":741650201,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1467463186,"text":"Impossible... I had already reached the stage of \"no return.\" How have I fallen to this point?","nextNodeIds":[741650202]},{"nodeId":741650202,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":263857218,"text":"And I have lost all control of the Primordial Sea.","nextNodeIds":[741650203]},{"nodeId":741650203,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2235717538,"text":"Why, why has this happened? Why, why did you do this?","nextNodeIds":[741650204]},{"nodeId":741650204,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3875540298,"text":"The new world cannot be born. All will die in a shell, a husk of a dream!","nextNodeIds":[741650205]},{"nodeId":741650205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":33753058,"text":"Paimon reckons you're the one who should try waking up from your dream.","nextNodeIds":[741650206]},{"nodeId":741650206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2686726338,"text":"The end of the world is the kind of thing that everyone should work together to stop.","nextNodeIds":[741650207]},{"nodeId":741650207,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3924664930,"text":"I see. The Holy Blade is not on my side. With each swing, it cuts through the universal will that surrounds me.","nextNodeIds":[741650208]},{"nodeId":741650208,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1344985938,"text":"Until, at last, my weak, ordinary self has returned to its physical body.","nextNodeIds":[741650209,741650215]},{"nodeId":741650209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3600341362,"text":"The Primordial Sea won't overflow its banks so soon.","nextNodeIds":[741650210]},{"nodeId":741650210,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":875952194,"text":"Indeed, I can sense changes in the values originally entered into the world-formula.","nextNodeIds":[741650211]},{"nodeId":741650211,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":4294436170,"text":"Someone has seized control of the life-force, and someone has opened the beast-realm.","nextNodeIds":[741650212]},{"nodeId":741650212,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3061651042,"text":"And then, there is one more variable. That is you.","nextNodeIds":[741650213]},{"nodeId":741650213,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":4107528090,"text":"The person fated to see the all-consuming whale put to flight. The one who shall witness all.","nextNodeIds":[741650214]},{"nodeId":741650214,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":764289762,"text":"I see, I see.","nextNodeIds":[741650221]},{"nodeId":741650221,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":434489162,"text":"I once dreamed of becoming one just like you. But that dream is now shattered.","nextNodeIds":[741650222]},{"nodeId":741650222,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2890679042,"text":"All I have done is meaningless. An empty dream.","nextNodeIds":[741650223]},{"nodeId":741650223,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2592661970,"text":"No, less than a dream, even. A dream is at least harmless. But I... No, you, and they... have paid so much for all I have done.","nextNodeIds":[741650224]},{"nodeId":741650224,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1433227498,"text":"Narzissenkreuz.","nextNodeIds":[741650225]},{"nodeId":741650225,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2842551514,"text":"Oh, it's you. I didn't see you there.","nextNodeIds":[741650226]},{"nodeId":741650226,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":3791274338,"text":"Do you know who I actually am?","nextNodeIds":[741650227]},{"nodeId":741650227,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":547969802,"text":"Names are just labels. But yes, I am most familiar with the two colors that mix in your soul.","nextNodeIds":[741650228]},{"nodeId":741650228,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1671240618,"text":"Director Lyris does not know what has happened. She just holds onto Mary-Ann, who herself still clings to life.","nextNodeIds":[741650229]},{"nodeId":741650229,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2627975130,"text":"She cannot understand such a complex present and future, and hopes just to retain the past. And so, she does the only thing she can.","nextNodeIds":[741650230]},{"nodeId":741650230,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":79874258,"text":"My name is Ann.","nextNodeIds":[741650231]},{"nodeId":741650231,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":162092442,"text":"In that case, hello, Ann.","nextNodeIds":[741650232]},{"nodeId":741650232,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1011605890,"text":"I am willing to forgive you.","nextNodeIds":[741650233]},{"nodeId":741650233,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":522194042,"text":"What an odd thing to say. From the very start, my plans have had lofty and sacred aims. Selfishness has never come into it.","nextNodeIds":[741650234]},{"nodeId":741650234,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2690960106,"text":"None may judge or criticize me, nor do I need forgiveness.","nextNodeIds":[741650235]},{"nodeId":741650235,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":960606722,"text":"Your aims may have been lofty, but your insanity has harmed many.","nextNodeIds":[741650236]},{"nodeId":741650236,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1187670242,"text":"You did not even enter the formula correctly... and what's wrong with being forgiven for a mistake?","nextNodeIds":[741650237]},{"nodeId":741650237,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3130155402,"text":"...You are right. I apologize.","nextNodeIds":[741650238]},{"nodeId":741650238,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1332311146,"text":"So please, Narzissenkreuz, come back with us. There are other people you need to see.","nextNodeIds":[741650239]},{"nodeId":741650239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":492751922,"text":"This guy seems to have become much more cooperative. But a request like that...","nextNodeIds":[741650240]},{"nodeId":741650240,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":826195602,"text":"Of course.","nextNodeIds":[741650241]},{"nodeId":741650241,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3141974314,"text":"Huh? Doesn't this sorta thing usually require some inner struggle and hours of persuasion?","nextNodeIds":[741650242]},{"nodeId":741650242,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3934306770,"text":"As I have said before, I do not feel that I have done anything wrong. My mission has failed, but the world has been saved nonetheless.","nextNodeIds":[741650243]},{"nodeId":741650243,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3857629530,"text":"Let others mock and curse me. I am empty within now. Only one desire remains.","nextNodeIds":[741650244]},{"nodeId":741650244,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4002566882,"text":"What is it?","nextNodeIds":[741650245]},{"nodeId":741650245,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":11479418,"text":"I, too, wish to return to the very beginning — to the time before the Narzissenkreuz heroes set off on their journey.","nextNodeIds":[741650246]},{"nodeId":741650246,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":685821522,"text":"But that's impossible. We are not masters of our own fate. I no longer even have the power to determine my own dreams.","nextNodeIds":[741650247]},{"nodeId":741650247,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":3816717794,"text":"#Well, Knight {NICKNAME}, when you're ready, we'll proceed to reseal the primordial waters, and then we'll leave this place.","nextNodeIds":[]},{"nodeId":741650215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3844267730,"text":"That creature has already been defeated.","nextNodeIds":[741650216]},{"nodeId":741650216,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3250328714,"text":"I should have sensed the changes in the values originally entered into the world-formula. A \"variable\" has descended upon this world.","nextNodeIds":[741650217]},{"nodeId":741650217,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3002264010,"text":"Not everything from outside the universe can be called a \"presence\" or \"variable.\"","nextNodeIds":[741650218]},{"nodeId":741650218,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1266380730,"text":"But it seems I overlooked one nonetheless. You.","nextNodeIds":[741650219]},{"nodeId":741650219,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3385569210,"text":"The witness of all, the recorder of all, the designer of all.","nextNodeIds":[741650220]},{"nodeId":741650220,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1291854410,"text":"Only one who is worth a world can bear that title.","nextNodeIds":[741650221]}]},{"talkId":7416503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7416505","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7416503,"initDialog":741650301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21263,20995],"performCfg":"QuestDialogue/WQ/Fontaine_74165/Q7416503","priority":5,"questId":74165,"showRandomTalkCount":0},"dialogs":[{"nodeId":741650301,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2247999074,"text":"Impossible... I had already reached the stage of \"no return.\" How have I fallen to this point?","nextNodeIds":[741650302]},{"nodeId":741650302,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":157808490,"text":"And I have lost all control of the Primordial Sea.","nextNodeIds":[741650303]},{"nodeId":741650303,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":4040705522,"text":"Why, why has this happened? Why, why did you do this?","nextNodeIds":[741650304]},{"nodeId":741650304,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2657899122,"text":"The new world cannot be born. All will die in a shell, a husk of a dream!","nextNodeIds":[741650305]},{"nodeId":741650305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1686159602,"text":"Paimon reckons you're the one who should try waking up from your dream.","nextNodeIds":[741650306]},{"nodeId":741650306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":161508306,"text":"The end of the world is the kind of thing that everyone should work together to stop.","nextNodeIds":[741650307]},{"nodeId":741650307,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1831603290,"text":"I see. The Holy Blade is not on my side. With each swing, it cuts through the universal will that surrounds me.","nextNodeIds":[741650308]},{"nodeId":741650308,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1620998802,"text":"Until, at last, my weak, ordinary self has returned to its physical body.","nextNodeIds":[741650309]},{"nodeId":741650309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3125602018,"text":"The Primordial Sea won't overflow its banks so soon.","nextNodeIds":[741650310]},{"nodeId":741650310,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":540176202,"text":"Indeed, I can sense changes in the values originally entered into the world-formula.","nextNodeIds":[741650311]},{"nodeId":741650311,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":686341890,"text":"Someone has seized control of the life-force, and someone has opened the beast-realm.","nextNodeIds":[741650312]},{"nodeId":741650312,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1688639930,"text":"And then, there is one more variable. That is you.","nextNodeIds":[741650313]},{"nodeId":741650313,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3919479282,"text":"The person fated to see the all-consuming whale put to flight. The one who shall witness all.","nextNodeIds":[741650314]},{"nodeId":741650314,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":472403250,"text":"I see, I see.","nextNodeIds":[741650315]},{"nodeId":741650315,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":232559074,"text":"I once dreamed of becoming one just like you. But that dream is now shattered.","nextNodeIds":[741650316]},{"nodeId":741650316,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3802716210,"text":"All I have done is meaningless. An empty dream.","nextNodeIds":[741650317]},{"nodeId":741650317,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2314510650,"text":"No, less than a dream, even. A dream is at least harmless. But I... No, you, and they... have paid so much for all I have done.","nextNodeIds":[741650318]},{"nodeId":741650318,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":821698610,"text":"Narzissenkreuz.","nextNodeIds":[741650319]},{"nodeId":741650319,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":208164978,"text":"Oh, it's you. I didn't see you there.","nextNodeIds":[741650320]},{"nodeId":741650320,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":4249225586,"text":"Do you know who I actually am?","nextNodeIds":[741650321]},{"nodeId":741650321,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2633823074,"text":"Names are just labels. But yes, I am most familiar with the two colors that mix in your soul.","nextNodeIds":[741650322]},{"nodeId":741650322,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3376436386,"text":"Director Lyris does not know what has happened. She just holds onto Mary-Ann, who herself still clings to life.","nextNodeIds":[741650323]},{"nodeId":741650323,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":262517690,"text":"She cannot understand such a complex present and future, and hopes just to retain the past. And so, she does the only thing she can.","nextNodeIds":[741650324]},{"nodeId":741650324,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":124425298,"text":"My name is Ann.","nextNodeIds":[741650325]},{"nodeId":741650325,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":983614058,"text":"In that case, hello, Ann.","nextNodeIds":[741650326]},{"nodeId":741650326,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":3619725114,"text":"I am willing to forgive you.","nextNodeIds":[741650327]},{"nodeId":741650327,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2418288066,"text":"What an odd thing to say. From the very start, my plans have had lofty and sacred aims. Selfishness has never come into it.","nextNodeIds":[741650328]},{"nodeId":741650328,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":493282730,"text":"None may judge or criticize me, nor do I need forgiveness.","nextNodeIds":[741650329]},{"nodeId":741650329,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":2168396826,"text":"Your aims may have been lofty, but your insanity has harmed many.","nextNodeIds":[741650330]},{"nodeId":741650330,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":218875698,"text":"You did not even enter the formula correctly... and what's wrong with being forgiven for a mistake?","nextNodeIds":[741650331]},{"nodeId":741650331,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":1303796354,"text":"...You are right. I apologize.","nextNodeIds":[741650332]},{"nodeId":741650332,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":307467290,"text":"So please, Narzissenkreuz, come back with us. There are other people you need to see.","nextNodeIds":[741650333]},{"nodeId":741650333,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":262264642,"text":"This guy seems to have become much more cooperative. But a request like that...","nextNodeIds":[741650334]},{"nodeId":741650334,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3868023314,"text":"Of course.","nextNodeIds":[741650335]},{"nodeId":741650335,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1864104146,"text":"Huh? Doesn't this sorta thing usually require some inner struggle and hours of persuasion?","nextNodeIds":[741650336]},{"nodeId":741650336,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3982780090,"text":"As I have said before, I do not feel that I have done anything wrong. My mission has failed, but the world is still fated to be saved.","nextNodeIds":[741650337]},{"nodeId":741650337,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":3723528882,"text":"Let others mock and curse me. I am empty within now. Only one desire remains.","nextNodeIds":[741650338]},{"nodeId":741650338,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1961849290,"text":"What is it?","nextNodeIds":[741650339]},{"nodeId":741650339,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":2310413962,"text":"I, too, wish to return to the very beginning — to the time before the Narzissenkreuz heroes set off on their journey.","nextNodeIds":[741650340]},{"nodeId":741650340,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"Narzissenkreuz","textMapHash":252695962,"text":"But that's impossible. We are not masters of our own fate. I no longer even have the power to determine my own dreams.","nextNodeIds":[741650341]},{"nodeId":741650341,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"Ann","textMapHash":1927934394,"text":"#Well, Knight {NICKNAME}, when you're ready, we'll proceed to reseal the primordial waters, and then we'll leave this place.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7416502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7416503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","1103"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"},{"LNHLPKELCAL":["3","1137"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_7252:2560.706,-76.100,3379.072]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"