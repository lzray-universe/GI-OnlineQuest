{"mainQuestId":71514,"title":"Radiant Sparks","description":"During Lantern Rite, Tiantian, a recruiter for the Adventurers' Guild, is eagerly rubbing her hands together in anticipation of an interesting event...","titleTextMapHash":543847647,"descTextMapHash":356937630,"mainQuestExcel":{"mainQuestId":71514,"titleTextMapHash":543847647,"title":"Radiant Sparks","descTextMapHash":356937630,"description":"During Lantern Rite, Tiantian, a recruiter for the Adventurers' Guild, is eagerly rubbing her hands together in anticipation of an interesting event...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2019,"luaPath":"Actor/Quest/WQ71514","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2019,"chapterId":0,"descTextMapHash":356937630,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71514,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":142812761,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71514","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171514],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":543847647,"type":"WQ","unlockDescTextMapHash":1705667302}},"flow":[{"subQuestId":7151401,"order":1,"stepDescription":"Talk to Tiantian","stepDescTextMapHash":3211100668,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2096"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7151401],"talks":[{"talkId":7151401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7151401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7151401,"initDialog":715140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2096],"performCfg":"","priority":5,"questId":71514,"showRandomTalkCount":0},"dialogs":[{"nodeId":715140101,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":4115232850,"text":"Hey! Happy Lantern Rite, esteemed ones!","nextNodeIds":[715140102]},{"nodeId":715140102,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2975874466,"text":"You guys have been having fun? How about going on a special adventure with me?","nextNodeIds":[715140103]},{"nodeId":715140103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1738028042,"text":"Wow, you called us \"esteemed ones\"! Such a great attitude!","nextNodeIds":[715140104]},{"nodeId":715140104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3171272186,"text":"Recently, we've been having a lot of fun! But... why is Paimon getting a strange feeling that we've met before?","nextNodeIds":[715140105]},{"nodeId":715140105,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":951163714,"text":"You guys are extremely diligent adventurers, so I'm sure we've bumped into each other at some point!","nextNodeIds":[715140106]},{"nodeId":715140106,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":908907634,"text":"I'm Tiantian. I usually hang out around the Feiyun Slope, looking to recruit new people into the Adventurers' Guild.","nextNodeIds":[715140107]},{"nodeId":715140107,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":88829834,"text":"Everyone and their cats and dogs passing by have probably heard my voice!","nextNodeIds":[715140108,715140110]},{"nodeId":715140108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2434370842,"text":"You do look a bit familiar...","nextNodeIds":[715140109]},{"nodeId":715140109,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2757624418,"text":"Yes! It means my efforts were noticed by you guys! All the more reason for you to experience my masterpiece!","nextNodeIds":[715140112]},{"nodeId":715140112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4048344338,"text":"At this point, of course we'll lend you a hand!","nextNodeIds":[715140113]},{"nodeId":715140113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3232026546,"text":"Can you tell us a little bit about your particular adventure?","nextNodeIds":[715140114]},{"nodeId":715140114,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":438833978,"text":"Sure, then I'll cut to the chase!","nextNodeIds":[715140115]},{"nodeId":715140115,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2143450466,"text":"Recently I came across a new novel at the Wanwen Bookhouse... no, that's not it. Rather, I gathered some new information!","nextNodeIds":[715140116]},{"nodeId":715140116,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":337330522,"text":"I've noticed that people's expectations for adventure are rising and activities such as climbing and wind gliding are not as exciting as they used to be.","nextNodeIds":[715140117]},{"nodeId":715140117,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":3748470282,"text":"In order to get more people to join the Adventurers' Guild, we need to come up with more novel and exciting approaches.","nextNodeIds":[715140118]},{"nodeId":715140118,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":597030898,"text":"So, I teamed up with a couple of other recruiters, pooled together our resources, consulted a few expert mountain climbers and fireworks craftsmen, and designed a new racing challenge!","nextNodeIds":[715140119]},{"nodeId":715140119,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2973571810,"text":"There are many mechanisms laid out in the challenge. Just step on them and use the momentum from the fireworks and gunpowder blasts to accelerate into the sky!","nextNodeIds":[715140120]},{"nodeId":715140120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1292696770,"text":"Fireworks? Gunpowder!? So for the challenge, you want to... blast people into the sky!?!?","nextNodeIds":[715140121,715140122]},{"nodeId":715140121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2405852834,"text":"Firework-flying Paimon!","nextNodeIds":[715140123]},{"nodeId":715140123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":233367282,"text":"Why are you so excited? You're also going up!","nextNodeIds":[715140124]},{"nodeId":715140124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2736169834,"text":"Although with your strength, an explosive barrel bursting in front of you wouldn't faze you... but who knows? It just might blow you away!","nextNodeIds":[715140125]},{"nodeId":715140125,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2686479138,"text":"Not to worry. The explosion is contained inside a tough device. I've taken the necessary precautions to make sure it's safe and injury-free!","nextNodeIds":[715140126]},{"nodeId":715140126,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2419942498,"text":"I've also filed a patent with the Ministry of Civil Affairs and have publicized this event many times. Please do not steal my idea!","nextNodeIds":[715140127]},{"nodeId":715140127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4190056442,"text":"There are so many hurdles! You've really put a lot of thought into this!","nextNodeIds":[715140128]},{"nodeId":715140128,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":3925415130,"text":"As far as I can tell, just doing this racing challenge will stir the spirit of adventure even in an average passerby!","nextNodeIds":[715140129]},{"nodeId":715140129,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":545526762,"text":"Esteemed ones, your reputation precedes you. If you guys take point on this racing challenge, you'll be sure to attract a lot of people.","nextNodeIds":[715140130]},{"nodeId":715140130,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":1378479002,"text":"I have also prepared great rewards for the challenge. They'll be sure to encourage more people to join the Adventurers' Guild!","nextNodeIds":[715140131,715140133]},{"nodeId":715140131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3448997290,"text":"Okay, firework and gunpowder race, let's go!","nextNodeIds":[715140132]},{"nodeId":715140132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1834826266,"text":"Yep! There's no reason we shouldn't do this if there are rewards to obtain!","nextNodeIds":[715140135]},{"nodeId":715140135,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2659271426,"text":"Then it's a deal! Without further ado, please give it a whirl!","nextNodeIds":[715140136]},{"nodeId":715140136,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2205749866,"text":"Hehe, there are a lot of tracks for you to try. I'm sure you'll have a good time with them, and I'll get a couple months' worth of results. It's a win-win!","nextNodeIds":[]},{"nodeId":715140133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3279296634,"text":"Oh boy, time for Paimon and me to get blown sky high!","nextNodeIds":[715140134]},{"nodeId":715140134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1338692522,"text":"Hey, Paimon sees you laughing! As Tiantian said, it's perfectly safe. Don't you want to give it a try?","nextNodeIds":[715140135]},{"nodeId":715140122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3824487322,"text":"Rocket-propelled Paimon!","nextNodeIds":[715140123]},{"nodeId":715140110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1495586306,"text":"I'm drawing a blank...","nextNodeIds":[715140111]},{"nodeId":715140111,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":1871722146,"text":"Doesn't ring a bell? Then I shall make a bigger impression with this masterpiece... No, I shall do it to recruit more people into the Adventurers' Guild.","nextNodeIds":[715140112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2096"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7151401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","count":20},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171514],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":356937630,"CHECNJEMEFE":{"2096"