{"mainQuestId":40086,"title":"Farewell, My Shroom Buddies","description":"It's about time to say goodbye to your shroom buddies...","titleTextMapHash":469178175,"descTextMapHash":3054161406,"mainQuestExcel":{"mainQuestId":40086,"titleTextMapHash":469178175,"title":"Farewell, My Shroom Buddies","descTextMapHash":3054161406,"description":"It's about time to say goodbye to your shroom buddies...","chapterId":10105,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/EQ40086","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":10105,"descTextMapHash":3054161406,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":40086,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1212893505,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/EQ40086","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[140086],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":469178175,"type":"EQ","unlockDescTextMapHash":1156454446}},"flow":[{"subQuestId":4008604,"order":1,"stepDescription":"Wait until two days later","stepDescTextMapHash":3890741828,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDL