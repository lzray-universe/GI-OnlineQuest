ALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4008601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4008601,"initDialog":400860101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1063],"performCfg":"QuestDialogue/EQ/V3.2FungusFighter_40086/Q4008601","priority":5,"questId":40086,"showRandomTalkCount":0},"dialogs":[{"nodeId":400860101,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":2617220066,"text":"#{NICKNAME}, Paimon, Bongo-Head! Over here!","nextNodeIds":[400860102]},{"nodeId":400860102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2767137794,"text":"Hey, Layla! Have you and Twirly-Whirly been having fun these past few days?","nextNodeIds":[400860103]},{"nodeId":400860103,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":4256409954,"text":"Definitely! With Twirly-Whirly helping me carry my luggage, we could go camping really far away, and I got to see the stars from a different perspective. I even managed to make some progress with my paper!","nextNodeIds":[400860104]},{"nodeId":400860104,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":2141968490,"text":"Although... I've tried making almost everything on my food list now. Every time I used flour or something, it got in the air and gave me a coughing fit... But after all that, I still haven't figured out what Twirly-Whirly likes.","nextNodeIds":[400860105]},{"nodeId":400860105,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":3809284586,"text":"It would be great if the improved Wisdom Orb allowed us to communicate directly with the Fungi... Oh! I should mention that in my letter and get someone to ask a senior Amurta scholar!","nextNodeIds":[400860106]},{"nodeId":400860106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1640284394,"text":"Paimon's never seen you in such good spirits, Layla! You spoke a lot more than usual just now, and you're still full of life... You really go the extra mile for your shroom buddies.","nextNodeIds":[400860107]},{"nodeId":400860107,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":1761107866,"text":"Whew, I think I might've overexerted myself though... I'm flagging hard. Let's go see Miss Yae before I crash ...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4008601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4008601_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4008602,"order":3,"stepDescription":"Meet up with Yae Miko","stepDescTextMapHash":2940847316,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4008602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4008602_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[4008602],"talks":[{"talkId":4008602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4008602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4008602,"initDialog":400860201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1034],"performCfg":"QuestDialogue/EQ/V3.2FungusFighter_40086/Q4008602","priority":5,"questId":40086,"showRandomTalkCount":0},"dialogs":[{"nodeId":400860201,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3139552146,"text":"Oh? You're earlier than I expected...","nextNodeIds":[400860202]},{"nodeId":400860202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":704275250,"text":"Miko, you're not leaving, are you? It feels like you never got to properly enjoy your vacation here...","nextNodeIds":[400860203]},{"nodeId":400860203,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":12141570,"text":"Oh, my needs for amusement have been more than met. Thanks to your help, our little inspiration hunt went perfectly. Not only did we gain invaluable experience in the tournament, we also had all the excitement of exposing a criminal conspiracy...","nextNodeIds":[400860204]},{"nodeId":400860204,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3529426634,"text":"Yes, I think I might ask Souka to ditch her original characters and just make you the protagonists in her next novel.","nextNodeIds":[400860205,400860206]},{"nodeId":400860205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1171474466,"text":"You were helping behind the scenes.","nextNodeIds":[400860207]},{"nodeId":400860207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4061184946,"text":"True! It all makes sense now. You dropped so many hints, but it went over Paimon's head at the time!","nextNodeIds":[400860208]},{"nodeId":400860208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":621164834,"text":"Why didn't you expose Elchingen right away, though? Why wait for things to escalate like they did?","nextNodeIds":[400860209]},{"nodeId":400860209,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":879173306,"text":"Going for the big reveal right at the beginning would have been an anti-climax of the most literal kind. I wanted to see how you'd react in a situation like this, and you did not disappoint...","nextNodeIds":[400860210]},{"nodeId":400860210,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2173869770,"text":"I thought that the story between you and the Fungi would follow a master-servant paradigm, but you offered something even better: companionship, based on mutual understanding.","nextNodeIds":[400860211]},{"nodeId":400860211,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3692137266,"text":"From a certain point of view, it seems fitting that Elchingen, the one person who could barely keep the word \"Master\" from his lips, met his downfall at your hand. Of course, considering what he's capable of, I'm sure he'll have his ways of continuing to put up a fight...","nextNodeIds":[400860212]},{"nodeId":400860212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":399172354,"text":"Paimon's getting confused again... In the future, we should take notes when Miko's talking and carefully look over them later...","nextNodeIds":[400860213]},{"nodeId":400860213,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1532280674,"text":"That's enough chatting for now. I'll leave Blitzara in your hands. Remember to take good care of it.","nextNodeIds":[400860214]},{"nodeId":400860214,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":199662722,"text":"I hope you really give this a good shot, you and Haniyyah. The future of this highly entertaining tournament depends on the decisions you make from now on... I'm excited to see what you've got in store for us.","nextNodeIds":[]},{"nodeId":400860206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":20533210,"text":"You knew there was something up with Elchingen.","nextNodeIds":[400860207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4008602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4008602_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4008603,"order":4,"stepDescription":"Meet up with Haniyyah","stepDescTextMapHash":3083073564,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4008603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4008603_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[4008603],"talks":[{"talkId":4008603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4008603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4008603,"initDialog":400860301,"nextRandomTalks":[],"nextTalks":[],"npcId":[12855,1063],"performCfg":"QuestDialogue/EQ/V3.2FungusFighter_40086/Q4008603","priority":5,"questId":40086,"showRandomTalkCount":0},"dialogs":[{"nodeId":400860301,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":3637232050,"text":"Hello, all. Right on time.","nextNodeIds":[400860302]},{"nodeId":400860302,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":1925163162,"text":"I've collected all the other contestants' Wisdom Orbs and found a suitable place for our Fungi friends to live. I'll make absolutely sure the surrounding environment is not affected.","nextNodeIds":[400860303]},{"nodeId":400860303,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":571075418,"text":"Say hello to everyone, Kindlejoy.","nextNodeIds":[400860304]},{"nodeId":400860304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":744379682,"text":"\"Kindlejoy\"?","nextNodeIds":[400860305]},{"nodeId":400860305,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":2647194050,"text":"That's Pyro-1's new name. When I saw how well-behaved it was when we first met, a sense of joy welled up inside me.","nextNodeIds":[400860306]},{"nodeId":400860306,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":146094298,"text":"If I'd just let go of my preconceived notions about Fungi and allowed myself to truly feel that moment... Maybe I could have felt like that all this time.","nextNodeIds":[400860307]},{"nodeId":400860307,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":401449122,"text":"I'm so glad Haniyyah has finally worked things out...","nextNodeIds":[400860308]},{"nodeId":400860308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":167817178,"text":"Yeah! Even though Paimon has gotten used to the name \"Pyro-1\" at this point, the new name holds so much more significance!","nextNodeIds":[400860309,400860310]},{"nodeId":400860309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1209806346,"text":"Congratulations, Haniyyah.","nextNodeIds":[400860311]},{"nodeId":400860311,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":2027975010,"text":"I will commit to giving these gentle creatures the highest standard of care I can provide. Please rest assured that your Fungi friends will be safe with me.","nextNodeIds":[400860312]},{"nodeId":400860312,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":3869788122,"text":"I guess it's... time for us to say goodbye...","nextNodeIds":[400860313]},{"nodeId":400860313,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","textMapHash":1860182570,"text":"Go on, Twirly-Whirly. Be a good Fungus now, and do everything that Haniyyah says...","nextNodeIds":[400860314]},{"nodeId":400860314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1019941570,"text":"Blitzara, Miko will be back to visit when the next beast tamers tournament comes around.","nextNodeIds":[400860315]},{"nodeId":400860315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":474414530,"text":"High five, Bongo-Head! It was really fun having you around. Paimon hopes you have a good time at Haniyyah's, and is really looking forward to seeing you again next time!","nextNodeIds":[400860316]},{"nodeId":400860316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4200639818,"text":"We'll meet again... that's a promise!","nextNodeIds":[400860317]},{"nodeId":400860317,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":1115270650,"text":"I hope that the day when humans and Fungi can live in harmony will come quickly...","nextNodeIds":[400860318]},{"nodeId":400860318,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","textMapHash":4109882930,"text":"I believe in you all, you'll make it happen! I look forward to the good news!","nextNodeIds":[]},{"nodeId":400860310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3429887194,"text":"Congratulations to you too, Kindlejoy.","nextNodeIds":[400860311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4008603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["4008603","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4008603_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4008601,4008602,4008603],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"Layla","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"Haniyyah","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[140086],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3054161406,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/EQ/V3.2FungusFighter_40086/Q4008601","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEG