,"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7405903","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7405902,"initDialog":740590201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5322],"performCfg":"QuestDialogue/WQ/Fontaine_74045/Q7405902","priority":5,"questId":74059,"showRandomTalkCount":0},"dialogs":[{"nodeId":740590201,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":70754498,"text":"#{NICKNAME}, Paimon, it's been a while!","nextNodeIds":[740590202]},{"nodeId":740590202,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":3999263098,"text":"Are you looking for the same strange rocks as last time?","nextNodeIds":[740590203]},{"nodeId":740590203,"roleType":"TALK_ROLE_NPC","speakerId":1400,"speakerName":"Paimon","textMapHash":3435620434,"text":"Uh, we are, but there's something else too...","nextNodeIds":[740590204]},{"nodeId":740590204,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2069038954,"text":"You give Chesil's prototype clock to Puca and tell her about Chesil's plan to make clocks using the strange ore.","nextNodeIds":[740590205]},{"nodeId":740590205,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":2444351138,"text":"A—Amazing! They can make things like these out of those rocks!?","nextNodeIds":[740590206]},{"nodeId":740590206,"roleType":"TALK_ROLE_NPC","speakerId":1400,"speakerName":"Paimon","textMapHash":1789052978,"text":"Eh? Only the bits inside are made from that stone...","nextNodeIds":[740590207]},{"nodeId":740590207,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":118925346,"text":"You can even hear it ticking underwater... I've never seen a clock like this!","nextNodeIds":[740590208]},{"nodeId":740590208,"roleType":"TALK_ROLE_NPC","speakerId":1400,"speakerName":"Paimon","textMapHash":1419975994,"text":"Chesil talked about it having an oyster-style structure... Or was it clam-style?","nextNodeIds":[740590209]},{"nodeId":740590209,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":3558513114,"text":"Hehe, I'm happy just hearing the sound coming from the clock!","nextNodeIds":[740590210]},{"nodeId":740590210,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":1012726234,"text":"I never imagined that even ordinary stones like this would be so suited for something...","nextNodeIds":[740590211]},{"nodeId":740590211,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":2965063594,"text":"I always thought that you had to be like my sister, and only the rarest of gemstones could be turned into treasures. I never thought that you could also make something incredible with such ordinary rocks...","nextNodeIds":[740590212]},{"nodeId":740590212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":76951234,"text":"Everything has its value and purpose.","nextNodeIds":[740590213]},{"nodeId":740590213,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":2228542074,"text":"Mm-hmm, I suddenly feel really good about myself!","nextNodeIds":[740590214]},{"nodeId":740590214,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3743296002,"text":"Puca carefully places the clock in a nice place.","nextNodeIds":[740590215]},{"nodeId":740590215,"roleType":"TALK_ROLE_NPC","speakerId":1400,"speakerName":"Paimon","textMapHash":341442098,"text":"Okay, now all you have to do is get the ore ready and sell it to Chesil when he needs it!","nextNodeIds":[740590216]},{"nodeId":740590216,"roleType":"TALK_ROLE_NPC","speakerId":1400,"speakerName":"Paimon","textMapHash":4172848474,"text":"Then, you'll even be able to have your own gemstone workshop, just like your sister!","nextNodeIds":[740590217]},{"nodeId":740590217,"roleType":"TALK_ROLE_NPC","speakerId":1400,"speakerName":"Paimon","textMapHash":396037666,"text":"You've collected lots of different stones, after all. Maybe you'll be able to find a use for each and every one of them!","nextNodeIds":[740590218]},{"nodeId":740590218,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":1881606522,"text":"Right! I'll definitely make preparations for that! Thank you so much!","nextNodeIds":[740590219]},{"nodeId":740590219,"roleType":"TALK_ROLE_NPC","speakerId":5322,"speakerName":"Puca","textMapHash":3104072178,"text":"If you ever need any rocks, come find me anytime!","nextNodeIds":[740590220]},{"nodeId":740590220,"roleType":"TALK_ROLE_NPC","speakerId":1400,"speakerName":"Paimon","textMapHash":473242346,"text":"Hehe, don't mention it!","nextNodeIds":[]}]},{"talkId":