E","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7405902,"order":3,"stepDescription":"","stepDescTextMapHash":3351719676,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7405901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7405901],"talks":[{"talkId":7405901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7405902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7405901,"initDialog":740590101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5096],"performCfg":"QuestDialogue/WQ/Fontaine_74045/Q7405901","priority":5,"questId":74059,"showRandomTalkCount":0},"dialogs":[{"nodeId":740590101,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":3987128418,"text":"Ah, it's you two, the ones who sold me those gemstones...","nextNodeIds":[740590102]},{"nodeId":740590102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1604908450,"text":"Yeah! You said something about turning them into pretty accessories the last time we met... How's that going?","nextNodeIds":[740590103]},{"nodeId":740590103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2039705666,"text":"Paimon can't wait to see how they turned out!","nextNodeIds":[740590104]},{"nodeId":740590104,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":11119554,"text":"About that... I'm afraid I must disappoint you.","nextNodeIds":[740590105]},{"nodeId":740590105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1163406746,"text":"Huh?","nextNodeIds":[740590106]},{"nodeId":740590106,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":3484695722,"text":"I really wanted to inlay the gemstones in jewelry, but the ore is far too hard to polish by hand in any detail...","nextNodeIds":[740590107]},{"nodeId":740590107,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":4040278474,"text":"And that's not even the worst part. Who could have imagined that after being cut and polished, the ore would lose all its original glow?","nextNodeIds":[740590108]},{"nodeId":740590108,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":3196477634,"text":"Either way, they're not suitable for crafting at all.","nextNodeIds":[740590109]},{"nodeId":740590109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4254234362,"text":"Oh... Paimon didn't expect things to turn out like this. We genuinely thought that these stones would be useful in some way...","nextNodeIds":[740590110]},{"nodeId":740590110,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":3546599994,"text":"Useful, you say... Well, it certainly isn't useless...","nextNodeIds":[740590126]},{"nodeId":740590126,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":760923690,"text":"Chesil places a mechanical clock on the counter while speaking.","nextNodeIds":[740590111]},{"nodeId":740590111,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":1910287354,"text":"Look at this new mechanical clock — it was made using that very ore.","nextNodeIds":[740590112]},{"nodeId":740590112,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":1600366354,"text":"I was about to blame myself for misjudging the ore and was going to just get rid of it...","nextNodeIds":[740590113]},{"nodeId":740590113,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":847318218,"text":"But then some clocksmiths came by and saw the scraps left over from our processing attempts. Since the ore was so durable, they took some with them and used it to make components for their clocks.","nextNodeIds":[740590114]},{"nodeId":740590114,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":834444890,"text":"I was surprised to discover that thanks to the ore's high resistance to abrasion, it is superior to materials traditionally used for the moving components of clocks.","nextNodeIds":[740590115]},{"nodeId":740590115,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":223455698,"text":"But if they're used to make clocks, the supply shipments would need to be even more reliable...","nextNodeIds":[740590116,740590117]},{"nodeId":740590116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2710064258,"text":"I guess we can do that...","nextNodeIds":[740590118]},{"nodeId":740590118,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2626660370,"text":"You tell Chesil about Puca and the ore veins.","nextNodeIds":[740590119]},{"nodeId":740590119,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":3884453946,"text":"I see, then that is truly a happy coincidence! The prototype clock was created using the latest waterproof clam-style design — in other words, it was intended for Melusine use from the very start!","nextNodeIds":[740590120]},{"nodeId":740590120,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":3445985450,"text":"In that case, could you bring this prototype to Miss Puca and explain the situation to her?","nextNodeIds":[740590121]},{"nodeId":740590121,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":3292904146,"text":"After all, I've never done business with Melusines before... If Miss Puca could provide us with a stable supply, we'd be able to establish a whole new production line.","nextNodeIds":[740590122]},{"nodeId":740590122,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":4236253298,"text":"I'll be sure to personally visit her in the future! Hmm... it would be a good idea to implement Melusine aesthetics into future clock designs...","nextNodeIds":[740590123]},{"nodeId":740590123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2232509290,"text":"Hehe, sounds like it'll benefit Puca too if you succeeded!","nextNodeIds":[740590124]},{"nodeId":740590124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":826950138,"text":"Ooh, this could be a great opportunity for Puca to start her own gemstone factory! C'mon, let's go talk to her!","nextNodeIds":[740590125]},{"nodeId":740590125,"roleType":"TALK_ROLE_NPC","speakerId":5096,"speakerName":"Chesil","textMapHash":816490418,"text":"I'm counting on you!","nextNodeIds":[]},{"nodeId":740590117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":116422274,"text":"If you contact Puca directly...","nextNodeIds":[740590118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7405901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133403781,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7405906,"order":4,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7405906,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"E