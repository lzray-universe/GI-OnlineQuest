eNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7612602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7612602,"initDialog":761260201,"nextRandomTalks":[],"nextTalks":[],"npcId":[7046],"performCfg":"QuestDialogue/WQ/NodKrai_76126/Q7612602","priority":5,"questId":76126,"showRandomTalkCount":0},"dialogs":[{"nodeId":761260201,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1144209338,"text":"Ah... Jahoda? What brings you here? Hmm... Is Boss Nefer available right now?","nextNodeIds":[761260202]},{"nodeId":761260202,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1497837386,"text":"(Just as I thought, he wants to see Boss Nef... Hmm, I should be able to handle a small matter like this myself.)","nextNodeIds":[761260203]},{"nodeId":761260203,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3780593114,"text":"No need to go to all that trouble. I'm actually here because my boss sent me to help you.","nextNodeIds":[761260204]},{"nodeId":761260204,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3105493618,"text":"Huh? Wh—What do you mean? Does that mean Boss Nefer has...","nextNodeIds":[761260205]},{"nodeId":761260205,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":961794834,"text":"You've always wanted to visit the Frostmoon Scions, right?","nextNodeIds":[761260206]},{"nodeId":761260206,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1363932130,"text":"So, the plan is to befriend Lyylikki first, then ask her to take you to the Frostmoon Scions?","nextNodeIds":[761260207]},{"nodeId":761260207,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3278455658,"text":"What!? Lady Nefer knew it all along? But I've kept it locked in my heart and barely told anyone...","nextNodeIds":[761260208]},{"nodeId":761260208,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2555456938,"text":"(Now is the time to use that super cool line that Boss said! What was that line again...? Um... Oh!)","nextNodeIds":[761260209]},{"nodeId":761260209,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":601387578,"text":"Hehe, Mr. Zompaynco, when you guard a secret, you must also learn to hide the fact that you're guarding one.","nextNodeIds":[761260210]},{"nodeId":761260210,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2001627658,"text":"Otherwise, no matter how tall a wall you build in your heart, sooner or later the wind will find its cracks.","nextNodeIds":[761260211]},{"nodeId":761260211,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3853361762,"text":"*Sigh* I was never good at keeping my feelings bottled up, even back when I was still in my hometown.","nextNodeIds":[761260212]},{"nodeId":761260212,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1846863058,"text":"(YES! I said it! All that practice paid off, heheh!)","nextNodeIds":[761260213]},{"nodeId":761260213,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":4050052402,"text":"Well, now that you know, could you help me make an introduction? I'm an outsider, and I don't want to intrude on Miss Lyylikki.","nextNodeIds":[761260214]},{"nodeId":761260214,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2782434738,"text":"Don't worry, Lyylikki's really kind. Whether you're a complete stranger or in a form not entirely human, she's always warm and welcoming.","nextNodeIds":[761260215]},{"nodeId":761260215,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3911091762,"text":"Oh? Is that so...?","nextNodeIds":[761260216]},{"nodeId":761260216,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":720179458,"text":"But still, calling on her unannounced is rather impolite... Um, but if you happen to know her...","nextNodeIds":[761260217]},{"nodeId":761260217,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2539480490,"text":"Of course I do! They should be just about done handing out the meals now. Let's head over.","nextNodeIds":[761260218]},{"nodeId":761260218,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3174060962,"text":"Oh! And by the way, Boss also said we won't be charging you this time.","nextNodeIds":[761260219]},{"nodeId":761260219,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":251893746,"text":"Oh, thank you so much! I'll go get my things right away.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["7046"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7612603,"order":3,"stepDescription":"Accompany Zompaynco to speak with Lyylikki","stepDescTextMapHash":2494012092,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["7058"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7612601],"talks":[{"talkId":7612601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7612603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7612601,"initDialog":761260101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7058],"performCfg":"QuestDialogue/WQ/NodKrai_76126/Q7612601","priority":5,"questId":76126,"showRandomTalkCount":0},"dialogs":[{"nodeId":761260101,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1214388290,"text":"Jahoda? And... Mr. Zompaynco. What can I do for you?","nextNodeIds":[761260102]},{"nodeId":761260102,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1979107594,"text":"I... uhh... about that...","nextNodeIds":[761260103]},{"nodeId":761260103,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3899826514,"text":"He wants to visit the Frostmoon Scions, but can't quite bring himself to ask, so he's hoping you'll help him out.","nextNodeIds":[761260104]},{"nodeId":761260104,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":2724304842,"text":"Yes! Yes, that's exactly it!","nextNodeIds":[761260105]},{"nodeId":761260105,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3056748674,"text":"G—Greetings, Miss Lyylikki! It's such a pleasure to meet you. Uh... I brought this fossil specimen from Natlan along...","nextNodeIds":[761260106]},{"nodeId":761260106,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":651019602,"text":"Thank you, but Mr. Zompaynco... umm... We've already met, haven't we? You really don't need to be so formal.","nextNodeIds":[761260107]},{"nodeId":761260107,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":515097082,"text":"Huh? Then... how did you notice me?","nextNodeIds":[761260108]},{"nodeId":761260108,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":477191762,"text":"You've always been there when I was distributing meals, haven't you? Wandering around the line, circling back and forth, but never stepping in.","nextNodeIds":[761260109]},{"nodeId":761260109,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":591998586,"text":"I thought you might want a serving but were too shy to say so, so I quietly set a portion aside for you.","nextNodeIds":[761260110]},{"nodeId":761260110,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1559360698,"text":"But you've never came around to claim one. In fact, you hadn't shown up today, I was going to ask someone to check and see if you need help or something like that.","nextNodeIds":[761260111]},{"nodeId":761260111,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":2180934530,"text":"Ah... I—I'm so sorry. I've been hesitating, trying to figure out how to say hello...","nextNodeIds":[761260112]},{"nodeId":761260112,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":788806746,"text":"So, Miss Lyylikki... would it be alright if I paid the Frostmoon Scions a visit?","nextNodeIds":[761260113]},{"nodeId":761260113,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2060425466,"text":"Of course. We've welcomed a few guests from outside before. But may I ask why?","nextNodeIds":[761260114]},{"nodeId":761260114,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":167470490,"text":"I'd like to take some photos and notes, look through some records, and if possible... ask someone about the local legends!","nextNodeIds":[761260115]},{"nodeId":761260115,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":865056466,"text":"I'm a member of Natlan's Saurian Relics Association. If I could find materials connected to my research, that would be invaluable.","nextNodeIds":[761260116]},{"nodeId":761260116,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2083275250,"text":"I see... so you're hoping to spend some time in the archives, then? Let me think...","nextNodeIds":[761260117]},{"nodeId":761260117,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2835104394,"text":"Well, seeing how you seem to have hit it off, I'll consider this commission complete. Let me get back and report to my boss.","nextNodeIds":[761260118]},{"nodeId":761260118,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":2860980874,"text":"Thank you, Miss Jahoda! But... I really must pay you for your trouble. It'd be wrong to have you come all the way here for nothing.","nextNodeIds":[761260119]},{"nodeId":761260119,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":4112473626,"text":"And please be sure to convey my gratitude to Boss Nefer when you return.","nextNodeIds":[761260120]},{"nodeId":761260120,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":398994282,"text":"Of course. I'll take my leave now, then. You two enjoy your chat.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execAc