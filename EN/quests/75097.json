S IF! You better add your own sound effects every time you touch a Statue of The Seven!","nextNodeIds":[750970108]}]},{"talkId":7509703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["502802","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["7509704","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7509705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7509706","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_A_AND_ETCOR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7509703,"initDialog":750970301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"","priority":6,"questId":75097,"showRandomTalkCount":0},"dialogs":[{"nodeId":750970301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1746775138,"text":"Hehe, that's the way it should be! That's the kind of stable connection with the Statue of The Seven we're looking for.","nextNodeIds":[750970302]},{"nodeId":750970302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":388585138,"text":"So that issue we were having before was due to that baddie in the Night Kingdom, huh? The Statue of The Seven sure must've been having a hard time back then... Great job, Statue!","nextNodeIds":[750970303]},{"nodeId":750970303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":690446058,"text":"Though, it's not like you could've granted the power to resonate with Pyro even if you wanted to...","nextNodeIds":[750970304]},{"nodeId":750970304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3606719106,"text":"Yeah, that happened while I was fighting alongside the Pyro Archon...","nextNodeIds":[750970305]},{"nodeId":750970305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2808481442,"text":"Yeah, Paimon was super scared then... But as it turned out, you were too strong for that!","nextNodeIds":[750970306]},{"nodeId":750970306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":961036682,"text":"Either way, it's great that we managed to get rid of all those Abyss monsters and restore the Statues!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7509701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7509705,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7509703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7509701","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["7509702","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QU