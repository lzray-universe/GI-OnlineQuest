{"mainQuestId":71125,"title":"\"Vibro-Crystals. It's Always Vibro-Crystals...\"","description":"A pair of engineers from Fontaine is currently performing some rather esoteric research in Liyue...","titleTextMapHash":3318292351,"descTextMapHash":3954802782,"mainQuestExcel":{"mainQuestId":71125,"titleTextMapHash":3318292351,"title":"\"Vibro-Crystals. It's Always Vibro-Crystals...\"","descTextMapHash":3954802782,"description":"A pair of engineers from Fontaine is currently performing some rather esoteric research in Liyue...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5189,"luaPath":"Actor/Quest/WQ71125","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5189,"chapterId":0,"descTextMapHash":3954802782,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71125,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2653891137,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71125","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171125],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3318292351,"type":"WQ","unlockDescTextMapHash":3882122094}},"flow":[{"subQuestId":7112501,"order":1,"stepDescription":"Talk to the Fontainian engineers","stepDescTextMapHash":1385752436,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7112505,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30152"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7112501,7112503,7112504,7112505],"talks":[{"talkId":7112501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7112501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7112501,"initDialog":711250101,"nextRandomTalks":[],"nextTalks":[7112503,7112504],"npcId":[30152,30322],"performCfg":"QuestDialogue/WQ/CrystalLink3_71125/Q7112501","priority":6,"questId":71125,"showRandomTalkCount":0},"dialogs":[{"nodeId":711250101,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1884586426,"text":"Stop it, Patrice! Our current experiments run completely contrary to the Institute's directives...","nextNodeIds":[711250102]},{"nodeId":711250102,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":2783965522,"text":"You mean the one on the approval document that says \"this project should produce technology that provides greater economic benefits\"?","nextNodeIds":[711250103]},{"nodeId":711250103,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":700346002,"text":"They just want to know if it can be sold for Mora, don't worry about that! We just need to continue testing and gathering data, yeah? So, you'll need to give me some more Mora to buy Vibro-Crystals...","nextNodeIds":[711250104]},{"nodeId":711250104,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":2578912178,"text":"We don't have that much funding left. Where are you going to get the Mora to hire testers once you've blown it all? Or are you going to do it yourself?","nextNodeIds":[711250105]},{"nodeId":711250105,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":521915258,"text":"Well, you must remember, dear Anatole, that \"research supervisors of outdoor experiments must, if necessity dictates, assist the researcher in performing testing...\"","nextNodeIds":[711250106]},{"nodeId":711250106,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":1979427674,"text":"I'll leave the next experiment to you, then. Also, I recall that you have a considerable quantity of travel funds, yes? You could always eat fewer meals and...","nextNodeIds":[711250107]},{"nodeId":711250107,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1616079866,"text":"Oh, and now you're putting it upon your colleagues to save Mora on your behalf? Ah, Patrice, how hard your heart is! That Mora is for Bamboo Shoot Soup — not a wicked villain such as yourself!","nextNodeIds":[711250108]},{"nodeId":711250108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":33068386,"text":"Yeah! You can always work less, but you should never eat less!","nextNodeIds":[711250109]},{"nodeId":711250109,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":94793482,"text":"Precisely so!","nextNodeIds":[711250110]},{"nodeId":711250110,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1884591850,"text":"Ah, I knew it! To speak such piercing insights, you must be the famous...","nextNodeIds":[711250111]},{"nodeId":711250111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2137600634,"text":"That's right, Paimon's the renowned Paimon!","nextNodeIds":[711250112]},{"nodeId":711250112,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1205772010,"text":"#Then this must be the renowned {NICKNAME}?","nextNodeIds":[711250113,711250114]},{"nodeId":711250113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1791146914,"text":"That's me, the famous... me!","nextNodeIds":[711250116]},{"nodeId":711250116,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1679082978,"text":"Anyway, it is just as Paimon says. How could I ever skimp on food?","nextNodeIds":[711250117]},{"nodeId":711250117,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":4145297234,"text":"What should I do, then? If I don't have the funding to conduct my experiments, forget the prospect of \"greater economic benefits\" — the only prospects awaiting me will be \"tragedy.\"","nextNodeIds":[711250118]},{"nodeId":711250118,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":3166409794,"text":"*sigh*...","nextNodeIds":[711250119]},{"nodeId":711250119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2065109266,"text":"Ah, and by the way, what were you two talking about with all those \"prospects\"? Are you prospecting?","nextNodeIds":[711250120]},{"nodeId":711250120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1489360090,"text":"Economic benefits... Are you two researching how to prospect for Mora? Whoa, i—is there any chance you'll find a way to make Mora just spurt out of the ground like a fountain?","nextNodeIds":[711250121]},{"nodeId":711250121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2104505354,"text":"Ooh, I'm in. I'd like a cut.","nextNodeIds":[711250122]},{"nodeId":711250122,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":3583969490,"text":"No, no, not that kind of prospect at all. That said, I do believe that my research project's \"prospects\" will turn out to be just as valuable...","nextNodeIds":[711250123]},{"nodeId":711250123,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":3257595642,"text":"We need to settle the funding issue first. Also, we need to design an invention that will sell well.","nextNodeIds":[711250124]},{"nodeId":711250124,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":92023738,"text":"*cough* Great inventions are often mere byproducts of great research... Marvelous, inventive ideas leap forth like stingrays from your mind as you conduct said research...","nextNodeIds":[711250125]},{"nodeId":711250125,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":3872486594,"text":"They'd better.","nextNodeIds":[711250126]},{"nodeId":711250126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1835037322,"text":"Wait, hold on a sec. Paimon's getting curious now. Just what sort of research are you doing?","nextNodeIds":[711250127]},{"nodeId":711250127,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":2861311106,"text":"We're working on ores known as Vibro-Crystals. We discovered them in Liyue previously while studying the different properties of ore in the region.","nextNodeIds":[711250128]},{"nodeId":711250128,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":913765234,"text":"They can be divided into two types: Transmitter and Receiver Crystals.","nextNodeIds":[711250129]},{"nodeId":711250129,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":3158246306,"text":"When the Transmitter Crystal is stimulated in a certain way, it will release a specific energy that resonates with the Receiver Crystal half, generating unique effects.","nextNodeIds":[711250130]},{"nodeId":711250130,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1981448546,"text":"Which is an interesting phenomenon, albeit one that... Let's just say that the Fontainian Research Institute isn't nearly as interested in ores as it used to be.","nextNodeIds":[711250131]},{"nodeId":711250131,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":3802938882,"text":"Mr. Raimondo's also been clear that it lacks \"economic benefits\" — ergo, it won't bring the money in.","nextNodeIds":[711250132]},{"nodeId":711250132,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":3353913410,"text":"Such shallowness!","nextNodeIds":[711250133]},{"nodeId":711250133,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":4144698290,"text":"*sigh* In any case, Patrice was stymied while applying for funding. He didn't manage to secure any Mora, only an honorary title.","nextNodeIds":[711250134]},{"nodeId":711250134,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":3746205234,"text":"I thought that I could at least use the title to guarantee an interim loan from the Northland Bank...","nextNodeIds":[711250135]},{"nodeId":711250135,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":2582709218,"text":"But the moment the clerks heard that I was an Institute engineer, their smiles melted like snow in spring.","nextNodeIds":[711250136]},{"nodeId":711250136,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":56000458,"text":"And no wonder, considering how hard our lot have abused that trick.","nextNodeIds":[711250137]},{"nodeId":711250137,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":3600632402,"text":"So it is as you see — we're out of funding, and we can't even hire adventurers to help perform our experiments... nor do we have even the foggiest ideas about possible inventions.","nextNodeIds":[711250138]},{"nodeId":711250138,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1304304098,"text":"Not that this comes as any surprise. I must admit that it's tough, living in a foreign land with little funding while performing complex experiments, maintaining the experimental site, and also trying to design an invention.","nextNodeIds":[711250139]},{"nodeId":711250139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2841194274,"text":"#Well, how about we help out, {NICKNAME}?","nextNodeIds":[711250140]},{"nodeId":711250140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2309030978,"text":"Oho, Paimon's going to become a great inventor, eh?","nextNodeIds":[711250141]},{"nodeId":711250141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1467929850,"text":"Paimon doesn't know the first thing about inventing, but we could do the \"performing experiments\" part, right?","nextNodeIds":[711250142]},{"nodeId":711250142,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":3085128794,"text":"C—Could you really?","nextNodeIds":[]},{"nodeId":711250114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1554848426,"text":"I'd imagine that I'm already a bit more than just \"renowned.\"","nextNodeIds":[711250115]},{"nodeId":711250115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1350404162,"text":"Hey, why'd you get competitive all of a sudden!?","nextNodeIds":[711250116]}]},{"talkId":7112503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7405379","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7112501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7112503,"initDialog":711250301,"nextRandomTalks":[],"nextTalks":[7112505],"npcId":[30152,30322],"performCfg":"QuestDialogue/WQ/CrystalLink3_71125/Q7112503","priority":5,"questId":71125,"showRandomTalkCount":0},"dialogs":[{"nodeId":711250301,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":991697818,"text":"Well, I'll have you know that I'm an Honorary Senior Researcher.","nextNodeIds":[711250302]},{"nodeId":711250302,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1345686738,"text":"R—Really? Absolutely astonishing, I didn't think that we'd be hearing an Institute honorary title all the way out here...","nextNodeIds":[711250303]},{"nodeId":711250303,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":3695294594,"text":"Well! I'd say that those with the heart to help out deserve all the titles they could ever want, wouldn't you?","nextNodeIds":[]}]},{"talkId":7112504,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7112501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7112504,"initDialog":711250401,"nextRandomTalks":[],"nextTalks":[7112505],"npcId":[30152,30322],"performCfg":"QuestDialogue/WQ/CrystalLink3_71125/Q7112504","priority":5,"questId":71125,"showRandomTalkCount":0},"dialogs":[{"nodeId":711250401,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":509528826,"text":"Well, here's an experienced adventurer should you need one.","nextNodeIds":[711250402]},{"nodeId":711250402,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":1079717706,"text":"#In that case, we'll leave the experiment in your hands, {NICKNAME}, Paimon. All the best — the success of the project is riding on you!","nextNodeIds":[]}]},{"talkId":7112505,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","