..","nextNodeIds":[711250503]},{"nodeId":711250503,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","textMapHash":2916036722,"text":"As for the rest, we'll see how your product design work comes along, Patrice.","nextNodeIds":[711250504]},{"nodeId":711250504,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":169772586,"text":"Sure, sure. At least the experiments can continue...","nextNodeIds":[711250505]},{"nodeId":711250505,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","textMapHash":1266467506,"text":"#In that case, we'll leave the experiment in your hands, {NICKNAME}, Paimon. All the best — the success of the project is riding on you!","nextNodeIds":[711250506]},{"nodeId":711250506,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":92795114,"text":"Don't you worry, just leave it to us!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7112505,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30152"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7112501,7112503,7112504,7112505],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"Anatole","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"Patrice","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_