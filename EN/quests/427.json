","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[42708],"talks":[{"talkId":42708,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["42708","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":42708,"initDialog":4270801,"nextRandomTalks":[],"nextTalks":[],"npcId":[1483],"performCfg":"QuestDialogue/LQ/Ambor1_427/Q42708","priority":0,"questId":427,"showRandomTalkCount":0},"dialogs":[{"nodeId":4270801,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":724360315,"text":"I am Otto of the Knights of Favonius.","nextNodeIds":[4270802]},{"nodeId":4270802,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":630633427,"text":"Wh—What's going on?","nextNodeIds":[4270803]},{"nodeId":4270803,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":1997136971,"text":"Please show me your gliding license.","nextNodeIds":[4270804,4270805]},{"nodeId":4270804,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3308579291,"text":"Ahh... my um, gliding license is, uh...","nextNodeIds":[4270806]},{"nodeId":4270806,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":4282744403,"text":"It is against the law to glide without a license! I am arresting you under Section 7, Article 12 of the Mondstadt Penal Code.","nextNodeIds":[4270807]},{"nodeId":4270807,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":107605523,"text":"You have the right to remain silent. Anything you say will forever carry on the wind.","nextNodeIds":[4270808]},{"nodeId":4270808,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":666469691,"text":"Wait... I'm an instructor. This is a gliding exam.","nextNodeIds":[4270809]},{"nodeId":4270809,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":2068981195,"text":"Oh... I see.","nextNodeIds":[4270810]},{"nodeId":4270810,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":1343538747,"text":"Well, you picked a bad time to hold your gliding exam.","nextNodeIds":[4270811]},{"nodeId":4270811,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1581356531,"text":"Really, why?","nextNodeIds":[4270812]},{"nodeId":4270812,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":629921003,"text":"The Knights of Favonius received a report from a Sister at the Cathedral claiming she saw Raptor gliding around these parts. I thought your student here must have been his partner in crime.","nextNodeIds":[4270813]},{"nodeId":4270813,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2104289795,"text":"Raptor? Who's that?","nextNodeIds":[4270814]},{"nodeId":4270814,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":409311771,"text":"A known criminal in Mondstadt. He always uses a wind glider to commit his crimes, so people started calling him Raptor.","nextNodeIds":[4270815]},{"nodeId":4270815,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3586273579,"text":"Wow. He flies fast, then?","nextNodeIds":[4270816]},{"nodeId":4270816,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":1950676339,"text":"So far we haven't managed to catch him... Our plan this time was to draw him into the Cathedral with a precious artifact, and ambush him inside.","nextNodeIds":[4270817]},{"nodeId":4270817,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":3607476499,"text":"...But he escaped with the artifact.","nextNodeIds":[4270818]},{"nodeId":4270818,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":2519202275,"text":"Fortunately, one of the Sisters put some secret markings on the artifact using elemental magic!","nextNodeIds":[4270819]},{"nodeId":4270819,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":3606790931,"text":"...But he was too fast, and we couldn't even keep up with the trail the markings left behind.","nextNodeIds":[4270820]},{"nodeId":4270820,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":247202427,"text":"Well, if you need help chasing down a gliding criminal, I'm the one for the job! So tell me, which way did he go?","nextNodeIds":[4270821]},{"nodeId":4270821,"roleType":"TALK_ROLE_NPC","speakerId":1483,"speakerName":"Otto","textMapHash":430571603,"text":"As far as I know, he was last seen near Springvale, but that was some time ago.","nextNodeIds":[4270822]},{"nodeId":4270822,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1423279787,"text":"#Leave it to me! With me and {NICKNAME} chasing him down together, he doesn't stand a chance.","nextNodeIds":[4270823,4270824]},{"nodeId":4270823,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2154022875,"text":"Sure.","nextNodeIds":[4270825]},{"nodeId":4270825,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":982466891,"text":"Once we've got this Raptor guy, we'll pick up where we left off.","nextNodeIds":[4270826]},{"nodeId":4270826,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1218616619,"text":"But no need to worry... I'll be sure to have a word with Jean.","nextNodeIds":[]},{"nodeId":4270824,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2508568763,"text":"So... I passed?","nextNodeIds":[4270825]},{"nodeId":4270805,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":302048795,"text":"It got eaten by Baron Bunny...","nextNodeIds":[4270806]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[42708,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[{"talkId":4270303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomT