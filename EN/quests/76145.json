6,"speakerName":"Kuzmich","textMapHash":3517855330,"text":"Great! Finally sold everything. Looks like the old \"small profit, quick turnover\" strategy really works.","nextNodeIds":[761450602]},{"nodeId":761450602,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":1869413850,"text":"By rights, I should be heading back to Snezhnaya... though right now I've barely made enough for the journey. I came here empty-handed, and I'd rather not go back the same way!","nextNodeIds":[761450603]},{"nodeId":761450603,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":38566354,"text":"*sigh* Anyway, thanks for supporting my business.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7614506,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7614507,"order":5,"stepDescription":"","stepDescTextMapHash":2969807204,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1145,1],"PAINLIBBLDK":"QUEST_CONTENT_SHOP_SELL_OUT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7614507],"talks":[{"talkId":7614507,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7614507","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7614507,"initDialog":761450701,"nextRandomTalks":[],"nextTalks":[],"npcId":[7656],"performCfg":"","priority":5,"questId":76145,"showRandomTalkCount":0},"dialogs":[{"nodeId":761450701,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":2814018482,"text":"Oh my, fate works in mysterious ways — running into you here again! Want to take a look? This time I've got some pretty good stuff.","nextNodeIds":[761450709,761450702,761450706,761450711]},{"nodeId":761450709,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":161256458,"text":"Let's see what good stuff you have.","nextNodeIds":[761450710]},{"nodeId":761450710,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3709751098,"text":"Hey, all of this is retired equipment the Fatui got rid of. You won't find it anywhere else, so take whatever you like!","nextNodeIds":[]},{"nodeId":761450702,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2793616098,"text":"Didn't you go back to Snezhnaya?","nextNodeIds":[761450703]},{"nodeId":761450703,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":104185450,"text":"To be honest, my home is in Novokitezhgrad, and my whole family works in the mines. They are all more stubborn than the Domovoy, and when I said I wanted to go into business, they were dead set against it.","nextNodeIds":[761450704]},{"nodeId":761450704,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":320074378,"text":"So before I left, I made a big promise to make a fortune... But who would've thought I'd end up barely able to scrape together enough money for the journey back.","nextNodeIds":[761450705]},{"nodeId":761450705,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3879192714,"text":"Making it big is out of the question now, but at least let me earn a little — something to show for when I get back.","nextNodeIds":[]},{"nodeId":761450706,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3883721354,"text":"Why are you in Fatui territory?","nextNodeIds":[761450707]},{"nodeId":761450707,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3918249818,"text":"Oh, come on! I'm a law-abiding Snezhnayan, and being around the Fatui here feels just like being at home.","nextNodeIds":[761450708]},{"nodeId":761450708,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3206090874,"text":"All my goods here are retired equipment the Fatui got rid of, and they specifically asked me to handle it. You won't find anything like this anywhere else, this is the only place.","nextNodeIds":[]},{"nodeId":761450711,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":469716442,"text":"No thanks, I'll be going now.","nextNodeIds":[761450712]},{"nodeId":761450712,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3299132554,"text":"Ah, what a pity...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1145,1],"PAINLIBBLDK":"QUEST_CONTENT_SHOP_SELL_OUT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7614509,"order":6,"stepDescription":"","stepDescTextMapHash":1083142820,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7614509,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK"