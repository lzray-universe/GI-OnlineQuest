,"",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7614504,"initDialog":761450401,"nextRandomTalks":[],"nextTalks":[],"npcId":[7656],"performCfg":"","priority":5,"questId":76145,"showRandomTalkCount":0},"dialogs":[{"nodeId":761450401,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":2350931842,"text":"What a coincidence, we meet again! Would you like to buy something? My new stock isn't moving at all... please, help me out here.","nextNodeIds":[761450407,761450402,761450409]},{"nodeId":761450407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":384905634,"text":"Let me see what good stuff you have.","nextNodeIds":[761450408]},{"nodeId":761450408,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":4231877970,"text":"These are all local specialties. Don't worry, I'll give you the very best price!","nextNodeIds":[]},{"nodeId":761450402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4170011802,"text":"Why did you restock again?","nextNodeIds":[761450403]},{"nodeId":761450403,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3478497490,"text":"Well, you know how it is — business is business. Strike while the iron's hot, right? I came across a good opportunity in Piramida, someone needed to sell their goods urgently and gave me a good price.","nextNodeIds":[761450404]},{"nodeId":761450404,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":799971050,"text":"I got a little too excited and forgot I was supposed to be heading home... so I bought everything. And now, here I am...","nextNodeIds":[761450405]},{"nodeId":761450405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2992276874,"text":"Guess why he's in such a hurry to sell.","nextNodeIds":[761450406]},{"nodeId":761450406,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":2953939594,"text":"Agh, please don't rub it in... Why not have a look instead? Maybe you'll find something useful.","nextNodeIds":[]},{"nodeId":761450409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1434678690,"text":"Sorry, I'm heading off.","nextNodeIds":[761450410]},{"nodeId":761450410,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":282558034,"text":"Hey... don't leave yet! I'm sure there's something you need!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1144,1],"PAINLIBBLDK":"QUEST_CONTENT_SHOP_SELL_OUT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7614506,"order":4,"stepDescription":"","stepDescTextMapHash":717370972,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7614506,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"Q