E_NPC"},"isHidden":false,"talkIds":[7614501],"talks":[{"talkId":7614501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7614502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7614501,"initDialog":761450101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7656],"performCfg":"","priority":5,"questId":76145,"showRandomTalkCount":0},"dialogs":[{"nodeId":761450101,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":482828194,"text":"Business really is terrible these days... Maybe I should save up some money and try to rent a stall in Nasha Town...","nextNodeIds":[761450113,761450102,761450115]},{"nodeId":761450113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":396804954,"text":"Got any good stuff?","nextNodeIds":[761450114]},{"nodeId":761450114,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3956166466,"text":"Just some trinkets I got from Natlan, feel free to take a look if anything interests you.","nextNodeIds":[]},{"nodeId":761450102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1887057082,"text":"Who are you?","nextNodeIds":[761450103]},{"nodeId":761450103,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":30222010,"text":"Oh my, a customer! Hello there! I'm Kuzmich, a traveling merchant from Snezhnaya.","nextNodeIds":[761450104]},{"nodeId":761450104,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":858398658,"text":"Well, that's what I like to call myself, but I'm just doing a bit of small business on my travels to earn some money for the journey.","nextNodeIds":[761450105]},{"nodeId":761450105,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3559170738,"text":"But when I passed through Natlan, the people there were just too enthusiastic, and I got caught up in the moment and... Now if I don't sell all this merchandise, I won't even have enough money for a ticket back home.","nextNodeIds":[761450106,761450110]},{"nodeId":761450106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":879898314,"text":"Are you going back to Snezhnaya?","nextNodeIds":[761450107]},{"nodeId":761450107,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":400570674,"text":"Yes, once I sell this batch of goods, I'll buy a train ticket and head back.","nextNodeIds":[761450108]},{"nodeId":761450108,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":1070874410,"text":"Although it snows there all year round, and everywhere is covered in ice and snow, you can only stay cooped up in the city every day...","nextNodeIds":[761450109]},{"nodeId":761450109,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":1750071586,"text":"But after being away for so long, I'm starting to miss the days when I could sleep all day at home.","nextNodeIds":[]},{"nodeId":761450110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":558286994,"text":"Business looks pretty slow here.","nextNodeIds":[761450111]},{"nodeId":761450111,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":2654780466,"text":"Yeah... but if I want a proper stall in town, I'll have to borrow money from Northland Bank. I heard the one in Nasha Town doesn't have a very good reputation...","nextNodeIds":[761450112]},{"nodeId":761450112,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":4059381762,"text":"Ah, whatever. At least there's good foot traffic here. As long as people keep passing by, the goods will sell eventually, right?","nextNodeIds":[]},{"nodeId":761450115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3661935250,"text":"Sorry, I have to go now.","nextNodeIds":[761450116]},{"nodeId":761450116,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":229948330,"text":"Hey, why are you leaving already? Won't you take a look...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1143,1],"PAINLIBBLDK":"QUEST_CONTENT_SHOP_SELL_OUT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMG