type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7614503,"initDialog":761450301,"nextRandomTalks":[],"nextTalks":[],"npcId":[7656],"performCfg":"","priority":5,"questId":76145,"showRandomTalkCount":0},"dialogs":[{"nodeId":761450301,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":3958953754,"text":"Oh my, I can't believe they're all sold out! Looks like I do have some business sense after all.","nextNodeIds":[761450302]},{"nodeId":761450302,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":1208689130,"text":"Next, I'll ask the Lightkeepers to guide me through the Dreadshade Mire. After that, it should be a straight shot to the north.","nextNodeIds":[761450303]},{"nodeId":761450303,"roleType":"TALK_ROLE_NPC","speakerId":7656,"speakerName":"Kuzmich","textMapHash":4096920178,"text":"Maybe I'll find some business opportunities on my way back... Well then, this is where we part. Until we meet again!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7614503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":