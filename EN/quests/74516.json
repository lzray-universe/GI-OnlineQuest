{"mainQuestId":74516,"title":"An Invasion on Hold","description":"After a spate of spirited fishing, you manage to halt the spread of invasive fish in Fontaine's waters. Meanwhile, you receive some good news from the Maison Gardiennage...","titleTextMapHash":300771023,"descTextMapHash":2940266174,"mainQuestExcel":{"mainQuestId":74516,"titleTextMapHash":300771023,"title":"An Invasion on Hold","descTextMapHash":2940266174,"description":"After a spate of spirited fishing, you manage to halt the spread of invasive fish in Fontaine's waters. Meanwhile, you receive some good news from the Maison Gardiennage...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5251,"luaPath":"Actor/Quest/WQ74516","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5251,"chapterId":0,"descTextMapHash":2940266174,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74516,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2640365961,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74516","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174516],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":300771023,"type":"WQ","unlockDescTextMapHash":3008507510}},"flow":[{"subQuestId":7451601,"order":1,"stepDescription":"Talk to Jala","stepDescTextMapHash":684635364,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30773"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7451601],"talks":[{"talkId":7451601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7451601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7451601,"initDialog":745160101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30773,30784],"performCfg":"QuestDialogue/WQ/FishingJoy_74516/Q7451601","priority":6,"questId":74516,"showRandomTalkCount":0},"dialogs":[{"nodeId":745160101,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":759363642,"text":"Honorary Knight and The Helper in White, good news!","nextNodeIds":[745160102]},{"nodeId":745160102,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":638264482,"text":"This is Enghiene of the Maison Gardiennage. She has already arrested the supplier behind The Unchained.","nextNodeIds":[745160103]},{"nodeId":745160103,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":1872541626,"text":"Hmph! The scoundrel was still counting money even as I kicked the door down... A proper piece of work, that one!","nextNodeIds":[745160104]},{"nodeId":745160104,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":3569789170,"text":"And it looks like your fishing spree's had the desired effect — there's been a clear reduction in the number of invasive species in these waters...","nextNodeIds":[745160105]},{"nodeId":745160105,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":407307402,"text":"The way things are going, I'd say it won't take long before the problem's been thoroughly dealt with.","nextNodeIds":[745160106]},{"nodeId":745160106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1554612466,"text":"That's awesome! So, there's no need to worry about the Fonta... Uhh, Paimon meant, the quality of Fontaine's water!","nextNodeIds":[745160107]},{"nodeId":745160107,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":3728447434,"text":"#You're clearly a very capable hunter! It's not just anyone who can enlist the help of {NICKNAME}, the Grand Chef Supreme of Valor...","nextNodeIds":[745160108]},{"nodeId":745160108,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":2159992098,"text":"How does that old phrase go...? That's right, like shooting gulls with a cannon!","nextNodeIds":[745160109,745160110]},{"nodeId":745160109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3049423410,"text":"Anything to keep those seabirds off my Fisherman's Toast...","nextNodeIds":[745160111]},{"nodeId":745160111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3962271106,"text":"Now that Paimon thinks about it, Officer Enghiene looks a little familiar...","nextNodeIds":[745160112]},{"nodeId":745160112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1061320250,"text":"Is it because we're always helping uphold the peace? Paimon must have seen a million officers by now!","nextNodeIds":[745160113,745160116]},{"nodeId":745160113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3230330666,"text":"Nice to meet you, Officer We've-Never-Met-But-Looks-Familiar!","nextNodeIds":[745160114]},{"nodeId":745160114,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":4025049914,"text":"Hahaha! There's no need to act so formally. I'm sure we'll be working together a lot in the future, so let's try to keep it casual.","nextNodeIds":[745160115]},{"nodeId":745160115,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":1108539242,"text":"Otherwise, I'm going to have to act all serious every time I run into trouble and need your help. Can you imagine how exhausting that would be?","nextNodeIds":[745160121]},{"nodeId":745160121,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":1819990322,"text":"*sigh* I've been up to my eyeballs with this case for so long, but it looks like I can finally clock out...","nextNodeIds":[745160122]},{"nodeId":745160122,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":514095394,"text":"I think I'll take a trip to The Rusty Rudder for a drink or two. Wait and see if that scumbag and the Unchained make an appearance on the news... Wanna join me?","nextNodeIds":[745160123]},{"nodeId":745160123,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":3891513002,"text":"Thanks for the offer, Officer Enghiene, but I can't let my guard down just yet. These invasive fish don't give up easily, y'know. Who knows what new trouble they might cause?","nextNodeIds":[745160124]},{"nodeId":745160124,"roleType":"TALK_ROLE_NPC","speakerId":30773,"speakerName":"Jala","textMapHash":2963689594,"text":"I can't stop until these waters are completely free of invasive species... but once I'm done, I'll come and find you for a drink!","nextNodeIds":[745160125]},{"nodeId":745160125,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":1533474346,"text":"Wow, now that's motivation! Well, guessing it might take you a while, but I'll see you there when you're done!","nextNodeIds":[745160126]},{"nodeId":745160126,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":3577034410,"text":"Give it your best and give 'em what for!","nextNodeIds":[745160127]},{"nodeId":745160127,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3697161874,"text":"Jala returns to the water's edge to continue monitoring the situation...","nextNodeIds":[745160128]},{"nodeId":745160128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1510870186,"text":"Paimon thinks that Miss Jala works a bit too hard...","nextNodeIds":[745160129]},{"nodeId":745160129,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":1130516810,"text":"Well, I guess... there must have been someone in her past with a really strong sense of responsibility, who had a profound effect on her... It's easy to see how she feels.","nextNodeIds":[745160130]},{"nodeId":745160130,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":1499177682,"text":"Watching her work, I don't dare slack off myself.","nextNodeIds":[745160131,745160133]},{"nodeId":745160131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3034635626,"text":"Motivation is good...","nextNodeIds":[745160132]},{"nodeId":745160132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3940686890,"text":"#Working hard is important, but sometimes it's also good to be like {NICKNAME}. Everyone needs a good work-life balance!","nextNodeIds":[745160135]},{"nodeId":745160135,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":3318896106,"text":"In that case, if one day I come to you for professional time-management tips, you'd better not turn me away!","nextNodeIds":[745160136]},{"nodeId":745160136,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":2160986018,"text":"Anyway... I'll put in an application to the higher-ups to have the expenses for this operation — especially your remuneration — upgraded to the \"Main-Cannon-Operational-Expenses\" band.","nextNodeIds":[745160137]},{"nodeId":745160137,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":95456250,"text":"Hopefully, the next time I run into trouble, you two will already be there...","nextNodeIds":[745160138]},{"nodeId":745160138,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":1626851482,"text":"With any luck, you'll be standing there, hands on hips, greeting me with a smile and a resounding \"The problem's already been solved!\"","nextNodeIds":[]},{"nodeId":745160133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2805338602,"text":"But work-life balance is even better.","nextNodeIds":[745160134]},{"nodeId":745160134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2469070434,"text":"#Paimon agrees! {NICKNAME} is an expert when it comes to not working too hard!","nextNodeIds":[745160135]},{"nodeId":745160116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":741974858,"text":"Have we worked together before, officer?","nextNodeIds":[745160117]},{"nodeId":745160117,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":2568073346,"text":"So you do remember me? That's wonderful!","nextNodeIds":[745160118]},{"nodeId":745160118,"roleType":"TALK_ROLE_NPC","speakerId":30784,"speakerName":"Enghiene","textMapHash":2563469850,"text":"The next time we see each other, it'll be just like meeting an old colleague... There'll be no need to tip-toe around and carefully consider each word.","nextNodeIds":[745160119,745160120]},{"nodeId":745160119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":408039626,"text":"Au naturel is fine by us!","nextNodeIds":[745160121]},{"nodeId":745160120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2741910314,"text":"If there's any trouble in the future, we can be sure to help each other out!","nextNodeIds":[745160121]},{"nodeId":745160110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":725507266,"text":"I wouldn't mind learning how to shoot a cannon!","nextNodeIds":[745160111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QU