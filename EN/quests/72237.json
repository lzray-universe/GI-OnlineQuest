,{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7223703,"initDialog":722370301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20480],"performCfg":"QuestDialogue/WQ/Inazuma_72237/Q7223703","priority":5,"questId":72237,"showRandomTalkCount":0},"dialogs":[{"nodeId":722370301,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":4106908042,"text":"You two are...","nextNodeIds":[722370302]},{"nodeId":722370302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3022744634,"text":"Are you Antei?","nextNodeIds":[722370303]},{"nodeId":722370303,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":3763924282,"text":"That's right. That's me. I feel... a little strange...","nextNodeIds":[722370304]},{"nodeId":722370304,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":3976059946,"text":"I remember chasing those scoundrels... ripping a core out and throwing it into a camp. Then after that, I got a little woozy from my own injuries... I was hurt pretty bad...","nextNodeIds":[722370305]},{"nodeId":722370305,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":2931277146,"text":"But then I woke up, and then I met you, and now I feel fine. Tell me, am I going to die soon or something?","nextNodeIds":[722370306]},{"nodeId":722370306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":439028042,"text":"...","nextNodeIds":[722370307]},{"nodeId":722370307,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":3552356162,"text":"...No, that's not important right now. Are you here to arrest me again? I've already proven my innocence.","nextNodeIds":[722370308]},{"nodeId":722370308,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":919501882,"text":"It was those people from Khaenri'ah. They were the ones who stole that library book. I was assigned as one of their bodyguards, sure, but there's no way I would have been in cahoots with them!","nextNodeIds":[722370309]},{"nodeId":722370309,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":1032625234,"text":"I tracked their diplomatic team to this place and beat them all.","nextNodeIds":[722370310]},{"nodeId":722370310,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":2602001250,"text":"But I spent a long time dealing with some giant mechanical creature they had with them. Finally, I was able to tear its core out, but I was wounded seriously in the process.","nextNodeIds":[722370311]},{"nodeId":722370311,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":478458818,"text":"The disabled machine crashed on top of the lost book. There's no way to retrieve it now.","nextNodeIds":[722370312]},{"nodeId":722370312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2453700538,"text":"Wow, Byakuyakoku's Jibashiri are pretty tough...","nextNodeIds":[722370313]},{"nodeId":722370313,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":4185843258,"text":"Wait, you aren't Jibashiri or candidates yourselves? *sigh* Whatever. The Jibashiri started out as heroes who fought against the Bathysmal Vishaps. It was only later that they became law enforcement — the judges of the nether.","nextNodeIds":[722370314]},{"nodeId":722370314,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":3346752082,"text":"The machine's core is in the camp. Go there and have a look if you don't believe me.","nextNodeIds":[]}]},{"talkId":7223704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7223705","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7223708","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7223704,"initDialog":722370401,"nextRandomTalks":[],"nextTalks":[],"npcId":[20480],"performCfg":"","priority":5,"questId":72237,"showRandomTalkCount":0},"dialogs":[{"nodeId":722370401,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":3782344346,"text":"I once heard a Narukami Island envoy talk about this creature named a \"bird.\" It has wings and it can fly through the skies.","nextNodeIds":[722370402]},{"nodeId":722370402,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":4071320066,"text":"That's just amazing, can you imagine it?","nextNodeIds":[722370403]},{"nodeId":722370403,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":3037038706,"text":"Some people believe that they are messengers from the gods who carry word of human fates.","nextNodeIds":[722370404]},{"nodeId":722370404,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":2185697778,"text":"And if some exiled person finally expires out in the wild, the very same creature will come to peck and consume their mortal flesh.","nextNodeIds":[722370405]},{"nodeId":722370405,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"Antei","textMapHash":3688086698,"text":"These animals fascinate me, to be honest. If I should see the light of another day, I will definitely keep a bird.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7223703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["5","155008039,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20480","11","2"],"NOCCOBOFKHP":5,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_SHOW_OR_HIDE_NPC"}}},{"subQuestId":7223709,"order":5,"stepDescription":"Obtain the Ruin machine's core","stepDescTextMapHash":465895476,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[101654,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0