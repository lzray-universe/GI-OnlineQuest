ATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1037"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[201501,201552],"talks":[{"talkId":201501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["201501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":201501,"initDialog":20150101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1037,1039],"performCfg":"QuestDialogue/AQ/Inazuma2_2015/Q201501","priority":5,"questId":2015,"showRandomTalkCount":0},"dialogs":[{"nodeId":20150101,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":3912486522,"text":"#How is Teppei's condition, {NICKNAME}?","nextNodeIds":[20150102,20150103]},{"nodeId":20150102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":964742922,"text":"How could none of us have noticed?","nextNodeIds":[20150104]},{"nodeId":20150104,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":1765219554,"text":"...I have put out the order to seize all Delusions.","nextNodeIds":[20150105]},{"nodeId":20150105,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":933461482,"text":"The vast majority are showing some loss of vitality, but nothing serious.","nextNodeIds":[20150106]},{"nodeId":20150106,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":2730007362,"text":"Sadly, a few have been... less fortunate...","nextNodeIds":[20150107]},{"nodeId":20150107,"roleType":"TALK_ROLE_NPC","speakerId":1039,"speakerName":"Gorou","textMapHash":1397850378,"text":"Your Excellency, I'm planning to establish a dedicated field hospital to monitor their condition.","nextNodeIds":[20150108]},{"nodeId":20150108,"roleType":"TALK_ROLE_NPC","speakerId":1039,"speakerName":"Gorou","textMapHash":2635237122,"text":"The soldiers are up in arms about the ban though. They know full well what a Delusion is, but they still intend to keep using them.","nextNodeIds":[20150109]},{"nodeId":20150109,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":1117511466,"text":"Okay. I'll leave you to deal with this situation. I have to get to the front line.","nextNodeIds":[20150110]},{"nodeId":20150110,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":1546527546,"text":"This whole fiasco is certain to be a blow to morale. If the Shogun's Army attacks now, while we're scrambling to recover, it could well undo everything we have achieved so far.","nextNodeIds":[20150111]},{"nodeId":20150111,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":3890884458,"text":"#{NICKNAME}, what are your thoughts?","nextNodeIds":[20150112]},{"nodeId":20150112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1264156946,"text":"I'll go confront the Fatui directly.","nextNodeIds":[20150113]},{"nodeId":20150113,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":395501554,"text":"No, it's too dangerous!","nextNodeIds":[20150114]},{"nodeId":20150114,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":3307981682,"text":"The Sakoku Decree is still in force, so their Delusions must be produced within Inazuma's borders.","nextNodeIds":[20150115]},{"nodeId":20150115,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":161458922,"text":"To organize an operation of this scale, they will have had to mobilize a huge amount of manpower and resources. They can't have done it without local support.","nextNodeIds":[20150116]},{"nodeId":20150116,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":111184394,"text":"If we want to stop them, we have to destroy the factory where the Delusions are made. But it's sure to be heavily guarded...","nextNodeIds":[20150117]},{"nodeId":20150117,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":432964202,"text":"It's dangerous to go alone. At least take some troops with you...","nextNodeIds":[20150118]},{"nodeId":20150118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3344766538,"text":"There's no time for that.","nextNodeIds":[20150119]},{"nodeId":20150119,"roleType":"TALK_ROLE_NPC","speakerId":1039,"speakerName":"Gorou","textMapHash":2119321706,"text":"Your Excellency, given the urgency of the situation, we were hardly discreet when confiscating the Delusions. The Fatui are sure to take notice.","nextNodeIds":[20150120]},{"nodeId":20150120,"roleType":"TALK_ROLE_NPC","speakerId":1039,"speakerName":"Gorou","textMapHash":209580786,"text":"If we spend any longer amassing our forces, they will get wind of our plans and make their escape.","nextNodeIds":[20150121]},{"nodeId":20150121,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":1620835146,"text":"Very true. Mm... let me think...","nextNodeIds":[20150122]},{"nodeId":20150122,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":144923594,"text":"I gave this some thought while you were confiscating the Delusions. The site of the factory must be big and secluded, but close enough to a transport route to ensure the supply of raw materials...","nextNodeIds":[20150123]},{"nodeId":20150123,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":2113875066,"text":"Not many places meet these criteria, and if we take the locations where our soldiers received their Delusions into account as well, I suspect the site is likely to be the cliffs near the ocean at the southwest of <color=#00E1FFFF>Yashiori Island</color>.","nextNodeIds":[20150124]},{"nodeId":20150124,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":1988545866,"text":"I'm not going to stop you, but please be careful.","nextNodeIds":[20150125]},{"nodeId":20150125,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":2419895170,"text":"We have lost too many courageous fighters already. I don't want to lose you too.","nextNodeIds":[20150126]},{"nodeId":20150126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3456461666,"text":"Okay, let's go.","nextNodeIds":[20150127]},{"nodeId":20150127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3178184498,"text":"Huh? You mean, to the <color=#00E1FFFF>Delusion factory</color>?","nextNodeIds":[20150128]},{"nodeId":20150128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2841992354,"text":"...","nextNodeIds":[20150129]},{"nodeId":20150129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3786752178,"text":"Really? You aren't going to think it over first? Ugh, fine...","nextNodeIds":[]},{"nodeId":20150103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2790443178,"text":"He's taken a sudden turn for the worse.","nextNodeIds":[20150104]}]},{"talkId":201552,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["