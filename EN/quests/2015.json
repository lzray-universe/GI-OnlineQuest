"","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":201504,"initDialog":20150401,"nextRandomTalks":[],"nextTalks":[],"npcId":[10013],"performCfg":"QuestDialogue/AQ/Inazuma2_2015/Q201504","priority":5,"questId":2015,"showRandomTalkCount":0},"dialogs":[{"nodeId":20150401,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":131139722,"text":"You actually managed to find this place. Congratulations.","nextNodeIds":[20150402]},{"nodeId":20150402,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":2436920378,"text":"Hah. Barely two words in and you already look like you want me dead.","nextNodeIds":[20150403,20150404]},{"nodeId":20150403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":452765394,"text":"You're manufacturing Delusions...","nextNodeIds":[20150405]},{"nodeId":20150405,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":2112193546,"text":"Oh, so that's what this is about.","nextNodeIds":[20150406]},{"nodeId":20150406,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":3259125402,"text":"I think you've got the wrong idea. I know how this looks, but I'm just here to follow orders.","nextNodeIds":[20150407]},{"nodeId":20150407,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":344358946,"text":"I'm obviously not the mastermind behind this. Aren't you supposed to be pretty tough? What are you waiting for, go get them.","nextNodeIds":[20150408]},{"nodeId":20150408,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":2437086154,"text":"You're getting all worked up over nothing. Pff, you've changed... You're getting weak.","nextNodeIds":[20150409]},{"nodeId":20150409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":97949690,"text":"How can you say this is nothing?","nextNodeIds":[20150410]},{"nodeId":20150410,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":1908677850,"text":"How can you call it anything more? It's the way of the world. Human life is worthless.","nextNodeIds":[20150411]},{"nodeId":20150411,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":1532683698,"text":"They were always going to die, with or without a Delusion. At least having one gives them a chance to fulfill their ambitions.","nextNodeIds":[20150412]},{"nodeId":20150412,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":3450403274,"text":"Do you have any idea how useful the Vision Hunt Decree is to us? It took a lot of work to make it happen. Obviously it was in our best interests.","nextNodeIds":[20150413]},{"nodeId":20150413,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":3398208082,"text":"Good news is, our hard work is finally paying off. Generating conflict creates a big market for Delusions. Now we just let the promise of power draw in the weak...","nextNodeIds":[20150414]},{"nodeId":20150414,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":1215918218,"text":"For just a small price, they get the feeling of controlling the world. Trading their life for supreme power... pretty good deal, don't you think?","nextNodeIds":[20150415]},{"nodeId":20150415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2742778106,"text":"So the Fatui started the Vision Hunt Decree? You've been behind it all along?","nextNodeIds":[20150416]},{"nodeId":20150416,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":2133649146,"text":"From the outside, Inazuma looks pretty impenetrable, but on the inside... it's a land of opportunity. With a little effort, we were able to break them down from within.","nextNodeIds":[20150417]},{"nodeId":20150417,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":3637082698,"text":"Eternity stretches things out over a long time. But each moment within it becomes all the more fragile.","nextNodeIds":[20150418]},{"nodeId":20150418,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":1145680402,"text":"Take your friend in the resistance, for example. There's nothing you can do now. He's a lost cause.","nextNodeIds":[20150419]},{"nodeId":20150419,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":494872338,"text":"Just like a bubble on the water. Beautiful for a moment, then total destruction.","nextNodeIds":[20150420]},{"nodeId":20150420,"roleType":"TALK_ROLE_NPC","speakerId":10013,"speakerName":"The Balladeer","textMapHash":1963108658,"text":"The more it takes from them, the more tightly they hold onto it. And the more incompetent they are, the more determined they are to fight it! Hahaha, it's such a farce, you have to see the funny side.","nextNodeIds":[20150421,20150422]},{"nodeId":20150421,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2337464386,"text":"Don't you dare mock Teppei...","nextNodeIds":[20150423]},{"nodeId":20150423,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1472328626,"text":"#Hey! {NICKNAME}, calm down...","nextNodeIds":[]},{"nodeId":20150422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3992343410,"text":"He's not incompetent!","nextNodeIds":[20150423]},{"nodeId":20150404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":367650010,"text":"You're giving Delusions to the resistance...","nextNodeIds":[20150405]}]},{"talkId":201505,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["201505","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["50001","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":201505,"initDialog":20150501,"nextRandomTalks":[],"nextTalks":[],"npcId":[10013],"performCfg":"QuestDialogue/AQ/Inazuma2_2015/Q201505","priority":5,"questId":2015,"showRandomTalkCount":0},"dialogs":[{"nodeId":201504