],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7053002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7053002,"initDialog":705300201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30317],"performCfg":"","priority":5,"questId":70530,"showRandomTalkCount":0},"dialogs":[{"nodeId":705300201,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":574708810,"text":"Traveler! Traveler, please wait!","nextNodeIds":[705300202]},{"nodeId":705300202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2216448474,"text":"What event have you got going on here?","nextNodeIds":[705300203]},{"nodeId":705300203,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":1780857970,"text":"An event? No, no, I have neither the energy nor ability for something like that.","nextNodeIds":[705300204]},{"nodeId":705300204,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":3502685826,"text":"I'm merely someone interested in photo-taking. I even had someone get me a Kamera and took a great many pictures with it.","nextNodeIds":[705300205]},{"nodeId":705300205,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":2558044818,"text":"The people at the Guild seemed to really like the pictures I took. Cyrus even said that we could turn them into books and give them out as souvenirs.","nextNodeIds":[705300206]},{"nodeId":705300206,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":354372922,"text":"And well, you know what? Since it's Windblume Festival, Cyrus requested that I go around Mondstadt and take various pictures related to the festival.","nextNodeIds":[705300207]},{"nodeId":705300207,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":260486202,"text":"He's planning on putting them together into a commemorative album to be given out to the adventurers in the Guild as mementos.","nextNodeIds":[705300208]},{"nodeId":705300208,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":823464410,"text":"But... Mondstadt's a big place with lots of photo-taking spots, and I'm just one person...","nextNodeIds":[705300209]},{"nodeId":705300209,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":279026850,"text":"The other adventurers are also out on their own errands and won't have any time to help.","nextNodeIds":[705300210]},{"nodeId":705300210,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":4067766826,"text":"I know that a festival isn't really the right time to be asking around for help... but please, Traveler! I've heard that you're a dab hand at the Kamera, so please, help me out!","nextNodeIds":[705300211,705300213]},{"nodeId":705300211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2130728130,"text":"Well, I do know a thing or two...","nextNodeIds":[705300212]},{"nodeId":705300212,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":3078863186,"text":"Phew, alright, that's a relief. So the rumors are true then...","nextNodeIds":[705300216]},{"nodeId":705300216,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":2541263666,"text":"Anyway, Traveler, in that case, allow me to formally request your help in going around Mondstadt to take pictures using your Kamera.","nextNodeIds":[705300217]},{"nodeId":705300217,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":1814902754,"text":"Ah, yes, why don't you use this Kamera to take your photos? I maintain it regularly, so it runs very smoothly.","nextNodeIds":[705300218]},{"nodeId":705300218,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":1596214250,"text":"I mean, it takes a good Kamera to take good pictures, wouldn't you say?","nextNodeIds":[705300219]},{"nodeId":705300219,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":3176306626,"text":"I'll be counting on you, then. The pictures just need to be related to the Windblume Festival. Otherwise, there are no particular restrictions on their content!","nextNodeIds":[705300220]},{"nodeId":705300220,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":478529762,"text":"As for the reward, you don't need to worry. I'll follow the usual Guild regulations. You won't be working for free!","nextNodeIds":[705300221]},{"nodeId":705300221,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":3047884834,"text":"Now, I'll need to sort the pictures here into categories...","nextNodeIds":[]},{"nodeId":705300213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2440174098,"text":"Where'd you hear that about me?","nextNodeIds":[705300214]},{"nodeId":705300214,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":2410277842,"text":"Well, some other adventurers in the Guild told me so. There's quite a few Kamera enthusiasts amongst them.","nextNodeIds":[705300215]},{"nodeId":705300215,"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","textMapHash":2486630530,"text":"We've even been thinking of starting a Kamera Club, but we're not sure if Cyrus would approve...","nextNodeIds":[705300216]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30317"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7053002],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30317,"speakerName":"Fassben","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[170530],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2908101998,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"