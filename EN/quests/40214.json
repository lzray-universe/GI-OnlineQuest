{"mainQuestId":40214,"title":"An Adventurer's Woes","description":"To provide assistance to Nod-Krai's adventurers, the Adventurers' Guild has also placed an order with Aino...","titleTextMapHash":3159579583,"descTextMapHash":290712158,"mainQuestExcel":{"mainQuestId":40214,"titleTextMapHash":3159579583,"title":"An Adventurer's Woes","descTextMapHash":290712158,"description":"To provide assistance to Nod-Krai's adventurers, the Adventurers' Guild has also placed an order with Aino...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2042,"luaPath":"Actor/Quest/WQ40214","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2042,"chapterId":0,"descTextMapHash":290712158,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":40214,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":286970129,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ40214","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[140214],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3159579583,"type":"WQ","unlockDescTextMapHash":937833966}},"flow":[{"subQuestId":4021401,"order":1,"stepDescription":"Talk to Sarin","stepDescTextMapHash":2756975564,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7016"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7665303],"talks":[{"talkId":7665303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4021401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7665303,"initDialog":766530301,"nextRandomTalks":[],"nextTalks":[],"npcId":[7016],"performCfg":"QuestDialogue/EQ/V6.0ActivityNodKraiTour_76653/Q7665303","priority":5,"questId":40214,"showRandomTalkCount":0},"dialogs":[{"nodeId":766530301,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":893810474,"text":"Ah, Miss Aino. You're here...","nextNodeIds":[766530302]},{"nodeId":766530302,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3531252626,"text":"#Hmm? Aren't you the legendary {NICKNAME} and {M#his}{F#her} fairy companion?","nextNodeIds":[766530303]},{"nodeId":766530303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3559260562,"text":"You know us?","nextNodeIds":[766530304]},{"nodeId":766530304,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3701019202,"text":"My name is Sarin, and I'm the Branch Master of Nod-Krai's Adventurers' Guild. Just think about your reputation in the Guild... If I didn't know you, it would be a serious dereliction of my duties, wouldn't it?","nextNodeIds":[766530305]},{"nodeId":766530305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3380075890,"text":"Huh, that makes sense!","nextNodeIds":[766530306]},{"nodeId":766530306,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":3904021650,"text":"Ah, so you know each other! But lemme just confirm, which order's yours again?","nextNodeIds":[766530307]},{"nodeId":766530307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1195963706,"text":"Paimon's curious too. What kind of help would the Guild need from Aino?","nextNodeIds":[766530308]},{"nodeId":766530308,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":2918065890,"text":"Well... You know how it is. An adventurer's biggest obstacle out in the wild are the various enemies that stand in their way.","nextNodeIds":[766530309]},{"nodeId":766530309,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3283325914,"text":"In other regions, the Guild can collaborate with local authorities to provide some protection for adventurers. But in a place like Nod-Krai, we can only rely on ourselves.","nextNodeIds":[766530310]},{"nodeId":766530310,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":4016920258,"text":"So recently, I've come up with an idea: To design a self-defense device that any adventurer can carry around. That way, even less-skilled adventurers can fend off powerful foes!","nextNodeIds":[766530311]},{"nodeId":766530311,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3280897746,"text":"But... Haha, well, let's just say my attempt ended in failure. And since I lack the talent to get the job done, I may as well hire a professional to help me out.","nextNodeIds":[766530312]},{"nodeId":766530312,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1779122706,"text":"Oh yeah, that one! It's a good idea, but the design? Yeesh...","nextNodeIds":[766530313]},{"nodeId":766530313,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":196286562,"text":"And that is why we have asked you, Aino... Ah, I mean Miss Aino, for her invaluable assistance!","nextNodeIds":[766530314]},{"nodeId":766530314,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":2524280978,"text":"The hard part about this one, Sarin, is that the device you've designed uses tech from elsewhere... It can't adapt to Nod-Krai's kuuvahki-rich environments, y'see.","nextNodeIds":[766530315]},{"nodeId":766530315,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":3700238834,"text":"I mean, what we need to do isn't complicated. We just need to use his device, find some bad guys, beat them up for testing, then tweak the design as needed.","nextNodeIds":[766530316]},{"nodeId":766530316,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1930246794,"text":"And when testing, I'll be able to gather some data about kuuvahki-rich environments! So it's a win-win order.","nextNodeIds":[766530317]},{"nodeId":766530317,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":2176920298,"text":"Buuut, I'm not helping out with the fighting. If the device breaks down when you're surrounded, you'll only have your fists to rely on!","nextNodeIds":[766530318,766530319]},{"nodeId":766530318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2836829402,"text":"No problem.","nextNodeIds":[766530320]},{"nodeId":766530320,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":943929650,"text":"I'll leave it in your capable hands, then. If you need anything, just let me know. The Guild will ensure that your reward for a successful order is most generous!","nextNodeIds":[]},{"nodeId":766530319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1840064546,"text":"Great. My fists have been itching for some faces.","nextNodeIds":[766530320]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7016"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7665303],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","count":9},{"roleType":"TALK_ROLE_NPC","sp