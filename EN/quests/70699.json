":[{"nodeId":706990101,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":2159317762,"text":"Honorary Knight! We're so lucky to have you come and test out the entertainment stalls. It really puts my mind at ease!","nextNodeIds":[706990102]},{"nodeId":706990102,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":4202339946,"text":"This is actually my first time taking part in a development project, so I'm a little nervous. It's kinda frying my brain...","nextNodeIds":[706990103]},{"nodeId":706990103,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":2183600762,"text":"All I had to do was put a casing on an existing device. But there were so many design considerations, so many parameters to adjust...","nextNodeIds":[706990104]},{"nodeId":706990104,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3211807154,"text":"I don't envy Captain Albedo, having to create purpose-built devices from scratch... It must be such a difficult task.","nextNodeIds":[706990105,706990106]},{"nodeId":706990105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1555762706,"text":"I think it's functioning really well.","nextNodeIds":[706990107]},{"nodeId":706990107,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3855629570,"text":"Wow, uh... Th—Thank you! Thanks, Honorary Knight, that means a lot coming from you!","nextNodeIds":[706990108]},{"nodeId":706990108,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3980360074,"text":"I'll... I'll keep doing my best. Hopefully, I'll get to the point where I can build some useful stuff for the Reconnaissance Company...","nextNodeIds":[706990109]},{"nodeId":706990109,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":934217514,"text":"Oh, I won a few toys in one of the games. I'd like you to have this one...","nextNodeIds":[706990110]},{"nodeId":706990110,"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","textMapHash":3720140578,"text":"I have another one the same. Now, whenever I look at it, I'll think of all the encouragement you gave me!","nextNodeIds":[]},{"nodeId":706990106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1356867602,"text":"Don't be hard on yourself. You can only get better.","nextNodeIds":[706990107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1060"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7069901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1060,"speakerName":"Mika","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[170699],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3847751686,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/DPEQ_70699/Q7069901","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FA