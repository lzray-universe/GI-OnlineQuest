{"mainQuestId":71523,"title":"Hundred-Pace Hurling Rites","description":"Ting Zhi is busy near Wangshu Inn...","titleTextMapHash":3000588855,"descTextMapHash":306613574,"mainQuestExcel":{"mainQuestId":71523,"titleTextMapHash":3000588855,"title":"Hundred-Pace Hurling Rites","descTextMapHash":306613574,"description":"Ting Zhi is busy near Wangshu Inn...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2025,"luaPath":"Actor/Quest/WQ71523","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2025,"chapterId":0,"descTextMapHash":306613574,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71523,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3630220089,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71523","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171523],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3000588855,"type":"WQ","unlockDescTextMapHash":2492010526}},"flow":[{"subQuestId":7152301,"order":1,"stepDescription":"Talk to Ting Zhi","stepDescTextMapHash":843192028,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30426"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7152301],"talks":[{"talkId":7152301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7152301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7152301,"initDialog":715230101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30426],"performCfg":"QuestDialogue/WQ/V4.1PoetryActivity/Q7152301","priority":0,"questId":71523,"showRandomTalkCount":0},"dialogs":[{"nodeId":715230101,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":1682418586,"text":"Hmm... Now it shouldn't be too difficult...","nextNodeIds":[715230102]},{"nodeId":715230102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3938533570,"text":"What are you doing?","nextNodeIds":[715230103]},{"nodeId":715230103,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":624054610,"text":"I'm setting up the game I'm responsible for... Have you heard of \"Hundred-Pace Hurling Rites\"?","nextNodeIds":[715230104]},{"nodeId":715230104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1350923970,"text":"You want me to conduct a bunch of rites to chuck things long distances?","nextNodeIds":[715230105]},{"nodeId":715230105,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":1707238098,"text":"You... are very perceptive, and got it half right! The core game mechanics do revolve around \"throwing,\" but that's not what \"rites\" means here.","nextNodeIds":[715230106]},{"nodeId":715230106,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":488054482,"text":"I learned about this game from an ancient book. Let me briefly walk you through it...","nextNodeIds":[715230107]},{"nodeId":715230107,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":3148603362,"text":"The traditional rules dictate that all participants in this game must be sitting down, as part of the rites.","nextNodeIds":[715230108]},{"nodeId":715230108,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":2545686874,"text":"Well, you must also adopt a special sitting posture, which I will not demonstrate for you at this time, since I don't have any cushions here...","nextNodeIds":[715230109]},{"nodeId":715230109,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":3253946306,"text":"From their sitting positions, the participants must follow the music's rhythm and \"throw\" the \"Darts\" into the distant \"pots.\"","nextNodeIds":[715230110]},{"nodeId":715230110,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":3312642130,"text":"There are many ways to throw the Darts into the pots, each with their own special names.","nextNodeIds":[715230111]},{"nodeId":715230111,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":216302714,"text":"For example, the first Dart to land in the pot is called the \"First.\" If the subsequent Dart also lands in the vessel, it's called a \"Streak.\"","nextNodeIds":[715230112]},{"nodeId":715230112,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":2599678162,"text":"If the Dart hits the handles of the pot, it's called \"Piercing.\" If a Dart is thrown through the neck before bouncing out of the pot, it's called \"Valiant.\"","nextNodeIds":[715230113,715230116]},{"nodeId":715230113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3266299266,"text":"Th—That's way too complicated!","nextNodeIds":[715230114]},{"nodeId":715230114,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":3654923418,"text":"Don't worry. I just told you these are the \"traditional rules.\"","nextNodeIds":[715230115]},{"nodeId":715230115,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":1601960122,"text":"But I have simplified them for everyone's convenience.","nextNodeIds":[715230118]},{"nodeId":715230118,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":2798291546,"text":"Ahem! Anyway, all you need to know is that the goal is to throw as many Darts into the pots as you can before time runs out... I'll take care of the rest!","nextNodeIds":[715230119]},{"nodeId":715230119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3509291410,"text":"That sure is simplified, alright.","nextNodeIds":[715230120]},{"nodeId":715230120,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":2582191594,"text":"I mean... The rule book does say that whoever tosses the most Darts into the pot wins...","nextNodeIds":[715230121]},{"nodeId":715230121,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":2943689818,"text":"As for the rules that require the loser to drink and write a poem... I can't really ask every player who loses to do all that now, now can I?","nextNodeIds":[715230122]},{"nodeId":715230122,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":3673670538,"text":"Anyways! I'm almost done setting up the game. The Holding Pots are over there. I'll get you the Darts momentarily.","nextNodeIds":[715230123]},{"nodeId":715230123,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":860097242,"text":"You can try it now if you're interested.","nextNodeIds":[]},{"nodeId":715230116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2594558746,"text":"Th—There's no way to remember all that!","nextNodeIds":[715230117]},{"nodeId":715230117,"roleType":"TALK_ROLE_NPC","speakerId":30426,"speakerName":"Ting Zhi","textMapHash":1595044786,"text":"Don't worry, you don't need to remember all those terms, they... Ugh... Remembering them is my job.","nextNodeIds":[715230118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLN