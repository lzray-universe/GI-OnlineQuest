{"mainQuestId":74688,"title":"Pre-Packaged Solution","description":"After a brief battle, you manage to suppress the monsters in the ruins, collecting a large amount of data on Frejus's cannon in the process...","titleTextMapHash":1075891927,"descTextMapHash":2281319854,"mainQuestExcel":{"mainQuestId":74688,"titleTextMapHash":1075891927,"title":"Pre-Packaged Solution","descTextMapHash":2281319854,"description":"After a brief battle, you manage to suppress the monsters in the ruins, collecting a large amount of data on Frejus's cannon in the process...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5270,"luaPath":"Actor/Quest/WQ74688","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5270,"chapterId":0,"descTextMapHash":2281319854,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74688,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3393076913,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74688","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[0],"series":74687,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1075891927,"type":"WQ","unlockDescTextMapHash":3180102534}},"flow":[{"subQuestId":7468801,"order":1,"stepDescription":"Talk to the Gardes","stepDescTextMapHash":1066772356,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30534"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7468801],"talks":[{"talkId":7468801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7468801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468801,"initDialog":746880101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30839,30509,30534],"performCfg":"QuestDialogue/WQ/74688_74688/Q7468801","priority":5,"questId":74688,"showRandomTalkCount":0},"dialogs":[{"nodeId":746880101,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2163090338,"text":"These results are far, far better than expected!","nextNodeIds":[746880102]},{"nodeId":746880102,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":944317810,"text":"Even a whole company couldn't take out as many monsters as you! Based on the current situation, there's no way those monsters can escape the ruins.","nextNodeIds":[746880103]},{"nodeId":746880103,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2815213978,"text":"How do you feel? Was it hard work?","nextNodeIds":[746880104,746880107]},{"nodeId":746880104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1811896186,"text":"My vision's a little blurry...","nextNodeIds":[746880105]},{"nodeId":746880105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4129278434,"text":"Urgh, yeah. Those muzzle flashes aren't super bright, but Paimon still got dizzy from staring at them for too long...","nextNodeIds":[746880106]},{"nodeId":746880106,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1445375434,"text":"No problem! A paper I once read mentioned that you can suppress the flash by installing a device at the end of the barrel. It helps lower visual fatigue when firing for long periods.","nextNodeIds":[746880110]},{"nodeId":746880110,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2489577610,"text":"Anyway, the crisis has been averted, and we've collected enough data to ensure the next version of my cannon will be even better!","nextNodeIds":[746880111]},{"nodeId":746880111,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":4077314522,"text":"I can't thank you enough for your help, Proto-Boss — and, of course, for that of your little assistant!","nextNodeIds":[746880112]},{"nodeId":746880112,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1564039610,"text":"And lest we forget the vital role you played, Miss Marine... The reward money has already been earmarked for our Proto-Boss, but once I've sold the cannon, I'll split the proceeds with you — fifty-fifty!","nextNodeIds":[746880113]},{"nodeId":746880113,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":2232826810,"text":"Huh? You want to split the money with me!?","nextNodeIds":[746880114]},{"nodeId":746880114,"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","textMapHash":1314633298,"text":"I don't care much for Mora, but I wouldn't say no to some fermented Tidalga... and it needs to be wheat-based alcohol, none of that fruity nonsense.","nextNodeIds":[746880115]},{"nodeId":746880115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":770619346,"text":"Paimon hasn't tried fermented Tidalga before, but it sounds like it's worth a try...","nextNodeIds":[746880116,746880117]},{"nodeId":746880116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":291295594,"text":"You can't have alcohol, Paimon.","nextNodeIds":[746880118]},{"nodeId":746880118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1909956402,"text":"Sure — we can just swap the alcohol with Fonta! That'll do the trick!","nextNodeIds":[746880119]},{"nodeId":746880119,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":4224429346,"text":"I've never heard of this dish before... Where would I go to find it?","nextNodeIds":[746880120]},{"nodeId":746880120,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":136737674,"text":"This sounds like a perfect opportunity to invent an \"Automated Tidalga Pickler.\"","nextNodeIds":[746880121]},{"nodeId":746880121,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":1495811706,"text":"After all, your Automatic Breakfast Oven works wonders. You clearly have a knack for culinary devices.","nextNodeIds":[746880122]},{"nodeId":746880122,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":1924110850,"text":"Moreover, the market for this sort of food preparation device is huge. It's not like trying to sell cannons, where you need to display their exceptional performance against powerful opponents.","nextNodeIds":[746880123]},{"nodeId":746880123,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2782274370,"text":"And you don't have to run off to dangerous areas and battle monsters and the like every time you want to test a toaster.","nextNodeIds":[746880124]},{"nodeId":746880124,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":263379954,"text":"Hmm, you make a good point. Maybe I should try switching my focus...","nextNodeIds":[746880125]},{"nodeId":746880125,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":274927946,"text":"That said, if I did decide to become an inventor of machines with culinary applications — let's call them kitchen \"appliances\" — wouldn't all my previous work go to waste? And besides... I'd no longer have any connection to the Gardes!","nextNodeIds":[746880126]},{"nodeId":746880126,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3660135170,"text":"You...","nextNodeIds":[746880127]},{"nodeId":746880127,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":289052170,"text":"*sigh* I guess you're right... Giving up on all your previous work isn't really your style.","nextNodeIds":[746880128]},{"nodeId":746880128,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3100708834,"text":"Come to think of it, apart from installing Gardemeks' target identification module on our cannon, we could also have some actual Gardemeks serve as \"bodyguard meks\" within its unit.","nextNodeIds":[746880129]},{"nodeId":746880129,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":684250146,"text":"With that specialized protection detail in place, we shouldn't have to worry about monsters getting into our gun's blind spots.","nextNodeIds":[746880130]},{"nodeId":746880130,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":743643514,"text":"That way, you can combine all these machines together and sell them as a \"Pre-Packaged Solution\"...","nextNodeIds":[746880131]},{"nodeId":746880131,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":137293930,"text":"Oh! That's not a bad idea! Solving all our customers' problems with one complete package... That's definitely something worth looking into!","nextNodeIds":[746880132]},{"nodeId":746880132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":914155506,"text":"It's like they just need to start chatting and the ideas come flowing out...","nextNodeIds":[746880133]},{"nodeId":746880133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1684051498,"text":"I bet if we locked them in a room together and kept them there for a few weeks, they'd come up with all sorts of new inventions!","nextNodeIds":[]},{"nodeId":746880117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2568576458,"text":"You shouldn't eat just anything, Paimon.","nextNodeIds":[746880118]},{"nodeId":746880107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1889272570,"text":"My ears are still ringing...","nextNodeIds":[746880108]},{"nodeId":746880108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2893655370,"text":"Paimon feels like there's a flock of seagulls screaming inside her head!","nextNodeIds":[746880109]},{"nodeId":746880109,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1307656538,"text":"I have a solution for that! An abandoned engineering project I read mentioned using a multi-chambered muzzle device to slow down the gases responsible for the noise and make the cannon quieter. Unfortunately, the materials required are quite expensive...","nextNodeIds":[746880110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7468801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30534"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":30839,"speakerName":"Marine","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[0],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2281319854,"CHECNJEMEFE":{"30839":[1171]}