{"mainQuestId":75509,"title":"A Style-Fusion Symposium","description":"After playing Rhythm Ball for a while, some of your companions want to share their thoughts with you...","titleTextMapHash":2458679695,"descTextMapHash":4005680446,"mainQuestExcel":{"mainQuestId":75509,"titleTextMapHash":2458679695,"title":"A Style-Fusion Symposium","descTextMapHash":4005680446,"description":"After playing Rhythm Ball for a while, some of your companions want to share their thoughts with you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":5261,"luaPath":"Actor/Quest/WQ75509","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5261,"chapterId":0,"descTextMapHash":4005680446,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75509,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2711548833,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75509","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175509],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[33544],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2458679695,"type":"WQ","unlockDescTextMapHash":3196340006}},"flow":[{"subQuestId":7550901,"order":1,"stepDescription":"Return to the party venue","stepDescTextMapHash":2396481596,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1087"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7550901],"talks":[{"talkId":7550901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550901,"initDialog":755090101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1087,1095,1097],"performCfg":"QuestDialogue/WQ/BrickBreakerV2_75509/Q7550901","priority":5,"questId":75509,"showRandomTalkCount":0},"dialogs":[{"nodeId":755090101,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":453338834,"text":"Mizuki! Mizuki! Amina just told me some amazing news!","nextNodeIds":[755090102]},{"nodeId":755090102,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":437796946,"text":"Thanks to the party, the People of the Springs had forty percent more visitors than normal! And to think, we barely did anything to promote it!","nextNodeIds":[755090103]},{"nodeId":755090103,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":1441169306,"text":"That's great! I also have some good news... Over the past few days, the number of patients at my practice has dropped by ninety percent!","nextNodeIds":[755090104]},{"nodeId":755090104,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3642897546,"text":"If our goal was to lift people's spirits and give them a space to let go of their worries, I think we can safely say... That's a job well done!","nextNodeIds":[755090105]},{"nodeId":755090105,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":4011287762,"text":"Haha, then let's go even bigger next time! Add even more games!","nextNodeIds":[755090106]},{"nodeId":755090106,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":421099058,"text":"That way, there's something for everyone — hot springs if you want relaxation, games if you want fun... As far as vacations go, you can't get much better than that!","nextNodeIds":[755090107]},{"nodeId":755090107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":683276338,"text":"Hey! Mualani! Mizuki!","nextNodeIds":[755090108,755090109]},{"nodeId":755090108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":989371426,"text":"The musical genius has returned!","nextNodeIds":[755090110]},{"nodeId":755090110,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":2358000594,"text":"Hehe, say no more! It's written all over your face! You had a blast, didn't you?","nextNodeIds":[755090111]},{"nodeId":755090111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1135166074,"text":"Are you kidding!? An all-you-can-eat, self-serve buffet? Paimon was on cloud nine! She had five servings of Hot Spring O'Clock!","nextNodeIds":[755090112]},{"nodeId":755090112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3287847362,"text":"#And {NICKNAME} was even more obsessed with the Rhythm Ball than Paimon with the free food!","nextNodeIds":[755090113,755090114]},{"nodeId":755090113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3139659682,"text":"Ehe.","nextNodeIds":[755090115]},{"nodeId":755090115,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":247758114,"text":"Honestly, watching you play was quite the spectacle! An expert performance if I ever saw one!","nextNodeIds":[755090116]},{"nodeId":755090116,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":3128588522,"text":"You should help me brainstorm the next time we host something like this! We can come up with even more fun games!","nextNodeIds":[755090117]},{"nodeId":755090117,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":765997538,"text":"#As far as I know, that does seem to be one of {NICKNAME}'s many talents.","nextNodeIds":[755090118]},{"nodeId":755090118,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":1866931194,"text":"I look forward to working with you again, Miss Mualani. Although, it would be easier if you had a designated office space... Why don't I help you open a consultancy?","nextNodeIds":[755090119]},{"nodeId":755090119,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":2411197306,"text":"Ooh, I like the sound of that! Let me ask around! If there's space... We could put it right next to your clinic!","nextNodeIds":[755090120]},{"nodeId":755090120,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3955752682,"text":"Good idea! I'd love nothing more than to be neighbors.","nextNodeIds":[755090121,755090122]},{"nodeId":755090121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3829338282,"text":"Man, I want to live here, too!","nextNodeIds":[755090123]},{"nodeId":755090123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3725411610,"text":"Ooh, all-you-can-eat buffets and hot springs every day... Oh yeah, that sounds like the life, hehe...","nextNodeIds":[755090124]},{"nodeId":755090124,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":694686538,"text":"Well, if you had a permanent address, it would be easier to track you down if we need something.","nextNodeIds":[755090125]},{"nodeId":755090125,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3771452394,"text":"Never knew the day would come when I'd sound like one of my clients.","nextNodeIds":[755090126]},{"nodeId":755090126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2021154338,"text":"Oh, Xilonen!","nextNodeIds":[755090127]},{"nodeId":755090127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1772675362,"text":"The music you picked for Rhythm Ball was excellent! Every time we played the game, we would start dancing before we knew it!","nextNodeIds":[755090128]},{"nodeId":755090128,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":714438626,"text":"Glad to hear it.","nextNodeIds":[755090129]},{"nodeId":755090129,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":62769258,"text":"From what I've observed over the past few days, you have great potential as \"fusion\" artists.","nextNodeIds":[755090130]},{"nodeId":755090130,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1196662426,"text":"It could be because you've encountered music from all sorts of different cultures. When you're immersed in the melody, it's almost like you can incorporate different beats on instinct.","nextNodeIds":[755090131]},{"nodeId":755090131,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3020573626,"text":"The most cutting-edge music often involves some form of \"fusion.\" So, I have a feeling I'll be coming to you for inspiration one day.","nextNodeIds":[755090132]},{"nodeId":755090132,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":429492810,"text":"Here, I want you to have this. Give it a listen sometime.","nextNodeIds":[755090133]},{"nodeId":755090133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3327975514,"text":"What is it?","nextNodeIds":[755090134]},{"nodeId":755090134,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":1159941674,"text":"No way! One of Xilonen's mixtapes! At Xochicuicatl Records, that would sell in a heartbeat!","nextNodeIds":[755090135]},{"nodeId":755090135,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":4062537210,"text":"Ah, yes. Not everyone can get their hands on the records or equipment Miss Xilonen recommends. It's a source of anxiety for some people. I once treated a patient for that very reason...","nextNodeIds":[755090136]},{"nodeId":755090136,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2373007250,"text":"...You can treat even that, Miss Mizuki?","nextNodeIds":[755090137]},{"nodeId":755090137,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":638028954,"text":"All I did was help her manage her emotions. I told her to consider getting a job at the record store. Then, she would be one of the first to get information on your latest recommendations.","nextNodeIds":[755090138]},{"nodeId":755090138,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3408582194,"text":"Hah, good idea... I just hope she can keep it to herself, or job applications are about to become just as hard to snag...","nextNodeIds":[755090139,755090140]},{"nodeId":755090139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1484168290,"text":"Well, thanks for this.","nextNodeIds":[755090141]},{"nodeId":755090141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3077344482,"text":"Yeah! Paimon can't wait to hear it!","nextNodeIds":[755090142]},{"nodeId":755090142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1400370090,"text":"Next time, we'll help you come up with an even better game... With music that's just as amazing as this time, of course!","nextNodeIds":[755090143]},{"nodeId":755090143,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":90944442,"text":"That's a promise! People won't know what hit 'em!","nextNodeIds":[755090144]},{"nodeId":755090144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1097348762,"text":"Man, the party isn't even over, and Paimon already can't wait for the next one! The People of the Springs really know how to live it up...","nextNodeIds":[]},{"nodeId":755090140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1827677282,"text":"I'll give it a good listen.","nextNodeIds":[755090141]},{"nodeId":755090122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2672351570,"text":"More time in the People of the Springs... Count us in!","nextNodeIds":[755090123]},{"nodeId":755090114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2266797562,"text":"No, no, no. Nothing can compare to your obsession with food!","nextNodeIds":[755090115]},{"nodeId":755090109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1117301498,"text":"Two happy visitors here to give you a five-star review!","nextNodeIds":[755090110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7550901","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1087"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7550901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[175509],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4005680446,"CHECNJEME