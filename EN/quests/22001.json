h":1207541170,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["203101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2200103],"talks":[{"talkId":2200103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200106","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2200103,"initDialog":220010301,"nextRandomTalks":[],"nextTalks":[],"npcId":[203101],"performCfg":"","priority":6,"questId":22001,"showRandomTalkCount":0},"dialogs":[{"nodeId":220010301,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":2808538381,"text":"Here we are! Here's the captain!","nextNodeIds":[220010302]},{"nodeId":220010302,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1802622461,"text":"What are you doing, bringing the pirates here!? You should've led them on a wild goose chase so that me and Lulu would have time to escape!","nextNodeIds":[220010303]},{"nodeId":220010303,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":1440604581,"text":"Why do you and Lulu get to escape while I have to stay here and hold the pirates up!?","nextNodeIds":[220010304]},{"nodeId":220010304,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":3359125653,"text":"I got a better idea: I give you over to the pirates while I escape with Lulu!","nextNodeIds":[220010305]},{"nodeId":220010305,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":2105595837,"text":"But... Beidou says you should never abandon your friends!","nextNodeIds":[220010306]},{"nodeId":220010306,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":4019919941,"text":"Oh? And does Beidou also say that the captain should run away with their favorite person at the first sign of trouble!?","nextNodeIds":[220010307]},{"nodeId":220010307,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":3041135381,"text":"Why you little... I'm never sharing my Lotus Heads with you EVER again!","nextNodeIds":[220010308]},{"nodeId":220010308,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":471128789,"text":"FINE! It's only you who cares so much about stupid Lotus Heads anyway!","nextNodeIds":[220010309]},{"nodeId":220010309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1774998925,"text":"They are blowing this way out of proportion...","nextNodeIds":[220010310]},{"nodeId":220010310,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":2722361517,"text":"Don't worry, I know a way we can sort this out.","nextNodeIds":[220010311]},{"nodeId":220010311,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":1099520077,"text":"Lotus Heads are their favorite thing in the world... Giving them their favorite treat will definitely calm them down.","nextNodeIds":[220010312]},{"nodeId":220010312,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":2225479285,"text":"Can you find some Lotus Heads for me?","nextNodeIds":[220010313,220010315]},{"nodeId":220010313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2415583085,"text":"Okay.","nextNodeIds":[220010314]},{"nodeId":220010314,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":2273951581,"text":"Thank you! You need to be quick though.","nextNodeIds":[]},{"nodeId":220010315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2007798189,"text":"It's not Lotus Heads they're fighting over...","nextNodeIds":[220010316]},{"nodeId":220010316,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":3673110733,"text":"Oh... Really? Well what is it?","nextNodeIds":[220010317]},{"nodeId":220010317,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":3153750237,"text":"...Anyway, just get some Lotus Heads. We can't have them arguing like this all day.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB"