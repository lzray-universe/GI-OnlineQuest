0010415]},{"nodeId":220010415,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":3931349141,"text":"We've been playing together a long time. I know these things.","nextNodeIds":[]},{"nodeId":220010416,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2772133717,"text":"Little Lulu is a miracle worker...","nextNodeIds":[220010417]},{"nodeId":220010417,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":4122861869,"text":"Heeh-hee, thanks. But Beidou is the real miracle worker.","nextNodeIds":[220010418]},{"nodeId":220010418,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":3060519957,"text":"I hope I can be like her when I grow up...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[100026,2],"PAINLIBBLDK":"QUEST_CONTENT_ITEM_LESS_THAN","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["26200"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"},{"LNHLPKELCAL":["100026","2"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["203001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2200101,2200102,2200103,2200104,2200106,2200107,2200108,2200109],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","count":28},{"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","count":19},{"roleType":"TALK_R