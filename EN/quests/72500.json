{"mainQuestId":72500,"title":"Festival Afterword","description":"After the performance, you find Mamoru, who appears quite flustered indeed. Has he encountered some trouble?","titleTextMapHash":95975399,"descTextMapHash":1876225478,"mainQuestExcel":{"mainQuestId":72500,"titleTextMapHash":95975399,"title":"Festival Afterword","descTextMapHash":1876225478,"description":"After the performance, you find Mamoru, who appears quite flustered indeed. Has he encountered some trouble?","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":5072,"luaPath":"Actor/Quest/WQ72500","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5072,"chapterId":0,"descTextMapHash":1876225478,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72500,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3472050401,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72500","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":95975399,"type":"WQ","unlockDescTextMapHash":4211522942}},"flow":[{"subQuestId":7250001,"order":1,"stepDescription":"Talk to Mamoru","stepDescTextMapHash":751444892,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7250001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7250001_N12278","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7250001],"talks":[{"talkId":7250001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7250001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7250001,"initDialog":725000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30189,30190,30188],"performCfg":"QuestDialogue/WQ/MusicGameGuide_72500/Q7250001","priority":5,"questId":72500,"showRandomTalkCount":0},"dialogs":[{"nodeId":725000101,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":2802107186,"text":"Bad news!","nextNodeIds":[725000102]},{"nodeId":725000102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3293167578,"text":"What happened?","nextNodeIds":[725000103]},{"nodeId":725000103,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":1822818570,"text":"Boss got arrested again!","nextNodeIds":[725000104]},{"nodeId":725000104,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":622947434,"text":"Just now, someone from the Tenryou Commission came to post a notice on the bulletin board saying our festival has to be suspended.","nextNodeIds":[725000105]},{"nodeId":725000105,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":3279544170,"text":"I don't know what happened. I think maybe the boss sent some flyers to Tenshukaku.","nextNodeIds":[725000106]},{"nodeId":725000106,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":3877140914,"text":"He did say that the Shogun would definitely not wanna miss the Almighty Arataki Great and Glorious Drumalong Festival, after all!","nextNodeIds":[725000107]},{"nodeId":725000107,"roleType":"TALK_ROLE_NPC","speakerId":30190,"speakerName":"Akira","textMapHash":3017351002,"text":"Hmm... Well, I think Boss is right. The Almighty Shogun would definitely wanna come to the festival.","nextNodeIds":[725000108]},{"nodeId":725000108,"roleType":"TALK_ROLE_NPC","speakerId":30188,"speakerName":"Genta","textMapHash":4103319202,"text":"Yeah... don't you agree?","nextNodeIds":[725000109]},{"nodeId":725000109,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":3911235514,"text":"Come on, who cares what we think?","nextNodeIds":[725000110]},{"nodeId":725000110,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":3303667850,"text":"Anyway, the boss was arrested on the spot by the Okuzumeshuu. They took him to the Tenryou Commission.","nextNodeIds":[725000111]},{"nodeId":725000111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1829601274,"text":"What are you going to do?","nextNodeIds":[725000112]},{"nodeId":725000112,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":1340709186,"text":"Shinobu's probably on the case by now.","nextNodeIds":[725000113]},{"nodeId":725000113,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":2042851762,"text":"I heard the Okuzumeshuu charged the boss with causing a disturbance in a restricted military zone.","nextNodeIds":[725000114]},{"nodeId":725000114,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":1427772178,"text":"Then Madam Kujou Sara changed it to obstructing the public order.","nextNodeIds":[725000115]},{"nodeId":725000115,"roleType":"TALK_ROLE_NPC","speakerId":30188,"speakerName":"Genta","textMapHash":1670356610,"text":"Ahhhhh, that despicable Kujou Tengu! How can she get away with charging Boss with a felony over something like this!","nextNodeIds":[725000116]},{"nodeId":725000116,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":879140002,"text":"You idiot! That's a misdemeanor, she downgraded the offense. Usually, you just get a warning for that...","nextNodeIds":[725000117]},{"nodeId":725000117,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":3196974178,"text":"Anyway, I guess we'll just have to wait until the boss gets out before seeing what to do about the festival.","nextNodeIds":[725000118]},{"nodeId":725000118,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":147783410,"text":"Don't worry, Traveler. With Shinobu on the case, everything's gonna turn out just fine.","nextNodeIds":[725000119]},{"nodeId":725000119,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":4237791178,"text":"You've been so supportive of our festival. When the boss gets out, I'm sure he'll want to thank you in person!","nextNodeIds":[725000120]},{"nodeId":725000120,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":2155657210,"text":"I hope your journey, like our festival, will go from strength to strength.","nextNodeIds":[725000121]},{"nodeId":725000121,"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","textMapHash":378374522,"text":"From strength to strength!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7250001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7250001_N12278","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7250001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30189,"speakerName":"Mamoru","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2},{"roleType":"TALK_ROLE_NPC","speakerId":30188,"speakerName":"Genta","count":2},{"roleType":"TALK_ROLE_NPC","speakerId":30190,"speakerName":"Akira","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1876225478,"CHECNJEMEFE":{},"CJP