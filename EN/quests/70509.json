PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050902,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,40],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1045"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7050903,"order":5,"stepDescription":"Give the drink to Shenhe","stepDescTextMapHash":3280895356,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1045"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7050902],"talks":[{"talkId":7050902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7050903","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7050902,"initDialog":705090201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1045],"performCfg":"QuestDialogue/WQ/Mengde_70509/Q7050902","priority":5,"questId":70509,"showRandomTalkCount":0},"dialogs":[{"nodeId":705090201,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":2254272082,"text":"Hmm, it's sweet and smooth. Not bitter at all. What is it?","nextNodeIds":[705090202]},{"nodeId":705090202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3275937970,"text":"It's called a Snow-Covered Kiss! Whisk milk until it froths, and then gently pour it over some juice. It looks like it's covered by a layer of snow.","nextNodeIds":[705090203]},{"nodeId":705090203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1001664330,"text":"Don't ask why it's called a kiss, though... Paimon doesn't get it either. It's probably just a gimmick to get it to sell better!","nextNodeIds":[705090204]},{"nodeId":705090204,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":4141686210,"text":"A gimmick?","nextNodeIds":[705090205]},{"nodeId":705090205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2135716586,"text":"Uh, Paimon's just guessing... Maybe it's more of a romantic description!","nextNodeIds":[705090206]},{"nodeId":705090206,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":775488450,"text":"Romantic?","nextNodeIds":[705090207]},{"nodeId":705090207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3211116594,"text":"Uhh... It's hard to explain! Stop making Paimon come up with things.","nextNodeIds":[705090208,705090209]},{"nodeId":705090208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":727575850,"text":"The milky foam doesn't have much taste to it...","nextNodeIds":[705090210]},{"nodeId":705090210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1205394202,"text":"Mm-hmm, that's right.","nextNodeIds":[705090211,705090212]},{"nodeId":705090211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1011997114,"text":"The moment you taste the sweetness of the juice...","nextNodeIds":[705090213]},{"nodeId":705090213,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":2591664978,"text":"...Oh.","nextNodeIds":[705090214]},{"nodeId":705090214,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":3963245858,"text":"I see. I seem to understand now.","nextNodeIds":[705090215]},{"nodeId":705090215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1132711938,"text":"Oh? Really?","nextNodeIds":[705090216]},{"nodeId":705090216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1176214306,"text":"But wait, why is Paimon the one who's confused now!?","nextNodeIds":[705090217]},{"nodeId":705090217,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":2094825946,"text":"Occasionally, I chew on divine herbs as I wander about in the mountains. I have witnessed the moment a new sprout breaks through the soil.","nextNodeIds":[705090218]},{"nodeId":705090218,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":1699664682,"text":"The elation in my heart then does bear a resemblance to what I'm experiencing now.","nextNodeIds":[705090219]},{"nodeId":705090219,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":2494990122,"text":"#Thank you for helping me understand these obscure names, {NICKNAME}.","nextNodeIds":[705090220]},{"nodeId":705090220,"roleType":"TALK_ROLE_NPC","speakerId":1045,"speakerName":"Shenhe","textMapHash":2503121242,"text":"I might need your help again sometime in the future.","nextNodeIds":[]},{"nodeId":705090212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1774246922,"text":"Like a sprout pushing through the ice to give you a kiss...","nextNodeIds":[705090213]},{"nodeId":705090209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":984893442,"text":"It's kind of like snow on the mountains...","nextNodeIds":[705090210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,50],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[{"LNHLPKELCAL":["1068","201068004"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["1068","201068005"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_IND