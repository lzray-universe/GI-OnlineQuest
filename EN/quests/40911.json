:"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1587"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4091104],"talks":[{"talkId":4091104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4091104","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":4091104,"initDialog":409110401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1587],"performCfg":"QuestDialogue/EQ/Crucible1_4091101/Q4091104","priority":5,"questId":40911,"showRandomTalkCount":0},"dialogs":[{"nodeId":409110401,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3916542886,"text":"Just need to activate it a few more times...","nextNodeIds":[409110402]},{"nodeId":409110402,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3801937478,"text":"Traveler! Just who I wanted to see. Do you remember that Elemental Crucible I made?","nextNodeIds":[409110403]},{"nodeId":409110403,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2161364662,"text":"After you activated it, I was able to gather a fair bit of data from the sidelines.","nextNodeIds":[409110404]},{"nodeId":409110404,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2861285142,"text":"Most importantly, I was able to determine its reliability.","nextNodeIds":[409110405]},{"nodeId":409110405,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":4075923750,"text":"With such reliable apparatus, we will be able to perform even more experiments from now on.","nextNodeIds":[409110406]},{"nodeId":409110406,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3642628862,"text":"If you're willing to help, Traveler, could you help me activate the Elemental Crucible once more?","nextNodeIds":[409110407,409110409]},{"nodeId":409110407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":789395022,"text":"Gotcha.","nextNodeIds":[409110408]},{"nodeId":409110408,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2143043534,"text":"Many thanks.","nextNodeIds":[]},{"nodeId":409110409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1599550246,"text":"How many experiments would you like to conduct?","nextNodeIds":[409110410]},{"nodeId":409110410,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1376135918,"text":"The more the merrier, of course. For a Vision-less alchemist like myself, these brute-force measures are the only way I can do research...","nextNodeIds":[409110411]},{"nodeId":409110411,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2594702590,"text":"So please help me activate the Elemental Crucible again. I'll be in your debt, Traveler.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4091104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":"