{"mainQuestId":40911,"title":"One Giant Step for Alchemy?","description":"In an effort to hone his alchemical skills, Timaeus has designed an all-new alchemical furnace. There's just one problem — he needs some help to get it working...","titleTextMapHash":3142834945,"descTextMapHash":1782013943,"mainQuestExcel":{"mainQuestId":40911,"titleTextMapHash":3142834945,"title":"One Giant Step for Alchemy?","descTextMapHash":1782013943,"description":"In an effort to hone his alchemical skills, Timaeus has designed an all-new alchemical furnace. There's just one problem — he needs some help to get it working...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/EQ40911","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":1782013943,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":40911,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":570331343,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/EQ40911","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[490014],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3142834945,"type":"EQ","unlockDescTextMapHash":2349982699}},"flow":[{"subQuestId":4091101,"order":1,"stepDescription":"Meet Timaeus in Mondstadt","stepDescTextMapHash":4159029086,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4091101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1587"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4091101],"talks":[{"talkId":4091101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4091101","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":4091101,"initDialog":409110101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1587],"performCfg":"QuestDialogue/EQ/Crucible1_4091101/Q4091101","priority":5,"questId":40911,"showRandomTalkCount":0},"dialogs":[{"nodeId":409110102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3331179590,"text":"What is it?","nextNodeIds":[409110103]},{"nodeId":409110101,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":557042166,"text":"...Traveler! Hi! Hold up a second...","nextNodeIds":[409110102]},{"nodeId":409110103,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":700404126,"text":"Okay, so... I'm sorry about this, but... there's something I really need your help with.","nextNodeIds":[409110104]},{"nodeId":409110104,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3852172790,"text":"As you know, I've never made much progress in my alchemical studies...","nextNodeIds":[409110105]},{"nodeId":409110105,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3382997382,"text":"Well, I've realized that I can't keep trying the same things over and over again. Clearly, that approach is getting me nowhere.","nextNodeIds":[409110106]},{"nodeId":409110107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1607832798,"text":"You're switching to bio-alchemy?","nextNodeIds":[409110108]},{"nodeId":409110109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":525013414,"text":"You're going back to the origins of the art?","nextNodeIds":[409110110]},{"nodeId":409110106,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3740582262,"text":"So, I decided I'd change focus. Take a fresh approach. Attempt something that's not been done before...","nextNodeIds":[409110107,409110109]},{"nodeId":409110108,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":564171838,"text":"There's nothing particularly new about bio-alchemy. There are already people researching that.","nextNodeIds":[409110111]},{"nodeId":409110110,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":709959542,"text":"You mean study the alchemical arts of the ancients? No, that's not something I'd be able to get involved in...","nextNodeIds":[409110111]},{"nodeId":409110111,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":215483462,"text":"Do you know what the most important factor in alchemy is? It's the elements.","nextNodeIds":[409110112]},{"nodeId":409110112,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3057510518,"text":"For a number of reasons, alchemy is mostly performed using items infused with elemental energy, rather than pure elemental energy itself.","nextNodeIds":[409110113]},{"nodeId":409110113,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":88090966,"text":"Naturally, this introduces impurities into the transmutation process, making the elemental reactions less effective...","nextNodeIds":[409110114]},{"nodeId":409110114,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":625525270,"text":"To compensate, we must use larger quantities of elemental materials. Even then, we still need to be very hands-on during the transmutation process, as the impurities can easily ruin the outcome.","nextNodeIds":[409110115]},{"nodeId":409110115,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":4213042542,"text":"Unfortunately, this all creates extra costs for those who wish to perform alchemy without using Visions.","nextNodeIds":[409110116]},{"nodeId":409110116,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":336635950,"text":"The biggest issue is that items infused with elemental energy do not come cheap.","nextNodeIds":[409110117]},{"nodeId":409110117,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3247496798,"text":"The bill for the average transmutation is more astonishing than the fruits of our labor...","nextNodeIds":[409110118]},{"nodeId":409110119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3673617238,"text":"I don't have a Vision, either.","nextNodeIds":[409110120]},{"nodeId":409110121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4227619998,"text":"So, what do you need me to do?","nextNodeIds":[409110122]},{"nodeId":409110118,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1357723630,"text":"*sigh* Maybe this is why I've never made any tangible progress. The barrier to entry is just too high...","nextNodeIds":[409110119,409110123]},{"nodeId":409110120,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1637763614,"text":"True... But I hear you can still manipulate elemental energy, correct?","nextNodeIds":[409110123]},{"nodeId":409110122,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1863329390,"text":"I've heard you can manipulate elemental energy even though you don't have a Vision. Is that right?","nextNodeIds":[409110123]},{"nodeId":409110123,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":4094083782,"text":"Here's the thing: I've come up with a new kind of alchemical furnace which I call the <color=#00E1FFFF>Elemental Crucible</color>. The idea behind it is...","nextNodeIds":[409110124]},{"nodeId":409110124,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":872226614,"text":"Well, basically, it's a vessel that can hold pure elemental energy and generate elemental reactions.","nextNodeIds":[409110125]},{"nodeId":409110125,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3971907262,"text":"With any luck, the Elemental Crucible will be the thing that takes my alchemical skills to the next level...","nextNodeIds":[409110126]},{"nodeId":409110126,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1910918022,"text":"Everything is set up and ready to go. All I'm missing now is someone with the ability to actually move the pure elemental energy around.","nextNodeIds":[409110127]},{"nodeId":409110127,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2517875710,"text":"If you're willing to help out, please meet me at the <color=#00E1FFFF>Thousand Winds Temple</color>. That's where I had some people set everything up.","nextNodeIds":[409110128]},{"nodeId":409110128,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1874617214,"text":"I really hope this will be my big breakthrough in alchemy...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4091101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["5001","500103"],"PAINLIBBLDK":"QUEST_EXEC_ACTIVE_ACTIVITY_COND_STATE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1587"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4091102,"order":2,"stepDescription":"Go to the Thousand Winds Temple","stepDescTextMapHash":536428710,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4091102,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4091103Timaeus","60"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4091102,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHED