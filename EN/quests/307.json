:3071109,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":4045546155,"text":"As bustling as it may be — no, I can't imagine it will be dangerous at all.","nextNodeIds":[3071112]},{"nodeId":3071112,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2535085651,"text":"It's a pity that the Temple of the Wolf has been disturbed by such an atrocity.","nextNodeIds":[3071113]},{"nodeId":3071113,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3890856531,"text":"#Let's head in, {NICKNAME}.","nextNodeIds":[3071114]},{"nodeId":3071114,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1008203083,"text":"No one makes offerings to The Four Winds anymore, yet the old winds never vanish...","nextNodeIds":[3071115]},{"nodeId":3071115,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3688877707,"text":"We need to clear out the temples, for The Four Winds.","nextNodeIds":[]},{"nodeId":3071110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2724915883,"text":"No doubt nothing more than a disorderly mob of creatures.","nextNodeIds":[3071111]},{"nodeId":3071111,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2997438947,"text":"Oh, ho-ho! You're quite the brave one, aren't you!","nextNodeIds":[3071112]},{"nodeId":3071104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1809543163,"text":"It's the smell of burnt Pyro Slimes.","nextNodeIds":[3071105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[30711,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFD