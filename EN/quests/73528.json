NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30406"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352801],"talks":[{"talkId":7352801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7352801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352801,"initDialog":735280101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30406],"performCfg":"QuestDialogue/WQ/Sumeru_73528/Q7352801","priority":5,"questId":73528,"showRandomTalkCount":0},"dialogs":[{"nodeId":735280101,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":3857589410,"text":"Passing Travelers, I, Basima, Amurta researcher, beseech thee not to leave too hastily...","nextNodeIds":[735280102]},{"nodeId":735280102,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":2204034530,"text":"Please. Relax thy body, clear thy mind, and listen closely, for I have a matter of utmost importance to share with you—","nextNodeIds":[735280103]},{"nodeId":735280103,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":3267747234,"text":"Finches are the cutest!","nextNodeIds":[735280104]},{"nodeId":735280104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3674159522,"text":"?","nextNodeIds":[735280105]},{"nodeId":735280105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2630273882,"text":"?","nextNodeIds":[735280106]},{"nodeId":735280106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1978343922,"text":"Finches are definitely cute... But Miss Basima, you're a researcher, right? You should know saying something like that without any qualifications can lead to serious arguments!","nextNodeIds":[735280107]},{"nodeId":735280107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2728465146,"text":"Paimon thought that scholars spoke a bit more cautiously. Paimon would never say something like \"Golden Shrimp Balls are the most delicious food!\" if Paimon was a researcher.","nextNodeIds":[735280108]},{"nodeId":735280108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2367191490,"text":"Paimon would qualify her statement! Like, \"Among the Liyue cuisine Paimon's eaten lately, this is Paimon's favorite.\"","nextNodeIds":[735280109,735280110,735280111]},{"nodeId":735280109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":696545178,"text":"But I'm willing to say this no matter what!","nextNodeIds":[735280112]},{"nodeId":735280112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":503328322,"text":"#Wha— {NICKNAME}, that was really unexpected!","nextNodeIds":[735280113]},{"nodeId":735280113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1041592482,"text":"Even if it's not a joke, you shouldn't be so loud...","nextNodeIds":[735280114]},{"nodeId":735280114,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":1633768138,"text":"Hahaha, now that's the spirit!","nextNodeIds":[735280115]},{"nodeId":735280115,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":397967930,"text":"It is precisely because I am a researcher that I don't want my whole life to be like an academic debate, constantly worrying about the accuracy of every word that comes out of my mouth.","nextNodeIds":[735280116]},{"nodeId":735280116,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":1690719914,"text":"It's not like I'm under constant surveillance! Speaking carelessly won't get me punished, so why live in constant fear?","nextNodeIds":[735280117]},{"nodeId":735280117,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":3432790570,"text":"We should be brave, and shout out the most important feelings in our hearts as loud as we can for the world to hear!","nextNodeIds":[735280118]},{"nodeId":735280118,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":3440570922,"text":"Once you've tried my tabletop game \"Bing-Bang Finchball\", I'm sure you wouldn't hesitate to shout out \"Finches are the cutest!\"","nextNodeIds":[735280119]},{"nodeId":735280119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4109032274,"text":"Bing-bang... Finchball? You mean those things on the table behind you?","nextNodeIds":[735280120]},{"nodeId":735280120,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":1308233562,"text":"That's right, once you've played, you'll see for yourself just how adorable finches are!","nextNodeIds":[735280121]},{"nodeId":735280121,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":3062816666,"text":"Also, as an official amusement venue of the Veluriyam Mirage, you'll be able to get rewards based on your score!","nextNodeIds":[735280122]},{"nodeId":735280122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3548678906,"text":"She's made it sound so dramatic... but it worked! Paimon's getting really curious. Plus, there are rewards for playing!","nextNodeIds":[735280123]},{"nodeId":735280123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3681989258,"text":"#What do you think, {NICKNAME}?","nextNodeIds":[735280124,735280125]},{"nodeId":735280124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2606038834,"text":"Let's give it a go!","nextNodeIds":[735280126]},{"nodeId":735280126,"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","textMapHash":1700229946,"text":"Hahaha, now you're getting it! Enjoy the game!","nextNodeIds":[]},{"nodeId":735280125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2096824570,"text":"Let's see just how cute finches really are!","nextNodeIds":[735280126]},{"nodeId":735280110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1947857394,"text":"Paimon is the cutest!","nextNodeIds":[735280112]},{"nodeId":735280111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":443174962,"text":"Period!","nextNodeIds":[735280112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30406"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7352801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30406,"speakerName":"Basima","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173528],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":589882150,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73528/Q7352801","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":735280101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7352801,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30406],"KJLN