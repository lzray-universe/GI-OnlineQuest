{"mainQuestId":73525,"title":"Complex Cartography","description":"A visibly troubled adventurer from Liyue stands by the riverside in Sumeru. Is some kind of problem giving them grief...","titleTextMapHash":4005974791,"descTextMapHash":2671608358,"mainQuestExcel":{"mainQuestId":73525,"titleTextMapHash":4005974791,"title":"Complex Cartography","descTextMapHash":2671608358,"description":"A visibly troubled adventurer from Liyue stands by the riverside in Sumeru. Is some kind of problem giving them grief...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5140,"luaPath":"Actor/Quest/WQ73525","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5140,"chapterId":0,"descTextMapHash":2671608358,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73525,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3926606697,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73525","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173525],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4005974791,"type":"WQ","unlockDescTextMapHash":642515646}},"flow":[{"subQuestId":7352501,"order":1,"stepDescription":"Talk to the adventurer from Liyue","stepDescTextMapHash":307771076,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30402"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352501],"talks":[{"talkId":7352501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352501,"initDialog":735250101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30402],"performCfg":"QuestDialogue/WQ/Sumeru_73525/Q7352501","priority":5,"questId":73525,"showRandomTalkCount":0},"dialogs":[{"nodeId":735250101,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":332078762,"text":"Geez, I'll have to trouble Lan again... But it's not like I have a choice. There's simply too much work, and I'm only one person. How am I supposed to finish?","nextNodeIds":[735250102]},{"nodeId":735250102,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":4173059194,"text":"I have no choice but to delay the mapping submission again. If this goes on, my living expenses here in Sumeru will exceed the deposit for the commission...","nextNodeIds":[735250103]},{"nodeId":735250103,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":2701242010,"text":"B-But there's nothing more terrifying than Lan's rage... *sigh*...","nextNodeIds":[735250104]},{"nodeId":735250104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1711574426,"text":"Huh? What's an adventurer from Liyue doing over here...?","nextNodeIds":[735250105]},{"nodeId":735250105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":120762418,"text":"Hey! You! From the Adventurers' Guild!","nextNodeIds":[735250106]},{"nodeId":735250106,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":4293449626,"text":"Huh? What's wrong? Am I not allowed to rest by the river here?","nextNodeIds":[735250107]},{"nodeId":735250107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1254420306,"text":"No, no! Paimon's just curious...","nextNodeIds":[735250108]},{"nodeId":735250108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1600598426,"text":"An adventurer from Liyue in Sumeru...","nextNodeIds":[735250109]},{"nodeId":735250109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1745260282,"text":"It's really rare! And you even look super anxious, so we came over to ask if we could help!","nextNodeIds":[735250110]},{"nodeId":735250110,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":2727290738,"text":"I see. I'm Peixiu, and you are?","nextNodeIds":[735250111]},{"nodeId":735250111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1785120866,"text":"#Paimon is Paimon, and this is {NICKNAME}! So, Peixiu, what are you doing here in Sumeru...? Ah! Paimon knows! Did you get lost!?","nextNodeIds":[735250112]},{"nodeId":735250112,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":814469402,"text":"Ahahahaha! So the cute little one is Paimon! Hahaha, lost...","nextNodeIds":[735250113]},{"nodeId":735250113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2264139858,"text":"What's so funny!?","nextNodeIds":[735250114,735250115]},{"nodeId":735250114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2278162154,"text":"It's barely funny.","nextNodeIds":[735250116]},{"nodeId":735250116,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":935311714,"text":"...Under most circumstances, no, it wouldn't be funny. But asking a cartographer if he's lost is quite amusing.","nextNodeIds":[735250117]},{"nodeId":735250117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":914727362,"text":"C-Cartographer?","nextNodeIds":[735250118]},{"nodeId":735250118,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":732083714,"text":"Yes, we are responsible for surveying the landscape and updating older maps... It's one of the Adventurers' Guild's duties.","nextNodeIds":[735250119]},{"nodeId":735250119,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":749839354,"text":"I am one such cartographer, but...","nextNodeIds":[735250120]},{"nodeId":735250120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":914031666,"text":"But?","nextNodeIds":[735250121]},{"nodeId":735250121,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":472681698,"text":"I'm just an apprentice. I've completed some rough sketches, but there are tons of mistakes. I need to get to a shaded valley or tunnel to carry out a detailed survey.","nextNodeIds":[735250122]},{"nodeId":735250122,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":125547714,"text":"Ugh, this is killing me. The terrain here in Sumeru is so complex, and there are so many roads and caves too. Sometimes, I wonder if the entire mountain is hollow...","nextNodeIds":[735250123]},{"nodeId":735250123,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":3547010794,"text":"Progress is just way too slow... *sigh* I don't know the terrain as well as the locals do.","nextNodeIds":[735250124]},{"nodeId":735250124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3991264634,"text":"Huh? Then why don't you get a local adventurer to do it?","nextNodeIds":[735250125]},{"nodeId":735250125,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":3829299698,"text":"Er, it's actually a joint project between the Sumeru and Liyue branches of the Adventurers' Guild, and a completed map will be provided to those who trade or venture between the two.","nextNodeIds":[735250126]},{"nodeId":735250126,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":3951102778,"text":"It was entrusted to the Liyue branch because the Adventurer who was supposed to be in charge had cartographic experience, and her reputation is that of absolute reliability.","nextNodeIds":[735250127]},{"nodeId":735250127,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":1392385426,"text":"Supposedly, she already did something similar in Qiaoying Village. All it took was a single glance for her to know all the terrain inside and out, and her maps were very precise too.","nextNodeIds":[735250128]},{"nodeId":735250128,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":3659856354,"text":"But she left for some mining area. Uh, did she go to the Chasm or Blackcliff Forge...","nextNodeIds":[735250129]},{"nodeId":735250129,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":972657034,"text":"Anyway, once we laid eyes on her map, we all felt ashamed of our own skills. The adventurers who used her map praised it to the skies!","nextNodeIds":[735250130]},{"nodeId":735250130,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":1246078490,"text":"I can't compete with that... I may have drawn a map, but there are too many omissions, and surveying everything again will take too long...","nextNodeIds":[735250131]},{"nodeId":735250131,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":2571927650,"text":"*sigh* I'm a stranger in a strange land. I may have the support of Sumeru's Adventurers' Guild, but I'm just not efficient enough. If this goes on much longer, the deposit I received won't even be able to cover my travel expenses.","nextNodeIds":[735250132]},{"nodeId":735250132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":866887994,"text":"Ugh, that sounds awful.","nextNodeIds":[735250133]},{"nodeId":735250133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2975842194,"text":"We don't really know much about cartography though... Maybe Paimon can help mark where you can find delicious food on your map instead?","nextNodeIds":[735250134]},{"nodeId":735250134,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":3832179370,"text":"Haha! That's a great idea! A map showing all the best local cuisine would definitely be popular!","nextNodeIds":[735250135]},{"nodeId":735250135,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":3935280210,"text":"But... well, my remaining work doesn't really require drawing the map. What's left is a final survey to verify the map's accuracy...","nextNodeIds":[735250136]},{"nodeId":735250136,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":201947178,"text":"There are a few dangerous locations surrounded by difficult terrain that I haven't been able to get to.","nextNodeIds":[735250137]},{"nodeId":735250137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":881559410,"text":"Oh, if that's all...","nextNodeIds":[735250138]},{"nodeId":735250138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1264449162,"text":"That doesn't sound very difficult...","nextNodeIds":[735250139]},{"nodeId":735250139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4064612482,"text":"Yeah, maybe we can help!","nextNodeIds":[735250140]},{"nodeId":735250140,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":1574434402,"text":"But most of these locations are really dangerous! There may even be monsters roaming around.","nextNodeIds":[735250141]},{"nodeId":735250141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3079035546,"text":"That's exactly why you should leave it to us!","nextNodeIds":[735250142]},{"nodeId":735250142,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":3772187602,"text":"R-Really...? With your help, it feels like I'll be done in no time! I may even make the deadline...","nextNodeIds":[735250143]},{"nodeId":735250143,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":138717002,"text":"Most importantly, supplying travelers with an updated map will help prevent them from getting led somewhere deserted or dangerous by the old map!","nextNodeIds":[735250144]},{"nodeId":735250144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":711309050,"text":"Sounds great! Hehe, but we'll only help you on one condition! And that is that you have to mail us a copy of your food map once you're done making it!","nextNodeIds":[735250145]},{"nodeId":735250145,"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","textMapHash":4192283594,"text":"Hahaha! But of course! However, this map has to be verified before any of that can happen! It's all up to you now!","nextNodeIds":[]},{"nodeId":735250115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1306987130,"text":"A three out of five...","nextNodeIds":[735250116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30402"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7352501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30402,"speakerName":"Peixiu","count":26},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[1735