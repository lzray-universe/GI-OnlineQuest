xtNodeIds":[220130407]},{"nodeId":220130407,"roleType":"TALK_ROLE_NPC","speakerId":3021,"speakerName":"Hasegawa","textMapHash":1034138378,"text":"Although it's called an \"awakening,\" it just seems cheap.","nextNodeIds":[220130408]},{"nodeId":220130408,"roleType":"TALK_ROLE_NPC","speakerId":3021,"speakerName":"Hasegawa","textMapHash":1233851074,"text":"I just think this kind of cheap plot makes the character look cheap too. I really hope the author reconsiders this course...","nextNodeIds":[220130409]},{"nodeId":220130409,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":4247970866,"text":"Traveler, let's... let's go ask someone else...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3032","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2201304,"order":4,"stepDescription":"Ask for Rie's opinion","stepDescTextMapHash":1738805916,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3032","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAI