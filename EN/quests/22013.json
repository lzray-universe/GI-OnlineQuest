alks":[],"npcId":[3033,3032],"performCfg":"","priority":5,"questId":22013,"showRandomTalkCount":0},"dialogs":[{"nodeId":220130101,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":2771402034,"text":"Have you read the reader feedback? Our reviews have been plummeting lately!","nextNodeIds":[220130102]},{"nodeId":220130102,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3014709114,"text":"Don't worry. This is just the calm before the grand climax!","nextNodeIds":[220130103]},{"nodeId":220130103,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2223231234,"text":"When the key plot point gets revealed, we'll see a real turnaround in those reviews!","nextNodeIds":[220130104]},{"nodeId":220130104,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":489532210,"text":"And what good is that if your novel gets axed long before you get there?","nextNodeIds":[220130105]},{"nodeId":220130105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":291548394,"text":"What's going on?","nextNodeIds":[220130106]},{"nodeId":220130106,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":2109561514,"text":"Traveler, thank goodness you're here.","nextNodeIds":[220130107]},{"nodeId":220130107,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1957070410,"text":"Junkichi has been adding a lot more wild abilities to the main character, in \"Onibudou.\" It's just been one thing after another ever since that \"inspiration trip\" of his.","nextNodeIds":[220130108]},{"nodeId":220130108,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":4011889778,"text":"Yae Publishing House has received a lot of negative feedback from readers who say they don't understand why these abilities are appearing. They think that the author isn't taking the story seriously.","nextNodeIds":[220130109]},{"nodeId":220130109,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2139415458,"text":"They don't know what they're talking about. I'll just keep writing, they'll get it at some point...","nextNodeIds":[220130110]},{"nodeId":220130110,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1363132938,"text":"Like I was saying, your novel will get axed before you can get to that point!","nextNodeIds":[220130111]},{"nodeId":220130111,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":2854858130,"text":"Oh, whatever... From what I recall, there are a few readers of \"Onibudou\" around this area...","nextNodeIds":[220130112]},{"nodeId":220130112,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1142196282,"text":"Why don't you go and ask them if your idea has legs or not?","nextNodeIds":[220130113]},{"nodeId":220130113,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":323071250,"text":"Fine! I'm sure they'll get it, anyway. Traveler, come with me. I'll need a witness!","nextNodeIds":[220130114]},{"nodeId":220130114,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1687684458,"text":"Yes, that sounds good. Bring the Traveler with you. That way, you can't deny what they say later.","nextNodeIds":[220130115]},{"nodeId":220130115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3768789970,"text":"Let's do this.","nextNodeIds":[220130116]},{"nodeId":220130116,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3283642618,"text":"Okay, let's get going. I'm sure my readers will understand me!","nextNodeIds":[220130117]},{"nodeId":220130117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1947335010,"text":"How much feature creep is there, anyway?","nextNodeIds":[220130118]},{"nodeId":220130118,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3007509578,"text":"Just... just a bit.","nextNodeIds":[220130119]},{"nodeId":220130119,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1339948018,"text":"\"A bit\"? The main character will soon have more abilities than every other character in the story combined!","nextNodeIds":[220130120]},{"nodeId":220130120,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3829850402,"text":"Ahem! Let's get going. I'm sure my readers get it!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3032","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2201302,"order":2,"stepDescription":"Ask for Yuzu's opinion","stepDescTextMapHash":3304488372,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3032","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2201302