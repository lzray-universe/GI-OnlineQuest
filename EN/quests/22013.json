s":[220130502]},{"nodeId":220130502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":746559306,"text":"Indeed. Have you read \"Onibudou,\" by any chance?","nextNodeIds":[220130503]},{"nodeId":220130503,"roleType":"TALK_ROLE_NPC","speakerId":3024,"speakerName":"Rie","textMapHash":2766409162,"text":"I have. I like the main character a lot, too.","nextNodeIds":[220130504]},{"nodeId":220130504,"roleType":"TALK_ROLE_NPC","speakerId":3024,"speakerName":"Rie","textMapHash":2397077434,"text":"But I've been having a hard time reading it lately...","nextNodeIds":[220130505]},{"nodeId":220130505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3745590994,"text":"A hard time?","nextNodeIds":[220130506]},{"nodeId":220130506,"roleType":"TALK_ROLE_NPC","speakerId":3024,"speakerName":"Rie","textMapHash":3185213418,"text":"In the last few chapters, the main character was suddenly bestowed with all these new abilities.","nextNodeIds":[220130507]},{"nodeId":220130507,"roleType":"TALK_ROLE_NPC","speakerId":3024,"speakerName":"Rie","textMapHash":3454342434,"text":"The story spends a lot of time talking about how those abilities were awakened and how they can be used.","nextNodeIds":[220130508]},{"nodeId":220130508,"roleType":"TALK_ROLE_NPC","speakerId":3024,"speakerName":"Rie","textMapHash":474126682,"text":"And the names of those abilities are getting harder and harder to follow. I can't remember any of them.","nextNodeIds":[220130509]},{"nodeId":220130509,"roleType":"TALK_ROLE_NPC","speakerId":3024,"speakerName":"Rie","textMapHash":594025314,"text":"If I keep reading, I don't think I will be able to follow the story without understanding these abilities.","nextNodeIds":[220130510]},{"nodeId":220130510,"roleType":"TALK_ROLE_NPC","speakerId":3024,"speakerName":"Rie","textMapHash":1378437530,"text":"*sigh* I was thinking of giving the book a rest and switching to something a little easier to follow.","nextNodeIds":[220130511]},{"nodeId":220130511,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1252694706,"text":"Uh... Let's...","nextNodeIds":[220130512]},{"nodeId":220130512,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2602936986,"text":"Let's head back...","nextNodeIds":[220130513]},{"nodeId":220130513,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3864037186,"text":"Okay... I don't get why this is happening...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3032","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2201305,"order":5,"stepDescription":"Report the results to Shigeru","stepDescTextMapHash":883879772,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201306,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3033"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2201306],"talks":[{"talkId":2201306,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2201305","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2201306,"initDialog":220130601,"nextRandomTalks":[],"nextTalks":[],"npcId":[3033,3032],"performCfg":"QuestDialogue/IQ/Inazuma_22013/Q2201306","priority":5,"questId":22013,"showRandomTalkCount":0},"dialogs":[{"nodeId":220130601,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1741090914,"text":"Alright then, how did it turn out? Did you get the readers'...","nextNodeIds":[220130602]},{"nodeId":220130602,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":3474112122,"text":"...Wait, why does he look so depressed... what kind of feedback did you get?","nextNodeIds":[220130603]},{"nodeId":220130603,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":3042197458,"text":"*sigh*... So, Junkichi, will you accept the feedback now?","nextNodeIds":[220130604]},{"nodeId":220130604,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":28112514,"text":"I can't believe it... How did this happen...","nextNodeIds":[220130605]},{"nodeId":220130605,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2155619346,"text":"Are my ideas... and my writing... not interesting enough?","nextNodeIds":[220130606]},{"nodeId":220130606,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1391214626,"text":"As I said, advancing the plot purely by giving the character new powers can be dangerous...","nextNodeIds":[220130607]},{"nodeId":220130607,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":2429180762,"text":"The new traits might be momentarily popular, but as soon as the novelty wears off, the readers will get bored.","nextNodeIds":[220130608]},{"nodeId":220130608,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":715836714,"text":"This is years of experience talking, you know.","nextNodeIds":[220130609]},{"nodeId":220130609,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":848342946,"text":"I—I know...","nextNodeIds":[220130610]},{"nodeId":220130610,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":2146241666,"text":"It's not too late to change it, though... We can't reverse the reviews of the previous chapters, but we can get the following chapters back on solid footing...","nextNodeIds":[220130611]},{"nodeId":220130611,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shige