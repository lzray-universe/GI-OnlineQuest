{"mainQuestId":22013,"title":"This Novel Seems... Problematic?","description":"Shigeru, an editor at the Yae Publishing House, seems to be facing an unprecedented crisis.","titleTextMapHash":4073616527,"descTextMapHash":2382481062,"mainQuestExcel":{"mainQuestId":22013,"titleTextMapHash":4073616527,"title":"This Novel Seems... Problematic?","descTextMapHash":2382481062,"description":"Shigeru, an editor at the Yae Publishing House, seems to be facing an unprecedented crisis.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ22013","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2382481062,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":22013,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1965846489,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ22013","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":41020,"titleTextMapHash":4073616527,"type":"IQ","unlockDescTextMapHash":2480855230}},"flow":[{"subQuestId":2201301,"order":1,"stepDescription":"Visit Shigeru and Junkichi","stepDescTextMapHash":1335179340,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QU