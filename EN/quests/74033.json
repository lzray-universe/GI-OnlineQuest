 tinkered with the drive valve and trapped their own companion.","nextNodeIds":[740330103]},{"nodeId":740330103,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":1855448666,"text":"Anyway, let's get it to open up the passage to <color=#00E1FFFF>Supply Warehouse 1</color>. By the way, if they offer you a drink, you'd best say no.","nextNodeIds":[740330104]},{"nodeId":740330104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2093855914,"text":"Who's going to offer us a drink? And why won't we take it?","nextNodeIds":[740330105]},{"nodeId":740330105,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":320995266,"text":"You'll find out soon enough.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7403305,"order":3,"stepDescription":"Operate the drive valve to open access to Supply Warehouse 1","stepDescTextMapHash":2146349124,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7403305"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","