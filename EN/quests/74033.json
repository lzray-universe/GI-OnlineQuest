_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_4529:4594.517,-46.380,4592.511]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7403304,"order":5,"stepDescription":"Talk to the trapped person","stepDescTextMapHash":3895630428,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21076"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7403304],"talks":[{"talkId":7403304,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7403304","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7403304,"initDialog":740330401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21048,21076],"performCfg":"QuestDialogue/Q7403304","priority":5,"questId":74033,"showRandomTalkCount":0},"dialogs":[{"nodeId":740330401,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":437915978,"text":"Mitul, are you alright? I hope you weren't trapped for too long.","nextNodeIds":[740330402]},{"nodeId":740330402,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":179104322,"text":"My savior! You're finally here!","nextNodeIds":[740330403]},{"nodeId":740330403,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":1558762146,"text":"Where's Koblenz? He's not with you?","nextNodeIds":[740330404]},{"nodeId":740330404,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":386726922,"text":"He told me about trapping you here and asked for my help, but he left because a guard interrupted us.","nextNodeIds":[740330405]},{"nodeId":740330405,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":634737986,"text":"I knew he wasn't reliable! He probably ran away because he felt guilty.","nextNodeIds":[740330406]},{"nodeId":740330406,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":4195305170,"text":"I mean, how do you make money in business if you don't take risks?","nextNodeIds":[740330407]},{"nodeId":740330407,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":2029486026,"text":"He was clumsy, and too cautious, to boot... I mean, Pure Water is one thing, but even Fonta is available nowadays.","nextNodeIds":[740330408]},{"nodeId":740330408,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":3084262730,"text":"If Fonta is here, how are we supposed to survive?","nextNodeIds":[740330409]},{"nodeId":740330409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2484625930,"text":"Oh...","nextNodeIds":[740330410]},{"nodeId":740330410,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":3773004442,"text":"What, you like Fonta too?","nextNodeIds":[740330411,740330413]},{"nodeId":740330411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":418454362,"text":"Don't you like Fonta?","nextNodeIds":[740330412]},{"nodeId":740330412,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":1756857642,"text":"I do! I have to admit, it's a formidable rival...","nextNodeIds":[740330415]},{"nodeId":740330415,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":3990684690,"text":"Anyway, I have to settle this with Koblenz. By the way, has he paid you?","nextNodeIds":[740330416]},{"nodeId":740330416,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3017477834,"text":"Nope.","nextNodeIds":[740330417]},{"nodeId":740330417,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":2886291370,"text":"...Sometimes I want to stuff him in a large bucket. That'll make him reflect on what he's done. Anyway, please take these Coupons.","nextNodeIds":[740330418]},{"nodeId":740330418,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":627101042,"text":"Take them, you two, if you would.","nextNodeIds":[740330419]},{"nodeId":740330419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1663964586,"text":"What? You want us to take all of it?","nextNodeIds":[740330420]},{"nodeId":740330420,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":3290725410,"text":"Of course.","nextNodeIds":[740330421]},{"nodeId":740330421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3732399762,"text":"Thank you, then. We can go to the Rag and Bone Shop later to see if they have anything new.","nextNodeIds":[740330422]},{"nodeId":740330422,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":1871481834,"text":"By the way, I'd like to apologize for dragging you into this. I have some fresh health drinks — would you like a bottle?","nextNodeIds":[740330423]},{"nodeId":740330423,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3972883610,"text":"Fresh... health drinks?","nextNodeIds":[740330424]},{"nodeId":740330424,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":2109374858,"text":"Yup! Healthier than Pure Water, in fact!","nextNodeIds":[740330425,740330428]},{"nodeId":740330425,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1577289690,"text":"I'll take one.","nextNodeIds":[740330426]},{"nodeId":740330426,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3998789354,"text":"(Hey, didn't Caterpillar tell you to not take one?)","nextNodeIds":[740330427]},{"nodeId":740330427,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4118604122,"text":"#No, {NICKNAME} didn't mean it! We already had a lot of drinks before coming here.","nextNodeIds":[740330431]},{"nodeId":740330431,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2330239858,"text":"But Paimon bets these drinks are good! We'll make sure to try one next time.","nextNodeIds":[740330432]},{"nodeId":740330432,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":1924908130,"text":"Bad timing, huh? Well, come back when you get a chance. It'll be my treat!","nextNodeIds":[740330433]},{"nodeId":740330433,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":3413812474,"text":"Anyway, I must go talk to Koblenz now.","nextNodeIds":[740330434]},{"nodeId":740330434,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","textMapHash":765517826,"text":"I have something else to take care of, so I need to get going. Don't worry too much about the Coupons. <color=#00E1FFFF>I'll put the clues I come across on the blackboard</color>. Let's meet up later.","nextNodeIds":[740330435]},{"nodeId":740330435,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1438308394,"text":"See you later!","nextNodeIds":[]},{"nodeId":740330428,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2350475458,"text":"I'll have a Fonta, please.","nextNodeIds":[740330429]},{"nodeId":740330429,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":87845946,"text":"Well, I have that, too. Wait. Do you have a problem with my healthy drinks? Let me tell you...","nextNodeIds":[740330430]},{"nodeId":740330430,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3379227034,"text":"#That's not what {NICKNAME} meant! It's just that we... had lots of drinks before coming here.","nextNodeIds":[740330431]},{"nodeId":740330413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1166074954,"text":"It's just about alright.","nextNodeIds":[740330414]},{"nodeId":740330414,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","textMapHash":2455272690,"text":"A customer with taste, I see.","nextNodeIds":[740330415]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133408795"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["74025","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21076"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7403301,7403304],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"Mitul","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"Caterpillar","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174033],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3335790246,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[74025],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/Q7403301","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNF