{"mainQuestId":71039,"title":"Valor's Afterglow: The Faint Light Remembered","description":"Zhiqiong seems to have left the exploration team to explore on her own. Still, it's too dangerous to go alone into The Chasm, so she must be found...","titleTextMapHash":2465890159,"descTextMapHash":485183102,"mainQuestExcel":{"mainQuestId":71039,"titleTextMapHash":2465890159,"title":"Valor's Afterglow: The Faint Light Remembered","descTextMapHash":485183102,"description":"Zhiqiong seems to have left the exploration team to explore on her own. Still, it's too dangerous to go alone into The Chasm, so she must be found...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ71039","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":485183102,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71039,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1032540081,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71039","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171039],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2465890159,"type":"WQ","unlockDescTextMapHash":3872394862}},"flow":[{"subQuestId":7103901,"order":1,"stepDescription":"","stepDescTextMapHash":386421028,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[71038,0],"PAINLIBBLDK":"QUEST_CONTENT_TIME_VAR_PASS_DAY","PPFLKMOMKAI":"1"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SC