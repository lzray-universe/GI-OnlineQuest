EC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7103902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7103901,"initDialog":710390101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2616,1005],"performCfg":"QuestDialogue/WQ/Liyue_71039/Q7103901","priority":10,"questId":71039,"showRandomTalkCount":0},"dialogs":[{"nodeId":710390101,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":668261642,"text":"...","nextNodeIds":[710390102,710390103]},{"nodeId":710390102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2929596842,"text":"Hey there, Jinwu!","nextNodeIds":[710390104]},{"nodeId":710390104,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":2304717850,"text":"...!?","nextNodeIds":[710390105]},{"nodeId":710390105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2400914,"text":"Yikes! Y—You scared me!","nextNodeIds":[710390106]},{"nodeId":710390106,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":1024524498,"text":"S—Sorry. Anyway, um, if you're looking for Zhiqiong... she left.","nextNodeIds":[710390107,710390109]},{"nodeId":710390107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2958998578,"text":"Where'd she go?","nextNodeIds":[710390108]},{"nodeId":710390108,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":4188075522,"text":"I don't know... I was distracted for just a few moments, and that was it — she was gone.","nextNodeIds":[710390112]},{"nodeId":710390112,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":1743986170,"text":"I had a talk with her... but she insisted on leaving. I doubt I could have cajoled or browbeat her, or even beat her into staying.","nextNodeIds":[710390113]},{"nodeId":710390113,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":430913962,"text":"*sigh* I just hope she knows what she's doing.","nextNodeIds":[710390114]},{"nodeId":710390114,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":2244597466,"text":"I really do hope so...","nextNodeIds":[710390115]},{"nodeId":710390115,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":2232363738,"text":"Ugh, right, I have to tell Muning, and get him to organize a search party for that kid!","nextNodeIds":[710390116,710390117]},{"nodeId":710390116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3081643634,"text":"We'll go to Muning.","nextNodeIds":[710390118]},{"nodeId":710390118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3896846626,"text":"Ugh, that Zhiqiong, she's gone again! Let's get back to the surface and look for Muning, quickly!","nextNodeIds":[]},{"nodeId":710390117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":970486218,"text":"Relax a little.","nextNodeIds":[710390118]},{"nodeId":710390109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":871167418,"text":"How was she doing when she left?","nextNodeIds":[710390110]},{"nodeId":710390110,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":3995689562,"text":"...","nextNodeIds":[710390111]},{"nodeId":710390111,"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","textMapHash":3849713994,"text":"Khedive did a check-up, and he said that it didn't look too promising...","nextNodeIds":[710390112]},{"nodeId":710390103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2902057490,"text":"Are you doing fine?","nextNodeIds":[710390104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["6","166001309,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["6","166001649,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2616"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7103903,"order":3,"stepDescription":"Talk to Muning about Zhiqiong's departure","stepDescTextMapHash":1624904676,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2061"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7103902],"talks":[{"talkId":7103902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7103903","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7103902,"initDialog":710390201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2061,1005],"performCfg":"QuestDialogue/WQ/Liyue_71039/Q7103902","priority":8,"questId":71039,"showRandomTalkCount":0},"dialogs":[{"nodeId":710390201,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2062309546,"text":"Hmm? Zhiqiong's not with you? Word's come down from the Ministry.","nextNodeIds":[710390202]},{"nodeId":710390202,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2321171554,"text":"On account of the invaluable help that her maps have brought to the Huishan Hall, the Ministry of Civil Affairs has decided to make an exception for her and... Let me see, invite her to be formally accepted as a consultant and guide.","nextNodeIds":[710390203]},{"nodeId":710390203,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":195570330,"text":"Congratulations to her are in order — it seems that all that running around wasn't for naught.","nextNodeIds":[710390204]},{"nodeId":710390204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":654020170,"text":"She left.","nextNodeIds":[710390205]},{"nodeId":710390205,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1921503890,"text":"Left? What do you mean? Do you mean she left first? But the Millelith didn't tell me of anyone leaving The Chasm...","nextNodeIds":[710390206]},{"nodeId":710390206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":116138106,"text":"Zhiqiong left the team.","nextNodeIds":[710390207]},{"nodeId":710390207,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2947725002,"text":"Eh? Uh...","nextNodeIds":[710390208]},{"nodeId":710390208,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3845761450,"text":"Wait! Wait!","nextNodeIds":[710390209]},{"nodeId":710390209,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":4271885578,"text":"Hang on a moment, you mean she left the exploration team?","nextNodeIds":[710390210]},{"nodeId":710390210,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2444568898,"text":"As in, Zhiqiong left the team?","nextNodeIds":[710390211]},{"nodeId":710390211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":449194650,"text":"Yes! Which part of that didn't you get?","nextNodeIds":[710390212]},{"nodeId":710390212,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":363020946,"text":"...I get it. I will put a search and rescue party together immediately. If she is still in The Chasm, we should be able to find her.","nextNodeIds":[710390213]},{"nodeId":710390213,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3085916498,"text":"She might just be doing something harebrained again, or perhaps she left for another reason... But regardless, we must find her.","nextNodeIds":[710390214]},{"nodeId":710390214,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1216633474,"text":"In her current condition, working away from the team is simply far too reckless...","nextNodeIds":[710390215,710390217]},{"nodeId":710390215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":542266314,"text":"Need my help?","nextNodeIds":[710390216]},{"nodeId":710390216,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":73219914,"text":"No, I don't reckon so... I suppose it's about time I stepped in as well.","nextNodeIds":[710390233]},{"nodeId":710390233,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3525898938,"text":"I'll be there if you need me.","nextNodeIds":[710390234]},{"nodeId":710390234,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1015686322,"text":"Paimon too! We can't just leave our junior adventurer behind!","nextNodeIds":[710390235]},{"nodeId":710390235,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3497867706,"text":"We'll look out while on the road as well. Who knows, maybe we'll bump into her somehow!","nextNodeIds":[]},{"nodeId":710390217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1732317826,"text":"About Zhiqiong...","nextNodeIds":[710390218]},{"nodeId":710390218,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":149252970,"text":"She's a restless one, but whatever the case, we are still friends. I might not be the friendliest person around, but I don't simply forget friendships just like that.","nextNodeIds":[710390219]},{"nodeId":710390219,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":4165410074,"text":"She's always talking about some big adventurer's dream or something, and she's actually been injured quite seriously several times before. Nearly bit it on at least one occasion, too. And here I thought she'd settled down for a bit...","nextNodeIds":[710390220]},{"nodeId":710390220,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1544933610,"text":"I'd hoped that she'd have forgotten those unrealistic dreams of hers already. Roald... Stanley... It's not all wine and roses with them, you know!","nextNodeIds":[710390221]},{"nodeId":710390221,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1402877730,"text":"*sigh* But I never expected... To be honest, I was starting to wonder if asking you to come to The Chasm was the right decision... If we hadn't, she might not have had a fire lit under her again...","nextNodeIds":[710390222,710390226]},{"nodeId":710390222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1708719418,"text":"Her efforts did produce some results in the end.","nextNodeIds":[710390223]},{"nodeId":710390223,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":159302682,"text":"Results...? I think that's a bit too utilitarian. We are very grateful for the maps that she drew of large swathes of The Chasm, yes...","nextNodeIds":[710390224]},{"nodeId":710390224,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2465455106,"text":"But should intangible, illusory things like \"dreams\" and pursuing them really come before one's life?","nextNodeIds":[710390225]},{"nodeId":710390225,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":27651778,"text":"I just can't understand it, nor can I imagine anyone really plunging into danger over things like that.","nextNodeIds":[710390232]},{"nodeId":710390232,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3197935938,"text":"As such, please leave the search for her to me... Uh, more accurately, just leave it to the Millelith search party.","nextNodeIds":[710390233]},{"nodeId":710390226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3959547242,"text":"It is her choice, you know.","nextNodeIds":[710390227]},{"nodeId":710390227,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1086121650,"text":"Choice, you say... Excuses! She's going there to die, don't you realize that!?","nextNodeIds":[710390228]},{"nodeId":710390228,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":442730786,"text":"...*cough* Sorry, I spoke a little harshly there. Still... couldn't she just exercise a little more patience in the face of things that we mortals cannot change!?","nextNodeIds":[710390229]},{"nodeId":710390229,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1504185090,"text":"In twenty or thirty years... maybe even ten, we might have safer underground equipment! Then, she wouldn't have to worry about having to go on expeditions to make underground maps.","nextNodeIds":[710390230]},{"nodeId":710390230,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3576953706,"text":"But she's not willing to wait for any of these things, not at all! No, she just has to finish an entire life's work while she's still so young!","nextNodeIds":[710390231]},{"nodeId":710390231,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3679496626,"text":"It's folly, I say, and as a friend, I can't just leave her be.","nextNodeIds":[710390232]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7103901","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["0"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2061"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7103901,7103902],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","count":25},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":2616,"speakerName":"Jinwu","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_M