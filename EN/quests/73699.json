3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7369905"}],"triggerCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"736990501"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7369906,"order":11,"stepDescription":"Talk to Sorush","stepDescTextMapHash":2277085220,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369906,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7369906_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7369906],"talks":[{"talkId":7369906,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7369906","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369906,"initDialog":736990601,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7369906","priority":5,"questId":73699,"showRandomTalkCount":0},"dialogs":[{"nodeId":736990601,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":174413410,"text":"Hey, isn't this the place we passed by looking for Mihir? Though, Mihir shouldn't be here right now, right?","nextNodeIds":[736990602]},{"nodeId":736990602,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":970231058,"text":"All those thorns... They should be Mihir's companions. They look pretty good. Speaking of which, they helped us a lot.","nextNodeIds":[736990603]},{"nodeId":736990603,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":746691786,"text":"Pale Floater... Did you forget all that I have accomplished?","nextNodeIds":[736990604]},{"nodeId":736990604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3885972138,"text":"No way. You might complain a lot, but you do care about your people, right?","nextNodeIds":[736990605,736990607]},{"nodeId":736990605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":10651890,"text":"I... What did you do, Sorush? I can't seem to recall.","nextNodeIds":[736990606]},{"nodeId":736990606,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2640022834,"text":"How can you be so forgetful, Yasnapati? I punish you with the task of several more odes!","nextNodeIds":[736990609]},{"nodeId":736990609,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1498688586,"text":"Haha. Paimon knew it! You've got a big bark to go with your soft heart.","nextNodeIds":[736990610]},{"nodeId":736990610,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1508471314,"text":"Malicious slander! I was only here because I wished to earn the Chaplet. If the elder hadn't made me come... Hmph.","nextNodeIds":[736990611]},{"nodeId":736990611,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1830395938,"text":"Well, whatever you say, Mihir's part of the reason you even managed to claim the Twin-Horned Chaplet. Shouldn't you thank her for that, at least?","nextNodeIds":[736990612]},{"nodeId":736990612,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1663208666,"text":"Her? Bah. For such a figure, one stained and still struggling thusly, I'd say she would only be worth any merit after another ten cleansing pilgrimages.","nextNodeIds":[736990613]},{"nodeId":736990613,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":688102170,"text":"Ten is way too many! Uh... Wait a minute, on second thought, Paimon thinks it wouldn't be too hard...","nextNodeIds":[736990614,736990616]},{"nodeId":736990614,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2818793866,"text":"The path really isn't that long.","nextNodeIds":[736990615]},{"nodeId":736990615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3178640762,"text":"Yeah, maybe we can use it as exercise every now and again?","nextNodeIds":[736990618]},{"nodeId":736990618,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1619018314,"text":"From the name, Paimon thought we would be walking for ten days and nights. As it turns out, we didn't even need to go that far. Hmm... the shortness of this trail is making Paimon suspicious.","nextNodeIds":[736990619]},{"nodeId":736990619,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1468700258,"text":"If it was as long as the Oceanids' pilgrimage, then perhaps I would respect her. As it stands now, I can only state that the distance of the cleansing pilgrimage suits Mihir.","nextNodeIds":[736990620]},{"nodeId":736990620,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2811623418,"text":"The Oceanids' pilgrimage?","nextNodeIds":[736990621]},{"nodeId":736990621,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3745696482,"text":"After the catastrophe, a great number of Oceanids came from Fontaine to Sumeru, with the path they walked becoming their so-called holy path.","nextNodeIds":[736990622]},{"nodeId":736990622,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2359504610,"text":"Strange. Why would the Oceanids need to come to Sumeru? Pilgrimage... A pilgrimage for what?","nextNodeIds":[736990623]},{"nodeId":736990623,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1468192234,"text":"Hm... I only heard of such a thing from my elder. Though there have been Oceanids from Fontaine, I haven't truly looked into it...","nextNodeIds":[736990624]},{"nodeId":736990624,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":371434914,"text":"Could it be for the Harvisptokhm?","nextNodeIds":[736990625]},{"nodeId":736990625,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1168389098,"text":"Right. Sorush said that the Harvisptokhm was the god that let the Pari be born. If honor's a big deal here, then the thing most deserving of it is definitely the Harvisptokhm.","nextNodeIds":[736990626]},{"nodeId":736990626,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2926986522,"text":"But what's the potential relationship between the Oceanids and the Harvisptokhm...? Don't tell Paimon the Oceanids and Pari are like, distantly related?","nextNodeIds":[736990627]},{"nodeId":736990627,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1332332322,"text":"Hmm... Looking at you carefully, Paimon's really beginning to see the resemblance!","nextNodeIds":[736990628]},{"nodeId":736990628,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":79577786,"text":"Haha. Paimon hasn't discovered any world-shaking secrets, has she?","nextNodeIds":[736990629,736990630]},{"nodeId":736990629,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4204281178,"text":"They're not that similar.","nextNodeIds":[736990631]},{"nodeId":736990631,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3400540962,"text":"The slander flows from your lips again, Pale Floater... I know nothing of any Oceanid.","nextNodeIds":[736990632]},{"nodeId":736990632,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2198297986,"text":"Hm. You're probably right. Sorush did say that the distance Oceanids need to travel for their pilgrimage is far longer than Mihir's cleansing.","nextNodeIds":[736990633]},{"nodeId":736990633,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2965618410,"text":"But if that's true, does that mean the Oceanids are stronger than the Pari? Is Sorush admitting defeat? Hehe.","nextNodeIds":[736990634]},{"nodeId":736990634,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3999305994,"text":"Wh—What? I didn't mean that...","nextNodeIds":[736990635]},{"nodeId":736990635,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2563821658,"text":"...In all seriousness, the \"cleansing pilgrimage\" is not actually tied to distance. It is more of a symbolic affair, showcasing a rise and return to form.","nextNodeIds":[736990636]},{"nodeId":736990636,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1551263250,"text":"Hmm... That sounds impressive... but...","nextNodeIds":[736990637]},{"nodeId":736990637,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1314759058,"text":"Regardless, it is irrational to brush all Pari as lesser than the Oceanids! And not because of any bias I may or may not have regarding Mihir.","nextNodeIds":[736990638]},{"nodeId":736990638,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3971866506,"text":"Speaking of which, why did Zurvan say that the next part of the training was just right for Sorush? It doesn't look like anything special here. Also, Mihir's missing too...","nextNodeIds":[736990639]},{"nodeId":736990639,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1438768098,"text":"Though if she was here, Sorush probably wouldn't talk to her properly either. They are pretty different in a lot of ways.","nextNodeIds":[736990640,736990642]},{"nodeId":736990640,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":36299418,"text":"One is round and the other is pricky?","nextNodeIds":[736990641]},{"nodeId":736990641,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3667315922,"text":"Yeah, but... But that's not what Paimon wanted to say!","nextNodeIds":[736990644]},{"nodeId":736990644,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2925207122,"text":"That fool... If her existence and her efforts over these centuries are forgotten, then what was it all for?","nextNodeIds":[736990645]},{"nodeId":736990645,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":621466202,"text":"Maybe that's the question that Zurvan wants Sorush to think about?","nextNodeIds":[736990646]},{"nodeId":736990646,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1752798906,"text":"...","nextNodeIds":[736990647]},{"nodeId":736990647,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":50605338,"text":"It seems that Sorush still needs some time.","nextNodeIds":[]},{"nodeId":736990642,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4086531122,"text":"Mihir doesn't need a Yasnapati.","nextNodeIds":[736990643]},{"nodeId":736990643,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3505987842,"text":"Yeah. She also said that being forgotten is a good thing.","nextNodeIds":[736990644]},{"nodeId":736990630,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4140152914,"text":"Maybe a bit.","nextNodeIds":[736990631]},{"nodeId":736990616,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1444973242,"text":"Though the way isn't long, running it repeatedly does make me tired...","nextNodeIds":[736990617]},{"nodeId":736990617,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2115946074,"text":"Huh? I expected an adventurer to be used to such a life by now.","nextNodeIds":[736990618]},{"nodeId":736990607,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1793077426,"text":"Sorush's the hero of this story.","nextNodeIds":[736990608]},{"nodeId":736990608,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":448396386,"text":"Indeed, hehe.","nextNodeIds":[736990609]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369906,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7369906_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7369901,7369906],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":28},{"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","count":19},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173699],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":75551950,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[73700],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73697/Q7369901","ANDJNFLIDIJ":"PLAY_