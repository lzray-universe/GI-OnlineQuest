{"mainQuestId":73699,"title":"The Recollector's Path","description":"Sorush's training continues. Even a Wenut crystallized across countless eras has a date of expiry. Could there possibly be an ode or poem that could outlast even such a being?\\n","titleTextMapHash":141787719,"descTextMapHash":75551950,"mainQuestExcel":{"mainQuestId":73699,"titleTextMapHash":141787719,"title":"The Recollector's Path","descTextMapHash":75551950,"description":"Sorush's training continues. Even a Wenut crystallized across countless eras has a date of expiry. Could there possibly be an ode or poem that could outlast even such a being?\\n","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5132,"luaPath":"Actor/Quest/WQ73699","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5132,"chapterId":0,"descTextMapHash":75551950,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73699,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1656996921,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73699","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173699],"series":73697,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[73700],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":141787719,"type":"WQ","unlockDescTextMapHash":872365190}},"flow":[{"subQuestId":7369901,"order":5,"stepDescription":"Talk to Zurvan","stepDescTextMapHash":2579227684,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369901],"talks":[{"talkId":7369901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7369901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369901,"initDialog":736990101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4284],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7369901","priority":5,"questId":73699,"showRandomTalkCount":0},"dialogs":[{"nodeId":736990101,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":3097638506,"text":"Hm. Looks like you successfully completed your training.","nextNodeIds":[736990102]},{"nodeId":736990102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2400800626,"text":"Oh, we got it done, but ugh, Sorush...","nextNodeIds":[736990103]},{"nodeId":736990103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1270194642,"text":"After seeing that crystallized Wenut, she said, with real sincerity, that even though it had existed for centuries, one day it would still disappear without a trace...","nextNodeIds":[736990104]},{"nodeId":736990104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1877316970,"text":"And then immediately afterward, when we mentioned that her odes might be distorted as well, her mood changed instantly.","nextNodeIds":[736990105]},{"nodeId":736990105,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1064343538,"text":"Hmph. But of course! My deeds... I mean, the deeds of us Pari should be eternal. How can such a thing be compared to that which might part into dust and ash?","nextNodeIds":[736990106]},{"nodeId":736990106,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":239574474,"text":"If something cannot be recorded properly, then there must be something wrong with the method. You wished to remind me of this fact, which is why you sent me to view the crystallized Wenut. Am I right, Elder Zurvan?","nextNodeIds":[736990107]},{"nodeId":736990107,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":239368234,"text":"Ah. That's the way you see it. Interesting.","nextNodeIds":[736990108]},{"nodeId":736990108,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1220165786,"text":"Do you care nothing for the renown of the Pari?","nextNodeIds":[736990109]},{"nodeId":736990109,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1310621706,"text":"If you're speaking of renown in the way humans understand it, not so much. Whatever you say, the present-day members of the Order of Skeptics are so very dull.","nextNodeIds":[736990110]},{"nodeId":736990110,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1244680346,"text":"#Of course, if there are more interesting individuals like {NICKNAME} or Paimon, then that would be a different case entirely.","nextNodeIds":[736990111]},{"nodeId":736990111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3643779274,"text":"Hehe, a compliment from Zurvan.","nextNodeIds":[736990112,736990115]},{"nodeId":736990112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4000810354,"text":"Thanks! Appreciate the praise, Elder!","nextNodeIds":[736990113]},{"nodeId":736990113,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3904538010,"text":"Hold... Y—You can't call her \"Elder\"!","nextNodeIds":[736990114]},{"nodeId":736990114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1058470722,"text":"Sorush, there's no need to be stingy. Zurvan is the eldest here, so us calling her elder is reasonable, right?","nextNodeIds":[736990117]},{"nodeId":736990117,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1157705002,"text":"Alright. Enough idle chatter. If Sorush still thinks so highly of this \"human notion of renown,\" then the training that comes next might be just right.","nextNodeIds":[736990118]},{"nodeId":736990118,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1458332050,"text":"Alright. I await your good news.","nextNodeIds":[]},{"nodeId":736990115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2274571546,"text":"Can \"interesting\" be considered a compliment?","nextNodeIds":[736990116]},{"nodeId":736990116,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":2247083562,"text":"It is by my standards.","nextNodeIds":[736990117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7369902,"order":6,"stepDescription":"Head to the specified location and complete the trial","stepDescTextMapHash":3017251684,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7369902"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7369902_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLM