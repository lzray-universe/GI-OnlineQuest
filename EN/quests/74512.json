ONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451201,"initDialog":745120101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30509,30534],"performCfg":"QuestDialogue/WQ/SlimeCannon_74512/Q7451201","priority":5,"questId":74512,"showRandomTalkCount":0},"dialogs":[{"nodeId":745120101,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":3150690594,"text":"The data indicates that this invention is a success. Thank you both.","nextNodeIds":[745120102]},{"nodeId":745120102,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":689010034,"text":"Yup, thanks!","nextNodeIds":[745120103]},{"nodeId":745120103,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3790986730,"text":"See, I told you this would go well! With your genius in play, Frejus, this remote-controlled cannon thing was a piece of cake!","nextNodeIds":[745120104]},{"nodeId":745120104,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1056959346,"text":"I—I suppose...","nextNodeIds":[745120105]},{"nodeId":745120105,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":574522498,"text":"In that case, let's get cracking with the next awesome gadget — and I have a great idea for one, too!","nextNodeIds":[745120106]},{"nodeId":745120106,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":4171218538,"text":"What?","nextNodeIds":[745120107]},{"nodeId":745120107,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2757611018,"text":"What about an airship that can explore the skies?","nextNodeIds":[745120108]},{"nodeId":745120108,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":3184576954,"text":"Um...","nextNodeIds":[745120109]},{"nodeId":745120109,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3936053498,"text":"Or a mega drill that can bore deep underground?","nextNodeIds":[745120110]},{"nodeId":745120110,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":2323324634,"text":"Hah...","nextNodeIds":[745120111]},{"nodeId":745120111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":155688050,"text":"Feels like she's trying to make his life difficult on purpose...","nextNodeIds":[745120112]},{"nodeId":745120112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":241700098,"text":"Those might be a bit of a tall order...","nextNodeIds":[745120113]},{"nodeId":745120113,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3454992338,"text":"I mean, you're the one who rejected the Institute's offer three times. I'm sure you can make stuff even they can't, right?","nextNodeIds":[745120114]},{"nodeId":745120114,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":4139727154,"text":"Of course. I can only say that it will be tricky, but not a big deal.","nextNodeIds":[745120115]},{"nodeId":745120115,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":3248788074,"text":"*sigh* You know what? I don't want those things anymore. Flying up into the sky or delving into the earth both sound boring. It's cold up there, and it's stuffy down there.","nextNodeIds":[745120116]},{"nodeId":745120116,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":4099574202,"text":"I share that sentiment.","nextNodeIds":[745120117]},{"nodeId":745120117,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":2478858266,"text":"In that case, could you make something that we'd use normally? ...Ooh, that's right! I love sleeping in in the mornings, so could you make me an automatic oven that bakes on its own?","nextNodeIds":[745120118]},{"nodeId":745120118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3891801074,"text":"Well now, that sounds possible.","nextNodeIds":[745120119]},{"nodeId":745120119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3046907178,"text":"Her earlier suggestions were intentionally impossible, I think.","nextNodeIds":[745120120]},{"nodeId":745120120,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":783763714,"text":"Alright, let me consider how this might be designed.","nextNodeIds":[745120121]},{"nodeId":745120121,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"Chenee","textMapHash":976533834,"text":"Nice! I'll take that as agreement — and if it does prove impossible, you'll just have to make me breakfast in the future, eh, Frejus?","nextNodeIds":[745120122]},{"nodeId":745120122,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"Frejus","textMapHash":1731139226,"text":"What? What sort of request is that... In any case, you needn't worry, I'm sure such a small invention is well within my skill. I am, after all, a \"genius.\"","nextNodeIds":[]}]},{"talkId":7451202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFree