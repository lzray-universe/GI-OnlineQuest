{"mainQuestId":11001,"title":"Cooking Appointment","description":"While out on a stroll, you bumped into a strange girl. This girl, a chef from Liyue by the name of Xiangling, is on a journey to seek out exotic ingredients. She enlists your help in a hunt, but your private hunting expedition appears to have earned the ire of Draff, the leader of the hunters. You head off to apologize to him...","titleTextMapHash":1789362889,"descTextMapHash":2944495999,"mainQuestExcel":{"mainQuestId":11001,"titleTextMapHash":1789362889,"title":"Cooking Appointment","descTextMapHash":2944495999,"description":"While out on a stroll, you bumped into a strange girl. This girl, a chef from Liyue by the name of Xiangling, is on a journey to seek out exotic ingredients. She enlists your help in a hunt, but your private hunting expedition appears to have earned the ire of Draff, the leader of the hunters. You head off to apologize to him...","chapterId":2007,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/LQ11001","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":2007,"descTextMapHash":2944495999,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":11001,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1313595311,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/LQ11001","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":2007,"rewardIdList":[111001],"series":2007,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[11002],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1789362889,"type":"LQ","unlockDescTextMapHash":2757737139}},"flow":[{"subQuestId":1100101,"order":1,"stepDescription":"Go with Xiangling to Springvale","stepDescTextMapHash":452312950,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["153701"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133002317,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["153701"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1100102,"order":2,"stepDescription":"Apologize to Draff","stepDescTextMapHash":3867827830,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["153701"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1100102],"talks":[{"talkId":1100102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100102","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100102,"initDialog":110010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[153701],"performCfg":"QuestDialogue/LQ/Xiangling1_11001/Q1100102","priority":5,"questId":11001,"showRandomTalkCount":0},"dialogs":[{"nodeId":110010201,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":2213579126,"text":"You must be Xiangling.","nextNodeIds":[110010202]},{"nodeId":110010202,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":249325334,"text":"Sorry Mr. Draff, this was all my fault.","nextNodeIds":[110010203]},{"nodeId":110010203,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":1289941974,"text":"I heard the whole story. And now that you're here in person...","nextNodeIds":[110010204]},{"nodeId":110010204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":831125566,"text":"Ooh, he's gonna let her have it!","nextNodeIds":[110010205,110010206]},{"nodeId":110010205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3172641334,"text":"Violence is not the answer!","nextNodeIds":[110010207]},{"nodeId":110010207,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":2256496238,"text":"...Please help me promote my meat!","nextNodeIds":[110010208]},{"nodeId":110010208,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2543441222,"text":"...Eh?","nextNodeIds":[110010209]},{"nodeId":110010209,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":2013972686,"text":"Sorry if I was a little brash. Let me explain.","nextNodeIds":[110010210]},{"nodeId":110010210,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":236634398,"text":"Springvale has built its reputation on top-quality meat products, but this reputation is so far limited to Mondstadt.","nextNodeIds":[110010211]},{"nodeId":110010211,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":3227985430,"text":"When I heard that the great maestro Xiangling herself was in Mondstadt, I asked Allan to send you over.","nextNodeIds":[110010212]},{"nodeId":110010212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":639035878,"text":"Maestro?","nextNodeIds":[110010213]},{"nodeId":110010213,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":1616828974,"text":"Haven't you heard? She's the one behind Wanmin Restaurant, that one-of-a-kind folk cuisine restaurant in Liyue Harbor.","nextNodeIds":[110010214]},{"nodeId":110010214,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":649055510,"text":"Her unique take on cooking ingredients is behind some of the best-loved dishes in all of Liyue. They are very highly rated by travelers, too.","nextNodeIds":[110010215]},{"nodeId":110010215,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2192788870,"text":"Hee-hee, you're too kind. I just try to cook things that are cheap and cheerful.","nextNodeIds":[110010216]},{"nodeId":110010216,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":2366239654,"text":"With a top-notch chef cooking top-notch cuisine with top-notch meat from Springvale... Our reputation would spread far and wide.","nextNodeIds":[110010217]},{"nodeId":110010217,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":775169494,"text":"Hmm... I don't know...","nextNodeIds":[110010218]},{"nodeId":110010218,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3354403670,"text":"I only ever think about how to make tasty dishes... I never limit myself to specific ingredients, and I don't know the first thing about promoting anything.","nextNodeIds":[110010219]},{"nodeId":110010219,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":3481016150,"text":"You use boar meat all the time anyway, surely? I can't see what the issue is.","nextNodeIds":[110010220]},{"nodeId":110010220,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3618432262,"text":"The issue is... What would you think if I added a bit of Slime Condensate?","nextNodeIds":[110010221]},{"nodeId":110010221,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":2049146086,"text":"That's... I mean, couldn't you add something a bit more normal?","nextNodeIds":[110010222]},{"nodeId":110010222,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1243549070,"text":"There's no such thing as \"normal\" ingredients to me! You can turn anything into a delicacy if you cook it in the right way.","nextNodeIds":[110010223]},{"nodeId":110010223,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1818048718,"text":"I will not stand for having my creativity shackled by what ingredients I can and can't use! Food cooked like that is destined to be boring, period!","nextNodeIds":[110010224,110010225]},{"nodeId":110010224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2106057470,"text":"That escalated quickly...","nextNodeIds":[110010226]},{"nodeId":110010226,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","textMapHash":1834735214,"text":"*sigh* Well, since you feel so strongly about it, forget it. But it really is a pity...","nextNodeIds":[]},{"nodeId":110010225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4104978822,"text":"Celebrity chefs are known to be somewhat strong-minded...","nextNodeIds":[110010226]},{"nodeId":110010206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4116616918,"text":"If you're looking for a fight, bring it on!","nextNodeIds":[110010207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["153701"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1100103,"order":3,"stepDescription":"Catch up to Xiangling","stepDescTextMapHash":2431882966,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100103,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100103,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100103,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":1100104,"order":4,"stepDescription":"Talk to Xiangling at the source of the aroma","stepDescTextMapHash":3420413798,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1012"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1100104],"talks":[{"talkId":1100104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100104","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100104,"initDialog":110010401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1012],"performCfg":"QuestDialogue/LQ/Xiangling1_11001/Q1100104","priority":5,"questId":11001,"showRandomTalkCount":0},"dialogs":[{"nodeId":110010401,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3805762686,"text":"Hello, may I have a taste of your delicious cooking?","nextNodeIds":[110010402]},{"nodeId":110010402,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":1151215102,"text":"Sorry, I've taken all the orders I can for the next few days. The earliest I could put you down for is seven days from now, is that okay?","nextNodeIds":[110010403]},{"nodeId":110010403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1575540294,"text":"Wow, it must be delicious if it's that popular.","nextNodeIds":[110010404]},{"nodeId":110010404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1825801398,"text":"Odd... This woman is clearly a very popular chef...","nextNodeIds":[110010405]},{"nodeId":110010405,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1335026686,"text":"Yeah, good point. Why does Draff want Xiangling to help when Springvale already has this lady?","nextNodeIds":[110010406]},{"nodeId":110010406,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":3077096294,"text":"Hmm... Maybe he feels that Mondstadt cuisine can't compete with that of Teyvat's biggest business hub, Liyue Harbor.","nextNodeIds":[110010407]},{"nodeId":110010407,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":1614721294,"text":"But I disagree! I don't think my cooking is at all inferior to anyone else's.","nextNodeIds":[110010408]},{"nodeId":110010408,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3361811966,"text":"Well then... Show me what you got! Maybe I can give you some feedback.","nextNodeIds":[110010409]},{"nodeId":110010409,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":2578488166,"text":"Sorry, but customer feedback like \"Oh, that tasted good\" is no use to me. If I wanted feedback I would ask a professional chef— Hang on, are you... Xiangling!?","nextNodeIds":[110010410]},{"nodeId":110010410,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3247104686,"text":"That's me!","nextNodeIds":[110010411]},{"nodeId":110010411,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":1954788822,"text":"It's really you! Well, I guess you do know what you're doing when it comes to cooking meat then.","nextNodeIds":[110010412]},{"nodeId":110010412,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":3610108614,"text":"As it happens, I have one of today's prime cuts remaining. So tell me, how would you cook this?","nextNodeIds":[110010413]},{"nodeId":110010413,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2692012518,"text":"That depends on the ratio of fat to meat. With this cut, I would probably roast it over a hot stone with a little salt, some Jueyun Chili, and Qingxin flower.","nextNodeIds":[110010414]},{"nodeId":110010414,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":2847214902,"text":"Qingxin flower!? But the melted fat would make the flavor of the flowers ten times stronger than when eaten raw... It would overpower everything!","nextNodeIds":[110010415]},{"nodeId":110010415,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":623178270,"text":"I know, that's why it's a garnish — I would never marinate the meat in it!","nextNodeIds":[110010416]},{"nodeId":110010416,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3849573022,"text":"I've tried it before. If you baste the petals in oil and then cook them with the right heat and duration, it gets rid of the bitterness completely and leaves you with a lovely crispy topping.","nextNodeIds":[110010417]},{"nodeId":110010417,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":479319622,"text":"Then throw in some Jueyun Chilis grown at a high altitude, where the low humidity and varying temperature lends them a unique dry heat.","nextNodeIds":[110010418]},{"nodeId":110010418,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1191878030,"text":"The petals absorb the saltiness from the sea salt, the chili spice, and the umami of the tender, freshly grilled steak, while also adding a floral aftertaste.","nextNodeIds":[110010419]},{"nodeId":110010419,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":2220005126,"text":"That's pure overkill! You're going all out on the trimmings and doing no justice to the meat whatsoever.","nextNodeIds":[110010420]},{"nodeId":110010420,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":1286295110,"text":"Who wants to eat a roast when you can taste everything except the roast?","nextNodeIds":[110010421]},{"nodeId":110010421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3628821126,"text":"Whoa whoa whoa, stop arguing!","nextNodeIds":[110010422,110010423]},{"nodeId":110010422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1735100710,"text":"I don't think they can hear anyone but themselves...","nextNodeIds":[110010424]},{"nodeId":110010424,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":108266358,"text":"Hmph. Well, there's only one sure-fire way out of a cooking dispute...","nextNodeIds":[110010425]},{"nodeId":110010425,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":939205326,"text":"I declare a cook-off!","nextNodeIds":[110010426]},{"nodeId":110010426,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":461006702,"text":"Suits me! If you can't beat my cooking, it'll show that Draff was clearly wrong about you.","nextNodeIds":[110010427]},{"nodeId":110010427,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":419652678,"text":"Alright — but if I win, you have to use my winning dish to promote Springvale!","nextNodeIds":[110010428]},{"nodeId":110010428,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":3214330694,"text":"And if you lose, you have to add my winning dish to the Wanmin menu!","nextNodeIds":[110010429]},{"nodeId":110010429,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","textMapHash":1817454838,"text":"With a caption saying \"This special addition to the Wanmin menu is generously provided by Chef Brook of Springvale, meat expert.\" Hmph!","nextNodeIds":[110010430]},{"nodeId":110010430,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1195324670,"text":"You have a deal!","nextNodeIds":[110010431]},{"nodeId":110010431,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2782869918,"text":"I'm off to get ingredients — I will see you all in Liyue!","nextNodeIds":[110010432]},{"nodeId":110010432,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":10191374,"text":"Wait! Waaait!","nextNodeIds":[110010433]},{"nodeId":110010433,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2745288806,"text":"#{NICKNAME}, let's try and catch up.","nextNodeIds":[]},{"nodeId":110010423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":779764358,"text":"I guess this is a sort of culinary clash of the titans.","nextNodeIds":[110010424]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1012"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1100102,1100104],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"Draff","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"Brook","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[111001],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2944495999,"CHECNJEMEFE":{"1012":[1090,1120