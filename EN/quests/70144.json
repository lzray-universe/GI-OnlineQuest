40102]},{"nodeId":701440102,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":1016131290,"text":"What about it? Has your investigation revealed something?","nextNodeIds":[701440103]},{"nodeId":701440103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1196114002,"text":"This is what I discovered.","nextNodeIds":[701440104]},{"nodeId":701440104,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":203489514,"text":"Goodness... I wonder when it could have appeared here?","nextNodeIds":[701440105]},{"nodeId":701440105,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2820846962,"text":"Thank you for investigating, I'll report the situation to the Guild. Here's your reward.","nextNodeIds":[]}]},{"talkId":7014402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7014402,"initDialog":701440201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1665],"performCfg":"","priority":5,"questId":70144,"showRandomTalkCount":0},"dialogs":[{"nodeId":701440201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":381955618,"text":"Do you have a commission for me?","nextNodeIds":[701440202]},{"nodeId":701440202,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":694144834,"text":"A commission, you say? Your timing couldn't have been better! I was just thinking I should find an experienced adventurer to investigate the strange air current.","nextNodeIds":[701440203]},{"nodeId":701440203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2906797770,"text":"What strange air current?","nextNodeIds":[701440204]},{"nodeId":701440204,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2695363002,"text":"Let me give you a bit of background. Not long ago, a small team of explorers went on an expedition up the mountain. A few highly experienced adventurers joined them, and they took a safe route that avoided all the known dangerous spots.","nextNodeIds":[701440205]},{"nodeId":701440205,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2368281346,"text":"But somehow, they fell foul of a sudden and powerful current of cold air along their way and were forced to return to the camp.","nextNodeIds":[701440206]},{"nodeId":701440206,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":3592694466,"text":"I spoke to the adventurers when they got back. They said that it shouldn't have been possible for an air current that strong to appear on the trail they were following. Apparently, it just came out of nowhere. It doesn't seem like it was a naturally occurring phenomenon.","nextNodeIds":[701440207]},{"nodeId":701440207,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2638084226,"text":"Since then, numerous explorers and surveyors have reported encountering the same situation. After organizing a few investigations of our own, we now believe that we have pinpointed the source of the air current.","nextNodeIds":[701440208]},{"nodeId":701440208,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2088401698,"text":"Unfortunately, all the adventurers who have taken part in the investigations so far are still recuperating from frostbite, muscular fatigue, and other issues, so our investigations have temporarily ground to a halt...","nextNodeIds":[701440209]},{"nodeId":701440209,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":3370812226,"text":"Traveler, if you are willing, could you continue investigating the source of the air current on our behalf?","nextNodeIds":[701440210,701440212]},{"nodeId":701440210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2511728890,"text":"Sure.","nextNodeIds":[701440211]},{"nodeId":701440211,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":3174174466,"text":"Many thanks. Make sure you're well-prepared before you set off — whatever is causing this is most unnatural.","nextNodeIds":[701440215]},{"nodeId":701440215,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2248644858,"text":"If you've no further questions, I will leave you to proceed with the investigation. Many thanks for your assistance.","nextNodeIds":[]},{"nodeId":701440212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4066288850,"text":"What's in this for me?","nextNodeIds":[701440213]},{"nodeId":701440213,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2826905258,"text":"Oh... Straight to the point, I see. Don't worry, the Guild is not in the business of short-changing its adventurers. I will have a reward waiting for you when you return to the camp.","nextNodeIds":[701440214]},{"nodeId":701440214,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":44027922,"text":"As for the size of said reward... That will be determined based on the value of your findings. You know the score, right?","nextNodeIds":[701440215]}]},{"talkId":7014403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7014403,"initDialog":701440301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1665],"performCfg":"","priority":5,"questId":70144,"showRandomTalkCount":0},"dialogs":[{"nodeId":701440301,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4049169562,"text":"Do you have a commission for me?","nextNodeIds":[701440302]},{"nodeId":701440302,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":3275441442,"text":"A commission, you say? Your timing couldn't have been better! I was just thinking I should find an experienced adventurer to investigate the strange air current.","nextNodeIds":[701440303]},{"nodeId":701440303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2834762658,"text":"What strange air current?","nextNodeIds":[701440304]},{"nodeId":701440304,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":1292315826,"text":"Let me give you a bit of background. Not long ago, a small team of explorers went on an expedition up the mountain. A few highly experienced adventurers joined them, and they took a safe route that avoided all the known dangerous spots.","nextNodeIds":[701440305]},{"nodeId":701440305,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":3115872170,"text":"But somehow, they fell foul of a sudden and powerful cold current along their way and were forced to return to the camp.","nextNodeIds":[701440306]},{"nodeId":701440306,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":3293345842,"text":"I spoke to the adventurers when they got back. They said that it shouldn't have been possible for an air current that strong to appear on the trail they were following. Apparently, it just came out of nowhere, and did not have the hallmarks of a naturally occurring phenomenon...","nextNodeIds":[701440307]},{"nodeId":701440307,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":2414873122,"text":"Since then, numerous explorers and surveyors have reported encountering the same situation. After organizing a fair few investigations of our own, we now believe that we have pinpointed the source of the air current.","nextNodeIds":[701440308]},{"nodeId":701440308,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":1161339370,"text":"Unfortunately, our investigations have now ground to a halt, as we are short on personnel...","nextNodeIds":[701440309]},{"nodeId":701440309,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":1131220850,"text":"Traveler, if you are willing, could you continue investigating the source of this phenomenon on our behalf?","nextNodeIds":[701440310]},{"nodeId":701440310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3229732290,"text":"One step ahead of you. I've already been.","nextNodeIds":[701440311]},{"nodeId":701440311,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":1105240338,"text":"You've investigated it already? Wow, what a lucky coincidence... Well, what did you find out?","nextNodeIds":[701440312]},{"nodeId":701440312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2379914834,"text":"This is what I discovered.","nextNodeIds":[701440313]},{"nodeId":701440313,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":1885486946,"text":"I wonder when it could have appeared here?","nextNodeIds":[701440314]},{"nodeId":701440314,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","textMapHash":1471874282,"text":"Thank you for investigating, I'll report the situation to the Guild. Here's your reward.","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7014401,7014402,7014403],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"Iris","count":24},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3761023550,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_NONE","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":701440101,"ILHDCGDKKKA":"TALK_HERO_LOCAL","ILHDNJDDEOP":7014401,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[1665],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["99902","3"],"_type":"QUEST_COND_STATE_EQUAL"}],"NIJAPEJKLDI":false,"NMKNFLIHHHE":false,"NMMOKMEKDJO":false,"NPGONNBAOOI":11969433100604223257,"OAIIIMFGNGM":false,"OAOCMNEPKOG":70144,"ODEOIJMOMPL":[],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST","PCCKKGAHFFJ":false,"PNACKFKJJHM":[]},{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH"