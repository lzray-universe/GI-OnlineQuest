aram":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7905401,"initDialog":790540101,"nextRandomTalks":[],"nextTalks":[],"npcId":[13249],"performCfg":"QuestDialogue/WQ/Penumbra_79054/Q7905401","priority":3,"questId":79054,"showRandomTalkCount":0},"dialogs":[{"nodeId":790540101,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":638743442,"text":"Why are you up here yourself? There isn't even a rail line here, and it's way high up at the very edge of the Mirage.","nextNodeIds":[790540102]},{"nodeId":790540102,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":1919359442,"text":"People rarely come here. Even Idyia... Heh, I doubt she even knows this place exists.","nextNodeIds":[790540103]},{"nodeId":790540103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2008700386,"text":"So if there's nothing here, why are you here, Jeroney?","nextNodeIds":[790540104]},{"nodeId":790540104,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":505050402,"text":"I just came out for a little fresh air... Hey, don't give me that \"you ran away from home after arguing with Ferdinand again\" look!","nextNodeIds":[790540105]},{"nodeId":790540105,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":1750903122,"text":"Come on, there really wasn't an argument. I'm just taking a stroll out of, well, I don't know, personal interest!","nextNodeIds":[790540106]},{"nodeId":790540106,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":2370133026,"text":"I suppose you already knew that the Choo-Choo Cart was my idea. At that time, I was only thinking: What's something that could easily reach great heights...","nextNodeIds":[790540107]},{"nodeId":790540107,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":3296502842,"text":"So I... So Jeroney brainstormed the Choo-Choo Cart and the rails, all for the love of the sky and heights.","nextNodeIds":[790540108]},{"nodeId":790540108,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":3599325746,"text":"Sounds silly, doesn't it? I remember Inazuma has a saying that goes something like, \"only idiots and smoke like to rise up high\"...","nextNodeIds":[790540109,790540110]},{"nodeId":790540109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2965019538,"text":"It's awesome that you could think up the Choo-Choo Cart.","nextNodeIds":[790540111]},{"nodeId":790540111,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":3791296522,"text":"But it can only exist in the Veluriyam Mirage.","nextNodeIds":[790540112]},{"nodeId":790540112,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":3662260146,"text":"...Forget it, let's not talk about it. I also came here to stargaze.","nextNodeIds":[790540113]},{"nodeId":790540113,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":128729290,"text":"I know the stars here are merely an ephemeral shadow from outside the Mirage, but they're pretty enough for me.","nextNodeIds":[790540114]},{"nodeId":790540114,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":3313432258,"text":"Every night when I look upon the starry sky... I feel so peaceful.","nextNodeIds":[790540115]},{"nodeId":790540115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1653165298,"text":"The one who loves the starry sky... is it Jeroney...?","nextNodeIds":[790540116]},{"nodeId":790540116,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":446076762,"text":"But whoever sees a starry sky like that couldn't help but fall in love with it. If only I could see the stars in the daytime...","nextNodeIds":[790540117]},{"nodeId":790540117,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":1767606746,"text":"Or even better, if I didn't have to climb up here every day!","nextNodeIds":[790540118]},{"nodeId":790540118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1736865570,"text":"Wait! That's possible! Paimon's got an idea!","nextNodeIds":[790540119]},{"nodeId":790540119,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":3866495658,"text":"Huh? Really?","nextNodeIds":[790540120]},{"nodeId":790540120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1239544642,"text":"We can just take a photo...","nextNodeIds":[790540121]},{"nodeId":790540121,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":4020428234,"text":"Pho... Photo? That sounds like some advanced technology.","nextNodeIds":[790540122]},{"nodeId":790540122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":845922754,"text":"Yeah, why don't we take a photo of the starry sky for Jeroney?","nextNodeIds":[790540123]},{"nodeId":790540123,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":656120386,"text":"Can you really do that?","nextNodeIds":[790540124]},{"nodeId":790540124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1584866602,"text":"Of course you can!","nextNodeIds":[790540125]},{"nodeId":790540125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1408202842,"text":"But... Paimon isn't sure of any good spots to take pictures of the starry night...","nextNodeIds":[790540126]},{"nodeId":790540126,"roleType":"TALK_ROLE_NPC","speakerId":13249,"speakerName":"Jeroney","textMapHash":2778181234,"text":"Here! At night, on the platform here, you can see the most beautiful starscape! That's the reason I came here in the first place.","nextNodeIds":[790540127]},{"nodeId":790540127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":201906802,"text":"Really? Great! Jeroney, you just wait for our photo!","nextNodeIds":[]},{"nodeId":790540110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4062016842,"text":"I think it is so much fun.","nextNodeIds":[790540111]}]},{"talkId":7905404,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7905401","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7905403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7905401","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7905402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondCom