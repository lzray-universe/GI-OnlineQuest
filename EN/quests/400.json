{"mainQuestId":400,"title":"","description":"","titleTextMapHash":2751309041,"descTextMapHash":1914682679,"mainQuestExcel":{"mainQuestId":400,"titleTextMapHash":2751309041,"title":"","descTextMapHash":1914682679,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/MQ400","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":1914682679,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":400,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":358628415,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/MQ400","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":1003,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2751309041,"type":"AQ","unlockDescTextMapHash":2268289155}},"flow":[{"subQuestId":40001,"order":1,"stepDescription":"","stepDescTextMapHash":2956522047,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[40001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[39607],"talks":[{"talkId":39607,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["40001","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":39607,"initDialog":3960701,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/AQ/Mengde3_396/Q39607","priority":5,"questId":400,"showRandomTalkCount":0},"dialogs":[{"nodeId":3960701,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3596392219,"text":"If you want to chat, now's the time — a bard stays not always in a single clime.","nextNodeIds":[3960702,3960707,3960715,3960727,3960741]},{"nodeId":3960702,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1803569907,"text":"About Dvalin...","nextNodeIds":[3960703]},{"nodeId":3960703,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":730349595,"text":"Up till the end, Dvalin remembered his duty as one of the Four Winds.","nextNodeIds":[3960704]},{"nodeId":3960704,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4026710923,"text":"As such, I don't intend to forcibly strip him of that duty and force my ideals of freedom onto him.","nextNodeIds":[3960705]},{"nodeId":3960705,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3432289667,"text":"I just hope that Dvalin will be able to choose for himself and understand what freedom is.","nextNodeIds":[3960706]},{"nodeId":3960706,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3722998899,"text":"Before I became an archon, I too was taught the meaning of freedom in this way by a friend.","nextNodeIds":[3960701]},{"nodeId":3960707,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2640600707,"text":"About the Abyss Order...","nextNodeIds":[3960708]},{"nodeId":3960708,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1185571347,"text":"Kaeya shared some new intelligence, you say?","nextNodeIds":[3960709]},{"nodeId":3960709,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3970074139,"text":"#...I see. So, the Abyss Order has a {F#Prince}{M#Princess} who orchestrated the plan to corrupt Dvalin?","nextNodeIds":[3960710]},{"nodeId":3960710,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1199266715,"text":"#They were probably trying to turn Dvalin into a weapon of war for the Abyss. But that said, I have never heard of any such {F#Prince}{M#Princess} of the Abyss Order.","nextNodeIds":[3960711,3960712]},{"nodeId":3960711,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2110788811,"text":"Not an Abyss Order tradition, then.","nextNodeIds":[3960713]},{"nodeId":3960713,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3888698683,"text":"I think so, too...","nextNodeIds":[3960714]},{"nodeId":3960714,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4236300771,"text":"#Apparently, but how does a {F#Prince}{M#Princess} come out of nowhere and take command over the entire Abyss Order?","nextNodeIds":[3960701]},{"nodeId":3960712,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1054501763,"text":"So this is a recent development...","nextNodeIds":[3960713]},{"nodeId":3960715,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1300671659,"text":"About Signora...","nextNodeIds":[3960716]},{"nodeId":3960716,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2006769275,"text":"That Fatui lady didn't hang around, did she? She just grabbed your Gnosis and left!","nextNodeIds":[3960717]},{"nodeId":3960717,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1088585123,"text":"She wanted to avoid any eyewitnesses from the Knights of Favonius.","nextNodeIds":[3960718]},{"nodeId":3960718,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3635427251,"text":"The slightest slip-up here would have destroyed the Fatui's diplomatic relations with the Knights.","nextNodeIds":[3960719]},{"nodeId":3960719,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2455570363,"text":"So they're just gonna keep acting like Mondstadt's allies as if nothing happened!?","nextNodeIds":[3960720]},{"nodeId":3960720,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":695540923,"text":"*sigh*... If only the seven nations had banded together against the Abyss Order in the first place.","nextNodeIds":[3960721]},{"nodeId":3960721,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4105838515,"text":"The Fatui possess the strongest military among the seven nations. Yet they've used it to steal the Holy Lyre, covet the power of gods, and use Dvalin as a bargaining chip against the Knights...","nextNodeIds":[3960722]},{"nodeId":3960722,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1124318651,"text":"Speaking of the Lyre... didn't Diluc say something like this before?","nextNodeIds":[3960723]},{"nodeId":3960723,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1846024427,"text":"He said that the Fatui can only run amok across the seven nations and threaten the Knights because of the harbingers.","nextNodeIds":[3960724]},{"nodeId":3960724,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1256382931,"text":"Yes. As I said earlier, the Cryo Archon has given them authority and strength beyond that of other mortals.","nextNodeIds":[3960725]},{"nodeId":3960725,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1534723843,"text":"The Tsaritsa... I haven't seen her in five hundred years. What is she thinking? What's her plan?","nextNodeIds":[3960726]},{"nodeId":3960726,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2302855531,"text":"Whatever the answer is, I have a feeling it's only going to make your search for The Seven all the more difficult...","nextNodeIds":[3960701]},{"nodeId":3960727,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4252629123,"text":"About deities...","nextNodeIds":[3960728]},{"nodeId":3960728,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2501252283,"text":"As I said before, Vision wielders are known as allogenes and may ascend to Celestia.","nextNodeIds":[3960729]},{"nodeId":3960729,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4007426411,"text":"A Gnosis is a higher-order nexus of elemental manipulation and is emblematic of an archon's status as one of The Seven.","nextNodeIds":[3960730]},{"nodeId":3960730,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":491966179,"text":"#But as for which of The Seven took your {F#brother}{M#sister}... I'm sorry, I don't know.","nextNodeIds":[3960731]},{"nodeId":3960731,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1419278691,"text":"...Wait, as one of the Seven, I'm not clear of suspicion yet either, am I?","nextNodeIds":[3960732,3960734]},{"nodeId":3960732,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3955386723,"text":"You don't look like that god at all.","nextNodeIds":[3960733]},{"nodeId":3960733,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3604264435,"text":"Hang on a hot second! Tone-Deaf Bard is just one of Barbatos' many incarnations, who's to say—","nextNodeIds":[3960734]},{"nodeId":3960734,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":227379563,"text":"We've known you long enough to trust you.","nextNodeIds":[3960735]},{"nodeId":3960735,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2897361899,"text":"#Haha, we're a great team indeed! Say, once you find your {F#brother}{M#sister}, how would you like to become one of the new Four Winds?","nextNodeIds":[3960736]},{"nodeId":3960736,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4143196571,"text":"Perhaps...","nextNodeIds":[3960737]},{"nodeId":3960737,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2388546563,"text":"#Hmm, you don't seem too into it, {NICKNAME}...","nextNodeIds":[3960738]},{"nodeId":3960738,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3643865483,"text":"Hey, Tone-Deaf Bard... If being one of the Four Winds means free food, you can consider Paimon!","nextNodeIds":[3960739]},{"nodeId":3960739,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2658548915,"text":"Hahaha...","nextNodeIds":[3960701]},{"nodeId":3960741,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2301107483,"text":"There's nothing else...","nextNodeIds":[3960742]},{"nodeId":3960742,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1507500963,"text":"Well then, best be off to <color=#00E1FFFF>Liyue</color>. If the descension ritual you fail to tally, then another year you must dally.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[40001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[39607],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","count":24},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1914682679,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/AQ/Mengde3_396/Q39607","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGG