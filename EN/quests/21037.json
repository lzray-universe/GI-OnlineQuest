EST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2400"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2103701,2103704],"talks":[{"talkId":2103701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2103701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2103701,"initDialog":210370101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2400],"performCfg":"","priority":5,"questId":21037,"showRandomTalkCount":0},"dialogs":[{"nodeId":210370101,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":3550159082,"text":"Liyue... I wonder when I'll come back...","nextNodeIds":[210370102]},{"nodeId":210370102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3265836778,"text":"What's the matter?","nextNodeIds":[210370103]},{"nodeId":210370103,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":4042935866,"text":"Ah, Traveler! It's you!","nextNodeIds":[210370104]},{"nodeId":210370104,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2755114714,"text":"Well, my itinerary to Fontaine has finally been decided, and in a few days, I'll set off with that merchant.","nextNodeIds":[210370105]},{"nodeId":210370105,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1255943810,"text":"He's still got some business stuff to deal with. And I'm taking advantage of this time to make sure I've packed everything.","nextNodeIds":[210370106,210370107]},{"nodeId":210370106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4280731826,"text":"You are not going to visit Jueyun Karst one last time?","nextNodeIds":[210370108]},{"nodeId":210370108,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1627563746,"text":"Haha, I might regret my decision if I were to do that.","nextNodeIds":[210370109]},{"nodeId":210370109,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":508230842,"text":"I'll just take a look around the city from here. I've lived here for so long, and this time, I don't even know when I'll be able to come back.","nextNodeIds":[210370110]},{"nodeId":210370110,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2178639946,"text":"Oh, by the way, Que'er... *sigh* She hasn't agreed to go with me in the end, but I already asked Zhiruo to take care of her.","nextNodeIds":[210370111]},{"nodeId":210370111,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":653305914,"text":"I've also left some of my savings to her. She's much brighter than I am. She can take care of herself.","nextNodeIds":[210370112]},{"nodeId":210370112,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":3465140650,"text":"And perhaps one day, she'll understand my decision.","nextNodeIds":[210370113]},{"nodeId":210370113,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":3848787106,"text":"Right, Traveler, can I ask you one more favor?","nextNodeIds":[210370114]},{"nodeId":210370114,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1112444802,"text":"Could you please fetch me some soil?","nextNodeIds":[210370115,210370116]},{"nodeId":210370115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1262276146,"text":"I can help with that...","nextNodeIds":[210370117]},{"nodeId":210370117,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":799158194,"text":"For someone like me who is about to leave his hometown, he'd want to bring some souvenirs with him, right?","nextNodeIds":[210370118]},{"nodeId":210370118,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1631018290,"text":"With Liyue's soil carried with me, I can at least say that I haven't been completely disconnected from this land.","nextNodeIds":[210370119]},{"nodeId":210370119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2715451730,"text":"Why don't you fetch it yourself?","nextNodeIds":[210370120]},{"nodeId":210370120,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2481720026,"text":"Hahaha... Like I said, if I were to walk around this place, tons of memories would sure come flooding back...","nextNodeIds":[210370121]},{"nodeId":210370121,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1203505426,"text":"And then, I'm afraid that the little courage I've finally mustered to leave my hometown would disappear.","nextNodeIds":[210370122]},{"nodeId":210370122,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":442328674,"text":"So, I can only leave the task to you, Traveler. I'll mark the location for you.","nextNodeIds":[210370123]},{"nodeId":210370123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2219246538,"text":"What's so special about that place?","nextNodeIds":[210370124]},{"nodeId":210370124,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2256481570,"text":"Ahem... I used to practice my swordsmanship with Que'er there...","nextNodeIds":[210370125]},{"nodeId":210370125,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":4029717178,"text":"Anyway! I'll be leaving the task to you, Traveler.","nextNodeIds":[]},{"nodeId":210370116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1844263098,"text":"What do you need it for?","nextNodeIds":[210370117]},{"nodeId":210370107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2896595402,"text":"You are not going to walk around this place one last time?","nextNodeIds":[210370108]}]},{"talkId":2103704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2103701","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2103704,"initDialog":210370401,"nextRandomTalks":[],"nextTalks":[],"npcId":[2418,2079],"performCfg":"QuestDialogue/IQ/Liyue_21037/Q2103704","priority":5,"questId":21037,"showRandomTalkCount":0},"dialogs":[{"nodeId":210370401,"roleType":"TALK_ROLE_NPC","speakerId":2418,"speakerName":"Little Que'er","textMapHash":1562566170,"text":"He must've been on purpose, Zhiruo! He just... He just doesn't want to be with me! *whimper*","nextNodeIds":[210370402]},{"nodeId":210370402,"roleType":"TALK_ROLE_NPC","speakerId":2079,"speakerName":"Zhiruo","textMapHash":2230924218,"text":"Que'er, you and he have spent so much time together, he must know what you're thinking.","nextNodeIds":[210370403]},{"nodeId":210370403,"roleType":"TALK_ROLE_NPC","speakerId":2079,"speakerName":"Zhiruo","textMapHash":1599222106,"text":"This time, he's determined to leave Liyue and travel abroad, he must have his reasons. So what's the harm if you travel with him?","nextNodeIds":[210370404]},{"nodeId":210370404,"roleType":"TALK_ROLE_NPC","speakerId":2418,"speakerName":"Little Que'er","textMapHash":2408306722,"text":"I just don't want to leave here! What's wrong with us staying here forever? The Guhua Clan... I couldn't care less about the Guhua Clan!","nextNodeIds":[210370405]},{"nodeId":210370405,"roleType":"TALK_ROLE_NPC","speakerId":2079,"speakerName":"Zhiruo","textMapHash":1982842554,"text":"Then why don't you tell him that?","nextNodeIds":[210370406]},{"nodeId":210370406,"roleType":"TALK_ROLE_NPC","speakerId":2418,"speakerName":"Little Que'er","textMapHash":2486783562,"text":"I... *sigh* He's been drawn to the whole idea of reviving the Clan. If he knew I'd said that, he must hate me...","nextNodeIds":[210370407]},{"nodeId":210370407,"roleType":"TALK_ROLE_NPC","speakerId":2079,"speakerName":"Zhiruo","textMapHash":321980514,"text":"*sigh* Que'er...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2103701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2400"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2103703,"order":3,"stepDescription":"Collect some soil for Sun Yu","stepDescTextMapHash":4132677492,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"q2103703"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYE