{"mainQuestId":74137,"title":"Radiant Harvest: Cause and Effect","description":"On the shores of Romaritime Harbor, a merchant named Kesean appears to be in a bit of a pickle...","titleTextMapHash":2613096919,"descTextMapHash":3866782326,"mainQuestExcel":{"mainQuestId":74137,"titleTextMapHash":2613096919,"title":"Radiant Harvest: Cause and Effect","descTextMapHash":3866782326,"description":"On the shores of Romaritime Harbor, a merchant named Kesean appears to be in a bit of a pickle...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5157,"luaPath":"Actor/Quest/WQ74137","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5157,"chapterId":0,"descTextMapHash":3866782326,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74137,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1282956801,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74137","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174137],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2613096919,"type":"WQ","unlockDescTextMapHash":1537197454}},"flow":[{"subQuestId":7413701,"order":1,"stepDescription":"Go to the vicinity of Romaritime Harbor","stepDescTextMapHash":236043444,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7413701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30420"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7413701],"talks":[{"talkId":7413701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7413701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7413701,"initDialog":741370101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5133,30420],"performCfg":"QuestDialogue/WQ/Fontaine_74137/Q7413701","priority":5,"questId":74137,"showRandomTalkCount":0},"dialogs":[{"nodeId":741370101,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":2174251778,"text":"\"The expert panel has confirmed that the 'Violetglow Jellyfish' sold by the defendant has caused a significant negative impact on the local ecology, and seriously disrupted the normal activities of native underwater organisms.\"","nextNodeIds":[741370102]},{"nodeId":741370102,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":807797890,"text":"\"...The evidence is conclusive, and the defendant has been declared guilty of the crime of ecological destruction.\"","nextNodeIds":[741370103]},{"nodeId":741370103,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":2005732186,"text":"W—Wait... I really didn't know anything! I wasn't the one who released them!","nextNodeIds":[741370104]},{"nodeId":741370104,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":3057716706,"text":"\"...In light of the defendant's lack of conscious criminal intent, the defendant is hereby specially permitted to make amends for their crime.\"","nextNodeIds":[741370105]},{"nodeId":741370105,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":2842361066,"text":"\"If the defendant could retrieve all Violetglow Jellyfish within the designated waters within a certain time limit, certain sanctions may be waived.\"","nextNodeIds":[741370106]},{"nodeId":741370106,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":579229146,"text":"Retrieve!? How can I possibly do that? C—Could you please reconsider? Even a bigger fine would do...","nextNodeIds":[741370107]},{"nodeId":741370107,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":3175648234,"text":"\"...Please see the appendix for details on the time limit.\" ...Sir, there is no use in trying to negotiate with me. Furthermore, you are wasting your precious time trying to argue when you could be coming up with a retrieval plan instead.","nextNodeIds":[741370108]},{"nodeId":741370108,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1854362434,"text":"*sigh* Those people just bought jellyfish and released them everywhere. I'm no good at swimming... How am I supposed to retrieve them... I knew I shouldn't have sold them...","nextNodeIds":[741370109]},{"nodeId":741370109,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":1006548026,"text":"The Gardes will continue to investigate those who released them without permission. But, in any case...","nextNodeIds":[741370110]},{"nodeId":741370110,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":3026952826,"text":"You were the one who bred these jellyfish, and you were the one who sold them off the record. The one who failed to remind buyers not to release them was also you.","nextNodeIds":[741370111]},{"nodeId":741370111,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":3447018546,"text":"Frankly speaking, this sentence is already quite generous.","nextNodeIds":[741370112]},{"nodeId":741370112,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3818141450,"text":"Ugh... I should have known better. I should've signed a disclaimer when I sold the jellyfish...","nextNodeIds":[741370113]},{"nodeId":741370113,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","textMapHash":3072091658,"text":"Anyway, I hope you'll make use of this generous sentence and rectify the situation. I also hope that the next time we meet, it won't be in the Fortress of Meropide.","nextNodeIds":[741370114]},{"nodeId":741370114,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1630798490,"text":"Kesean despondently watches Augereau leave...","nextNodeIds":[741370115]},{"nodeId":741370115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3609655986,"text":"Whoa, are you alright? You look quite pale...","nextNodeIds":[741370116,741370117]},{"nodeId":741370116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3540673234,"text":"What is this \"Violetglow Jellyfish\"?","nextNodeIds":[741370118]},{"nodeId":741370118,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3917509506,"text":"...You guys heard all that? I'm sorry, but I don't have time to chat right now. I've got to put up a commission at the Adventurers' Guild or hire a diver...","nextNodeIds":[741370119]},{"nodeId":741370119,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":2502319858,"text":"...But putting up a commission takes time, and I don't know how to hire a diver... Argh!!! Am I really going to end up at the Fortress of Meropide?","nextNodeIds":[741370120]},{"nodeId":741370120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3977723842,"text":"#{NICKNAME}, Paimon is smelling a business opportunity... no... an opportunity to help another person!","nextNodeIds":[741370121,741370122]},{"nodeId":741370121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2041144186,"text":"So, you're looking for an adventurer?","nextNodeIds":[741370123]},{"nodeId":741370123,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3048844202,"text":"Yeah... Hang on, you... are you saying you're one?","nextNodeIds":[741370124]},{"nodeId":741370124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":219237058,"text":"#Hehe! You've got just the right person. {NICKNAME}'s the best diver among adventurers!","nextNodeIds":[741370125]},{"nodeId":741370125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3988611706,"text":"And the best adventurer among divers.","nextNodeIds":[741370126]},{"nodeId":741370126,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1800170674,"text":"#Thank the heavens! Finally, a lucky break after ages of bad luck! {M#Mr.}{F#Miss} Adventurer, please help me! Payment won't be an issue, I promise!","nextNodeIds":[741370127]},{"nodeId":741370127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3589852442,"text":"Tell me what's going on exactly first.","nextNodeIds":[741370128]},{"nodeId":741370128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4190331810,"text":"Yeah! We just saw you get charged with something... It wasn't anything serious, was it? If so, we ain't helpin'!","nextNodeIds":[741370129]},{"nodeId":741370129,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":2900442066,"text":"No no, it was nothing of that sort... You see, I was trained as a researcher in biology, and during one of my recent experiments, I accidentally bred a batch of glowing jellyfish.","nextNodeIds":[741370130]},{"nodeId":741370130,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":688934306,"text":"They were originally meant to be disposed of after I finished my experiment, but I thought they looked rather pretty, so I thought I could sell them as pets for some quick mora...","nextNodeIds":[741370131]},{"nodeId":741370131,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":2325056682,"text":"After all, those studying biology don't usually make much mora...","nextNodeIds":[741370132]},{"nodeId":741370132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4088742682,"text":"Um... so did you end up making any mora?","nextNodeIds":[741370133]},{"nodeId":741370133,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3022557354,"text":"Well, doing business is certainly easier than doing biology... I did make some mora, but I also brought a lot of trouble upon myself.","nextNodeIds":[741370134]},{"nodeId":741370134,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3945818858,"text":"This was my first time in the pet biz, and I didn't think things through, especially when it came to buyers who bought pets just to release them...","nextNodeIds":[741370135]},{"nodeId":741370135,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":175074674,"text":"My guess is that they felt bad for these little creatures born in a lab, and released them as soon as they got their hands on them.","nextNodeIds":[741370136]},{"nodeId":741370136,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":655358130,"text":"Unfortunately, these jellyfish that I specially bred are incompatible with the local ecosystem, especially due to their tendency to gather and glow in clusters...","nextNodeIds":[741370137]},{"nodeId":741370137,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":4048349314,"text":"...They can easily change the amount of light available at different depths of the water, and disrupt the normal activities of other species, thereby impacting the ecological equilibrium...","nextNodeIds":[741370138]},{"nodeId":741370138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2295658754,"text":"W—Wait, so they like gathering, and glowing, and can impact some kind of equilibrium... Can you put it in a simpler way?","nextNodeIds":[741370139]},{"nodeId":741370139,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":4152198370,"text":"Oh, sorry about that. That's just a bad old habit of mine... You guys know of those fish species that are only active during the day or night, right?","nextNodeIds":[741370140]},{"nodeId":741370140,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1305389162,"text":"Well, the behavior of some underwater creatures is closely tied to the amount of light in the water, and as soon as an unnatural light source is brought into the equation, that behavior is easily disrupted...","nextNodeIds":[741370141]},{"nodeId":741370141,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1063777674,"text":"...I used to have peers who did research on fishing with artificial lights...","nextNodeIds":[741370142,741370143]},{"nodeId":741370142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":744670234,"text":"You're getting off track again.","nextNodeIds":[741370144]},{"nodeId":741370144,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":870774346,"text":"Ah... please excuse me. Long story short, the Gardes recently discovered an unusual glow in the waters at various places.","nextNodeIds":[741370145]},{"nodeId":741370145,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1530134226,"text":"After an investigation, they concluded that the glow were light released by clusters of Violetglow Jellyfish.","nextNodeIds":[741370146]},{"nodeId":741370146,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":2699087802,"text":"Although I wasn't the one who released them, I was the one who sold them. They ordered me to clean this mess up, or at the very least, cut down the jellyfish's numbers to a safe level.","nextNodeIds":[741370147]},{"nodeId":741370147,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3774987410,"text":"I'm a researcher... How could I possibly get into the water? Thank goodness you showed up at the right moment. Otherwise, I would have been able to do nothing as this bad luck sent me to rock bottom...","nextNodeIds":[741370148]},{"nodeId":741370148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3465833010,"text":"That does sound pretty unlucky... But you're not exactly innocent either...","nextNodeIds":[741370149]},{"nodeId":741370149,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1270702922,"text":"#...{M#Mr.}{F#Miss} Adventurer, please help me! I'm willing to compensate you generously in return!","nextNodeIds":[741370150]},{"nodeId":741370150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3922936714,"text":"#A generous compensation... {NICKNAME}, he seems to be trying to make up for his mistake. He's a good guy!","nextNodeIds":[741370151,741370152]},{"nodeId":741370151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":434691202,"text":"...Fine.","nextNodeIds":[741370153]},{"nodeId":741370153,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":91549530,"text":"Ahh, thank you so much! The Gardes are investigating the locations where the Violetglow Jellyfish were released. All you need to do is to go to each of the places, and catch as many of them as you can.","nextNodeIds":[741370154]},{"nodeId":741370154,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":399829314,"text":"Their range of activity is not large, and they don't move all that quickly, either...","nextNodeIds":[741370155]},{"nodeId":741370155,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1803325042,"text":"I believe that an ace diver like yourself should make quick work of them.","nextNodeIds":[741370156]},{"nodeId":741370156,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":2884626994,"text":"It should be pretty easy to spot the jellyfish. Just follow the light and swim around for a bit, and you should be able to find them.","nextNodeIds":[741370157]},{"nodeId":741370157,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3726963866,"text":"I'll always be here, so if there's anything you're unsure of, feel free to come ask me... Uh, that is, if I haven't been taken away to the Fortress of Meropide already...","nextNodeIds":[]},{"nodeId":741370152,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2075510602,"text":"What exactly do I need to do?","nextNodeIds":[741370153]},{"nodeId":741370143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1765379330,"text":"Focus on the main points.","nextNodeIds":[741370144]},{"nodeId":741370122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":959550922,"text":"So, you're looking for a diver?","nextNodeIds":[741370123]},{"nodeId":741370117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3843680058,"text":"What is this \"crime of ecological destruction\"?","nextNodeIds":[741370118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7413701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30420"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7413701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","count":29},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"Augereau","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":8},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174137],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3866782326,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74137/Q7413701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":741370101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7413701,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[5133,30420],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["7413701","2"],"_type":"QUEST_COND_STATE_EQUAL"}],"NIJAPEJKLDI":false,"NMKNFLIHHHE":false,"NMMOKMEKDJO":false,"NPGONNBAOOI":15442372358928725454,"OAIIIMFGNGM":false,"OAOCMNEPKOG":74137,"ODEOIJMOMPL":["[3_6224:1729.470,441.440,4935.436,0.000,172.087,0.000]","[3_6226:1730.136,441.440,4933.521,0.000,38.257,0.000]"],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST","PCCKKGAHFFJ":false,"PNACKFKJJHM":[]}],"IBNCKLKHAKG":0,"IEGCPJALJOA":0,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","ILHDNJDDEOP":74137,"ILICEMABDDI":[],"JAPLGJLDPHJ":[],"JDCIPCDDDPK":0,"JDEFCNEDMLL":5157,"KCONOGOIGIH":0,"LEFIHLHODBM":[],"LMCFKPMJGEO":false,"MEJIMPLKPHN":0,"MHHFFHCLDKI":false,"MMOEEOFGHHG":2613096919,"NJGLJLODPBN":true,"NKAKCKAJCLD":0,"NOCNCPAGOPC":"Actor/Quest/WQ74137","OPIDGNOCOHD":"QUEST_SHOW","PAINLIBBLDK":"WQ","PEDANLIDLGE":0,"PEFIFLDHPEE":false,"PIGICJKACHG":[],"PPJLLGCPCOL":{"HDHKBHOLGIM":{}}},"meta":{"questType":"WQ","series":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","showType":"QUEST_SHOW","repeatable":false,"recommendLevel":0,"chapterId":0,"chapterTitle":"","chapterNum":"","needPlayerLevel":null,"cityId":null,"cityName":"","unlockDesc":"","preMainQuestIds":[],"nextMainQuestIds":[74138],"rewardIdList":[174137],"rewards":[{"rewardId":174137,"items":[{"itemId":202,"name":"Mora","count":10000,"itemType":"ITEM_VIRTUAL","rank":10},{"itemId":104002,"name":"Adventurer's Experience","count":4,"itemType":"ITEM_MATERIAL","rank":100}],"playerExp":0,"hcoin":0,"scoin":0}]},"cutscenes":[]}