e_21030/Q2103001","priority":5,"questId":21030,"showRandomTalkCount":0},"dialogs":[{"nodeId":210300101,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":639195514,"text":"Eh? These two ores aren't the same either?","nextNodeIds":[210300102]},{"nodeId":210300102,"roleType":"TALK_ROLE_NPC","speakerId":2048,"speakerName":"Master Zhang","textMapHash":3857737218,"text":"Of course not. The quality and price of anything forged from either of these types of ores would be completely different.","nextNodeIds":[210300103]},{"nodeId":210300103,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":3219430186,"text":"Um, but... But this is all we have left of these two types, right?","nextNodeIds":[210300104]},{"nodeId":210300104,"roleType":"TALK_ROLE_NPC","speakerId":2048,"speakerName":"Master Zhang","textMapHash":1064733394,"text":"*sigh*","nextNodeIds":[210300105]},{"nodeId":210300105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1244261186,"text":"What are you two doing?","nextNodeIds":[210300106]},{"nodeId":210300106,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":1954953586,"text":"Hi there, Traveler! I'm currently helping Dad check on the ironware that he's ordered.","nextNodeIds":[210300107]},{"nodeId":210300107,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":521337194,"text":"Mister Blacksmith over here is totally the best! He said he'd forge me a small sword, too!","nextNodeIds":[210300108]},{"nodeId":210300108,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":1913372970,"text":"But he says that there haven't been enough raw materials to go around the store lately, so Dad's batch of ironware might be delayed...","nextNodeIds":[210300109]},{"nodeId":210300109,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":166946754,"text":"And I've got no idea when my sword will be ready, either...","nextNodeIds":[210300110]},{"nodeId":210300110,"roleType":"TALK_ROLE_NPC","speakerId":2048,"speakerName":"Master Zhang","textMapHash":3975740954,"text":"*sigh* Well, it can't be helped. We've been very busy lately, so we're more or less out of ore.","nextNodeIds":[210300111]},{"nodeId":210300111,"roleType":"TALK_ROLE_NPC","speakerId":2048,"speakerName":"Master Zhang","textMapHash":3175255122,"text":"The areas where ore is most plentiful are also occupied by many monsters, so I dare not go mining there...","nextNodeIds":[210300112]},{"nodeId":210300112,"roleType":"TALK_ROLE_NPC","speakerId":2048,"speakerName":"Master Zhang","textMapHash":1114601842,"text":"I can only try to tide this busy period over before asking an adventurer to escort me to an area where I can mine.","nextNodeIds":[210300113]},{"nodeId":210300113,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":1775697314,"text":"But when will that be...","nextNodeIds":[210300114]},{"nodeId":210300114,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":2651570930,"text":"Actually, Traveler, I've heard that you're really good at beating monsters. Is that true?","nextNodeIds":[210300115]},{"nodeId":210300115,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":4049516114,"text":"If it is, could you please help me out? Please...","nextNodeIds":[210300116,210300117]},{"nodeId":210300116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1535574554,"text":"Haha, alright.","nextNodeIds":[210300118]},{"nodeId":210300118,"roleType":"TALK_ROLE_NPC","speakerId":2048,"speakerName":"Master Zhang","textMapHash":3599289562,"text":"Traveler, are you going to check the situation out there? In that case, let me mark my usual mining spots on the map for you...","nextNodeIds":[210300119]},{"nodeId":210300119,"roleType":"TALK_ROLE_NPC","speakerId":2048,"speakerName":"Master Zhang","textMapHash":1254775218,"text":"Alright, that should do it. Be careful while you're there. Those places are crawling with monsters.","nextNodeIds":[210300120]},{"nodeId":210300120,"roleType":"TALK_ROLE_NPC","speakerId":2031,"speakerName":"Little Meng","textMapHash":1950939794,"text":"I'm counting on you then, Traveler!","nextNodeIds":[]},{"nodeId":210300117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":527429962,"text":"I'll... see what I can do.","nextNodeIds":[210300118]}]},{"talkId":2103003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2103001","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2103002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["",""