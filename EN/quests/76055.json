IDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7605501,7605502,7605503],"talks":[{"talkId":7605501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":4,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7605501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["10000119","0","0","0",""],"type":"QUEST_COND_PLAYER_TEAM_CONTAINS_AVATAR"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7605501,"initDialog":760550101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7144],"performCfg":"QuestDialogue/WQ/NodKrai_76055/Q7605501","priority":5,"questId":76055,"showRandomTalkCount":0},"dialogs":[{"nodeId":760550101,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2235217770,"text":"(<color=#FFCC33FF>Lauma</color> seems to have heard something...)","nextNodeIds":[760550102]},{"nodeId":760550102,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1971257226,"text":"...Strange. I'm sure I just heard something.","nextNodeIds":[760550103]},{"nodeId":760550103,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":3232543130,"text":"(Ah, guests! Come, come! Spin the wheel, then stop the wheel, and then there'll be good food!)","nextNodeIds":[760550104]},{"nodeId":760550104,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":823082098,"text":"(Huh? Why aren't you spinning the wheel? Go on, spin it. Good food awaits!)","nextNodeIds":[760550105]},{"nodeId":760550105,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2712557226,"text":"That sounds... like a little puppy? Spin the wheel for good food... What does that mean?","nextNodeIds":[760550106]},{"nodeId":760550106,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":2483880210,"text":"(Ho there, guests! You can speak to me! Well, please spin the wheel, then, or I shan't have anything delicious to eat!)","nextNodeIds":[760550107]},{"nodeId":760550107,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":518208362,"text":"Are you hungry, then? I've brought some biscuits. Here, have one.","nextNodeIds":[760550108]},{"nodeId":760550108,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":895703546,"text":"(Hmm? You're not spinning the wheel, but you want to give me food... Hmm, sure. I'll grab some first. Why not?)","nextNodeIds":[760550109]},{"nodeId":760550109,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":3058262522,"text":"(Thank you, guest. Pavlov's the name, and thanks for the biscuit. It was dee-licious! Still, you didn't spin the wheel.)","nextNodeIds":[760550110]},{"nodeId":760550110,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":4176912994,"text":"You're quite welcome... But if I might ask, what do you mean by \"spinning the wheel\"?","nextNodeIds":[760550111]},{"nodeId":760550111,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":1385538122,"text":"(If the wheel is spun, then stopped, good food will drop down. That's how it always is.)","nextNodeIds":[760550112]},{"nodeId":760550112,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":3502891466,"text":"(Won't you spin the wheel, dear guest? Everyone feels happy after spinning it.)","nextNodeIds":[760550113]},{"nodeId":760550113,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":349509522,"text":"I suppose I shan't. It seems... you are living well here?","nextNodeIds":[760550114]},{"nodeId":760550114,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":905279458,"text":"(Of course, of course! People play with me, the wheel plays with me, and there's good food.)","nextNodeIds":[760550115]},{"nodeId":760550115,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2066994594,"text":"Then that is well. Say hello to your owner for me. I'll be off now.","nextNodeIds":[760550116]},{"nodeId":760550116,"roleType":"TALK_ROLE_NPC","speakerId":7145,"speakerName":"Pavlov","textMapHash":601567898,"text":"(Ohh... See you, guest! Come again!)","nextNodeIds":[]}]},{"talkId":7605502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7605501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","2201","0","",""],"type":"QUEST_COND_PLAYER_HAVE_AVATAR"},{"param":["0","2201","0","0",""],"type":"QUEST_COND_PLAYER_TEAM_NOT_CONTAINS_AVATAR"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7605502,"initDialog":760550201,"nextRandomTalks":[],"nextTalks":[],"npcId":[7144],"performCfg":"","priority":5,"questId":76055,"showRandomTalkCount":0},"dialogs":[{"nodeId":760550201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":766086170,"text":"(Hmm? Is that some <color=#FFCC33FF>small animal</color> I hear...?)","nextNodeIds":[760550202]},{"nodeId":760550202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":345728746,"text":"(If there was someone present who could understand animal speech, perhaps they'd be able to pinpoint the source of this sound...)","nextNodeIds":[]}]},{"talkId":7605503,"talkCo