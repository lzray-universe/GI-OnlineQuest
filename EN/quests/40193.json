Cfg":"QuestDialogue/EQ/V5.4DQDHD_40193/Q4019302","priority":5,"questId":40193,"showRandomTalkCount":0},"dialogs":[{"nodeId":401930201,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":804335986,"text":"Following Itto's constant nagging, you all head to Aisa Bathhouse once again...","nextNodeIds":[401930202]},{"nodeId":401930202,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":49219730,"text":"Hahaha! This has gotta be the hottest one! Let's see who can last the longest! Who's in?","nextNodeIds":[401930203]},{"nodeId":401930203,"roleType":"TALK_ROLE_NPC","speakerId":1033,"speakerName":"Thoma","textMapHash":3571747314,"text":"Hehe, if you're that excited about it, how can I refuse?","nextNodeIds":[401930204]},{"nodeId":401930204,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"Kuki Shinobu","textMapHash":427720546,"text":"Listen... This isn't a sauna...","nextNodeIds":[401930205]},{"nodeId":401930205,"roleType":"TALK_ROLE_NPC","speakerId":1040,"speakerName":"Sayu","textMapHash":656345522,"text":"Ahhh... so warm... *snore*","nextNodeIds":[401930206]},{"nodeId":401930206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3210154626,"text":"Hey, don't fall asleep in the tub!","nextNodeIds":[401930207]},{"nodeId":401930207,"roleType":"TALK_ROLE_NPC","speakerId":1039,"speakerName":"Gorou","textMapHash":784598674,"text":"Uh... My fur is so heavy. I almost feel dizzy...","nextNodeIds":[401930208]},{"nodeId":401930208,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3908387418,"text":"Hahaha! If you can't handle the heat, Gorou, get out of the... tub!","nextNodeIds":[401930209]},{"nodeId":401930209,"roleType":"TALK_ROLE_NPC","speakerId":1038,"speakerName":"Kujou Sara","textMapHash":657396458,"text":"Hey! Stop being so loud!","nextNodeIds":[401930210]},{"nodeId":401930210,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":185830674,"text":"On the other side...","nextNodeIds":[401930211]},{"nodeId":401930211,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":2457685010,"text":"Heh, Itto is as energetic as ever.","nextNodeIds":[401930212]},{"nodeId":401930212,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":2999681650,"text":"It's not good to get distracted during a match, brother.","nextNodeIds":[401930213]},{"nodeId":401930213,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":4224514650,"text":"#Whoa! This game is getting heated! What's your next move, {NICKNAME}? What do you two think?","nextNodeIds":[401930214]},{"nodeId":401930214,"roleType":"TALK_ROLE_NPC","speakerId":1037,"speakerName":"Sangonomiya Kokomi","textMapHash":3034940130,"text":"Hm... I would take it slow, try to consolidate my advantage.","nextNodeIds":[401930215]},{"nodeId":401930215,"roleType":"TALK_ROLE_NPC","speakerId":1057,"speakerName":"Shikanoin Heizou","textMapHash":3821735906,"text":"Or, you could be aggressive... taking a risk isn't a bad idea!","nextNodeIds":[401930216,401930217]},{"nodeId":401930216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":803023178,"text":"(Go slow and steady)","nextNodeIds":[401930218]},{"nodeId":401930218,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":1432081618,"text":"#Oh? Very clever, {NICKNAME}! A decisive defeat... I concede! Now, based on the random draw earlier, the next player should be...","nextNodeIds":[401930219]},{"nodeId":401930219,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":1147379386,"text":"Ayaka! Have fun, you two.","nextNodeIds":[401930220]},{"nodeId":401930220,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"Kamisato Ayaka","textMapHash":4029746882,"text":"#Oh, uh... Okay! Go easy on me, {NICKNAME}...","nextNodeIds":[401930221]},{"nodeId":401930221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2659930458,"text":"(Ayato must have lost to me on purpose to give Ayaka more time to play... Always up to something, that one...)","nextNodeIds":[]},{"nodeId":401930217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2397632402,"text":"(Be aggressive!)","nextNodeIds":[401930218]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4019302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133220817"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[1202_3:-11.715,2.036,-12.211]"],"NOCCOBOFKHP":1202,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4019303,"order":4,"stepDescription":"Go to the Aisa Bathhouse","stepDescTextMapHash":1091227884,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4019303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_322001355:-3115.168,253.294,-4457.596]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[4019303],"talks":[{"talkId":4019303