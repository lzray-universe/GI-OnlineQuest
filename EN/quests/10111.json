LPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[1011104],"talks":[{"talkId":1011104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1011104","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1011104,"initDialog":101110401,"nextRandomTalks":[],"nextTalks":[],"npcId":[141101,141301],"performCfg":"QuestDialogue/LQ/Wendy1_10111/Q1011104","priority":5,"questId":10111,"showRandomTalkCount":0},"dialogs":[{"nodeId":101110401,"roleType":"TALK_ROLE_NPC","speakerId":141101,"speakerName":"Stanley","textMapHash":3269167197,"text":"*panting*","nextNodeIds":[101110402]},{"nodeId":101110402,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":790015917,"text":"I was so sure I was about to die!","nextNodeIds":[101110403]},{"nodeId":101110403,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1766079141,"text":"To be fair, that could have gone either way.","nextNodeIds":[101110404]},{"nodeId":101110404,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2278938213,"text":"So — you must be Jack the Adventurer, I assume?","nextNodeIds":[101110405]},{"nodeId":101110405,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":1583346125,"text":"Yes... Who are you?","nextNodeIds":[101110406]},{"nodeId":101110406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3165519349,"text":"Actually, we came looking for you.","nextNodeIds":[101110407]},{"nodeId":101110407,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1914487229,"text":"Ellin has a message for you. She said she won't be able to join you today to plan out your next adventure together. She'll join you some other time.","nextNodeIds":[101110408]},{"nodeId":101110408,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":2239014413,"text":"Oh, I see... I feel bad you had to come all this way to find me... and then had to rescue me...","nextNodeIds":[101110409]},{"nodeId":101110409,"roleType":"TALK_ROLE_NPC","speakerId":141101,"speakerName":"Stanley","textMapHash":3432670501,"text":"Huh? I don't see what all the fuss is about. It was nothing that I, Stanley, couldn't have dealt with by myself!","nextNodeIds":[101110410]},{"nodeId":101110410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2457496645,"text":"Whoa, you're Stanley? You're that legendary adventurer? Renowned in all of Mondstadt? Who once set foot in the Mare Jivari!?","nextNodeIds":[101110411]},{"nodeId":101110411,"roleType":"TALK_ROLE_NPC","speakerId":141101,"speakerName":"Stanley","textMapHash":2116600053,"text":"Hehehe, the very same!","nextNodeIds":[101110412]},{"nodeId":101110412,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3427887701,"text":"Hahaha! I must say, it's an honor to meet one as legendary as yourself.","nextNodeIds":[101110413]},{"nodeId":101110413,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2232550877,"text":"Well then, how would everyone like to proceed? Head back, or head further inside?","nextNodeIds":[101110414,101110417]},{"nodeId":101110414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4231857549,"text":"Stanley, what do you think?","nextNodeIds":[101110415]},{"nodeId":101110415,"roleType":"TALK_ROLE_NPC","speakerId":141101,"speakerName":"Stanley","textMapHash":247340037,"text":"Hehehe, well... I think you're now in the safe hands of Stanley, the great explorer and legend of Mondstadt!","nextNodeIds":[101110416]},{"nodeId":101110416,"roleType":"TALK_ROLE_NPC","speakerId":141101,"speakerName":"Stanley","textMapHash":594181189,"text":"In which case, why head back now?","nextNodeIds":[101110419]},{"nodeId":101110419,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3995424973,"text":"Okay, motion passed by unanimous consent! Let's head further in.","nextNodeIds":[]},{"nodeId":101110417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1424954941,"text":"Jack, what do you think?","nextNodeIds":[101110418]},{"nodeId":101110418,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":160796821,"text":"I think we should keep going. With Stanley by our side, we'll have no problem.","nextNodeIds":[101110419]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1011104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1011,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[3,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_MY_WORLD","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUE