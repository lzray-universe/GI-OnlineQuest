}},{"subQuestId":1011106,"order":9,"stepDescription":"","stepDescTextMapHash":3571538046,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1011106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[1011106],"talks":[{"talkId":1011106,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1011106","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1011106,"initDialog":101110601,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/LQ/Wendy1_10111/Q1011106","priority":5,"questId":10111,"showRandomTalkCount":0},"dialogs":[{"nodeId":101110601,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2254145421,"text":"Traveler, I believe I have made a small discovery.","nextNodeIds":[101110602]},{"nodeId":101110602,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3924434637,"text":"Could I ask you to use the nirnama detector once more?","nextNodeIds":[101110603]},{"nodeId":101110603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1767238109,"text":"What? Stanley has an imaginary friend?","nextNodeIds":[101110604]},{"nodeId":101110604,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1037038701,"text":"It seems his imaginary friend is a seasoned warrior... covered in scars from head to foot, and a look of staunch determination on his face.","nextNodeIds":[101110605,101110608]},{"nodeId":101110605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3083712613,"text":"It fits Stanley's description of himself.","nextNodeIds":[101110606]},{"nodeId":101110606,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3310445029,"text":"You're saying his imaginary friend is an idealized version of his own self?","nextNodeIds":[101110607]},{"nodeId":101110607,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1477888413,"text":"Interesting idea! But is it true?","nextNodeIds":[101110611]},{"nodeId":101110611,"roleType":"TALK_ROLE_NPC","speakerId":141101,"speakerName":"Stanley","textMapHash":2925411173,"text":"Please excuse me, I'll be leaving now.","nextNodeIds":[101110612]},{"nodeId":101110612,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":2857110789,"text":"Bye, Stanley!","nextNodeIds":[101110613]},{"nodeId":101110613,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":245688061,"text":"Do you two still have time to spare?","nextNodeIds":[101110614]},{"nodeId":101110614,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":563695021,"text":"What is it?","nextNodeIds":[101110615]},{"nodeId":101110615,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":1301084781,"text":"A few days ago, Stanley got drunk and told me a secret — something he's never told anyone before.","nextNodeIds":[101110616]},{"nodeId":101110616,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":72337197,"text":"The weapons he took on his adventure all those years ago... they were none other than those once wielded by Mondstadt's greatest hero, Vennessa herself! The <color=#00E1FFFF>Sword of Brilliant Valor</color> and the <color=#00E1FFFF>Shield of Magnificent Honor</color>!","nextNodeIds":[101110617]},{"nodeId":101110617,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":2356249101,"text":"I don't know whether you believe me, but... apparently, both the sword and shield are still right here in Mondstadt, over in <color=#00E1FFFF>Dadaupa Gorge</color>!","nextNodeIds":[101110618]},{"nodeId":101110618,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":3947341117,"text":"Since you guys are the experts at this... Can you come with me to try and retrieve these two legendary weapons?","nextNodeIds":[101110619,101110621]},{"nodeId":101110619,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2262147277,"text":"Stanley seriously owned these weapons?","nextNodeIds":[101110620]},{"nodeId":101110620,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":3281829077,"text":"You bet! This is Stanley we're talking about!","nextNodeIds":[101110623]},{"nodeId":101110623,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":2986273053,"text":"If I can just get ahold of something impressive enough to show my family what I'm capable of, maybe they'll finally come around to the idea of me being an adventurer...","nextNodeIds":[101110624]},{"nodeId":101110624,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":1563056893,"text":"Right now, I'm just a rookie. My abilities are limited, and my parents don't support my goals one bit...","nextNodeIds":[101110625]},{"nodeId":101110625,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":2905038421,"text":"So, what do you say? Help a guy out?","nextNodeIds":[101110626]},{"nodeId":101110626,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":1261656181,"text":"I can't bring myself to tell Stanley about it, because my reasons are so... selfish. But, I swear I'll give the weapons back to him as soon as I'm done!","nextNodeIds":[101110627]},{"nodeId":101110627,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2955239997,"text":"Aw, poor Jack... Let's help him out!","nextNodeIds":[101110628,101110629]},{"nodeId":101110628,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":312938749,"text":"Alright then.","nextNodeIds":[101110630]},{"nodeId":101110630,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":892620925,"text":"Venti, you coming too?","nextNodeIds":[101110631]},{"nodeId":101110631,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":359960469,"text":"Mm... I don't know...","nextNodeIds":[101110632]},{"nodeId":101110632,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":3784469301,"text":"Oh, one other thing — I have a bottle of rare vintage wine that I had someone fetch for me a couple years ago. Help me find these weapons and it's all yours!","nextNodeIds":[101110633]},{"nodeId":101110633,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3774487541,"text":"Oh, <color=#00E1FFFF>Dadaupa Gorge</color>, was it? Hehe, let's hurry, there's no time to lose!","nextNodeIds":[]},{"nodeId":101110629,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1698461813,"text":"Hard to say no after that sob story.","nextNodeIds":[101110630]},{"nodeId":101110621,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3979197021,"text":"Why did he abandon them in the wild, then?","nextNodeIds":[101110622]},{"nodeId":101110622,"roleType":"TALK_ROLE_NPC","speakerId":141301,"speakerName":"Jack","textMapHash":3848893405,"text":"I dunno, outstanding individuals always come with their quirks, right?","nextNodeIds":[101110623]},{"nodeId":101110608,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3165594461,"text":"I knew there was something weird about his story...","nextNodeIds":[101110609]},{"nodeId":101110609,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":515482373,"text":"Oh? You thought so too, huh?","nextNodeIds":[101110610]},{"nodeId":101110610,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2057053349,"text":"I agree. He wasn't telling the whole story.","nextNodeIds":[101110611]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1011106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[3,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_MY_WORLD","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1011029,1011104,1011106],"speakerCounts":[{"roleType":"TALK_ROLE_NPC