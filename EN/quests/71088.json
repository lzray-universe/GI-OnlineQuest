{"mainQuestId":71088,"title":"","description":"","titleTextMapHash":3695992391,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":71088,"titleTextMapHash":3695992391,"title":"","descTextMapHash":4020445438,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ71088","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":4020445438,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71088,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3184801993,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71088","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3695992391,"type":"WQ","unlockDescTextMapHash":3640311142}},"flow":[{"subQuestId":7108801,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104001,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7108802],"talks":[{"talkId":7108802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7108801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7108802,"initDialog":710880201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2618],"performCfg":"","priority":5,"questId":71088,"showRandomTalkCount":0},"dialogs":[{"nodeId":710880201,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1451385322,"text":"Why, hello! It's you!","nextNodeIds":[710880221]},{"nodeId":710880221,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3411261682,"text":"Hah, they actually managed to get you to come here.","nextNodeIds":[710880202,710880203]},{"nodeId":710880202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3945603314,"text":"Yes, it's me.","nextNodeIds":[710880204]},{"nodeId":710880204,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":164509842,"text":"Ah, my apologies, please! My name is Khedive. Khedive Pursina.","nextNodeIds":[710880205]},{"nodeId":710880205,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3614214882,"text":"If you know anything of the history of the Akademiya, you would know that our founder was once the rival of the Purbirunis in the field of astronomy...","nextNodeIds":[710880206,710880208]},{"nodeId":710880206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1306661082,"text":"#Well, I'm {NICKNAME}.","nextNodeIds":[710880207]},{"nodeId":710880207,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1586828378,"text":"Ah, there's no need for you to introduce yourself so specifically. Your name and its fame have long reached my ears.","nextNodeIds":[710880211]},{"nodeId":710880211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1118218538,"text":"What are you doing here?","nextNodeIds":[710880212]},{"nodeId":710880212,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3016998570,"text":"I'm a researcher who was specifically called in by the Ministry of Civil Affairs. My task is to study the changes that have occurred in life forms within The Chasm before it reopens, and to examine any items of paleontological interest...","nextNodeIds":[710880213]},{"nodeId":710880213,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":2785719698,"text":"Of course, it has been agreed that I shall share the results of my research with the historical society here in Liyue.","nextNodeIds":[710880214]},{"nodeId":710880214,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3333543794,"text":"*sigh* I know what you're thinking, and to be honest this does, in principle, violate the rules of the Akademiya. But the Liyue authorities were quite firm about this. I doubt anyone could have moved them an inch.","nextNodeIds":[710880215]},{"nodeId":710880215,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1282004346,"text":"Additionally, the exploration team has been signed under my name, and I am to pay for the salaries of all the camp's miners out of pocket... So if we don't get results, it'll be quite the loss for me.","nextNodeIds":[710880216,710880217]},{"nodeId":710880216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2565744682,"text":"That's true...","nextNodeIds":[710880218]},{"nodeId":710880218,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":2689334474,"text":"It's fine, though. I've got the Mora.","nextNodeIds":[710880219]},{"nodeId":710880219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4237445506,"text":"Alright, then. See you.","nextNodeIds":[710880220]},{"nodeId":710880220,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1074979106,"text":"See you!","nextNodeIds":[]},{"nodeId":710880217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1025950178,"text":"That sounds really rough.","nextNodeIds":[710880218]},{"nodeId":710880208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1470315050,"text":"Is announcing your academic school of thought tradition in Sumeru?","nextNodeIds":[710880209]},{"nodeId":710880209,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":482024850,"text":"Ah, no, no... It is just... Let's just call it a scholar's pride, shall we?","nextNodeIds":[710880210]},{"nodeId":710880210,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3685238250,"text":"Actually, you know what? I blame Anisa for infecting me with the Purbirunis' bad habit in that regard.","nextNodeIds":[710880211]},{"nodeId":710880203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4018153714,"text":"Do I know you?","nextNodeIds":[710880204]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104001,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7108802,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103701,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7108803],"talks":[{"talkId":7108803,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7108802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7108803,"initDialog":710880301,"nextRandomTalks":[],"nextTalks":[],"npcId":[2197],"performCfg":"","priority":5,"questId":71088,"showRandomTalkCount":0},"dialogs":[{"nodeId":710880301,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":151137338,"text":"Huh, it's a new face. Ho there, youngster!","nextNodeIds":[710880302]},{"nodeId":710880302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2812863818,"text":"\"New face?\"","nextNodeIds":[710880303]},{"nodeId":710880303,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":3852782586,"text":"Well, I don't quite know everyone here at the mine, but it's only polite to at least call everyone *something*, right? Still... you look like this is your first time here. Am I right?","nextNodeIds":[710880304]},{"nodeId":710880304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2287738106,"text":"#Indeed you are. {NICKNAME}'s the name, and the pleasure is all mine.","nextNodeIds":[710880305]},{"nodeId":710880305,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":2119422378,"text":"Jinwu. I'm in charge of the facilities here. I've worked at the mines for the past 20-odd years. To most of these lads, I'm their big sister. You have any questions, or the facilities give you any trouble? Give me a shout.","nextNodeIds":[710880306]},{"nodeId":710880306,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":1751906114,"text":"And if you're up for a few old stories, I'm up for telling them. I mean, if we're free, we're free to talk, eh?","nextNodeIds":[710880307,710880316,710880323,710880326]},{"nodeId":710880307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3868827650,"text":"Could you tell me about The Chasm's history?","nextNodeIds":[710880308]},{"nodeId":710880308,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":585557722,"text":"Wow, that's going to be quite the story. How about I give you a short introduction instead?","nextNodeIds":[710880309]},{"nodeId":710880309,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":3309315514,"text":"So The Chasm's the biggest mine in Liyue bar none, and it's also the oldest in the land — if you don't count the mine at Mt. Tianheng, that is.","nextNodeIds":[710880310]},{"nodeId":710880310,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":32963546,"text":"They say that indigenous tribes already existed here, gathering the Glazed Sand Crystal and trading completed porcelain products, long before Rex Lapis ever arrived.","nextNodeIds":[710880311]},{"nodeId":710880311,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":1378138930,"text":"Later, these tribes would make blood-pacts with the Lord of Geo's Yaksha and join him, thus becoming the forebears of Shenglu Hall, one of Liyue's Eight Trades.","nextNodeIds":[710880312]},{"nodeId":710880312,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":2404200994,"text":"They also took part in the great battles to subdue Azhdaha and repel the black calamity... They've contributed a lot to Liyue.","nextNodeIds":[710880313]},{"nodeId":710880313,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":249813818,"text":"See that valley over there to the northwest? They say that it is the trail left over after the Lord of Geo bodily dragged Azhdaha out of The Chasm.","nextNodeIds":[710880314]},{"nodeId":710880314,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":1157856746,"text":"Eventually, they would forsake their tribal lands and ways, and growing used to city life, would join the Lord of Geo in his dwelling, creating and selling porcelain for a living, forsaking their old militant roots.","nextNodeIds":[710880315]},{"nodeId":710880315,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":56539306,"text":"So yeah, those nitpickers at Shenglu Hall had ancestors who fought alongside Rex Lapis himself! Imagine that!","nextNodeIds":[]},{"nodeId":710880316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1567027354,"text":"Could you tell me more about The Chasm itself?","nextNodeIds":[710880317]},{"nodeId":710880317,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":500432770,"text":"I was there, you know, when they sealed this place up several years back. The lads down below dug up something truly...","nextNodeIds":[710880318]},{"nodeId":710880318,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":939415050,"text":"Well, I remember the long line of wounded that were carried back up to the surface, I'll tell you what...","nextNodeIds":[710880319]},{"nodeId":710880319,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":1478481450,"text":"Even spookier yet, the lads who were injured weren't necessarily hurt in the way you'd usually think miners would be. It was more like... spiritual or mental damage, you know?","nextNodeIds":[710880320]},{"nodeId":710880320,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":3668588802,"text":"They'd recover a few days after being brought up to the surface, so there wasn't much serious damage done in the end, but that was enough to get the Qixing to step in.","nextNodeIds":[710880321]},{"nodeId":710880321,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":1431996266,"text":"Doesn't matter what exactly they dug up, but I'll bet you that it was nothing good. The folks at Yujing Terrace reckoned so, too... and so they sealed The Chasm off completely.","nextNodeIds":[710880322]},{"nodeId":710880322,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":416871170,"text":"Now that sure got Shenglu Hall riled up... though that's a story for another day.","nextNodeIds":[]},{"nodeId":710880323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4013484138,"text":"Tell me about your work...","nextNodeIds":[710880324]},{"nodeId":710880324,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":1733701626,"text":"Me? I manage equipment. Nothing too exciting, mind! I spent the last 20-plus years tinkering with miners' ore-lamps and water filters while other kids went to school, s'all.","nextNodeIds":[710880325]},{"nodeId":710880325,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":3060022778,"text":"#{F#Take note, girl, don't get into this line of work. It's sweat and hard labor all day, every day. Not worth it.}{M#Met batch after batch of miners while I was at it. Some of them weren't hardly any older than you when they first went in.}","nextNodeIds":[]},{"nodeId":710880326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":80665762,"text":"Could you tell me about the Seven-Star Array?","nextNodeIds":[710880327]},{"nodeId":710880327,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":2625135946,"text":"That's a little something that the Qixing set up. Tell you what, it certainly bars the righteous, but not the wick... Hahah! Right, just kidding.","nextNodeIds":[710880328]},{"nodeId":710880328,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":826033866,"text":"Anyway, this array is the highest class of seal in the land as far as governance is concerned. If anyone sees it, they'll know what the consequences of breaking the seal will be, alright.","nextNodeIds":[710880329]},{"nodeId":710880329,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":3517739106,"text":"And that's why the Qixing used these ostentatious Bedrock Keys to anchor the array. Gotta send a message, make a show of force, y'know?","nextNodeIds":[710880330]},{"nodeId":710880330,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":3431356050,"text":"Gotta put the fear of Rex Lapis — or at least the fear of the Qixing's retribution — into the hearts of any thieves who might want to break the seal and steal some stuff.","nextNodeIds":[710880331]},{"nodeId":710880331,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","textMapHash":3165336058,"text":"*cough* In other words, if someone really does break the seals and does not suffer the consequences... It means that they at least have the tacit approval of the Qixing.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103701,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7108802,7108803],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"Jinwu","count":25},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":14},{"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","count":13}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":7108