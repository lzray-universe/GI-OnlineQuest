{"mainQuestId":74517,"title":"Operation Downpour Simulation","description":"In a corner of the Court of Fontaine, Turenna and Enghiene, members of the Special Security and Surveillance Patrol, have set up a new tabletop wargame. The stage is set for you to show off your tactical brilliance...","titleTextMapHash":2234857735,"descTextMapHash":3737133030,"mainQuestExcel":{"mainQuestId":74517,"titleTextMapHash":2234857735,"title":"Operation Downpour Simulation","descTextMapHash":3737133030,"description":"In a corner of the Court of Fontaine, Turenna and Enghiene, members of the Special Security and Surveillance Patrol, have set up a new tabletop wargame. The stage is set for you to show off your tactical brilliance...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5266,"luaPath":"Actor/Quest/WQ74517","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5266,"chapterId":0,"descTextMapHash":3737133030,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74517,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1470881057,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74517","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174517],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2234857735,"type":"WQ","unlockDescTextMapHash":141399534}},"flow":[{"subQuestId":7451701,"order":1,"stepDescription":"Talk to the members of the Maison Gardiennage","stepDescTextMapHash":3038507996,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30834"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7451701],"talks":[{"talkId":7451701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7451701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451701,"initDialog":745170101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30834,30835],"performCfg":"QuestDialogue/WQ/3405_74517/Q7451701","priority":5,"questId":74517,"showRandomTalkCount":0},"dialogs":[{"nodeId":745170101,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":1931806466,"text":"#Just as we set our strategy and picked our script, the Proto-Boss, {NICKNAME}, makes a grand entrance!","nextNodeIds":[745170102]},{"nodeId":745170102,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":94765738,"text":"Seriously? You believe in that old saying?","nextNodeIds":[745170103]},{"nodeId":745170103,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":3486868978,"text":"\"Sensing the heat of impending battle, the Proto-Boss will appear like a bullet from the dark — to commandeer their troops with ruthless efficiency...\"","nextNodeIds":[745170104,745170105]},{"nodeId":745170104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":23212202,"text":"Seems like I showed up right on cue.","nextNodeIds":[745170106]},{"nodeId":745170106,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":2039643282,"text":"I see! You mean to say that the velocity of our musket rounds can still be improved... I feel the same way.","nextNodeIds":[745170107]},{"nodeId":745170107,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":3951102626,"text":"#Put a sock in it, Turenna! We got {NICKNAME} to come all this way, so let's get down to business!","nextNodeIds":[745170108]},{"nodeId":745170108,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":948418242,"text":"Fair enough. Musket talk comes later, then. Now, Proto-Boss, I'm sure you're in top form, ready to lead your troops at any time, right?","nextNodeIds":[745170109,745170111]},{"nodeId":745170109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3267277226,"text":"Is this about a new tabletop wargame?","nextNodeIds":[745170110]},{"nodeId":745170110,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":4151173970,"text":"Right you are! The rules and layout have been updated according to scenarios faced by the Special Security and Surveillance Patrol.","nextNodeIds":[745170113]},{"nodeId":745170113,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":1148791010,"text":"Which is to say that this current iteration is more challenging. We've prepared a number of special scenarios, including some contributions from the Patrol's elites.","nextNodeIds":[745170114]},{"nodeId":745170114,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":1850741010,"text":"Some scenarios are seriously brain-boggling... So why don't you lead us by example, Proto-Boss?","nextNodeIds":[745170115]},{"nodeId":745170115,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":2682791050,"text":"Of course, you'll be handsomely compensated for your help. Go play, get paid — two birds with one stone!","nextNodeIds":[745170116,745170117]},{"nodeId":745170116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4027915314,"text":"Time to strut my stuff, then!","nextNodeIds":[745170118]},{"nodeId":745170118,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":3234538,"text":"#Just you watch, Turenna. No matter how good {NICKNAME} is, I'm sure the third Assault Scenario will be a real toughie...","nextNodeIds":[745170119]},{"nodeId":745170119,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":1006754170,"text":"#Nonsense! There's no way {M#he'll}{F#she'll} get stuck on that. Maybe you're just getting rusty, Drillmaster.","nextNodeIds":[745170120]},{"nodeId":745170120,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":4192984298,"text":"T—Turenna! The cheek of you!","nextNodeIds":[745170121]},{"nodeId":745170121,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":1863900882,"text":"Let's bet on it, Drillmaster! I wager... Some of Captain Chevreuse's limited-edition ammunition!","nextNodeIds":[]},{"nodeId":745170117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1334084210,"text":"Getting paid to play? That's the dream.","nextNodeIds":[745170118]},{"nodeId":745170111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2733579410,"text":"Umm, I don't quite get it...","nextNodeIds":[745170112]},{"nodeId":745170112,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":1906302514,"text":"Simply put, after we returned from that cooperative wargame in Liyue, we adapted it to suit the Special Patrol's current needs.","nextNodeIds":[745170113]},{"nodeId":745170105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3991889490,"text":"More like lightning than a bullet, no?","nextNodeIds":[745170106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30834"],"NOCCOBOFKHP":3,"OFEBJ