omTalks":[],"nextTalks":[],"npcId":[4070],"performCfg":"","priority":8,"questId":73673,"showRandomTalkCount":0},"dialogs":[{"nodeId":736730101,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":4016443794,"text":"Greetings, welcome to the Citadel of Regzar.","nextNodeIds":[736730102]},{"nodeId":736730102,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":2118801946,"text":"This is where the Corps of Thirty get in touch with each other and coordinate. I can see from your outfit that you are not one of them...","nextNodeIds":[736730103]},{"nodeId":736730103,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":4056374962,"text":"Oh, I see, you came for the recruitment, right?","nextNodeIds":[736730106,736730104]},{"nodeId":736730106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1679484930,"text":"That's right.","nextNodeIds":[736730107]},{"nodeId":736730107,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":3328295098,"text":"Very well then. I'll brief you on the gig in case it's not clear.","nextNodeIds":[736730108]},{"nodeId":736730108,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":3053493314,"text":"I am Effendi, a liaison sent by the Akademiya to coordinate the cooperation between the Akademiya and the Corps of Thirty.","nextNodeIds":[736730109]},{"nodeId":736730109,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":3426435162,"text":"You may have known that the Corps of Thirty is hired by the Akademiya to guard the whole Sumeru City.","nextNodeIds":[736730110]},{"nodeId":736730110,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":2610655866,"text":"They are additionally responsible for dealing with some problems residents encounter in daily life, which compounds their workload.","nextNodeIds":[736730111]},{"nodeId":736730111,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":2193370250,"text":"To ease the pressure, I decided to recruit an assistant after consulting with the Parchamdar.","nextNodeIds":[736730112]},{"nodeId":736730112,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":1709308490,"text":"You don't need to worry about city defense, just help us complete the residents' commissions.","nextNodeIds":[736730113]},{"nodeId":736730113,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":2053604170,"text":"As to the specifics, most of them are cumbersome and detailed. I'll elaborate with examples.","nextNodeIds":[]},{"nodeId":736730104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":46141042,"text":"Recruitment?","nextNodeIds":[736730105]},{"nodeId":736730105,"roleType":"TALK_ROLE_NPC","speakerId":4070,"speakerName":"Effendi","textMapHash":3909067290,"text":"You came without having a look at it? Never mind, I'll explain.","nextNodeIds":[736730108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["4070"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7367302,"order":2,"stepDescription":"Talk to Effendi","stepDescTextMapHash":3351159756,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPI