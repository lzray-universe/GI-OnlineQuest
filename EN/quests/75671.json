{"mainQuestId":75671,"title":"Finches Are Still the Cutest","description":"Somewhere in Atocpan, you and Paimon run into a cheerful researcher slash merchant slash expert on adorable creatures. She invites you to play a game...","titleTextMapHash":823156703,"descTextMapHash":1064164806,"mainQuestExcel":{"mainQuestId":75671,"titleTextMapHash":823156703,"title":"Finches Are Still the Cutest","descTextMapHash":1064164806,"description":"Somewhere in Atocpan, you and Paimon run into a cheerful researcher slash merchant slash expert on adorable creatures. She invites you to play a game...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5297,"luaPath":"Actor/Quest/WQ75671","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5297,"chapterId":0,"descTextMapHash":1064164806,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75671,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1827801097,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75671","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175671],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":823156703,"type":"WQ","unlockDescTextMapHash":3843303390}},"flow":[{"subQuestId":7567101,"order":1,"stepDescription":"Talk to the scholar","stepDescTextMapHash":2149364516,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7567101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30919"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7567101],"talks":[{"talkId":7567101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7567101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7567101,"initDialog":756710101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30919],"performCfg":"QuestDialogue/WQ/Natlan_75671/Q7567101","priority":5,"questId":75671,"showRandomTalkCount":0},"dialogs":[{"nodeId":756710101,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":2086853050,"text":"Chirp chirp! Coo coo! Chirp chirp chirp!","nextNodeIds":[756710102]},{"nodeId":756710102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1628277402,"text":"Um... what's going on here?","nextNodeIds":[756710103,756710104]},{"nodeId":756710103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3483165370,"text":"Are you sending... some kind of secret message?","nextNodeIds":[756710105]},{"nodeId":756710105,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":3169819586,"text":"Sort of! This is a technique I use to communicate with the cute little finches.","nextNodeIds":[756710106]},{"nodeId":756710106,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":2246250370,"text":"Oh, I seem to have forgotten to say hello to you folks. And the all-important opening line.","nextNodeIds":[756710107]},{"nodeId":756710107,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":4090227098,"text":"Kind Travelers passing through, I, Basima the Fifth, Amurta researcher, rising mercantile star, and expert on adorable animals, offer my heartfelt greetings.","nextNodeIds":[756710108]},{"nodeId":756710108,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":1940883338,"text":"Please. Relax thy body, clear thy mind, and listen closely, for I have a matter of utmost importance to share with you—","nextNodeIds":[756710109]},{"nodeId":756710109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2404216722,"text":"\"Finches are the cutest\"...?","nextNodeIds":[756710110]},{"nodeId":756710110,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":2273176530,"text":"You're absolutely correct! Congratulations, looks like the Finch's cuteness got to you too. You're even jumping to answer right away!","nextNodeIds":[756710111]},{"nodeId":756710111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":217664450,"text":"This is odd. Paimon's not sure why, but when she saw the game on the table, this line just popped into her head.","nextNodeIds":[756710112]},{"nodeId":756710112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":438661594,"text":"#Does this feel familiar to you too, {NICKNAME}?","nextNodeIds":[756710113,756710115]},{"nodeId":756710113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":219174002,"text":"We've met this lady before, right?","nextNodeIds":[756710114]},{"nodeId":756710114,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":2853161706,"text":"You're right! And it wasn't just a brief encounter either. It warms my heart to see you both still so full of life!","nextNodeIds":[756710117]},{"nodeId":756710117,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":1487248354,"text":"Anyway, would you like to try this game? This is version 17 from the third generation of \"Bing-Bang Finchball!\"","nextNodeIds":[756710118]},{"nodeId":756710118,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":1256313770,"text":"As you unwind and enjoy the game, you'll also get to hear wonderful stories of how the little finch, alongside the much, much bigger Ancient Scarlet-Plume Finch, triumphed over the gulls!","nextNodeIds":[756710119]},{"nodeId":756710119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3429397290,"text":"Sounds awesome! We've always been huge fans of relaxing games!","nextNodeIds":[756710120,756710121]},{"nodeId":756710120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2104722138,"text":"Let's play right now!","nextNodeIds":[756710122]},{"nodeId":756710122,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":630943226,"text":"Alright! I hope you find the way of playing that suits you best and enjoy a one-of-a-kind experience!","nextNodeIds":[]},{"nodeId":756710121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3592071306,"text":"Game start! Game start!","nextNodeIds":[756710122]},{"nodeId":756710115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1671227250,"text":"We can start the \"finches are the cutest\" thing now, if you want.","nextNodeIds":[756710116]},{"nodeId":756710116,"roleType":"TALK_ROLE_NPC","speakerId":30919,"speakerName":"Basima the Fifth","textMapHash":1440463202,"text":"You got it! And even if you can't remember the past right now, that's fine. What matters is that you enjoy the present...","nextNodeIds":[756710117]},{"nodeId":756710104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2122560882,"text":"Or speaking in some kind of... code?","nextNodeIds":[756710105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7567101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30919"],"