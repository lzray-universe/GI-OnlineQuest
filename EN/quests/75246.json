Ids":[752460202]},{"nodeId":752460202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3964321530,"text":"Happily.","nextNodeIds":[]}]},{"talkId":7524603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7524603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7524603,"initDialog":752460384,"nextRandomTalks":[],"nextTalks":[],"npcId":[21869],"performCfg":"QuestDialogue/WQ/Natlan_75246/Q7524603","priority":5,"questId":75246,"showRandomTalkCount":0},"dialogs":[{"nodeId":752460384,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":188832330,"text":"#As the elder, you should go first, {M#Gramps}{F#other Granny}.","nextNodeIds":[752460385]},{"nodeId":752460385,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1726456154,"text":"Happily.","nextNodeIds":[752460301]},{"nodeId":752460301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":514193178,"text":"#Wow, the competition's really heating up! Here comes a pro move from {NICKNAME}... and there's a bite! {NICKNAME} reels it in, and up comes a...","nextNodeIds":[752460302]},{"nodeId":752460302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1218735842,"text":"Hold on... is that... an Asha?","nextNodeIds":[752460303]},{"nodeId":752460303,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":2628773194,"text":"Wow... Not exactly the kind of catch I was expecting! Not super sure how we're gonna judge that...","nextNodeIds":[752460304]},{"nodeId":752460304,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1157634738,"text":"#Nice one, {M#Gramps}{F#other Granny}! We'll have to see if anyone manages to reel in something even more special. Otherwise, that might be enough for the win.","nextNodeIds":[752460305]},{"nodeId":752460305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":466139602,"text":"Thanks, everyone! I'm up against some fierce competition, but I think I've got a shot. Let's hope my grandson is right!","nextNodeIds":[752460306]},{"nodeId":752460306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1842541034,"text":"#Quite the impressive showing from {NICKNAME}! That'll be a tough act for the remaining two competitors to follow!","nextNodeIds":[752460307]},{"nodeId":752460307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1571100042,"text":"Ifa, you're up!","nextNodeIds":[752460308]},{"nodeId":752460308,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":764657106,"text":"You've got this, bro! Teamwork makes the dream work!","nextNodeIds":[752460309]},{"nodeId":752460309,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3056598834,"text":"Sorry, Cacucu. There's no room for teamwork here.","nextNodeIds":[752460310]},{"nodeId":752460310,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":2423039346,"text":"Whoa, look alive, bros... I've got something!","nextNodeIds":[752460311,752460313]},{"nodeId":752460311,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2664107354,"text":"Ifa reels in the rod with all his strength. Looks like he's caught something big...","nextNodeIds":[752460312]},{"nodeId":752460312,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2014304514,"text":"But... it's another unexpected catch.","nextNodeIds":[]},{"nodeId":752460313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2555166306,"text":"Huh... Looks like Ifa reeled in a koholasaur... towing a capybara? Not sure what's going on there...","nextNodeIds":[752460314]},{"nodeId":752460314,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":4279945818,"text":"Impressive! Ifa's always had a way with animals.","nextNodeIds":[752460315]},{"nodeId":752460315,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":1648798330,"text":"Wait, I think there's something wrong with this koholasaur's tail... I think he might've cut it on a rock, and I'm guessing this capybara was trying to help.","nextNodeIds":[752460316]},{"nodeId":752460316,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":2716216578,"text":"Or, the capybara was trying to eat his tail.","nextNodeIds":[752460317]},{"nodeId":752460317,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":4279577626,"text":"No way, bro. Cacucu, can you go ask?","nextNodeIds":[752460318]},{"nodeId":752460318,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":3603744170,"text":"Yep, yep... You got it, bro!","nextNodeIds":[752460319]},{"nodeId":752460319,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3852747154,"text":"See? Haha! Knew I was right... No, wait. That's not what's important right now.","nextNodeIds":[752460320,752460322]},{"nodeId":752460320,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1091354402,"text":"Ifa quickly checks the koholasaur's tail. Luckily, it's just a scratch.","nextNodeIds":[752460321]},{"nodeId":752460321,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":37365746,"text":"After a simple triage, the koholasaur and his capybara companion leave.","nextNodeIds":[]},{"nodeId":752460322,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":509300586,"text":"Aw, a new friendship. Looks like today is their lucky day, too.","nextNodeIds":[752460323]},{"nodeId":752460323,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":632245546,"text":"\"Too\"?","nextNodeIds":[752460324]},{"nodeId":752460324,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1106378922,"text":"That's right. It's my turn, and I have a feeling I'm going to win this thing!","nextNodeIds":[752460325]},{"nodeId":752460325,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":1243249178,"text":"Teamwork makes the dream work, bro!","nextNodeIds":[752460326]},{"nodeId":752460326,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3381452002,"text":"Guessing that's your way of rooting for us, little guy? Where did you even learn that...","nextNodeIds":[752460327]},{"nodeId":752460327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2024950090,"text":"Cacucu, fishing cheerleader extraordinaire!","nextNodeIds":[752460328]},{"nodeId":752460328,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":823426546,"text":"\"Fishing cheerleader\" sounds too lackluster. We're fighting for something important. It needs to have a bit more impa... Huh!?","nextNodeIds":[752460329]},{"nodeId":752460329,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3136456898,"text":"What is that!? Quick, out of the way!","nextNodeIds":[752460330]},{"nodeId":752460330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":933022922,"text":"Okay, this one looks a bit unusual... But, it's another capybara! And he charged at us! Didn't you say they're supposed to be gentle creatures?","nextNodeIds":[752460331]},{"nodeId":752460331,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":2494077474,"text":"He must be fighting for something important, too. Hm, I can sense it...","nextNodeIds":[752460332]},{"nodeId":752460332,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3534229042,"text":"...Or, maybe not...","nextNodeIds":[752460333]},{"nodeId":752460333,"roleType":"TALK_ROLE_NPC","speakerId":21978,"speakerName":"Capybara","textMapHash":2187188738,"text":"...!","nextNodeIds":[752460334]},{"nodeId":752460334,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1399225434,"text":"I guess that's just us. But, he is upset.","nextNodeIds":[752460335]},{"nodeId":752460335,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":3096691786,"text":"Oh, hey, little dude!","nextNodeIds":[752460336]},{"nodeId":752460336,"roleType":"TALK_ROLE_NPC","speakerId":21978,"speakerName":"Capybara","textMapHash":3952468962,"text":"?","nextNodeIds":[752460337]},{"nodeId":752460337,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":54244562,"text":"Haha! Awesome, bro!","nextNodeIds":[752460338]},{"nodeId":752460338,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":138082,"text":"Wh—What? Is Cacucu trying to... talk him down or something?","nextNodeIds":[752460339]},{"nodeId":752460339,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":601693058,"text":"Comfort him, more like. He might not look it, but Cacucu has an amazing bedside manner.","nextNodeIds":[752460340]},{"nodeId":752460340,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3499982858,"text":"Huh. Even with his, um... limited vocabulary?","nextNodeIds":[752460341]},{"nodeId":752460341,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3444039394,"text":"When you're talking to a capybara, I don't think human vocabulary matters much, Paimon.","nextNodeIds":[752460342]},{"nodeId":752460342,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2970683018,"text":"Oh... right!","nextNodeIds":[752460343]},{"nodeId":752460343,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1425502162,"text":"We just need to trust the little broski.","nextNodeIds":[752460344]},{"nodeId":752460344,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":4001775978,"text":"Besides, when you're trying to communicate, I think tone carries more weight than the actual words.","nextNodeIds":[752460345]},{"nodeId":752460345,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3611376050,"text":"For example, \"hello\" means \"I'm happy.\"","nextNodeIds":[752460346]},{"nodeId":752460346,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3632309994,"text":"But, \"hello\"... means \"I'm frustrated.\"","nextNodeIds":[752460347]},{"nodeId":752460347,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1971299682,"text":"And, \"hello!\"... That's anger, a sign to run and hide because danger is near.","nextNodeIds":[752460348]},{"nodeId":752460348,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2863757570,"text":"Okay, Paimon doesn't completely follow, but she'll take your word for it...","nextNodeIds":[752460349]},{"nodeId":752460349,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3683240242,"text":"You learn something every day, huh? Thanks!","nextNodeIds":[752460350]},{"nodeId":752460350,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3446834810,"text":"Oh, my pleasure! It's the method I came up with to communicate with the aphids.","nextNodeIds":[752460351]},{"nodeId":752460351,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3334796746,"text":"Aphid STAFF... remember, bro?","nextNodeIds":[752460352]},{"nodeId":752460352,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":747798938,"text":"No, not just the staff. There are aphids who didn't want to join, you know. I understand their feelings, of course, and I respect their decision.","nextNodeIds":[752460353]},{"nodeId":752460353,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":2483015890,"text":"...Then, maybe you can throw some of that understanding my way, bro. I'm at my wit's end here.","nextNodeIds":[752460354]},{"nodeId":752460354,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1466695370,"text":"Huh, really? I thought you'd be proud. See, look over there.","nextNodeIds":[752460355]},{"nodeId":752460355,"roleType":"TALK_ROLE_NPC","speakerId":21978,"speakerName":"Capybara","textMapHash":1963398298,"text":"——.","nextNodeIds":[752460356]},{"nodeId":752460356,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":656747410,"text":"Hahaha! For real?","nextNodeIds":[752460357]},{"nodeId":752460357,"roleType":"TALK_ROLE_NPC","speakerId":21978,"speakerName":"Capybara","textMapHash":1068235698,"text":"——.","nextNodeIds":[752460358]},{"nodeId":752460358,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":41773842,"text":"Wow! Wow!","nextNodeIds":[752460359]},{"nodeId":752460359,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":626921514,"text":"Whoa, looks like they really hit it off.","nextNodeIds":[752460360]},{"nodeId":752460360,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3124241842,"text":"Okay, well, I am a little proud, but... Huh? Ororon!","nextNodeIds":[752460361]},{"nodeId":752460361,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1475550898,"text":"Don't worry. I've got this.","nextNodeIds":[752460362]},{"nodeId":752460362,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":227943658,"text":"Hello, Capybara King. Do you want something to eat? I have a fresh batch of Ifa's cookies here.","nextNodeIds":[752460363]},{"nodeId":752460363,"roleType":"TALK_ROLE_NPC","speakerId":21978,"speakerName":"Capybara","textMapHash":2607678602,"text":"Rrooo...","nextNodeIds":[752460364]},{"nodeId":752460364,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":2844821810,"text":"Capybara King?","nextNodeIds":[752460365]},{"nodeId":752460365,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":97334746,"text":"Huh, he ate them! Looks like that perked him up for sure!","nextNodeIds":[752460366]},{"nodeId":752460366,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":2416118058,"text":"Oh dear! Oh dear!","nextNodeIds":[752460367]},{"nodeId":752460367,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2288266722,"text":"Hold on... How did our fishing competition turn into a petting zoo?","nextNodeIds":[752460368,752460369]},{"nodeId":752460368,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1124269010,"text":"Hey, it's not a bad result!","nextNodeIds":[752460370]},{"nodeId":752460370,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":322554666,"text":"Huh, true... Well, guess this makes Ororon the winner?","nextNodeIds":[752460371]},{"nodeId":752460371,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":738449922,"text":"Considering he managed to catch this, um... Capybara King or whatever.","nextNodeIds":[752460372]},{"nodeId":752460372,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1417480362,"text":"It's a fine name, indeed.","nextNodeIds":[752460373]},{"nodeId":752460373,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":2730836466,"text":"Sure, Ororon wins. None of us managed to catch an actual fish, anyway.","nextNodeIds":[752460374]},{"nodeId":752460374,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":3184098186,"text":"Haha!","nextNodeIds":[752460375]},{"nodeId":752460375,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":789521642,"text":"Nice, then I get the mead! Although, it was mine to begin with...","nextNodeIds":[752460376]},{"nodeId":752460376,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":252079370,"text":"Well, you get to keep it! That's something, right?","nextNodeIds":[752460377]},{"nodeId":752460377,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":645438786,"text":"True, and the Capybara King left us a little something extra, too. Look, I think it's a gift.","nextNodeIds":[752460378]},{"nodeId":752460378,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3809075946,"text":"A \"Gift Egg\" and a picture? Huh, the location in this picture looks familiar...","nextNodeIds":[752460379]},{"nodeId":752460379,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3412133922,"text":"Does that mean the Capybara King wants us to go there? Kinda seems like that, right?","nextNodeIds":[752460380]},{"nodeId":752460380,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":705119154,"text":"Couldn't hurt to go and see.","nextNodeIds":[752460381]},{"nodeId":752460381,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":1560584314,"text":"Yeah, definitely something to check out if you've got some time.","nextNodeIds":[752460382]},{"nodeId":752460382,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3263305626,"text":"Maybe there'll be something awesome waiting for us.","nextNodeIds":[752460383]},{"nodeId":752460383,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":2782365018,"text":"Yeah, who knows... But we should come prepared just in case.","nextNodeIds":[]},{"nodeId":752460369,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1182698514,"text":"Pretty fun, don't you think?","nextNodeIds":[752460370]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7524603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"},{"LNHLPKELCAL":["3","133520019,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_I