{"mainQuestId":75246,"title":"Encounters Always Happen on a Holiday","description":"While strolling around the Easybreeze Holiday Resort, you and Paimon spot some familiar figures...","titleTextMapHash":1692690047,"descTextMapHash":2357504310,"mainQuestExcel":{"mainQuestId":75246,"titleTextMapHash":1692690047,"title":"Encounters Always Happen on a Holiday","descTextMapHash":2357504310,"description":"While strolling around the Easybreeze Holiday Resort, you and Paimon spot some familiar figures...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ75246","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":2357504310,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75246,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1660545393,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75246","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175246],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[29017],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1692690047,"type":"WQ","unlockDescTextMapHash":2930614182}},"flow":[{"subQuestId":7524601,"order":1,"stepDescription":"","stepDescTextMapHash":1356786068,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7524601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21850"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7524601],"talks":[{"talkId":7524601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7524601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7524601,"initDialog":752460101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21850],"performCfg":"QuestDialogue/WQ/Natlan_75246/Q7524601","priority":5,"questId":75246,"showRandomTalkCount":0},"dialogs":[{"nodeId":752460101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3560103442,"text":"Look, there are people over there!","nextNodeIds":[752460102]},{"nodeId":752460102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4067253426,"text":"Huh, they look familiar. I think that's...","nextNodeIds":[752460103]},{"nodeId":752460103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3158060946,"text":"Ororon and Ifa!","nextNodeIds":[752460104]},{"nodeId":752460104,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":1239910946,"text":"#Oh, {M#Gramps}{F#other Granny} and Paimon! I knew those were voices I recognized!","nextNodeIds":[752460105]},{"nodeId":752460105,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":4252441290,"text":"Bros! Bros!","nextNodeIds":[752460106]},{"nodeId":752460106,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3583386330,"text":"Hah! You're here at the resort, too! Man, it's been a while!","nextNodeIds":[752460107]},{"nodeId":752460107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1052525482,"text":"Yep! Chasca told us you've been working here. Guess we were bound to run into each other at some point!","nextNodeIds":[752460108]},{"nodeId":752460108,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":855259874,"text":"Yeah, for sure. Yo, this place has a nice vibe to it, don't you think? I hear everyone's been having a blast.","nextNodeIds":[752460109]},{"nodeId":752460109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1586114978,"text":"Hehe, definitely! With any luck, it'll only get better, and we'll get even more visitors!","nextNodeIds":[752460110]},{"nodeId":752460110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":30030474,"text":"What about you two? How's your work going?","nextNodeIds":[752460111]},{"nodeId":752460111,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":1016331050,"text":"Not bad! The saurian staff and the aphids are all in good health and full of energy, so we had some free time on our hands. Thought we'd take a look around.","nextNodeIds":[752460112]},{"nodeId":752460112,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":170315498,"text":"...Aphid STAFF.","nextNodeIds":[752460113]},{"nodeId":752460113,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3668683794,"text":"Huh?","nextNodeIds":[752460114]},{"nodeId":752460114,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":2566931834,"text":"The aphids are part of the staff, too. You missed that part.","nextNodeIds":[752460115]},{"nodeId":752460115,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":883058178,"text":"You can say that again, bro!","nextNodeIds":[752460116]},{"nodeId":752460116,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3597923722,"text":"Right... My bad. I'm grateful to our entire staff, of course. And, to Mr. Ororon, for looking out for them so... proactively.","nextNodeIds":[752460117]},{"nodeId":752460117,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3255111962,"text":"We got here early to fight for an important cause. That's its own reward.","nextNodeIds":[752460118]},{"nodeId":752460118,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":747743626,"text":"You see, this is my bro's first time getting a formal invitation like that, and as you can probably tell, he's very, um... committed.","nextNodeIds":[752460119]},{"nodeId":752460119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2148736290,"text":"Enthusiasm's a good thing.","nextNodeIds":[752460120]},{"nodeId":752460120,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":77593482,"text":"#See? {M#Gramps}{F#Other Granny} knows what {M#he's}{F#she's} talking about.","nextNodeIds":[752460121]},{"nodeId":752460121,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":2578538954,"text":"Every day, we get a new chance to fight for what's important. Cacucu taught me that.","nextNodeIds":[752460122]},{"nodeId":752460122,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":2331991114,"text":"Haha!","nextNodeIds":[752460123]},{"nodeId":752460123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1438549826,"text":"But, aren't you just... fishing? Since when did that count as \"fighting for what's important\"?","nextNodeIds":[752460124]},{"nodeId":752460124,"roleType":"TALK_ROLE_NPC","speakerId":21971,"speakerName":"Cacucu","textMapHash":403614842,"text":"Do you even hear yourself?","nextNodeIds":[752460125]},{"nodeId":752460125,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":2837898778,"text":"Since it was suggested by a friend, of course. He's a famous adventurer from Mondstadt with incredible luck. If he says it'll work, who are we to argue?","nextNodeIds":[752460126]},{"nodeId":752460126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3293702314,"text":"(Wait... Bennett?)","nextNodeIds":[752460127]},{"nodeId":752460127,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3169588506,"text":"Yeah, that bro spun a stick around and it ended up pointing at this pond. As Ororon put it — better to follow luck where it leads than try to make your own. So, we came to fish here.","nextNodeIds":[752460128]},{"nodeId":752460128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":683441194,"text":"Okay, even if that made sense... This pond is surrounded by capybaras! Can you even fish here?","nextNodeIds":[752460129]},{"nodeId":752460129,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":3520276570,"text":"Of course! Capybaras are gentle creatures, so we're good. Besides, when life gives you water, you fish. That's what Granny taught me.","nextNodeIds":[752460130]},{"nodeId":752460130,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":31569538,"text":"Ah, another one of Granny's pearls of wisdom. Along with, \"when life gives you food, you eat\" or \"when life gives you lemons, make lemonade.\"","nextNodeIds":[752460131]},{"nodeId":752460131,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":632590890,"text":"#Haha, exactly. Except, we're the ones handing you lemons this time, {M#Gramps}{F#other Granny} and Paimon. Since you're here, why don't you fish with us?","nextNodeIds":[752460132]},{"nodeId":752460132,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":3193986962,"text":"And, to up the ante a bit... Whoever catches the biggest fish gets a pint of Ororon's Aphimead.","nextNodeIds":[752460133]},{"nodeId":752460133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2281253290,"text":"Now that's an offer Paimon can get behind!","nextNodeIds":[752460134]},{"nodeId":752460134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3605123010,"text":"#Hehehe, did you forget who you're dealing with here? We never back away from a challenge, and {NICKNAME} is a tough opponent!","nextNodeIds":[752460135,752460137]},{"nodeId":752460135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3943952354,"text":"Let's do this, bro!","nextNodeIds":[752460136]},{"nodeId":752460136,"roleType":"TALK_ROLE_NPC","speakerId":21849,"speakerName":"Ifa","textMapHash":2585068578,"text":"Got your game face on, I see! Alright, I'm down!","nextNodeIds":[]},{"nodeId":752460137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3578661602,"text":"I'll take you on, grandson.","nextNodeIds":[752460138]},{"nodeId":752460138,"roleType":"TALK_ROLE_NPC","speakerId":21850,"speakerName":"Ororon","textMapHash":4212060090,"text":"Alright, then it's winner takes all — meaning not only all the fish, but the aphid staff's mead too.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7524601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21850"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7524603,"order":3,"stepDescription":"Partake in a thrilling fishing contest","stepDescTextMapHash":2912706764,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7524603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21850"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7524602,7524603],