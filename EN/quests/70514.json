{"mainQuestId":70514,"title":"Evermotion Mechanical Painting","description":"Félix Yogue, a person from the Court of Fontaine, seems to be having some problems...","titleTextMapHash":4169114919,"descTextMapHash":3188716686,"mainQuestExcel":{"mainQuestId":70514,"titleTextMapHash":4169114919,"title":"Evermotion Mechanical Painting","descTextMapHash":3188716686,"description":"Félix Yogue, a person from the Court of Fontaine, seems to be having some problems...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5082,"luaPath":"Actor/Quest/WQ70514","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5082,"chapterId":0,"descTextMapHash":3188716686,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70514,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2226055329,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70514","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170514],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4169114919,"type":"WQ","unlockDescTextMapHash":1145159102}},"flow":[{"subQuestId":7051401,"order":1,"stepDescription":"Talk to Félix Yogue","stepDescTextMapHash":1499576052,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30217"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7051401],"talks":[{"talkId":7051401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7051401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7051401,"initDialog":705140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30217,1437],"performCfg":"QuestDialogue/WQ/Mengde_70514/Q7051401","priority":5,"questId":70514,"showRandomTalkCount":0},"dialogs":[{"nodeId":705140101,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1998887250,"text":"The passion of Mondstadt is well-founded, I say. More so than I imagined, in fact... even their hilichurls are so very lively.","nextNodeIds":[705140102]},{"nodeId":705140102,"roleType":"TALK_ROLE_NPC","speakerId":1437,"speakerName":"Swan","textMapHash":2747022930,"text":"Regardless, Mr. Yogue, we ask that you not go out by yourself again.","nextNodeIds":[705140103]},{"nodeId":705140103,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3781326362,"text":"What? Then what about my machine? I'm still missing... um...","nextNodeIds":[705140104]},{"nodeId":705140104,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3824240698,"text":"1, 2, 3... 18... 19 components!","nextNodeIds":[705140105]},{"nodeId":705140105,"roleType":"TALK_ROLE_NPC","speakerId":1437,"speakerName":"Swan","textMapHash":1619001626,"text":"We've got adventurers working on finding them. Just wait here in the city where it's safe, please...","nextNodeIds":[705140106]},{"nodeId":705140106,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2311363218,"text":"But without that device, my... It's a matter of inspiration, you understand? What shall I do when inspiration strikes?","nextNodeIds":[705140107]},{"nodeId":705140107,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":466179138,"text":"Ah, it comes and it goes... Like a belch after a good drink, or a candle in the wind!","nextNodeIds":[705140108]},{"nodeId":705140108,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1631498946,"text":"Hmm, actually, that's not a bad analogy. I should write it down. I'm sure Xavier would love it...","nextNodeIds":[705140109]},{"nodeId":705140109,"roleType":"TALK_ROLE_NPC","speakerId":1437,"speakerName":"Swan","textMapHash":405493946,"text":"You...","nextNodeIds":[705140110]},{"nodeId":705140110,"roleType":"TALK_ROLE_NPC","speakerId":1437,"speakerName":"Swan","textMapHash":1857968186,"text":"Huh? Honorary Knight? Ah, wonderful! Just the person I wanted to see! Please, over here!","nextNodeIds":[705140111,705140112]},{"nodeId":705140111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4024751994,"text":"What's wrong?","nextNodeIds":[705140113]},{"nodeId":705140113,"roleType":"TALK_ROLE_NPC","speakerId":1437,"speakerName":"Swan","textMapHash":730784090,"text":"Well, allow me to introduce you. This man here is from the Court of Fontaine...","nextNodeIds":[705140114]},{"nodeId":705140114,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2921406818,"text":"No man am I, but a daydreamer! That is how we name ourselves!","nextNodeIds":[705140115]},{"nodeId":705140115,"roleType":"TALK_ROLE_NPC","speakerId":1437,"speakerName":"Swan","textMapHash":146324666,"text":"...So, Mr. Yogue, this is our Honorary Knight...","nextNodeIds":[705140116]},{"nodeId":705140116,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":4202923346,"text":"Yogue! Félix Yogue. Salutations to you, Honorary Knight! Long have I heard of your many exploits.","nextNodeIds":[705140117]},{"nodeId":705140117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":781879754,"text":"You know of me?","nextNodeIds":[705140118]},{"nodeId":705140118,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":4087213514,"text":"Of course, of course! Who wouldn't?","nextNodeIds":[705140119]},{"nodeId":705140119,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":789044914,"text":"Your battle against Dvalin in Mondstadt made headlines in The Steambird for three whole weeks!","nextNodeIds":[705140120]},{"nodeId":705140120,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":630390026,"text":"Hahaha, if those reporters knew that I was speaking to you right now, why, they would be beside themselves with envy!","nextNodeIds":[705140121,705140124]},{"nodeId":705140121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":856532882,"text":"What's The Steambird?","nextNodeIds":[705140122]},{"nodeId":705140122,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":679310362,"text":"Ah, you don't know? It's a... Ah, let's say it's a rather popular newspaper in the Court of Fontaine.","nextNodeIds":[705140123]},{"nodeId":705140123,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":190291930,"text":"You once got their sales up to record numbers, I'll have you know.","nextNodeIds":[705140125]},{"nodeId":705140125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3111780658,"text":"Headlines, you say?","nextNodeIds":[705140126]},{"nodeId":705140126,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1086195906,"text":"Indeed! And you got their sales up to record numbers, to boot!","nextNodeIds":[705140127]},{"nodeId":705140127,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":4097597514,"text":"Front-page, full-length, expert interviews up the wazoo, and the best hand-drawn illustrations Mora could buy! You made a lot of people mad Mora there.","nextNodeIds":[705140128]},{"nodeId":705140128,"roleType":"TALK_ROLE_NPC","speakerId":1437,"speakerName":"Swan","textMapHash":3005911674,"text":"Well then... Traveler, Mr. Yogue, I shall leave you guys alone... I've got some other things to handle at the moment, if you'll excuse me.","nextNodeIds":[705140129]},{"nodeId":705140129,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1508731394,"text":"Swan leaves in a hurry...","nextNodeIds":[705140130]},{"nodeId":705140130,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1199880010,"text":"Ah, it is as I was told. The Knights of Favonius have a never-ending backlog of work.","nextNodeIds":[705140131]},{"nodeId":705140131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":857258130,"text":"So, why are you here in Mondstadt?","nextNodeIds":[705140132]},{"nodeId":705140132,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2568252554,"text":"Me? Well, I'm actually planning to tour Teyvat.","nextNodeIds":[705140133]},{"nodeId":705140133,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3832795842,"text":"As for the purpose of my trip, why, it is to promote these Kinesis Cores that I have made.","nextNodeIds":[705140134]},{"nodeId":705140134,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":4120940778,"text":"Simply put, a Kinesis Core is a form of clockwork device. As long as its mainspring is wound from time to time, these cores can provide motive force for a long period of time.","nextNodeIds":[705140135]},{"nodeId":705140135,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2660021026,"text":"I even created a sort of perpetual-motion toy powered by the Kinesis Core to show off its capabilities. I call it the Evermotion Mechanical Painting.","nextNodeIds":[705140136]},{"nodeId":705140136,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3381568650,"text":"Unfortunately, while I'd love to show the device to you...","nextNodeIds":[705140137]},{"nodeId":705140137,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2661461090,"text":"Its allure was all too much for even monsters to resist.","nextNodeIds":[705140138]},{"nodeId":705140138,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":31496786,"text":"At the moment, they must have divvied my device up into many pieces in a manner most unfriendly, playing around with each component...","nextNodeIds":[705140139]},{"nodeId":705140139,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1204574778,"text":"I have, of course, asked for the help of the Adventurers' Guild, but I have received no news from any adventurer so far...","nextNodeIds":[705140140]},{"nodeId":705140140,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3695733338,"text":"Honorary Knight, could you help me out as well, if you have a mind to?","nextNodeIds":[705140141]},{"nodeId":705140141,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2432882770,"text":"Believe me, neither my device nor the payment due will disappoint you!","nextNodeIds":[705140142]},{"nodeId":705140142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":117042594,"text":"Leave it to me.","nextNodeIds":[705140143]},{"nodeId":705140143,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":731857962,"text":"Wonderful. You are indeed a mighty adventurer, and a mighty sympathetic one, too. Just as the papers said!","nextNodeIds":[705140144]},{"nodeId":705140144,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":4185719898,"text":"Ah, it's a shame that we're in Mondstadt. Were we in the Court of Fontaine, I would bring a few reporters from The Steambird for an exclusive interview with you.","nextNodeIds":[705140145]},{"nodeId":705140145,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":82711482,"text":"I'm sure that your charisma would bowl them over to the point where you'd be guaranteed another three weeks' worth of headlines — not to mention the requisite royalties.","nextNodeIds":[]},{"nodeId":705140124,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1669857642,"text":"Front-page, full-length, expert interviews up the wazoo, and the best hand-drawn illustrations Mora could buy! You made a lot of people mad Mora there.","nextNodeIds":[705140125]},{"nodeId":705140112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4203480986,"text":"Did something happen?","nextNodeIds":[705140113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30217"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7051402,"order":2,"stepDescription":"Collect Components","stepDescTextMapHash":3521688180,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7051402"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7051402_guide","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"i