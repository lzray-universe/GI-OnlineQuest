OBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2211201],"talks":[{"talkId":2211201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211201","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2211201,"initDialog":221120101,"nextRandomTalks":[],"nextTalks":[],"npcId":[220201],"performCfg":"","priority":6,"questId":22112,"showRandomTalkCount":0},"dialogs":[{"nodeId":221120101,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":837409520,"text":"Looks like this is going to need repairing...","nextNodeIds":[221120102]},{"nodeId":221120102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1989040376,"text":"What's wrong?","nextNodeIds":[221120103]},{"nodeId":221120103,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":1324649600,"text":"Ah, it's you. See for yourself — the staircase is broken...","nextNodeIds":[221120104]},{"nodeId":221120104,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":3105707136,"text":"It's in pretty bad shape. Someone is definitely going to have an accident if it isn't repaired.","nextNodeIds":[221120105]},{"nodeId":221120105,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":3513258544,"text":"How it broke, you ask? Well, a group of monsters tried to get inside, so I came out to fight them off.","nextNodeIds":[221120106]},{"nodeId":221120106,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":4053857280,"text":"I should have pulled my punches... I sent one of the big heavy ones flying and he landed right on the staircase. It smashed on impact.","nextNodeIds":[221120107]},{"nodeId":221120107,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":138643344,"text":"I promised myself I'd fix it but I just haven't found the time. Reason being, the inn is just getting busier and busier at the moment. All the more reason why this repair is getting urgent...","nextNodeIds":[221120108]},{"nodeId":221120108,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":2408471272,"text":"It's not a difficult job. I can easily repair this myself.","nextNodeIds":[221120109]},{"nodeId":221120109,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":2476272312,"text":"If you have the time, could you fetch some Wooden Planks for me? I need to stay here in case someone else misses their step...","nextNodeIds":[221120110,221120113]},{"nodeId":221120110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3159229400,"text":"Okay.","nextNodeIds":[221120111]},{"nodeId":221120111,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":3557103280,"text":"Great. I actually bought the Wooden Planks already, they're currently stored just outside the inn.","nextNodeIds":[221120112]},{"nodeId":221120112,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":4194496208,"text":"See if you can find them and bring a few back here.","nextNodeIds":[]},{"nodeId":221120113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1388899672,"text":"Won't it just get smashed again?","nextNodeIds":[221120114]},{"nodeId":221120114,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":3261799832,"text":"That won't happen. I'm getting old anyway... and I'll make sure I restrain myself next time.","nextNodeIds":[221120115]},{"nodeId":221120115,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":4129543048,"text":"In any case, it needs fixing whatever happens. I actually bought the Wooden Planks already, they're currently stored just outside the inn.","nextNodeIds":[221120116]},{"nodeId":221120116,"roleType":"TALK_ROLE_NPC","speakerId":220201,"speakerName":"Huai'an","textMapHash":3312378920,"text":"Please bring a few of them here for me.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["220201"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2211202,"order":2,"stepDescription":"Collect 5 wooden planks","stepDescTextMapHash":4226638150,"finishConds":[{"BFGALAINLMD":5,"LNHLPKELCAL":[100306,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH"