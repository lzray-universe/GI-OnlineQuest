{"mainQuestId":74670,"title":"Semi-Automatic Forging","description":"Blacksmiths in Fontaine do not hammer their metals themselves, but rather use an even more advanced method. If you have time, you really should go check it out...","titleTextMapHash":2069175959,"descTextMapHash":4249667382,"mainQuestExcel":{"mainQuestId":74670,"titleTextMapHash":2069175959,"title":"Semi-Automatic Forging","descTextMapHash":4249667382,"description":"Blacksmiths in Fontaine do not hammer their metals themselves, but rather use an even more advanced method. If you have time, you really should go check it out...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ74670","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":4249667382,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74670,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":481740833,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74670","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174670],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2069175959,"type":"WQ","unlockDescTextMapHash":2971064430}},"flow":[{"subQuestId":7467001,"order":1,"stepDescription":"Go to the workshop","stepDescTextMapHash":1123910668,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["5033"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467001],"talks":[{"talkId":7467001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7467001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467001,"initDialog":746700101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5033],"performCfg":"QuestDialogue/WQ/Fontaine_74670/Q7467001","priority":5,"questId":74670,"showRandomTalkCount":0},"dialogs":[{"nodeId":746700101,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":2984254010,"text":"Hmm. There's still room for improvement here. The hammering force still isn't quite right. The materials used are all the same, so is this due to the difference in forging methods? One where the harder material is made into the outer layer, and one where it becomes the inner layer instead...","nextNodeIds":[746700102]},{"nodeId":746700102,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":3393561210,"text":"If that's the case, should the corresponding force be pre-set, or should I make an adaptive mechanism that sets the force based on forging method instead?","nextNodeIds":[746700103]},{"nodeId":746700103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3115402578,"text":"Huh. Y'know, this machine really is fascinating up close, the way it just clangs on the metal by itself — at this rate, it feels like you wouldn't need a blacksmith at all!","nextNodeIds":[746700104]},{"nodeId":746700104,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":760162546,"text":"Haha. This machine isn't smart enough to \"not need a blacksmith\" yet. When you need to make something, there are still countless little details that need to be tuned, and the tempering and polishing needs to be done manually as well.","nextNodeIds":[746700105]},{"nodeId":746700105,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":1968097562,"text":"However, one day, I will turn it into a fully automated forge.","nextNodeIds":[746700106]},{"nodeId":746700106,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":1978114178,"text":"Anyway, do you have a commission for me?","nextNodeIds":[746700107]},{"nodeId":746700107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4101306354,"text":"That hinges on how well the Auto-Smith can perform...","nextNodeIds":[746700108]},{"nodeId":746700108,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":1700838106,"text":"Then, I gotta show you what I've got!","nextNodeIds":[746700109]},{"nodeId":746700109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3172375618,"text":"Huh, so you're the blacksmith too, and not just the boss?","nextNodeIds":[746700110]},{"nodeId":746700110,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":1433677194,"text":"That's right. I wear both hats, wield both hammers, however you want to put it. Surprised, huh?","nextNodeIds":[746700111]},{"nodeId":746700111,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":111427338,"text":"People who find out about me for the first time all end up making the expressions you're making right now. \"Where are the solid chunks of muscle on her arms? She's even leaner than the average person.\"","nextNodeIds":[746700112]},{"nodeId":746700112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4086274666,"text":"\"Yeah, that's right. Can someone like that really work as a blacksmith...\" Hmm, those aren't Paimon's thoughts. Paimon just continued your hypothetical conversation without even realizing it...","nextNodeIds":[746700113]},{"nodeId":746700113,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":4075358322,"text":"Haha, no offense taken. Truth be told, letting someone as feeble in body as I serve as a blacksmith is the main point of this machine.","nextNodeIds":[746700114]},{"nodeId":746700114,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":1989383490,"text":"Humans can use tools, and exquisitely-designed tools can make the impossible, possible.","nextNodeIds":[746700115]},{"nodeId":746700115,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":452990530,"text":"Some say that all automated forgings are hollow and soulless. But if you ask me, the machine is just as much of a tool as a regular smith's hammer. Really, I would love to see those smiths knock metal into shape with their bare hands...","nextNodeIds":[746700116]},{"nodeId":746700116,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":1178543346,"text":"Anyway, I digress. I'll forge a razor-sharp sword for you right away... Hmm. But it seems like I've run out of materials.","nextNodeIds":[746700117]},{"nodeId":746700117,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":3061527450,"text":"*sigh* It appears we've used up too much of our materials during the previous rounds of experiments. What should I do...","nextNodeIds":[746700118]},{"nodeId":746700118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4095571210,"text":"Ohh, Paimon knows! For the next phase, Paimon must pull on a mysterious lever. Once Paimon has done that, the forge will rattle and chime before transforming into a mobile mechanism that will leave to seek materials on its own!","nextNodeIds":[746700119]},{"nodeId":746700119,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":832472274,"text":"Hmm... Automated material-gathering machines... Feels like that would be a high-demand design as well. But how shall they differentiate between different forms of matter? Could they perhaps use the external reflectivity of surfaces to judge the properties of an object?","nextNodeIds":[746700120]},{"nodeId":746700120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1885130426,"text":"Miss Estelle...?","nextNodeIds":[746700121]},{"nodeId":746700121,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":4085342770,"text":"Ah, apologies, I got distracted. As it stands, the Auto-Smith is just a hammering mechanism. It cannot transform nor roam on its own. All the materials it uses must still be delivered by human beings...","nextNodeIds":[746700122]},{"nodeId":746700122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1624232130,"text":"Aww...","nextNodeIds":[746700123]},{"nodeId":746700123,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":2519528618,"text":"But if you're interested, you can also give me any spare materials you have collected. When one is testing and tuning their Auto-Smith, there is always a scarcity of resources.","nextNodeIds":[746700124]},{"nodeId":746700124,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":3821513162,"text":"In return... Let me offer you some designs from this workshop!","nextNodeIds":[746700125,746700126]},{"nodeId":746700125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":126491466,"text":"I smell trade secrets...","nextNodeIds":[746700127]},{"nodeId":746700127,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":2458747634,"text":"How should I put it? To me, what matters isn't the \"product\" that is forged, but the \"tool\" used for forging.","nextNodeIds":[746700128]},{"nodeId":746700128,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":3994534034,"text":"Letting the Auto-Smith work with different materials to procure more data sets will help the machine create better products down the line. The designs, contrarily, are of lesser importance.","nextNodeIds":[746700129]},{"nodeId":746700129,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":4041858562,"text":"So, we are interested in more than just forging materials. Feel free to bring over anything that you think might be useful.","nextNodeIds":[746700130]},{"nodeId":746700130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1372115994,"text":"Hmm, you aren't trying to scam us with some strange and useless designs, are you? What if the next time we're back, we'll just find an empty shop, with no sign of you, the Auto-Smith, or the materials we handed over to you...","nextNodeIds":[746700131]},{"nodeId":746700131,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":3590001674,"text":"No, that would never happen! This counts as a long-term partnership. In such relationships, nothing is more important than trust. I will make sure that the designs will be of the highest quality.","nextNodeIds":[746700132]},{"nodeId":746700132,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":926509562,"text":"Besides, even if I could run, it won't be easy for the Auto-Smith to sprout legs and follow...","nextNodeIds":[746700133]},{"nodeId":746700133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1823495578,"text":"That's a fair point...","nextNodeIds":[746700134,746700135]},{"nodeId":746700134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":381636794,"text":"Well, that settles it then!","nextNodeIds":[746700136]},{"nodeId":746700136,"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","textMapHash":302794850,"text":"I hope this partnership will benefit both of us. Yes, I'm looking forward to seeing what kinds of materials you will bring to the forge.","nextNodeIds":[]},{"nodeId":746700135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1393931314,"text":"I'm looking forward to working with you!","nextNodeIds":[746700136]},{"nodeId":746700126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4065018578,"text":"Are you sure that's okay?","nextNodeIds":[746700127]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["5033"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5033,"speakerName":"Estelle","count":23},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174670],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4249667382,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74670/Q7467001","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":746700101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7467001,"JGFEJPBPHGJ":[],"JN