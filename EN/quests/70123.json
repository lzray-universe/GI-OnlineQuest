":7012304,"initDialog":701230401,"nextRandomTalks":[],"nextTalks":[],"npcId":[20183],"performCfg":"","priority":0,"questId":70123,"showRandomTalkCount":0},"dialogs":[{"nodeId":701230401,"roleType":"TALK_ROLE_NPC","speakerId":20183,"speakerName":"Scribbled Note","textMapHash":3409599394,"text":"The snowstorm from the summit came too quickly. I barely had enough time to duck into this cave. I lost half my supplies in the chaos, too...","nextNodeIds":[701230402]},{"nodeId":701230402,"roleType":"TALK_ROLE_NPC","speakerId":20183,"speakerName":"Scribbled Note","textMapHash":4153153642,"text":"I don't know why, either, but the rocks above the cave collapsed suddenly, sealing the entrance with the falling gravel. This is very bad...","nextNodeIds":[701230403]},{"nodeId":701230403,"roleType":"TALK_ROLE_NPC","speakerId":20183,"speakerName":"Scribbled Note","textMapHash":1179188962,"text":"But... I believe that there's another way out for me. The other end of this cave is a cliff, yes, but there's nothing below but thick snow. If I try climbing a certain distance down and then jumping the rest of the way...","nextNodeIds":[701230404]},{"nodeId":701230404,"roleType":"TALK_ROLE_NPC","speakerId":20183,"speakerName":"Scribbled Note","textMapHash":1357235722,"text":"My supplies won't last more than a few more days. I have to act soon...","nextNodeIds":[701230405]},{"nodeId":701230405,"roleType":"TALK_ROLE_NPC","speakerId":20183,"speakerName":"Scribbled Note","textMapHash":1653506146,"text":"I promised Joel that I'd take him to see the snow. I won't break that promise.","nextNodeIds":[701230406]},{"nodeId":701230406,"roleType":"TALK_ROLE_NPC","speakerId":20183,"speakerName":"Scribbled Note","textMapHash":4013071522,"text":"Oh, yes. If anyone sees these notes, please put some food into that feeding bowl for those foxes.","nextNodeIds":[701230407]},{"nodeId":701230407,"roleType":"TALK_ROLE_NPC","speakerId":20183,"speakerName":"Scribbled Note","textMapHash":3445019114,"text":"They kept me company the entire time I was trapped in here. If I get the chance, I'd love to bring Joel back here to see them...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7012303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133008371"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7012303","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7012304,"order":4,"stepDescription":"Head for the summit to search for Joel's father","stepDescTextMapHash":4062110812,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7012304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7012304","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7012304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133008373"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["3","133008064,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["3","133008389,2"],"PAINLIBBLDK":"QUEST_EXEC_RE