lkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7012305","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7012305,"initDialog":701230501,"nextRandomTalks":[],"nextTalks":[],"npcId":[1668],"performCfg":"","priority":0,"questId":70123,"showRandomTalkCount":0},"dialogs":[{"nodeId":701230501,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":2417439674,"text":"How did it go? Any news from Daddy?","nextNodeIds":[701230502,701230511]},{"nodeId":701230502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2618830986,"text":"Here's what we discovered in the cavern at the summit...","nextNodeIds":[701230503]},{"nodeId":701230503,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":2808855058,"text":"Daddy... No, that can't be. Daddy's a great adventurer! He'd get out of a small rough patch like this for sure.","nextNodeIds":[701230504]},{"nodeId":701230504,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":923614234,"text":"He said that he'd found a way down the mountain in his notes, didn't he? He must've made it down safely. That's gotta be it.","nextNodeIds":[701230505]},{"nodeId":701230505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1277455722,"text":"I suppose he made it down safely...","nextNodeIds":[701230506]},{"nodeId":701230506,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":2014014194,"text":"Exactly. He must've! He might even be resting right now.","nextNodeIds":[701230507]},{"nodeId":701230507,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":3475357906,"text":"Or... he might have set up a new campsite at the summit, and is taking a break there right now...","nextNodeIds":[701230508]},{"nodeId":701230508,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":2942167762,"text":"Whatever the case, I'm sure that once he's all rested up, Daddy will come here and look for me...","nextNodeIds":[701230509]},{"nodeId":701230509,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":1135427634,"text":"I'll keep waiting for him here. Thanks for helping me out, by the way. Here, these are for you.","nextNodeIds":[]},{"nodeId":701230511,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3121017834,"text":"I didn't find anything.","nextNodeIds":[701230512]},{"nodeId":701230512,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":3620756418,"text":"R—Really? But that Knight of Favonius said that Daddy did go up the mountain.","nextNodeIds":[701230513]},{"nodeId":701230513,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":2140105642,"text":"Maybe he was mistaken... Or maybe Daddy set up a new campsite elsewhere...","nextNodeIds":[701230514]},{"nodeId":701230514,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":489817562,"text":"Well, guess I'll just wait here for him... I bet Daddy would be worried sick if he came home and couldn't find me.","nextNodeIds":[701230515]},{"nodeId":701230515,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":4104221802,