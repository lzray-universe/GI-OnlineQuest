{"mainQuestId":74518,"title":"Thinking Outside Every Box...","description":"After the wargames, the members of the Special Security and Surveillance Patrol seem to have gained new tactical insights...","titleTextMapHash":4106725087,"descTextMapHash":2960078294,"mainQuestExcel":{"mainQuestId":74518,"titleTextMapHash":4106725087,"title":"Thinking Outside Every Box...","descTextMapHash":2960078294,"description":"After the wargames, the members of the Special Security and Surveillance Patrol seem to have gained new tactical insights...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5266,"luaPath":"Actor/Quest/WQ74518","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5266,"chapterId":0,"descTextMapHash":2960078294,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74518,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1395560737,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74518","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174518],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4106725087,"type":"WQ","unlockDescTextMapHash":2355502958}},"flow":[{"subQuestId":7451801,"order":1,"stepDescription":"Talk to the members of the Maison Gardiennage","stepDescTextMapHash":3977665844,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30834"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7451801],"talks":[{"talkId":7451801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7451801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451801,"initDialog":745180101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30834,30835],"performCfg":"QuestDialogue/WQ/3405_74518/Q7451801","priority":5,"questId":74518,"showRandomTalkCount":0},"dialogs":[{"nodeId":745180101,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":1936836890,"text":"Hmm... the route taken by the attacking force, and their coordination with their supporting flank teams when targeting an enemy stronghold... These aspects must be studied further.","nextNodeIds":[745180102]},{"nodeId":745180102,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":1628643602,"text":"#But what about {NICKNAME}'s unorthodox tactics? They don't seem to make sense at a glance, and yet...","nextNodeIds":[745180103,745180104]},{"nodeId":745180103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2855861834,"text":"See something you like?","nextNodeIds":[745180105]},{"nodeId":745180105,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":703019914,"text":"Indeed! As you can see, once the main force has been deployed, it is difficult for them to disengage for a short period of time. This window is when covering the enemy's flanks and cutting off their reinforcements becomes crucial.","nextNodeIds":[745180106]},{"nodeId":745180106,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":2711494154,"text":"But with limited troops, it becomes difficult to decide how many to allocate to the support unit.","nextNodeIds":[745180107]},{"nodeId":745180107,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":3153427762,"text":"Ugh... If we had the numbers, we could downsize the main force. But if we couldn't spare many, we might not even be able to cut the enemy off... Nobody knows for sure how much manpower we'd have each time.","nextNodeIds":[745180108]},{"nodeId":745180108,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":2666743450,"text":"It's customary for the Special Patrol to form a support unit of about one quarter the strength of the main attacking force, and deploy them to patrol areas where we might expect enemy reinforcements to show up...","nextNodeIds":[745180109]},{"nodeId":745180109,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":792357730,"text":"Normally, this arrangement would suffice, although there have been exceptions... One time, while the support unit was leisurely patrolling their target area with no enemies in sight, the main force was running thin and had to fight for their lives...","nextNodeIds":[745180110]},{"nodeId":745180110,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":4252949114,"text":"But as for you, Proto-Boss — you planned your attack routes for the main force exceptionally well, coordinating their movements with those of the support unit.","nextNodeIds":[745180111]},{"nodeId":745180111,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":1858323842,"text":"That way, both units could rely on each other for support when it mattered, making the most of our manpower.","nextNodeIds":[745180112]},{"nodeId":745180112,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":127393210,"text":"When the main assault met heavy resistance, the support unit could act like reinforcements. Likewise, when enemy reinforcements suddenly arrived in force, both teams could move in tandem to intercept. Like an offensive-defensive unit!","nextNodeIds":[745180113,745180114]},{"nodeId":745180113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3999314122,"text":"That's just how I roll.","nextNodeIds":[745180115]},{"nodeId":745180115,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":156207106,"text":"Anyway, thanks to your unorthodox strategy, you've demolished the same third Assault Scenario that had Drillmaster Enghiene stumped...","nextNodeIds":[745180116]},{"nodeId":745180116,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":3702750674,"text":"...","nextNodeIds":[745180117]},{"nodeId":745180117,"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","textMapHash":313732954,"text":"Fine, I admit defeat! You'll be getting your limited-edition ammunition once we get back!","nextNodeIds":[745180118]},{"nodeId":745180118,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":2349030306,"text":"Hehe! The pleasure's all mine, Drillmaster!","nextNodeIds":[745180119]},{"nodeId":745180119,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":1626152946,"text":"The very same limited-edition bullets used by Captain Chevreuse, renowned for their precision and velocity over long distances... Hehehe...","nextNodeIds":[745180120]},{"nodeId":745180120,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":583832042,"text":"Ahem! Back to the topic at hand, I've always known you had an interest in firearms, Proto-Boss! I talked through some of the necessary application requirements with my colleagues, and you're a perfect fit!","nextNodeIds":[745180121]},{"nodeId":745180121,"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","textMapHash":2125969058,"text":"When you're free, we'll find an opportunity to get the relevant paperwork done, check up on your key data, and get you a custom-made musket of your own!","nextNodeIds":[]},{"nodeId":745180114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2081868162,"text":"Really? I just did whatever...","nextNodeIds":[745180115]},{"nodeId":745180104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2531451306,"text":"Any textbook examples for your recruits?","nextNodeIds":[745180105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30834"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7451801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30834,"speakerName":"Turenna","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":30835,"speakerName":"Enghiene","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174518],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2960078294,"CHECNJEMEFE":{"30834":[1190],"30835":[1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/3405_74518/Q7451801","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":745180101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7451801,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":