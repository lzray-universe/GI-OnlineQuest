{"mainQuestId":72738,"title":"Travelers' Tales: Destiny Drawn","description":"Something new seems to be happening at the Grand Narukami Shrine...","titleTextMapHash":2850691751,"descTextMapHash":2441985782,"mainQuestExcel":{"mainQuestId":72738,"titleTextMapHash":2850691751,"title":"Travelers' Tales: Destiny Drawn","descTextMapHash":2441985782,"description":"Something new seems to be happening at the Grand Narukami Shrine...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ72738","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2441985782,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72738,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3725142745,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72738","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172738],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2850691751,"type":"WQ","unlockDescTextMapHash":44787374}},"flow":[{"subQuestId":7273801,"order":1,"stepDescription":"Go to the Grand Narukami Shrine","stepDescTextMapHash":2591410436,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7273801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1034"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7273801],"talks":[{"talkId":7273801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7273801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7273801,"initDialog":727380101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1034],"performCfg":"QuestDialogue/WQ/NodKrai_72738/Q7273801","priority":5,"questId":72738,"showRandomTalkCount":0},"dialogs":[{"nodeId":727380101,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1228183722,"text":"Yes, that'll do. Just a quick and simple cleanup job...","nextNodeIds":[727380102]},{"nodeId":727380102,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3429400226,"text":"Ah, little one, you're just in time.","nextNodeIds":[727380103,727380104]},{"nodeId":727380103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2979305002,"text":"Just in time... In time for what?","nextNodeIds":[727380105]},{"nodeId":727380105,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1497282418,"text":"Oh, look at you. I can tell you're thinking. \"Oh no, she's going to send me off on some pain-in-the-neck errand again, isn't she?\"","nextNodeIds":[727380106]},{"nodeId":727380106,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2290494930,"text":"Don't worry, I was just going to say that we've finished renovating the shrine and are preparing to roll out a brand-new service.","nextNodeIds":[727380107]},{"nodeId":727380107,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2704565338,"text":"Now, I haven't had the chance to announce it yet, but here you are already. Wouldn't you agree that's good timing?","nextNodeIds":[727380108]},{"nodeId":727380108,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1675901314,"text":"See this offering box beside me? There's going to be another place to make wishes here soon.","nextNodeIds":[727380109]},{"nodeId":727380109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3913618842,"text":"Don't you already have fortune slips?","nextNodeIds":[727380110]},{"nodeId":727380110,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3909325690,"text":"That's different. Fortune slips are about telling fortunes, whereas this... is about making wishes.","nextNodeIds":[727380111]},{"nodeId":727380111,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3183191018,"text":"Now then, close your eyes, make a wish, write it down on a prayer plaque, then hang it up on this rack here, and maybe your wish will come true.","nextNodeIds":[727380112]},{"nodeId":727380112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2743884202,"text":"Can I wish for anything?","nextNodeIds":[727380113]},{"nodeId":727380113,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1529923874,"text":"Of course. But as for which wishes come true... That is up to the gods who watch over us all.","nextNodeIds":[727380114]},{"nodeId":727380114,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":348421138,"text":"Powerless Guuji that I am, I can only help you in mortal matters.","nextNodeIds":[727380115,727380116]},{"nodeId":727380115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1641017826,"text":"I wouldn't mind making some new friends...","nextNodeIds":[727380117]},{"nodeId":727380117,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3805301018,"text":"If that's what you wish for, then why not try it out? Here, take this fortune paper.","nextNodeIds":[727380118]},{"nodeId":727380118,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":4030174842,"text":"It's left over from writing fortune slips. You can have it.","nextNodeIds":[727380119]},{"nodeId":727380119,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3713260466,"text":"Try writing your wish there. That might make it more likely to come true.","nextNodeIds":[727380120]},{"nodeId":727380120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3304041898,"text":"Really?","nextNodeIds":[727380121]},{"nodeId":727380121,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3352798298,"text":"When have I ever lied to you? Hurry up now, little one, it's time to make your wish.","nextNodeIds":[727380122]},{"nodeId":727380122,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1794824874,"text":"Remember to write your wish on the fortune paper, then stick it to the prayer plaque and hang it on the rack...","nextNodeIds":[727380123]},{"nodeId":727380123,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2412458330,"text":"After that, your wish will be made.","nextNodeIds":[727380124]},{"nodeId":727380124,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3070804234,"text":"Yes. Nice and solemn. Very good.","nextNodeIds":[727380125]},{"nodeId":727380125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1066532978,"text":"Are you sure this'll work...?","nextNodeIds":[727380126]},{"nodeId":727380126,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":6254402,"text":"Alright, little one, back to business with you. Remember to keep your ears pricked and your eyes open!","nextNodeIds":[727380127]},{"nodeId":727380127,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2280021930,"text":"After all, the person you wish to meet might just be sitting at some noodle stand, having themselves a lovely bowl... And bring me back one while you're at it.","nextNodeIds":[]},{"nodeId":727380116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3578287666,"text":"I'd like to be reunited with some old friends...","nextNodeIds":[727380117]},{"nodeId":727380104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":627304122,"text":"Hold on a second... Where's this going?","nextNodeIds":[727380105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7273801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1034"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7273801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","count":19},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[172738],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2441985782,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/NodKrai_72738/Q7273801","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":727380101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7273801,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[1034],"KJLNGKKBBOI":"