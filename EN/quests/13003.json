{"mainQuestId":13003,"title":"Garden Memories","description":"Now that you've left the lab, you should inform Katheryne that the contamination issue has been resolved.","titleTextMapHash":2376344271,"descTextMapHash":891967110,"mainQuestExcel":{"mainQuestId":13003,"titleTextMapHash":2376344271,"title":"Garden Memories","descTextMapHash":891967110,"description":"Now that you've left the lab, you should inform Katheryne that the contamination issue has been resolved.","chapterId":2030,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/LQ13003","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":2030,"descTextMapHash":891967110,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":13003,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1810093273,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/LQ13003","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":2031,"rewardIdList":[113003],"series":13000,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2376344271,"type":"LQ","unlockDescTextMapHash":3833704494}},"flow":[{"subQuestId":1300301,"order":1,"stepDescription":"Talk to Katheryne in Sumeru","stepDescTextMapHash":3368444500,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1300301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EM