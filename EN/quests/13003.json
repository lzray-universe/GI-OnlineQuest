XEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1300303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1300303,"initDialog":130030301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1050,12686],"performCfg":"QuestDialogue/LQ/Tighnari1_13003/Q1300303","priority":5,"questId":13003,"showRandomTalkCount":0},"dialogs":[{"nodeId":130030301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4117629770,"text":"Tighnari—","nextNodeIds":[130030302]},{"nodeId":130030302,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":1285583154,"text":"Shh, keep your voice down.","nextNodeIds":[130030303]},{"nodeId":130030303,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":123016682,"text":"The Lilac Daphne, a daphne of the genus Thymelaeaceae, has a strong anticonvulsant effect. It can also be made into an anesthetic powder...","nextNodeIds":[130030304]},{"nodeId":130030304,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":2875019042,"text":"Extrapolating from these two data sets, it would be particularly potent against piscine species... Hey, make sure you're getting all this down.","nextNodeIds":[130030305]},{"nodeId":130030305,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"Karkata","textMapHash":1078157530,"text":"Kolu!","nextNodeIds":[130030306]},{"nodeId":130030306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2991449530,"text":"Karkata!?","nextNodeIds":[130030307]},{"nodeId":130030307,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"Karkata","textMapHash":3308000658,"text":"Kalu! Kalu!","nextNodeIds":[130030308]},{"nodeId":130030308,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":2195134066,"text":"I thought I told you all to keep your voices low. Plants aren't afraid of noise, but your shouting is making my ears ring.","nextNodeIds":[130030309]},{"nodeId":130030309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":858217306,"text":"Y—You didn't disassemble Karkata?","nextNodeIds":[130030310]},{"nodeId":130030310,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":142814802,"text":"Why would I do that?","nextNodeIds":[130030311]},{"nodeId":130030311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":552424682,"text":"But Paimon thought you said, \"According to the Akademiya's policies\"...","nextNodeIds":[130030312]},{"nodeId":130030312,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":2955702242,"text":"So that's why you two barged in like barbarians at this hour. Fine, I suppose I wasn't clear enough about this yesterday.","nextNodeIds":[130030313]},{"nodeId":130030313,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":4108371154,"text":"What I meant was, according to the Akademiya's policies, all products of research must be destroyed. That's why we can't let the Akademiya discover that place.","nextNodeIds":[130030314]},{"nodeId":130030314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1433079602,"text":"So the real reason you stayed back was to...","nextNodeIds":[130030315]},{"nodeId":130030315,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":2966199050,"text":"Anyway, the first thing I did was repair Karkata. During my time at the Akademiya, I took an elective course at the Spantamad. Who knew it would prove useful one day.","nextNodeIds":[130030316]},{"nodeId":130030316,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":2986691458,"text":"We then buried Abattouy together. After organizing the research materials, I kept some as a souvenir, most of it was burned to hide the evidence.","nextNodeIds":[130030317]},{"nodeId":130030317,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":1892987858,"text":"I'm not with the Akademiya, so what do their policies have to do with me? On the other hand, I am the Forest Watcher of the Avidya Forest. I have a duty to protect all life in the forest.","nextNodeIds":[130030318]},{"nodeId":130030318,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":1875385858,"text":"All life brought forth in this world has meaning, and Karkata is no exception. If it exists, then it shouldn't be carelessly abandoned or destroyed.","nextNodeIds":[130030319]},{"nodeId":130030319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2632752170,"text":"Hehe, that's great!","nextNodeIds":[130030320]},{"nodeId":130030320,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"Karkata","textMapHash":2839178554,"text":"Kulilu?","nextNodeIds":[130030321]},{"nodeId":130030321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1014320178,"text":"Wait, you just said \"life form.\" You recognize Karkata as a true living being now?","nextNodeIds":[130030322]},{"nodeId":130030322,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":2094876514,"text":"The possibility exists is all. It's hard to explain Karkata's efforts to \"repair\" Abattouy.","nextNodeIds":[130030323]},{"nodeId":130030323,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":3051827394,"text":"Abattouy only left behind a small portion of his research. Who knows how many commands he installed.","nextNodeIds":[130030324]},{"nodeId":130030324,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":3629303226,"text":"Maybe a conflict between all those commands resulted in this sort of behavior.","nextNodeIds":[130030325]},{"nodeId":130030325,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":3268633898,"text":"From a more rigorous perspective, it is impossible to conclude that Karkata is a real life form, but the possibility exists — I am willing to believe in that.","nextNodeIds":[130030326]},{"nodeId":130030326,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"Karkata","textMapHash":857765162,"text":"Kolu!","nextNodeIds":[130030327]},{"nodeId":130030327,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":1026843730,"text":"By the way, I'm not interested in continuing research on this subject. I'm just letting it hang out here because this place is relatively secluded.","nextNodeIds":[130030328]},{"nodeId":130030328,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"Tighnari","textMapHash":387128730,"text":"But as things stand now, it wouldn't be a bad idea to make it my research assistant. At the very least, it can record my experiments.","nextNodeIds":[130030329]},{"nodeId":130030329,"roleType":"TALK_ROLE_NPC","s