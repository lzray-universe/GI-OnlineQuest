tTalks":[],"npcId":[4019],"performCfg":"QuestDialogue/LQ/Tighnari1_13003/Q1300301","priority":5,"questId":13003,"showRandomTalkCount":0},"dialogs":[{"nodeId":130030101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":131726794,"text":"...Anyway, so the contaminated region turned out to be a Ley Line effluence deep in the forest. Things are already getting back to normal.","nextNodeIds":[130030102]},{"nodeId":130030102,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":3536394938,"text":"I see. Thank you for your hard work.","nextNodeIds":[130030103]},{"nodeId":130030103,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":471486922,"text":"Once the excess Ley Line energy dissipates from the air, we should be able to make an announcement for residents to resume their normal activities.","nextNodeIds":[130030104]},{"nodeId":130030104,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":3083582098,"text":"This is the stipulated reward. Please accept it.","nextNodeIds":[130030105]},{"nodeId":130030105,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3821108626,"text":"After leaving the Adventurers' Guild, Paimon takes you to a quiet place...","nextNodeIds":[130030106]},{"nodeId":130030106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2045223330,"text":"Is Karkata... going to be sent back to the Akademiya?","nextNodeIds":[130030107]},{"nodeId":130030107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1269519706,"text":"It's already damaged, but Paimon feels sad thinking about it getting disassembled.","nextNodeIds":[130030108]},{"nodeId":130030108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4094098506,"text":"Me too.","nextNodeIds":[130030109]},{"nodeId":130030109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3530437970,"text":"Oh! Then how about we find Tighnari tomorrow and ask him to not do that?","nextNodeIds":[130030110]},{"nodeId":130030110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2472334914,"text":"Paimon really wants to go right now, but Tighnari said that we would \"discuss matters tomorrow.\" We'll probably make him mad if we go now, huh?","nextNodeIds":[130030111]},{"nodeId":130030111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3256146738,"text":"Probably.","nextNodeIds":[130030112]},{"nodeId":130030112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3705316234,"text":"Alright then! We'll find Tighnari tomorrow and tell him not to disassemble Karkata!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1300301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4019"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1300302,"order":2,"stepDescription":"Wait till 8:00 – 12:00 the next day","stepDescTextMapHash":2158784492,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"8,12"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDAN