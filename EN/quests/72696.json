PLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30187"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7269601],"talks":[{"talkId":7269601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7269601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269601,"initDialog":726960101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30187],"performCfg":"QuestDialogue/WQ/Inazuma_72696/Q7269601","priority":5,"questId":72696,"showRandomTalkCount":0},"dialogs":[{"nodeId":726960101,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":765595690,"text":"Phew! Wow, that was close...","nextNodeIds":[726960102]},{"nodeId":726960102,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":614552290,"text":"So close, yes, very close indeed...","nextNodeIds":[726960103]},{"nodeId":726960103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3866583346,"text":"Bertrand, are you alright? You're sweating all over, and you look like you might collapse at any moment!","nextNodeIds":[726960104]},{"nodeId":726960104,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1905382842,"text":"I \"look like I might collapse,\" eh? Nay, I've already done so, yes indeed!","nextNodeIds":[726960105,726960106]},{"nodeId":726960105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4119980178,"text":"What's going on?","nextNodeIds":[726960107]},{"nodeId":726960107,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":4210079162,"text":"Heh, almost! Almost. But thanks to some emergency adjustments, performed triple-quick-time by yours truly, the process stabilized.","nextNodeIds":[726960108]},{"nodeId":726960108,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2556176594,"text":"The elements are beginning to slowly fuse with the source materials we collected as we speak.","nextNodeIds":[726960109]},{"nodeId":726960109,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3151062290,"text":"Indeed, that was a really close shave! If I hadn't been able to control the elemental energy, I'd probably be competing with the Naganohara family's fireworks for highest recorded altitude right now.","nextNodeIds":[726960110]},{"nodeId":726960110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2565871970,"text":"I thought you said it won't explode.","nextNodeIds":[726960111]},{"nodeId":726960111,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1451895850,"text":"I said that the toys wouldn't explode — I never guaranteed that the machine that makes them would be similarly stable.","nextNodeIds":[726960112]},{"nodeId":726960112,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1932331026,"text":"But honestly, it's thanks to your help in this experiment that we even got this far. If I had tried doing this in one go from the start, I don't think there'd be anything left of the Great Machine, never mind there being any toys.","nextNodeIds":[726960113]},{"nodeId":726960113,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":4094669522,"text":"Alright then. This is the final step, also known as \"Core Activation.\"","nextNodeIds":[726960114]},{"nodeId":726960114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2095568954,"text":"Paimon remembers you mentioned this had to do with elemental creatures, right?","nextNodeIds":[726960115]},{"nodeId":726960115,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1617748882,"text":"Precisely. Elemental life forms are constantly being powered by the elements. Collecting this motive force and adding it to our machine is the final step.","nextNodeIds":[726960116]},{"nodeId":726960116,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3566641930,"text":"If I can make the toys, then I can keep making them. Then I can pay off my debt, earn a good sum, and live out my days in Inazuma in peace...","nextNodeIds":[726960117]},{"nodeId":726960117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1581184770,"text":"Eh? Not going back to Fontaine?","nextNodeIds":[726960118]},{"nodeId":726960118,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":447971042,"text":"Fontaine... Ah, Fontaine.","nextNodeIds":[726960119]},{"nodeId":726960119,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":800575122,"text":"#{NICKNAME}, Paimon, you have never been to Fontaine, I suppose. If you had, you would know...","nextNodeIds":[726960120]},{"nodeId":726960120,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3207069562,"text":"For some people, it is a most convenient place to live. But for others, it is naught but a place of grief and disappointment.","nextNodeIds":[726960121]},{"nodeId":726960121,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1417669546,"text":"The energy system there is very special, and no one knows how long it can be sustained. Thus, we must find alternative energy solutions before it all comes crashing down.","nextNodeIds":[726960122]},{"nodeId":726960122,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3308049346,"text":"And yet, change is even harder than we can imagine. The result of all this being... that I must now research alternative energy, alone and away from Fontaine.","nextNodeIds":[726960123]},{"nodeId":726960123,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1072276322,"text":"The Great Machine, too, is a product of that research, which is why it remains somewhat unstable and at risk of exploding if not handled with the utmost care...","nextNodeIds":[726960124]},{"nodeId":726960124,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2915140130,"text":"But someday—someday! Someday, I will find a good energy solution.","nextNodeIds":[726960125]},{"nodeId":726960125,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3770033642,"text":"And then I shall return to Fontaine.","nextNodeIds":[726960126]},{"nodeId":726960126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2866867370,"text":"Bertrand...","nextNodeIds":[726960127]},{"nodeId":726960127,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1146050506,"text":"Well, let's not talk about such things now. On to our final process.","nextNodeIds":[726960128]},{"nodeId":726960128,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":80611634,"text":"#My standard of living in Inazuma before I can return to Fontaine depends on you, {NICKNAME}!","nextNodeIds":[]},{"nodeId":726960106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2669628914,"text":"Did the elemental reactions fail?","nextNodeIds":[726960107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30187"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7269602,"order":2,"stepDescription":"Collect 3 portions of Core Propulsion by defeating 3 Slimes","stepDescTextMapHash":3522517028,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[5080,301],"PAINLIBBLDK":"QUEST_CONTENT_A