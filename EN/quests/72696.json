","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269604,"initDialog":726960401,"nextRandomTalks":[],"nextTalks":[],"npcId":[30187],"performCfg":"QuestDialogue/WQ/Inazuma_72696/Q7269604","priority":5,"questId":72696,"showRandomTalkCount":0},"dialogs":[{"nodeId":726960401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1847271354,"text":"Is this really a toy made by a machine from Fontaine?","nextNodeIds":[726960402]},{"nodeId":726960402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":538052066,"text":"...Hmm, this just doesn't fit with my image of Fontaine.","nextNodeIds":[726960403]},{"nodeId":726960403,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":961111594,"text":"Ah, but you see, making goods only in Fontaine's image is no way of guaranteeing mercantile success.","nextNodeIds":[726960404]},{"nodeId":726960404,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3784099178,"text":"To tell the truth, this production process does include my various gleanings from studying local popular culture. After all, you must win the people's hearts to earn your welcome.","nextNodeIds":[726960405]},{"nodeId":726960405,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2342418986,"text":"Will this stuff really be popular, though?","nextNodeIds":[726960406]},{"nodeId":726960406,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1409973586,"text":"*cough* Now, I am sure that there might be some early misunderstandings, but so long as we persevere and continue to improve on our work, I'm sure that they will someday be moved!","nextNodeIds":[726960407]},{"nodeId":726960407,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":812976074,"text":"Whatever the case may be, we have completed this first production cycle.","nextNodeIds":[726960408]},{"nodeId":726960408,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":4271526418,"text":"How did you find it? Fascinating, no?","nextNodeIds":[726960409]},{"nodeId":726960409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1391117922,"text":"It was decent.","nextNodeIds":[726960410]},{"nodeId":726960410,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3418135602,"text":"Hehe, alright. Hmm, I see, so this is what we can produce using these material ratios. Well, in that case, I shall keep this in storage... and also, this voucher is for you.","nextNodeIds":[726960417]},{"nodeId":726960417,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":398288026,"text":"As for this voucher, you can use it to redeem a robot with the same design as this one for free! If you like this model, then you need only redeem it using this voucher... Well, once we have established a stable production flow, of course.","nextNodeIds":[726960418]},{"nodeId":726960418,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":842316914,"text":"This is our first robotic toy, after all, so there are still some examinations to be done. We can't be producing exploding gadgets all the time, now can we?","nextNodeIds":[726960411]},{"nodeId":726960411,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2307424746,"text":"Hmm, and now, let's read the record of issues caused during the test run... It seems that we must make some adjustments to improve our efficiency.","nextNodeIds":[726960412]},{"nodeId":726960412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3452138354,"text":"Huh, you're actually pretty serious about all this, aren't you?","nextNodeIds":[726960413]},{"nodeId":726960413,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":724830690,"text":"Of course I am. As a person living alone in a faraway land, this machine and my creativity are all that sustain me.","nextNodeIds":[726960414]},{"nodeId":726960414,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3684123922,"text":"I mean, the Doushin who arrested me previously called these \"bizarre tricks.\" Hah! Well, I'll teach 'em to look down on these \"tricks.\"","nextNodeIds":[726960415]},{"nodeId":726960415,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2831822730,"text":"In any case, I must make some adjustments first such that I'll be able to begin mass production shortly.","nextNodeIds":[726960416]},{"nodeId":726960416,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1634080138,"text":"#Do come and lend me your aid when that time comes as well, alright, {NICKNAME}?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269604,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30187"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7269601,7269602,72