:"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12688"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2303001],"talks":[{"talkId":2303001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2303001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2303001,"initDialog":230300101,"nextRandomTalks":[],"nextTalks":[],"npcId":[12688,12689],"performCfg":"QuestDialogue/IQ/Sumeru_23030/Q2303001","priority":5,"questId":23030,"showRandomTalkCount":0},"dialogs":[{"nodeId":230300101,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":4025428906,"text":"More data — that's what we need!","nextNodeIds":[230300102]},{"nodeId":230300102,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":858562618,"text":"How can your devices function without data to support them?","nextNodeIds":[230300103]},{"nodeId":230300103,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":1340920074,"text":"So you suggest doing nothing till you get every single piece of data, huh?","nextNodeIds":[230300104]},{"nodeId":230300104,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":3871424986,"text":"Will you analyze every incoming wave while trying to catch fish? No! You just need to focus on the one that comes with the fish!","nextNodeIds":[230300105]},{"nodeId":230300105,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":433869882,"text":"Now I see why you never actually catch any fish.","nextNodeIds":[230300106]},{"nodeId":230300106,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":3355870882,"text":"Come on! You've never studied at Hara{RUBY#[S]Semiotics}vatat yourself! So just cut it with the wordplay, okay? We should really get to work.","nextNodeIds":[230300107]},{"nodeId":230300107,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":953412826,"text":"We can't afford more delays. Ours and Yasmin's theses might become obsolete if we take too long!","nextNodeIds":[230300108]},{"nodeId":230300108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3474436314,"text":"What are you arguing about?","nextNodeIds":[230300109]},{"nodeId":230300109,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":453791122,"text":"You're...","nextNodeIds":[230300110]},{"nodeId":230300110,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":1708156858,"text":"You must be the Traveler Yasmin mentioned. You've really helped us a lot.","nextNodeIds":[230300111]},{"nodeId":230300111,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":366743794,"text":"It's an honor to meet you, Traveler! An honor indeed!","nextNodeIds":[230300112]},{"nodeId":230300112,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":3105319538,"text":"My name is Pharez, and I study at Kshahrewar.","nextNodeIds":[230300113]},{"nodeId":230300113,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":663827754,"text":"My name is Ladep, and I'm a student of Spantamad.","nextNodeIds":[230300114]},{"nodeId":230300114,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":1940082066,"text":"Traveler, we could really use a favor from you.","nextNodeIds":[230300115]},{"nodeId":230300115,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":4126565522,"text":"You know that Yasmin has been sprinkling those potions around the Divine Tree's roots, right?","nextNodeIds":[230300116]},{"nodeId":230300116,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":1577648194,"text":"Well... Um... The potions seem to have caused a little problem recently...","nextNodeIds":[230300117]},{"nodeId":230300117,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":2714890010,"text":"Monsters of all kinds often appear at the potion-sprinkling sites.","nextNodeIds":[230300118]},{"nodeId":230300118,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":1224903178,"text":"I never changed anything about the formula or its proportions, I swear. As such, this must have been due to... Um, some unforeseen circumstances.","nextNodeIds":[230300119]},{"nodeId":230300119,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":2793851242,"text":"Whatever you say... Anyway, Traveler, please come with us to check the sites where Yasmin sprinkled the potions.","nextNodeIds":[230300120]},{"nodeId":230300120,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":19460922,"text":"There are probably lots of monsters, which precludes us from going there ourselves... We're going to need a companion with great martial prowess.","nextNodeIds":[230300121]},{"nodeId":230300121,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":3062755434,"text":"More importantly, even if the Fungi are not that dangerous, if the problem created by our potions reaches our tutor's ears...","nextNodeIds":[230300122]},{"nodeId":230300122,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":2287491978,"text":"Our thesis proposals will be doomed for sure...","nextNodeIds":[230300123]},{"nodeId":230300123,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":3489600010,"text":"Especially here in Spantamad, where a single error in the submitted data will result in serious criticism...","nextNodeIds":[230300124,230300125]},{"nodeId":230300124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1838518218,"text":"Alright, I'll do it.","nextNodeIds":[]},{"nodeId":230300125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1597476202,"text":"How have you dealt with similar conditions in the past?","nextNodeIds":[230300126]},{"nodeId":230300126,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":2144545490,"text":"Well, hiring an adventurer is the usual solution. We've also turned to our tutor before, asking him to help find us some trustworthy Eremite members.","nextNodeIds":[230300127]},{"nodeId":230300127,"roleType":"TALK_ROLE_NPC","speakerId":12689,"speakerName":"Pharez","textMapHash":1908044306,"text":"But you know, a tutor's patience is not always infinite. Given the current circumstances, we're hesitant to trouble him again...","nextNodeIds":[230300128]},{"nodeId":230300128,"roleType":"TALK_ROLE_NPC","speakerId":12688,"speakerName":"Ladep","textMapHash":185254130,"text":"So please, help us, Traveler! You're our only hope!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12688"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2303007,"order":2,"stepDescription":"Go with Ladep","stepDescTextMapHash":3268822708,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303007,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2303002_guide","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303007,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMM