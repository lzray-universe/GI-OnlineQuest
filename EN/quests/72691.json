{"mainQuestId":72691,"title":"Irodori Poetry: Part I","description":"The Mondstadt bard Lenne is discussing poetry quite passionately with the Inazuman poet Ootomo...","titleTextMapHash":1427700351,"descTextMapHash":3638742910,"mainQuestExcel":{"mainQuestId":72691,"titleTextMapHash":1427700351,"title":"Irodori Poetry: Part I","descTextMapHash":3638742910,"description":"The Mondstadt bard Lenne is discussing poetry quite passionately with the Inazuman poet Ootomo...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2012,"luaPath":"Actor/Quest/WQ72691","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2012,"chapterId":0,"descTextMapHash":3638742910,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72691,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3878885817,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72691","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172691],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1427700351,"type":"WQ","unlockDescTextMapHash":131661870}},"flow":[{"subQuestId":7269101,"order":1,"stepDescription":"Talk to Ootomo","stepDescTextMapHash":1384396556,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30172"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7269101],"talks":[{"talkId":7269101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7269101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269101,"initDialog":726910101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30172],"performCfg":"QuestDialogue/WQ/Inazuma_72691/Q7269101","priority":5,"questId":72691,"showRandomTalkCount":0},"dialogs":[{"nodeId":726910101,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":3475381402,"text":"#{F#Miss}{M#Mister}, I see that you've been walking back and forth in this area for some time now. I believe you must be someone who appreciates the elegance of the arts.","nextNodeIds":[726910102]},{"nodeId":726910102,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":2947042794,"text":"There is a question of elegance that I might need your help with. Would you mind lending me your aid?","nextNodeIds":[726910103]},{"nodeId":726910103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3408038426,"text":"Yes, what is it?","nextNodeIds":[726910104]},{"nodeId":726910104,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":3402880298,"text":"Though I have only just met this man, Lenne, a bard from Mondstadt, over here, we have already become fast friends.","nextNodeIds":[726910105]},{"nodeId":726910105,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":3465398722,"text":"Ootomo speaks the truth. We have only known each other for a few days, but I already have the greatest respect for his great learning.","nextNodeIds":[726910106]},{"nodeId":726910106,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":2288299570,"text":"Hehe, you are too kind, Lenne. In any case, we have made friends through poetry, and we're taking this opportunity to write a few collaborative works.","nextNodeIds":[726910107]},{"nodeId":726910107,"roleType":"TALK_ROLE_NPC","speakerId":30172,"speakerName":"Ootomo","textMapHash":3999413738,"text":"And since Lenne has gone through all the effort to come to Inazuma, he really wants to add a bit of that Inazuman flavor to his work.","nextNodeIds":[726910108]},{"nodeId":726910108,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":2897274266,"text":"Indeed. Unfortunately, my itinerary has been far too tight. I haven't had time to really go around and see the sights.","nextNodeIds":[726910109]},{"nodeId":726910109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1138369642,"text":"So, what can I do for you?","nextNodeIds":[726910110]},{"nodeId":726910110,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":1943788538,"text":"Friend, the theme of the poem I wish to write is \"nostalgia.\"","nextNodeIds":[726910111]},{"nodeId":726910111,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":1395344186,"text":"Upon seeing the sights in a distant land, a vagabond cannot help but remember their home. That is why I need to add some things into my poem that symbolize this distant place.","nextNodeIds":[726910112]},{"nodeId":726910112,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":1824508954,"text":"Could you help me take a few pictures from which I can draw some inspiration?","nextNodeIds":[726910113]},{"nodeId":726910113,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":4214397778,"text":"Inazuma should have a great number of unique sights to see, yes? For example, when you speak of Mondstadt, everyone's minds will turn to Dandelions or Windwheel Asters...","nextNodeIds":[726910114]},{"nodeId":726910114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3170205178,"text":"Ooh, Paimon gets it now. Well in that case, let's take a few pictures of some of Inazuma's regional specialties! That should do it.","nextNodeIds":[726910115]},{"nodeId":726910115,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":4249022930,"text":"Indeed, I would be in your debt if you would! Allow me to also write a copy of my half-done poem manuscript, just for you to use as reference material.","nextNodeIds":[726910116]},{"nodeId":726910116,"roleType":"TALK_ROLE_NPC","speakerId":30173,"speakerName":"Lenne","textMapHash":2952995922,"text":"As for the number of pictures that I will need, I think <color=#00E1FFFF>4</color>, each showcasing different contents, will do. I will also pay for any travel fees you may incur in the process.","nextNodeIds":[726910117]},{"nodeId":726910117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3392970890,"text":"#Well, {NICKNAME}, since Lenne's request seems clear, let's head out right now!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30172"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7269102,"order":2,"stepDescription":"Prepare 4 photos of Inazuman regional specialties related to the theme","stepDescTextMapHash":3148829228,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_IRODORI_POETRY_REACH_MIN_PROGRESS","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30173"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PA