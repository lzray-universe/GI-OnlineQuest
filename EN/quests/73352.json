{"mainQuestId":73352,"title":"Rocking Carriage","description":"Masud, known as the Phantom Toy Master, is at the Sabzeruz Festival recommending his new game to guests...","titleTextMapHash":740471991,"descTextMapHash":2070145054,"mainQuestExcel":{"mainQuestId":73352,"titleTextMapHash":740471991,"title":"Rocking Carriage","descTextMapHash":2070145054,"description":"Masud, known as the Phantom Toy Master, is at the Sabzeruz Festival recommending his new game to guests...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2034,"luaPath":"Actor/Quest/WQ73352","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2034,"chapterId":0,"descTextMapHash":2070145054,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73352,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":764855449,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73352","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173352],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":740471991,"type":"WQ","unlockDescTextMapHash":81335046}},"flow":[{"subQuestId":7335201,"order":1,"stepDescription":"Talk to Masud","stepDescTextMapHash":1113315956,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30659"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7335201],"talks":[{"talkId":7335201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7335201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7335201,"initDialog":733520101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30659],"performCfg":"QuestDialogue/WQ/SumeruBirth_73352/Q7335201","priority":5,"questId":73352,"showRandomTalkCount":0},"dialogs":[{"nodeId":733520101,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":3995660290,"text":"Why, my greetings to you, dear traveler from afar, and to your little friend. Have you been enjoying the Sabzeruz Festival?","nextNodeIds":[733520102]},{"nodeId":733520102,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":4253613746,"text":"If you're both interested, I, the Phantom Toy Master, shall be pleased to invite you to play a new game — the \"Rocking Carriage,\" a flower that blooms only during the Festival.","nextNodeIds":[733520103]},{"nodeId":733520103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":819646290,"text":"And what's that?","nextNodeIds":[733520104]},{"nodeId":733520104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1755747834,"text":"Just hearing the name, Paimon's kinda imagining Nahida happily swaying from side to side in her carriage!","nextNodeIds":[733520105,733520106]},{"nodeId":733520105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2114262482,"text":"Even I'm getting all gladsome over here!","nextNodeIds":[733520107]},{"nodeId":733520107,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":1618917906,"text":"Wonderful! All in Sumeru wish that the \"Dendro Archon shall be happy every day,\" after all.","nextNodeIds":[733520108]},{"nodeId":733520108,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":1702546434,"text":"That association you made... Ah, what an excellent scene! One that deserves to be rendered upon a magnificent scroll, if I do say so myself!","nextNodeIds":[733520109]},{"nodeId":733520109,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":4153299282,"text":"Still, the atmosphere of this game is a livelier thing. Rather than a celebration, it's best thought of as an adventure—","nextNodeIds":[733520110]},{"nodeId":733520110,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":2493639962,"text":"\"Smart or not, nice or naughty, every child with a good heart will receive their own Flower Carriage during the Sabzeruz Festival celebrations...\"","nextNodeIds":[733520111]},{"nodeId":733520111,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":292633130,"text":"\"Riding in their carriage, the children shall embark on unique adventures, encountering and overcoming danger, and finding the greatest treasure, a thousand blooming flowers...\"","nextNodeIds":[733520112,733520113]},{"nodeId":733520112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1417083138,"text":"Paimon's both smart and nice.","nextNodeIds":[733520114]},{"nodeId":733520114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":48771482,"text":"Hehe, that's right! And as for that treasure, it may as well be ours already!","nextNodeIds":[733520115]},{"nodeId":733520115,"roleType":"TALK_ROLE_NPC","speakerId":30659,"speakerName":"Masud","textMapHash":2330274570,"text":"Haha, good, good. In that case, play on, play to your hearts' content!","nextNodeIds":[]},{"nodeId":733520113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3656410538,"text":"Trust me, we're danger-overcoming pros.","nextNodeIds":[733520114]},{"nodeId":733520106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":699357890,"text":"Just hearing you say that makes me wanna watch Nahida do that too...","nextNodeIds":[733520107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"