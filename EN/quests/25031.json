traLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2503104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2503104,"initDialog":250310401,"nextRandomTalks":[],"nextTalks":[],"npcId":[20088],"performCfg":"QuestDialogue/IQ/Natlan_25031/Q2503104","priority":5,"questId":25031,"showRandomTalkCount":0},"dialogs":[{"nodeId":250310401,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":4047898962,"text":"Thank you, thanks for your help...","nextNodeIds":[250310402]},{"nodeId":250310402,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":3199706858,"text":"If I could have gotten rid of that damn bag earlier, I would have taken care of them all by myself.","nextNodeIds":[250310403]},{"nodeId":250310403,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":4230774002,"text":"No way! Then we'd have come to Natlan for nothing!","nextNodeIds":[250310404]},{"nodeId":250310404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3688613626,"text":"Hold up, are you... Alrani?","nextNodeIds":[250310405]},{"nodeId":250310405,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3886069778,"text":"#Huh? Y—You're {NICKNAME}, aren't you? It's really you!","nextNodeIds":[250310406]},{"nodeId":250310406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1199527106,"text":"This lady next to you, surely it's not...","nextNodeIds":[250310407]},{"nodeId":250310407,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":3630912290,"text":"Narzam, Treasure Hoarder. We've met before. You haven't forgotten, have you?","nextNodeIds":[250310408]},{"nodeId":250310408,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1028172306,"text":"Phew... You really are my savior! How many times have you saved me now? Once, twice...","nextNodeIds":[250310409]},{"nodeId":250310409,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":3220092394,"text":"I hope you're not counting that time you were with me. That happened because you insisted on staying.","nextNodeIds":[250310410]},{"nodeId":250310410,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":4267669642,"text":"Of course I'm not counting that time. And what do you mean I insisted on staying? I already paid you!","nextNodeIds":[250310411]},{"nodeId":250310411,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":1573491666,"text":"Yeah, just about enough to cover food and drinks...","nextNodeIds":[250310412]},{"nodeId":250310412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":689267994,"text":"Don't tell me you're here for your thesis again?","nextNodeIds":[250310413]},{"nodeId":250310413,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1145495770,"text":"Hehe, well... Given the countless hours of hard work I've put into it, I couldn't just let it all go to waste, could I...","nextNodeIds":[250310414]},{"nodeId":250310414,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3800811538,"text":"I applied for special funding from the Akademiya this time, and I even settled on a research topic as original as it gets.","nextNodeIds":[250310415]},{"nodeId":250310415,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3072264554,"text":"Besides, I have Narzam with me as my guard. She's chased all the bad guys away.","nextNodeIds":[250310416]},{"nodeId":250310416,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":3080429754,"text":"Probably more just the fact that we're not carrying anything valuable enough to make it worth their while...","nextNodeIds":[250310417,250310418]},{"nodeId":250310417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":236029098,"text":"But in the end...","nextNodeIds":[250310419]},{"nodeId":250310419,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":1101262058,"text":"...All this way, right from when we set out from the Children of Echoes, this girl's been clutching that bag with all her documents in as if it were a baby.","nextNodeIds":[250310420]},{"nodeId":250310420,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":3522131730,"text":"To be honest, even to me, she looks like some fool clinging on to treasure.","nextNodeIds":[250310421]},{"nodeId":250310421,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":2350850746,"text":"And someone carrying treasure, walking through an empty wilderness with only a single guard to protect her... Who wouldn't give that a try?","nextNodeIds":[250310422]},{"nodeId":250310422,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1460207322,"text":"Well, you're right about one thing... My bag is indeed full of treasure! Not only does it contain all my field interview records, but copies of various documents too.","nextNodeIds":[250310423]},{"nodeId":250310423,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1166261970,"text":"Armed with treasures like these, I'll have no problem writing my thesis!","nextNodeIds":[250310424]},{"nodeId":250310424,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3149568498,"text":"And my chosen topic — the \"Pilgrimage of the Return of the Sacred Flame.\" It's a subject of great importance, so I'll surely be able to graduate.","nextNodeIds":[250310425]},{"nodeId":250310425,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2591052322,"text":"Oh, and of course, I couldn't have done it without Tahmures. This was her idea in the first place! She really is a great friend, teehee...","nextNodeIds":[250310426]},{"nodeId":250310426,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3449939074,"text":"#Thank you once again, {NICKNAME}. If it wasn't for you, those bad guys would not only have ruined my books, they'd have stolen my money too!","nextNodeIds":[250310427]},{"nodeId":250310427,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":842587298,"text":"A while back, I finally managed to earn a bit of pocket money by helping organize some books and materials. If it had been stolen, I wouldn't be able to afford any new materials myself.","nextNodeIds":[250310428]},{"nodeId":250310428,"roleType":"TALK_ROLE_NPC","speakerId":20776,"speakerName":"Narzam","textMapHash":87622306,"text":"True, but you'd end up spending all your money on books regardless. If I hadn't confiscated your wallet, we'd have gone hungry for sure...","nextNodeIds":[250310429]},{"nodeId":250310429,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":536546474,"text":"I—I don't buy that many books... do I...?","nextNodeIds":[250310430]},{"nodeId":250310430,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":4177772794,"text":"Anyway, that's enough talk for now. We still need to head over to the People of the Springs to gather materials.","nextNodeIds":[250310431]},{"nodeId":250310431,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2638294290,"text":"Goodbye then! My thesis shall be finished next we meet — I guarantee it! And when that time comes, I'll treat you to a delicious meal!","nextNodeIds":[]},{"nodeId":250310418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3021016618,"text":"You still wound up running into trouble.","nextNodeIds":[250310419]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133504240"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133504634"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20088"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2503105,"order":5,"stepDescription":"Report back to Tahmures","stepDescTextMapHash":3535484340,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503105,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6087"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2503105],"talks":[{"talkId":2503105,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2503105","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2503105,"initDialog":250310501,"nextRandomTalks":[],"nextTalks":[],"npcId":[6087],"performCfg":"QuestDialogue/IQ/Natlan_25031/Q2503105","priority":5,"questId":25031,"showRandomTalkCount":0},"dialogs":[{"nodeId":250310501,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":2187887418,"text":"So, how did it go?","nextNodeIds":[250310502,250310503]},{"nodeId":250310502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1312729114,"text":"Alrani's safe and sound.","nextNodeIds":[250310504]},{"nodeId":250310504,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":647736802,"text":"Phew... I was worried sick. If you'd have taken any longer, I'd have set off searching myself!","nextNodeIds":[250310505]},{"nodeId":250310505,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":3102178490,"text":"Couldn't that fool have picked a slightly simpler topic? With her ability, I'm sure she'd still get a high enough grade to graduate.","nextNodeIds":[250310506]},{"nodeId":250310506,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":3077239658,"text":"She always chooses such huge topics, does heaps of preparation, then ends up with nothing to show for it.","nextNodeIds":[250310507]},{"nodeId":250310507,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":2533012690,"text":"Apologies... I'm letting myself get carried away. Thank you for your help. Please, take these as payment.","nextNodeIds":[250310508]},{"nodeId":250310508,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":2352870234,"t