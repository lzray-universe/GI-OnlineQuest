Talks":[],"nextTalks":[],"npcId":[6087],"performCfg":"QuestDialogue/IQ/Natlan_25031/Q2503101","priority":5,"questId":25031,"showRandomTalkCount":0},"dialogs":[{"nodeId":250310101,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":1177111738,"text":"This is bad... This is really bad...","nextNodeIds":[250310102]},{"nodeId":250310102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2142828290,"text":"Something gone wrong with Alem's training?","nextNodeIds":[250310103]},{"nodeId":250310103,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":3432079970,"text":"#{NICKNAME}! Thank goodness you're here...","nextNodeIds":[250310104]},{"nodeId":250310104,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":992182250,"text":"There's no time to explain. Please help me save her!","nextNodeIds":[250310105,250310106]},{"nodeId":250310105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3614929450,"text":"Is she a friend?","nextNodeIds":[250310107]},{"nodeId":250310107,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":3519766578,"text":"I—I guess you could say that. We've both broken down several times over our theses, even cried our hearts out in the library together...","nextNodeIds":[250310108]},{"nodeId":250310108,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":1324421090,"text":"Aaaah, but now's not the time for all this! She just wouldn't listen to me!","nextNodeIds":[250310109]},{"nodeId":250310109,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":2580446226,"text":"She said she'd do anything for her thesis, then set off with that guard of hers, rambling about the wilderness together for who knows how long!","nextNodeIds":[250310110]},{"nodeId":250310110,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":332585618,"text":"But she still hasn't come back! And the tribe can't spare anyone to go rescue her...","nextNodeIds":[250310111]},{"nodeId":250310111,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":2991967290,"text":"#Please, {NICKNAME}, you have to go save her!","nextNodeIds":[250310112,250310113]},{"nodeId":250310112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2530783514,"text":"Leave it to me, I can handle it.","nextNodeIds":[250310115]},{"nodeId":250310115,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":2689509882,"text":"#Anyway, please help me out, {NICKNAME}! I'm counting on you!","nextNodeIds":[]},{"nodeId":250310113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4037189674,"text":"Seriously, you people from the Akademiya...","nextNodeIds":[250310114]},{"nodeId":250310114,"roleType":"TALK_ROLE_NPC","speakerId":6087,"speakerName":"Tahmures","textMapHash":193556338,"text":"That girl... *sigh* All I'll say is that her luck is truly shocking. She was even going on about making one last-ditch effort for her thesis in Natlan...","nextNodeIds":[250310115]},{"nodeId":250310106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4251525970,"text":"Is she an acquaintance?","nextNodeIds":[250310107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6087"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GU