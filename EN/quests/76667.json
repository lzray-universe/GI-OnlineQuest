L","heroTalk":"TALK_HERO_MAIN","id":7666701,"initDialog":766670101,"nextRandomTalks":[],"nextTalks":[7666702,7666703],"npcId":[7058],"performCfg":"","priority":5,"questId":76667,"showRandomTalkCount":0},"dialogs":[{"nodeId":766670101,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2242200930,"text":"Ugh... I should have brought more Lakkaberries...","nextNodeIds":[766670102,766670103]},{"nodeId":766670102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1083442178,"text":"(When Lauma was here last time...)","nextNodeIds":[766670104]},{"nodeId":766670104,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1329854586,"text":"#Hello, {NICKNAME}, are you here for a Feast of the Moon? I'm so sorry, but... you might have to wait a little while.","nextNodeIds":[766670105]},{"nodeId":766670105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4159698482,"text":"What is a Feast of the Moon?","nextNodeIds":[766670106]},{"nodeId":766670106,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":827650842,"text":"Huh? Didn't you get one last time...? Oh, right, Lady Lauma organized that one... and I guess she didn't mention the meal's official name.","nextNodeIds":[766670107]},{"nodeId":766670107,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2778145810,"text":"Simply put, a Feast of the Moon is a free meal we Frostmoon Scions distribute to those in need.","nextNodeIds":[766670108]},{"nodeId":766670108,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3331775906,"text":"Helping such people has ever been one of our traditions, though it used to be limited to the area around Hiisi Island...","nextNodeIds":[766670109]},{"nodeId":766670109,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":249235114,"text":"But under Lady Lauma's leadership and with everyone's help, we've gradually expanded our reach.","nextNodeIds":[766670110]},{"nodeId":766670110,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3105278882,"text":"Lady Lauma says this is part of spreading the Moon Goddess's Favor to all. There's a saying that goes... Um...","nextNodeIds":[766670111]},{"nodeId":766670111,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3151305906,"text":"\"The first fruit of the harvest must be placed upon the Moonlight Altar — not as an offering to the gods, but as a spark for...\"","nextNodeIds":[766670112]},{"nodeId":766670112,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3612154058,"text":"\"A spark for...\" Umm... What was the rest of it again...","nextNodeIds":[766670113]},{"nodeId":766670113,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":692799994,"text":"*Ahem*, anyway! This shop is one of the main distribution points for the meal. Hehe, and I manage almost everything here by myself! Pretty impressive, right?","nextNodeIds":[766670114]},{"nodeId":766670114,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2521353554,"text":"We've had a lot of trouble getting the meals out in Nasha Town, but I believe in what Lady Lauma says — we really can help more people this way!","nextNodeIds":[766670115]},{"nodeId":766670115,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3265459666,"text":"However... when I was preparing the ingredients yesterday, I forgot to close the box lid tightly, and when I woke up this morning, many fruits had been pecked open by birds and were completely unusable.","nextNodeIds":[766670116]},{"nodeId":766670116,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":398633146,"text":"I can barely make any Feasts of the Moon with the remaining Lakkaberries... *sigh*... What should I do now...","nextNodeIds":[]},{"nodeId":766670103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2606266914,"text":"(It seems they were handing out food...)","nextNodeIds":[766670104]}]},{"talkId":7666705,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7666701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7666701","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7666705,"initDialog":766670501,"nextRandomTalks":[],"nextTalks":[7666703,7666702],"npcId":[7058],"performCfg":"",