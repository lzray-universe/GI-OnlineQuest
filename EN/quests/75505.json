{"mainQuestId":75505,"title":"Aphid Treasure","description":"Some new little thingamajig has hit the market among the Children of Echoes recently...","titleTextMapHash":2571315623,"descTextMapHash":1763287550,"mainQuestExcel":{"mainQuestId":75505,"titleTextMapHash":2571315623,"title":"Aphid Treasure","descTextMapHash":1763287550,"description":"Some new little thingamajig has hit the market among the Children of Echoes recently...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5216,"luaPath":"Actor/Quest/WQ75505","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5216,"chapterId":0,"descTextMapHash":1763287550,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75505,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1386541361,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75505","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175505],"series":75505,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[75506],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2571315623,"type":"WQ","unlockDescTextMapHash":246230462}},"flow":[{"subQuestId":7550501,"order":1,"stepDescription":"Go to the Children of Echoes","stepDescTextMapHash":95502484,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7550501],"talks":[{"talkId":7550501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550501,"initDialog":755050101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1095],"performCfg":"QuestDialogue/WQ/3504_75505/Q7550501","priority":5,"questId":75505,"showRandomTalkCount":0},"dialogs":[{"nodeId":755050101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4121528626,"text":"Hey, Xilonen! Didn't expect to see you here.","nextNodeIds":[755050102]},{"nodeId":755050102,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":464865410,"text":"Hey there, Traveler, Paimon! What, is it so weird to see me at my own home?","nextNodeIds":[755050103]},{"nodeId":755050103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2957056378,"text":"Well, no, but Paimon thought you'd have found a beautiful tree to get a few days' shut-eye in by now since we just solved such a big problem.","nextNodeIds":[755050104]},{"nodeId":755050104,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3313319594,"text":"Haha, I'd love to, but everyone's been busy with the reconstruction. It'd feel wrong to slack off at a time like this.","nextNodeIds":[755050105]},{"nodeId":755050105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1887371266,"text":"So this is where you've decided to contribute?","nextNodeIds":[755050106]},{"nodeId":755050106,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1346151898,"text":"Here, let me show you something.","nextNodeIds":[755050107]},{"nodeId":755050107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3171674194,"text":"Wow! What a pretty jewel!","nextNodeIds":[755050108,755050110]},{"nodeId":755050108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4277424554,"text":"Looks very valuable.","nextNodeIds":[755050109]},{"nodeId":755050109,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2530868010,"text":"Yes, but that's not all.","nextNodeIds":[755050112]},{"nodeId":755050112,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1412882970,"text":"This is a Phlogiston Honey Pearl with peculiar patterning that's been making the rounds recently in the market. They're usually produced by Phlogiston Aphids. Pretty common, really.","nextNodeIds":[755050113]},{"nodeId":755050113,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1899865650,"text":"But these oddly patterned ones are both novel and scarce, making them quite expensive.","nextNodeIds":[755050114]},{"nodeId":755050114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2404007098,"text":"Paimon gets it! That's just like how we love treasure chests that have awesome-looking patterns on them too!","nextNodeIds":[755050115]},{"nodeId":755050115,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":100404674,"text":"Hehe, so I bought a few for my collection, and guess what? After a few days, the potted plant I was raising nearby had withered.","nextNodeIds":[755050116]},{"nodeId":755050116,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1164672842,"text":"I didn't think much of it at first. I mean, I don't know the first thing about growing plants anyway. Later, however, I heard Kachina say that some people got sick.","nextNodeIds":[755050117]},{"nodeId":755050117,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3388107562,"text":"Most of them were customers of Cheven's gemstone shop. Even Cheven herself proved no exception.","nextNodeIds":[755050118]},{"nodeId":755050118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":431630962,"text":"Huh? Wait... Did it all have something to do with this gem, then?","nextNodeIds":[755050119]},{"nodeId":755050119,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":4149717330,"text":"I thought so too, and so I smashed one open... and discovered that it contained some Abyssal energy.","nextNodeIds":[755050120]},{"nodeId":755050120,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":233311458,"text":"Low-concentration, of course, and isolated by the outer shell of the honey pearl itself — which made it almost undetectable.","nextNodeIds":[755050121]},{"nodeId":755050121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1147179202,"text":"What about the victims? How are they doing now?","nextNodeIds":[755050122]},{"nodeId":755050122,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3146633506,"text":"No need to worry. The low concentration resulted in rather minor maladies, with most being sleepy or being prone to exhaustion.","nextNodeIds":[755050123]},{"nodeId":755050123,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2496719274,"text":"It hasn't had any effect on the more fit, like myself or Kachina.","nextNodeIds":[755050124]},{"nodeId":755050124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1534180170,"text":"Phew... And here Paimon thought this might be a sticky situation.","nextNodeIds":[755050125]},{"nodeId":755050125,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":4294151442,"text":"Sticky? Like the honey in Honey Pearls?","nextNodeIds":[755050126]},{"nodeId":755050126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":805798754,"text":"I'd bet Paimon was thinking \"sticky like Slimes\" instead.","nextNodeIds":[755050127]},{"nodeId":755050127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1873149386,"text":"Hehe, you know it! And fortunately for us, this problem's only a threat to ordinary people, just like Slimes!","nextNodeIds":[755050128]},{"nodeId":755050128,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":28102522,"text":"Heh, you two really understand one another.","nextNodeIds":[755050129]},{"nodeId":755050129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2045373898,"text":"We totally do! Still, we've met lots of people scared stiff by Slimes, so it's not like we can ignore it just because it isn't dangerous for us, right?","nextNodeIds":[755050130]},{"nodeId":755050130,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":69779970,"text":"Exactly. I already explained the situation to our Chief, and asked him to collect and destroy all the strange Honey Pearls on the market.","nextNodeIds":[755050131]},{"nodeId":755050131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":487986962,"text":"But we still need to attack this issue at the source.","nextNodeIds":[755050132]},{"nodeId":755050132,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3655470786,"text":"My sentiments exactly. Like I said, Phlogiston Honey Pearls are produced by Phlogiston Aphids. If anything is the source of the problem, it'll be them.","nextNodeIds":[755050133]},{"nodeId":755050133,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":673318106,"text":"I went to look for Kinich, since he's got the better head for investigating between us. Yesterday, he sent word that he found Aphids with Abyssal contamination.","nextNodeIds":[755050134]},{"nodeId":755050134,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2996350186,"text":"There are also traces of their presence near the Scions of the Canopy and the People of the Springs. Right, and Kinich also notified Mualani.","nextNodeIds":[755050135]},{"nodeId":755050135,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":395909298,"text":"However, they're not exactly gemstone enthusiasts, so the problem didn't affect them as much.","nextNodeIds":[755050136]},{"nodeId":755050136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1190141314,"text":"Hmm... Looks like there are all sorts of lingering Abyss-related issues, huh? Guess we've gotta be patient.","nextNodeIds":[755050137]},{"nodeId":755050137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1429918386,"text":"How do you plan to deal with the Aphids?","nextNodeIds":[755050138]},{"nodeId":755050138,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":4275572810,"text":"Catch 'em first. We can still purify this level of Abyssal contamination, we shouldn't need to harm the Aphids.","nextNodeIds":[755050139]},{"nodeId":755050139,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3278171514,"text":"Kinich has marked out places where they gather, and I'm heading to a spot near our tribe.","nextNodeIds":[755050140]},{"nodeId":755050140,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":649261546,"text":"Would you like to come along, by the way? A little bug-catching sounds like fun, doesn't it?","nextNodeIds":[755050141]},{"nodeId":755050141,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":464304018,"text":"I'd have invited Kachina, but unfortunately, she's already occupied.","nextNodeIds":[755050142,755050146,755050148]},{"nodeId":755050142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1998447858,"text":"Are we there so you can slack off?","nextNodeIds":[755050143]},{"nodeId":755050143,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":946689394,"text":"Hah! Do I look like I'm going to lie down and watch you from a tree? We'll be working together.","nextNodeIds":[755050144]},{"nodeId":755050144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3946082106,"text":"Just kidding. Let's go.","nextNodeIds":[755050145]},{"nodeId":755050145,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2751678434,"text":"Glad to have you! Would've been a boring trip otherwise. Let's head off, then.","nextNodeIds":[]},{"nodeId":755050146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":292429666,"text":"I'm game.","nextNodeIds":[755050147]},{"nodeId":755050147,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3979919554,"text":"Glad to have you! Would've been a boring trip otherwise. Let's head off, then.","nextNodeIds":[]},{"nodeId":755050148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":7988866,"text":"Nah, seems like a boring gig.","nextNodeIds":[755050149]},{"nodeId":755050149,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3431673330,"text":"Ugh, guess it's crushing boredom for me, then... Sure you don't wanna come? I was planning on giving you a little something for your time, you know.","nextNodeIds":[755050150]},{"nodeId":755050150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1982079650,"text":"Ooh! There's pay? What is it?","nextNodeIds":[755050151]},{"nodeId":755050151,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":715673138,"text":"Shiny, shiny stuff. Pretty, too.","nextNodeIds":[755050152]},{"nodeId":755050152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2171395498,"text":"#Mora! It's gotta be Mora! C'mon, {NICKNAME}, are we gonna pass up a chance to make some money?","nextNodeIds":[755050153,755050155]},{"nodeId":755050153,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1018730714,"text":"Alright, I was just kidding earlier. Let's go!","nextNodeIds":[755050154]},{"nodeId":755050154,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1109132154,"text":"Haha, fine by me. Let's go.","nextNodeIds":[]},{"nodeId":755050155,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2669343250,"text":"Well, guess we'll do it for the Mora.","nextNodeIds":[755050156]},{"nodeId":755050156,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1785085786,"text":"Haha, fine by me. Let's go.","nextNodeIds":[]},{"nodeId":755050110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":580909194,"text":"Something looks off.","nextNodeIds":[755050111]},{"nodeId":755050111,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1333316026,"text":"Hah, sharp as always.","nextNodeIds":[755050112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7550502,"order":2,"stepDescription":"Go to where the Abyssal Aphids were spotted","stepDescTextMapHash":675995428,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["14830"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7550502],"talks":[{"talkId":7550502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550502,"initDialog":755050201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1095],"performCfg":"QuestDialogue/WQ/3504_75505/Q7550502","priority":5,"questId":75505,"showRandomTalkCount":0},"dialogs":[{"nodeId":755050201,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3835708858,"text":"This is our spot.","nextNodeIds":[755050202]},{"nodeId":755050202,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":394928162,"text":"See that? An Aphid, polluted with the power of the Abyss. Way larger than any normal one ever gets.","nextNodeIds":[755050203]},{"nodeId":755050203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":460636506,"text":"Whoa, what a huge Aphid... Uh, is it dangerous?","nextNodeIds":[755050204]},{"nodeId":755050204,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3406915954,"text":"Relax, even though it's been contaminated by the Abyss, its behavior doesn't seem to have changed at all.","nextNodeIds":[755050205]},{"nodeId":755050205,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":296506674,"text":"Still, I've specially prepared an extra-large insect net to make sure everything goes smoothly. Here ya go. It'll come in handy for catching them in a moment.","nextNodeIds":[755050206]},{"nodeId":755050206,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2683017722,"text":"Oh right! By the way, Kinich mentioned something rather unusual. He discovered that there's a special berry that always grows near areas where Abyssal Aphids are found.","nextNodeIds":[755050207]},{"nodeId":755050207,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2287457114,"text":"The berry contains a toxin that can paralyze the Aphids, so if we spread them on the net, it'll stop the Aphids from struggling.","nextNodeIds":[755050208]},{"nodeId":755050208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2566851074,"text":"Huh? Why are Aphids living around a berry that paralyzes them? Seems kinda strange to Paimon...","nextNodeIds":[755050209]},{"nodeId":755050209,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1607789154,"text":"I think so too. First time I've heard of animals living alongside something that's dangerous to them.","nextNodeIds":[755050210]},{"nodeId":755050210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1272452354,"text":"It's totally unnatural! Wait... Could someone be behind them getting infected with the Abyss!?","nextNodeIds":[755050211]},{"nodeId":755050211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2795217890,"text":"Paimon's sure on high alert these days.","nextNodeIds":[755050212]},{"nodeId":755050212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1976072674,"text":"Hey! Even the dumbest guides grow up! And Paimon was never dumb to start with anyway.","nextNodeIds":[755050213]},{"nodeId":755050213,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":885208874,"text":"The only problem with that is that we searched everywhere, but didn't find any trace of human involvement.","nextNodeIds":[755050214]},{"nodeId":755050214,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":565087562,"text":"So let's just chalk it up to some unknown natural Aphid behavior for now.","nextNodeIds":[755050215]},{"nodeId":755050215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2658119778,"text":"Fine, but no matter what, we've got to catch them first! We don't want anything else that makes people sick running around.","nextNodeIds":[755050216]},{"nodeId":755050216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2954453522,"text":"Bugbuster Squad, move out!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["14830"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7550503,"order":3,"stepDescription":"Capture the Abyssal Aphids","stepDescTextMapHash":3362366492,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[5216,7550503],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[5216,7550503],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7550504,"order":4,"stepDescription":"Talk to Xilonen","stepDescTextMapHash":2061174332,"finishConds":[{"BFGALAINLMD":0,"