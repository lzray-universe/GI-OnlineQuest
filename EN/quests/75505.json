"",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550503,"initDialog":755050301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1095],"performCfg":"QuestDialogue/WQ/3501_75505/Q7550503","priority":5,"questId":75505,"showRandomTalkCount":0},"dialogs":[{"nodeId":755050301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3187822850,"text":"Phew! We did it! Though this bugger certainly looks big, it was pretty easy to catch.","nextNodeIds":[755050302]},{"nodeId":755050302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":847082738,"text":"It's not dangerous at all, other than the fact it likes to run away. The insect net and numbing berries were really useful too!","nextNodeIds":[755050303]},{"nodeId":755050303,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3250467938,"text":"Hehe, but seeing as that it's the Abyss these Aphids are contaminated with, they could attract monsters. Best to be on your guard.","nextNodeIds":[755050304]},{"nodeId":755050304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":638483778,"text":"Yeah, you're right! And since these all-too-convenient berries just happen to be here... Well, if it was Paimon, she'd steer clear of any enemies!","nextNodeIds":[755050305]},{"nodeId":755050305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3162277602,"text":"#Being around berries like this isn't normal or natural, {NICKNAME}! We should keep our eyes peeled. There's something real fishy going on for sure!","nextNodeIds":[755050306]},{"nodeId":755050306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1103033650,"text":"You certainly look like an expert on suspicious goings-on.","nextNodeIds":[755050307]},{"nodeId":755050307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1239549882,"text":"Hehe, Paimon learned it from you!","nextNodeIds":[755050308]},{"nodeId":755050308,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2946648394,"text":"Ha!","nextNodeIds":[755050309]},{"nodeId":755050309,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":512560138,"text":"Anyway, thanks for coming out here with me. We've taken care of one area, so it's about time for a nice little break.","nextNodeIds":[755050310]},{"nodeId":755050310,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2374938994,"text":"After all, I'll need your help over the next few days too.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7550501,7550502,7550503],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","count":45},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":22},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":15}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[175505],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1763287550,"CHECNJEMEFE":{"1095":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGA