ype":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":1913169658,"text":"Lacquerware... how do you make those...","nextNodeIds":[220270102]},{"nodeId":220270102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2049153362,"text":"Why do you need lacquerware?","nextNodeIds":[220270103]},{"nodeId":220270103,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":1406823514,"text":"#Oh, it's you, {F#big sis}{M#big bro}. So here's the thing. Have you ever heard of a shrine's divine intervention?","nextNodeIds":[220270104]},{"nodeId":220270104,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":3307592242,"text":"From what I've heard, if you give precious offerings to the shrine, maybe your wishes will come true.","nextNodeIds":[220270105]},{"nodeId":220270105,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":2749152578,"text":"I think that pretty lacquerware is very valuable. If I used those as offerings to the shrine, then I'd be sure to get a reply.","nextNodeIds":[220270106]},{"nodeId":220270106,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":714323954,"text":"However, I don't have money to buy any lacquerware. That's why I want to make one for myself.","nextNodeIds":[220270107]},{"nodeId":220270107,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":3139634362,"text":"I heard that Nanatsuki from Yayoi Lacquerware is very good at making them...","nextNodeIds":[220270108]},{"nodeId":220270108,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":1614016914,"text":"#Could you go ask her about the lacquerware, {F#big sis}{M#big bro}?","nextNodeIds":[220270109,220270111]},{"nodeId":220270109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2536455610,"text":"No problem. Let's go.","nextNodeIds":[220270110]},{"nodeId":220270110,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":383106682,"text":"#Thank you, {F#big sis}{M#big bro}!","nextNodeIds":[]},{"nodeId":220270111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":826290306,"text":"Not going yourself?","nextNodeIds":[220270112]},{"nodeId":220270112,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":4039023154,"text":"Nanatsuki is pretty serious most of the time. I don't have the guts to go ask for her help myself...","nextNodeIds":[220270113]},{"nodeId":220270113,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":1305045050,"text":"#But if you're with me, {F#big sis}{M#big bro}, things will probably go better...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2202701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2202702,"order":2,"stepDescription":"Talk to Yayoi Nanatsuki","stepDescTextMapHash":868496132,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2202702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2202702],"talks":[{"talkId":2202702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2202702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2202702,"initDialog":220270201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3001],"performCfg":"QuestDialogue/IQ/Inazuma_22027/Q2202702","priority":5,"questId":22027,"showRandomTalkCount":0},"dialogs":[{"nodeId":220270201,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"Yayoi Nanatsuki","textMapHash":1339719306,"text":"Hello, is there anything I can help you with?","nextNodeIds":[220270202]},{"nodeId":220270202,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":3712754042,"text":"Uhh... so...","nextNodeIds":[220270203]},{"nodeId":220270203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3057252474,"text":"So, he wants to ask about lacquerware...","nextNodeIds":[220270204]},{"nodeId":220270204,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"Yayoi Nanatsuki","textMapHash":2776621586,"text":"Ah, so you want to offer lacquerwares to the shrine, and you want to make one yourself?","nextNodeIds":[220270205]},{"nodeId":220270205,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":1955565330,"text":"Please, Nanatsuki. I have a wish that I want to have fulfilled! That's why I... Don't worry, I won't tell anyone about your secret formula!","nextNodeIds":[220270206]},{"nodeId":220270206,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"Yayoi Nanatsuki","textMapHash":3222448082,"text":"The issue is not the painting formula. If you want to make beautiful lacquerware, leaving the paint aside, you also need a long period of practice.","nextNodeIds":[220270207]},{"nodeId":220270207,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"Yayoi Nanatsuki","textMapHash":1470172818,"text":"And this isn't just about time, it's more about... the capital. I am the fourth generation successor to a family of lacquerware-makers.","nextNodeIds":[220270208]},{"nodeId":220270208,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"Yayoi Nanatsuki","textMapHash":66481114,"text":"I even traveled to Sumeru to study lacquerwares. So it's impossible for you to grasp lacquerwares overnight.","nextNodeIds":[220270209]},{"nodeId":220270209,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":2888213122,"text":"Is... is that so? But I can't really think of anything else to offer to the shrine...","nextNodeIds":[220270210]},{"nodeId":220270210,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"Yayoi Nanatsuki","textMapHash":1940446730,"text":"In my opinion, it's not about the value of the item being offered to the shrine. This item you offer should represent your feelings.","nextNodeIds":[220270211]},{"nodeId":220270211,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"Yayoi Nanatsuki","textMapHash":1813304802,"text":"As long as you have the right feelings and intentions, and offer your favorite items, you should be able to get a response from the archons.","nextNodeIds":[220270212]},{"nodeId":220270212,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":1490944802,"text":"Right feelings and intentions... the things that I like...","nextNodeIds":[220270213]},{"nodeId":220270213,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":4146618058,"text":"Hmm, I think I get it... and I also don't. But thank you anyway, Nanatsuki.","nextNodeIds":[220270214]},{"nodeId":220270214,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"Shouta","textMapHash":3491437170,"text":"#Let's go back to the shrine first, {F#big sis}{M#big bro}. I still need your help with figuring out the kind of things I want to offer.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2202702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"Q