ng for you, Honorary Knight? If there's anything I can do to help, just say the word!","nextNodeIds":[]}]},{"talkId":7451904,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["0","1","74519","",""],"type":"TALK_EXEC_SET_QUEST_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7451901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","0","74519","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451904,"initDialog":745190401,"nextRandomTalks":[],"nextTalks":[],"npcId":[30907],"performCfg":"QuestDialogue/WQ/Fontaine_74519/Q7451904","priority":5,"questId":74519,"showRandomTalkCount":0},"dialogs":[{"nodeId":745190401,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":4001268714,"text":"Oh, hello there, Honorary Knight! Are you here to see Master Jean... Or is there something I can help you with?","nextNodeIds":[745190402,745190403]},{"nodeId":745190402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3385191074,"text":"I'm just having a little stroll.","nextNodeIds":[745190404]},{"nodeId":745190404,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":3039960986,"text":"I'm currently conducting a routine cleanup of the area around the Knights of Favonius offices. Most of the dust has been cleaned out at this point. Next, I'll be re-organizing our old files.","nextNodeIds":[745190405]},{"nodeId":745190405,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":1188778786,"text":"Those documents have piled up for a while now. I'm thinking that everyone will have an easier time looking them up if I sort them into different categories.","nextNodeIds":[745190406]},{"nodeId":745190406,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":1229187994,"text":"Also, I can learn a lot from those who came before me in the process. That's a form of training too, isn't it?","nextNodeIds":[745190407]},{"nodeId":745190407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3760272522,"text":"You're as serious about your work as ever, Noelle.","nextNodeIds":[745190408]},{"nodeId":745190408,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":1532955674,"text":"Just doing my duty. You and the other Knights are always pushing forward, so I've got to catch up as soon as I can.","nextNodeIds":[745190409,745190410]},{"nodeId":745190409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":930549634,"text":"Your resolve deserves remembrance...","nextNodeIds":[745190411]},{"nodeId":745190411,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":2748244130,"text":"Huh? Me? I mean, you're most welcome! It's just... I just finished cleaning, so I'll be covered in dust...","nextNodeIds":[745190412,745190413]},{"nodeId":745190412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":112260994,"text":"Ah, but that's the point! I mean to capture you at your hardest-working!","nextNodeIds":[745190414]},{"nodeId":745190414,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":3609725914,"text":"Um... I—Isn't it a bit too soon to call me that? But if you want to take the photo... It would be my honor, covered in dust though I may be!","nextNodeIds":[745190415]},{"nodeId":745190415,"roleType":"TALK_ROLE_NPC","speakerId":30907,"speakerName":"Noelle","textMapHash":2267689674,"text":"I'm sure you'll hit the shutter at the perfect moment!","nextNodeIds":[]},{"nodeId":745190413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3309143026,"text":"I mean to set the Maid Knight's \"decisive breakthrough\" onto film!","nextNodeIds":[745190414]},{"nodeId":745190410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1938911290,"text":"...So allow me to take a photo of you!","nextNodeIds":[745190411]},{"nodeId":745190403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":225769274,"text":"What are you busy with, Noelle?","nextNodeIds":[745190404]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7451901"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANL