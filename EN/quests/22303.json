,"PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2230301],"talks":[{"talkId":2230301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2230301","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2230301,"initDialog":223030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2040],"performCfg":"","priority":5,"questId":22303,"showRandomTalkCount":0},"dialogs":[{"nodeId":223030101,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":1814367404,"text":"Business seems to be grinding to a halt...","nextNodeIds":[223030102]},{"nodeId":223030102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2732987772,"text":"What's wrong?","nextNodeIds":[223030103]},{"nodeId":223030103,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":863780188,"text":"I was just saying, business is getting tougher and tougher in this tavern of mine.","nextNodeIds":[223030104]},{"nodeId":223030104,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":3693685260,"text":"For us in the food and drink business, having a long history is both a blessing and a curse.","nextNodeIds":[223030105]},{"nodeId":223030105,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":3264280404,"text":"The good part is, a long history gives you more of a reputation, which helps bring in business.","nextNodeIds":[223030106]},{"nodeId":223030106,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":488140684,"text":"The bad part is, people get bored of having the same thing over and over again. In big restaurants, where they have plenty of variety, that's obviously not a problem.","nextNodeIds":[223030107]},{"nodeId":223030107,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":1126594028,"text":"But my tavern is only a small one.","nextNodeIds":[223030108]},{"nodeId":223030108,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":1997293908,"text":"My long-term regulars are now finally starting to get bored with the drinks, and one by one they're leaving...","nextNodeIds":[223030109]},{"nodeId":223030109,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":1599023436,"text":"I've heard there's a big wine industry in Mondstadt. They have a famous Dandelion Wine, supposedly brewed with Dandelions.","nextNodeIds":[223030110]},{"nodeId":223030110,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":2702395604,"text":"I'm not even sure if brewing with Dandelions is possible... But I'd like to at least give it a try.","nextNodeIds":[223030111]},{"nodeId":223030111,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":1697517756,"text":"Could you go to Mondstadt and fetch some Dandelions for me?","nextNodeIds":[223030112,223030114]},{"nodeId":223030112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":676219892,"text":"Okay.","nextNodeIds":[223030113]},{"nodeId":223030113,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":3248176948,"text":"Great. You have my word I will pay you for your trouble. And in Liyue, our word is our bond.","nextNodeIds":[]},{"nodeId":223030114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2785868396,"text":"Dandelion wine?","nextNodeIds":[223030115]},{"nodeId":223030115,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":1694894308,"text":"You think it's a strange flavor? That may be, but I've heard it's extremely popular in Mondstadt.","nextNodeIds":[223030116]},{"nodeId":223030116,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":419635660,"text":"Although, it's not going to sell if I just copy the exact same recipe...","nextNodeIds":[223030117]},{"nodeId":223030117,"roleType":"TALK_ROLE_NPC","speakerId":2040,"speakerName":"Degui","textMapHash":286856052,"text":"Anyway, start by bringing me some <color=#00E1FFFF>Dandelions</color>, and in the meantime, I will think about how to add a little Liyue touch to the brewing process.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2230301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2040"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2230302,"order":2,"stepDescription":"Give the Dandelion to Degui","stepDescTextMapHash":969526094,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2230302,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC