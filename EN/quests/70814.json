,{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7081402,"initDialog":708140201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2016],"performCfg":"","priority":5,"questId":70814,"showRandomTalkCount":0},"dialogs":[{"nodeId":708140201,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":976646530,"text":"Was there anything else?","nextNodeIds":[708140202]},{"nodeId":708140202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":176282602,"text":"Have you found that sword of yours?","nextNodeIds":[708140203]},{"nodeId":708140203,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":802739154,"text":"...Huh, to think you still remember that. Unfortunately, no. I still don't have the foggiest idea where it might be.","nextNodeIds":[708140204]},{"nodeId":708140204,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":875090682,"text":"It seems I'm still at square one, waiting for things to happen.","nextNodeIds":[708140205]},{"nodeId":708140205,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2492995122,"text":"If anything related to that matter crops up, I might come looking for you — When that happens, I'll be counting on you.","nextNodeIds":[708140206]}]},{"talkId":7081403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7081401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7081403,"initDialog":708140301,"nextRandomTalks":[],"nextTalks":[],"npcId":[2096],"performCfg":"","priority":5,"questId":70814,"showRandomTalkCount":0},"dialogs":[{"nodeId":708140301,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2278861362,"text":"A—Are you an adventurer? Are you here to accept commissions?","nextNodeIds":[708140302]},{"nodeId":708140302,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":1646722378,"text":"Uh, please... wait a moment, let me see what I have here... \"Speed Glider,\" \"Outdoor Survival Experience Guide,\" \"Free Climbing Instructor Wanted...\"","nextNodeIds":[708140303]},{"nodeId":708140303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":270501882,"text":"That doesn't sound like the Adventurers' Guild...","nextNodeIds":[708140304]},{"nodeId":708140304,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2634851994,"text":"I know, and Lan says so too! But all the adventures I've read about in books were something like this...","nextNodeIds":[708140305]},{"nodeId":708140305,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":4266244290,"text":"If I don't give out these commissions, what should I give out, then...","nextNodeIds":[708140306]},{"nodeId":708140306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2044993154,"text":"Something like \"beat up monsters,\" perhaps?","nextNodeIds":[708140307]},{"nodeId":708140307,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":3695565194,"text":"I—Isn't that dangerous? I mean, there are a lot of them around Lisha, and they are a threat to passers-by.","nextNodeIds":[708140308]},{"nodeId":708140308,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":619774994,"text":"But normal people don't stand a chance against them. They might even get hurt...","nextNodeIds":[708140309,708140311]},{"nodeId":708140309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":401377322,"text":"Well then, leave it to me.","nextNodeIds":[708140310]},{"nodeId":708140310,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":3391045394,"text":"Can you really? Well.. Alright then, I'll leave it in your hands. I'll go back and discuss appropriate payment for your services with Lan.","nextNodeIds":[]},{"nodeId":708140311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3987452026,"text":"Adventurers are anything but ordinary.","nextNodeIds":[708140312]},{"nodeId":708140312,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":3673757338,"text":"Is that so... W—Well then, I'll let you handle it. I'll discuss your payment with Lan later.","nextNodeIds":[]}]},{"talkId":7081404,"talkConfig":{"checkActionAfter":false,"c