EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7081405,"initDialog":708140501,"nextRandomTalks":[],"nextTalks":[],"npcId":[2096],"performCfg":"","priority":5,"questId":70814,"showRandomTalkCount":0},"dialogs":[{"nodeId":708140501,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":3891267074,"text":"Eh? You're back already? Have you completed the commission?","nextNodeIds":[708140502]},{"nodeId":708140502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2506829770,"text":"Done, and done!","nextNodeIds":[708140503]},{"nodeId":708140503,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":996213146,"text":"That's... really impressive. I went back to the Guild to reorganize our commissions based on the one I gave you.","nextNodeIds":[708140504]},{"nodeId":708140504,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2807788058,"text":"There was a whole mountain of commissions related to defeating monsters. So adventurers are supposed to do this sort of thing all the time...","nextNodeIds":[708140505]},{"nodeId":708140505,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":756229714,"text":"But other than monsters, there've been reports that say that Treasure Hoarders have been seen along the roads.","nextNodeIds":[708140506]},{"nodeId":708140506,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":1587895994,"text":"Is this really also something the Adventurers' Guild should do? It feels like it falls under the job scope of the Millelith...","nextNodeIds":[708140507,708140509]},{"nodeId":708140507,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2294297546,"text":"We can do it.","nextNodeIds":[708140508]},{"nodeId":708140508,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":677607234,"text":"Huh. Adventurers can really do anything, it seems.","nextNodeIds":[708140511]},{"nodeId":708140511,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":1622286450,"text":"Well then, I will prepare adequate compensation for you — so please take this commission, too!","nextNodeIds":[708140512]},{"nodeId":708140512,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2401792018,"text":"What, another one already? We haven't gotten our...","nextNodeIds":[708140513]},{"nodeId":708140513,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":4183898514,"text":"There'll be further compensation! I've already discussed this with Lan. So as long as you complete the next commission, you'll receive further payment.","nextNodeIds":[708140514]},{"nodeId":708140514,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2094672066,"text":"Well, that sounds more like it.","nextNodeIds":[708140515]},{"nodeId":708140515,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":1021306858,"text":"I'll be counting on you, then.","nextNodeIds":[708140516]},{"nodeId":708140516,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2451873490,"text":"Well, that's two commissions down.","nextNodeIds":[708140517]},{"nodeId":708140517,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":2111838914,"text":"The secret method Lan taught me to \"get adventurers to take commissions gladly\" really works...","nextNodeIds":[]},{"nodeId":708140509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":590956362,"text":"If the money's good...","nextNodeIds":[708140510]},{"nodeId":708140510,"roleType":"TALK_ROLE_NPC","speakerId":2096,"speakerName":"Tiantian","textMapHash":4159638138,"text":"Adventurers really are impressive... It seems like you can do almost anything.","nextNodeIds":[708140511]}]},{"talkId":7081406,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7081403","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7081404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":[""