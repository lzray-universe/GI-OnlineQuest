og":1903102101,"nextRandomTalks":[],"nextTalks":[],"npcId":[10905],"performCfg":"QuestDialogue/COOP/CoopChongyun/coop_1903104","priority":5,"questId":19031,"showRandomTalkCount":0},"dialogs":[{"nodeId":1903102101,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":601866837,"text":"It's dangerous to walk alone here, isn't it?","nextNodeIds":[1903102102]},{"nodeId":1903102102,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":1189646061,"text":"You have no idea who... or what you'll meet.","nextNodeIds":[1903102103,1903102104]},{"nodeId":1903102103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1631805637,"text":"...","nextNodeIds":[1903102105]},{"nodeId":1903102105,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2794645021,"text":"Hmm, you seem to be pretty calm. You know, there's a saying, \"you can't keep your shoes dry if you keep walking along the river.\"","nextNodeIds":[1903102106]},{"nodeId":1903102106,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":487826109,"text":"You're bound to run into something in such a strange and eerie place...","nextNodeIds":[1903102107]},{"nodeId":1903102107,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":113967749,"text":"And what you encounter here could become a nightmare that haunts you for the rest of your life.","nextNodeIds":[1903102108,1903102109]},{"nodeId":1903102108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2120488317,"text":"Oh, really?","nextNodeIds":[1903102110]},{"nodeId":1903102110,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2201067925,"text":"Huh? How are you so calm? People usually run away in terror before I can even finish a sentence.","nextNodeIds":[1903102111,1903102114]},{"nodeId":1903102111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2769726829,"text":"You look like just another average person to me.","nextNodeIds":[1903102112]},{"nodeId":1903102112,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":1968905837,"text":"Yeah... but a more sophisticated way to play a ghost is to create a creepy atmosphere that scares people psychologically.","nextNodeIds":[1903102113]},{"nodeId":1903102113,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":1600174141,"text":"In which case, my appearance becomes irrelevant.","nextNodeIds":[1903102117]},{"nodeId":1903102117,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":1073665093,"text":"*sigh* Besides, I'll never be able to scare someone like you who doesn't believe in ghosts to begin with.","nextNodeIds":[1903102118]},{"nodeId":1903102118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":695843269,"text":"Sounds like you're just slacking off to me...","nextNodeIds":[1903102119]},{"nodeId":1903102119,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":882232509,"text":"Hey, that's not true! Oh, I'd better go find some wimps to scare now!","nextNodeIds":[1903102120]},{"nodeId":1903102120,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2335677325,"text":"You should go back and find your partner. He might be terrified by now.","nextNodeIds":[]},{"nodeId":1903102114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":118512013,"text":"Don't you have a costume or anything like that?","nextNodeIds":[1903102115]},{"nodeId":1903102115,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2592539229,"text":"Yes, I have one, but it's too hot to wear... and besides, a more sophisticated way to play a ghost is to create a creepy atmosphere that scares people psychologically.","nextNodeIds":[1903102116]},{"nodeId":1903102116,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2820410429,"text":"In which case, my appearance becomes irrelevant.","nextNodeIds":[1903102117]},{"nodeId":1903102109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4160734341,"text":"Sorry, I don't get it... What are you doing here?","nextNodeIds":[1903102110]},{"nodeId":1903102104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":83013365,"text":"Hello.","nextNodeIds":[1903102105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1903102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":1903106,"order":6,"stepDescription":"Talk to the staff","stepDescTextMapHash":2362003556,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1903102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[1903102],"talks":[{"talkId":1903102,"talkConfig":{"checkActionAf