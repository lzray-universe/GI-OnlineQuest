eIds":[1903102113]},{"nodeId":1903102113,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":1600174141,"text":"In which case, my appearance becomes irrelevant.","nextNodeIds":[1903102117]},{"nodeId":1903102117,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":1073665093,"text":"*sigh* Besides, I'll never be able to scare someone like you who doesn't believe in ghosts to begin with.","nextNodeIds":[1903102118]},{"nodeId":1903102118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":695843269,"text":"Sounds like you're just slacking off to me...","nextNodeIds":[1903102119]},{"nodeId":1903102119,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":882232509,"text":"Hey, that's not true! Oh, I'd better go find some wimps to scare now!","nextNodeIds":[1903102120]},{"nodeId":1903102120,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2335677325,"text":"You should go back and find your partner. He might be terrified by now.","nextNodeIds":[]},{"nodeId":1903102114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":118512013,"text":"Don't you have a costume or anything like that?","nextNodeIds":[1903102115]},{"nodeId":1903102115,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2592539229,"text":"Yes, I have one, but it's too hot to wear... and besides, a more sophisticated way to play a ghost is to create a creepy atmosphere that scares people psychologically.","nextNodeIds":[1903102116]},{"nodeId":1903102116,"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","textMapHash":2820410429,"text":"In which case, my appearance becomes irrelevant.","nextNodeIds":[1903102117]},{"nodeId":1903102109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4160734341,"text":"Sorry, I don't get it... What are you doing here?","nextNodeIds":[1903102110]},{"nodeId":1903102104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":83013365,"text":"Hello.","nextNodeIds":[1903102105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1903102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1903101,1903102],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":10905,"speakerName":"Fu San'er","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1023,"speakerName":"Chongyun","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3435794190,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[19032,19035],"GMENNHMBBOH":[],"HCJHEADFCAO":3003,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":190310101,"ILHDCGDK