{"mainQuestId":71520,"title":"Experiment Phase: Uncontrolled Parameters","description":"There seems to be a groaning Sumeru researcher in the suburbs of Liyue. This isn't the first time you've seen a groaning researcher, but you can't help but wonder what he's here for...","titleTextMapHash":3335523575,"descTextMapHash":3799290982,"mainQuestExcel":{"mainQuestId":71520,"titleTextMapHash":3335523575,"title":"Experiment Phase: Uncontrolled Parameters","descTextMapHash":3799290982,"description":"There seems to be a groaning Sumeru researcher in the suburbs of Liyue. This isn't the first time you've seen a groaning researcher, but you can't help but wonder what he's here for...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5138,"luaPath":"Actor/Quest/WQ71520","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5138,"chapterId":0,"descTextMapHash":3799290982,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71520,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2476226625,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71520","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171520],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3335523575,"type":"WQ","unlockDescTextMapHash":3636575734}},"flow":[{"subQuestId":7152001,"order":1,"stepDescription":"Talk to the groaning researcher","stepDescTextMapHash":3106321932,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7152001],"talks":[{"talkId":7152001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7152001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7152001,"initDialog":715200101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30225,1005],"performCfg":"QuestDialogue/WQ/Liyue_71520/Q7152001","priority":5,"questId":71520,"showRandomTalkCount":0},"dialogs":[{"nodeId":715200101,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4254275442,"text":"There's no way I'm gonna finish this... Guess I have no choice but to reduce the scale of my experiment. Let me think... How should I explain this to my mentor?","nextNodeIds":[715200102]},{"nodeId":715200102,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1749642610,"text":"\"Ohh, my experiment is way too hard to conduct! It's impossible to find the right materials, and I still failed after trying everything I could to build an ideal experiment environment!\"","nextNodeIds":[715200103]},{"nodeId":715200103,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2466466330,"text":"Ugh, what a lame excuse... I'm sure my mentor won't have any of that...","nextNodeIds":[715200104]},{"nodeId":715200104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2693012570,"text":"Maybe you should just tell him up front that you can't complete this project, then come up with a new proposal!","nextNodeIds":[715200105]},{"nodeId":715200105,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3980804666,"text":"Wh—Whoa... Don't just join the conversation when someone's talking to themselves!","nextNodeIds":[715200106]},{"nodeId":715200106,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":824953114,"text":"Oh hey, it's you! Do you still remember me? I'm Jami, an Amurta researcher.","nextNodeIds":[715200107,715200109]},{"nodeId":715200107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1929267738,"text":"Oh, you're the one who had a hard time with your thesis proposal...","nextNodeIds":[715200108]},{"nodeId":715200108,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4277439578,"text":"Yep, that's me. The Amurta researcher who was tormented by his thesis proposal and was this close to seeing the Dendro Archon.","nextNodeIds":[715200111]},{"nodeId":715200111,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1091056058,"text":"*sigh* Anyway, thank you for that suggestion, but as things currently stand, I'm pretty much past the point of no return... If I discontinue this project, my mentor would no doubt skin me alive...","nextNodeIds":[715200112]},{"nodeId":715200112,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1241360850,"text":"And that won't be all. He'll leave me to dry and turn me into a specimen, then place me inside the Amurta labs. My label would say \"Jami, who failed to live up to his mentor's expectations.\"","nextNodeIds":[715200113]},{"nodeId":715200113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":558196050,"text":"Sounds like the start of another urban legend at the Akademiya... Would mentors really do that?","nextNodeIds":[715200114]},{"nodeId":715200114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1218817418,"text":"That's way too exaggerated.","nextNodeIds":[715200115]},{"nodeId":715200115,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":201520554,"text":"Heh, I guess becoming a specimen wouldn't be too bad... I can at least serve as a warning to my juniors...","nextNodeIds":[715200116]},{"nodeId":715200116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3382018514,"text":"Whoa, he's become so depressed...","nextNodeIds":[715200117]},{"nodeId":715200117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1200023962,"text":"But why can't you just stop? You shouldn't force yourself to do something you can't do.","nextNodeIds":[715200118]},{"nodeId":715200118,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1613182002,"text":"It's complicated... and it's not really impossible to do either. I conducted a similar experiment in the past and even obtained some workable data...","nextNodeIds":[715200119]},{"nodeId":715200119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":604660330,"text":"Oh, that's great! Just continue working on your experiment then!","nextNodeIds":[715200120]},{"nodeId":715200120,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4250069458,"text":"*sigh* But everything went downhill from there. My previous experiment was such a huge success that my Darshan began having high hopes for my project. Even my mentor gave me a few compliments.","nextNodeIds":[715200121]},{"nodeId":715200121,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1954413290,"text":"\"You can do it Jami, I believe in you!\" ...Who would've thought that cranky old man would say something like that?","nextNodeIds":[715200122,715200123]},{"nodeId":715200122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":121509378,"text":"Isn't that a good thing?","nextNodeIds":[715200124]},{"nodeId":715200124,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1788690658,"text":"Yeah, I felt truly honored by their kindness and made an impulsive decision to turn my research project into an unprecedented success.","nextNodeIds":[715200125]},{"nodeId":715200125,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1058806562,"text":"Our Darshan had just received some new funds at that time.","nextNodeIds":[715200126]},{"nodeId":715200126,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":498635218,"text":"So I came here and built the best possible experimental site. I used the most advanced building materials and bought top-tier observation equipment at great expense.","nextNodeIds":[715200127]},{"nodeId":715200127,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1193648082,"text":"As I worked on constructing the site, I couldn't help but set the highest standards for everything.","nextNodeIds":[715200128]},{"nodeId":715200128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4008680586,"text":"Hehe, Paimon gets it! It's like walking into a restaurant and saying \"Just bring up all your best dishes!\" when ordering.","nextNodeIds":[715200129]},{"nodeId":715200129,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1966705642,"text":"Exactly! I was thoroughly won over by that feeling. Before I knew it, the costs began growing exponentially as the scale of my experiment increased.","nextNodeIds":[715200130]},{"nodeId":715200130,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1290610490,"text":"The experiment has developed to a point where it's impossible for me to complete, and the sheer cost of maintaining the site makes it difficult to hire additional assistance...","nextNodeIds":[715200131]},{"nodeId":715200131,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3983873498,"text":"But if I scale down my experiment, the matra would accuse me of not using the funds completely and pocketing the extra Mora for myself...","nextNodeIds":[715200132]},{"nodeId":715200132,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4176294130,"text":"Haha, maybe I should just turn myself in before the matra start suspecting... Oh, and before that, I have to enjoy one last meal at Lambad's Tavern.","nextNodeIds":[715200133]},{"nodeId":715200133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4243182594,"text":"\"Just bring up all your best dishes!\"","nextNodeIds":[715200134]},{"nodeId":715200134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3031920986,"text":"Ooh, can you take us with you? No, no, wait, are you sure there's nothing else you can do to save your experiment?","nextNodeIds":[715200135]},{"nodeId":715200135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3969994834,"text":"Just get to the point and tell us what's troubling you!","nextNodeIds":[715200136]},{"nodeId":715200136,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3859174402,"text":"I need more Mora...","nextNodeIds":[715200137]},{"nodeId":715200137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3428232258,"text":"#Hey, {NICKNAME}, is that a butterfly over there? Let's go check it out!","nextNodeIds":[715200138,715200139]},{"nodeId":715200138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2565228954,"text":"Looks like a flying lizard to me!","nextNodeIds":[715200140]},{"nodeId":715200140,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1744567770,"text":"Wait, don't go! Hear me out, please! I need the Mora to hire observers who can help with the experiment!","nextNodeIds":[715200141]},{"nodeId":715200141,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1804041738,"text":"If you don't mind helping, I wouldn't have to hire extra observers. After the experiment ends, I can simply sell as much equipment as I can and use that Mora as your compensation...","nextNodeIds":[715200142]},{"nodeId":715200142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3628167682,"text":"#Hmph. Whatcha think, {NICKNAME}?","nextNodeIds":[715200143]},{"nodeId":715200143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":689641162,"text":"Let's help him then.","nextNodeIds":[715200144]},{"nodeId":715200144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2264076890,"text":"But what exactly do \"observers\" of your experiment do?","nextNodeIds":[715200145]},{"nodeId":715200145,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3938425938,"text":"My project is centered on the defense deficiencies of various creatures. Collecting data requires you to engage in strategic combat while taking pictures.","nextNodeIds":[715200146]},{"nodeId":715200146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1270531154,"text":"...Paimon kinda gets why it's expensive to hire observers now.","nextNodeIds":[715200147]},{"nodeId":715200147,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3438533274,"text":"Yeah, it is a little dangerous, so you really don't have to help... Just remember to place some flowers before my specimen if you ever pass by the Amurta lab...","nextNodeIds":[715200148]},{"nodeId":715200148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1089226834,"text":"Alright, alright, we're pros at fighting monsters! But taking pictures while fighting sounds like a lot of trouble...","nextNodeIds":[715200149]},{"nodeId":715200149,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1640673874,"text":"Don't worry, because this is where my Fayz Potion comes into play!","nextNodeIds":[715200150]},{"nodeId":715200150,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":559420226,"text":"This potion only works inside the experimental site. Drinking it will allow you to subjectively feel as if time has slowed down.","nextNodeIds":[715200151]},{"nodeId":715200151,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3745965994,"text":"There's no guarantee that you'll be able to dodge every single attack, haha. But at least you'll have enough time to adjust the angle before taking a picture.","nextNodeIds":[715200152]},{"nodeId":715200152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":498422722,"text":"Paimon thinks he means: \"Injury is unavoidable, but please make sure the photos are good!\"","nextNodeIds":[715200153]},{"nodeId":715200153,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1956846730,"text":"With how skilled the both of you look, I'm sure you'll be fine.","nextNodeIds":[715200154]},{"nodeId":715200154,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3440538410,"text":"But compared to high-quality pictures, your safety always comes first. I mean it!","nextNodeIds":[715200155]},{"nodeId":715200155,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1810712298,"text":"We'll be careful!","nextNodeIds":[715200156]},{"nodeId":715200156,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1863341306,"text":"*sob* My entire academic career is in your hands... I'm counting on you!","nextNodeIds":[]},{"nodeId":715200139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2167197506,"text":"Let's go, Paimon!","nextNodeIds":[715200140]},{"nodeId":715200123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3515346250,"text":"But everyone's so nice to you.","nextNodeIds":[715200124]},{"nodeId":715200109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1263818634,"text":"Who?","nextNodeIds":[715200110]},{"nodeId":715200110,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2363446834,"text":"I'm that researcher whose proposal got rejected twice and couldn't get started on his experiment... They called me the \"groaning Akademiya researcher\" Jami.","nextNodeIds":[715200111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7152001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","count":32},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171520],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3799290982,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Liyue_71520/Q7152001","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":715200101,"ILHDCG