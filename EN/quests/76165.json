tions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7616502,"order":3,"stepDescription":"","stepDescTextMapHash":3573392516,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7616502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7616502],"talks":[{"talkId":7616502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7616502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7616502,"initDialog":761650201,"nextRandomTalks":[],"nextTalks":[],"npcId":[7647],"performCfg":"","priority":5,"questId":76165,"showRandomTalkCount":0},"dialogs":[{"nodeId":761650201,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":3922255346,"text":"Oh, greetings. I'm Patolichev, quartermaster of the Lightkeepers. How can I help you?","nextNodeIds":[761650202]},{"nodeId":761650202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3773192386,"text":"Are you Patolichev of the Frostgale Steeds?","nextNodeIds":[761650203]},{"nodeId":761650203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3814752826,"text":"The Frostgale Steeds... Ah, you mean those strange shadows we saw earlier...","nextNodeIds":[761650204]},{"nodeId":761650204,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":1245323674,"text":"Yes, that was the squad I once served with. The Frostgale Steeds... It's been a long time since I've heard that name. I never thought I'd hear it from someone else's mouth... May I ask how you...?","nextNodeIds":[761650205,761650208]},{"nodeId":761650205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2157149386,"text":"We've been to the foot of Kipumaki Cliff before.","nextNodeIds":[761650206]},{"nodeId":761650206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":829908194,"text":"Yep! And we took care of the Wild Hunt that was causing trouble there!","nextNodeIds":[761650207]},{"nodeId":761650207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1824286034,"text":"We even saw the Ratniki from the Frostgale Steeds... their shadows still lingering from their fight against the Wild Hunt...","nextNodeIds":[761650210]},{"nodeId":761650210,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":3283610154,"text":"I can't believe it was real...","nextNodeIds":[761650211]},{"nodeId":761650211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2109881410,"text":"Of course it was! We saw it with our own eyes!","nextNodeIds":[761650212]},{"nodeId":761650212,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":2583610458,"text":"Ah... Over the years, people have told me from time to time of how they've seen the figures of my fallen comrades at Kipumaki Cliff. That's why even now, I still go there often... and tend to their graves while I'm there.","nextNodeIds":[761650213]},{"nodeId":761650213,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":538378642,"text":"But not once... not even once, have I ever seen them myself. It's been so long... I thought those stories were just kind lies to comfort me.","nextNodeIds":[761650214]},{"nodeId":761650214,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":4039064986,"text":"And yet you truly saw them... Why is it that whenever I go, they never show themselves to me?","nextNodeIds":[761650215,761650217]},{"nodeId":761650215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1454540066,"text":"Maybe... the time just hasn't come yet.","nextNodeIds":[761650216]},{"nodeId":761650216,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":3259822842,"text":"Perhaps... Still, knowing they're really there, even as mere fleeting shadows or memories, is enough for me.","nextNodeIds":[761650219]},{"nodeId":761650219,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":3546936026,"text":"#In any case, thank you, {M#Sir}{F#Lady}, thank you for being willing to tell me. This means a lot to me.","nextNodeIds":[761650220]},{"nodeId":761650220,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":3684534362,"text":"It's thanks to them that I can still stand here today. And yet... how I wish I could stand with them once more at the foot of Kipumaki Cliff, fighting shoulder to shoulder again.","nextNodeIds":[761650221]},{"nodeId":761650221,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":2939205690,"text":"...One day. One day, I'm sure I'll meet them again.","nextNodeIds":[]},{"nodeId":761650217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1373324250,"text":"Maybe they just don't want you to recall the pain...","nextNodeIds":[761650218]},{"nodeId":761650218,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","textMapHash":4126939426,"text":"*sigh* Pain? No... Those final days, standing side by side with them to the very end... how could that ever be painful?","nextNodeIds":[761650219]},{"nodeId":761650208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2904576402,"text":"We saw the Ratniki of the Frostgale Steeds...","nextNodeIds":[761650209]},{"nodeId":761650209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4230626234,"text":"Yes... and even if only their shadows remain, those shadows still show them locked in battle with the Wild Hunt...","nextNodeIds":[761650210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7616502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7616501,7616502],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"Patolichev","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":360780206,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":761650101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7616501,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[1005,7665],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPF