NIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["7000"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7612901],"talks":[{"talkId":7612901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7612901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7612901,"initDialog":761290101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7000,7016],"performCfg":"QuestDialogue/WQ/NodKrai_76129/Q7612901","priority":5,"questId":76129,"showRandomTalkCount":0},"dialogs":[{"nodeId":761290101,"roleType":"TALK_ROLE_NPC","speakerId":7000,"speakerName":"Katheryne","textMapHash":2199130706,"text":"Thank you again for all the help you've given the Guild, Boss Nefer, Miss Jahoda.","nextNodeIds":[761290102]},{"nodeId":761290102,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3454769866,"text":"There's no need for that. Not when this is really a collaboration between us.","nextNodeIds":[761290103]},{"nodeId":761290103,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":3250645842,"text":"That's true, but I still want to thank you, Boss Nefer, for being so willing to help the Guild with the... complicated investigative work.","nextNodeIds":[761290104]},{"nodeId":761290104,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":771171938,"text":"The Adventurers' Guild has also sent several folks to help us with our work. We're all working together towards the same goal.","nextNodeIds":[761290105]},{"nodeId":761290105,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1418160274,"text":"I hope our future collaborations will be just as pleasant, Mr. Sarin.","nextNodeIds":[761290106]},{"nodeId":761290106,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":2014514706,"text":"You can rest assured, Boss Nefer, that the Adventurers' Guild...","nextNodeIds":[761290107]},{"nodeId":761290107,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":923898274,"text":"Oh, I should be clear about this. You can absolutely trust that we at the Nod-Krai Adventurers' Guild are your ever-reliable partners.","nextNodeIds":[761290108]},{"nodeId":761290108,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3923194466,"text":"Heh, that much is clear to me, yes.","nextNodeIds":[761290109]},{"nodeId":761290109,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":736308290,"text":"(Good, good, just keep talking like that, Boss Nef, my dearest Boss Nef, please don't look at me, please don't look at me, please don't look at me...)","nextNodeIds":[761290110]},{"nodeId":761290110,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":478856338,"text":"Jahoda, why are you keeping so quiet?","nextNodeIds":[761290111]},{"nodeId":761290111,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3226805002,"text":"(NO, she looked at me!!! Fine, just don't look at the commission board, please don't look at the commission board, please don't look at the commission boar—)","nextNodeIds":[761290112]},{"nodeId":761290112,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2710803362,"text":"Huh? M-me? Um, I don't have anything to say! Um... Thanks... for the commission...?","nextNodeIds":[761290113]},{"nodeId":761290113,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"Sarin","textMapHash":2683326490,"text":"Oh, we should also thank you for your assistance, Miss Jahoda. Without you, the paperwork at the Guild would've piled up into a mountain by now.","nextNodeIds":[761290114]},{"nodeId":761290114,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1299218738,"text":"No need for thank me... I'm getting paid, so I have to do the job right, of course...","nextNodeIds":[761290115]},{"nodeId":761290115,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":92531218,"text":"(*Sigh* Looks like she has forgotten everything I taught her to say...)","nextNodeIds":[761290116]},{"nodeId":761290116,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2704969650,"text":"By the way, since we're all here...","nextNodeIds":[761290117]},{"nodeId":761290117,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1072525194,"text":"(No! We had such a good vibe going, Boss! Please just give me a break, Boss!)","nextNodeIds":[761290118]},{"nodeId":761290118,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":695311946,"text":"Mr. Sarin, would you please bring over the latest batch of commissions?","nextNodeIds":[761290119]},{"nodeId":761290119,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":496882610,"text":"Jahoda, pick the commission you believe matters the most.","nextNodeIds":[761290120]},{"nodeId":761290120,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":2304612938,"text":"I want you to think this over carefully, so take your time, okay?","nextNodeIds":[761290121]},{"nodeId":761290121,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2908038362,"text":"Okay... Yes, Boss...","nextNodeIds":[761290122]},{"nodeId":761290122,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3529513050,"text":"(Ugh!!! I'm DOOMED!)","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7612901","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["7000"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7612901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","count":