10380101,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2626070186,"text":"Traveler, thank goodness you're here. I almost thought you wouldn't be back today.","nextNodeIds":[210380102]},{"nodeId":210380102,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2715412970,"text":"Today is the day I depart from Liyue Harbor. I have troubled you so much before... I have to thank you properly.","nextNodeIds":[210380103]},{"nodeId":210380103,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":640583530,"text":"...","nextNodeIds":[210380104]},{"nodeId":210380104,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1029801810,"text":"Ahem... I was just thinking about what to say after seeing you.","nextNodeIds":[210380105]},{"nodeId":210380105,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":3878874434,"text":"Now it's time for me to actually talk, I somehow don't even remember any of the words... Look at me, making a fool of myself even now, haha.","nextNodeIds":[210380106,210380107]},{"nodeId":210380106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2561965354,"text":"Don't worry about it. I'm sure we'll meet again soon.","nextNodeIds":[210380108]},{"nodeId":210380108,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":644349282,"text":"Really? Haha, that's wonderful news! I'll show you around when you get there!","nextNodeIds":[210380109]},{"nodeId":210380109,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2474185882,"text":"Well, I actually still have one last favor to ask. You have a Kamera, right? Do you mind taking a picture for me?","nextNodeIds":[210380110]},{"nodeId":210380110,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":3061976818,"text":"A sailor told me that it's best to keep a picture of your hometown with you when you are traveling abroad.","nextNodeIds":[210380111]},{"nodeId":210380111,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1099268290,"text":"But I don't own a Kamera, so maybe you'd be kind enough to help me out.","nextNodeIds":[210380112,210380113]},{"nodeId":210380112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2140604426,"text":"No problem.","nextNodeIds":[]},{"nodeId":210380113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1729986594,"text":"Strike a pose!","nextNodeIds":[210380114]},{"nodeId":210380114,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1273160338,"text":"P—Pose!? I—It's about the scenery behind me!","nextNodeIds":[]},{"nodeId":210380107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1787956290,"text":"I'll pay you a visit in Fontaine sometime.","nextNodeIds":[210380108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2103801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2400"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2103802,"order":2,"stepDescription":"Take a photo of Sun Yu","stepDescTextMapHash":1459197548,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2103802,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE",