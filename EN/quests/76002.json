60020305]},{"nodeId":760020305,"roleType":"TALK_ROLE_NPC","speakerId":22019,"speakerName":"Basu","textMapHash":3911238218,"text":"\"Mademoiselle Belleville\" is the name of this hunk of metal. Shipped all the way from the Fleuve Cendre, it wasn't easy getting it here. If it got snatched, we'd be ruined.","nextNodeIds":[760020306]},{"nodeId":760020306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1205899162,"text":"Ooh, a Fontainian clockwork meka? Wow, Fontaine tech really is something else. Imagine still working after being transported all this way...","nextNodeIds":[760020307]},{"nodeId":760020307,"roleType":"TALK_ROLE_NPC","speakerId":22019,"speakerName":"Basu","textMapHash":3386743210,"text":"Are you taking the Fonta? This thing's power system was ripped out ages ago. There's no way it's—","nextNodeIds":[760020308]},{"nodeId":760020308,"roleType":"TALK_ROLE_NPC","speakerId":22021,"speakerName":"Mademoiselle Belleville","textMapHash":186183082,"text":"WARNING. Startup mode <color=#FF9999FF>ANOMALOUS</color>. Energy module <color=#FF9999FF>ABNORMAL</color>. Verification failed.","nextNodeIds":[760020309]},{"nodeId":760020309,"roleType":"TALK_ROLE_NPC","speakerId":22021,"speakerName":"Mademoiselle Belleville","textMapHash":4043097186,"text":"Verification failed. <color=#FF9999FF>Verification failed</color>. <color=#FF9999FF>Verification failed</color>. <color=#FF9999FF>Annihilate</color>. <color=#FF9999FF>Annihilate</color>. <color=#FF9999FF>Annihilate</color>. <color=#FF9999FF>Annihilaaaaa—</color>","nextNodeIds":[760020310]},{"nodeId":760020310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":736084914,"text":"#Eek! {NICKNAME}, watch out!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7600203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"Q