Talks":[],"nextTalks":[],"npcId":[22020],"performCfg":"QuestDialogue/WQ/NodKrai_76002/Q7600205","priority":5,"questId":76002,"showRandomTalkCount":0},"dialogs":[{"nodeId":760020501,"roleType":"TALK_ROLE_NPC","speakerId":22020,"speakerName":"Hoyka","textMapHash":371461258,"text":"Ha! That's the end of that — foreign nutjob spouting nonsense, rambling on about liquidating my crew. Not doing much liquidating now he's frozen solid, 'ey?","nextNodeIds":[760020502]},{"nodeId":760020502,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":585702618,"text":"Phew... Now we've saved Nasha Town from being flooded with contraband! Oh, and hey, don't forget our reward!","nextNodeIds":[760020503]},{"nodeId":760020503,"roleType":"TALK_ROLE_NPC","speakerId":22020,"speakerName":"Hoyka","textMapHash":102920274,"text":"Hmph, don't get ahead of yourselves — I gotta check the goods first.","nextNodeIds":[760020504]},{"nodeId":760020504,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1534672866,"text":"Wait, check... the g—goods?","nextNodeIds":[760020505]},{"nodeId":760020505,"roleType":"TALK_ROLE_NPC","speakerId":22020,"speakerName":"Hoyka","textMapHash":4185622610,"text":"Of course! If something's wrong with the goods then we don't get nothin' — and your cut of nothin', is nothin'.","nextNodeIds":[760020506]},{"nodeId":760020506,"roleType":"TALK_ROLE_NPC","speakerId":22020,"speakerName":"Hoyka","textMapHash":3364343426,"text":"Tch... Look at these scratches. Rust, too! The Fleuve Cendre's getting real sloppy these days...","nextNodeIds":[760020507]},{"nodeId":760020507,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2241019962,"text":"Huh? Isn't that a Fontainian clockwork meka? Wow, Fontaine tech really is something else. Imagine still working after being transported all this way...","nextNodeIds":[760020508]},{"nodeId":760020508,"roleType":"TALK_ROLE_NPC","speakerId":22020,"speakerName":"Hoyka","textMapHash":3190479050,"text":"Still working? Give it a rest! The power system in this thing should've been ripped out ages ago. There's no way it's—","nextNodeIds":[760020509]},{"nodeId":760020509,"roleType":"TALK_ROLE_NPC","speakerId":22021,"speakerName":"Mademoiselle Belleville","textMapHash":1698096706,"text":"WARNING. Startup mode <color=#FF9999FF>ANOMALOUS</color>. Energy module <color=#FF9999FF>ABNORMAL</color>. Verification failed.","nextNodeIds":[760020510]},{"nodeId":760020510,"roleType":"TALK_ROLE_NPC","speakerId":22021,"speakerName":"Mademoiselle Belleville","textMapHash":1426073202,"text":"Verification failed. <color=#FF9999FF>Verification failed</color>. <color=#FF9999FF>Verification failed</color>. <color=#FF9999FF>Annihilate</color>. <color=#FF9999FF>Annihilate</color>. <color=#FF9999FF>Annihilate</color>. <color=#FF9999FF>Annihilaaaaa—</color>","nextNodeIds":[760020511]},{"nodeId":760020511,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1060030410,"text":"#Eek! {NICKNAME}, watch out!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7600205,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7600206,"order":6,"stepDescription":"","stepDescTextMapHash":1975440212,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7600206"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NON