61007,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3443839731,"text":"Sounds deep.","nextNodeIds":[3061009]},{"nodeId":3061009,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1115026459,"text":"It's what Lisa likes to say.","nextNodeIds":[3061010]},{"nodeId":3061010,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2163280267,"text":"Speaking of which, The Four Winds we were discussing earlier...","nextNodeIds":[3061011]},{"nodeId":3061011,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2861630515,"text":"If you want to learn more about our history, you can ask Lisa.","nextNodeIds":[3061012]},{"nodeId":3061012,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3544481795,"text":"...I'm not saying I don't know our history! It's just...","nextNodeIds":[3061013]},{"nodeId":3061013,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":701342155,"text":"I mean... A librarian is supposed to be more knowledgeable than an Outrider, right?","nextNodeIds":[]},{"nodeId":3061008,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1703313907,"text":"Did you come up with it?","nextNodeIds":[3061009]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[30610,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1001,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["1"],"PAINLIBBLDK":"QUEST_EXEC_REMOVE_TRIAL_AVATAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","