hCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7367605"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133303654","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133303655","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7367602_guide_Q7367604_N12760","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7367604,"order":5,"stepDescription":"Talk to Banu","stepDescTextMapHash":762352956,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367604,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7367602_guide_Q7367604_N12760"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7367604],"talks":[{"talkId":7367604,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367604,"initDialog":736760401,"nextRandomTalks":[],"nextTalks":[],"npcId":[12761,12760],"performCfg":"QuestDialogue/WQ/Sumeru_73676/Q7367604","priority":5,"questId":73676,"showRandomTalkCount":0},"dialogs":[{"nodeId":736760401,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":764574042,"text":"Banu, are you alright?","nextNodeIds":[736760402]},{"nodeId":736760402,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":901651762,"text":"C'mon, there was really nothing to worry about. The book you wrote has taught me to run away if I'm no match for the bad guys. So I did.","nextNodeIds":[736760403]},{"nodeId":736760403,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3513533234,"text":"And Shalmar, how come you've brought Apple with you? Isn't she supposed to be at home guarding the house?","nextNodeIds":[736760404]},{"nodeId":736760404,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2741220818,"text":"Apple was worried about you, so she came along. You know she only listens to you and your mom. There's no way I can persuade her to go back home.","nextNodeIds":[736760405,736760406]},{"nodeId":736760405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":945524674,"text":"Wait a second...","nextNodeIds":[736760407]},{"nodeId":736760407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":834309914,"text":"Banu seems to know that Rishboland Tiger jumping out of nowhere... Did she just call it Apple...? And that man showing up with that tiger... Ohh, Paimon's got a million questions...","nextNodeIds":[736760408]},{"nodeId":736760408,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":259929170,"text":"Ahem, please allow me to introduce...","nextNodeIds":[736760409]},{"nodeId":736760409,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":76945522,"text":"This klutz here is Shalmar, author of 50 Things Every Traveling Scholar Should Know, the book that I lent you.","nextNodeIds":[736760410]},{"nodeId":736760410,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1300617730,"text":"I meant to introduce both Shalmar and Apple to you after the summoning ceremony of the Great Future Star. But just as I expected, something unexpected happened.","nextNodeIds":[736760411]},{"nodeId":736760411,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2432301834,"text":"Well, at least we won't have to go looking for them. This accident was certainly unexpected, but it wasn't bad at all! If only I could be this lucky next time as well...","nextNodeIds":[736760412]},{"nodeId":736760412,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2896876290,"text":"Good day, I'm Shalmar, Banu's biological father.","nextNodeIds":[736760413]},{"nodeId":736760413,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2873673258,"text":"As for Apple, she's a graceful female Rishboland Tiger, and also a significant member of our family.","nextNodeIds":[736760414]},{"nodeId":736760414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2674057626,"text":"B—Biological father? What's that supposed to mean...? Are you not Banu's father in other respects?","nextNodeIds":[736760415]},{"nodeId":736760415,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":1631550882,"text":"That is correct. From my perspective, Banu and I share an equal friendship, while in everyday life, we are teammates, people who have divided the household chores between us.","nextNodeIds":[736760416]},{"nodeId":736760416,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":1706233994,"text":"Being a father is but the very most insignificant of my identities, and I much prefer being her friend to being her father.","nextNodeIds":[736760417]},{"nodeId":736760417,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":631958002,"text":"I have been listening to your conversation just now, all while hiding in that hole in the ground right beneath the mechanism. Now that I have heard how willing you are to help Banu, I must extend my gratitude to you.","nextNodeIds":[736760418]},{"nodeId":736760418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4029380578,"text":"You're welcome.","nextNodeIds":[736760419]},{"nodeId":736760419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1351171530,"text":"Well, this overly formal way of speaking... No wonder Banu talked to us like that when we first met...","nextNodeIds":[736760420]},{"nodeId":736760420,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":3459200218,"text":"Her phrasing and way of doing things are indeed similar to my own, but even as a child, I would say that Banu is a much more impressive person overall.","nextNodeIds":[736760421]},{"nodeId":736760421,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":4125981226,"text":"For example, the mixed rice she makes is 10,000 times better than the one I make. That alone is superb enough.","nextNodeIds":[736760422]},{"nodeId":736760422,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2261026554,"text":"Therefore, I cherish dearly my time spent with such a happy, lively, and marvelous child.","nextNodeIds":[736760423]},{"nodeId":736760423,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":3750771122,"text":"Whenever I think of her going to the Akademiya, pulling her hair out till midnight every day in the library, suffering from malnutrition due to irregular meal timings over long periods of time, and her hair turning white even before she turns 40...","nextNodeIds":[736760424]},{"nodeId":736760424,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":959191466,"text":"It pains me beyond description.","nextNodeIds":[736760425]},{"nodeId":736760425,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":526278362,"text":"So naturally, before she starts a new life in the Akademiya, I must seize every opportunity to create as many fun memories for her as I can. This \"Star-Seeker's Sojourn\" was designed for this exact purpose as well.","nextNodeIds":[736760460]},{"nodeId":736760460,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":1257352146,"text":"Since I am somewhat acquainted with both Ley Lines and mechanics, I've made some special arrangements regarding the mechanisms around these parts.","nextNodeIds":[736760461]},{"nodeId":736760461,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2957331562,"text":"Hey Shalmar, I gotta ask you this. Were you the one who called those monsters out — you know, when we were looking for the Future Stars, and just now too?","nextNodeIds":[736760462]},{"nodeId":736760462,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":32973514,"text":"No, I would never! They... were all accidents. I only have myself to blame for having put you in danger, all because of my lack of consideration...","nextNodeIds":[736760463]},{"nodeId":736760463,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2207395218,"text":"#I—I actually asked Apple to follow you in secret. As for this young adventurer, {M#he}{F#she} is apparently more than capable. So...","nextNodeIds":[736760464]},{"nodeId":736760464,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1081490138,"text":"*sigh* You are really an unreliable father, you know? What would you ever do without me and Apple?","nextNodeIds":[736760426]},{"nodeId":736760426,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":532418042,"text":"The two of us have been traveling for a long time, but we've never met a father as strange as you...","nextNodeIds":[736760427]},{"nodeId":736760427,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2923298522,"text":"You believe me to be strange? Well, being strange is one of my key traits, so that was one of the best compliments I could possibly receive.","nextNodeIds":[736760428]},{"nodeId":736760428,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4032252842,"text":"Is that part of your setting, too?","nextNodeIds":[736760429]},{"nodeId":736760429,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":1582862850,"text":"Indeed so. Otherwise, what would the difference between me and the tides of human mediocrity in this overpopulated world be?","nextNodeIds":[736760430]},{"nodeId":736760430,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":1774571386,"text":"No matter how strange my words and deeds are, I nonetheless remain an ordinary person in this vast world, and yet I have the freedom to talk nonsense — something that those prestigious sages can only dream of.","nextNodeIds":[736760431]},{"nodeId":736760431,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2261092354,"text":"Is that not such a delight?","nextNodeIds":[736760432]},{"nodeId":736760432,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3241836778,"text":"Don't be fooled by him. Every time he tries to hide something, he'll act like this and start talking nonsense.","nextNodeIds":[736760433]},{"nodeId":736760433,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":934941874,"text":"Anyway, Shalmar, where's my Great Future Star?","nextNodeIds":[736760434]},{"nodeId":736760434,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":692098386,"text":"You said that collecting all six Future Stars and unlocking the final mechanism would bring the Great Future Star out. Where is it, then?","nextNodeIds":[736760435]},{"nodeId":736760435,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":1388571874,"text":"Relax, relax! I swear I wasn't deceiving you. Look, the Great Future Star is right here!","nextNodeIds":[736760436]},{"nodeId":736760436,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":34814298,"text":"Shalmar takes out a Starconch from his pocket and hands it to Banu.","nextNodeIds":[736760437]},{"nodeId":736760437,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":3751632594,"text":"This is the Great Future Star — that which has crossed the vast sea of stars and come to you after you collected all the Future Stars. Look, doesn't it have a shining white star on its surface?","nextNodeIds":[736760438]},{"nodeId":736760438,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":1218660066,"text":"This Star is formed by all the Future Stars you've collected, and it is your very own Great Future Star. Put your ear to that black opening and listen carefully. Listen to the sea of stars as it speaks to you.","nextNodeIds":[736760439]},{"nodeId":736760439,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3461466146,"text":"Ooh! So this is the Great Future Star!","nextNodeIds":[736760440,736760441]},{"nodeId":736760440,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2583395906,"text":"...","nextNodeIds":[736760442]},{"nodeId":736760442,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3702520010,"text":"That's nonsense! This is just a Starconch! You can find them anywhere on the beaches of Liyue!","nextNodeIds":[736760443]},{"nodeId":736760443,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2655392658,"text":"Oh... Well, Shalmar, is \"Starconch\" its alternative name in another setting?","nextNodeIds":[736760444]},{"nodeId":736760444,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":319020450,"text":"Ahem... Yes, you can say that. In the settings that many people imagine, this is known as a Starconch, and it dwells in the sea. H—However, in the setting I have created, its name is the Great Future Star.","nextNodeIds":[736760445]},{"nodeId":736760445,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":428585066,"text":"Ah, I get it. It's like that thing from the Akademiya's dumpster! I call it \"Banu's Wisdom,\" but everyone else calls it \"Ayesha's Chaos Prospector.\"","nextNodeIds":[736760446]},{"nodeId":736760446,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2487469786,"text":"Thank you, Shalmar. I love the Great Future Star very much!","nextNodeIds":[736760447]},{"nodeId":736760447,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3081128882,"text":"Huh, are we just going to muddle our way through like that?","nextNodeIds":[736760448]},{"nodeId":736760448,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":3004145138,"text":"I wouldn't call this \"muddling,\" exactly. Everyone perceives the world in their own way. And in my very own eyes, this is indeed the Great Future Star that has traveled across the sea of stars to arrive here.","nextNodeIds":[736760449]},{"nodeId":736760449,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":220586506,"text":"Isn't it fun to tap into new ways of seeing the world? Plus, Banu has accepted the name as well.","nextNodeIds":[736760450,736760454]},{"nodeId":736760450,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1471473682,"text":"Sounds like sophistry to me.","nextNodeIds":[736760451]},{"nodeId":736760451,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1213103722,"text":"#Tap into new ways of seeing the world? Hmmm... So, {NICKNAME}, should we start seeing the Mints in your bag as Mora?","nextNodeIds":[736760452]},{"nodeId":736760452,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":908355162,"text":"Paimon, please tell me you didn't fall for that...","nextNodeIds":[736760453]},{"nodeId":736760453,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1021473066,"text":"Hehe, Paimon just thought it would make our journey much more lighthearted, y'know?","nextNodeIds":[736760458]},{"nodeId":736760458,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":2780830082,"text":"Please rest assured, the two of you. Even I would never utter nonsense when it comes to Mora. I ensure you that you'll be duly paid and that this commission will be worth your while.","nextNodeIds":[736760459]},{"nodeId":736760459,"roleType":"TALK_ROLE_NPC","speakerId":12761,"speakerName":"Shalmar","textMapHash":3470911570,"text":"Please take these as your rewards. Thank you for taking care of Banu for the past few days. Your good deeds shall be remembered forever.","nextNodeIds":[]},{"nodeId":736760454,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1149388474,"text":"You do have a point.","nextNodeIds":[736760455]},{"nodeId":736760455,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3380863058,"text":"#Hey {NICKNAME}, don't be fooled! What if you started perceiving Mora as something trivial? Wouldn't you start throwing them away, then!?","nextNodeIds":[736760456]},{"nodeId":736760456,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":224092306,"text":"Well, that's a hard no for sure!","nextNodeIds":[736760457]},{"nodeId":736760457,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2459669930,"text":"This Shalmar guy is too good at talking his way out of things. We'd better bring up the rewards first before he tries to pull a fast one on us again!","nextNodeIds":[736760458]},{"nodeId":736760441,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":413085018,"text":"Banu, listen...","nextNodeIds":[736760442]},{"nodeId":736760406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2062132010,"text":"What's going on here...?","nextNodeIds":[736760460]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367604,0],"PAINLIB