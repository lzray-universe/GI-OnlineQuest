3676,"showRandomTalkCount":0},"dialogs":[{"nodeId":736760101,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3432077362,"text":"How's it going? Have you found all the Future Stars?","nextNodeIds":[736760102]},{"nodeId":736760102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3518406930,"text":"Got all six right here.","nextNodeIds":[736760103]},{"nodeId":736760103,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1580487962,"text":"Yay! Now we can go summon the Great Future Star.","nextNodeIds":[736760104]},{"nodeId":736760104,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3114603138,"text":"Be sure to prepare yourself before we set off! Unexpected things may happen when we summon the Great Future Star!","nextNodeIds":[736760105]},{"nodeId":736760105,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2727681722,"text":"Every time I attempt something special, unexpected things happen. So I'm more than well-prepared now. You should be careful, too.","nextNodeIds":[736760106]},{"nodeId":736760106,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":377423394,"text":"The last time I fired a Great Golden Skyscraping Arrow while at home, the yard suddenly exploded. If Apple hadn't rushed over and taken Shalmar and me away, we would've been pretty doomed.","nextNodeIds":[736760107]},{"nodeId":736760107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1196691034,"text":"Isn't that a bit too dangerous, actually?","nextNodeIds":[736760108]},{"nodeId":736760108,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":126468098,"text":"Haha. Rest assured! In general, all issues fall within acceptable bounds.","nextNodeIds":[736760109]},{"nodeId":736760109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1081573610,"text":"You just said that your yard exploded! That was big enough a problem if you ask Paimon!","nextNodeIds":[736760110]},{"nodeId":736760110,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1949103714,"text":"It'll be fine, don't worry! When you are ready, meet up with me at this location I've marked on the map. I'll be heading there first.","nextNodeIds":[736760111]},{"nodeId":736760111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2424394130,"text":"#{NICKNAME}, Paimon's got a bad feeling about this... We'd better stay alert when we get there!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12760"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7367602,"order":2,"stepDescription":"Head to the designated location","stepDescTextMapHash":1679255636,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7367603_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7367603],"talks":[{"talkId":7367603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367603,"initDialog":736760301,"nextRandomTalks":[],"nextTalks":[],"npcId":[12760],"performCfg":"QuestDialogue/WQ/Sumeru_73676/Q7367603","priority":5,"questId":73676,"showRandomTalkCount":0},"dialogs":[{"nodeId":736760301,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":4052233234,"text":"Oh! There's only one mechanism left. I must say, the final trial this time seems pretty easy.","nextNodeIds":[736760302]},{"nodeId":736760302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1731694226,"text":"This time?","nextNodeIds":[736760303]},{"nodeId":736760303,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1357477106,"text":"Yup. The ones I encountered before were way more complicated than this!","nextNodeIds":[736760304]},{"nodeId":736760304,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3150807386,"text":"Some of them required way too many attempts to figure out the only correct solution, and some would even self-destruct if you gave the wrong solution. Painstaking — and truly troublesome!","nextNodeIds":[736760305,736760306]},{"nodeId":736760305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4206654666,"text":"Why don't you take it from here?","nextNodeIds":[736760307]},{"nodeId":736760307,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":298204346,"text":"Well, according to my experience, this mechanism should be no different from those basic old mechanisms Shalmar usually brings back home. You just need to insert all the keys and boom, it'll be unlocked!","nextNodeIds":[736760308]},{"nodeId":736760308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":794695706,"text":"Banu, have you been dealing with these weird mechanisms all this time?","nextNodeIds":[736760309]},{"nodeId":736760309,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2168831298,"text":"Yes! I've been to many interesting places with Shalmar and Apple. We've had a lot of fun together!","nextNodeIds":[736760310]},{"nodeId":736760310,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1074658202,"text":"In fact, we always have fun, like when I came out to look for the Future Stars this time — or whenever I came up with new settings with Shalmar or encountered situations unexpected.","nextNodeIds":[736760311]},{"nodeId":736760311,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1772568106,"text":"It would be so boring to just wander around the house and do the same things every day.","nextNodeIds":[736760312]},{"nodeId":736760312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1423058018,"text":"Paimon agrees! We often leave familiar places and go on adventures in new ones, too.","nextNodeIds":[736760313]},{"nodeId":736760313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1135521050,"text":"We've seen many terrifying things, but we've also had many pleasant surprises — even moments that have stolen our breath away.","nextNodeIds":[736760314]},{"nodeId":736760314,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3928913634,"text":"Exactly! And that's why I'm sure that we'll make great friends!","nextNodeIds":[736760315]},{"nodeId":736760315,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":963836626,"text":"But, there's one thing I want you to know before we continue. I know it can get pretty dangerous playing outside in the wild, regardless of how fun it may be. That's why I've come fully prepared.","nextNodeIds":[736760316]},{"nodeId":736760316,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":4151679586,"text":"Shalmar told me that it's important to observe people carefully before I ask them for help and that I should stay away from the Treasure Hoarders and any Eremite strangers.","nextNodeIds":[736760317]},{"nodeId":736760317,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3132226018,"text":"But you look like a nice person, which is why I asked you for help. Now that you've helped me this much, I cannot let you get hurt because of me.","nextNodeIds":[736760318]},{"nodeId":736760318,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1751868522,"text":"That's my bottom line. So if you're scared, it's totally fine. I can solve this mechanism by myself.","nextNodeIds":[736760319,736760320]},{"nodeId":736760319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3530112258,"text":"Scared? Me? Nah, never.","nextNodeIds":[736760321]},{"nodeId":736760321,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2140233506,"text":"That also works. Anyway, just insert the six Future Stars into the mechanism and there shouldn't be anything to worry about.","nextNodeIds":[]},{"nodeId":736760320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":794553658,"text":"If things can get dangerous, you'd better leave them to me.","nextNodeIds":[736760321]},{"nodeId":736760306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":527968010,"text":"It suddenly occurs to me that I have something else to do.","nextNodeIds":[736760307]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7367603"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7367603_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7367603,"order":3,"stepDescription":"Touch the mechanism","stepDescTextMapHash":101525572,"finishConds":[{"B