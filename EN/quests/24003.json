DANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5062"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400301],"talks":[{"talkId":2400301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400301,"initDialog":240030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5062,5063],"performCfg":"QuestDialogue/IQ/Fontaine_24003/Q2400301","priority":5,"questId":24003,"showRandomTalkCount":0},"dialogs":[{"nodeId":240030101,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":2531632802,"text":"You won't find the hiding spot I picked this time!","nextNodeIds":[240030102]},{"nodeId":240030102,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":1735823602,"text":"If you hide in those places, it'll be your parents who come looking for you, not me.","nextNodeIds":[240030103]},{"nodeId":240030103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2900442754,"text":"What are you doing?","nextNodeIds":[240030104]},{"nodeId":240030104,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":837713466,"text":"I'm playing hide-and-seek with my brother! Trouble is... Well, he knows all my hiding spots...","nextNodeIds":[240030105]},{"nodeId":240030105,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":3084459138,"text":"Verut, we've been playing here for so long that you've hidden everywhere there is to hide.","nextNodeIds":[240030106]},{"nodeId":240030106,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":3130801386,"text":"As for those places where you can't hide... If I've told you once, I've told you a thousand times why you can't go there.","nextNodeIds":[240030107]},{"nodeId":240030107,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":3152124498,"text":"Oh, those places aren't that dangerous! Mom and Dad exaggerate way too much!","nextNodeIds":[240030108]},{"nodeId":240030108,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":2374195186,"text":"But when you hide in those places, your clothes and pants will get dirty or torn. Mom and Dad work hard enough already, so don't give them one extra thing to worry about.","nextNodeIds":[240030109]},{"nodeId":240030109,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":2913488914,"text":"Oh... Alright...","nextNodeIds":[240030110,240030111]},{"nodeId":240030110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3001442546,"text":"Why don't I join in?","nextNodeIds":[240030112]},{"nodeId":240030112,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":195535658,"text":"Really? You wanna play with me?","nextNodeIds":[240030113]},{"nodeId":240030113,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":3879058130,"text":"Verut, don't make trouble for others! Sorry, all my brother ever thinks about is playing...","nextNodeIds":[240030114,240030115]},{"nodeId":240030114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1950151826,"text":"Don't worry, I've got time.","nextNodeIds":[240030116]},{"nodeId":240030116,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":2030344482,"text":"#Awesome! See, brother? {M#He}{F#She} agreed! I'll definitely hide better than you, just watch!","nextNodeIds":[240030117]},{"nodeId":240030117,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":4272922866,"text":"*sigh* Alright then. In that case, we'll be counting on you.","nextNodeIds":[240030118]},{"nodeId":240030118,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":2424473978,"text":"Verut, don't hide in those places I told you about, alright? If our parents get back — they're getting back late today — and see your clothes all tattered, no one's gonna help you patch them up.","nextNodeIds":[240030119]},{"nodeId":240030119,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":2848405362,"text":"Got it, I got it... Ugh, you're such a nag! I'm gonna go hide now. You hide too, quickly!","nextNodeIds":[240030120]},{"nodeId":240030120,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":3871585826,"text":"You go first. I already know where I'm hiding.","nextNodeIds":[240030121]},{"nodeId":240030121,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":556628666,"text":"#Really? You're bragging, I know it! {M#He's}{F#She's} gonna find you for sure!","nextNodeIds":[240030122]},{"nodeId":240030122,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":948819986,"text":"Aurele and Verut hide in their respective spots...","nextNodeIds":[]},{"nodeId":240030115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3235641650,"text":"It's alright. You're not bothering me.","nextNodeIds":[240030116]},{"nodeId":240030111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2912793114,"text":"Well, I might not be able to find you.","nextNodeIds":[240030112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1","1","3"],"PAINLIBBLDK":"QUEST_EXEC_RANDOM_CLOSED_QUEST_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5062"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2400302,"order":2,"stepDescription":"Look for Aurele and Verut","stepDescTextMapHash":924653476,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUES