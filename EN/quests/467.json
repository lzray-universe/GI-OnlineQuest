on","textMapHash":3629195539,"text":"A picnic! Oh, Paimon just loves picnics!","nextNodeIds":[4670108]},{"nodeId":4670108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1522974411,"text":"My travel partner here is good at cooking as well!","nextNodeIds":[4670801,4670901]},{"nodeId":4670801,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3181332467,"text":"I can only cook a few simple dishes...","nextNodeIds":[4670802]},{"nodeId":4670802,"roleType":"TALK_ROLE_NPC","speakerId":1479,"speakerName":"Lynn","textMapHash":255410379,"text":"That's okay. Let's see what you can do!","nextNodeIds":[4670803]},{"nodeId":4670803,"roleType":"TALK_ROLE_NPC","speakerId":1479,"speakerName":"Lynn","textMapHash":3468743843,"text":"You won't get a lot of chances like this to learn from a survival expert!","nextNodeIds":[4671001]},{"nodeId":4671001,"roleType":"TALK_ROLE_NPC","speakerId":1479,"speakerName":"Lynn","textMapHash":1334328731,"text":"There are some Mushrooms and meat in the barrel over there. Try making a <color=#00E1FFFF>Chicken-Mushroom Skewer</color> for me.","nextNodeIds":[]},{"nodeId":4670901,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2091381323,"text":"That's right, I love cooking too.","nextNodeIds":[4670902]},{"nodeId":4670902,"roleType":"TALK_ROLE_NPC","speakerId":1479,"speakerName":"Lynn","textMapHash":1555227347,"text":"Oh, there's a cooking pot right here. Show me what you got!","nextNodeIds":[4670903]},{"nodeId":4670903,"roleType":"TALK_ROLE_NPC","speakerId":1479,"speakerName":"Lynn","textMapHash":1917909115,"text":"It's good to have someone to practice with.","nextNodeIds":[4671001]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[46701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NON