422,30419],"performCfg":"QuestDialogue/WQ/V4.2FungusFighterV3/Q7450801","priority":5,"questId":74508,"showRandomTalkCount":0},"dialogs":[{"nodeId":745080101,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":470645146,"text":"After a while, you and Paimon arrive at the Lil' Fungi's Fun-Tastic Fiesta booth...","nextNodeIds":[745080102]},{"nodeId":745080102,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1057144962,"text":"Mmm! I love these soft, bouncy, smooth, squishy Fungi! Hehe, I want to keep playing!","nextNodeIds":[745080103]},{"nodeId":745080103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1751269818,"text":"And you are...","nextNodeIds":[745080104]},{"nodeId":745080104,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2055356146,"text":"I'm Enghiene, and I was Turenna's drillmaster before she entered the Special Patrol!","nextNodeIds":[745080105]},{"nodeId":745080105,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2373804314,"text":"I'm nothing like her, you hear? Nothing! I'm not going to grovel before you just because you're Super Zenith Boss-Level Forces!","nextNodeIds":[745080106]},{"nodeId":745080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2374322554,"text":"Uh, so this super arrogant Melusine... used to be Turenna's drillmaster?","nextNodeIds":[745080107]},{"nodeId":745080107,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":759770282,"text":"Don't worry, Golden Comet, Silver Companion!","nextNodeIds":[745080108]},{"nodeId":745080108,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":1542659050,"text":"Ms. Turenna received new orders not long ago, and has returned to the Special Patrol's base.","nextNodeIds":[745080109]},{"nodeId":745080109,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":4137007674,"text":"Before departing, she asked Ms. Enghiene to watch the event area in her place.","nextNodeIds":[745080110]},{"nodeId":745080110,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"Haniyyah","textMapHash":2858938114,"text":"She loves Lil' Fungi's Fun-Tastic Fiesta, and we're always playing it.","nextNodeIds":[745080111]},{"nodeId":745080111,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2984895898,"text":"That's right! I love both the tabletop game, and those round Fungi in real life!","nextNodeIds":[745080112]},{"nodeId":745080112,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2592339410,"text":"They're soft, bouncy, smooth, and squishy... just like Tidalga... Hehehe...","nextNodeIds":[745080113,745080114]},{"nodeId":745080113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3725317738,"text":"Why are you drooling?","nextNodeIds":[745080115]},{"nodeId":745080115,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":3370436954,"text":"I won't! I just want to hold them and rub my face against them. Haniyyah didn't mind when I pinched Kindlejoy!","nextNodeIds":[745080116]},{"nodeId":745080116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2023131994,"text":"That's... That's the most you can do! Only we can hold Bongo-Head!","nextNodeIds":[745080117]},{"nodeId":745080117,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":4063456698,"text":"You're so stingy! I want them both!","nextNodeIds":[745080118]},{"nodeId":745080118,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":1758545954,"text":"Haniyyah said you're experts at the game. How about a round against me?","nextNodeIds":[745080119]},{"nodeId":745080119,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"Enghiene","textMapHash":2548637322,"text":"If I win, I'm going to hold and pinch Bongo-Head!","nextNodeIds":[745080120]},{"nodeId":745080120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":559698562,"text":"Grr, she's looking down on us!","nextNodeIds":[745080121]},{"nodeId":745080121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1527551762,"text":"#Let's do this, {NICKNAME}! As early adopters of the game, we need to show her what we're made of!","nextNodeIds":[745080122,745080123]},{"nodeId":745080122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3915266738,"text":"We're also the first champions of the Nilotpala Cup!","nextNodeIds":[745080124]},{"nodeId":745080124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4159977866,"text":"We didn't earn these titles just to be this easily defeated!","nextNodeIds":[]},{"nodeId":745080123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4111768426,"text":"And the Twin Stars of Brilliant Valor!","nextNodeIds":[745080124]},{"nodeId":745080114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1904860170,"text":"You can't eat them! No eating Fungi!","nextNodeIds":[745080115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30419"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuest