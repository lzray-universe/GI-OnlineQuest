lse,"talkIds":[7905202],"talks":[{"talkId":7905202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7905201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7905202,"initDialog":790520201,"nextRandomTalks":[],"nextTalks":[],"npcId":[13250,1005],"performCfg":"QuestDialogue/WQ/Penumbra_79052/Q7905202","priority":3,"questId":79052,"showRandomTalkCount":0},"dialogs":[{"nodeId":790520201,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":913529994,"text":"It might be more exciting if we had made the rail tilt a little more... It's about the rotation angle in the air... *cough*","nextNodeIds":[790520202]},{"nodeId":790520202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3037543082,"text":"Oh, Haddo!","nextNodeIds":[790520203]},{"nodeId":790520203,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":2231505850,"text":"It's you... *cough* Enjoying your days in the Veluriyam Mirage?","nextNodeIds":[790520204,790520205]},{"nodeId":790520204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3400914906,"text":"We've had a lot of fun!","nextNodeIds":[790520206]},{"nodeId":790520206,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":1296696418,"text":"That's good... *cough* It's good to hear that you're having a good time.","nextNodeIds":[790520208]},{"nodeId":790520208,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":261500442,"text":"Oh, speaking of which... *cough* Would you like to try one of these test mini-carts?","nextNodeIds":[790520209]},{"nodeId":790520209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":484358730,"text":"Test? Do carts even need to be tested?","nextNodeIds":[790520210]},{"nodeId":790520210,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":3336077906,"text":"Yeah. See the site behind me? That's where Choo-Choo Carts are tested. Hehe, do you remember the Torrential Twister?","nextNodeIds":[790520211]},{"nodeId":790520211,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":2535637018,"text":"This is where that rail line was born... *cough* Even with the Preprint and the Streaming Projector, a properly designed route is essential to the whole process.","nextNodeIds":[790520212]},{"nodeId":790520212,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":2821759178,"text":"So it's important that we design and test the rails in advance so we can collect feedback for future iterations... Right now it's just... just more or less... what Jeroney calls \"overstimulating.\"","nextNodeIds":[790520213]},{"nodeId":790520213,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":1302123186,"text":"The test site for small carts has three rails for gradient testing. *cough* Choo-Choo Carts can go a bit faster on these rails...","nextNodeIds":[790520214]},{"nodeId":790520214,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":3898545898,"text":"They are called... *cough* \"Meh, It's Okay Rail,\" \"Kinda Dizzy Now Rail,\" and \"Aaaah! Please Slow Down Rail.\" Oh, if you're wondering, Ferdinand came up with the names.","nextNodeIds":[790520215]},{"nodeId":790520215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1832507898,"text":"Hey, how's Ferdinand doing?","nextNodeIds":[790520216]},{"nodeId":790520216,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":361056738,"text":"He's alright. He just needs some, um, fresh air...","nextNodeIds":[790520217]},{"nodeId":790520217,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":2113638698,"text":"Anyway, since all three are faster than... *cough* All three tests are faster than the rails outside, so I recommend that you begin with the \"Meh, It's Okay Rail.\"","nextNodeIds":[790520218]},{"nodeId":790520218,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":4182266490,"text":"Whaddaya say? Brave enough to give it a go?","nextNodeIds":[790520219,790520220]},{"nodeId":790520219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2194199978,"text":"Let's do this!","nextNodeIds":[790520221]},{"nodeId":790520221,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":1035292610,"text":"I like your confidence! Go find the Hydro Eidolon in charge of the three test rails. It'll be happy to activate the test for you.","nextNodeIds":[]},{"nodeId":790520220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3639107602,"text":"Nope, I've got other plans...","nextNodeIds":[790520222]},{"nodeId":790520222,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":4214169378,"text":"No hurry. *cough* The Hydro Eidolon in charge of the three test rails is always there. Feel free to come test whenever you've got time...","nextNodeIds":[]},{"nodeId":790520205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1255177994,"text":"Is your cough getting better?","nextNodeIds":[790520207]},{"nodeId":790520207,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","textMapHash":2859575882,"text":"*cough* I'm not expecting it to get better. But it's alright, a cough can't stop my passion for designing tracks...","nextNodeIds":[790520208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7905202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7905202],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"Haddo","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3}],"raw"