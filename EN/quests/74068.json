{"mainQuestId":74068,"title":"Scenes from Life in Meropide: An Actor's Training","description":"The Tri-Coupon Troupe is preparing to put on a new show...","titleTextMapHash":417321823,"descTextMapHash":4077318486,"mainQuestExcel":{"mainQuestId":74068,"titleTextMapHash":417321823,"title":"Scenes from Life in Meropide: An Actor's Training","descTextMapHash":4077318486,"description":"The Tri-Coupon Troupe is preparing to put on a new show...","chapterId":10156,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ74068","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":10156,"descTextMapHash":4077318486,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74068,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2226830921,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74068","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174068],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":417321823,"type":"WQ","unlockDescTextMapHash":589810270}},"flow":[{"subQuestId":7406801,"order":1,"stepDescription":"","stepDescTextMapHash":4156202964,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406801,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406801,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7406802,"order":2,"stepDescription":"","stepDescTextMapHash":4129177180,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7406802],"talks":[{"talkId":7406802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406802,"initDialog":740680201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5222,5221],"performCfg":"QuestDialogue/Q7406802","priority":5,"questId":74068,"showRandomTalkCount":0},"dialogs":[{"nodeId":740680201,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1079441194,"text":"Okay. So, the last line here is, \"But I never expected to see, muddily reflected in the eyes of my nemesis, a sad, lonely face, gradually made desolate by vengeance...\"","nextNodeIds":[740680202]},{"nodeId":740680202,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3700068594,"text":"No, it's so strange to suddenly feel remorse for the acts of vengeance already committed, and given how brutal the revenge was against the accomplices, it doesn't make sense to show mercy to the main culprit...","nextNodeIds":[740680203]},{"nodeId":740680203,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3734412906,"text":"A—Actually, it was all foreshadowed. See, after every act of retribution, her determination began to waver little by little, due to the atrocities she had committed and witnessed.","nextNodeIds":[740680204]},{"nodeId":740680204,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":2665781930,"text":"I mean, we don't want to encourage dedicating your whole life to revenge, after all...","nextNodeIds":[740680205]},{"nodeId":740680205,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":788403130,"text":"Nope, I just don't think the ending is convincing, at least to me. You're going to catch flak if the script stays as-is.","nextNodeIds":[740680206]},{"nodeId":740680206,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":2370182178,"text":"Don't judge it based on your own tastes.","nextNodeIds":[740680207]},{"nodeId":740680207,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3152317874,"text":"This again? Well, I think you're actually the one tailoring it to your personal tastes. You shouldn't always be preaching to the audience. Oh, right! We do have an audience here now, don't we?","nextNodeIds":[740680208]},{"nodeId":740680208,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1002106386,"text":"#What is your name, {M#blond}{F#blonde} friend?","nextNodeIds":[740680209]},{"nodeId":740680209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2440677506,"text":"#Call me {NICKNAME}.","nextNodeIds":[740680210]},{"nodeId":740680210,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":4179159578,"text":"Hello. You've been watching so you must have an interest in theater. Allow me to introduce myself, my name is Meilhat.","nextNodeIds":[740680211]},{"nodeId":740680211,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":4249293826,"text":"And this here is Fourmon.","nextNodeIds":[740680212]},{"nodeId":740680212,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":4174073986,"text":"How do you do...","nextNodeIds":[740680213]},{"nodeId":740680213,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1226759186,"text":"We are the world-renowned...","nextNodeIds":[740680214]},{"nodeId":740680214,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":2316745930,"text":"?","nextNodeIds":[740680215]},{"nodeId":740680215,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":124756514,"text":"Aren't you going to follow that up with \"Tri-Coupon Troupe!\"?","nextNodeIds":[740680216]},{"nodeId":740680216,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":2090247450,"text":"Fine, fine... As you can see, we are the world-renowned Tri-Coupon Troupe...","nextNodeIds":[740680217]},{"nodeId":740680217,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":549207314,"text":"Haha, we're not actually world-renowned in the least. The regular cast consists of just the two of us.","nextNodeIds":[740680218]},{"nodeId":740680218,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":136739130,"text":"Then you shouldn't have promoted us like that from the start. Also, I never agreed to you hyping me up as a \"renowned performance artist\" over the loudspeaker, either...","nextNodeIds":[740680219]},{"nodeId":740680219,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":340913858,"text":"It's just an advertising tactic. And I believe that you, Monsieur Fourmon, will one day be a famous performance artist.","nextNodeIds":[740680220]},{"nodeId":740680220,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":1810815402,"text":"Oh, stop it. I'm just trying this out for fun...","nextNodeIds":[740680221]},{"nodeId":740680221,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":2699916202,"text":"Monsieur Fourmon is very talented! Someday, he may even grace the grand stage of the Opera Epiclese.","nextNodeIds":[740680222]},{"nodeId":740680222,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":29977778,"text":"Thanks for the compliment, I... Wait a second, I've already been there! I'm here because that's where I was sentenced!","nextNodeIds":[740680223]},{"nodeId":740680223,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3624407434,"text":"#Uh, that's true, I guess. Anyway, {NICKNAME}, we're rehearsing a play called \"The Countess of Monte-Mer,\" but we'd like to hear an outside opinion regarding the ending.","nextNodeIds":[740680224,740680226]},{"nodeId":740680224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4019459666,"text":"I know nothing about theater...","nextNodeIds":[740680225]},{"nodeId":740680225,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3943036410,"text":"It's okay. Let me put it this way, plays are meant to entertain the audience. Exciting is exciting, and boring is boring. You don't have to know anything to give your opinion.","nextNodeIds":[740680228]},{"nodeId":740680228,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3706007754,"text":"#How about it, Fourmon? Let's put on a little performance for {NICKNAME}!","nextNodeIds":[740680229]},{"nodeId":740680229,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":1994900226,"text":"Ahem... Then let's start from, \"Some say that for all evils there are two remedies — time and silence...\"","nextNodeIds":[740680230]},{"nodeId":740680230,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2407627426,"text":"\"Some say that for all evils there are two remedies — time and silence.\"\\nThe story opens in a land of exiles called Monte-Mer.\\nA woman named Juliette has lost her fiance to a brutal murder, and she herself has been framed and banished.\\nBut the fire of vengeance burns intensely in her bosom, refusing to surrender to either time or silence.\\nThere will come a day when she finally escapes and exacts payback on all who were responsible!","nextNodeIds":[740680231]},{"nodeId":740680231,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3097421226,"text":"As chance would have it, not only does she escape Monte-Mer, but she unearths its hidden treasure.\\nOne after another, she takes her vengeance on those who wronged her.\\nBut what she lost in the euphoria of revenge was her own compassion.\\nAs she faces her nemesis of days past, does she even realize this?\\nOr perhaps that is why, at the last moment, her sharp blade went wide of the mark...","nextNodeIds":[740680232]},{"nodeId":740680232,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3066281394,"text":"Juliette... Why does it have to be you, Juliette?","nextNodeIds":[740680233]},{"nodeId":740680233,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1143439850,"text":"Yes, it's me. You didn't see this coming, did you? When you killed my fiance with your own hand and banished me to Monte-Mer!?","nextNodeIds":[740680234]},{"nodeId":740680234,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":476535322,"text":"Ah! Why you... You she-devil! I remember now, I remember...","nextNodeIds":[740680235]},{"nodeId":740680235,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":1676685562,"text":"In court, two weeks ago, you said, \"The pound of flesh from his chest is the principal, and the blood and surplus flesh are the interest!\" Then killed Anthony!","nextNodeIds":[740680236]},{"nodeId":740680236,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":1561202434,"text":"He collapsed there in the middle of the court, pale as the death coming for him! All the crowd could not but helplessly stare as his heart stopped beating!","nextNodeIds":[740680237]},{"nodeId":740680237,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3366204554,"text":"...Hmph! He who perjured himself so many years ago, finally paid the price I demanded of him! And with interest. He had only himself to blame for such an end!","nextNodeIds":[740680238]},{"nodeId":740680238,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":4181224442,"text":"And the lead actor Raoult, haplessly crushed by a falling light in a theater...","nextNodeIds":[740680239]},{"nodeId":740680239,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3785404338,"text":"Were it not for his glib, serpentine tongue, my lover and I never would have fallen into your trap!","nextNodeIds":[740680240]},{"nodeId":740680240,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":715238994,"text":"So... So you got close to me just to rig my clock to fire a hidden dagger, taking my life at midnight?","nextNodeIds":[740680241]},{"nodeId":740680241,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":2170201698,"text":"Exactly.","nextNodeIds":[740680242]},{"nodeId":740680242,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3407560210,"text":"Juliette, please, forgive me... You saw how Anthony's wife hanged herself after he died, leaving behind only the piteous sobs of their young son...","nextNodeIds":[740680243]},{"nodeId":740680243,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3610192338,"text":"Is this really what you want to see? Think about Raoult. The sight of his haggard, snow-haired mother trying to gather his broken, scattered remains, wailing in agony and sorrow...","nextNodeIds":[740680244]},{"nodeId":740680244,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":1071033354,"text":"I know my sins are many and grave, but you should know why we killed your fiance... It's because he killed our friends...","nextNodeIds":[740680245]},{"nodeId":740680245,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":203259154,"text":"I don't believe you! You're lying! You must be!","nextNodeIds":[740680246]},{"nodeId":740680246,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":4088388562,"text":"It is your choice whether to believe it or not! Ah, Juliette! Just what kind of jagged pillar of fate have these chains of sin bound us both so tightly to!","nextNodeIds":[740680247]},{"nodeId":740680247,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":1478713970,"text":"If vengeance will free you, plunge the knife in your hand into my chest! But I can promise you, revenge will not put you at ease... But fill your heart with an agonizing void.","nextNodeIds":[740680248]},{"nodeId":740680248,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3870542138,"text":"Look at my own pitiful state. I know what lies down that road, better than any...","nextNodeIds":[740680249]},{"nodeId":740680249,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3049158858,"text":"How could this be...? Is this perpetually drunk and tortured man a portent of what is to come? I thought I would be free after exacting revenge...","nextNodeIds":[740680250]},{"nodeId":740680250,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":774788218,"text":"But I never expected to see, muddily reflected in the eyes of my nemesis, a sad, lonely face, gradually made desolate by vengeance...","nextNodeIds":[]},{"nodeId":740680226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":895489810,"text":"I've got nothing but opinions!","nextNodeIds":[740680227]},{"nodeId":740680227,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1600771746,"text":"There you have it! Usually those who are too willing to give out their opinion aren't quite normal... But it's all right, we need opinions right now, any opinions will do.","nextNodeIds":[740680228]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7406803,"order":3,"stepDescription":"Talk to Meilhat","stepDescTextMapHash":2776257092,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5222"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7406803],"talks":[{"talkId":7406803,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406803","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406803,"initDialog":740680301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5222,5221],"performCfg":"QuestDialogue/Q7406803","priority":5,"questId":74068,"showRandomTalkCount":0},"dialogs":[{"nodeId":740680301,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1107296394,"text":"#Okay, {NICKNAME}, this is it... This is the part I feel we need to discuss.","nextNodeIds":[740680302]},{"nodeId":740680302,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1902409634,"text":"There are two directions we can go with the plot. One is for Juliette to abort her revenge, and spend the rest of her treasure traveling the world and enjoying life.","nextNodeIds":[740680303]},{"nodeId":740680303,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":2030690258,"text":"And the other is for her to complete her vengeance, only to realize she still feels empty inside, so she donates all of her wealth to charities, then grows old and dies alone in the place where she first met her fiance.","nextNodeIds":[740680304]},{"nodeId":740680304,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1136286674,"text":"So, as the audience, which do you prefer?","nextNodeIds":[740680305,740680312]},{"nodeId":740680305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2966571554,"text":"Giving up on revenge counts as a kind of freedom...","nextNodeIds":[740680306]},{"nodeId":740680306,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3469999434,"text":"Hmm, really?","nextNodeIds":[740680307]},{"nodeId":740680307,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":37035578,"text":"See what I mean? Audiences can understand, since Jerome already serves as an example of someone who successfully exacted revenge but still isn't happy.","nextNodeIds":[740680308]},{"nodeId":740680308,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":261281674,"text":"\"Kill your nemesis and you'll be happy\" may sound good, but happiness is created and built, not obtained through destructive means like revenge.","nextNodeIds":[740680309]},{"nodeId":740680309,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":419654378,"text":"You don't gain happiness through retribution, only a sinful pleasure. But when that euphoria fades and you can't find another direction in life, it leaves naught but a huge void inside.","nextNodeIds":[740680310]},{"nodeId":740680310,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3326304218,"text":"In the process of getting revenge, it's vital that they find another means of redemption beyond vengeance itself!","nextNodeIds":[740680311]},{"nodeId":740680311,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1766563890,"text":"Hmm, that does make sense, though I'm still not entirely convinced.","nextNodeIds":[740680318]},{"nodeId":740680318,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3151137218,"text":"#Thanks, {NICKNAME}. Your feedback has been most valuable!","nextNodeIds":[740680319]},{"nodeId":740680319,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3966508098,"text":"Yes, indeed. After such a discussion, I feel like the conclusion does have some room for improvement. If it can be properly presented...","nextNodeIds":[740680320]},{"nodeId":740680320,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3695707530,"text":"#You must come when the play officially premieres, {NICKNAME}. There'll be an ending that will exceed your wildest imagination!","nextNodeIds":[740680321,740680322]},{"nodeId":740680321,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2279950242,"text":"R—Really...?","nextNodeIds":[740680323]},{"nodeId":740680323,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":2045161610,"text":"Well, it's still to be finalized, so I don't know, either...","nextNodeIds":[740680324]},{"nodeId":740680324,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":531913418,"text":"#Then why would you tell {NICKNAME} that!","nextNodeIds":[740680325]},{"nodeId":740680325,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":3949068674,"text":"#Just call it promotion! Oh, and thank you for the feedback, {NICKNAME}. Please take these. Feel free to drop by anytime.","nextNodeIds":[]},{"nodeId":740680322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1322212466,"text":"Exceed my wildest imagination in a good way, or...","nextNodeIds":[740680323]},{"nodeId":740680312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4173909642,"text":"Of course you've got to complete your vengeance first!","nextNodeIds":[740680313]},{"nodeId":740680313,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":1334084218,"text":"#See, see! {NICKNAME} and I think alike.","nextNodeIds":[740680314]},{"nodeId":740680314,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":939031898,"text":"Jerome is the linchpin of the whole revenge story. If he doesn't feel the sting of vengeance, it will feel like a complete letdown.","nextNodeIds":[740680315]},{"nodeId":740680315,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3005892730,"text":"Hmm...","nextNodeIds":[740680316]},{"nodeId":740680316,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"Meilhat","textMapHash":808476618,"text":"Making the character just imagine the pain and emptiness is also different from the character actually experiencing the same after doing the deed!","nextNodeIds":[740680317]},{"nodeId":740680317,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"Fourmon","textMapHash":3386511666,"text":"That is true...","nextNodeIds":[740680318]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1