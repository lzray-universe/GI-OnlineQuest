ks":[],"npcId":[1587],"performCfg":"","priority":9,"questId":20506,"showRandomTalkCount":0},"dialogs":[{"nodeId":205060201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3602887577,"text":"Coooool!","nextNodeIds":[205060202]},{"nodeId":205060202,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":144524841,"text":"All we are really doing is following the methods of the ancients as best we can.","nextNodeIds":[205060203]},{"nodeId":205060203,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":336225209,"text":"Much as one who uses a wind glider needs not understand how it was built in order to glide.","nextNodeIds":[205060204]},{"nodeId":205060204,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3173328521,"text":"The difference with alchemy is that every time I think I finally understand how it's supposed to work, something totally unexpected happens...","nextNodeIds":[205060205,205060207]},{"nodeId":205060205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":908960249,"text":"What other uses does alchemy have?","nextNodeIds":[205060206]},{"nodeId":205060206,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":4222358305,"text":"To be honest with you, I just don't know.","nextNodeIds":[205060210]},{"nodeId":205060210,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":45001321,"text":"There's a lot of other mysterious recipes I have to research first.","nextNodeIds":[205060211]},{"nodeId":205060211,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":366269065,"text":"Over the course of your adventures, you should come across some alchemists' notes from ancient civilizations.","nextNodeIds":[205060212]},{"nodeId":205060212,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":4137501265,"text":"And as your Adventure Rank increases, more recipes will become available to you.","nextNodeIds":[205060213,205060215]},{"nodeId":205060213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2258758809,"text":"Thanks for the explanation.","nextNodeIds":[205060214]},{"nodeId":205060214,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1411481,"text":"You're welcome. I look forward to hearing more about your exploits!","nextNodeIds":[205060218]},{"nodeId":205060218,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2735361033,"text":"Well, see you next time. May the wind bring you good fortune on your path ahead.","nextNodeIds":[]},{"nodeId":205060215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1276572937,"text":"The next time you hear from me I'll be a Paimon-conjuring alchemy wizard.","nextNodeIds":[205060216]},{"nodeId":205060216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3051935001,"text":"Why are you so obsessed with other Paimons? Do I no longer satisfy your Paimonial needs?","nextNodeIds":[205060217]},{"nodeId":205060217,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":1269864825,"text":"Haha... You two are a fascinating pair I must say.","nextNodeIds":[205060218]},{"nodeId":205060207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4081747009,"text":"Can you conjure up a new Paimon using alchemy?","nextNodeIds":[205060208]},{"nodeId":205060208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2596645401,"text":"Hey! You shall have no other Paimon before this Paimon!","nextNodeIds":[205060209]},{"nodeId":205060209,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3860236849,"text":"Hahaha! Unfortunately my skills are not that advanced.","nextNodeIds":[205060210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2050602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2050601,2050602],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3382521351,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":9,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":205060101,"ILHDCGDKKKA":"TALK_HERO_LOCAL","ILHDNJDDEOP":2050601,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[1587],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[9000],"MBDOOOMPFCD":false