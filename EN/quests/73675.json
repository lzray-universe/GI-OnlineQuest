{"mainQuestId":73675,"title":"Where the Future Stars Fall","description":"Banu is searching for something out in the wild all by herself...","titleTextMapHash":2971963783,"descTextMapHash":3587681558,"mainQuestExcel":{"mainQuestId":73675,"titleTextMapHash":2971963783,"title":"Where the Future Stars Fall","descTextMapHash":3587681558,"description":"Banu is searching for something out in the wild all by herself...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5096,"luaPath":"Actor/Quest/WQ73675","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5096,"chapterId":0,"descTextMapHash":3587681558,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73675,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4040516809,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73675","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173675],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2971963783,"type":"WQ","unlockDescTextMapHash":4288242462}},"flow":[{"subQuestId":7367501,"order":1,"stepDescription":"Talk to Banu","stepDescTextMapHash":3733781668,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12760"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7367501],"talks":[{"talkId":7367501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367501,"initDialog":736750101,"nextRandomTalks":[],"nextTalks":[],"npcId":[12760,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73675/Q7367501","priority":5,"questId":73675,"showRandomTalkCount":0},"dialogs":[{"nodeId":736750101,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":851452674,"text":"Oh, this is great! It's a well-dressed stranger instead of someone from the Eremites or Treasure Hoarders. Alright, I must seize this opportunity!","nextNodeIds":[736750102]},{"nodeId":736750102,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1515502266,"text":"Umm... \"Wayfaring friend, please, wait a second before you venture forth!\"","nextNodeIds":[736750103,736750104]},{"nodeId":736750103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1385888234,"text":"Hello?","nextNodeIds":[736750105]},{"nodeId":736750105,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1367094594,"text":"\"Good day, bracket, address them as sir or ma'am based on their gender, bracket. Terribly sorry to bother you, but please take some time out of your busy schedule to... uh... give ear to my request.\"","nextNodeIds":[736750106]},{"nodeId":736750106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3236906346,"text":"D—Did you just say bracket?","nextNodeIds":[736750107]},{"nodeId":736750107,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3894372362,"text":"Wait, wait, please don't interrupt me just yet, or I'll forget my lines. My next line should be...","nextNodeIds":[736750108]},{"nodeId":736750108,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3953248434,"text":"\"Bracket, describe the difficulty you've encountered concisely... and politely ask for their help, then thank them in a formal manner, bracket.\"","nextNodeIds":[736750109]},{"nodeId":736750109,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3099836746,"text":"And the last line is... \"Bracket, example, bracket. I'd be truly grateful for your kindness and generosity. Your good deed shall be remembered forever.\"","nextNodeIds":[736750110]},{"nodeId":736750110,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2253257402,"text":"\"In the meantime, I'm willing to pay you handsomely for your hard work, so please, I implore you to give my request some serious consideration.\"","nextNodeIds":[736750111]},{"nodeId":736750111,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2276801546,"text":"Phew. Now that I didn't miss a single word this time, it shouldn't be a problem at all. Alright, I'll leave the Future Stars to you then.","nextNodeIds":[736750112]},{"nodeId":736750112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":310516578,"text":"Sounds like you have a favor to ask us, but Paimon's really not following...","nextNodeIds":[736750113]},{"nodeId":736750113,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1648849922,"text":"Huh? How come? According to 50 Things Every Traveling Scholar Should Know, that was exactly what you should say when asking strangers for help. There shouldn't be a problem...","nextNodeIds":[736750114,736750116]},{"nodeId":736750114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1182478410,"text":"I have some questions...","nextNodeIds":[736750115]},{"nodeId":736750115,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2570187578,"text":"R—Really? P—Please give me a second. I'll look up what to recite when \"they have some questions.\"","nextNodeIds":[736750118]},{"nodeId":736750118,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2186580826,"text":"The girl takes out a book titled 50 Things Every Traveling Scholar Should Know from her pocket and anxiously leafs through it.","nextNodeIds":[736750119]},{"nodeId":736750119,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1991231282,"text":"*sigh* It doesn't say anything about that. But Shalmar told me I can just check the book when there's a problem...","nextNodeIds":[736750120]},{"nodeId":736750120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1340431226,"text":"Paimon's still confused... But by the looks of things, you need our help, right?","nextNodeIds":[736750121]},{"nodeId":736750121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":477691266,"text":"If the book can't help you, you can just tell us what's going on in your own words, y'know?","nextNodeIds":[736750122]},{"nodeId":736750122,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2482514058,"text":"Hmm, alright! I'm Banu and I came here following the map to look for the Future Stars. There are altogether six of them!","nextNodeIds":[736750123]},{"nodeId":736750123,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1641672530,"text":"Whoever finds all the Future Stars can summon the Great Future Star, which is super duper amazing! And that's exactly my goal here.","nextNodeIds":[736750124]},{"nodeId":736750124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2860154138,"text":"Ah, Paimon remembers that you did mention something about the Future Stars earlier.","nextNodeIds":[736750125]},{"nodeId":736750125,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2726124290,"text":"Yes. Well, that's about it for the Future Star's setting.","nextNodeIds":[736750126,736750128]},{"nodeId":736750126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1478854162,"text":"Setting?","nextNodeIds":[736750127]},{"nodeId":736750127,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3505924890,"text":"Yup. Compared to the ones I usually read about, this setting is pretty easy to understand. But it's also less fun since it's a little too easy.","nextNodeIds":[736750130]},{"nodeId":736750130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2112110266,"text":"...","nextNodeIds":[736750131]},{"nodeId":736750131,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2871453362,"text":"Well, then I thought the setting was too vague considering it never talked about how to find the Future Stars. So to make up for that, I came up with a supplementary setting.","nextNodeIds":[736750132]},{"nodeId":736750132,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2578487194,"text":"The girl pulls out a strange object from the grass behind her.","nextNodeIds":[736750133]},{"nodeId":736750133,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":3432525250,"text":"Ta-da! This is... \"Banu's Wisdom,\" yes, that's the name! It's a very important item because it can help you locate the Future Stars. Isn't that impressive? Hehe.","nextNodeIds":[736750134]},{"nodeId":736750134,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":4804386,"text":"I think it's a really cool name too, don't you think? Unfortunately, it's way too tall and heavy for me to move it around. So it became less cool...","nextNodeIds":[736750135]},{"nodeId":736750135,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2017748506,"text":"This is the favor I'm asking. You should be able to move it, so can you help me find the Future Stars with it? After summoning the Great Future Star, I'll reward you in a big way!","nextNodeIds":[736750136,736750137]},{"nodeId":736750136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3856810378,"text":"Is that your request?","nextNodeIds":[736750138]},{"nodeId":736750138,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":891868010,"text":"Before I met you, I had also asked others for help. But when they heard about the Future Stars, they just gave me weird looks and didn't want to listen to me anymore.","nextNodeIds":[736750139]},{"nodeId":736750139,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2688619394,"text":"They even told me to stop fussing around and go back home to my parents. That's so annoying! I'm not some runaway kid up to mischief!","nextNodeIds":[736750140]},{"nodeId":736750140,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":511764034,"text":"Adults are always like this. Just because I'm a child, they think I'm talking nonsense.","nextNodeIds":[736750141]},{"nodeId":736750141,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1322763602,"text":"But the Future Stars are real! I'm not imagining things. You'll see that I'm not lying once you take this... uh... \"Banu's Wisdom\" with you and go look for the Stars!","nextNodeIds":[736750142]},{"nodeId":736750142,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":162507298,"text":"If you're not willing to help either, *sigh* I'll just have to wait and see if the next person I meet is willing to listen and accept my request...","nextNodeIds":[736750143]},{"nodeId":736750143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3799977514,"text":"Okay, I'll see what I can do.","nextNodeIds":[736750144]},{"nodeId":736750144,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2169969242,"text":"You believe me! Thank you! And please take this \"Banu's Wisdom\" with you.","nextNodeIds":[736750145]},{"nodeId":736750145,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2881162354,"text":"Remember, after it runs for a while, \"Banu's Wisdom\" will need to rest a bit before it can point you to the location of the Future Stars again.","nextNodeIds":[736750146]},{"nodeId":736750146,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":2482896226,"text":"Oh, and take this book, 50 Things Every Traveling Scholar Should Know! I've marked the location of the Stars on the map in this book. So you may follow that map first.","nextNodeIds":[736750147]},{"nodeId":736750147,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":1624116082,"text":"Come back to me once you find all six Future Stars. Then we can go check the Great Future Star out together! I'll take you there.","nextNodeIds":[]},{"nodeId":736750137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2921306618,"text":"I'll think about it.","nextNodeIds":[736750138]},{"nodeId":736750128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2158144706,"text":"Which book is that in?","nextNodeIds":[736750129]},{"nodeId":736750129,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":255520322,"text":"Hmm... I think this setting was just made up.","nextNodeIds":[736750130]},{"nodeId":736750116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":597547026,"text":"You haven't told us what difficulty you've encountered.","nextNodeIds":[736750117]},{"nodeId":736750117,"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","textMapHash":4250736026,"text":"R—Really? P—Please give me a second. I'll look up what to recite when \"you haven't told them what difficulty you've encountered.\"","nextNodeIds":[736750118]},{"nodeId":736750104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":940375010,"text":"Can I help you?","nextNodeIds":[736750105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12760"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7367501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":12760,"speakerName":"Banu","count":30},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173675],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3587681558,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73675/Q7367501","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":736750101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7367501,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[12760,1005],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNH