ntId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1500503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1500501,"initDialog":150050101,"nextRandomTalks":[],"nextTalks":[],"npcId":[14227,14228],"performCfg":"QuestDialogue/LQ/Mualani_15005/Q1500501","priority":5,"questId":15005,"showRandomTalkCount":0},"dialogs":[{"nodeId":150050101,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2849889178,"text":"The defeated Koholasaurs scatter and run away.","nextNodeIds":[150050102]},{"nodeId":150050102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":319704578,"text":"Judging from your clothes, you must be scholars from Sumeru, right?","nextNodeIds":[150050103]},{"nodeId":150050103,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":1145098434,"text":"Yes, I'm Karya, and this is my senior, Viramdra. Thank you so much for saving us. That was a little too close...","nextNodeIds":[150050104]},{"nodeId":150050104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1722990562,"text":"#Don't mention it! Handling these sort of things is practically second nature to us by now. Paimon is Paimon, and this is {NICKNAME}!","nextNodeIds":[150050105]},{"nodeId":150050105,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"Viramdra","textMapHash":1704002818,"text":"*sigh* Still, it seems that all the Koholasaurs just ran off... We need to capture at least one alive.","nextNodeIds":[150050106]},{"nodeId":150050106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1691779314,"text":"Huh? Capture one alive?","nextNodeIds":[150050107]},{"nodeId":150050107,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"Viramdra","textMapHash":1487826082,"text":"Correct. Say, I can see you are very skilled at dealing with them. Do you think you could use me as live bait to help us capture one? I will pay you for the effort!","nextNodeIds":[150050108]},{"nodeId":150050108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3320374258,"text":"Um, well...","nextNodeIds":[150050109]},{"nodeId":150050109,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":4246465714,"text":"Apologies. Viramdra has been hyper-focused on his research, so please, don't be too hard on him...","nextNodeIds":[150050110]},{"nodeId":150050110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":362187098,"text":"Oh, no worries! But why did you approach a whole group of wild Koholasaurs? And what's this talk about \"capturing them\"?","nextNodeIds":[150050111]},{"nodeId":150050111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3816087434,"text":"Don't tell me you want to get a picture with them, too.","nextNodeIds":[150050112]},{"nodeId":150050112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2972206346,"text":"Paimon's pretty sure that's not what they're trying to do!","nextNodeIds":[150050113]},{"nodeId":150050113,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":3387602138,"text":"I'm sure we must look very silly... The fact of the matter is that we're searching for a mysterious island from a certain legend. It's said that a very important clue about the island can be found on Koholasaurs, so...","nextNodeIds":[150050114]},{"nodeId":150050114,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":3840189930,"text":"Approaching them without the help of a guide from the People of the Springs was certainly an unwise choice on our part.","nextNodeIds":[150050115]},{"nodeId":150050115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4066384338,"text":"A mysterious island?","nextNodeIds":[150050116]},{"nodeId":150050116,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":2786458874,"text":"Yes. There's a legend from the People of the Springs that mentions a mysterious island, and Viramdra believes the key to his research can be found there.","nextNodeIds":[150050117]},{"nodeId":150050117,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"Viramdra","textMapHash":983576610,"text":"Ahem... Are you certain you two won't consider my proposal to capture one?","nextNodeIds":[150050118]},{"nodeId":150050118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1830413338,"text":"Some proposal... There's no way we'd be willing to use a person as live bait!","nextNodeIds":[150050119]},{"nodeId":150050119,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"Viramdra","textMapHash":2234184914,"text":"Then I suppose discussing it any further will just be a waste of time. I must come up with another solution...","nextNodeIds":[150050120]},{"nodeId":150050120,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":3369478298,"text":"Ahem... Viramdra!","nextNodeIds":[150050121]},{"nodeId":150050121,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"Viramdra","textMapHash":2420396154,"text":"Oh, alright... You did rescue Karya and I just now, and I suppose I should express some gratitude. Thank you very much.","nextNodeIds":[150050122]},{"nodeId":150050122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":470782058,"text":"A little awkward, but Paimon'll take it...","nextNodeIds":[150050123]},{"nodeId":150050123,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"Viramdra","textMapHash":2957974642,"text":"We should move on, Karya.","nextNodeIds":[150050124]},{"nodeId":150050124,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":4218239130,"text":"Yes, thank you again. My apologies... Viramdra really doesn't have the best people skills.","nextNodeIds":[150050125]},{"nodeId":150050125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4161811202,"text":"That's alright, bye now!","nextNodeIds":[150050126]},{"nodeId":150050126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2742014178,"text":"You really don't see a pair of adventurers like those two every day!","nextNodeIds":[150050127]},{"nodeId":150050127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":727505146,"text":"But anyway, Paimon's really curious about that mysterious island that lady just mentioned!","nextNodeIds":[150050128]},{"nodeId":150050128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3515904026,"text":"Do you wanna find the island too, Paimon?","nextNodeIds":[150050129]},{"nodeId":150050129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2142472826,"text":"Yeah! Who knows, there might be treasure!","nextNodeIds":[150050130]},{"nodeId":150050130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2476329922,"text":"After all the amazing places we've explored during our adventures, finding some mysterious island should be a walk in the park for us!","nextNodeIds":[150050131]},{"nodeId":150050131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":425245426,"text":"But we don't have any info about this island.","nextNodeIds":[150050132]},{"nodeId":150050132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2010111114,"text":"Ah, you're right... The lady mentioned that the mysterious island is related to a legend of the People of the Springs... So maybe we can start by asking some of them about it?","nextNodeIds":[150050133]},{"nodeId":150050133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1968718762,"text":"Time's ticking. Let's get started on our next adventure!","nextNodeIds":[150050134]},{"nodeId":150050134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3252115026,"text":"But the real question is... who should we ask?","nextNodeIds":[150050135]},{"nodeId":150050135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3323617522,"text":"Can we just talk to the chief?","nextNodeIds":[150050136]},{"nodeId":150050136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4130021258,"text":"Hmm... that's an idea. If anyone, the chief of the tribe should know the details!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1500501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133502195"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q1500501_guide"],"