,"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1500502,"initDialog":150050201,"nextRandomTalks":[],"nextTalks":[],"npcId":[14317,1005],"performCfg":"QuestDialogue/LQ/Mualani_15005/Q1500502","priority":5,"questId":15005,"showRandomTalkCount":0},"dialogs":[{"nodeId":150050201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1988690386,"text":"Wow, what an amazing view! And we can even see some Koholasaurs here and there! Hey, why don't we try to get a picture with one or two of them in the wild?","nextNodeIds":[150050202]},{"nodeId":150050202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2257667002,"text":"But what if they try to bite us?","nextNodeIds":[150050203]},{"nodeId":150050203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3140816114,"text":"Well... they're so cute, they probably won't do that, right...?","nextNodeIds":[150050204]},{"nodeId":150050204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1016633234,"text":"Huh? What's happening over there?","nextNodeIds":[150050205]},{"nodeId":150050205,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"Karya","textMapHash":3468859562,"text":"Help! Somebody help us!","nextNodeIds":[150050206]},{"nodeId":150050206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2862355890,"text":"Ah! Wild Koholasaurs are actually biting people!","nextNodeIds":[150050207,150050209]},{"nodeId":150050207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":737472394,"text":"It's time for us to save the day again!","nextNodeIds":[150050208]},{"nodeId":150050208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4179877658,"text":"#Yeah, those two are in trouble! The legendary {NICKNAME} and {M#his}{F#her} trusty sidekick Paimon will not stand by idly!","nextNodeIds":[]},{"nodeId":150050209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":286869938,"text":"Seems those pictures we wanted will have to wait.","nextNodeIds":[150050210]},{"nodeId":150050210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1926444170,"text":"Yeah, we can save those for later! We can't just stand around when someone's calling for help!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1500502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_350200104:-2934.368,200.810,8851.006,0.000,233.244,0.000]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1500502,"order":2,"stepDescription":"Defeat the Koholasaurs","stepDescTextMapHash":4058879244,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"quest1500502"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q1500501_guide","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT