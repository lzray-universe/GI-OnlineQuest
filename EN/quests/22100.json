2210001,2210002],"talks":[{"talkId":2210001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2210001","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2210001,"initDialog":221000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2202],"performCfg":"","priority":6,"questId":22100,"showRandomTalkCount":0},"dialogs":[{"nodeId":221000101,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":3567118688,"text":"*sigh* Whatever am I going to do...","nextNodeIds":[221000102]},{"nodeId":221000102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3908308088,"text":"What's wrong?","nextNodeIds":[221000103]},{"nodeId":221000103,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":1564208976,"text":"This location... It's a real challenge to run an inn here.","nextNodeIds":[221000104]},{"nodeId":221000104,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":1602745760,"text":"Dihua Marsh means lots of Silvergrass, and where treasure lies, monsters will follow.","nextNodeIds":[221000105]},{"nodeId":221000105,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":4247029080,"text":"We're lucky that the Millelith cleared most of them out of the area. Since then it's mostly been fine.","nextNodeIds":[221000106]},{"nodeId":221000106,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":3485537776,"text":"But inexplicably, they seem to have made something of a resurgence recently.","nextNodeIds":[221000107]},{"nodeId":221000107,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":2368556016,"text":"I know they would never come anywhere near the inn, but there's no denying they're an eyesore. And if even I think so, I can guarantee my customers will too.","nextNodeIds":[221000108]},{"nodeId":221000108,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":2149069440,"text":"Are you free to help? It would be great if you could deal with any nearby monsters for me.","nextNodeIds":[221000109,221000110]},{"nodeId":221000109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1225580728,"text":"Okay.","nextNodeIds":[221000111]},{"nodeId":221000111,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":4226403424,"text":"Haha... Ah, I must say I do find your forthrightness refreshing...","nextNodeIds":[221000114]},{"nodeId":221000114,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":3108656552,"text":"Anyway. I'm not exactly thrilled to be begging a guest for help like this.","nextNodeIds":[221000115]},{"nodeId":221000115,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":1823360760,"text":"But please be assured that you will be well compensated for your trouble.","nextNodeIds":[221000116]},{"nodeId":221000116,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":2361052544,"text":"Best of luck, and thank you.","nextNodeIds":[]},{"nodeId":221000110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3168709160,"text":"You're stressing out over an eyesore!?","nextNodeIds":[221000112]},{"nodeId":221000112,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":3844114432,"text":"Frankly, yes, their irksome presence is the biggest problem they pose.","nextNodeIds":[221000113]},{"nodeId":221000113,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":3266121872,"text":"But some people, such as a certain young gentleman obsessed with peace and quiet, find that simply intolerable. And when something upsets him, it usually ends up upsetting the rest of Dihua Marsh too...","nextNodeIds":[221000114]}]},{"talkId":2210002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2210001","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2210002","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2210002,"initDialog":221000201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2202],"performCfg":"","priority":6,"questId":22100,"showRandomTalkCount":0},"dialogs":[{"nodeId":221000201,"roleType":"TALK_ROLE_NPC",