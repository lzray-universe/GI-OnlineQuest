questId":70533,"showRandomTalkCount":0},"dialogs":[{"nodeId":705330101,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":996043138,"text":"What a surprise. To think that my invention could be used in this fashion...","nextNodeIds":[705330102]},{"nodeId":705330102,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3171367042,"text":"Ah, Traveler! It seems we meet again... *cough*","nextNodeIds":[705330103,705330105]},{"nodeId":705330103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3930946058,"text":"I thought you'd left Mondstadt.","nextNodeIds":[705330104]},{"nodeId":705330104,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3094252002,"text":"That was the plan, yes, but... Things do change, you know...","nextNodeIds":[705330108]},{"nodeId":705330108,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2419020794,"text":"*cough* But let's get back on topic.","nextNodeIds":[705330109]},{"nodeId":705330109,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2389289578,"text":"This time, I've been invited by the Mondstadt Adventurers' Guild to create several Mechanical Paintings based on certain card faces that can be disassembled and reassembled.","nextNodeIds":[705330110]},{"nodeId":705330110,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":4238340490,"text":"As for the card game, what was it again... Ah, right, it's called Genius Invokation TCG.","nextNodeIds":[705330111]},{"nodeId":705330111,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2522908018,"text":"According to them, these paintings will be brought to be used in the King of Invokations Grand Prix as a sort of minigame to liven things up just a bit.","nextNodeIds":[705330112]},{"nodeId":705330112,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":534183762,"text":"*sigh* These things are too complicated for me. I should just concentrate on my inventions.","nextNodeIds":[705330113]},{"nodeId":705330113,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":2169118514,"text":"Ah, yes, Mondstadt's mechanical paintings are with me, so if you want to play around with them, feel free.","nextNodeIds":[]},{"nodeId":705330105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2392058970,"text":"Did something go wrong with your invention again?","nextNodeIds":[705330106]},{"nodeId":705330106,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":1137394298,"text":"No, not at all! Not this time... Or should I say, there was never a problem.","nextNodeIds":[705330107]},{"nodeId":705330107,"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","textMapHash":3591992882,"text":"When I asked you for your help previously, I was having a monster problem, not an invention problem!","nextNodeIds":[705330108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30217"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7053301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30217,"speakerName":"Félix Yogue","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler