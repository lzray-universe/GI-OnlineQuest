eckActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["101609","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":101601,"initDialog":10160101,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/AQ/Liyue1_1016/Q101601","priority":6,"questId":1016,"showRandomTalkCount":0},"dialogs":[{"nodeId":10160101,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":956408297,"text":"Ah, you're here. There's no need to order, I've already done so.","nextNodeIds":[10160102]},{"nodeId":10160102,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2808036737,"text":"\"Third-Round Knockout\" is not for lightweights, like those taverns in Mondstadt. Here, the owner does not take such unorthodox orders as fruit juice.","nextNodeIds":[10160103]},{"nodeId":10160103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2771516305,"text":"So, does this mean I can order wine this time?","nextNodeIds":[10160104]},{"nodeId":10160104,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3369960121,"text":"I ordered some wine-fermented sweet rice balls for you, if that counts.","nextNodeIds":[10160105]},{"nodeId":10160105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":820149385,"text":"I guess I should have expected this...","nextNodeIds":[10160106]},{"nodeId":10160106,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"Iron Tongue Tian","textMapHash":1481580945,"text":"...If it is to your liking, dear customers, I shall continue the tale of Lady Ningguang's Jade Chamber.","nextNodeIds":[10160107]},{"nodeId":10160107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2553982073,"text":"Hey, there's even a storyteller here! Great atmosphere!","nextNodeIds":[10160108]},{"nodeId":10160108,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2945007273,"text":"Besides fine wine, the excellent ambience is the reason why this place is so well-loved.","nextNodeIds":[10160109]},{"nodeId":10160109,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2263685385,"text":"But when I say ambience, I refer to a different sort from the one the Teyvat Travel Guide uses to judge other establishments.","nextNodeIds":[10160110]},{"nodeId":10160110,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"Iron Tongue Tian","textMapHash":3958481329,"text":"As you all know, high above the land of Liyue lies a pavilion in the clouds, a palace in the mist...","nextNodeIds":[10160111]},{"nodeId":10160111,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"Iron Tongue Tian","textMapHash":2635664953,"text":"What does it mean to have all-seeing eyes? This, my friends: Lady Ningguang's masterwork that bridges earth and sky.","nextNodeIds":[10160112]},{"nodeId":10160112,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"Iron Tongue Tian","textMapHash":2221009297,"text":"Imagine. The weather is clear, and you gaze down from the deck on the world below...","nextNodeIds":[10160113]},{"nodeId":10160113,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"Iron Tongue Tian","textMapHash":855083257,"text":"Behold! The glorious sights of Liyue Harbor, stretching out far and wide!","nextNodeIds":[10160201]},{"nodeId":10160201,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"Iron Tongue Tian","textMapHash":402353481,"text":"These are but scraps of paper, and yet they guide Lady Ningguang's hand — such is their value.","nextNodeIds":[10160202]},{"nodeId":10160202,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"Iron Tongue Tian","textMapHash":2980590625,"text":"Merely grasping one or two of them will surely gift you a fragment of her wisdom — enough to stay a step or two ahead of your peers.","nextNodeIds":[10160203]},{"nodeId":10160203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3543104369,"text":"Tianquan Ningguang... feels like we're hearing this name a lot.","nextNodeIds":[10160204]},{"nodeId":10160204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":588739273,"text":"Liyue locals talk about her, the Fatui hate her, she's most likely the one who hid the Exuvia, and we saw her at the Rite of Descension...","nextNodeIds":[10160205]},{"nodeId":10160205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1703035521,"text":"Huh, Paimon wonders what sort of person she is.","nextNodeIds":[10160207]},{"nodeId":10160207,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":1319330193,"text":"At last, I have found you, you who returned from Jueyun Karst.","nextNodeIds":[10160208]},{"nodeId":10160208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":338850665,"text":"Who's there!?","nextNodeIds":[10160209]},{"nodeId":10160209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2561605441,"text":"Paimon, we gotta go... !","nextNodeIds":[10160210]},{"nodeId":10160210,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3350347393,"text":"Wait! I am not with the Millelith, nor am I here to claim your bounty.","nextNodeIds":[10160211]},{"nodeId":10160211,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3439300841,"text":"However, I am an emissary of the Liyue Qixing. My name is Ganyu, secretary at the Yuehai Pavilion, and I have come specifically to meet you.","nextNodeIds":[10160212,10160213]},{"nodeId":10160212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3823197393,"text":"Emissary?","nextNodeIds":[10160214]},{"nodeId":10160214,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":1913804257,"text":"Well, in concrete terms, I am the corporate secretary for the Qixing. At the moment, I am serving as Lady Ningguang's special emissary.","nextNodeIds":[10160215]},{"nodeId":10160215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1518542001,"text":"Ningguang sent you? We were literally just talking about her...","nextNodeIds":[10160216]},{"nodeId":10160216,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3328646489,"text":"My apologies, you who have returned from Jueyun Karst... I am duty-bound, and cannot extend my courtesy to you in full.","nextNodeIds":[10160217]},{"nodeId":10160217,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":120430697,"text":"But I have with me a letter from Lady Ningguang. She extends a formal invitation to you in her capacity as Tianquan.","nextNodeIds":[10160218]},{"nodeId":10160218,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2632324937,"text":"She invites you to her palace in the sky.","nextNodeIds":[10160219]},{"nodeId":10160219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2213716337,"text":"An official invitation...?","nextNodeIds":[10160220]},{"nodeId":10160220,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":1481012377,"text":"Lady Ningguang said this:","nextNodeIds":[10160221]},{"nodeId":10160221,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":956435025,"text":"#\"Invite {F#her}{M#him} to come here.\"","nextNodeIds":[10160222]},{"nodeId":10160222,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":1159862401,"text":"#\"I wish to meet {F#her}{M#him}.\"","nextNodeIds":[10160223]},{"nodeId":10160223,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":4184286097,"text":"\"At the Jade Chamber, together, we shall snip every one of these entwining dark threads.\"","nextNodeIds":[]},{"nodeId":10160213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3741421929,"text":"Secretary?","nextNodeIds":[10160214]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["10005","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":101606,"order":6,"stepDescription":"","stepDescTextMapHash":1677916374,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101606,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_I