:"Chang the Ninth","textMapHash":2119158237,"text":"Thanks for your help. I'm not sure what I would have done without it.","nextNodeIds":[221150204]},{"nodeId":221150204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":563932437,"text":"Granny Ruoxin is worried sick about you.","nextNodeIds":[221150205]},{"nodeId":221150205,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":2140132325,"text":"Is she? She's wasting her energy... I'm quite capable of looking after myself. I could have easily dealt with them if it came to it... It just would have been a bit of a bother, that's all...","nextNodeIds":[221150206]},{"nodeId":221150206,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":3913599525,"text":"...Still, I'm glad you showed up. Otherwise, I could have been here a while longer... This way, at least I won't have to put up with her constant nagging when I get back.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133102904,3"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1624"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2211505,"order":5,"stepDescription":"Talk to Paimon","stepDescTextMapHash":4030630706,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGP