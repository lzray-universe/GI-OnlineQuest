roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":1455993301,"text":"I'm so used to calling him Little Chang now, it feels strange saying \"Chang the Ninth.\"","nextNodeIds":[221150105]},{"nodeId":221150105,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":2347755205,"text":"Last night, he said he was going out to do some research for his novel. I didn't think anything of it, just told him not to stay out too late. The usual.","nextNodeIds":[221150106]},{"nodeId":221150106,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":3958499605,"text":"But he still hasn't come back. I'm so worried something's happened to him.","nextNodeIds":[221150107]},{"nodeId":221150107,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":2995447821,"text":"And I'm too old and frail to go out looking for him. Could you two dears go and find him for me?","nextNodeIds":[221150108,221150110]},{"nodeId":221150108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2253931197,"text":"Leave it to us.","nextNodeIds":[221150109]},{"nodeId":221150109,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":1101950349,"text":"Wonderful. Thank you, dears.","nextNodeIds":[]},{"nodeId":221150110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4239506829,"text":"Do you know which way he went?","nextNodeIds":[221150111]},{"nodeId":221150111,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":3843020277,"text":"*sigh* There's only one place he'll have gone. Wuwang Hill, north of here.","nextNodeIds":[221150112]},{"nodeId":221150112,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":954957405,"text":"Please, go and find him — for my sake. He's been out there so long... I do hope nothing's happened to him.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133102904,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2306"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2211502,"order":2,"stepDescription":"Find Chang the Ninth","stepDescTextMapHash":2646227898,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1174,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22115NPCBorn","40"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2211507],"talks":[{"talkId":2211507,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","