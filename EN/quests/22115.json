["2211506","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22115NPCBorn","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":2211507,"order":10,"stepDescription":"Give the pages to Chang the Ninth","stepDescTextMapHash":1483370690,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211505,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1624"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2211505],"talks":[{"talkId":2211505,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211507","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2211505,"initDialog":221150501,"nextRandomTalks":[],"nextTalks":[],"npcId":[1624],"performCfg":"","priority":3,"questId":22115,"showRandomTalkCount":0},"dialogs":[{"nodeId":221150501,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":2324865853,"text":"*sigh* I need to make this novel a good one... But how?","nextNodeIds":[221150502]},{"nodeId":221150502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":410936933,"text":"Did you drop these?","nextNodeIds":[221150503]},{"nodeId":221150503,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":136967269,"text":"Hmm? Oh... Yes, these are mine. But I didn't like what I'd written, so I scrapped them. Tossed them into the river.","nextNodeIds":[221150504]},{"nodeId":221150504,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":3214957205,"text":"I can't believe you went and collected them all... This writing's barely legible now anyway.","nextNodeIds":[221150505]},{"nodeId":221150505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1356051653,"text":"What were you writing?","nextNodeIds":[221150506]},{"nodeId":221150506,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":3205576813,"text":"A story for a girl I knew as a child. These are early drafts that I scrapped. Ah, that little girl... You've no idea what she was like when we were small. Constantly badgering me to read her a story.","nextNodeIds":[221150507]},{"nodeId":221150507,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":1503392573,"text":"Regrettably, I never had much time to write back then. I wrote the beginnings of a story to start her off, telling myself I'd write the rest when I had more time.","nextNodeIds":[221150508]},{"nodeId":221150508,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":1566857109,"text":"And then one day, she disappeared. I couldn't find her anywhere.","nextNodeIds":[221150509]},{"nodeId":221150509,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":1269455533,"text":"Hmph. It's because of her family, I'm sure of it. They never liked me, didn't want her to have anything to do with me. So they waited for an opportunity to quietly move out of Qingce Village for good.","nextNodeIds":[221150510]},{"nodeId":221150510,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":2481593973,"text":"Well, they'll soon see! Once I've made a name for myself they'll never look at me in the same way again! As soon as I've finished this story I'm writing for her, I'll see that it gets sold all over the world!","nextNodeIds":[221150511]},{"nodeId":221150511,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":4245922341,"text":"That way, they'll see the new me from wherever they are in the world! They'll see I'm not the same Chang the Ninth I was as a kid!","nextNodeIds":[221150512]},{"nodeId":221150512,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":1438177301,"text":"And then... And then I can see her again... But first things first — I need to actually get the story written.","nextNodeIds":[221150513]},{"nodeId":221150513,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":476907645,"text":"...I—I'm sorry, look at me, giving you my whole life story! Anyway. I should get back to working on my book.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211505,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100495,100513,100514"],"PAINLIBBLDK":"QUEST_EXEC_DEL_ALL_SPECIFIC_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1624"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2211508,"order":11,"stepDescription":"Talk to Granny Ruoxin","stepDescTextMapHash":1292488018,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211506,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["2306"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2211506,2211508],"talks":[{"talkId":2211506,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211508","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2211506,"initDialog":221150601,"nextRandomTalks":[],"nextTalks":[],"npcId":[2306],"performCfg":"","priority":3,"questId":22115,"showRandomTalkCount":0},"dialogs":[{"nodeId":221150601,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":1209011349,"text":"*sigh* Oh, Little Chang...","nextNodeIds":[221150602]},{"nodeId":221150602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":51802053,"text":"Chang the Ninth is back, safe and sound.","nextNodeIds":[221150603]},{"nodeId":221150603,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":4277246037,"text":"Yes, I saw! Thank you, dears.","nextNodeIds":[221150604]},{"nodeId":221150604,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":1711129581,"text":"He's always been this way, since he was a boy... Running off and getting himself into trouble, protesting that he's all grown up... He'll never grow up, though.","nextNodeIds":[221150605]},{"nodeId":221150605,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":677936085,"text":"Anyway, it's nothing you should fret about. Little Chang will do as Little Chang pleases.","nextNodeIds":[221150606]},{"nodeId":221150606,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":3261498629,"text":"Thank you for going all that way to bring him home. Please accept this in return.","nextNodeIds":[221150607]},{"nodeId":221150607,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":2639571429,"text":"I won't keep you any longer, I'm sure you have things to get back to. But... please don't end up like Little Chang. He's so preoccupied with how he's seen by others that he's never gotten round to taking a long, hard look at himself...","nextNodeIds":[221150608]},{"nodeId":221150608,"roleType":"TALK_ROLE_NPC","speakerId":2306,"speakerName":"Granny Ruoxin","textMapHash":105128973,"text":"Alas, mortals are no adepti... And what is mortal life but a short sufferance that comes before death? Alas!","nextNodeIds":[]}]},{"talkId":2211508,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211508","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2211508,"initDialog":221150801,"nextRandomTalks":[],"nextTalks":[],"npcId":[1624],"performCfg":"","priority":3,"questId":22115,"showRandomTalkCount":0},"dialogs":[{"nodeId":221150801,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":1703806285,"text":"Now, where was I up to...","nextNodeIds":[221150802]},{"nodeId":221150802,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3579232005,"text":"What's the girl's name?","nextNodeIds":[221150803]},{"nodeId":221150803,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":1345243981,"text":"Why, what's it to you? ...Anyway, she preferred me not to use her full name — too formal, she'd say. So I called her by her nickname.","nextNodeIds":[221150804]},{"nodeId":221150804,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":3942466557,"text":"But... she'll be all grown up after this many years. I don't think the nickname would suit her anymore...","nextNodeIds":[221150805]},{"nodeId":221150805,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":3090414477,"text":"If I see her again, I'll have to use her full name... But anyway, forget it. I'm not telling you her name — full, nick, or otherwise.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211506,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["28100"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"},{"LNHLPKELCAL":["3","133102239,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["3","133102505,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["2306"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2211501,2211502,2211503,2211505,2211506,2211507,2211508],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","count":20},{"roleType":"T