r","textMapHash":2880679989,"text":"What are you doing?","nextNodeIds":[220000105]},{"nodeId":220000105,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":119354445,"text":"We were gonna play a game, but there's no one to be the pirate.","nextNodeIds":[220000106]},{"nodeId":220000106,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1871166517,"text":"If there's no pirate, there's no one to do the robbing... so we can't start the game.","nextNodeIds":[220000107]},{"nodeId":220000107,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":4079618925,"text":"Ooh, ooh, I know, you can do it! Do you want to be a pirate?","nextNodeIds":[220000108,220000110]},{"nodeId":220000108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1677006693,"text":"It will be done.","nextNodeIds":[220000109]},{"nodeId":220000109,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":2779360445,"text":"Yay! Right, let's get ready...","nextNodeIds":[220000115]},{"nodeId":220000115,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1597135085,"text":"When you're ready, come and join in.","nextNodeIds":[]},{"nodeId":220000110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2184120589,"text":"Pirating is not my area of expertise...","nextNodeIds":[220000111]},{"nodeId":220000111,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":562525053,"text":"It's not that hard! A pirate is just someone who is very naughty and takes things that don't belong to them.","nextNodeIds":[220000112]},{"nodeId":220000112,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":401755165,"text":"I've never met a real pirate though. That's just what Beidou told me.","nextNodeIds":[220000113]},{"nodeId":220000113,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":374949605,"text":"But I think it must be quite easy to play a pirate.","nextNodeIds":[220000114]},{"nodeId":220000114,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":708944149,"text":"Hehehe, I'm sure you can do it! Let's go!","nextNodeIds":[220000115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["203101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2200002,"order":2,"stepDescription":"Talk to \"Captain\" Little Meng","stepDescTextMapHash":1056064210,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["203101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2200002,2200004,2200007],"talks":[{"talkId":2200002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200002","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":2200002,"initDialog":220000201,"nextRandomTalks":[],"nextTalks":[],"npcId":[203101],"performCfg":"","priority":6,"questId":22000,"showRandomTalkCount":0},"dialogs":[{"nodeId":220000201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1606806413,"text":"Ready!","nextNodeIds":[220000202]},{"nodeId":220000202,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1014906973,"text":"Then let the game begin!","nextNodeIds":[220000203]},{"nodeId":220000203,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":3816027885,"text":"...How do we start?","nextNodeIds":[220000204]},{"nodeId":220000204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":175297957,"text":"Uh... Shiver me timbers? I'm robbing you!","nextNodeIds":[220000205]},{"nodeId":220000205,"roleType":"TALK_ROLE_NPC","speakerId":207401,"speakerName":"Little Lulu","textMapHash":3424359349,"text":"Eek! Pirates!","nextNodeIds":[220000206]},{"nodeId":220000206,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":1270195149,"text":"Don't worry, Lulu, I'll save you!","nextNodeIds":[220000207]},{"nodeId":220000207,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":2397899973,"text":"You must be a pirate. Tell me, why are you robbing us?","nextNodeIds":[220000208,220000209]},{"nodeId":220000208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":128619301,"text":"Because I'm a pirate...","nextNodeIds":[220000210]},{"nodeId":220000210,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1013835165,"text":"Not all of them. There are good-guy pirates and bad-guy pirates.","nextNodeIds":[220000211]},{"nodeId":220000211,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":3917731549,"text":"Beidou says she's a pirate, but she's one of the good guys. She gives us snacks! Everyone loves Beidou.","nextNodeIds":[220000212]},{"nodeId":220000212,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":4160751565,"text":"Why you gotta be a bad pirate? Can't you be a good pirate instead?","nextNodeIds":[220000213]},{"nodeId":220000213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2808865285,"text":"You're the one who said pirates are naughty people who take things that don't belong to them!","nextNodeIds":[220000214,220000215]},{"nodeId":220000214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1470503165,"text":"I see the error of my ways.","nextNodeIds":[220000216]},{"nodeId":220000216,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":2266039045,"text":"Great! Owning up to your mistakes is the first step towards becoming a better person. That's what Beidou says.","nextNodeIds":[220000217]},{"nodeId":220000217,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":667604965,"text":"The next step is tidying up the area. Because as long as you do good things, you can be a good person. Even a good pirate.","nextNodeIds":[]},{"nodeId":220000215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1733758981,"text":"I hereby renounce said naughtiness.","nextNodeIds":[220000216]},{"nodeId":220000209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3469265621,"text":"That's what pirates do...","nextNodeIds":[220000210]}]},{"talkId":2200004,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200002","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2200004,"initDialog":220000401,"nextRandomTalks":[],"nextTalks":[2200002,2200007],"npcId":[203101],"performCfg":"","priority":6,"questId":22000,"showRandomTalkCount":0},"dialogs":[{"nodeId":220000401,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1306916869,"text":"Ready?","nextNodeIds":[]}]},{"talkId":2200007,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_