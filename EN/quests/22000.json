00502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2814996573,"text":"Not yet.","nextNodeIds":[220000503]},{"nodeId":220000503,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1564502085,"text":"Hurry up. This is your chance to change your ways and show you can be a good person.","nextNodeIds":[220000504]},{"nodeId":220000504,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":3068137717,"text":"Hey, are we seriously saying that just cleaning up the place once turns you into one of the good guys?","nextNodeIds":[220000505]},{"nodeId":220000505,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":1117234253,"text":"All it takes to be a good person is the willingness to do the right thing.","nextNodeIds":[220000506]},{"nodeId":220000506,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":2870070221,"text":"That sounds too simple...","nextNodeIds":[220000507]},{"nodeId":220000507,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":3964633141,"text":"Do good, you're a good person. Do bad, you're a bad person. Yes, it's very simple.","nextNodeIds":[220000508]},{"nodeId":220000508,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":1251643957,"text":"Huh. You may say so, but then how come there's still so many bad people in the world?","nextNodeIds":[220000509]},{"nodeId":220000509,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":29712669,"text":"Because everything in the world is easier said than done.","nextNodeIds":[220000510]},{"nodeId":220000510,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":486913973,"text":"But doing bad things is still easier than doing good things.","nextNodeIds":[220000511]},{"nodeId":220000511,"roleType":"TALK_ROLE_NPC","speakerId":203001,"speakerName":"Little Fei","textMapHash":78732109,"text":"Did Beidou teach you that?","nextNodeIds":[220000512]},{"nodeId":220000512,"roleType":"TALK_ROLE_NPC","speakerId":203101,"speakerName":"Little Meng","textMapHash":856255165,"text":"Nah, that one I read in a book.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":4,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"133107005"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133107005,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["2200005","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22000Dirt","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":2200005,"order":4,"stepDescription":"","stepDescTextMapHash":1263586826,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2200005,0],"PAINLIBBLDK":"QUEST_CONTENT_ADD_QUEST_PROGRESS","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2200005,0],"PAINLIBBLDK":"QUEST_CONTENT_ADD_QUEST_PROGRESS","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"