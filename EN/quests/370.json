{"mainQuestId":370,"title":"Shadow Over Mondstadt","description":"Thanks to your efforts, Mondstadt's elemental flow has returned to normal. It's time to report back to Jean.","titleTextMapHash":2826605337,"descTextMapHash":1581497687,"mainQuestExcel":{"mainQuestId":370,"titleTextMapHash":2826605337,"title":"Shadow Over Mondstadt","descTextMapHash":1581497687,"description":"Thanks to your efforts, Mondstadt's elemental flow has returned to normal. It's time to report back to Jean.","chapterId":1002,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/MQ370","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":1002,"descTextMapHash":1581497687,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":370,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":337996991,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/MQ370","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":1002,"rewardIdList":[100370],"series":1002,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[371],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2826605337,"type":"AQ","unlockDescTextMapHash":336068387}},"flow":[{"subQuestId":37001,"order":1,"stepDescription":"Return to Mondstadt","stepDescTextMapHash":984138423,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q37