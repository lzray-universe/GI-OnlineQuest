,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37002","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37002,"initDialog":3700201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1006],"performCfg":"QuestDialogue/AQ/Mengde2_370/Q37002","priority":1,"questId":370,"showRandomTalkCount":0},"dialogs":[{"nodeId":3700201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2713299939,"text":"Isn't that Jean?","nextNodeIds":[3700202]},{"nodeId":3700202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1350070979,"text":"Seems she's talking to someone...","nextNodeIds":[3700203]},{"nodeId":3700203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1356925755,"text":"Let's let her finish, then go say hi?","nextNodeIds":[3700204]},{"nodeId":3700204,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":2267257747,"text":"...which is what has brought us to this point in the first place.","nextNodeIds":[3700205]},{"nodeId":3700205,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":3688899995,"text":"If you are unable to promptly deal with the Stormterror threat, then leave the defense of Mondstadt to the Fatui.","nextNodeIds":[3700206]},{"nodeId":3700206,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":1860761963,"text":"We can put an end to Mondstadt's dragon issues. All we need to do is bring that monster to the—","nextNodeIds":[3700207]},{"nodeId":3700207,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":126639715,"text":"\"Monster\"?","nextNodeIds":[3700208]},{"nodeId":3700208,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":2932747595,"text":"Yes. What's your point?","nextNodeIds":[3700209]},{"nodeId":3700209,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":537295827,"text":"Ah...","nextNodeIds":[3700210]},{"nodeId":3700210,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":583375587,"text":"I'd expect a more professional attitude from your diplomats.","nextNodeIds":[3700211]},{"nodeId":3700211,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3889036363,"text":"Yet here you are saying you want to \"put an end\" to one of The Four Winds of Mondstadt?","nextNodeIds":[3700212]},{"nodeId":3700212,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3199012155,"text":"I won't have any of this nonsense in front of the Knights of Favonius.","nextNodeIds":[3700213]},{"nodeId":3700213,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":405953115,"text":"Heh... Hehehe... It's not as crazy as you make it sound.","nextNodeIds":[3700214]},{"nodeId":3700214,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":390577851,"text":"Fine. That's enough negotiation for today.","nextNodeIds":[3700215]},{"nodeId":3700215,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":1865147307,"text":"At this stage it's simply... an amicable exchange of constructive opinions, no?","nextNodeIds":[3700216]},{"nodeId":3700216,"roleType":"TALK_ROLE_NPC","speakerId":1487,"speakerName":"Anastasia","textMapHash":4060850891,"text":"I'll be sure to make... thorough notes...","nextNodeIds":[3700217]},{"nodeId":3700217,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1156191675,"text":"#Oh, {NICKNAME}, you're back.","nextNodeIds":[3700218]},{"nodeId":3700218,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1044072811,"text":"Thanks for your help. The elemental flow is finally stable.","nextNodeIds":[3700219]},{"nodeId":3700219,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3655343779,"text":"The aftermath of Stormterror's last attack is finally settled for the moment.","nextNodeIds":[3700220]},{"nodeId":3700220,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3873524827,"text":"However, the pressure from the delegation has become too big to be ignored...","nextNodeIds":[3700221]},{"nodeId":3700221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":846059347,"text":"Delegation?","nextNodeIds":[3700222]},{"nodeId":3700222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3001183523,"text":"From Liyue Harbor or Inazuma City?","nextNodeIds":[3700223]},{"nodeId":3700223,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1306165179,"text":"Snezhnaya. They choose to follow the God of Cryo.","nextNodeIds":[3700224]},{"nodeId":3700224,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1565535995,"text":"Their envoys go by a particular name: The Fatui. Heard of them?","nextNodeIds":[3700225]},{"nodeId":3700225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1060929683,"text":"Oh, them. They are super famous.","nextNodeIds":[3700226]},{"nodeId":3700226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3647796219,"text":"Wait, infamous is more the word...","nextNodeIds":[3700227]},{"nodeId":3700227,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":200597539,"text":"I don't think killing Stormterror is the right course of action.","nextNodeIds":[3700228]},{"nodeId":3700228,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1973850835,"text":"The Cryo God's Fatui have always coveted the Anemo God's power.","nextNodeIds":[3700229]},{"nodeId":3700229,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1117982875,"text":"I don't believe they have Mondstadt's best interests at heart.","nextNodeIds":[3700230]},{"nodeId":3700230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":536864739,"text":"Speaking of power...","nextNodeIds":[3700231]},{"nodeId":3700231,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":810704571,"text":"#What is it, {NICKNAME}?","nextNodeIds":[3700232]},{"nodeId":3700232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1953075899,"text":"There's something I need to show the Knights of Favonius.","nextNodeIds":[3700233]},{"nodeId":3700233,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4149131771,"text":"Oh? Let us head back to headquarters then.","nextNodeIds":[3700234]},{"nodeId":3700234,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3631371387,"text":"We shouldn't discuss important matters... out in the open.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1006"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":37004,"order":3,"stepDescription":"Return to the Knights of Favonius Headquarters with Jean","stepDescTextMapHash":556300975,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1004,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["QuestKnighthood"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1004,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["QuestKnighthood"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":37005,"order":4,"stepDescription":"Talk to Jean","stepDescTextMapHash":3633474671,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37005,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["QuestDoorin"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[37005],"talks":[{"talkId":37005,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37005","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37005,"initDialog":3700401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1006],"performCfg":"QuestDialogue/AQ/Mengde2_370/Q37004","priority":1,"questId":370,"showRandomTalkCount":0},"dialogs":[{"nodeId":3700401,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3557049619,"text":"It's a crystal embedded with some kind of power... Lisa, are you able to analyze it?","nextNodeIds":[3700402]},{"nodeId":3700402,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3720744091,"text":"Let me take a look...","nextNodeIds":[3700403]},{"nodeId":3700403,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1377649731,"text":"Hmm... I can see impurities in the crystal, but upon further inspection...","nextNodeIds":[3700404]},{"nodeId":3700404,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3913720035,"text":"No, I'm sorry, I can't make a proper analysis at the moment. Give me some time. I'll take a look through the library's restricted section.","nextNodeIds":[3700405]},{"nodeId":3700405,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3420654219,"text":"Right. I'll leave the research to you then, Lisa.","nextNodeIds":[3700406]},{"nodeId":3700406,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3446410947,"text":"Understood. I'll notify you all if I make any progress.","nextNodeIds":[3700407]},{"nodeId":3700407,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3780346931,"text":"Though I wouldn't go getting your hopes up. They are incredibly ancient texts, not to mentio— Ouch!","nextNodeIds":[3700408]},{"nodeId":3700408,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":120852003,"text":"Gosh, that hurt!","nextNodeIds":[3700409]},{"nodeId":3700409,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1555280219,"text":"The impurities in the crystal... It hurts when I get close...","nextNodeIds":[3700410]},{"nodeId":3700410,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2366526515,"text":"I see... It appears to react to Visions.","nextNodeIds":[3700411]},{"nodeId":3700411,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":4038390475,"text":"The impurities and the elemental energy we embody repel each other.","nextNodeIds":[3700412]},{"nodeId":3700413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":815322731,"text":"...","nextNodeIds":[3700414]},{"nodeId":3700412,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2313624123,"text":"#It's strange, though. {NICKNAME} has elemental abilities as well, but doesn't seem to be affected in the same way.","nextNodeIds":[3700413]},{"nodeId":3700415,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":803332355,"text":"Cutie?","nextNodeIds":[3700417]},{"nodeId":3700416,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3943045699,"text":"Okay. I will keep it.","nextNodeIds":[3700417]},{"nodeId":3700414,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3637803059,"text":"Anyway, the crystal would be better left in the hands of my cutie. It will just be a pain if left with us — both literally and metaphorically.","nextNodeIds":[3700415,3700416]},{"nodeId":3700417,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2585876611,"text":"...Fascinating.","nextNodeIds":[3700418]},{"nodeId":3700418,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":20573067,"text":"Do you know anything about what makes you special?","nextNodeIds":[3700419]},{"nodeId":3700420,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2184663603,"text":"I do not know what to make of it either.","nextNodeIds":[3700421]},{"nodeId":3700421,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":379369539,"text":"#Well, then, {NICKNAME}... The Knights of Favonius have another favor to ask of you.","nextNodeIds":[3700422]},{"nodeId":3700422,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4273246139,"text":"Please accept the title of Honorary Knight... and the gratitude of the Acting Grand Master.","nextNodeIds":[3700423]},{"nodeId":3700424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4200392867,"text":"Honorary Knight... of Favonius!?","nextNodeIds":[3700425]},{"nodeId":3700426,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3212864179,"text":"We ask for your continued assistance in finding some answers.","nextNodeIds":[3700427]},{"nodeId":3700427,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2864286467,"text":"Stormterror's rage... and strange crystals... I know Mondstadt's peace hangs in the balance.","nextNodeIds":[3700428]},{"nodeId":3700428,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3634830363,"text":"May the wind open your eyes to the truth.","nextNodeIds":[3700429]},{"nodeId":3700429,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1829024571,"text":"We'll meet back here if you find anything.","nextNodeIds":[]},{"nodeId":4820221,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3241160067,"text":"Okay then. You just need to follow the <color=#00E1FFFF>marked route</color> to the finish.","nextNodeIds":[4820222]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37005,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["QuestDoorin"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":37003,"order":5,"stepDescription":"","stepDescTextMapHash":411942639,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1067,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG"