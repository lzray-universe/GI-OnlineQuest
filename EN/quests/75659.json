{"mainQuestId":75659,"title":"A Hero's Approval!","description":"A combat readiness liaison is awaiting your help outside the Stadium of the Sacred Flame's Speaker's Chamber...","titleTextMapHash":894204351,"descTextMapHash":2351189110,"mainQuestExcel":{"mainQuestId":75659,"titleTextMapHash":894204351,"title":"A Hero's Approval!","descTextMapHash":2351189110,"description":"A combat readiness liaison is awaiting your help outside the Stadium of the Sacred Flame's Speaker's Chamber...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5240,"luaPath":"Actor/Quest/WQ75659","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5240,"chapterId":0,"descTextMapHash":2351189110,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75659,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1695915273,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75659","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[139604],"series":75659,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":894204351,"type":"WQ","unlockDescTextMapHash":358154270}},"flow":[{"subQuestId":7565901,"order":1,"stepDescription":"Talk to the combat readiness liaison","stepDescTextMapHash":3494826652,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7565901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["15129"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7565901],"talks":[{"talkId":7565901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7565901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7565901,"initDialog":756590101,"nextRandomTalks":[],"nextTalks":[],"npcId":[15129],"performCfg":"QuestDialogue/WQ/Natlan_75659/Q7565901","priority":5,"questId":75659,"showRandomTalkCount":0},"dialogs":[{"nodeId":756590101,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":3930802378,"text":"You're finally here, great hero!","nextNodeIds":[756590102]},{"nodeId":756590102,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":2736508754,"text":"I have waited here for a long time indeed, but your arrival has made it all worth it. Ah, the very sight of you is as rejuvenating balm!","nextNodeIds":[756590103,756590104]},{"nodeId":756590103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2130511674,"text":"Indeed, my timing is impeccable.","nextNodeIds":[756590105]},{"nodeId":756590105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":185824994,"text":"Wow, the atmosphere suddenly got so... formal... Does Paimon, um, also have to speak really formally too?","nextNodeIds":[756590106]},{"nodeId":756590106,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":3310709898,"text":"Ah, not to worry, hero, noble guide. Allow me to introduce this situation in brief.","nextNodeIds":[756590107]},{"nodeId":756590107,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":2387396394,"text":"I am but a humble staff member at the Speaker's Chamber. Irade is my name, and I assist our Archon in the training of various tribal patrol squads.","nextNodeIds":[756590108]},{"nodeId":756590108,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":155120602,"text":"Tradition dictates that, after a certain period of time has passed, new warriors are to be selected from amongst the youth of the tribes to join these squads.","nextNodeIds":[756590109]},{"nodeId":756590109,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":784229970,"text":"At the same time, we must prepare sterner tests for the veteran members such that they never cease to challenge themselves and improve.","nextNodeIds":[756590110]},{"nodeId":756590110,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":4240735298,"text":"The relevant selection and examination stages are designed via cooperation between the combat readiness liaisons and outstanding warriors from every tribe...","nextNodeIds":[756590111]},{"nodeId":756590111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3910328370,"text":"Yeah, alright, Paimon can see where this is going!","nextNodeIds":[756590112]},{"nodeId":756590112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1397018514,"text":"#Don't worry! {NICKNAME}'s a real pro when it comes to combat and tests of speed, so {M#he}{F#she} should be able to help you come up with lots of cool stages!","nextNodeIds":[756590113,756590114]},{"nodeId":756590113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3311985546,"text":"Are you going to send me a commission, then?","nextNodeIds":[756590115]},{"nodeId":756590115,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":2643509802,"text":"Hardly, hardly! I would not presume to ask you to do that which was my job from the first, great hero! That would not only be a dereliction of my duty, but a slight against you, to boot!","nextNodeIds":[756590116]},{"nodeId":756590116,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":2668323738,"text":"The design of all the exam stages has already been completed. I'd just like to request that you, great hero, help us \"certify\" their suitability, and, at the same time, set an example for our warriors.","nextNodeIds":[756590117]},{"nodeId":756590117,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":3374679050,"text":"Just as written exams demand perfect scores, so too must lofty targets for practical skills be set. Mighty warriors will take the lead in clearing these challenges, and this will greatly motivate their juniors.","nextNodeIds":[756590118]},{"nodeId":756590118,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":2512784530,"text":"For example, exam stages related to the Children of Echoes will be certified by \"Baraka\" Xilonen...","nextNodeIds":[756590119]},{"nodeId":756590119,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":3499790410,"text":"While we've asked \"Malipo\" Kinich and \"Vuka\" Chasca to deal with those of the Scions of the Canopy and the Flower-Feather Clan, which has led to many warriors gladly taking on said challenges...","nextNodeIds":[756590120]},{"nodeId":756590120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2092761946,"text":"#Ah, so that's what you're going for... In that case, aren't you asking {NICKNAME} to become— How do you say it again?","nextNodeIds":[756590121]},{"nodeId":756590121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3843418242,"text":"Oh, right! \"The unattainable horizon\"!","nextNodeIds":[756590122]},{"nodeId":756590122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":238164706,"text":"Alright. This ace shall set the pace.","nextNodeIds":[756590123]},{"nodeId":756590123,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":3701319626,"text":"That's the spirit! That's our hero!","nextNodeIds":[756590124]},{"nodeId":756590124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1593314650,"text":"Still, Paimon, let's stay humble. Teyvat's full of skilled fighters.","nextNodeIds":[756590125]},{"nodeId":756590125,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":1540798290,"text":"Ah, such modesty — truly, you are a virtuous hero!","nextNodeIds":[756590126]},{"nodeId":756590126,"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","textMapHash":74918674,"text":"In that case, allow me to mark some exam stage locations out on the map. Feel free to visit them and show us what you've got!","nextNodeIds":[]},{"nodeId":756590114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":109720050,"text":"Are you going to be my client?","nextNodeIds":[756590115]},{"nodeId":756590104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2133013482,"text":"Err... So, what's the situation?","nextNodeIds":[756590105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7565901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["15129"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7565901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":15129,"speakerName":"Irade","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[139604],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2351189110,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH"