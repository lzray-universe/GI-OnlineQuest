"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7507613","3","","",""],"type":"QUEST_COND_QUEST_STATE_NOT_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7507604,"initDialog":750760401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21705],"performCfg":"","priority":4,"questId":75076,"showRandomTalkCount":0},"dialogs":[{"nodeId":750760401,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":467761826,"text":"The fog on the sea has thickened lately. A worrying sign...","nextNodeIds":[750760404]},{"nodeId":750760404,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":1529631594,"text":"Could that legend be true?","nextNodeIds":[750760405]},{"nodeId":750760405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2509547882,"text":"What legend?","nextNodeIds":[750760406]},{"nodeId":750760406,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":4052950122,"text":"Err... Ah, that depends on what legend you wish to hear, outlander hero...","nextNodeIds":[750760407]},{"nodeId":750760407,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":26781034,"text":"Two reasons have been given for that floating island and the huge graffiti: One more akin to a story, and the other to a real legend.","nextNodeIds":[750760402]},{"nodeId":750760402,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":3758966242,"text":"Which would you like to hear, outlander warrior?","nextNodeIds":[750760408,750760411]},{"nodeId":750760408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4104029210,"text":"Let's hear the story...","nextNodeIds":[750760409]},{"nodeId":750760409,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":3230455122,"text":"Hmm, there's always a romantic spin with stories... There, the origin of the graffiti on the foggy floating island is part of The Tale of Qoyllor and Ukuku.","nextNodeIds":[750760403]},{"nodeId":750760403,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":811827298,"text":"It is said that the girl named Qoyllor left a huge work of graffiti by the beach in order to contact her Father Sun.","nextNodeIds":[750760410]},{"nodeId":750760410,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":3777387258,"text":"Her Father Sun saw the graffiti from the sky and thus whisked her away from the earth... That's sort of how the story goes.","nextNodeIds":[750760417]},{"nodeId":750760417,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":329403602,"text":"It is said that the unsettling mist was bestowed by the Sun Father upon the people of the surface, as punishment for stealing his daughter's power.","nextNodeIds":[750760415]},{"nodeId":750760415,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":4133511810,"text":"*sigh* Be it legend or story, the rising fog is never a good sign.","nextNodeIds":[750760416]},{"nodeId":750760416,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":1695193530,"text":"Outlander hero... That place is probably fraught with danger, so you must take care not to get too close...","nextNodeIds":[]},{"nodeId":750760411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3055695426,"text":"About the real legend...","nextNodeIds":[750760412]},{"nodeId":750760412,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":2454434618,"text":"As for the real legend... It is said that a long time ago, there was an evil sorcerer who disguised himself as a Wayob and bewitched the heroes of the tribe.","nextNodeIds":[750760413]},{"nodeId":750760413,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":2080599050,"text":"Later, the tribal heroes had to seal the pitch-black wicked wizard within that giant graffiti...","nextNodeIds":[750760414]},{"nodeId":750760414,"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","textMapHash":2804585866,"text":"As to why the ocean surface has become like this... They say that it presages the moment when the evil wizard shall shatter the seal and escape its grasp.","nextNodeIds":[750760415]}]}],"questNarration":[],"talkIds":[7507604,7507612],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21705,"speakerName":"Sakaw","count":14},{"roleType":"TALK_ROLE_NPC","speakerId":21742,"speakerName":"Weakened Wayob Manifestation","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[175076],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3342035734,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":4,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCK