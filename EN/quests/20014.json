{"mainQuestId":20014,"title":"Adventurer Exam: Battle Tactics","description":"Anna from Mondstadt would really like to become an adventurer...","titleTextMapHash":533558279,"descTextMapHash":3237967918,"mainQuestExcel":{"mainQuestId":20014,"titleTextMapHash":533558279,"title":"Adventurer Exam: Battle Tactics","descTextMapHash":3237967918,"description":"Anna from Mondstadt would really like to become an adventurer...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ20014","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3237967918,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":20014,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1602943177,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ20014","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":40010,"titleTextMapHash":533558279,"type":"IQ","unlockDescTextMapHash":1288587206}},"flow":[{"subQuestId":2001401,"order":1,"stepDescription":"Talk to Anthony","stepDescTextMapHash":1375722092,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2001401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1408"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2001401,2001404],"talks":[{"talkId":2001401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2001401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2001401,"initDialog":200140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1408,1405],"performCfg":"QuestDialogue/IQ/Mengde_20014/Q2001401","priority":5,"questId":20014,"showRandomTalkCount":0},"dialogs":[{"nodeId":200140101,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":3833873258,"text":"Anna, please reconsider. We should really take the long-term view here...","nextNodeIds":[200140102]},{"nodeId":200140102,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3691933762,"text":"Oh, come on! Stop worrying, already. I'll be fine!","nextNodeIds":[200140103,200140104]},{"nodeId":200140103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":955764202,"text":"Doing well over there, Anna?","nextNodeIds":[200140105]},{"nodeId":200140105,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":2181563346,"text":"Traveler! You're just in time! Please, you've got to help me out here. Anna wants to become an adventurer!","nextNodeIds":[200140106]},{"nodeId":200140106,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":507488338,"text":"And why can't I be an adventurer? I'm as healthy as can be, and Cyrus says I've got the mind for the job, too!","nextNodeIds":[200140107]},{"nodeId":200140107,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1367486546,"text":"You haven't even been well for that long! What are you going to do if you fall ill again? Besides, there's no way our parents will agree!","nextNodeIds":[200140108]},{"nodeId":200140108,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3672294282,"text":"Come on, I've already talked to Mom and Dad about this. They say they'll allow it as long as I pass the Adventurers' Guild selection trials.","nextNodeIds":[200140109]},{"nodeId":200140109,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1911318530,"text":"Wh... What!?","nextNodeIds":[200140110,200140111]},{"nodeId":200140110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1888706362,"text":"Calm down, son...","nextNodeIds":[200140112]},{"nodeId":200140112,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":793477570,"text":"Cyrus helped me get a training schedule set up a few days back. I've been training ever since then.","nextNodeIds":[200140113]},{"nodeId":200140113,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":68541986,"text":"That said, it's all been scouting work, foraging for emergency rations, outdoor survival, and stuff like that...","nextNodeIds":[200140114]},{"nodeId":200140114,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":4107428914,"text":"But I've heard that adventurers also do battle with monsters out in the wild often, too.","nextNodeIds":[200140115]},{"nodeId":200140115,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3374075234,"text":"I'd love to learn how to do that, but I haven't found anyone who'll teach me...","nextNodeIds":[200140116]},{"nodeId":200140116,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":56917426,"text":"And as you can see, my brother...","nextNodeIds":[200140117]},{"nodeId":200140117,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1212373170,"text":"I won't have it! Those monsters are highly dangerous! Even if you do go, you'll have to make sure you're accompanied by a seasoned veteran at the very least!","nextNodeIds":[200140118]},{"nodeId":200140118,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":500672090,"text":"I mean, I've asked Jack! He agreed to help me.","nextNodeIds":[200140119]},{"nodeId":200140119,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":82421674,"text":"Oh, get real. I know who Jack is. He can barely take care of himself out there, let alone you.","nextNodeIds":[200140120]},{"nodeId":200140120,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":1765471234,"text":"Well, I doubt we'll find any veteran adventurers that easily at the Guild, and I don't have the funds to put a commission up...","nextNodeIds":[200140121,200140122]},{"nodeId":200140121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1550051762,"text":"Hmm. Why don't I come with you?","nextNodeIds":[200140123]},{"nodeId":200140123,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":4050192978,"text":"Eh? You'd help me out! That's great!","nextNodeIds":[200140124]},{"nodeId":200140124,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3258537698,"text":"Alright then, brother, guess you can rest easy now!","nextNodeIds":[200140125]},{"nodeId":200140125,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":552233122,"text":"Well...","nextNodeIds":[200140126]},{"nodeId":200140126,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":3061504794,"text":"#*sigh* Alright, alright. I know how strong the Honorary Knight is. With {F#her}{M#him} by your side, I suppose I can rest a little easier.","nextNodeIds":[200140127]},{"nodeId":200140127,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":716175754,"text":"However, you should still be careful out there...","nextNodeIds":[200140128]},{"nodeId":200140128,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":225932154,"text":"Do you remember everything I told you?","nextNodeIds":[200140129]},{"nodeId":200140129,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":2807123242,"text":"Yeah, yeah, I remember them... You've talked my ear off several times already!","nextNodeIds":[200140130]},{"nodeId":200140130,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3204550722,"text":"Alright then, Traveler, let's head out right now! I've had Jack check out the encampment we're going to.","nextNodeIds":[]},{"nodeId":200140122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":922764706,"text":"I've got some confidence in my skills.","nextNodeIds":[200140123]},{"nodeId":200140111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3905710450,"text":"In that case, how's your training going?","nextNodeIds":[200140112]},{"nodeId":200140104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3341530850,"text":"What are you two talking about, Anthony?","nextNodeIds":[200140105]}]},{"talkId":2001404,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2001401","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUES