],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2001403","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2001405","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2001402,"initDialog":200140201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1405],"performCfg":"QuestDialogue/IQ/Mengde_20014/Q2001402","priority":5,"questId":20014,"showRandomTalkCount":0},"dialogs":[{"nodeId":200140201,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":354191106,"text":"Wow, you beat them all down — you made it look pretty easy, too.","nextNodeIds":[200140202]},{"nodeId":200140202,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":426151434,"text":"It's just as the handbook says — you can use all sorts of ways and means to beat monsters...","nextNodeIds":[200140203]},{"nodeId":200140203,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":974109506,"text":"Still, I've