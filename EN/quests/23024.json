"","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2302407,"initDialog":230240701,"nextRandomTalks":[],"nextTalks":[],"npcId":[4079,4080],"performCfg":"QuestDialogue/Q2302407","priority":5,"questId":23024,"showRandomTalkCount":0},"dialogs":[{"nodeId":230240701,"roleType":"TALK_ROLE_NPC","speakerId":4079,"speakerName":"Vardan","textMapHash":829656082,"text":"Traveler, you couldn't have come at a better time. The rose is finally in full bloom!","nextNodeIds":[230240702]},{"nodeId":230240702,"roleType":"TALK_ROLE_NPC","speakerId":4079,"speakerName":"Vardan","textMapHash":3879317426,"text":"Thanks to you, it is the best growing rose I've ever seen.","nextNodeIds":[230240703]},{"nodeId":230240703,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":1632350330,"text":"The doctors at Bimarstan will be amazed, too!","nextNodeIds":[230240704]},{"nodeId":230240704,"roleType":"TALK_ROLE_NPC","speakerId":4079,"speakerName":"Vardan","textMapHash":3790136882,"text":"No time better than now. Let me move this flower...","nextNodeIds":[230240705]},{"nodeId":230240705,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":2087482674,"text":"Wait, what was that sound?","nextNodeIds":[230240706]},{"nodeId":230240706,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":928486562,"text":"Something is stirring in the field...","nextNodeIds":[230240707]},{"nodeId":230240707,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3555716826,"text":"Whoa! A Whopperflower! Why is it even here!?","nextNodeIds":[230240708]},{"nodeId":230240708,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":3937888674,"text":"Oh no! The field! It's ruining the field!","nextNodeIds":[230240709,230240710]},{"nodeId":230240709,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2681071050,"text":"I'll take care of it!","nextNodeIds":[230240711]},{"nodeId":230240711,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3987647482,"text":"Eh? The Whopperflower fled...?","nextNodeIds":[230240712]},{"nodeId":230240712,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":3962650106,"text":"How... How could this be!?","nextNodeIds":[230240713]},{"nodeId":230240713,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":2850363642,"text":"One of our roses, the most important of our herbs, turned into a monster and ran away!","nextNodeIds":[230240714,230240715]},{"nodeId":230240714,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":899601570,"text":"It didn't \"turn into\" a monster...","nextNodeIds":[230240716]},{"nodeId":230240716,"roleType":"TALK_ROLE_NPC","speakerId":4079,"speakerName":"Vardan","textMapHash":1961587762,"text":"You mean that the Whopperflower was responsible for the rose's slow growth?","nextNodeIds":[230240717]},{"nodeId":230240717,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":1749480906,"text":"Is that so? Then the fertilizer used on it was a waste. And it consumed double the amount of water.","nextNodeIds":[230240718]},{"nodeId":230240718,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":2889005634,"text":"Have we just been taking care of this Whopperflower all this time!?","nextNodeIds":[230240719]},{"nodeId":230240719,"roleType":"TALK_ROLE_NPC","speakerId":4079,"speakerName":"Vardan","textMapHash":3482223394,"text":"Darn! How did it even disguise itself amongst the flowers? We never even noticed it!","nextNodeIds":[230240720]},{"nodeId":230240720,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":881752994,"text":"Well, everyone gets played sometimes.","nextNodeIds":[230240721]},{"nodeId":230240721,"roleType":"TALK_ROLE_NPC","speakerId":4079,"speakerName":"Vardan","textMapHash":1080545506,"text":"We're in serious trouble now. Our field is totally destroyed as well...","nextNodeIds":[230240722]},{"nodeId":230240722,"roleType":"TALK_ROLE_NPC","speakerId":4080,"speakerName":"Gurgen","textMapHash":3975078570,"text":"We'll have to explain this to Bimarstan and plant new roses...","nextNodeIds":[]},{"nodeId":230240715,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1235218090,"text":"It was likely there from the beginning...","nextNodeIds":[230240716]},{"nodeId":230240710,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":413803138,"text":"Get behind me!","nextNodeIds":[230240711]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2302407,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133302120"],"PAINLIBBLDK":"QUEST_EXEC_REGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133302120","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["3","133302114,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["42300"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4079"]