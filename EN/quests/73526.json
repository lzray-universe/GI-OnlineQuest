{"mainQuestId":73526,"title":"The Phantom Toy Master and the Barking Fox","description":"While taking a stroll through Veluriyam Mirage, you and Paimon notice a weary merchant. Perhaps giving her a hand may earn you a rare reward...","titleTextMapHash":1390448423,"descTextMapHash":3220365142,"mainQuestExcel":{"mainQuestId":73526,"titleTextMapHash":1390448423,"title":"The Phantom Toy Master and the Barking Fox","descTextMapHash":3220365142,"description":"While taking a stroll through Veluriyam Mirage, you and Paimon notice a weary merchant. Perhaps giving her a hand may earn you a rare reward...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2023,"luaPath":"Actor/Quest/WQ73526","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2023,"chapterId":0,"descTextMapHash":3220365142,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73526,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2402577201,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73526","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173526],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1390448423,"type":"WQ","unlockDescTextMapHash":2092051846}},"flow":[{"subQuestId":7352601,"order":1,"stepDescription":"Talk to the strange merchant","stepDescTextMapHash":1034892812,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30405"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352601],"talks":[{"talkId":7352601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7352601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352601,"initDialog":735260101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30405],"performCfg":"QuestDialogue/WQ/Sumeru_73526/Q7352601","priority":5,"questId":73526,"showRandomTalkCount":0},"dialogs":[{"nodeId":735260101,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":1523649202,"text":"I should have hired someone to do this for me...","nextNodeIds":[735260102]},{"nodeId":735260102,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":2285733194,"text":"It's only the first test, but I have to cross mountains... This is torture!","nextNodeIds":[735260103]},{"nodeId":735260103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2982870562,"text":"Are you alright? You sound so weak...","nextNodeIds":[735260104]},{"nodeId":735260104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2461265114,"text":"#{NICKNAME}, she looks absolutely exhausted. Let's make her some food!","nextNodeIds":[735260105]},{"nodeId":735260105,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2512069538,"text":"You cook up some piping-hot Fried Radish Balls and Steak at the nearby stove to help the stranger regain her strength...","nextNodeIds":[735260106]},{"nodeId":735260106,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":2408164866,"text":"Hahahaha! I feel so ALIVE!","nextNodeIds":[735260107]},{"nodeId":735260107,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":2398764330,"text":"You've got skills. However, the low-quality ingredients and spices resulted in a rather dry texture.","nextNodeIds":[735260108]},{"nodeId":735260108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1669486314,"text":"How can you be so picky at a time like this!? A full stomach is all that matters!","nextNodeIds":[735260109]},{"nodeId":735260109,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":1648361586,"text":"On the contrary! The harder times get, the more you must crave the luxuries of life! It's how you stay motivated!","nextNodeIds":[735260110]},{"nodeId":735260110,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":717186410,"text":"The more your cash flow dries up, the bigger the loan you take out! It's the only way you can go all out and reverse your fortune!","nextNodeIds":[735260111]},{"nodeId":735260111,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":512251122,"text":"That is the trade secret of turning the tides that I, the Phantom Toy Master Madiha, am bestowing upon you in return for your aid.","nextNodeIds":[735260112]},{"nodeId":735260112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1639184802,"text":"Ph—Phantom Toy Master? That sounds pretty cool! But looking like that, it doesn't seem right...","nextNodeIds":[735260113,735260114]},{"nodeId":735260113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2107862002,"text":"Your toy isn't finished yet, huh?","nextNodeIds":[735260115]},{"nodeId":735260115,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":2574796722,"text":"Hey! H—How did you know!?","nextNodeIds":[735260116]},{"nodeId":735260116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2115495882,"text":"Let's see... you nearly died of hunger, you were so confused that you were talking to yourself, something about a test and hiring someone...","nextNodeIds":[735260117]},{"nodeId":735260117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":808830570,"text":"So obviously, you haven't finished your signature toy, right? It must be going really bad if you can't even remember to eat!","nextNodeIds":[735260118]},{"nodeId":735260118,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":2157922218,"text":"H—How could you say that! I won't be spoken of like that! My Barking Fox is in the final stage before production!","nextNodeIds":[735260119]},{"nodeId":735260119,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":1462824962,"text":"Once I figure out the flight envelope of the Barking Fox, I'll be able to write a manual that even Fungi can understand! Then with another loan for mass-production, I'll be able to turn a huge profit!","nextNodeIds":[735260120]},{"nodeId":735260120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2247542170,"text":"Flight envelope? What manual? Explain without the technical jargon so Paimon can understand!","nextNodeIds":[735260121]},{"nodeId":735260121,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":4043899778,"text":"It's easier to just show you!","nextNodeIds":[735260122]},{"nodeId":735260122,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":957231418,"text":"Madiha pulls out a blue package from her bag and quickly inflates it.\\nA moment later, a strange-looking toy appears and floats steadily in midair.","nextNodeIds":[735260123]},{"nodeId":735260123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":785437650,"text":"Is that your signature toy? It doesn't even look like a fox! You should just call it something like... Limited Edition Big-Eared Sunsettia Bomb: Blue Star!","nextNodeIds":[735260124]},{"nodeId":735260124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":468371546,"text":"And why is it called \"Barking\"? It doesn't even look like it's barking with laughter!","nextNodeIds":[735260125]},{"nodeId":735260125,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":3752451066,"text":"No, no, no! It's because its jet sounds like someone barking with laughter! Have a listen if you don't believe me!","nextNodeIds":[735260126]},{"nodeId":735260126,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":1694686026,"text":"(It emits an indescribably low howling sound. It would be stretching the bounds of the truth to even consider comparing it to \"barking.\")","nextNodeIds":[735260127]},{"nodeId":735260127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3898576450,"text":"#Where did she even hear that laughter from...? {NICKNAME}, Paimon thinks she may be barking mad...","nextNodeIds":[735260128]},{"nodeId":735260128,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":3563739514,"text":"Anyway, a small hot air balloon provides lift for the Barking Fox while the hidden jet provides propulsion, so it has excellent maneuverability.","nextNodeIds":[735260129]},{"nodeId":735260129,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":3834181954,"text":"Just imagine a toy that can fly nimbly! Forget kids, even adults wouldn't be able to resist its charms!","nextNodeIds":[735260130,735260131]},{"nodeId":735260130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":776285090,"text":"That does sound quite novel.","nextNodeIds":[735260132]},{"nodeId":735260132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1167402970,"text":"Paimon smells something familiar...","nextNodeIds":[735260133]},{"nodeId":735260133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":981858138,"text":"Let Paimon guess! Madiha is going to say: Please help me complete the final tests, and I'll reward you.","nextNodeIds":[735260134]},{"nodeId":735260134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1090172490,"text":"#But Paimon and {NICKNAME} will have to think about it. We're busy, and you'll have to make it worth our while...","nextNodeIds":[735260135]},{"nodeId":735260135,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":2431419714,"text":"No! Of course a small reward won't be enough! Let me do the math...","nextNodeIds":[735260136]},{"nodeId":735260136,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":1545769810,"text":"60%... No! 70% of the total Barking Fox profits for the next year! What do you think?","nextNodeIds":[735260137]},{"nodeId":735260137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3343650074,"text":"70%! Isn't that a bit too much...?","nextNodeIds":[735260138]},{"nodeId":735260138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2267608546,"text":"Ahem... Paimon means to say that you're speaking Paimon's language, Phantom Toy Master!","nextNodeIds":[735260139,735260140]},{"nodeId":735260139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1315444498,"text":"Can it even be mass-produced within a year?","nextNodeIds":[735260141]},{"nodeId":735260141,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":1386103402,"text":"Now you've grasped the crux of the matter! The faster you complete testing, the sooner the Barking Fox can enter production and begin sales, and the more you'll make!","nextNodeIds":[735260142]},{"nodeId":735260142,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":1975787466,"text":"We must work together to perfect it quickly! It's a win-win situation!","nextNodeIds":[735260143]},{"nodeId":735260143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2850706842,"text":"Oh, this is starting to make sense now...","nextNodeIds":[735260144]},{"nodeId":735260144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1934077234,"text":"#Hehe, {NICKNAME}, if we do this, we'll be involved in the toy industry and can be called merchants, right?","nextNodeIds":[735260145]},{"nodeId":735260145,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":626932386,"text":"Time is money! Let's get to it. I sought help from a few adventurers in the past and set up a few flight envelope test challenges based on their experiences. Let me show you where they are...","nextNodeIds":[735260146]},{"nodeId":735260146,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"Madiha","textMapHash":55371474,"text":"The Barking Fox's future and the Phantom Toy Master's brand are in your hands!","nextNodeIds":[]},{"nodeId":735260140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1748656314,"text":"And even mass-production may not turn a profit...","nextNodeIds":[735260141]},{"nodeId":735260131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":779105362,"text":"It may sell well.","nextNodeIds":[735260132]},{"nodeId":735260114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":887462666,"text":"Maybe you're broke?","nextNodeIds":[735260115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30405"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7352601],"sp