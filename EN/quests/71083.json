am":["7109702","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7104520","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7108302,"initDialog":710830201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2061],"performCfg":"","priority":5,"questId":71083,"showRandomTalkCount":0},"dialogs":[{"nodeId":710830201,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1952524314,"text":"How is everything down there? Did you encounter any danger?","nextNodeIds":[710830202,710830210]},{"nodeId":710830202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1284338354,"text":"(You describe your experiences to Muning.)","nextNodeIds":[710830203]},{"nodeId":710830203,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":4064088194,"text":"Ah, I see. That does sound rather dangerous. I'm afraid I'll have to ask you to help take care of Jinwu and Zhiqiong, then.","nextNodeIds":[710830204]},{"nodeId":710830204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2310202714,"text":"Aren't you supposed to stop me?","nextNodeIds":[710830205]},{"nodeId":710830205,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":258813162,"text":"Well, that is my duty, yes. But you always run off too quickly for me to stop you, so I can't.","nextNodeIds":[710830206]},{"nodeId":710830206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1960806602,"text":"I don't run that fast.","nextNodeIds":[710830207]},{"nodeId":710830207,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":523327250,"text":"No, you do. That's what the report says, and what the report says is the truth.","nextNodeIds":[710830208]},{"nodeId":710830208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4106510042,"text":"Alright, guess I'm really, really fast, then.","nextNodeIds":[710830209]},{"nodeId":710830209,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1613673530,"text":"Exactly. As such, please do be careful.","nextNodeIds":[]},{"nodeId":710830210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1188605082,"text":"All goes well, don't you fret.","nextNodeIds":[710830211]},{"nodeId":710830211,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3479262786,"text":"That's good, that's good. As long as things go well, the Qixing will have no reason to come down too hard on me...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104520,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7108301,7108302],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKC