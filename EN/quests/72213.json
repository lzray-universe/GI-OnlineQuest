[3189,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72213/Q7221301","priority":5,"questId":72213,"showRandomTalkCount":0},"dialogs":[{"nodeId":722130101,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1387402298,"text":"\"Celery\"...","nextNodeIds":[722130102]},{"nodeId":722130102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2151471354,"text":"How's the statue?","nextNodeIds":[722130103]},{"nodeId":722130103,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":709053490,"text":"That stone human is most skilled, meow meow meow.","nextNodeIds":[722130104]},{"nodeId":722130104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2079101202,"text":"Is it done?","nextNodeIds":[722130105]},{"nodeId":722130105,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2387438114,"text":"No, but before I knew it, he had brought a big, big stone over.","nextNodeIds":[722130106]},{"nodeId":722130106,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":160888154,"text":"He then started to knock on it, donk-donk-donk, all while muttering things about \"employer\" and \"salary.\"","nextNodeIds":[722130107]},{"nodeId":722130107,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":126309914,"text":"Speaking of which, I would like to ask: what is an \"envoyer,\" and what is \"celery\"?","nextNodeIds":[722130108]},{"nodeId":722130108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2161338610,"text":"I think you mean \"employer\" and \"salary.\"","nextNodeIds":[722130109]},{"nodeId":722130109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1030422298,"text":"Basically, since you asked him to do something, he should be given something in return.","nextNodeIds":[722130110]},{"nodeId":722130110,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1054265578,"text":"Ah, is that the case? So humans are particular about such things... Alright. I shall permit him to scratch my ears.","nextNodeIds":[722130111]},{"nodeId":722130111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1581077738,"text":"Uh, Paimon doesn't think that's enough...","nextNodeIds":[722130112]},{"nodeId":722130112,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2123614122,"text":"Is it not? Hmm, then perhaps I should give him something to eat.","nextNodeIds":[722130113]},{"nodeId":722130113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1531494938,"text":"I think what he wants is Mora...","nextNodeIds":[722130114]},{"nodeId":722130114,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":96598754,"text":"Mora? Are these things not for shoving inside the Offering Box? How strange. To think that humans were concerned about such things.","nextNodeIds":[722130115]},{"nodeId":722130115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4906394,"text":"Well, a salary is very important, actually.","nextNodeIds":[722130116]},{"nodeId":722130116,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2796841482,"text":"Mmph. I will trust your words on account of the aid you've provided so far. I will speak to the stone human when we return.","nextNodeIds":[722130117]},{"nodeId":722130117,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1250743274,"text":"However, the stone human is no longer going donk-donk-donk. He seems to be carrying a short wooden pole, who knows what for...","nextNodeIds":[722130118]},{"nodeId":722130118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3110255706,"text":"A wooden pole? Isn't statue-carving done with a hammer, a chisel, and stuff like that?","nextNodeIds":[722130119]},{"nodeId":722130119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2769961122,"text":"Did his tools break or something...","nextNodeIds":[722130120]},{"nodeId":722130120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3344251346,"text":"#Oh brother. Come on then, {NICKNAME}, let's go find Mr. Ooshima. Sounds like he needs some help!","nextNodeIds":[]}]},{"talkId":7221302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7221301","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7221302,"initDialog":722130201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3189],"performCfg":"","priority":1,"questId":72213,"showRandomTalkCount":0},"dialogs":[{"nodeId":722130201,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3108666130,"text":"A \"celery\" is important to humans. I will remember that.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7221302,"order":2,"stepDescription":"Ask Ooshima Junpei some questions","stepDescTextMapHash":2897007652,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3182"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7221303],"talks":[{"talkId":7221303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7221302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7221303,"initDialog":722130301,"nextRandomTalks":[],"nextTalks":[],"npcId":[3182],"performCfg":"","priority":5,"questId":72213,"showRandomTalkCount":0},"dialogs":[{"nodeId":722130301,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":937691562,"text":"*sigh* How am I supposed to work without a hammer or chisel...","nextNodeIds":[722130302]},{"nodeId":722130302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3387863722,"text":"Encountering some trouble?","nextNodeIds":[722130303]},{"nodeId":722130303,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1578345346,"text":"Oh, it's you. Well... I was careless. I didn't check my tools properly when we came here, so just as I was getting engrossed in my work, I broke my hammer and chisel by mistake...","nextNodeIds":[722130304]},{"nodeId":722130304,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":2152089162,"text":"I'd like to return to Narukami Island to buy some more, but...","nextNodeIds":[722130305]},{"nodeId":722130305,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1734852330,"text":"How do I put this... I guess I'm just more used to finishing work like this in one go, you know?","nextNodeIds":[722130306]},{"nodeId":722130306,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3435332890,"text":"My tools might be broken, but I can still do some measurements and figure out how I want to continue carving.","nextNodeIds":[722130307]},{"nodeId":722130307,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3717345074,"text":"If I left now and went to Narukami Island to get some tools, I'd probably have to re-acquaint myself with the \"feel\" of this carving...","nextNodeIds":[722130308]},{"nodeId":722130308,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":776598570,"text":"Also, this stone's composition is very hard. If we were to use ordinary tools, they would break pretty quickly.","nextNodeIds":[722130309]},{"nodeId":722130309,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3899660386,"text":"Hmm, you know what...","nextNodeIds":[722130310]},{"nodeId":722130310,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":2765032962,"text":"Traveler, could you help me find 3 Iron Chunks?","nextNodeIds":[722130311]},{"nodeId":722130311,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3282368618,"text":"I plan on making some tools personally, ones suited to the task.","nextNodeIds":[722130312,722130314]},{"nodeId":722130312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3920886994,"text":"Leave it to me.","nextNodeIds":[722130313]},{"nodeId":722130313,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":212361466,"text":"Great! It's up to you, then.","nextNodeIds":[]},{"nodeId":722130314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":749978482,"text":"You're going to forge them yourself?","nextNodeIds":[722130315]},{"nodeId":722130315,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3263561274,"text":"Come on, I'm someone who worked at Tatarasuna. Of course I know a thing or three about forging.","nextNodeIds":[722130316]},{"nodeId":722130316,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":353709106,"text":"However, I probably shouldn't start any sort of furnace at the shrine. I imagine that the Lady Priestess would be displeased. It is a cat, after all.","nextNodeIds":[722130317]},{"nodeId":722130317,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1128821306,"text":"Either way, please help me find 3 Iron Chunks.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3182"],"NOC