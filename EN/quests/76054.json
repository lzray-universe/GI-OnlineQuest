EST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360300005:2138.599,108.775,11208.970,0.000,189.288,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7605401],"talks":[{"talkId":7605401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7605401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7605401,"initDialog":760540101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76049/Q7605401","priority":5,"questId":76054,"showRandomTalkCount":0},"dialogs":[{"nodeId":760540101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3312578562,"text":"Huh, where's Columbina? Paimon doesn't see her anywhere...","nextNodeIds":[760540102]},{"nodeId":760540102,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3171190322,"text":"Over here.","nextNodeIds":[760540103]},{"nodeId":760540103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":903618954,"text":"Whoa! What are you doing all the way up there?","nextNodeIds":[760540104]},{"nodeId":760540104,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1592654762,"text":"Come join me.","nextNodeIds":[760540105]},{"nodeId":760540105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2654832586,"text":"What are we getting ourselves into this time...","nextNodeIds":[760540106]},{"nodeId":760540106,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1754064090,"text":"Do you remember those stones we went out to gather last time?","nextNodeIds":[760540107]},{"nodeId":760540107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2589047626,"text":"Last time? Oh, you mean the ore that glows after absorbing kuuvahki?","nextNodeIds":[760540108]},{"nodeId":760540108,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3154746218,"text":"Correct. Well, after that, the kuuhenki gathered some more, and I sorted them into two types — darker ones and lighter ones.","nextNodeIds":[760540109]},{"nodeId":760540109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1372609890,"text":"Darker ones and lighter ones? But... Why?","nextNodeIds":[760540110]},{"nodeId":760540110,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3584991754,"text":"To play Moon Chess, of course.","nextNodeIds":[760540111]},{"nodeId":760540111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":461293610,"text":"Uh... What's \"Moon Chess\"?","nextNodeIds":[760540112]},{"nodeId":760540112,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3591121746,"text":"Oh, you've never played?","nextNodeIds":[760540113]},{"nodeId":760540113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3561623858,"text":"...Nope.","nextNodeIds":[760540114]},{"nodeId":760540114,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2231008290,"text":"I see... Ever since seeing the grids the children of the Frostmoon Scions draw on the ground, I've always wanted to try it out. But I've never had anyone to play it with.","nextNodeIds":[760540115]},{"nodeId":760540115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1139518314,"text":"Well, what are the rules?","nextNodeIds":[760540116]},{"nodeId":760540116,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":498567810,"text":"Hm... It'll be easier if I just show you...","nextNodeIds":[760540117]},{"nodeId":760540117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4130262914,"text":"Whoa! Th—That's amazing! How did you do that?","nextNodeIds":[760540118]},{"nodeId":760540118,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3596165978,"text":"Hm? With a little kuuvahki, of course... You can't do that?","nextNodeIds":[760540119]},{"nodeId":760540119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3537550026,"text":"Hahaha... Maybe you should lower your expectations. We're not all moon goddesses...","nextNodeIds":[760540120]},{"nodeId":760540120,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3358866674,"text":"As you wish. Now, this is the board — it represents the \"night sky.\" And the pieces each player controls represent the \"moons.\"","nextNodeIds":[760540121]},{"nodeId":760540121,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2327332914,"text":"The two players take turns placing their moons in the sky, and the first to get three moons in a row wins.","nextNodeIds":[760540122]},{"nodeId":760540122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2285564258,"text":"Ohhh! So it's basically a version of tic-tac-toe...","nextNodeIds":[760540123]},{"nodeId":760540123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2377926658,"text":"So, it's called \"Moon Chess\" here in Nod-Krai, huh... Talk about giving it a local touch...","nextNodeIds":[760540124]},{"nodeId":760540124,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":640269482,"text":"I see. Well, in this version, the moons rotate, meaning there can never be more than three moons in the sky at once.","nextNodeIds":[760540125]},{"nodeId":760540125,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2606660426,"text":"So, when the night sky is full, the moon that rose earliest will vanish.","nextNodeIds":[760540126]},{"nodeId":760540126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2141145346,"text":"That... actually makes a lot of sense... and it makes the game a lot harder too!","nextNodeIds":[760540127]},{"nodeId":760540127,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":275500842,"text":"So, would you like to give it a try? It'll be my first time playing too.","nextNodeIds":[760540128]},{"nodeId":760540128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":835362506,"text":"(Looks like she's really looking forward to this...)","nextNodeIds":[760540129]},{"nodeId":760540129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3622357154,"text":"#Hehe, sounds fun! Paimon will be the referee! {NICKNAME}'s a clever one, though, so watch out!","nextNodeIds":[760540130]},{"nodeId":760540130,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3958344986,"text":"Alright then.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7605401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360300005:2138.599,108.775,11208.970,0.000,189.288,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7605403,"order":3,"stepDescription":"Play Moon Chess with The Damselette","stepDescTextMapHash":2586114004,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7605403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUI