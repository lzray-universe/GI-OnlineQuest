ons...","nextNodeIds":[]}]},{"talkId":7605403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7605403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7605403,"initDialog":760540301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76054/Q7605403","priority":5,"questId":76054,"showRandomTalkCount":0},"dialogs":[{"nodeId":760540301,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3079223170,"text":"Perhaps... Like this?","nextNodeIds":[760540302]},{"nodeId":760540302,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1442356458,"text":"Hmm, let me think...","nextNodeIds":[760540303]},{"nodeId":760540303,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3165678466,"text":"Oh...","nextNodeIds":[760540304]},{"nodeId":760540304,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2495145410,"text":"Moons... Moons...","nextNodeIds":[760540305]},{"nodeId":760540305,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1823660322,"text":"How about here?","nextNodeIds":[760540306]},{"nodeId":760540306,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2122320666,"text":"Looks like I won this round.","nextNodeIds":[760540307]},{"nodeId":760540307,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":758871898,"text":"My three moons are connected.","nextNodeIds":[760540308]},{"nodeId":760540308,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1695856658,"text":"Mm, this should win it.","nextNodeIds":[760540309]},{"nodeId":760540309,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3684794546,"text":"Mm... The moons wax and wane in an endless cycle...","nextNodeIds":[760540310]},{"nodeId":760540310,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1979952002,"text":"It seems both sets of moons refuse to be eclipsed.","nextNodeIds":[760540311]},{"nodeId":760540311,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2578700082,"text":"Are we... heading for a tie?","nextNodeIds":[760540312]},{"nodeId":760540312,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":977090114,"text":"Ah, you weigh your decisions carefully before making them, I see. Take your time — we have plenty of that, after all.","nextNodeIds":[760540313]},{"nodeId":760540313,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1877855882,"text":"Did you forget how to place your moons in the night sky? Shall I help you?","nextNodeIds":[760540314]},{"nodeId":760540314,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4214694458,"text":"You don't like this game? Hm... I find it quite amusing myself.","nextNodeIds":[760540315]},{"nodeId":760540315,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3533271682,"text":"Mm? Are you staring at me? Your gaze is not subtle.","nextNodeIds":[760540316]},{"nodeId":760540316,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":711050466,"text":"You're staring... Is the truth of the moons written on my face?","nextNodeIds":[760540317]},{"nodeId":760540317,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":984229522,"text":"The board's over there, by the way...","nextNodeIds":[760540318]},{"nodeId":760540318,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2451451226,"text":"Hm, your moons are aligned.","nextNodeIds":[760540319]},{"nodeId":760540319,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2469296050,"text":"The night sky is yours.","nextNodeIds":[760540320]},{"nodeId":760540320,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1333058314,"text":"Ah... I must have... slipped up somewhere.","nextNodeIds":[760540321]},{"nodeId":760540321,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":391591778,"text":"You have a wonderful time playing the game with Columbina...","nextNodeIds":[760540322]},{"nodeId":760540322,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":497960970,"text":"Thank you, I enjoyed that a lot.","nextNodeIds":[760540323]},{"nodeId":760540323,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":915363362,"text":"If you'd like... feel free to come keep me company again, sometime.","nextNodeIds":[760540324]},{"nodeId":760540324,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3377446674,"text":"Here, take this as a token of our promise.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7605403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":[],"PAINLIBBLDK":"QUEST_EXEC_ACTIVE_DAMSELETTE_FREE_MOON_PHASE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7605401,7605402,7605403],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","count":39},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":659775454,"CHECNJEMEFE":{"1318":[8010]},"CJPLOBIFHLG":"MAINQUEST_TAG_FLOWERLAND","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"UI