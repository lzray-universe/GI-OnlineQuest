{"mainQuestId":75658,"title":"Why Did a Member of a \"Secret Organization\" Come Here?","description":"You've received a mysterious commission from an \"organization whose details may not be disclosed\" at the Adventurers' Guild. Specifically, you are to assist the client in completing data collection work on a series of giant monsters, including the Secret Source Automaton: Configuration Device, Legatus Golem, Hydro Tulpa, and Emperor of Fire and Iron. It seems that this might just be a toughie...","titleTextMapHash":3468481439,"descTextMapHash":3965045790,"mainQuestExcel":{"mainQuestId":75658,"titleTextMapHash":3468481439,"title":"Why Did a Member of a \"Secret Organization\" Come Here?","descTextMapHash":3965045790,"description":"You've received a mysterious commission from an \"organization whose details may not be disclosed\" at the Adventurers' Guild. Specifically, you are to assist the client in completing data collection work on a series of giant monsters, including the Secret Source Automaton: Configuration Device, Legatus Golem, Hydro Tulpa, and Emperor of Fire and Iron. It seems that this might just be a toughie...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5245,"luaPath":"Actor/Quest/WQ75658","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5245,"chapterId":0,"descTextMapHash":3965045790,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75658,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":400513297,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75658","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175658],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3468481439,"type":"WQ","unlockDescTextMapHash":2091262262}},"flow":[{"subQuestId":7565801,"order":1,"stepDescription":"Talk to the client","stepDescTextMapHash":1466283188,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7565801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30718"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7565801],"talks":[{"talkId":7565801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7565801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7565801,"initDialog":756580101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30718],"performCfg":"QuestDialogue/WQ/EffigyChallengeV6_75507/Q7565801","priority":5,"questId":75658,"showRandomTalkCount":0},"dialogs":[{"nodeId":756580101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3032650970,"text":"Huh? Didn't the Guild say that this was a super-tough quest commissioned by an \"organization whose details may not be disclosed\"? Why's the client a little kid?","nextNodeIds":[756580102]},{"nodeId":756580102,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":385352466,"text":"#{NICKNAME} and Paimon, I presume? Nice to meet you both. I'm your client, Helka. I trust you've been informed about the details of this commission?","nextNodeIds":[756580103]},{"nodeId":756580103,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3365896218,"text":"In short, I need help gathering information on giant monsters, including combat-related performance data. I look forward to working with you two.","nextNodeIds":[756580104]},{"nodeId":756580104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2950880442,"text":"Sure! Leave it to us... Hang on a sec, we haven't been introduced — how do you know who we are?","nextNodeIds":[756580105]},{"nodeId":756580105,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":370166626,"text":"Considering the difficulty of this commission, the Adventurers' Guild was likely to pass this task on to seasoned adventurers with commensurate experience.","nextNodeIds":[756580106]},{"nodeId":756580106,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":2592651162,"text":"And considering that duos consisting of a \"golden-haired traveler and little white guide\" are rare amongst these more famous candidates...","nextNodeIds":[756580107]},{"nodeId":756580107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1315278226,"text":"Ohh, so that's it. You might look like a kid, but you sure know a lot. You even talk kinda like an old...","nextNodeIds":[756580108]},{"nodeId":756580108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2981893874,"text":"*cough* A more composed sort of kid.","nextNodeIds":[756580109]},{"nodeId":756580109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1754207330,"text":"Ah, yeah, that! Anyway, are you really our client? Also, this \"organization whose details may not be disclosed\" thing is kinda...","nextNodeIds":[756580110]},{"nodeId":756580110,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":2806031050,"text":"I was indeed the one who issued that commission, and as for the \"organization\"... Well, Katya taught me to say that.","nextNodeIds":[756580111]},{"nodeId":756580111,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3159162866,"text":"Though I'm reluctant to admit this, an institution with murky origins is more likely to be taken seriously by the Guild than some child with no background to speak of.","nextNodeIds":[756580112]},{"nodeId":756580112,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3801352018,"text":"But the organization's existence, at least, is no lie. I am a part of it.","nextNodeIds":[756580113]},{"nodeId":756580113,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3347061098,"text":"I just told them what I thought they should know. As for what information they got from parsing my words... That's up to their imagination.","nextNodeIds":[756580114,756580116]},{"nodeId":756580114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":592512626,"text":"Is this the sort of organization that occasionally throws parties?","nextNodeIds":[756580115]},{"nodeId":756580115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2854598530,"text":"Huh, so it's the kind of \"secret organization\" that has get-togethers with food... Wait, isn't that just a normal friends' club!?","nextNodeIds":[756580117]},{"nodeId":756580117,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":4153789122,"text":"That's right. I made an agreement with Maisie before I left that I wouldn't lie or cheat others, or do anything dangerous. I succeeded in both.","nextNodeIds":[756580118]},{"nodeId":756580118,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":2747222226,"text":"Even when telling the truth, one can phrase things in a manner more advantageous to oneself — and with strong enough backing, even dangerous spaces can be made safe.","nextNodeIds":[756580119]},{"nodeId":756580119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3752182906,"text":"Are... are you sure that's how it works?","nextNodeIds":[756580120]},{"nodeId":756580120,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":2057700986,"text":"Of course I am. If you're both ready, then, let us set off.","nextNodeIds":[]},{"nodeId":756580116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3877841818,"text":"Wow, so it's a \"secret club.\"","nextNodeIds":[756580117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7565801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30718"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7565801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[175658],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3965045790,"CHECNJEMEFE":{"30718":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/EffigyChallengeV6_75507/Q7565801","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":756580101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7565801,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30718],"KJLNGKKBBOI":"TA