"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4014502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4014501,"initDialog":401450101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1007],"performCfg":"QuestDialogue/EQ/V4.5AlchemySim_40145/Q4014501","priority":5,"questId":40145,"showRandomTalkCount":0},"dialogs":[{"nodeId":401450101,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":779888050,"text":"After a brief trial period, the potion shop opens to great success...","nextNodeIds":[401450102]},{"nodeId":401450102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1191057074,"text":"*sigh* We just keep getting swarmed with more and more customers. It's been nonstop work for so long, Paimon's starting to feel a bit lightheaded...","nextNodeIds":[401450103,401450104]},{"nodeId":401450103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":700498274,"text":"Business sure is booming...","nextNodeIds":[401450105]},{"nodeId":401450105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":613226866,"text":"We've got a lot of orders. Paimon's not sure we can fill them all on our own.","nextNodeIds":[401450106]},{"nodeId":401450106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3032222338,"text":"Maybe we should hire some help...","nextNodeIds":[401450107]},{"nodeId":401450107,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3288944162,"text":"Taking a break, cuties?","nextNodeIds":[401450108]},{"nodeId":401450108,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":523848106,"text":"I was just looking at the sales data, and it seems like you two have quite the talent for business. The potions seem to be flying off the shelves!","nextNodeIds":[401450109]},{"nodeId":401450109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3797887794,"text":"Oh, Lisa! Perfect timing! We were just talking about how we could use some help around the shop.","nextNodeIds":[401450110]},{"nodeId":401450110,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":783007426,"text":"Oh? Are the orders piling up already? Having trouble keeping up?","nextNodeIds":[401450111]},{"nodeId":401450111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2589773242,"text":"Yep, we're officially swamped! Paimon never thought we'd get this many customers...","nextNodeIds":[401450112]},{"nodeId":401450112,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2027016234,"text":"Well, I can't say I'm surprised by the success. I was actually anticipating this kind of response.","nextNodeIds":[401450113]},{"nodeId":401450113,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":994632554,"text":"While you two were busy with the shop, I was talking with Freda about some possible ways to make the business more efficient.","nextNodeIds":[401450114]},{"nodeId":401450114,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3933979330,"text":"After observing your work, I made note of several improvements we can make to the brewing, cultivation, and sales aspects of the business.","nextNodeIds":[401450115]},{"nodeId":401450115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1954584498,"text":"Wait, so you've been doing things behind the scenes this whole time!","nextNodeIds":[401450116]},{"nodeId":401450116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1919264842,"text":"Paimon kinda thought you were just slacking off...","nextNodeIds":[401450117]},{"nodeId":401450117,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":556463578,"text":"Hey now, I'm actually pretty reliable when it counts!","nextNodeIds":[401450118]},{"nodeId":401450118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3000196050,"text":"So how are we supposed to put those improvements in action?","nextNodeIds":[401450119]},{"nodeId":401450119,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3694362138,"text":"Well, I discussed things over with Freda, and the two of us came up with a plan.","nextNodeIds":[401450120]},{"nodeId":401450120,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":675611434,"text":"I'll let her give you the details, though. Why don't you go and find her?","nextNodeIds":[]},{"nodeId":401450104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1278979826,"text":"We've made quite the name for ourselves.","nextNodeIds":[401450105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4014501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133003077"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGD