{"mainQuestId":1023,"title":"Heart of Glaze","description":"At Ningguang's advice, you verified the Fatui's schemes regarding the Sigil of Permission before continuing to help Zhongli prepare for the rite. You met Ganyu once again at Dihua Marsh before returning to Liyue Harbor — only to find that things in the city seem to be spiraling out of control.","titleTextMapHash":186534449,"descTextMapHash":1116484007,"mainQuestExcel":{"mainQuestId":1023,"titleTextMapHash":186534449,"title":"Heart of Glaze","descTextMapHash":1116484007,"description":"At Ningguang's advice, you verified the Fatui's schemes regarding the Sigil of Permission before continuing to help Zhongli prepare for the rite. You met Ganyu once again at Dihua Marsh before returning to Liyue Harbor — only to find that things in the city seem to be spiraling out of control.","chapterId":1103,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/MQ1023","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":1103,"descTextMapHash":1116484007,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":1023,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2890727999,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/MQ1023","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":1006,"rewardIdList":[101023],"series":1101,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[1024],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":186534449,"type":"AQ","unlockDescTextMapHash":640208419}},"flow":[{"subQuestId":102301,"order":1,"stepDescription":"Go to the Golden House","stepDescTextMapHash":3151610934,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101,183],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":"3"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q102301Guild"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101,183],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":"3"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133107929,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q102301Guild"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":102303,"order":2,"stepDescription":"","stepDescTextMapHash":3596423782,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[102303],"talks":[{"talkId":102303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["102303","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":102303,"initDialog":10230301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"QuestDialogue/AQ/Liyue3_1023/Q102303","priority":5,"questId":1023,"showRandomTalkCount":0},"dialogs":[{"nodeId":10230301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3539357361,"text":"Wow... This is the <color=#00E1FFFF>Golden House</color>?","nextNodeIds":[10230302]},{"nodeId":10230302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1944476953,"text":"It looked impressive enough from the outside... But who would've guessed that it was even fancier on the inside... and so full of Mora!!!","nextNodeIds":[10230303]},{"nodeId":10230303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2602565305,"text":"This is where all of Teyvat's Mora is minted, right? In that case, maybe they won't notice if a few Mora go missing...","nextNodeIds":[10230304,10230305]},{"nodeId":10230304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3082101145,"text":"Touch a single Mora and we're done for!","nextNodeIds":[10230306]},{"nodeId":10230306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":770703953,"text":"Ooh, so it's a trap. Tricky, tricky... Good thing Paimon's got you here!","nextNodeIds":[10230307]},{"nodeId":10230307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1378274137,"text":"But even if we can't take any, we can still have a closer look, right?","nextNodeIds":[10230308]},{"nodeId":10230308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":685632225,"text":"Or better yet, take a nap on top of a mountain of Mora! It's like a dream come true!","nextNodeIds":[10230309,10230310]},{"nodeId":10230309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1245190457,"text":"We'd better check on the Exuvia first.","nextNodeIds":[10230311]},{"nodeId":10230311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1701333257,"text":"Oh, right! Back to business!","nextNodeIds":[10230312]},{"nodeId":10230312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2631510993,"text":"It's quiet... Too quiet. Surely someone's gotta be guarding something as important as the Exuvia.","nextNodeIds":[10230313]},{"nodeId":10230313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":403001577,"text":"#Huh!? {NICKNAME}, look! What happened here?","nextNodeIds":[10230314,10230315]},{"nodeId":10230314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3247491089,"text":"The Millelith...","nextNodeIds":[10230315]},{"nodeId":10230315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1144846161,"text":"They've been knocked unconscious!","nextNodeIds":[10230316]},{"nodeId":10230316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":590158793,"text":"Uh-oh, Paimon smells trouble!","nextNodeIds":[10230317]},{"nodeId":10230317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1421465961,"text":"Quick! We have to go make sure that the Exuvia is alright.","nextNodeIds":[]},{"nodeId":10230310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3152749601,"text":"Something feels amiss here.","nextNodeIds":[10230311]},{"nodeId":10230305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2477733665,"text":"If it were that easy, this place would have been emptied long ago.","nextNodeIds":[10230306]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":102302,"order":3,"stepDescription":"Examine the Exuvia","stepDescTextMapHash":4028223406,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["10261"],"NOCCOBOFKHP":20101,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[102302],"talks":[{"talkId":102302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["102302","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":102302,"initDialog":10230201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10261],"performCfg":"QuestDialogue/AQ/Liyue3_1023/Q102302","priority":5,"questId":1023,"showRandomTalkCount":0},"dialogs":[{"nodeId":10230201,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1126368409,"text":"You've already fulfilled your task as guides, so why do you still linger here? Haven't you already seen enough trouble for today?","nextNodeIds":[10230202]},{"nodeId":10230202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3518548553,"text":"Huh? Who's there?","nextNodeIds":[10230203]},{"nodeId":10230203,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3175763801,"text":"If you were Fatui, I imagine that you would be entitled to a generous reward from the Tsaritsa herself.","nextNodeIds":[10230204]},{"nodeId":10230204,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2367923585,"text":"But now, you're nothing but dross — and you're in my way.","nextNodeIds":[10230205,10230208]},{"nodeId":10230205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2341231433,"text":"How did you find out it was here?","nextNodeIds":[10230206]},{"nodeId":10230206,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1080516673,"text":"Hmm, where should I start? Well, I've never been one to beat around the bush, you know. But who could have possibly guessed that the God of Geo would mysteriously perish the very moment I arrived in Liyue, and that the Exuvia would subsequently be hidden away?","nextNodeIds":[10230207]},{"nodeId":10230207,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1416155313,"text":"If it weren't for that lovely little Rite of Parting ceremony you put together, it would have taken me a whole lot longer to get the information I needed.","nextNodeIds":[10230211]},{"nodeId":10230211,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3286765345,"text":"Stopping the Mora mints, hiding away the Exuvia... Hahaha, the Qixing are really pulling out all the stops this time...","nextNodeIds":[10230212]},{"nodeId":10230212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1068270841,"text":"So you've been planning to take the Gnosis from inside the Exuvia all along!?","nextNodeIds":[10230213]},{"nodeId":10230213,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3427791713,"text":"As one of the Eleven Fatui Harbingers, it's my duty to see the will of the Tsaritsa fulfilled.","nextNodeIds":[10230214]},{"nodeId":10230214,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1710211681,"text":"She will get that which she desires.","nextNodeIds":[10230215,10230216]},{"nodeId":10230215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1360019193,"text":"Not if I have anything to say about it.","nextNodeIds":[10230217]},{"nodeId":10230217,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":133344065,"text":"Hah! I'm not asking for your blessing, and there's nothing you can do to stop me anyway.","nextNodeIds":[10230218]},{"nodeId":10230218,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1020618945,"text":"The time for discussion and diplomacy has already passed. I mean, if it were up to me, I would have skipped that stage to begin with... but I'm willing to do as the Tsaritsa deems fit.","nextNodeIds":[10230219]},{"nodeId":10230219,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":741649953,"text":"Either way — we now come to my favorite part. A simple pleasure, and one that I am oh-so-delighted to be sharing with you...","nextNodeIds":[10230220]},{"nodeId":10230220,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2048942697,"text":"The battle.","nextNodeIds":[10230221]},{"nodeId":10230221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1815283761,"text":"Battle? So you're the type that goes looking for trouble, huh?","nextNodeIds":[10230222]},{"nodeId":10230222,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2677908417,"text":"Haha, you could say that.","nextNodeIds":[10230223]},{"nodeId":10230223,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3837132937,"text":"When Signora offended the deities outside the Cathedral in Mondstadt, she swiftly left the scene once her mission was accomplished.","nextNodeIds":[10230224]},{"nodeId":10230224,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":855873441,"text":"Instead of confronting you directly, she chose to rely on the snow and ice to make her escape. She wouldn't want the Knights to come running towards the sound of battle, now, would she?","nextNodeIds":[10230225]},{"nodeId":10230225,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3445119233,"text":"When she faces a worthy opponent, she will prioritize her mission, weigh the outcomes, and consider the consequences of her actions...","nextNodeIds":[10230226]},{"nodeId":10230226,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3299280401,"text":"But as for me, the greatest pleasure of being a Harbinger lies in crossing blades with strong opponents.","nextNodeIds":[10230227]},{"nodeId":10230227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":278245281,"text":"We won't let what happened in Mondstadt ever happen again!","nextNodeIds":[10230228]},{"nodeId":10230228,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2510736753,"text":"Oh? So you intend to fight me? Good. I won't kill you, Traveler. I'll just play along — to feel the thrill of battle!","nextNodeIds":[10230229]},{"nodeId":10230229,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3564233817,"text":"Besides, you could never defeat me. Not even in your wildest dreams. But hey, try to relish the fight anyway. Because if you ask me... without that, what else is there?","nextNodeIds":[10230230]},{"nodeId":10230230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2158060753,"text":"I could never defeat you!? You're completely delusional.","nextNodeIds":[10230231]},{"nodeId":10230231,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":4075140257,"text":"Ahahahaha!","nextNodeIds":[10230232]},{"nodeId":10230232,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":4015596265,"text":"Fighting talk, I love it! Now, let's see you live up to it.","nextNodeIds":[]},{"nodeId":10230216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":973866561,"text":"I won't allow you to get near the Exuvia.","nextNodeIds":[10230217]},{"nodeId":10230208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":244078537,"text":"Looks like I was just in time, then.","nextNodeIds":[10230209]},{"nodeId":10230209,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":221742697,"text":"Hah! Although I'm deeply grateful to you that I was able to effortlessly find this secret location...","nextNodeIds":[10230210]},{"nodeId":10230210,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1409161673,"text":"Don't you think that trying to stop me now would just be wasted effort?","nextNodeIds":[10230211]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["20101","220101001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["10261"],"NOCCOBOFKHP":20101,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":102304,"order":4,"stepDescription":"Duel Childe","stepDescTextMapHash":1499678406,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"10230401"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STY