"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["102305","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":102305,"initDialog":10230501,"nextRandomTalks":[],"nextTalks":[],"npcId":[10200],"performCfg":"QuestDialogue/AQ/Liyue3_1023/Q102305","priority":5,"questId":1023,"showRandomTalkCount":0},"dialogs":[{"nodeId":10230501,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":464355873,"text":"*panting*","nextNodeIds":[10230502]},{"nodeId":10230502,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2464413377,"text":"Look! Childe's back to normal again.","nextNodeIds":[10230546]},{"nodeId":10230546,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2823443129,"text":"Ugh, well then... time to cool off.","nextNodeIds":[10230503]},{"nodeId":10230503,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2109593041,"text":"It seems the burden of the Foul Legacy Transformation was too great for my body. I lacked the opportunity to think this through...","nextNodeIds":[10230504]},{"nodeId":10230504,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2846457585,"text":"And now that I consider the matter more carefully, you never had any chance of beating me to the Gnosis.","nextNodeIds":[10230505]},{"nodeId":10230505,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":551256553,"text":"You had no connection to the Gnosis, no matter where it had been taken.","nextNodeIds":[10230506]},{"nodeId":10230506,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4185250529,"text":"That's what we've been trying to tell you! We didn't take it!","nextNodeIds":[10230507]},{"nodeId":10230507,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":661004729,"text":"Your show of ability today far surpasses that of Signora's initial assessment of you in Mondstadt. Tell me, how could that be?","nextNodeIds":[10230508,10230509]},{"nodeId":10230508,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3055011025,"text":"(Because I'm collecting the powers of the seven elements...)","nextNodeIds":[10230510]},{"nodeId":10230510,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3461481729,"text":"You already know the answer, don't you? I can see it in your eyes.","nextNodeIds":[10230511]},{"nodeId":10230511,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1998003025,"text":"But if that is a secret you wish to keep, I guess I'll just have to curb my curiosity.","nextNodeIds":[10230512]},{"nodeId":10230512,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2044128097,"text":"This battle has already left me satisfied.","nextNodeIds":[10230513]},{"nodeId":10230513,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2543602065,"text":"Anyone who strives as I do to grow stronger shall be called a friend, even if our friendship can only be shown in battle against one another.","nextNodeIds":[10230514]},{"nodeId":10230514,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2252309241,"text":"Pretty sure that's not the normal way to make friends.","nextNodeIds":[10230515]},{"nodeId":10230515,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":811882025,"text":"Unfortunately, I must bring this amiable conversation to an end. My quest still beckons.","nextNodeIds":[10230516]},{"nodeId":10230516,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":308235873,"text":"Given that the Gnosis wasn't taken by anyone, then we must look once again to the beginning. Perhaps it was never in the Exuvia to begin with.","nextNodeIds":[10230517]},{"nodeId":10230517,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3257304041,"text":"In fact, it might be that the Exuvia was just a diversion of sorts.","nextNodeIds":[10230518]},{"nodeId":10230518,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3242884137,"text":"What? So you mean that...","nextNodeIds":[10230519,10230520]},{"nodeId":10230519,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3804478057,"text":"Rex Lapis still lives?","nextNodeIds":[10230521]},{"nodeId":10230521,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3337586273,"text":"Yes, it appears so. Interesting to say the least...","nextNodeIds":[10230522]},{"nodeId":10230522,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":2063023177,"text":"It seems that the guardian deity of the capital of commerce is also well-versed in little maneuvers beyond the boundaries of contracts.","nextNodeIds":[10230523]},{"nodeId":10230523,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1601229849,"text":"As such, we must now look to our backup plan.","nextNodeIds":[10230524]},{"nodeId":10230524,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3926430217,"text":"Backup plan?","nextNodeIds":[10230525]},{"nodeId":10230525,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3793482961,"text":"I had hoped it would never come to this, for the weak will be swept away in the process.","nextNodeIds":[10230526]},{"nodeId":10230526,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3870101585,"text":"The truth is, the world belongs to those who pursue strength. I seldom willingly involve myself with the weak.","nextNodeIds":[10230527]},{"nodeId":10230527,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1765476609,"text":"Unfortunately, we cannot be picky about our methods as Fatui Harbingers. Children must all learn to eat their vegetables sometime.","nextNodeIds":[10230528]},{"nodeId":10230528,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1486031305,"text":"So, what are you planning to do?","nextNodeIds":[10230529]},{"nodeId":10230529,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3187375241,"text":"I will awaken the god that lies dormant beneath Guyun Stone Forest.","nextNodeIds":[10230530]},{"nodeId":10230530,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2989710801,"text":"A god!?","nextNodeIds":[10230531]},{"nodeId":10230531,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1940737945,"text":"<color=#00E1FFFF>Osial, Overlord of the Vortex</color>, who was defeated by Morax the Geo Archon in the Archon War, and who has remained pinned beneath the waves by the Geo Archon's stone spears ever since.","nextNodeIds":[10230532]},{"nodeId":10230532,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":862146489,"text":"If such an ancient god were to be unleashed upon Liyue Harbor, defenseless without the protection of its deity...","nextNodeIds":[10230533]},{"nodeId":10230533,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":864227905,"text":"Do you think the cunning Rex Lapis would just stand aloof and watch the ensuing destruction?","nextNodeIds":[10230534]},{"nodeId":10230534,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2167662689,"text":"But... the Archon War ended two thousand years ago! How could an ancient god appear in a world now overseen by The Seven?","nextNodeIds":[10230535]},{"nodeId":10230535,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":219757945,"text":"Simple! I've already prepared the means to awaken it.","nextNodeIds":[10230536]},{"nodeId":10230536,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1218455177,"text":"Hey! Those are Sigils of Permission!","nextNodeIds":[10230537]},{"nodeId":10230537,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3199435721,"text":"Oh, Paimon remembers now! The Fatui have been researching them...","nextNodeIds":[10230538,10230539]},{"nodeId":10230538,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3162335049,"text":"I saw your research with my own eyes.","nextNodeIds":[10230540]},{"nodeId":10230540,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1787911265,"text":"Indeed. The one that was given to you was just a by-product of our research.","nextNodeIds":[10230541]},{"nodeId":10230541,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":1574916577,"text":"With the power of so many Sigils of Permission concentrated in one place, along with that which was bestowed upon me as a Harbinger by our Tsaritsa... Breaking the subduing might of the Geo Archon's spears for a time should be no obstacle.","nextNodeIds":[10230544]},{"nodeId":10230544,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":149013761,"text":"Using the powers of ancient gods in such a situation fails to interest me and is largely against my principles.","nextNodeIds":[10230545]},{"nodeId":10230545,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"Childe","textMapHash":3777725337,"text":"But knowing that such an action will not only force the Geo Archon to show its hand, but you as well... That makes matters a little more intriguing.","nextNodeIds":[]},{"nodeId":10230539,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2453732609,"text":"You've been trying to duplicate them.","nextNodeIds":[10230540]},{"nodeId":10230520,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2964746721,"text":"The corpse was fake?","nextNodeIds":[10230521]},{"nodeId":10230509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1543574353,"text":"(Because I'm gradually restoring my former power...)","nextNodeIds":[10230510]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["10009","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["3","183"],"PAINLIBBLDK":"QUEST_EXEC_LOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":102306,"order":6,"stepDescription":"","stepDescTextMapHash":2165747262,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PA