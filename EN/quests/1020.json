EBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[102007],"talks":[{"talkId":102007,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["102007","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":102007,"initDialog":10200701,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"QuestDialogue/AQ/Liyue3_1020/Q102007","priority":5,"questId":1020,"showRandomTalkCount":0},"dialogs":[{"nodeId":10200701,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4041115841,"text":"Huh? It only takes us up to here...","nextNodeIds":[10200702]},{"nodeId":10200702,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3462601937,"text":"Aw, if that wind current was stronger, we'd be able to reach the top in one go!","nextNodeIds":[10200703]},{"nodeId":10200703,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3606657945,"text":"Best we go back to Liyue and ask the Millelith...","nextNodeIds":[10200704]},{"nodeId":10200704,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4035001641,"text":"Huh? Why?","nextNodeIds":[10200705]},{"nodeId":10200705,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3068435185,"text":"The way up shouldn't be a secret, or...","nextNodeIds":[10200706]},{"nodeId":10200706,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3781339489,"text":"Or? ...Oh, Paimon gets it! If it was a secret, Ganyu wouldn't have let us try to find it ourselves, right?","nextNodeIds":[10200707]},{"nodeId":10200707,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3046391257,"text":"Alright, let's follow your plan, then we can...","nextNodeIds":[10200708]},{"nodeId":10200708,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1360038937,"text":"Oh! Hang on a moment. Look down there!","nextNodeIds":[10200709]},{"nodeId":10200709,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":830820809,"text":"Looks like we've gotten close to the <color=#00E1FFFF>Guizhong Ballista</color>.","nextNodeIds":[10200710]},{"nodeId":10200710,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1725771321,"text":"Hmm... Uh... Paimon has a new idea!","nextNodeIds":[10200711]},{"nodeId":10200711,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3691423337,"text":"Why don't we shoot you up to the Jade Chamber using the Ballista?","nextNodeIds":[10200712,10200714]},{"nodeId":10200712,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3686738177,"text":"No thanks. I don't have a death wish.","nextNodeIds":[10200713]},{"nodeId":10200713,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3076005969,"text":"Oh... Right. This method does seem a bit unsafe...","nextNodeIds":[10200716]},{"nodeId":10200716,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4001522041,"text":"Still, I do remember that the Ballista had a scope.","nextNodeIds":[10200717]},{"nodeId":10200717,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":193635721,"text":"Oh, that's right!","nextNodeIds":[10200718]},{"nodeId":10200718,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2131986193,"text":"Now that you mention it, we could use the Guizhong Ballista to see if there's another way up nearby!","nextNodeIds":[]},{"nodeId":10200714,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":992690233,"text":"Do you really hate me that much?","nextNodeIds":[10200715]},{"nodeId":10200715,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":241972345,"text":"Uhh... No. Paimon may have just forgotten to think about the safety measures...","nextNodeIds":[10200716]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102007,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":102004,"order":5,"stepDescription":"Head over to the Guizhong Ballista","stepDescTextMapHash":1164753134,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102004,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q101503Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[102004],"talks":[{"talkId":102004,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["102004","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":102004,"initDialog":10200401,"nextRandomTalks":[],"nextTalks":[],"npcId":[10262],"performCfg":"QuestDialogue/AQ/Liyue3_1020/Q102004","priority":5,"questId":1020,"showRandomTalkCount":0},"dialogs":[{"nodeId":10200401,"roleType":"TALK_ROLE_NPC","speakerId":10262,"speakerName":"Huaqing","textMapHash":3032848649,"text":"Halt!","nextNodeIds":[10200402]},{"nodeId":10200402,"roleType":"TALK_ROLE_NPC","speakerId":10262,"speakerName":"Huaqing","textMapHash":1093227177,"text":"Who trespasses on these hallowed grounds?","nextNodeIds":[10200403,10200404]},{"nodeId":10200403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2223154657,"text":"We're just passing through...","nextNodeIds":[10200405]},{"nodeId":10200405,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":208609585,"text":"Exactly. What're you talking about?","nextNodeIds":[10200406]},{"nodeId":10200406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":473455873,"text":"We're invited guests! What makes you think you can treat us like this?","nextNodeIds":[10200407]},{"nodeId":10200407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":861954001,"text":"No... Wait... Maybe this was Ningguang's plan all along!","nextNodeIds":[10200408]},{"nodeId":10200408,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":164583929,"text":"She pretended to invite us to the Jade Chamber, but set up a Millelith ambush here to arrest us!","nextNodeIds":[10200409,10200410]},{"nodeId":10200409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4020860801,"text":"I'm quite sure that's not the case.","nextNodeIds":[10200411]},{"nodeId":10200411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2816674585,"text":"Grr... Now Paimon's mad! ...You! Over there! This is a trick, isn't it? How shameless!","nextNodeIds":[10200412]},{"nodeId":10200412,"roleType":"TALK_ROLE_NPC","speakerId":10262,"speakerName":"Huaqing","textMapHash":3341677425,"text":"What? We're just on guard duty. What do you mean, \"shameless\"?","nextNodeIds":[10200413]},{"nodeId":10200413,"roleType":"TALK_ROLE_NPC","speakerId":10263,"speakerName":"Yang","textMapHash":1220039369,"text":"What nonsense! Seize these suspicious intruders at once!","nextNodeIds":[10200414]},{"nodeId":10200414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3190576913,"text":"Well, here they come — line 'em up and knock 'em down!","nextNodeIds":[]},{"nodeId":10200410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":899874553,"text":"We haven't explained the invitation to them yet...","nextNodeIds":[10200411]},{"nodeId":10200404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1740048089,"text":"Hallowed what now? These are the wilds around Mt. Tianheng...","nextNodeIds":[10200405]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102004,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q101503Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":102005,"order":6,"stepDescription":"Fight the Millelith","stepDescTextMapHash":1527703006,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"10200501"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q101503Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"10200501"}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102005,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_TEAM_DEAD","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["3","133107108,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q101503Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":102006,"order":7,"stepDescription":"","stepDescTextMapHash":692491190,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102006,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q101503Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[102006],"talks":[{"talkId":102006,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["102006","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":102006,"initDialog":10200601,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"QuestDialogue/AQ/Liyue3_1020/Q102006","priority":5,"questId":1020,"showRandomTalkCount":0},"dialogs":[{"nodeId":10200601,"roleType":"TALK_ROLE_NPC","speakerId":10262,"speakerName":"Huaqing","textMapHash":2627183361,"text":"Stop! What's all this about?","nextNodeIds":[10200602]},{"nodeId":10200602,"roleType":"TALK_ROLE_NPC","speakerId":10262,"speakerName":"Huaqing","textMapHash":928066785,"text":"Lady Keqing, these two strange people suddenly appeared. They seem to have designs on the Guizhong Ballista.","nextNodeIds":[10200603]},{"nodeId":10200603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":218880857,"text":"Who're you calling \"strange\"?","nextNodeIds":[10200604]},{"nodeId":10200604,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":549286017,"text":"We were just looking for the way to the Jade Chamber.","nextNodeIds":[10200605]},{"nodeId":10200605,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":4169835113,"text":"Hmm? You want to go to the Jade Chamber? Who are you?","nextNodeIds":[10200606]},{"nodeId":10200606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":488024409,"text":"We're invited guests, here to look for the Liyue Qixing! Who are you?","nextNodeIds":[10200607]},{"nodeId":10200607,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":4132863361,"text":"...","nextNodeIds":[10200608]},{"nodeId":10200608,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1304435617,"text":"Well, as it happens, I am one of the Liyue Qixing.","nextNodeIds":[10200609]},{"nodeId":10200609,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1202570241,"text":"???","nextNodeIds":[10200610]},{"nodeId":10200610,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":4040326313,"text":"I'm Keqing, the Yuheng of the Qixing.","nextNodeIds":[10200611]},{"nodeId":10200611,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1163892873,"text":"I know of you, Traveler. You're Ningguang's guests, yes? Didn't expect to meet you here in the mountains.","nextNodeIds":[10200612]},{"nodeId":10200612,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2219944633,"text":"Wow... Paimon didn't think we'd meet some super-rich big shot out here in the middle of nowhere, either.","nextNodeIds":[10200613]},{"nodeId":10200613,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":805289945,"text":"The Guizhong Ballista in Tianheng Pass has long been in disrepair, and yet it was fixed in a single night. I came here to investigate that occurrence.","nextNodeIds":[10200614]},{"nodeId":10200614,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1050869065,"text":"These Millelith are just here to guard the scene, not to arrest anyone.","nextNodeIds":[10200615]},{"nodeId":10200615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1072903457,"text":"So, this was all a misunderstanding? Paimon never would've thought...","nextNodeIds":[10200616]},{"nodeId":10200616,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":666569745,"text":"Thinking isn't that hard, Paimon.","nextNodeIds":[10200617]},{"nodeId":10200617,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":353050249,"text":"Anyway, for a mortal to be able to repair an adepti mechanism is quite the mystery, even to the Qixing.","nextNodeIds":[10200618]},{"nodeId":10200618,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1651313137,"text":"Hehe, that was...","nextNodeIds":[10200619,10200620]},{"nodeId":10200619,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":469421001,"text":"(Shh, Paimon, don't complicate the matter!)","nextNodeIds":[10200621]},{"nodeId":10200621,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":772371649,"text":"Eh? Oh, right. So, Lady Yuheng, might you have any idea why Lady Tianquan invited us to go to the Jade Chamber?","nextNodeIds":[10200622]},{"nodeId":10200622,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2574846713,"text":"Just call me Keqing.","nextNodeIds":[10200623]},{"nodeId":10200623,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1018944185,"text":"I'd say that Ningguang's purpose is to request that the savior of Mondstadt take a more neutral stance... Or at least, to not wholly side with the adepti.","nextNodeIds":[10200624]},{"nodeId":10200624,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3440274273,"text":"We're not taking sides. We spoke with the adepti. They want to protect Liyue as well...","nextNodeIds":[10200625]},{"nodeId":10200625,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1058649713,"text":"When you say \"protect,\" you're referring to their sanctimonious arrogance, aren't you?","nextNodeIds":[10200626]},{"nodeId":10200626,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3175325873,"text":"Huh?","nextNodeIds":[10200627]},{"nodeId":10200627,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":666693001,"text":"You are mortals, and thus under their protection. There was no way they would have regarded you as someone with the ability to assassinate a god.","nextNodeIds":[10200628]},{"nodeId":10200628,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":743721801,"text":"Naturally, they would also regard Ningguang's locking down the area, questioning the citizenry, and pursuit of the assassin to be pointless work. Perhaps they even wonder if there might be a cover-up.","nextNodeIds":[10200629]},{"nodeId":10200629,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1829477649,"text":"I'll say it like it is: they're underestimating us.","nextNodeIds":[10200630]},{"nodeId":10200630,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3946148577,"text":"Well, you've got a point there...","nextNodeIds":[10200631]},{"nodeId":10200631,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3555100433,"text":"Still, this is the first time Paimon's seen a person from Liyue who doesn't respect the gods or the adepti.","nextNodeIds":[10200632]},{"nodeId":10200632,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":361533721,"text":"Hah. Should I respect the shallow sense of time and condescension to mortals that has caused them to delay in moving against us Qixing?","nextNodeIds":[10200633]},{"nodeId":10200633,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1801547489,"text":"Forget it. I shouldn't speak of them this way. This skepticism is mine alone, and Ningguang does not share it.","nextNodeIds":[10200634]},{"nodeId":10200634,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":785280649,"text":"Either way, I will admit that the actions of the adepti this time were quite restrained.","nextNodeIds":[10200635]},{"nodeId":10200635,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1727730225,"text":"Rex Lapis' death is indeed an extraordinary circumstance. But to think that they would call for a council of adepti rather than come down here directly...","nextNodeIds":[10200636]},{"nodeId":10200636,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3173772257,"text":"How surprisingly civilized of them.","nextNodeIds":[10200637,10200638]},{"nodeId":10200637,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1162823905,"text":"Any chance you could talk it out with them?","nextNodeIds":[10200639]},{"nodeId":10200639,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":598146361,"text":"Well, for Ningguang... She would talk anything and everything out if she could. But I doubt we can do that here.","nextNodeIds":[10200640]},{"nodeId":10200640,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2873404729,"text":"The time of the adepti has long passed. If even the Liyue Qixing don't want to face that truth, then what future is there for Liyue?","nextNodeIds":[10200641]},{"nodeId":10200641,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2770127865,"text":"Phew... Another super bold statement...","nextNodeIds":[10200642]},{"nodeId":10200642,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":905793489,"text":"*sigh* I'll stop here. Honestly, I hadn't intended to say so much. But you're a good listener, Traveler.","nextNodeIds":[10200643]},{"nodeId":10200643,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3579710513,"text":"You should both be off to the Jade Chamber. Don't be late, now. Ningguang's schedule is packed to the gills all the way till next year.","nextNodeIds":[10200644]},{"nodeId":10200644,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":779751473,"text":"The cream of Liyue's mercantile crop all see \"ascending to the Jade Chamber\" as the greatest honor. Each brings rich gifts as they visit, all to curry a little favor with Ningguang.","nextNodeIds":[10200645]},{"nodeId":10200645,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3867813977,"text":"Favor?","nextNodeIds":[10200646,10200647]},{"nodeId":10200646,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1207613289,"text":"Paimon, that's not the point.","nextNodeIds":[10200648]},{"nodeId":10200648,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2822424217,"text":"But... But!","nextNodeIds":[10200649]},{"nodeId":10200649,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2961176033,"text":"Wait, that's right! Greeting gifts are a staple of Liyue's culture. We need to get one, not to curry favor or anything — just to... respect Liyue's culture!","nextNodeIds":[10200650]},{"nodeId":10200650,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":121251649,"text":"Ah, so eager...","nextNodeIds":[10200651]},{"nodeId":10200651,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":412542609,"text":"Alright, alright. You can decide on your greeting gift yourselves. Let me tell you how to get to the Jade Chamber first.","nextNodeIds":[10200652]},{"nodeId":10200652,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3934391641,"text":"You didn't actually have to come to Mt. Tianheng. Go back to Liyue Harbor, find a guide at the Yuehai Pavilion, and...","nextNodeIds":[10200653]},{"nodeId":10200653,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":929360529,"text":"Well then. May we meet again, Traveler.","nextNodeIds":[10200654]},{"nodeId":10200654,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1090459329,"text":"Well, that Yuheng may not respect the gods, but Paimon thinks she's a pretty cool person.","nextNodeIds":[10200655,10200656]},{"nodeId":10200655,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2051254873,"text":"She made a good impression on me, too.","nextNodeIds":[10200657]},{"nodeId":10200657,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2098800961,"text":"So... What should we give to Ningguang when we see her?","nextNodeIds":[10200658]},{"nodeId":10200658,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2557437641,"text":"You really have shifted focus, haven't you, Paimon...","nextNodeIds":[10200659]},{"nodeId":10200659,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2498783385,"text":"Oh, right! Paimon dreamed of an amazing snack last night — <color=#00E1FFFF>Sugar-Frosted Slime!</color>","nextNodeIds":[10200660]},{"nodeId":10200660,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":445754561,"text":"Paimon has a feeling that it would be perfect for a super rich person like Ningguang!","nextNodeIds":[10200661]},{"nodeId":10200661,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1372973265,"text":"Why don't we go with that for a gift?","nextNodeIds":[10200662,10200664]},{"nodeId":10200662,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3658310097,"text":"So, do you have a recipe?","nextNodeIds":[10200663]},{"nodeId":10200663,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3450508809,"text":"Nope! But Paimon's sure that we just need to make it with some boom shaka-laka!","nextNodeIds":[10200666]},{"nodeId":10200666,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1586373297,"text":"Let's go gather ingredients. Time waits for no one, and neither will our riches!","nextNodeIds":[]},{"nodeId":10200664,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2860742393,"text":"And... how would we make this thing you dreamed up?","nextNodeIds":[10200665]},{"nodeId":10200665,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2274120913,"text":"With a certain boom shaka-laka, of course!","nextNodeIds":[10200666]},{"nodeId":10200656,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3489360417,"text":"I agree with some of her views.","nextNodeIds":[10200657]},{"nodeId":10200647,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":558100225,"text":"Paimon, get serious.","nextNodeIds":[10200648]},{"nodeId":10200638,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2835806081,"text":"Ningguang would prefer to negotiate, wouldn't she?","nextNodeIds":[10200639]},{"nodeId":10200620,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3255452257,"text":"(We only did a tiny part of the work there...)","nextNodeIds":[10200621]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102006,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q101503Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[102001,102002,102004,102006,102007],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":52},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":29},{"roleType":