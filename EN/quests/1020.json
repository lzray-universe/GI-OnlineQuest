eakerName":"Traveler","textMapHash":3878236033,"text":"That's pretty high up.","nextNodeIds":[10200104]},{"nodeId":10200104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1212947945,"text":"Hmm... Uhh...","nextNodeIds":[10200105]},{"nodeId":10200105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2045397025,"text":"Ah, this is bad... Paimon's supposed to be your guide, but Paimon doesn't know where the way up to the Jade Chamber is...","nextNodeIds":[10200106,10200107]},{"nodeId":10200106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":690879937,"text":"You're only realizing that now!?","nextNodeIds":[10200108]},{"nodeId":10200108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3104076817,"text":"Ugh...","nextNodeIds":[10200109]},{"nodeId":10200109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1461768353,"text":"Well, since we want to go to the Jade Chamber, heading to its location on the map is the sensible thing to do!","nextNodeIds":[10200110]},{"nodeId":10200110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1562643273,"text":"Let's look around. There has to be a way up there nearby!","nextNodeIds":[]},{"nodeId":10200107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":357905241,"text":"We should have asked that emissary, Ganyu.","nextNodeIds":[10200108]},{"nodeId":10200103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2165937193,"text":"Question is, how do we get up there?","nextNodeIds":[10200104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ