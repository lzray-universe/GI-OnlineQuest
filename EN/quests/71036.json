6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"166001246"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7103611_guide","25"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7103610,"order":11,"stepDescription":"Talk to Zhiqiong","stepDescTextMapHash":1305865116,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20523"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7103603],"talks":[{"talkId":7103603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7103610","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7103603,"initDialog":710360301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20523],"performCfg":"","priority":5,"questId":71036,"showRandomTalkCount":0},"dialogs":[{"nodeId":710360301,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":2972894474,"text":"Well, thanks for your help! Please, take this as a little token of appreciation.","nextNodeIds":[710360302]},{"nodeId":710360302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4274095258,"text":"You're too kind.","nextNodeIds":[710360303]},{"nodeId":710360303,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3844582466,"text":"Well, the various geological anomalies have mostly stopped lately, which means that I've just needed to make some small amendments to my maps.","nextNodeIds":[710360304]},{"nodeId":710360304,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1894076202,"text":"Thanks to your adventures, our work has become a lot easier, too.","nextNodeIds":[710360305]},{"nodeId":710360305,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":2386930794,"text":"Ah, don't let me keep you any longer. Whether you need some rest or would like to continue your adventures, please, go ahead!","nextNodeIds":[710360306]},{"nodeId":710360306,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":212370194,"text":"It's going to be a while before we will go and retrieve the beacons. It'll be nice if you could help us out then, too!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20523"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":7104116,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7103713","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7104116,"initDialog":710411201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20523,1005],"performCfg":"QuestDialogue/WQ/Liyue_71041/Q7104112","priority":4,"questId":71036,"showRandomTalkCount":0},"dialogs":[{"nodeId":710411201,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":849215946,"text":"Do you need something?","nextNodeIds":[710411202,710411212,710411223,710411232]},{"nodeId":710411202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2399620082,"text":"About your maps...","nextNodeIds":[710411203]},{"nodeId":710411203,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":745577170,"text":"Eh? My maps? There's honestly not much to be said about them. Before I joined the Adventurers' Guild, I was the mine cartographer.","nextNodeIds":[710411204]},{"nodeId":710411204,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3211044866,"text":"Of course, I wasn't just some person sitting behind a desk... In fact, we couldn't be more different.","nextNodeIds":[710411234]},{"nodeId":710411234,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":165000938,"text":"I was once commissioned by them to map out the terrain of Qiaoying Village... and after all that work, they canceled the construction project just like that, with only a word.","nextNodeIds":[710411205]},{"nodeId":710411205,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3858232738,"text":"People like them get assistants to do the dirty exploration work and information-gathering for them, and then they start drawing... But those like me? We can't do that.","nextNodeIds":[710411206]},{"nodeId":710411206,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1193240546,"text":"As... well, half a miner myself, I've long gotten used to passing through the dangerous underground passages. It's just the way the job works.","nextNodeIds":[710411207]},{"nodeId":710411207,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":4032758554,"text":"Also, after that great change, the lower levels of The Chasm have really been truly unstable.","nextNodeIds":[710411208]},{"nodeId":710411208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":214623810,"text":"Eh? Unstable? Is that very dangerous?","nextNodeIds":[710411209]},{"nodeId":710411209,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3545111450,"text":"You bet it is. The terrain here is slowly but constantly changing. A path today might be a rock wall next month. It's almost as if... How should I say this...","nextNodeIds":[710411210]},{"nodeId":710411210,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3621261746,"text":"It's almost as if The Chasm itself is changing shape as it likes.","nextNodeIds":[710411211]},{"nodeId":710411211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":166944418,"text":"Uh... things can't be that spooky, right?","nextNodeIds":[]},{"nodeId":710411212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":610262154,"text":"Tell me about your life as an adventurer.","nextNodeIds":[710411213]},{"nodeId":710411213,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1005661114,"text":"Haha, what? My \"life\"? You don't have to be so polite. I'm just a newbie. I've barely started my journey, unlike you.","nextNodeIds":[710411214]},{"nodeId":710411214,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3930295074,"text":"I have completed some commissions from the Guild, of course, but I'm not that experienced yet, so I haven't done much solo exploration. I don't think I've left any tales of my deeds behind either...","nextNodeIds":[710411215]},{"nodeId":710411215,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1560732162,"text":"So I've been thinking that The Chasm might be just the place for me to make my mark for future generations to remember me by.","nextNodeIds":[710411216]},{"nodeId":710411216,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":297312474,"text":"The Chasm might be, to quote the great adventurer Alice, my \"Rubicon\"!","nextNodeIds":[710411217,710411220]},{"nodeId":710411217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2094425154,"text":"The Rubicon... is that hilichurl language?","nextNodeIds":[710411218]},{"nodeId":710411218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2296352650,"text":"Paimon's never heard of that one either...","nextNodeIds":[710411219]},{"nodeId":710411219,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3465453410,"text":"Well, I'm not too sure myself, but given that Alice is an adventurer who has seen the entire world, so that must be some place she's been to... right?","nextNodeIds":[]},{"nodeId":710411220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":774026754,"text":"Your Rubicon, huh? That's pretty impressive.","nextNodeIds":[710411221]},{"nodeId":710411221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2804427218,"text":"Wait, you don't even know what that is!","nextNodeIds":[710411222]},{"nodeId":710411222,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3484816106,"text":"Haha, regardless, thanks for your encouragement!","nextNodeIds":[]},{"nodeId":710411223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2410118354,"text":"What do you think about Clitopho?","nextNodeIds":[710411224]},{"nodeId":710411224,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":697649570,"text":"Him? I don't trust him. We've had to deal with the Treasure Hoarders above the mines for who-knows how long. They're up to no good. I know it!","nextNodeIds":[710411225]},{"nodeId":710411225,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":2464048914,"text":"Don't you trust a word that he says. Turning over a new leaf... Washing his hands of the situation...","nextNodeIds":[710411226]},{"nodeId":710411226,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1079152514,"text":"While they say such pretty words, they'll be reaching their filthy hands into your back pocket.","nextNodeIds":[710411227]},{"nodeId":710411227,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":2049355618,"text":"Even Rex Lapis would have trouble protecting your wallet from them then!","nextNodeIds":[710411228]},{"nodeId":710411228,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":924811882,"text":"I'm not prejudiced or anything... I'm just telling you to be wary. The Treasure Hoarders are never to be trusted.","nextNodeIds":[710411229]},{"nodeId":710411229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4143969010,"text":"That does sound like prejudice to me, though.","nextNodeIds":[710411230]},{"nodeId":710411230,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":415773194,"text":"...Maybe it is. You've probably seen a great many more things than I have, so I guess you might be more generous to them. But as for me, I'll always keep an eye at the back of my head, just for them.","nextNodeIds":[710411231]},{"nodeId":710411231,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1922357186,"text":"And I'll keep doing that until this guy can prove that he's got nothing more to do with those despicable \"former\" companions of his.","nextNodeIds":[]},{"nodeId":710411232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":312816690,"text":"See you around.","nextNodeIds":[710411233]},{"nodeId":710411233,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1518793474,"text":"See you!","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7103602,7103603,7104116],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","count":41},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171036],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2645275358,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],