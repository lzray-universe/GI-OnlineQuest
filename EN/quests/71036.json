","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7103602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7103602,"initDialog":710360201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20523,1005],"performCfg":"QuestDialogue/WQ/Liyue_71036/Q7103602","priority":5,"questId":71036,"showRandomTalkCount":0},"dialogs":[{"nodeId":710360201,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1967784730,"text":"#Hello, {NICKNAME}! How have things been?","nextNodeIds":[710360202,710360204]},{"nodeId":710360202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2763576754,"text":"Pretty good. Are you feeling better?","nextNodeIds":[710360203]},{"nodeId":710360203,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1793256778,"text":"Thanks for your concern. I'm quite fine now, thanks. I'm sorry for causing you trouble before.","nextNodeIds":[710360206]},{"nodeId":710360206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1566523442,"text":"C'mon, Zhiqiong, just stop running around everywhere already, or you'll end up like you did the last time.","nextNodeIds":[710360207]},{"nodeId":710360207,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":2682074578,"text":"Alright, I won't. Thanks to your efforts, The Chasm has become a lot safer. The geological peculiarities here have also, well, stabilized a fair bit.","nextNodeIds":[710360208]},{"nodeId":710360208,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":2582301338,"text":"However, Jinwu and Khedive still need to conduct further analysis on that mysterious crystal's... Uh...","nextNodeIds":[710360209]},{"nodeId":710360209,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1089918482,"text":"Wavelength, I think Khedive called it? I guess it's just some sort of weird Sumeru jargon. Whatever the case, we need to plant some beacons and get some of that data.","nextNodeIds":[710360210]},{"nodeId":710360210,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3215082418,"text":"Jinwu finally found the time to put those beacons together, and I need to put them down in a few specific locations to get the data we need.","nextNodeIds":[710360211]},{"nodeId":710360211,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":3918944274,"text":"After a while, we can go and collect them, and Khedive will then sift through the data obtained.","nextNodeIds":[710360212]},{"nodeId":710360212,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":2963265458,"text":"Previously, there were too many hazardous areas for us to do anything but perform data analysis from our campsite...","nextNodeIds":[710360213]},{"nodeId":710360213,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":4220405682,"text":"But now that you've cleared much of the way for us, we can use the beacons to get more accurate data.","nextNodeIds":[710360214]},{"nodeId":710360214,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1688903554,"text":"*sigh* Well, having something to do is better than having nothing at all on your plate. Ah, right! Do you mind coming with me if you're free?","nextNodeIds":[710360215,710360217]},{"nodeId":710360215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1135894602,"text":"Lead the way.","nextNodeIds":[710360216]},{"nodeId":710360216,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":584092090,"text":"Alright then, let's go!","nextNodeIds":[]},{"nodeId":710360217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4209833490,"text":"Sooo, what's in it for me?","nextNodeIds":[710360218]},{"nodeId":710360218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1721112218,"text":"Come on, that's way too direct! ...Although Paimon would like to know, too...","nextNodeIds":[710360219]},{"nodeId":710360219,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":741356370,"text":"Haha, this should be a milk run, but I doubt Jinwu won't have anything for you in return.","nextNodeIds":[]},{"nodeId":710360204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":9358538,"text":"Well, still alive in spite of everything. How are you doing?","nextNodeIds":[710360205]},{"nodeId":710360205,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"Zhiqiong","textMapHash":1614690434,"text":"I'm alright... But I wouldn't say I'm super good. I mean, you did hog all the exploration glory, didn't you?","nextNodeIds":[710360206]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["6","166001528,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20523"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7103604,"order":4,"stepDescription":"Place the measuring beacons","stepDescTextMapHash":270636764,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"wq7103604"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7103604_guide","30"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"wq7103604"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER