{"mainQuestId":73698,"title":"The Recollector's Path","description":"After completing some of the training assignments recommended by Zurvan, Sorush grows closer to assuming the responsibilities of a Bloomguard...\\n","titleTextMapHash":1202961559,"descTextMapHash":1888522494,"mainQuestExcel":{"mainQuestId":73698,"titleTextMapHash":1202961559,"title":"The Recollector's Path","descTextMapHash":1888522494,"description":"After completing some of the training assignments recommended by Zurvan, Sorush grows closer to assuming the responsibilities of a Bloomguard...\\n","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5132,"luaPath":"Actor/Quest/WQ73698","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5132,"chapterId":0,"descTextMapHash":1888522494,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73698,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2600494025,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73698","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173698],"series":73697,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[73699],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1202961559,"type":"WQ","unlockDescTextMapHash":2315042438}},"flow":[{"subQuestId":7369801,"order":5,"stepDescription":"Talk to Zurvan","stepDescTextMapHash":1622786732,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369801],"talks":[{"talkId":7369801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7369801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369801,"initDialog":736980101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4284],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7369801","priority":5,"questId":73698,"showRandomTalkCount":0},"dialogs":[{"nodeId":736980101,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":1415197698,"text":"It appears the first part of your training went well.","nextNodeIds":[736980102,736980104]},{"nodeId":736980102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3857737642,"text":"You could say so.","nextNodeIds":[736980103]},{"nodeId":736980103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":795373482,"text":"Yeah. Maybe it was a bit too easy for Sorush?","nextNodeIds":[736980106]},{"nodeId":736980106,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":547342146,"text":"Ha. Then I look forward to seeing her coming performance.","nextNodeIds":[736980107]},{"nodeId":736980107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2795243466,"text":"Oh, right. About listening to Sorush tell stories, it turned out that Sorush went through a rebellious phase—","nextNodeIds":[736980108]},{"nodeId":736980108,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1249323746,"text":"Speak no more of this!","nextNodeIds":[736980109]},{"nodeId":736980109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4045545034,"text":"Ah!","nextNodeIds":[736980110]},{"nodeId":736980110,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4029617162,"text":"Ahem. Anyhow, I have finally sh—shed that stage of my life.","nextNodeIds":[736980111]},{"nodeId":736980111,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2360332546,"text":"The important thing is that I, with my Yasnapati and the Pale Floater, recalled the history following the birth of the Pari, and spoke of the familiars of the forest and their special festival.","nextNodeIds":[736980112]},{"nodeId":736980112,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1154691474,"text":"The fact that we, as Pari, do not have such a celebration of our own makes me troubled. Do you not feel the same way, Elder?","nextNodeIds":[736980113]},{"nodeId":736980113,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1240313626,"text":"If it were up to me, we should let humans attend the Pari Festival, and hear from them the praises they sing for the Pari. Afterward, I shall pick the best singer...","nextNodeIds":[736980114]},{"nodeId":736980114,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":158718202,"text":"To my knowledge, Festival Utsava is not a day to be so willfully and wastefully spent.","nextNodeIds":[736980115]},{"nodeId":736980115,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3725525330,"text":"Uh...","nextNodeIds":[736980116]},{"nodeId":736980116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2735039330,"text":"Paimon always thought Sorush's desire to get humans to record her deeds was different from the other Pari... Is this also the influence of the Order of Skeptics?","nextNodeIds":[736980117]},{"nodeId":736980117,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":754552890,"text":"That is the very reason why recalling and pondering the past is significant.","nextNodeIds":[736980118]},{"nodeId":736980118,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"Zurvan","textMapHash":718435418,"text":"Ha. Whatever happens, I look forward to seeing her coming performance.","nextNodeIds":[]},{"nodeId":736980104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1158643050,"text":"I wouldn't go that far.","nextNodeIds":[736980105]},{"nodeId":736980105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2258837874,"text":"Sorush isn't nearly as amazing as she says she is, so she'll have to try even harder for what comes next.","nextNodeIds":[736980106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7369802,"order":6,"stepDescription":"Head to the specified location and complete the trial","stepDescTextMapHash":378201940,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7369802"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7369802_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7369802"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLH