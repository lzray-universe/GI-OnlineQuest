"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"736980501"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7369806,"order":10,"stepDescription":"Talk to Sorush","stepDescTextMapHash":1619359004,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369806,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7369806_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7369806],"talks":[{"talkId":7369806,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7369806","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369806,"initDialog":736980601,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7369806","priority":5,"questId":73698,"showRandomTalkCount":0},"dialogs":[{"nodeId":736980601,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1877420666,"text":"Wait! Paimon remembers this place? We've been here before.","nextNodeIds":[736980602,736980604]},{"nodeId":736980602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1131897482,"text":"It does leave an impression.","nextNodeIds":[736980603]},{"nodeId":736980603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1660776978,"text":"It sure scared Paimon pretty good!","nextNodeIds":[736980606]},{"nodeId":736980606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1507189610,"text":"Paimon remembers that Sorush said this Wenut got sealed here because it was unlucky. Though, what does it have to do with Sorush's training?","nextNodeIds":[736980607]},{"nodeId":736980607,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3242301442,"text":"Huh. Does Zurvan actually mean to say: \"Haha. Behold, Sorush! Behold the fate of the unfortunate\"?","nextNodeIds":[736980608]},{"nodeId":736980608,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":4170918410,"text":"Hm... My elder is no Pari of such idle nature!","nextNodeIds":[736980609]},{"nodeId":736980609,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3579489850,"text":"...Back to the topic. Though I did not elaborate on the Wenut in detail when we passed through here earlier, the catastrophe that caused it should be familiar to you.","nextNodeIds":[736980610]},{"nodeId":736980610,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2157676202,"text":"The one that happened five hundred years ago...","nextNodeIds":[736980611]},{"nodeId":736980611,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":643425434,"text":"Indeed. The Wenut must've been frozen in an instant. As it has been crystallized, its form remains in perpetuity.","nextNodeIds":[736980612]},{"nodeId":736980612,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2959510978,"text":"It's as if it would start burrowing through the earth again once unsealed.","nextNodeIds":[736980613]},{"nodeId":736980613,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2617570914,"text":"This moment will be frozen in time...?","nextNodeIds":[736980614]},{"nodeId":736980614,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2554596274,"text":"Aghh! Paimon doesn't want to end up like that!","nextNodeIds":[736980615]},{"nodeId":736980615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4083564602,"text":"You say what happened to the Wenut happened in an instant... Ah! No! No! Just thinking of it scares Paimon!","nextNodeIds":[736980616]},{"nodeId":736980616,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":329902042,"text":"I won't let that happen!","nextNodeIds":[736980617]},{"nodeId":736980617,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1847379202,"text":"#Y—Yeah! Paimon won't let something so horrible happen to {NICKNAME} either.","nextNodeIds":[736980618]},{"nodeId":736980618,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1237068426,"text":"Hmph. Then you should thank us Pari.","nextNodeIds":[736980619]},{"nodeId":736980619,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":553296482,"text":"During those days of ruin, many species and races, including the Pari, gave their lives... Sometimes, even things more precious than their lives.","nextNodeIds":[736980620]},{"nodeId":736980620,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1103941834,"text":"Their sacrifices are why we are spared from facing the same irrevocable fate.","nextNodeIds":[736980621]},{"nodeId":736980621,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1653779698,"text":"And just so. As I was not there to witness the catastrophe, when this land faces danger once again, I must take action...","nextNodeIds":[736980622]},{"nodeId":736980622,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1401347218,"text":"Then, from what you're saying, this Wenut is even older than you are, which should also make it your elder.","nextNodeIds":[736980623]},{"nodeId":736980623,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3030284298,"text":"However, it will not be returning to life. It has been sealed in its crystallized state for centuries. Perhaps the only fate that awaits it is gradual dissolution.","nextNodeIds":[736980624]},{"nodeId":736980624,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3303673154,"text":"With how severe the loss of life was during the catastrophe, the Wenut, like countless other unfortunate souls, were frozen at the moment that calamity struck.","nextNodeIds":[736980625]},{"nodeId":736980625,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3636786770,"text":"But many more suffered even graver fates than this poor fool before us, for they had already worn away beneath the grinding passing of time itself.","nextNodeIds":[736980626]},{"nodeId":736980626,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":297885714,"text":"To this day, nothing remains of them. Not memory nor memorial.","nextNodeIds":[736980627]},{"nodeId":736980627,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1076070418,"text":"This one before us only lingers because of its immense size, and the fact that it has been hidden away in this cave from the glaring eye of the sun and lashing winds. Thus, the intactness of its condition.","nextNodeIds":[736980628]},{"nodeId":736980628,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":1835510178,"text":"However, no being on this land can overcome time. Not even remains and husks will endure. One day, there will be nothing left of it, either.","nextNodeIds":[736980629]},{"nodeId":736980629,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3761691202,"text":"That sounds kinda sad... Not having any trace that shows you lived once...","nextNodeIds":[736980630]},{"nodeId":736980630,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3505682034,"text":"Hm. The records left here by the humans should have something relating to the Wenut. I presume such a thing is rare for humans, no?","nextNodeIds":[736980631]},{"nodeId":736980631,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":665228474,"text":"From what I heard my elder say, aside from the Order of Skeptics, there were also researchers from the forest here seeking inquiry.","nextNodeIds":[736980632]},{"nodeId":736980632,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":2252594402,"text":"Though some humans believe that the Setekh Wenut is the completed state of a Quicksand Eel... To hold such theories and assumptions makes one worry for the contents recorded by these humans.","nextNodeIds":[736980633]},{"nodeId":736980633,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":610942858,"text":"That information's not reliable at all!","nextNodeIds":[736980634]},{"nodeId":736980634,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1601351818,"text":"Think! These records are obviously false, yet you still enthusiastically found a human to serve as your \"Yasnapati\"...","nextNodeIds":[736980635]},{"nodeId":736980635,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":139167666,"text":"Maybe before this crystal is entirely corroded, the poems and odes dedicated to you will have changed beyond our recognition.","nextNodeIds":[736980636]},{"nodeId":736980636,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3386503394,"text":"Maybe the Bloomguard mentioned in the odes might not be pink or cute, but instead have a rough but reliable exterior, a mild and respectful personality, and act with rationality and calmness... Hmm?","nextNodeIds":[736980637]},{"nodeId":736980637,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2627210386,"text":"That sounds a lot like the idealized image of a guardian.","nextNodeIds":[736980638]},{"nodeId":736980638,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2062870434,"text":"But that sounds nothing like you, Sorush.","nextNodeIds":[736980639]},{"nodeId":736980639,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":193127114,"text":"Absolutely not! Wait, I believe I understand what my elder desires. She must be reminding me to find a better way to record my deeds...","nextNodeIds":[736980640]},{"nodeId":736980640,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","textMapHash":3562485490,"text":"Hm. My elder does possess foresight indeed. I must offer her my deepest thanks.","nextNodeIds":[736980641]},{"nodeId":736980641,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":435266570,"text":"Paimon doesn't think she meant that...","nextNodeIds":[]},{"nodeId":736980604,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2390162954,"text":"Where are we again?","nextNodeIds":[736980605]},{"nodeId":736980605,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3448127194,"text":"Sorush brought us through here while bringing us to see Zurvan, remember?","nextNodeIds":[736980606]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369806,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7369806_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7369801,7369806],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"Sorush","count":25},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon",