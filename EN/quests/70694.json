{"mainQuestId":70694,"title":"Strength, Courage, and Trials","description":"Bold Bang Bouldern from the Collective of Plenty seems to be planning some kind of exciting activity with your old friend...","titleTextMapHash":3946698207,"descTextMapHash":2550209862,"mainQuestExcel":{"mainQuestId":70694,"titleTextMapHash":3946698207,"title":"Strength, Courage, and Trials","descTextMapHash":2550209862,"description":"Bold Bang Bouldern from the Collective of Plenty seems to be planning some kind of exciting activity with your old friend...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2044,"luaPath":"Actor/Quest/WQ70694","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2044,"chapterId":0,"descTextMapHash":2550209862,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70694,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1086070489,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70694","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170694],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3946698207,"type":"WQ","unlockDescTextMapHash":1985840286}},"flow":[{"subQuestId":7069401,"order":1,"stepDescription":"Talk to Bold Bang Bouldern","stepDescTextMapHash":1446940972,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30896"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7069401],"talks":[{"talkId":7069401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7069401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7069401,"initDialog":706940101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1035,30896],"performCfg":"QuestDialogue/WQ/DPEQ_70694/Q7069401","priority":5,"questId":70694,"showRandomTalkCount":0},"dialogs":[{"nodeId":706940101,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":456638514,"text":"Miss Bold Bang, is your lower back still hurting?","nextNodeIds":[706940102]},{"nodeId":706940102,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","textMapHash":3047882138,"text":"I'm good now... That hot compress worked like a charm!","nextNodeIds":[706940103]},{"nodeId":706940103,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":3464231234,"text":"Heh, to make a hot compress like this, you have to heat the wet bandage with slow-burning gunpowder for just the right amount of time, or you might end up setting it on fire.","nextNodeIds":[706940104]},{"nodeId":706940104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4081321506,"text":"Only Yoimiya would come up with a way to warm up bandages like that!","nextNodeIds":[706940105]},{"nodeId":706940105,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","textMapHash":395944354,"text":"#Hold on a second... Look who's here! Our hero both in name and deed, and {M#his}{F#her} little white companion!","nextNodeIds":[706940106]},{"nodeId":706940106,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","textMapHash":3678256802,"text":"Is this the part where a woven scroll comic scene unfolds right in front of me...?","nextNodeIds":[706940107,706940108]},{"nodeId":706940107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1071913002,"text":"Hey! Are you helping patch her up?","nextNodeIds":[706940109]},{"nodeId":706940109,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","textMapHash":2691415218,"text":"Oh, please don't worry about me! I was just wandering about in the wild, looking for some new tough opponents to practice against.","nextNodeIds":[706940110]},{"nodeId":706940110,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","textMapHash":345181306,"text":"Miss Yoimiya here was really a great help to me when I accidentally hurt my back and tumbled down the hill like a snowball!","nextNodeIds":[706940111]},{"nodeId":706940111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1108945882,"text":"Oof... That sounds painful...","nextNodeIds":[706940112]},{"nodeId":706940112,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":4022527306,"text":"Heh, to quote The Soulblazer Saga, \"I'm merely a warrior who happened to pass by\"...","nextNodeIds":[706940113]},{"nodeId":706940113,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2498439506,"text":"And now, we can make that a \"free mercenary\"! The Knights have granted me permission to take action and deal with monsters as I see fit.","nextNodeIds":[706940114,706940115]},{"nodeId":706940114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3088409410,"text":"Sounds like there are still monsters lurking, then?","nextNodeIds":[706940116]},{"nodeId":706940116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1318053130,"text":"Things don't look so good... Should we contact the Knights and ask for reinforcements?","nextNodeIds":[706940117]},{"nodeId":706940117,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":631014746,"text":"True, we can't afford to be careless, but the situation isn't that urgent yet.","nextNodeIds":[706940118]},{"nodeId":706940118,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2625704146,"text":"The Knights have already cleared out the monsters around the International Cross Country Challenge venue, and there are only a few stragglers wandering about at this point.","nextNodeIds":[706940119]},{"nodeId":706940119,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2189197642,"text":"And honestly, there are quite a few adventurers competing in the challenge who can hold their own anyway.","nextNodeIds":[706940120]},{"nodeId":706940120,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":2966120194,"text":"They have the strength, skills, and courage. If we treat them like we do the regular folks, they might end up feeling insulted instead.","nextNodeIds":[706940121]},{"nodeId":706940121,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","textMapHash":624775874,"text":"So, in line with usual practice at the Adventurers' Guild, we're treating this as a trial, and we've formed a team on the spot to deal with those monsters.","nextNodeIds":[706940122]},{"nodeId":706940122,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","textMapHash":1007397674,"text":"And that's exactly what the Trial of Valor is about: clearing monsters, emulating various heroes' combat styles, and transcending your own limits!","nextNodeIds":[706940123]},{"nodeId":706940123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3462123122,"text":"Now that's the kind of thinking you'd expect from the Collective of Plenty!","nextNodeIds":[706940124,706940125]},{"nodeId":706940124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2072301218,"text":"Then I definitely want to be a part of this!","nextNodeIds":[706940126]},{"nodeId":706940126,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":212998346,"text":"#Awesome! It's been a while since I last saw you in action, {NICKNAME}.","nextNodeIds":[706940127]},{"nodeId":706940127,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","textMapHash":4205247018,"text":"I'm really excited to see your skills now... I wonder, what kind of fireworks can I compare your dazzling moves to?","nextNodeIds":[]},{"nodeId":706940125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1477174714,"text":"I'm not missing out on this either, that's for sure!","nextNodeIds":[706940126]},{"nodeId":706940115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3930530402,"text":"We'll have to act with caution since there are civilians in the area too.","nextNodeIds":[706940116]},{"nodeId":706940108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3683009586,"text":"Have you just been through a battle?","nextNodeIds":[706940109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30896"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7069401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"Yoimiya","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"Bold Bang Bouldern","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170694],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKO