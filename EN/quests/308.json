EPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[30814],"talks":[{"talkId":30814,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["30814","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":30814,"initDialog":3081401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1007],"performCfg":"QuestDialogue/AQ/Mengde1_308/Q30814","priority":1,"questId":308,"showRandomTalkCount":0},"dialogs":[{"nodeId":3081401,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3966263043,"text":"Dragon of the East, Lion of the South, Wolf of the North, Falcon of the West...","nextNodeIds":[3081402]},{"nodeId":3081402,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2673318923,"text":"They are the Four Winds of Mondstadt, affiliated with Barbatos, the God of Anemo.","nextNodeIds":[3081403]},{"nodeId":3081403,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":271797899,"text":"The Dragon of the East, Stormterror — its real name, is Dvalin.","nextNodeIds":[3081404]},{"nodeId":3081404,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2611099523,"text":"Though most in Mondstadt seem to have forgotten that in all this \"Stormterror\" business.","nextNodeIds":[3081405]},{"nodeId":3081405,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1537834187,"text":"So now you know why Dvalin is only able to channel three of the Four Winds' power.","nextNodeIds":[3081406]},{"nodeId":3081406,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3436769179,"text":"Because it has been consuming itself from the beginning.","nextNodeIds":[3081407,3081408]},{"nodeId":3081407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1860248947,"text":"Why?","nextNodeIds":[3081409]},{"nodeId":3081409,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":916529859,"text":"Because of hatred, I presume.","nextNodeIds":[3081410]},{"nodeId":3081410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2100359723,"text":"Hatred...?","nextNodeIds":[3081411]},{"nodeId":3081411,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":756362147,"text":"Hatred for Mondstadt.","nextNodeIds":[3081412]},{"nodeId":3081412,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1941740123,"text":"Hatred drove it to become something more powerful than the wind itself — to become Stormterror.","nextNodeIds":[3081413]},{"nodeId":3081413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1052012859,"text":"But why would one of The Four Winds...","nextNodeIds":[3081414]},{"nodeId":3081414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":732620955,"text":"Hate the city it was supposed to protect?","nextNodeIds":[3081415]},{"nodeId":3081415,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1309719403,"text":"...","nextNodeIds":[3081416]},{"nodeId":3081416,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1883468571,"text":"As a child of Mondstadt, it's something that's really hard to say aloud.","nextNodeIds":[3081417]},{"nodeId":3081417,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2830776859,"text":"Here, take this. It's a very old story from more than a century ago.","nextNodeIds":[]},{"nodeId":3081408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3869950011,"text":"Why would it go to such lengths?","nextNodeIds":[3081409]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[30814,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[3,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_MY_WORLD","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1003,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["3"],"PAINLIBBLDK":"QUEST_EXEC_REMOVE_TRIAL_AVATAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":30804,"order":12,"stepDescription":"Leave Domain","stepDescTextMapHash":3926918687,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[3,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_MY_WORLD","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":