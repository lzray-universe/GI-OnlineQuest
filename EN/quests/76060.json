NotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7606003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7606003,"initDialog":760600301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76060/Q7606003","priority":5,"questId":76060,"showRandomTalkCount":0},"dialogs":[{"nodeId":760600301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":450036514,"text":"Alright, these should do. What do you think, Maalaus?","nextNodeIds":[760600302]},{"nodeId":760600302,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":3479556426,"text":"~!","nextNodeIds":[760600303]},{"nodeId":760600303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3735221706,"text":"Yep, looks like a happy kuuhenki to Paimon! Hehe, wonder what kind of painting we'll get this time...","nextNodeIds":[760600304]},{"nodeId":760600304,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":3758402562,"text":"...","nextNodeIds":[760600305]},{"nodeId":760600305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2114509618,"text":"Oh, is it done already?","nextNodeIds":[760600306]},{"nodeId":760600306,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":2099131506,"text":"...","nextNodeIds":[760600307]},{"nodeId":760600307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4205793786,"text":"Maalaus seems a little sad. Is it because of the painting? Let's take a look...","nextNodeIds":[760600308]},{"nodeId":760600308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3435485090,"text":"Okay so, it's Columbina... taking a walk under the moonlight and gazing up at the night sky.","nextNodeIds":[760600309]},{"nodeId":760600309,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":683111050,"text":"Ah... I must be looking at the true moon beyond the false sky. I used to take midnight walks like that all the time.","nextNodeIds":[760600310]},{"nodeId":760600310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4261167538,"text":"Used to...? Oh, right...","nextNodeIds":[760600311]},{"nodeId":760600311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1524690962,"text":"(Columbina is pretty much confined to this garden, now... even though Nod-Krai is where she was born...)","nextNodeIds":[760600312]},{"nodeId":760600312,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2710638922,"text":"Yes, I would gaze at the sky and wonder... What really lies up there on the true Frost Moon?","nextNodeIds":[760600313]},{"nodeId":760600313,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4236702898,"text":"Perhaps it's just like here, filled with lots of little animals...","nextNodeIds":[760600314]},{"nodeId":760600314,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2327123810,"text":"Or perhaps... there's nothing there at all.","nextNodeIds":[760600315]},{"nodeId":760600315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4168983570,"text":"Oh...","nextNodeIds":[760600316,760600319]},{"nodeId":760600316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3416229458,"text":"You could always take a few up there with you?","nextNodeIds":[760600317]},{"nodeId":760600317,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2576116506,"text":"Ha... An interesting thought.","nextNodeIds":[760600318]},{"nodeId":760600318,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1264568234,"text":"But... Since the moon lies beyond the false sky, that's one adventure I would rather not risk taking them on...","nextNodeIds":[760600322]},{"nodeId":760600322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":281111610,"text":"(One is a \"home\" where she isn't even free to move around... the other is a \"home\" she knows nothing about...)","nextNodeIds":[760600323]},{"nodeId":760600323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1449766170,"text":"(...)","nextNodeIds":[760600324]},{"nodeId":760600324,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":1093235202,"text":"...","nextNodeIds":[760600325]},{"nodeId":760600325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2915309346,"text":"Maalaus and the other kuuhenki are really gonna miss you...","nextNodeIds":[760600326]},{"nodeId":760600326,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1775117882,"text":"And I will miss them too.","nextNodeIds":[760600327]},{"nodeId":760600327,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":345923794,"text":"But in the end, this is a journey that only I can make... and the answer at the end of it is mine alone to seek.","nextNodeIds":[760600328]},{"nodeId":760600328,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":119806194,"text":"And who knows? Whatever that answer turns out to be... Perhaps it will be something beautiful.","nextNodeIds":[760600329]},{"nodeId":760600329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1693383706,"text":"W—Well... We'll just have to come visit you, then! With Maalaus!","nextNodeIds":[760600330]},{"nodeId":760600330,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1752365290,"text":"Alright. We could hold that art exhibition on the moon, perhaps.","nextNodeIds":[760600331]},{"nodeId":760600331,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":922369746,"text":"Yeah, great idea! It's a promise!","nextNodeIds":[760600332]},{"nodeId":760600332,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3098059474,"text":"Mm...","nextNodeIds":[760600333]},{"nodeId":760600333,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4194018778,"text":"I hope so, I truly do...","nextNodeIds":[]},{"nodeId":760600319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2487493634,"text":"There could be other cute creatures up there...","nextNodeIds":[760600320]},{"nodeId":760600320,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3078104866,"text":"Mm, I hope so.","nextNodeIds":[760600321]},{"nodeId":760600321,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":898709090,"text":"And I hope... if there are, the creatures would welcome the sudden and unexpected return of their \"Goddess.\"","nextNodeIds":[760600322]}]},{"talkId":7606004,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7606003","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7606004,"initDialog":760600401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76060/Q7606004","priority":5,"questId":76060,"showRandomTalkCount":0},"dialogs":[{"nodeId":760600401,"roleType":"TALK_ROLE_NPC","speakerId":