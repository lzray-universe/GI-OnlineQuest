18],"performCfg":"QuestDialogue/WQ/NodKrai_76060/Q7606001","priority":5,"questId":76060,"showRandomTalkCount":0},"dialogs":[{"nodeId":760600101,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":2209914378,"text":"...","nextNodeIds":[760600102]},{"nodeId":760600102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":656666090,"text":"Huh? Isn't that Maalaus? Has she been out gathering inspiration, again?","nextNodeIds":[760600103]},{"nodeId":760600103,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2819324618,"text":"Yes. But the little one has been like this ever since she came back... As if lost in thought.","nextNodeIds":[760600104]},{"nodeId":760600104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":930832186,"text":"Huh, maybe the theme this time is super profound... Y'know, like when a great artist realizes some fundamental truth about the world.","nextNodeIds":[760600105]},{"nodeId":760600105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":81177842,"text":"Come to think of it, Maalaus has given us a whole bunch of paintings. We could hold an entire exhibition at this rate!","nextNodeIds":[760600106]},{"nodeId":760600106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3819752362,"text":"Hehe, Paimon can't wait to tell everyone all about our little painter's rise to artistic stardom! Ah, but we'd need Columbina's permission first, of course.","nextNodeIds":[760600107]},{"nodeId":760600107,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3243656034,"text":"Hm? Why is that?","nextNodeIds":[760600108]},{"nodeId":760600108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2988602074,"text":"Well, 'cause they're nearly all paintings of you.","nextNodeIds":[760600109]},{"nodeId":760600109,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":181286330,"text":"Oh... It's okay, I don't mind. It sounds intriguing.","nextNodeIds":[760600110]},{"nodeId":760600110,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":1342839146,"text":"~!","nextNodeIds":[760600111]},{"nodeId":760600111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3231323258,"text":"Oh, seems like Maalaus has decided what to draw! Quick, let's see what kind of paint we've got.","nextNodeIds":[760600112]},{"nodeId":760600112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2256619818,"text":"This time... Let's go for deep and tranquil colors!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7606001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7606002,"order":2,"stepDescription":"Give the kuuhenki some objects with vivid colors","stepDescTextMapHash":2467101628,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7606001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":