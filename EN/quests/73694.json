"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30351"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369401],"talks":[{"talkId":7369401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7369401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369401,"initDialog":736940101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30351],"performCfg":"QuestDialogue/WQ/Sumeru_73694/Q7369401","priority":5,"questId":73694,"showRandomTalkCount":0},"dialogs":[{"nodeId":736940101,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":4201983434,"text":"Ugh, why does everyone seem so exhausted...","nextNodeIds":[736940102]},{"nodeId":736940102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":134182426,"text":"Are you running some sort of event here?","nextNodeIds":[736940103]},{"nodeId":736940103,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":1476629290,"text":"You're the Traveler, aren't you? Haha! I've always wanted to meet you.","nextNodeIds":[736940104]},{"nodeId":736940104,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":3510157010,"text":"That's right. Vahumana is running an archaeology-themed game this time!","nextNodeIds":[736940105]},{"nodeId":736940105,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":2973648802,"text":"We have many researchers who study history under our banner, and so archaeological work, especially the sort that is done in person, is often unavoidable.","nextNodeIds":[736940106]},{"nodeId":736940106,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":4232509602,"text":"Wait, wait, don't be nervous. We're not getting everyone to do that in person. This event is just a replica of archaeological \"activities.\"","nextNodeIds":[736940107]},{"nodeId":736940107,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":2217739090,"text":"We have placed a lot of replica relics and buried them all around Sumeru City, and we term those places, at least for now, our Archaeological Zones.","nextNodeIds":[736940108]},{"nodeId":736940108,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":2474726098,"text":"Those who take part in this activity just need to bring our specially-made detectors to those sites and dig up the buried replicas.","nextNodeIds":[736940109]},{"nodeId":736940109,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":2379657698,"text":"It's all thanks to the students of the other Darshans for constructing a batch of containers and corresponding detectors.","nextNodeIds":[736940110]},{"nodeId":736940110,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":2402496770,"text":"What do you think, Traveler? Would you be interested in giving this a go?","nextNodeIds":[736940111,736940112]},{"nodeId":736940111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3971088898,"text":"Doesn't sound too hard...","nextNodeIds":[736940113]},{"nodeId":736940113,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":4222295730,"text":"Hahaha, great! In that case, here's a detector! I'll mark the Archaeological Zones on your <color=#00E1FFFF>Archaeological Manual</color>.","nextNodeIds":[736940114]},{"nodeId":736940114,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":1677361858,"text":"Alright, that should do it. Well then, Traveler, go out there and have yourself some archaeological fun!","nextNodeIds":[736940115]},{"nodeId":736940115,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":1796835082,"text":"Once you've found all the relic replicas, do remember to come back and collect your reward from me.","nextNodeIds":[736940116]},{"nodeId":736940116,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":3630194514,"text":"You just need to follow the detector in order to find the replicas. We've even split the types of replicas into zones according to the elements.","nextNodeIds":[736940117]},{"nodeId":736940117,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":1547572986,"text":"However... These detectors were originally used in elemental surveys, and despite our last-minute modifications, they might still be affected by certain elements.","nextNodeIds":[736940118]},{"nodeId":736940118,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","textMapHash":2566886210,"text":"All in all, you just need to dig up all the replicas, and you'll find that we've got awesome rewards for you!","nextNodeIds":[]},{"nodeId":736940112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":725261050,"text":"We could give it a go...","nextNodeIds":[736940113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30351"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7369401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"Daneh","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173694],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":60108294,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73694/Q7369401","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMH