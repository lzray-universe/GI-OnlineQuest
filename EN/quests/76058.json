rGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7605802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7605801,"initDialog":760580101,"nextRandomTalks":[],"nextTalks":[],"npcId":[22101,7088,7087,7041],"performCfg":"QuestDialogue/WQ/NodKrai_76058/Q7605801","priority":5,"questId":76058,"showRandomTalkCount":0},"dialogs":[{"nodeId":760580101,"roleType":"TALK_ROLE_NPC","speakerId":7088,"speakerName":"Maisie","textMapHash":1717533658,"text":"I've never seen a Weasel Thief this white before. Do you think it might be ill...?","nextNodeIds":[760580102]},{"nodeId":760580102,"roleType":"TALK_ROLE_NPC","speakerId":7087,"speakerName":"Mikko","textMapHash":3203482938,"text":"It was full of energy just now — it even tried to snatch some food from Jurva. It doesn't seem sick to me!","nextNodeIds":[760580103]},{"nodeId":760580103,"roleType":"TALK_ROLE_NPC","speakerId":7041,"speakerName":"Jurva","textMapHash":573150082,"text":"Maybe it's a rare species? Linnea might know.","nextNodeIds":[760580104]},{"nodeId":760580104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3534339274,"text":"Whoa! It's the Mora thief who emptied Paimon's secret stash!","nextNodeIds":[760580105]},{"nodeId":760580105,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2924516738,"text":"The Weasel Thief tries to run away, but the three kids are lightning fast. They pin it down, and after a short struggle, it gives up. You take the chance to explain what happened...","nextNodeIds":[760580106]},{"nodeId":760580106,"roleType":"TALK_ROLE_NPC","speakerId":7087,"speakerName":"Mikko","textMapHash":3825392202,"text":"So this isn't the first time it's done this? In that case, we've gotta teach it a lesson! Do something wrong, and you get punished. That's only fair, right?","nextNodeIds":[760580107]},{"nodeId":760580107,"roleType":"TALK_ROLE_NPC","speakerId":7088,"speakerName":"Maisie","textMapHash":2876622226,"text":"But... It's just an animal. It doesn't understand what's right and wrong...","nextNodeIds":[760580108,760580109]},{"nodeId":760580108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3066042618,"text":"As long as it gives Paimon her Mora back, that's enough for me.","nextNodeIds":[760580110]},{"nodeId":760580110,"roleType":"TALK_ROLE_NPC","speakerId":7041,"speakerName":"Jurva","textMapHash":2378567106,"text":"Anyway, let's get Paimon her Mora back first. It's not like the weasel can spend it, so it should all still be there.","nextNodeIds":[760580111]},{"nodeId":760580111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3926950898,"text":"Yay! Hehe, Paimon's secret stash is back in business!","nextNodeIds":[760580112]},{"nodeId":760580112,"roleType":"TALK_ROLE_NPC","speakerId":7088,"speakerName":"Maisie","textMapHash":788709458,"text":"I wish we could keep it. That way, when Helka comes back, we can show her a rare Weasel Thief!","nextNodeIds":[760580113]},{"nodeId":760580113,"roleType":"TALK_ROLE_NPC","speakerId":7087,"speakerName":"Mikko","textMapHash":3736422682,"text":"Huh? But it's not like we can put it to work... Stealing doesn't count! Why should it get free food for nothing?","nextNodeIds":[760580114]},{"nodeId":760580114,"roleType":"TALK_ROLE_NPC","speakerId":7041,"speakerName":"Jurva","textMapHash":2794278866,"text":"Okay, okay, but what should we do with it...? Let's figure that out with Katya later.","nextNodeIds":[]},{"nodeId":760580109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3732628730,"text":"Even animals need to learn how cruel the world can be...","nextNodeIds":[760580110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7605801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7605801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":7088,"speakerName":"Maisie","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":7087,"speakerName":"Mikko","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":7041,"speakerName":"Jurva","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":2},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2},{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[176058],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":t