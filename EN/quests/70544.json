ST_GUIDE_NONE"},"isHidden":false,"talkIds":[7054401],"talks":[{"talkId":7054401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7054401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7054401,"initDialog":705440101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30524],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7054401","priority":5,"questId":70544,"showRandomTalkCount":0},"dialogs":[{"nodeId":705440101,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":480632626,"text":"Ohoho! So this is the rumored sacred land that people name the Furball Fortress! And yet it is furnished in such a prosaic manner — shabby, one might even call it.","nextNodeIds":[705440102]},{"nodeId":705440102,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":788162850,"text":"Surely a few... swings woven from the vines of purple agate grapes might be built! Pure silver lamps mounted with candles made of abyssal sea salt, all the better to light the cat-feeding platters with the motifs of nightborne stars!","nextNodeIds":[705440103]},{"nodeId":705440103,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":1859433634,"text":"And... Yes, statues! Forged in the image of cat familiars by melting the venerable coinage of lost dynasties and adorning them with strange pearls and dewdrops from the depths of a fjord. Surely, this would make for an amenable choice!","nextNodeIds":[705440104]},{"nodeId":705440104,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":3421444282,"text":"You surely must agree, do you not, dear familiar...","nextNodeIds":[705440105]},{"nodeId":705440105,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":1088887882,"text":"...Hmm. You have yet to declare your name to your Prinzessin. Think on that, then, and know that it shall be your utmost honor to be known to her!","nextNodeIds":[705440106]},{"nodeId":705440106,"roleType":"TALK_ROLE_NPC","speakerId":30527,"speakerName":"Dopey","textMapHash":3373008450,"text":"Meow?","nextNodeIds":[705440107]},{"nodeId":705440107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1482920338,"text":"His name is \"Dopey,\" esteemed Prinzessin!","nextNodeIds":[705440108]},{"nodeId":705440108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":311478826,"text":"Dopey isn't the brightest, and he can't really understand or appreciate your exquisite choice of words. Please, show him clemency, Prinzessin...","nextNodeIds":[705440109]},{"nodeId":705440109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3647901242,"text":"Hey, wait, no, that's not right! Why does Paimon get like this whenever she sees Fischl?","nextNodeIds":[705440110,705440111]},{"nodeId":705440110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3731528442,"text":"Nothing wrong with that, let me give it a whirl too!","nextNodeIds":[705440112]},{"nodeId":705440112,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":774375386,"text":"Haha, as I anticipated! Cat Conjurors, thou hath once more been brought before our august person by the weavings of the threads of fate...","nextNodeIds":[705440113]},{"nodeId":705440113,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":1188748482,"text":"'Tis a most pleasing reunion!","nextNodeIds":[705440114]},{"nodeId":705440114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3390788210,"text":"What a title... Looks like Fischl heard about us from Valerina!","nextNodeIds":[705440115]},{"nodeId":705440115,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":2896982354,"text":"By your counsel, much thought have I given of late within Immernachtreich to realize the ingenuities obtained from prior experiences, and...","nextNodeIds":[705440116]},{"nodeId":705440116,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":3219998370,"text":"I have decided to select the most sagacious and sensible of cat familiars to accompany my eminent person on my sojourns!","nextNodeIds":[705440117]},{"nodeId":705440117,"roleType":"TALK_ROLE_NPC","speakerId":30527,"speakerName":"Dopey","textMapHash":2200548314,"text":"Meow~","nextNodeIds":[705440118]},{"nodeId":705440118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2728579442,"text":"Oh, so you were also planning on taking care of a cat, Fischl? Well, understandable. Most people want to have their own after seeing just so how adorable they are!","nextNodeIds":[705440119]},{"nodeId":705440119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":769725618,"text":"But Fischl, don't you already have Oz?","nextNodeIds":[705440120]},{"nodeId":705440120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":81344018,"text":"And the two of you tend to move really fast, can a cat keep up? Or... Are you gonna have Oz fly while carrying the cat?","nextNodeIds":[705440121]},{"nodeId":705440121,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":807718754,"text":"Hmph! I, the Prinzessin der Verurteilung, often traverse three thousand universes. Though such a journey may not be long, having more suitable companions and gaining insight into things easily overlooked... naturally wouldn't hurt.","nextNodeIds":[705440122]},{"nodeId":705440122,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":1729729810,"text":"Oz also would like to have a cat familiar to play... *cough* Ahem, to join forces with to guarantee that my mood shall shine bright as moonlight every second of every day!","nextNodeIds":[705440123]},{"nodeId":705440123,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":3917801970,"text":"Yet, 'tis a shame that though Oz went to great pains to don a form that sets most at ease, he could not diminish his majesty fully, and could not approach the cat familiars.","nextNodeIds":[705440124]},{"nodeId":705440124,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":3472854698,"text":"Whenever dear Oz gets within five paces of a cat familiar, their fur shall inadvertently stand on end and inflate like a Bloatty Floatty unmoored. Any closer, and terror overtakes them, and they flee for the hills.","nextNodeIds":[705440125]},{"nodeId":705440125,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":1656525634,"text":"The Anemo Archon's devoted and loyal nuns recommended that Oz repose without, and as their advice was sound, I graciously assented.","nextNodeIds":[705440126]},{"nodeId":705440126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2497414626,"text":"Majesty? Oh, right, Paimon gets it...","nextNodeIds":[705440127]},{"nodeId":705440127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3696403954,"text":"You mean that Oz's body has so much Electro energy that the second he enters the Furball Fortress, all the feline fur gets electri-fried, right?","nextNodeIds":[705440128]},{"nodeId":705440128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3765150546,"text":"But if that's true, then how could a cat ever travel with you, Fischl...?","nextNodeIds":[705440129]},{"nodeId":705440129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2243503730,"text":"If only there was some material in Teyvat that could block the effects of Electro!","nextNodeIds":[705440130]},{"nodeId":705440130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":758606546,"text":"Then we could make cat clothes out of that material, and then a cat could travel with you and Oz, no problem!","nextNodeIds":[705440131]},{"nodeId":705440131,"roleType":"TALK_ROLE_NPC","speakerId":30527,"speakerName":"Dopey","textMapHash":420961994,"text":"Meow?","nextNodeIds":[705440132,705440133]},{"nodeId":705440132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1895020338,"text":"Gimme! Give it to me first!","nextNodeIds":[705440134]},{"nodeId":705440134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4152129194,"text":"But now that Paimon thinks about it, elemental power is super-duper-mega strong! If there was a material that could just easily resist something as powerful as the elements... That would be too good to be true!","nextNodeIds":[705440135]},{"nodeId":705440135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":774706986,"text":"We probably shouldn't stand around daydreaming!","nextNodeIds":[705440136]},{"nodeId":705440136,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":257871274,"text":"Ah, the naivete! Do not jump to judge a cat familiar's talents through common sense! The semantic resources of mere mortal words struggle to accurately convey their properties.","nextNodeIds":[705440137]},{"nodeId":705440137,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":1372225490,"text":"Perhaps somewhere in this world there exists a cat familiar that can... dive deep into the depths, endure in an inferno, and ride upon the wind! Such a special entity would surely have no fear of thunder or lightning.","nextNodeIds":[705440138]},{"nodeId":705440138,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":2791521458,"text":"So long as I am patient in my search, I shall find it — forsooth, even if I should seek for ten years or a hundred, it shall be but a fleeting instant in the Immernachtreich!","nextNodeIds":[705440139]},{"nodeId":705440139,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":812985194,"text":"Additionally, the devotion to one's development in life is as important as the innate nature one is born with. I see this \"Dopey\" has immense potential. Perhaps after joining my retinue for a spell, it will become all the more familiar with the power of Electro!","nextNodeIds":[705440140]},{"nodeId":705440140,"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","textMapHash":3275036506,"text":"By happenstance, I, the Prinzessin, have disentangled a million myriad menial affairs, thus allowing myself a tincture of time to spare. Perhaps, then, it shall not hurt, endeavoring to stay here and familiarize myself with these cat familiars... particularly this \"Dopey\"!","nextNodeIds":[705440141]},{"nodeId":705440141,"roleType":"TALK_ROLE_NPC","speakerId":30527,"speakerName":"Dopey","textMapHash":4290730274,"text":"Meow!","nextNodeIds":[705440142]},{"nodeId":705440142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2033155682,"text":"Hehe! Then Paimon hopes you'll have fun here in the Furball Fortress, Fischl!","nextNodeIds":[]},{"nodeId":705440133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":377211034,"text":"Those Electro Slimes will be no match once I have donned this panoply of war!","nextNodeIds":[705440134]},{"nodeId":705440111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1519754322,"text":"I, the Great Cat Conjuror, sincerely pay my humble respects!","nextNodeIds":[705440112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7054401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30524,"speakerName":"Fischl","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":15},{"roleType":"TALK_ROLE_NPC","speakerId