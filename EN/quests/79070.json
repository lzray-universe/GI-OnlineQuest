{"mainQuestId":79070,"title":"","description":"","titleTextMapHash":3201841807,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":79070,"titleTextMapHash":3201841807,"title":"","descTextMapHash":3015850862,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ79070","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3015850862,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":79070,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2711126177,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ79070","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3201841807,"type":"WQ","unlockDescTextMapHash":4023365582}},"flow":[{"subQuestId":7907001,"order":1,"stepDescription":"","stepDescTextMapHash":4237333604,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7907001,7907002,7907003],"talks":[{"talkId":7907001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7907001,"initDialog":790700101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21471,21472,21470],"performCfg":"","priority":5,"questId":79070,"showRandomTalkCount":0},"dialogs":[{"nodeId":790700101,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":2356653938,"text":"Your Excellencies. I welcome you on behalf of the Kingdom of Breezes and Bells.","nextNodeIds":[790700102]},{"nodeId":790700102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3055210314,"text":"What will you do next?","nextNodeIds":[790700103]},{"nodeId":790700103,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":1067826370,"text":"Hmm... Well, first, I shall announce to all the people that the relic has passed judgment.","nextNodeIds":[790700104]},{"nodeId":790700104,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":745797530,"text":"And that the Guardian... will be Mr. Faurobert, who has come here from afar.","nextNodeIds":[790700105]},{"nodeId":790700105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3678602378,"text":"Huh!? Why would you do that?","nextNodeIds":[790700106]},{"nodeId":790700106,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":84900474,"text":"Trying to explain everything we've been through would be far too complicated.","nextNodeIds":[790700107]},{"nodeId":790700107,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":4142324490,"text":"Besides, it would take too long for them to grasp the concept of me being both a princess and a Guardian at the same time.","nextNodeIds":[790700108]},{"nodeId":790700108,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":809342050,"text":"When the time is right, I will make a detailed record of all that happened and then inform my people in writing.","nextNodeIds":[790700109]},{"nodeId":790700109,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":3212790154,"text":"But until then, I will still preside over all the affairs of the kingdom as its \"Princess.\"","nextNodeIds":[790700110]},{"nodeId":790700110,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":3551533882,"text":"Once those \"trial grounds\" have been officially converted into \"training grounds,\" I will set off.","nextNodeIds":[790700111,790700112]},{"nodeId":790700111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":727253114,"text":"Set off?","nextNodeIds":[790700113]},{"nodeId":790700113,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":3935197866,"text":"Your Highness, do you still remember... Who the relic actually lit up for back in the cave?","nextNodeIds":[790700114]},{"nodeId":790700114,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":2391911178,"text":"Hmm? Who it... actually lit up for?","nextNodeIds":[790700115]},{"nodeId":790700115,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":3677909458,"text":"Yes, as we were both next to it at the time. Of course, Your Highness fully deserves to be acknowledged, but I on the other hand... I...","nextNodeIds":[790700116]},{"nodeId":790700116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3163721714,"text":"You're a champion who's been acknowledged by a champion.","nextNodeIds":[790700117]},{"nodeId":790700117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":42881850,"text":"Exactly, and that champion came specifically to ask for your help! How could you possibly still think you're unworthy?","nextNodeIds":[790700118]},{"nodeId":790700118,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":664781610,"text":"*sigh* Maybe it's simply that you shine so brightly, Your Highness, that everyone was mistaken...","nextNodeIds":[790700119]},{"nodeId":790700119,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":2886663242,"text":"Pfft... Well then, Mr. Champion, would you be willing to undergo another trial?","nextNodeIds":[790700120]},{"nodeId":790700120,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":3412085418,"text":"I, Princess Cimest of the Kingdom of Breezes and Bells, shall personally bear witness to your deeds with this relic.","nextNodeIds":[790700121]},{"nodeId":790700121,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":1890567850,"text":"Of course! I do, I do, I do!","nextNodeIds":[790700122,790700123]},{"nodeId":790700122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2153454162,"text":"Hold your horses...","nextNodeIds":[790700124]},{"nodeId":790700124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1700005674,"text":"He gets so excited whenever he hears the princess's name. Hehe, Faurobert...","nextNodeIds":[790700125]},{"nodeId":790700125,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":330126746,"text":"Don't get me wrong! I—I'm doing this to fulfill the calling of Rainsong Pond! All that training I did, it was all to save... Uhh, I mean, protect Her Highness.","nextNodeIds":[790700126]},{"nodeId":790700126,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":2797179314,"text":"And it's such an important task, so naturally I must ensure that it all goes without a hitch...","nextNodeIds":[790700127]},{"nodeId":790700127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3641286946,"text":"Are you willing to travel together with Her Highness?","nextNodeIds":[790700128]},{"nodeId":790700128,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":2174536226,"text":"I—I am...","nextNodeIds":[790700129]},{"nodeId":790700129,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":4160357818,"text":"Hehe, that's good to hear. Well then, Mr. \"Champion\" Faurobert, are you ready for my trial?","nextNodeIds":[790700130]},{"nodeId":790700130,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":3618217930,"text":"I am, Your Highness! Whenever you're ready, I'm ready!","nextNodeIds":[790700131]},{"nodeId":790700131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":541142970,"text":"Whoa! The relic's lit up again, and it's super bright this time!","nextNodeIds":[]},{"nodeId":790700123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":977164018,"text":"My ears... It burns!","nextNodeIds":[790700124]},{"nodeId":790700112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":144227858,"text":"What are you going to do?","nextNodeIds":[790700113]}]},{"talkId":7907002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907001","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7907002,"initDialog":790700201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21466,21467,21469],"performCfg":"","priority":5,"questId":79070,"showRandomTalkCount":0},"dialogs":[{"nodeId":790700201,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":311596714,"text":"Estampe! Where have you been!?","nextNodeIds":[790700202]},{"nodeId":790700202,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"Estampe","textMapHash":2572689082,"text":"Uhh, actually, I was strolling about the area, and had a go at that trial. It was fun, but I had to adopt a slightly different approach to pass it.","nextNodeIds":[790700203]},{"nodeId":790700203,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"Estampe","textMapHash":343415610,"text":"Mr. Horellou has filled me in on everything that has happened to you. Not bad, Mr. Guardian. Turns out you're pretty talented after all, eh?","nextNodeIds":[790700204]},{"nodeId":790700204,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":4282260730,"text":"Y—Y—You... If you'd been standing next to me, I'd have pushed you off, I tell you! I'd have pushed you off ten times if I had the chance!","nextNodeIds":[790700205]},{"nodeId":790700205,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"Estampe","textMapHash":157999202,"text":"Hence why I decided to take part in the trial instead. Faurobert, my friend, I always believed you could do it. And look... You did it!","nextNodeIds":[790700206]},{"nodeId":790700206,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"Horellou","textMapHash":3906768010,"text":"Hahaha, you're jolly good fellows, the both of you. Today is an auspicious day for our pond!","nextNodeIds":[790700207]},{"nodeId":790700207,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"Horellou","textMapHash":2479476514,"text":"Finally, we have a true champion. Though Mr. Faurobert hasn't saved a princess yet, I believe that his chance will come.","nextNodeIds":[790700208]},{"nodeId":790700208,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":1064785922,"text":"*sigh* But I really didn't do anything, Mr. Horellou, other than standing by and watching as Her Highness did all the heavy lifting...","nextNodeIds":[790700209]},{"nodeId":790700209,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"Horellou","textMapHash":2815382226,"text":"Isn't that even better? Surely you didn't want the princess to be in danger?","nextNodeIds":[790700210]},{"nodeId":790700210,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":581896594,"text":"I... Uh...","nextNodeIds":[790700211]},{"nodeId":790700211,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"Horellou","textMapHash":2151965186,"text":"Ahh, that's quite enough, Mr. Faurobert. You were entrusted to fulfill the calling by Cibrelus himself!","nextNodeIds":[790700212]},{"nodeId":790700212,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":1096288618,"text":"Oh, pish posh! I'm not even sure if it was Cibrelus! After all, I've only ever heard of him, never heard him speak!","nextNodeIds":[790700213]},{"nodeId":790700213,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"Estampe","textMapHash":4060384546,"text":"And you even accepted the princess's trial. You're a champion if ever there was one.","nextNodeIds":[790700214]},{"nodeId":790700214,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":2168341954,"text":"Can we just... Not talk about this for now? Please...","nextNodeIds":[790700215]},{"nodeId":790700215,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"Horellou","textMapHash":1376563946,"text":"Anyway, to sum up — the future of Rainsong Pond is now in your capable hands!","nextNodeIds":[790700216]},{"nodeId":790700216,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"Horellou","textMapHash":1586816610,"text":"Now, we can simply enjoy jumping for jumping's own sake! When I get back, I'll suggest to the committee that we make \"fun\" the focus going forward!","nextNodeIds":[790700217]},{"nodeId":790700217,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"Estampe","textMapHash":861209290,"text":"That sounds like a proposal I'd be willing to get behind. On that note, let's head back.","nextNodeIds":[790700218]},{"nodeId":790700218,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"Faurobert","textMapHash":1800007066,"text":"Hey, don't leave me here!","nextNodeIds":[]}]},{"talkId":7907003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907001","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7907003,"initDialog":790700301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21470,21471,21472],"performCfg":"","priority":5,"questId":79070,"showRandomTalkCount":0},"dialogs":[{"nodeId":790700301,"roleType":"TALK_ROLE_NPC","speakerId":21471,"speakerName":"Saborn","textMapHash":1431940058,"text":"Both you and that paper frog were acknowledged as Guardians, Your Highness!?","nextNodeIds":[790700302]},{"nodeId":790700302,"roleType":"TALK_ROLE_NPC","speakerId":21472,"speakerName":"Souffache","textMapHash":3904706450,"text":"Unbelievable, unheard of! There is simply no precedent for this!","nextNodeIds":[790700303]},{"nodeId":790700303,"roleType":"TALK_ROLE_NPC","speakerId":21471,"speakerName":"Saborn","textMapHash":911642514,"text":"And you'll have to make changes to the trial too... No, don't do this, Your Highness!","nextNodeIds":[790700304]},{"nodeId":790700304,"roleType":"TALK_ROLE_NPC","speakerId":21472,"speakerName":"Souffache","textMapHash":3189932298,"text":"You can't simply overhaul such an ancient tradition on a whim, Your Highness!","nextNodeIds":[790700305]},{"nodeId":790700305,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":3191880002,"text":"Alright, alright, keep your voices down. My ears are starting to hurt...","nextNodeIds":[790700306]},{"nodeId":790700306,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":3284036258,"text":"It's all been decided already. Now, given that I am both a princess and a Guardian who has been acknowledged by the relic, you're in even less of a position to stop me.","nextNodeIds":[790700307]},{"nodeId":790700307,"roleType":"TALK_ROLE_NPC","speakerId":21471,"speakerName":"Saborn","textMapHash":672294202,"text":"But, Your Highness...","nextNodeIds":[790700308]},{"nodeId":790700308,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":1470396786,"text":"The both of you may relax. I'll host a ceremony to train up hosts of reliable flying squirrels to defend the kingdom.","nextNodeIds":[790700309]},{"nodeId":790700309,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":4269893370,"text":"Only after that will I leave the kingdom.","nextNodeIds":[790700310]},{"nodeId":790700310,"roleType":"TALK_ROLE_NPC","speakerId":21472,"speakerName":"Souffache","textMapHash":328156082,"text":"Your Highness, we... *sigh* You...","nextNodeIds":[790700311]},{"nodeId":790700311,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":2264598242,"text":"Don't worry, you two. I can take care of myself.","nextNodeIds":[790700312]},{"nodeId":790700312,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"Cimest","textMapHash":3898784234,"text":"As the princess, in the end it is I who shall face the wild winds of the world on my own.","nextNodeIds":[790700313]},{"nodeId":790700313,"roleType":"TALK_ROLE_NPC","speakerId":21471,"speakerName":"Saborn","textMapHash":1606033474,"text":"...As you wish, Your Highness.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"