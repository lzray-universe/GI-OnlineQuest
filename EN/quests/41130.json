":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4113001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4113001,"initDialog":411300101,"nextRandomTalks":[],"nextTalks":[4113004,4113005],"npcId":[30014],"performCfg":"","priority":1,"questId":41130,"showRandomTalkCount":0},"dialogs":[{"nodeId":411300101,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":842501162,"text":"Traveler, over here!","nextNodeIds":[411300102]},{"nodeId":411300102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2344855274,"text":"What's up?","nextNodeIds":[411300103]},{"nodeId":411300103,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":566142922,"text":"It's about Qingce Village again. Those meteorites that came down have caused the monsters around the village to go wild. They've been rampaging across the roads, and Qingce Village is on the verge of being surrounded by them.","nextNodeIds":[411300106]},{"nodeId":411300106,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":2963559130,"text":"While no major harm will befall Qingce Village so long as we guard it, the supplies we get from the city need to come in from the outside.","nextNodeIds":[411300107]},{"nodeId":411300107,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":845541586,"text":"Under the present circumstances, the Ministry of Civil Affairs can't send too many troops to escort those supplies. They would be in trouble if attacked by large groups of monsters.","nextNodeIds":[411300108]},{"nodeId":411300108,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":836975250,"text":"I and some of my compatriots gave this some thought... and while we can't go too far from Qingce Village, we can help to defeat the monsters near the village itself.","nextNodeIds":[411300109]},{"nodeId":411300109,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":1854374626,"text":"This way, we can help those who are escorting our supplies. However, our scouts tell us that there are quite a few points of monster concentration.","nextNodeIds":[411300110]},{"nodeId":411300110,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":3303553090,"text":"We'd be hard-pressed to take all these camps out in good time by ourselves. And I worry that something might happen to Qingce Village if we take too long...","nextNodeIds":[411300111]},{"nodeId":411300111,"roleType":"TALK_ROLE_NPC","speakerId":30014,"speakerName":"Jinglun","textMapHash":3713184586,"text":"Could you help us with a portion of the monsters, Traveler?","nextNodeIds":[]}]},{"talkId":4113004,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,