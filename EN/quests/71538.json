,"","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7153802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7153801,"initDialog":715380101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30684],"performCfg":"QuestDialogue/WQ/Liyue_71538/Q7153801","priority":5,"questId":71538,"showRandomTalkCount":0},"dialogs":[{"nodeId":715380101,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":2585856282,"text":"#Hello, {NICKNAME}. Happy Lantern Rite.","nextNodeIds":[715380102,715380103]},{"nodeId":715380102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3670321266,"text":"Are you... here for a case?","nextNodeIds":[715380104]},{"nodeId":715380104,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":863308642,"text":"I'm being forced to take a vacation.","nextNodeIds":[715380105]},{"nodeId":715380105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3396967202,"text":"Forced... to take a vacation?","nextNodeIds":[715380106]},{"nodeId":715380106,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":4130619962,"text":"The Maison Gardiennage stipulates that all employees are required to use our vacation time by the end of the year.","nextNodeIds":[715380107]},{"nodeId":715380107,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":4289297186,"text":"The end-of-year calculations came through, and the Patrol found out I hadn't taken a single day off, so...","nextNodeIds":[715380108,715380109]},{"nodeId":715380108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3852518490,"text":"Sounds like a demanding job...","nextNodeIds":[715380110]},{"nodeId":715380110,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":1461225218,"text":"No. Our officers operate on a rotating schedule, but as the captain of the squad, I'm always on duty.","nextNodeIds":[715380111]},{"nodeId":715380111,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":3094451274,"text":"I also deal with a lot of emergency cases, so over time, I just... forgot to take vacation.","nextNodeIds":[715380112]},{"nodeId":715380112,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":2082873690,"text":"I was fine going without any time off this year, but my officers wouldn't hear of it...","nextNodeIds":[715380113]},{"nodeId":715380113,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":864837250,"text":"They started shouting about how \"rules are meant to be followed\" and \"a captain needs to lead by example.\" Basically, they wouldn't take no for an answer.","nextNodeIds":[715380114]},{"nodeId":715380114,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":2422195122,"text":"One of the Gestionnaires who works with us mentioned how Liyue is a top vacation destination during the Lantern Rite festival. He pulled out a boat ticket right then and there, so... Here I am.","nextNodeIds":[715380115]},{"nodeId":715380115,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":2690203466,"text":"And I have to hand it to him — Liyue is a sight to behold this time of year. I just came back from Qiaoying Village, actually. I really loved the dim sum made with tea.","nextNodeIds":[715380116]},{"nodeId":715380116,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":2369996370,"text":"I bought some to share with the Special Patrol. I was planning to follow local customs and make a few gift envelopes, as well.","nextNodeIds":[715380117]},{"nodeId":715380117,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":1040665226,"text":"It's just... I'm not very good at this kind of thing. No matter what I do, it always ends up looking weird.","nextNodeIds":[715380118]},{"nodeId":715380118,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"Chevreuse","textMapHash":1476085506,"text":"#Do you know how to make them, {NICKNAME}?","nextNodeIds":[715380119]},{"nodeId":715380119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3392307066,"text":"I've got some suggestions...","nextNodeIds":[]},{"nodeId":715380109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3793214690,"text":"Is it like that for everyone?","nextNodeIds":[715380110]},{"nodeId":715380103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":117330218,"text":"You... don't look like you're here for work?","nextNodeIds":[715380104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[