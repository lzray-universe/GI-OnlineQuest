{"mainQuestId":72686,"title":"Go Forth, Golden Whirlwind!","description":"You have received no commissions from Katheryne, nor do you have appointments with any friends. And yet, in the darkness, a golden light leads you to a small island in the middle of the ocean. How strange. What in the world happened?","titleTextMapHash":3456062743,"descTextMapHash":800886406,"mainQuestExcel":{"mainQuestId":72686,"titleTextMapHash":3456062743,"title":"Go Forth, Golden Whirlwind!","descTextMapHash":800886406,"description":"You have received no commissions from Katheryne, nor do you have appointments with any friends. And yet, in the darkness, a golden light leads you to a small island in the middle of the ocean. How strange. What in the world happened?","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2012,"luaPath":"Actor/Quest/WQ72686","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2012,"chapterId":0,"descTextMapHash":800886406,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72686,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2657074177,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72686","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172686],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3456062743,"type":"WQ","unlockDescTextMapHash":2404347294}},"flow":[{"subQuestId":7268601,"order":1,"stepDescription":"Talk to Yasuhiko Tarou","stepDescTextMapHash":2949470828,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30167"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7268601],"talks":[{"talkId":7268601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7268601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268601,"initDialog":726860101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30167],"performCfg":"QuestDialogue/WQ/Inazuma_72686/Q7268601","priority":5,"questId":72686,"showRandomTalkCount":0},"dialogs":[{"nodeId":726860101,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3120580866,"text":"Might I ask for your name?","nextNodeIds":[726860102]},{"nodeId":726860102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4116108994,"text":"#I'm {NICKNAME}.","nextNodeIds":[726860103]},{"nodeId":726860103,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":2699771074,"text":"Good, I've written it down. May I ask if you are willing to put your honor as a warrior on the line?","nextNodeIds":[726860104,726860105]},{"nodeId":726860104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1295004850,"text":"Wait, what?","nextNodeIds":[726860106]},{"nodeId":726860106,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":950359706,"text":"Mm? Are you not, then, a warrior who has come forth to take part in this contest?","nextNodeIds":[726860107]},{"nodeId":726860107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":259251338,"text":"Never heard of such a thing.","nextNodeIds":[726860108]},{"nodeId":726860108,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3943919226,"text":"Have you not heard of the \"Clash of Lone Blades\"?","nextNodeIds":[726860109]},{"nodeId":726860109,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":1341072506,"text":"That can't be, I should have put up notices.","nextNodeIds":[726860110]},{"nodeId":726860110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1156039130,"text":"Where did you put them up?","nextNodeIds":[726860111]},{"nodeId":726860111,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":2868243178,"text":"Here.","nextNodeIds":[726860112]},{"nodeId":726860112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1669094618,"text":"C'mon, that's no use at all! No one's gonna see that, much less come over!","nextNodeIds":[726860113]},{"nodeId":726860113,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":1652301818,"text":"Hmph! This is all the Yashiro Commission's fault, what with their \"no weapons or fighting during the Irodori Festival\" nonsense. I applied to organize duels on Ritou, but they refused, and wouldn't let me put up advertisements, either.","nextNodeIds":[726860114]},{"nodeId":726860114,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":1799852570,"text":"So I could only put the arena here and place the sign nearby.","nextNodeIds":[726860115]},{"nodeId":726860115,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":1464014938,"text":"That said, we have already had 4 applicants. If we also include you, that makes 5.","nextNodeIds":[726860116]},{"nodeId":726860116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2229819786,"text":"#Huh, so people actually joined. That's odd. Speaking of which, Paimon can't quite remember why you came here either, {NICKNAME}...","nextNodeIds":[726860117]},{"nodeId":726860117,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":1639993282,"text":"The way I see it, you were able to find this place without any prior hints. This must mean that you are a warrior with a formidable spirit indeed.","nextNodeIds":[726860118]},{"nodeId":726860118,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":2213652586,"text":"Those who hanker after martial prowess will always be attracted to one another. This is the way of the world — and there is little need to be surprised by it.","nextNodeIds":[726860119]},{"nodeId":726860119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":941766522,"text":"Paimon has no idea what world you live in.","nextNodeIds":[726860120]},{"nodeId":726860120,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3049978586,"text":"Hehe. But still, would you be willing to take part?","nextNodeIds":[726860121]},{"nodeId":726860121,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":1032935314,"text":"If you can defeat each of the four challengers, you will receive a reward, as a matter of course.","nextNodeIds":[726860122]},{"nodeId":726860122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1897974586,"text":"I'll give it some consideration.","nextNodeIds":[726860123]},{"nodeId":726860123,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":21954394,"text":"Well then, please do take your time.","nextNodeIds":[]},{"nodeId":726860105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":867663426,"text":"Oh, no, no, have a nice day.","nextNodeIds":[726860106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGD