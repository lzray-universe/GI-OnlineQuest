H":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7181001],"talks":[{"talkId":7181001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"QuestDialogue/COOP/CoopBarbara/test3","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7181001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7181001,"initDialog":718100101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20088],"performCfg":"","priority":5,"questId":71810,"showRandomTalkCount":0},"dialogs":[{"nodeId":718100101,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1796794426,"text":"Ugh. How am I supposed to write my thesis like this? What should I do...","nextNodeIds":[718100102]},{"nodeId":718100102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":913039858,"text":"Are you okay?","nextNodeIds":[718100103]},{"nodeId":718100103,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1785733762,"text":"I— What? Oh! It's you! Do you still remember me?","nextNodeIds":[718100104]},{"nodeId":718100104,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1172651442,"text":"I was that, uh, person you found in a Treasure Hoarder cage down in Lingju Pass. Heh, in any case, thank you for saving me.","nextNodeIds":[718100105]},{"nodeId":718100105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1726147778,"text":"What brings you here?","nextNodeIds":[718100106]},{"nodeId":718100106,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3803852882,"text":"Well, uh, after being rescued by you, I went to look for Soraya at Wangshu Inn. By a stroke of luck, I was able to find her.","nextNodeIds":[718100107]},{"nodeId":718100107,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3185681378,"text":"Soraya's a really good person — not only did she treat me to a meal, but she also helped me re-organize my notes.","nextNodeIds":[718100108]},{"nodeId":718100108,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2413127482,"text":"But... she told me afterward that the topic that I'd chosen has already been the subject of many prior theses at the Akademiya.","nextNodeIds":[718100109]},{"nodeId":718100109,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":945382658,"text":"Unless I were to write an exceptional thesis, there's no way that I'll pass... She advised me to change angles — for example, I could write about something related to the elements.","nextNodeIds":[718100110]},{"nodeId":718100110,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2703226794,"text":"But since I don't have a Vision and can't use the elements, I have no idea where to begin...","nextNodeIds":[718100111]},{"nodeId":718100111,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3851148386,"text":"So there was nothing for it but to come to the city to try my luck and see if I could find any material here.","nextNodeIds":[718100112]},{"nodeId":718100112,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":810369922,"text":"Wait... When you saved me back then, you fought in a very unique manner...","nextNodeIds":[718100113]},{"nodeId":718100113,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":63511410,"text":"Do you have a Vision, by any chance?","nextNodeIds":[718100114]},{"nodeId":718100114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1477315258,"text":"No, I don't.","nextNodeIds":[718100115]},{"nodeId":718100115,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2400791202,"text":"Huh? You can fight in that manner without possessing a Vision? How can that be?","nextNodeIds":[718100116]},{"nodeId":718100116,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":576264130,"text":"No, never mind. It's a very long story, no doubt... Either way, I have something to ask of you.","nextNodeIds":[718100117]},{"nodeId":718100117,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":622912378,"text":"Could you demonstrate your manner of fighting to me? Perhaps I might discern something that can be used to refine my thesis...","nextNodeIds":[718100118]},{"nodeId":718100118,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1646452026,"text":"Please help me out! If I don't finish this thesis, I'll be dead meat when I return to the Akademiya...","nextNodeIds":[718100119,718100122]},{"nodeId":718100119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2681917834,"text":"Alright, sure...","nextNodeIds":[718100120]},{"nodeId":718100120,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":496725770,"text":"Thank you so much! Let's go outside, then.","nextNodeIds":[718100121]},{"nodeId":718100121,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1850727482,"text":"I recall noticing a group of hilichurls around these parts. Show me your fighting style, using them as your target!","nextNodeIds":[]},{"nodeId":718100122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":814901914,"text":"Is the Akademiya that scary a place?","nextNodeIds":[718100123]},{"nodeId":718100123,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3533157058,"text":"Oh, it's a very, very frightening place. I wake up sobbing every time I dream of it.","nextNodeIds":[718100124]},{"nodeId":718100124,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":29543122,"text":"I'd rather stay in that Treasure Hoarder cage than have to do another draft or thesis defense.","nextNodeIds":[718100125]},{"nodeId":718100125,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":86611346,"text":"Alright, that's enough about the Akademiya...","nextNodeIds":[718100126]},{"nodeId":718100126,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1256685698,"text":"I recall noticing a group of hilichurls around these parts. Show me your fighting style, using them as your target!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7181001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7181002,"order":2,"stepDescription":"Defeat all the hilichurls","stepDescTextMapHash":2411657044,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1331049161"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q71810Target0","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1331049161"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q71810