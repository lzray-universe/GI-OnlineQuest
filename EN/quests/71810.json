UEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q71810Target4","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1331049162"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q71810Target4","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7181009,"order":9,"stepDescription":"Speak to Alrani","stepDescTextMapHash":983370084,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7181003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["20088"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7181003],"talks":[{"talkId":7181003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7181009","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7181003,"initDialog":718100301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20088],"performCfg":"","priority":0,"questId":71810,"showRandomTalkCount":0},"dialogs":[{"nodeId":718100301,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":168371970,"text":"Haha, from the perspective of someone without a Vision like myself, I didn't notice your use of Elemental Sight at all...","nextNodeIds":[718100302]},{"nodeId":718100302,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2381126674,"text":"I suppose that might be something that only other Vision wielders can sense.","nextNodeIds":[718100303]},{"nodeId":718100303,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":20882058,"text":"Still, thanks for demonstrating so many things to me.","nextNodeIds":[718100304]},{"nodeId":718100304,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3664017610,"text":"*sigh* How I wish I had a Vision... Having an Electro Vision would be the best. Not only would it look cool, I could defend myself, too.","nextNodeIds":[718100305]},{"nodeId":718100305,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":4277390082,"text":"Hmm, no — an Electro Vision would probably be the least attainable of all...","nextNodeIds":[718100306]},{"nodeId":718100306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":220885066,"text":"I'm sure you can get one if you work hard.","nextNodeIds":[718100307]},{"nodeId":718100307,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2488822210,"text":"No, it won't happen, no matter how hard I work—","nextNodeIds":[718100308]},{"nodeId":718100308,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":709130082,"text":"Wait. Don't you know? It seems that nobody has obtained an Electro Vision for a whole year now.","nextNodeIds":[718100309]},{"nodeId":718100309,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1286007874,"text":"I've heard that the Akademiya has been researching this matter for a while now, and they have concluded that the lack of Electro Visions granted to mortals is the will of the Electro Archon.","nextNodeIds":[718100310]},{"nodeId":718100310,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1466357858,"text":"I've also heard it said that Inazuma's Electro Archon has proclaimed a \"Vision Hunt Decree,\" which has aimed to confiscate the majority of all Visions from Vision wielders throughout Inazuma.","nextNodeIds":[718100311]},{"nodeId":718100311,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":1636636778,"text":"Those who disobey and withhold their Visions will be punished severely...","nextNodeIds":[718100312]},{"nodeId":718100312,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3846870554,"text":"I once wanted to travel to Inazuma to write a thesis regarding this decree, but it really does seem dangerous over there...","nextNodeIds":[718100313]},{"nodeId":718100313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":982931818,"text":"You'll be fine. You don't have a Vision.","nextNodeIds":[718100314]},{"nodeId":718100314,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2957889434,"text":"H—Hey, don't say that! Just think about it, if people with Visions are already suffering, don't you think that those who go without would be even worse off?","nextNodeIds":[718100315]},{"nodeId":718100315,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":4154300874,"text":"I suppose I should just stay here in Liyue and finish my thesis in peace, then report back to the Akademiya in Sumeru with my findings as soon as possible. If I delay any longer, I won't hear the end of it...","nextNodeIds":[718100316]},{"nodeId":718100316,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":3778994026,"text":"Ah, right, I still have to thank you for showing me so many things. Take these as tokens of my appreciation.","nextNodeIds":[718100317]},{"nodeId":718100317,"roleType":"TALK_ROLE_NPC","speakerId":20088,"speakerName":"Alrani","textMapHash":2336738034,"text":"I'll finish my thesis this time for sure!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7181003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133104916"],"PAINLIBBLDK":"QUEST