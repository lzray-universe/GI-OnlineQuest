odeIds":[732090403,732090404]},{"nodeId":732090403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1608348730,"text":"The wish has finally been fulfilled.","nextNodeIds":[732090405]},{"nodeId":732090405,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3012168746,"text":"I finally did something right in the end. Uncle Shafaqat, I've helped you fulfill your wish.","nextNodeIds":[732090406]},{"nodeId":732090406,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":156821098,"text":"It's a shame he is no longer around to see it.","nextNodeIds":[732090407]},{"nodeId":732090407,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":148059162,"text":"Don't say that, Sabbah. Do you remember the last stanza of the rose song?","nextNodeIds":[732090408]},{"nodeId":732090408,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1911732514,"text":"\"No land but folk songs bore my spirit.\"","nextNodeIds":[732090409]},{"nodeId":732090409,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2203164810,"text":"\"Songs shall defy my fate, and overcome my destiny.\"","nextNodeIds":[732090410]},{"nodeId":732090410,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3887646290,"text":"\"They will surpass me, surpass time. They will surpass the ever-lasting withering of life.\"","nextNodeIds":[732090411]},{"nodeId":732090411,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":21790258,"text":"Uncle Shafaqat's life, the Golden Roses, and the folk song he composed himself — they have all remained with us.","nextNodeIds":[732090412]},{"nodeId":732090412,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3906831626,"text":"Yeah, you're right. He has surpassed time and the withering of life.","nextNodeIds":[732090413]},{"nodeId":732090413,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3287101970,"text":"Thank you for telling me about him. This means a lot to me.","nextNodeIds":[732090414]},{"nodeId":732090414,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2888303642,"text":"He was an exile before me, and seeing the traces of his life here always makes me feel like I've crossed through time and space...","nextNodeIds":[732090415]},{"nodeId":732090415,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3436761298,"text":"I'm not just looking at him. I'm looking at myself too.","nextNodeIds":[732090416]},{"nodeId":732090416,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":605248346,"text":"I can no longer say anything to him, but I can shoulder his regrets and live on.","nextNodeIds":[732090417]},{"nodeId":732090417,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3773632026,"text":"If I live on for him too, then I'm sure that I will eventually find my own salvation.","nextNodeIds":[732090418,732090419]},{"nodeId":732090418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3751424218,"text":"I wish you happiness.","nextNodeIds":[732090420]},{"nodeId":732090420,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":749379002,"text":"I don't feel so bad living here anymore. I'm... so glad I met you all.","nextNodeIds":[732090421]},{"nodeId":732090421,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3357805242,"text":"Roses truly are flowers that can bring people happiness. Mr. Affan, we shall have to work hard and plant more roses here in the future.","nextNodeIds":[732090422]},{"nodeId":732090422,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2616349898,"text":"Hahaha! Well then, you have a deal.","nextNodeIds":[732090423]},{"nodeId":732090423,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1573695274,"text":"Mm, I'll do my best.","nextNodeIds":[]},{"nodeId":732090419,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3001382562,"text":"Keep your chin up.","nextNodeIds":[732090420]},{"nodeId":732090404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2120976466,"text":"It was all worth it.","nextNodeIds":[732090405]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320904,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["73223","4"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["73275","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4233"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7320905,"order":6,"stepDescription":"Use the power of Dendro to \"awaken\" the Golden Rose","stepDescTextMapHash":3528489996,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320905,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false