","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4178"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2302701,2302702,2302703],"talks":[{"talkId":2302701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2302701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["42030","0","0","",""],"type":"QUEST_COND_DAILY_TASK_VAR_EQ"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2302701,"initDialog":230270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4178],"performCfg":"QuestDialogue/IQ/Sumeru_23027/Q2302701","priority":5,"questId":23027,"showRandomTalkCount":0},"dialogs":[{"nodeId":230270101,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1936895938,"text":"Looks like it does need some proper care...","nextNodeIds":[230270102]},{"nodeId":230270102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3836096786,"text":"What are you doing?","nextNodeIds":[230270103]},{"nodeId":230270103,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2486070082,"text":"You are... Huh. Judging by your looks, you must be a traveler, yes?","nextNodeIds":[230270104]},{"nodeId":230270104,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":40131434,"text":"I'm Yasmin, a student from Amurta. I'm here to study the Divine Tree.","nextNodeIds":[230270105]},{"nodeId":230270105,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":3683041482,"text":"The years this Divine Tree has seen exceed the total amount of rice grains contained in all the pilaf in Port Ormos.","nextNodeIds":[230270106]},{"nodeId":230270106,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":67861514,"text":"It also holds the Akademiya up. It can be said to be as important as the vegetables at the bottom of Tandoori Roast Chicken.","nextNodeIds":[230270107,230270108]},{"nodeId":230270107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2481795746,"text":"What kind of simile is this...","nextNodeIds":[230270110]},{"nodeId":230270110,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2796502674,"text":"If anything untoward were to happen to it, Sumeru City in its entirety would face terrible disasters.","nextNodeIds":[230270111]},{"nodeId":230270111,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":315631130,"text":"It might be harried by pests, or locusts bigger than a roof might rush out from the inside...","nextNodeIds":[230270112]},{"nodeId":230270112,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2291454170,"text":"Or the branches might go into a growing frenzy, and the roots might sprout outward like floods from the earth, destroying every house in its path.","nextNodeIds":[230270113]},{"nodeId":230270113,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":880791266,"text":"Or maybe the Divine Tree might wither so very quickly that its trunk falls on half of Sumeru City, crushing everything there...","nextNodeIds":[230270114]},{"nodeId":230270114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4076291218,"text":"Th—Those things aren't really gonna happen, right!?","nextNodeIds":[230270115]},{"nodeId":230270115,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2318246402,"text":"Oh, of course. Or at least, everything has been totally fine so far.","nextNodeIds":[230270116]},{"nodeId":230270116,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2738234618,"text":"But then again, it's not like the fungal beasts will warn you in advance before attacking you while you gather mushrooms in the forests.","nextNodeIds":[230270117]},{"nodeId":230270117,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2032459154,"text":"That's why I'm here: to observe the tree and prepare for any incidents that might come our way.","nextNodeIds":[230270118]},{"nodeId":230270118,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":3941275562,"text":"But as you can see, my thoughts are as swift as a Dusk Bird, yet my strength is as feeble as a Starshroom.","nextNodeIds":[230270119]},{"nodeId":230270119,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1088509258,"text":"So, Traveler, could you help me record the condition of the Divine Tree's roots at a few locations?","nextNodeIds":[230270120]},{"nodeId":230270120,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1662402010,"text":"Usually, I hire adventurers to go with me, but no one seems to have been available this time around...","nextNodeIds":[230270121,230270122]},{"nodeId":230270121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":374409930,"text":"Leave it to me.","nextNodeIds":[]},{"nodeId":230270122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3859488954,"text":"Do you researchers all talk like that...","nextNodeIds":[230270123]},{"nodeId":230270123,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1953268626,"text":"Eh? Are you referring to the similes I'm using? Sorry about that. It's just how I talk...","nextNodeIds":[230270124]},{"nodeId":230270124,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":306524538,"text":"People in the Akademiya have also talked to me about this, but I can't just change at the drop of a hat!","nextNodeIds":[230270125]},{"nodeId":230270125,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":855122402,"text":"I'm counting on you this time. I'll be waiting for you here.","nextNodeIds":[]},{"nodeId":230270108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2559797522,"text":"This is your kind of analogy, eh, Paimon?","nextNodeIds":[230270109]},{"nodeId":230270109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3289449850,"text":"Yeah, it is a great tree indeed...","nextNodeIds":[230270110]}]},{"talkId":2302702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2302701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["42030","0","0","",""],"type":"QUEST_COND_DAILY_TASK_VAR_GT"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2302702,"initDialog":230270201,"nextRandomTalks":[],"nextTalks":[],"npcId":[4178],"performCfg":"","priority":5,"questId":23027,"showRandomTalkCount":0},"dialogs":[{"nodeId":230270201,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":355876754,"text":"Traveler, what a coincidence. We meet again.","nextNodeIds":[230270202]},{"nodeId":230270202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":427315794,"text":"Are you still doing your research?","nextNodeIds":[230270203]},{"nodeId":230270203,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":3212937842,"text":"Yes. Ladep and Pharez requested more data, so here I am, continuing my work.","nextNodeIds":[230270204]},{"nodeId":230270204,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1227134282,"text":"That said, I wonder how those roots are doing right now...","nextNodeIds":[230270205]},{"nodeId":230270205,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2670881898,"text":"Traveler, if you would, please help me record the conditions of the Divine Tree roots once again.","nextNodeIds":[]}]},{"talkId":2302703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2302701","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2302711","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","",