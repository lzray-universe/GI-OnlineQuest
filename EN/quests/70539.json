{"mainQuestId":70539,"title":"Furball Fortress's Frightful Fix!","description":"Your recent travels have seen you and Paimon encounter all manner of strange creatures, but in light of various factors, Paimon would still like to have some fun with cats.\\nAs such, you intend to return to Mondstadt and drop by The Cat's Tail...","titleTextMapHash":226446895,"descTextMapHash":3548287534,"mainQuestExcel":{"mainQuestId":70539,"titleTextMapHash":226446895,"title":"Furball Fortress's Frightful Fix!","descTextMapHash":3548287534,"description":"Your recent travels have seen you and Paimon encounter all manner of strange creatures, but in light of various factors, Paimon would still like to have some fun with cats.\\nAs such, you intend to return to Mondstadt and drop by The Cat's Tail...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5183,"luaPath":"Actor/Quest/WQ70539","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5183,"chapterId":0,"descTextMapHash":3548287534,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70539,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3217090209,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70539","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170539],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":226446895,"type":"WQ","unlockDescTextMapHash":2163407278}},"flow":[{"subQuestId":7053903,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053903,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053903,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7053901,"order":2,"stepDescription":"Go to The Cat's Tail entrance","stepDescTextMapHash":2186317508,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1431"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7053901],"talks":[{"talkId":7053901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7053901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7053901,"initDialog":705390101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1431,30531],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7053901","priority":5,"questId":70539,"showRandomTalkCount":0},"dialogs":[{"nodeId":705390101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":719411194,"text":"Looks like Margaret is talking with those two people over there.","nextNodeIds":[705390102]},{"nodeId":705390102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":354715202,"text":"Wait, is that Rosaria? Huh, she's standing next to an Adventurer Paimon doesn't recognize.","nextNodeIds":[705390103,705390104]},{"nodeId":705390103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1230572786,"text":"Think she's also here to play with some cats?","nextNodeIds":[705390105]},{"nodeId":705390105,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":124598426,"text":"Say no more, Valerina. I'll continue to help you out, just as Victoria requested.","nextNodeIds":[705390106]},{"nodeId":705390106,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":1542683946,"text":"Look after the cats, check up on their health, give them a bath... These are all things well within my capabilities.","nextNodeIds":[705390107]},{"nodeId":705390107,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2281091250,"text":"That doesn't solve our biggest problem, though, Miss Rosaria! The cats have been so anxious. If we can't get them to trust us...","nextNodeIds":[705390108]},{"nodeId":705390108,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2607546298,"text":"They're sure to get sick from all the anxiety. We just opened, and the \"Furball Fortress\" is already about to go under!","nextNodeIds":[705390109]},{"nodeId":705390109,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2708718834,"text":"Well, panicking certainly isn't going to solve the problem. The fact is, neither of us has a way with cats. That's not something I can change.","nextNodeIds":[705390110]},{"nodeId":705390110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1374678794,"text":"Hi, Rosaria! And hello to you too, Miss Adventurer!","nextNodeIds":[705390111]},{"nodeId":705390111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4031979530,"text":"Sounds like you are all really worried about something.","nextNodeIds":[705390112]},{"nodeId":705390112,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":20551306,"text":"Our cat saviors! They've appeared already!","nextNodeIds":[705390113]},{"nodeId":705390113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3875284554,"text":"Eh... \"Saviors\"? Seems a bit sudden considering we just met...","nextNodeIds":[705390114,705390115]},{"nodeId":705390114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1095965914,"text":"Sounds like a title we'll have to live up to!","nextNodeIds":[705390116]},{"nodeId":705390116,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":438032130,"text":"I'll try to keep it short. My name's Valerina, and I really like small animals. Recently, I've been trying to set up a shelter for stray cats. I call it the \"Furball Fortress.\"","nextNodeIds":[705390117]},{"nodeId":705390117,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3761562314,"text":"I thought it would be a good way to rescue those poor animals that have nowhere to go. Plus, getting them off the streets will improve the overall environment and look of the city. It's a win-win!","nextNodeIds":[705390118]},{"nodeId":705390118,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3408461154,"text":"The sisters over at the Church heard about my plans, and sent over the kindly Miss Rosaria to help.","nextNodeIds":[705390119]},{"nodeId":705390119,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2444858490,"text":"I wouldn't exactly describe myself as \"kindly.\" I just accepted the assignment from Victoria. After all, I was the only one with any knowledge of medicine, or the spare time to help.","nextNodeIds":[705390120]},{"nodeId":705390120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2512220898,"text":"Well, it seems like you've got quite the plan, Valerina. Thanks for bringing us up to speed!","nextNodeIds":[705390121]},{"nodeId":705390121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2830720146,"text":"So, what had you so worried just now? Are you short on Mora? Are you missing something you need?","nextNodeIds":[705390122]},{"nodeId":705390122,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3306034466,"text":"No, I've got more than enough Mora. The funds, the location, the supplies, all the various procedures... They've all been settled!","nextNodeIds":[705390123]},{"nodeId":705390123,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":4092204834,"text":"The main problem is, um... The cats... They, uh, keep swatting at me.","nextNodeIds":[705390124]},{"nodeId":705390124,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":1822109186,"text":"They're always hissing and swatting... They won't let me approach them, not even with treats.","nextNodeIds":[705390125]},{"nodeId":705390125,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2293004018,"text":"The cats are afraid of me as well. They run away the minute I'm in the vicinity.","nextNodeIds":[705390126]},{"nodeId":705390126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1522987530,"text":"Oh, Paimon has heard something like this before. There's something about certain people that just makes cats afraid...","nextNodeIds":[705390127]},{"nodeId":705390127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3906388162,"text":"Huh, a kind-hearted cat rescuer who doesn't get along with cats... Seems like just visiting The Cat's Tail would be enough to leave you flustered, let alone running your own cat shelter...","nextNodeIds":[705390128]},{"nodeId":705390128,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2304011906,"text":"That's why we consulted an expert! But, Miss Margaret wasn't able to offer a solution to our problem. She's short on workers, so she couldn't spare anyone to help us either...","nextNodeIds":[705390129]},{"nodeId":705390129,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2125645474,"text":"She did give us one piece of advice, though — to enlist the help of the Honorary Knight and their trusty Helper in White!","nextNodeIds":[705390130]},{"nodeId":705390130,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2736121890,"text":"We had just wrapped up our conversation, and the next thing we knew, you two appeared before us like saviors sent by Lord Barbatos himself!","nextNodeIds":[705390131]},{"nodeId":705390131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":479061970,"text":"Well, Paimon's not sure how much Lord Barbatos would know about taking care of cats... But that aside, we've never even worked at a shelter before, but somehow we've been turned into the saviors of the entire operation...","nextNodeIds":[705390132,705390133]},{"nodeId":705390132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":324601474,"text":"It's perfect timing, though, no?","nextNodeIds":[705390134]},{"nodeId":705390134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4095808866,"text":"Well, that's true! Even if Paimon has no experience working at a shelter, she's confident she can get on their good side just fine!","nextNodeIds":[705390135]},{"nodeId":705390135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1556928266,"text":"Like, that's all we need to do here, right? We just need to show Valerina and Rosaria how to get friendly with the cats, and everything else should fall into line!","nextNodeIds":[705390136]},{"nodeId":705390136,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":826377330,"text":"Feel free to focus your efforts on Valerina. Just call me if any of the cats need medical attention.","nextNodeIds":[705390137]},{"nodeId":705390137,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":1509615298,"text":"Hmm, if you all can keep the shelter running with minimal effort on my part...","nextNodeIds":[705390138]},{"nodeId":705390138,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2740815202,"text":"This errand might turn out to be a good use of my time after all. It's better than church activities, in any case.","nextNodeIds":[705390139]},{"nodeId":705390139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3434026290,"text":"Ah, so that's why you agreed to help. You just wanted to shirk your church duties...","nextNodeIds":[705390140]},{"nodeId":705390140,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2390881962,"text":"Well, I guess I should show you around first. Follow me, you two. Let's make our way to the \"Furball Fortress\"!","nextNodeIds":[]},{"nodeId":705390133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2804785530,"text":"We were just talking about playing with cats.","nextNodeIds":[705390134]},{"nodeId":705390115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3807161866,"text":"I smell a commission coming!","nextNodeIds":[705390116]},{"nodeId":705390104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1266753026,"text":"Think she's also here to play some cards?","nextNodeIds":[705390105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","1160,1159"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1431"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7053902,"order":3,"stepDescription":"Go to the Furball Fortress","stepDescTextMapHash":1327694140,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[1090_1:-0.084,0.000,8.221]"],"NOCCOBOFKHP":1090,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7053902],"talks":[{"talkId":7053902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7053902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7053902,"initDialog":705390201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30531],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7053902","priority":5,"questId":70539,"showRandomTalkCount":0},"dialogs":[{"nodeId":705390201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2480781234,"text":"Oh, it's just a regular house. Gotta say, Paimon was expecting something a little bigger with \"Fortress\" in the name and everything.","nextNodeIds":[705390202]},{"nodeId":705390202,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":183915986,"text":"This was the biggest space I could find in the city over the past few weeks. The rent is cheap, so that's a plus. A half a year's worth of rent along with all the Cat's Tail-inspired furnishings only cost me a few million Mora.","nextNodeIds":[705390203]},{"nodeId":705390203,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3505278442,"text":"Of course, not all of the cats will be staying indefinitely. We plan to offer some of the healthy ones up for adoption. As long as the new future owners prove capable and the cat seems like a good fit, they're welcome to take their new pet back to a loving home!","nextNodeIds":[705390204]},{"nodeId":705390204,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2295891714,"text":"This location is definitely good enough. We could even expand the business one day and start sheltering stray dogs, foxes, or even squirrels! When that day comes, though, I'll probably have to think of a different name. Hmm, maybe the \"Furball and Friends Fortress\" would be a better fit, haha.","nextNodeIds":[705390205]},{"nodeId":705390205,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":1647310330,"text":"I would suggest letting all of this play out first. You still don't know if the customers will even get along with the strays.","nextNodeIds":[705390206]},{"nodeId":705390206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1285153218,"text":"Huh? Look over there! That cat is staring at us...","nextNodeIds":[705390207]},{"nodeId":705390207,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":868307882,"text":"Oh, it's the little white cat! She's super afraid of people. She ran away when we tried to give her a bath. It took us forever to track her down again.","nextNodeIds":[705390208]},{"nodeId":705390208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1297975546,"text":"She looks so soft and clean, and her fur is so white and fluffy, just like fresh fallen snow. Wait, that's perfect! We should call her \"Snowball\"!","nextNodeIds":[705390209,705390210]},{"nodeId":705390209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2994236266,"text":"\"Tofu\" would also be a good fit!","nextNodeIds":[705390211]},{"nodeId":705390211,"roleType":"TALK_ROLE_NPC","speakerId":30525,"speakerName":"Snowball","textMapHash":876373202,"text":"Meow~ meow~!","nextNodeIds":[705390212]},{"nodeId":705390212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3992324682,"text":"#Those are also some good names, {NICKNAME}, but Paimon thinks she likes \"Snowball\" best!","nextNodeIds":[705390213]},{"nodeId":705390213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1876219290,"text":"Here, kitty kitty. That's it, Snowball! Good kitty. That's a good kitty...","nextNodeIds":[705390214]},{"nodeId":705390214,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":1872893610,"text":"I—It's been, what, a minute? And you already got the cat to listen to you! Did you see that, Miss Rosaria? She's practically a miracle worker! You really are a cat whisperer...","nextNodeIds":[705390215]},{"nodeId":705390215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":930955530,"text":"That was nothing! They may be strays, but as long as you give them a good name and call on them with love, you're sure to gain their trust eventually!","nextNodeIds":[705390216]},{"nodeId":705390216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1462151794,"text":"First things first, though, you gotta pay attention to the way you interact with them. Hmm, how should Paimon put it... Basically, it all comes down to your demeanor!","nextNodeIds":[705390217]},{"nodeId":705390217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1150810010,"text":"For example, you can't just stand there trembling in fear, Valerina. If you're afraid, the cats are sure to become afraid as well! As for you, Rosaria, you might want to keep an eye on your, uh... facial expressions...","nextNodeIds":[705390218]},{"nodeId":705390218,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2655143722,"text":"These poor creatures, picked up off the streets, given a name... and they now have a loving home. Fate is kind to even the lost souls who have wandered astray...","nextNodeIds":[705390219]},{"nodeId":705390219,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2444320178,"text":"This city really has brought peace and happiness to us all.","nextNodeIds":[705390220]},{"nodeId":705390220,"roleType":"TALK_ROLE_NPC","speakerId":30525,"speakerName":"Snowball","textMapHash":4148216522,"text":"Meow!","nextNodeIds":[705390221]},{"nodeId":705390221,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3262713738,"text":"Hey, Snowball is snuggling up to Rosaria! Looks like she's not afraid of her anymore!","nextNodeIds":[705390222]},{"nodeId":705390222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1101462946,"text":"(Did Rosaria just... smile?)","nextNodeIds":[705390223,705390224]},{"nodeId":705390223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1981318554,"text":"(I saw it too!)","nextNodeIds":[705390225]},{"nodeId":705390225,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":2627936402,"text":"No matter. There are more important things to focus on.","nextNodeIds":[705390226]},{"nodeId":705390226,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"Rosaria","textMapHash":281937626,"text":"Anyway, it's getting a bit stuffy in here. I'm going to go get some air. Call me if you need me.","nextNodeIds":[705390227]},{"nodeId":705390227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":360221970,"text":"Huh, Paimon thought Rosaria would be happier about that...","nextNodeIds":[705390228]},{"nodeId":705390228,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":2296565282,"text":"Please teach me more of your ways, Honorary Knight! And you too, o great cat whisperer!","nextNodeIds":[705390229]},{"nodeId":705390229,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":1946726546,"text":"We're sure to get more and more strays coming to the \"Furball Fortress,\" and I doubt all of them will be as friendly as Snowball. There's still so much I don't know about interacting with them...","nextNodeIds":[705390230]},{"nodeId":705390230,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3328059938,"text":"No problem! Just watch and learn!","nextNodeIds":[705390231]},{"nodeId":705390231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2423162674,"text":"It's about time we move on to a more advanced lesson — how to get the cats not to just trust you, but to like you!","nextNodeIds":[705390232]},{"nodeId":705390232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3990508482,"text":"It's all about patience! As long as you put in the effort to get to know them, you'll become best friends in no time!","nextNodeIds":[705390233]},{"nodeId":705390233,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3631934738,"text":"I completely understand! The Furball Fortress is still in its trial phase, so the more I can learn at this stage, the better!","nextNodeIds":[]},{"nodeId":705390224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":989296850,"text":"(We should pretend like we didn't see anything!)","nextNodeIds":[705390225]},{"nodeId":705390210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1128305090,"text":"\"Pudding\" isn't a bad choice either!","nextNodeIds":[705390211]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions"