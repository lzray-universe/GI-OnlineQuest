XEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7052902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7052902,"initDialog":705290201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30046],"performCfg":"QuestDialogue/WQ/70529/Q7052902","priority":5,"questId":70529,"showRandomTalkCount":0},"dialogs":[{"nodeId":705290201,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":2206436386,"text":"Hello there, and welcome to the Windblume Festival. You've come at a good time — we're currently organizing a little game known as \"Ballads of Breeze.\"","nextNodeIds":[705290202]},{"nodeId":705290202,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":429306650,"text":"Taking part in this game will allow you to play some lovely tunes, just like the bards of Mondstadt...","nextNodeIds":[705290203,705290204]},{"nodeId":705290203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2553539330,"text":"How can I measure up to bards...?","nextNodeIds":[705290205]},{"nodeId":705290205,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":2547381906,"text":"Oh, don't you worry! We've had, um, lots of play-testers in the past!","nextNodeIds":[705290206]},{"nodeId":705290206,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":4193251794,"text":"Even someone with zero knowledge of how to play instruments will be able to play something that... uh, won't sound too bad...","nextNodeIds":[705290207]},{"nodeId":705290207,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":207702546,"text":"Please, believe me. Have faith in the Knights of Favonius!","nextNodeIds":[705290208]},{"nodeId":705290208,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":35283146,"text":"As long as you do your best to keep up with the rhythm and beat, you'll be able to strum up a storm with ease.","nextNodeIds":[705290209]},{"nodeId":705290209,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":2121840290,"text":"Focus only on the wind around you and the lovely song you wish to play, and all your troubles will surely fade away.","nextNodeIds":[705290210]},{"nodeId":705290210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1271385298,"text":"Well, I imagine bards must be quite carefree, then.","nextNodeIds":[705290211]},{"nodeId":705290211,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":529451938,"text":"Hahaha, I wouldn't say that for sure! After all, they do fret about whether their songs will move people enough to fork some Mora over.","nextNodeIds":[705290212]},{"nodeId":705290212,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":178666434,"text":"As for you... You just need to play to your heart's content.","nextNodeIds":[705290213]},{"nodeId":705290213,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":699972602,"text":"W—Well, uh, never mind what I just said! I hope you know how this works by now, yes? Well, if it interests you, you're free to give it a go.","nextNodeIds":[705290214]},{"nodeId":705290214,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":3975694170,"text":"You can use your own instrument to play said tunes, and if you haven't brought one, we can lend you some...","nextNodeIds":[705290215]},{"nodeId":705290215,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":4087075594,"text":"Hehe... not to brag, but we do have quite a few on hand here, and each of them is quite different from the rest.","nextNodeIds":[705290216]},{"nodeId":705290216,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":2746939578,"text":"Which of the instruments would you like to use first?","nextNodeIds":[705290217,705290218,705290219]},{"nodeId":705290217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":678719074,"text":"The Windsong Lyre.","nextNodeIds":[705290220]},{"nodeId":705290220,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":2950964682,"text":"Oh, this one, then? No problem!","nextNodeIds":[705290221]},{"nodeId":705290221,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":703511514,"text":"Oh, and there's one more thing I forgot to mention! Please wait for a moment, I need to consult my notes...","nextNodeIds":[705290222]},{"nodeId":705290222,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":1347243154,"text":"Hmm, right... In order to make sure that everyone is able to play the best they can, we've decided to implement a \"tuning\" phase to this game.","nextNodeIds":[705290223]},{"nodeId":705290223,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":3270052418,"text":"Simply put, we mean to help you tune your instrument to be in the best state possible. Don't worry, it's easy. The first step should be...","nextNodeIds":[705290224]},{"nodeId":705290224,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":1180296578,"text":"Alright! That should do it. Your instrument's all tuned up, and the musical scores should be ready as well.","nextNodeIds":[705290225]},{"nodeId":705290225,"roleType":"TALK_ROLE_NPC","speakerId":30046,"speakerName":"Lizzie","textMapHash":2681378986,"text":"You can start any time now — so long as you want to, of course.","nextNodeIds":[]},{"nodeId":705290218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3118501666,"text":"The Floral Zither.","nextNodeIds":[705290220]},{"nodeId":705290219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3263584098,"text":"The Festive Drum.","nextNodeIds":[705290220]},{"nodeId":705290204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2451687362,"text":"Will I really sound good...?","nextNodeIds":[705290205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30046"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7052902