ceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7613801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7613801,"initDialog":761380101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7046],"performCfg":"QuestDialogue/WQ/NodKrai_76138/Q7613801","priority":5,"questId":76138,"showRandomTalkCount":0},"dialogs":[{"nodeId":761380101,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":2683217426,"text":"Lady Nefer! What a coincidence, you've come at just the right time...","nextNodeIds":[761380102]},{"nodeId":761380102,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":986197106,"text":"You've made up your mind, then?","nextNodeIds":[761380103]},{"nodeId":761380103,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1430612594,"text":"Huh? Made up my mind...? Wh-what do you mean, could it be...?","nextNodeIds":[761380104]},{"nodeId":761380104,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3166890050,"text":"I know you've always wanted to visit the Frostmoon Scions.","nextNodeIds":[761380105]},{"nodeId":761380105,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3564909042,"text":"You hope to get acquainted with Lyylikki first, and use that friendship as your stepping stone.","nextNodeIds":[761380106]},{"nodeId":761380106,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3045807490,"text":"You... you knew it all along? But I've kept it locked in my heart and barely told anyone...","nextNodeIds":[761380107]},{"nodeId":761380107,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3944332866,"text":"Well, Mr. Zompaynco, when you guard a secret, you must also learn to hide the fact that you're guarding one.","nextNodeIds":[761380108]},{"nodeId":761380108,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":704850738,"text":"Otherwise, no matter how tall a wall you build in your heart, sooner or later the wind will find its cracks.","nextNodeIds":[761380109]},{"nodeId":761380109,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3975872458,"text":"*sigh* I was never good at keeping my feelings bottled up, even back when I was still in my hometown.","nextNodeIds":[761380110]},{"nodeId":761380110,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1674384818,"text":"Well, now that you know, could you help me make an introduction? I'm an outsider, and I don't want to intrude on Miss Lyylikki.","nextNodeIds":[761380111]},{"nodeId":761380111,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":530217082,"text":"Rest assured. The Frostmoon Scions are exceptionally gracious — whether one arrives as a stranger or in a form not entirely human, they will extend a warm and courteous welcome.","nextNodeIds":[761380112]},{"nodeId":761380112,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1283411730,"text":"Huh? Is that so...?","nextNodeIds":[761380113]},{"nodeId":761380113,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1315769570,"text":"But still, it wouldn't be proper to just barge in. Lady Nefer, could you introduce me?","nextNodeIds":[761380114]},{"nodeId":761380114,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1987400778,"text":"Alright. Judging by the time, they should have just finished distributing the meals — perfect timing for a chat. Let's go.","nextNodeIds":[761380115]},{"nodeId":761380115,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1618592442,"text":"By the way, no charge this time. I was just passing by, anyway.","nextNodeIds":[761380116]},{"nodeId":761380116,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":2245645458,"text":"Oh, thank you so much! I'll go get my things right away.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7613801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["7046"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7613802,"order":3,"stepDescription":"Accompany Zompaynco to speak with Lyylikki","stepDescTextMapHash":792978316,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7613802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["7058"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7613802],"talks":[{"talkId":7613802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7613802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7613802,"initDialog":761380201,"nextRandomTalks":[],"nextTalks":[],"npcId":[7058],"performCfg":"QuestDialogue/WQ/NodKrai_76138/Q7613802","priority":5,"questId":76138,"showRandomTalkCount":0},"dialogs":[{"nodeId":761380201,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":968666554,"text":"Lady Nefer? And... Mr. Zompaynco. What brings you here?","nextNodeIds":[761380202]},{"nodeId":761380202,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":800996274,"text":"Our Natlanese guest here has expressed interest in visiting the Frostmoon Scions.","nextNodeIds":[761380203]},{"nodeId":761380203,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3562715466,"text":"But, out of courtesy, he'd prefer someone to introduce him. Well then, Mr. Zompaynco, the floor is yours.","nextNodeIds":[761380204]},{"nodeId":761380204,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1477690250,"text":"G—Greetings, Miss Lyylikki! It's such a pleasure to meet you. Uh... I brought this fossil specimen from Natlan along...","nextNodeIds":[761380205]},{"nodeId":761380205,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2753330538,"text":"Thank you, but Mr. Zompaynco... umm... We've already met, haven't we? You really don't need to be so formal.","nextNodeIds":[761380206]},{"nodeId":761380206,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3479453530,"text":"Huh? Then... how did you notice me?","nextNodeIds":[761380207]},{"nodeId":761380207,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":187316522,"text":"You've always been there when I was distributing meals, haven't you? Wandering around the line, circling back and forth, but never stepping in.","nextNodeIds":[761380208]},{"nodeId":761380208,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":4194357146,"text":"I thought you might want a serving but were too shy to say so, so I quietly set a portion aside for you.","nextNodeIds":[761380209]},{"nodeId":761380209,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2861622306,"text":"But you've never came around to claim one. In fact, you hadn't shown up today, I was going to ask someone to check and see if you need help or something like that.","nextNodeIds":[761380210]},{"nodeId":761380210,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":2469238642,"text":"Ah... I—I'm so sorry. I've been hesitating, trying to figure out how to say hello...","nextNodeIds":[761380211]},{"nodeId":761380211,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":1635952602,"text":"So, Miss Lyylikki... would it be alright if I paid the Frostmoon Scions a visit?","nextNodeIds":[761380212]},{"nodeId":761380212,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1835358690,"text":"Of course. We've welcomed a few guests from outside before. But may I ask why?","nextNodeIds":[761380213]},{"nodeId":761380213,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":3924321770,"text":"I'd like to take some photos and notes, look through some records, and if possible... ask someone about the local legends!","nextNodeIds":[761380214]},{"nodeId":761380214,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":2417990714,"text":"I'm a member of Natlan's Saurian Relics Association. If I could find materials connected to my research, that would be invaluable.","nextNodeIds":[761380215]},{"nodeId":761380215,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3233971066,"text":"I see... so you're hoping to spend some time in the archives, then? Let me think...","nextNodeIds":[761380216]},{"nodeId":761380216,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":653108850,"text":"Well, now that the two of you have been properly introduced, my task here is done. I'll take my leave.","nextNodeIds":[761380217]},{"nodeId":761380217,"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","textMapHash":732990850,"text":"Thank you, Lady Nefer! But... I really must pay you for your trouble — it would be wrong to have you make this trip for nothing.","nextNodeIds":[761380218]},{"nodeId":761380218,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1416597082,"text":"As you wish, Mr. Zompaynco.","nextNodeIds":[761380219]},{"nodeId":761380219,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1524861546,"text":"Then I'll be off. Have yourself a pleasant conversation.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7613802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7613801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["7058"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7613801,7613802],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":7046,"speakerName":"Zompaynco","count":15},{"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[176138],"BHCBFLFOGJN":0,"BPE