"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37501","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["37502","3",""],"type":"QUEST_COND_STATE_NOT_EQUAL"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37406,"initDialog":3740306,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"","priority":1,"questId":375,"showRandomTalkCount":0},"dialogs":[{"nodeId":3740306,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1852953179,"text":"Don't be shy. Go.","nextNodeIds":[]}]},{"talkId":37501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37406","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["37501","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37501,"initDialog":3750101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/AQ/Mengde2_375/Q37501","priority":1,"questId":375,"showRandomTalkCount":0},"dialogs":[{"nodeId":3750101,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3359019699,"text":"It didn't work... I knew it.","nextNodeIds":[3750102]},{"nodeId":3750102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1861843643,"text":"You \"knew it\"?","nextNodeIds":[3750103]},{"nodeId":3750103,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":939038907,"text":"#I just wanted to know how influential {NICKNAME} — the hotshot of the Knights of the Favonius — is.","nextNodeIds":[3750104]},{"nodeId":3750104,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":113068987,"text":"You see, the best warrior should always be presented with the best sword, and yet here we are...","nextNodeIds":[3750105]},{"nodeId":3750105,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1818616011,"text":"Does the story not make for a fitting ballad?","nextNodeIds":[3750106]},{"nodeId":3750106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3273868307,"text":"So what are you trying to say? That we're not good enough?","nextNodeIds":[3750107]},{"nodeId":3750107,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2799441915,"text":"No, that's not it. More of a commentary regarding Mondstadt's inability to see the warrior standing right before its very eyes.","nextNodeIds":[3750108]},{"nodeId":3750108,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":63778211,"text":"Very well. Looks like borrowing it is not going to be possible. We're simply going to have to steal it.","nextNodeIds":[3750109]},{"nodeId":3750110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3213683075,"text":"...","nextNodeIds":[3750111]},{"nodeId":3750109,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2902368515,"text":"Today we stand for free will! Any suggestions on just how we steal it?","nextNodeIds":[3750110]},{"nodeId":3750112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1115045539,"text":"I don't want to steal anything!","nextNodeIds":[3750113]},{"nodeId":3750111,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":286848979,"text":"Come now, speak up. That's what free will is for.","nextNodeIds":[3750112]},{"nodeId":3750113,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2818651907,"text":"Hahaha, look at you. Sidetracked from the start.","nextNodeIds":[3750114]},{"nodeId":3750114,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2943201091,"text":"But seriously, you're more suitable for the job than I.","nextNodeIds":[3750115]},{"nodeId":3750115,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2749451635,"text":"Aside from singing, I don't really have any other talents.","nextNodeIds":[3750116]},{"nodeId":3750116,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3254969083,"text":"Besides, if I was caught, I'd have no one to right the grave injustice of my arrest.","nextNodeIds":[3750117]},{"nodeId":3750117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1400936779,"text":"How can it be a \"grave injustice\" if you got caught stealing red-handed?","nextNodeIds":[3750118]},{"nodeId":3750118,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1430574723,"text":"#But things are different for {NICKNAME}. You are the superstar of the Knights of Favonius. You have made contributions to Mondstadt.","nextNodeIds":[3750119]},{"nodeId":3750119,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1052390115,"text":"Should you get caught, you would easily be able to talk your way out of it.","nextNodeIds":[3750120]},{"nodeId":3750140,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":469666899,"text":"The guards here, it seems they're off duty throughout the night.","nextNodeIds":[]},{"nodeId":3750141,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2509381379,"text":"If we manage to seize this opportunity, it should be smooth sailing from here.","nextNodeIds":[]},{"nodeId":3750120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3529806251,"text":"Stop mentioning us getting caught!","nextNodeIds":[3750121]},{"nodeId":3750122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3128780323,"text":"I'm sorry— Wait... Did you just say... you're Barbatos?","nextNodeIds":[3750123]},{"nodeId":3750121,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2188564619,"text":"#{NICKNAME}... What do you say?","nextNodeIds":[3750122]},{"nodeId":3750123,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":308119867,"text":"Ah, yes. Seems I did mention that...","nextNodeIds":[3750124]},{"nodeId":3750125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2092215547,"text":"If you really are a god, then we can't simply abandon you.","nextNodeIds":[3750126]},{"nodeId":3750124,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1018976923,"text":"Your point being?","nextNodeIds":[3750125]},{"nodeId":3750126,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2370867323,"text":"Why does your decision hinge upon whether or not I am a god?","nextNodeIds":[3750127]},{"nodeId":3750128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3995841291,"text":"And if you're not a god, then I'll help Dvalin anyway.","nextNodeIds":[3750129]},{"nodeId":3750127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1843863347,"text":"#Paimon'll fill you in on {NICKNAME}'s background story when we get the time...","nextNodeIds":[3750128]},{"nodeId":3750130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2651622139,"text":"I will bring you the Holy Lyre der Himmel.","nextNodeIds":[]},{"nodeId":3750131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2378045795,"text":"I don't want to see another separation.","nextNodeIds":[]},{"nodeId":3750129,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1126327379,"text":"Huh?","nextNodeIds":[3750130,3750131]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1008","1"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1001"],"NOCCOBOFKHP":1008,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":37502,"order":2,"stepDescription":"Enter the Cathedral at night (18:00 – 06:00)","stepDescTextMapHash":914354047,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1005,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","