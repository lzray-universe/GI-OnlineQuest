":[{"param":["7405105","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7405103,"initDialog":740510301,"nextRandomTalks":[],"nextTalks":[],"npcId":[13489,13491,13490],"performCfg":"QuestDialogue/WQ/Fontaine_74051/Q7405103","priority":5,"questId":74051,"showRandomTalkCount":0},"dialogs":[{"nodeId":740510301,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":2895567698,"text":"Great! The Film Kamera is intact, and the film hasn't been destroyed...","nextNodeIds":[740510328]},{"nodeId":740510328,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":3734387954,"text":"Thank the Archons. I thought we were gonna have to start shooting all over again.","nextNodeIds":[740510302,740510303]},{"nodeId":740510302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1746717714,"text":"Why are you filming here?","nextNodeIds":[740510329]},{"nodeId":740510303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4083106434,"text":"Seems you aren't from Fontaine either.","nextNodeIds":[740510329]},{"nodeId":740510329,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":3401506346,"text":"It's a long story...","nextNodeIds":[740510305]},{"nodeId":740510304,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":2354786802,"text":"Let's keep it brief. We three are from Qiaoying Village in Liyue.","nextNodeIds":[740510305]},{"nodeId":740510305,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":1969142890,"text":"Most people there are in the tea business but we... don't have any interest in tea...","nextNodeIds":[740510306]},{"nodeId":740510306,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":3654123426,"text":"So, we changed professions and started filming dokumentari films to help promote tea vendors in the village.","nextNodeIds":[740510307]},{"nodeId":740510307,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"Yifeng","textMapHash":1056186930,"text":"In truth, there are too many people in the tea business, and we just couldn't compete.","nextNodeIds":[740510308]},{"nodeId":740510308,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"Xingye","textMapHash":1951241202,"text":"The skilled helpers we had at the store left one by one to work elsewhere, so if we just stuck to making tea, we'd be starving.","nextNodeIds":[740510309]},{"nodeId":740510309,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":159610058,"text":"Can't you two... not make things sound so depressing!?","nextNodeIds":[740510310]},{"nodeId":740510310,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":1951713890,"text":"We've made plenty of Mora shooting these tea dokumentaris in the village.","nextNodeIds":[740510311]},{"nodeId":740510311,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"Yifeng","textMapHash":61797730,"text":"But recently, some others in the village have also started to shoot their own promotional films.","nextNodeIds":[740510312]},{"nodeId":740510312,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"Xingye","textMapHash":3177685770,"text":"Some of them are even performing an opera in them. They're making a real big show of it.","nextNodeIds":[740510313]},{"nodeId":740510313,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":2775420946,"text":"So that's why we're in Fontaine. We're trying to seek advice from master filmmakers!","nextNodeIds":[740510314]},{"nodeId":740510314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1416505034,"text":"So, you're here to learn about filmmaking in Fontaine?","nextNodeIds":[740510315]},{"nodeId":740510315,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":774186426,"text":"Yeah. We found this \"lighting expert\" called Geisert.","nextNodeIds":[740510316]},{"nodeId":740510316,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":554110946,"text":"He's real good at using lighting to film... what was it again?","nextNodeIds":[740510317]},{"nodeId":740510317,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"Yifeng","textMapHash":161516138,"text":"\"Narratives.\"","nextNodeIds":[740510318]},{"nodeId":740510318,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":4177414938,"text":"Yeah! Applying lighting to his \"narratives.\"","nextNodeIds":[740510319]},{"nodeId":740510319,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":3134499298,"text":"With Mr. Geisert's advice, we can definitely shoot the best films in all of Qiaoying Village!","nextNodeIds":[740510320]},{"nodeId":740510320,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"Xingye","textMapHash":2863200994,"text":"Boss, last month you said we were going to shoot the best films in Liyue.","nextNodeIds":[740510321]},{"nodeId":740510321,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":2270014410,"text":"You have to adjust your expectations realistically when doing business... What do you know?","nextNodeIds":[740510322]},{"nodeId":740510322,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":738726514,"text":"Anyway, thanks for your help, Traveler. Here, take this Mora.","nextNodeIds":[740510323]},{"nodeId":740510323,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":2738443930,"text":"Xingye, Yifeng, pack that up quick! We gotta finish shooting our sample and show it to Mr. Geisert.","nextNodeIds":[740510324]},{"nodeId":740510324,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":1856159618,"text":"Watch the lighting! The Kamera's gotta be angled toward the light source in this way. We gotta capture that... high-definition lighting!","nextNodeIds":[740510325]},{"nodeId":740510325,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"Ms. Qiu","textMapHash":747182738,"text":"You all read that book, right? The lighting's gotta have a sense of texture? You get what I'm saying?","nextNodeIds":[740510326]},{"nodeId":740510326,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"Xingye","textMapHash":3491579450,"text":"Boss, we might've read Mr. Geisert's book...","nextNodeIds":[740510327]},{"nodeId":740510327,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"Yifeng","textMapHash":1847110346,"text":"But with what we got, we're not going to be able to capture that high-definition lighting tactility you want no matter how much we struggle...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7405103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133402044"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3