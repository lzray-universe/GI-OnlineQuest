YER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7272701],"talks":[{"talkId":7272701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7272701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7272701,"initDialog":727270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30252],"performCfg":"QuestDialogue/WQ/Daoqi_72727/Q7272701","priority":5,"questId":72727,"showRandomTalkCount":0},"dialogs":[{"nodeId":727270101,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":990090210,"text":"Hello there, warrior from a foreign land!","nextNodeIds":[727270102,727270104]},{"nodeId":727270102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2162807338,"text":"We meet again.","nextNodeIds":[727270103]},{"nodeId":727270103,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":2371709226,"text":"Indeed we meet again! You cut as dazzling a figure as ever...","nextNodeIds":[727270106]},{"nodeId":727270106,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":10764002,"text":"...Ahem, point is, it would seem that some people have been secretly organizing another Hyakunin Ikki.","nextNodeIds":[727270107,727270112]},{"nodeId":727270107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2826485450,"text":"What is this Hyakunin Ikki again?","nextNodeIds":[727270108]},{"nodeId":727270108,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":1350307370,"text":"Hyakunin Ikki was originally a festival organized by the Tengu-kin to celebrate memorable events or make peace with loss through a good old-fashioned brawl.","nextNodeIds":[727270109]},{"nodeId":727270109,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":971505210,"text":"During the festival, be it warriors or monsters, everyone can cast aside their preconceived notions with no questions asked about their origins in a pure, hot-blooded free-for-all.","nextNodeIds":[727270110]},{"nodeId":727270110,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":3159338450,"text":"They say that warriors who emerge from the festival victorious can also win all kinds of treasures...","nextNodeIds":[727270111]},{"nodeId":727270111,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":2166056282,"text":"...That said, since the crack-down on the Tengu-kin, I'm not too sure who's organizing the festival this time or where the rewards will come from.","nextNodeIds":[727270115]},{"nodeId":727270115,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":3958878786,"text":"Anyway, it's too crowded here to be discussing this sort of thing. As always, please come with me...","nextNodeIds":[727270116]},{"nodeId":727270116,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":133842426,"text":"Kayabuki Ikkei takes you to a small island outside Inazuma City...","nextNodeIds":[]},{"nodeId":727270112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3923738194,"text":"...There's another one?","nextNodeIds":[727270113]},{"nodeId":727270113,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":4284628010,"text":"That's right. Perhaps your valor in battle has attracted even more people. To be honest, the audience got so fired up that they looked like they wanted to get in the ring themselves.","nextNodeIds":[727270114]},{"nodeId":727270114,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":2326765866,"text":"To be honest, I never thought the next Hyakunin Ikki would be so soon either...","nextNodeIds":[727270115]},{"nodeId":727270104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2803012290,"text":"You are...?","nextNodeIds":[727270105]},{"nodeId":727270105,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":1167549554,"text":"Huh? You don't remember me? Ah, sorry, perhaps I was so busy recording your heroics in battle during the last Hyakunin Ikki that I didn't cheer loudly enough...","nextNodeIds":[727270106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7272701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7272702,"order":2,"stepDescription":"Talk to Kayabuki","stepDescTextMapHash":516912164,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7272702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7272702],"talks":[{"talkId":7272702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7272702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7272702,"initDialog":727270201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30252],"performCfg":"QuestDialogue/WQ/Daoqi_72727/Q7272702","priority":5,"questId":72727,"showRandomTalkCount":0},"dialogs":[{"nodeId":727270201,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":2630750626,"text":"Here we are. This is the place.","nextNodeIds":[727270202]},{"nodeId":727270202,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":3498394138,"text":"Same rules as always: Once you enter this rather suspicious-seeming door, you'll be in the tournament venue for this round of Hyakunin Ikki.","nextNodeIds":[727270203,727270204]},{"nodeId":727270203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1234808090,"text":"...It's looking as suspicious as always.","nextNodeIds":[727270207]},{"nodeId":727270207,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":1719400618,"text":"Anyway, I'll be recording your heroics and cheering for you at the top of my lungs this time, too.","nextNodeIds":[727270208,727270209]},{"nodeId":727270208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3954431914,"text":"Great. I'm getting fired up already.","nextNodeIds":[727270210]},{"nodeId":727270210,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":777364490,"text":"Well, I hope I'll get to see your flashy swordplay this time as well!","nextNodeIds":[]},{"nodeId":727270209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3511640170,"text":"This is always such a pain...","nextNodeIds":[727270210]},{"nodeId":727270204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3924950994,"text":"What are the rules of Hyakunin Ikki?","nextNodeIds":[727270205]},{"nodeId":727270205,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":251385122,"text":"The rules probably have not changed much. Monsters, adventurers, and warriors from across Teyvat, who share a common yearning for battle, will quench their thirst on this festival stage through passionate combat.","nextNodeIds":[727270206]},{"nodeId":727270206,"roleType":"TALK_ROLE_NPC","speakerId":30252,"speakerName":"Kayabuki Ikkei","textMapHash":487666298,"text":"And of course, just like last time, feel free to bring your friends and companions! After all, the \"Hyakunin\" in \"Hyakunin Ikki\" means that the more people you bring, the merrier!","nextNodeIds":[727270207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7272702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPL