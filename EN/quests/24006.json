{"mainQuestId":24006,"title":"Their Childhood: Good Times","description":"Aurele, Verut, and Lovi all seem to be playing some game again...","titleTextMapHash":219191031,"descTextMapHash":3411840326,"mainQuestExcel":{"mainQuestId":24006,"titleTextMapHash":219191031,"title":"Their Childhood: Good Times","descTextMapHash":3411840326,"description":"Aurele, Verut, and Lovi all seem to be playing some game again...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ24006","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":3411840326,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":24006,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1035951145,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ24006","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":43140,"titleTextMapHash":219191031,"type":"IQ","unlockDescTextMapHash":673989318}},"flow":[{"subQuestId":2400601,"order":1,"stepDescription":"Talk to Verut","stepDescTextMapHash":3656325532,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5062"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400601],"talks":[{"talkId":2400601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400601,"initDialog":240060101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5062,5021,5063],"performCfg":"QuestDialogue/IQ/Fontaine_24006/Q2400601","priority":5,"questId":24006,"showRandomTalkCount":0},"dialogs":[{"nodeId":240060101,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":1343956378,"text":"It's my turn to catch people, huh? I'll get you for sure, Lovi!","nextNodeIds":[240060102]},{"nodeId":240060102,"roleType":"TALK_ROLE_NPC","speakerId":5021,"speakerName":"Lovi","textMapHash":1341829178,"text":"I wouldn't be so sure! There's some places even you can't climb up to.","nextNodeIds":[240060103]},{"nodeId":240060103,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":490271514,"text":"Well, um, that's because my shoes aren't suited to climbing. If I change shoes, I can definitely get you!","nextNodeIds":[240060104]},{"nodeId":240060104,"roleType":"TALK_ROLE_NPC","speakerId":5021,"speakerName":"Lovi","textMapHash":1191916426,"text":"Then let's both take our shoes off. That'll make things fair!","nextNodeIds":[240060105]},{"nodeId":240060105,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":2296549130,"text":"Stop! You're both not allowed to run around barefoot. There's all sorts of abandoned bits and bobs everywhere. What if you get cut?","nextNodeIds":[240060106]},{"nodeId":240060106,"roleType":"TALK_ROLE_NPC","speakerId":5021,"speakerName":"Lovi","textMapHash":2834105698,"text":"Okay...","nextNodeIds":[240060107]},{"nodeId":240060107,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":659337946,"text":"Fine...","nextNodeIds":[240060108]},{"nodeId":240060108,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":1686651362,"text":"Um, brother, when you were trying to catch me earlier, you were kinda distracted, weren't you? I ran past you earlier, and you didn't respond at all.","nextNodeIds":[240060109]},{"nodeId":240060109,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":749839194,"text":"Huh? Did that happen? I didn't notice...","nextNodeIds":[240060110]},{"nodeId":240060110,"roleType":"TALK_ROLE_NPC","speakerId":5021,"speakerName":"Lovi","textMapHash":3254305618,"text":"Exactly! I ran an entire round earlier, and you didn't seem to see me at all!","nextNodeIds":[240060111]},{"nodeId":240060111,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":3176672074,"text":"But... Huh? It's you! Why are you here?","nextNodeIds":[240060112,240060115]},{"nodeId":240060112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2240558090,"text":"Why's Lovi here?","nextNodeIds":[240060113]},{"nodeId":240060113,"roleType":"TALK_ROLE_NPC","speakerId":5021,"speakerName":"Lovi","textMapHash":1864365666,"text":"Dad said that he needed to go out to work. Mom has to work as well.","nextNodeIds":[240060114]},{"nodeId":240060114,"roleType":"TALK_ROLE_NPC","speakerId":5021,"speakerName":"Lovi","textMapHash":11655730,"text":"Aurele happened to come to return a book, so Dad asked him to take care of me, so I came over to play with them.","nextNodeIds":[240060118]},{"nodeId":240060118,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":399131010,"text":"Never mind that, let's continue playing. Who's going to do the catching this time?","nextNodeIds":[240060119,240060120]},{"nodeId":240060119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2046962114,"text":"I thought you didn't like hide-and-seek.","nextNodeIds":[240060121]},{"nodeId":240060121,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":3626846610,"text":"Well, um, *cough* I've been trying to write a review recently, and I've had some questions that need consideration.","nextNodeIds":[240060122]},{"nodeId":240060122,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":3775467298,"text":"I've found that, well, my mind is more agile when I am exercising, so...","nextNodeIds":[240060123]},{"nodeId":240060123,"roleType":"TALK_ROLE_NPC","speakerId":5021,"speakerName":"Lovi","textMapHash":474604466,"text":"But he zones out easily and sometimes just stands there talking to himself. He won't react no matter what you say to him.","nextNodeIds":[240060124]},{"nodeId":240060124,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":2785040434,"text":"Why don't you join us? You're way better than my brother is at hide-and-seek.","nextNodeIds":[240060125,240060126]},{"nodeId":240060125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":66651178,"text":"No problem.","nextNodeIds":[240060127]},{"nodeId":240060127,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":1968858882,"text":"Hehe, go ahead and do your best. Lovi and I are masters of hide-and-seek.","nextNodeIds":[240060128]},{"nodeId":240060128,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":3117639002,"text":"Then let's begin. C'mon, Lovi! We've got hiding spots to find!","nextNodeIds":[240060129]},{"nodeId":240060129,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2946633346,"text":"Lovi and Verut run like the wind, while Aurele leaves slowly, pondering as he does...","nextNodeIds":[]},{"nodeId":240060126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1701721458,"text":"I'm not gonna go easy on any of you.","nextNodeIds":[240060127]},{"nodeId":240060120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1117378322,"text":"Why the sudden enthusiasm for hide-and-seek?","nextNodeIds":[240060121]},{"nodeId":240060115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1552988778,"text":"Still hide-and-seek, then?","nextNodeIds":[240060116]},{"nodeId":240060116,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":2456399202,"text":"Yes. Mr. Delerue happens to need to go on a business trip, and Aunt Dumay also needs to work, so they asked that I take care of Lovi.","nextNodeIds":[240060117]},{"nodeId":240060117,"roleType":"TALK_ROLE_NPC","speakerId":5063,"speakerName":"Aurele","textMapHash":221739466,"text":"So I brought her here to play with us... I hope her dress won't get too dirty...","nextNodeIds":[240060118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5062"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2400602,"order":2,"stepDescription":"Find all the kids","stepDescTextMapHash":803907228,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_340100244:3505.555,282.822,4548.804]","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2400602],"talks":[{"talkId":2400602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400602,"initDialog":240060201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5062],"performCfg":"","priority":5,"questId":24006,"showRandomTalkCount":0},"dialogs":[{"nodeId":240060201,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":851536058,"text":"So you found me anyway, huh? Guess you really are better at this.","nextNodeIds":[240060202]},{"nodeId":240060202,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":2982585762,"text":"I'll head back to the meeting point. I hope my brother does better...","nextNodeIds":[240060203]},{"nodeId":240060203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2787853522,"text":"Why do you hope so?","nextNodeIds":[240060204]},{"nodeId":240060204,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":3899305154,"text":"Well, he did say it himself, didn't he? His brain works better after we play hide-and-seek.","nextNodeIds":[240060205]},{"nodeId":240060205,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":1032801450,"text":"But he has too many thoughts, and he needs to squat on the ground, trying to recall and memorize them for a long time.","nextNodeIds":[240060206]},{"nodeId":240060206,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":2956177602,"text":"Lovi told me that those ideas of his are very precious things, and so we shouldn't disturb him.","nextNodeIds":[240060207]},{"nodeId":240060207,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":1760767578,"text":"That's why when we're playing hide-and-seek with him, if we're about to catch him, we purposely take our time until he finishes collecting his thoughts.","nextNodeIds":[240060208]},{"nodeId":240060208,"roleType":"TALK_ROLE_NPC","speakerId":5062,"speakerName":"Verut","textMapHash":1360332842,"text":"It's just that if it's my brother's turn to catch people, we'll have to wait for him for a long while...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_340100244:3505.555,282.82