aram":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351901,"initDialog":735190101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351901","priority":5,"questId":73519,"showRandomTalkCount":0},"dialogs":[{"nodeId":735190101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3162823018,"text":"I don't understand... She was the one who mentioned the idea of going to the café to write the report...","nextNodeIds":[735190102,735190103]},{"nodeId":735190102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2451084250,"text":"Why are you here by yourself?","nextNodeIds":[735190104]},{"nodeId":735190104,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":484564562,"text":"*sigh* I don't want to talk about it. She's off to work on the report by herself.","nextNodeIds":[735190105]},{"nodeId":735190105,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1274920394,"text":"We were supposed to meet at the café yesterday, but it took her a long time to show up. She didn't even bring any pen or paper for her report!","nextNodeIds":[735190106]},{"nodeId":735190106,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":687544218,"text":"I criticized her for wasting time when we should be working on the report, and then she flew into a rage! She said she'd write the report herself and made me leave!","nextNodeIds":[735190107]},{"nodeId":735190107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2221619650,"text":"This is ridiculous, don't you think?","nextNodeIds":[735190108]},{"nodeId":735190108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3980258362,"text":"...","nextNodeIds":[735190109]},{"nodeId":735190109,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2167675514,"text":"Still, I'm used to her fiery temper. She'll simmer down in a couple days.","nextNodeIds":[735190110]},{"nodeId":735190110,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1401999530,"text":"If only controlling her emotions was as simple as flipping a switch.","nextNodeIds":[735190111,735190112]},{"nodeId":735190111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":24549082,"text":"Best of luck.","nextNodeIds":[735190113]},{"nodeId":735190113,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1434894002,"text":"Huh? Even you're acting strange... Oh well, never mind. There are still a few affected Wenut around here, though I'm sure the situation will resolve itself if I just leave it alone.","nextNodeIds":[735190114]},{"nodeId":735190114,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":331034786,"text":"But if you have time, please help prevent them from threatening passers-by.","nextNodeIds":[735190115]},{"nodeId":735190115,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":4176955562,"text":"By the way, the elemental environment and the charging device are now back to normal.","nextNodeIds":[735190116]},{"nodeId":735190116,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2711184794,"text":"There's never been a better time to experience the Wenutslayer Cannon at full power!","nextNodeIds":[]},{"nodeId":735190112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1337848378,"text":"Good luck to you.","nextNodeIds":[735190113]},{"nodeId":735190103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1719782242,"text":"Where's Shriya?","nextNodeIds":[735190104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","cou