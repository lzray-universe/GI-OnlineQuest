{"mainQuestId":72674,"title":"Eight Locales Over Mountains and Seas","description":"You have not gone to see Ioroi of Chinju Forest for quite some time now. Perhaps it's time to pay the sealed king of bake-danuki a visit...","titleTextMapHash":3353905119,"descTextMapHash":3030334742,"mainQuestExcel":{"mainQuestId":72674,"titleTextMapHash":3353905119,"title":"Eight Locales Over Mountains and Seas","descTextMapHash":3030334742,"description":"You have not gone to see Ioroi of Chinju Forest for quite some time now. Perhaps it's time to pay the sealed king of bake-danuki a visit...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5055,"luaPath":"Actor/Quest/WQ72674","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5055,"chapterId":0,"descTextMapHash":3030334742,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72674,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1280166873,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72674","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172674],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3353905119,"type":"WQ","unlockDescTextMapHash":995626142}},"flow":[{"subQuestId":7267401,"order":1,"stepDescription":"Head to Chinju Forest to visit Ioroi","stepDescTextMapHash":2464470540,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3159"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7267401],"talks":[{"talkId":7267401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267401,"initDialog":726740101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3159],"performCfg":"QuestDialogue/WQ/Inazuma_72674/Q7267401","priority":5,"questId":72674,"showRandomTalkCount":0},"dialogs":[{"nodeId":726740101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2942434370,"text":"Hey there, Ioroi!","nextNodeIds":[726740102]},{"nodeId":726740102,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":4019050682,"text":"Eeek! You saw through me? How did... Wait, no, this scent...","nextNodeIds":[726740103]},{"nodeId":726740103,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":783429146,"text":"Ah, so it's you. It has been so long, I could not recognize your scent!","nextNodeIds":[726740104]},{"nodeId":726740104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3514983866,"text":"And you haven't changed at all, Ioroi — still scared of humans and stuck in a stone!","nextNodeIds":[726740105]},{"nodeId":726740105,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1971279466,"text":"Mmm!? What do you mean by that?","nextNodeIds":[726740106,726740107]},{"nodeId":726740106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3825230426,"text":"Hope your seal can be lifted soon.","nextNodeIds":[726740108]},{"nodeId":726740108,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":155186842,"text":"Bah, it is but a human seal! If I were but to try harder...","nextNodeIds":[726740109]},{"nodeId":726740109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3402916186,"text":"*cough*","nextNodeIds":[726740110]},{"nodeId":726740110,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1065602282,"text":"...","nextNodeIds":[726740111]},{"nodeId":726740111,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3528476826,"text":"#Well. Regardless, I see you have taken good care of the little ones. My little tanuki often say that they enjoy playing with their nice-smelling yellow-furred {F#Aunt}{M#Uncle}.","nextNodeIds":[726740112,726740113,726740114]},{"nodeId":726740112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4161452562,"text":"#Yellow-furred {F#Aunt}{M#Uncle}...","nextNodeIds":[726740115]},{"nodeId":726740115,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3601362042,"text":"And here I had thought that humans were all the same as that fellow who had us sealed — wicked and scary. But it seems that there are still some good eggs amongst you.","nextNodeIds":[726740116,726740117]},{"nodeId":726740116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1598629010,"text":"Most people are alright.","nextNodeIds":[726740118]},{"nodeId":726740118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":570128970,"text":"That's right. Most of the people we've met are good people! You got sealed because you stole that comb...","nextNodeIds":[726740119]},{"nodeId":726740119,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1494434946,"text":"Hmph! And I've returned it! So if you ever meet that fellow who learned magic from Reizenbou, tell him to get me out of this stone!","nextNodeIds":[726740120]},{"nodeId":726740120,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3483501458,"text":"Mmph! When you get down to it, everything is that sneaky kitsune's fault...","nextNodeIds":[726740121]},{"nodeId":726740121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2204184178,"text":"(Ioroi really complains like some old geezer, huh?)","nextNodeIds":[726740122]},{"nodeId":726740122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2842096554,"text":"(Well, he is quite old.)","nextNodeIds":[726740123]},{"nodeId":726740123,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1887813106,"text":"Well then, neither your hands nor legs are made of stone, so you've been to many places, surely?","nextNodeIds":[726740124]},{"nodeId":726740124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1824886178,"text":"Yup! We came right over the ocean, you know?","nextNodeIds":[726740125]},{"nodeId":726740125,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1821231242,"text":"You tell Ioroi about your adventures in Mondstadt and Liyue.","nextNodeIds":[726740126]},{"nodeId":726740126,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2465858138,"text":"...So, there are so many lands abroad. Very impressive.","nextNodeIds":[726740127]},{"nodeId":726740127,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2827986434,"text":"I have been subsisting off reports from the little tanuki all this while, and so do not know what the outside world is like.","nextNodeIds":[726740128]},{"nodeId":726740128,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2111695162,"text":"Once upon a time, I stood at the summit of Mt. Yougou and saw a very, very high mountain on the other side of the ocean. It was possibly even taller than Mt. Yougou. I still wonder, even today, what that place was.","nextNodeIds":[726740129,726740131]},{"nodeId":726740129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3606911490,"text":"Across the ocean, you say...","nextNodeIds":[726740130]},{"nodeId":726740130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3285359458,"text":"That's gotta be Dragonspine, right?","nextNodeIds":[726740132]},{"nodeId":726740132,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1278213050,"text":"Mmmm, Dragonspine? Just thinking about that name makes my tummy feel cold. Goodness knows why that fellow wants to go there...","nextNodeIds":[726740133]},{"nodeId":726740133,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2598299610,"text":"...","nextNodeIds":[726740134]},{"nodeId":726740134,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1647190898,"text":"As I said earlier, you are fine folk, yes? So...","nextNodeIds":[726740135]},{"nodeId":726740135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1687284122,"text":"Paimon can smell this request coming a mile away!","nextNodeIds":[726740136]},{"nodeId":726740136,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2660842458,"text":"Mmm! Even like this, I am still the Hidden Protector of the Grove, defender of Chinju Forest, and thusly appointed by Her Excellency herself! If I was not sealed in stone, I would certainly use an eight-tatami large...","nextNodeIds":[726740137,726740138]},{"nodeId":726740137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2251877074,"text":"Alright then. What do you need help with?","nextNodeIds":[726740143]},{"nodeId":726740143,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1638477194,"text":"Though I cannot move on my own power, the little children can do so. As such, I would like to ask you to take the little tanuki out to train.","nextNodeIds":[726740144]},{"nodeId":726740144,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3801255306,"text":"Take Kichiboushi with you. He has been quite eager to see you since the last time you played together — quite eager indeed!","nextNodeIds":[726740145,726740146]},{"nodeId":726740145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4175521194,"text":"Well, we can do that...","nextNodeIds":[726740147]},{"nodeId":726740147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1778166610,"text":"That's true. We can't understand what Kichiboushi says, so wouldn't traveling together be kinda tough?","nextNodeIds":[726740148]},{"nodeId":726740148,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3464739274,"text":"Impossible. We tanuki understand human speech by nature. It is you humans who do not speak ours.","nextNodeIds":[726740149]},{"nodeId":726740149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3569870186,"text":"What? Is that how it is?","nextNodeIds":[726740150]},{"nodeId":726740150,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4250651682,"text":"But as travel companions...","nextNodeIds":[726740151]},{"nodeId":726740151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4184531306,"text":"We'd like to chat as we travel, you know?","nextNodeIds":[726740152]},{"nodeId":726740152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1028056970,"text":"#Just like Paimon does with {NICKNAME}!","nextNodeIds":[726740153]},{"nodeId":726740153,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3740500946,"text":"Mmph. Very well then. Now that I consider it, didn't someone once use our magic to make you some food?","nextNodeIds":[726740154]},{"nodeId":726740154,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2837878418,"text":"Now, I may look like this, but making you a \"meal\" that can allow you to understand Kichiboushi's speech is hardly impossible nonetheless.","nextNodeIds":[726740155]},{"nodeId":726740155,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1410903218,"text":"Woo-hoo! Food!","nextNodeIds":[726740156]},{"nodeId":726740156,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3303908146,"text":"Is it gonna taste good, though...","nextNodeIds":[726740157]},{"nodeId":726740157,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3779480082,"text":"Now, now, don't you underestimate my culinary prowess!","nextNodeIds":[726740158]},{"nodeId":726740158,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1759498570,"text":"Although you can't be sure where Ioroi got it from...\\nYou and Paimon have a feast that \"looks very delicious\" off Ioroi's stone tummy.","nextNodeIds":[726740159]},{"nodeId":726740159,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":896416858,"text":"Ooh, this is great!","nextNodeIds":[726740160]},{"nodeId":726740160,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3842468802,"text":"Of course. I am Ioroi, you know — the very same who once made Sashimi Platters out of mud balls and tanuki fur to utterly deceive the Four Oni of Ogata!","nextNodeIds":[726740161]},{"nodeId":726740161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1299874450,"text":"That's awesome, Ioroi! But so, what did you make the meal we just had out of?","nextNodeIds":[726740162]},{"nodeId":726740162,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1240353746,"text":"Some questions are best left unasked, Paimon.","nextNodeIds":[726740163]},{"nodeId":726740163,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3886267698,"text":"Huh?","nextNodeIds":[726740164]},{"nodeId":726740164,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2509426178,"text":"Well, forget it. Let's go find Kichiboushi and have a chat!","nextNodeIds":[]},{"nodeId":726740146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3289245698,"text":"One question, if you would...","nextNodeIds":[726740147]},{"nodeId":726740138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":243148058,"text":"Well...","nextNodeIds":[726740139]},{"nodeId":726740139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2187062482,"text":"#Ooh, Paimon knows what you mean, {NICKNAME}! Will there be treasure?","nextNodeIds":[726740140]},{"nodeId":726740140,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":300814794,"text":"Treasure? Why, of course! I am the chief of five hundred and five bake-danuki, after all! Not a single one of Inazuma's treasures has ever escaped my sight.","nextNodeIds":[726740141]},{"nodeId":726740141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3088300050,"text":"In that case, what do you need help with?","nextNodeIds":[726740142]},{"nodeId":726740142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3987702546,"text":"That's right, we're super good at helping!","nextNodeIds":[726740143]},{"nodeId":726740131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2965861162,"text":"From the direction you're referring to, that's probably Dragonspine.","nextNodeIds":[726740132]},{"nodeId":726740117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3603035098,"text":"Why, thank you.","nextNodeIds":[726740118]},{"nodeId":726740113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2998712394,"text":"Nice-smelling...","nextNodeIds":[726740115]},{"nodeId":726740114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2751429626,"text":"#Also, it's not {F#Aunt}{M#Uncle}. It's {F#Big Sis}{M#Big Bro}.","nextNodeIds":[726740115]},{"nodeId":726740107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3799071634,"text":"Paimon means that we hope that your seal will soon be lifted.","nextNodeIds":[726740108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3159"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7267402,"order":2,"stepDescription":"Talk to Kichiboushi","stepDescTextMapHash":4012178276,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7267402_N3160","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7267402,7267404],"talks":[{"talkId":7267402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267402,"initDialog":726740201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3160],"performCfg":"QuestDialogue/WQ/Inazuma_72674/Q7267402","priority":5,"questId":72674,"showRandomTalkCount":0},"dialogs":[{"nodeId":726740201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1939847826,"text":"Hey there, Kichiboushi! Long time no see!","nextNodeIds":[726740202]},{"nodeId":726740202,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":828687170,"text":"Mm! White Fur, Yellow Fur.","nextNodeIds":[726740203]},{"nodeId":726740203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":212698682,"text":"I guess \"Yellow Fur\" must be me?","nextNodeIds":[726740204]},{"nodeId":726740204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2973140210,"text":"Who're you calling White Fur?","nextNodeIds":[726740205]},{"nodeId":726740205,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3396587386,"text":"Mm, very strong. Can understand.","nextNodeIds":[726740206]},{"nodeId":726740206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2690090570,"text":"#I'm {NICKNAME}, and this is Paimon.","nextNodeIds":[726740207]},{"nodeId":726740207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":974351442,"text":"And you'd better remember that!","nextNodeIds":[726740208]},{"nodeId":726740208,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":750015466,"text":"Squelch squelch Lavender Melon.","nextNodeIds":[726740209]},{"nodeId":726740209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2898513850,"text":"What? Lavender Melon? And what's \"squelch squelch\" supposed to mean?","nextNodeIds":[726740210]},{"nodeId":726740210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":859029650,"text":"Well, at least we can kinda-sorta communicate...","nextNodeIds":[726740211]},{"nodeId":726740211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3562136754,"text":"\"Kinda-sorta\" is kinda-sorta right.","nextNodeIds":[726740212]},{"nodeId":726740212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2866998610,"text":"#Whatever the case, {NICKNAME}, let's go back and see Ioroi again. We are taking Kichiboushi out on a long journey, after all.","nextNodeIds":[726740213]},{"nodeId":726740213,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2114743314,"text":"Ioroi! Yey!","nextNodeIds":[726740214]},{"nodeId":726740214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4210040986,"text":"Yey!","nextNodeIds":[]}]},{"talkId":7267404,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267404,"initDialog":726740401,"nextRandomTalks":[],"nextTalks":[],"npcId":[3159],"performCfg":"QuestDialogue/WQ/Inazuma_72674/Q7267404","priority":5,"questId":72674,"showRandomTalkCount":0},"dialogs":[{"nodeId":726740401,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2375248842,"text":"Through the power of the bake-danuki meal made by mine own hands, you, too, may speak to the little tanuki. Go, try having a chat with Kichiboushi.","nextNodeIds":[726740402]},{"nodeId":726740402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3579141578,"text":"We'll do that.","nextNodeIds":[726740403]},{"nodeId":726740403,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1027647690,"text":"Go, then, go. I have all the time in the world to go nowhere, but it is not so with my little tanuki.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7267402_N3160","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7267403,"order":3,"stepDescription":"Talk to Ioroi","stepDescTextMapHash":4150876908,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3159"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7267403],"talks":[{"talkId":7267403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267403,"initDialog":726740301,"nextRandomTalks":[],"nextTalks":[],"npcId":[3159],"performCfg":"QuestDialogue/WQ/Inazuma_72674/Q7267403","priority":5,"questId":72674,"showRandomTalkCount":0},"dialogs":[{"nodeId":726740301,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1375815018,"text":"Mm! How goes it?","nextNodeIds":[726740302]},{"nodeId":726740302,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1031104538,"text":"Mm! See White Fur, Yellow Fur, very happy. Lavender Melon Kapow!","nextNodeIds":[726740303]},{"nodeId":726740303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":741545386,"text":"Lavender Melon Kapow...","nextNodeIds":[726740304]},{"nodeId":726740304,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3622787146,"text":"Hmm, quite the bright spark, aren't you?","nextNodeIds":[726740305]},{"nodeId":726740305,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":721942450,"text":"Kapow!","nextNodeIds":[726740306]},{"nodeId":726740306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4036652586,"text":"So, what does Lavender Melon Kapow mean again...?","nextNodeIds":[726740307]},{"nodeId":726740307,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1300487066,"text":"Kapow is Kapow. Lavender Melon is Lavender Melon.","nextNodeIds":[726740308]},{"nodeId":726740308,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":4016620330,"text":"Well, it seems that communications have been established without any problems. Ah, mine \"culinary\" skills are as fine as ever!","nextNodeIds":[726740309,726740311]},{"nodeId":726740309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4134675642,"text":"...I suppose so?","nextNodeIds":[726740310]},{"nodeId":726740310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":963386482,"text":"Nope, not at all! We can't understand a thing Kichiboushi's saying!","nextNodeIds":[726740312]},{"nodeId":726740312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3598255786,"text":"Well, Ioroi, here's the thing...","nextNodeIds":[726740313]},{"nodeId":726740313,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2121021490,"text":"You tell Ioroi how the attempted interactions are going...","nextNodeIds":[726740314]},{"nodeId":726740314,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":47870618,"text":"Mmm, so that's how it is. Not to worry. It is because you are not yet used to Kichiboushi's aura.","nextNodeIds":[726740315]},{"nodeId":726740315,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1845804306,"text":"Take it slow! The more used to his aura you are, the better you shall understand him!","nextNodeIds":[726740316]},{"nodeId":726740316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1890241162,"text":"How slow are we talking about here?","nextNodeIds":[726740317]},{"nodeId":726740317,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3760380354,"text":"Ah, hmm. Let me think about that...","nextNodeIds":[726740318]},{"nodeId":726740318,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":4081772858,"text":"Eh! Whatever the case, do not be in a rush!","nextNodeIds":[726740319]},{"nodeId":726740319,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2391115602,"text":"Rush no good.","nextNodeIds":[726740320]},{"nodeId":726740320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3880699490,"text":"You don't know either, do you?","nextNodeIds":[726740321]},{"nodeId":726740321,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2154103538,"text":"Hmph! I will have you know that I am Ioroi, the long-lived king of bake-danuki! I simply do not put such premiums on time as you humans do.","nextNodeIds":[726740322]},{"nodeId":726740322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":791646650,"text":"(Even though he's spent most of his time sealed in that stone statue...)","nextNodeIds":[726740323]},{"nodeId":726740323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1571053194,"text":"Then why can you speak to humans just fine, Ioroi?","nextNodeIds":[726740324]},{"nodeId":726740324,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3254199290,"text":"Mmph! Such impertinence! Rather, you should ask why you humans may speak to us.","nextNodeIds":[726740325]},{"nodeId":726740325,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1616768602,"text":"Having lived as long and become as powerful as I have, I have had at least some interactions with humanity.","nextNodeIds":[726740326]},{"nodeId":726740326,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3081173082,"text":"A long, long time ago, I often spoke with tengu, kitsune, oni, youkai, and humans alike. And while human stories often concern themselves, at least half of them involve bake-danuki who transformed into humans.","nextNodeIds":[726740327]},{"nodeId":726740327,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":4047871130,"text":"Half of the remaining half are indeed about humans themselves, and the other half are about all the other youkai.","nextNodeIds":[726740328]},{"nodeId":726740328,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2304156418,"text":"But even in this half, a good half concern we tanuki, who clad ourselves in the guise of the other youkai. Then half again of the tanuki tales are those concerning me.","nextNodeIds":[726740329]},{"nodeId":726740329,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1603840682,"text":"Mmph, as such, you may see that I am the greatest of them all. Naturally, speaking to you young ones is no tall order at all.","nextNodeIds":[726740330]},{"nodeId":726740330,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3105471994,"text":"I get it. Five over sixteen to Ioroi, yes?","nextNodeIds":[726740331]},{"nodeId":726740331,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2630892602,"text":"Mm? What's \"Five Over Sixteen\"? Is it something that one may eat?","nextNodeIds":[726740332]},{"nodeId":726740332,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3281694306,"text":"Sounds delicious. Want to eat.","nextNodeIds":[726740333]},{"nodeId":726740333,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2919552298,"text":"#{NICKNAME}'s referring to the percentage of stories that you're involved in, Ioroi.","nextNodeIds":[726740334]},{"nodeId":726740334,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":2031388722,"text":"Ioroi. Powerful!","nextNodeIds":[726740335]},{"nodeId":726740335,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2033793218,"text":"Hah, why of course! You have much to learn from my powers, you do.","nextNodeIds":[726740336]},{"nodeId":726740336,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1644070402,"text":"Eh? Come to think of it, we're starting to get what Kichiboushi is saying, aren't we?","nextNodeIds":[726740337]},{"nodeId":726740337,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":300511290,"text":"White Fur smart.","nextNodeIds":[726740338]},{"nodeId":726740338,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":224573450,"text":"That might have been praise, but Paimon sure doesn't feel good about it.","nextNodeIds":[726740339]},{"nodeId":726740339,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3865109178,"text":"Good, good. Then I leave this child in your hands. Take him to go see the world and train!","nextNodeIds":[726740340]},{"nodeId":726740340,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":1552988034,"text":"Why, when I was but a young tanuki, I too went on a pilgrimage to eighteen sites in Inazuma along the trail of the great bake-danuki Tsukumo, never once straying from the tanuki paths — only thus did I reach my present stature.","nextNodeIds":[726740341]},{"nodeId":726740341,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4128850930,"text":"Eh? Is that why you were sealed in stone?","nextNodeIds":[726740342]},{"nodeId":726740342,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1857288482,"text":"Mm-haha! Stone!","nextNodeIds":[726740343]},{"nodeId":726740343,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2420364666,"text":"Eh!? You too, Kichiboushi...?","nextNodeIds":[726740344]},{"nodeId":726740344,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4244379970,"text":"Ahem! So, uh, back on topic! Where should we go first?","nextNodeIds":[726740345,726740347]},{"nodeId":726740345,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1427759146,"text":"There's that place Ioroi mentioned earlier...","nextNodeIds":[726740346]},{"nodeId":726740346,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1146311610,"text":"Uh-huh! Dragonspine it is, then!","nextNodeIds":[726740348]},{"nodeId":726740348,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1458122378,"text":"\"If there's a mountain, we shall climb it\" — ah, Paimon's been waiting for a chance to say something cool like that!","nextNodeIds":[726740349]},{"nodeId":726740349,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":1376070562,"text":"Mountain, there!","nextNodeIds":[726740350]},{"nodeId":726740350,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":2229522322,"text":"Oooh, that sounds cold... Don't let your tummy get cold now, Kichiboushi. You'll catch a cold otherwise, and if you do, you won't be able to perform using your belly drum.","nextNodeIds":[726740351]},{"nodeId":726740351,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","textMapHash":3680743834,"text":"#Also, remember to eat properly and follow {F#Aunt}{M#Uncle} Yellow Fur like a good boy.","nextNodeIds":[726740352]},{"nodeId":726740352,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":204013634,"text":"#Understand! Following {F#Aunt}{M#Uncle} Yellow Fur!","nextNodeIds":[726740353,726740354,726740355]},{"nodeId":726740353,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3253435754,"text":"We'll take good care of Kichiboushi, don't worry.","nextNodeIds":[726740356]},{"nodeId":726740356,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3485494570,"text":"Pleased to meet you, Kichiboushi!","nextNodeIds":[726740357]},{"nodeId":726740357,"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","textMapHash":3775340066,"text":"Mm! No worry! Kichiboushi take care of you!","nextNodeIds":[726740358]},{"nodeId":726740358,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1426269058,"text":"Hmm, looks like we're not completely getting through to him...","nextNodeIds":[]},{"nodeId":726740354,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3844144226,"text":"Don't you worry.","nextNodeIds":[726740356]},{"nodeId":726740355,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":206882770,"text":"#It's not {F#Aunt}{M#Uncle}. It's {F#Big Sis}{M#Big Bro}.","nextNodeIds":[726740356]},{"nodeId":726740347,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4037913242,"text":"How does Dragonspine sound?","nextNodeIds":[726740348]},{"nodeId":726740311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2276422834,"text":"...\"Without any problems,\" he says...","nextNodeIds":[726740312]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3159"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7267401,7267402,7267403,7267404],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"Ioroi","count":48},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":37},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":36},{"roleType":"TALK_ROLE_NPC","speakerId":3160,"speakerName":"\"Kichiboushi\"","count":15},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[172674],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3030334742,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Inazuma_72674/Q7267401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJ