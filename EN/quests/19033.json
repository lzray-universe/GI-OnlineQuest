"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":1903301,"initDialog":1903201201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10918],"performCfg":"QuestDialogue/COOP/CoopChongyun/coop_1903301","priority":5,"questId":19033,"showRandomTalkCount":0},"dialogs":[{"nodeId":1903201201,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":3672485365,"text":"Ugh... I'm beat. Finally, I can take a break.","nextNodeIds":[1903201202]},{"nodeId":1903201202,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":3217640421,"text":"*sigh* I wonder if I took things a little too far... A few people seemed scared out of their minds.","nextNodeIds":[1903201203]},{"nodeId":1903201203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1607708237,"text":"Who are you?","nextNodeIds":[1903201204]},{"nodeId":1903201204,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":1315541533,"text":"Huh? Hey, you shouldn't be here!","nextNodeIds":[1903201205]},{"nodeId":1903201205,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":3262596445,"text":"*sigh* Never mind. I assume you overheard me anyway.","nextNodeIds":[1903201206]},{"nodeId":1903201206,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":2317396309,"text":"I work here pretending to be a ghost, but now's my break time, so I took off my costume. I get all hot and stuffy wearing that thing...","nextNodeIds":[1903201207,1903201208]},{"nodeId":1903201207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":181812901,"text":"So there are no real ghosts here?","nextNodeIds":[1903201209]},{"nodeId":1903201209,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":3497326565,"text":"Of course, how could there be real ghosts here?","nextNodeIds":[1903201210]},{"nodeId":1903201210,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":3279543173,"text":"No one wants to see a real ghost, neither us nor the participants.","nextNodeIds":[1903201211]},{"nodeId":1903201211,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":3813645885,"text":"They just come here for the atmosphere, or should I say, the chance... Everyone wants the chance to feel the thrill of excitement.","nextNodeIds":[1903201212]},{"nodeId":1903201212,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":1475068189,"text":"When people find themselves in a scary situation, they'll say things that they'd never dare to otherwise. That's what the Test of Courage is all about.","nextNodeIds":[1903201213,1903201214]},{"nodeId":1903201213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4270717293,"text":"I think I understand.","nextNodeIds":[1903201215]},{"nodeId":1903201215,"roleType":"TALK_ROLE_NPC","speakerId":10918,"speakerName":"Zhouliang","textMapHash":1574625997,"text":"*sigh* Okay... I should get back to work now. Hope you and... whoever you're here with have a fun time.","nextNodeIds":[]},{"nodeId":1903201214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3247417597,"text":"(Chongyun will be very disappointed.)","nextNodeIds":[1903201215]},{"nodeId":1903201208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1032491221,"text":"It's all planned to scare people, right?","nextNodeIds":[1903201209]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1903301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMC