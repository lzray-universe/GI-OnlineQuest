COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":1911705,"initDialog":191170106,"nextRandomTalks":[],"nextTalks":[],"npcId":[12156],"performCfg":"QuestDialogue/COOP/CoopThoma/Q1911705","priority":5,"questId":19117,"showRandomTalkCount":0},"dialogs":[{"nodeId":191170106,"roleType":"TALK_ROLE_NPC","speakerId":12156,"speakerName":"Ninken","textMapHash":2018073362,"text":"Woof! Woof! *growl*","nextNodeIds":[191170107]},{"nodeId":191170107,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":3461464674,"text":"You're a vicious little thing, aren't you? You almost bit me again!","nextNodeIds":[191170108]},{"nodeId":191170108,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":1618663786,"text":"Look at you, wasting away... you must wanna eat a little something?","nextNodeIds":[191170109]},{"nodeId":191170109,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":3623945626,"text":"You don't have to come back with us, but c'mon — a dog's gotta eat, right?","nextNodeIds":[191170110]},{"nodeId":191170110,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":3768001882,"text":"You're not worried it's poisoned, are you? Here, I'll take the first bite.","nextNodeIds":[191170121]},{"nodeId":191170121,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":3765704810,"text":"See? Delicious and poison-free.","nextNodeIds":[191170111,191170112]},{"nodeId":191170111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2245625010,"text":"Thoma...","nextNodeIds":[191170113]},{"nodeId":191170113,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":3341988306,"text":"Come on, just have a bite. A little tiny bite, and then I'll leave you alone, how's that sound?","nextNodeIds":[191170114]},{"nodeId":191170114,"roleType":"TALK_ROLE_NPC","speakerId":12156,"speakerName":"Ninken","textMapHash":4120448050,"text":"Woof! Woof, woof!","nextNodeIds":[191170115]},{"nodeId":191170115,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":3335649058,"text":"Looks like it has zero intention of eating the food we brought... Is it just me, or does it look kind of on edge?","nextNodeIds":[191170116]},{"nodeId":191170116,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":482801786,"text":"Maybe it's something in the sea... Or something nearby that's got him on alert.","nextNodeIds":[191170117]},{"nodeId":191170117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":841970002,"text":"Those monsters, perhaps?","nextNodeIds":[191170118]},{"nodeId":191170118,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":2512985154,"text":"You think he was attacked by monsters... Hmm, it's possible.","nextNodeIds":[191170119]},{"nodeId":191170119,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":3604010738,"text":"People do tend to lose their appetite in dangerous situations. Maybe it's the same for dogs, too. Let's clear out the area on behalf of our canine companion here.","nextNodeIds":[191170120]},{"nodeId":191170120,"roleType":"TALK_ROLE_NPC","speakerId":503,"speakerName":"Thoma","textMapHash":404031906,"text":"#Thanks for helping out. This place should be a little more tranquil now, {NICKNAME}.","nextNodeIds":[]},{"nodeId":191170112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1184064842,"text":"You're really putting yourself out there...","nextNodeIds":[191170113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[105001,1911704],"PAINLIBBLDK":"QUEST_CONTENT_MAIN_COOP_ENTER_SAVE_POINT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"gui