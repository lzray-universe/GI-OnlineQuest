yList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7105806","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7105805,"initDialog":710580501,"nextRandomTalks":[],"nextTalks":[],"npcId":[20535,1005],"performCfg":"QuestDialogue/WQ/Liyue_71058/Q7105805","priority":5,"questId":71058,"showRandomTalkCount":0},"dialogs":[{"nodeId":710580501,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":3097604802,"text":"As expected, you came. Please take a seat.","nextNodeIds":[710580502]},{"nodeId":710580502,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":513145314,"text":"Lemme see what's left... Black tea is out... Sugar, out too... Alright, here's some milk— Ugh, it's turned sour. Gotta throw it away later. Um, my apologies.","nextNodeIds":[710580503]},{"nodeId":710580503,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":616264474,"text":"But there is plenty of Fire-Water, plus some hardtack and sour jam to go with it — enough for a tea party.","nextNodeIds":[710580504]},{"nodeId":710580504,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3059698626,"text":"Whoa...! Do you people really consider Fire-Water to be a standard tea party thing?","nextNodeIds":[710580505]},{"nodeId":710580505,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":3243343618,"text":"Yep, what's the problem with it?","nextNodeIds":[710580506,710580508]},{"nodeId":710580506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":492556258,"text":"Uh... I'll pass.","nextNodeIds":[710580507]},{"nodeId":710580507,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":2197914658,"text":"What? Hehe, no one's gonna call you out on drinking here. Just suit yourself!","nextNodeIds":[710580510,710580511]},{"nodeId":710580510,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4140843106,"text":"What are you doing?","nextNodeIds":[710580512]},{"nodeId":710580512,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":2093673402,"text":"\"Sharing food and intel at the right moment is conducive to silencing a curious mouth.\"","nextNodeIds":[710580513]},{"nodeId":710580513,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":1166149522,"text":"...that's what our handbook says.","nextNodeIds":[710580514]},{"nodeId":710580514,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3989187146,"text":"Well, where's the intel?","nextNodeIds":[710580515]},{"nodeId":710580515,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":3175930226,"text":"Uh? I just shared it.","nextNodeIds":[710580516]},{"nodeId":710580516,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2787572386,"text":"Huh? Did you tell us anything?","nextNodeIds":[710580517]},{"nodeId":710580517,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":3606571930,"text":"Fatui Advance Team Handbook, Appendix 4-4, Article 32: \"Sharing food and intel at the right moment is conducive to silencing a curious mouth.\" You're welcome.","nextNodeIds":[710580518]},{"nodeId":710580518,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":3043051570,"text":"You saved my life and in return, I divulged classified content from our handbook. Hehe, how's that for sincerity?","nextNodeIds":[710580519]},{"nodeId":710580519,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2840390690,"text":"What's the use of that!?","nextNodeIds":[710580520]},{"nodeId":710580520,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":4058105066,"text":"Hehe, jokes aside... Actually, I'm very grateful for your help, but my kind gesture doesn't mean anything else.","nextNodeIds":[710580521]},{"nodeId":710580521,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1240282290,"text":"Uh... with what you people have done, Paimon finds it hard to believe in your \"kind gesture\"...","nextNodeIds":[710580522]},{"nodeId":710580522,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3817121786,"text":"What are you up to, really?","nextNodeIds":[710580523]},{"nodeId":710580523,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":526524218,"text":"It's no surprise that outsiders fail to understand the cause of the Fatui. But when we aren't talking about what we pursue or which side we are on, we are just a bunch of ordinary people.","nextNodeIds":[710580524]},{"nodeId":710580524,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":583725770,"text":"...Besides, all our agendas and deeds are just preparatory work for the final battle.","nextNodeIds":[710580525]},{"nodeId":710580525,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3356039290,"text":"The final battle...?","nextNodeIds":[710580526]},{"nodeId":710580526,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":919433466,"text":"Yes, in the end, all of us shall face a common enemy and the inescapable long night... Everyone in Snezhnaya has been thusly warned.","nextNodeIds":[710580527]},{"nodeId":710580527,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":2352253122,"text":"So, every drop of tears and blood of mankind, shed for the sake of this cruel world... They shall not be shed in vain.","nextNodeIds":[710580528]},{"nodeId":710580528,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":1463700538,"text":"Let's have a toast! No? Hmph, I'll just suit myself...","nextNodeIds":[710580529,710580531]},{"nodeId":710580529,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":585988290,"text":"Is this how you justify the evil you've done?","nextNodeIds":[710580530]},{"nodeId":710580530,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":666331418,"text":"Maybe you're right... I don't know, nor do I care to know. You wanted an explanation, and I gave you one. You're free to not find it to your liking. That's all.","nextNodeIds":[710580534]},{"nodeId":710580534,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":86494410,"text":"Ugh... Where did all that deep stuff suddenly come from...","nextNodeIds":[710580535]},{"nodeId":710580535,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":323391890,"text":"By the way, I've introduced myself, but I don't know your name yet.","nextNodeIds":[710580536,710580537]},{"nodeId":710580536,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2710767786,"text":"#{NICKNAME}.","nextNodeIds":[710580538]},{"nodeId":710580538,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3988209570,"text":"And Paimon's Paimon!","nextNodeIds":[710580539]},{"nodeId":710580539,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":1618517066,"text":"Oh! Your names...!","nextNodeIds":[710580540]},{"nodeId":710580540,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2455778498,"text":"Hehehe! We're pretty well-known all over the Teyvat, aren't we?","nextNodeIds":[710580541]},{"nodeId":710580541,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":1092658898,"text":"Sorry, I've never heard of you... Either of you, actually.","nextNodeIds":[710580542]},{"nodeId":710580542,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4131172978,"text":"What!?","nextNodeIds":[710580543]},{"nodeId":710580543,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":863807410,"text":"Please don't take it the wrong way — I was sent down here a long time ago. I barely know anything about what's happening on the surface save for the news we get through our supply lines.","nextNodeIds":[710580544]},{"nodeId":710580544,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4189910914,"text":"Eh... Doesn't that mean...","nextNodeIds":[710580545]},{"nodeId":710580545,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2685888170,"text":"That your supply line's long been cut off?","nextNodeIds":[710580546]},{"nodeId":710580546,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":2548140434,"text":"...","nextNodeIds":[710580547]},{"nodeId":710580547,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":4276110162,"text":"Tea party's over! I need to get some rest. Excuse me!","nextNodeIds":[710580548]},{"nodeId":710580548,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":258710898,"text":"Hey! We haven't even started eating yet!","nextNodeIds":[710580549]},{"nodeId":710580549,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":1485400442,"text":"Leave already! Didn't you just frown upon my Fire-Water?","nextNodeIds":[710580550]},{"nodeId":710580550,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1320839954,"text":"That's because Paimon didn't think it was drinkable at all!","nextNodeIds":[710580551,710580552]},{"nodeId":710580551,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2369669058,"text":"Alright, Paimon...","nextNodeIds":[710580553]},{"nodeId":710580553,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3908939218,"text":"Hmph!","nextNodeIds":[710580554]},{"nodeId":710580554,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":576204394,"text":"#By the way, uh...! {NICKNAME}, please wait—","nextNodeIds":[710580555]},{"nodeId":710580555,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":183246786,"text":"Uh, it's nothing. I'm just thinking... that if it were you...","nextNodeIds":[710580556]},{"nodeId":710580556,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":281423338,"text":"Please come back another day... if you don't find it too troublesome.","nextNodeIds":[]},{"nodeId":710580552,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1368855090,"text":"People have different food preferences, y'know...","nextNodeIds":[710580553]},{"nodeId":710580537,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":803754618,"text":"#You might've heard about me. I'm {NICKNAME}.","nextNodeIds":[710580538]},{"nodeId":710580531,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1245723746,"text":"That's quite a lofty-sounding explanation...","nextNodeIds":[710580532]},{"nodeId":710580532,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":918067090,"text":"Ha...! You know what? You should try the liquor and jam from Snezhnaya.","nextNodeIds":[710580533]},{"nodeId":710580533,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":2091414314,"text":"Don't take it all too seriously, and don't think too much about it. Just trust what you want to trust. That's what we call \"belief.\"","nextNodeIds":[710580534]},{"nodeId":710580511,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3793315458,"text":"What are you up to?","nextNodeIds":[710580512]},{"nodeId":710580508,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2506244698,"text":"We are not here for your tea party...","nextNodeIds":[710580509]},{"nodeId":710580509,"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","textMapHash":2419396394,"text":"I know. I know... Don't get so serious.","nextNodeIds":[710580510,710580511]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7105805,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20535"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7105801,7105802,7105805],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20535,"speakerName":"Katarina","count":40},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName