{"mainQuestId":73510,"title":"An Abundant Estimation","description":"The testing on the Shock-Boiled Brews is progressing smoothly. It is time to report back to Hajanad...","titleTextMapHash":1556703527,"descTextMapHash":3480068302,"mainQuestExcel":{"mainQuestId":73510,"titleTextMapHash":1556703527,"title":"An Abundant Estimation","descTextMapHash":3480068302,"description":"The testing on the Shock-Boiled Brews is progressing smoothly. It is time to report back to Hajanad...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5129,"luaPath":"Actor/Quest/WQ73510","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5129,"chapterId":0,"descTextMapHash":3480068302,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73510,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":621821353,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73510","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173510],"series":5129,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1556703527,"type":"WQ","unlockDescTextMapHash":1079374510}},"flow":[{"subQuestId":7351001,"order":1,"stepDescription":"Talk to Hajanad","stepDescTextMapHash":2404864420,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7351001],"talks":[{"talkId":7351001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7351001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351001,"initDialog":735100101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30226],"performCfg":"QuestDialogue/WQ/Sumeru_73510/Q7351001","priority":5,"questId":73510,"showRandomTalkCount":0},"dialogs":[{"nodeId":735100101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3969187058,"text":"Hajanad, it was a great success. Wanna hear the good news?","nextNodeIds":[735100102]},{"nodeId":735100102,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3012872066,"text":"Hold on a moment. Allow me to sense the Shock-Boiling Device you have on you.","nextNodeIds":[735100103]},{"nodeId":735100103,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":148062490,"text":"Ah, this blazing warmth, this magnetic echo! It is like a chorus of alchemical potions in the flames. Such... such excitement!","nextNodeIds":[735100104]},{"nodeId":735100104,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3052036914,"text":"Impeccable, I say! Using the data you've provided, I'm sure I'll be able to write the most perfect report!","nextNodeIds":[735100105]},{"nodeId":735100105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4023641250,"text":"Really? Paimon didn't sense anything.","nextNodeIds":[735100106]},{"nodeId":735100106,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":195203818,"text":"\"White High-Intelligence Floating Assistive Unit,\" you should read a few... books of late-night Akademiya quotations. It will help enhance your linguistic variety!","nextNodeIds":[735100107]},{"nodeId":735100107,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1048690610,"text":"That way, you will be able to understand many intricate analogies, and both your humor and resistance to stress will increase manifold.","nextNodeIds":[735100108]},{"nodeId":735100108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2705096650,"text":"#Nah, Paimon doesn't get what you're saying, and there's no stress anyway. Besides, {NICKNAME}'s not the type to make Paimon do any strange experiments!","nextNodeIds":[735100109]},{"nodeId":735100109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":594103786,"text":"Anyway, don't change the subject. We've performed the experiment as we agreed...","nextNodeIds":[735100110]},{"nodeId":735100110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":872784114,"text":"...So now it's payday!","nextNodeIds":[735100111]},{"nodeId":735100111,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2974976826,"text":"You'll have it, you'll have it! Come on, don't you trust me?","nextNodeIds":[735100112]},{"nodeId":735100112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2017355970,"text":"Eh? This is fifty people's salary? This... kinda feels different from what Paimon expected.","nextNodeIds":[735100113]},{"nodeId":735100113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3732048074,"text":"Err, not that it's too little or anything...","nextNodeIds":[735100114,735100115]},{"nodeId":735100114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1431395498,"text":"But I wouldn't call that \"a large sum of Mora.\"","nextNodeIds":[735100116]},{"nodeId":735100116,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1726112170,"text":"Eh? Did the Mora I saved over this half a year not pack enough of a punch for you?","nextNodeIds":[735100117]},{"nodeId":735100117,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1702374042,"text":"Did I underestimate the price that mercenaries can fetch? The daily wage I planned for them was the same as the daily allowance my mentor gave me, though!","nextNodeIds":[735100118]},{"nodeId":735100118,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2720310298,"text":"My new mentor's very generous, too! Now that I'm under her, I can have one Shawarma Wrap every day and still have funds left over!","nextNodeIds":[735100119]},{"nodeId":735100119,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2104915154,"text":"If I bought a bag of flour and picked some Zaytun Peaches outdoors, then grabbed several buckets of river water to cook them into paste, I could even live for two weeks on a single day's funds!","nextNodeIds":[735100120]},{"nodeId":735100120,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1503536650,"text":"Then, the leftover funds can be diverted back into Shock-Boiled Brew research. And that's how I came up with my estimate for mercenary pay!","nextNodeIds":[735100121,735100122]},{"nodeId":735100121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1188943866,"text":"Your dietary demands are very... modest.","nextNodeIds":[735100123]},{"nodeId":735100123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":188974570,"text":"Hajanad... How have you even survived up till now? You're practically punishing yourself, the way you live!","nextNodeIds":[735100124]},{"nodeId":735100124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2278306554,"text":"You at least need to eat your fill of Shawarma Wrap to call it a \"big meal\"! If you only eat paste every day, you'll definitely ruin your health!","nextNodeIds":[735100125]},{"nodeId":735100125,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":763119906,"text":"I know, I know... I already live very well, you know? Some students need to fork out Mora to finish their studies. I was like that before — now that really was \"not having any time to think about food.\"","nextNodeIds":[735100126]},{"nodeId":735100126,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3805307154,"text":"Now that I have a stipend approved by my mentor, I can eat my fill every day. I consider myself most fortunate, really!","nextNodeIds":[735100127]},{"nodeId":735100127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4096466170,"text":"You didn't get it...","nextNodeIds":[735100128]},{"nodeId":735100128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2858300570,"text":"Paimon's got it! We'll treat you to an awesome meal. That'll show you what real standards are — not this \"just getting by\" stuff!","nextNodeIds":[735100129]},{"nodeId":735100129,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1502415394,"text":"No, I couldn't! The commissioned treating the commissioner? To me, that would never do! Thanks for your concern, but there's no need to worry.","nextNodeIds":[735100130]},{"nodeId":735100130,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3304706418,"text":"As long as I continue to make progress and prove my ability, I will definitely make it someday! Constantly thinking of feasting and drinking is not something I should be doing at this stage.","nextNodeIds":[735100131]},{"nodeId":735100131,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3617547178,"text":"Now then, time's a-wasting. I'm going back to write my report!","nextNodeIds":[735100132]},{"nodeId":735100132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":712062426,"text":"Well, then you could also take some fruits and vegetables from us to make up the difference! We often find Sunsettias and Cabbages, so we've definitely got lots to spare in our bag!","nextNodeIds":[735100133]},{"nodeId":735100133,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3657806058,"text":"Hehehe... Hahahah... Ahahahah! I can already see my mentor's jaw going slack at the sight of these discoveries!","nextNodeIds":[735100134]},{"nodeId":735100134,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3793346066,"text":"Paimon's words may as well be wind between Hajanad's ears. Laughing giddily, she stumbles away...","nextNodeIds":[735100135]},{"nodeId":735100135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":901311922,"text":"And there she goes...","nextNodeIds":[735100136]},{"nodeId":735100136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2744905826,"text":"Paimon keeps getting the feeling that if she keeps going on like this, she's going to collapse from malnutrition at some point.","nextNodeIds":[735100137,735100138]},{"nodeId":735100137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":341524362,"text":"Her mentor should notice, I hope.","nextNodeIds":[735100139]},{"nodeId":735100139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3054104658,"text":"Yeah. From how Hajanad put it, her mentor does really value her.","nextNodeIds":[735100140]},{"nodeId":735100140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2210142650,"text":"Well, guess we can only hope that she finishes her research smoothly and secures more funds, so she can live an ordinary life...","nextNodeIds":[735100141]},{"nodeId":735100141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4024922826,"text":"Maybe we'll meet again. Who knows? Maybe we'll get more rewards and less worry about her eating habits next time!","nextNodeIds":[]},{"nodeId":735100138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4271834410,"text":"Let's hope this research maniac doesn't collapse too easily.","nextNodeIds":[735100139]},{"nodeId":735100122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1946063514,"text":"Your views on standards of living are very... precarious.","nextNodeIds":[735100123]},{"nodeId":735100115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4151558194,"text":"There is some discrepancy here, I must confess.","nextNodeIds":[735100116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173510],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3480068302,"CHECNJEMEFE":{"30226":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73510/Q7351001","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"",