tId":71522,"showRandomTalkCount":0},"dialogs":[{"nodeId":715220101,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":3424338474,"text":"This type of game sure is inspiring, hahaha!","nextNodeIds":[715220102]},{"nodeId":715220102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3524210418,"text":"What new game?","nextNodeIds":[715220103]},{"nodeId":715220103,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":3933936226,"text":"Traveler! Good timing! I happen to need someone to playtest my new game.","nextNodeIds":[715220104]},{"nodeId":715220104,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":509623378,"text":"Look here. I'm calling this game \"Inspiration Eruption.\"","nextNodeIds":[715220105]},{"nodeId":715220105,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":2797957946,"text":"It perfectly captures the entire process of how we poets create poetry!","nextNodeIds":[715220106,715220110]},{"nodeId":715220106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2662000482,"text":"You mean drinking, drinking, and more drinking?","nextNodeIds":[715220107]},{"nodeId":715220109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3448320002,"text":"Enlighten me.","nextNodeIds":[715220110]},{"nodeId":715220107,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":1610305290,"text":"Hahaha, hilarious. Though using wine to let one's creative juices flow is certainly a good idea.","nextNodeIds":[715220108]},{"nodeId":715220108,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":3905677666,"text":"However, wine alone is not enough to inspire truly extraordinary poetry.","nextNodeIds":[715220110]},{"nodeId":715220110,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":1994876354,"text":"Before we write a poem, we have to start by seeking out inspiration.","nextNodeIds":[715220111]},{"nodeId":715220111,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":690268938,"text":"Some like to travel, some prefer solitude, while others... really enjoy using wine to stimulate their creativity.","nextNodeIds":[715220112]},{"nodeId":715220112,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":3278019682,"text":"This is the most challenging part, since we cannot pinpoint where inspiration lies.","nextNodeIds":[715220113]},{"nodeId":715220113,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":2716007610,"text":"So most of the time we feel like we haven't found our muse, and become anxious and depressed...","nextNodeIds":[715220114]},{"nodeId":715220114,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":867509322,"text":"But in truth, inspiration has already visited us and left its mark inside our heads without us ever knowing.","nextNodeIds":[715220115]},{"nodeId":715220115,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":378643898,"text":"At the right juncture, they will come bursting out and take the form of a great poem... or a painting... or something else.","nextNodeIds":[715220116]},{"nodeId":715220116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1720217770,"text":"And you can turn all that into a game?","nextNodeIds":[715220117]},{"nodeId":715220117,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":434499690,"text":"Hahaha! Of course! The process of making poetry is quite clear and easily understood.","nextNodeIds":[715220118]},{"nodeId":715220118,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":3087209690,"text":"It just so happens that there are a few tabletop game designers in Mondstadt interested in my ideas.","nextNodeIds":[715220119]},{"nodeId":715220119,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":1105997394,"text":"After some discussions and a few brainstorming sessions, we finally came up with \"Inspiration Eruption\"!","nextNodeIds":[715220120]},{"nodeId":715220120,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":856079434,"text":"You can try it right now if you're interested.","nextNodeIds":[715220121]},{"nodeId":715220121,"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","textMapHash":4024130882,"text":"Play a few rounds, and maybe you'll become a poet yourself!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30425"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7152201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30425,"speakerName":"Buies","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171522],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":567973198,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/V4.1PoetryA