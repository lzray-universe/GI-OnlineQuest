IGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[35723],"talks":[{"talkId":35723,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["35723","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":35723,"initDialog":3572301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/AQ/Mengde1_357/Q35723","priority":5,"questId":357,"showRandomTalkCount":0},"dialogs":[{"nodeId":3572301,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1869953907,"text":"Stormterror... is attacking Mondstadt itself!","nextNodeIds":[3572302]},{"nodeId":3572302,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3819597867,"text":"#Kaeya, {NICKNAME}, you've come at the right time. We must...","nextNodeIds":[3572303]},{"nodeId":3572303,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":315660587,"text":"Hold on, Amber. Are you perhaps forgetting to introduce us?","nextNodeIds":[3572304]},{"nodeId":3572304,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":333125603,"text":"Oh... right. This is Kaeya, our Cavalry Captain.","nextNodeIds":[3572305]},{"nodeId":3572305,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1380985715,"text":"#These two are travelers from afar, {NICKNAME} and Paimon.","nextNodeIds":[3572306]},{"nodeId":3572306,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":924223131,"text":"(From afar? Is that all we know of them?)","nextNodeIds":[3572307]},{"nodeId":3572307,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3753073011,"text":"Long story short...","nextNodeIds":[3572308]},{"nodeId":3572308,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3989948595,"text":"I see. Welcome to Mondstadt — though you haven't arrived at the best of times, I'm afraid.","nextNodeIds":[3572309]},{"nodeId":3572309,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1731765947,"text":"I understand the anguish of being separated from family.","nextNodeIds":[3572310]},{"nodeId":3572310,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1021094635,"text":"I'm not really sure why you're looking for the Anemo God...","nextNodeIds":[3572311]},{"nodeId":3572311,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2079723611,"text":"But everyone has their secrets, right?","nextNodeIds":[3572312]},{"nodeId":3572312,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1306335595,"text":"Haha, relax! I won't press you for more.","nextNodeIds":[3572313]},{"nodeId":3572313,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1106031611,"text":"First and foremost, on behalf of the Knights of Favonius, I would like to extend our thanks to you for your help just now.","nextNodeIds":[3572314,3572315]},{"nodeId":3572314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1165951259,"text":"Well, we couldn't just leave the situation to fester.","nextNodeIds":[3572318]},{"nodeId":3572318,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2644877251,"text":"Your fight to defend the city against the dragon just now was witnessed by no small number of citizens.","nextNodeIds":[3572319]},{"nodeId":3572319,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":319058331,"text":"The Acting Grand Master of the Knights of Favonius is also very interested in meeting you, and formally invites you both to <color=#00E1FFFF>our headquarters</color>.","nextNodeIds":[]},{"nodeId":3572315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":323755851,"text":"You're welcome! So... Ah... Where's the reward?","nextNodeIds":[3572316]},{"nodeId":3572316,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3532778659,"text":"Ahh... How about a traditional Mondstadt delicacy, Sticky Honey Roast?","nextNodeIds":[3572317]},{"nodeId":3572317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1609139779,"text":"I just heard about that one!","nextNodeIds":[3572318]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[35723,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","K