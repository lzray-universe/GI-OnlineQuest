MapHash":1547471690,"text":"To think that there would be underground ruins here too... *gulp*","nextNodeIds":[726550203,726550204]},{"nodeId":726550203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1324179506,"text":"What's the matter?","nextNodeIds":[726550205]},{"nodeId":726550205,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":3012285498,"text":"N—Nothing, it's nothing.","nextNodeIds":[726550206]},{"nodeId":726550206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":604637602,"text":"You don't look so good. Are you unwell?","nextNodeIds":[726550207]},{"nodeId":726550207,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":807234810,"text":"Haha. I just don't normally get off the boat, so this ruin entrance is... well, quite a sight.","nextNodeIds":[726550208]},{"nodeId":726550208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":403316546,"text":"Really? Paimon doesn't think so.","nextNodeIds":[726550209]},{"nodeId":726550209,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":3432452474,"text":"S—Still, the Captain's order still needs completing. I'm sure you're really curious as to what treasures lie within as well, aren't you, Traveler?","nextNodeIds":[726550210]},{"nodeId":726550210,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":3436366682,"text":"So, could I invite you, experienced and skilled as you are, to take the lead?","nextNodeIds":[726550211]},{"nodeId":726550211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":892560818,"text":"You're hopeless...","nextNodeIds":[726550212]},{"nodeId":726550212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":493637746,"text":"That she is! Come on, Traveler, lets go!","nextNodeIds":[]},{"nodeId":726550204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3390526578,"text":"Find anything new?","nextNodeIds":[726550205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30055"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7265504,"order":4,"stepDescription":"Search the ruins","stepDescTextMapHash":1529116964,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7301,334],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7265502target"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7265503],"talks":[{"talkId":7265503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7265504","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7265503,"initDialog":726550301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30055],"performCfg":"","priority":5,"questId":72655,"showRandomTalkCount":0},"dialogs":[{"nodeId":726550301,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":999190690,"text":"Hmm? Do you need to warm up or anything?","nextNodeIds":[726550302,726550303]},{"nodeId":726550302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1377656178,"text":"Can you tell me anything about these ruins?","nextNodeIds":[726550304]},{"nodeId":726550304,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1780576882,"text":"Well, I'm a Technical Officer, so I don't know much about world history, I'm afraid.","nextNodeIds":[726550305]},{"nodeId":726550305,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1754832034,"text":"Nonetheless, I believe these ruins to be related to the great disaster that occurred five hundred years ago...","nextNodeIds":[726550306]},{"nodeId":726550306,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":2877295162,"text":"I grew up listening to old sailors tell that tale, you know? They said that neither land nor sea could escape the reach of the Abyss...","nextNodeIds":[726550307]},{"nodeId":726550307,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":80960114,"text":"But to me, those were no different from the ghost stories they tell to scare children.","nextNodeIds":[726550308]},{"nodeId":726550308,"roleType":"TALK_ROLE_NPC","speakerId":30055,"speakerName":"Muzhen","textMapHash":1883394210,"text":"I mean, only the terrors you can see are true, after all!","nextNodeIds":[]},{"nodeId":726550303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":897718802,"text":"Do you know anything about those mysterious machines?","nextNodeIds":[726550304]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7301,334],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7265502target"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7265505,"order":5,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"",