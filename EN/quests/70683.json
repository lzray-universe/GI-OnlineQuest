{"mainQuestId":70683,"title":"","description":"","titleTextMapHash":4216004167,"descTextMapHash":628324726,"mainQuestExcel":{"mainQuestId":70683,"titleTextMapHash":4216004167,"title":"","descTextMapHash":628324726,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5233,"luaPath":"Actor/Quest/WQ70683","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5233,"chapterId":0,"descTextMapHash":628324726,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70683,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3690929977,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70683","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4216004167,"type":"WQ","unlockDescTextMapHash":1878958622}},"flow":[{"subQuestId":7068301,"order":1,"stepDescription":"","stepDescTextMapHash":2966576612,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7068307,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7068307],"talks":[{"talkId":7068307,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7068301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["5233","5233009","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7068307,"initDialog":706830701,"nextRandomTalks":[],"nextTalks":[],"npcId":[30668,30669],"performCfg":"QuestDialogue/WQ/MonsterChess_70683/Q7068307","priority":7,"questId":70683,"showRandomTalkCount":0},"dialogs":[{"nodeId":706830701,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":2250930130,"text":"Thank you for your help, Honorary Knight and your Helper in White. You are indeed the famed heroes of Mondstadt — your Wargame records are marvels worthy of repeated breakdown and analysis.","nextNodeIds":[706830702,706830704]},{"nodeId":706830702,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2213034018,"text":"Hehe, go us!","nextNodeIds":[706830703]},{"nodeId":706830703,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1264186850,"text":"#Hehe, well, {NICKNAME}'s faced down countless monsters in real life! Guess we've been a big help to the Knights of Favonius after all, huh?","nextNodeIds":[706830705]},{"nodeId":706830705,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":1752534954,"text":"Yes, this Wargame has gone very well indeed. Both the 7th Company and the Knights as a whole could gain much from analyzing these results.","nextNodeIds":[706830706]},{"nodeId":706830706,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":2292112690,"text":"This way, our efforts to improve security in the areas surrounding Mondstadt should go more smoothly. For example, we'll be better able to deal with sudden attacks of Slimes on older folk, or hilichurls assaulting caravans...","nextNodeIds":[706830707]},{"nodeId":706830707,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":445310298,"text":"Y'know, Paimon somehow feels like that's happened waaaay too many times... Wait, does this mean that they'll never happen again?","nextNodeIds":[706830708]},{"nodeId":706830708,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":2383217178,"text":"...","nextNodeIds":[706830709]},{"nodeId":706830709,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3137355466,"text":"R... Right?","nextNodeIds":[706830710]},{"nodeId":706830710,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":2779088066,"text":"It will take some time, but we...","nextNodeIds":[706830711]},{"nodeId":706830711,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":1641798834,"text":"Phonia! Phonia! Listen— Oh, it's you, Honorary Knight, and your Helper in White! Hey there!","nextNodeIds":[706830712]},{"nodeId":706830712,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":3927471930,"text":"...What is it this time?","nextNodeIds":[706830713]},{"nodeId":706830713,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":953891434,"text":"C'mon, what's with that face? I was just going to give a report regarding the Wargames...","nextNodeIds":[706830714]},{"nodeId":706830714,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":1339726218,"text":"Hmph. Anyway! While I was \"wargaming in silence\" — just as you requested, by the by — I discovered something incredible!","nextNodeIds":[706830715]},{"nodeId":706830715,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1104676586,"text":"Something super duper incredible?","nextNodeIds":[706830716]},{"nodeId":706830716,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":3767385754,"text":"That's absolutely right! You see, even though these are just simulations, if we multiply explosive power by ten times...","nextNodeIds":[706830717]},{"nodeId":706830717,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":784606250,"text":"Wouldn't that miniaturized explosive arrow we developed previously be enough to beat a Ruin Guard in one hit?","nextNodeIds":[706830718]},{"nodeId":706830718,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":74873914,"text":"?","nextNodeIds":[706830719]},{"nodeId":706830719,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1092712538,"text":"?","nextNodeIds":[706830720]},{"nodeId":706830720,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":3625091474,"text":"...","nextNodeIds":[706830721]},{"nodeId":706830721,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":2277856034,"text":"Let me just ask you this first... Why did you have to multiply the power by ten?","nextNodeIds":[706830722]},{"nodeId":706830722,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":2030204354,"text":"Well, that would make the simulation results prettier, wouldn't it? I mean, it might not be possible in real life, but such data is always exciting, right?","nextNodeIds":[706830723]},{"nodeId":706830723,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":1837039954,"text":"So long as we work hard toward that goal, we might someday get those very results! To create a beautiful explosion that has almost one-tenth of a Jumpy Dumpty's power... Ahhh...","nextNodeIds":[706830724]},{"nodeId":706830724,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":601010938,"text":"Well, you should have multiplied the explosion's power by a hundred times, then.","nextNodeIds":[706830725]},{"nodeId":706830725,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":2793503954,"text":"Huh? Oh, right! Well, that's Phonia for you. If we multiplied the explosive force by a hundred times, then we could... We could defeat just about any monster!","nextNodeIds":[706830726]},{"nodeId":706830726,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":1916332410,"text":"Especially if we also used the enhanced model equipped with the Spikey Fish King-Type Tactical Core. That could destroy a whole group of Ruin Graders with one shot—","nextNodeIds":[706830727]},{"nodeId":706830727,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":734828474,"text":"Really? Then why stop there? Why not multiply it ten million times? Perhaps we might even blow the Favonius Cathedral up to where it can have a nice chat with the Fontaine Research Institute.","nextNodeIds":[706830728]},{"nodeId":706830728,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":1010585138,"text":"And then, once the church strings you up for all to see, I can finally cut ties with you and find a normal tenant to rent out my house to.","nextNodeIds":[706830729]},{"nodeId":706830729,"roleType":"TALK_ROLE_NPC","speakerId":30669,"speakerName":"Ematol","textMapHash":701196978,"text":"Uhhh... I was kidding, you know? Just kidding, I swear!","nextNodeIds":[706830730]},{"nodeId":706830730,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":31068138,"text":"Don't worry, so was I. I'm your direct superior, in any case. Were you to be strung up in public, I'd be on the hook for negligence as well. Besides, I can't find anyone to rent the house out to, anyway.","nextNodeIds":[706830731]},{"nodeId":706830731,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":99446778,"text":"Wait, so the joke's that you don't actually have prospective tenants... Wait, that's a terrible joke!","nextNodeIds":[706830732]},{"nodeId":706830732,"roleType":"TALK_ROLE_NPC","speakerId":30668,"speakerName":"Phonia","textMapHash":1771011794,"text":"Aaanyway, thanks again for your help, you two. And Ematol? When you get back, you're going to reflect on changing simulation parameters of your own accord — no arguing.","nextNodeIds":[]},{"nodeId":706830704,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2726646802,"text":"Just glad I could help.","nextNodeIds":[706830705]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7068307,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"