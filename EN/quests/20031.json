ne","textMapHash":2262141201,"text":"You're more than welcome. After all, you are the one helping me.","nextNodeIds":[200310512]},{"nodeId":200310512,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":706100409,"text":"And please note that helping a fellow adventurer to complete a commission also counts towards your eligibility for a daily reward.","nextNodeIds":[200310513]},{"nodeId":200310513,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":4185645385,"text":"We encourage you to work actively with your fellow adventurers. Ad astra abyssosque!","nextNodeIds":[]},{"nodeId":200310509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3818804969,"text":"Only one reward per day?","nextNodeIds":[200310510]},{"nodeId":200310510,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":503589865,"text":"As things currently stand, yes... My apologies.","nextNodeIds":[200310511]},{"nodeId":200310511,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2544366809,"text":"But please be assured that we are constantly pushing Headquarters to make sure all our adventurers receive fair and adequate compensation.","nextNodeIds":[200310512]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003105,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2003107,"order":7,"stepDescription":"Complete 4 Daily Commissi