200310408]},{"nodeId":200310408,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1112299705,"text":"Let me explain the Guild's system to you in a little more detail.","nextNodeIds":[200310409]},{"nodeId":200310409,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":4037903513,"text":"The Guild receives requests from far and wide each day, and assigns commissions to adventurers accordingly.","nextNodeIds":[200310410]},{"nodeId":200310410,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3312347729,"text":"These commissioned adventures are the main source of compensation for our guild members.","nextNodeIds":[200310411]},{"nodeId":200310411,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3542278633,"text":"On the subject of compensation, I should mention that the Guild has prepared a little something for you.","nextNodeIds":[]},{"nodeId":200310406,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2076274673,"text":"I was just being a Good Samaritan.","nextNodeIds":[200310407]},{"nodeId":200310407,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1912191937,"text":"And that is exactly what makes you our avid new adventurer.","nextNodeIds":[200310408]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2010137,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[2003104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2003105,0],"PAINLIBBLDK":"QUEST_CONTENT_ADD_QUEST_PROGRESS","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["2003102","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GU