:"#You did a fine job, {NICKNAME}! Outstanding performance, considering it was your first time.","nextNodeIds":[200310202]},{"nodeId":200310202,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":494561449,"text":"The requester even asked me to thank you on their behalf.","nextNodeIds":[200310203]},{"nodeId":200310203,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3020662241,"text":"And, as promised, you are due your reward.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2010137,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[2003102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2003104,"order":4,"stepDescription":"Talk to Katheryne","stepDescTextMapHash":884914472,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2003103],"talks":[{"talkId":2003103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["2003104","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["1","",""],"type":"QUEST_COND_DAILY_TASK_REWARD_CAN_GET"},{"param":["1","",""],"type":"QUEST_COND_DAILY_TASK_REWARD_RECEIVED"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2003103,"initDialog":200310301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1512],"performCfg":"","priority":10,"questId":20031,"showRandomTalkCount":0},"dialogs":[{"nodeId":200310301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1967723225,"text":"Oh, you shouldn't have! Except, you totally should.","nextNodeIds":[200310302]},{"nodeId":200310302,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":755868873,"text":"This is a token of the Guild's gratitude.","nextNodeIds":[200310303]},{"nodeId":200310303,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2506065809,"text":"We receive many new commissions every day, and without the efforts of each and every adventurer there is no way we could respond to them all.","nextNodeIds":[200310304]},{"nodeId":200310304,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":762803513,"text":"If you complete enough commissions each day, you will be eligible to claim a special reward from me.","nextNodeIds":[200310305]},{"nodeId":200310305,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3267337169,"text":"Your Adventurer Handbook keeps a record of how many adventures you complete each day.","nextNodeIds":[200310306]},{"nodeId":200310306,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3044353401,"text":"Make sure you claim your daily rewards on the days that you complete sufficient adventures. There is a limited quantity of rewards, so it will become forfeit should you not claim it.","nextNodeIds":[200310307,200310309]},{"nodeId":200310307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2298150433,"text":"Okay. Thanks for the explanation.","nextNodeIds":[200310308]},{"nodeId":200310308,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1617430881,"text":"You're more than welcome. After all, you are the one helping me.","nextNodeIds":[200310312]},{"nodeId":200310312,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2046402537,"text":"And please note that helping a fellow adventurer to complete a commission also counts towards your eligibility for a daily reward.","nextNodeIds":[200310313]},{"nodeId":200310313,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3002254881,"text":"We encourage you to work actively with your fellow adventurers. Ad astra abyssosque!","nextNodeIds":[]},{"nodeId":200310309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3771866113,"text":"Only one reward per day?","nextNodeIds":[200310310]},{"nodeId":200310310,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1519308881,"text":"As things currently stand, yes... My apologies.","nextNodeIds":[200310311]},{"nodeId":200310311,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2217371217,"text":"But please be assured that we are constantly pushing Headquarters to make sure all our adventurers receive fair and adequate compensation.","nextNodeIds":[200310312]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2003105,"order":5,"stepDescription":"Talk to Katheryne","stepDescTextMapHash":1244320144,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2010137,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[2003104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2003104],"talks":[{"talkId":2003104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"i