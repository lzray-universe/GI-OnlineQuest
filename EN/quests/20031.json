RMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["2003102","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","",""],"type":"QUEST_COND_DAILY_TASK_REWARD_CAN_GET"},{"param":["0","",""],"type":"QUEST_COND_DAILY_TASK_REWARD_RECEIVED"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2003101,"initDialog":200310101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1512],"performCfg":"","priority":10,"questId":20031,"showRandomTalkCount":0},"dialogs":[{"nodeId":200310101,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2640080161,"text":"We meet again, avid adventurer.","nextNodeIds":[200310102]},{"nodeId":200310102,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":618044593,"text":"Are your adventures going smoothly?","nextNodeIds":[200310103,200310105]},{"nodeId":200310103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":433800969,"text":"I'm like a well-oiled adventuring machine.","nextNodeIds":[200310104]},{"nodeId":200310104,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2007131025,"text":"That is the spirit. Keep it up!","nextNodeIds":[200310107]},{"nodeId":200310107,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3818200825,"text":"It seems that you have a wealth of experience under your belt now. Time to introduce you to the formal work of the Guild.","nextNodeIds":[200310108]},{"nodeId":200310108,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2765598833,"text":"The Guild receives requests from far and wide each day, and assigns <color=#00E1FFFF>commissions</color> to adventurers accordingly.","nextNodeIds":[200310109]},{"nodeId":200310109,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3984651617,"text":"These commissioned adventures are the main source of compensation for our guild members.","nextNodeIds":[200310110]},{"nodeId":200310110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":307013849,"text":"What kind of commissions are they?","nextNodeIds":[200310111]},{"nodeId":200310111,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1450256689,"text":"It is a mixed bag! Anything from running an errand for fellow citizens to dealing with monsters. Some are textbook, others are extremely dangerous.","nextNodeIds":[200310112]},{"nodeId":200310112,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2510785025,"text":"But you do not have to take my word for it. You should find out for yourself.","nextNodeIds":[200310113]},{"nodeId":200310113,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1013595737,"text":"Here you can find the details of today's commissions.","nextNodeIds":[200310114]},{"nodeId":200310114,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":961090457,"text":"Please report back to me upon completion. There will be a generous reward waiting for you.","nextNodeIds":[200310115,200310117]},{"nodeId":200310115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2326879937,"text":"Just leave it to me.","nextNodeIds":[200310116]},{"nodeId":200310116,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3024704921,"text":"#Excellent. I knew I could count on you, {NICKNAME}.","nextNodeIds":[200310119]},{"nodeId":200310119,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3316176049,"text":"#I await your return with great anticipation, {NICKNAME}. Ad astra abyssosque!","nextNodeIds":[]},{"nodeId":200310117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3377260177,"text":"How generous are we talking?","nextNodeIds":[200310118]},{"nodeId":200310118,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3010714257,"text":"Patience is a virtue! You will find out soon enough. I am sure you will not be disappointed.","nextNodeIds":[200310119]},{"nodeId":200310105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":51956833,"text":"Actually, adventuring is quite taxing work.","nextNodeIds":[200310106]},{"nodeId":200310106,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1112298145,"text":"It is always that way when you are starting out. Preparing properly before an adventure can help things go more smoothly.","nextNodeIds":[200310107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2003102,0],"PAINLIBBLDK":"QUEST_CONTENT_ADD_QUEST_PROGRESS","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["2003105","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2003103,"order":3,"stepDescription":"Complete the commission","stepDescTextMapHash":588568504,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2010137,0],