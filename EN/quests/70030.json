{"mainQuestId":70030,"title":"Tuned to the World's Sounds","description":"The Alcor's Chief Mate Juza is looking for you at the Liyue Harbor wharf. Seems that he needs your help with something...","titleTextMapHash":3662713351,"descTextMapHash":3364603110,"mainQuestExcel":{"mainQuestId":70030,"titleTextMapHash":3662713351,"title":"Tuned to the World's Sounds","descTextMapHash":3364603110,"description":"The Alcor's Chief Mate Juza is looking for you at the Liyue Harbor wharf. Seems that he needs your help with something...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ70030","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":3364603110,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70030,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":911481521,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70030","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170030],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3662713351,"type":"WQ","unlockDescTextMapHash":1799505222}},"flow":[{"subQuestId":7003001,"order":1,"stepDescription":"Go to the Liyue Harbor wharf and meet Chief Mate Juza","stepDescTextMapHash":3222002724,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q70030PlayerPort","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q70030PlayerPort","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7003002,"order":2,"stepDescription":"Talk to Chief Mate Juza","stepDescTextMapHash":3162184380,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2433"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7003001],"talks":[{"talkId":7003001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7003002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7003001,"initDialog":700300101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2433],"performCfg":"QuestDialogue/WQ/MusicGameGuide_70030/Q7003001","priority":5,"questId":70030,"showRandomTalkCount":0},"dialogs":[{"nodeId":700300101,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":2432330338,"text":"Hey, hey, Traveler! Long time no see, you been keeping well?","nextNodeIds":[700300102]},{"nodeId":700300102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2788228082,"text":"Have we met?","nextNodeIds":[700300103]},{"nodeId":700300103,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":2981581050,"text":"Oh, uh... So, you've completely forgotten who I am, huh?","nextNodeIds":[700300104]},{"nodeId":700300104,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":720439994,"text":"I'm Juza, chief mate of The Alcor! You hitched a ride with us to Inazuma, in case you'd forgotten.","nextNodeIds":[700300105]},{"nodeId":700300105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2760961586,"text":"#Nah, {F#she's}{M#he's} just kidding with you, Juza! Of course we remember you, hehe.","nextNodeIds":[700300106]},{"nodeId":700300106,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":1028585522,"text":"Ah... I was gonna say! This is The Alcor we're talking about here, and I'm the chief mate to boot...","nextNodeIds":[700300107]},{"nodeId":700300107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2145502650,"text":"Yes, heh, so... you need a hand with anything?","nextNodeIds":[700300108]},{"nodeId":700300108,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":3884743938,"text":"Not me, actually. It's Kaedehara Kid, a temporary crew member of ours.","nextNodeIds":[700300109]},{"nodeId":700300109,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":2515298458,"text":"You know him, right? He came back with us on the return trip from Inazuma.","nextNodeIds":[700300110]},{"nodeId":700300110,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":4100520778,"text":"I don't know what's been going on with him, but he was in really high spirits the whole way back. He kept trying to get everyone to join him for some poetry and song.","nextNodeIds":[700300111]},{"nodeId":700300111,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":1431979690,"text":"Unfortunately, no one on board from Captain Beidou to Little Yue has that kind of um... Kind of, y'know, uh...","nextNodeIds":[700300112,700300114]},{"nodeId":700300112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":560712122,"text":"Sophistication!","nextNodeIds":[700300113]},{"nodeId":700300113,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":2286378122,"text":"Sophistication! Yes! Not an ounce of the stuff between us.","nextNodeIds":[700300116]},{"nodeId":700300116,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":2814252082,"text":"So, once we got to Liyue, he disembarked and disappeared off into mother nature. I'm gonna say he probably couldn't bear being around a bunch of uncouth sailors a second longer.","nextNodeIds":[700300117]},{"nodeId":700300117,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":1958293898,"text":"Then, not long after that, we got a message from him telling us to keep an eye out for you.","nextNodeIds":[700300118]},{"nodeId":700300118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1386395554,"text":"Is he in trouble?","nextNodeIds":[700300119]},{"nodeId":700300119,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":3135575330,"text":"Didn't give the specifics. He just said that if we saw you, we should tell you he wants to chat with you.","nextNodeIds":[700300120]},{"nodeId":700300120,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":1959800914,"text":"From the tone of the message, it didn't sound all that serious — but then again, who'd be asking for the likes of you unless it was some sort of major crisis?","nextNodeIds":[700300121]},{"nodeId":700300121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1549992866,"text":"#Actually, we deal with little things all the time, don't we, {NICKNAME}?","nextNodeIds":[700300122,700300123,700300124]},{"nodeId":700300122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3167381242,"text":"Yep, feeding pigeons and whatnot.","nextNodeIds":[700300125]},{"nodeId":700300125,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":300840026,"text":"Oh... Huh, never would've guessed. So you do everyone's odd jobs, too.","nextNodeIds":[700300126]},{"nodeId":700300126,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":667746402,"text":"No wonder the captain's so fond of you. She's got a soft spot for the honest, hard-working folks of this world, you know?","nextNodeIds":[700300127]},{"nodeId":700300127,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":3433301546,"text":"Ahem! Getting sidetracked. Please go check up on Kaedehara Kid when you get the chance. Last I heard, he was hanging around the north of Liyue.","nextNodeIds":[700300128]},{"nodeId":700300128,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":898062298,"text":"I've got some things to do on the boat — see you 'round, and safe travels!","nextNodeIds":[]},{"nodeId":700300123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2872228650,"text":"Yep, delivering food and so on.","nextNodeIds":[700300125]},{"nodeId":700300124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":996593034,"text":"Yep, spring cleaning and the like.","nextNodeIds":[700300125]},{"nodeId":700300114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1537617282,"text":"Quirkiness!","nextNodeIds":[700300115]},{"nodeId":700300115,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"Juza","textMapHash":2796983058,"text":"No, no! I mean sophistication! We don't have an ounce of the stuff between the whole crew.","nextNodeIds":[700300116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2433"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7003003,"order":3,"stepDescription":"Go to the northern section of Liyue Harbor and look for Kazuha","stepDescTextMapHash":3553789436,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q70030KazuhaStart","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q70030KazuhaStart","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7003004,"order":4,"stepDescription":"Go to the northern section of Liyue Harbor and look for Kazuha","stepDescTextMapHash":3596759052,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1032"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7003002],"talks":[{"talkId":7003002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7003004","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7003002,"initDialog":700300201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1032],"performCfg":"QuestDialogue/WQ/MusicGameGuide_70030/Q7003002","priority":5,"questId":70030,"showRandomTalkCount":0},"dialogs":[{"nodeId":700300201,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":961833090,"text":"While the bridge slowly withers, the strings gently whisper / A twilight melody from the solitary zither...","nextNodeIds":[700300202]},{"nodeId":700300202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2120703282,"text":"Hey, hey! Kaedehara Kid! So what are you up to here? We've come to help!","nextNodeIds":[700300203]},{"nodeId":700300203,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2637162698,"text":"You made it. Good to see you again.","nextNodeIds":[700300204]},{"nodeId":700300204,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":3922790130,"text":"This appellation, \"Kaedehara Kid\"... When uttered by Paimon, it takes on a whole new tone.","nextNodeIds":[700300205]},{"nodeId":700300205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3694405850,"text":"Hee-hee, Paimon learned it from Chief Mate Juza.","nextNodeIds":[700300206,700300207]},{"nodeId":700300206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2785327730,"text":"You seem to be enjoying yourself.","nextNodeIds":[700300208]},{"nodeId":700300208,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":449993346,"text":"Haha, what makes you say that? Do I usually mope around as if perpetually hounded by adverse fate?","nextNodeIds":[700300209]},{"nodeId":700300209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2967869370,"text":"It's 'cause Juza said that you needed us for something! We didn't expect to find you admiring the scenery and reciting poetry without a care in the whole world!","nextNodeIds":[700300210]},{"nodeId":700300210,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":271724874,"text":"The events of Inazuma are behind me, and no longer linger on my mind. Now, I return to Liyue. It is the natural time to explore all the verses and melodies that arise from this land.","nextNodeIds":[700300211]},{"nodeId":700300211,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1584752842,"text":"As to the matter requiring your assistance — there was none to begin with. Unfortunately, you are too late for that, because now, there is.","nextNodeIds":[700300212]},{"nodeId":700300212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3167473314,"text":"Huh? That was really confusing... There was none to begin with, but somehow now there still is...? What!?","nextNodeIds":[700300213]},{"nodeId":700300213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2800299570,"text":"Have you been eating those wild plants that you're not supposed to? 'Cause you're talking total baloney!","nextNodeIds":[700300214]},{"nodeId":700300214,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2697689402,"text":"Shh... Listen.","nextNodeIds":[700300215]},{"nodeId":700300215,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2152159018,"text":"What do you think?","nextNodeIds":[700300216]},{"nodeId":700300216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3741241650,"text":"Wow... Well, Paimon thinks you play just like another bard we know, who plays for loose change.","nextNodeIds":[700300217]},{"nodeId":700300217,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2594067658,"text":"Oh, you're friends with a professional bard? I hope I have the chance to meet them some day. Traveler, what do you think?","nextNodeIds":[700300218,700300219]},{"nodeId":700300218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3279036610,"text":"I think your instrument is broken.","nextNodeIds":[700300220]},{"nodeId":700300220,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1128001914,"text":"Very good, you're right. More to the point, however, it has a certain special ability.","nextNodeIds":[700300221]},{"nodeId":700300221,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2527461682,"text":"I acquired this anonymous Ancient Zither from an abandoned cave dwelling as I was exploring the mountains.","nextNodeIds":[700300222]},{"nodeId":700300222,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1361281050,"text":"When I first found it, it was old, but intact. The sight of it inspired me, and suddenly, I found myself strumming.","nextNodeIds":[700300223]},{"nodeId":700300223,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":189490810,"text":"To my surprise, as soon as the melody began, my mind began to drift, and I could hear the sound of someone playing along with me... somehow, it all felt so familiar...","nextNodeIds":[700300224]},{"nodeId":700300224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2445921850,"text":"Just to circle back for a second — are you sure you haven't been eating anything suspicious? That makes you see things that aren't there?","nextNodeIds":[700300225]},{"nodeId":700300225,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":4041427378,"text":"I don't believe so, because when the melody ended, my mind became completely clear again. That's when I finally started to inspect my surroundings properly: As expected, it was a place full of mystery.","nextNodeIds":[700300226]},{"nodeId":700300226,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1850149450,"text":"The cave was overrun with weeds, so I imagine the owner left a long time ago. But the table and chair were spotless, and gave off a fine and delicate fragrance.","nextNodeIds":[700300227]},{"nodeId":700300227,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1225084170,"text":"Even the ever-present sound of the wind fell silent in that place. It was quite miraculous. I can only assume that it must have been the treasure trove of a fabled Liyue adeptus.","nextNodeIds":[700300228]},{"nodeId":700300228,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1315898154,"text":"Whoa! So this instrument is an adeptus's treasure!?","nextNodeIds":[700300229]},{"nodeId":700300229,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":3626552890,"text":"Haha, who can say? Regardless, it was a wondrous experience, and after it was over, I thought to myself — I simply must share this with a friend.","nextNodeIds":[700300230]},{"nodeId":700300230,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2988873354,"text":"But in Liyue, besides Captain Beidou, you are the only friend I have.","nextNodeIds":[700300231]},{"nodeId":700300231,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":3560827978,"text":"I doubt this would interest Beidou in the least, so I decided to invite you to share this experience.","nextNodeIds":[700300232]},{"nodeId":700300232,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1242027162,"text":"I asked Chief Mate Juza to be on the lookout for you. But unfortunately, the Ancient Zither broke before you arrived.","nextNodeIds":[700300233]},{"nodeId":700300233,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2830638906,"text":"The fault is my own. I've been taking it everywhere with me, and playing it too often.","nextNodeIds":[700300234]},{"nodeId":700300234,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1122722642,"text":"Oh... So even adepti treasures break in the end?","nextNodeIds":[700300235]},{"nodeId":700300235,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1759658202,"text":"If Eternity lies out of reach even for the mighty Electro Archon herself... then it is all the more elusive for everything else.","nextNodeIds":[700300236]},{"nodeId":700300236,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":371180050,"text":"#Uh-oh, well... P—Please be super-duper careful with our Serenitea Pot, {NICKNAME}!","nextNodeIds":[700300237]},{"nodeId":700300237,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1725837122,"text":"Luckily, in this case, the breakage is fixable. It is more akin to hibernation than anything else — the energy within the instrument has dissipated with the passage of time.","nextNodeIds":[700300238]},{"nodeId":700300238,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":339023626,"text":"All we need to do is find the right material, and we can awaken it once again.","nextNodeIds":[700300239]},{"nodeId":700300239,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2513721090,"text":"If I heard correctly, the material in question should be... the Glaze Lily.","nextNodeIds":[700300240]},{"nodeId":700300240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":325522538,"text":"Where did you hear that?","nextNodeIds":[700300241]},{"nodeId":700300241,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2281637338,"text":"As I've mentioned before, the wind carries with it the whispers of everything that resides in the world, and I am attuned to some of what they say.","nextNodeIds":[700300242]},{"nodeId":700300242,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2772733754,"text":"So, I am privy to a few fragments of this Ancient Zither's history.","nextNodeIds":[700300243]},{"nodeId":700300243,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1427910170,"text":"Go on. I'll wait here for you.","nextNodeIds":[700300244]},{"nodeId":700300244,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1838638778,"text":"You are the savior of Liyue Harbor. I'm sure this should be well within your ability to handle?","nextNodeIds":[]},{"nodeId":700300219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3955483594,"text":"That instrument looks quite valuable.","nextNodeIds":[700300220]},{"nodeId":700300207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3627119378,"text":"You seem rather relaxed.","nextNodeIds":[700300208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1032"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7003006,"order":6,"stepDescription":"Search for the Glaze Lilies required to repair the Ancient Zither","stepDescTextMapHash":3120484908,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003006,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1032"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7003003],"talks":[{"talkId":7003003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7003006","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7003006","","","",""],"type":"QUEST_COND_ITEM_GIVING_ACTIVED"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7003003,"initDialog":700300301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1032],"performCfg":"QuestDialogue/WQ/MusicGameGuide_70030/Q7003003","priority":5,"questId":70030,"showRandomTalkCount":0},"dialogs":[{"nodeId":700300301,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2110062514,"text":"You've returned, even before the wind could bring tidings of your progress. This is quite astonishing... How did you achieve it?","nextNodeIds":[700300302]},{"nodeId":700300302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2235464794,"text":"#Hehe, maybe {F#she's}{M#he's} got a few more tricks up {F#her}{M#his} sleeve than you thought!","nextNodeIds":[700300303]},{"nodeId":700300303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":697346610,"text":"Ahem. Will these be enough?","nextNodeIds":[700300304]},{"nodeId":700300304,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":530136922,"text":"Let me see.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003006,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1032"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7003007,"order":7,"stepDescription":"Gave Kazuha the Glaze Lilies","stepDescTextMapHash":4274391012,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003004,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1032"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7003004],"talks":[{"talkId":7003004,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7003007","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7003004,"initDialog":700300401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1032],"performCfg":"QuestDialogue/WQ/MusicGameGuide_70030/Q7003004","priority":5,"questId":70030,"showRandomTalkCount":0},"dialogs":[{"nodeId":700300401,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1329691866,"text":"Good, these are fine specimens. They will be plenty. If we extract the juices and apply them to the body of the instrument, it should awaken from its present slumber.","nextNodeIds":[700300402]},{"nodeId":700300402,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2670611698,"text":"Yes, there it is, that familiar feeling. It's awoken.","nextNodeIds":[700300403]},{"nodeId":700300403,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1428569218,"text":"#Come, try it for yourself, {NICKNAME}. It's all yours.","nextNodeIds":[700300404]},{"nodeId":700300404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2201421674,"text":"When you say \"it's all yours\"...?","nextNodeIds":[700300405]},{"nodeId":700300405,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2138132450,"text":"Haha, can a poet not be forthright in expression? Then, let me rephrase. This instrument is my gift unto you.","nextNodeIds":[700300406]},{"nodeId":700300406,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2510076818,"text":"I came back to Liyue to listen to what this region of the world has to say. In these vast and ancient lands watched over by the Geo Archon, there are countless soft voices to be heard... This gives me all the satisfaction I desire.","nextNodeIds":[700300407]},{"nodeId":700300407,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1757304426,"text":"Of course, should there come a day when you wish to part with this instrument, I will come to collect it. But... I hope that day will never come.","nextNodeIds":[700300408]},{"nodeId":700300408,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":846029458,"text":"Well, my onward journey beckons. What is the customary Liyue saying at moments like this? Ah, yes.","nextNodeIds":[700300409]},{"nodeId":700300409,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":528965170,"text":"#\"We will meet again,\" {NICKNAME}.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003004,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133104660,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1032"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7003008,"order":8,"stepDescription":"