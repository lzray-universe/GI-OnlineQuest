_GUIDE_NPC"},"isHidden":false,"talkIds":[7518802],"talks":[{"talkId":7518802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7518802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7518802,"initDialog":751880201,"nextRandomTalks":[],"nextTalks":[],"npcId":[6430],"performCfg":"","priority":5,"questId":75188,"showRandomTalkCount":0},"dialogs":[{"nodeId":751880201,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":2749730522,"text":"Hey, you over there! ...That's right, you!","nextNodeIds":[751880202]},{"nodeId":751880202,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":117966114,"text":"You've got such a spring in your step, and the speed you run... It's clear you're pretty strong, like someone who works out.","nextNodeIds":[751880203]},{"nodeId":751880203,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":3481928290,"text":"Are you one of our warriors from the Collective of Plenty? Or from another tribe perhaps?","nextNodeIds":[751880204,751880205]},{"nodeId":751880204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2076299458,"text":"I'm just a passing adventurer.","nextNodeIds":[751880206]},{"nodeId":751880206,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":3583016842,"text":"I see, that's too bad. *sigh* Ah well, I guess having someone show up to help right when you need them most is the kind of luck you only find in dreams.","nextNodeIds":[751880207]},{"nodeId":751880207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1364383218,"text":"What's up?","nextNodeIds":[751880208]},{"nodeId":751880208,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":246159818,"text":"Well, I've got a farm here, as I'm sure you've noticed.","nextNodeIds":[751880209]},{"nodeId":751880209,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":1555030482,"text":"I've always managed this farm on my own, but I've been a bit down on my luck lately...","nextNodeIds":[751880210]},{"nodeId":751880210,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":414107866,"text":"A few days ago, I got into a wrestling match with a warrior from the tribe and ended up hurting my back. Yeah, I know, it was a pretty stupid thing to do...","nextNodeIds":[751880211]},{"nodeId":751880211,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":91335778,"text":"As a result, not only can't I help my old pa clear new fields, I can't even manage my own farm. To be honest, right now, even just walking hurts.","nextNodeIds":[751880212]},{"nodeId":751880212,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":617590866,"text":"I was just thinking of hiring someone to help out for a few days when you came along.","nextNodeIds":[751880213]},{"nodeId":751880213,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":2761637114,"text":"It's a pity you're only passing by. Farm work requires daily effort and care, so if you're only here once in a while, my crops will end up going to waste.","nextNodeIds":[751880214]},{"nodeId":751880214,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":4294349250,"text":"But right now, I don't have the strength to travel all the way to the tribe to find someone. *sigh* Aside from the few little Tatankasaurs I've raised, there's really no one else around to help.","nextNodeIds":[751880215]},{"nodeId":751880215,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":2613554026,"text":"Those little troublemakers have been acting up these past few days. All three of them have just been lazing about in the fields, and won't even come back to me.","nextNodeIds":[751880216]},{"nodeId":751880216,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":312180586,"text":"If you would do me a small favor, could you please bring them back? I'm finding it very hard to walk.","nextNodeIds":[751880217]},{"nodeId":751880217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3195466258,"text":"Sure, no problem.","nextNodeIds":[751880218]},{"nodeId":751880218,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":2611202978,"text":"Thanks, I really appreciate it. They're usually quite well-behaved and often keep me company when I'm working in the fields. I'm not sure what's gotten into them these past few days...","nextNodeIds":[751880219]},{"nodeId":751880219,"roleType":"TALK_ROLE_NPC","speakerId":6430,"speakerName":"Paqarin","textMapHash":2475607930,"text":"If you call out to them, I'm sure... I mean, fairly sure that my three little saurians will come back of their own accord.","nextNodeIds":[]},{"nodeId":751880205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2359663298,"text":"I'm not from Natlan at all.","nextNodeIds":[751880206]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7518802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133517034"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6430"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7518803,"order":2,"stepDescription":"","stepDescTextMapHash":1227472292,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7518802,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_GLOBAL_VAR_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_10848:-2481.449,257.759,10375.050]","50"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_