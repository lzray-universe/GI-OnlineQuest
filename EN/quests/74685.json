coratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7468502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468501,"initDialog":746850101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30565],"performCfg":"QuestDialogue/WQ/Watergun_74685/Q7468501","priority":5,"questId":74685,"showRandomTalkCount":0},"dialogs":[{"nodeId":746850101,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":2572815826,"text":"Reducing the power to this level should be sufficient, the bubbleballs will be able to break the targets, an excellent balance of entertainment and safety...","nextNodeIds":[746850102]},{"nodeId":746850102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4247220850,"text":"Bubbleballs? Entertainment? Oh, so it's a toy water cannon! That's a relief...","nextNodeIds":[746850103]},{"nodeId":746850103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1317656730,"text":"Though... Doesn't this water cannon look familiar? Have we... seen it somewhere before?","nextNodeIds":[746850104,746850108]},{"nodeId":746850104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":795356994,"text":"I don't really recall, so let's just say it's our first time seeing it.","nextNodeIds":[746850105]},{"nodeId":746850105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1033235506,"text":"Maybe it's because its shape is so unusual, it looks like a Spinocrocodile... The moment Paimon sees it, she just wants to give it a nickname like \"Crococannon\"...","nextNodeIds":[746850106]},{"nodeId":746850106,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":1574019594,"text":"Crococannon? The name's not bad! \"Croco\" is almost like... the sound of cannonballs! Concise, easy to understand, and memorable... I think it's an excellent suggestion!","nextNodeIds":[746850107]},{"nodeId":746850107,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":1917680266,"text":"Looks like you two are interested in this watercannon! How would you like to be my first guests?","nextNodeIds":[746850112]},{"nodeId":746850112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1500976642,"text":"Oh! Paimon thinks she can guess what you're gonna say next—","nextNodeIds":[746850113]},{"nodeId":746850113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":76462338,"text":"You've just finished making adjustments to the watercannon, and were just planning to find some people to test it out and give you some feedback?","nextNodeIds":[746850114]},{"nodeId":746850114,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":1871935946,"text":"Absolutely and completely correct! You guys are the real deal, you must have worked together with many in the past. I anticipate no difficulties in cooperating with you!","nextNodeIds":[746850115]},{"nodeId":746850115,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":358743090,"text":"Allow me to introduce myself. My name is Brest, and I am a former naval artillery engineer from the Fontaine Research Institute's armaments research team, currently unemployed.","nextNodeIds":[746850116]},{"nodeId":746850116,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":33176842,"text":"In order to make a living, I've been fiddling with this \"Improved Crocomorph Vortex-Based Crocodilian-Armored Heavy Naval Battleship-Style Recreational Water Blasting Cannon\" in the hopes of opening a water park...","nextNodeIds":[746850117]},{"nodeId":746850117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3955613554,"text":"Waitasec, a naval artillery engineer... unemployed... a water park? Paimon's brain is swimming in a sea of confusion...","nextNodeIds":[746850118,746850119]},{"nodeId":746850118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2184703394,"text":"You must've been through quite a bit...","nextNodeIds":[746850120]},{"nodeId":746850120,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":945502738,"text":"No choice, really, times have changed. Fontaine once had an impressive armada, and back then, naval cannons were a non-negotiable requirement. But after a massive battle, the fleet was utterly annihilated...","nextNodeIds":[746850121]},{"nodeId":746850121,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":2108008162,"text":"Fontaine is now a nation of clockwork meka, and the Palais Mermonia has no plans to rebuild the fleet. Naval artillery is expensive, large, and heavy, and there's currently no real use for them... nor for someone like me, who likes to tinker with them...","nextNodeIds":[746850122]},{"nodeId":746850122,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":4034865738,"text":"In any case, military contracting is a dead end, so I've got to consider switching to another industry completely. After all, no matter how you slice it, you've gotta live! Being happy is the important thing.","nextNodeIds":[746850123]},{"nodeId":746850123,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":3281149882,"text":"Opening a water park, earning some money from ticket sales, living an ordinary, peaceful life... not that bad, really...","nextNodeIds":[746850124]},{"nodeId":746850124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2326108794,"text":"Should... Should Paimon say you're really the glass-half-full type? Doesn't seem like you need to be consoled at all...","nextNodeIds":[746850125]},{"nodeId":746850125,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":308893042,"text":"Anyway, let's not talk about sad stuff like that now, let's talk about my Improved Crococannon! It's really super fun!","nextNodeIds":[746850126]},{"nodeId":746850126,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":2590614002,"text":"Based on the blueprints left behind by Monsieur Chatillon, I've made a few targeted optimizations. The new model no longer requires loading, and can even switch between ammunition types!","nextNodeIds":[746850127]},{"nodeId":746850127,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":3587122794,"text":"I've also added more targets and stage designs to make the attraction even more challenging! I've been playing for three days, and I'm still not tired of it!","nextNodeIds":[746850128]},{"nodeId":746850128,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":1769798698,"text":"After you start playing, you'll be able to forget about all your problems, and just lose yourself in the fun! If you're satisfied, then help me spread the word about it!","nextNodeIds":[746850129,746850130]},{"nodeId":746850129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2288267818,"text":"Then we won't mention anything about work or unemployment.","nextNodeIds":[746850131]},{"nodeId":746850131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2142801178,"text":"Say no more, Paimon wants to play!","nextNodeIds":[746850132]},{"nodeId":746850132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":204349890,"text":"Ms. Brest is right, we did work together really well! Paimon hopes that... when other people run into rough patches, they can have that same great attitude she does!","nextNodeIds":[]},{"nodeId":746850130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":234124090,"text":"Then let's try out this new Crococannon.","nextNodeIds":[746850131]},{"nodeId":746850119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":410820250,"text":"That's quite the career shift...","nextNodeIds":[746850120]},{"nodeId":746850108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2313914634,"text":"Hey, isn't this the Crococannon?","nextNodeIds":[746850109]},{"nodeId":746850109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1579045042,"text":"That's right! Paimon remembers now, we saw the Crococannon back in the Veluriyam Mirage! But the person operating it... doesn't look like Mr. Chatillon?","nextNodeIds":[746850110]},{"nodeId":746850110,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":4225550010,"text":"Monsieur Chatillon!? You know of the legendary watercannon designer Chatillon!? ...That means you two must truly be experts in the field!","nextNodeIds":[746850111]},{"nodeId":746850111,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","textMapHash":2216756402,"text":"Looks like you and this watercannon have quite the connection! How would you like to be my first guests?","nextNodeIds":[746850112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133405112"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30565"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"Brest","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174685],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3050870486,"CHECNJEMEFE":{"30565":[1090]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPK