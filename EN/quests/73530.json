{"mainQuestId":73530,"title":"Fight for Academic Reputation!","description":"You meet a familiar-looking researcher sighing by the side of the road. Go ask him what's wrong.","titleTextMapHash":2317760647,"descTextMapHash":1984789078,"mainQuestExcel":{"mainQuestId":73530,"titleTextMapHash":2317760647,"title":"Fight for Academic Reputation!","descTextMapHash":1984789078,"description":"You meet a familiar-looking researcher sighing by the side of the road. Go ask him what's wrong.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5182,"luaPath":"Actor/Quest/WQ73530","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5182,"chapterId":0,"descTextMapHash":1984789078,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73530,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3756106769,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73530","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173530],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2317760647,"type":"WQ","unlockDescTextMapHash":3678945174}},"flow":[{"subQuestId":7353001,"order":1,"stepDescription":"Talk to the groaning researcher","stepDescTextMapHash":3731921172,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7353001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7353001],"talks":[{"talkId":7353001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7353001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7353001,"initDialog":735300101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30225],"performCfg":"QuestDialogue/WQ/Sumeru_73530/Q7353001","priority":5,"questId":73530,"showRandomTalkCount":0},"dialogs":[{"nodeId":735300101,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3112751098,"text":"Haha... *sigh*... Hahaha...","nextNodeIds":[735300102]},{"nodeId":735300102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4086006346,"text":"#Uh, {NICKNAME}, this guy's laughing and crying at the same time... and he looks pretty familiar, doesn't he?","nextNodeIds":[735300103]},{"nodeId":735300103,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1907562978,"text":"Ah! It's been a while, you two. Do you still remember me?","nextNodeIds":[735300104,735300106]},{"nodeId":735300104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2508832202,"text":"Err...","nextNodeIds":[735300105]},{"nodeId":735300105,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":244312154,"text":"It's me, Jami from Amurta! Inventor of the Fayz Potion! You know me!","nextNodeIds":[735300108]},{"nodeId":735300108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":429229362,"text":"Oh, Paimon thinks she remembers you now.","nextNodeIds":[735300109]},{"nodeId":735300109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2846361458,"text":"Is your research going well, then?","nextNodeIds":[735300110]},{"nodeId":735300110,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1636152690,"text":"Haha... Well... *sigh*","nextNodeIds":[735300111]},{"nodeId":735300111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1842758738,"text":"Looks like that's a \"no.\"","nextNodeIds":[735300112]},{"nodeId":735300112,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1587707066,"text":"No, no, thanks to you, my Fayz Potion research achieved rather impressive results.","nextNodeIds":[735300113]},{"nodeId":735300113,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":555057482,"text":"But I was so worried about disappointing my mentor... I never expected him to praise my work to the skies.","nextNodeIds":[735300114]},{"nodeId":735300114,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1204524698,"text":"\"Ah, Jami, well done! A student I am proud of, indeed!\"","nextNodeIds":[735300115]},{"nodeId":735300115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4268957098,"text":"Wait. Isn't that a good thing?","nextNodeIds":[735300116]},{"nodeId":735300116,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":756639826,"text":"It would have been good if we had just stopped there, sure... But what happened afterward was a true nightmare.","nextNodeIds":[735300117]},{"nodeId":735300117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":771183170,"text":"And what happened, exactly?","nextNodeIds":[735300118]},{"nodeId":735300118,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":437860050,"text":"Maybe the data we got was *too* ideal, because my mentor, that smiling old fella with a wrinkly smile, got it into his head to \"try it himself.\"","nextNodeIds":[735300119]},{"nodeId":735300119,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3327125522,"text":"So, I set the experimental site for him, and brewed up the most effective of Fayz Potions...","nextNodeIds":[735300120]},{"nodeId":735300120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1471833930,"text":"And...?","nextNodeIds":[735300121]},{"nodeId":735300121,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1040693298,"text":"And then... Under the watchful eyes of countless students, he boldly stood right in front of the monsters while drinking the potion and got ambushed for his trouble. They beat him in the blink of an eye...","nextNodeIds":[735300122]},{"nodeId":735300122,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":894682978,"text":"Fortunately, he's fine. He just needs some bed rest.","nextNodeIds":[735300123]},{"nodeId":735300123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3069013434,"text":"Pfft, hahaha!","nextNodeIds":[735300124]},{"nodeId":735300124,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3987384234,"text":"Hehe... *cough* Regardless, it was my lack of academic proficiency that embarrassed my mentor.","nextNodeIds":[735300125]},{"nodeId":735300125,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1100997194,"text":"That ill-tempered fogey then proceeded to blame me all the more for \"not considering user needs\" and \"lacking awareness of practical circumstances.\" It was a real tongue-lashing, I'll tell you that.","nextNodeIds":[735300126]},{"nodeId":735300126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1669701474,"text":"Wait, that's unreasonable! He's to blame too!","nextNodeIds":[735300127]},{"nodeId":735300127,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1264944602,"text":"Right? Anyway, that's why I'd like you two to—","nextNodeIds":[735300128,735300129]},{"nodeId":735300128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3632807482,"text":"Teach him a lesson?","nextNodeIds":[735300130]},{"nodeId":735300130,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4197008602,"text":"No, no! I've got no such ill intentions! Not right now, anyway!","nextNodeIds":[735300131]},{"nodeId":735300131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3159405714,"text":"Oh, so you've had them \"before,\" have you?","nextNodeIds":[735300132]},{"nodeId":735300132,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3629023682,"text":"Uh... That's... not super important right now.","nextNodeIds":[735300133]},{"nodeId":735300133,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1737871682,"text":"What I mean to say is that after reviewing previous experiments, I have come up with a \"Long-Lasting Fayz Potion.\"","nextNodeIds":[735300134]},{"nodeId":735300134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1790789570,"text":"Err, and what's that supposed to do?","nextNodeIds":[735300135]},{"nodeId":735300135,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4190543682,"text":"I recalled my mentor's reaction when he was ambushed, and I suddenly realized that we ordinary people tend to freeze up in the face of danger, at a loss as to what to do...","nextNodeIds":[735300136]},{"nodeId":735300136,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":795881370,"text":"If you only drink the potion when you're already in danger, it might have no time to work on you.","nextNodeIds":[735300137]},{"nodeId":735300137,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1224242450,"text":"But this version is different. Once you've drunk it, it will trigger once you encounter danger, which can buy more time for normal folks.","nextNodeIds":[735300138]},{"nodeId":735300138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3683033418,"text":"How can you tell if you're \"in danger\"?","nextNodeIds":[735300139]},{"nodeId":735300139,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3867750114,"text":"Didn't I say so earlier? Ordinary people will lock up when danger approaches. As long as you act normally after drinking the Long-Lasting Fayz Potion, it will not take effect.","nextNodeIds":[735300140]},{"nodeId":735300140,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":311663298,"text":"But once they freeze on the spot, the potion will kick in, slowing their \"subjective\" time.","nextNodeIds":[735300141]},{"nodeId":735300141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3445342586,"text":"Ooh, so that's how it works. Paimon kinda gets it now. In that case... Are you asking us to help you complete your experiment?","nextNodeIds":[735300142]},{"nodeId":735300142,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":3176324186,"text":"That's right. Although the Long-Lasting Fayz Potion was designed for ordinary people, experiments can still be risky, so it would be best to have someone with combat experience do the initial testing.","nextNodeIds":[735300143]},{"nodeId":735300143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3638899050,"text":"Hmm, let Paimon think. Should we help?","nextNodeIds":[735300144]},{"nodeId":735300144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2484064298,"text":"#Ooh, Paimon's suddenly a little hungry. We could use a meal at Lambad's Tavern, don't you think, {NICKNAME}? Do we have enough Mora for that?","nextNodeIds":[735300145,735300146]},{"nodeId":735300145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1077003738,"text":"Hate to break it to you...","nextNodeIds":[735300147]},{"nodeId":735300147,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":1424232594,"text":"*cough* Well, to tell the truth, despite the tongue-lashing, my mentor did grant me a considerable amount of research funding. I would be willing to pay handsomely...","nextNodeIds":[735300148]},{"nodeId":735300148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1580894378,"text":"In that case, let us lend you our aid!","nextNodeIds":[735300149]},{"nodeId":735300149,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":4134902466,"text":"Thank you so much! Please, save me from my shattered academic reputation!","nextNodeIds":[]},{"nodeId":735300146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3630347626,"text":"We're over budget this month.","nextNodeIds":[735300147]},{"nodeId":735300129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3535921258,"text":"Bribe him?","nextNodeIds":[735300130]},{"nodeId":735300106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3182684674,"text":"The one who's always sighing?","nextNodeIds":[735300107]},{"nodeId":735300107,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"Jami","textMapHash":2208462234,"text":"Oh, so you remember that nickname... Yeah, it's me, Jami, the sighing Amurta researcher, shame of my school, and ashamed to this day to speak my name—","nextNodeIds":[735300108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7353001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7353001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId"