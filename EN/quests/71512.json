{"mainQuestId":71512,"title":"Behind the Scenes","description":"In Liyue Harbor, an adventurer is busy with a certain task...","titleTextMapHash":3515475847,"descTextMapHash":877853358,"mainQuestExcel":{"mainQuestId":71512,"titleTextMapHash":3515475847,"title":"Behind the Scenes","descTextMapHash":877853358,"description":"In Liyue Harbor, an adventurer is busy with a certain task...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2019,"luaPath":"Actor/Quest/WQ71512","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2019,"chapterId":0,"descTextMapHash":877853358,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71512,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4253294945,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71512","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171512],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3515475847,"type":"WQ","unlockDescTextMapHash":3940090638}},"flow":[{"subQuestId":7151201,"order":1,"stepDescription":"Talk to Zhaoqin","stepDescTextMapHash":1970805764,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30295"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7151201],"talks":[{"talkId":7151201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7151201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7151201,"initDialog":715120101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30295],"performCfg":"","priority":5,"questId":71512,"showRandomTalkCount":0},"dialogs":[{"nodeId":715120101,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":2577862714,"text":"Did... this area get cleared? Huh... I think it should have been cleared already...","nextNodeIds":[715120102]},{"nodeId":715120102,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":308995962,"text":"Agh, what a headache.","nextNodeIds":[715120103]},{"nodeId":715120103,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":3444859754,"text":"Hmph... You're... the Traveler! My apologies, I was too busy. I didn't even notice you.","nextNodeIds":[715120104]},{"nodeId":715120104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2135265362,"text":"What are you so busy with?","nextNodeIds":[715120105]},{"nodeId":715120105,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":2523893666,"text":"Ahem... So, it's like this. For this year's Lantern Rite festival, we of the Liyue Harbor Adventurers' Guild have been dispatched by the Ministry of Civil Affairs to help with some tertiary tasks.","nextNodeIds":[715120106]},{"nodeId":715120106,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":2903457290,"text":"The Millelith are primarily responsible for patrolling the city and other key areas. We, on the other hand, get to go out and clear out some monsters... along with those good for nothing bandits too.","nextNodeIds":[715120107]},{"nodeId":715120107,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":1242906554,"text":"Speaking of which, you're a registered adventurer as well, aren't you? I've heard plenty about your exploits.","nextNodeIds":[715120108]},{"nodeId":715120108,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":1321008586,"text":"If you want, you can help us out too. What do you say?","nextNodeIds":[715120109,715120110]},{"nodeId":715120109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4134596594,"text":"Isn't it supposed to be the holidays...","nextNodeIds":[715120111]},{"nodeId":715120111,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":868005674,"text":"Well... Since we are helping the ministry during a holiday, they're providing additional compensation for our efforts.","nextNodeIds":[715120112]},{"nodeId":715120112,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":4040439354,"text":"So, should any adventurers be willing to take on these commissions, they'll be able to collect more rewards upon completing their tasks...","nextNodeIds":[715120113,715120115]},{"nodeId":715120113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2044762602,"text":"How much additional compensation are we talking about?","nextNodeIds":[715120114]},{"nodeId":715120114,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":2681037074,"text":"Trust me, it's plenty!","nextNodeIds":[715120123]},{"nodeId":715120123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":574674410,"text":"That depends on how much work I still have left.","nextNodeIds":[715120116]},{"nodeId":715120116,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":1601583250,"text":"Haha! Alright! I knew you wouldn't just stay idle. I'll be sure to mark down all the locations already confirmed by the Guild. Also, please take this miniature Launch Tube.","nextNodeIds":[715120117]},{"nodeId":715120117,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":1941780890,"text":"Should you accept one of the commissions... Remember to launch some fireworks after you clear out an area.","nextNodeIds":[715120118]},{"nodeId":715120118,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":1157647218,"text":"After you launch the fireworks, we will send someone to designate the area as \"cleared.\"","nextNodeIds":[715120119]},{"nodeId":715120119,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":2413506842,"text":"And then, we will adjust the overall plan in accordance with the areas that have been cleared.","nextNodeIds":[715120120]},{"nodeId":715120120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":916159298,"text":"That sounds pretty strategic...","nextNodeIds":[715120121]},{"nodeId":715120121,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":2069632962,"text":"Yeah... This is the Lantern Rite festival after all. We can't let anything go wrong... People are more tense than a stretched cord right now.","nextNodeIds":[715120122]},{"nodeId":715120122,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"Zhaoqin","textMapHash":487611034,"text":"Never mind this for now. I'll go take a look at the situation. Need to make a report to Lan later...","nextNodeIds":[]},{"nodeId":715120115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2993597122,"text":"Then... show me what needs to be done...","nextNodeIds":[715120116]},{"nodeId":715120110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":926413482,"text":"What about the Lantern Rite...","nextNodeIds":[715120111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_T