NONE"},"isHidden":false,"talkIds":[7504201],"talks":[{"talkId":7504201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7504201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7504201,"initDialog":750420101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21481],"performCfg":"","priority":5,"questId":75042,"showRandomTalkCount":0},"dialogs":[{"nodeId":750420101,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":408335226,"text":"Oh, hello. How have you been lately?","nextNodeIds":[750420102]},{"nodeId":750420102,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":1525206578,"text":"Or is there something you would like to confirm?","nextNodeIds":[750420103,750420108,750420115]},{"nodeId":750420103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1391661442,"text":"About the Flamelord's Blessing...","nextNodeIds":[750420104]},{"nodeId":750420104,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":4126620874,"text":"The Flamelord's Blessing... Some hold that it is a kind of atavism, because everyone has always been convinced that this power must stem from a deeper, ancestral source.","nextNodeIds":[750420105]},{"nodeId":750420105,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":489317586,"text":"Yet, according to the Saurian Relics Association's records, these young Saurians that bear this mark are wracked by uncontrollable forces that rise within their bodies as they grow...","nextNodeIds":[750420106]},{"nodeId":750420106,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":1136108842,"text":"This power rips and tears their bodies, turning them into something altogether different from regular Saurians... It drives them berserk, and causes them to lose their sanity.","nextNodeIds":[750420107]},{"nodeId":750420107,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":2173454010,"text":"The best example is Holawaqa, the Qucusaur tyrant... It is said that it once had the Flamelord's Blessing bestowed upon it.","nextNodeIds":[]},{"nodeId":750420108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2048711602,"text":"How would the tribe \"deal with the matter,\" again?","nextNodeIds":[750420109]},{"nodeId":750420109,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":1648032962,"text":"They would send him back to the Night Kingdom, for while he could perhaps never gain the acceptance of the dragons or the Night Kingdom while he lives...","nextNodeIds":[750420110]},{"nodeId":750420110,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":3189677690,"text":"...Once he has left this world, he will without doubt return to the embrace of the night. This may seem cold, yet there he would be reunited with the souls of all beings...","nextNodeIds":[750420111]},{"nodeId":750420111,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":1218133866,"text":"Forgive my presumption, but perhaps that too might be seen as a form of kindness.","nextNodeIds":[750420112]},{"nodeId":750420112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1632428250,"text":"Any clues about the token?","nextNodeIds":[750420113]},{"nodeId":750420113,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":3712507970,"text":"Some, but... I need to find someone who can confirm them. Later on, perhaps you'll find me over with Pacal, leader of the Children of Echoes.","nextNodeIds":[750420114]},{"nodeId":750420114,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":1795288474,"text":"He might look a little... over the top, perhaps, but in all frankness, he's more reliable than the most solid of crystals.","nextNodeIds":[]},{"nodeId":750420115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3295635642,"text":"I have no more questions. Goodbye!","nextNodeIds":[750420116]},{"nodeId":750420116,"roleType":"TALK_ROLE_NPC","speakerId":21481,"speakerName":"Manqu","textMapHash":1050971586,"text":"Your visits are always welcome, friend.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7501901,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_G