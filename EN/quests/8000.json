OMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1015"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[800001],"talks":[{"talkId":800001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["800001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":800001,"initDialog":80000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1015],"performCfg":"QuestDialogue/AQ/Twins1_8000/Q800001","priority":5,"questId":8000,"showRandomTalkCount":0},"dialogs":[{"nodeId":80000101,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":2646212546,"text":"Yes, yes. They have the audacity to go after anything.","nextNodeIds":[80000102]},{"nodeId":80000102,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":2014825258,"text":"The Seven, dragons, gods... no ancient artifact that relates can escape their greedy ambitions.","nextNodeIds":[80000103]},{"nodeId":80000103,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":3987260530,"text":"Still, this time is different... Who do they think they are, going after the Abyss Order's treasures...?","nextNodeIds":[80000104]},{"nodeId":80000104,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":197043122,"text":"Oh, Traveler, it's you.","nextNodeIds":[80000105]},{"nodeId":80000105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3936079186,"text":"Huh? Ganyu, what are you doing here with Lan? Do you have a commission you need to post?","nextNodeIds":[80000106]},{"nodeId":80000106,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":793534730,"text":"#Hello, {NICKNAME}.","nextNodeIds":[80000107]},{"nodeId":80000107,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":1110351530,"text":"We were just discussing the Treasure Hoarders.","nextNodeIds":[80000108]},{"nodeId":80000108,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":1212185138,"text":"Yes, we were just saying how even the audacious Treasure Hoarders should know better than to mess with the Abyss — it's just too evil.","nextNodeIds":[80000109]},{"nodeId":80000109,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2557201458,"text":"But we recently received intel from the Ministry of Civil Affairs that two big-time Treasure Hoarders in Liyue and Mondstadt are planning some big joint operation.","nextNodeIds":[80000110]},{"nodeId":80000110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":391240338,"text":"\"Two big-time Treasure Hoarders\"?","nextNodeIds":[80000111]},{"nodeId":80000111,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":2124930298,"text":"Yes, they're known as \"Big Sis of the South\" and \"Raptor of the North.\"","nextNodeIds":[80000112]},{"nodeId":80000112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":573909378,"text":"Ahh! Raptor! Paimon remembers he tried to run away from Amber in Mondstadt... But who is \"Big Sis of the South\"?","nextNodeIds":[80000113,80000114]},{"nodeId":80000113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2230719050,"text":"Does \"Big Sis\" mean she bosses people around?","nextNodeIds":[80000116]},{"nodeId":80000116,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":3895599402,"text":"You are correct. She is the head of the Treasure Hoarders in Liyue. As I understand it, the Treasure Hoarders all call her \"Boss.\"","nextNodeIds":[80000117]},{"nodeId":80000117,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":2333702122,"text":"Some say that the God of Thieves even bestowed a gift upon her for her exploits, making her \"Big Sis of the Gods.\" ...But that's probably just a wild rumor.","nextNodeIds":[80000118]},{"nodeId":80000118,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3945182906,"text":"Anyway, the Treasure Hoarders discovered some previously unexplored ruins that the Abyss Order has been secretly guarding in the shadows.","nextNodeIds":[80000119]},{"nodeId":80000119,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2307046178,"text":"Despite how dangerous that makes it, all the Treasure Hoarders can think about is what kinds of treasure could be inside...","nextNodeIds":[80000120]},{"nodeId":80000120,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":412658786,"text":"They have already devised a plan: they will send out a decoy to divert the Abyss Order's forces away from the ruins, then send an expert thief inside to steal the treasure.","nextNodeIds":[80000121]},{"nodeId":80000121,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":3833865746,"text":"To this end, Big Sis and Raptor have reportedly recruited a certain \"Grand Thief\" from Fontaine...","nextNodeIds":[80000122]},{"nodeId":80000122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2705801794,"text":"\"Grand Thief\"? That's quite an impressive-sounding title.","nextNodeIds":[80000123]},{"nodeId":80000123,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":258971434,"text":"Indeed. He is an extraordinary individual.","nextNodeIds":[80000124]},{"nodeId":80000124,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":968375562,"text":"The Grand Thief is highly respected in the Treasure Hoarders, in the same way that we adventurers look up to great adventurers.","nextNodeIds":[80000125,80000127]},{"nodeId":80000125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1360704098,"text":"Just like the famous adventurer, Alice?","nextNodeIds":[80000126]},{"nodeId":80000126,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":298773098,"text":"Ah, so you're familiar with the author of the Teyvat Travel Guide, then? Correct, the Grand Thief is someone as renowned as her.","nextNodeIds":[80000129]},{"nodeId":80000129,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":3563371986,"text":"So, despite being relative big-timers in Liyue and Mondstadt, Big Sis and Raptor had to put in a lot of work to convince a thief of his status to come and personally oversee this operation.","nextNodeIds":[80000130]},{"nodeId":80000130,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":213248050,"text":"With the major changes in Liyue recently, the Ministry of Civil Affairs and the Millelith already have their hands full. They don't have any time to investigate rumors about Treasure Hoarder activity.","nextNodeIds":[80000131]},{"nodeId":80000131,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":766065994,"text":"But anything related to the Abyss makes me feel like there is some unknown danger lurking beneath the surface...","nextNodeIds":[80000132]},{"nodeId":80000132,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2348949994,"text":"So, I decided to come to the Adventurers' Guild to post a commission.","nextNodeIds":[80000133,80000134]},{"nodeId":80000133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2038458914,"text":"Well, since I'm here...","nextNodeIds":[80000135]},{"nodeId":80000135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1604223146,"text":"Mm-hmmm! Leave this commission to us!","nextNodeIds":[80000136]},{"nodeId":80000136,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":247240714,"text":"Oh, thank you so much.","nextNodeIds":[80000137]},{"nodeId":80000137,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":1267695890,"text":"Good to see this in the hands of a reliable Guild member. Well then, good luck. The Guild will take care of the details of this commission.","nextNodeIds":[]},{"nodeId":80000134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4243845330,"text":"I, too, understand the dangers of the Abyss.","nextNodeIds":[80000135]},{"nodeId":80000127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2632901202,"text":"Just like the great adventurer, Stanley?","nextNodeIds":[80000128]},{"nodeId":80000128,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":1847975298,"text":"Ah, you met the living legend himself while you were in Mondstadt? Correct, the Grand Thief is someone just as renowned as him.","nextNodeIds":[80000129]},{"nodeId":80000114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3219691706,"text":"Is she the \"Boss\" the Treasure Hoarders refer to?","nextNodeIds":[80000115]},{"nodeId":80000115,"roleType":"TALK_ROLE_NPC","speakerId":201601,"speakerName":"Lan","textMapHash":3820845434,"text":"You already know something then. I guess you must have crossed paths with the Treasure Hoarders many times before.","nextNodeIds":[80000116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[800001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1015"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":800002,"order":3,"stepDescription":"Go to the ruins","stepDescTextMapHash":641250884,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1114,233],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":"3"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE