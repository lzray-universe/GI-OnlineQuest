{"mainQuestId":72133,"title":"Orobashi's Legacy: Prologue","description":"Yashiori Island is deep in the throes of the Tatarigami's effects. Still, a miner named Kaji remains on the island, seemingly searching for a way to inhibit the corruption's proliferation...","titleTextMapHash":4155151279,"descTextMapHash":3266313670,"mainQuestExcel":{"mainQuestId":72133,"titleTextMapHash":4155151279,"title":"Orobashi's Legacy: Prologue","descTextMapHash":3266313670,"description":"Yashiori Island is deep in the throes of the Tatarigami's effects. Still, a miner named Kaji remains on the island, seemingly searching for a way to inhibit the corruption's proliferation...","chapterId":10037,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ72133","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":10037,"descTextMapHash":3266313670,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72133,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2691279281,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72133","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172133],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4155151279,"type":"WQ","unlockDescTextMapHash":189199078}},"flow":[{"subQuestId":7213301,"order":1,"stepDescription":"","stepDescTextMapHash":1810252292,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7213301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7213301],"talks":[{"talkId":7213301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7213301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7213301,"initDialog":721330101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20248],"performCfg":"","priority":5,"questId":72133,"showRandomTalkCount":0},"dialogs":[{"nodeId":721330101,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":2078953458,"text":"Hello! Excuse me, outlander. Could you hear me out?","nextNodeIds":[721330102]},{"nodeId":721330102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1835951162,"text":"What's up?","nextNodeIds":[721330103]},{"nodeId":721330103,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3981675842,"text":"Please don't linger on this island for too long. Recently, the Tatarigami's reach has spread wider and wider.","nextNodeIds":[721330104]},{"nodeId":721330104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1786370922,"text":"\"Tatarigami\"?","nextNodeIds":[721330105]},{"nodeId":721330105,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":2005786106,"text":"Yes, since the people from Sangonomiya destroyed the ward that suppressed the soul of the serpent god, the Tatarigami has spread across the island...","nextNodeIds":[721330106]},{"nodeId":721330106,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":543431290,"text":"As you can see, the sky is now perpetually clouded and the rain won't stop. This is all because of the Tatarigami.","nextNodeIds":[721330107]},{"nodeId":721330107,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":2022112490,"text":"Recently, one by one all the miners have fallen ill, gone insane, or fled to other islands...","nextNodeIds":[721330108]},{"nodeId":721330108,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3556091290,"text":"Everyone's gone. There's hardly anyone living on this island anymore.","nextNodeIds":[721330109]},{"nodeId":721330109,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":428939370,"text":"Ironically, due to the chaos created by the Tatarigami, the Shogunate and the rebels have not been fighting over this place quite as hard.","nextNodeIds":[721330110]},{"nodeId":721330110,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":782065138,"text":"Hmph! But if they had not destroyed our great Ogosho's ward, the island wouldn't have become such a mess in the first place!","nextNodeIds":[721330111]},{"nodeId":721330111,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":4094195858,"text":"What do the Commissions or dragons or serpents have to do with me, huh? They never asked my opinion before starting their cursed war!","nextNodeIds":[721330112]},{"nodeId":721330112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3242041426,"text":"Then why are you still here?","nextNodeIds":[721330113]},{"nodeId":721330113,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3445888602,"text":"Why? Because this is my home.","nextNodeIds":[721330114]},{"nodeId":721330114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2417758882,"text":"What about your family?","nextNodeIds":[721330115]},{"nodeId":721330115,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3605329858,"text":"They are in a safe place, but thanks for your concern. They must be waiting for me to bring them back here.","nextNodeIds":[721330116]},{"nodeId":721330116,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3681421770,"text":"No one on the island left voluntarily. We are a family here. Anywhere else we go, we'll have to work for someone else.","nextNodeIds":[721330117]},{"nodeId":721330117,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":2979444994,"text":"But someone had to stay and clean up the mess so that everyone else can return home eventually.","nextNodeIds":[721330118]},{"nodeId":721330118,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":4107980338,"text":"*sigh* This is such a headache...","nextNodeIds":[721330119]},{"nodeId":721330119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":985326266,"text":"Is there anything I can help with?","nextNodeIds":[721330120]},{"nodeId":721330120,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":558354714,"text":"If it were any other child offering to help me out of the blue, I'd be laughing out loud right now...","nextNodeIds":[721330121]},{"nodeId":721330121,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":1328343162,"text":"But seeing as you're a traveler from afar who has managed to venture this deep into Inazuma, you must certainly be able to hold your own.","nextNodeIds":[721330122]},{"nodeId":721330122,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":42991290,"text":"I'll get straight to the point, then. The ward over there has been bothering me for a long time, maybe you could find a way to repair it?","nextNodeIds":[721330123]},{"nodeId":721330123,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":2986750882,"text":"I'm sure that this awful weather can only be due to the wards' destruction.","nextNodeIds":[721330124]},{"nodeId":721330124,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":925786090,"text":"But please, be careful when you approach the ward. If you stare at it, it will release a burst of energy towards you...","nextNodeIds":[721330125]},{"nodeId":721330125,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3237192186,"text":"It's harmless, but very uncomfortable. It feels like it's... rejecting you.","nextNodeIds":[721330126]},{"nodeId":721330126,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":1865980746,"text":"I think the ward is missing some components. It can probably be fixed by putting the missing parts back.","nextNodeIds":[721330127]},{"nodeId":721330127,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":142703850,"text":"Of course, that's just speculation on my part. I still can't say for sure what's gone wrong.","nextNodeIds":[721330128]},{"nodeId":721330128,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3489619530,"text":"So, if you want to help, please help me fix this ward.","nextNodeIds":[721330129]},{"nodeId":721330129,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":1936109194,"text":"But if you can't manage it, then like I was saying — don't stick around here too long.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7213301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7213301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","count":24},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[172133],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3266313670,"CHECNJEMEFE