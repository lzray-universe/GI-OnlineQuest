,"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":501308,"initDialog":50130801,"nextRandomTalks":[],"nextTalks":[],"npcId":[1095],"performCfg":"QuestDialogue/AQ/Natlan_5013/Q501308","priority":5,"questId":5013,"showRandomTalkCount":0},"dialogs":[{"nodeId":50130801,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":4070813666,"text":"The Children of Echoes' territory is secure. All monsters down.","nextNodeIds":[50130802]},{"nodeId":50130802,"roleType":"TALK_ROLE_NPC","speakerId":1086,"speakerName":"Kachina","textMapHash":3228270802,"text":"I'll go deal with the Abyss Tumor!","nextNodeIds":[50130803]},{"nodeId":50130803,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":4104535642,"text":"All good here at the People of the Springs, too. We crushed it!","nextNodeIds":[50130804]},{"nodeId":50130804,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","textMapHash":655370066,"text":"Masters of the Night-Wind are also safe. Should I go support the Flower-Feather Clan?","nextNodeIds":[50130805]},{"nodeId":50130805,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1692142322,"text":"Things are still pretty rough over there. I'm already en route.","nextNodeIds":[50130806]},{"nodeId":50130806,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":142482050,"text":"No need. I just dealt with it.","nextNodeIds":[50130807]},{"nodeId":50130807,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2720589074,"text":"Already!? But you were just at the Stadium!","nextNodeIds":[50130808]},{"nodeId":50130808,"roleType":"TALK_ROLE_NPC","speakerId":1092,"speakerName":"Chasca","textMapHash":2035317514,"text":"Yeah, well. You have no idea how long I've been itching to bash some heads in.","nextNodeIds":[50130809]},{"nodeId":50130809,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3256608186,"text":"Oh... Fair enough...","nextNodeIds":[50130810]},{"nodeId":50130810,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":889864146,"text":"Iansan, what should we do about the Collective of Plenty? Your home's a long ways away from the stadium.","nextNodeIds":[50130811]},{"nodeId":50130811,"roleType":"TALK_ROLE_NPC","speakerId":1091,"speakerName":"Iansan","textMapHash":4148745538,"text":"Oh, no need to worry. I just heard from Varesa, she says they're safe now.","nextNodeIds":[50130812]},{"nodeId":50130812,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":1339849506,"text":"Sounds like all regions are secured. The Abyss forces are weakening.","nextNodeIds":[50130813]},{"nodeId":50130813,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3350479194,"text":"Yeah! Their only game-plan was to outnumber us, and that ain't gonna work now that we have the Ode of Resurrection on our side!","nextNodeIds":[50130814]},{"nodeId":50130814,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":94413858,"text":"Hold up... The Abyss is sending a sizeable unit towards the Stadium.","nextNodeIds":[50130815]},{"nodeId":50130815,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"Kinich","textMapHash":1710100266,"text":"I guess they've realized that the Ode of Resurrection is a game changer, so now, they are going to try to destroy the sacred flame.","nextNodeIds":[50130816]},{"nodeId":50130816,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":2131093026,"text":"We ain't gonna let them get away with that. Friends, let's gather at the stadium!","nextNodeIds":[50130817]},{"nodeId":50130817,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1357385546,"text":"More Abyss Tumors have descended, all near the Stadium. Let's split up and take them out.","nextNodeIds":[50130818]},{"nodeId":50130818,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":4095826450,"text":"Oh, and we need someone to guard the main entrance.","nextNodeIds":[50130819]},{"nodeId":50130819,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1069841210,"text":"Allow me.","nextNodeIds":[50130820]},{"nodeId":50130820,"roleType":"TALK_ROLE_NPC","speakerId":1087,"speakerName":"Mualani","textMapHash":569840994,"text":"Alright. This is the final battle!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[501308,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["20238017","4"],"PAINLIBBLDK":"QUEST_EXEC_SET_ABYSS_WAR_LIMIT_REGION_STATE"},{"LNHLPKELCAL":["24","4"],"PAINLIBBLDK":"QUEST_EXEC_SET_ABYSS_WAR_LEVEL_STATE"},{"LNHLPKELCAL":[],"PAINLIBBLDK":"QUEST_EXEC_FINISH_ABYSS_WAR_ACCOUNT_PERFORMANCE"},{"LNHLPKELCAL":["20238001","4"],"PAINLIBBLDK":"QUEST_EXEC_SET_ABYSS_WAR_LIMIT_REGION_STATE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[20238_133:-1665.806,49.534,8161.581]","20"],"NOCCOBOFKHP":20238,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":501310,"order":12,"stepDescription":"Hold the gate! Repel the final attack!","stepDescTextMapHash":828075884,"finishConds":[{"BFGALAINLMD":1