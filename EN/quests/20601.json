erId":1413,"speakerName":"Jack","textMapHash":1412876274,"text":"Ugh... Anyway, I... This is embarrassing, but I have something to ask of you...","nextNodeIds":[206010606]},{"nodeId":206010606,"roleType":"TALK_ROLE_NPC","speakerId":1413,"speakerName":"Jack","textMapHash":158980394,"text":"I actually came to the Thousand Winds Temple because I'm soon to take an Adventure Ranking test...","nextNodeIds":[206010607]},{"nodeId":206010607,"roleType":"TALK_ROLE_NPC","speakerId":1413,"speakerName":"Jack","textMapHash":314143138,"text":"I thought that the ranking would go much more smoothly if I could show my stuff at this time.","nextNodeIds":[206010608]},{"nodeId":206010608,"roleType":"TALK_ROLE_NPC","speakerId":1413,"speakerName":"Jack","textMapHash":3139071914,"text":"I never thought that I'd not only have nothing to show for it, but almost lose my life in the process as well.","nextNodeIds":[206010609]},{"nodeId":206010609,"roleType":"TALK_ROLE_NPC","speakerId":1413,"speakerName":"Jack","textMapHash":2104132810,"text":"C—Could I ask you not to tell Cyrus about this? I'd truly be in hot soup if this were to affect my ranking...","nextNodeIds":[206010610,206010612]},{"nodeId":206010610,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":583578258,"text":"Your secret's safe with me.","nextNodeIds":[206010611]},{"nodeId":206010611,"roleType":"TALK_ROLE_NPC","speakerId":1413,"speakerName":"Jack","textMapHash":229779034,"text":"Thank you so much! I promise I won't be so reckless in future!","nextNodeIds":[]},{"nodeId":206010612,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":355883538,"text":"This isn't right...","nextNodeIds":[206010613]},{"nodeId":206010613,"roleType":"TALK_ROLE_NPC","speakerId":1413,"speakerName":"Jack","textMapHash":3986219986,"text":"I know it isn't, and Cyrus always says that adventurers should be honest with themselves...","nextNodeIds":[206010614]},{"nodeId":206010614,"roleType":"TALK_ROLE_NPC","speakerId":1413,"speakerName":"Jack","textMapHash":2267941586,"text":"But... *sigh* Forget it. I just hope he wont be too mad at me...","nextNodeIds":[]}]},{"talkId":2060107,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["2060108","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2060107,"initDialog":206010701,"nextRandomTalks":[],"nextTalks":[],"npcId":[1409],"performCfg":"","priority":5,"questId":20601,"showRandomTalkCount":0},"dialogs":[{"nodeId":206010701,"roleType":"TALK_ROLE_NPC","speakerId":1409,"spea