LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1004"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7050404,"order":6,"stepDescription":"Give the drinks to Keaya and Rosaria","stepDescTextMapHash":2245957020,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1004"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7050402],"talks":[{"talkId":7050402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7050404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7050402,"initDialog":705040201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1020,1004],"performCfg":"QuestDialogue/WQ/Mengde_70504/Q7050402","priority":5,"questId":70504,"showRandomTalkCount":0},"dialogs":[{"nodeId":705040201,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":3848521330,"text":"Hmm...","nextNodeIds":[705040202]},{"nodeId":705040202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3439932154,"text":"What is it, Rosaria? You don't like the drink?","nextNodeIds":[705040203]},{"nodeId":705040203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1333548266,"text":"I can make you another one...","nextNodeIds":[705040204]},{"nodeId":705040204,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":492588178,"text":"No, the drink you made me is fine. It's just that I rarely ever drink tea. The taste always reminds me of certain... things.","nextNodeIds":[705040205]},{"nodeId":705040205,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":497195354,"text":"Ah, I presume you're referring to the church?","nextNodeIds":[705040206]},{"nodeId":705040206,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":639397690,"text":"Yes. The church once held an event that I couldn't attend, but Sister Barbara still saved some tea and dessert for me...","nextNodeIds":[705040207]},{"nodeId":705040207,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":2056630538,"text":"The dessert had already gone stale, so she whisked it away when I wasn't looking, but the tea tasted just like this drink you made me.","nextNodeIds":[705040208]},{"nodeId":705040208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":399208226,"text":"Boy, you're in rare form today, Rosaria.","nextNodeIds":[705040209]},{"nodeId":705040209,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1090394114,"text":"Sounds to me like Mondstadt's just gained another black tea lover.","nextNodeIds":[705040210]},{"nodeId":705040210,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":2240985658,"text":"Heh, I'd prefer something a little stiffer.","nextNodeIds":[705040211]},{"nodeId":705040211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2475349866,"text":"What about you, Kaeya? How's your drink?","nextNodeIds":[705040212]},{"nodeId":705040212,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3628090818,"text":"That depends. If I point out a few flaws, will you make me another one?","nextNodeIds":[705040213]},{"nodeId":705040213,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1327708738,"text":"Hahaha, I'm just kidding. I'd never subject you to such treatment.","nextNodeIds":[705040214]},{"nodeId":705040214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1468772458,"text":"Gosh, Kaeya sure is a tough nut to crack, you never know what he'll say next. How can you stand to drink with this guy, Rosaria?","nextNodeIds":[705040215]},{"nodeId":705040215,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":3089362434,"text":"Hmm? I don't really care what's going through his mind, as long as we only talk about drinks.","nextNodeIds":[705040216]},{"nodeId":705040216,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":3354583922,"text":"Besides, Kaeya's only interested in people or things that intrigue him, whether that's you, the innkeeper here, or anybody else...","nextNodeIds":[705040217]},{"nodeId":705040217,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3164327594,"text":"Hey! How could you divulge so much about your dear old drinking buddy, hmm?","nextNodeIds":[705040218]},{"nodeId":705040218,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":981190554,"text":"You think I'm saying too much? Heh, get over yourself, it's no big deal.","nextNodeIds":[705040219]},{"nodeId":705040219,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":824172698,"text":"Ugh, I'm constantly surrounded by uptight folks day-to-day. I prefer the easygoing atmosphere in the tavern.","nextNodeIds":[705040220]},{"nodeId":705040220,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2846253386,"text":"Ooh, are we gossiping about people who take themselves too seriously, now?","nextNodeIds":[705040221]},{"nodeId":705040221,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2947778786,"text":"Speaking of which, I know someone who could easily place in the \"Top Three Most Serious People in Mondstadt.\"","nextNodeIds":[705040222]},{"nodeId":705040222,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1344378466,"text":"As to their level of seriousness... Well, let me put it this way, they probably wouldn't even flinch if I said that to their face.","nextNodeIds":[705040223]},{"nodeId":705040223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1895538764,"text":"Are there really rankings for people like that?","nextNodeIds":[705040224]},{"nodeId":705040224,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2000192434,"text":"Of course. Just off the top of my head, there's a running list for the most consistent drinkers, hardest workers, worst cooks, or even... biggest hoarders of dark secrets.","nextNodeIds":[705040225]},{"nodeId":705040225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2639312018,"text":"Sounds to Paimon like Mondstadters have way too much time on their hands!","nextNodeIds":[705040226]},{"nodeId":705040226,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":2359703658,"text":"Are there really that many people who don't need to work?","nextNodeIds":[705040227,705040228]},{"nodeId":705040227,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3135242602,"text":"No...","nextNodeIds":[705040229]},{"nodeId":705040229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1256660826,"text":"#Aww, but what about Paimon? Is there a category that Paimon can be ranked as high as {F#her}{M#him}?","nextNodeIds":[705040230]},{"nodeId":705040230,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2430716162,"text":"Why, of course. How about, \"Best Bartenders\"?","nextNodeIds":[705040231]},{"nodeId":705040231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1704557658,"text":"R—Really!?","nextNodeIds":[705040232]},{"nodeId":705040232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2400570170,"text":"#That's great, {NICKNAME}! Our names will be remembered together forever!","nextNodeIds":[705040233]},{"nodeId":705040233,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":4098515290,"text":"Heh...","nextNodeIds":[705040234]},{"nodeId":705040234,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":1179283978,"text":"Well, I must admit, the atmosphere you bring isn't half bad.","nextNodeIds":[705040235]},{"nodeId":705040235,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":4248781834,"text":"You can say that again. Just looking at these two brings a smile to my face.","nextNodeIds":[705040236]},{"nodeId":705040236,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1871140506,"text":"Good bartenders create a nice atmosphere and get people in a good mood. You know, like a mascot... so I guess there's really no contest for the title of \"Best Bartenders.\"","nextNodeIds":[705040237]},{"nodeId":705040237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2025492210,"text":"Huh?","nextNodeIds":[705040238]},{"nodeId":705040238,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":995093666,"text":"Heh, nothing. Thanks for your hospitality.","nextNodeIds":[705040239]},{"nodeId":705040239,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":4280829026,"text":"Yeah, I should be going, too.","nextNodeIds":[705040240]},{"nodeId":705040240,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","textMapHash":1432238130,"text":"By the way, that black tea tasted great. I'll try to make some for myself in the future... if I can manage to get up early enough in the morning, that is.","nextNodeIds":[705040241]},{"nodeId":705040241,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":352809754,"text":"Until next time.","nextNodeIds":[705040242]},{"nodeId":705040242,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3479217482,"text":"Please come again.","nextNodeIds":[]},{"nodeId":705040228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3062904034,"text":"I think I know who he's talking about...","nextNodeIds":[705040229]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,50],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1004"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7050401,7050402],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"Rosaria","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170504],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3014407534,"CHECNJEMEFE":{"1004":[1220],"1020":[1120]},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[70505],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70504/Q7050401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"",