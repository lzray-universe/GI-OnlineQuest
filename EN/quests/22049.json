O":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3035"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2204901],"talks":[{"talkId":2204901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2204901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2204901,"initDialog":220490101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3035],"performCfg":"","priority":5,"questId":22049,"showRandomTalkCount":0},"dialogs":[{"nodeId":220490101,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":1285394258,"text":"Oh, if it isn't my little girl's new pal? You here to hang out with her again?","nextNodeIds":[220490102,220490105]},{"nodeId":220490102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3416177634,"text":"How's business doing today?","nextNodeIds":[220490103]},{"nodeId":220490103,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":977399786,"text":"Good, very good! Hahaha, my little girl's a real good tinkerer, she is, eh?","nextNodeIds":[220490104]},{"nodeId":220490104,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":3821366626,"text":"Did you come looking for her today?","nextNodeIds":[220490107]},{"nodeId":220490107,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":4264349586,"text":"Well, that's unfortunate! She said she was going to gather materials to make new fireworks, so she's out at the moment!","nextNodeIds":[220490108]},{"nodeId":220490108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3685827946,"text":"Huh. Then where is she?","nextNodeIds":[220490109]},{"nodeId":220490109,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":373256642,"text":"What? Err, what did you say?","nextNodeIds":[220490110]},{"nodeId":220490110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1590087898,"text":"Yoimiya! Where's she gone?","nextNodeIds":[220490111]},{"nodeId":220490111,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":963021994,"text":"Oh, uh... I'm actually not that sure. She might have mentioned it, but you know, I don't think I heard it that clearly with these ears of mine...","nextNodeIds":[220490112]},{"nodeId":220490112,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":1791222538,"text":"Do you have something you need from her? Would you like to buy some fireworks?","nextNodeIds":[220490113,220490116]},{"nodeId":220490113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3403536762,"text":"We were looking to hang out with Yoimiya...","nextNodeIds":[220490114]},{"nodeId":220490114,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":873629762,"text":"Ah. Well in that case, I don't think you're going to have any luck. You can never know when she'll be back when she goes out to tinker with her fireworks.","nextNodeIds":[220490115]},{"nodeId":220490115,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":3195842890,"text":"How about this, then? She did make and then leave some new fireworks here in the store before she went out. Why don't you take them and go out to play?","nextNodeIds":[220490118]},{"nodeId":220490118,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":2842293842,"text":"Uh, where did I leave them... Around here, maybe?","nextNodeIds":[220490119,220490120]},{"nodeId":220490119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3570318226,"text":"Uh, is this really okay?","nextNodeIds":[220490121]},{"nodeId":220490121,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":2770781202,"text":"Oh it's fine, don't worry. We've got tons of stock here in the store. Just take it and go have fun. Don't worry about it!","nextNodeIds":[220490122]},{"nodeId":220490122,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":1598780250,"text":"Besides, my little girl was looking for people to give these things a test run anyway. Since you're here, it might as well be you, eh?","nextNodeIds":[220490123]},{"nodeId":220490123,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":357618922,"text":"Just take them out for a spin, and tell me how things went once you're done!","nextNodeIds":[220490124]},{"nodeId":220490124,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":3078611426,"text":"And once Yoimiya gets back, I'll pass your message on to her.","nextNodeIds":[220490125]},{"nodeId":220490125,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":2634418498,"text":"Don't worry about it. I'm sure she'll be more than happy to know that it was you who took them out for a whirl!","nextNodeIds":[220490126]},{"nodeId":220490126,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":794021594,"text":"Off you go, then. Make sure you set these off outside the city, though. If you light them up inside, you're going to attract a whole bunch of people...","nextNodeIds":[]},{"nodeId":220490120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3774699210,"text":"But we didn't ask Yoimiya...","nextNodeIds":[220490121]},{"nodeId":220490116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":658604634,"text":"We'd like to have fun with some fireworks...","nextNodeIds":[220490117]},{"nodeId":220490117,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":3229007730,"text":"Haha, I see, I see. That's good, then. Yoimiya did make and then leave some new fireworks here in the store before she went out. Why don't you take them and go out to play?","nextNodeIds":[220490118]},{"nodeId":220490105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":673536314,"text":"Is Yoimiya in?","nextNodeIds":[220490106]},{"nodeId":220490106,"roleType":"TALK_ROLE_NPC","speakerId":3035,"speakerName":"Naganohara Ryuunosuke","textMapHash":943826754,"text":"Ah, you're here looking for her, eh?","nextNodeIds":[220490107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2204901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3035"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2204902,"order":2,"stepDescription":"Test the fireworks outside the city","stepDescTextMapHash":3446131100,"finishConds":[{"BFGALAINLMD":3,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"133220683"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22049Target","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2204902],"talks":[{"talkId":2204902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"t