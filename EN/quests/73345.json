GUIDE_NONE"},"isHidden":false,"talkIds":[7334501],"talks":[{"talkId":7334501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7334501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7334501,"initDialog":733450101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20927],"performCfg":"QuestDialogue/WQ/Sumeru_73345/Q7334501","priority":5,"questId":73345,"showRandomTalkCount":0},"dialogs":[{"nodeId":733450101,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":4161038234,"text":"Well, why are you back? Did you get the door slammed on you by our great Vijnanapati? I'll have you know that he doesn't compromise so easily with the Pari.","nextNodeIds":[733450102]},{"nodeId":733450102,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":2568911042,"text":"You should just leave. And don't even think of getting anything more from me!","nextNodeIds":[733450103]},{"nodeId":733450103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2098125394,"text":"Pfft! You spilled the beans without our help every time, though!","nextNodeIds":[733450104,733450105]},{"nodeId":733450104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1736684322,"text":"So, about your Vijnanapati...","nextNodeIds":[733450106]},{"nodeId":733450106,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2742630586,"text":"You tell Pyrrho of the Great Songs and Nasejuna's betrayal.","nextNodeIds":[733450107]},{"nodeId":733450107,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":2838171418,"text":"Nonsense. Utter nonsense! Our Vijnanapati is the most scholarly man I know. He would not band together with those defiled beings!","nextNodeIds":[733450108]},{"nodeId":733450108,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":915520946,"text":"I'll bet you're just trying to mask your failure by sowing dissent.","nextNodeIds":[733450109]},{"nodeId":733450109,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":3426415770,"text":"Nice try, but your story's way out there. No way I'd fall for that!","nextNodeIds":[733450110]},{"nodeId":733450110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1079012026,"text":"Ugh... C'mon, we gotta think. Don't we have those notes that Nasejuna gave us?","nextNodeIds":[733450111]},{"nodeId":733450111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":664832578,"text":"It should still have Nasejuna's notes. Pyrrho should believe us if we give those to him!","nextNodeIds":[733450112]},{"nodeId":733450112,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":2198491362,"text":"What notes are these? You really love those tricks of yours, don't you?","nextNodeIds":[733450113]},{"nodeId":733450113,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1566641618,"text":"You give Rene's Investigation Notes to Pyrrho.","nextNodeIds":[733450114]},{"nodeId":733450114,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":1914100370,"text":"This... This is indeed the great Vijnanapati's handwriting...","nextNodeIds":[733450115]},{"nodeId":733450115,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":2330063610,"text":"It truly was a once-in-a-lifetime thing that we gained such a knowledgeable leader, and yet he turned his back on our duties and threw his lot with the followers of the dark hollow...","nextNodeIds":[733450116]},{"nodeId":733450116,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":923269874,"text":"*sigh* You may not know this, but we have struggled against the followers of the dark hollow for hundreds of years.","nextNodeIds":[733450117]},{"nodeId":733450117,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":2446193698,"text":"You could say that they are akin to our shadow, always attempting to taint our heritage. I have no doubt that the fall of our order to its present state cannot be separated from their plots.","nextNodeIds":[733450118]},{"nodeId":733450118,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":3582421578,"text":"But I never thought that this time, even our leader would be... Ah, a plague upon our house, this is!","nextNodeIds":[733450119]},{"nodeId":733450119,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":3108262930,"text":"No doubt Nasejuna has gone with those impure villains and now skulks with them in the shadows.","nextNodeIds":[733450120]},{"nodeId":733450120,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":73454778,"text":"In the past, he followed Elder Aryadeva to the Akademiya, and upon returning, he was absorbed with those ancient documents.","nextNodeIds":[733450121]},{"nodeId":733450121,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":837927490,"text":"We were people who emphasized praxis, and we found ourselves without a scholar like him for many years. I had thought that he would lead us to reform, but...","nextNodeIds":[733450122,733450123]},{"nodeId":733450122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1830384562,"text":"Honestly, we didn't see that one coming either.","nextNodeIds":[733450124]},{"nodeId":733450124,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":350424906,"text":"But since this is how things have played out, I must handle that which remains to be done.","nextNodeIds":[733450125]},{"nodeId":733450125,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":1736512394,"text":"Our first priority is to appoint a new Vijnanapati. Things would go ill if someone takes advantage of this vacuum.","nextNodeIds":[733450126]},{"nodeId":733450126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1675516586,"text":"Well, Paimon's really not sure if you have much of a vacuum worth sneaking into now...","nextNodeIds":[733450127]},{"nodeId":733450127,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":3272919202,"text":"Indeed, and I am ashamed of it. As penance, allow me to give you these documents that Nasejuna left in my keeping. They record the various traditions of our Order.","nextNodeIds":[733450128]},{"nodeId":733450128,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":1158696498,"text":"Although I have not been able to understand it, I believe it might be of interest to you, so please, take it.","nextNodeIds":[733450129]},{"nodeId":733450129,"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","textMapHash":4153966098,"text":"And if you should have any trouble in the future, just seek me out, and I will lend you my aid.","nextNodeIds":[]},{"nodeId":733450123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":325265010,"text":"This wasn't your fault.","nextNodeIds":[733450124]},{"nodeId":733450105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3040690874,"text":"Well, you say he's different, but...","nextNodeIds":[733450106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7334501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7334501","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7334501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20927,"speakerName":"Pyrrho","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROL