NE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7266001],"talks":[{"talkId":7266001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7266001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7266001,"initDialog":726600101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30065],"performCfg":"","priority":5,"questId":72660,"showRandomTalkCount":0},"dialogs":[{"nodeId":726600101,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":230695034,"text":"Why hello there, outlander! Do you have any interest in a little scrap, by any chance?","nextNodeIds":[726600102,726600104]},{"nodeId":726600102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2615518506,"text":"I've been in thousands of those.","nextNodeIds":[726600103]},{"nodeId":726600103,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":753142914,"text":"Ah, wonderful! Glad I had my eye on the right person.","nextNodeIds":[726600106]},{"nodeId":726600106,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":4207094626,"text":"It's like this: recently, some people have organized a Hyakunin Ikki in secret again.","nextNodeIds":[726600107,726600109]},{"nodeId":726600107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3394613562,"text":"Don't you mean the Hyakunin Isshu?","nextNodeIds":[726600108]},{"nodeId":726600108,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1895045002,"text":"No, no, I said \"Hyakunin Ikki.\" What on earth's the \"Hyakunin Isshu,\" anyway...","nextNodeIds":[726600110]},{"nodeId":726600110,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":2223427146,"text":"This practice used to circulate amongst the Tengu-Kin, who imitated the tengu. Basically, they would do this—","nextNodeIds":[726600111]},{"nodeId":726600111,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":2697805570,"text":"When the situation went ill, when they felt down, when something worth celebrating occurred, or if they were simply bored...","nextNodeIds":[726600112]},{"nodeId":726600112,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1411837914,"text":"They would engage in a hearty fight to celebrate, or simply to eliminate bad luck.","nextNodeIds":[726600113]},{"nodeId":726600113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":832099434,"text":"Sounds like you could just hold it at any time...","nextNodeIds":[726600114]},{"nodeId":726600114,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":493416562,"text":"...Now that you mention it, that is true, yes.","nextNodeIds":[726600115]},{"nodeId":726600115,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":2325300978,"text":"Whatever the case, let's find another place to discuss this matter. There are too many people in the city for such talk...","nextNodeIds":[]},{"nodeId":726600109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2583819834,"text":"I'm all ears.","nextNodeIds":[726600110]},{"nodeId":726600104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1223982154,"text":"Do you have a commission for me?","nextNodeIds":[726600105]},{"nodeId":726600105,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":3547445866,"text":"Now, I wouldn't call this a commission...","nextNodeIds":[726600106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7266002,"order":2,"stepDescription":"Talk to Kayabuki","stepDescTextMapHash":1246706484,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7266002],"talks":[{"talkId":7266002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7266002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7266002,"initDialog":726600201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30065],"performCfg":"","priority":5,"questId":72660,"showRandomTalkCount":0},"dialogs":[{"nodeId":726600201,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1890120778,"text":"Here we are.","nextNodeIds":[726600202]},{"nodeId":726600202,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":74193226,"text":"You can enter the Hyakunin Ikki Dojo by stepping through this... rather suspicious door.","nextNodeIds":[726600203,726600204]},{"nodeId":726600203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":354064122,"text":"Oh, that's pretty exciting.","nextNodeIds":[726600205]},{"nodeId":726600205,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1338879450,"text":"Though the Tengu-Kin have long been banned for flouting public order and morals, some still hold the Hyakunin Ikki free-for-all tournament from time to time.","nextNodeIds":[726600206]},{"nodeId":726600206,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":2385905842,"text":"Monsters, adventurers, and warriors who long for battle will be attracted here to engage in passionate battle on this stage.","nextNodeIds":[726600207]},{"nodeId":726600207,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1539389906,"text":"Feel free to bring your friends and companions! After all, the \"Hyakunin\" in \"Hyakunin Ikki\" means the more, the merrier!","nextNodeIds":[726600208]},{"nodeId":726600208,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":2022974930,"text":"You seem like a well-traveled adventurer. You shouldn't lack for any companions to take part together with you.","nextNodeIds":[726600209]},{"nodeId":726600209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1178070170,"text":"You're not taking part?","nextNodeIds":[726600210]},{"nodeId":726600210,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":1289988714,"text":"Oh, of course I will — as a spectator, cheering you on!","nextNodeIds":[726600211]},{"nodeId":726600211,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":2413678698,"text":"In truth, my goal here is to write the most epic fighting novel ever and use it to take first prize in Yae Publishing House's \"This Novel Is Amazing!\" contest...","nextNodeIds":[726600212]},{"nodeId":726600212,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":555424082,"text":"...And my gut tells me that your star will shine brightest in this arena.","nextNodeIds":[726600213,726600214]},{"nodeId":726600213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3387275634,"text":"I'll do my best.","nextNodeIds":[726600215]},{"nodeId":726600215,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":2207896778,"text":"Great! In fact, I already have a name for my novel. I'm calling it \"Hyakunin Ikki: Greatest Battle Chapter.\" If you should see it in Yae Publishing House's store one day, look out for the bit where the blond-haired outlander makes their debut!","nextNodeIds":[726600216]},{"nodeId":726600216,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"Kayabuki Ikkei","textMapHash":3734781530,"text":"I'm looking forward to your performance.","nextNodeIds":[]},{"nodeId":726600214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1581110450,"text":"Of course.","nextNodeIds":[726600215]},{"nodeId":726600204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2369478434,"text":"Oh, that's suspicious alright.","nextNodeIds":[726600205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7266003,"order":3,"stepDescription":"","stepDescTextMapHash":1949536268,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAP