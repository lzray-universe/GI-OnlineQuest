LHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7406501],"talks":[{"talkId":7406501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406501,"initDialog":740650101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21095,21107],"performCfg":"QuestDialogue/Q7406501","priority":5,"questId":74065,"showRandomTalkCount":0},"dialogs":[{"nodeId":740650101,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":42677906,"text":"#Well, well! If it isn't {NICKNAME} and Paimon!","nextNodeIds":[740650102,740650103]},{"nodeId":740650102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2987686698,"text":"Do we know you?","nextNodeIds":[740650104]},{"nodeId":740650104,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":182858698,"text":"Don't be so cold. I'll never forget what you did for me that other time.","nextNodeIds":[740650105]},{"nodeId":740650105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3585258786,"text":"That other time... Ah! We still have so much to ask you!","nextNodeIds":[740650106]},{"nodeId":740650106,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":345369786,"text":"I—Is that so? Ugh, oh, what's this? My memory, it's acting up again! What happened then, I wonder? I can't remember a thing!","nextNodeIds":[740650107]},{"nodeId":740650107,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":1273099106,"text":"The wise say it's better to look toward the future than look back into the past. So let's talk about our future collaboration, and let bygones be bygones, shall we?","nextNodeIds":[740650108]},{"nodeId":740650108,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":1687659290,"text":"I have a few jobs on hand that pay quite well, but I don't have anyone to help out. If you're free, would you like to have a go?","nextNodeIds":[740650109]},{"nodeId":740650109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2181104594,"text":"Hmph! Don't you go thinking we're that easy to dupe...","nextNodeIds":[740650110]},{"nodeId":740650110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":432751554,"text":"And just how good is the compensation?","nextNodeIds":[740650111]},{"nodeId":740650111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4226266338,"text":"Hey!","nextNodeIds":[740650112]},{"nodeId":740650112,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":1020173042,"text":"This is why I'm so fond of talking business with people like you. What do they call it again? Right, being quick to catch on!","nextNodeIds":[740650113]},{"nodeId":740650113,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":742396778,"text":"How about I state a number that's guaranteed to satisfy you?","nextNodeIds":[740650114]},{"nodeId":740650114,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":2532085802,"text":"A hundred Coupons! What do you think?","nextNodeIds":[740650115]},{"nodeId":740650115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2343228738,"text":"A hundred!?","nextNodeIds":[740650116]},{"nodeId":740650116,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":646097922,"text":"Mmm, I see you are moved by my generosity.","nextNodeIds":[740650117,740650119]},{"nodeId":740650117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":165265354,"text":"That won't even buy us a bottle cork.","nextNodeIds":[740650118]},{"nodeId":740650118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3794289154,"text":"Yeah! Paimon can't believe you had the gall to make that offer!","nextNodeIds":[740650121]},{"nodeId":740650121,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":2382114194,"text":"Am I not being generous enough? You young 'uns really are so... You just don't know what's good for you!","nextNodeIds":[740650122]},{"nodeId":740650122,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":3204399298,"text":"You should know, there're hordes of poor wretches who'd give an arm to do easy and profitable work like this...","nextNodeIds":[740650123]},{"nodeId":740650123,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":643235562,"text":"Decembre, you slippery little fraud, I've finally caught you! Last time I caught you hanging around the mail room, you were also swindling newcomers into commissions for you for a fraction of the actual fee...","nextNodeIds":[740650124]},{"nodeId":740650124,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":1328726090,"text":"#{NICKNAME} and Paimon? You didn't fall for his lies, did you?","nextNodeIds":[740650125,740650127]},{"nodeId":740650125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1601285522,"text":"I'm devastated... We've already been tricked once!","nextNodeIds":[740650126]},{"nodeId":740650126,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":3375241122,"text":"*sigh* Then I'm too late.","nextNodeIds":[740650130]},{"nodeId":740650130,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":2863014130,"text":"Anyways, don't believe a word he says. He targets newcomers or anyone unaware of the rules and cheats them. There's already a long list of victims.","nextNodeIds":[740650131]},{"nodeId":740650131,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":1048991282,"text":"My word, \"swindle\"!? You make it sound so awful. Is there any difference between us? Don't you guards use Coupons to make people do miscellaneous work for you, too?","nextNodeIds":[740650132]},{"nodeId":740650132,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":3407675490,"text":"We don't pocket a portion of their compensation.","nextNodeIds":[740650133]},{"nodeId":740650133,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"Decembre","textMapHash":1805730970,"text":"What are you hinting at? Don't slander me without any proof!","nextNodeIds":[740650134]},{"nodeId":740650134,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":3495056010,"text":"Oh, you want to see some proof? Let's go then. Solitary is quiet and spacious — a perfect place for you to peruse all the proof. Seriously, I still have trouble to deal with at the Geode Mine Shaft after this...","nextNodeIds":[740650135]},{"nodeId":740650135,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":1637956826,"text":"#Oh, {NICKNAME} and Paimon. If possible, could you help me...","nextNodeIds":[740650136]},{"nodeId":740650136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":643545986,"text":"Hey, it's not like we have all the time in the world, either!","nextNodeIds":[740650137]},{"nodeId":740650137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1772912642,"text":"I'm sure you pay handsomely — I'll do it.","nextNodeIds":[740650138]},{"nodeId":740650138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4060094226,"text":"Hey!","nextNodeIds":[740650139]},{"nodeId":740650139,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":3503572642,"text":"Haha! Payment will be provided in accordance with regulations, of course. I'm sure you know the standards, and you know I won't try to defraud you.","nextNodeIds":[740650140]},{"nodeId":740650140,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":1376553338,"text":"Anyway, some Fontemer Aberrants have been spotted in the Geode Mine Shaft... They may pose a threat if left unchecked, so they must be dealt with as soon as possible.","nextNodeIds":[740650141]},{"nodeId":740650141,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":2281208858,"text":"I'll take this guy to solitary first. Handing him over to my colleagues will take some time... I'll meet up with you as soon as I'm done.","nextNodeIds":[740650142]},{"nodeId":740650142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1341060810,"text":"Alright, but don't take too long.","nextNodeIds":[740650143]},{"nodeId":740650143,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":3019589338,"text":"I'll do my best. But the paperwork... It's not something I can speed up. I'll leave the business at the mine shaft to you then.","nextNodeIds":[]},{"nodeId":740650127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2052264154,"text":"But not this time.","nextNodeIds":[740650128]},{"nodeId":740650128,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":214345082,"text":"This time?","nextNodeIds":[740650129]},{"nodeId":740650129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3990519794,"text":"Uh... Things happened before this...","nextNodeIds":[740650130]},{"nodeId":740650119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2606325962,"text":"I'll pay you 100, you work, and I'll profit.","nextNodeIds":[740650120]},{"nodeId":740650120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4106394786,"text":"Whoa! Is that what you were planning!?","nextNodeIds":[740650121]},{"nodeId":740650103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4146834418,"text":"I have a bad feeling about this...","nextNodeIds":[740650104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKA