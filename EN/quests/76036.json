3],"performCfg":"QuestDialogue/WQ/NodKrai_76036/Q7603601","priority":5,"questId":76036,"showRandomTalkCount":0},"dialogs":[{"nodeId":760360101,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1319830322,"text":"Not this blue, then?","nextNodeIds":[760360102]},{"nodeId":760360102,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":333160698,"text":"...","nextNodeIds":[760360103,760360104]},{"nodeId":760360103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1766543090,"text":"Columbina?","nextNodeIds":[760360105]},{"nodeId":760360105,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":154822098,"text":"Oh? It's you.","nextNodeIds":[760360106]},{"nodeId":760360106,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3343976146,"text":"Could you help me? I'll be sure to return the favor.","nextNodeIds":[760360107]},{"nodeId":760360107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1091499074,"text":"Are you kidding? You know you don't owe us anything, right...","nextNodeIds":[760360108,760360109]},{"nodeId":760360108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2690700010,"text":"You've helped us a lot in the past...","nextNodeIds":[760360110]},{"nodeId":760360110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3982223594,"text":"Yeah. We'd help you even if you had nothing to give us.","nextNodeIds":[760360111]},{"nodeId":760360111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4028121890,"text":"So, what sorta help do you need?","nextNodeIds":[760360112]},{"nodeId":760360112,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4058272202,"text":"Well... To be precise, this creature is the one that needs help.","nextNodeIds":[760360113]},{"nodeId":760360113,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":3940654378,"text":"...","nextNodeIds":[760360114]},{"nodeId":760360114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1724706690,"text":"The kuuhenki?","nextNodeIds":[760360115]},{"nodeId":760360115,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4264087162,"text":"Yes. This little one procured a paint brush somewhere, and upon returning to my side, proceeded to swish about happily.","nextNodeIds":[760360116]},{"nodeId":760360116,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":34413194,"text":"I found a canvas and some paint for her, but though some time has passed, her attempts to mix the colors she desires have met with little success.","nextNodeIds":[760360117]},{"nodeId":760360117,"roleType":"TALK_ROLE_NPC","speakerId":15380,"speakerName":"Luonnotar","textMapHash":2277022314,"text":"...!","nextNodeIds":[760360118]},{"nodeId":760360118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":875466802,"text":"Whoa, where did you come from?","nextNodeIds":[760360119]},{"nodeId":760360119,"roleType":"TALK_ROLE_NPC","speakerId":15380,"speakerName":"Luonnotar","textMapHash":2293752034,"text":"!!!","nextNodeIds":[760360120]},{"nodeId":760360120,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":381602322,"text":"??","nextNodeIds":[760360121]},{"nodeId":760360121,"roleType":"TALK_ROLE_NPC","speakerId":15380,"speakerName":"Luonnotar","textMapHash":2395506962,"text":"...!","nextNodeIds":[760360122]},{"nodeId":760360122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2299774818,"text":"Uh... Are we playing charades? Sorry. We didn't catch any of that..","nextNodeIds":[760360123]},{"nodeId":760360123,"roleType":"TALK_ROLE_NPC","speakerId":15380,"speakerName":"Luonnotar","textMapHash":706904546,"text":"...","nextNodeIds":[760360124]},{"nodeId":760360124,"roleType":"TALK_ROLE_NPC","speakerId":15380,"speakerName":"Luonnotar","textMapHash":11624586,"text":"!!!","nextNodeIds":[760360125]},{"nodeId":760360125,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":588832498,"text":"!!!","nextNodeIds":[760360126]},{"nodeId":760360126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2148916202,"text":"Huh, looks like she's taken an interest in your pack.","nextNodeIds":[760360127]},{"nodeId":760360127,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":52577066,"text":"Perhaps you carry suitable colors on your person?","nextNodeIds":[760360128]},{"nodeId":760360128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1234157210,"text":"Uh, we don't usually carry around stuff like that... Speaking of which, where did you find the paint? No offense, but you, uh, don't look like the painting sort.","nextNodeIds":[760360129]},{"nodeId":760360129,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2344019426,"text":"This little one was quite impatient, so I made some paint using the colorful flowers nearby.","nextNodeIds":[760360130]},{"nodeId":760360130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2152287114,"text":"Huh, could Luonnotar be looking for other colorful things to make paint with, then?","nextNodeIds":[760360131]},{"nodeId":760360131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1783033842,"text":"C'mon, let's see what we've got in our packs.","nextNodeIds":[]},{"nodeId":760360109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3482677506,"text":"It's us who should be \"returning the favor\"...","nextNodeIds":[760360110]},{"nodeId":760360104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":960467330,"text":"What happened?","nextNodeIds":[760360105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7603602,"order":2,"stepDescription":"Give the kuuhenki some objects with vivid colors","stepDescTextMapHash":3934283436,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603602,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7603602],"talks":[{"talkId":7603602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestro