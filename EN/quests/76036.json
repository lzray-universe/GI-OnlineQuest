edRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7603603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7603603,"initDialog":760360301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318,15603],"performCfg":"QuestDialogue/WQ/NodKrai_76036/Q7603603","priority":5,"questId":76036,"showRandomTalkCount":0},"dialogs":[{"nodeId":760360301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":56315442,"text":"Will these do?","nextNodeIds":[760360302]},{"nodeId":760360302,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":441960530,"text":"Yes. The kuuhenki looks quite satisfied.","nextNodeIds":[760360303]},{"nodeId":760360303,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":3472072394,"text":"!","nextNodeIds":[760360304]},{"nodeId":760360304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2094432930,"text":"Man, Paimon never knew kuuhenki could do art.","nextNodeIds":[760360305]},{"nodeId":760360305,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":566105050,"text":"Kuuhenki are much like us, in truth. Each one has its own personality and hobbies.","nextNodeIds":[760360306]},{"nodeId":760360306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3067626314,"text":"Wait, does that mean you can tell all the kuuhenki in Nod-Krai apart from each other?","nextNodeIds":[760360307]},{"nodeId":760360307,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1879742906,"text":"The ones I've met, yes.","nextNodeIds":[760360308]},{"nodeId":760360308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3831729762,"text":"That's impressive! Especially because, other than Luonnotar, all the other kuuhenki kinda look the same...","nextNodeIds":[760360309]},{"nodeId":760360309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1133400426,"text":"So, what is this little painter's name?","nextNodeIds":[760360310]},{"nodeId":760360310,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1289264298,"text":"Name...?","nextNodeIds":[760360311]},{"nodeId":760360311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2359157714,"text":"Wait... They do have names, don't they?","nextNodeIds":[760360312]},{"nodeId":760360312,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2209987714,"text":"We recognize each other, and that's enough. We don't need names... I don't have one either.","nextNodeIds":[760360313]},{"nodeId":760360313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":742378922,"text":"That doesn't mean mean you have to continue the cycle!","nextNodeIds":[760360314]},{"nodeId":760360314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":133291978,"text":"Hmm... Let's think... \"Luonnotar\" means \"a creature born beneath the Moon Goddess's blessing\"...","nextNodeIds":[760360315]},{"nodeId":760360315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2216395762,"text":"So... What would \"painting\" be in the language of the Frostmoon Scions?","nextNodeIds":[760360316]},{"nodeId":760360316,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3955818290,"text":"I think it would be... Maa... naus? Maalaus? Yes. Maalaus.","nextNodeIds":[760360317]},{"nodeId":760360317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2879607722,"text":"Ooh, sounds nice! Let's go with that!","nextNodeIds":[760360318]},{"nodeId":760360318,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":1712537082,"text":"??","nextNodeIds":[760360319]},{"nodeId":760360319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3132969978,"text":"What is it, Maalaus? Done with your painting?","nextNodeIds":[760360320]},{"nodeId":760360320,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":637181362,"text":"!!!","nextNodeIds":[760360321]},{"nodeId":760360321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2366838306,"text":"Ooh! Let's see, let's see... Whoa. What in the...!","nextNodeIds":[760360322]},{"nodeId":760360322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1905084090,"text":"What's the matter?","nextNodeIds":[760360323]},{"nodeId":760360323,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4272982090,"text":"This is amazing!","nextNodeIds":[760360324]},{"nodeId":760360324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2149983370,"text":"Paimon was expecting something a lot more childish... or, y'know, Melusine-like...","nextNodeIds":[760360325]},{"nodeId":760360325,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3557151082,"text":"The kuuhenki are adept at sensing their surroundings. When it comes to recreating what they've seen, they tend to capture things exactly as they were.","nextNodeIds":[760360326]},{"nodeId":760360326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3020744090,"text":"So, is this a drawing of Columbina, Maalaus?","nextNodeIds":[760360327]},{"nodeId":760360327,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":2943995570,"text":"!!!","nextNodeIds":[760360328]},{"nodeId":760360328,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1019383106,"text":"Hm...?","nextNodeIds":[760360329]},{"nodeId":760360329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2680843170,"text":"...It looks like Columbina when she was first born.","nextNodeIds":[760360330]},{"nodeId":760360330,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":582525250,"text":"Huh?","nextNodeIds":[760360331]},{"nodeId":760360331,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3189881826,"text":"Lauma said your birth was recorded by the Frostmoon Scions... But, this painting does look a bit different.","nextNodeIds":[760360332,760360333]},{"nodeId":760360332,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3745626698,"text":"And kuuhenki...","nextNodeIds":[760360334]},{"nodeId":760360334,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2287605914,"text":"This little one, Maalaus, was one of the first kuuhenki born. It's possible this is Maalaus' interpretation of how things looked back then.","nextNodeIds":[760360335]},{"nodeId":760360335,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4062522090,"text":"Seems like you're trying to help us get to know your goddess, huh, Maalaus?","nextNodeIds":[760360336]},{"nodeId":760360336,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":3411136154,"text":"!","nextNodeIds":[760360337]},{"nodeId":760360337,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":552760338,"text":"...","nextNodeIds":[760360338]},{"nodeId":760360338,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":352842946,"text":"Don't worry, Maalaus. We appreciate it! We're all friends here!","nextNodeIds":[760360339]},{"nodeId":760360339,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":86744290,"text":"!!!","nextNodeIds":[760360340]},{"nodeId":760360340,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":796951274,"text":"Wow, that was quick. You've finished another painting already?","nextNodeIds":[760360341]},{"nodeId":760360341,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2783954546,"text":"...?","nextNodeIds":[760360342]},{"nodeId":760360342,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2182162794,"text":"This... must depict the Frostmoon Scions worshipping Columbina as their goddess.","nextNodeIds":[760360343]},{"nodeId":760360343,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2505849274,"text":"Hmm? What's she doing by the altar? The details are too small to make out.","nextNodeIds":[760360344]},{"nodeId":760360344,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":3542049410,"text":"!","nextNodeIds":[760360345]},{"nodeId":760360345,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3226862546,"text":"Oh, so she was eating the offerings!","nextNodeIds":[760360346]},{"nodeId":760360346,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1561167914,"text":"...Was I not supposed to?","nextNodeIds":[760360347]},{"nodeId":760360347,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2575569698,"text":"Oh, no no no. It's just a bit, um... unconventional?","nextNodeIds":[760360348]},{"nodeId":760360348,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4105789970,"text":"Looks like you were having a good time...","nextNodeIds":[760360349]},{"nodeId":760360349,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1946938882,"text":"Well... They were delicious...","nextNodeIds":[760360350]},{"nodeId":760360350,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":430417362,"text":"Fair point.","nextNodeIds":[760360351]},{"nodeId":760360351,"roleType":"TALK_ROLE_NPC","speakerId":15603,"speakerName":"Maalaus","textMapHash":4217254034,"text":"!","nextNodeIds":[760360352]},{"nodeId":760360352,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2479365530,"text":"Yes, I understand.","nextNodeIds":[760360353]},{"nodeId":760360353,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":507309034,"text":"Give me your hand.","nextNodeIds":[760360354,760360355]},{"nodeId":760360354,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":468489346,"text":"Seriously, you don't have to give us anything...","nextNodeIds":[760360356]},{"nodeId":760360356,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1621029386,"text":"It's not like that. This is proof that we're \"friends.\"","nextNodeIds":[]},{"nodeId":760360355,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3855836490,"text":"This is not for eating, you know...","nextNodeIds":[760360356]},{"nodeId":760360333,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2347025650,"text":"Shouldn't have existed before the Moon Goddess' birth...","nextNodeIds":[760360334]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603603,0],