":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351601,"initDialog":735160101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342,30343],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351601","priority":5,"questId":73516,"showRandomTalkCount":0},"dialogs":[{"nodeId":735160101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2908261098,"text":"Did you see that, Shriya? Our Wenutslayer Cannon is a game changer!","nextNodeIds":[735160102]},{"nodeId":735160102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2527071170,"text":"I wish all the supervisors who listened to our thesis defense could come and see this. This would cure them of their antiquated views!","nextNodeIds":[735160103]},{"nodeId":735160103,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":345788954,"text":"So it really did go off without a hitch... I thought it was going to end up like Experimental Device No. 3...","nextNodeIds":[735160104]},{"nodeId":735160104,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":703598706,"text":"Ahem... Only from our failures do we learn to succeed. I'm no longer who I used to be.","nextNodeIds":[735160105]},{"nodeId":735160105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3918860602,"text":"How many accidents happened that year...? Well, anyway, this experiment was a success, and that's all that matters!","nextNodeIds":[735160106]},{"nodeId":735160106,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3441380274,"text":"Yeah, while the ball is rolling, maybe we should try it somewhere else!","nextNodeIds":[735160107]},{"nodeId":735160107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3005225362,"text":"Eyewitness reports say that there are Wenut in this area numbering in the double-digits at the very least!","nextNodeIds":[735160108]},{"nodeId":735160108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1591907474,"text":"Whoa... double digits!? You're not gonna pick them off one by one, are you? That would take a really long time!","nextNodeIds":[735160109]},{"nodeId":735160109,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3193683938,"text":"Huh? What's the matter? If it's the maintenance of the Wenutslayer Cannon you're concerned about, you don't have to worry...","nextNodeIds":[735160110]},{"nodeId":735160110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1785809714,"text":"Wait, wait, wait! It would take a long time to repeat this process over and over again. Even if the machine doesn't break down, we will!","nextNodeIds":[735160111]},{"nodeId":735160111,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3073794386,"text":"Vinayak, not everyone can be jolted back to life after just smelling machine oil.","nextNodeIds":[735160112]},{"nodeId":735160112,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3840943434,"text":"Really? Looks like wetware performance will have to be considered next time...","nextNodeIds":[735160113]},{"nodeId":735160113,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2493736082,"text":"Anyway, let's call it a day. With data from this full run and samples collected after the battle, I am one step closer to solving this puzzle.","nextNodeIds":[735160114]},{"nodeId":735160114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":597165746,"text":"What puzzle?","nextNodeIds":[735160115]},{"nodeId":735160115,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":797116826,"text":"Why the Wenut are behaving violently, abnormal environmental parameters... If we can figure that out, we might be able to get to the bottom of this mess.","nextNodeIds":[735160116]},{"nodeId":735160116,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1537240738,"text":"Please give me one more day to do some research. By this time tomorrow, we should have the results.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"",