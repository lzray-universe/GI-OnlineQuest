"","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7211902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7211901,"initDialog":721190101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3162],"performCfg":"","priority":5,"questId":72119,"showRandomTalkCount":0},"dialogs":[{"nodeId":721190101,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2371590922,"text":"Oh! Uh, Traveler... Things do not look good.","nextNodeIds":[721190102]},{"nodeId":721190102,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1512130802,"text":"The Fatui within have concentrated their forces near the core. It seems that they have discovered something.","nextNodeIds":[721190103]},{"nodeId":721190103,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1781269362,"text":"Surely they don't intend to breach the core's defenses... No, we can no longer afford to delay. We must move now to initiate functionality tests.","nextNodeIds":[721190104]},{"nodeId":721190104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":206855354,"text":"Functionality tests?","nextNodeIds":[721190105]},{"nodeId":721190105,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":4251200202,"text":"By that, I mean that we must test our machine friend's purification abilities. I have no intention of moving it into the furnace only to find that it will not function.","nextNodeIds":[721190106]},{"nodeId":721190106,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3134698786,"text":"To that end, please help me find 3 Onikabuto, if you will.","nextNodeIds":[721190107]},{"nodeId":721190107,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2738091906,"text":"I want to place them near the Mikage Furnace, which will cause them to be tainted by Tatarigami.","nextNodeIds":[721190108]},{"nodeId":721190108,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1856601842,"text":"Then, we will retrieve them, and use this purification device to cleanse them.","nextNodeIds":[721190109]},{"nodeId":721190109,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":325639410,"text":"This is the test I have devised.","nextNodeIds":[721190110]},{"nodeId":721190110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1386039418,"text":"Where do I find these Onikabuto?","nextNodeIds":[721190111]},{"nodeId":721190111,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3760608754,"text":"Hmm... normally, they are found in Electro-rich environments...","nextNodeIds":[721190112]},{"nodeId":721190112,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3667391778,"text":"I have also heard that they can survive near the Mikage Furnace. What hardy little critters they are...","nextNodeIds":[721190113]},{"nodeId":721190113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3471080706,"text":"Why don't I just snag some from in the furnace, then?","nextNodeIds":[721190114]},{"nodeId":721190114,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3244348250,"text":"Well, you could do that, but if you were to take Onikabuto directly from the Mikage Furnace for testing...","nextNodeIds":[721190115]},{"nodeId":721190115,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3968850058,"text":"To tell you the truth, I worry about the reliability of my little machine...","nextNodeIds":[721190116]},{"nodeId":721190116,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":865591442,"text":"It is best to work through tests step by step, after all.","nextNodeIds":[721190117]},{"nodeId":721190117,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2470460858,"text":"Ahem, well then... please help me find 3 Onikabuto, if you will.","nextNodeIds":[721190118,721190120]},{"nodeId":721190118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1079342194,"text":"I've got this.","nextNodeIds":[721190119]},{"nodeId":721190119,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2764800994,"text":"So you do. Just 3 is fine!","nextNodeIds":[]},{"nodeId":721190120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2352495778,"text":"I could just take a dip inside the Furnace myself...","nextNodeIds":[721190121]},{"nodeId":721190121,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1658330738,"text":"Well... you could use yourself as the test subject, yes.","nextNodeIds":[721190122]},{"nodeId":721190122,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1581631362,"text":"But like I said before, this device's reliability may not meet expectations.","nextNodeIds":[721190123]},{"nodeId":721190123,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":574160394,"text":"If something unexpected truly does happen during the purification process, you might... uh, encounter some unforeseen issues...","nextNodeIds":[721190124]},{"nodeId":721190124,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3466412634,"text":"Ahem. Let's just stick to using the Onikabuto for now, shall we?","nextNodeIds":[721190125]},{"nodeId":721190125,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3153031186,"text":"Just 3 will do! Once you've caught them, just bring them back here.","nextNodeIds":[]}]},{"talkId":7211902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7211902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7211903","1","","",""],"type":"QUEST_COND_QUEST_NOT