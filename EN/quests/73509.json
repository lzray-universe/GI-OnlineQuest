{"mainQuestId":73509,"title":"Boiling Over!","description":"You and Paimon meet a certain strange student by the Wall of Samiel to the southwest of the rainforest. She seems to have reason to remember the two of you...","titleTextMapHash":1544732607,"descTextMapHash":3491513494,"mainQuestExcel":{"mainQuestId":73509,"titleTextMapHash":1544732607,"title":"Boiling Over!","descTextMapHash":3491513494,"description":"You and Paimon meet a certain strange student by the Wall of Samiel to the southwest of the rainforest. She seems to have reason to remember the two of you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5129,"luaPath":"Actor/Quest/WQ73509","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5129,"chapterId":0,"descTextMapHash":3491513494,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73509,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2439853465,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73509","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173509],"series":5129,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1544732607,"type":"WQ","unlockDescTextMapHash":820981678}},"flow":[{"subQuestId":7350901,"order":1,"stepDescription":"Talk to the strange researcher","stepDescTextMapHash":1829344244,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7350901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7350901],"talks":[{"talkId":7350901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7350901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7350901,"initDialog":735090101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30226],"performCfg":"QuestDialogue/WQ/Sumeru_73509/Q7350901","priority":6,"questId":73509,"showRandomTalkCount":0},"dialogs":[{"nodeId":735090101,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1298940362,"text":"Hehe... Haha... Ahahahaha! It is a success!","nextNodeIds":[735090102]},{"nodeId":735090102,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":329117266,"text":"Now I just need to hire a mercenary band and conduct a pilot deployment, with a goal to achieve basic operational capacity within ten days.","nextNodeIds":[735090103]},{"nodeId":735090103,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1157440546,"text":"Once I get the frontline reports, I'll be able to convince my mentor to give me a higher budget, with which I can prove to the Akademiya that this is the alchemical potion's strongest form!","nextNodeIds":[735090104]},{"nodeId":735090104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":344968786,"text":"What's going on, why's there someone laughing herself silly in the desert's direction?","nextNodeIds":[735090105]},{"nodeId":735090105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2827741930,"text":"And what's with all the talk about mercenaries and operational capacity... This person sounds like some kinda battle maniac!","nextNodeIds":[735090106]},{"nodeId":735090106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2414229746,"text":"#What do we do, {NICKNAME}? Should we, uh, get away for a bit?","nextNodeIds":[735090107,735090124]},{"nodeId":735090107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1050580970,"text":"No, no, I'm interested. Let's see where this situation goes.","nextNodeIds":[735090108]},{"nodeId":735090108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4245114794,"text":"Eh? Oh, right. Paimon forgot that you're a combat expert yourself...","nextNodeIds":[735090109]},{"nodeId":735090109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1820397402,"text":"Speaking of which, it does tend to be that whenever you get along with someone, they'll almost certainly be willing to purchase our services.","nextNodeIds":[735090110]},{"nodeId":735090110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3589605290,"text":"As long as this person doesn't plan on doing any bad things, and the Mora is good, we can definitely consider helping out!","nextNodeIds":[735090111]},{"nodeId":735090111,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4144339706,"text":"Hmm? Are you talking about me behind my—","nextNodeIds":[735090112]},{"nodeId":735090112,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4215826698,"text":"Ah! It's... It's you! The golden-haired outlander and their White High-Intelligence Floating Assistive Unit!","nextNodeIds":[735090113]},{"nodeId":735090113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2532946242,"text":"Huh? You know us? Paimon doesn't remember having this nickname, though!","nextNodeIds":[735090114]},{"nodeId":735090114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3960015218,"text":"You have us at a disadvantage, Miss...","nextNodeIds":[735090115]},{"nodeId":735090115,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2927143402,"text":"Ah, so you've forgotten me. But I understand. I am but a normal plebeian, while you — you are living legends!","nextNodeIds":[735090116]},{"nodeId":735090116,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":740993722,"text":"A long time back, you aided my experiments with my great creation, the Remelting Tablets — alchemical potions designed to aid people in combat.","nextNodeIds":[735090117]},{"nodeId":735090117,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3272048626,"text":"That research went very smoothly indeed. You enjoyed hearty battles, and I drew much useful data and inspiration from said battles.","nextNodeIds":[735090118]},{"nodeId":735090118,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3352584714,"text":"It would not be wrong to say that you changed my life — and for that, I have always been thankful! The results of my research have also been of aid to some members of the Corps of Thirty in their work regarding Sumeru's security...","nextNodeIds":[735090119]},{"nodeId":735090119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1186799042,"text":"Seriously? Did we really do that? Huh, we should remember that in future, then.","nextNodeIds":[735090120]},{"nodeId":735090120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2876327706,"text":"Speaking of that, you were saying something about combat and potions earlier, weren't you?","nextNodeIds":[735090121]},{"nodeId":735090121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3759252274,"text":"Will you need our help this time as well?","nextNodeIds":[735090122]},{"nodeId":735090122,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3542715106,"text":"Well, why not? With you two around, I shan't have to rub shoulders with those sellswords.","nextNodeIds":[735090123]},{"nodeId":735090123,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3654337618,"text":"To tell the truth, I was worried that they might fleece me... or even rob me!","nextNodeIds":[735090139]},{"nodeId":735090139,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":231701042,"text":"If you were to help me complete the verification process for my Shock-Boiled Brews, I'd be willing to give you the part of my budget I set aside for this exactly. It would also serve as further thanks for your help.","nextNodeIds":[735090140]},{"nodeId":735090140,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3002252522,"text":"Mora worth fifty peoples' salaries. Not bad for remuneration, yes?","nextNodeIds":[735090141]},{"nodeId":735090141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4267104642,"text":"Fifty peoples' worth of Mora!? Doesn't that mean that we'll be set for... a long while once we do a single day of work?","nextNodeIds":[735090142]},{"nodeId":735090142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4151725298,"text":"#Sounds like a great deal, {NICKNAME}! We don't come by something like this often!","nextNodeIds":[735090143,735090144]},{"nodeId":735090143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2107516890,"text":"Looks like a good opportunity. Let's do it.","nextNodeIds":[735090145]},{"nodeId":735090145,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":551199282,"text":"Haha! As decisive as ever! Well then, let's get to business.","nextNodeIds":[735090146]},{"nodeId":735090146,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4168399466,"text":"I discovered a temperature-related weakness in the Remelting Tablets I was testing in the Great Red Sand. In high-heat conditions, the explosion of the remelting tablets would not achieve its desired effect.","nextNodeIds":[735090147]},{"nodeId":735090147,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1644972610,"text":"As such, I dissolved some potions in stable liquid solutions and stored them separately from the tablets, which have higher melting points. When using them, I mixed the two together and pressurized the container.","nextNodeIds":[735090148]},{"nodeId":735090148,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2914116210,"text":"Having the tablets explode within the liquid medium produces a shock-boiling effect with higher efficacy and greater stability, and so the new device was named the \"Shock-Boiling Device.\"","nextNodeIds":[735090149]},{"nodeId":735090149,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1026926082,"text":"You could sit in front of a Flaming Flower for an entire day, and you would still be able to use potions to aid you in battle. It's a huge leap in the reliability of the device!","nextNodeIds":[735090150]},{"nodeId":735090150,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2352671122,"text":"I even added periodic activation and recording functions to the device. In battle, it will activate in an automatic, reactive manner, and record combat data to boot. It's now incredibly easy to use!","nextNodeIds":[735090151]},{"nodeId":735090151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2578968794,"text":"Uh... So, we just need to use this super convenient support device to beat some monsters up, right?","nextNodeIds":[735090152]},{"nodeId":735090152,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1119829002,"text":"Exactly!","nextNodeIds":[735090153]},{"nodeId":735090153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1503666258,"text":"You really are serious about your work, Hajanad. You've explained this in so much detail that even as unfamiliar as Paimon is with this stuff, she thinks she's kinda got it!","nextNodeIds":[735090154]},{"nodeId":735090154,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1662039930,"text":"A less good-tempered researcher might have just said \"fixed some known issue\" just to dodge having to give that explanation!","nextNodeIds":[735090155,735090156]},{"nodeId":735090155,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3968031042,"text":"Well, it can activate automatically and make records...","nextNodeIds":[735090157]},{"nodeId":735090157,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":627626386,"text":"Alright then. Then let's do as we did before and help Hajanad test her device's effects out.","nextNodeIds":[735090158]},{"nodeId":735090158,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2996654266,"text":"We're in familiar territory — a few simple fights are all that separate us and a nice sum of Mora, and we can help Hajanad too! Everyone wins!","nextNodeIds":[735090159]},{"nodeId":735090159,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4120973194,"text":"Haha, talk about effective communication! I knew I'd much enjoy working with you two over those mercenaries!","nextNodeIds":[735090160]},{"nodeId":735090160,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4273800770,"text":"I've already prepared our test site — it's a Domain not far from here. Just take the device and help perform the tests, please!","nextNodeIds":[735090161]},{"nodeId":735090161,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1606390202,"text":"I'll be here waiting for your feedback!","nextNodeIds":[]},{"nodeId":735090156,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3549942210,"text":"We don't really need to understand the fine details behind how it works...","nextNodeIds":[735090157]},{"nodeId":735090144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3414368994,"text":"Let's hear it for the Shock-Boiled Brews, then.","nextNodeIds":[735090145]},{"nodeId":735090124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4259324186,"text":"Wait a moment. She looks rather familiar.","nextNodeIds":[735090125]},{"nodeId":735090125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4104076258,"text":"Huh. You're right. She does look pretty familiar.","nextNodeIds":[735090126]},{"nodeId":735090126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1238879898,"text":"Ooh, Paimon remembers! We met this person on a cliffside in the rainforest! What was her name again...","nextNodeIds":[735090127,735090129]},{"nodeId":735090127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4150520338,"text":"The Alchemical Teamaster.","nextNodeIds":[735090128]},{"nodeId":735090128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2260324122,"text":"Huh. Paimon remembers that she was a pretty serious-minded alchemist. Not someone who would use her cauldron for anything other than research... Wait a minute, her name was Hajanad!","nextNodeIds":[735090131]},{"nodeId":735090131,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":310078082,"text":"Hmm? Are you talking about me behind my—","nextNodeIds":[735090132]},{"nodeId":735090132,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2114538178,"text":"Could... Could it be you? The golden-haired outlander and their White High-Intelligence Floating Assistive Unit?","nextNodeIds":[735090133]},{"nodeId":735090133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1469647458,"text":"Well, we weren't expecting to meet like this either. How've you been, Hajanad?","nextNodeIds":[735090134]},{"nodeId":735090134,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1198090778,"text":"Good! Never been better, really!","nextNodeIds":[735090135]},{"nodeId":735090135,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3410265682,"text":"Thanks to you, I was able to use my Remelting Tablet research data to write an essay that proved its excellence. Even the Corps of Thirty expressed a certain amount of interest.","nextNodeIds":[735090136]},{"nodeId":735090136,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1652416674,"text":"As it turns out, my original mentor wasn't taking me seriously at all, even though he wasn't a big deal himself. The reviews I got for my essay eclipsed him and all his students, and so I was able to be rid of him in one go!","nextNodeIds":[735090137]},{"nodeId":735090137,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2848554874,"text":"My new mentor very much thinks my research has potential, and helped me set up a specialization with a rather decent budget...","nextNodeIds":[735090138]},{"nodeId":735090138,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3905394586,"text":"Ah yes. If the two of you have some time, could you help me once again?","nextNodeIds":[735090139]},{"nodeId":735090129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4233258178,"text":"The Master Alchemical Exploder.","nextNodeIds":[735090130]},{"nodeId":735090130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3650901874,"text":"Hey, that sounds like something Paimon would say instead! Pretty sure her name was... Hajanad! It was Hajanad!","nextNodeIds":[735090131]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7350901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"