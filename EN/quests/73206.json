NLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[{"talkId":7320505,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7320503","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7320601","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7320505,"initDialog":732050501,"nextRandomTalks":[],"nextTalks":[],"npcId":[4233],"performCfg":"QuestDialogue/WQ/Sumeru_73205/Q7320505","priority":5,"questId":73206,"showRandomTalkCount":0},"dialogs":[{"nodeId":732050501,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3196309122,"text":"♪Rose, oh rose, grant me my wish...","nextNodeIds":[732050502]},{"nodeId":732050502,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1569911346,"text":"Hmm? You're still here?","nextNodeIds":[732050503,732050513]},{"nodeId":732050503,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1949780698,"text":"Why live here?","nextNodeIds":[732050504]},{"nodeId":732050504,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2092702938,"text":"Well, anyway, I'm an old weirdo, and \"old weirdos behave in inexplicable ways.\" Few people ask me questions like you do.","nextNodeIds":[732050505]},{"nodeId":732050505,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":110396754,"text":"I've always wanted to go out and grab the chance to do something with my life.","nextNodeIds":[732050506]},{"nodeId":732050506,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":4149710434,"text":"When I was a newlywed, I almost left with the Eremites, but then I thought about it, and I couldn't just leave my wife to take up a life of wandering.","nextNodeIds":[732050507]},{"nodeId":732050507,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3241765082,"text":"Later, I met a traveling merchant and wanted to follow suit and do some business, but that didn't work out because I didn't have enough Mora.","nextNodeIds":[732050508]},{"nodeId":732050508,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":715141210,"text":"Much later, my wife passed and nothing held me back anymore, but by then, I'd gotten too old to leave.","nextNodeIds":[732050509]},{"nodeId":732050509,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2570292794,"text":"I've dragged things out up till now and I've missed out on too much.","nextNodeIds":[732050510]},{"nodeId":732050510,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":376942554,"text":"In retrospect, I've found that I belong neither to this village, nor to anywhere else.","nextNodeIds":[732050511]},{"nodeId":732050511,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2070759114,"text":"So in the end, I moved by myself to the edge of the village, and I found life here to be more comfortable.","nextNodeIds":[732050512]},{"nodeId":732050512,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3796481810,"text":"And decades went by, just like that.","nextNodeIds":[732050525]},{"nodeId":732050525,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1068378634,"text":"I'd like to invite you to come and see these flowers when they bloom. It's probably going to be tomorrow or the day after. Will you be able to make it?","nextNodeIds":[732050526]},{"nodeId":732050526,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2666097770,"text":"Sure.","nextNodeIds":[732050527]},{"nodeId":732050527,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3853086850,"text":"Alright, alright...","nextNodeIds":[732050528]},{"nodeId":732050528,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":771209882,"text":"♪Rose, oh rose, grant me my wish...","nextNodeIds":[]},{"nodeId":732050513,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1789280658,"text":"About the old ghost...","nextNodeIds":[732050514]},{"nodeId":732050514,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":4287648026,"text":"Only outsiders ask about the old ghost. The children of the village all know his name.","nextNodeIds":[732050515]},{"nodeId":732050515,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2360751954,"text":"Whenever a child is naughty, their parents will say, \"The old ghost will come take you away.\"","nextNodeIds":[732050516]},{"nodeId":732050516,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3919630698,"text":"These younglings don't know the old ghost at all, but are pretty good at using his name to scare people.","nextNodeIds":[732050517]},{"nodeId":732050517,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":832958402,"text":"I met the old ghost myself as a child. He did dislike children, but he wasn't scary.","nextNodeIds":[732050518]},{"nodeId":732050518,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":683924554,"text":"For some reason, he became known as the old ghost. I thought it was just a bunch of people talking about him behind his back.","nextNodeIds":[732050519]},{"nodeId":732050519,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2083456626,"text":"Weren't you friends?","nextNodeIds":[732050520]},{"nodeId":732050520,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":754735514,"text":"When I was young, I used to sneak close to his garden to play. He'd chase me away with a garden hoe as soon as he saw me.","nextNodeIds":[732050521]},{"nodeId":732050521,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3802528538,"text":"He probably took me for a naughty child looking to cause trouble. Why would he remember me?","nextNodeIds":[732050522]},{"nodeId":732050522,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":316169562,"text":"He might not have known who I was, but I still remember him and his little garden.","nextNodeIds":[732050523]},{"nodeId":732050523,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1319398402,"text":"So I suppose I can call him my friend, right?","nextNodeIds":[732050524]},{"nodeId":732050524,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":620888906,"text":"I want to grow the same flowers, just to recreate that little garden in my memories.","nextNodeIds":[732050525]}]}],"questNarration":[],"talkIds":[7320505,7320601,7320603,7320605],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","count":40},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173206],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2168627198,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73205/Q7320505","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_AND","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":732050501,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7320505,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[4233],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":true,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["7320503","3"],"_type":"QUEST_COND_STATE_EQU