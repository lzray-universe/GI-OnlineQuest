type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550601,"initDialog":755060101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1095],"performCfg":"QuestDialogue/WQ/3501_75506/Q7550601","priority":5,"questId":75506,"showRandomTalkCount":0},"dialogs":[{"nodeId":755060101,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":601126650,"text":"Hey, you're here. This is the last place where the Abyssal Aphid was spotted.","nextNodeIds":[755060102]},{"nodeId":755060102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1559191490,"text":"So, we're done if we catch it here, right?","nextNodeIds":[755060103]},{"nodeId":755060103,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":269567482,"text":"Pretty much. Even if a few manage to get away, it's not a big deal. I'll find time to deal with them.","nextNodeIds":[755060104]},{"nodeId":755060104,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":552435690,"text":"I already heard from the tribe that the patients have taken a turn for the better over the last few days.","nextNodeIds":[755060105]},{"nodeId":755060105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2004428138,"text":"That's great news!","nextNodeIds":[755060106]},{"nodeId":755060106,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":491603538,"text":"Though, there is one fly in the ointment: Your conspiracy theory turned out to be just that, Paimon.","nextNodeIds":[755060107]},{"nodeId":755060107,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":804626730,"text":"Seems like those fruit just grow naturally where the Aphids tend to congregate.","nextNodeIds":[755060108]},{"nodeId":755060108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1633104386,"text":"Uh... Paimon never expected some kinda Fatui... or Treasure Hoarder... or some other kind of mastermind behind the scenes... Paimon was just showing the kind of sensible caution any guide worth her salt would have!","nextNodeIds":[755060109]},{"nodeId":755060109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3933182746,"text":"I'm sure you'll always be vigilant, Paimon.","nextNodeIds":[755060110]},{"nodeId":755060110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3452557306,"text":"Hehe, that's a given!","nextNodeIds":[755060111]},{"nodeId":755060111,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":474538234,"text":"Alright, let's hurry up and wrap this up then.","nextNodeIds":[755060112]},{"nodeId":755060112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4246230666,"text":"Okay! Bugbuster Squad, move out! Time for our final battle!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7550602,"order":3,"stepDescription":"Capture the Abyssal Aphids","stepDescTextMapHash":1418725900,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[5216,7550602],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[5216,7550602],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7550603,"order":4,"stepDescription":"Talk to Xilonen","stepDescTextMapHash":1151625444,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7550602],"talks":[{"talkId":7550602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550602,"initDialog":755060201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1094,1095],"performCfg":"QuestDialogue/WQ/3501_75506/Q7550602","priority":5,"questId":75506,"showRandomTalkCount":0},"dialogs":[{"nodeId":755060201,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":2946591354,"text":"#Xilonen? {NICKNAME}, Paimon, you two as well? Hello!","nextNodeIds":[755060202]},{"nodeId":755060202,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":183174962,"text":"Ororon? What's wrong?","nextNodeIds":[755060203]},{"nodeId":755060203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1613311594,"text":"Have you recovered?","nextNodeIds":[755060204]},{"nodeId":755060204,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":3815605778,"text":"Thank you for your concern. Granny spent a few days pouring bitter stuff down my throat and forcing me to rest, and I'm much better now.","nextNodeIds":[755060205]},{"nodeId":755060205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1122441986,"text":"Hey, Ororon! Are you here to help Xilonen catch Aphids?","nextNodeIds":[755060206]},{"nodeId":755060206,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":4276303514,"text":"Aphids? Oh! So you were the ones who kidnapped Hundred Percent Sweetness...","nextNodeIds":[755060207]},{"nodeId":755060207,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":3116150906,"text":"No wonder Extreme Sweetness and Unusually Sweet also disappeared... It was you all along.","nextNodeIds":[755060208]},{"nodeId":755060208,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":651746562,"text":"Uh... Are those all the names of Aphids?","nextNodeIds":[755060209]},{"nodeId":755060209,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1814102730,"text":"Yep.","nextNodeIds":[755060210]},{"nodeId":755060210,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":757369026,"text":"It makes it easier to tell them apart. I don't actually judge them, after all, they're still amazing even if they don't produce honeydew.","nextNodeIds":[755060211]},{"nodeId":755060211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1483647874,"text":"So... These Aphids... were all raised by you?","nextNodeIds":[755060212]},{"nodeId":755060212,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1468635722,"text":"Actually, I don't really do much that would interfere with their natural behaviors. We just happen to live in the same territory. It's a kind of relationship where we just get along with each other.","nextNodeIds":[755060213]},{"nodeId":755060213,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1637922274,"text":"Uh... Sorry, I had no idea. But they were contaminated by the Abyss, which was affecting the tribe, so we had to take care of that.","nextNodeIds":[755060214]},{"nodeId":755060214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2116221314,"text":"Yeah, that's right! ...And we didn't harm them, either, just so you know!","nextNodeIds":[755060215]},{"nodeId":755060215,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":2587792602,"text":"Really? That's good. Still, no need to worry, it's not a big deal. In fact, I myself came here to deal with that problem.","nextNodeIds":[755060216]},{"nodeId":755060216,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":2531846378,"text":"But I must set the record straight. The Aphids weren't contaminated by the Abyss. They're smart little creatures who chose to eat the Abyssal energy.","nextNodeIds":[755060217]},{"nodeId":755060217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":347096458,"text":"Say what now? They chose to eat it?","nextNodeIds":[755060218]},{"nodeId":755060218,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1492055586,"text":"Exactly. They only eat a little bit at a time. Though that little bit is enough to make their bodies expand, but it won't kill them.","nextNodeIds":[755060219]},{"nodeId":755060219,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":4144261298,"text":"After a while, they'll fly somewhere far away, and then create Phlogiston Honey Pearls that bind up the contaminants inside.","nextNodeIds":[755060220]},{"nodeId":755060220,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":61239698,"text":"The outer shell of the Pearl acts as a barrier against the contamination, and this way, they can slowly strip away the Abyssal energy from their home.","nextNodeIds":[755060221]},{"nodeId":755060221,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1916064642,"text":"Though the process must be repeated over and over and over, but they're all patient critters. Even if the ants move, it isn't a problem.","nextNodeIds":[755060222]},{"nodeId":755060222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2029382082,"text":"Oh... So they're protecting their home...","nextNodeIds":[755060223]},{"nodeId":755060223,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":4285588354,"text":"First I've heard of it as well. So they know the land is being invaded, too.","nextNodeIds":[755060224]},{"nodeId":755060224,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":2676788466,"text":"Yes, Hundred Percent Sweetness and the rest have been fighting hard! They're all really great, capable Aphids.","nextNodeIds":[755060225]},{"nodeId":755060225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1413212090,"text":"Guess that's \"Natlan, the Nation of War\" for you.","nextNodeIds":[755060226]},{"nodeId":755060226,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2375784906,"text":"Though, Ororon, how did you find this place?","nextNodeIds":[755060227]},{"nodeId":755060227,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1881771714,"text":"Oh, that's because I fed them some Numberry seeds. They can't digest them, so it doesn't take long for them to excrete them.","nextNodeIds":[755060228]},{"nodeId":755060228,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":546131386,"text":"After the seeds hit the ground, they grow quickly, turning into fruiting bushes. If I follow the bushes, I can find them.","nextNodeIds":[755060229]},{"nodeId":755060229,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":3421647834,"text":"Then I gather the Honey Pearls they produce and take care of them, and then use more Numberries to bring them back.","nextNodeIds":[755060230]},{"nodeId":755060230,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1736165146,"text":"But it seems like you guys have already done all that for me, and didn't harm them in the process. Really, I'm very grateful to you all.","nextNodeIds":[755060231]},{"nodeId":755060231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":512342698,"text":"So that's what was going on with the Numberries! Paimon was draining all her brain juice trying to figure out if there was some kind of plot behind them...","nextNodeIds":[755060232]},{"nodeId":755060232,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":1139994546,"text":"Huh? Did I cause you any trouble?","nextNodeIds":[755060233]},{"nodeId":755060233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":306422114,"text":"No, not at all! Don't worry about it!","nextNodeIds":[755060234]},{"nodeId":755060234,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3917488458,"text":"Ororon, rest assured that we will return all the Abyss-cleaning Aphids back to you, just as they were.","nextNodeIds":[755060235]},{"nodeId":755060235,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":4194888850,"text":"That would be just perfect! They're all very important living beings, and must be treated well.","nextNodeIds":[755060236]},{"nodeId":755060236,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","textMapHash":4084710322,"text":"Well, since the problem's already taken care of, I'll see you all later! Feel free to drop by and visit me next time, I'll take you to see some other good friends of mine.","nextNodeIds":[755060237]},{"nodeId":755060237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":774553842,"text":"Then I'll be looking forward to it. Until next time.","nextNodeIds":[755060238]},{"nodeId":755060238,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2733435194,"text":"Phew! I never imagined things would turn out quite like this. That Ororon sure is a master of \"surprises.\"","nextNodeIds":[755060239]},{"nodeId":755060239,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1548204834,"text":"And thank you both. Without the two of you around, this would've been one boring trip.","nextNodeIds":[755060240]},{"nodeId":755060240,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1840378098,"text":"This is for you. It's an uncontaminated Phlogiston Honey Pearl. Don't worry, it's not valuable.","nextNodeIds":[755060241]},{"nodeId":755060241,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3817770154,"text":"Just think of it like a memento, something to remember these tiny warriors who fight for Natlan by.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7550601,7550602],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"Ororon","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":12},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[175506],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3749236310,"CHECNJEMEFE":{"1095":[1120]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"