{"mainQuestId":75506,"title":"Last Ride of the Bugbuster Squad","description":"The work of catching Abyssal Aphids is making steady progress, and today is the final mission...","titleTextMapHash":1154795047,"descTextMapHash":3749236310,"mainQuestExcel":{"mainQuestId":75506,"titleTextMapHash":1154795047,"title":"Last Ride of the Bugbuster Squad","descTextMapHash":3749236310,"description":"The work of catching Abyssal Aphids is making steady progress, and today is the final mission...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5216,"luaPath":"Actor/Quest/WQ75506","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5216,"chapterId":0,"descTextMapHash":3749236310,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75506,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2748399801,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75506","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175506],"series":75505,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1154795047,"type":"WQ","unlockDescTextMapHash":3059897790}},"flow":[{"subQuestId":7550601,"order":1,"stepDescription":"Wait until the following day","stepDescTextMapHash":2714927780,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJH