","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3060"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2202901],"talks":[{"talkId":2202901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2202901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2202901,"initDialog":220290101,"nextRandomTalks":[],"nextTalks":[2202906],"npcId":[3060],"performCfg":"","priority":5,"questId":22029,"showRandomTalkCount":0},"dialogs":[{"nodeId":220290101,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":553104074,"text":"I must! I must...","nextNodeIds":[220290102]},{"nodeId":220290102,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1216278490,"text":"Huh? Who are you?","nextNodeIds":[220290103]},{"nodeId":220290103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3269917706,"text":"I accepted your commission.","nextNodeIds":[220290104]},{"nodeId":220290104,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":937088010,"text":"Oh, you mean my request for a training partner. That's right, I posted that. I want to find someone as my martial arts training partner.","nextNodeIds":[220290105]},{"nodeId":220290105,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1149963058,"text":"So you're the one who accepted it? I don't think I have ever met you in the city before.","nextNodeIds":[220290106]},{"nodeId":220290106,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":4031697282,"text":"Sorry, I don't mean to question your strength. But I'm really not sure what your martial arts skills are like...","nextNodeIds":[220290107,220290109]},{"nodeId":220290107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2781221226,"text":"I've defeated giant dragons before.","nextNodeIds":[220290108]},{"nodeId":220290108,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1433963986,"text":"Hahaha... is that so? Actually, I'm more curious about where you found one of those. I've only heard of them before...","nextNodeIds":[220290112]},{"nodeId":220290112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3997196202,"text":"Oh, don't worry, I'm pretty capable.","nextNodeIds":[220290113]},{"nodeId":220290113,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1821984482,"text":"Haha, anyway, words won't prove anything. Let's put the words to test with our hands then.","nextNodeIds":[220290114,220290115]},{"nodeId":220290114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4041952362,"text":"Gladly.","nextNodeIds":[]},{"nodeId":220290115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2543024418,"text":"Actually, why did you post that commission anonymously?","nextNodeIds":[220290116]},{"nodeId":220290116,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":483095234,"text":"Well, it's actually because of something that I... am not proud of...","nextNodeIds":[220290117]},{"nodeId":220290117,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2306510146,"text":"Ahem, since you have already accepted it, I will tell you the truth, then.","nextNodeIds":[220290118]},{"nodeId":220290118,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3588193042,"text":"Earlier, I went out on a mission with several Doushin. On the way back, we ran into a group of Kairagi who were getting ready to raid a merchant caravan.","nextNodeIds":[220290119]},{"nodeId":220290119,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3826476906,"text":"We rushed over there to rescue the caravan. In the beginning, we had the upper hand, and they quickly retreated.","nextNodeIds":[220290120]},{"nodeId":220290120,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1444622330,"text":"But when we were just about to have a break, another group of Kairagi suddenly came out of nowhere, and there seemed to be a leader commanding them.","nextNodeIds":[220290121]},{"nodeId":220290121,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":682850010,"text":"Before my colleagues and I could react, they were already overwhelming us...","nextNodeIds":[220290122]},{"nodeId":220290122,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":4119675282,"text":"Having lost the upper hand, we could only try fending the Kairagi off while escorting the merchants back to the town.","nextNodeIds":[220290123]},{"nodeId":220290123,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2852350522,"text":"And when I was fighting against that Kairagi leader... he took my weapon.","nextNodeIds":[220290124]},{"nodeId":220290124,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3596300586,"text":"And that guy actually held my weapon up after taking it, laughing at me all the while. It was so humiliating...","nextNodeIds":[220290125]},{"nodeId":220290125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3307661818,"text":"What happened to that group of merchants?","nextNodeIds":[220290126]},{"nodeId":220290126,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1550515482,"text":"We ran into other patrolling Doushin while retreating, so those Kairagi also retreated after seeing them.","nextNodeIds":[220290127]},{"nodeId":220290127,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":1167908394,"text":"Those merchants were also escorted to the city by us. But their goods were all... *sigh* It's all because my skills were lacking...","nextNodeIds":[220290128]},{"nodeId":220290128,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2965320618,"text":"After returning, I was also issued another weapon. But I still can't get over what happened...","nextNodeIds":[220290129]},{"nodeId":220290129,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2226932754,"text":"Therefore, I posted that commission in the hopes of honing my skill.","nextNodeIds":[220290130]},{"nodeId":220290130,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":3803192866,"text":"Once I am powerful enough, I'm going to defeat that Kairagi myself and take my weapon back, clearing this stain from my name!","nextNodeIds":[]},{"nodeId":220290109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":973713002,"text":"I witnessed the fall of a god.","nextNodeIds":[220290110]},{"nodeId":220290110,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":2544177170,"text":"Eh, what are you talking about? You mean that you've taken part in the Rite of Descension in Liyue before, right?","nextNodeIds":[220290111]},{"nodeId":220290111,"roleType":"TALK_ROLE_NPC","speakerId":3060,"speakerName":"Asakura","textMapHash":4051406450,"text":"Hahaha, based on your logic, many people in Liyue have \"witnessed the fall of a god\" as well.","nextNodeIds":[220290112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2202901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3060"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2202904,"order":2,"stepDescription":"Talk to Asakura","stepDescTextMapHash":3600854788,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2202904,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_I