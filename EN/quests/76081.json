pe":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3045363314,"text":"Rest assured. After you and your comrades fell, my father Nikita took up the mantle of Starshyna and led the people you saved to rebuild the order.","nextNodeIds":[760810403]},{"nodeId":760810403,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":1929279746,"text":"Today, we are strong enough to protect this land even under the shadow of the Wild Hunt.","nextNodeIds":[760810404]},{"nodeId":760810404,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":3675141498,"text":"Your sacrifice was not made in vain. Your deeds and your will shall live on.","nextNodeIds":[760810405]},{"nodeId":760810405,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"Illuga","textMapHash":4237361730,"text":"Farewell, Mr. Sigurd. I'll visit you from time to time. May you find your peace at last.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7608102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7608104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133601402","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["7608101","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[{"talkId":7608199,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,