TYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30381"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7053201],"talks":[{"talkId":7053201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7053201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7053201,"initDialog":705320101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30381],"performCfg":"","priority":5,"questId":70532,"showRandomTalkCount":0},"dialogs":[{"nodeId":705320101,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":888631634,"text":"Hmm... Should I include this card? Huh? I still have some cards left...","nextNodeIds":[705320102]},{"nodeId":705320102,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":2559939730,"text":"Oh, hey Traveler! My apologies, I was too busy thinking about the card decks that I didn't notice you.","nextNodeIds":[705320103]},{"nodeId":705320103,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":4042511802,"text":"I'm an adventurer commissioned by the Guild to help organize the King of Invokations Grand Prix, and I'm in charge of a uh... duel event with special rules!","nextNodeIds":[705320104]},{"nodeId":705320104,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":3315047050,"text":"We named it \"Zero Hour Invokation.\"","nextNodeIds":[705320105,705320106]},{"nodeId":705320105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2438763890,"text":"How is this any different from ordinary TCG duels?","nextNodeIds":[705320107]},{"nodeId":705320107,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":3350904354,"text":"Oh, no, no, Zero Hour Invokation is an unofficial tournament with its own rules.","nextNodeIds":[705320108]},{"nodeId":705320108,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":3745007090,"text":"In Zero Hour Invokation, you will not be using your own decks. Instead, you'll be choosing three out of eight incomplete pre-built decks to form a full deck.","nextNodeIds":[705320109]},{"nodeId":705320109,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":4302746,"text":"Within the three decks, you'll find some newly released cards. As for using them to their full potential... that'll depend on your card skills.","nextNodeIds":[705320110]},{"nodeId":705320110,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":2173779274,"text":"The rest of the rules are identical to ordinary matches.","nextNodeIds":[705320111]},{"nodeId":705320111,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":2090688690,"text":"If you're out of ideas on how you should build your deck, we're always here to help.","nextNodeIds":[705320112]},{"nodeId":705320112,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":586771106,"text":"But I can't guarantee how good the decks will be, hehe.","nextNodeIds":[705320113]},{"nodeId":705320113,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":1938650106,"text":"Anyway, I suggest that you choose and build your own decks. You'll be using them to duel with other players after all.","nextNodeIds":[705320114]},{"nodeId":705320114,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":912587874,"text":"If you're confident about your skills, you can head over to the other cities where the Grand Prix is being held and try out Zero Hour Invokation there.","nextNodeIds":[705320115]},{"nodeId":705320115,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":2943374074,"text":"Oh, and you don't have to stress over it. In Zero Hour Invokation, all participants will receive prizes, regardless of the outcome of their duels.","nextNodeIds":[705320116]},{"nodeId":705320116,"roleType":"TALK_ROLE_NPC","speakerId":30381,"speakerName":"Frida","textMapHash":1781531786,"text":"If you're interested, come try it out.","nextNodeIds":[]},{"nodeId":705320106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":228436362,"text":"Doesn't feel any different from the Grand Prix...","nextNodeIds":[705320107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TAL