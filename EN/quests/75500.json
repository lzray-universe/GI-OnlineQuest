{"mainQuestId":75500,"title":"Avant-Garde Graffiti Visionary!","description":"The Children of Echoes' dances leave Paimon in awe, and beneath the stage, a certain artist from Natlan with unique views notices the budding talent you and Paimon possess...","titleTextMapHash":2315610007,"descTextMapHash":1392515022,"mainQuestExcel":{"mainQuestId":75500,"titleTextMapHash":2315610007,"title":"Avant-Garde Graffiti Visionary!","descTextMapHash":1392515022,"description":"The Children of Echoes' dances leave Paimon in awe, and beneath the stage, a certain artist from Natlan with unique views notices the budding talent you and Paimon possess...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2033,"luaPath":"Actor/Quest/WQ75500","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2033,"chapterId":0,"descTextMapHash":1392515022,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75500,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2899750801,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75500","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175500],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2315610007,"type":"WQ","unlockDescTextMapHash":2420493014}},"flow":[{"subQuestId":7550001,"order":1,"stepDescription":"Watch the Children of Echoes' dance event","stepDescTextMapHash":3482898028,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30609"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7550001],"talks":[{"talkId":7550001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550001,"initDialog":755000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30609],"performCfg":"QuestDialogue/WQ/Natlan_75500/Q7550001","priority":5,"questId":75500,"showRandomTalkCount":0},"dialogs":[{"nodeId":755000101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2702185058,"text":"Wow...","nextNodeIds":[755000102]},{"nodeId":755000102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":837210450,"text":"As it turns out, the Children of Echoes sure can dance! Paimon never thought the human body could perform the motions they did onstage!","nextNodeIds":[755000103]},{"nodeId":755000103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":921355634,"text":"The rhythmic music, the exciting fireworks... All of that combined brings a totally different vibe from anything we've seen so far!","nextNodeIds":[755000104]},{"nodeId":755000104,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3505581466,"text":"#Well said, radiant {M#sir}{F#lady}, and your wow-warbling floating doll, too!","nextNodeIds":[755000105]},{"nodeId":755000105,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1124518498,"text":"Sharp senses, and distinguished, too... Yes. I'm sure you have what it takes to be the vanguard of avant-garde, and a rising star amongst graffiti artists!","nextNodeIds":[755000106]},{"nodeId":755000106,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1345990690,"text":"So, how about it? Wanna join me, the Dopey Dazzler, in grasping the latest and greatest in trendy artistic thought?","nextNodeIds":[755000107]},{"nodeId":755000107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1682001474,"text":"Wow, here comes another person with an odd nickname!","nextNodeIds":[755000108,755000109]},{"nodeId":755000108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1090830428,"text":"Wow, you really do \"wow\" a lot.","nextNodeIds":[755000110]},{"nodeId":755000110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":521546882,"text":"Don't even try changing the subject! This isn't about the \"wow\" factor or a silly nickname. The important part is what this girl was talking about.","nextNodeIds":[755000111]},{"nodeId":755000111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3486726434,"text":"\"Avant-garde thought\"... Is that the key to Natlan's artistic uniqueness?","nextNodeIds":[755000112]},{"nodeId":755000112,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3058271298,"text":"Ah, there we go. Very perceptive!","nextNodeIds":[755000113]},{"nodeId":755000113,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2904307610,"text":"As you can see, the vibrant dances, the frenetic music, the vivid graffiti... All of this has deep connections to the avant-garde.","nextNodeIds":[755000114]},{"nodeId":755000114,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2348111258,"text":"Fashions, trends, novelty... To us, these are synonyms of \"avant-garde.\"","nextNodeIds":[755000115]},{"nodeId":755000115,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3833024762,"text":"As for me, the Dopey Dazzler, mainstay of the Graffiti Alliance, I'm trying to encourage a greater understanding of such forward thinking. First Natlan, then the world!","nextNodeIds":[755000116]},{"nodeId":755000116,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":998455234,"text":"That way, art will constantly evolve, and works of extraordinary aesthetic value may be produced! Ever upwards and on for large-scale graffiti work!","nextNodeIds":[755000117,755000118]},{"nodeId":755000117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2164809714,"text":"I don't quite get it.","nextNodeIds":[755000119]},{"nodeId":755000119,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2944180906,"text":"A more specific example, then. See the large work of graffiti in the stage backdrop? I was involved in drawing that.","nextNodeIds":[755000120]},{"nodeId":755000120,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1304552186,"text":"If that backdrop was a realistic landscape painting, a fine oil painting from Fontaine, or a mural from Sumeru...","nextNodeIds":[755000121]},{"nodeId":755000121,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3505855930,"text":"Do you think it would still fit?","nextNodeIds":[755000122]},{"nodeId":755000122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":77683906,"text":"Huh, okay, that's pretty straightforward. Paimon gets it now.","nextNodeIds":[755000123]},{"nodeId":755000123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3072597258,"text":"So if the backdrop's patterns and colors weren't as explosive, it would feel less... energetic?","nextNodeIds":[755000124]},{"nodeId":755000124,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":895694202,"text":"Of course, I wouldn't claim that landscape, oil, or wall paintings are bad, but when you need to emphasize vivid tension and burning soul, there's nothing quite like graffiti!","nextNodeIds":[755000125]},{"nodeId":755000125,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":529369938,"text":"If you ask me, every tribe here in Natlan has the impulse to strive ever higher, the desire to pursue strength — that's why avant-garde is our primary style!","nextNodeIds":[755000126]},{"nodeId":755000126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1027661450,"text":"Y'know, you call yourself \"dopey,\" but you're pretty knowledgeable, aren't you?","nextNodeIds":[755000127,755000128]},{"nodeId":755000127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3128000626,"text":"Are you going to take us on as students?","nextNodeIds":[755000129]},{"nodeId":755000129,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":660509458,"text":"Whoa, whoa, an old hand at this song-and-dance, are we?","nextNodeIds":[755000130]},{"nodeId":755000130,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":774342002,"text":"Don't worry, I'm not too fussed about all that master-student stuff, and I don't care about fortune or fame either. What we do here is share our experiences, in the hope that they will bloom and bear fruit everywhere.","nextNodeIds":[755000131]},{"nodeId":755000131,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":4241208914,"text":"As long as you can grasp the essence of avant-garde and create the inspired works of graffiti required, I'll be satisfied.","nextNodeIds":[755000132]},{"nodeId":755000132,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3722733794,"text":"In fact, I'd even cough up as much Mora and material as it took to help you grow into a graffiti master!","nextNodeIds":[755000133]},{"nodeId":755000133,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2047400954,"text":"And then, you can help me with sketches.","nextNodeIds":[755000134,755000135]},{"nodeId":755000134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2463481978,"text":"Me? Sketches?","nextNodeIds":[755000136]},{"nodeId":755000136,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2831147234,"text":"You could also help me promote this art elsewhere and attract more talent to our Alliance.","nextNodeIds":[755000137]},{"nodeId":755000137,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1661657002,"text":"After all, our goal is to create unparalleled avant-garde work on every mountain! Currently though, we number at just over ten people, and that's just not going to hack it.","nextNodeIds":[755000138]},{"nodeId":755000138,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2397946762,"text":"My back and waist... *sigh* If I had to carry dyes and paints all day, my bones would be left crooked, and my shoulders and thighs a mess too, no doubt.","nextNodeIds":[755000139]},{"nodeId":755000139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":309393754,"text":"Paimon was going to say that there seemed to be something fishy about all this...","nextNodeIds":[755000140]},{"nodeId":755000140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3643406234,"text":"But since you're being so honest, guess there can't be anything too off here.","nextNodeIds":[755000141]},{"nodeId":755000141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2863428810,"text":"#And y'know, {NICKNAME}, learning graffiti art doesn't sound so bad. We could probably draw something to mark our territory and scare off monsters and baddies!","nextNodeIds":[755000142]},{"nodeId":755000142,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1403831634,"text":"Haha, yes! That's the spirit! In that case, let's get to it.","nextNodeIds":[755000143]},{"nodeId":755000143,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":735309730,"text":"Now, our work isn't too strict about painting skills — it's all about the mindset. Let us begin, therefore, by taking the measure of avant-garde.","nextNodeIds":[755000144]},{"nodeId":755000144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1368507906,"text":"The \"measure\"? You mean the \"principles\"?","nextNodeIds":[755000145]},{"nodeId":755000145,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1776729514,"text":"Close enough! In short, we need to find the inspiration to break out of our constraints and express ourselves freely.","nextNodeIds":[755000146]},{"nodeId":755000146,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2200124658,"text":"Once you have done this, you'll be able to seize upon the scenery even amidst a speedrun challenge, and discover the limits of human movement in the midst of close-quarter combat, just as I do.","nextNodeIds":[755000147]},{"nodeId":755000147,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":786998506,"text":"That way, you'll discover the exaggerated line-work you need for graffiti.","nextNodeIds":[755000148]},{"nodeId":755000148,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3750413666,"text":"As for color schemes, we make use of combinations found in the natural world. You'll be surprised how many surprises it has in store...","nextNodeIds":[755000149]},{"nodeId":755000149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":694030170,"text":"This sounds familiar... But there's something a bit off...","nextNodeIds":[755000150,755000151]},{"nodeId":755000150,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2519171162,"text":"Observing lines of motion while racing and fighting.","nextNodeIds":[755000152]},{"nodeId":755000152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1723558042,"text":"These methods of studying \"aesthetics\" really are kinda different. Guess that's Natlan for you...","nextNodeIds":[755000153]},{"nodeId":755000153,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2674987834,"text":"Anyway, take this guidebook and this Kamera, and go forth throughout Natlan. Might as well enjoy the unique sights and sounds while you learn, eh?","nextNodeIds":[755000154]},{"nodeId":755000154,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3286727402,"text":"And once you're back, I'll use what you've seen and heard to help come up with an avant-garde philosophy you can best understand!","nextNodeIds":[]},{"nodeId":755000151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3406830490,"text":"Collecting materials and studying colors.","nextNodeIds":[755000152]},{"nodeId":755000135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4095747426,"text":"Hmm? Is that how you get your hands on new assistants?","nextNodeIds":[755000136]},{"nodeId":755000128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2687989282,"text":"What's your hourly rate?","nextNodeIds":[755000129]},{"nodeId":755000118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2772416042,"text":"Seems a bit abstract.","nextNodeIds":[755000119]},{"nodeId":755000109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3229826946,"text":"You're not beating the \"wow-warbler\" allegations.","nextNodeIds":[755000110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550001,0],"PAINLIBBLDK":"QUEST_CONTENT_C