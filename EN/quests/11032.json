ONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1103203","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1103202,"initDialog":110320201,"nextRandomTalks":[],"nextTalks":[],"npcId":[202901,1015],"performCfg":"QuestDialogue/LQ/Ganyu1_11032/Q1103203","priority":5,"questId":11032,"showRandomTalkCount":0},"dialogs":[{"nodeId":110320201,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":2699370658,"text":"Ms. Ganyu, thank you for accepting my invitation. And as for the two of you, your presence is also much appreciated.","nextNodeIds":[110320202]},{"nodeId":110320202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":350255266,"text":"Sure!","nextNodeIds":[110320203]},{"nodeId":110320203,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3744808762,"text":"That's so kind of you, Huixin. You went to great lengths to organize this.","nextNodeIds":[110320204]},{"nodeId":110320204,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":1541753978,"text":"Ha, truth be told... Apart from thanking you for all the help, there's something I'd like to tell you...","nextNodeIds":[110320205]},{"nodeId":110320205,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2854535098,"text":"Oh? If there's anything I can help you with, just tell me straight away. No need to hesitate.","nextNodeIds":[110320206]},{"nodeId":110320206,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":3501129314,"text":"Ah... No, no, I don't really need help. Uh... Could you just listen for a bit?","nextNodeIds":[110320207]},{"nodeId":110320207,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":831830522,"text":"With pleasure.","nextNodeIds":[110320208]},{"nodeId":110320208,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":3695452162,"text":"Ha... When I was a little girl, my father used to tell me many stories about you, Ms. Ganyu.","nextNodeIds":[110320209]},{"nodeId":110320209,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":349562146,"text":"Even though I have the utmost respect for my father... I always admired how gentle and reliable you are.","nextNodeIds":[110320210]},{"nodeId":110320210,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":3445603202,"text":"I only decided to join the Yuehai Pavilion staff because I've always looked up to you.","nextNodeIds":[110320211]},{"nodeId":110320211,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":28936170,"text":"I didn't know that you think so highly of me.","nextNodeIds":[110320212]},{"nodeId":110320212,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":1612756778,"text":"However, in reality, working at the Yuehai Pavilion turned out to be an arduous task.","nextNodeIds":[110320213]},{"nodeId":110320213,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":2264130154,"text":"I can't compare myself to such an outstanding secretary like you. I often doubt myself as a result...","nextNodeIds":[110320214]},{"nodeId":110320214,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2939151890,"text":"I disagree. You're a great secretary in your own right.","nextNodeIds":[110320215]},{"nodeId":110320215,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":2676630690,"text":"Aha, thank you.","nextNodeIds":[110320216]},{"nodeId":110320216,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":3481302586,"text":"Over the years, I became a mother, too...","nextNodeIds":[110320217]},{"nodeId":110320217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1084272114,"text":"Huh! So Uncle Tian is a grandpa!","nextNodeIds":[110320218]},{"nodeId":110320218,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":2725506322,"text":"Influenced by my youthful ideals, she followed my footsteps and came to be a secretary at the Yuehai Pavilion, too.","nextNodeIds":[110320219]},{"nodeId":110320219,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":3914064282,"text":"At first, I was worried about her. It's not an easy job, after all. To tell the truth, I'm still unsure if she's capable enough.","nextNodeIds":[110320220]},{"nodeId":110320220,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":308430394,"text":"But after all that happened this time, I've... made up my mind to support her choice.","nextNodeIds":[110320221]},{"nodeId":110320221,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":689518450,"text":"So, what made you change your mind?","nextNodeIds":[110320222]},{"nodeId":110320222,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":1239177010,"text":"The fact that she'll have you, Ms. Ganyu, as her senior colleague.","nextNodeIds":[110320223]},{"nodeId":110320223,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":2544895530,"text":"You'll help her, gentle as always, and tell her, \"Your mom used to do it like that.\" Heh.","nextNodeIds":[110320224]},{"nodeId":110320224,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":617387026,"text":"It'd be such a beautiful moment.","nextNodeIds":[110320225]},{"nodeId":110320225,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":3276781890,"text":"If it's not too much to ask for, she might still need your guidance in twenty plus years, too.","nextNodeIds":[110320226]},{"nodeId":110320226,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":1028026210,"text":"Huixin...","nextNodeIds":[110320227]},{"nodeId":110320227,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2251131418,"text":"I... I never thought that I meant so much to you.","nextNodeIds":[110320228]},{"nodeId":110320228,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":825541842,"text":"Heh, just like when you showed me my father's trick. Having you as their \"witness\" makes people feel at ease.","nextNodeIds":[110320229]},{"nodeId":110320229,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3230422146,"text":"\"Witness\"...","nextNodeIds":[110320230]},{"nodeId":110320230,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3555976746,"text":"...It's true that I've witnessed thousands of years of Liyue Harbor's history. All the changes it's gone through, the stories of its people...","nextNodeIds":[110320231]},{"nodeId":110320231,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2266045354,"text":"But I've always regarded it as nothing more than the source of my loneliness.","nextNodeIds":[110320232]},{"nodeId":110320232,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":893755818,"text":"Huixin, you don't know how important those words are to me...","nextNodeIds":[110320233]},{"nodeId":110320233,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":4100740538,"text":"You've made me realize that I share another connection with the people of Liyue Harbor, apart from my contract with Rex Lapis.","nextNodeIds":[110320234]},{"nodeId":110320234,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":1518449154,"text":"They rely on me, accept me, and long for me to bear witness to their stories.","nextNodeIds":[110320235]},{"nodeId":110320235,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":2968520850,"text":"Of course! You're irreplaceable to us!","nextNodeIds":[110320236]},{"nodeId":110320236,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":964364794,"text":"Ehehe... That's right. That's why I can't disappoint you.","nextNodeIds":[110320237]},{"nodeId":110320237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1601441338,"text":"Hooray! Ganyu's finally cheered up!","nextNodeIds":[110320238]},{"nodeId":110320238,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3451007938,"text":"Even if I've really been supplanted, I wish to fight for my place...","nextNodeIds":[110320239]},{"nodeId":110320239,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2829321170,"text":"I won't let you down. I'm going to fulfill my contract and keep working as the Qixing's secretary.","nextNodeIds":[110320240,110320241]},{"nodeId":110320240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1342789346,"text":"Uh... I told you, you haven't been...","nextNodeIds":[110320242]},{"nodeId":110320242,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":2101825458,"text":"Regardless, I'll go back and see for myself.","nextNodeIds":[110320243]},{"nodeId":110320243,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":4092073394,"text":"I'm afraid that it might've all become a mess during my absence.","nextNodeIds":[110320244]},{"nodeId":110320244,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"Ganyu","textMapHash":3187534474,"text":"No time to waste — let's get back to work!","nextNodeIds":[110320245]},{"nodeId":110320245,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"Huixin","textMapHash":3250172842,"text":"Good luck, Ms. Ganyu!","nextNodeIds":[110320246]},{"nodeId":110320246,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1529870418,"text":"Huuuuh!? We leaving already? Paimon's still hungry!","nextNodeIds":[]},{"nodeId":110320241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3399114250,"text":"You haven't been fired. It's a misunderstanding.","nextNodeIds":[110320242]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1103202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1035","201035001,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["202901"],"NOC