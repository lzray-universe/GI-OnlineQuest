_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7611804,"initDialog":761180401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76118/Q7611804","priority":5,"questId":76118,"showRandomTalkCount":0},"dialogs":[{"nodeId":761180401,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":74824210,"text":"Ah, you're back.","nextNodeIds":[761180402]},{"nodeId":761180402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3906132650,"text":"Guess what, Columbina? You were right, Lauma didn't tell us a thing!","nextNodeIds":[761180403]},{"nodeId":761180403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":558770458,"text":"She seems quite busy, though.","nextNodeIds":[761180404]},{"nodeId":761180404,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":996306242,"text":"So we'll be keeping you company over the next few days. You just sit tight and keep those expectations high!","nextNodeIds":[761180405]},{"nodeId":761180405,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1442222394,"text":"Expectations for... what exactly?","nextNodeIds":[761180406]},{"nodeId":761180406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3962032618,"text":"Ack...! Oh! Uh, nothing! We don't know a thing, honest!","nextNodeIds":[761180407]},{"nodeId":761180407,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1877182538,"text":"Hehe... Very well, then. I look forward to spending the next few days with you.","nextNodeIds":[761180408]},{"nodeId":761180408,"roleType":"TALK_ROLE_NPC","speakerId":15738,"speakerName":"Longplume Ibis","textMapHash":3495353074,"text":"!!!","nextNodeIds":[761180409]},{"nodeId":761180409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3360656226,"text":"Ooh, here comes our food... Wait a minute. Where's the grub?","nextNodeIds":[761180410]},{"nodeId":761180410,"roleType":"TALK_ROLE_NPC","speakerId":15738,"speakerName":"Longplume Ibis","textMapHash":1787956690,"text":"!!!","nextNodeIds":[761180411]},{"nodeId":761180411,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4099869426,"text":"It says, \"The time has come.\" Do you know what that means?","nextNodeIds":[761180412]},{"nodeId":761180412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1775132890,"text":"Ohhhhh, Paimon gets it now.","nextNodeIds":[761180413]},{"nodeId":761180413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3968444178,"text":"Columbina.","nextNodeIds":[761180414]},{"nodeId":761180414,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3155178506,"text":"Yes?","nextNodeIds":[761180415]},{"nodeId":761180415,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3825885074,"text":"You usually wear a blindfold, don't you?","nextNodeIds":[761180416]},{"nodeId":761180416,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4004509498,"text":"Yes. What of it?","nextNodeIds":[761180417]},{"nodeId":761180417,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2304044034,"text":"But you can use kuuvahki to observe the outside world even so, right?","nextNodeIds":[761180418]},{"nodeId":761180418,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3893420842,"text":"That's right. If anything, I sense things more clearly this way.","nextNodeIds":[761180419]},{"nodeId":761180419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":41973602,"text":"Then, uh, could we ask you to deliberately not sense any changes outside for the time being?","nextNodeIds":[761180420]},{"nodeId":761180420,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":568998978,"text":"So that this can be a \"pleasant surprise\"?","nextNodeIds":[761180421]},{"nodeId":761180421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3065039402,"text":"...Sounds like you've already guessed what this is about...","nextNodeIds":[761180422]},{"nodeId":761180422,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1184634058,"text":"Alright. I see. In that case, would you take my hand?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611804,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_360300034:2138.565,108.378,11193.690,0.000,117.940,0.000]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7611804,"order":4,"stepDescription":"Head to the statue of Kuutar","stepDescTextMapHash":2663423996,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611805,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAO