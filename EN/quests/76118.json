{"mainQuestId":76118,"title":"The Homebound Moon","description":"Columbina is having a spot of trouble in the Silvermoon Hall...","titleTextMapHash":1572568351,"descTextMapHash":2105340214,"mainQuestExcel":{"mainQuestId":76118,"titleTextMapHash":1572568351,"title":"The Homebound Moon","descTextMapHash":2105340214,"description":"Columbina is having a spot of trouble in the Silvermoon Hall...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76118","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":2105340214,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"UI_QuestSign_FlowerLand","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76118,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1764123209,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76118","mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1572568351,"type":"WQ","unlockDescTextMapHash":1149674294}},"flow":[{"subQuestId":7611801,"order":1,"stepDescription":"Meet Columbina","stepDescTextMapHash":4156882388,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_360300100:2141.429,108.600,11192.040,0.000,180.000,0.000]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7611801],"talks":[{"talkId":7611801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7611801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7611801,"initDialog":761180101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76118/Q7611801","priority":5,"questId":76118,"showRandomTalkCount":0},"dialogs":[{"nodeId":761180101,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3630962378,"text":"...","nextNodeIds":[761180102]},{"nodeId":761180102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1497148970,"text":"Is it just Paimon, or do you smell something yummy too?","nextNodeIds":[761180103]},{"nodeId":761180103,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":466846202,"text":"...","nextNodeIds":[761180104]},{"nodeId":761180104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1680866066,"text":"Columbina's having a feast for one!","nextNodeIds":[761180105]},{"nodeId":761180105,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2387808778,"text":"#{NICKNAME}, Paimon...","nextNodeIds":[761180106]},{"nodeId":761180106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2973673586,"text":"Looks like someone's enjoying herself...","nextNodeIds":[761180107]},{"nodeId":761180107,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2960084010,"text":"Would you like to try some as well?","nextNodeIds":[761180108]},{"nodeId":761180108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":925968890,"text":"No, no, you go ahead.","nextNodeIds":[761180109]},{"nodeId":761180109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1772205354,"text":"We don't usually see you eating here! Did you go out just to buy it?","nextNodeIds":[761180110]},{"nodeId":761180110,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4260996514,"text":"Lauma gave it to me.","nextNodeIds":[761180111]},{"nodeId":761180111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2057316018,"text":"Wow, she sure takes good care of you, huh?","nextNodeIds":[761180112]},{"nodeId":761180112,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":936998754,"text":"On the condition that I don't leave.","nextNodeIds":[761180113]},{"nodeId":761180113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":549368890,"text":"Wait, what!? Isn't that just a bribe so you'll accept house arrest? And a cheap one, at that!","nextNodeIds":[761180114]},{"nodeId":761180114,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":614289106,"text":"She also brought me some interesting books and exquisitely made toys...","nextNodeIds":[761180115]},{"nodeId":761180115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1958022634,"text":"Um, now it sounds more like a mother going out on a business trip and the kid she's leaving at home...","nextNodeIds":[761180116]},{"nodeId":761180116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":261304018,"text":"Did Lauma explain her reasoning?","nextNodeIds":[761180117]},{"nodeId":761180117,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":991921698,"text":"She just told me not to go out for the time being, and to be especially sure to avoid the Frostmoon Scions.","nextNodeIds":[761180118]},{"nodeId":761180118,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":128775218,"text":"I asked the animals who came to deliver my meals, but Lauma had instructed them to remain silent, and so they did.","nextNodeIds":[761180119]},{"nodeId":761180119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1247511682,"text":"Uh, that's...","nextNodeIds":[761180120]},{"nodeId":761180120,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1587551282,"text":"If I had to guess, she is preparing something that has to do with me.","nextNodeIds":[761180121]},{"nodeId":761180121,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3964545578,"text":"Worry not. I have never considered staying here boring in the first place. The food is good, and much to my liking. Not going out is fine with me.","nextNodeIds":[761180122]},{"nodeId":761180122,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":933950674,"text":"And if the Scions are indeed preparing for something... Well, all the more reason not to interrupt them.","nextNodeIds":[761180123]},{"nodeId":761180123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1457786506,"text":"Want us to go ask around?","nextNodeIds":[761180124]},{"nodeId":761180124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1785495282,"text":"Yeah. Paimon's kinda curious now, too.","nextNodeIds":[761180125]},{"nodeId":761180125,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":934412578,"text":"You can... but you should be prepared.","nextNodeIds":[761180126]},{"nodeId":761180126,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1513356314,"text":"She likely knows you'll come to see me, so she may not tell you anything at all.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_360300100:2141.429,108.600,11192.040,0.000,180.000,0.000]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7611802,"order":2,"stepDescription":"Meet Lauma","stepDescTextMapHash":306802020,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_360600059:1800.898,240.126,10367.920]","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7611803],"talks":[{"talkId":7611803,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7611802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7611803,"initDialog":761180301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1315],"performCfg":"QuestDialogue/WQ/NodKrai_76118/Q7611803","priority":5,"questId":76118,"showRandomTalkCount":0},"dialogs":[{"nodeId":761180301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2310743594,"text":"You wanna renovate the statue of Kuutar!?","nextNodeIds":[761180302]},{"nodeId":761180302,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2455731674,"text":"Precisely so.","nextNodeIds":[761180303]},{"nodeId":761180303,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2260211978,"text":"No longer is she the wingless Kuu{RUBY#[S]Moon Maiden}tar who could only gaze at the moon beyond the skies in solitude.","nextNodeIds":[761180304]},{"nodeId":761180304,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":4272306082,"text":"We witnessed her unfurling her wings, and know she has regained the freedom to live.","nextNodeIds":[761180305]},{"nodeId":761180305,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2759075450,"text":"As such, it is only right that the statue, too, be restored.","nextNodeIds":[761180306]},{"nodeId":761180306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":933153810,"text":"That does sound like a good idea!","nextNodeIds":[761180307]},{"nodeId":761180307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1024321266,"text":"Have you told the other Frostmoon Scions about this?","nextNodeIds":[761180308]},{"nodeId":761180308,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":596550026,"text":"That I have. I spoke to them of the Moon Goddess's sacrifice, and her return...","nextNodeIds":[761180309]},{"nodeId":761180309,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3235838802,"text":"And of how we stood against the force that pollutes this world with the guidance of that gentle light.","nextNodeIds":[761180310]},{"nodeId":761180310,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2484775426,"text":"Everyone was delighted to hear of her return, so I took the opportunity to convey Columbina's thoughts to them...","nextNodeIds":[761180311]},{"nodeId":761180311,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3860961274,"text":"That she wants to see us as family, and would like us to do the same for her.","nextNodeIds":[761180312]},{"nodeId":761180312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3062809210,"text":"And what did everyone say?","nextNodeIds":[761180313]},{"nodeId":761180313,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2505821810,"text":"...","nextNodeIds":[761180314]},{"nodeId":761180314,"roleType":"TALK_ROLE_NPC","speakerId":7096,"speakerName":"Zirnytsia","textMapHash":50420154,"text":"The Lady Moon Goddess...","nextNodeIds":[761180315]},{"nodeId":761180315,"roleType":"TALK_ROLE_NPC","speakerId":15476,"speakerName":"Lauha","textMapHash":1624507442,"text":"Would we... not be overstepping by regarding her as family?","nextNodeIds":[761180316]},{"nodeId":761180316,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2288072810,"text":"I believe that this is what Columbina genuinely wishes for.","nextNodeIds":[761180317]},{"nodeId":761180317,"roleType":"TALK_ROLE_NPC","speakerId":15475,"speakerName":"Kunegunda","textMapHash":1492684618,"text":"(I can't believe the Lady Moonchanter referred to our Moon Goddess by her first name!)","nextNodeIds":[761180318]},{"nodeId":761180318,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":745480834,"text":"Perhaps you may all yet recall the words I spoke not long ago.","nextNodeIds":[761180319]},{"nodeId":761180319,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2926073226,"text":"\"The road shall be paved with truth, and we shall pave it ourselves.\"","nextNodeIds":[761180320]},{"nodeId":761180320,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":4010631778,"text":"I will not ask all of you to make the same choice as I, but I do have words I would like to share with you this day.","nextNodeIds":[761180321]},{"nodeId":761180321,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3423542650,"text":"\"If we wish to invite the moonlight in to stay, we must first open doors that once were tightly shut.\"","nextNodeIds":[761180322]},{"nodeId":761180322,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1841905578,"text":"...That is what happened. Considering the situation over the past few days, things seem to have gone better than I thought they might have.","nextNodeIds":[761180323]},{"nodeId":761180323,"roleType":"TALK_ROLE_NPC","speakerId":15409,"speakerName":"Maciej","textMapHash":1875247802,"text":"Lady Lauma. A new batch of stone has arrived at the warehouse.","nextNodeIds":[761180324]},{"nodeId":761180324,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1523172330,"text":"Understood. I'll be right over.","nextNodeIds":[761180325]},{"nodeId":761180325,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":4112592498,"text":"Could you keep what I said, including what you've seen, a secret from Columbina — at least for now? I'd like this to be a surprise.","nextNodeIds":[761180326]},{"nodeId":761180326,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1045509514,"text":"Paimon knows you mean well, but seriously, you sure do love your surprises... You, and your Moon Goddess...","nextNodeIds":[761180327]},{"nodeId":761180327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3099643474,"text":"My lips are sealed.","nextNodeIds":[761180328]},{"nodeId":761180328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":549493626,"text":"Hey, Lauma, about Paimon's hush money... Er, Paimon meant to say, we don't happen to have any spare Feast of the Moon servings today, do we?","nextNodeIds":[761180329]},{"nodeId":761180329,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3184612738,"text":"That we do. Come, let me prepare some for you. Oh, and one more thing...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_360600059:1800.898,240.126,10367.920]","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7611803,"order":3,"stepDescription":"Report to Columbina","stepDescTextMapHash":467673892,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611804,0],"PAIN