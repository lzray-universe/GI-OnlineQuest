ndomTalkCount":0},"dialogs":[{"nodeId":761180501,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":403097706,"text":"Here we are.","nextNodeIds":[761180502]},{"nodeId":761180502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2136698386,"text":"You can open your eyes now.","nextNodeIds":[761180503]},{"nodeId":761180503,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1928355378,"text":"...","nextNodeIds":[761180504]},{"nodeId":761180504,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1180850802,"text":"(She really did open her eyes!)","nextNodeIds":[761180505]},{"nodeId":761180505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":213865250,"text":"(I just said that without thinking...)","nextNodeIds":[761180506]},{"nodeId":761180506,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":804561306,"text":"It's beautiful...","nextNodeIds":[761180507]},{"nodeId":761180507,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3718920114,"text":"This pair of wings makes it look all the more complete.","nextNodeIds":[761180508]},{"nodeId":761180508,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2282051994,"text":"This is a gift we Frostmoon Scions would like to give you, Columbina.","nextNodeIds":[761180509]},{"nodeId":761180509,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2762614330,"text":"To celebrate our goddess who can now fly free, whose fingers can at last touch the place she calls \"home.\"","nextNodeIds":[761180510]},{"nodeId":761180510,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":177894218,"text":"...The me from before would only be reminded of the confusion I felt upon being born whenever I looked upon this statue.","nextNodeIds":[761180511]},{"nodeId":761180511,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3440035986,"text":"But now, what I feel is the warmth of a \"home.\"","nextNodeIds":[761180512]},{"nodeId":761180512,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3240136866,"text":"Perhaps, like this statue, I have chosen to stay here even though I now have wings.","nextNodeIds":[761180513]},{"nodeId":761180513,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4164405914,"text":"...Thank you all.","nextNodeIds":[761180514]},{"nodeId":761180514,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":178367114,"text":"We do have another gift prepared, but you'll have to walk with me a bit farther.","nextNodeIds":[761180515]},{"nodeId":761180515,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":954715906,"text":"Huh? There's another surprise?","nextNodeIds":[761180516]},{"nodeId":761180516,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1856975706,"text":"My fellow Scions and I have organized a simple welcome banquet in the forest.","nextNodeIds":[761180517]},{"nodeId":761180517,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3129977842,"text":"From now on, this will be your home as well, Columbina.","nextNodeIds":[761180518]},{"nodeId":761180518,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3080874482,"text":"Whenever you grow homesick, please, feel free to remain here and enjoy our hospitality, meager though it may be.","nextNodeIds":[761180519]},{"nodeId":761180519,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4119579338,"text":"Sure. I will.","nextNodeIds":[761180520]},{"nodeId":761180520,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3391419498,"text":"Well, what do you know? The moon's up.","nextNodeIds":[761180521]},{"nodeId":761180521,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1728356506,"text":"Let's go, then.","nextNodeIds":[761180522]},{"nodeId":761180522,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2503352234,"text":"It is my hope that every night may be as wonderful as that Moon-Prayer Night.","nextNodeIds":[761180523]},{"nodeId":761180523,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":1072803954,"text":"Welcome home, Columbina.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611805,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133603052"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":[],"PAINLIBBLDK":"QUEST_EXEC_ACTIVE_DAMSELETTE_FREE_MOON_PHASE"},{"LNHLPKELCAL":["7611801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_360600080:1937.591,236.595,10530.780]","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7611801,7611803,7611804,7611805],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","count":31},{"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","count":27},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":24},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":1