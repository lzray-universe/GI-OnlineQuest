s sounds pretty serious. Let's go find a doctor, {NICKNAME}.","nextNodeIds":[]},{"nodeId":740320216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2905442602,"text":"Why don't you rest up in the infirmary?","nextNodeIds":[740320217]},{"nodeId":740320206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3848131090,"text":"That's certainly a new way to use the word \"fine.\"","nextNodeIds":[740320207]},{"nodeId":740320207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3641236842,"text":"You don't sound fine at all.","nextNodeIds":[740320208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5238"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7403203,"order":4,"stepDescription":"Ask for Arderne's opinion","stepDescTextMapHash":610022756,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5250"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7403203,7403205],"talks":[{"talkId":7403203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7403203","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7403203,"initDialog":740320301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5250],"performCfg":"QuestDialogue/Q7403203","priority":5,"questId":74032,"showRandomTalkCount":0},"dialogs":[{"nodeId":740320301,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":1440799498,"text":"Are you in trouble? Or are others in trouble? You both look healthy, so it must be the latter.","nextNodeIds":[740320302]},{"nodeId":740320302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2639847290,"text":"Indeed...","nextNodeIds":[740320303]},{"nodeId":740320303,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":731315922,"text":"You explain Lechlade's situation.","nextNodeIds":[740320304]},{"nodeId":740320304,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":1579061258,"text":"Him again, huh?","nextNodeIds":[740320305]},{"nodeId":740320305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":114971330,"text":"Can you treat him?","nextNodeIds":[740320306]},{"nodeId":740320306,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":730725634,"text":"His headache? Or his delusions?","nextNodeIds":[740320307]},{"nodeId":740320307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":505621738,"text":"Huh? You mean he's not that sick?","nextNodeIds":[740320308]},{"nodeId":740320308,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":2211732826,"text":"Based on his lab results, most likely not.","nextNodeIds":[740320309]},{"nodeId":740320309,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":1386486658,"text":"I heard that he misdiagnosed a patient when he was still on the outside, ignoring some early warning results, and healthcare outcome... Well, he's been a little paranoid ever since.","nextNodeIds":[740320310]},{"nodeId":740320310,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":1412342546,"text":"He's like that to others, and worse when it comes to himself.","nextNodeIds":[740320311]},{"nodeId":740320311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1095728962,"text":"How about the yellow-green stones?","nextNodeIds":[740320312]},{"nodeId":740320312,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":3568726018,"text":"No one else is having those same health issues, right?","nextNodeIds":[740320313]},{"nodeId":740320313,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":1513098858,"text":"But I can't very well ignore him, so please, give him this.","nextNodeIds":[740320314]},{"nodeId":740320314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2701009674,"text":"Isn't this Pure Water? Are you sure?","nextNodeIds":[740320315]},{"nodeId":740320315,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":2064397202,"text":"Oh, so you know what this is. It's fine in the sense that it does no harm to the body, and it'll give him a boost.","nextNodeIds":[740320316,740320318]},{"nodeId":740320316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2276295650,"text":"So he doesn't know?","nextNodeIds":[740320317]},{"nodeId":740320317,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":1132204738,"text":"As far as I know, he stays away from these drinks. But I gave it to him before, telling him it was a health potion, and he did actually show more vigor after drinking it.","nextNodeIds":[740320322]},{"nodeId":740320322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":606762026,"text":"Alright, we'll give this to him. If it doesn't work...","nextNodeIds":[740320323]},{"nodeId":740320323,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":2408095322,"text":"Then tell him to go lie down in the infirmary. If you tell him it's \"doctor's orders,\" he'll listen.","nextNodeIds":[740320324]},{"nodeId":740320324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1537451762,"text":"#Sure. Let's go back, {NICKNAME}.","nextNodeIds":[]},{"nodeId":740320318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3405883210,"text":"Why not just give him Fonta?","nextNodeIds":[740320319]},{"nodeId":740320319,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":2680368762,"text":"That's the thing. Everyone here knows what Fonta tastes like.","nextNodeIds":[740320320]},{"nodeId":740320320,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":3127600714,"text":"But based on my knowledge, he hasn't had Pure Water. After all, it's not very common here.","nextNodeIds":[740320321]},{"nodeId":740320321,"roleType":"TALK_ROLE_NPC","speakerId":5250,"speakerName":"Arderne","textMapHash":140774866,"text":"I gave it to him before, telling him it was a health potion, and he did actually show more vigor after drinking it.","nextNodeIds":[740320322]}]},{"talkId":7403205,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7403203","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","",