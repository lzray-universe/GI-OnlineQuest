:740320401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1124926418,"text":"We're back. The doctor gave you this.","nextNodeIds":[740320402]},{"nodeId":740320402,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":182950066,"text":"Lechlade takes the Pure Water and drinks all of it immediately.","nextNodeIds":[740320403]},{"nodeId":740320403,"roleType":"TALK_ROLE_NPC","speakerId":5238,"speakerName":"Lechlade","textMapHash":3719161514,"text":"Ah, me, that's better! Vigor fills me once again!","nextNodeIds":[740320404,740320406]},{"nodeId":740320404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3189923442,"text":"That's it!?","nextNodeIds":[740320405]},{"nodeId":740320405,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1549617866,"text":"Wasn't that a little too fast?","nextNodeIds":[740320408]},{"nodeId":740320408,"roleType":"TALK_ROLE_NPC","speakerId":5238,"speakerName":"Lechlade","textMapHash":3830482178,"text":"Arderne is a really good doctor, and certified, too! The medicine he prescribes always works. Unlike mine...","nextNodeIds":[740320409]},{"nodeId":740320409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":528301794,"text":"But what about the yellow-green stones?","nextNodeIds":[740320410]},{"nodeId":740320410,"roleType":"TALK_ROLE_NPC","speakerId":5238,"speakerName":"Lechlade","textMapHash":3495736786,"text":"Suspicious, of course!","nextNodeIds":[740320411]},{"nodeId":740320411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1574657226,"text":"Ugh, guess his delusions can't be helped.","nextNodeIds":[740320412]},{"nodeId":740320412,"roleType":"TALK_ROLE_NPC","speakerId":5238,"speakerName":"Lechlade","textMapHash":3895513154,"text":"Now I can keep working! Thank you so much for helping out. Here, take these Coupons — just a little something to show my appreciation.","nextNodeIds":[740320413]},{"nodeId":740320413,"roleType":"TALK_ROLE_NPC","speakerId":5238,"speakerName":"Lechlade","textMapHash":4187779514,"text":"Stay healthy!","nextNodeIds":[]},{"nodeId":740320406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2378461402,"text":"I don't think you were sick at all.","nextNodeIds":[740320407]},{"nodeId":740320407,"roleType":"TALK_ROLE_NPC","speakerId":5238,"speakerName":"Lechlade","textMapHash":1605568970,"text":"No, no, I was sick — but you brought me the cure!","nextNodeIds":[740320408]}]},{"talkId":7403206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7403204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"para