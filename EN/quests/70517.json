ONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7051701_T7051701_N30202","20"],"NOCCOBOFKHP":9,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7051701],"talks":[{"talkId":7051701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7051701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7051701,"initDialog":705170101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30221],"performCfg":"QuestDialogue/WQ/Mengde_70517/Q7051701","priority":5,"questId":70517,"showRandomTalkCount":0},"dialogs":[{"nodeId":705170101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1319480714,"text":"This place sure looks pretty normal.","nextNodeIds":[705170102]},{"nodeId":705170102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1155098914,"text":"Guess there won't be anything to eat here...","nextNodeIds":[705170103,705170104]},{"nodeId":705170103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3403270370,"text":"Don't give yourself away too soon, Paimon.","nextNodeIds":[705170105]},{"nodeId":705170105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1428760914,"text":"*cough* W—Well, y'know, looking for secrets is hungry work! Everyone knows that!","nextNodeIds":[705170106]},{"nodeId":705170106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3185438738,"text":"And anyway, we've recently been eating barbecue a lot to save time. Aren't you sick of that already?","nextNodeIds":[705170107]},{"nodeId":705170107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":996684650,"text":"If we can find some shells or conches, we can stew them with some fruit.","nextNodeIds":[705170108]},{"nodeId":705170108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2363169082,"text":"They'll be fresh and sweet and springy...","nextNodeIds":[705170109,705170111]},{"nodeId":705170109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1947234546,"text":"That sounds pretty terrible. Not my cup of tea.","nextNodeIds":[705170110]},{"nodeId":705170110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1227882058,"text":"Come on, give it go! It might open a whole new culinary world to you!","nextNodeIds":[705170113]},{"nodeId":705170113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2464721850,"text":"#Wait a moment! Look over there, {NICKNAME}.","nextNodeIds":[705170114]},{"nodeId":705170114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":374088402,"text":"That's weird, that device just appeared all of a sudden.","nextNodeIds":[705170115]},{"nodeId":705170115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1734029698,"text":"And there's some luggage nearby, too. Is that Fatui gear?","nextNodeIds":[705170116]},{"nodeId":705170116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1628956778,"text":"Huh. Right on the Mora, Paimon. Good work.","nextNodeIds":[705170117]},{"nodeId":705170117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2290772722,"text":"Right? Paimon was right on the Mora...","nextNodeIds":[705170118]},{"nodeId":705170118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3241071490,"text":"Waaait a moment. There's nothing good about this discovery!","nextNodeIds":[705170119]},{"nodeId":705170119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3730692714,"text":"If this is Fatui business, then there's gotta be some scheme afoot!","nextNodeIds":[705170120]},{"nodeId":705170120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3222486354,"text":"If we leave this thing be, things might eventually get out of control.","nextNodeIds":[705170121]},{"nodeId":705170121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4005708842,"text":"Whatever the case, let's see what we can do about that device first. If you think we should, let's have a look through that Fatui gear.","nextNodeIds":[705170122]},{"nodeId":705170122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":965636890,"text":"#Let's do this like we always do, {NICKNAME}, and then we can kick back and start looking for something to eat instead!","nextNodeIds":[]},{"nodeId":705170111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1427120162,"text":"Sounds like how you'd taste, Paimon.","nextNodeIds":[705170112]},{"nodeId":705170112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":962862418,"text":"Hey! Paimon isn't some aquacultural product!","nextNodeIds":[705170113]},{"nodeId":705170104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2425484338,"text":"Well, that's your enthusiasm explained...","nextNodeIds":[705170105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7051701_T7051701_N30202","20"],"NOCCOBOFKHP":9,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7051702,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7051702,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST