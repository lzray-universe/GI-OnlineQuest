nough, I have made great gains on all the futures I bought!","nextNodeIds":[230030204]},{"nodeId":230030204,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":3156624794,"text":"Come, let's go to Lambad's Tavern, and you can order whatever you want. It'll be my treat! I must thank you, after all.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2300302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2300303,"order":3,"stepDescription":"Talk to Hatim at Lambad's Tavern","stepDescTextMapHash":977058940,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2300304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4004"],"NOCCOBOFKHP":1072,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2300304],"talks":[{"talkId":2300304,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2300303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2300304,"initDialog":230030401,"nextRandomTalks":[],"nextTalks":[],"npcId":[4004],"performCfg":"QuestDialogue/IQ/Sumeru_23003/Q2300304","priority":5,"questId":23003,"showRandomTalkCount":0},"dialogs":[{"nodeId":230030401,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":4242800506,"text":"This is all thanks to your help, so please, order whatever you'd like to eat today! Haha!","nextNodeIds":[230030402]},{"nodeId":230030402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":195800538,"text":"Looks like you really did make a lot of Mora!","nextNodeIds":[230030403]},{"nodeId":230030403,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":2476857722,"text":"It is a good sum by a normal person's measure, but compared to the assets that I, Hatim, possess, it is but a mere ripple.","nextNodeIds":[230030404]},{"nodeId":230030404,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":3958436074,"text":"After all, I am also privy to knowledge obtained from decades of experience as an old hand. If you are interested in futures, I can share some of my personal experiences with you, in fact.","nextNodeIds":[230030405]},{"nodeId":230030405,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":1944672586,"text":"We agreed the last time that you shall gain additional benefits, so please, ask me anything.","nextNodeIds":[230030406]},{"nodeId":230030406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1868892130,"text":"Heh. Y'know, this additional benefit doesn't feel all that different from not having any!","nextNodeIds":[230030407]},{"nodeId":230030407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2788477018,"text":"We don't play with futures after all...","nextNodeIds":[230030408]},{"nodeId":230030408,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":3102916226,"text":"Oh, nonsense! You shall have a share of the Mora too, of course. But compared to that, my advice is what is truly of value!","nextNodeIds":[230030409]},{"nodeId":230030409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2986372002,"text":"Then Paimon has a question... Will there really be slime futures?","nextNodeIds":[230030410]},{"nodeId":230030410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4057546962,"text":"N—Not that Paimon wants to profit, of course! Just asking...","nextNodeIds":[230030411]},{"nodeId":230030411,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":2258683922,"text":"Only commodities in circulation can become futures, so if there is as much Slime Condensate as flour and milk on the market, then it's possible for tradable Slime Condensate futures to be created.","nextNodeIds":[230030412]},{"nodeId":230030412,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":1395317058,"text":"But I've mentioned this before. If you want to trade in Slime Condensate futures, I'm afraid that all Slimes in the wild will go extinct.","nextNodeIds":[230030413]},{"nodeId":230030413,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":1457193162,"text":"Plus, institutions or individuals who specialize in raising slimes may arise, and they may continuously produce large quantities of Slime Condensate.","nextNodeIds":[230030414]},{"nodeId":230030414,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":3666674498,"text":"When that time comes, the price of Slime Condensate might also go up...","nextNodeIds":[230030415]},{"nodeId":230030415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4221324810,"text":"What!? It's just buying some Slime Condensate, how can things get so complicated...?","nextNodeIds":[230030416]},{"nodeId":230030416,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2668146994,"text":"#P—Paimon'll just stick to getting {NICKNAME} to beat those Slimes up...","nextNodeIds":[230030417]},{"nodeId":230030417,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":2508884322,"text":"What about you, Child of Fortune? Do you have any questions?","nextNodeIds":[230030418]},{"nodeId":230030418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2266534306,"text":"How did you come up with the idea of \"Golden Dish\"?","nextNodeIds":[230030419]},{"nodeId":230030419,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":2101207682,"text":"Ha! You really are a Child of Fortune. Straight to asking about the key to wealth.","nextNodeIds":[230030420]},{"nodeId":230030420,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":1010424218,"text":"I can't really say that I \"came up with\" it, but I can say that I learned about these \"Golden Dishes\" during my long career in futures trading.","nextNodeIds":[230030421]},{"nodeId":230030421,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":2970635026,"text":"The futures trading market is treacherous... But as long as I have my \"Golden Dishes,\" piloting this investment ship shall be a cinch!","nextNodeIds":[230030422,230030423]},{"nodeId":230030422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3783836586,"text":"This really is nonsense...","nextNodeIds":[230030424]},{"nodeId":230030424,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":852050770,"text":"Ah, enough of that! Come, eat, eat! Eat up! I'll be asking for your help more often in the future.","nextNodeIds":[230030425]},{"nodeId":230030425,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"Hatim","textMapHash":2086909442,"text":"Here! Try this Shawarma Wrap. It's Sumeru's special dish. You really must try it, hahaha...","nextNodeIds":[230030426]},{"nodeId":230030426,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1151945754,"text":"You enjoy the delicious food with Hatim...","nextNodeIds":[]},{"nodeId":230030423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1813962418,"text":"Isn't this just what they call \"peace of mind\"...?","nextNodeIds":[230030424]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2300304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1072","201072