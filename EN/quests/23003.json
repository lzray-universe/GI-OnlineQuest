":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2300307,"initDialog":230030701,"nextRandomTalks":[],"nextTalks":[],"npcId":[12729],"performCfg":"QuestDialogue/IQ/Sumeru_23003/Q2300307","priority":5,"questId":23003,"showRandomTalkCount":0},"dialogs":[{"nodeId":230030701,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":1914464706,"text":"I went to the \"Wealth Spot\" and even ate the \"Golden Dish\"...","nextNodeIds":[230030702]},{"nodeId":230030702,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":2381028130,"text":"But the result is this drop...! This makes no sense! How is this market making any sense? Where's the fairness!?","nextNodeIds":[230030703]},{"nodeId":230030703,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2466338570,"text":"Hatim, we've been looking for you for a long time. Are you okay?","nextNodeIds":[230030704]},{"nodeId":230030704,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":1439986922,"text":"Ah, it's you guys... I... I'm fine. I'm great... Look. I'm not missing an arm or a leg or anything.","nextNodeIds":[230030705]},{"nodeId":230030705,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":1488864250,"text":"I just lost my deposit... Ahem...","nextNodeIds":[230030706]},{"nodeId":230030706,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2373176314,"text":"S—Sorry...","nextNodeIds":[230030707]},{"nodeId":230030707,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":2123229002,"text":"No! This is not your fault. Don't take it to heart.","nextNodeIds":[230030708]},{"nodeId":230030708,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":3375895106,"text":"Of course, it's certainly not my fault either. What's truly to blame is this market for being bad.","nextNodeIds":[230030709]},{"nodeId":230030709,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":2792604714,"text":"It makes no sense! It doesn't follow rules! It just goes down like that, and goes up like... like... Well, it didn't go up...","nextNodeIds":[230030710]},{"nodeId":230030710,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":2222893122,"text":"Really, argh... I really...","nextNodeIds":[230030711]},{"nodeId":230030711,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":60898594,"text":"Never mind, I simply cannot believe it... I cannot believe that I, Hatim the exceptionally rich from Kalimi, still cannot conquer futures trading!","nextNodeIds":[230030712]},{"nodeId":230030712,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":53705314,"text":"Didn't you lose everything...?","nextNodeIds":[230030713]},{"nodeId":230030713,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":3248212882,"text":"Hmph, it doesn't matter. I still have plenty of backup funds.","nextNodeIds":[230030714]},{"nodeId":230030714,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":3035909882,"text":"Even if I don't have any Mora on hand, I still have working capital and assets elsewhere.","nextNodeIds":[230030715]},{"nodeId":230030715,"roleType":"TALK_ROLE_NPC","speakerId":12729,"speakerName":"Hatim","textMapHash":31974