riority":5,"questId":23021,"showRandomTalkCount":0},"dialogs":[{"nodeId":230210101,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2912106682,"text":"Traveler! You're just in time. I just launched the ship. It's steady as she goes, as they say.","nextNodeIds":[230210102]},{"nodeId":230210102,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2817558794,"text":"My calculation worked out perfectly, just as I thought!","nextNodeIds":[230210103]},{"nodeId":230210103,"roleType":"TALK_ROLE_NPC","speakerId":4031,"speakerName":"Qishan","textMapHash":1281667954,"text":"So, when do we start this load test?","nextNodeIds":[230210104]},{"nodeId":230210104,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":3692642706,"text":"Let's not rush. The Traveler is here, so we may start soon.","nextNodeIds":[230210105]},{"nodeId":230210105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2695503042,"text":"What's a load test?","nextNodeIds":[230210106]},{"nodeId":230210106,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":869467178,"text":"In a nutshell, we test the load capacity of the ship using heavy objects.","nextNodeIds":[230210107]},{"nodeId":230210107,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":3836955122,"text":"This means that someone is going to have to move the stuff onto the ship with me.","nextNodeIds":[230210108]},{"nodeId":230210108,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":58009538,"text":"And you, Traveler, as I observed previously, are most able-bodied. Surely such a gig is a piece of cake to you...","nextNodeIds":[230210109,230210110]},{"nodeId":230210109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1616308858,"text":"Oh, so that's why you asked me to come here, eh?","nextNodeIds":[230210111]},{"nodeId":230210111,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":3144287530,"text":"Well... Ugh, I can't do this on my own, so I could only ask you to help out.","nextNodeIds":[230210112]},{"nodeId":230210112,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1307510554,"text":"There will be generous rewards, I promise! I just helped a guy fix his large ship days ago. It was a pretty well-paying job, too!","nextNodeIds":[230210113]},{"nodeId":230210113,"roleType":"TALK_ROLE_NPC","speakerId":4031,"speakerName":"Qishan","textMapHash":1883411554,"text":"Well paid, you say...","nextNodeIds":[230210114]},{"nodeId":230210114,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2921953266,"text":"Eh? Uh, well, I did spend nearly all that Mora on the ship...","nextNodeIds":[230210115]},{"nodeId":230210115,"roleType":"TALK_ROLE_NPC","speakerId":4031,"speakerName":"Qishan","textMapHash":4264022306,"text":"Nearly all?","nextNodeIds":[230210116]},{"nodeId":230210116,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2056095058,"text":"I still have some left! Don't worry, I can still buy you some coffee...","nextNodeIds":[230210117]},{"nodeId":230210117,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":619684810,"text":"Well then, Traveler, let's get this started! To the ship!","nextNodeIds":[]},{"nodeId":230210110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1148765266,"text":"Oh, now I'm slightly annoyed.","nextNodeIds":[230210111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2302101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,