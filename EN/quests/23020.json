YLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4032 "],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2302001],"talks":[{"talkId":2302001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2302001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2302001,"initDialog":230200101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4032,4031],"performCfg":"QuestDialogue/IQ/Xumi_23020/Q2302001","priority":5,"questId":23020,"showRandomTalkCount":0},"dialogs":[{"nodeId":230200101,"roleType":"TALK_ROLE_NPC","speakerId":4031,"speakerName":"Qishan","textMapHash":1977052514,"text":"...That's why I'd submit that we can't scrimp too much on material in this area.","nextNodeIds":[230200102]},{"nodeId":230200102,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":106161738,"text":"Don't worry, its strength is good enough. I've done the necessary calculations many times.","nextNodeIds":[230200103]},{"nodeId":230200103,"roleType":"TALK_ROLE_NPC","speakerId":4031,"speakerName":"Qishan","textMapHash":3494175290,"text":"Argh, I've told you this before. Many problems cannot simply be solved by calculation...","nextNodeIds":[230200104]},{"nodeId":230200104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3618504010,"text":"What are you guys arguing about?","nextNodeIds":[230200105]},{"nodeId":230200105,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1202565418,"text":"Oh, it's you. We're discussing the design problems of that ship of mine.","nextNodeIds":[230200106]},{"nodeId":230200106,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1849856002,"text":"I've done plenty of calculations, and I can guarantee that every area has enough strength.","nextNodeIds":[230200107]},{"nodeId":230200107,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1890948746,"text":"But Qishan stubbornly claims that the calculated strength is not necessarily reliable...","nextNodeIds":[230200108]},{"nodeId":230200108,"roleType":"TALK_ROLE_NPC","speakerId":4031,"speakerName":"Qishan","textMapHash":3918844770,"text":"The \"strength\" that you're talking about only exists in theory.","nextNodeIds":[230200109]},{"nodeId":230200109,"roleType":"TALK_ROLE_NPC","speakerId":4031,"speakerName":"Qishan","textMapHash":2150810530,"text":"The ship will have to withstand pressure while in the water, and that will be way more than the numbers you have here.","nextNodeIds":[230200110]},{"nodeId":230200110,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2154410010,"text":"I understand the logic, but my finances are limited, and...","nextNodeIds":[230200111]},{"nodeId":230200111,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":579089082,"text":"If I buy more expensive materials, I will only be able to finish the keel of this ship at most... *cough*!","nextNodeIds":[230200112]},{"nodeId":230200112,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2143974754,"text":"Anyway! Let's just follow my plan for this ship for now. I've already purchased all the materials.","nextNodeIds":[230200113]},{"nodeId":230200113,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":3417656602,"text":"Traveler, if you're willing, could you help me carry some materials? I can't carry them all by myself...","nextNodeIds":[230200114,230200115]},{"nodeId":230200114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4193187890,"text":"No problem.","nextNodeIds":[230200118]},{"nodeId":230200118,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":3643473858,"text":"I'm leaving it to you then, as I have calculations to work with. I'll fetch the rest after I'm done...","nextNodeIds":[]},{"nodeId":230200115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1944935906,"text":"Qishan knows about shipbuilding?","nextNodeIds":[230200116]},{"nodeId":230200116,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":312504082,"text":"Oh, she does. She's even faster than me when it comes to certain calculations, actually.","nextNodeIds":[230200117]},{"nodeId":230200117,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":62909322,"text":"I have no idea why she wants to be a helper here, really...","nextNodeIds":[230200118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2302001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4032 "],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2302002,"order":2,"stepDescription":"Fetch the materials for building the ship","stepDescTextMapHash":2644028612,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2302002,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2302001_GUIDE","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2302002,2302006],"talks":[{"talkId":2302002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,