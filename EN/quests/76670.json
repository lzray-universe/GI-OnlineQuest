],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7667001,"initDialog":766700101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7058],"performCfg":"","priority":5,"questId":76670,"showRandomTalkCount":0},"dialogs":[{"nodeId":766700101,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2012260930,"text":"Lyylikki, how have things gone for you lately?","nextNodeIds":[766700102]},{"nodeId":766700102,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2310405442,"text":"Ah! Hello, Lady Lauma. Everything's been going smoothly here.","nextNodeIds":[766700103]},{"nodeId":766700103,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":312336458,"text":"The supply of ingredients has been steady, no one's causing trouble, and my cooking skills have really improved!","nextNodeIds":[766700104]},{"nodeId":766700104,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1048393258,"text":"Oh, by the way, about those \"friends\" you mentioned last time... Were you talking about those animals?","nextNodeIds":[766700105]},{"nodeId":766700105,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":3579002018,"text":"They're so well-behaved and just quietly watch the people in line. I tried offering them something to eat, but they wouldn't take it...","nextNodeIds":[766700106]},{"nodeId":766700106,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":2396091426,"text":"Those little ones understand their duties. When they're on shift, they stay focused and hold to their posts.","nextNodeIds":[766700107]},{"nodeId":766700107,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3654158898,"text":"Still, once they're off duty, feel free to give them a little treat. Hehe, I'm sure they'd be delighted.","nextNodeIds":[766700108]},{"nodeId":766700108,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":4221322978,"text":"Great! Then I'll make something delicious today to show my thanks.","nextNodeIds":[766700109]},{"nodeId":766700109,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":3494514682,"text":"Thank you, Lyylikki. If you need any help, just let me know.","nextNodeIds":[766700110]},{"nodeId":766700110,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":4260327810,"text":"No need, really! I've got it all under control — and besides, Mr. Kantor and Miss Jahoda are helping out.","nextNodeIds":[766700111]},{"nodeId":766700111,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"Lauma","textMapHash":250796058,"text":"Alright, I'll leave you to it. See you later, Lyylikki.","nextNodeIds":[766700112]},{"nodeId":766700112,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":2925029738,"text":"Ah, I should go bring out the next round of dishes... Oh, Lady Lauma, would you like to try this plate as well? It's freshly made — just came off the stove!","nextNodeIds":[766700113]},{"nodeId":766700113,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"Lyylikki","textMapHash":1440414658,"text":"Alright, now to plate the food... Huh? Where are the plates I just washed...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7667001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QU