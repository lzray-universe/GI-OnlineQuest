{"mainQuestId":75124,"title":"","description":"","titleTextMapHash":3500624511,"descTextMapHash":2959565574,"mainQuestExcel":{"mainQuestId":75124,"titleTextMapHash":3500624511,"title":"","descTextMapHash":2959565574,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ75124","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2959565574,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75124,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":642410137,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75124","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3500624511,"type":"WQ","unlockDescTextMapHash":2493585790}},"flow":[{"subQuestId":7512401,"order":1,"stepDescription":"","stepDescTextMapHash":2581408076,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7512401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21732"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7512401],"talks":[{"talkId":7512401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7512401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7512401,"initDialog":751240101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21732],"performCfg":"QuestDialogue/WQ/Natian_75124/Q7512401","priority":5,"questId":75124,"showRandomTalkCount":0},"dialogs":[{"nodeId":751240101,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":1354336210,"text":"*sigh* It ran off again. Agh, there's only one left inside the swim ring... What do we do now...","nextNodeIds":[751240102]},{"nodeId":751240102,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":2745574882,"text":"How long is this going to take...","nextNodeIds":[751240103]},{"nodeId":751240103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3681725578,"text":"Huh, looks like someone's taking pictures... of the Flowcurrent Birds here?","nextNodeIds":[751240104]},{"nodeId":751240104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4200193626,"text":"Well, they are pretty cute...","nextNodeIds":[751240105,751240107]},{"nodeId":751240105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2811780378,"text":"What with how they sway this way and that...","nextNodeIds":[751240106]},{"nodeId":751240106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2063964290,"text":"Right? They're so cute, bobbing about as they walk. And when they puff up into a ball and float on the water... Ah, that just makes Paimon feel happy.","nextNodeIds":[751240109]},{"nodeId":751240109,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":2600045178,"text":"That's the spirit, my lovely young lady with the beautifully shiny silver hair! Truly, the one who created these Flowcurrent Birds deserves all the praise this world can offer...","nextNodeIds":[751240110]},{"nodeId":751240110,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":3560626946,"text":"So great is... Ah, wait, I haven't introduced myself yet. I'm a Flowcurrent Bird photography enthusiast. Call me Jonvelle.","nextNodeIds":[751240111]},{"nodeId":751240111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2934740090,"text":"#Sure! My name's Paimon, and this is {NICKNAME}... Still, why are you sighing sadly over here? Aren't there tons of Flowcurrent Birds around you?","nextNodeIds":[751240112]},{"nodeId":751240112,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":995513506,"text":"That's... a long story, but allow me to summarize. There are many just like me, and all of us want to take the most interesting photos...","nextNodeIds":[751240113]},{"nodeId":751240113,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":3171772042,"text":"And just a few days ago, I came up with an idea most ingenious... That is, to put all the Flowcurrent Birds within my Kamera frame into swim rings!","nextNodeIds":[751240114,751240117]},{"nodeId":751240114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":213236770,"text":"And what might be the meaning in that, exactly?","nextNodeIds":[751240115]},{"nodeId":751240115,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":1562939266,"text":"The meaning, of course, is that it is utterly meaningless. Flowcurrent Birds can swim, and as such, to have them wear those swim rings...","nextNodeIds":[751240116]},{"nodeId":751240116,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":1502614586,"text":"...Is a thing as devoid of meaning as spending Mora to earn the same amount of Mora back!","nextNodeIds":[751240120]},{"nodeId":751240120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":929877042,"text":"Feels like you're putting too much on their shoulders...","nextNodeIds":[751240121]},{"nodeId":751240121,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":742844738,"text":"Indeed, that is what they call \"surrealist photography\" — one must seek deeper meaning within the photo one takes... Though, unfortunately we've run into some trouble on that front.","nextNodeIds":[751240122]},{"nodeId":751240122,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":3395428434,"text":"As one might expect, real Flowcurrent Birds don't wear swim rings, and so one cannot, in fact, take such pictures...","nextNodeIds":[751240123]},{"nodeId":751240123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1784309914,"text":"You did call it \"surreal,\" you know...","nextNodeIds":[751240124]},{"nodeId":751240124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":226265242,"text":"#Wait. We could just put the swim rings on all the Flowcurrent Birds, couldn't we? C'mon, {NICKNAME}. Let's lend a hand, from two Flowcurrent Bird enthusiasts to another!","nextNodeIds":[751240125,751240127]},{"nodeId":751240125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4088317498,"text":"Woohoo, yes, jolly enthusiast cooperation!","nextNodeIds":[751240126]},{"nodeId":751240126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1651048210,"text":"Ex-actly!","nextNodeIds":[751240129]},{"nodeId":751240129,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":1442296754,"text":"Wait, really? You'd help me out?","nextNodeIds":[751240130]},{"nodeId":751240130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3036700642,"text":"Hehe, as long as you give us a few nice pictures once you're done!","nextNodeIds":[751240131]},{"nodeId":751240131,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":893138154,"text":"W—Well then, I'd be in your debt!","nextNodeIds":[]},{"nodeId":751240127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3706891554,"text":"I prefer Flying Squirrels though...","nextNodeIds":[751240128]},{"nodeId":751240128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":617668898,"text":"Hey, now's not the time for that sort of talk!","nextNodeIds":[751240129]},{"nodeId":751240117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2454202138,"text":"Indeed, this is hardly something a normal person would have considered...","nextNodeIds":[751240118]},{"nodeId":751240118,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":3619003482,"text":"When Flowcurrent Birds, who can float on water by themselves, wear swim rings, this will create an overflow of layered meaning within the photo.","nextNodeIds":[751240119]},{"nodeId":751240119,"roleType":"TALK_ROLE_NPC","speakerId":21732,"speakerName":"Jonvelle","textMapHash":838377978,"text":"Thus, sufficiently embodying both the themes of \"overuse\" and \"waste\"...","nextNodeIds":[751240120]},{"nodeId":751240107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1828202546,"text":"I prefer Flying Squirrels, to be honest...","nextNodeIds":[751240108]},{"nodeId":751240108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1225883914,"text":"Well, they're cute too, but could you really bear to say \"Flying Squirrels are cuter\" right in front of a swimming Flowcurrent Bird's face?","nextNodeIds":[751240109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7512401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21732"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7512402,"order":2,"stepDescription":"","stepDescTextMapHash":1259