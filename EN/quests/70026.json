{"mainQuestId":70026,"title":"Journey to Tsurumi","description":"Katheryne of the Adventurers' Guild is currently puzzling over a certain commission...","titleTextMapHash":674190911,"descTextMapHash":138237726,"mainQuestExcel":{"mainQuestId":70026,"titleTextMapHash":674190911,"title":"Journey to Tsurumi","descTextMapHash":138237726,"description":"Katheryne of the Adventurers' Guild is currently puzzling over a certain commission...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ70026","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":138237726,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70026,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":542514929,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70026","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170026],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":674190911,"type":"WQ","unlockDescTextMapHash":1881417950}},"flow":[{"subQuestId":7002601,"order":1,"stepDescription":"Talk to Katheryne","stepDescTextMapHash":2432157628,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7002601],"talks":[{"talkId":7002601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7002601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7002601,"initDialog":700260101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3004],"performCfg":"","priority":5,"questId":70026,"showRandomTalkCount":0},"dialogs":[{"nodeId":700260101,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":1277960354,"text":"Hello there, Traveler. We meet again.","nextNodeIds":[700260102]},{"nodeId":700260102,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3932516586,"text":"Your recent commission completion record has been stellar indeed. Why, I'd even say you're one of our star adventurers.","nextNodeIds":[700260103,700260105]},{"nodeId":700260103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2461875978,"text":"You're too kind.","nextNodeIds":[700260104]},{"nodeId":700260104,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":1553369586,"text":"We of the Inazuma Adventurers' Guild are normally in contact with the other branches throughout Teyvat. As such, there is no need for you to be so humble. Your exploits in Mondstadt and Liyue are known to us.","nextNodeIds":[700260107]},{"nodeId":700260107,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":330859322,"text":"Actually, we'd like you to consider working on a relatively simple investigation. The area to be investigated is on Tsurumi Island.","nextNodeIds":[700260108]},{"nodeId":700260108,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2124707954,"text":"The weather on the island can be considered quite unique, and it is shrouded in fog all year around. However, investigations should still be relatively safe to conduct.","nextNodeIds":[700260109]},{"nodeId":700260109,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":153745698,"text":"The Guild normally sends more experienced adventurers to take up this task, but this time, the adventurer we sent canceled the commission soon after arriving on Tsurumi Island.","nextNodeIds":[700260110]},{"nodeId":700260110,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3812302610,"text":"He did not elaborate much as to his reasons; he just hurriedly explained that it was beyond his abilities and that he was giving it up.","nextNodeIds":[700260111]},{"nodeId":700260111,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":1837803362,"text":"But after this adventurer forfeited, this commission ended up idling here for quite a while without anyone to take it up. The commissioning party has asked after it several times already...","nextNodeIds":[700260112]},{"nodeId":700260112,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3146346850,"text":"Well then, I thought, we should probably send an adventurer with exceptional survival skills and experience, and have them complete this commission.","nextNodeIds":[700260113]},{"nodeId":700260113,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2161249970,"text":"That was when you came to mind. So, what do you say, Traveler?","nextNodeIds":[700260114,700260117]},{"nodeId":700260114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3599805338,"text":"This all seems a little fishy.","nextNodeIds":[700260115]},{"nodeId":700260115,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3035504866,"text":"That's an understandable perspective. That the previous adventurer canceled on us was quite unexpected indeed...","nextNodeIds":[700260116]},{"nodeId":700260116,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":4199719650,"text":"Tsurumi Island is quite far off the beaten track, and the Guild knows precious little about it.","nextNodeIds":[700260120]},{"nodeId":700260120,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2346282402,"text":"Well, we can work around this and decrease the commission's requirements a little.","nextNodeIds":[700260121]},{"nodeId":700260121,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":4208404378,"text":"If you should encounter any particularly pernicious dangers along the way, you can return to ask for help. There's no need to obsess over completing this investigation.","nextNodeIds":[700260122]},{"nodeId":700260122,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":126474210,"text":"Ah, yes. By the way, the person who posted this commission appears to be a researcher from the Sumeru Akademiya. He originally intended to investigate the weather on Tsurumi Island, but ran into some problems during the research process.","nextNodeIds":[700260123]},{"nodeId":700260123,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2818077650,"text":"That's why he posted this commission. If I'm not mistaken, he has forked out the lion's share of his research grant, so the rewards should be quite sizable...","nextNodeIds":[700260124,700260125]},{"nodeId":700260124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3451496362,"text":"I'll take it.","nextNodeIds":[700260126]},{"nodeId":700260126,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":57954714,"text":"Well then, thank you for your willingness to take up this commission. Allow me to show you where to begin.","nextNodeIds":[700260127]},{"nodeId":700260127,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3336453538,"text":"Please do stay safe as you investigate, however. I wish you all the best.","nextNodeIds":[700260128]},{"nodeId":700260128,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":1529998202,"text":"Ad astra abyssosque!","nextNodeIds":[]},{"nodeId":700260125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":166573538,"text":"Well, let's give this a go then, shall we?","nextNodeIds":[700260126]},{"nodeId":700260117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2153520050,"text":"Let me consider it...","nextNodeIds":[700260118]},{"nodeId":700260118,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":918068442,"text":"Are you worried that there might be unknown dangers along the way?","nextNodeIds":[700260119]},{"nodeId":700260119,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":1465446474,"text":"To be honest, some adventurers did reject this commission on that account as well...","nextNodeIds":[700260120]},{"nodeId":700260105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4120909754,"text":"Alright then, so, what's the job?","nextNodeIds":[700260106]},{"nodeId":700260106,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":307865162,"text":"Haha, you are as direct as they say.","nextNodeIds":[700260107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7002602,"order":2,"stepDescription":"Go to the designated location to investigate","stepDescTextMapHash":3157983804,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002602,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q70026MonsterPos","35"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002602,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q70026MonsterPos","35"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7002603,"order":3,"stepDescription":"Report back to Katheryne","stepDescTextMapHash":3727446540,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7002602],"talks":[{"talkId":7002602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7002603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7002602,"initDialog":700260201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3004],"performCfg":"","priority":5,"questId":70026,"showRandomTalkCount":0},"dialogs":[{"nodeId":700260201,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3431227122,"text":"Welcome back, Traveler. What did you find?","nextNodeIds":[700260202]},{"nodeId":700260202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2936661754,"text":"So, we met this Ruin Grader that won't stay dead...","nextNodeIds":[700260203]},{"nodeId":700260203,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3754340770,"text":"A strange Ruin Grader that keeps getting back up no matter how many times it is brought down... The person who commissioned this quest didn't say a thing about this.","nextNodeIds":[700260204]},{"nodeId":700260204,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":177902538,"text":"No wonder that previous adventurer looked so upset. They must've been stumped by that strange Ruin Grader.","nextNodeIds":[700260205]},{"nodeId":700260205,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2020034786,"text":"...We should really be informed of such things ahead of time...","nextNodeIds":[700260206]},{"nodeId":700260206,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":1002645442,"text":"I'm sure that I reminded Mr. Hosseini that he should be honest and clear when stating the details of the commission. How could he do something like this?","nextNodeIds":[700260207]},{"nodeId":700260207,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":1700503874,"text":"Unclear wording, missing content, it seems that more and more people are writing commissions this way. How are we supposed to give adventurers work like this? Seriously...","nextNodeIds":[700260208,700260210]},{"nodeId":700260208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1419610002,"text":"Sounds like it's been rough for you...","nextNodeIds":[700260209]},{"nodeId":700260209,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":241522106,"text":"I'm alright, at least. I just wish that the people posting commissions would communicate their needs to the Guild more clearly.","nextNodeIds":[700260212]},{"nodeId":700260212,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":261952890,"text":"...My apologies, I spoke out of turn.","nextNodeIds":[700260213]},{"nodeId":700260213,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3284734554,"text":"Regardless, I believe that the best and least costly way to solve this is to make contact with the person who submitted this commission directly and explain the situation with the reviving Ruin Grader to him.","nextNodeIds":[700260214]},{"nodeId":700260214,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":229403682,"text":"We shall see if he can accept the investigation results as they are and, if he believes that we can continue investigating, whether he has any way of solving the problem or not.","nextNodeIds":[700260215]},{"nodeId":700260215,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3245387994,"text":"All I can do is record matters as best as I can. If this commission is to continue, I will do my best to support you all the same.","nextNodeIds":[700260216]},{"nodeId":700260216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1911694434,"text":"Got it.","nextNodeIds":[700260217]},{"nodeId":700260217,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2812604850,"text":"In that case, I leave the matter of contacting Mr. Hosseini to you.","nextNodeIds":[]},{"nodeId":700260210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3961504978,"text":"This is part of the whole adventuring process, isn't it?","nextNodeIds":[700260211]},{"nodeId":700260211,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2522880826,"text":"Well, so is my serving as the intermediary between the guild and the people who post our commissions.","nextNodeIds":[700260212]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7002604,"order":4,"stepDescription":"Ask Hosseini some questions","stepDescTextMapHash":3568777444,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7002603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30068"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7002603],"talks":[{"talkId":7002603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7002604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7002603,"initDialog":700260301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30068],"performCfg":"","priority":5,"questId":70026,"showRandomTalkCount":0},"dialogs":[{"nodeId":700260301,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1477100058,"text":"My research on Tsurumi Island...","nextNodeIds":[700260302,700260303]},{"nodeId":700260302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4127745602,"text":"Well hello there.","nextNodeIds":[700260304]},{"nodeId":700260304,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1522189042,"text":"Ahh, I just received a status report from the Adventurers' Guild, and was just wondering if the one who had taken the commission up was you. So it was!","nextNodeIds":[700260305]},{"nodeId":700260305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1894763482,"text":"This investigation commission...","nextNodeIds":[700260306]},{"nodeId":700260306,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":714902730,"text":"*sigh* I know what you're going to say. Miss Katheryne was just haranguing me back there. I told her that I now understand the situation... More or less.","nextNodeIds":[700260307]},{"nodeId":700260307,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3124578682,"text":"Would it be correct to say that you encountered a Ruin Grader with regenerative powers at the investigation area?","nextNodeIds":[700260308,700260309]},{"nodeId":700260308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":73155682,"text":"That's right.","nextNodeIds":[700260310]},{"nodeId":700260310,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2061984922,"text":"Well, I have seen that Ruin Grader, but I didn't know that it could revive itself.","nextNodeIds":[700260311]},{"nodeId":700260311,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2577803066,"text":"When I came to Inazuma, I was fascinated by the ever-foggy Tsurumi Island. I even went to investigate it personally.","nextNodeIds":[700260312]},{"nodeId":700260312,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2930013930,"text":"The mysterious fog that lies over the island is fertile ground for research. However, each one of my attempts to go deeper into the island have ended in abject failure. I haven't made any progress at all...","nextNodeIds":[700260313]},{"nodeId":700260313,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1277858290,"text":"It was just as I was thinking on this that I discovered an island that was not shrouded in fog, and that Ruin Grader.","nextNodeIds":[700260314]},{"nodeId":700260314,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1990854874,"text":"However, I wasn't sufficiently prepared for such an encounter, so I had to leave in a hurry soon after coming ashore on that island. So, though I did see that Ruin Grader, I didn't get a good look at it.","nextNodeIds":[700260315]},{"nodeId":700260315,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":607457762,"text":"I didn't mean to deceive anyone, and honestly, encountering unknown circumstances is part of both research and adventuring, is it not?","nextNodeIds":[700260316]},{"nodeId":700260316,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":95790042,"text":"That said, I did give it some thought, and as it turns out, I do have some idea as to what might have happened here.","nextNodeIds":[700260317]},{"nodeId":700260317,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1010475378,"text":"Here's my hypothesis: I believe this Ruin Grader to have some kind of self-repair module built into it. It should also have some kind of external power source that allows it to function normally.","nextNodeIds":[700260318]},{"nodeId":700260318,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3759627978,"text":"It is significantly more advanced than the usual Ruin Graders you'll meet. We could consider it a special anomalous model, even!","nextNodeIds":[700260319]},{"nodeId":700260319,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1554418906,"text":"Ruin Graders are autonomous machines powered by Chaos Cores. Once these cores are damaged, the machines will lose the ability to move on their own power.","nextNodeIds":[700260320]},{"nodeId":700260320,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":551573850,"text":"But this anomalous model is different. Its power comes from an external source, which I strongly believe might be the ley lines.","nextNodeIds":[700260321]},{"nodeId":700260321,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":199554466,"text":"I do have some experience in the study of how ancient civilizations utilized energy. According to the texts, there were once machines that could function in perpetuity.","nextNodeIds":[700260322]},{"nodeId":700260322,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2176490546,"text":"If such records are reliable, this special Ruin Grader could have been an important product of the ancients' research into energy.","nextNodeIds":[700260323]},{"nodeId":700260323,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1782085330,"text":"We need to stop it somehow and conduct detailed research into its inner workings.","nextNodeIds":[700260324]},{"nodeId":700260324,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2392979786,"text":"Any ideas?","nextNodeIds":[700260325]},{"nodeId":700260325,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3149479306,"text":"Well, we have about... three solutions, I think. Two of which have rather slim odds of working out.","nextNodeIds":[700260326]},{"nodeId":700260326,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1757794834,"text":"Let me think... Ah! Right! This'll do.","nextNodeIds":[700260327]},{"nodeId":700260327,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":849959114,"text":"Before coming to Inazuma, I did arrange to have a few relics shipped along to serve as research material on a few new topics.","nextNodeIds":[700260328]},{"nodeId":700260328,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3871460810,"text":"Not long before you came over, my countrymen managed to get them delivered to me.","nextNodeIds":[700260329]},{"nodeId":700260329,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3939313130,"text":"Among them are a few ancient tools known as Pursina's Spikes. In theory, they can be used to disrupt the flow of ley line energies, which can be used to cut the flow of power to this anomalous Ruin Grader model.","nextNodeIds":[700260330]},{"nodeId":700260330,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":394319922,"text":"Unfortunately, this set of Pursina's Spikes seems a little faulty at the moment. The result of a bumpy voyage, perhaps.","nextNodeIds":[700260331,700260332]},{"nodeId":700260331,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3413234986,"text":"And our solution to this new problem?","nextNodeIds":[700260333]},{"nodeId":700260333,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2289318538,"text":"Oh, come on, unforeseen circumstances are part and parcel of research, aren't they? We just need to, uh, get used to them...","nextNodeIds":[700260334]},{"nodeId":700260334,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3855881746,"text":"So I was thinking, since we both need those Spikes, we can team up to get them repaired.","nextNodeIds":[700260335,700260338]},{"nodeId":700260335,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1449602514,"text":"You know what? I feel used.","nextNodeIds":[700260336]},{"nodeId":700260336,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2484071514,"text":"Come now, don't say that. Let's call it an \"alignment of objectives\" instead, shall we?","nextNodeIds":[700260337]},{"nodeId":700260337,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3758241770,"text":"Anyway, I will not do you harm for my own benefit. I will not drag the Akademiya's good name through the mud.","nextNodeIds":[700260341]},{"nodeId":700260341,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3771607634,"text":"Alright, I'll have faith.","nextNodeIds":[700260342]},{"nodeId":700260342,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":4223237378,"text":"Wonderful! Here's to our partnership, then.","nextNodeIds":[700260343]},{"nodeId":700260343,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3552130802,"text":"The key difficulty in maintaining Pursina's Spikes lies in the specific materials used in its components, which makes them quite difficult to mass-produce.","nextNodeIds":[700260344]},{"nodeId":700260344,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":1095378778,"text":"Usually, we just cannibalize identical parts from other old relics to repair them.","nextNodeIds":[700260345]},{"nodeId":700260345,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2911113730,"text":"Fortunately, these components are rather common in ancient relics. In fact, you could probably find them wherever such artifacts may be found.","nextNodeIds":[700260346]},{"nodeId":700260346,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3965089442,"text":"Of course, you need not worry about not being able to find those ancient relics. We do, after all, have a handy tool to improve the efficiency of our search.","nextNodeIds":[700260347]},{"nodeId":700260347,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":3266122818,"text":"This device here is known as Ayesha's Chaos Prospector. The details of how it works can be quite complicated, so I shan't elaborate here.","nextNodeIds":[700260348]},{"nodeId":700260348,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":4157158402,"text":"In sum, Ayesha's Chaos Prospector will notify you when you have discovered an ancient relic or a ley line energy distortion with... pretty decent accuracy, really.","nextNodeIds":[700260349]},{"nodeId":700260349,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":395974794,"text":"Our most urgent task at the moment is to use it to find components hidden deep underground. Once we've found enough components, the maintenance process can begin.","nextNodeIds":[700260350]},{"nodeId":700260350,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2589068322,"text":"This collection work will take several days, but we do need to have patience and to proceed steadily.","nextNodeIds":[700260351]},{"nodeId":700260351,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":2208283802,"text":"Alright then. If you understand what we need to do, then try putting this glorious machine to work!","nextNodeIds":[]},{"nodeId":700260338,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1973776986,"text":"Are you sure the Spikes will work?","nextNodeIds":[700260339]},{"nodeId":700260339,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":977181258,"text":"Well, I've never actually used Pursina's Spikes before, but their basic principles have been rigorously proven. Things should not go wrong — in theory.","nextNodeIds":[700260340]},{"nodeId":700260340,"roleType":"TALK_ROLE_NPC","speakerId":30068,"speakerName":"Hosseini","textMapHash":857193266,"text":"Even if you do not believe in me, have faith in the power of science!","nextNodeIds":[700260341]},{"nodeId":700260332,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":117485570,"text":"...","nextNodeIds":[700260333]},{"nodeId":700260309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2137740554,"text":"And you know nothing about that?","nextNodeIds":[700260310]},{"nodeId":700260303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2695821978,"text":"We meet again.","nextNodeIds":[700260304]}]}],"condi