NE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5042"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7465001],"talks":[{"talkId":7465001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7465001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7465001,"initDialog":746500101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5042],"performCfg":"","priority":8,"questId":74650,"showRandomTalkCount":0},"dialogs":[{"nodeId":746500101,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":2531209770,"text":"Truly spectacular weather today, no?","nextNodeIds":[746500102,746500103]},{"nodeId":746500102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3909015186,"text":"Yes, truly...","nextNodeIds":[746500104]},{"nodeId":746500104,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":4006038986,"text":"If only the weather was this cooperative every workday, I should be quite merry indeed.","nextNodeIds":[746500105]},{"nodeId":746500105,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":4189794802,"text":"And speaking of work, my dear, you are here to interview for the \"troubleshooter\" position advertised in our \"Tales of Humanity\" section, are you not?","nextNodeIds":[746500106,746500108]},{"nodeId":746500106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":250106234,"text":"I am.","nextNodeIds":[746500107]},{"nodeId":746500107,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":1366497866,"text":"Excellent. You didn't ask any questions about the title \"troubleshooter\" and thus it can be surmised that Ethan's word choice, while eccentric, is simple and easy to understand.","nextNodeIds":[746500111]},{"nodeId":746500111,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":4031154738,"text":"Putting that aside for the moment, would you like to know how I was able to correctly ascertain that you were here for the job, and not seeking to ask for help in our \"Tales of Humanity\" section?","nextNodeIds":[746500112]},{"nodeId":746500112,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":2171260306,"text":"Observation. Every citizen who comes to The Steambird seeking help appears anxious and jittery, but you... Your steps are relaxed, your expression calm.","nextNodeIds":[746500113]},{"nodeId":746500113,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":4248242490,"text":"*sigh* Those who are fortunate are all the same, those who fall victim to misfortune all have their own woes.","nextNodeIds":[746500114]},{"nodeId":746500114,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":3359886218,"text":"But you needn't worry. Those who seek assistance from others via \"Tales of Humanity\" haven't run into any serious trouble, so it shouldn't be hard to handle.","nextNodeIds":[746500115]},{"nodeId":746500115,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":997661818,"text":"Have a look at this batch of commissions... *sigh*","nextNodeIds":[]},{"nodeId":746500108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":745608938,"text":"\"Troubleshooter\"...?","nextNodeIds":[746500109]},{"nodeId":746500109,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":1141075938,"text":"Yes, yes, I know. The name \"troubleshooter\" is simply too gauche and unbecoming of the standards of a publication such as ours.","nextNodeIds":[746500110]},{"nodeId":746500110,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":3425079714,"text":"Yes... Ethan has substantial room for growth when it comes to coining new words.","nextNodeIds":[746500111]},{"nodeId":746500103,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"Euphrasie","textMapHash":3911430682,"text":"Quite comfortable.","nextNodeIds":[746500104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7465001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActi