nextTalks":[],"npcId":[21844],"performCfg":"QuestDialogue/EQ/V58Resort_15048/Q1504801","priority":5,"questId":15048,"showRandomTalkCount":0},"dialogs":[{"nodeId":150480101,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":650239034,"text":"...I'm sorry, but we can't let you take that risk.","nextNodeIds":[150480102]},{"nodeId":150480102,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3371581626,"text":"But that's not what you said earlier...","nextNodeIds":[150480103]},{"nodeId":150480103,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":4268194410,"text":"Our sincerest apologies. We may be pressed for time, but the safety of our visitors has to come first. We hope you understand.","nextNodeIds":[150480104]},{"nodeId":150480104,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":1371115922,"text":"#Oh, {NICKNAME}! Perfect timing! Could you help me talk this gentleman around?","nextNodeIds":[150480105]},{"nodeId":150480105,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":2139501642,"text":"They need someone for the testing, so I went over all my adventuring experience, made it clear I was willing to accept any risks... It was all going so well...","nextNodeIds":[150480106]},{"nodeId":150480106,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":1085028674,"text":"But the minute I mentioned some of the close calls I've had in the past, he flat-out refused to let me take part.","nextNodeIds":[150480107]},{"nodeId":150480107,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":3923326802,"text":"Sir, I appreciate your enthusiasm, I truly do.","nextNodeIds":[150480108]},{"nodeId":150480108,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":4245006978,"text":"But if you, in your own words, have a tendency to fall into rivers even when you're crossing a bridge made of solid stone, it might be better to try something a little more... laid-back? Like, lounging on one of those beach chairs over there.","nextNodeIds":[150480109]},{"nodeId":150480109,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":1254886362,"text":"*sigh* But... I really am an adventurer, and I'm qualified for the testing too! I've just... had some bad luck in the past, that's all...","nextNodeIds":[150480110]},{"nodeId":150480110,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3146663786,"text":"I really want to help. You can count on me, I swear!","nextNodeIds":[150480111,150480112]},{"nodeId":150480111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2229422794,"text":"I can vouch for him.","nextNodeIds":[150480113]},{"nodeId":150480113,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":2581691002,"text":"Well, if the savior of Natlan says so... How about this — would it be alright if your Asha companion completed the first round of testing instead?","nextNodeIds":[150480114]},{"nodeId":150480114,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":194520026,"text":"You can watch from the sidelines, familiarize yourself with the route, and if everything goes smoothly, you can join the second round of testing.","nextNodeIds":[150480115]},{"nodeId":150480115,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3854213906,"text":"Does that sound good to you, buddy?","nextNodeIds":[150480116]},{"nodeId":150480116,"roleType":"TALK_ROLE_NPC","speakerId":21856,"speakerName":"Asha","textMapHash":2322617290,"text":"♪","nextNodeIds":[150480117]},{"nodeId":150480117,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":1625670082,"text":"Alright then! I'll leave it to you, partner!","nextNodeIds":[]},{"nodeId":150480112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1988200194,"text":"He has my full confidence.","nextNodeIds":[150480113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1504801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21844"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1504802,"order":3,"stepDescription":"Help the Asha reach the destination","stepDescTextMapHash":2095328372,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q150480201"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["133521003","3104","614.5594:200.4555:14646.54"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_GADGET"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q150480201"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133521003","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJO