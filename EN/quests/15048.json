e,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1504808","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1504808,"initDialog":150480801,"nextRandomTalks":[],"nextTalks":[],"npcId":[21844],"performCfg":"QuestDialogue/EQ/V58Resort_15048/Q1504808","priority":5,"questId":15048,"showRandomTalkCount":0},"dialogs":[{"nodeId":150480801,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3241587818,"text":"Whew, my heart's racing so fast... Gotta take a while to catch my breath...","nextNodeIds":[150480802]},{"nodeId":150480802,"roleType":"TALK_ROLE_NPC","speakerId":21856,"speakerName":"Asha","textMapHash":1031135850,"text":"♪","nextNodeIds":[150480803]},{"nodeId":150480803,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2662218938,"text":"Let's give it up for Bennett and his Asha buddy! You guys make such a great team!","nextNodeIds":[150480804]},{"nodeId":150480804,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3898746594,"text":"Especially the way you worked together at the end. Your special bond made all the difference!","nextNodeIds":[150480805]},{"nodeId":150480805,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":257270610,"text":"You turned the tide of misfortune together.","nextNodeIds":[150480806]},{"nodeId":150480806,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3583693778,"text":"We sure did!","nextNodeIds":[150480807]},{"nodeId":150480807,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":1657302906,"text":"#I owe a big thanks to you in particular, {NICKNAME}.","nextNodeIds":[150480808]},{"nodeId":150480808,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":2356583826,"text":"If you hadn't believed in me and helped convince the staff, I never would have had the chance to even compete in the challenge, let alone face it alongside our Asha friend...","nextNodeIds":[150480809]},{"nodeId":150480809,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":3733968314,"text":"Mr. Bennett, the final safety test has been completed, which means that Asha Speedrun is now officially ready to open. Your help was much appreciated!","nextNodeIds":[150480810]},{"nodeId":150480810,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":621283274,"text":"Did you hear that, Asha? We did it!","nextNodeIds":[150480811]},{"nodeId":150480811,"roleType":"TALK_ROLE_NPC","speakerId":21871,"speakerName":"Gaun","textMapHash":2984803450,"text":"I'll remember your name, Mr. Bennett — the brave and kind-hearted adventurer.","nextNodeIds":[150480812]},{"nodeId":150480812,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":1390353418,"text":"I know this adventure isn't over yet, but just the idea of saying goodbye is getting harder and harder to bear...","nextNodeIds":[150480813]},{"nodeId":150480813,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":246263370,"text":"Asha, I'm really gonna miss you.","nextNodeIds":[150480814]},{"nodeId":150480814,"roleType":"TALK_ROLE_NPC","speakerId":21856,"speakerName":"Asha","textMapHash":1169436290,"text":"...","nextNodeIds":[150480815]},{"nodeId":150480815,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3646411170,"text":"Hehe, hey... If anything, I should be the one doing the comforting here! As the leader of this Adventure Team, it's my job to look after you.","nextNodeIds":[150480816]},{"nodeId":150480816,"roleType":"TALK_ROLE_NPC","speakerId":21856,"speakerName":"Asha","textMapHash":3840193314,"text":"...","nextNodeIds":[150480817]},{"nodeId":150480817,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3691061778,"text":"Huh, something must've gotten in my eyes out there... Getting a bit watery, haha... Got a bit of a lump in my throat too...","nextNodeIds":[150480818]},{"nodeId":150480818,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":3197430666,"text":"I'll have to ask Professor Venti how to express my feelings in moments like this. After all, he's the best poet I know...","nextNodeIds":[150480819]},{"nodeId":150480819,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2292308770,"text":"Tone-Deaf Bard would just say something like...","nextNodeIds":[150480820]},{"nodeId":150480820,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":152304314,"text":"Speak from the heart.","nextNodeIds":[150480821]},{"nodeId":150480821,"roleType":"TALK_ROLE_NPC","speakerId":21844,"speakerName":"Bennett","textMapHash":989257154,"text":"It really means a lot to have you here by my side... Thank you, Asha.","nextNodeIds":[150480822]},{"nodeId":150480822,"roleType":"TALK_ROLE_NPC","speakerId":21856,"speakerName":"Asha","textMapHash":492295514,"text":"...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1504808,0],"PA