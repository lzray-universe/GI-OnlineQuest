{"mainQuestId":74138,"title":"Radiant Harvest: Compensation","description":"The deadline for retrieving the Violetglow Jellyfish is nearing. It's time to check in on how Kesean's doing...","titleTextMapHash":2665133079,"descTextMapHash":3434932926,"mainQuestExcel":{"mainQuestId":74138,"titleTextMapHash":2665133079,"title":"Radiant Harvest: Compensation","descTextMapHash":3434932926,"description":"The deadline for retrieving the Violetglow Jellyfish is nearing. It's time to check in on how Kesean's doing...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5157,"luaPath":"Actor/Quest/WQ74138","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5157,"chapterId":0,"descTextMapHash":3434932926,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74138,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3574175665,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74138","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174138],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2665133079,"type":"WQ","unlockDescTextMapHash":1637781934}},"flow":[{"subQuestId":7413801,"order":1,"stepDescription":"Talk to Kesean","stepDescTextMapHash":1457782468,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7413801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30420"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7413801],"talks":[{"talkId":7413801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7413801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7413801,"initDialog":741380101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30420],"performCfg":"QuestDialogue/WQ/Fontaine_74137/Q7413801","priority":5,"questId":74138,"showRandomTalkCount":0},"dialogs":[{"nodeId":741380101,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3464842834,"text":"Hey! You're back. You missed out on something hilarious just now!","nextNodeIds":[741380102]},{"nodeId":741380102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3263590930,"text":"Something hilarious? What happened?","nextNodeIds":[741380103]},{"nodeId":741380103,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":4212470290,"text":"Just now, I brought the retrieved jellyfish and waited here for Mr. Augereau's inspection. But before he could show up, some of my buyers did.","nextNodeIds":[741380104]},{"nodeId":741380104,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3118497034,"text":"They told me that ever since releasing the first several batches of jellyfish, they felt refreshed, and their business has been going super well. They thought it must have been a blessing from the heavens for doing a good deed! So they came back to buy more to release.","nextNodeIds":[741380105,741380106]},{"nodeId":741380105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3496991602,"text":"I'm still trying to catch them for you...","nextNodeIds":[741380107]},{"nodeId":741380107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":889669386,"text":"#Hmm... {NICKNAME} catches them, Mr. Kesean sells them, and buyers release them again... Hey! Is this your way of making money!?","nextNodeIds":[741380108]},{"nodeId":741380108,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":313819514,"text":"What!? No! How could I!? I don't want any more trouble with the Gardes!","nextNodeIds":[741380109]},{"nodeId":741380109,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":539557794,"text":"Ahem... I spent ages telling them that releasing these jellyfish does more harm than good, but they simply wouldn't listen!","nextNodeIds":[741380110]},{"nodeId":741380110,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":2283402330,"text":"They just believe that their luck was due to... what they consider to be a good deed.","nextNodeIds":[741380111]},{"nodeId":741380111,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":976104498,"text":"They even believe that my bad luck was due to keeping the jellyfish in captivity. *sigh* Just what are they thinking...","nextNodeIds":[741380112]},{"nodeId":741380112,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":844641186,"text":"Anyway, while we argued, Mr. Augereau arrived and immediately took them into custody.","nextNodeIds":[741380113,741380114]},{"nodeId":741380113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3765693442,"text":"Guess their luck had run out.","nextNodeIds":[741380115]},{"nodeId":741380115,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1233487562,"text":"...In the end, was carelessly releasing these creatures without first understanding their habits and ecology really for the creatures, or just for their own good luck?","nextNodeIds":[741380116]},{"nodeId":741380116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1857900306,"text":"They were also taken into custody by the Gardes... Seems like they didn't get much luck out of it in the end.","nextNodeIds":[741380117]},{"nodeId":741380117,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3324853034,"text":"Ha! Speaking of which, thanks to you, the Gardes have now waived my jail sentence.","nextNodeIds":[741380118]},{"nodeId":741380118,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":814795066,"text":"In addition to the compensation I promised you, I also have a little memento for you. Please, take it.","nextNodeIds":[741380119]},{"nodeId":741380119,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1979312554,"text":"Kesean takes out a jellyfish ball...","nextNodeIds":[741380120]},{"nodeId":741380120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3791836258,"text":"Ehh?? Are these... also Violetglow Jellyfish? Why do they look so much smaller than the ones we caught before...","nextNodeIds":[741380121]},{"nodeId":741380121,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1250001922,"text":"Yep, they are smaller specimens. I picked out a few suitable specimens from the storage warehouse yesterday. There were more specimens than there were assignment numbers, though, so I figured I might as well give you some as a memento.","nextNodeIds":[741380122]},{"nodeId":741380122,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":802069178,"text":"As for the rest, I'll continue breeding them and find a way to integrate them into natural environments.","nextNodeIds":[741380123]},{"nodeId":741380123,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":3545146458,"text":"Oh, and I'm also planning on keeping a few of the Violetglow Jellyfish to investigate their clustering and glowing behavior.","nextNodeIds":[741380124,741380125]},{"nodeId":741380124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4060702082,"text":"Well, they do look pretty cute...","nextNodeIds":[741380126]},{"nodeId":741380126,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","textMapHash":1134987402,"text":"W—Woah, wait! Don't you dare to think about releasing them!!!","nextNodeIds":[]},{"nodeId":741380125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2544120890,"text":"I think they would look cuter swimming in the water...","nextNodeIds":[741380126]},{"nodeId":741380114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3056902666,"text":"You reap what you sow.","nextNodeIds":[741380115]},{"nodeId":741380106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3907562594,"text":"How are you still selling them...","nextNodeIds":[741380107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7413801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30420"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7413801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"Kesean","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174138],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3434932926,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__Backing