72/Q7907201","priority":5,"questId":79072,"showRandomTalkCount":0},"dialogs":[{"nodeId":790720101,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":4116855594,"text":"#Oh my, what an honor. You must be {NICKNAME}, in which case, the one by your side must be your companion, Ms. Paimon.","nextNodeIds":[790720102]},{"nodeId":790720102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3413026634,"text":"Hehe, right in one! That's us!","nextNodeIds":[790720103]},{"nodeId":790720103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1492437218,"text":"We're that famous, are we?","nextNodeIds":[790720104]},{"nodeId":790720104,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":2627571122,"text":"News travels quickly to, from, and through Constellation Metropole.","nextNodeIds":[790720105]},{"nodeId":790720105,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":3676521730,"text":"I must say that you're right on time — I was just putting the finishing touches on this game of mine, named \"Flying Hats.\"","nextNodeIds":[790720106]},{"nodeId":790720106,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":3349864474,"text":"I can't be like the eponymous hatter in the \"Flying Hatter,\" who gave everyone a lovely hat, I fear...","nextNodeIds":[790720107]},{"nodeId":790720107,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":2670157754,"text":"But I believe that \"Flying Hats\" will bring joy to those who play it.","nextNodeIds":[790720108]},{"nodeId":790720108,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":3456434530,"text":"I've also designed three completely different gameplay modes for it... Don't worry, don't worry, the rules aren't too complicated!","nextNodeIds":[790720109]},{"nodeId":790720109,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":518379210,"text":"You'll figure it out after just one game, I guarantee it.","nextNodeIds":[790720110,790720112]},{"nodeId":790720110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4151709098,"text":"I'll give it a try!","nextNodeIds":[790720111]},{"nodeId":790720111,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":2199681482,"text":"Alrighty-righty then. This way, please.","nextNodeIds":[]},{"nodeId":790720112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1427510746,"text":"I'm busy right now...","nextNodeIds":[790720113]},{"nodeId":790720113,"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","textMapHash":2699035626,"text":"Oh, it's quite alright. Just come find me whenever you've got the time. I'll be staying here for time being.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7907201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30603"],"NOCCOBOFKHP":100,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7907201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30603,"speakerName":"Devitt","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[179072],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO"