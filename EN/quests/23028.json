aram":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2302804,"initDialog":230280401,"nextRandomTalks":[],"nextTalks":[],"npcId":[12901,4178],"performCfg":"QuestDialogue/IQ/Sumeru_23028/Q2302804","priority":5,"questId":23028,"showRandomTalkCount":0},"dialogs":[{"nodeId":230280401,"roleType":"TALK_ROLE_NPC","speakerId":12901,"speakerName":"Awan","textMapHash":1449546186,"text":"Yasmin? What are you doing here? Ugh... Are you here to sprinkle your potion again?","nextNodeIds":[230280402]},{"nodeId":230280402,"roleType":"TALK_ROLE_NPC","speakerId":12901,"speakerName":"Awan","textMapHash":652781538,"text":"Those roots look perfectly fine. No more potions are needed here.","nextNodeIds":[230280403]},{"nodeId":230280403,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1279265386,"text":"Even so, we should take good care of them.","nextNodeIds":[230280404]},{"nodeId":230280404,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":3884732522,"text":"Crossing the bridge only when we get to it is like getting a Fish Roll ready, only to realize that the fish is undercooked.","nextNodeIds":[230280405]},{"nodeId":230280405,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":27458050,"text":"At that point, your options are either to start all over again or to open up the already rolled pastry, both of which are a pain in the neck.","nextNodeIds":[230280406]},{"nodeId":230280406,"roleType":"TALK_ROLE_NPC","speakerId":12901,"speakerName":"Awan","textMapHash":3408367538,"text":"Okay, okay, I can't beat you in an argument... But I have talked to you about the smell of that potion, right?","nextNodeIds":[230280407]},{"nodeId":230280407,"roleType":"TALK_ROLE_NPC","speakerId":12901,"speakerName":"Awan","textMapHash":247443810,"text":"I live nearby, and I don't want to sleep with that funky smell in my nostrils, alright?","nextNodeIds":[230280408]},{"nodeId":230280408,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2023333514,"text":"Don't worry, I already had Ladep adjust the formula. The odor shouldn't be too offensive.","nextNodeIds":[230280409]},{"nodeId":230280409,"roleType":"TALK_ROLE_NPC","speakerId":12901,"speakerName":"Awan","textMapHash":879551554,"text":"Fine then, I'm leaving. Don't come sprinkling that potion of yours near my yard. I can't take it...","nextNodeIds":[230280410]},{"nodeId":230280410,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2030028346,"text":"Alright, I get it. Traveler, could you pass me the potions in that case?","nextNodeIds":[230280411]},{"nodeId":230280411,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2393756378,"text":"You administer the potions with Yasmin...","nextNodeIds":[230280412]},{"nodeId":230280412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1540098042,"text":"The potions really do smell terrible...","nextNodeIds":[230280413]},{"nodeId":230280413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4225319330,"text":"But it seems that you're not bothered by it at all, Yasmin...","nextNodeIds":[230280414]},{"nodeId":230280414,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2094254698,"text":"If you mean the smell... My nose has whiffed many things far worse than that.","nextNodeIds":[230280415]},{"nodeId":230280415,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2338238754,"text":"Alright, that should be all we need. I have also gathered some data. I'm sure Pharez will be thrilled...","nextNodeIds":[230280416]},{"nodeId":230280416,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2890466034,"text":"Here is your payment, Traveler. Thank you for your help so far.","nextNodeIds":[230280417]},{"nodeId":230280417,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1419118730,"text":"I wonder how Ladep and Pharez are doing with their work...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2302804,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["42031","0"],"PAINLIBBLDK":"QUEST_EXEC_INC_DAILY_TASK_VAR"},{"LNHLPKELCAL":["2302801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["42031"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2302803_guide","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":12691,"speakerName":"","textMapHash":4051138690,"text":"(I should be able to return a little later today...)"},{"roleType":"TALK_ROLE_NPC","speakerId":12691,"speakerName":"","textMapHash":2069642978,"text":"(Eek! Not again!?)"},{"roleType":"TALK_ROLE_NPC","speakerId":12692,"speakerName":"","textMapHash":1390218674,"text":"(I should be able to return a little later today...)"},{"roleType":"TALK_ROLE_NPC","speakerId":12692,"speakerName":"","textMapHash":206456362,"text":"(Eek! Not again!?)"},{"roleType":"