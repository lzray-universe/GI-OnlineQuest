ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2935296698,"text":"Traveler! Thank goodness you're here. I was just in need of someone's help!","nextNodeIds":[230280102]},{"nodeId":230280102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3400942810,"text":"Is there anything wrong with the Divine Tree's roots?","nextNodeIds":[230280103]},{"nodeId":230280103,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2054873946,"text":"Oh, the Divine Tree is perfectly fine.","nextNodeIds":[230280104]},{"nodeId":230280104,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":134242962,"text":"And my job here is to keep it that way.","nextNodeIds":[230280105]},{"nodeId":230280105,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1472217674,"text":"To be specific, I am sprinkling these potions around the tree's roots.","nextNodeIds":[230280106]},{"nodeId":230280106,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1347685122,"text":"Unfortunately, I can't move all these potions on my own, while Ladep and Pharez are busily engaged in their own work.","nextNodeIds":[230280107]},{"nodeId":230280107,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":1539052274,"text":"As such, I could really use your help in moving these potions.","nextNodeIds":[230280108,230280112]},{"nodeId":230280108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4016613242,"text":"Ladep and Pharez? Who are they, again?","nextNodeIds":[230280109]},{"nodeId":230280109,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":124142050,"text":"Oh, they are students, just like me. But Ladep is from Spantamad, and Pharez is from Kshahrewar.","nextNodeIds":[230280110]},{"nodeId":230280110,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2931449098,"text":"We are researching on a shared topic, thus the cooperation despite our different ideologies.","nextNodeIds":[230280111]},{"nodeId":230280111,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":3231599450,"text":"These potions, for example, are the fruits of our teamwork.","nextNodeIds":[230280113]},{"nodeId":230280113,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":164546858,"text":"Okay, I will carry this one, and I'll be counting on you for the rest. Thank you!","nextNodeIds":[230280114]},{"nodeId":230280114,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2180698578,"text":"Careful now. Ladep said the potions were intentionally made with a foul odor so that no one would drink them by accident.","nextNodeIds":[230280115]},{"nodeId":230280115,"roleType":"TALK_ROLE_NPC","speakerId":4178,"speakerName":"Yasmin","textMapHash":2004265506,"text":"Try not to get any on your clothes... The smell won't wash off easily at all.","nextNodeIds":[]},{"nodeId":230280112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4137388330,"text":"Well, let's go then.","nextNodeIds":[230280113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2302801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4178"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2302802,"order":2,"stepDescription":"Follow Yasmin","stepDescTextMapHash":1903351564,"finishConds":[{"BFGALAINLMD":0,