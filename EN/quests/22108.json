{"mainQuestId":22108,"title":"Where Is the Unseen Razor?","description":"Lan has been looking for a certain sword. Her search has not been fruitful, so she's decided to widen her search range.","titleTextMapHash":2670998161,"descTextMapHash":1198669775,"mainQuestExcel":{"mainQuestId":22108,"titleTextMapHash":2670998161,"title":"Where Is the Unseen Razor?","descTextMapHash":1198669775,"description":"Lan has been looking for a certain sword. Her search has not been fruitful, so she's decided to widen her search range.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":1198669775,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":22108,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4189893767,"LEFIHLHODBM":[],"luaPath":"","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":25000,"titleTextMapHash":2670998161,"type":"IQ","unlockDescTextMapHash":1780637115}},"flow":[{"subQuestId":2210801,"order":1,"stepDescription":"Talk to Lan","stepDescTextMapHash":1892024270,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2210801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2016"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2210801,2210802],"talks":[{"talkId":2210801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2210801","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2210801,"initDialog":221080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2016],"performCfg":"","priority":6,"questId":22108,"showRandomTalkCount":0},"dialogs":[{"nodeId":221080101,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":751499816,"text":"I hope it turns up this time... there are so few leads left...","nextNodeIds":[221080102]},{"nodeId":221080102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3245239152,"text":"What's wrong?","nextNodeIds":[221080103]},{"nodeId":221080103,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1674888408,"text":"What brings you here? If you'd like to learn more about the Guild, please talk to Katheryne over there.","nextNodeIds":[221080104]},{"nodeId":221080104,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1921799000,"text":"...Oh, you're an adventurer already? Please accept my apologies, I may be the Branch Master, but I am not well acquainted with the Guild's day-to-day business.","nextNodeIds":[221080105]},{"nodeId":221080105,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2307198920,"text":"So I don't really know any of the newcomers... Having said that, you're no newcomer at all, are you? You look like a seasoned adventurer to me.","nextNodeIds":[221080106]},{"nodeId":221080106,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1769189320,"text":"In which case, maybe there's something you can help me with. I must emphasize though, this is not a guild quest but a personal commission.","nextNodeIds":[221080107,221080108]},{"nodeId":221080107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3641021056,"text":"I'll take it!","nextNodeIds":[221080109]},{"nodeId":221080109,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2505647304,"text":"I appreciate your enthusiasm, but it is highly unwise to accept a commission without examining the details first.","nextNodeIds":[221080111]},{"nodeId":221080111,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2729329408,"text":"Your commission, should you choose to accept it, is to defeat two strong hilichurls who bear giant shields.","nextNodeIds":[221080112]},{"nodeId":221080112,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3353556096,"text":"Their shields are infused with Geo energy. Not terribly dangerous, but you should still proceed carefully.","nextNodeIds":[221080113]},{"nodeId":221080113,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3832435992,"text":"All I need you to do is defeat them. Come and find me afterwards and you will be fairly compensated.","nextNodeIds":[221080114]},{"nodeId":221080114,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2391398608,"text":"Oh, and if you come across anything sword-related, bring it back for me.","nextNodeIds":[221080115]},{"nodeId":221080115,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":940670304,"text":"If not, it doesn't matter. As long as you defeat the hilichurls you will receive your compensation. That's all. I will leave you to get ready now.","nextNodeIds":[]},{"nodeId":221080108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":348252480,"text":"Give me more details, and I'll consider it.","nextNodeIds":[221080110]},{"nodeId":221080110,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3579505000,"text":"A cautious response. I'm sure you learned the value of caution the hard way.","nextNodeIds":[221080111]}]},{"talkId":2210802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2210801","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2210802","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2210802,"initDialog":221080201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2016],"perfor