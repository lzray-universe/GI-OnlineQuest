LT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1102102],"talks":[{"talkId":1102102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1102102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1102102,"initDialog":110210201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/LQ/Zhongli1_11021/Q1102102","priority":0,"questId":11021,"showRandomTalkCount":0},"dialogs":[{"nodeId":110210201,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1932516010,"text":"This place looks so ordinary... Can we really find anything valuable here?","nextNodeIds":[110210202]},{"nodeId":110210202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3951727618,"text":"Huh? Paimon thinks it looks really grand!","nextNodeIds":[110210203]},{"nodeId":110210203,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":3183724730,"text":"I don't mean the scenery, but rather that there should be something out of the ordinary. A big battle did just occur and all... And I don't even know where to begin looking here.","nextNodeIds":[110210204]},{"nodeId":110210204,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":4116519866,"text":"Guyun Stone Forest is actually the perfect place to be if you wish to learn about the gods or the history of the Archon War.","nextNodeIds":[110210205]},{"nodeId":110210205,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3151631034,"text":"Legend has it that Rex Lapis threw spears made of large rock into the sea here, piercing and crushing the Overlord of the Vortex.","nextNodeIds":[110210206]},{"nodeId":110210206,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":542852538,"text":"After many years of wind erosion, those stone spears have turned into the unique rock formations we see now.","nextNodeIds":[110210207]},{"nodeId":110210207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2038723130,"text":"These mountains were the Lord of Geo's weapons?","nextNodeIds":[110210208]},{"nodeId":110210208,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3756370426,"text":"What we see now is just the part of them that remains. The stone spears hurled by Rex Lapis, all those years ago, were much greater, both in number and in size.","nextNodeIds":[110210209]},{"nodeId":110210209,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":4269042282,"text":"But due to the different angles they landed at, their large centers of mass, erosion by seawater, and years of gravity, many of them have been completely swallowed by the sea.","nextNodeIds":[110210210]},{"nodeId":110210210,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2212182146,"text":"So, besides wind erosion, the initial collapsing of the stone spears also played a big part in the formation of Guyun Stone Forest.","nextNodeIds":[110210211]},{"nodeId":110210211,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":3464431122,"text":"Well... A god able to fight one so powerful as Rex Lapis was certainly very strong in its own right.","nextNodeIds":[110210212]},{"nodeId":110210212,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":24856370,"text":"Indeed, this is where the value lies in research at Guyun Stone Forest.","nextNodeIds":[110210213]},{"nodeId":110210213,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1336851362,"text":"Most of the objects from that time were lost to the sea, but the gigantic waves created by the Overlord of the Vortex have given those sunken objects a chance to see the light of day again.","nextNodeIds":[110210214]},{"nodeId":110210214,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2617851850,"text":"So you're saying that if we look carefully, we'll be able to get very, very rich—","nextNodeIds":[110210215]},{"nodeId":110210215,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2731890370,"text":"Uh, I mean — rich with archaeological knowledge and historical value, yes? That's all I seek in life.","nextNodeIds":[110210216]},{"nodeId":110210216,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1066418874,"text":"Well, since we brought so many people, I think it would be best to split up and look.","nextNodeIds":[110210217]},{"nodeId":110210217,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3283177266,"text":"Okay then, I will go with my friend here. Although I have a smattering of knowledge in various disciplines, when it comes to archaeology, I can't compete with the expert here.","nextNodeIds":[110210218]},{"nodeId":110210218,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2293256794,"text":"Huh? M—Me?","nextNodeIds":[110210219]},{"nodeId":110210219,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":668081434,"text":"What's the matter? This is your profession, why are you so surprised?","nextNodeIds":[110210220]},{"nodeId":110210220,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":152628138,"text":"I get it... I'll escort him then.","nextNodeIds":[110210221]},{"nodeId":110210221,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3071319506,"text":"Okay. If we find anything valuable or rare, let's meet on the shore opposite from here.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1102107,"o