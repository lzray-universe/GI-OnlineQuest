de":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q11021Gadget3","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1102106,"order":9,"stepDescription":"Meet up with the other group","stepDescTextMapHash":2823042948,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10302"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1102106],"talks":[{"talkId":1102106,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1102106","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1102106,"initDialog":110210601,"nextRandomTalks":[],"nextTalks":[],"npcId":[10302],"performCfg":"QuestDialogue/LQ/Zhongli1_11021/Q1102106","priority":0,"questId":11021,"showRandomTalkCount":0},"dialogs":[{"nodeId":110210601,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2403684810,"text":"...You call yourself a scholar of archaeology? You can't even recognize this or that. What are you good for?","nextNodeIds":[110210602]},{"nodeId":110210602,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":878868610,"text":"We all have our areas of expertise! I already tried very hard to explain!","nextNodeIds":[110210603]},{"nodeId":110210603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1166815346,"text":"Stop arguing! What in the world happened?","nextNodeIds":[110210604]},{"nodeId":110210604,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1095796674,"text":"This girl just keeps bragging about how she's an archaeologist, but she doesn't even know anything about the surrounding ruins! I even know more than her!","nextNodeIds":[110210605]},{"nodeId":110210605,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":2496224882,"text":"She left me to rely solely on guessing — I mean, experience — to find anything valuable to take back. Ugh, what a waste of time!","nextNodeIds":[110210606]},{"nodeId":110210606,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":784727274,"text":"I—I've just been researching the God of Salt, so I'm not familiar with sea relics. Is that so strange!?","nextNodeIds":[110210607,110210608]},{"nodeId":110210607,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1310218650,"text":"(Hmm, it is a bit strange...)","nextNodeIds":[110210609]},{"nodeId":110210609,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2862223922,"text":"And you! You kept asking about how much Mora everything is worth! Can the value of relics only be measured in Mora!?","nextNodeIds":[110210610]},{"nodeId":110210610,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1203652282,"text":"Uh... I mean, isn't measuring their value in Mora the easiest way? This also matches the traditions of Liyue, does it not?","nextNodeIds":[110210611]},{"nodeId":110210611,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1108587418,"text":"Now, now, calm down, no need to make a fuss. We were able to bring back some intriguing objects. Let's have a look.","nextNodeIds":[110210612]},{"nodeId":110210612,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1630699610,"text":"Oh...","nextNodeIds":[110210613]},{"nodeId":110210613,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2762277594,"text":"What a shame. *sigh* These objects were indeed washed ashore by the Overlord of the Vortex, but they have nothing to do with the god besides being in the vicinity at the time.","nextNodeIds":[110210614]},{"nodeId":110210614,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":581767130,"text":"This stone slab we found, however, has a mysterious pattern and faint aura of divine power. Perhaps it will be useful for research purposes.","nextNodeIds":[110210615]},{"nodeId":110210615,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":299327490,"text":"Quick, give it to me!","nextNodeIds":[110210616]},{"nodeId":110210616,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1168564138,"text":"Hehe, at least we didn't come for nothing. The power of the gods, yes! This is good... heh.","nextNodeIds":[110210617]},{"nodeId":110210617,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1612883506,"text":"Oh, but these other objects are certainly worth a little something, right? It should be enough to cover the cost of hiring you — it's all mine!","nextNodeIds":[110210618]},{"nodeId":110210618,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2076002002,"text":"So... it's only valuable for research if there are remnants of divine power on it?","nextNodeIds":[110210619]},{"nodeId":110210619,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":3047457650,"text":"Not at all. My quest to uncover the history of the God of Salt is because history can tell us about culture and beliefs...","nextNodeIds":[110210620]},{"nodeId":110210620,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":55221762,"text":"But YOU... You're just trying to use archaeology to get rich!","nextNodeIds":[110210621]},{"nodeId":110210621,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":193017666,"text":"Nonsense! I'm a professional archaeology researcher from Snezhnaya, I swear. If I'm lying, may the Lord of Geo strike me down!","nextNodeIds":[110210622,110210623]},{"nodeId":110210622,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":521693394,"text":"(No, you're trying to get rich off archaeology...)","nextNodeIds":[110210624]},{"nodeId":110210624,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2679246882,"text":"Oh, by the way. You probably don't want to sell that teacup.","nextNodeIds":[110210625]},{"nodeId":110210625,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1562938802,"text":"Oh, why's that?","nextNodeIds":[110210626]},{"nodeId":110210626,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":4263407322,"text":"That's not an ancient teacup. It's part of Ningguang's collection, it must have fallen here along with the Jade Chamber. So unless you want to mess with the Qixing...","nextNodeIds":[110210627]},{"nodeId":110210627,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":243629898,"text":"Ah, I see... What a shame. It was of such high quality, too.","nextNodeIds":[110210628]},{"nodeId":110210628,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":4112530450,"text":"See!? You do want to sell these objects!","nextNodeIds":[110210629]},{"nodeId":110210629,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1308849010,"text":"S—So what! Why can't I pursue wealth both intellectual and material? Don't be so simple-minded!","nextNodeIds":[110210630]},{"nodeId":110210630,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":960620026,"text":"Alright then! No need to stay here any longer. Hm, I'm rather quite intrigued by the God of Salt too, actually. Let's go to Sal Terrae next.","nextNodeIds":[]},{"nodeId":110210623,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1946055594,"text":"(No, you're trying to collect the strength of the gods...)","nextNodeIds":[110210624]},{"nodeId":110210608,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1666986706,"text":"(One shouldn't lack general knowledge in their field...)","nextNodeIds":[110210609]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100627:1,100628:1,100629:1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM_BATCH"},{"LNHLPKELCAL":["133108903"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["3","133108905,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10302"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1102102,1102106],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[111021],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4114951158,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[11022],"GMENNHMBBOH":[],"HCJHEADFCAO":2014,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AI