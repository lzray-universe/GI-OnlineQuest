ockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["48001","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":48001,"initDialog":4800101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/LQ/Ambor1_480/Q48001","priority":0,"questId":480,"showRandomTalkCount":0},"dialogs":[{"nodeId":4820202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":121645699,"text":"I mean, I read it but...","nextNodeIds":[4820204]},{"nodeId":4820203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2065597067,"text":"I can't say I really grasped the rules...","nextNodeIds":[4820204]},{"nodeId":4820201,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3938872275,"text":"Great, you're here! Did you have a good read-through of the gliding manual? Got all the rules down?","nextNodeIds":[4820202,4820203]},{"nodeId":4820204,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3054491267,"text":"Sounds like it was a real drag. I would know, I've been there...","nextNodeIds":[4820205]},{"nodeId":4820205,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2372747907,"text":"The gliding manual is super dry... I couldn't get into it at all. Don't tell Jean though...","nextNodeIds":[4820206]},{"nodeId":4820206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2457201043,"text":"Really? Hmm... Paimon thought there were some pretty cool stories in the gliding manual.","nextNodeIds":[4820207]},{"nodeId":4820207,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2630360763,"text":"Cool stories? Oh, you must mean the example cases in the Appendix.","nextNodeIds":[4820208]},{"nodeId":4820208,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3761714747,"text":"Some of them I like. My favorite one is about the illegal Anemo Slime take-off.","nextNodeIds":[4820209]},{"nodeId":4820209,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2996522931,"text":"Apparently, if you pop an Anemo Slime and take off in the burst of wind, it shoots you up really, really high... I really wanna try it!","nextNodeIds":[4820210]},{"nodeId":4820210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3211497611,"text":"No, not that story. Paimon meant the one with the little bird who wanted to learn to fly.","nextNodeIds":[4820211]},{"nodeId":4820211,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1487126603,"text":"Ah... What...?","nextNodeIds":[4820212]},{"nodeId":4820212,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3303595211,"text":"Lemme take a look... Shoot, this is the storybook I used to read as a kid!","nextNodeIds":[4820213]},{"nodeId":4820213,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2996819763,"text":"Oops, sorry! I put both books in the same pile and must have grabbed the wrong one when I was leaving.","nextNodeIds":[4820214]},{"nodeId":4820214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1929493883,"text":"How in the heck do you confuse a bedtime story with an instruction manual?","nextNodeIds":[4820215]},{"nodeId":4820215,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2836657187,"text":"Ahh... This is so embarrassing...","nextNodeIds":[4820216]},{"nodeId":4820216,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3396387147,"text":"It's because... Maybe deep down inside, that fairytale is the thing that truly taught me how to glide...","nextNodeIds":[4820217]},{"nodeId":4820217,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1664226147,"text":"\"What you lacked was not wind. It's courage that's allowed you to become the first flying birds of this world.\"","nextNodeIds":[4820218]},{"nodeId":4820218,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2598610363,"text":"Reading that gave me the courage to glide, to become an Outrider, and to become the Gliding Champion of Mondstadt.","nextNodeIds":[4820219]},{"nodeId":4820219,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":969715299,"text":"...But anyway, let's get back to the exam!","nextNodeIds":[4820220]},{"nodeId":4820220,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3789087843,"text":"Don't be nervous, just glide like you're used to.","nextNodeIds":[4820221]},{"nodeId":4820222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3044226523,"text":"I'm ready.","nextNodeIds":[]},{"nodeId":4820221,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3241160067,"text":"Okay then. You just need to follow the <color=#00E1FFFF>marked route</color> to the finish.","nextNodeIds":[4820222]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFD