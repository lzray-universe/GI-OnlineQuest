{"mainQuestId":72685,"title":"Theater Mechanicus: Stage of Brilliance","description":"Inazuma's Komakata is promoting the latest version of Theater Mechanicus during the Irodori Festival...","titleTextMapHash":3894236783,"descTextMapHash":1866616534,"mainQuestExcel":{"mainQuestId":72685,"titleTextMapHash":3894236783,"title":"Theater Mechanicus: Stage of Brilliance","descTextMapHash":1866616534,"description":"Inazuma's Komakata is promoting the latest version of Theater Mechanicus during the Irodori Festival...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2012,"luaPath":"Actor/Quest/WQ72685","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2012,"chapterId":0,"descTextMapHash":1866616534,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72685,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2986961657,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72685","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172685],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3894236783,"type":"WQ","unlockDescTextMapHash":3309040086}},"flow":[{"subQuestId":7268501,"order":1,"stepDescription":"Talk to Komakata","stepDescTextMapHash":3140194452,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268501,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30064"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7268501],"talks":[{"talkId":7268501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7268501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268501,"initDialog":726850101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30064],"performCfg":"QuestDialogue/WQ/Inazuma_72685/Q7268501","priority":5,"questId":72685,"showRandomTalkCount":0},"dialogs":[{"nodeId":726850101,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":3327483722,"text":"Hello there, Irodori Festival-goer!","nextNodeIds":[726850102]},{"nodeId":726850102,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":498002962,"text":"Come, try your hand at the all-new version of Theater Mechanicus!","nextNodeIds":[726850103,726850119]},{"nodeId":726850103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1217115162,"text":"What's Theater Mechanicus?","nextNodeIds":[726850104]},{"nodeId":726850104,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":513791746,"text":"It's a tabletop game from Liyue, and a very interesting one, too!","nextNodeIds":[726850105]},{"nodeId":726850105,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":2819575146,"text":"The original inventor of the game is Ms. Ruijin from Liyue, and she gave me the overseas franchising rights to the game, such that I'd be able to distribute it in Inazuma.","nextNodeIds":[726850106]},{"nodeId":726850106,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":891045274,"text":"I've been in correspondence with her about ways in which we might improve Theater Mechanicus.","nextNodeIds":[726850107]},{"nodeId":726850107,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":4188627426,"text":"And just as luck would have it, the release of our new ruleset coincided with news that the Magnificent Irodori Festival was going to be held.","nextNodeIds":[726850108]},{"nodeId":726850108,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":1047035138,"text":"A short while after deciding to take part in the exhibition, I heard that some big shot would be attending to assess the business prospects of Theater Mechanicus.","nextNodeIds":[726850109]},{"nodeId":726850109,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":1333747458,"text":"That got me pumped right up! I mean, I hope everyone gets to play the best Theater Mechanicus possible.","nextNodeIds":[726850110]},{"nodeId":726850110,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":2375439122,"text":"Would you like to have a go at Theater Mechanicus: Stage of Brilliance?","nextNodeIds":[726850111]},{"nodeId":726850111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4161903418,"text":"\"Stage of Brilliance\"?","nextNodeIds":[726850112]},{"nodeId":726850112,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":267805634,"text":"Long story short, this is Theater Mechanicus' latest and greatest playstyle, which draws inspiration from the \"endgame\" phase of Liyue chess games.","nextNodeIds":[726850113]},{"nodeId":726850113,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":2379722586,"text":"When each new board for Stage of Brilliance opens, there will already be some devices present on the field.","nextNodeIds":[726850114]},{"nodeId":726850114,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":1947292674,"text":"Players must analyze the situation and figure out how to use these devices and carefully ponder stratagems that might be used to achieve victory.","nextNodeIds":[726850115]},{"nodeId":726850115,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":3448540362,"text":"The pace of Stage of Brilliance is faster than those of previous versions, all the better to test the players' judgment. It'll be a sore test and no mistake!","nextNodeIds":[726850116]},{"nodeId":726850116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2532155818,"text":"Well, let's have at it, then.","nextNodeIds":[726850117]},{"nodeId":726850117,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":2678451122,"text":"I hope that the Stage of Brilliance will meet your expectations!","nextNodeIds":[726850118]},{"nodeId":726850118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1819782978,"text":"Try Theater Mechanicus.","nextNodeIds":[]},{"nodeId":726850119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1050737802,"text":"Hello again, Komakata...","nextNodeIds":[726850120]},{"nodeId":726850120,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":2598663906,"text":"Oh-ho! So you do remember me, huh?","nextNodeIds":[726850121]},{"nodeId":726850121,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":3831455874,"text":"Ah, it was all thanks to your ingenious strategies that I realized just how much more room Theater Mechanicus has left to improve.","nextNodeIds":[726850122]},{"nodeId":726850122,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":1809744194,"text":"When the Stage of Wonders promotional event ended, I wrote to Ruijin to share my views with her.","nextNodeIds":[726850123]},{"nodeId":726850123,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":3442635250,"text":"I never thought that we'd be on the exact same page! I guess I'm a pretty good \"overseas franchise owner,\" eh? Hehehe...","nextNodeIds":[726850124]},{"nodeId":726850124,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":2186726706,"text":"Either way, after some back and forth between us, we've come up with the newest version of Theater Mechanicus, which we call the \"Stage of Brilliance.\"","nextNodeIds":[726850125]},{"nodeId":726850125,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":1730644690,"text":"It draws inspiration from the \"endgame\" phase of Liyue chess games.","nextNodeIds":[726850126]},{"nodeId":726850126,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":1600512778,"text":"When each new board for Stage of Brilliance opens, there will already be some devices present on the field.","nextNodeIds":[726850127]},{"nodeId":726850127,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":793944794,"text":"Players must analyze the situation and figure out how to use these devices and carefully ponder stratagems that might be used to achieve victory.","nextNodeIds":[726850128]},{"nodeId":726850128,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":3398358370,"text":"The pace of Stage of Brilliance is faster than those of previous versions, all the better to test the players' judgment. It'll be a sore test and no mistake!","nextNodeIds":[726850129]},{"nodeId":726850129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1734316874,"text":"That does sound interesting.","nextNodeIds":[726850130]},{"nodeId":726850130,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":971832858,"text":"I know, right? I can't wait to see how our customers react after playing.","nextNodeIds":[726850131]},{"nodeId":726850131,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":62187178,"text":"I think I've finally gotten the hang of being a franchise owner after all this time. As such, I'd like to use this Irodori Festival as an opportunity to get more people acquainted with this game.","nextNodeIds":[726850132]},{"nodeId":726850132,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":76914458,"text":"I've even heard that some big shot will be attending to assess its business prospects, so this might be our chance to make it big! Or at least, that's what I hope.","nextNodeIds":[726850133]},{"nodeId":726850133,"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","textMapHash":3062433258,"text":"So, how about it? Why not give the Stage of Brilliance a go?","nextNodeIds":[726850134]},{"nodeId":726850134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2759126242,"text":"Try Theater Mechanicus.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268501,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30064"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7268501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30064,"speakerName":"Komakata","count":27},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[172685],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1866616534,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Inazuma_72685/Q7268501","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":f