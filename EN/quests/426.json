EST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":42601,"initDialog":4260101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"","priority":0,"questId":426,"showRandomTalkCount":0},"dialogs":[{"nodeId":4260101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":584800291,"text":"Gonna rest for a while. What's your plan?","nextNodeIds":[4260102,4260105,4260110,4260118]},{"nodeId":4260102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2515623595,"text":"I'm thinking of doing a quest.","nextNodeIds":[4260103]},{"nodeId":4260103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":291279107,"text":"That's easy! Just click on the exclamation mark at the top-left corner of the screen and you can view all the quests you have taken on so far.","nextNodeIds":[4260104]},{"nodeId":4260104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1094601523,"text":"Some quests are really hard, and there's no way you will be able to complete them until you reach the right level for that quest. If your level isn't high enough, you're too weak.","nextNodeIds":[4260117]},{"nodeId":4260117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3607458923,"text":"Anything else?","nextNodeIds":[4260102,4260105,4260110,4260118]},{"nodeId":4260105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3696671051,"text":"Perhaps I should look around a bit more...","nextNodeIds":[4260106]},{"nodeId":4260106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":521866011,"text":"Some areas are way more dangerous than others.","nextNodeIds":[4260107]},{"nodeId":4260107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3498412075,"text":"You should train in some of the easier areas first, so you don't get beaten to a pulp so soon.","nextNodeIds":[4260108]},{"nodeId":4260108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2059450987,"text":"Alfry of the Adventurers' Guild knows Teyvat like the back of her hand.","nextNodeIds":[4260109]},{"nodeId":4260109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2154810931,"text":"She lives in downtown Mondstadt not far from the gate. You should go ask her about the areas that suit you.","nextNodeIds":[4260117]},{"nodeId":4260110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2941595547,"text":"I think I need to become stronger.","nextNodeIds":[4260111]},{"nodeId":4260111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3565900475,"text":"Well, you can't get stronger without handy weapons or rare Artifacts.","nextNodeIds":[4260112]},{"nodeId":4260112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2755965347,"text":"Heard there's a lot of 'em in dungeons, but they're dangerous places. You'll probably get hurt.","nextNodeIds":[4260113]},{"nodeId":4260113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4089380067,"text":"But... if you're too chicken to earn them, you could always purchase them here in Mondstadt.","nextNodeIds":[4260114]},{"nodeId":4260114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2004964251,"text":"Weapons and Artifacts can also be enhanced and ascended.","nextNodeIds":[4260115]},{"nodeId":4260115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1495283811,"text":"But you'll have to figure out the rest by yourself.","nextNodeIds":[4260116]},{"nodeId":4260116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3875322651,"text":"Oh yeah, suppose your own level is pretty important too...","nextNodeIds":[4260117]},{"nodeId":4260118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1522060851,"text":"I'm not sure yet... I need to think on it a bit more.","nextNodeIds":[4260119]},{"nodeId":4260119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":685409099,"text":"Okay.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[42602,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[42602,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["42601"],"PAINLIBBLDK":"QUEST_EXEC_ROLLBACK_QUEST"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[42601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":0,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DA