m":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7268302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7268301,"initDialog":726830101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30160],"performCfg":"QuestDialogue/WQ/Inazuma_72683/Q7268301","priority":12,"questId":72683,"showRandomTalkCount":0},"dialogs":[{"nodeId":726830101,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":693577746,"text":"*cough* No... This is still no good... It won't do...","nextNodeIds":[726830102]},{"nodeId":726830102,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3164664546,"text":"Any further delay and I'll miss the next submission deadline... *sob*...","nextNodeIds":[726830103,726830104]},{"nodeId":726830103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3123466978,"text":"Hello...","nextNodeIds":[726830105]},{"nodeId":726830105,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":4252242954,"text":"Huh!?","nextNodeIds":[726830106]},{"nodeId":726830106,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3750867962,"text":"I'm sorry—soooo sorry! I will submit it today!","nextNodeIds":[726830107]},{"nodeId":726830107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3000613474,"text":"Whoa! Hang on, we...","nextNodeIds":[726830108]},{"nodeId":726830108,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2427012074,"text":"Miss Moriko, please just give me...","nextNodeIds":[726830109]},{"nodeId":726830109,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2748374634,"text":"Huh? So you aren't Miss Moriko... Thank goodness... Ugh *coughing*","nextNodeIds":[726830110]},{"nodeId":726830110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3857366522,"text":"So who is Miss Moriko...","nextNodeIds":[726830111]},{"nodeId":726830111,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":1568920842,"text":"Miss Moriko is my executive editor.","nextNodeIds":[726830112]},{"nodeId":726830112,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3213607554,"text":"My name is Asagiri. I'm a, um, a freelance illustrator of sorts. Miss Moriko is... the executive editor in charge of my work.","nextNodeIds":[726830113]},{"nodeId":726830113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2241482682,"text":"An illustrator? What does that mean?","nextNodeIds":[726830114]},{"nodeId":726830114,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2239954682,"text":"I suppose you've read some light novels of Yae Publishing House, haven't you?","nextNodeIds":[726830115]},{"nodeId":726830115,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":913140562,"text":"Have you noticed that a light novel usually contains a few pages of pure pictures?","nextNodeIds":[726830116]},{"nodeId":726830116,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3972412522,"text":"Such pictures are what we call illustrations, and those who draw them are illustrators.","nextNodeIds":[726830117]},{"nodeId":726830117,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2044852658,"text":"To serve an important scene or plot, or to give the protagonist a face, some authors will have people draw them an illustration.","nextNodeIds":[726830118]},{"nodeId":726830118,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":4159606146,"text":"The illustration not only creates a more immersive reading experience but also enriches the novel.","nextNodeIds":[726830119]},{"nodeId":726830119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2134689642,"text":"Oh, Paimon gets it now. It's no simple business to make light novels...","nextNodeIds":[726830120]},{"nodeId":726830120,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":1492516410,"text":"I can recommend a few novels to you! For example... ahem! *coughing*","nextNodeIds":[726830121]},{"nodeId":726830121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2252520730,"text":"Are you alright?","nextNodeIds":[726830122]},{"nodeId":726830122,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3361477786,"text":"I'm fine. I've never been very healthy — with all the midnight-oil burning and meal skipping during my work...","nextNodeIds":[726830123]},{"nodeId":726830123,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":121878666,"text":"*cough* As a result, my health keeps deteriorating...","nextNodeIds":[726830124]},{"nodeId":726830124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2169657402,"text":"Since you're unwell, why are you still working here out in the open? Can't you draw at home?","nextNodeIds":[726830125]},{"nodeId":726830125,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":363159026,"text":"I'm here to gather some inspiration.","nextNodeIds":[726830126]},{"nodeId":726830126,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3337051218,"text":"My muse has left me recently. I've missed the deadlines for a few illustrations.","nextNodeIds":[726830127]},{"nodeId":726830127,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3572114162,"text":"Miss Moriko has postponed the deadlines for me several times. She'll be so mad if I dare delay any further.","nextNodeIds":[726830128]},{"nodeId":726830128,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":108781786,"text":"I was thinking that maybe a walk in the open would bring my muse back, so I decided to go on a trip.","nextNodeIds":[726830129]},{"nodeId":726830129,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":513852506,"text":"But as it turned out... Haha... You see, it hadn't taken long before I ended up in this miserable state...","nextNodeIds":[726830130]},{"nodeId":726830130,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":787866658,"text":"*sigh* I'd better put up a request at the Adventurers' Guild and see if any adventurer with a Kamera can help out.","nextNodeIds":[726830131]},{"nodeId":726830131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3418727530,"text":"Huh? Speaking of the Kamera...","nextNodeIds":[726830132,726830134]},{"nodeId":726830132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3417736594,"text":"I do have one...","nextNodeIds":[726830133]},{"nodeId":726830133,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":57782106,"text":"Really!? You have a Kamera?","nextNodeIds":[726830135]},{"nodeId":726830135,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":2244114002,"text":"I—I wanted to have an adventurer take pictures for me using the Kamera!","nextNodeIds":[726830136]},{"nodeId":726830136,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":309696626,"text":"I've heard about many fascinating locations out there — say, the lofty snow mountain near Mondstadt and the area in Liyue where there are many pillars...","nextNodeIds":[726830137]},{"nodeId":726830137,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":1719574738,"text":"And what's more! There's this place named \"Jueyun Karst.\" They say that the adepti live there!","nextNodeIds":[726830138]},{"nodeId":726830138,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3706640154,"text":"The abode of the adepti... The thought of it gives me thrills...","nextNodeIds":[726830139]},{"nodeId":726830139,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":340312986,"text":"But sadly, my health doesn't allow me to really go there...","nextNodeIds":[726830140]},{"nodeId":726830140,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":4276121346,"text":"However, if you can capture their sceneries with the Kamera, I can surely... Ugh *coughing*","nextNodeIds":[726830141]},{"nodeId":726830141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1808920978,"text":"Whoa! Take it easy!","nextNodeIds":[726830142,726830143]},{"nodeId":726830142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":26212162,"text":"Leave it to me.","nextNodeIds":[726830144]},{"nodeId":726830144,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":1179529946,"text":"Really!? That's wonderful! There are many places on my wish list. Gimme a second. Let me find the list.","nextNodeIds":[726830145]},{"nodeId":726830145,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":3177673770,"text":"And don't you worry about the finances. I have quite some savings.","nextNodeIds":[726830146]},{"nodeId":726830146,"roleType":"TALK_ROLE_NPC","speakerId":30160,"speakerName":"Asagiri","textMapHash":632877194,"text":"Where is my notebook? Where is it? My notebook...","nextNodeIds":[]},{"nodeId":726830143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2732276962,"text":"I will work this out.","nextNodeIds":[726830144]},{"nodeId":726830134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2982983082,"text":"But what can it do?","nextNodeIds":[726830135]},{"nodeId":726830104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1317494362,"text":"Excuse me...","nextNodeIds":[726830105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7268301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["30160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7268301],"speaker