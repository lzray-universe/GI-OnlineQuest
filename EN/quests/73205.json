 I'll think about what to do about the fertilizer.","nextNodeIds":[732050402]},{"nodeId":732050402,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":4209628210,"text":"After growing things for decades, I do know how to make some simple fertilizer.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[133308427,427067],"PAINLIBBLDK":"QUEST_CONTENT_GADGET_STATE_CHANGE","PPFLKMOMKAI":"201"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7320901_Player","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7320503,"order":6,"stepDescription":"Talk to Affan","stepDescTextMapHash":1325964100,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4233"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7320503],"talks":[{"talkId":7320503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7320503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7320503,"initDialog":732050301,"nextRandomTalks":[],"nextTalks":[],"npcId":[4233],"performCfg":"QuestDialogue/WQ/Sumeru_73205/Q7320503","priority":5,"questId":73205,"showRandomTalkCount":0},"dialogs":[{"nodeId":732050301,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3936145826,"text":"Good, good, you two are very resourceful.","nextNodeIds":[732050302]},{"nodeId":732050302,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":4170848018,"text":"I have a feeling that they will grow well this time, now that I have guidance from the experts.","nextNodeIds":[732050303]},{"nodeId":732050303,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":60504770,"text":"Were the Shawarma and Tahchin good?","nextNodeIds":[732050304,732050306]},{"nodeId":732050304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":877802138,"text":"They were delicious.","nextNodeIds":[732050305]},{"nodeId":732050305,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1342805514,"text":"Delicious, eh? I'll make more for you, then.","nextNodeIds":[732050307]},{"nodeId":732050307,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2614244970,"text":"I'm not as good of a cook as my late wife, so forgive my poor cooking. Please take them. The portions are smaller this time, though.","nextNodeIds":[732050308]},{"nodeId":732050308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2458719258,"text":"This is so tasty! You're really kind! We'll visit you often.","nextNodeIds":[732050309]},{"nodeId":732050309,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3688875098,"text":"Haha, didn't you children want to ask me what kind of flower this is?","nextNodeIds":[732050310]},{"nodeId":732050310,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1710619010,"text":"I guess I might as well tell you. I'm planting roses.","nextNodeIds":[732050311]},{"nodeId":732050311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3260655354,"text":"As in, Sumeru Roses?","nextNodeIds":[732050312]},{"nodeId":732050312,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1098876250,"text":"This type of flower is called the Golden Rose. It's much more precious than the Sumeru Rose.","nextNodeIds":[732050313]},{"nodeId":732050313,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2511918018,"text":"Remember how I told you that these flower seeds were left to me by a friend?","nextNodeIds":[732050314]},{"nodeId":732050314,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":145310506,"text":"Well, these seeds, and this old house I'm living in now were all left to me by that late \"old ghost.\"","nextNodeIds":[732050315]},{"nodeId":732050315,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":4240233466,"text":"Oh, I forgot. You're not from Aaru Village, so you're most likely not familiar with that name.","nextNodeIds":[732050316]},{"nodeId":732050316,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1853945138,"text":"No matter. Just think of that fellow as an old man who used to grow some flowers...","nextNodeIds":[732050317]},{"nodeId":732050317,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":208436626,"text":"...","nextNodeIds":[732050318]},{"nodeId":732050318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":195755034,"text":"Hey, Grandpa Affan, you're spacing out all of a sudden. Hello! Hello?","nextNodeIds":[732050319]},{"nodeId":732050319,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3499419434,"text":"Ah! Oh. I was lost in thought. I'm sorry, I'm old, and my mind has begun to wander. How embarrassing...","nextNodeIds":[732050320]},{"nodeId":732050320,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":686616434,"text":"Thank you again, children. You can have a look around if there's anything else you want to see.","nextNodeIds":[732050321]},{"nodeId":732050321,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":971115442,"text":"I won't drive people away anymore. But be careful not to tread on the nursery.","nextNodeIds":[]},{"nodeId":732050306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4274132002,"text":"I haven't tried them yet.","nextNodeIds":[732050307]}]}],"conditions":{"finishCon