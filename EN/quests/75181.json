moveDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7518101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7518101,"initDialog":751810101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21809],"performCfg":"QuestDialogue/WQ/Natlan_75181/Q7518101","priority":5,"questId":75181,"showRandomTalkCount":0},"dialogs":[{"nodeId":751810101,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2699500242,"text":"The scene materializes before you like some nostalgic memory.","nextNodeIds":[751810102]},{"nodeId":751810102,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":74758354,"text":"Operations stream along countless convolutions, flowing spectrum paths that shift across layered platforms.\\nThe accumulated Phlogiston coalesces under immense pressure into a floating, controllable ball of heat.\\n\"We've done it!\" Your brethren cheer all around you.\\nYet the one who masterminded this feat, in no way inferior to star-forging, stands outside the experimental site, as though wholly unrelated to this momentous deed.","nextNodeIds":[751810103]},{"nodeId":751810103,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":2740261786,"text":"Congratulations are in order. Creating something equivalent to a celestial body in miniature... An \"Astral Assemblage,\" is it? Truly, a grand achievement, comparable with lunar reconstruction.","nextNodeIds":[751810104]},{"nodeId":751810104,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":349968426,"text":"\"That one\" would surely have tucked their wings in and nodded congratulations to you — were they still with us.","nextNodeIds":[751810105]},{"nodeId":751810105,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":3595128946,"text":"\"...If you had been willing to help, it might have been completed long ago.\"","nextNodeIds":[751810106]},{"nodeId":751810106,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":4109590770,"text":"I have no interest in it.","nextNodeIds":[751810107]},{"nodeId":751810107,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":1329608922,"text":"\"...But you should help me, Kukulkan. We have driven the All-Plunderer's herald into the deepest of mountain valleys, yet once its master awakens...\"","nextNodeIds":[751810108]},{"nodeId":751810108,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":2466327258,"text":"\"It will surely bring another catastrophe upon our people.\"","nextNodeIds":[751810109]},{"nodeId":751810109,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":1472711930,"text":"Ah, how very noble of you, creating this thing to protect your pitiable brethren...","nextNodeIds":[751810110]},{"nodeId":751810110,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":404789722,"text":"\"'Our' pitiable brethren.\"","nextNodeIds":[751810111]},{"nodeId":751810111,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":3670809794,"text":"\"This is only the beginning, and my days are numbered. I must forge a new path for the Dragonborn before the pitch-black shadow smothers us all.\"","nextNodeIds":[751810112]},{"nodeId":751810112,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":3853217050,"text":"Or, perhaps, you should let them find their own way... Forgive my forthrightness, but the path you plan to create may be too narrow for our kind.","nextNodeIds":[751810113]},{"nodeId":751810113,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":1013573794,"text":"\"The narrow way must be walked. When your time runs short... When waiting becomes a luxury.\"","nextNodeIds":[751810114]},{"nodeId":751810114,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":2285211866,"text":"\"Enough waiting, I say. A time will come, Kukulkan, when your days go down like the sun behind the hills, and you will understand. Then, you shall make the same decision as I have...\"","nextNodeIds":[751810115]},{"nodeId":751810115,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","textMapHash":1056878762,"text":"...My king, my elder brother, O lord who gave me life on the day you yourself were born... On this alone I cannot concede to you.","nextNodeIds":[751810116]},{"nodeId":751810116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2739302634,"text":"Huh. That... Did we just see something that happened when this fireball was made?","nextNodeIds":[751810117]},{"nodeId":751810117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":593063522,"text":"You saw that too, Paimon?","nextNodeIds":[751810118]},{"nodeId":751810118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4243546290,"text":"Yeah, Paimon saw it super clearly this time as well... The ones surrounding this cake platform had to be the dragons who used to live here...","nextNodeIds":[751810119]},{"nodeId":751810119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":625955746,"text":"But who were the two people who were speaking, then? Weird...","nextNodeIds":[751810120]},{"nodeId":751810120,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3298990450,"text":"Graawrr...","nextNodeIds":[751810121]},{"nodeId":751810121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1655219810,"text":"Anyway, the seal on the Astral Assemblage here should be broken now, right?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7518101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["101","610104035,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["101","610102175"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[101_64:-466.034,939.147,-247.885]"],"NOCCOBOFKHP":101,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7518101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"Immerse","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4},{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","count":2},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":1},{"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2064715854,"CHECNJEMEFE":{},"CJPLOBIFHLG":"