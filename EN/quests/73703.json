{"mainQuestId":73703,"title":"Tell Me, Mirror Mirror","description":"You hear that there's a scholar out in the wild who's trying to recruit people to participate in a strange mirror-related activity. Maybe you should go take a look...","titleTextMapHash":3827322039,"descTextMapHash":3782425454,"mainQuestExcel":{"mainQuestId":73703,"titleTextMapHash":3827322039,"title":"Tell Me, Mirror Mirror","descTextMapHash":3782425454,"description":"You hear that there's a scholar out in the wild who's trying to recruit people to participate in a strange mirror-related activity. Maybe you should go take a look...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5142,"luaPath":"Actor/Quest/WQ73703","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5142,"chapterId":0,"descTextMapHash":3782425454,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73703,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1840426425,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73703","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173703],"series":73703,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3827322039,"type":"WQ","unlockDescTextMapHash":609219982}},"flow":[{"subQuestId":7370301,"order":1,"stepDescription":"Find the scholar in the wild","stepDescTextMapHash":1203731756,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13356"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7370301],"talks":[{"talkId":7370301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7370301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370301,"initDialog":737030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[13356],"performCfg":"QuestDialogue/WQ/Animal_73703/Q7370301","priority":5,"questId":73703,"showRandomTalkCount":0},"dialogs":[{"nodeId":737030101,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":370639858,"text":"Ahem! You two, over there, excuse me...","nextNodeIds":[737030102]},{"nodeId":737030102,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":3998864866,"text":"There's a brand new game here for you two to play! Hehe, as long as you complete the challenge, you'll obtain a ton of funding for experiments!","nextNodeIds":[737030103]},{"nodeId":737030103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2352769402,"text":"Funding?","nextNodeIds":[737030104]},{"nodeId":737030104,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":2744083586,"text":"Ah! No, sorry, I spoke too quickly! What I mean is, if you finish the game and fill out the survey, then you'll get amazing rewards!","nextNodeIds":[737030105]},{"nodeId":737030105,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":101641434,"text":"The game is really simple too! Heehee, there aren't many chances to obtain rewards this easily, you know...","nextNodeIds":[737030106]},{"nodeId":737030106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3967891346,"text":"Hm, that seems a bit suspicious to Paimon!","nextNodeIds":[737030107,737030108]},{"nodeId":737030107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":66543482,"text":"Is this some kind of new scam?","nextNodeIds":[737030109]},{"nodeId":737030109,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":3528125514,"text":"Whoa, whoa, don't be like that! There's no need to get so suspicious right off the bat, really... Though I admit that randomly inviting strangers passing by in a place like this might be seen as somewhat unusual.","nextNodeIds":[737030110]},{"nodeId":737030110,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":4263475362,"text":"But at least listen to my excuse! Er, I mean, listen to my explanation!","nextNodeIds":[737030111]},{"nodeId":737030111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":946658738,"text":"Alright, let's hear it.","nextNodeIds":[737030112]},{"nodeId":737030112,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":3101763450,"text":"Though the two of you cannot tell, I am a researcher from the Amurta Darshan of the Akademiya. My name is Lamiya.","nextNodeIds":[737030113]},{"nodeId":737030113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":736277042,"text":"Um, it's actually really obvious, since you're wearing Akademiya clothing.","nextNodeIds":[737030114]},{"nodeId":737030114,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":2668596154,"text":"Oho, that's where you're wrong! What if a con artist merely put on Akademiya robes to fool you into thinking they were a researcher?","nextNodeIds":[737030115]},{"nodeId":737030115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1922768194,"text":"...","nextNodeIds":[737030116]},{"nodeId":737030116,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":2284435682,"text":"Of course, I am most definitely not talking about myself! Pfff, come on, I was just reminding you two! I really am from Amurta, if you doubt me, just ask any matra! I'm definitely at the top of quite a few of their lists.","nextNodeIds":[737030117]},{"nodeId":737030117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4123306546,"text":"Is that supposed to be... a good thing?","nextNodeIds":[737030118]},{"nodeId":737030118,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1466790970,"text":"Ahem! Anyway, you two... oh, right! I haven't asked your names yet...","nextNodeIds":[737030119]},{"nodeId":737030119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2501191362,"text":"Paimon's name is Paimon!","nextNodeIds":[737030120]},{"nodeId":737030120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":205166138,"text":"#And I'm {NICKNAME}.","nextNodeIds":[737030121]},{"nodeId":737030121,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1782890354,"text":"#Hehe, in that case, {NICKNAME} and Paimon, allow me to explain this little challenge to you!","nextNodeIds":[737030122]},{"nodeId":737030122,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":3514199722,"text":"This is actually all related to a story I read when I was a child, about a boy who turns into a cat and has all kinds of adventures in the land of cats!","nextNodeIds":[737030123]},{"nodeId":737030123,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1016299298,"text":"It's a really cute story, hehe, after the protagonist falls in love with a beautiful cat, he turns back into a human! Then, the story ends with him as the owner of that gorgeous cat, living out their lives as pet and master... it's a pretty good ending.","nextNodeIds":[737030124]},{"nodeId":737030124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1145501850,"text":"No... That's actually a really weird ending.","nextNodeIds":[737030125]},{"nodeId":737030125,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1630519394,"text":"Well, at the very end, the boy finds out the beautiful cat is actually male! So I think the ending actually has quite a bit of literary value...","nextNodeIds":[737030126]},{"nodeId":737030126,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":2202983418,"text":"Hehe... sorry, we got a bit off topic. Anyway, the whole point is that much of the story is written from the perspective of an animal, which fascinated me! After becoming a scholar, I decided that would be my research area.","nextNodeIds":[737030127]},{"nodeId":737030127,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":303505010,"text":"By combining the equipment I developed with the mature tech of the Akasha, we can see the world through the eyes of various animals.","nextNodeIds":[737030128]},{"nodeId":737030128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1275408282,"text":"Now that sounds more like it! Though, using the Akademiya's research funds to chase your dreams, isn't that a bit like abusing your position to get what you want?","nextNodeIds":[737030129]},{"nodeId":737030129,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":2984962778,"text":"Haha, perhaps it is appropriating public technology for my private purposes, and a bit selfish, but this also is quite practical and has a lot of potential.","nextNodeIds":[737030130]},{"nodeId":737030130,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1305931114,"text":"When searching for victims after a disaster, or exploring collapsed ruins, small animals are far more agile than us, and if we could borrow their eyes...","nextNodeIds":[737030131,737030137]},{"nodeId":737030131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2211303242,"text":"Then you can infiltrate places you aren't supposed to.","nextNodeIds":[737030132]},{"nodeId":737030132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2991092410,"text":"What do you mean, infiltrate places you aren't supposed to...? Lamiya was clearly talking about really good and noble uses!","nextNodeIds":[737030133]},{"nodeId":737030133,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1480027178,"text":"#Hehe, exactly! Quite perceptive, {NICKNAME}, humans tend to be cautious around their own kind, but are quite relaxed around animals.","nextNodeIds":[737030134]},{"nodeId":737030134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3303272794,"text":"HEY! Don't actually use it for any weird stuff!","nextNodeIds":[737030135]},{"nodeId":737030135,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1630714802,"text":"A joke, a jest! Each time the tech is used, everything is recorded. If you use it for anything naughty, you'll immediately be caught and punished.","nextNodeIds":[737030136]},{"nodeId":737030136,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":899512818,"text":"But still, what do you think? Sounds like some pretty amazing research, doesn't it?","nextNodeIds":[737030141]},{"nodeId":737030141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2791903602,"text":"It actually does sound quite impressive.","nextNodeIds":[737030142]},{"nodeId":737030142,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":503936266,"text":"I was planning on taking my time, b—but those fools at Kshahrewar managed to see the promise in such research, and are planning to achieve similar results with tiny machines!","nextNodeIds":[737030143]},{"nodeId":737030143,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1612919826,"text":"It's b—blasphemy, I say! Corruption and evil! Compared to cute little animals, who wants cold machines!?","nextNodeIds":[737030144]},{"nodeId":737030144,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1791108754,"text":"#Right, {NICKNAME} and Paimon!?","nextNodeIds":[737030145]},{"nodeId":737030145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":486707906,"text":"Well, uh...","nextNodeIds":[737030146,737030148]},{"nodeId":737030146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3696352346,"text":"Of course animals are much cuter!","nextNodeIds":[737030147]},{"nodeId":737030147,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1387114850,"text":"#I just knew you'd understand, {NICKNAME}!","nextNodeIds":[737030151]},{"nodeId":737030151,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1077603026,"text":"Anyway, the point is that if I can't produce results ASAP, those Kshahrewar dolts will certainly beat me to the punch! So grabbing passersby out here away from prying eyes is my only option.","nextNodeIds":[737030152]},{"nodeId":737030152,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":3741493458,"text":"Hehe, when you think about it like that, there's nothing suspicious about it at all.","nextNodeIds":[737030153]},{"nodeId":737030153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":310332738,"text":"Sounds like it's pretty legit after all!","nextNodeIds":[737030154]},{"nodeId":737030154,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":218415818,"text":"\"Not many chances to obtain rewards this easily\"...","nextNodeIds":[737030155]},{"nodeId":737030155,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2330447530,"text":"Alright, then count us in!","nextNodeIds":[737030156]},{"nodeId":737030156,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1579665594,"text":"Hehe, thank you, thank you so much!","nextNodeIds":[737030157]},{"nodeId":737030157,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":3903029562,"text":"Anyway, take this first! It's a tool I invented, I call it the Inscribed Mirror. The mirror will show you what the animal connected to my device sees!","nextNodeIds":[737030158]},{"nodeId":737030158,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1385036698,"text":"Just use the images shown in the Inscribed Mirror to figure out where the animals with the devices attached are, then catch them to earn your reward!","nextNodeIds":[737030159]},{"nodeId":737030159,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2584850674,"text":"Huh? So if they're running around all over the place...","nextNodeIds":[737030160]},{"nodeId":737030160,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1627202250,"text":"It's fine, hehe, they're all trained, and will stay in the area! They won't go too far, so don't worry about that!","nextNodeIds":[737030161]},{"nodeId":737030161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1134834786,"text":"#Okay! C'mon, {NICKNAME}, let's roll out!","nextNodeIds":[]},{"nodeId":737030148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":204972362,"text":"I am from the \"Beep, Construct, Beep\" Darshan.","nextNodeIds":[737030149]},{"nodeId":737030149,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":1825335386,"text":"?","nextNodeIds":[737030150]},{"nodeId":737030150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1925548522,"text":"Hmph, Paimon has no idea what you're talking about!","nextNodeIds":[737030151]},{"nodeId":737030137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":271226242,"text":"Searching for things will be much easier.","nextNodeIds":[737030138]},{"nodeId":737030138,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":544934826,"text":"Exactly! For example, if you can borrow the vision of a Weasel Thief, you can explore ruins quite quickly.","nextNodeIds":[737030139]},{"nodeId":737030139,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":3796283946,"text":"With the eyes of birds, you can look down from on high, and on a clear day with good visibility, it would be very easy to conduct topography or other forms of observation.","nextNodeIds":[737030140]},{"nodeId":737030140,"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","textMapHash":520992906,"text":"Hehe, what do you think? Sounds like some pretty amazing research, doesn't it?","nextNodeIds":[737030141]},{"nodeId":737030108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1127712762,"text":"Should we report this to the matra?","nextNodeIds":[737030109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13356"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7370301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13356,"speakerName":"Lamiya","count":35},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173703],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false