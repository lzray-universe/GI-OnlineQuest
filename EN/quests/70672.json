"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7067202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067201,"initDialog":706720101,"nextRandomTalks":[],"nextTalks":[],"npcId":[13276],"performCfg":"QuestDialogue/WQ/Mengde_70672/Q7067201","priority":5,"questId":70672,"showRandomTalkCount":0},"dialogs":[{"nodeId":706720101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3326027130,"text":"Wait, isn't that Tubby? What's she doing in The Cat's Tail!?","nextNodeIds":[706720102]},{"nodeId":706720102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3431484882,"text":"Tuuubbyyy...!","nextNodeIds":[706720103]},{"nodeId":706720103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3236119802,"text":"Hey, Tubby!","nextNodeIds":[706720104]},{"nodeId":706720104,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":99991650,"text":"Ah, it's you two.","nextNodeIds":[706720105]},{"nodeId":706720105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2972351450,"text":"What are you doing here? ...Wait, and how'd you get out of the Serenitea Pot? You can do that?","nextNodeIds":[706720106]},{"nodeId":706720106,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1563040762,"text":"Of course I can... Ah, but this is your first time seeing me outside of the teapot realm, isn't it?","nextNodeIds":[706720107]},{"nodeId":706720107,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":546393866,"text":"Although the adepti created teapot spirits primarily to manage and maintain their teapot realms, our movements are not restricted to those domains.","nextNodeIds":[706720108]},{"nodeId":706720108,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":3283064986,"text":"For instance, there's Chubby— I'm sorry, \"Jade Seeker,\" who travels far and wide to gather the rarest treasures in the land.","nextNodeIds":[706720109]},{"nodeId":706720109,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2938773650,"text":"*sigh* But it is true that I, in contrast, rarely leave the teapot realm at all.","nextNodeIds":[706720110]},{"nodeId":706720110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":153636266,"text":"Ah. Paimon gets it now.","nextNodeIds":[706720111]},{"nodeId":706720111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3200535666,"text":"Huh, well since you so rarely leave, what's the occasion today?","nextNodeIds":[706720112,706720115]},{"nodeId":706720112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":364943570,"text":"I'm guessing you didn't come for a drink?","nextNodeIds":[706720113]},{"nodeId":706720113,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1940009290,"text":"As curious as I am to know how the drinks here differ from those in Liyue, no — in fact, I was sent here for a reason.","nextNodeIds":[706720114]},{"nodeId":706720114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2957963786,"text":"What reason is that?","nextNodeIds":[706720117]},{"nodeId":706720117,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1674092498,"text":"#Um... and as it happens, it has something to do with {NICKNAME}, too.","nextNodeIds":[706720118]},{"nodeId":706720118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4180843930,"text":"...How so?","nextNodeIds":[706720119]},{"nodeId":706720119,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":266486898,"text":"Well, as I'm sure you've discovered, with the rising popularity of Genius Invokation TCG, inviting a friend to a duel in the tavern has become a fun way to pass the time.","nextNodeIds":[706720120]},{"nodeId":706720120,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":330745234,"text":"There's just one little problem. Many invitees currently have to travel an enormous distance to get here, turning the whole thing into quite an ordeal. I have therefore been sent here to create a little game room using the same adeptus art as is used to construct teapot realms.","nextNodeIds":[706720121]},{"nodeId":706720121,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1673858354,"text":"That way, anyone with an invitation will need only to think the thought, and they will instantly appear in the game room.","nextNodeIds":[706720122]},{"nodeId":706720122,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":356809474,"text":"You will be free to use the room whenever you wish to invite a friend to duel, and it will be far more straightforward for them to take you up on the offer.","nextNodeIds":[706720123]},{"nodeId":706720123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2528239450,"text":"Wow. This'll make things much easier!","nextNodeIds":[706720124]},{"nodeId":706720124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3416611698,"text":"But... What if Margaret finds out? She's not gonna get mad at you for renovating her tavern with your adeptus arts, is she...?","nextNodeIds":[706720125]},{"nodeId":706720125,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1644099402,"text":"Umm... That shouldn't be a problem, since the realm will not be physically located within The Cat's Tail. Besides, we obviously sought the owner's permission in advance...","nextNodeIds":[706720126]},{"nodeId":706720126,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":583342650,"text":"She was quite enthusiastic: \"Ooh, Liyue's adepti arts sound pretty useful! Could you double the size of the tavern while you're at it?\" ...Unfortunately, my mastery of adeptus arts is not sufficient to achieve this.","nextNodeIds":[706720127]},{"nodeId":706720127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1044792090,"text":"Huh... Yeah, that does sound like something Margaret would say...","nextNodeIds":[706720128]},{"nodeId":706720128,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1529577962,"text":"Anyway, it's great that you're here — I was expecting to have to wait until your next visit to the teapot realm to fill you in.","nextNodeIds":[706720129]},{"nodeId":706720129,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":393478266,"text":"Right then. Let's get started.","nextNodeIds":[706720130]},{"nodeId":706720130,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":165336194,"text":"Okay, that should do it.","nextNodeIds":[706720131]},{"nodeId":706720131,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":583930074,"text":"#Over to you, {NICKNAME}. Now you can invite friends to duel with you in this room, wherever in the world they are. I hope it serves you well.","nextNodeIds":[706720132]},{"nodeId":706720132,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1951573938,"text":"...Oh, and I almost forgot. A guy from the tavern wanted me to say this to you:","nextNodeIds":[706720133]},{"nodeId":706720133,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":3131621178,"text":"Hope you'll have fun playing Genius Invokation TCG!","nextNodeIds":[]},{"nodeId":706720115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3264749298,"text":"Not to play cards, I'll bet.","nextNodeIds":[706720116]},{"nodeId":706720116,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":332270266,"text":"Indeed not, although it may surprise you to learn that the reason I was sent here still has to do with the card game.","nextNodeIds":[706720134]},{"nodeId":706720134,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":4103123042,"text":"Tubby uses her adeptus arts to remodel the tavern and update the match invitation board.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7067204,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7067201","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["1076","201076001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13276"],"NOCCOBOFKHP":1076,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7067204,"order":3,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067204,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067204,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1076","201076001,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7067203,"order":4,"stepDescription":"Talk to the strange guest","stepDescTextMapHash":1811991676,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7067205,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13276"],"NOCCOBOFKHP":1076,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7067202],"talks":[{"talkId":7067202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7067203","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067202,"initDialog":706720201,"nextRandomTalks":[],"nextTalks":[],"npcId":[13276],"performCfg":"QuestDialogue/WQ/Mengde_70672/Q7067202","priority":5,"questId":70672,"showRandomTalkCount":0},"dialogs":[{"nodeId":706720201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4070196402,"text":"Huh? There's a strange new customer in the tavern!","nextNodeIds":[706720202]},{"nodeId":706720202,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1850330546,"text":"Hmm?","nextNodeIds":[706720203]},{"nodeId":706720203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1414157962,"text":"#Look, look, {NICKNAME} it's a huge finch!","nextNodeIds":[706720204]},{"nodeId":706720204,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":3304314634,"text":"Excuse me, I am not a finch! My name is...","nextNodeIds":[706720205]},{"nodeId":706720205,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2214884082,"text":"Um... Oh dear, it seems... No, I can't quite remember my name. You can just call me \"Tubby,\" I suppose.","nextNodeIds":[706720206]},{"nodeId":706720206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2527984186,"text":"Well, hey Tubby. Don't think we've seen you around Mondstadt before...","nextNodeIds":[706720207]},{"nodeId":706720207,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1564747594,"text":"That's because it's highly unusual for me to be in Mondstadt at all. I actually came here all the way from Liyue...","nextNodeIds":[706720208]},{"nodeId":706720208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3635985514,"text":"So... How come you came all this way just to visit The Cat's Tail?","nextNodeIds":[706720209,706720212]},{"nodeId":706720209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":624875210,"text":"I'm guessing you didn't come for a drink?","nextNodeIds":[706720210]},{"nodeId":706720210,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1081533458,"text":"As curious as I am to know how the drinks here differ from those in Liyue, no — in fact, I was sent here for a reason.","nextNodeIds":[706720211]},{"nodeId":706720211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1422157146,"text":"What reason is that?","nextNodeIds":[706720214]},{"nodeId":706720214,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":1868181954,"text":"#Um... and if I am guessing correctly, and you are indeed {NICKNAME}... then as it happens, it has something to do with you, too.","nextNodeIds":[706720215]},{"nodeId":706720215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1634046866,"text":"...How so?","nextNodeIds":[706720216]},{"nodeId":706720216,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":117383842,"text":"Well, as I'm sure you've discovered, with the rising popularity of Genius Invokation TCG, inviting a friend to a duel in the tavern has become a fun way to pass the time.","nextNodeIds":[706720217]},{"nodeId":706720217,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2685984626,"text":"There's just one little problem. Many invitees currently have to travel an enormous distance to get here, turning the whole thing into quite an ordeal. I have therefore been sent here to create a little game room using the same adeptus art as is used to construct teapot realms.","nextNodeIds":[706720218]},{"nodeId":706720218,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2400864922,"text":"That way, anyone with an invitation will need only to think the thought, and they will instantly appear in the game room.","nextNodeIds":[706720219]},{"nodeId":706720219,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":4053517162,"text":"You will be free to use the room whenever you wish to invite a friend to duel, and it will be far more straightforward for them to take you up on the offer.","nextNodeIds":[706720220]},{"nodeId":706720220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1101877914,"text":"Wow. This'll make things much easier!","nextNodeIds":[706720221]},{"nodeId":706720221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3969193746,"text":"But... What if Margaret finds out? She's not gonna get mad at you for renovating her tavern with your adeptus arts, is she...?","nextNodeIds":[706720222]},{"nodeId":706720222,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":4286221354,"text":"Umm... That shouldn't be a problem, since the realm will not be physically located within The Cat's Tail. Besides, we obviously sought the owner's permission in advance...","nextNodeIds":[706720223]},{"nodeId":706720223,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":3215560490,"text":"She was quite enthusiastic: \"Ooh, Liyue's adepti arts sound pretty useful! Could you double the size of the tavern while you're at it?\" ...Unfortunately, my mastery of adeptus arts is not sufficient to achieve this.","nextNodeIds":[706720224]},{"nodeId":706720224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2859261282,"text":"Huh... Yeah, that does sound like something Margaret would say...","nextNodeIds":[706720225]},{"nodeId":706720225,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2609764658,"text":"Anyway, it's great that you're here. I was racking my brains trying to think how to get in touch with you after setting everything up.","nextNodeIds":[706720226]},{"nodeId":706720226,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2410593922,"text":"Right then. Let's get started.","nextNodeIds":[706720227]},{"nodeId":706720227,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2577550698,"text":"Okay, that should do it.","nextNodeIds":[706720228]},{"nodeId":706720228,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2335398042,"text":"Whoa, just like that? Liyue's adepti arts are pretty nifty.","nextNodeIds":[706720229]},{"nodeId":706720229,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2356032458,"text":"Mm-hmm... You know, I have a feeling that we will meet again someday. Who knows when — but we will find out when that time comes.","nextNodeIds":[706720230]},{"nodeId":706720230,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":3819039634,"text":"#Over to you, {NICKNAME}. Now you can invite friends to duel with you in this room, wherever in the world they are. I hope it serves you well.","nextNodeIds":[706720231]},{"nodeId":706720231,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":3287348074,"text":"...Oh, and I almost forgot. A guy from the tavern wanted me to say this to you:","nextNodeIds":[706720232]},{"nodeId":706720232,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":868083866,"text":"Hope you'll have fun playing Genius Invokation TCG!","nextNodeIds":[]},{"nodeId":706720212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3539297818,"text":"Not to play cards, I'll bet.","nextNodeIds":[706720213]},{"nodeId":706720213,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"Tubby","textMapHash":2049682362,"text":"Indeed not, although it may surprise you to learn that the reason I was sent here still has to do with the card game.","nextNodeIds":[706720233]},{"nodeId":706720233,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1577592978,"text":"Tubby uses her adeptus arts to remodel the tavern and update the match invitation board.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7067205,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7165401,1],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_GLOBAL_VAR_EQUAL","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["7067201","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["1076","201076001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13276"],"NOCCOBOFKHP":1076,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7067205,"order":5,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067205,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIB