D_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7320303,"initDialog":732030301,"nextRandomTalks":[],"nextTalks":[],"npcId":[4232],"performCfg":"QuestDialogue/WQ/Sumeru_73203/Q7320303","priority":5,"questId":73203,"showRandomTalkCount":0},"dialogs":[{"nodeId":732030301,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2369021306,"text":"Thank you again. Honestly, it gladdens my heart to see Sumeru Roses grow in this environment.","nextNodeIds":[732030302]},{"nodeId":732030302,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2314223770,"text":"As you talk to Sabbah, new leaves begin to sprout...","nextNodeIds":[732030303]},{"nodeId":732030303,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2341826522,"text":"The leaves unfold, revealing flower buds.","nextNodeIds":[732030304]},{"nodeId":732030304,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2793588714,"text":"The flower buds slowly open and blossom into Sumeru Roses.","nextNodeIds":[732030305]},{"nodeId":732030305,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3101610074,"text":"Sabbah picks one and hands it to you and Paimon.","nextNodeIds":[732030306]},{"nodeId":732030306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":699282906,"text":"You shouldn't have... You didn't have many to begin with...","nextNodeIds":[732030307]},{"nodeId":732030307,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3472449570,"text":"It's all right. After all, this wouldn't have been possible without your help.","nextNodeIds":[732030308,732030309]},{"nodeId":732030308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3106484922,"text":"We were just lending a hand.","nextNodeIds":[732030310]},{"nodeId":732030310,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":4069194986,"text":"A rose garden is magnificent, but a single rose also has beauty of its own. I've been intrigued by roses ever since my scholarly days.","nextNodeIds":[732030311]},{"nodeId":732030311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2764250762,"text":"What? You were a researcher?","nextNodeIds":[732030312]},{"nodeId":732030312,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2404042490,"text":"Right, I haven't told you yet... I'm not a native of Aaru Village. I \"moved\" here from the Akademiya.","nextNodeIds":[732030313]},{"nodeId":732030313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2321386522,"text":"See, didn't Paimon tell you that Miss Sabbah speaks in a refined way, just like the researchers we've met?","nextNodeIds":[732030314]},{"nodeId":732030314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":472030266,"text":"You planted these because you wanted to continue studying roses, right?","nextNodeIds":[732030315]},{"nodeId":732030315,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3496773098,"text":"I wouldn't say that. To be honest, I don't think that researchers' interest in their subjects should be cultivated just for research's sake alone.","nextNodeIds":[732030316]},{"nodeId":732030316,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":940696906,"text":"I did this because I love this world and want to understand the life cycle of plants.","nextNodeIds":[732030317]},{"nodeId":732030317,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":184613570,"text":"As for me, I once studied the impact of geographical changes on the evolution of roses.","nextNodeIds":[732030318]},{"nodeId":732030318,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2660445666,"text":"Just consider this. If the environments in Sumeru had changed in a totally different way, how would these roses have adapted?","nextNodeIds":[732030319]},{"nodeId":732030319,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3330664146,"text":"Would they have crawled up the walls like ivy? If so, the walls of the Akademiya would now be covered in roses.","nextNodeIds":[732030320]},{"nodeId":732030320,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1537514834,"text":"Would they have formed clusters? A natural bouquet! Wouldn't that have been lovely?","nextNodeIds":[732030321]},{"nodeId":732030321,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":382917642,"text":"Maybe they might have even developed a spectrum of colors... White, red, and gold... Brand new species in their own right.","nextNodeIds":[732030322]},{"nodeId":732030322,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1383932058,"text":"Of course, very few people discover new species nowadays, much less develop new species like the top researchers used to do.","nextNodeIds":[732030323]},{"nodeId":732030323,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1402784938,"text":"What I want to say is that there's a vast amount of potential in every rose.","nextNodeIds":[732030324]},{"nodeId":732030324,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3662560842,"text":"Exploring the possibilities is a lot of fun for me. Back then, I would happily collect samples every day.","nextNodeIds":[732030325]},{"nodeId":732030325,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":4011024562,"text":"Looking back now, that was a simple and joyful time.","nextNodeIds":[732030326]},{"nodeId":732030326,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1324103994,"text":"Anyway, just take it. To me, this is no loss. I am freely sharing my happiness.","nextNodeIds":[732030327]},{"nodeId":732030327,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":74715410,"text":"If you still feel awkward, just visit me often, and bring some Sumeru Roses with you.","nextNodeIds":[732030328]},{"nodeId":732030328,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2209215090,"text":"I feel at ease when I talk to you.","nextNodeIds":[732030329]},{"nodeId":732030329,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":417620202,"text":"And no matter what I said, you never thought it was nonsense or interrupted me.","nextNodeIds":[732030330]},{"nodeId":732030330,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":57041858,"text":"I'll have small gifts for you too. Though I have no use for them now, you might like them.","nextNodeIds":[732030331]},{"nodeId":732030331,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3908091930,"text":"We'll be back.","nextNodeIds":[732030332]},{"nodeId":732030332,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2034355922,"text":"Please do return.","nextNodeIds":[]},{"nodeId":732030309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1283936698,"text":"Don't sweat it.","nextNodeIds":[732030310]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7320309,"order":7,"stepDescription":"","stepDescTextMapHash":10476588,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320309,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320309,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133308032,5"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7320306,"order":8,"stepDescription":"","stepDescTextMapHash":542856228,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320306,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320306,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":7319305,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7319305","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7320301","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7319305,"initDialog":731930501,"nextRandomTalks":[],"nextTalks":[],"npcId":[4232],"performCfg":"","priority":4,"questId":73203,"showRandomTalkCount":0},"dialogs":[{"nodeId":731930501,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1442693538,"text":"If it weren't for you, I don't think I'd have ever seen these roses sprout.","nextNodeIds":[731930502]},{"nodeId":731930502,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":365395258,"text":"If only I knew this would happen... instead of seeds, I should have brought a few more books.","nextNodeIds":[731930503,731930519]},{"nodeId":731930503,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1692317730,"text":"You're not from here?","nextNodeIds":[731930504]},{"nodeId":731930504,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":596117186,"text":"Are you surprised? Well, I guess that means that I've adapted pretty well.","nextNodeIds":[731930505]},{"nodeId":731930505,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1620475658,"text":"When I first got here, I was unable to get used to anything, whether it be the food, the housing, or anything else.","nextNodeIds":[731930506]},{"nodeId":731930506,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":67973234,"text":"But I got used to everything over time.","nextNodeIds":[731930507]},{"nodeId":731930507,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2639542594,"text":"That doesn't mean that I've fully accepted my predicament, though.","nextNodeIds":[731930508]},{"nodeId":731930508,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":4141453330,"text":"I suppose it is impossible to make roses from Sumeru City bloom here after all.","nextNodeIds":[731930509]},{"nodeId":731930509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":359017922,"text":"Are you a researcher?","nextNodeIds":[731930510]},{"nodeId":731930510,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":814642754,"text":"I could have been called that once, but not anymore.","nextNodeIds":[731930511]},{"nodeId":731930511,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":122695530,"text":"I said something beyond my station, and learned something I shouldn't have.","nextNodeIds":[731930512]},{"nodeId":731930512,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":919728482,"text":"I broke the Akademiya's taboos, so I was removed from amongst their ranks.","nextNodeIds":[731930513]},{"nodeId":731930513,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":294633642,"text":"What did you say?","nextNodeIds":[731930514]},{"nodeId":731930514,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":19762730,"text":"Curiosity is the impetus for seeking wisdom, but it's also the cause of sin.","nextNodeIds":[731930515]},{"nodeId":731930515,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1711489714,"text":"I only understood that after I was exiled to this place.","nextNodeIds":[731930516]},{"nodeId":731930516,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":954460106,"text":"For safety reasons, I don't think I should go into details.","nextNodeIds":[731930517]},{"nodeId":731930517,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":82650002,"text":"All right then.","nextNodeIds":[731930518]},{"nodeId":731930518,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3253657690,"text":"Ahem, but...","nextNodeIds":[731930535]},{"nodeId":731930535,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":4011029546,"text":"I thought adventurers would just come and go, never coming back to chit-chat after finishing their jobs.","nextNodeIds":[731930536]},{"nodeId":731930536,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1921109858,"text":"I didn't expect to have another long conversation with you.","nextNodeIds":[731930537]},{"nodeId":731930537,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2112751138,"text":"To be honest, I don't have a lot of friends to talk to here.","nextNodeIds":[731930538]},{"nodeId":731930538,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":175212530,"text":"Do you think... at some point... you would be able to come by and fertilize my plants again?","nextNodeIds":[731930539]},{"nodeId":731930539,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":551501890,"text":"Sure.","nextNodeIds":[731930540]},{"nodeId":731930540,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1401134330,"text":"...Okay then, I'll wait for you.","nextNodeIds":[]},{"nodeId":731930519,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":515844442,"text":"Why grow Sumeru Roses?","nextNodeIds":[731930520]},{"nodeId":731930520,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":560126074,"text":"You probably don't know much about them... but they are very versatile, and have many uses.","nextNodeIds":[731930521]},{"nodeId":731930521,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3541931154,"text":"They can be eaten, turned into medicine, given as gifts, or fetch a good price on the market.","nextNodeIds":[731930522]},{"nodeId":731930522,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":188471090,"text":"And that's just some of the more common applications.","nextNodeIds":[731930523]},{"nodeId":731930523,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1454564938,"text":"The flower, leaves, and stalk of a Sumeru Rose also did not always look like this. They all had different appearances once upon a time.","nextNodeIds":[731930524]},{"nodeId":731930524,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3792851170,"text":"I believe geographical changes led to changes in the roses' traits.","nextNodeIds":[731930525]},{"nodeId":731930525,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":459679802,"text":"A study of its traits could help us derive past geographical and historical information.","nextNodeIds":[731930526]},{"nodeId":731930526,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3984847090,"text":"I won't be able to explain the mechanism over just a casual conversation, and sharing such information with adventurers is probably against the rules as well.","nextNodeIds":[731930527]},{"nodeId":731930527,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1204586362,"text":"If you're interested in botanical evolution, you should visit the Akademiya. They'll have more on the subject.","nextNodeIds":[731930528]},{"nodeId":731930528,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4139613378,"text":"So, you're doing this for your research?","nextNodeIds":[731930529]},{"nodeId":731930529,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":78803658,"text":"I'm not a researcher anymore. I no longer have the right or means to pursue any research.","nextNodeIds":[731930530]},{"nodeId":731930530,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":811033434,"text":"If you must know why... *sigh*, you are a very curious soul, you know that?","nextNodeIds":[731930531]},{"nodeId":731930531,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":3247229962,"text":"I grew a lot of Sumeru Roses back in my former residence. The flowers were spectacular, and I got to see them every day.","nextNodeIds":[731930532]},{"nodeId":731930532,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":1279178274,"text":"If it was possible, I wish I could see them again, just like before.","nextNodeIds":[731930533]},{"nodeId":731930533,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","textMapHash":2910555498,"text":"...That's all there is to it.","nextNodeIds":[731930534]},{"nodeId":731930534,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1064674922,"text":"I can understand that.","nextNodeIds":[731930535]}]}],"questNarration":[],"talkIds":[7319305,7320301,7320303,7320304],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"Sabbah","count":65},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":15},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":8},{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC