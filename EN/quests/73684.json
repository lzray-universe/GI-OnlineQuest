{"mainQuestId":73684,"title":"Across the Wilderness","description":"In Mondstadt, an adventurer seems to be recruiting people...","titleTextMapHash":1723623135,"descTextMapHash":2180053046,"mainQuestExcel":{"mainQuestId":73684,"titleTextMapHash":1723623135,"title":"Across the Wilderness","descTextMapHash":2180053046,"description":"In Mondstadt, an adventurer seems to be recruiting people...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5112,"luaPath":"Actor/Quest/WQ73684","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5112,"chapterId":0,"descTextMapHash":2180053046,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73684,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3247928625,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73684","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173684],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1723623135,"type":"WQ","unlockDescTextMapHash":1774073094}},"flow":[{"subQuestId":7368401,"order":1,"stepDescription":"Talk to Vinkel","stepDescTextMapHash":595812740,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30276"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7368401],"talks":[{"talkId":7368401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7368401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7368401,"initDialog":736840101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30276],"performCfg":"QuestDialogue/WQ/Sumeru_73684/Q7368401","priority":5,"questId":73684,"showRandomTalkCount":0},"dialogs":[{"nodeId":736840101,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":3487410546,"text":"Good day, fellow adventurers! Anyone who's interested in the new event held by the Adventurers' Guild, please gather around!","nextNodeIds":[736840102]},{"nodeId":736840102,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":1472628298,"text":"So long as you participate in the event, you will receive not only rewards offered by the Adventurers' Guild, but also certain extra special gifts!","nextNodeIds":[736840103,736840104]},{"nodeId":736840103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2857830058,"text":"The Adventurers' Guild is holding an event?","nextNodeIds":[736840105]},{"nodeId":736840105,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":2670892578,"text":"You are... the Traveler! Oh my, what a pleasant surprise. I wasn't expecting to see you at all!","nextNodeIds":[736840106]},{"nodeId":736840106,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":4109134602,"text":"As you can see, I'm recruiting participants for an event held by the Guild.","nextNodeIds":[736840107]},{"nodeId":736840107,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":3135451818,"text":"This is my first official job in the Guild, and I'm determined to leave a perfect impression!","nextNodeIds":[736840108]},{"nodeId":736840108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2998439764,"text":"About the event...","nextNodeIds":[736840109]},{"nodeId":736840109,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":2439480274,"text":"Ah, you must've not heard about the event!","nextNodeIds":[736840110]},{"nodeId":736840110,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":1498882474,"text":"Jack has named the event \"Across the Wilderness.\"","nextNodeIds":[736840111]},{"nodeId":736840111,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":3317902450,"text":"In his words, this event is gonna be \"simple yet fun, and at the same time can test the capabilities of the participating adventurers.\"","nextNodeIds":[736840112]},{"nodeId":736840112,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":2122756914,"text":"To be more specific, we are going to set up Wilderness Balloons in various locations.","nextNodeIds":[736840113]},{"nodeId":736840113,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":951713586,"text":"All that the participating adventurers need to do is to find the Wilderness Balloons according to the prompts and venture forward following the distribution of those balloons.","nextNodeIds":[736840114]},{"nodeId":736840114,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":4160084338,"text":"The more Wilderness Balloons one collects within the time limit, the higher the rating and the greater the rewards will be.","nextNodeIds":[736840115,736840119]},{"nodeId":736840115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":597965042,"text":"What if I accidentally popped the balloons...","nextNodeIds":[736840116]},{"nodeId":736840116,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":3558593794,"text":"These balloons are no ordinary balloons. They can withstand arrows from afar and will only be popped from close range.","nextNodeIds":[736840117]},{"nodeId":736840117,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":1662789458,"text":"When similar events were held before, the first thing most adventurers did when they saw the balloons was to pop them with their arrows. We repeatedly told them not to, but they never listened...","nextNodeIds":[736840118]},{"nodeId":736840118,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":4096111002,"text":"That's why we've customized these special balloons for this event. Hopefully it works...","nextNodeIds":[736840124]},{"nodeId":736840124,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":1148960850,"text":"And please excuse me but I've gotta go now. I still need to recruit quite a few participants for the event...","nextNodeIds":[736840125]},{"nodeId":736840125,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":1847890370,"text":"If you are interested, please do come and participate! If you are willing to take part, I'm sure Jack and Master Cyrus will be thrilled!","nextNodeIds":[]},{"nodeId":736840119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3005720282,"text":"That sounds like just a long-distance race to me...","nextNodeIds":[736840120]},{"nodeId":736840120,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":2327947802,"text":"Erm... Well, Jack said that...","nextNodeIds":[736840121]},{"nodeId":736840121,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":2718766530,"text":"\"Searching for the balloons is a test of the adventurers' observation skills, while venturing forward in different situations is a test of their fundamentals...\"","nextNodeIds":[736840122]},{"nodeId":736840122,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":286319442,"text":"\"And whether they can act according to the prompts is a test of their discipline...\"","nextNodeIds":[736840123]},{"nodeId":736840123,"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","textMapHash":4119099754,"text":"I just joined the Guild, and I don't know much about these things... But since Jack said so, there must be a reason.","nextNodeIds":[736840124]},{"nodeId":736840104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2351963802,"text":"What's the Adventurers' Guild doing...","nextNodeIds":[736840105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30276"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7368401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30276,"speakerName":"Vinkel","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173684],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2180053046,"CHECNJEMEFE":{"30276":[1270]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73684/Q7368401","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":736840101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7368401,"JGFEJP