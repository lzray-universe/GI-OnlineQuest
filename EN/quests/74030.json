xtTalks":[],"npcId":[5214],"performCfg":"QuestDialogue/Q7403001","priority":5,"questId":74030,"showRandomTalkCount":0},"dialogs":[{"nodeId":740300101,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":4184399474,"text":"Hello, what is it?","nextNodeIds":[740300102,740300105]},{"nodeId":740300102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3741261258,"text":"Please help us, good sorceress!","nextNodeIds":[740300103]},{"nodeId":740300103,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":4000195042,"text":"Why are you talking like Lanoire? Just get to the point.","nextNodeIds":[740300104]},{"nodeId":740300104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1962033434,"text":"We need lots of Coupons. Are there any jobs we can take?","nextNodeIds":[740300107]},{"nodeId":740300107,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":758945834,"text":"You didn't join Estienne's game, did you? You should know when to stop.","nextNodeIds":[740300108]},{"nodeId":740300108,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":4073890874,"text":"...Nonetheless, there is something that I need your help with.","nextNodeIds":[740300109]},{"nodeId":740300109,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":1737124922,"text":"Clynes should be repairing his device or whatever it is by the Rift of Erosion. Go help him out, would you?","nextNodeIds":[740300110]},{"nodeId":740300110,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":971882050,"text":"Just ask him for compensation. He won't object.","nextNodeIds":[740300111]},{"nodeId":740300111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3819681914,"text":"We'll take care of it!","nextNodeIds":[]},{"nodeId":740300105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":769699850,"text":"Is there anything we can help with?","nextNodeIds":[740300106]},{"nodeId":740300106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3576822450,"text":"It would be better if there's compensation!","nextNodeIds":[740300107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5214"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7403002,"order":2,"stepDescription":"Find Clynes near the Rift of Erosion","stepDescTextMapHash":2532456340,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7403002],"talks":[{"talkId":7403002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7403002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7403002,"initDialog":740300201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5252],"performCfg":"QuestDialogue/Q7403002","priority":5,"questId":74030,"showRandomTalkCount":0},"dialogs":[{"nodeId":740300201,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3652573882,"text":"Just in time. Come help me out!","nextNodeIds":[740300202,740300206]},{"nodeId":740300202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1322197658,"text":"You can read minds? That's scary!","nextNodeIds":[740300203]},{"nodeId":740300203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":909346194,"text":"Galvaryet sent us to help you... But how did you know that?","nextNodeIds":[740300204]},{"nodeId":740300204,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":112571930,"text":"...Because you're the only ones here to help.","nextNodeIds":[740300205]},{"nodeId":740300205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2053993578,"text":"...Well, that makes sense!","nextNodeIds":[740300210]},{"nodeId":740300210,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3269672794,"text":"Anyway, the task is nothing difficult. The Research Terminal here requires two people to operate it simultaneously, and I've already entered the commands. Just walk over and pull the lever.","nextNodeIds":[740300211]},{"nodeId":740300211,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2369210138,"text":"I almost forgot... The charging device should be nearby. Please install the charging device first before starting.","nextNodeIds":[740300212]},{"nodeId":740300212,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2654320234,"text":"And... Just to double-check, you're not machine killers, are you?","nextNodeIds":[740300213,740300214]},{"nodeId":740300213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2659692834,"text":"It depends on how you define machine killers.","nextNodeIds":[740300215]},{"nodeId":740300215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":83245018,"text":"Why do you ask?","nextNodeIds":[740300216]},{"nodeId":740300216,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":4144945626,"text":"I asked Galvana for help last time, and even though I only looked away for a moment, when I looked back, the terminal was already destroyed. I asked her what happened, but she couldn't tell me.","nextNodeIds":[740300217]},{"nodeId":740300217,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2720627290,"text":"I found out from her sister later that no machines can survive under her for more than half a day. Even Alain Guillotin would have given up on her, I suspect.","nextNodeIds":[740300218]},{"nodeId":740300218,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3685516074,"text":"Even the repair fee was deducted from my compensation. If you're just like her, then all my hard work will be in vain.","nextNodeIds":[740300219]},{"nodeId":740300219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2601444218,"text":"What a story. We're definitely not like her. Don't worry!","nextNodeIds":[740300220]},{"nodeId":740300220,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1442437562,"text":"I'm counting on you, then.","nextNodeIds":[]},{"nodeId":740300214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1965049474,"text":"If the research terminal attacks me, then I guess I am.","nextNodeIds":[740300215]},{"nodeId":740300206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4066280962,"text":"We won't do this for free, though.","nextNodeIds":[740300207]},{"nodeId":740300207,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":199230970,"text":"I'll ask Galvaryet to apply for your payment later.","nextNodeIds":[740300208]},{"nodeId":740300208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3049975066,"text":"Huh? She said we can get compensation from you directly.","nextNodeIds":[740300209]},{"nodeId":740300209,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":4089447226,"text":"Did she? Alright, then. Applying for funds here is even harder than from the Fontaine Research Institute...","nextNodeIds":[740300210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7403003,"order":3,"stepDescription":"Help Clynes operate the terminal","stepDescTextMapHash":2865124692,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7403003"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["133408109","109002","4359.9:188.74:4788.602"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_GADGET"},"isHidden":false,"talkIds":[7403003],"talks":[{"talkId":7403003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPri