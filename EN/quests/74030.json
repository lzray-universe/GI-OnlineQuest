NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7403004,"initDialog":740300401,"nextRandomTalks":[],"nextTalks":[],"npcId":[5252],"performCfg":"QuestDialogue/Q7403004","priority":5,"questId":74030,"showRandomTalkCount":0},"dialogs":[{"nodeId":740300401,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":4199963274,"text":"Looking good. If we weren't in a place like this, I would have hired you as my assistants.","nextNodeIds":[740300402]},{"nodeId":740300402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":799642570,"text":"This is too easy. By the way, what does this device do?","nextNodeIds":[740300403]},{"nodeId":740300403,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2830970330,"text":"There was a rift that connected to the outside, and it had to be watched. Now we can just seal the passage with this device and save manpower.","nextNodeIds":[740300404]},{"nodeId":740300404,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1583920074,"text":"This is nothing new to the Fontaine Research Institute, anyway. But since I have plenty of time, I modified it a little.","nextNodeIds":[740300405]},{"nodeId":740300405,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1305397986,"text":"What you're seeing now isn't even its final form, which was actually deployed at the Geode Mine Shaft... Ahem, I think I spoke too much. Just pretend you didn't hear anything.","nextNodeIds":[740300406,740300408]},{"nodeId":740300406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2947782282,"text":"So, there are exits in the Geode Mine Shaft.","nextNodeIds":[740300407]},{"nodeId":740300407,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2328239866,"text":"Right, you're a smart one. But if you were smarter, you would have kept that to yourself and not blurted it out.","nextNodeIds":[740300411]},{"nodeId":740300411,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":4040063906,"text":"Anyway, problem solved. Galvana no longer needs to come down too often, and I can take a break.","nextNodeIds":[740300412]},{"nodeId":740300412,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":236459562,"text":"...Ah, yes. I almost forgot about your compensation. Thanks for the help!","nextNodeIds":[]},{"nodeId":740300408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3956094370,"text":"Is the final version more powerful?","nextNodeIds":[740300409]},{"nodeId":740300409,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3534109434,"text":"Of course! There are other components... Wait, why do you want to know?","nextNodeIds":[740300410]},{"nodeId":740300410,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2857143962,"text":"If you want to know the full extent of it, you can give it a try yourself. But if you're caught, don't say I put you up to it.","nextNodeIds":[740300411]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403004,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["74025","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["7403001","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_