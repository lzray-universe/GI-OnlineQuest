Id":70659,"showRandomTalkCount":0},"dialogs":[{"nodeId":706590101,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1719550370,"text":"Hey there, fancy trying your hand at Windtrace?","nextNodeIds":[706590102]},{"nodeId":706590102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1759033434,"text":"What's Windtrace?","nextNodeIds":[706590103]},{"nodeId":706590103,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1148747178,"text":"I'm glad you asked. Windtrace is a game that's all about Mondstadt's history!","nextNodeIds":[706590104]},{"nodeId":706590104,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3300261546,"text":"I suppose you've heard of the aristocrats who once lived in Mondstadt City?","nextNodeIds":[706590105]},{"nodeId":706590105,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3489965594,"text":"They were tyrants, and their rule was brutal. Words cannot do justice to the way that people suffered at their hands...","nextNodeIds":[706590106]},{"nodeId":706590106,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":2867460922,"text":"To fight back against their oppression, a group of brave citizens came together and formed an underground resistance.","nextNodeIds":[706590107]},{"nodeId":706590107,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4202225946,"text":"These valiant rebels engaged in operations throughout the city, becoming a major thorn in the side of the aristocrats.","nextNodeIds":[706590108]},{"nodeId":706590108,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4213991474,"text":"But the aristocrats retaliated, quickly training up their own team of henchmen to suppress the rebels.","nextNodeIds":[706590109]},{"nodeId":706590109,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":293690162,"text":"And so, the rebels fought duel after duel with the aristocrats' lackeys all across Mondstadt.","nextNodeIds":[706590110]},{"nodeId":706590110,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":604620394,"text":"Windtrace takes its inspiration from this thrilling chapter of Mondstadt's history! And it used to be quite popular, too...","nextNodeIds":[706590111]},{"nodeId":706590111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":833169242,"text":"Used to be?","nextNodeIds":[706590112]},{"nodeId":706590112,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1714739618,"text":"Sadly, yes. Young people these days don't seem very interested in the game...","nextNodeIds":[706590113]},{"nodeId":706590113,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1795684402,"text":"But I can't let Windtrace fade into obscurity. So, I tweaked the rules a little to make it easier to get into and more fun.","nextNodeIds":[706590114]},{"nodeId":706590114,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1281238570,"text":"I also added a whole load of brand-new maps in. Hopefully, this will help to attract more people...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7065901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30051","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7065902,"order":2,