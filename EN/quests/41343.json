ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4134301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4134301,"initDialog":413430101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2082],"performCfg":"","priority":11,"questId":41343,"showRandomTalkCount":0},"dialogs":[{"nodeId":413430101,"roleType":"TALK_ROLE_NPC","speakerId":2046,"speakerName":"Geri","textMapHash":2893787658,"text":"But how do we make Xiao Lanterns? Do you have any idea, Freki?","nextNodeIds":[413430102]},{"nodeId":413430102,"roleType":"TALK_ROLE_NPC","speakerId":2082,"speakerName":"Freki","textMapHash":1274496138,"text":"Nope, no idea... Should we get someone else to make one for us?","nextNodeIds":[413430103]},{"nodeId":413430103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2709939282,"text":"So, you two want to release a Xiao Lantern, too?","nextNodeIds":[413430104]},{"nodeId":413430104,"roleType":"TALK_ROLE_NPC","speakerId":2082,"speakerName":"Freki","textMapHash":2576727954,"text":"Oh, it's you, Traveler. And yes, we were thinking about doing just that.","nextNodeIds":[413430105]},{"nodeId":413430105,"roleType":"TALK_ROLE_NPC","speakerId":2082,"speakerName":"Freki","textMapHash":1402682914,"text":"We originally intended to try out the food available during the Lantern Rite. But Geri said that he also wanted to release a lantern to catch a bit of that festive spirit.","nextNodeIds":[413430106]},{"nodeId":413430106,"roleType":"TALK_ROLE_NPC","speakerId":2046,"speakerName":"Geri","textMapHash":936598930,"text":"W—Well, yes! I mean, you have to immerse yourself in the festive spirit first, then eat some festive food. That's the proper way to experience it!","nextNodeIds":[413430107]},{"nodeId":413430107,"roleType":"TALK_ROLE_NPC","speakerId":2082,"speakerName":"Freki","textMapHash":2695392506,"text":"I've also heard that you can wish on those lanterns, or something... Neither of us knows how to make one, though.","nextNodeIds":[413430108]},{"nodeId":413430108,"roleType":"TALK_ROLE_NPC","speakerId":2082,"speakerName":"Freki","textMapHash":2809577274,"text":"Traveler, could we trouble you to make one of these Xiao Lanterns for us?","nextNodeIds":[413430109]},{"nodeId":413430109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3425295682,"text":"I'm on it.","nextNodeIds":[413430110]},{"nodeId":413430110,"roleType":"TALK_ROLE_NPC","speakerId":2082,"speakerName":"Freki","textMapHash":610342506,"text":"Wonderful! We'll wait for you here, then.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4134301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMM