AINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7273201],"talks":[{"talkId":7273201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7273201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7273201,"initDialog":727320101,"nextRandomTalks":[],"nextTalks":[],"npcId":[13087],"performCfg":"QuestDialogue/WQ/Daoqi_72732/Q7273201","priority":5,"questId":72732,"showRandomTalkCount":0},"dialogs":[{"nodeId":727320101,"roleType":"TALK_ROLE_NPC","speakerId":13087,"speakerName":"Pain-Grocer","textMapHash":3594728498,"text":"Arataki Gang, I'm here to duel!","nextNodeIds":[727320102]},{"nodeId":727320102,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2562234098,"text":"Oh, what now? Has Grandmaster Hanakado sent another kid to challenge me?","nextNodeIds":[727320103]},{"nodeId":727320103,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3197473194,"text":"Is he running out of people? 'Cause this is some serious bottom-of-the-barrel material.","nextNodeIds":[727320104]},{"nodeId":727320104,"roleType":"TALK_ROLE_NPC","speakerId":13087,"speakerName":"Pain-Grocer","textMapHash":2072410818,"text":"...It's not you I'm after.","nextNodeIds":[727320105]},{"nodeId":727320105,"roleType":"TALK_ROLE_NPC","speakerId":13087,"speakerName":"Pain-Grocer","textMapHash":2179258770,"text":"Empty vessels make the most noise.","nextNodeIds":[727320106]},{"nodeId":727320106,"roleType":"TALK_ROLE_NPC","speakerId":13087,"speakerName":"Pain-Grocer","textMapHash":840791642,"text":"#This {M#blond guy}{F#blonde gal}, on the other hand, looks like a strong and able warrior. I take it that {M#he}{F#she}'s the real leader of the Arataki Gang.","nextNodeIds":[727320107]},{"nodeId":727320107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2724651706,"text":"#Hahaha! Now that's what Paimon calls a good judge of character! Go on, praise {M#him}{F#her} some more!","nextNodeIds":[727320108]},{"nodeId":727320108,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":638647146,"text":"Hey, hey! What are you two talking about?","nextNodeIds":[727320109]},{"nodeId":727320109,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3395558298,"text":"#My compadre here is strong, for sure, but {M#he}{F#she}'s just outside help. Make no mistake, there's only ever been one leader of the Arataki Gang, and that is yours truly, Arataki Itto!","nextNodeIds":[727320110,727320111]},{"nodeId":727320110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2541991530,"text":"So should I be called the Oni King's Temporary Right Hand?","nextNodeIds":[727320112]},{"nodeId":727320112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3747954090,"text":"Hey, nice idea! The Arataki Gang may not be the strongest gang in the world, but being a leader would still be pretty cool!","nextNodeIds":[727320113]},{"nodeId":727320113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1006830482,"text":"If it's cool with you, Paimon could be called Arataki-for-3-Days-Only Paimon, or Paimon, Temporary Leader of the Arataki Gang!","nextNodeIds":[727320114]},{"nodeId":727320114,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":431123082,"text":"Hey, hey, hey! Don't let your opponent lead you astray! She's clearly just... just trying to sow discord, yeah! Okay? All part of a nefarious plot to turn us against each other!","nextNodeIds":[727320115]},{"nodeId":727320115,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":291870130,"text":"Just wait till I defeat her boss! She'll be begging to take back her words!","nextNodeIds":[727320116]},{"nodeId":727320116,"roleType":"TALK_ROLE_NPC","speakerId":13087,"speakerName":"Pain-Grocer","textMapHash":1238309514,"text":"Don't flatter yourself. I don't care about the Arataki Gang's internal affairs. I just want to battle strong opponents!","nextNodeIds":[727320117]},{"nodeId":727320117,"roleType":"TALK_ROLE_NPC","speakerId":13087,"speakerName":"Pain-Grocer","textMapHash":3827688690,"text":"Let's see just how good blondie here is at beetle fighting!","nextNodeIds":[]},{"nodeId":727320111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2911604610,"text":"Can't you just let me be the leader for a few days?","nextNodeIds":[727320112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7273201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133209112"],"PAINLIBBLDK":"QUEST_EXEC_REGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13087"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7273201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13087,"speakerName":"Pain-Grocer","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2139972694,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Daoqi_72732/Q7273201","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":727320101,"ILHDCGDKKKA":"