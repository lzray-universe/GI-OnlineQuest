QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7068701],"talks":[{"talkId":7068701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7068701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7068701,"initDialog":706870101,"nextRandomTalks":[],"nextTalks":[],"npcId":[9500],"performCfg":"QuestDialogue/WQ/Mengde_70687/Q7068701","priority":5,"questId":70687,"showRandomTalkCount":0},"dialogs":[{"nodeId":706870101,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3550560498,"text":"Hello, dear guests! Please, right this way!","nextNodeIds":[706870102]},{"nodeId":706870102,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2803911978,"text":"An certain astrologically-adept friend of Madame Mage has prepared you a gift!","nextNodeIds":[706870103]},{"nodeId":706870103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1340264914,"text":"Whoa! What a sparkly crystal ball! Looks expensive, too... How much do you think Margaret would pay for it? Ten million — no, twenty million Mora!?","nextNodeIds":[706870104]},{"nodeId":706870104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1373773730,"text":"Umm... Sorry, Paimon was just messing around! Anyway, what's it for?","nextNodeIds":[706870105]},{"nodeId":706870105,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2587329122,"text":"In the words of Madame Mage's friend: \"Where there are mages, one must surely have crystal balls worth the name.\" With its help, my dear guests will be able to set foot on a wonderful new stage...","nextNodeIds":[706870106]},{"nodeId":706870106,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":129667002,"text":"Now, I'm not really sure what she meant — I am just the concierge, after all! All I ever see when staring into a crystal ball is my reflection...","nextNodeIds":[706870107]},{"nodeId":706870107,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2896881706,"text":"Ah, right! There's also this box, another gift from Madame Mage!","nextNodeIds":[706870108]},{"nodeId":706870108,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3707717138,"text":"\"If you can put on a spectacular performance on this hidden stage, one as unpredictable as the tides of fate themselves, you shall discover the wondrous treasures this little box contains\"... At least, that's what she told me.","nextNodeIds":[706870109]},{"nodeId":706870109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3812898434,"text":"T—Treasures?!","nextNodeIds":[706870110]},{"nodeId":706870110,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1648560794,"text":"Well, that's all from me! It wouldn't be sporting for the concierge to spoil the intrigue for you all, dear guests. So please, take the stage in your usual gallant fashion!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7068701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["48000","248000001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":48000,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7068701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170687],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":169216454,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70687/Q7068701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"D