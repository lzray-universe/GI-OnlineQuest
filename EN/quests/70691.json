STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10090"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7069101],"talks":[{"talkId":7069101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7069101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7069101,"initDialog":706910101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1040,10090,30893],"performCfg":"QuestDialogue/WQ/DPEQ_70691/Q7069101","priority":5,"questId":70691,"showRandomTalkCount":0},"dialogs":[{"nodeId":706910101,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":3363250410,"text":"#{M#Mr. Honorary Knight}{F#Miss Honorary Knight}! Over here, over here!","nextNodeIds":[706910102]},{"nodeId":706910102,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":1842661274,"text":"Klee just made some new friends! Wanna come play with us?","nextNodeIds":[706910103]},{"nodeId":706910103,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":2346045002,"text":"They taught us a new game called Snowtrace.","nextNodeIds":[706910104]},{"nodeId":706910104,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":389182930,"text":"The rules aren't hard. It's just a very special kind of hide-and-seek!","nextNodeIds":[706910105]},{"nodeId":706910105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2986912618,"text":"Aww! Klee, Yaoyao, and Sayu, so you've all become friends!","nextNodeIds":[706910106]},{"nodeId":706910106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3796757762,"text":"From the name alone, this game sounds like an upgraded version of Windtrace, huh? Hehe, Paimon can't wait to play with you!","nextNodeIds":[706910107,706910108]},{"nodeId":706910107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":714514482,"text":"Hide-and-seek? Awesome!","nextNodeIds":[706910109]},{"nodeId":706910109,"roleType":"TALK_ROLE_NPC","speakerId":1040,"speakerName":"Sayu","textMapHash":1588392170,"text":"Achoo... Even though it isn't that cold at the camp, I'm still feeling a little sleepy...","nextNodeIds":[706910110]},{"nodeId":706910110,"roleType":"TALK_ROLE_NPC","speakerId":1040,"speakerName":"Sayu","textMapHash":1992539818,"text":"#Hmm? Are my eyes playing tricks on me, or do I see {NICKNAME} and Paimon?","nextNodeIds":[706910111]},{"nodeId":706910111,"roleType":"TALK_ROLE_NPC","speakerId":30893,"speakerName":"Yaoyao","textMapHash":2733998386,"text":"#Your eyes are working perfectly fine. That's {NICKNAME} and Paimon alright.","nextNodeIds":[706910112,706910113]},{"nodeId":706910112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2934783314,"text":"Hey there, Yaoyao! Hey there, Sayu!","nextNodeIds":[706910114]},{"nodeId":706910114,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":1839417914,"text":"Good idea! Once we get moving and start having fun, we won't doze off that easily!","nextNodeIds":[706910115]},{"nodeId":706910115,"roleType":"TALK_ROLE_NPC","speakerId":30893,"speakerName":"Yaoyao","textMapHash":2340270842,"text":"And didn't that awfully serious Miss Sumire say that spending more time in the snowy mountains would be good for your skills, Sayu?","nextNodeIds":[706910116]},{"nodeId":706910116,"roleType":"TALK_ROLE_NPC","speakerId":1040,"speakerName":"Sayu","textMapHash":1502834138,"text":"Ugh, I can't believe you guys remembered that!","nextNodeIds":[706910117]},{"nodeId":706910117,"roleType":"TALK_ROLE_NPC","speakerId":1040,"speakerName":"Sayu","textMapHash":3465959922,"text":"Alright... But if I lose to my peers or even to that super Ninken, slacking off is going to get a lot more difficult in the future.","nextNodeIds":[706910118]},{"nodeId":706910118,"roleType":"TALK_ROLE_NPC","speakerId":1040,"speakerName":"Sayu","textMapHash":1068428090,"text":"Looks like I'm really going to have to pull up my socks on this trip.","nextNodeIds":[706910119]},{"nodeId":706910119,"roleType":"TALK_ROLE_NPC","speakerId":30893,"speakerName":"Yaoyao","textMapHash":4254005522,"text":"And don't you worry! I came up with a new Goulash recipe using Jueyun Chili and ground pepper, and I just made some.","nextNodeIds":[706910120]},{"nodeId":706910120,"roleType":"TALK_ROLE_NPC","speakerId":30893,"speakerName":"Yaoyao","textMapHash":1932092698,"text":"Take a few bites of it before you start. I promise you won't feel cold at all during the game.","nextNodeIds":[706910121]},{"nodeId":706910121,"roleType":"TALK_ROLE_NPC","speakerId":1040,"speakerName":"Sayu","textMapHash":986738418,"text":"That sounds great! Hang on, I'll have a whole bowl first!","nextNodeIds":[706910122]},{"nodeId":706910122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2124433194,"text":"Paimon wants some too!","nextNodeIds":[706910123]},{"nodeId":706910123,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":26414546,"text":"Alright then, let's get our game of hide-and-seek started here in the snowy mountain!","nextNodeIds":[706910124]},{"nodeId":706910124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3067077714,"text":"Hehe! The whole mountain's covered in snow — it's the perfect hiding spot for Paimon!","nextNodeIds":[]},{"nodeId":706910113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4230797058,"text":"Want to play hide-and-seek?","nextNodeIds":[706910114]},{"nodeId":706910108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1615417186,"text":"I'd love to meet Klee's new friends too!","nextNodeIds":[706910109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARG