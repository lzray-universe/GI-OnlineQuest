ron sold me out, the little scamp...)","nextNodeIds":[401730511]},{"nodeId":401730511,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","textMapHash":1873005482,"text":"#(Still... {F#s}he remembered, that's gotta mean something, right? Why make a note of some mundane detail like that?)","nextNodeIds":[401730512]},{"nodeId":401730512,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","textMapHash":590013058,"text":"#(Ugh, focus! {F#She}{M#He} asked me a question! Umm, umm, umm... Argh, how do I respond?)","nextNodeIds":[401730513]},{"nodeId":401730513,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","textMapHash":3541858106,"text":"Ahem...","nextNodeIds":[401730514]},{"nodeId":401730514,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","textMapHash":3164431330,"text":"Sure, why not. I should have some time later. I'll let you know.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4017601,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_ANY_MANUAL_TRANSPORT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4017305],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"Citlali","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":