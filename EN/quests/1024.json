eak of numbers here.","nextNodeIds":[10210305]},{"nodeId":10210305,"roleType":"TALK_ROLE_NPC","speakerId":2456,"speakerName":"Bu'yun","textMapHash":2933890025,"text":"Ah, well said. Please, use this to ascend to the Chamber... Ah, yes. Speaking of which — are you two the guests that Lady Ningguang has arranged to meet with today?","nextNodeIds":[10210306]},{"nodeId":10210306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":972690561,"text":"Yup!","nextNodeIds":[10210307]},{"nodeId":10210307,"roleType":"TALK_ROLE_NPC","speakerId":2456,"speakerName":"Bu'yun","textMapHash":2523415529,"text":"(And yet the code they used was not the one for guests, but for the Yuheng. What's going on here...)","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102408,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["10009","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2456"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":102401,"order":3,"stepDescription":"","stepDescTextMapHash":617709662,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102,185],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":"3"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"