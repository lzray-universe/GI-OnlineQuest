{"mainQuestId":75670,"title":"Saurian Sojourn","description":"One day, while visiting the Children of Echoes, you meet a couple of people...","titleTextMapHash":2597826903,"descTextMapHash":3760646310,"mainQuestExcel":{"mainQuestId":75670,"titleTextMapHash":2597826903,"title":"Saurian Sojourn","descTextMapHash":3760646310,"description":"One day, while visiting the Children of Echoes, you meet a couple of people...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5295,"luaPath":"Actor/Quest/WQ75670","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5295,"chapterId":0,"descTextMapHash":3760646310,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75670,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":4096069169,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75670","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175670],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2597826903,"type":"WQ","unlockDescTextMapHash":751019974}},"flow":[{"subQuestId":7567001,"order":1,"stepDescription":"Talk to Komina and Kweku","stepDescTextMapHash":1167849708,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7567001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30879"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7567001],"talks":[{"talkId":7567001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7567001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7567001,"initDialog":756700101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30879,30883,30880],"performCfg":"QuestDialogue/WQ/HumanDragonPuzzle_75670/Q7567001","priority":5,"questId":75670,"showRandomTalkCount":0},"dialogs":[{"nodeId":756700101,"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"Komina","textMapHash":2812985506,"text":"Everything aside from the high-altitude training is now complete, sir.","nextNodeIds":[756700102]},{"nodeId":756700102,"roleType":"TALK_ROLE_NPC","speakerId":30883,"speakerName":"Assistant Instructor Yehyeh","textMapHash":2019346810,"text":"Yeh!","nextNodeIds":[756700103]},{"nodeId":756700103,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":1958726010,"text":"Excellent. You both sound ready to roll!","nextNodeIds":[756700104]},{"nodeId":756700104,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":436350282,"text":"The Children of Echoes will be the first strategic objective in our grand plan. After that, we'll systematically infiltrate the People of the Springs and the Scions of the Canopy...","nextNodeIds":[756700105]},{"nodeId":756700105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1929713442,"text":"Woah, woah, woah! What in the world are you talking about, Kweku?","nextNodeIds":[756700106]},{"nodeId":756700106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":154452938,"text":"Sounds like you've started a shadowy espionage organization.","nextNodeIds":[756700107]},{"nodeId":756700107,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":970408578,"text":"#Huh? Looks like our hero, {NICKNAME}, and {M#his}{F#her} companion, Paimon, are here!","nextNodeIds":[756700108]},{"nodeId":756700108,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":2726719386,"text":"Espionage organization? Ahahahaha! We're just here to share a few tips on how to have fun interactions with saurians.","nextNodeIds":[756700109]},{"nodeId":756700109,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":1087155842,"text":"Komina is our on-site doctor. She'll go with our participants to ensure their safety.","nextNodeIds":[756700110]},{"nodeId":756700110,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":1876382964,"text":"And this is Assistant Instructor Yehyeh, who's helping out by special request. Yehyeh really came through for us when we were setting the stage objectives!","nextNodeIds":[756700111]},{"nodeId":756700111,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":2081246434,"text":"As for me, well, I'm the Chief Instructor — to put it simply, I'm the organizer. You caught me giving the team a little pep talk just now...","nextNodeIds":[756700112,756700113]},{"nodeId":756700112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1273465146,"text":"Thank goodness it was all a misunderstanding...","nextNodeIds":[756700114]},{"nodeId":756700114,"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"Komina","textMapHash":4087014954,"text":"I'm sorry, it's all my fault! When I heard that Mr. Kweku was engaged in such a meaningful undertaking, I suggested he adopt more \"formal\" language to describe it... I guess that suggestion backfired.","nextNodeIds":[756700115]},{"nodeId":756700115,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":2302934010,"text":"Ha! No need to apologize, Miss Komina. Both Assistant Instructor Yehyeh and I love the titles you've come up with for us. Isn't that so, Assistant Instructor Yehyeh?","nextNodeIds":[756700116]},{"nodeId":756700116,"roleType":"TALK_ROLE_NPC","speakerId":30883,"speakerName":"Assistant Instructor Yehyeh","textMapHash":4236497074,"text":"Waaah... Yeh!!!","nextNodeIds":[756700117]},{"nodeId":756700117,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":3851667314,"text":"#See? ...Oh, by the way, would you like to give these stages a try too, {NICKNAME}? They might be a little easy for you, but you should still find them interesting.","nextNodeIds":[756700118]},{"nodeId":756700118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1489500210,"text":"What does it entail...?","nextNodeIds":[756700119]},{"nodeId":756700119,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":404523178,"text":"It's really simple — you work together with various saurians to complete the objectives we've set. The most important thing here is trust and teamwork between you and your saurian companions.","nextNodeIds":[756700120]},{"nodeId":756700120,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":1850361114,"text":"You won't be able to complete all the objectives on your own, so make sure to pay close attention to your saurian companions at all times.","nextNodeIds":[756700121]},{"nodeId":756700121,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","textMapHash":625701610,"text":"Oh, and one more thing — we won't be traveling with the qucusaurs this time, as we don't have the necessary high-altitude safety gear just yet. Safety is our number one priority, after all!","nextNodeIds":[756700122]},{"nodeId":756700122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2600009970,"text":"#Woohoo! Let's give it a go, {NICKNAME}! You're the master of working with others!","nextNodeIds":[756700123,756700124]},{"nodeId":756700123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4017356674,"text":"I'll give it a shot.","nextNodeIds":[756700125]},{"nodeId":756700125,"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"Komina","textMapHash":851745226,"text":"#Awesome... If word gets out that {NICKNAME} is here, everyone will want to have a go!","nextNodeIds":[756700126]},{"nodeId":756700126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3715475498,"text":"Huh? Then shouldn't Komina give us a \"formal\" title, too? You know, something formidable-sounding, hehe...","nextNodeIds":[756700127]},{"nodeId":756700127,"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"Komina","textMapHash":2005070738,"text":"Well, I'm going to have to think this over carefully...","nextNodeIds":[]},{"nodeId":756700124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2480279506,"text":"Anything for Paimon.","nextNodeIds":[756700125]},{"nodeId":756700113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2574242274,"text":"I was this close to reporting you...","nextNodeIds":[756700114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7567001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30879"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7567001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"Kweku","count":12},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"Komina","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":30883,"speakerName":"Assistant Instructor Yehyeh","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[175670],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFG