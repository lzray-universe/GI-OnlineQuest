761105,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":2670752018,"text":"Each masterless lantern, therefore, is a marker of misfortune, a tragedy that fills me with sorrow.","nextNodeIds":[760761106]},{"nodeId":760761106,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":1469915570,"text":"But they knew that such would be their inevitable fate from the moment they made their oaths.","nextNodeIds":[760761107]},{"nodeId":760761107,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":1235052026,"text":"If there was anything else we could do for them, it would be remembering the oaths they made.","nextNodeIds":[760761108]},{"nodeId":760761108,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","textMapHash":1104175482,"text":"To bear and defend \"lanterns alight with eternal hope\"... That was their dearest wish.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607611,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133601376"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1314"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7607611],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"Flins","count":7},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[176076],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":