P":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5019"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400101],"talks":[{"talkId":2400101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400101,"initDialog":240010101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5019,5113],"performCfg":"QuestDialogue/IQ/Fontaine_24001/Q2400101","priority":5,"questId":24001,"showRandomTalkCount":0},"dialogs":[{"nodeId":240010101,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":1007774634,"text":"Please, help me out! I was just thinking about the novel's story, and before I knew it, Barea was just gone!","nextNodeIds":[240010102]},{"nodeId":240010102,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":529549082,"text":"Are you sure you didn't leave it at your seat in the opera house, or left it tied to the restroom door, or something?","nextNodeIds":[240010103]},{"nodeId":240010103,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":527065362,"text":"I've already searched all those areas. I've even looked under that seat, but Barea wasn't there.","nextNodeIds":[240010104]},{"nodeId":240010104,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":3596217642,"text":"Oh, the mere thought of it, that my little Barea would be kidnapped by someone, or perhaps follow someone blindly as if stricken by puppy love...","nextNodeIds":[240010105]},{"nodeId":240010105,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":4294733242,"text":"Ms. Staelle, I'm quite sure that Barea wouldn't make the same mistake twice like that.","nextNodeIds":[240010106]},{"nodeId":240010106,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":2542264882,"text":"Ah, but my Barry-boo is still so little... and little children make the same errors many times, and even revel in it, right?","nextNodeIds":[240010107]},{"nodeId":240010107,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":1701796274,"text":"I'm... quite certain that Barea is not as young as you say.","nextNodeIds":[240010108,240010109]},{"nodeId":240010108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1390677090,"text":"And who's this Barea, if I might ask?","nextNodeIds":[240010110]},{"nodeId":240010110,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":3232191610,"text":"Ms. Staelle's dog...","nextNodeIds":[240010111]},{"nodeId":240010111,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":2986717442,"text":"My family.","nextNodeIds":[240010112]},{"nodeId":240010112,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":4226778186,"text":"Yep. Her family has gone missing, and she's asking for my help.","nextNodeIds":[240010113]},{"nodeId":240010113,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":2620210626,"text":"Ms. Staelle, we have already searched this area once. I would wager that Barea has headed off into the wilds.","nextNodeIds":[240010114]},{"nodeId":240010114,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":3302982610,"text":"Then let us go there too!","nextNodeIds":[240010115]},{"nodeId":240010115,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":4175330634,"text":"Please, Miss, I ask you to stay in the city. With the dress you wear, you would not be able to catch Barea even if you found it.","nextNodeIds":[240010116]},{"nodeId":240010116,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":4003204466,"text":"Nonsense! Why, Barea would jump into my arms if it so much as saw me!","nextNodeIds":[240010117]},{"nodeId":240010117,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":2139652674,"text":"Then I suppose it heard us not when we were calling up and down the theater, yes?","nextNodeIds":[240010118]},{"nodeId":240010118,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":3387537202,"text":"Well, there you have it. I'm afraid I cannot bring Barea back to Ms. Staelle alone.","nextNodeIds":[240010119]},{"nodeId":240010119,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":2388746298,"text":"I cannot simply leave my post for long, much less ask another colleague to leave theirs with me.","nextNodeIds":[240010120]},{"nodeId":240010120,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":3383726562,"text":"But if you're willing, Traveler, could you help us both out?","nextNodeIds":[240010121,240010122]},{"nodeId":240010121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2360446874,"text":"Well, it wouldn't be a problem, per se...","nextNodeIds":[240010124]},{"nodeId":240010124,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":2142616546,"text":"Well, that's settled, then. Please come with me to the wilds — we shall look for Barea together.","nextNodeIds":[240010125]},{"nodeId":240010125,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":770244418,"text":"Considering its weight and stamina, it cannot have run too far.","nextNodeIds":[240010126]},{"nodeId":240010126,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":1253088178,"text":"What!? My Barea is most healthy, thank you!","nextNodeIds":[240010127]},{"nodeId":240010127,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":751914146,"text":"I would agree — if we were talking about its mental health.","nextNodeIds":[240010128]},{"nodeId":240010128,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":2048455498,"text":"Let us be off — lest Barea gain a taste for the outdoors and run still further away.","nextNodeIds":[240010129]},{"nodeId":240010129,"roleType":"TALK_ROLE_NPC","speakerId":5019,"speakerName":"Staelle","textMapHash":607197322,"text":"Hey!","nextNodeIds":[]},{"nodeId":240010122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":876459266,"text":"You police need to deal with this stuff too?","nextNodeIds":[240010123]},{"nodeId":240010123,"roleType":"TALK_ROLE_NPC","speakerId":5113,"speakerName":"Blathine","textMapHash":3798190898,"text":"If the citizens of the Court of Fontaine ask me for help, I have no reason to refuse them.","nextNodeIds":[240010124]},{"nodeId":240010109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":8505210,"text":"How may I assist thee?","nextNodeIds":[240010110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5019"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2400102,"order":2,"stepDescription":"Follow Blathine","stepDescTextMapHash":3025374588,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400102,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5113"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400105],"talks":[{"talkId":2400105,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"pa