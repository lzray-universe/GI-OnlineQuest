{"mainQuestId":76051,"title":"The Artist By the Moon's Side (II)","description":"The Damselette is having a spot of trouble in the Silvermoon Hall...","titleTextMapHash":2964445015,"descTextMapHash":2080326478,"mainQuestExcel":{"mainQuestId":76051,"titleTextMapHash":2964445015,"title":"The Artist By the Moon's Side (II)","descTextMapHash":2080326478,"description":"The Damselette is having a spot of trouble in the Silvermoon Hall...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76051","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":2080326478,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"UI_QuestSign_FlowerLand","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76051,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":536904753,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76051","mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2964445015,"type":"WQ","unlockDescTextMapHash":3616171726}},"flow":[{"subQuestId":7605101,"order":1,"stepDescription":"Meet The Damselette","stepDescTextMapHash":2351901548,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7605101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7605101],"talks":[{"talkId":7605101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7605101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7605101,"initDialog":760510101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76049/Q7605101","priority":5,"questId":76051,"showRandomTalkCount":0},"dialogs":[{"nodeId":760510101,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3765214122,"text":"#{NICKNAME}, Paimon...","nextNodeIds":[760510102]},{"nodeId":760510102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1402672274,"text":"What's wrong, Columbina? You look like something's troubling you.","nextNodeIds":[760510103]},{"nodeId":760510103,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2335980122,"text":"Do you have any paint with you?","nextNodeIds":[760510104]},{"nodeId":760510104,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":1170425202,"text":"!!!","nextNodeIds":[760510105]},{"nodeId":760510105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1093265850,"text":"Oh! You're... Maalaus, right?","nextNodeIds":[760510106]},{"nodeId":760510106,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":2535975738,"text":"~!","nextNodeIds":[760510107]},{"nodeId":760510107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3842815842,"text":"In the mood for more painting, huh? Looks like you got most of the paint on yourself, though... How did that happen?","nextNodeIds":[760510108]},{"nodeId":760510108,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2087635258,"text":"Maalaus left for a bit and came back like this. I anticipate this paint will take quite some time to wash off.","nextNodeIds":[760510109]},{"nodeId":760510109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4107390730,"text":"Huh, maybe Maalaus ran into trouble while out searching for inspiration...","nextNodeIds":[760510110]},{"nodeId":760510110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2382902874,"text":"Still, this isn't a bad look at all. Very fitting for an artist!","nextNodeIds":[760510111]},{"nodeId":760510111,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":2688938602,"text":"??","nextNodeIds":[760510112]},{"nodeId":760510112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":518300282,"text":"Oh, and about the paint... We just need to give Maalaus colorful things, right? Like last time?","nextNodeIds":[760510113]},{"nodeId":760510113,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":2641978250,"text":"~~!","nextNodeIds":[760510114]},{"nodeId":760510114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3902977946,"text":"Hehe, now that's one happy kuuhenki. Maalaus must've hit on some really good ideas... Something fun and upbeat for sure!","nextNodeIds":[760510115]},{"nodeId":760510115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2923081370,"text":"Let's find some warm, happy colors this time!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7605101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7605102,"order":2,"stepDescription":"Give the kuuhenki some objects with vivid colors","stepDescTextMapHash":3204190324,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7605101,0],"PAINLIBBLDK":"QUEST_CONTEN