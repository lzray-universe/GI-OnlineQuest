ID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7605103","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7605103,"initDialog":760510301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76049/Q7605103","priority":5,"questId":76051,"showRandomTalkCount":0},"dialogs":[{"nodeId":760510301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1103475522,"text":"That should do it, right?","nextNodeIds":[760510302]},{"nodeId":760510302,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":2268447154,"text":"~~!","nextNodeIds":[760510303]},{"nodeId":760510303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2037053882,"text":"Oh! There she goes, painting away already!","nextNodeIds":[760510304]},{"nodeId":760510304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2180790050,"text":"Ahem... Dear judges, prepare to be amazed! What kind of masterpiece will our talented kuuhenki artist bring us toda—","nextNodeIds":[760510305]},{"nodeId":760510305,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":2410969290,"text":"!!!","nextNodeIds":[760510306]},{"nodeId":760510306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2685673522,"text":"Huh? You're done already!? Paimon didn't even get to finish her intro...!","nextNodeIds":[760510307]},{"nodeId":760510307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3884815714,"text":"Well, let's see here. Oh! Another drawing of Columbina. No surprise there!","nextNodeIds":[760510308,760510309]},{"nodeId":760510308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":471481794,"text":"It's beautiful.","nextNodeIds":[760510310]},{"nodeId":760510310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3619198266,"text":"Is that... a forest somewhere in Nod-Krai? There are so many little animals!","nextNodeIds":[760510311]},{"nodeId":760510311,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":784516650,"text":"I'm afraid... you would have to go back to the time before I left the Frostmoon Scions to see a scene like this.","nextNodeIds":[760510312]},{"nodeId":760510312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3413845810,"text":"Wow, Paimon's so jealous! Did cute little animals really gather around you like that?","nextNodeIds":[760510313]},{"nodeId":760510313,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1796347754,"text":"Yes, most of them were drawn to the kuuvahki around me. They felt safe curling up next to me like that.","nextNodeIds":[760510314]},{"nodeId":760510314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2374972386,"text":"That's so awesome! You could pet them all you wanted without them running away!","nextNodeIds":[760510315]},{"nodeId":760510315,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":732041058,"text":"Hm... I would say the chic badgers were the nicest to pet. They're the ones with the big, fluffy tails.","nextNodeIds":[760510316]},{"nodeId":760510316,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2985666714,"text":"The fur on a rimehorn deer's neck is quite soft as well. It makes a very comfortable pillow.","nextNodeIds":[760510317]},{"nodeId":760510317,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":521631994,"text":"Which do you prefer?","nextNodeIds":[760510318]},{"nodeId":760510318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":520466506,"text":"Um, we don't really have the same kind of experience to go off of...","nextNodeIds":[760510319]},{"nodeId":760510319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2362133450,"text":"But, Paimon would probably choose to pet a chic badger's tail.","nextNodeIds":[760510320]},{"nodeId":760510320,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2436178282,"text":"Chic badgers can be quite timid. If you want to pet them, they need to feel safe first.","nextNodeIds":[760510321]},{"nodeId":760510321,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":575769002,"text":"Ah... But I would exercise caution, Paimon.","nextNodeIds":[760510322]},{"nodeId":760510322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1765227242,"text":"Why? Do they... bite, or something? P—Paimon promises to be super gentle...","nextNodeIds":[760510323]},{"nodeId":760510323,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3810143330,"text":"No. I'm referring to danger from above.","nextNodeIds":[760510324]},{"nodeId":760510324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":890178922,"text":"Danger from above...?","nextNodeIds":[760510325]},{"nodeId":760510325,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3793048018,"text":"Yes... Longplume ibises often hunt little animals like these. I had to issue them a warning to get them to stop going after the kuuhenki.","nextNodeIds":[760510326]},{"nodeId":760510326,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3970963474,"text":"You're just telling Paimon this now!? It's a miracle she hasn't been carried off yet!","nextNodeIds":[760510327]},{"nodeId":760510327,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":643665050,"text":"Ah... Then, the next time I see one, I'll advise them that you are off limits as well.","nextNodeIds":[760510328]},{"nodeId":760510328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":143404434,"text":"Next time? No, you need to find one right now, or Paimon'll be too scared to even fly out that door!","nextNodeIds":[760510329]},{"nodeId":760510329,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":352679050,"text":"Ah, I see. In that case, I will be sure to tell them that Paimon is...","nextNodeIds":[760510330,760510332,760510334]},{"nodeId":760510330,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4155530882,"text":"The best companion ever.","nextNodeIds":[760510331]},{"nodeId":760510331,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3667765162,"text":"Exactly! They can't just go around snatching up people's travel companions!","nextNodeIds":[760510336]},{"nodeId":760510336,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":3727619730,"text":"!!!","nextNodeIds":[760510337]},{"nodeId":760510337,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":416786546,"text":"The little one... seems strangely curious about the idea of Paimon being carried off by a longplume ibis.","nextNodeIds":[760510338]},{"nodeId":760510338,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4176708674,"text":"Don't even think about painting a picture like that...","nextNodeIds":[]},{"nodeId":760510332,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4106949402,"text":"The greatest travel guide in Teyvat.","nextNodeIds":[760510333]},{"nodeId":760510333,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2877132834,"text":"Uh... Paimon's glad you see it that way, but... They probably don't even know what a \"travel guide\" is.","nextNodeIds":[760510336]},{"nodeId":760510334,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":748749746,"text":"A food source that would just upset their stomachs.","nextNodeIds":[760510335]},{"nodeId":760510335,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1257377434,"text":"No, don't even put that thought in their heads! What if they try their luck!?","nextNodeIds":[760510336]},{"nodeId":760510309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":611592098,"text":"Just looking at it makes me feel happy.","nextNodeIds":[760510310]}]},{"talkId":7605104,"talkConfig