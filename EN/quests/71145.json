{"mainQuestId":71145,"title":"Scenarios for Study","description":"The cooperative wargame being hosted by the Millelith is almost over. But it seems like Su Ding still has something to say to you...","titleTextMapHash":2521806319,"descTextMapHash":1433430686,"mainQuestExcel":{"mainQuestId":71145,"titleTextMapHash":2521806319,"title":"Scenarios for Study","descTextMapHash":1433430686,"description":"The cooperative wargame being hosted by the Millelith is almost over. But it seems like Su Ding still has something to say to you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":2031,"luaPath":"Actor/Quest/WQ71145","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2031,"chapterId":0,"descTextMapHash":1433430686,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71145,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3863993153,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71145","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171145],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2521806319,"type":"WQ","unlockDescTextMapHash":108199638}},"flow":[{"subQuestId":7114501,"order":1,"stepDescription":"Talk to Su Ding","stepDescTextMapHash":1342587932,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7114501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30601"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7114501],"talks":[{"talkId":7114501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7114501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7114501,"initDialog":711450101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30601],"performCfg":"QuestDialogue/WQ/4.7_guaiwuduitui_71145/Q7114501","priority":5,"questId":71145,"showRandomTalkCount":0},"dialogs":[{"nodeId":711450101,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":2196356402,"text":"#Thanks to the both of you, {NICKNAME} and your most talented helper!","nextNodeIds":[711450102]},{"nodeId":711450102,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":967720946,"text":"In the course of observing these Wargames, we've seen all sorts of combat strategies put into practice and a wide range of complex scenarios that we can analyze and learn from.","nextNodeIds":[711450103]},{"nodeId":711450103,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":345924842,"text":"Now, we just need to broaden our model by taking into account the different types of soldiers and their special traits. We'll then be able to create a variety of scenario-based training manuals for different units to study.","nextNodeIds":[711450104]},{"nodeId":711450104,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":829342602,"text":"If the two of you are interested, I'd be happy to provide you with said manuals next time we meet. That way, you'll be able to try out different scenarios in your spare time.","nextNodeIds":[711450105,711450107]},{"nodeId":711450105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2884378554,"text":"So that's it? It feels like we just got started...","nextNodeIds":[711450106]},{"nodeId":711450106,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":2078232386,"text":"We know that the two of you are very busy, so we tried to cut down on the number of similar scenarios so it didn't get too repetitive. Of course, if you haven't had enough, you're welcome to come back and keep playing anytime!","nextNodeIds":[711450109]},{"nodeId":711450109,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":2685295426,"text":"Anyway, on behalf of the Millelith General Staff and the representatives of all the other participating entities, allow me to express my sincere gratitude!","nextNodeIds":[711450110]},{"nodeId":711450110,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","textMapHash":4023390242,"text":"With any luck, we'll get a chance to work with you again in future. That way, we shall get even better at wiping out monsters and securing our lands!","nextNodeIds":[711450111,711450112]},{"nodeId":711450111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2216969746,"text":"I'd be delighted to help!","nextNodeIds":[711450113]},{"nodeId":711450113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":756196578,"text":"Hehe, everything's gone so smoothly. Not only did we manage to strengthen our connections with various groups we've met before, but we helped people all across Teyvat too!","nextNodeIds":[711450114]},{"nodeId":711450114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":595979554,"text":"Besides, Paimon's learned loads from watching you wargame.","nextNodeIds":[711450115]},{"nodeId":711450115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1998104106,"text":"If we have some time to kill at some point, maybe we can come back and test out some more scenarios...","nextNodeIds":[711450116]},{"nodeId":711450116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":196357778,"text":"Such as, uhh... If an Abyss Mage had to fight it out against the Great Snowboar King, who would win?","nextNodeIds":[711450117]},{"nodeId":711450117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":427645138,"text":"Or... Who has the hardest head, a Ruin Guard or a Geovishap?","nextNodeIds":[]},{"nodeId":711450112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1310320874,"text":"Absolutely... if I have the time!","nextNodeIds":[711450113]},{"nodeId":711450107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2636465506,"text":"Finally finished! All thanks to m—I mean Paimon and me...","nextNodeIds":[711450108]},{"nodeId":711450108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":201273090,"text":"Hehe... Paimon hasn't gotten her head around all the rules yet, but it was pretty fun! Seems like the results were good too!","nextNodeIds":[711450109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7114501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30601"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7114501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"Su Ding","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171145],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1433430686,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADF