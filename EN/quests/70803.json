,"","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7080302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7080301,"initDialog":708030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1577,1668,1674,1409],"performCfg":"QuestDialogue/WQ/Mengde_70803/Q7080301","priority":5,"questId":70803,"showRandomTalkCount":0},"dialogs":[{"nodeId":708030101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2269770826,"text":"Huh? Who is this guy...","nextNodeIds":[708030102,708030103]},{"nodeId":708030102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3941989002,"text":"Is he... Joel's father?","nextNodeIds":[708030104]},{"nodeId":708030104,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":4274192522,"text":"Oh, you're here, Traveler!","nextNodeIds":[708030105]},{"nodeId":708030105,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":1322711322,"text":"Allow me to introduce Joserf. He's Joel's father.","nextNodeIds":[708030106]},{"nodeId":708030106,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":2552849322,"text":"Dad! This is that traveler I was telling you about. The traveler's helped me out loads in the past, and this time we even built a snowman together.","nextNodeIds":[708030107]},{"nodeId":708030107,"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","textMapHash":240226858,"text":"Joel has told me everything about you. I can't thank you enough.","nextNodeIds":[708030108,708030109]},{"nodeId":708030108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4113227010,"text":"I'm glad you're finally reunited...","nextNodeIds":[708030110]},{"nodeId":708030110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2527439474,"text":"Wow, this is amazing!","nextNodeIds":[708030111]},{"nodeId":708030111,"roleType":"TALK_ROLE_NPC","speakerId":1409,"speakerName":"Cyrus","textMapHash":1337904970,"text":"Not bad, Pallad, not bad at all! You did great work this time!","nextNodeIds":[708030112]},{"nodeId":708030112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1508818154,"text":"\"This time\"? Did something happen the last time?","nextNodeIds":[708030113]},{"nodeId":708030113,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":3852973514,"text":"Uh... You remember the person I said I found the last time on Dragonspine, right?","nextNodeIds":[708030114]},{"nodeId":708030114,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":3446463706,"text":"After you accompanied me up the mountain and helped me to defeat those monsters, I continued searching the area.","nextNodeIds":[708030115]},{"nodeId":708030115,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":1687735898,"text":"During my search, I accidentally tripped and rolled my way down the mountain...","nextNodeIds":[708030116]},{"nodeId":708030116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2809511546,"text":"You... rolled...","nextNodeIds":[708030117]},{"nodeId":708030117,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":3024302418,"text":"Thankfully, the snow was very thick below. I wasn't hurt.","nextNodeIds":[708030118]},{"nodeId":708030118,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":2391214450,"text":"And I was just getting ready to head back when I heard noises at the side... and then someone just popped out of nowhere.","nextNodeIds":[708030119]},{"nodeId":708030119,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":1050607602,"text":"I didn't realize that this was the person I was looking for at first. In fact, I mistook him for a fellow adventurer in the search party.","nextNodeIds":[708030120]},{"nodeId":708030120,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":2482229266,"text":"But after a few words of conversation, it was clear that he was having memory problems. He didn't even know his own name.","nextNodeIds":[708030121]},{"nodeId":708030121,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":1922591850,"text":"The temperature was freezing, and there was no time to deal with all that there and then, so I convinced him to come back to the camp with me and figure everything else out after we got there.","nextNodeIds":[708030122]},{"nodeId":708030122,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":1239359042,"text":"We got back to the camp, ran into Joel, and the moment he saw him, he froze for a second, with this completely stunned expression on his face, and then he started crying out: \"Dad! Dad!\" That's when Joserf suddenly started to remember.","nextNodeIds":[708030123]},{"nodeId":708030123,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":2212033266,"text":"Daddy...","nextNodeIds":[708030124]},{"nodeId":708030124,"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","textMapHash":1735810330,"text":"Daddy's right here, Joel. Daddy's right here.","nextNodeIds":[708030125]},{"nodeId":708030125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1575757674,"text":"Joserf, don't you remember anything else at all?","nextNodeIds":[708030126]},{"nodeId":708030126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":272784410,"text":"The Boar Princess, feeding the foxes...?","nextNodeIds":[708030127]},{"nodeId":708030127,"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","textMapHash":1190678122,"text":"I'm sorry, I have no recollection. Maybe it's because of the head trauma? I'm not sure...","nextNodeIds":[708030128]},{"nodeId":708030128,"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","textMapHash":2481618546,"text":"I woke up and found myself covered in blood. My things were gone and there was nothing to indicate who I was or how I got there.","nextNodeIds":[708030129]},{"nodeId":708030129,"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","textMapHash":2228657042,"text":"I crawled into a cave and settled in for a slow recovery. After my legs and feet were a little better, my hunting skills were what kept me alive.","nextNodeIds":[708030130]},{"nodeId":708030130,"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","textMapHash":3985895162,"text":"Dad... I was so worried about you.","nextNodeIds":[708030131]},{"nodeId":708030131,"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","textMapHash":766391794,"text":"I'm alright now, Joel. Don't cry, daddy's not going anywhere. I'm here to stay.","nextNodeIds":[708030132]},{"nodeId":708030132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3983089002,"text":"So what's the plan now, Joserf?","nextNodeIds":[708030133]},{"nodeId":708030133,"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","textMapHash":2723467946,"text":"I... I just want to stay with my family for a while longer.","nextNodeIds":[708030134]},{"nodeId":708030134,"roleType":"TALK_ROLE_NPC","speakerId":1409,"speakerName":"Cyrus","textMapHash":2410391554,"text":"It's wonderful that you were able to return safe and sound! I suppose there's our happy ending now, hahah!","nextNodeIds":[708030135]},{"nodeId":708030135,"roleType":"TALK_ROLE_NPC","speakerId":1409,"speakerName":"Cyrus","textMapHash":2962918114,"text":"That said, Pallad, you've still got some way to go before your adventuring skills are up to scratch. I mean, losing your footing and rolling down the mountain like that...","nextNodeIds":[708030136]},{"nodeId":708030136,"roleType":"TALK_ROLE_NPC","speakerId":1409,"speakerName":"Cyrus","textMapHash":1509482890,"text":"You're having some remedial classes with me once we get back to the Guild, I say!","nextNodeIds":[708030137]},{"nodeId":708030137,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":3341455898,"text":"Huh? B—But Cyrus... I think I kinda made up for my mistakes this time, y'know...","nextNodeIds":[708030138]},{"nodeId":708030138,"roleType":"TALK_ROLE_NPC","speakerId":1409,"speakerName":"Cyrus","textMapHash":1730652186,"text":"No buts! Back to the Guild we go!","nextNodeIds":[708030139]},{"nodeId":708030139,"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","textMapHash":927504994,"text":"Guild Master, please!","nextNodeIds":[]},{"nodeId":708030109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":686417402,"text":"I'm glad you're okay...","nextNodeIds":[708030110]},{"nodeId":708030103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1924120962,"text":"A gigantic version of Joel...","nextNodeIds":[708030104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7080301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["40029","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7080302_guide","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7080301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1577,"speakerName":"Reckless Pallad","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1674,"speakerName":"Joserf","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1409,"speakerName":"Cyrus","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1668,"speakerName":"Joel","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[170803],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2953401558,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCAD