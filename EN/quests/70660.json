5,"questId":70660,"showRandomTalkCount":0},"dialogs":[{"nodeId":706600101,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2361322138,"text":"Welcome, adventurer. How have your travels been going thus far?","nextNodeIds":[706600102,706600105]},{"nodeId":706600102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3842502234,"text":"They've gone alright, I think.","nextNodeIds":[706600103]},{"nodeId":706600103,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":923987234,"text":"That's good. You're well on your way to becoming a truly amazing adventurer.","nextNodeIds":[706600104]},{"nodeId":706600104,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":4013948946,"text":"Ah, yes, if you're interested, you can go over to Gygax's and try the latest edition of Windtrace.","nextNodeIds":[706600108]},{"nodeId":706600108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3319480770,"text":"Does this have anything to do with the Adventurers' Guild?","nextNodeIds":[706600109]},{"nodeId":706600109,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2486267922,"text":"Well, Gygax has actually put up a commission for us to help him look for people to test Windtrace...","nextNodeIds":[706600110]},{"nodeId":706600110,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1043895266,"text":"So I suppose you could call the two matters related from that perspective.","nextNodeIds":[706600111]},{"nodeId":706600111,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3861240274,"text":"In any case, give it a go if you're willing. According to adventurers who have previously played it, it's actually quite fun...","nextNodeIds":[]},{"nodeId":706600105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3666827034,"text":"Are there any new commissions?","nextNodeIds":[706600106]},{"nodeId":706600106,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2216005570,"text":"Not at the moment, no.","nextNodeIds":[706600107]},{"nodeId":706600107,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3220047426,"text":"But if you're interested, you can go over to Gygax's and try the latest edition of Windtrace.","nextNodeIds":[706600108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1512","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7066005,"order":2,"stepDescription":"","stepDescTextMapHash":2451060204,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7066002],"talks":[{"talkId":7066002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7066002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7066005","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7066002,"initDialog":706600201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30051],"performCfg":"","priority":5,"questId":70660,"showRandomTalkCount":0},"dialogs":[{"nodeId":706600201,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3039270442,"text":"Hey there, fancy trying your hand at Windtrace?","nextNodeIds":[706600202,706600217]},{"nodeId":706600202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1649943130,"text":"What's Windtrace?","nextNodeIds":[706600203]},{"nodeId":706600203,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3879354906,"text":"I'm glad you asked. Windtrace is a game that's all about Mondstadt's history!","nextNodeIds":[706600204]},{"nodeId":706600204,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3195293906,"text":"I suppose you've heard of the aristocrats who once lived in Mondstadt City?","nextNodeIds":[706600205]},{"nodeId":706600205,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":602307738,"text":"They were tyrants, and their rule was brutal. Words cannot do justice to the way that people suffered at their hands...","nextNodeIds":[706600206]},{"nodeId":706600206,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":2021150682,"text":"To fight back against their oppression, a group of brave citizens came together and formed an underground resistance.","nextNodeIds":[706600207]},{"nodeId":706600207,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4028849674,"text":"These valiant rebels engaged in operations throughout the city, becoming a major thorn in the side of the aristocrats.","nextNodeIds":[706600208]},{"nodeId":706600208,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":208434866,"text":"But the aristocrats retaliated, quickly training up their own team of henchmen to suppress the rebels.","nextNodeIds":[706600209]},{"nodeId":706600209,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1406655826,"text":"And so, the rebels fought duel after duel with the aristocrats' lackeys all across Mondstadt.","nextNodeIds":[706600210]},{"nodeId":706600210,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3110404898,"text":"Windtrace takes its inspiration from this thrilling chapter of Mondstadt's history! And it used to be quite popular, too...","nextNodeIds":[706600211]},{"nodeId":706600211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1609219002,"text":"Used to be?","nextNodeIds":[706600212]},{"nodeId":706600212,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4166493026,"text":"Sadly, yes. Young people these days don't seem very interested in the game...","nextNodeIds":[706600213]},{"nodeId":706600213,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4185358530,"text":"But I can't let Windtrace fade into obscurity. So, I tweaked the rules a little to make it easier to get into and more fun.","nextNodeIds":[706600214]},{"nodeId":706600214,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1305310626,"text":"I also added a whole load of brand-new maps in. Hopefully, this will help to attract more people...","nextNodeIds":[]},{"nodeId":706600217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2859898034,"text":"So, what's the situation with Windtrace?","nextNodeIds":[706600218]},{"nodeId":706600218,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4030597482,"text":"I previously got some people to do a round of play-testing for Windtrace. Some of them were extremely good. Made a real impression on me, in fact.","nextNodeIds":[706600219]},{"nodeId":706600219,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":913053730,"text":"But a lot of people said that the game was pretty tough. Either it was Rebels claiming that they had few escape options, or it was the Hunters complaining that they couldn't find anyone.","nextNodeIds":[706600220]},{"nodeId":706600220,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3670385802,"text":"Some even griped that you have to be very familiar with each map to play properly, and asked that I simplify the gameplay.","nextNodeIds":[706600221]},{"nodeId":706600221,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1778212282,"text":"*sigh* I don't know who to listen to, so I decided to invite another batch of people to play-test the game, and I'll hear what they have to say.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7066002,"order":3,"stepDescription":"Talk to Gygax","stepDescTextMapHash":1404996148,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30051","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7066002],"talks":[{"talkId":7066002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement"