{"mainQuestId":4027,"title":"","description":"","titleTextMapHash":1167601975,"descTextMapHash":3177928190,"mainQuestExcel":{"mainQuestId":4027,"titleTextMapHash":1167601975,"title":"","descTextMapHash":3177928190,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/AQ4027","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":3177928190,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":4027,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2336240681,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/AQ4027","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":4020,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1167601975,"type":"AQ","unlockDescTextMapHash":1116691094}},"flow":[{"subQuestId":402701,"order":1,"stepDescription":"","stepDescTextMapHash":2822011564,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_ANY_MANUAL_TRANSPORT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[3,100],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"[3_340200113:3329.162,454.452,3811.095,0.000,306.786,0.000]"},{"BFGALAINLMD":0,"LNHLPKELCAL":[402701,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[402701],"talks":[{"talkId":402701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["402701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":402701,"initDialog":40251323,"nextRandomTalks":[],"nextTalks":[],"npcId":[1076],"performCfg":"QuestDialogue/AQ/Fontaine_4027/Q402701","priority":5,"questId":4027,"showRandomTalkCount":0},"dialogs":[{"nodeId":40251323,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1031373666,"text":"It seems, from your expressions, that you still have more things you wish to ask.","nextNodeIds":[40251324]},{"nodeId":40251324,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1755156034,"text":"Ask away. I will tell you the truth as I know it.","nextNodeIds":[40251325,40251338,40251359,40251367,40251379]},{"nodeId":40251325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":823871354,"text":"About the initial verdict that was passed on Childe...","nextNodeIds":[40251326]},{"nodeId":40251326,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":4062597546,"text":"I have investigated his case along many avenues, and I have learned that he once fell into an unknown chasm when he was young. There, by chance, he awakened the All-Devouring Narwhal.","nextNodeIds":[40251327]},{"nodeId":40251327,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1455029474,"text":"But, whether it be by sentiment or reason, that should not have been enough to consider him the root cause of the disaster. At most, he would have had tangential liability.","nextNodeIds":[40251328]},{"nodeId":40251328,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1182545962,"text":"As for the judgment passed by the Oratrice during the trial...","nextNodeIds":[40251329]},{"nodeId":40251329,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1204158714,"text":"Whether it was due to that liability by association, or Focalors deliberately using him to buy time for us on the assumption that he would be able to hold the creature off... I cannot say.","nextNodeIds":[40251330]},{"nodeId":40251330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1102299770,"text":"Guess Focalors had Fontainians in mind the whole time. In the end, it was thanks to her that they finally became real humans...","nextNodeIds":[40251331]},{"nodeId":40251331,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3506675970,"text":"Uh, hang on a second! Paimon's suddenly got another question.","nextNodeIds":[40251332]},{"nodeId":40251332,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2803999706,"text":"Back when Fontainians hadn't yet become real humans, were the children they had also transformed Oceanids?","nextNodeIds":[40251333]},{"nodeId":40251333,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3229371234,"text":"Life has always flowed like water. Do you recall how Fontainians would often come to the Fountain of Lucine to pray for children?","nextNodeIds":[40251334]},{"nodeId":40251334,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2505495242,"text":"Yeah. Lynette said that the Fountain is where all the waters in Fontaine converge...","nextNodeIds":[40251335]},{"nodeId":40251335,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3694841298,"text":"In truth, even those couples did not know that such prayers were no mere custom, but instead a form of ritual...","nextNodeIds":[40251336]},{"nodeId":40251336,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3098695706,"text":"Those Oceanids who were blessed within the spring water would later descend as new humans in the coming months.","nextNodeIds":[40251337]},{"nodeId":40251337,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1456390042,"text":"Uh... Paimon... sorta gets it now? Either way, seems like this ritual won't be of any further use — but it'll probably live on as a local custom!","nextNodeIds":[40251380]},{"nodeId":40251380,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1737288554,"text":"Uh, hang on a sec. Paimon's still got a question about the Gnosis...","nextNodeIds":[40251381]},{"nodeId":40251381,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1422402178,"text":"When we spoke to Lyney earlier, he mentioned that your attitude towards giving away the Gnosis had clearly changed...","nextNodeIds":[40251382]},{"nodeId":40251382,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3775070082,"text":"We guessed that there might be some reason for it that only you were aware of...","nextNodeIds":[40251383]},{"nodeId":40251383,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2669832954,"text":"Hmm. No wonder the House of the Hearth is the Fatui's intelligence division. They are certainly sharp.","nextNodeIds":[40251384]},{"nodeId":40251384,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2386060698,"text":"So, regarding this specific issue, I was just getting ready to share something with you.","nextNodeIds":[40251385]},{"nodeId":40251385,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3339976194,"text":"Uh... What is it?","nextNodeIds":[40251386]},{"nodeId":40251386,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2871512746,"text":"In truth, I exchanged some further words with that lady named Skirk after sending you two back to the surface. It went something like this...","nextNodeIds":[]},{"nodeId":40251338,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2730482354,"text":"About Fontaine's future...","nextNodeIds":[40251339]},{"nodeId":40251339,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4220391898,"text":"Yeah, about that, Wriothesley said Furina has already left. What's that all about?","nextNodeIds":[40251340]},{"nodeId":40251340,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":440154482,"text":"Ah, Lady Furina... The people are only aware that her death sentence has not been carried out. She abdicated the post of Hydro Archon and left affairs related to that title to me, before leaving the opera house.","nextNodeIds":[40251341]},{"nodeId":40251341,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":124454610,"text":"I related Focalors' words to her faithfully and completely. After hearing them, she seemed neither saddened nor comforted...","nextNodeIds":[40251342]},{"nodeId":40251342,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":500092874,"text":"She simply said that... she was tired, and needed to rest.","nextNodeIds":[40251343]},{"nodeId":40251343,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3962899786,"text":"Having said that, she then packed her things and moved out of the opera house, not unlike how an ordinary person might.","nextNodeIds":[40251344]},{"nodeId":40251344,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":980630954,"text":"Erm... But she's still got a place to stay, right?","nextNodeIds":[40251345]},{"nodeId":40251345,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1300174898,"text":"You need not worry. I will make arrangements to ensure that she will not want for food, clothing, board, or travel.","nextNodeIds":[40251346]},{"nodeId":40251346,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3466042330,"text":"In truth, I am... somewhat happy for her. The wear and tear on her spirit will, of course, take time to heal...","nextNodeIds":[40251347]},{"nodeId":40251347,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2769577010,"text":"But now that she no longer has to play the role of \"Focalors the Hydro Archon,\" she can finally lay down her burdens and lead a normal life.","nextNodeIds":[40251348]},{"nodeId":40251348,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2363120650,"text":"What about you, then? What are your plans, now that you've regained your full powers as the Hydro Dragon?","nextNodeIds":[40251349]},{"nodeId":40251349,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3882352042,"text":"After Focalors passed on, the Oratrice also ceased to function.","nextNodeIds":[40251350]},{"nodeId":40251350,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3361877042,"text":"This matter will directly affect our trials. After much careful consideration, I've decided to take over its role in our courts. From now on, I shall hear cases and pass verdicts by myself.","nextNodeIds":[40251351]},{"nodeId":40251351,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1432230906,"text":"Looks like you're still considering stuff from the perspective of the Iudex, huh.","nextNodeIds":[40251352]},{"nodeId":40251352,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1483596578,"text":"As an elemental dragon, there are indeed many things that I must do. But this power, and this duty... In a manner of speaking, you could say that both were granted to me.","nextNodeIds":[40251353]},{"nodeId":40251353,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1267115858,"text":"As such, before I attend to my other responsibilities, I must first and foremost continue to serve Fontaine as its highest judge. The duty of the Hydro Sovereign and the duty of the Iudex shall coexist within my person.","nextNodeIds":[40251354]},{"nodeId":40251354,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":988380114,"text":"Additionally, the Hydro Archon's departure has brought about another problem... Which is that the opera house shall no longer produce Indemnitium.","nextNodeIds":[40251355]},{"nodeId":40251355,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":485967794,"text":"That's true. That power was derived from the peoples' faith in the Hydro Archon, wasn't it?","nextNodeIds":[40251356]},{"nodeId":40251356,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3224971490,"text":"Wait. But the various meks and machines in the city are all still okay. Where are they getting their energy from?","nextNodeIds":[40251357]},{"nodeId":40251357,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3121074858,"text":"As I am now, I have full command over Pneumousia, and it can serve as a complete substitute — another reason why I cannot quite leave Fontaine immediately.","nextNodeIds":[40251358]},{"nodeId":40251358,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":876297650,"text":"Wow. This ancient dragon's authority stuff is really quite useful, huh?","nextNodeIds":[40251380]},{"nodeId":40251359,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":849331514,"text":"About Fontaine's Gnosis...","nextNodeIds":[40251360]},{"nodeId":40251360,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":917849802,"text":"Ooh, that's right. They say you've given it to The Knave as a \"diplomatic gift,\" or something...","nextNodeIds":[40251361]},{"nodeId":40251361,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1102835970,"text":"Leaving aside their intentionality, the two Fatui Harbingers have indeed done much for us during this crisis.","nextNodeIds":[40251362]},{"nodeId":40251362,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1479063490,"text":"Their sole remaining goal in Fontaine, at least at this point, would seem to be the Gnosis.","nextNodeIds":[40251363]},{"nodeId":40251363,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2278231090,"text":"The Oratrice has ceased to function. The Hydro Archon's divine throne is now no more. And I do not need the Gnosis's power...","nextNodeIds":[40251364]},{"nodeId":40251364,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2214886770,"text":"As such, it has lost all meaning for Fontaine.","nextNodeIds":[40251365]},{"nodeId":40251365,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2311842994,"text":"If the Fatui have impure designs, then we might as well accede to their request now... and avoid unnecessary conflict.","nextNodeIds":[40251366]},{"nodeId":40251366,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1857994210,"text":"Gah, what complicated considerations... Paimon thought you were just giving it to them out of gratitude to The Knave, and as an apology to Childe.","nextNodeIds":[40251380]},{"nodeId":40251367,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2332634898,"text":"About the next stop on my journey...","nextNodeIds":[40251368]},{"nodeId":40251368,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2770556474,"text":"You will soon be heading to Natlan, I presume?","nextNodeIds":[40251369]},{"nodeId":40251369,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1236891810,"text":"I'm afraid that I have little talent as a travel guide, so all I can do is tell you what I know about that land.","nextNodeIds":[40251370]},{"nodeId":40251370,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2592386354,"text":"As far as I'm aware, Natlan can be said to be \"a nation of dragons.\"","nextNodeIds":[40251371]},{"nodeId":40251371,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1981643538,"text":"A nation of dragons? You mean, like you?","nextNodeIds":[40251372]},{"nodeId":40251372,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":1931234346,"text":"No, I suspect that I would not find myself welcome there.","nextNodeIds":[40251373]},{"nodeId":40251373,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":3254342842,"text":"Unlike ancient dragons such as myself, the dragons of Natlan have undergone long years of development and evolution. Large numbers of them have entered a form of coexistence with humanity.","nextNodeIds":[40251374]},{"nodeId":40251374,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":802137898,"text":"Natlan is also the nation of \"war.\" War ravages those lands like an undying flame.","nextNodeIds":[40251375]},{"nodeId":40251375,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":927871930,"text":"There is one other piece of information I got incidentally from my negotiations with The Knave that I believe may be useful to you.","nextNodeIds":[40251376]},{"nodeId":40251376,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":4116497514,"text":"...The Harbinger known as The Captain has thrown his hat into the endless ring of war.","nextNodeIds":[40251377]},{"nodeId":40251377,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1015589994,"text":"\"The Captain\"... Sounds like a real tough customer. Seriously, everywhere you look, there's a Fatui Harbinger doing their thing!","nextNodeIds":[40251378]},{"nodeId":40251378,"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","textMapHash":2066394138,"text":"I suggest that you fully prepare yourself before going to Natlan. In the meantime, Fontaine's doors will always be open to you.","nextNodeIds":[40251380]},{"nodeId":40251379,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1586222354,"text":"I have no more questions.","nextNodeIds":[40251380]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_ANY_MANUAL_TRANSPORT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[3,100],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"[3_340200113:3329.162,454.452,3811.095,0.000,306.786,0.000]"},{"BFGALAINLMD":0,"LNHLPKELCAL":[402701,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[402701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1076,"speakerName":"Neuvillette","count":39},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3177928190,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/AQ/Fontai