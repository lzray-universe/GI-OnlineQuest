":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7068001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["48000","248000001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[{"talkId":7068001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7068001,"initDialog":706800101,"nextRandomTalks":[],"nextTalks":[],"npcId":[9500],"performCfg":"QuestDialogue/WQ/Wolf_70680/Q7068001","priority":5,"questId":70680,"showRandomTalkCount":0},"dialogs":[{"nodeId":706800101,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1479566706,"text":"Hello, dear guests! Please, come here!","nextNodeIds":[706800102]},{"nodeId":706800102,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2193604562,"text":"I have some good news to share with you. This took much longer than it should have... But in any case — at long last, the new stage is now ready for action!","nextNodeIds":[706800103]},{"nodeId":706800103,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1928346394,"text":"Put on a spectacular show for your audience, and you will receive a key that opens the door to the World Within the Painting...","nextNodeIds":[706800104]},{"nodeId":706800104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":396653402,"text":"Whoa, hold up! First storybooks, now a world inside a painting? This place is making less and less sense all the time...","nextNodeIds":[706800105]},{"nodeId":706800105,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":120146530,"text":"I know what you mean! But as I read in a storybook once, if a magician reveals all their tricks to the audience, it robs them of the surprise.","nextNodeIds":[706800106]},{"nodeId":706800106,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3815328394,"text":"So, it's quite right that things don't make sense. Madame Mage's magic is just like love — not something to try and make sense of, but something you just feel.","nextNodeIds":[706800107]},{"nodeId":706800107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1335584058,"text":"Fair enough, that explanation sorta works... But anyway, about this new World Within the Painting stage — is it any different from the other stage?","nextNodeIds":[706800108]},{"nodeId":706800108,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3475602010,"text":"The World Within the Painting is a world of many rules... This new stage will put friendship and trust to the test — a classic tale!","nextNodeIds":[706800109]},{"nodeId":706800109,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":575995610,"text":"And all those who pass the test will receive a small blessing from Madame Mage...","nextNodeIds":[706800110]},{"nodeId":706800110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2355395082,"text":"Ooh! Is it a good-luck spell or something? Like, um...","nextNodeIds":[706800111,706800112]},{"nodeId":706800111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1322220682,"text":"Be careful what you wish for...","nextNodeIds":[706800113]},{"nodeId":706800113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1882965010,"text":"Ah! Yep, good point, we should be careful what we wish for...","nextNodeIds":[706800114]},{"nodeId":706800114,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":12768306,"text":"I assure you, there's nothing to be nervous about. The paint is already on the canvas, and Madame Mage's blessing is no longer a secret.","nextNodeIds":[706800115]},{"nodeId":706800115,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3784458498,"text":"If you're ready, you can step onto the World Within the Painting stage and see for yourself.","nextNodeIds":[706800116]},{"nodeId":706800116,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2183980730,"text":"As you embark on your new adventure, do as they do in the stories: Whistle your favorite tune, cast your worries aside, and keep courage in your heart.","nextNodeIds":[]},{"nodeId":706800112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1842533066,"text":"I doubt it, and besides...","nextNodeIds":[706800113]}]}],"questNarration":[],"talkIds":[7068001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170680],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3468494710,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Wolf_70680/Q7068001","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":706800101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7068001,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[9500],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFP