TE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7504105,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7504101,7504102,7504103,7504104,7504105],"talks":[{"talkId":7504101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","2","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7504104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7504101,"initDialog":750410101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21679],"performCfg":"QuestDialogue/WQ/Natlan_75041/Q7504101","priority":5,"questId":75041,"showRandomTalkCount":0},"dialogs":[{"nodeId":750410101,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":604410834,"text":"These inhuman creatures are truly tough adversaries... inhuman monsters, I should say. Greetings, brave warrior... I am Quenin, a member of this adventure team. My duty is...","nextNodeIds":[750410102]},{"nodeId":750410102,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":1886867666,"text":"My duty... is to eliminate these monsters. Yes, I am a warrior of the adventure team. Be careful, brave warrior...","nextNodeIds":[750410103]},{"nodeId":750410103,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":1157206338,"text":"These monsters... they are extremely cunning — capable of disguising themselves in different forms.","nextNodeIds":[750410104]},{"nodeId":750410104,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2201910786,"text":"Every night, before I fall asleep, I hear... the sounds they make from their hiding spots in these ancient ruins. This... is why I cannot sleep at the encampment.","nextNodeIds":[750410105]},{"nodeId":750410105,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2730966714,"text":"This place is filled with these monsters. You... must be careful, too.","nextNodeIds":[]}]},{"talkId":7504102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","3","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7504104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","2","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7504102,"initDialog":750410201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21679],"performCfg":"QuestDialogue/WQ/Natlan_75041/Q7504102","priority":5,"questId":75041,"showRandomTalkCount":0},"dialogs":[{"nodeId":750410201,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2394429370,"text":"Ah, this place really is cursed...","nextNodeIds":[750410202]},{"nodeId":750410202,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":440788162,"text":"Do not tarry here too long. You must leave, and quickly... Yes, you must leave before the coming of the pitch-black tide.","nextNodeIds":[750410203]},{"nodeId":750410203,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2746111682,"text":"Yes, the pitch-black tide. Its vast shadow is almost upon us. We must... Must ensure that everyone gets to safety. That everyone... is safely evacuated.","nextNodeIds":[]}]},{"talkId":7504103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","4","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7504104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","3","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7504103,"initDialog":750410301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21679],"performCfg":"QuestDialogue/WQ/Natlan_75041/Q7504103","priority":5,"questId":75041,"showRandomTalkCount":0},"dialogs":[{"nodeId":750410301,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":561554138,"text":"Why do you linger here still...?","nextNodeIds":[750410302]},{"nodeId":750410302,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":1434815698,"text":"Our adventure team's leader, the hero who wore a falcon's mask, is already... We cannot hold out against them any longer...","nextNodeIds":[750410303]},{"nodeId":750410303,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":1026333714,"text":"You must leave as soon as possible. This place is cursed, brave warrior. It is not somewhere that people should stay.","nextNodeIds":[]}]},{"talkId":7504104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","5","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7504104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","4","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7504104,"initDialog":750410401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21679],"performCfg":"QuestDialogue/WQ/Natlan_75041/Q7504104","priority":5,"questId":75041,"showRandomTalkCount":0},"dialogs":[{"nodeId":750410401,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":1938740322,"text":"So you are still here, brave warrior.","nextNodeIds":[750410402]},{"nodeId":750410402,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":3781069506,"text":"Once upon a time, so the scholars say, the ancient and tyrannical Lord of this Cinder City knew... a way to prevent Abyssal corrosion. So we...","nextNodeIds":[750410403]},{"nodeId":750410403,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":532056978,"text":"But there really is something ominous about this place, brave warrior. Lately, I too have begun to feel a little... strange.","nextNodeIds":[750410404]},{"nodeId":750410404,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":4274185330,"text":"Sometimes, after waking, you'll find that a road that was perfectly intact just the day before has now become broken and dilapidated... And were those stone houses like that there to begin with? It feels like they should be more... complete.","nextNodeIds":[750410405]},{"nodeId":750410405,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":489169258,"text":"But sometimes, when I wake, I see friends who should not be here anymore... Are they monsters? That must be it... They're monsters that have taken the form of my friends.","nextNodeIds":[750410406]},{"nodeId":750410406,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":1179520834,"text":"My... My duty here is to eliminate those monsters, but... why? Why do I have to do that?","nextNodeIds":[750410407]},{"nodeId":750410407,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":4225138642,"text":"Anyway, all things said and done, this is a very strange place. You should leave... as soon as possible.","nextNodeIds":[]}]},{"talkId":7504105,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","6","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7504104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","5","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7504105,"initDialog":750410501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21679],"performCfg":"QuestDialogue/WQ/Natlan_75041/Q7504105","priority":5,"questId":75041,"showRandomTalkCount":0},"dialogs":[{"nodeId":750410501,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2930557098,"text":"You'd better leave at once. If you stay any longer, it'll be too late...","nextNodeIds":[750410502]},{"nodeId":750410502,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2957910618,"text":"Why will it be too late, you ask? Because... because our entire adventure team has been wiped out. That giant, pitch-black beast... They were all...","nextNodeIds":[750410503]},{"nodeId":750410503,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":1723450722,"text":"They tasked me with protecting the evacuees, and at the very least, to ensure that they left the city. As we speak, a rescue team from the Flower-Feather Clan is on their way...","nextNodeIds":[750410504]},{"nodeId":750410504,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2701972114,"text":"I must eliminate these evil monsters, so that the survivors can return to a land upon which the sun shines... Huh, but... Why am I here again?","nextNodeIds":[750410505]},{"nodeId":750410505,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":3981903946,"text":"That sound in my ears... Ahh, it's getting louder and louder. I... I have to go back to the waterfall. Yes, I must... return to the waterfall.","nextNodeIds":[750410506]},{"nodeId":750410506,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","textMapHash":2998294234,"text":"Brave warrior, you too should leave... as soon as possible.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7504101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7504102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7504103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7504104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7504105,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7504101,7504102,7504103,7504104,7504105],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"Quenin","count":24}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":445739526,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75041/Q7504101","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BK