logue/WQ/Daoqi_72662/Q7266202","priority":5,"questId":72662,"showRandomTalkCount":0},"dialogs":[{"nodeId":726620201,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2340341770,"text":"You found them so quickly? You're a powerful adventurer indeed!","nextNodeIds":[726620202]},{"nodeId":726620202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":298792170,"text":"Will these be enough?","nextNodeIds":[726620203]},{"nodeId":726620203,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":3624876282,"text":"Well, watch me next, I just have to do this...this...and this...","nextNodeIds":[726620204]},{"nodeId":726620204,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":290814490,"text":"This should be it, that's all.","nextNodeIds":[726620205]},{"nodeId":726620205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2035078106,"text":"The next step is to scatter the bait and wait for the \"Lunar Leviathan\" to appear, right?","nextNodeIds":[726620206]},{"nodeId":726620206,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":421658730,"text":"Yes, I purposely chose this place, from where we reached the shore back then.","nextNodeIds":[726620207]},{"nodeId":726620207,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":496968050,"text":"The \"Lunar Leviathan\" that guided us back to the ship also disappeared here.","nextNodeIds":[726620208]},{"nodeId":726620208,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":1299303322,"text":"So, is everyone ready? Don't forget to make a wish when you see the \"Lunar Leviathan.\"","nextNodeIds":[726620209]},{"nodeId":726620209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2874660474,"text":"What if it doesn't work?","nextNodeIds":[726620210]},{"nodeId":726620210,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":158574314,"text":"...","nextNodeIds":[726620211]},{"nodeId":726620211,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2668636226,"text":"Don't say such discouraging things, it will work. The \"Lunar Leviathan\" will definitely come.","nextNodeIds":[726620212]},{"nodeId":726620212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1424805746,"text":"Yeah! It will work! Big fish, big fish, you must be good and bite the bait! I'm counting on you!","nextNodeIds":[726620213]},{"nodeId":726620213,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"Kujirai Momiji","textMapHash":2033348898,"text":"Look! Look at this! It's glowing under the water! Something's coming!","nextNodeIds":[726620214]},{"nodeId":726620214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":300570,"text":"Really? Is the \"Lunar Leviathan\" really here?","nextNodeIds":[726620215]},{"nodeId":726620215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3987280722,"text":"Help, it's a Ruin Guard!","nextNodeIds":[726620216]},{"nodeId":726620216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":924125194,"text":"Why is it this guy!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133220119","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133220639","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133220640","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133220649","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["101546"],"PAINLIBBLDK":"QUEST_EXEC_DEL