{"mainQuestId":76123,"title":"A Gift From Her","description":"Columbina seems to have something she wants to do in the Silvermoon Hall...","titleTextMapHash":3685249495,"descTextMapHash":589209582,"mainQuestExcel":{"mainQuestId":76123,"titleTextMapHash":3685249495,"title":"A Gift From Her","descTextMapHash":589209582,"description":"Columbina seems to have something she wants to do in the Silvermoon Hall...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76123","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":589209582,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"UI_QuestSign_FlowerLand","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76123,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2278553769,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76123","mainQuestTag":"MAINQUEST_TAG_FLOWERLAND","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176123],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[0],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3685249495,"type":"WQ","unlockDescTextMapHash":2948062502}},"flow":[{"subQuestId":7612301,"order":1,"stepDescription":"Meet Columbina","stepDescTextMapHash":2821990788,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7612301],"talks":[{"talkId":7612301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7612301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7612301,"initDialog":761230101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76123/Q7612301","priority":5,"questId":76123,"showRandomTalkCount":0},"dialogs":[{"nodeId":761230101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4293086658,"text":"That smells great! Did we make it in time for Columbina's mealtime again?","nextNodeIds":[761230102]},{"nodeId":761230102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2577611754,"text":"Huh. Are those kuuhenki... lining up? For soup that Columbina's serving?","nextNodeIds":[761230103]},{"nodeId":761230103,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":749615114,"text":"Just a moment.","nextNodeIds":[761230104]},{"nodeId":761230104,"roleType":"TALK_ROLE_NPC","speakerId":7189,"speakerName":"Kuuhenki","textMapHash":481420042,"text":"~!","nextNodeIds":[761230105]},{"nodeId":761230105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3574833210,"text":"Wow, this is really good!","nextNodeIds":[761230106]},{"nodeId":761230106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4203319818,"text":"Refreshing, tasty fruit soup — Paimon's never had anything quite like it!","nextNodeIds":[761230107]},{"nodeId":761230107,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3260200826,"text":"Another serving?","nextNodeIds":[761230108]},{"nodeId":761230108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2375487906,"text":"Make that two!","nextNodeIds":[761230109]},{"nodeId":761230109,"roleType":"TALK_ROLE_NPC","speakerId":15380,"speakerName":"Luonnotar","textMapHash":4233133658,"text":"...!","nextNodeIds":[761230110]},{"nodeId":761230110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1166216602,"text":"Are you learning to cook?","nextNodeIds":[761230111]},{"nodeId":761230111,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1281106258,"text":"Yes. I asked Ineffa for some basic recipes, and have made several attempts. The kuuhenki and animals have both responded quite positively.","nextNodeIds":[761230112]},{"nodeId":761230112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2657842058,"text":"Having any issues in the kitchen?","nextNodeIds":[761230113]},{"nodeId":761230113,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1944827314,"text":"Well... My sleeves are too wide. They brush against the pot if I'm not careful...","nextNodeIds":[761230114]},{"nodeId":761230114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":331256898,"text":"(So, it's not the cooking itself that's giving you trouble.)","nextNodeIds":[761230115]},{"nodeId":761230115,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":256680562,"text":"I struggle somewhat with making desserts, though.","nextNodeIds":[761230116]},{"nodeId":761230116,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":540110546,"text":"You have to get the temperature and proportions just right...","nextNodeIds":[761230117]},{"nodeId":761230117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":178014338,"text":"(She must not have cooked much for herself in the past, then.)","nextNodeIds":[761230118]},{"nodeId":761230118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3391191634,"text":"(Besides, desserts and snacks are particularly hard to get right if you're working solo...)","nextNodeIds":[761230119]},{"nodeId":761230119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2533954378,"text":"Would you like me to help?","nextNodeIds":[761230120]},{"nodeId":761230120,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4114372834,"text":"Sure. Let's start with krumkake, shall we?","nextNodeIds":[761230121]},{"nodeId":761230121,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3831925826,"text":"Some time later...","nextNodeIds":[761230122]},{"nodeId":761230122,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2307043274,"text":"Would you like to try one?","nextNodeIds":[761230123,761230124]},{"nodeId":761230123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2842932426,"text":"(Take a nibble.)","nextNodeIds":[761230125]},{"nodeId":761230125,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3563199466,"text":"...","nextNodeIds":[761230126]},{"nodeId":761230126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2832453922,"text":"(Oh wow, that first bite probably soured my face into a prune...)","nextNodeIds":[761230127]},{"nodeId":761230127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1787037482,"text":"(But after you swallow some, the sweetness resurfaces... Maybe it gets better once you get used to it...)","nextNodeIds":[761230128]},{"nodeId":761230128,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3243181674,"text":"What do you think?","nextNodeIds":[761230129,761230130]},{"nodeId":761230129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":240079978,"text":"Passable...","nextNodeIds":[761230131]},{"nodeId":761230131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3049910850,"text":"Did Paimon miss anything?","nextNodeIds":[761230132]},{"nodeId":761230132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3697521186,"text":"Try this real quick, would you?","nextNodeIds":[761230133]},{"nodeId":761230133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2269313466,"text":"...","nextNodeIds":[761230134]},{"nodeId":761230134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1005442170,"text":"Gaaaah, it's so sour! Wh—What are you trying to do to Paimon!?","nextNodeIds":[761230135]},{"nodeId":761230135,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1429460050,"text":"Haha...","nextNodeIds":[761230136]},{"nodeId":761230136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2304077282,"text":"The aftertaste is pretty good, though.","nextNodeIds":[761230137]},{"nodeId":761230137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4179815698,"text":"It's all about the initial taste! Couldn't one of you have warned me to take a smaller bite!?","nextNodeIds":[761230138]},{"nodeId":761230138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2785848066,"text":"If you hadn't said anything, Paimon would've thought this was a prank! Watching people's faces pucker or something...","nextNodeIds":[761230139]},{"nodeId":761230139,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":601406330,"text":"Okay. Let me try again.","nextNodeIds":[761230140]},{"nodeId":761230140,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":416155986,"text":"More time passes...","nextNodeIds":[761230141]},{"nodeId":761230141,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1421734498,"text":"Here. Try this batch.","nextNodeIds":[761230142]},{"nodeId":761230142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4268946730,"text":"(Whoa...! This is way better!)","nextNodeIds":[761230143,761230144]},{"nodeId":761230143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1822348234,"text":"It's delicious!","nextNodeIds":[761230145]},{"nodeId":761230145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2145087594,"text":"Really? Paimon wants some too! ...Mmm! That's the stuff! Sooo tasty!","nextNodeIds":[761230146]},{"nodeId":761230146,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2673781186,"text":"Good enough to be given as a gift?","nextNodeIds":[761230147]},{"nodeId":761230147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":158377202,"text":"Totally! Wait, did you learn how to cook and make krumkake because you wanted to make a present for someone?","nextNodeIds":[761230148]},{"nodeId":761230148,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":843773002,"text":"Yes... For my friends.","nextNodeIds":[761230149]},{"nodeId":761230149,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3284137650,"text":"That's a great idea.","nextNodeIds":[761230150]},{"nodeId":761230150,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3858327402,"text":"Do you still remember the first time you came here together? You had prepared some food for me.","nextNodeIds":[761230151]},{"nodeId":761230151,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1682867818,"text":"Though the food couldn't do much to replenish the power I had lost, eating it did make me feel more relaxed.","nextNodeIds":[761230152]},{"nodeId":761230152,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1749233322,"text":"I did not give it much thought then, but now I understand.","nextNodeIds":[761230153]},{"nodeId":761230153,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3220596458,"text":"The time and effort put into carefully preparing food by hand is what gives it soul.","nextNodeIds":[761230154]},{"nodeId":761230154,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":491559914,"text":"What I enjoyed was not simply the food itself, but the warmth and kindness in the hands that made it.","nextNodeIds":[761230155]},{"nodeId":761230155,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1024818194,"text":"And the less those hands seek reciprocity, the greater the warmth and kindness required to match it in turn.","nextNodeIds":[761230156]},{"nodeId":761230156,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4051503114,"text":"Awww, Paimon's gonna blush if you go on like that... To be honest, we were at least kinda hoping to get on your good side back there.","nextNodeIds":[761230157,761230158]},{"nodeId":761230157,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3127134314,"text":"But things are different now.","nextNodeIds":[761230159]},{"nodeId":761230159,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":336071146,"text":"Indeed. But now that I understand all this, I'd like to do a little more... It's a wonderful feeling.","nextNodeIds":[761230160]},{"nodeId":761230160,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1073475178,"text":"Would you come with me to visit our friends?","nextNodeIds":[761230161]},{"nodeId":761230161,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1911524370,"text":"Apart from the krumkake, I have also prepared a few other gifts. Ah, but they must be sent in secret.","nextNodeIds":[761230162]},{"nodeId":761230162,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":243709818,"text":"Why \"in secret,\" if you don't mind Paimon asking?","nextNodeIds":[761230163]},{"nodeId":761230163,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4286969034,"text":"Well, you've always been the ones to \"pleasantly surprise\" me. I'd like to see how my friends will react when the tables are turned.","nextNodeIds":[761230164]},{"nodeId":761230164,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2748946722,"text":"Phew. We were running all over! Finally done.","nextNodeIds":[761230165]},{"nodeId":761230165,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":590514538,"text":"Their reactions were kind of surprising, though. Some didn't even realize they were gifts from you, Columbina...","nextNodeIds":[761230166]},{"nodeId":761230166,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2657925946,"text":"Aino just got straight to snacking...","nextNodeIds":[761230167]},{"nodeId":761230167,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":190040850,"text":"It's fine. I expected as much. What's important is that they were happy to receive the gifts.","nextNodeIds":[761230168]},{"nodeId":761230168,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3522925834,"text":"In that case, Lauma definitely knew the krumkakes and wreath on her desk came from you.","nextNodeIds":[761230169]},{"nodeId":761230169,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1276987722,"text":"Paimon can understand her being hesitant about wearing the wreath, but seriously, she stared at the krumkakes for a good ten minutes and still couldn't bring herself to eat one...","nextNodeIds":[761230170]},{"nodeId":761230170,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":384828234,"text":"I was getting worried that she might enshrine them...","nextNodeIds":[761230171]},{"nodeId":761230171,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3185132770,"text":"It seems Jahoda got quite the fright, though... Perhaps we shouldn't have slipped the gifts directly behind her...","nextNodeIds":[761230172]},{"nodeId":761230172,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2065359578,"text":"She almost jumped out of her skin.","nextNodeIds":[761230173]},{"nodeId":761230173,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4120680466,"text":"Maybe she's just naturally more alert? Still, she seemed to calm down when Ashru came over to paw at the scratching post you sent.","nextNodeIds":[761230174]},{"nodeId":761230174,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2644044378,"text":"As for our other friends who aren't in Nod-Krai, I'm counting on you to deliver their gifts.","nextNodeIds":[761230175]},{"nodeId":761230175,"roleType":"TALK_ROLE_NPC","speakerId":15738,"speakerName":"Longplume Ibis","textMapHash":1312244098,"text":"!!!","nextNodeIds":[761230176]},{"nodeId":761230176,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1623449338,"text":"I must say, you're quite good at preparing presents.","nextNodeIds":[761230177]},{"nodeId":761230177,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":491966754,"text":"Here.","nextNodeIds":[761230178]},{"nodeId":761230178,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2259294130,"text":"Ooh! Is it finally our turn?","nextNodeIds":[761230179]},{"nodeId":761230179,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4351650,"text":"Huh? Candies? Paimon thought we'd get krumkakes like everyone else.","nextNodeIds":[761230180]},{"nodeId":761230180,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1863060314,"text":"Well, you already had some of those while taste-testing. Some variety is nice, don't you think?","nextNodeIds":[761230181,761230182]},{"nodeId":761230181,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":738628386,"text":"Yeah... They're really good, too.","nextNodeIds":[761230183]},{"nodeId":761230183,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1161189666,"text":"That's good to hear.","nextNodeIds":[761230184]},{"nodeId":761230184,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3571206410,"text":"And there's one more gift. Here, for you.","nextNodeIds":[761230185]},{"nodeId":761230185,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3873724618,"text":"This is... a wind glider?","nextNodeIds":[761230186]},{"nodeId":761230186,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2522533090,"text":"I've heard it said that the skies belong to the birds, and the land, to the beasts...","nextNodeIds":[761230187]},{"nodeId":761230187,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1867390738,"text":"While the vast space between the two is reserved for adventurers wearing wing gliders.","nextNodeIds":[761230188]},{"nodeId":761230188,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1204773402,"text":"With this by your side, may your path forward ever be lit as with moonlight.","nextNodeIds":[761230189]},{"nodeId":761230189,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":173300338,"text":"It's perfect. Thank you.","nextNodeIds":[761230190]},{"nodeId":761230190,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4000355842,"text":"And thank you, for your companionship.","nextNodeIds":[]},{"nodeId":761230182,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3588016242,"text":"Better than the Moon-Prayer Night candies, even.","nextNodeIds":[761230183]},{"nodeId":761230158,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3161452450,"text":"If there's anything you'd like to eat, just say the word.","nextNodeIds":[761230159]},{"nodeId":761230144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2131488266,"text":"You sure learn fast!","nextNodeIds":[761230145]},{"nodeId":761230130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3197357162,"text":"But there's room for improvement...","nextNodeIds":[761230131]},{"nodeId":761230124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1942978298,"text":"(Chow down.)","nextNodeIds":[761230125]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":[],"PAINLIBBLDK":"QUEST_EXEC_ACTIVE_DAMSELETTE_FREE_MOON_PHASE"},{"LNHLPKELCAL":["133603053","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["7612301","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7612301],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","count":36},{"roleType":"TALK_ROLE_PLAYER","speakerI