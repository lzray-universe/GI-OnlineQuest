JFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_14910:2505.168,437.010,2158.234]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7116303],"talks":[{"talkId":7116303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7116303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7116303,"initDialog":711630301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1323],"performCfg":"QuestDialogue/WQ/Liyue_71163/Q7116303","priority":5,"questId":71163,"showRandomTalkCount":0},"dialogs":[{"nodeId":711630301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2244775114,"text":"What's going on? How did we end up here?","nextNodeIds":[711630302]},{"nodeId":711630302,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":2176197594,"text":"So, how do you like the little trinket I made for you?","nextNodeIds":[711630303]},{"nodeId":711630303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2944086594,"text":"So this is where you are, Zibai! What's this parasol? It suddenly went \"whoosh\" and transported us here!","nextNodeIds":[711630304]},{"nodeId":711630304,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":3397830922,"text":"It seems I'm not the only one who struggles to remember things. Have you already forgotten riding on it with me before?","nextNodeIds":[711630305]},{"nodeId":711630305,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":398832026,"text":"Does that jog your memory?","nextNodeIds":[711630306]},{"nodeId":711630306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1634398458,"text":"Oh! It's... It's the lunar chariot! No wonder it looked so familiar...","nextNodeIds":[711630307]},{"nodeId":711630307,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":2914954,"text":"Haha, it's just a replica created from my memories.","nextNodeIds":[711630308]},{"nodeId":711630308,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":594123186,"text":"And it's all thanks to the broken jade token you returned to me.","nextNodeIds":[711630309]},{"nodeId":711630309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":699661562,"text":"Oh! So this is the little trinket you were planning to make!","nextNodeIds":[711630310]},{"nodeId":711630310,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":3344780242,"text":"Precisely. This jade-token chariot can quickly transport you wherever you wish to go, which should help your travels unfold more smoothly.","nextNodeIds":[711630311]},{"nodeId":711630311,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":46615538,"text":"Please take it, my dutiful guides.","nextNodeIds":[711630312]},{"nodeId":711630312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":190726034,"text":"Wow, this is amazing... Paimon thought you were saying all that \"making a trinket\" stuff to be nice — she never expected you'd actually do it!","nextNodeIds":[711630313]},{"nodeId":711630313,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":1949258650,"text":"I had expected it to take some time, considering how badly the token was damaged — its spiritual energy was completely gone.","nextNodeIds":[711630314]},{"nodeId":711630314,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":637826170,"text":"But fortunately for us, this is Chenyu Vale.","nextNodeIds":[711630315]},{"nodeId":711630315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1208615434,"text":"Huh? What's so special about it?","nextNodeIds":[711630316]},{"nodeId":711630316,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":1591448506,"text":"Do you know exactly where about we are in the vale?","nextNodeIds":[711630317]},{"nodeId":711630317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1767940690,"text":"Uhm... Yilong Wharf?","nextNodeIds":[711630318]},{"nodeId":711630318,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":3523261866,"text":"Hehe, you have much to learn about this place.","nextNodeIds":[711630319]},{"nodeId":711630319,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":2999719834,"text":"The ground beneath our feet is actually one of the key intersections in Liyue's Ley Lines. There are eight such nodes in total...","nextNodeIds":[711630320]},{"nodeId":711630320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1799176498,"text":"Life, Death, Repose, Concealment, Initiation, Terrain, Fright, and Injury.","nextNodeIds":[711630321]},{"nodeId":711630321,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":2218583362,"text":"You're more familiar with this place than I expected...","nextNodeIds":[711630322]},{"nodeId":711630322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1073158794,"text":"Oh! Paimon remembers now. You're talking about the eight gates!","nextNodeIds":[711630323]},{"nodeId":711630323,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":1276735458,"text":"Correct. Where we stand right now is the center of the most auspicious of those gates — the Gate of Life.","nextNodeIds":[711630324]},{"nodeId":711630324,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":3811589346,"text":"The Gate of Life symbolizes growth, prosperity, and revitalization. Thus, I was able to replenish the jade token's spiritual energy so quickly and craft this chariot.","nextNodeIds":[711630325]},{"nodeId":711630325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2470060642,"text":"Wow, talk about a power-packed position! Guess Chenyu Vale really is a land of wonders...","nextNodeIds":[711630326]},{"nodeId":711630326,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":2826238682,"text":"Indeed... You would do well to settle here in peace and prosperity...","nextNodeIds":[711630327]},{"nodeId":711630327,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":247978874,"text":"Huh? Whaddya mean \"you\"...?","nextNodeIds":[711630328]},{"nodeId":711630328,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":711875010,"text":"It's nothing...","nextNodeIds":[711630329]},{"nodeId":711630329,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":4251878178,"text":"Alright, I have done all I wished to do. You may go about your business.","nextNodeIds":[711630330]},{"nodeId":711630330,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":1375767674,"text":"I plan to take a stroll atop the mountain. This is where we part ways.","nextNodeIds":[711630331]},{"nodeId":711630331,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1189709946,"text":"Thank you, Zibai.","nextNodeIds":[711630332]},{"nodeId":711630332,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":3541481538,"text":"No need to thank me. You woke me from my slumber — it is I who am in your debt.","nextNodeIds":[711630333]},{"nodeId":711630333,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1429995786,"text":"It was all Zhongli's doing, really.","nextNodeIds":[711630334]},{"nodeId":711630334,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":2037235514,"text":"And I have told him much the same as I've said to you.","nextNodeIds":[711630335]},{"nodeId":711630335,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":1810008266,"text":"He mentioned that you're on a long journey...","nextNodeIds":[711630336]},{"nodeId":711630336,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":975296602,"text":"Does your next stop happen to be a distant land of snow?","nextNodeIds":[711630337]},{"nodeId":711630337,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":908465066,"text":"Yes, we're heading to Snezhnaya.","nextNodeIds":[711630338]},{"nodeId":711630338,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":2607570858,"text":"Snezhnaya... Hmm, although I know nothing about the place, no journey through ice and snow is without its dangers.","nextNodeIds":[711630339]},{"nodeId":711630339,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":3675079666,"text":"If you find yourselves in need of help, you know where to find me.","nextNodeIds":[711630340]},{"nodeId":711630340,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2799805122,"text":"I know.","nextNodeIds":[711630341]},{"nodeId":711630341,"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","textMapHash":4269011266,"text":"Take care.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7116303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133115273"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_14910:2505.168,437.010,2158.234]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7116302,7116303],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1323,"speakerName":"Zibai","count":26},{"roleType":"TALK_ROLE_NPC","sp