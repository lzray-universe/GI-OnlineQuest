longs to her.","nextNodeIds":[711630204]},{"nodeId":711630204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2090606122,"text":"You're probably right... But why would she leave her parasol here by the door?","nextNodeIds":[711630205]},{"nodeId":711630205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2657622330,"text":"She does have a pretty poor memory...","nextNodeIds":[711630206]},{"nodeId":711630206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2628991914,"text":"What are we going to do? The way things are going, Paimon's worried she'll get halfway through eating and forget how to pick up her chopsticks...","nextNodeIds":[711630207]},{"nodeId":711630207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2970880706,"text":"*sigh* We should go find her.","nextNodeIds":[711630208]},{"nodeId":711630208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1156273770,"text":"Wait a moment... I'm not sure this is really a parasol.","nextNodeIds":[711630209]},{"nodeId":711630209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3230677546,"text":"Huh? What is it, then? Hmm... Let Paimon take a closer look...","nextNodeIds":[711630210]},{"nodeId":711630210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1095473850,"text":"Whoa!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7116302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133107319"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STY