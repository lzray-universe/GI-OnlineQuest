,"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":true,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7507306","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7507301","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7507303,"initDialog":750730301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21614],"performCfg":"QuestDialogue/WQ/Natlan_75073/Q7507303","priority":5,"questId":75073,"showRandomTalkCount":0},"dialogs":[{"nodeId":750730301,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":3545587554,"text":"*sob* Freedom! Freedom from this prison at last!","nextNodeIds":[750730302]},{"nodeId":750730302,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":726589034,"text":"This hot air balloon keeps on swaying this way and that. Heh, who knows, perhaps a gust of wind shall come and blow the whole thing down...","nextNodeIds":[750730303]},{"nodeId":750730303,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":2004706570,"text":"Even Granny Itztli would not be able to save us then, I fear.","nextNodeIds":[750730304]},{"nodeId":750730304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3398797906,"text":"Who are you, anyway, and how did you wind up here?","nextNodeIds":[750730305]},{"nodeId":750730305,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":2865122866,"text":"Ah, yes, I haven't introduced myself. Call me Conulaf, a trainee priest of the Masters of the Night-Wind...","nextNodeIds":[750730306]},{"nodeId":750730306,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":4052723762,"text":"As the title suggests, I'm currently in training to be a priest. I've stayed within our tribe all my life, so the elders told me, \"why don't you go out and see the world?\"","nextNodeIds":[750730307]},{"nodeId":750730307,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":2105391082,"text":"And so they kicked me out of the tribe under the guise of training—","nextNodeIds":[750730308]},{"nodeId":750730308,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":1602197250,"text":"Still, I wouldn't call getting caught by hilichurls the good kind of \"seeing the world,\" would you, my savior?","nextNodeIds":[750730309,750730311]},{"nodeId":750730309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2836572082,"text":"Adventuring on your own's dangerous stuff...","nextNodeIds":[750730310]},{"nodeId":750730310,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":1247747674,"text":"Indeed, indeed! Were it not for you, I don't know how long I'd have remained trapped in there...","nextNodeIds":[750730313]},{"nodeId":750730313,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":2947309530,"text":"In any case, thank you so much for saving me, my dear savior... Now, after all this wind I've been subjected to, I should head down before giving my continued training more consideration...","nextNodeIds":[750730314]},{"nodeId":750730314,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":2152097154,"text":"I don't have much on me, but in my family, we repay kindness when it is shown to us, so let me give you these!","nextNodeIds":[]},{"nodeId":750730311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1224213242,"text":"Well, so long as you're strong enough...","nextNodeIds":[750730312]},{"nodeId":750730312,"roleType":"TALK_ROLE_NPC","speakerId":21614,"speakerName":"Conulaf","textMapHash":701685394,"text":"Heh... I fear you're not fooling me with that. There just aren't many adventurers as strong as you are in this world...","nextNodeIds":[750730313]}]},{"talkId":7507304,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":true,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkM