"isHidden":false,"talkIds":[7227101,7227102],"talks":[{"talkId":7227101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":true,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7227101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["1","0","72271","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7227101,"initDialog":722710102,"nextRandomTalks":[],"nextTalks":[],"npcId":[2023],"performCfg":"","priority":5,"questId":72271,"showRandomTalkCount":0},"dialogs":[{"nodeId":722710102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3880708442,"text":"I've got some treasure I want to sell.","nextNodeIds":[722710103]},{"nodeId":722710103,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":3610726434,"text":"Oh, what rare objects have you found this time? Let me have a look.","nextNodeIds":[722710104]},{"nodeId":722710104,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3589648122,"text":"You tell Linlang about the Dragonbone Orb.","nextNodeIds":[722710105]},{"nodeId":722710105,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":1682563410,"text":"If what you see is true, this is a truly amazing relic.","nextNodeIds":[722710106]},{"nodeId":722710106,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":1360316314,"text":"But from a cursory examination, I can't find anything evidently special about it. Perhaps it requires extensive use to show its qualities...","nextNodeIds":[722710107]},{"nodeId":722710107,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":3496189066,"text":"The way I see it, it does seem that the wondrous properties you ascribe to it might be a tad... exaggerated. Perhaps it was simply something entrusted to you by those who had failed in their task.","nextNodeIds":[722710108]},{"nodeId":722710108,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":3559677866,"text":"Don't take it to heart, though. I'm just saying what's coming to my mind.","nextNodeIds":[722710122]},{"nodeId":722710122,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":2020093250,"text":"This is quite the common occurrence in our line of work, anyway.","nextNodeIds":[722710109]},{"nodeId":722710109,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":3300812178,"text":"Also, I believe that you did not keep this in sealed storage — it does seem like there is some wear and tear on its surface already.","nextNodeIds":[722710110]},{"nodeId":722710110,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":1952445314,"text":"I'm afraid that there will be some price reduction on that front, too.","nextNodeIds":[722710123]},{"nodeId":722710123,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":1239646730,"text":"How does 80,000 Mora sound? I can add 5 Bountiful Years on as specialty dishes as well.","nextNodeIds":[722710111]},{"nodeId":722710111,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":684586658,"text":"I believe that this is a good price.","nextNodeIds":[722710112,722710116,722710119]},{"nodeId":722710112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":529481266,"text":"...What will you use it for?","nextNodeIds":[722710113]},{"nodeId":722710113,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":282403946,"text":"To be honest, I would consider the story behind it more valuable than its capabilities.","nextNodeIds":[722710114]},{"nodeId":722710114,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":333014722,"text":"I suspect that this might be of much interest to our storytellers and opera troupes, or perhaps the great men and women of Yujing Terrace.","nextNodeIds":[722710115]},{"nodeId":722710115,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":1467992082,"text":"It would be quite the ancient showpiece of a relic even if I were to simply mount it on our shop counter.","nextNodeIds":[722710111]},{"nodeId":722710116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3270216082,"text":"A fair price. Done.","nextNodeIds":[722710117]},{"nodeId":722710117,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":1275085770,"text":"My, that's quite forward of you. Well then, here's you Mora.","nextNodeIds":[722710118]},{"nodeId":722710118,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":1211037602,"text":"If you should find any other such treasures, we are always awaiting your patronage.","nextNodeIds":[]},{"nodeId":722710119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":57180562,"text":"Let me think about it a bit more.","nextNodeIds":[722710120]},{"nodeId":722710120,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":3867950762,"text":"No problem. After all, you should always check the goods — I mean, the prices — when you're planning to sell precious relics.","nextNodeIds":[722710121]},{"nodeId":722710121,"roleType":"TALK_ROLE_NPC","speakerId":2023,"speakerName":"Linlang","textMapHash":894867578,"text":"You can come to me again once you've mulled the matter over.","nextNodeIds":[]}]},{"talkId":7227102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":true,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7227101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["1","1","72271","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"para