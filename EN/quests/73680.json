,"IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30248"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7368001],"talks":[{"talkId":7368001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7368001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2016","2016018","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7368001,"initDialog":736800101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30248],"performCfg":"QuestDialogue/WQ/Mengde_73680/Q7368001","priority":5,"questId":73680,"showRandomTalkCount":0},"dialogs":[{"nodeId":736800101,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":3871831978,"text":"Hello and welcome to Weinlesefest. May Lord Barbatos bless you.","nextNodeIds":[736800102]},{"nodeId":736800102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2867603994,"text":"#Hey, {NICKNAME}, look! There's a noticeboard here, and there's a whole bunch of paper pinned to it. Is it a commission board or something?","nextNodeIds":[736800103]},{"nodeId":736800103,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":1794160474,"text":"Hehe, no, they're not commissions. These are clues to find Fecund Hampers.","nextNodeIds":[736800104]},{"nodeId":736800104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1848411202,"text":"What's a Fecund Hamper? Ooh! Is it a sort of treasure?","nextNodeIds":[736800105]},{"nodeId":736800105,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":3978821978,"text":"That's one way to look at it. It seems it's your first time participating in the festival. Would you like me to give you a brief explanation?","nextNodeIds":[736800106,736800107]},{"nodeId":736800106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1959518250,"text":"Well, since Paimon's so interested...","nextNodeIds":[736800108]},{"nodeId":736800108,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":1630370330,"text":"Alright. Simply put, a Fecund Hamper is a gift prepared by residents for lucky outsiders during the festival.","nextNodeIds":[736800109]},{"nodeId":736800109,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":1302175642,"text":"We aren't just welcoming the return of Lord Barbatos, but we also mean to share the joy of harvest and reminisce about good times.","nextNodeIds":[736800110]},{"nodeId":736800110,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":970014194,"text":"Everyone will put a gift in a wooden box shaped like a barrel and hide it in a place that holds memories for them.","nextNodeIds":[736800111]},{"nodeId":736800111,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":457804842,"text":"Next, the owner of the gift will leave clues. The first person, no matter who, to find the box will get that gift.","nextNodeIds":[736800112]},{"nodeId":736800112,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":2376460018,"text":"Other than gifts, everyone will also leave a message in the box to the person who finds it. This is a sincere blessing, often more valuable than the gift itself.","nextNodeIds":[736800113]},{"nodeId":736800113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":602484794,"text":"This sounds pretty fun!","nextNodeIds":[736800114]},{"nodeId":736800114,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":1199507042,"text":"So, would the two of you like to try looking for a Fecund Hamper? You should be able to work the clues out easily if you have some knowledge of Mondstadt customs.","nextNodeIds":[736800115]},{"nodeId":736800115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3848616890,"text":"#Let's try, {NICKNAME}! We might even find a gift from someone we know!","nextNodeIds":[736800116]},{"nodeId":736800116,"roleType":"TALK_ROLE_NPC","speakerId":30248,"speakerName":"Annette","textMapHash":1989200602,"text":"Good luck and have fun!","nextNodeIds":[]},{"nodeId":736800107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1561804234,"text":"Go ahead, please.","nextNodeIds":[736800108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHL