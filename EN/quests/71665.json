{"mainQuestId":71665,"title":"Search Chronicle: Burning Up!","description":"You receive a very strange commission. Go to the area around the Pyro Regisvine to learn more from the client.","titleTextMapHash":2885448551,"descTextMapHash":3507293942,"mainQuestExcel":{"mainQuestId":71665,"titleTextMapHash":2885448551,"title":"Search Chronicle: Burning Up!","descTextMapHash":3507293942,"description":"You receive a very strange commission. Go to the area around the Pyro Regisvine to learn more from the client.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5188,"luaPath":"Actor/Quest/WQ71665","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5188,"chapterId":0,"descTextMapHash":3507293942,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71665,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1407995185,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71665","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171665],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2885448551,"type":"WQ","unlockDescTextMapHash":1219684070}},"flow":[{"subQuestId":7166501,"order":1,"stepDescription":"Search for the client","stepDescTextMapHash":666333276,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30545"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166501],"talks":[{"talkId":7166501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7166501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166501,"initDialog":716650101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30545],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_71665/Q7166501","priority":5,"questId":71665,"showRandomTalkCount":0},"dialogs":[{"nodeId":716650101,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3776212818,"text":"Ah, you're finally here. You're the \"protagonist,\" yes?","nextNodeIds":[716650102,716650104]},{"nodeId":716650102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3202864858,"text":"That's me, your protagonist.","nextNodeIds":[716650103]},{"nodeId":716650103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1836587914,"text":"Uh, Paimon's not sure what you mean by that question...","nextNodeIds":[716650105]},{"nodeId":716650105,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3840997162,"text":"Ah, would you look at that? Too eager for my own good again — and they even told me to be concise when I was posting the commission, too.","nextNodeIds":[716650106]},{"nodeId":716650106,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":1554484810,"text":"Here's the low-down. I'm Ranjit, a chef of cuisines creative. I've been looking to get along nicely with a Pyro Regisvine, but it seems uninterested in my company...","nextNodeIds":[716650107]},{"nodeId":716650107,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":942335594,"text":"Spitting fireballs and slamming the ground... Nothing I could do about that, so I'm hiring some adventurer help — of the protagonist kind, to be exact.","nextNodeIds":[716650108,716650110]},{"nodeId":716650108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2523097578,"text":"No problem! Just leave it to me.","nextNodeIds":[716650109]},{"nodeId":716650109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1935179922,"text":"Hey, hey! Don't go around agreeing to take on such ridiculous commissions!","nextNodeIds":[716650111]},{"nodeId":716650111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1400377370,"text":"Wait, are you for real? A creative cuisine chef, making friends with a Pyro Regisvine... Nothing about this makes any sense!","nextNodeIds":[716650112]},{"nodeId":716650112,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":500944842,"text":"Really? I mean, it is a very grumpy plant, but you never know till you try, right?","nextNodeIds":[716650113]},{"nodeId":716650113,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":1650978242,"text":"And after the Regisvine, I'd also like to give the Primo Geovishap, Jadeplume Terrorshroom, and Millennial Pearl Seahorse a go!","nextNodeIds":[716650114]},{"nodeId":716650114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4158306570,"text":"...This is getting crazier by the minute. Where did you even get these ideas from?","nextNodeIds":[716650115]},{"nodeId":716650115,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":4268528666,"text":"Actually, it's because of my trip to Natlan not long ago...","nextNodeIds":[716650116]},{"nodeId":716650116,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3595479322,"text":"It's a truly amazing place. If I had to describe its marvelous novelty, it would be like the first time I ate curry spicy enough to make me rain sweat.","nextNodeIds":[716650117]},{"nodeId":716650117,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":4275089410,"text":"My tongue had taken all the stimulation it could bear, but I shoveled spoonful after spoonful into my mouth. I couldn't help myself!","nextNodeIds":[716650118]},{"nodeId":716650118,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3068995826,"text":"...Speaking of which, I met a whole bunch of friends in Natlan. They're all good folks. Some taught me rock climbing, and others introduced me to the hot springs.","nextNodeIds":[716650119]},{"nodeId":716650119,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":2102661402,"text":"Bet you didn't know this, but the people of Natlan, especially their warriors, dress in imitation of their Saurians — and when in full panoply, they look every bit as brave!","nextNodeIds":[716650120]},{"nodeId":716650120,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":1009163746,"text":"I made myself a hat based on those of my Natlan friends. Pretty awesome, eh?","nextNodeIds":[716650121]},{"nodeId":716650121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1606808586,"text":"Um... Sure, it is pretty unique, but Paimon can't quite tell what you're talking about just from that.","nextNodeIds":[716650122]},{"nodeId":716650122,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":223490954,"text":"True, true! I mean, I haven't got a Saurian buddy with me, do I?","nextNodeIds":[716650123]},{"nodeId":716650123,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":1479766570,"text":"*sigh* It sure would be nice if I did, though. But I'm not a local, and to be honest, I'd get restless staying there for too long.","nextNodeIds":[716650124]},{"nodeId":716650124,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":514244730,"text":"That's why I thought to get myself a companion outside Natlan that could take the spot of a Saurian. Even if that doesn't work, it'll make a great story to tell my Natlan friends!","nextNodeIds":[716650125]},{"nodeId":716650125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2013513538,"text":"Uh, if that's your goal, you could've picked more suitable targets to make friends with, right?","nextNodeIds":[716650126]},{"nodeId":716650126,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3510855586,"text":"Huh? Don't you find them suitable? I mean, they're even like the Natlan Saurians — and they're also strong, to boot!","nextNodeIds":[716650127]},{"nodeId":716650127,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":4226723162,"text":"A Sumpter Beast companion's really nothing to brag about. I'll need a more demanding trial if I want a tale worth telling!","nextNodeIds":[716650128]},{"nodeId":716650128,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":2650375978,"text":"The real pity is that I can't be the \"protagonist\" myself... Calming these beasts that rage day and night is no easy task, let me tell you!","nextNodeIds":[716650129]},{"nodeId":716650129,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3439567298,"text":"But I suppose that's your field of expertise as an experienced adventurer, right? Of course, I'll provide support from the sidelines. Nets, food... You name it, you can leave it to me!","nextNodeIds":[716650130]},{"nodeId":716650130,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3575615898,"text":"But as for our \"negotiations\" with our prospective partners... The spotlight's going to be on you, dear \"protagonist\"!","nextNodeIds":[716650131]},{"nodeId":716650131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2200400578,"text":"Why are you foisting the dangerous stuff onto your protagonist?","nextNodeIds":[716650132,716650134]},{"nodeId":716650132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3420290674,"text":"The pay had better be worth the work...","nextNodeIds":[716650133]},{"nodeId":716650133,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3928930210,"text":"Of course, of course! Sure thing.","nextNodeIds":[716650136]},{"nodeId":716650136,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":3225588290,"text":"Well, since we're agreed, shall we head out now? My pots are ready, and my equipment's all checked. We should be good to go!","nextNodeIds":[716650137,716650138]},{"nodeId":716650137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":184141762,"text":"Let's go.","nextNodeIds":[]},{"nodeId":716650138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4125386938,"text":"I've got other things to handle. See you in a bit.","nextNodeIds":[716650139]},{"nodeId":716650139,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":2216183266,"text":"No worries. I'll wait for you here.","nextNodeIds":[]},{"nodeId":716650134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":105975570,"text":"I'm sure we can come to an agreement — if you convince me.","nextNodeIds":[716650135]},{"nodeId":716650135,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"Ranjit","textMapHash":2937745658,"text":"Of course, that's how these things work.","nextNodeIds":[716650136]},{"nodeId":716650110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":846505994,"text":"Concise, but clear as mud.","nextNodeIds":[716650111]},{"nodeId":716650104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":638459650,"text":"I don't understand what you're talking about...","nextNodeIds":[716650105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCL