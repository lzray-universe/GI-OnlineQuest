,"","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7612003,"initDialog":761200301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76120/Q7612003","priority":5,"questId":76120,"showRandomTalkCount":0},"dialogs":[{"nodeId":761200301,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":758245786,"text":"Hmm. A good choice.","nextNodeIds":[761200302]},{"nodeId":761200302,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":579681330,"text":"~!","nextNodeIds":[761200303]},{"nodeId":761200303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2126216962,"text":"She seems pretty pleased too— Whoa, straight to the canvas she goes!","nextNodeIds":[761200304]},{"nodeId":761200304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1959035338,"text":"Y'know, now that Paimon thinks about it, Maalaus's paintings pretty much cover your story from when you were born 'til now, Columbina.","nextNodeIds":[761200305]},{"nodeId":761200305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3043011154,"text":"And that story isn't over yet.","nextNodeIds":[761200306]},{"nodeId":761200306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3044904074,"text":"Yup! And Paimon wants to see more of our great painter's work, anyway.","nextNodeIds":[761200307]},{"nodeId":761200307,"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","textMapHash":851745762,"text":"!!!","nextNodeIds":[761200308]},{"nodeId":761200308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3624685042,"text":"Oh, done already? Quick as ever, huh.","nextNodeIds":[761200309]},{"nodeId":761200309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":692674698,"text":"Let Paimon see... Oohh! This is so pretty!","nextNodeIds":[761200310]},{"nodeId":761200310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3887247130,"text":"Paimon had no idea Teyvat looked so beautiful from the moon...","nextNodeIds":[761200311]},{"nodeId":761200311,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1051661922,"text":"Hah... Now I can understand why Maalaus says that I have changed.","nextNodeIds":[761200312]},{"nodeId":761200312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3886263738,"text":"Hmm? Why's that?","nextNodeIds":[761200313]},{"nodeId":761200313,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3273936490,"text":"When I see this painting, I remember...","nextNodeIds":[761200314]},{"nodeId":761200314,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3149759562,"text":"That as I sat on the moon, watching Teyvat, I thought about how I'd always been looking for a \"home\" of my own.","nextNodeIds":[761200315]},{"nodeId":761200315,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3585985370,"text":"But now, I suddenly have two homes, both of them places of such beauty.","nextNodeIds":[761200316]},{"nodeId":761200316,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1434661442,"text":"It was then that I realized that perhaps \"home\" is wherever the things and people you cherish are.","nextNodeIds":[761200317]},{"nodeId":761200317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2607047826,"text":"A lovely thought.","nextNodeIds":[761200318]},{"nodeId":761200318,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2322537282,"text":"Thank you. I think that after this, I'd like to take the kuuhenki to the moon more often.","nextNodeIds":[761200319]},{"nodeId":761200319,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3942167938,"text":"You're welcome to come visit my \"other home\" as well.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133603051","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":[],"PAINLIBBLDK":"QUEST_EXEC_ACTIVE_DAMSELETTE_FREE_MOON_PHASE"},{"LNHLPKELCAL":["7612001","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7612001,7612002,7612003,7612004],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","count":32},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":15702,"speakerName":"Maalaus","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1590122038,"CHECNJEM