"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76121/Q7612101","priority":5,"questId":76121,"showRandomTalkCount":0},"dialogs":[{"nodeId":761210101,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1385821170,"text":"♪~","nextNodeIds":[761210102]},{"nodeId":761210102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3105543370,"text":"Hey there, Columbina! You seem to be in a good mood today!","nextNodeIds":[761210103]},{"nodeId":761210103,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":527434106,"text":"Hah... Come on up.","nextNodeIds":[761210104]},{"nodeId":761210104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2087854642,"text":"You wanna play Moon Chess again or something?","nextNodeIds":[761210105]},{"nodeId":761210105,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":649276866,"text":"Yes. It has been a while, and I somewhat miss playing.","nextNodeIds":[761210106]},{"nodeId":761210106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1568886650,"text":"Are the rules the same as before?","nextNodeIds":[761210107]},{"nodeId":761210107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3022537338,"text":"Or, can you move multiple pieces per turn now because you're the Trilune Goddess?","nextNodeIds":[761210108]},{"nodeId":761210108,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2131167458,"text":"That would be cheating.","nextNodeIds":[761210109]},{"nodeId":761210109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2839002,"text":"Hehe, yeah, Paimon knows that! She was just kidding.","nextNodeIds":[761210110]},{"nodeId":761210110,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3584136938,"text":"Shall we begin, then?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7612102,"order":2,"stepDescription":"Play Moon Chess with Columbina","stepDescTextMapHash":1992397900,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7612102,7612103],"talks":[{"talkId":7612102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7612102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7612102,"initDialog":761210201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1318],"performCfg":"QuestDialogue/WQ/NodKrai_76121/Q7612102","priority":5,"questId":76121,"showRandomTalkCount":0},"dialogs":[{"nodeId":760540301,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3079223170,"text":"Perhaps... Like this?","nextNodeIds":[760540302]},{"nodeId":760540302,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1442356458,"text":"Hmm, let me think...","nextNodeIds":[760540303]},{"nodeId":760540303,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3165678466,"text":"Oh...","nextNodeIds":[760540304]},{"nodeId":760540304,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2495145410,"text":"Moons... Moons...","nextNodeIds":[760540305]},{"nodeId":760540305,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1823660322,"text":"How about here?","nextNodeIds":[760540306]},{"nodeId":760540306,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2122320666,"text":"Looks like I won this round.","nextNodeIds":[760540307]},{"nodeId":760540307,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":758871898,"text":"My three moons are connected.","nextNodeIds":[760540308]},{"nodeId":760540308,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1695856658,"text":"Mm, this should win it.","nextNodeIds":[760540309]},{"nodeId":760540309,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3684794546,"text":"Mm... The moons wax and wane in an endless cycle...","nextNodeIds":[760540310]},{"nodeId":760540310,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1979952002,"text":"It seems both sets of moons refuse to be eclipsed.","nextNodeIds":[760540311]},{"nodeId":760540311,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2578700082,"text":"Are we... heading for a tie?","nextNodeIds":[760540312]},{"nodeId":760540312,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":977090114,"text":"Ah, you weigh your decisions carefully before making them, I see. Take your time — we have plenty of that, after all.","nextNodeIds":[760540313]},{"nodeId":760540313,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1877855882,"text":"Did you forget how to place your moons in the night sky? Shall I help you?","nextNodeIds":[760540314]},{"nodeId":760540314,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4214694458,"text":"You don't like this game? Hm... I find it quite amusing myself.","nextNodeIds":[760540315]},{"nodeId":760540315,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3533271682,"text":"Mm? Are you staring at me? Your gaze is not subtle.","nextNodeIds":[760540316]},{"nodeId":760540316,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":711050466,"text":"You're staring... Is the truth of the moons written on my face?","nextNodeIds":[760540317]},{"nodeId":760540317,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":984229522,"text":"The board's over there, by the way...","nextNodeIds":[760540318]},{"nodeId":760540318,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2451451226,"text":"Hm, your moons are aligned.","nextNodeIds":[760540319]},{"nodeId":760540319,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2469296050,"text":"The night sky is yours.","nextNodeIds":[760540320]},{"nodeId":760540320,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1333058314,"text":"Ah... I must have... slipped up somewhere.","nextNodeIds":[760540321]},{"nodeId":760540321,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":391591778,"text":"You have a wonderful time playing the game with Columbina...","nextNodeIds":[760540322]},{"nodeId":761210202,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1421573674,"text":"The three moons, linked up in a line...","nextNodeIds":[761210203]},{"nodeId":761210203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3440586410,"text":"Huh? Still thinking about how that last match went?","nextNodeIds":[761210204]},{"nodeId":761210204,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":4069227426,"text":"Oh, no. It's just... Looking back on the game now gives me a peculiar feeling.","nextNodeIds":[761210205]},{"nodeId":761210205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3660515962,"text":"Oh, yeah. Now that you have the power of three moons, you've become more than just something that can dominate the night sky.","nextNodeIds":[761210206]},{"nodeId":761210206,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2291527930,"text":"Yes. And I also think... that the fate of the world may have been different, had there not been division between the three Moon Goddesses.","nextNodeIds":[761210207]},{"nodeId":761210207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2035085274,"text":"What were they like?","nextNodeIds":[761210208]},{"nodeId":761210208,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2326940754,"text":"The first one I saw was Sonnet, goddess of the Iridescent Moon. She was livelier than I'd imagined, more like a playful younger sister.","nextNodeIds":[761210209]},{"nodeId":761210209,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2590589898,"text":"Aria of the Eternal Moon, was the most mature of the three. She was a natural leader, and was most gentle to others. Ah, just like Lauma, actually.","nextNodeIds":[761210210]},{"nodeId":761210210,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1346145146,"text":"As for Canon of the Frost Moon... she seemed both wise and far-sighted. And it was she who gave her moon to me.","nextNodeIds":[761210211]},{"nodeId":761210211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":955431050,"text":"Sounds like all of them were kind deities.","nextNodeIds":[761210212]},{"nodeId":761210212,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2855047562,"text":"Yes. Despite their differences, they loved Teyvat, and they love this home.","nextNodeIds":[761210213]},{"nodeId":761210213,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3088727962,"text":"When I spoke to them of the things to come, they all seemed relieved, glad that this world still held so rich a future.","nextNodeIds":[761210214]},{"nodeId":761210214,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1259048946,"text":"That was also why they gave me the power to return \"home.\"","nextNodeIds":[761210215]},{"nodeId":761210215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":953885122,"text":"Huh... Paimon would love to see them, and give them a real proper \"thank you\"...","nextNodeIds":[761210216]},{"nodeId":761210216,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":294831642,"text":"I would very much like that as well. But I fear it's no longer possible...","nextNodeIds":[761210217]},{"nodeId":761210217,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3096746082,"text":"Fortunately, this world continues onward, and the humans they protected have survived, and pass on their stories to this day.","nextNodeIds":[761210218]},{"nodeId":761210218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1234052050,"text":"Exactly! As long as we live well and don't let the bad guys destroy the world — that's the best thanks we can give 'em!","nextNodeIds":[761210219,761210220]},{"nodeId":761210219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2732958530,"text":"You certainly have a way with words, Paimon...","nextNodeIds":[761210221]},{"nodeId":761210220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1591137154,"text":"In that case, every day's a thanks-giving for you...","nextNodeIds":[761210221]},{"nodeId":761210221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4158353418,"text":"Of course! You can bet Paimon's always trying to live her best life!","nextNodeIds":[761210222]},{"nodeId":761210222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1322681226,"text":"You too, Columbina! Eat well and sleep well every day, and come find us if you wanna play games!","nextNodeIds":[761210223]},{"nodeId":761210223,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1882097274,"text":"Haha, sure.","nextNodeIds":[761210224]},{"nodeId":761210224,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3262059866,"text":"I suspect that from now on, I shall think of those three gentle goddesses every time I play Moon Chess...","nextNodeIds":[]}]},{"talkId":7612103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7612102","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND