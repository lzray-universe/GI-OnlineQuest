","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7506801,7506802,7506803,7506804,7506805],"talks":[{"talkId":7506801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","2","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506801,"initDialog":750680101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21683],"performCfg":"QuestDialogue/WQ/Natlan_75068/Q7506801","priority":5,"questId":75068,"showRandomTalkCount":0},"dialogs":[{"nodeId":750680101,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1171162618,"text":"These inhuman creatures are truly tough adversaries... inhuman monsters, I should say. Greetings, brave warrior... I am Quenin, a member of this adventure team. My duty is...","nextNodeIds":[750680102]},{"nodeId":750680102,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":750266386,"text":"My duty... is to eliminate these monsters. Yes, I am a warrior of the adventure team. Be careful, brave warrior...","nextNodeIds":[750680103]},{"nodeId":750680103,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":2440629514,"text":"These monsters... they are extremely cunning — capable of disguising themselves in different forms.","nextNodeIds":[750680104]},{"nodeId":750680104,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":2614004898,"text":"Every night, before I fall asleep, I hear... the sounds they make from their hiding spots in these ancient ruins. This... is why I cannot sleep at the encampment.","nextNodeIds":[750680105]},{"nodeId":750680105,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1827808482,"text":"This place is filled with these monsters. You... must be careful, too.","nextNodeIds":[]}]},{"talkId":7506802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","3","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","2","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506802,"initDialog":750680201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21683],"performCfg":"QuestDialogue/WQ/Natlan_75068/Q7506802","priority":5,"questId":75068,"showRandomTalkCount":0},"dialogs":[{"nodeId":750680201,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":501939978,"text":"Ah, this place really is cursed...","nextNodeIds":[750680202]},{"nodeId":750680202,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1000822602,"text":"Do not tarry here too long. You must leave, and quickly... Yes, you must leave before the coming of the pitch-black tide.","nextNodeIds":[750680203]},{"nodeId":750680203,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":40316298,"text":"Yes, the pitch-black tide. Its vast shadow is almost upon us. We must... Must ensure that everyone gets to safety. That everyone... is safely evacuated.","nextNodeIds":[]}]},{"talkId":7506803,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","4","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","3","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506803,"initDialog":750680301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21683],"performCfg":"QuestDialogue/WQ/Natlan_75068/Q7506803","priority":5,"questId":75068,"showRandomTalkCount":0},"dialogs":[{"nodeId":750680301,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1802059570,"text":"Why do you linger here still...?","nextNodeIds":[750680302]},{"nodeId":750680302,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":4008089050,"text":"Our adventure team's leader, the hero who wore a falcon's mask, is already... We cannot hold out against them any longer...","nextNodeIds":[750680303]},{"nodeId":750680303,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1035810754,"text":"You must leave as soon as possible. This place is cursed, brave warrior. It is not somewhere that people should stay.","nextNodeIds":[]}]},{"talkId":7506804,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","5","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","4","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506804,"initDialog":750680401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21683],"performCfg":"QuestDialogue/WQ/Natlan_75068/Q7506804","priority":5,"questId":75068,"showRandomTalkCount":0},"dialogs":[{"nodeId":750680401,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":2287094034,"text":"So you are still here, brave warrior.","nextNodeIds":[750680402]},{"nodeId":750680402,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":3215530282,"text":"Once upon a time, so the scholars say, the ancient and tyrannical Lord of this Cinder City knew... a way to prevent Abyssal corrosion. So we...","nextNodeIds":[750680403]},{"nodeId":750680403,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1234777690,"text":"But there really is something ominous about this place, brave warrior. Lately, I too have begun to feel a little... strange.","nextNodeIds":[750680404]},{"nodeId":750680404,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1685785538,"text":"Sometimes, after waking, you'll find that a road that was perfectly intact just the day before has now become broken and dilapidated... And were those stone houses like that there to begin with? It feels like they should be more... complete.","nextNodeIds":[750680405]},{"nodeId":750680405,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":2085696778,"text":"But sometimes, when I wake, I see friends who should not be here anymore... Are they monsters? That must be it... They're monsters that have taken the form of my friends.","nextNodeIds":[750680406]},{"nodeId":750680406,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":4123800354,"text":"My... My duty here is to eliminate those monsters, but... why? Why do I have to do that?","nextNodeIds":[750680407]},{"nodeId":750680407,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":3182744114,"text":"Anyway, all things said and done, this is a very strange place. You should leave... as soon as possible.","nextNodeIds":[]}]},{"talkId":7506805,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","6","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","5","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506805,"initDialog":750680501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21683],"performCfg":"QuestDialogue/WQ/Natlan_75068/Q7506805","priority":5,"questId":75068,"showRandomTalkCount":0},"dialogs":[{"nodeId":750680501,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1182784554,"text":"You'd better leave at once. If you stay any longer, it'll be too late...","nextNodeIds":[750680502]},{"nodeId":750680502,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1101969834,"text":"Why will it be too late, you ask? Because... because our entire adventure team has been wiped out. That giant, pitch-black beast... They were all...","nextNodeIds":[750680503]},{"nodeId":750680503,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1730527090,"text":"They tasked me with protecting the evacuees, and at the very least, to ensure that they left the city. As we speak, a rescue team from the Flower-Feather Clan is on their way...","nextNodeIds":[750680504]},{"nodeId":750680504,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":3612215434,"text":"I must eliminate these evil monsters, so that the survivors can return to a land upon which the sun shines... Huh, but... Why am I here again?","nextNodeIds":[750680505]},{"nodeId":750680505,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":1312316314,"text":"That sound in my ears... Ahh, it's getting louder and louder. I... I have to go back to the waterfall. Yes, I must... return to the waterfall.","nextNodeIds":[750680506]},{"nodeId":750680506,"roleType":"TALK_ROLE_NPC","speakerId":21683,"speakerName":"Quenin","textMapHash":3418641866,"text":"Brave warrior, you too shou