{"mainQuestId":70690,"title":"Unexpected Commission","description":"One day, you receive an important commission from the Knights of Favonius...","titleTextMapHash":3842726303,"descTextMapHash":243227774,"mainQuestExcel":{"mainQuestId":70690,"titleTextMapHash":3842726303,"title":"Unexpected Commission","descTextMapHash":243227774,"description":"One day, you receive an important commission from the Knights of Favonius...","chapterId":10134,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ70690","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":10134,"descTextMapHash":243227774,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70690,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1125824297,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70690","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170690],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[70070],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3842726303,"type":"WQ","unlockDescTextMapHash":1359584390}},"flow":[{"subQuestId":7069001,"order":1,"stepDescription":"Go to the Knights of Favonius Headquarters","stepDescTextMapHash":1020307348,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[1004_257:-0.058,0.000,10.479]"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7069001],"talks":[{"talkId":7069001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7069001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7069001,"initDialog":706900101,"nextRandomTalks":[],"nextTalks":[7069002],"npcId":[1007],"performCfg":"QuestDialogue/WQ/Hexenzirkel_70690/Q7069001","priority":5,"questId":70690,"showRandomTalkCount":0},"dialogs":[{"nodeId":706900101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3677244522,"text":"Whoa, this is way too many books!","nextNodeIds":[706900102]},{"nodeId":706900102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":957349546,"text":"Considering this library-organizing job was classified as a premium commission, Paimon came mentally prepared, y'know?","nextNodeIds":[706900103]},{"nodeId":706900103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":569035586,"text":"But, seeing it in person is something else...","nextNodeIds":[706900104]},{"nodeId":706900104,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3032339834,"text":"Why, if it isn't cutie and Paimon! What brings you back to Mondstadt?","nextNodeIds":[706900105]},{"nodeId":706900105,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1612290410,"text":"Let me guess... You missed me so much, you just had to come visit, is that it?","nextNodeIds":[706900106,706900108]},{"nodeId":706900106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1871214306,"text":"You saw right through me.","nextNodeIds":[706900107]},{"nodeId":706900107,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2722630890,"text":"Hehe, you've become quite the flatterer since we last saw each other, haven't you?","nextNodeIds":[706900109]},{"nodeId":706900109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":632903218,"text":"Hehe, found you! We were starting to think you weren't clocking in today.","nextNodeIds":[706900110]},{"nodeId":706900110,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1602418738,"text":"Hehe, well, I wasn't planning to. But then, Katheryne mentioned someone had finally accepted an important commission for the library, so I came to check on things.","nextNodeIds":[706900111]},{"nodeId":706900111,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1494091370,"text":"Might you... both be here for that very commission, by any chance?","nextNodeIds":[706900112,706900113]},{"nodeId":706900112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2057815658,"text":"Pleased to meet you.","nextNodeIds":[706900114]},{"nodeId":706900114,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3736053234,"text":"Ah, music to my ears. Now, as you can see, a certain anonymous benefactor has donated a large amount of books to us.","nextNodeIds":[706900115]},{"nodeId":706900115,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2223014962,"text":"Imagine my surprise when a glance down the book list revealed that each one would be an entirely new addition to our collection.","nextNodeIds":[706900116]},{"nodeId":706900116,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":381333554,"text":"There are books of all different kinds, including quite a few that are banned... Troublesome, I know. So, this wasn't an odd job I could trust to just anyone.","nextNodeIds":[706900117]},{"nodeId":706900117,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2363085346,"text":"And sorting them myself... My, what a headache that would be. It would take ages!","nextNodeIds":[706900118]},{"nodeId":706900118,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":933624890,"text":"All that to say, I'm very relieved to see you here.","nextNodeIds":[706900119]},{"nodeId":706900119,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2610158002,"text":"I would treat you to some tea, of course, but looking at the state of this place... Perhaps another time, yes?","nextNodeIds":[706900120]},{"nodeId":706900120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3075040066,"text":"Don't worry! Just leave the commission to us!","nextNodeIds":[706900121]},{"nodeId":706900121,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2622337122,"text":"You're as sweet as ever, Paimon. Well then, good luck in here. I'll leave you to it.","nextNodeIds":[]},{"nodeId":706900113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1076739850,"text":"We're the only ones here, so... yeah.","nextNodeIds":[706900114]},{"nodeId":706900108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2999895834,"text":"Here for business, actually.","nextNodeIds":[706900109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1004","201004014,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["7069001","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[1004_257:-0.058,0.000,10.479]"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[{"talkId":7069002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7069002,"initDialog":706900201,"nextRandomTalks":[],"nextTalks":[],"npcId":[15181,1007],"performCfg":"QuestDialogue/WQ/Hexenzirkel_70690/Q7069002","priority":5,"questId":70690,"showRandomTalkCount":0},"dialogs":[{"nodeId":706900201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":859540898,"text":"Finally... We made it to the last stack.","nextNodeIds":[706900202]},{"nodeId":706900202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3680103066,"text":"What even are some of these books... \"A Hilichurl's Guide to Running for Your Life\"? Do Hilichurls even read? Oh, and \"Basics of Whopperflower Cultivation\"... Who'd grow one of those anyway!?","nextNodeIds":[706900203]},{"nodeId":706900203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3957955538,"text":"And, what's this one... \"The Little Witch's Dictionary\"? Huh, that title's kinda suspicious. And, didn't we already sort this area? Did you notice it earlier?","nextNodeIds":[706900204,706900206]},{"nodeId":706900204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2392244226,"text":"No, and it's not on the list either.","nextNodeIds":[706900205]},{"nodeId":706900205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1338188178,"text":"Huh, well \"witches\" always make Paimon think of... Y'know...","nextNodeIds":[706900207]},{"nodeId":706900207,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":1192531250,"text":"Yoohoo! Looking for me?","nextNodeIds":[706900208]},{"nodeId":706900208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1598030162,"text":"Alice? How did you get in here?","nextNodeIds":[706900209]},{"nodeId":706900209,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":3138049954,"text":"Hm? You must not have noticed, Paimon. I wasn't the one who barged in at all. When you opened that dictionary, you entered a mage's domain.","nextNodeIds":[706900210]},{"nodeId":706900210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2775362914,"text":"What!? Ugh, Paimon knew that book had issues!","nextNodeIds":[706900211]},{"nodeId":706900211,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":916600250,"text":"Hm, have you ever read the storybook, \"The Little Witch and the Undying Fire,\" by any chance?","nextNodeIds":[706900212,706900214]},{"nodeId":706900212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3266520970,"text":"I think so.","nextNodeIds":[706900213]},{"nodeId":706900213,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":2421606794,"text":"Splendid. That makes things easier to explain... This book was written as a dictionary for that other story. The actual contents of the two aren't related at all, though.","nextNodeIds":[706900216]},{"nodeId":706900216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":912481810,"text":"That explanation makes things even more confusing!","nextNodeIds":[706900217]},{"nodeId":706900217,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":389426026,"text":"Oh dear. Where should I begin... Ah, you know about the promise the Hexenzirkel made to Varka at the Tripartite Conference, yes?","nextNodeIds":[706900218]},{"nodeId":706900218,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":2033506122,"text":"Namely, that in Mondstadt's greatest time of need, the mages would return and lend their aid to the nation.","nextNodeIds":[706900219]},{"nodeId":706900219,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":920783746,"text":"Well, waiting around for danger to descend upon the land isn't exactly our style.","nextNodeIds":[706900220]},{"nodeId":706900220,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":2274253842,"text":"Rather than a scenario where we jump in and save the day out of nowhere, it makes more sense to lay the groundwork over time. That's how M put it.","nextNodeIds":[706900221]},{"nodeId":706900221,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":2482939554,"text":"Besides, who knows when such a crisis could occur? It could be in the next life, or even tomorrow. Preparation is crucial!","nextNodeIds":[706900222]},{"nodeId":706900222,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":3099687226,"text":"So, I gathered the mages together to write this dictionary. Of course, it had to be under the guise of being related to that storybook. Otherwise, I never would have been able to get them in one place.","nextNodeIds":[706900223,706900224]},{"nodeId":706900223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2733118306,"text":"Sounds like a lot of work.","nextNodeIds":[706900225]},{"nodeId":706900225,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":2379602938,"text":"Well, we looked into Barbie's scryglass and came up with a series of tasks tailor-made for the people of Mondstadt. They're all in this dictionary!","nextNodeIds":[706900226]},{"nodeId":706900226,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":3727064122,"text":"Striving toward a common goal, overcoming obstacles alongside trusted companions, becoming better versions of ourselves... That is the best defense against what dangers could lie ahead.","nextNodeIds":[706900227]},{"nodeId":706900227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3892655266,"text":"You make it sound like something bad is actually about to happen!","nextNodeIds":[706900228]},{"nodeId":706900228,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":2539303786,"text":"Now, now, I never said that! But still, we are talking about \"trusted companions\" here Paimon. And when we speak of a person who could be considered a friend to all in Mondstadt... I'm afraid the pool of options consists of but one.","nextNodeIds":[706900229,706900230]},{"nodeId":706900229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":375745522,"text":"I see what's going on here.","nextNodeIds":[706900231]},{"nodeId":706900231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4101530306,"text":"Wait. The huge book donation... That was just an excuse to get us here, wasn't it? We had to spend ages sorting through them, y'know!","nextNodeIds":[706900232]},{"nodeId":706900232,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":3758258690,"text":"Hmm? Oh dear, I never could have imagined you would need to go to such trouble.","nextNodeIds":[706900233]},{"nodeId":706900233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2941599162,"text":"Uh huh. Sure you didn't...","nextNodeIds":[706900234]},{"nodeId":706900234,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":1539473730,"text":"Hahaha, well, this is an important book. I couldn't just bring it into Teyvat without taking any precautions.","nextNodeIds":[706900235]},{"nodeId":706900235,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":1781836994,"text":"Much better to hide it in plain sight, you see. That's why I donated all those other books to the library.","nextNodeIds":[706900236]},{"nodeId":706900236,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":1416998794,"text":"Besides, it's not like this is a bad thing. Just... think of it as an excuse to reunite with old friends. And, as a favor to your dear Aunt Alice...","nextNodeIds":[706900237]},{"nodeId":706900237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1037197746,"text":"Okay, okay. If the goal is to help the people of Mondstadt, then we're in.","nextNodeIds":[706900238]},{"nodeId":706900238,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":33030506,"text":"We'll take the dictionary. And the next time we run into our friends, we'll pass your... \"tasks\" and stuff along, okay?","nextNodeIds":[706900239]},{"nodeId":706900239,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":4284500338,"text":"Wonderful! Then, I'll let you get to it. Have fun!","nextNodeIds":[]},{"nodeId":706900230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":786901066,"text":"I should've seen this coming...","nextNodeIds":[706900231]},{"nodeId":706900224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4234145338,"text":"So, how do we factor in, exactly?","nextNodeIds":[706900225]},{"nodeId":706900214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2198005394,"text":"First I've heard of it.","nextNodeIds":[706900215]},{"nodeId":706900215,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","textMapHash":4118960066,"text":"No matter. At least in name, this book was written as a dictionary for the other one. The actual contents of the two aren't related at all, though.","nextNodeIds":[706900216]},{"nodeId":706900206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2747028978,"text":"Yeah...","nextNodeIds":[706900207]}]}],"questNarration":[],"talkIds":[7069001,7069002],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"Alice","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","count":12},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":12}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170690],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":243227774,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[70070],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Hexenzirkel_70690/Q7069001","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[7069002],"DIA