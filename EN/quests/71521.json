{"mainQuestId":71521,"title":"Mending Painting Prospects","description":"Batlo from Mondstadt appears to have something on his mind...","titleTextMapHash":1439243719,"descTextMapHash":2921717054,"mainQuestExcel":{"mainQuestId":71521,"titleTextMapHash":1439243719,"title":"Mending Painting Prospects","descTextMapHash":2921717054,"description":"Batlo from Mondstadt appears to have something on his mind...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2025,"luaPath":"Actor/Quest/WQ71521","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2025,"chapterId":0,"descTextMapHash":2921717054,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71521,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1065368841,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71521","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171521],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1439243719,"type":"WQ","unlockDescTextMapHash":2600451150}},"flow":[{"subQuestId":7152101,"order":1,"stepDescription":"Talk to Batlo","stepDescTextMapHash":2633372916,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30424"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7152101],"talks":[{"talkId":7152101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7152101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7152101,"initDialog":715210101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30424],"performCfg":"QuestDialogue/WQ/V4.1PoetryActivity/Q7152101","priority":0,"questId":71521,"showRandomTalkCount":0},"dialogs":[{"nodeId":715210101,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":104833130,"text":"The next painting is... Right. It's this one...","nextNodeIds":[715210102]},{"nodeId":715210102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4257791618,"text":"What are you doing?","nextNodeIds":[715210103]},{"nodeId":715210103,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2885696882,"text":"#You are... {NICKNAME}! Your reputation precedes you!","nextNodeIds":[715210104]},{"nodeId":715210104,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2146891098,"text":"I heard so much about you from my colleagues and was wondering if you would grace this grand event.","nextNodeIds":[715210105]},{"nodeId":715210105,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1751911410,"text":"And as luck would have it, here you are! It is truly an honor to meet you!","nextNodeIds":[715210106]},{"nodeId":715210106,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3909085178,"text":"There are many things I wish to introduce to you, but before that, allow me to introduce myself.","nextNodeIds":[715210107]},{"nodeId":715210107,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":4092372954,"text":"I am Batlo, a painter... You should be quite familiar with this profession, no?","nextNodeIds":[715210108]},{"nodeId":715210108,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":246502274,"text":"But in addition to being a painter myself, I am also an art conservator.","nextNodeIds":[715210109]},{"nodeId":715210109,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3073203738,"text":"No matter what type of damage a painting has suffered, whether it was burnt, chewed on by rodents, rotted by mold, or any similar matter...","nextNodeIds":[715210110]},{"nodeId":715210110,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3631370522,"text":"As long as it is in my hands, I can restore the painting to its original, most perfect state!","nextNodeIds":[715210111]},{"nodeId":715210111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4252432474,"text":"Restoring paintings... Do you just repaint them?","nextNodeIds":[715210112]},{"nodeId":715210112,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":104963266,"text":"Hahaha! Of course not. Were I to just repaint them exactly as they were, that would be called \"copying.\"","nextNodeIds":[715210113]},{"nodeId":715210113,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2043145050,"text":"What we art conservators must do is restore a piece of artwork to its most original pristine condition.","nextNodeIds":[715210114]},{"nodeId":715210114,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1305225338,"text":"Every detail, from the colors to the brushstrokes... Even the material of the canvas itself must be exactly the same as the original painting.","nextNodeIds":[715210115,715210116]},{"nodeId":715210115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1206979594,"text":"That sounds complicated...","nextNodeIds":[715210117]},{"nodeId":715210117,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3950389242,"text":"Isn't it? It takes exceptional painting skill, as well as uncommonly keen and detailed image perception.","nextNodeIds":[715210118]},{"nodeId":715210118,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3153359706,"text":"Which is why... I simply haven't been able to hire many capable assistants.","nextNodeIds":[715210119]},{"nodeId":715210119,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1804980994,"text":"I mean, if a painter has both exceptional skills and a keen perception of the smallest details...","nextNodeIds":[715210120]},{"nodeId":715210120,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1004893090,"text":"Then why not just focus on their own work instead of helping restore that of other artists?","nextNodeIds":[715210121]},{"nodeId":715210121,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3392361474,"text":"Not to mention how this job doesn't pay well, and how people often think of us as a bunch of copycats with mediocre skills...","nextNodeIds":[715210122]},{"nodeId":715210122,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":84308522,"text":"But every job needs to be done by someone, wouldn't you agree?","nextNodeIds":[715210123]},{"nodeId":715210123,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1624397378,"text":"Art is a precious thing. An outstanding painting can carry history, stories, and emotions... and of course its market value.","nextNodeIds":[715210124]},{"nodeId":715210124,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2215334450,"text":"No matter what others think, as an artist myself, I will not stand idly by and watch those paintings deteriorate.","nextNodeIds":[715210125]},{"nodeId":715210125,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3805030298,"text":"But... as I just said, this job doesn't pay well, and is often misunderstood.","nextNodeIds":[715210126]},{"nodeId":715210126,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3275954402,"text":"Though I've been busy trying to recruit assistants, as you can see, as of now I'm still the only one doing the job.","nextNodeIds":[715210127]},{"nodeId":715210127,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2931929994,"text":"That's why I'm here today. I want to educate people about what an art conservator does, and perhaps I'll be able to recruit a few more people this way.","nextNodeIds":[715210128]},{"nodeId":715210128,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2643689642,"text":"However... Though I've yet to find an assistant, I have received numerous commissions to restore ancient paintings.","nextNodeIds":[715210129]},{"nodeId":715210129,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":820108490,"text":"These old paintings come from Mondstadt and Liyue. They include landscapes, figures, animals, and even... crayon drawings from children...","nextNodeIds":[715210130]},{"nodeId":715210130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4023049626,"text":"You restore crayon drawings, too?","nextNodeIds":[715210131]},{"nodeId":715210131,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1874167802,"text":"Uh... In principle, as long as it's a painting, it's a valid commission.","nextNodeIds":[715210132]},{"nodeId":715210132,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2124049770,"text":"Besides, even a child's crayon drawing contains the hard work they poured into it. Who is to say it may not be their first step to becoming an artist one day?","nextNodeIds":[715210133]},{"nodeId":715210133,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":530448418,"text":"So, it's understandable that their parents would come to me for to restore it.","nextNodeIds":[715210134,715210136]},{"nodeId":715210134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2282483202,"text":"Your expression says you haven't even managed to convince yourself...","nextNodeIds":[715210135]},{"nodeId":715210135,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1129804362,"text":"What? No! Not at all! I am absolutely not exasperated by these sorts of requests... I just have to study crayon drawings a bit...","nextNodeIds":[715210138]},{"nodeId":715210138,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2460524034,"text":"#{NICKNAME}, if you could, would you be willing to do me a favor?","nextNodeIds":[715210139]},{"nodeId":715210139,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2037780754,"text":"As you can see, I'm the only one here... But to restore a painting, I need to go out and find the relevant scenery painted therein...","nextNodeIds":[715210140,715210141]},{"nodeId":715210140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":87412346,"text":"You need to go out and find the original scenery?","nextNodeIds":[715210142]},{"nodeId":715210142,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":4009612394,"text":"Alas, indeed! Not only that, I also have to do all kinds of research on materials relevant to the painting.","nextNodeIds":[715210143]},{"nodeId":715210143,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":861907122,"text":"For example, how the scenery and animals depicted looked like at the time they were painted...","nextNodeIds":[715210144]},{"nodeId":715210144,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3094027442,"text":"Fortunately, the paintings I'm currently commissioned to restore aren't too old, so things shouldn't have changed drastically.","nextNodeIds":[715210145]},{"nodeId":715210145,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1623562682,"text":"I was about to head out to study the original locations, but as you know... the wilderness is a dangerous place for those more adept with the brush than the sword...","nextNodeIds":[715210146]},{"nodeId":715210146,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3184140930,"text":"That's why I'd like to ask you to find the relevant scenery for me.","nextNodeIds":[715210147]},{"nodeId":715210147,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1990555506,"text":"I'm not artistically gifted...","nextNodeIds":[715210148]},{"nodeId":715210148,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":237945746,"text":"No worries! I have already prepared everything that you'll need... I've done this before when hiring others to help me in the past...","nextNodeIds":[715210149]},{"nodeId":715210149,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2417825394,"text":"Look! This is a photo of the painting to be restored, and I have already marked the key landmarks in it.","nextNodeIds":[715210150]},{"nodeId":715210150,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":2374884706,"text":"All you need to do is to find the location and take photos of the marked objects with this Kamera, and you're done!","nextNodeIds":[715210151]},{"nodeId":715210151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1418469082,"text":"So... I just need to take photos?","nextNodeIds":[715210152]},{"nodeId":715210152,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":390796514,"text":"That's right, but you ought to familiarize yourself with the paintings before taking the picture.","nextNodeIds":[715210153]},{"nodeId":715210153,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1164070922,"text":"You need to feel their aesthetics and artistic sense... Let the paintings linger in your mind.","nextNodeIds":[715210154]},{"nodeId":715210154,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":910773346,"text":"As long as you understand them, perhaps you'll be able to sense the entire process of how these paintings were done while taking photos.","nextNodeIds":[715210155]},{"nodeId":715210155,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":108439578,"text":"Sketching, outlining, coloring, refining the details...","nextNodeIds":[715210156,715210157]},{"nodeId":715210156,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":941664938,"text":"You mean like... a hallucination?","nextNodeIds":[715210158]},{"nodeId":715210158,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1257608650,"text":"You are correct. To me, art... is a type of hallucination...","nextNodeIds":[715210159]},{"nodeId":715210159,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":135535690,"text":"What an artist must do is capture the hallucination in detail and express it objectively.","nextNodeIds":[715210160]},{"nodeId":715210160,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1799835474,"text":"Believe me, just study the photos I give you, and you will surely feel the \"artistic hallucinations\" within.","nextNodeIds":[715210161]},{"nodeId":715210161,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1058005898,"text":"#I entrust this task to you, {NICKNAME}.","nextNodeIds":[715210162]},{"nodeId":715210162,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":1807057850,"text":"And I... shall start on restoring these paintings... Right. The next one is...","nextNodeIds":[]},{"nodeId":715210157,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2994439426,"text":"Hallucinating it does seem a bit much...","nextNodeIds":[715210158]},{"nodeId":715210141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2674121210,"text":"That's quite a lot of preparation.","nextNodeIds":[715210142]},{"nodeId":715210136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":974174858,"text":"Do you know how to do crayon drawings?","nextNodeIds":[715210137]},{"nodeId":715210137,"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","textMapHash":3608105850,"text":"S—Sure! I'm just not an expert crayon artist, and I'm only superficially familiar with the literature. So I must study up on knowledge regarding crayon drawings!","nextNodeIds":[715210138]},{"nodeId":715210116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1342985346,"text":"That sounds amazing.","nextNodeIds":[715210117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30424"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7152101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30424,"speakerName":"Batlo","count":49},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":13}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171521],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2921717054,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFC