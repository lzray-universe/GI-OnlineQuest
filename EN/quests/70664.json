{"mainQuestId":70664,"title":"Windswept Domain","description":"You meet an adventurer in Liyue...","titleTextMapHash":1106775007,"descTextMapHash":3678800334,"mainQuestExcel":{"mainQuestId":70664,"titleTextMapHash":1106775007,"title":"Windswept Domain","descTextMapHash":3678800334,"description":"You meet an adventurer in Liyue...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5095,"luaPath":"Actor/Quest/WQ70664","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5095,"chapterId":0,"descTextMapHash":3678800334,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70664,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2649100633,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70664","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170664],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1106775007,"type":"WQ","unlockDescTextMapHash":2234802774}},"flow":[{"subQuestId":7066401,"order":1,"stepDescription":"Talk to Honglang","stepDescTextMapHash":4291538836,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30153"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7066401],"talks":[{"talkId":7066401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7066401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7066401,"initDialog":706640101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30153],"performCfg":"QuestDialogue/WQ/Mengde_70664/Q7066401","priority":5,"questId":70664,"showRandomTalkCount":0},"dialogs":[{"nodeId":706640101,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":611321834,"text":"Every time there's trouble, they send me to fix it...","nextNodeIds":[706640102,706640103]},{"nodeId":706640102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1850375426,"text":"Oh, aren't you...?","nextNodeIds":[706640104]},{"nodeId":706640104,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":189883794,"text":"It's you! What a coincidence! I never expected to meet you here of all places.","nextNodeIds":[706640105]},{"nodeId":706640105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1549571834,"text":"What are you doing here?","nextNodeIds":[706640106]},{"nodeId":706640106,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3911197282,"text":"*sigh* Don't ask. Remember that peculiar Domain? You know... the one where the internal structure changed according to one's mind?","nextNodeIds":[706640107]},{"nodeId":706640107,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":685960370,"text":"I was able to gather quite a lot of information thanks to your help in getting me in there to explore. After the Domain disappeared, I went back to report to Lan.","nextNodeIds":[706640108]},{"nodeId":706640108,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1565485338,"text":"I reiterated to her that I couldn't have managed this case without your help. I only provided a negligible amount of support.","nextNodeIds":[706640109]},{"nodeId":706640109,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":917138098,"text":"But she wouldn't listen and even commended my work before asking me to lead a team to explore more unknown Domains of that sort.","nextNodeIds":[706640110,706640111]},{"nodeId":706640110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2993312322,"text":"That doesn't sound like a half bad gig.","nextNodeIds":[706640112]},{"nodeId":706640112,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3069770650,"text":"What's so good about it? I used to just be a regular old adventurer with nothing stopping me from doing whatever I pleased.","nextNodeIds":[706640113]},{"nodeId":706640113,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2491116898,"text":"I may have earned less before, but I had my freedom. Now I'm stuck with this title Lan gave me...","nextNodeIds":[706640114]},{"nodeId":706640114,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":940683002,"text":"Enough about that, let's get down to business. See this door beside me? Behind it is another peculiar Domain.","nextNodeIds":[706640115]},{"nodeId":706640115,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2337146274,"text":"And this Domain is chock-a-block full of wind currents.","nextNodeIds":[706640116]},{"nodeId":706640116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":469127586,"text":"Wind currents? As in the usual kind?","nextNodeIds":[706640117]},{"nodeId":706640117,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2329794130,"text":"Yep, you know, those whooshing, swooshing wind currents you find outside. Adventurers often use them to fly even higher on their wind gliders.","nextNodeIds":[706640118]},{"nodeId":706640118,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2814674218,"text":"But the distribution of the wind currents in this Domain is a total mess. Some of them even collide with each other, forming areas that can't be flown through.","nextNodeIds":[706640119]},{"nodeId":706640119,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":300732882,"text":"I invited a few adventurers known to be handy with wind gliders to go in and investigate, but without fail, each one barely made it in before being forced to withdraw.","nextNodeIds":[706640120]},{"nodeId":706640120,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2988519938,"text":"They also reported finding mechanisms inside, and that activating them seems to affect some of the wind currents...","nextNodeIds":[706640121]},{"nodeId":706640121,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2507046962,"text":"But before they could work out the mechanisms' specific uses, a bunch of monsters appeared out of nowhere, so they had to pull out.","nextNodeIds":[706640122]},{"nodeId":706640122,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2454051746,"text":"After some discussion, we concluded that if we can make clever use of these mechanisms, it should make exploring this Domain a whole lot easier...","nextNodeIds":[706640123,706640124]},{"nodeId":706640123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2935785962,"text":"Have you gone in to explore yourself?","nextNodeIds":[706640125]},{"nodeId":706640125,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3886393130,"text":"Come on, don't act like you don't know! I'm, um... not the most physically fit, and I'm not so great with a wind glider either.","nextNodeIds":[706640126]},{"nodeId":706640126,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2289341514,"text":"I can just about manage flights under normal conditions, but when it comes to the situation in this Domain...","nextNodeIds":[706640127]},{"nodeId":706640127,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3231604346,"text":"If I went in to explore, I'd probably get blown around like a leaf before crashing headlong into a horde of monsters.","nextNodeIds":[706640128]},{"nodeId":706640128,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2534124586,"text":"Traveler, I saw how well you did the last time. You've got decent stamina, and a good head on your shoulders, too...","nextNodeIds":[706640129]},{"nodeId":706640129,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":890610602,"text":"Would you be willing to help me out once more and explore this Domain?","nextNodeIds":[706640130]},{"nodeId":706640130,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3493789882,"text":"As for payment, don't worry. I've got you more than covered.","nextNodeIds":[706640131,706640133]},{"nodeId":706640131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2646289514,"text":"Okay, I guess I'll try.","nextNodeIds":[706640132]},{"nodeId":706640132,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":2563714946,"text":"Great, I'm counting on you, then!","nextNodeIds":[]},{"nodeId":706640133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2980945562,"text":"Is there treasure inside?","nextNodeIds":[706640134]},{"nodeId":706640134,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":1914753210,"text":"Since we've barely been able to explore this Domain, I can't say for sure...","nextNodeIds":[706640135]},{"nodeId":706640135,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3133833618,"text":"But you can keep any treasure that you find while exploring!","nextNodeIds":[706640136]},{"nodeId":706640136,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","textMapHash":3665244610,"text":"I'm counting on you, Traveler.","nextNodeIds":[]},{"nodeId":706640124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2666237042,"text":"You didn't lead the charge?","nextNodeIds":[706640125]},{"nodeId":706640111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2095067322,"text":"Isn't it a good thing?","nextNodeIds":[706640112]},{"nodeId":706640103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3964394282,"text":"We meet again.","nextNodeIds":[706640104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30153"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7066401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"Honglang","count":26},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170664],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3678800334,"CHECNJEMEFE":{"30153":[1240]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70664/Q7066401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINN