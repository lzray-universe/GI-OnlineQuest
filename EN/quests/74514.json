{"mainQuestId":74514,"title":"Outside the Canvas, Inside the Lens: Dew-Kissed Chapter","description":"You once again encounter the illustrator Asagiri in Fontaine...","titleTextMapHash":1959203991,"descTextMapHash":1418570974,"mainQuestExcel":{"mainQuestId":74514,"titleTextMapHash":1959203991,"title":"Outside the Canvas, Inside the Lens: Dew-Kissed Chapter","descTextMapHash":1418570974,"description":"You once again encounter the illustrator Asagiri in Fontaine...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5201,"luaPath":"Actor/Quest/WQ74514","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5201,"chapterId":0,"descTextMapHash":1418570974,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74514,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3600668297,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74514","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174514],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1959203991,"type":"WQ","unlockDescTextMapHash":1778076926}},"flow":[{"subQuestId":7451401,"order":1,"stepDescription":"Talk to Asagiri","stepDescTextMapHash":516757084,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30567"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7451401],"talks":[{"talkId":7451401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7451401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451401,"initDialog":745140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30567],"performCfg":"QuestDialogue/WQ/ActivityPhotoGraphV4_74514/Q7451401","priority":5,"questId":74514,"showRandomTalkCount":0},"dialogs":[{"nodeId":745140101,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":2296645946,"text":"S—So cold... I definitely shouldn't have just gone out into the wind willy-nilly...","nextNodeIds":[745140102]},{"nodeId":745140102,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":3818701426,"text":"#...Huh? {NICKNAME}! Paimon! It's yo—AH-CHOO!","nextNodeIds":[745140103]},{"nodeId":745140103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4140846082,"text":"Asagiri? What're you doing here?","nextNodeIds":[745140104]},{"nodeId":745140104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3437968674,"text":"Are you okay? How'd you make it out this far all by yourself...","nextNodeIds":[745140105]},{"nodeId":745140105,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":47344010,"text":"I'm... well... fine! I'm much better now! See, I'm not even coughing anymore.","nextNodeIds":[745140106]},{"nodeId":745140106,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":4209731250,"text":"Haha... ha...","nextNodeIds":[745140107,745140108]},{"nodeId":745140107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3391830130,"text":"You sure about that?","nextNodeIds":[745140109]},{"nodeId":745140109,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":33697154,"text":"Whoa! No need! I admit it, I sneaked out on my own! Happy?","nextNodeIds":[745140110]},{"nodeId":745140110,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":1811003274,"text":"I... I didn't have a choice. How could I possibly paint beautiful pictures if I just sat in Inazuma all the time?","nextNodeIds":[745140111]},{"nodeId":745140111,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":695539226,"text":"Even if I have you running around taking pictures for me, picture references can't compare to seeing things with your own eyes.","nextNodeIds":[745140112]},{"nodeId":745140112,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":3783728242,"text":"So, I asked an author I worked with before to contact a merchant ship for me, and quietly hitched a ride with them so I could travel.","nextNodeIds":[745140113]},{"nodeId":745140113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3145258450,"text":"And you even brought all your painting tools with you...","nextNodeIds":[745140114]},{"nodeId":745140114,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":553375066,"text":"But of course! The canvas is my very soul! How could I ever abandon any of them?","nextNodeIds":[745140115]},{"nodeId":745140115,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":217975186,"text":"Plus, my paintings are selling exceptionally well in Fontaine. A few Fontainian authors have even asked me to do the covers for their novels!","nextNodeIds":[745140116]},{"nodeId":745140116,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":1740075146,"text":"Though... Apparently putting illustrations throughout novels isn't a thing for them! Truly strange...","nextNodeIds":[745140117]},{"nodeId":745140117,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":1155909082,"text":"#Oh, right... Since you happen to be here, {NICKNAME}... Would you mind helping me collect some reference materials?","nextNodeIds":[745140118,745140120]},{"nodeId":745140118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1466145194,"text":"Leave it to me.","nextNodeIds":[745140119]},{"nodeId":745140119,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":150814442,"text":"Excellent! With you helping out, I know the job's as good as done.","nextNodeIds":[745140123]},{"nodeId":745140123,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":170746466,"text":"Okay, let me have a look. As it happens, I've received a few more commissions from some authors...","nextNodeIds":[]},{"nodeId":745140120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3402098330,"text":"Alright then, but don't go running off.","nextNodeIds":[745140121]},{"nodeId":745140121,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":263237682,"text":"I know! Not like I can deal with those clockwork meka anyway.","nextNodeIds":[745140122]},{"nodeId":745140122,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"Asagiri","textMapHash":3698016962,"text":"When it comes to dealing with all kinds of weird monsters, you're the creme de la creme.","nextNodeIds":[745140123]},{"nodeId":745140108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":115492618,"text":"Let me write back and check.","nextNodeIds":[745140109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30567"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7451401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC"