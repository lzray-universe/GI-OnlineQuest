{"mainQuestId":10005,"title":"Old Friends and New Knowledge","description":"Guided by the witch's dictionary, you head to Dragonspine to bring Albedo a brand-new assignment...","titleTextMapHash":1638154655,"descTextMapHash":1986044670,"mainQuestExcel":{"mainQuestId":10005,"titleTextMapHash":1638154655,"title":"Old Friends and New Knowledge","descTextMapHash":1986044670,"description":"Guided by the witch's dictionary, you head to Dragonspine to bring Albedo a brand-new assignment...","chapterId":2078,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ10005","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":2078,"descTextMapHash":1986044670,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":10005,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2457153713,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ10005","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[110005],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[29026],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1638154655,"type":"WQ","unlockDescTextMapHash":223007918}},"flow":[{"subQuestId":1000501,"order":1,"stepDescription":"Go to Dragonspine","stepDescTextMapHash":3647947316,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1000501,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIH