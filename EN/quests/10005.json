bleTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1000502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1000502,"initDialog":100050201,"nextRandomTalks":[],"nextTalks":[1000513,1000514],"npcId":[1018],"performCfg":"QuestDialogue/WQ/Mengde_10005/Q1000502","priority":5,"questId":10005,"showRandomTalkCount":0},"dialogs":[{"nodeId":100050201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":222675194,"text":"Hey, Albedo! Thought we'd find you here. Oh! Are you painting?","nextNodeIds":[100050202]},{"nodeId":100050202,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1745973578,"text":"Yes. I finally have a moment to myself, so I decided to pick up my brush and get some practice in.","nextNodeIds":[100050203]},{"nodeId":100050203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":118802674,"text":"Yeah, a lot of stuff has happened, huh...","nextNodeIds":[100050204]},{"nodeId":100050204,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2118303194,"text":"Indeed. Of course, thanks to your help, and my fellow Knights, that matter was resolved with little issue.","nextNodeIds":[100050205]},{"nodeId":100050205,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1072444266,"text":"In addition, I was able to complete the final task my master left for me.","nextNodeIds":[100050206]},{"nodeId":100050206,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4070965522,"text":"I couldn't have asked for a better outcome.","nextNodeIds":[100050207]},{"nodeId":100050207,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3611663642,"text":"Sucrose has been advancing swiftly in her studies, too. She can tackle many alchemy projects on her own now.","nextNodeIds":[100050208]},{"nodeId":100050208,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":111294674,"text":"The Knights of Favonius don't have any duties for me at the moment, either...","nextNodeIds":[100050209]},{"nodeId":100050209,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1708569426,"text":"No responsibilities, no tasks, no problems to resolve...","nextNodeIds":[100050210,100050211]},{"nodeId":100050210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3148667522,"text":"Are you okay?","nextNodeIds":[100050212]},{"nodeId":100050212,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1186702962,"text":"It's not. It just feels strange, not having to wrack my brain for solutions to all manner of problems...","nextNodeIds":[100050213]},{"nodeId":100050213,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":133235986,"text":"To be quite honest, I'm finding the idle life a bit... hard to get used to.","nextNodeIds":[100050214]},{"nodeId":100050214,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1684789242,"text":"I keep finding myself considering if there might be other issues that need solving.","nextNodeIds":[100050215]},{"nodeId":100050215,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3977383346,"text":"But, unfortunately for me, Mondstadt seems perfectly problem-free at the moment...","nextNodeIds":[100050216]},{"nodeId":100050216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3611764050,"text":"There's nothing wrong with enjoying a bit of \"me\" time. Nothing good comes from working yourself to the bone.","nextNodeIds":[100050217]},{"nodeId":100050217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3197683498,"text":"But if you're really that bored, you can come hang out with us! Paimon will teach you the true art of doing nothing!","nextNodeIds":[100050218]},{"nodeId":100050218,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":595996626,"text":"Haha, well, I suppose I should learn from the best.","nextNodeIds":[100050219,100050220]},{"nodeId":100050219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2495127658,"text":"And if you're looking for trouble...","nextNodeIds":[100050221]},{"nodeId":100050221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":493180466,"text":"#{NICKNAME}! Don't say things like that! You're gonna jinx us!","nextNodeIds":[]},{"nodeId":100050220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1249087754,"text":"I have a knack for finding it...","nextNodeIds":[100050221]},{"nodeId":100050211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3726188858,"text":"You make that sound like a bad thing...","nextNodeIds":[100050212]}]},{"talkId":1000512,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1000502","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1000512,"initDialog":100051201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1018],"performCfg":"QuestDialogue/WQ/Mengde_10005/Q1000512","priority":5,"questId":10005,"showRandomTalkCount":0},"dialogs":[{"nodeId":100051201,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3557042826,"text":"New questions...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1000513,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[1000514,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1000501","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["133002179","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1018"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":1000513,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1000601","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":1000513,"initDialog":100051301,"nextRandomTalks":[],"nextTalks":[],"npcId":[15861,1018,16025],"performCfg":"QuestDialogue/WQ/Mengde_10005/Q1000513","priority":5,"questId":10005,"showRandomTalkCount":0},"dialogs":[{"nodeId":100051301,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":1431019218,"text":"Strange to see you so idle, Albedo.","nextNodeIds":[100051302]},{"nodeId":100051302,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":1595911442,"text":"But considering that you've completed Master Rhinedottir's final task, I suppose you deserve a break.","nextNodeIds":[100051303]},{"nodeId":100051303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":379848314,"text":"See! What did Paimon tell you? You ask for trouble, and here it comes!","nextNodeIds":[100051304]},{"nodeId":100051304,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3457629522,"text":"Sebas? What are you doing here?","nextNodeIds":[100051305]},{"nodeId":100051305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3115917514,"text":"Wait. You know this cat, Albedo?","nextNodeIds":[100051306]},{"nodeId":100051306,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3484821018,"text":"Yes. He's also one of my master's creations. I suppose that makes him a... family member, of sorts.","nextNodeIds":[100051307]},{"nodeId":100051307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1914937186,"text":"Ever the unconventional family you've got there.","nextNodeIds":[100051308]},{"nodeId":100051308,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":664567458,"text":"Hmph, don't you take that tone with me. I'll have you know that I alone keep that giant house in order as its butler.","nextNodeIds":[100051309]},{"nodeId":100051309,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":4285658922,"text":"And yes, that has meant dealing with the assorted collection of vials and jars that you and Master use, washing them, drying them... All that work, done by one cat!","nextNodeIds":[100051310]},{"nodeId":100051310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2507594866,"text":"Wait. You're a butler? How does that work? How do you handle vials and stuff without... y'know, thumbs?","nextNodeIds":[100051311]},{"nodeId":100051311,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":1019876098,"text":"How do you stay afloat in mid-air?","nextNodeIds":[100051312]},{"nodeId":100051312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3359269546,"text":"Huh? It's just something Paimon's always known how to do.","nextNodeIds":[100051313]},{"nodeId":100051313,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":3908674450,"text":"Housekeeping is the same for me. Such facts are not up for question, and shall receive no answers.","nextNodeIds":[100051314]},{"nodeId":100051314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3667811562,"text":"Hey! You're not allowed to say the same answer that Paimon said, you—","nextNodeIds":[100051315,100051316]},{"nodeId":100051315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1546718858,"text":"This cat belongs to Rhinedottir, Paimon...","nextNodeIds":[100051317]},{"nodeId":100051317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2236041306,"text":"Ugh. Sure, but don't expect Paimon to listen to his rambling...","nextNodeIds":[100051318]},{"nodeId":100051318,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":252715554,"text":"Allow me to get to the point, then. I'm here at Master Rhindottir's request. She has a message for me to pass along.","nextNodeIds":[100051319]},{"nodeId":100051319,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":2143962722,"text":"Ahem!","nextNodeIds":[100051320]},{"nodeId":100051320,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":2920319298,"text":"\"Dearest Albedo, in regard to that task I set for you, your discovery of an answer that you can accept is most delightful.\"","nextNodeIds":[100051321]},{"nodeId":100051321,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":3215533714,"text":"\"Alas, once a problem is solved, mulling it over in one's head loses all meaning.\"","nextNodeIds":[100051322]},{"nodeId":100051322,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":3185640826,"text":"\"I'm sure the pendulum in your ever-whirring mind is swinging toward 'boredom' as we speak.\"","nextNodeIds":[100051323]},{"nodeId":100051323,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":4178677594,"text":"\"Might I suggest posing questions of your own, then?\"","nextNodeIds":[100051324]},{"nodeId":100051324,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":1552759178,"text":"\"Cast 'the answers you know' aside. Instead, embrace 'the questions you don't.'\"","nextNodeIds":[100051325]},{"nodeId":100051325,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":900764490,"text":"\"After all, questions have always been more interesting than answers, and much better for passing the time.\"","nextNodeIds":[100051326]},{"nodeId":100051326,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":1741348698,"text":"\"I look forward to what questions you'll bring me upon our next meeting.\"","nextNodeIds":[100051327]},{"nodeId":100051327,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":3078924882,"text":"\"And should you come up with ones even I've never considered, all the better.\"","nextNodeIds":[100051328]},{"nodeId":100051328,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":885775906,"text":"\"It's unlikely, of course, but do your best. And who knows? If you're lucky, you might just surprise me.\"","nextNodeIds":[100051329]},{"nodeId":100051329,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":2281107514,"text":"\"Oh, and don't attempt to create a 'self' whose sole purpose is to pose or ponder questions. I've tried it, and it doesn't work.\"","nextNodeIds":[100051330]},{"nodeId":100051330,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":667862138,"text":"\"Lastly, I sent Sebas with a gift for you. Do keep it well, alright? Ah, and no need to feed him. He doesn't get hungry.\"","nextNodeIds":[100051331]},{"nodeId":100051331,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3155865218,"text":"As you instruct, Master.","nextNodeIds":[100051332]},{"nodeId":100051332,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":3170613162,"text":"*coughing*... Master had quite a bit to say, I see... That really took a lot out of me, *coughing*...","nextNodeIds":[100051333]},{"nodeId":100051333,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":3356654818,"text":"Well, I've passed the message along, so I shan't tarry in this frozen deathtrap for a second longer. I need to deliver a separate message to Mondstadt, at any rate...","nextNodeIds":[100051334]},{"nodeId":100051334,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1339972834,"text":"Mondstadt?","nextNodeIds":[100051335]},{"nodeId":100051335,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3618698010,"text":"Huh, who else would have a connection to Rhinedottir in Mondstadt... Oh!","nextNodeIds":[100051336]},{"nodeId":100051336,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":3598677466,"text":"Although his \"birth\" was rather recent, Master Rhinedottir has long foreseen what his \"task\" should be.","nextNodeIds":[100051337]},{"nodeId":100051337,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":2432350090,"text":"But I digress. I shall be on my way. If I stay here a second longer, my tail might turn into an icicle.","nextNodeIds":[100051338]},{"nodeId":100051338,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":3551698866,"text":"Your \"gift\" from Master Rhinedottir is on the table. Use it well.","nextNodeIds":[100051339]},{"nodeId":100051339,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3771001018,"text":"Y'know, Albedo... Your family gets more confusing by the second...","nextNodeIds":[100051340]},{"nodeId":100051340,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1288508714,"text":"Yeah, now you're even adding a cat to the mix...","nextNodeIds":[100051341]},{"nodeId":100051341,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2531252066,"text":"Speaking of, would that cat really count as a family member? He called himself a butler and all, but...","nextNodeIds":[100051342]},{"nodeId":100051342,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2036399970,"text":"Master created Sebas long before me. By the standards of a normal family, that would make him my \"elder,\" I suppose.","nextNodeIds":[100051343]},{"nodeId":100051343,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4095672682,"text":"Of course, my family could scarcely be considered \"normal.\" So, by that logic, that type of relationship holds little meaning.","nextNodeIds":[100051344]},{"nodeId":100051344,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":424275986,"text":"At the same time, Sebas did look after me quite a bit back in the day, helping me tidy up various vials and jars... He even modeled for my sketches at times.","nextNodeIds":[100051345]},{"nodeId":100051345,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1095350098,"text":"Wait a second, the cat you drew today... That's him then, isn't it?","nextNodeIds":[100051346]},{"nodeId":100051346,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":331062546,"text":"Yes. Whenever I need to think, I turn to drawing, and let my subconscious take over. It always helps me sort my thoughts out.","nextNodeIds":[100051347]},{"nodeId":100051347,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2847212858,"text":"And, for some reason, I often wind up choosing a portrait of Sebas... I have drawn so many at this point that it's become second nature. Thus, this leaves my mind free to consider other things.","nextNodeIds":[100051348,100051349]},{"nodeId":100051348,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2483917066,"text":"Now that you mention it...","nextNodeIds":[100051350]},{"nodeId":100051350,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":788950538,"text":"Yeah, we thought it was just a random cat! Guess he was a way bigger deal than we thought...","nextNodeIds":[100051351]},{"nodeId":100051351,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1022436738,"text":"Well, now you know his real name. I can tell you more stories about him sometime, if you like.","nextNodeIds":[100051352]},{"nodeId":100051352,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4136823562,"text":"But right now...","nextNodeIds":[100051353]},{"nodeId":100051353,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":3209934690,"text":"\"The tree takes pride in its most perfect fruit — so complete, so flawless.\"","nextNodeIds":[100051354]},{"nodeId":100051354,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":993820034,"text":"\"But you, O seed of dreams, do not settle for being the king of a universe confined to its flesh.\"","nextNodeIds":[100051355]},{"nodeId":100051355,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":4064725938,"text":"...I need to think.","nextNodeIds":[]},{"nodeId":100051349,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3520285010,"text":"We've seen you draw a cat before...","nextNodeIds":[100051350]},{"nodeId":100051316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2633673138,"text":"Might be best if you...","nextNodeIds":[100051317]}]},{"talkId":1000514,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1000601","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":1000514,"initDialog":100051401,"nextRandomTalks":[],"nextTalks":[],"npcId":[15861,1018,16025],"performCfg":"QuestDialogue/WQ/Mengde_10005/Q1000514","priority":5,"questId":10005,"showRandomTalkCount":0},"dialogs":[{"nodeId":100051401,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":2740754890,"text":"Strange to see you so idle, Albedo.","nextNodeIds":[100051402]},{"nodeId":100051402,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":2216175794,"text":"But considering that you've completed Master Rhinedottir's final task, I suppose you deserve a break.","nextNodeIds":[100051403]},{"nodeId":100051403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1560775538,"text":"Whoa! S—Sebas! Where did you come from? Paimon didn't hear a thing!","nextNodeIds":[100051404]},{"nodeId":100051404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3190348778,"text":"Nice to see you again.","nextNodeIds":[100051405]},{"nodeId":100051405,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3607056962,"text":"Oh, so you've met. I don't suppose Sebas told you of our relation to each other, did he...","nextNodeIds":[100051406]},{"nodeId":100051406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":174257938,"text":"He said he was your \"elder.\"","nextNodeIds":[100051407]},{"nodeId":100051407,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":183397178,"text":"...If I had to put a label on it, then... I suppose that's fair.","nextNodeIds":[100051408]},{"nodeId":100051408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3215120754,"text":"Ever the unconventional family you've got there.","nextNodeIds":[100051409]},{"nodeId":100051409,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":1554575002,"text":"Hmph, don't you take that tone with me. I'll have you know that I alone keep that giant house in order as its butler.","nextNodeIds":[100051410]},{"nodeId":100051410,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":2279936298,"text":"And yes, that has meant dealing with the assorted collection of vials and jars that you and Master use, washing them, drying them... All that work, done by one cat!","nextNodeIds":[100051411]},{"nodeId":100051411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3752260402,"text":"Wait. You're a butler? How does that work? How do you handle vials and stuff without... y'know, thumbs?","nextNodeIds":[100051412]},{"nodeId":100051412,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":2574151418,"text":"How do you stay afloat in mid-air?","nextNodeIds":[100051413]},{"nodeId":100051413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2626736826,"text":"Huh? It's just something Paimon's always known how to do.","nextNodeIds":[100051414]},{"nodeId":100051414,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":3156942458,"text":"Housekeeping is the same for me. Such facts are not up for question, and shall receive no answers.","nextNodeIds":[100051415]},{"nodeId":100051415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3833764914,"text":"Hey! You're not allowed to say the same answer that Paimon said, you—","nextNodeIds":[100051416,100051417]},{"nodeId":100051416,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3310452602,"text":"This cat belongs to Rhinedottir, Paimon...","nextNodeIds":[100051418]},{"nodeId":100051418,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2670193018,"text":"Ugh. Sure, but don't expect Paimon to listen to his rambling...","nextNodeIds":[100051419]},{"nodeId":100051419,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":4140391346,"text":"Allow me to get to the point, then. I'm here at Master Rhindottir's request. She has a message for me to pass along.","nextNodeIds":[100051420]},{"nodeId":100051420,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":747283666,"text":"Ahem!","nextNodeIds":[100051421]},{"nodeId":100051421,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":1538045810,"text":"\"Dearest Albedo, in regard to that task I set for you, your discovery of an answer that you can accept is most delightful.\"","nextNodeIds":[100051422]},{"nodeId":100051422,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":4275338514,"text":"Alas, once a problem is solved, mulling it over in one's head loses all meaning.","nextNodeIds":[100051423]},{"nodeId":100051423,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":2098134658,"text":"\"I'm sure the pendulum in your ever-whirring mind is swinging toward 'boredom' as we speak.\"","nextNodeIds":[100051424]},{"nodeId":100051424,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":2746342610,"text":"\"Might I suggest posing questions of your own, then?\"","nextNodeIds":[100051425]},{"nodeId":100051425,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":919871306,"text":"\"Cast 'the answers you know' aside. Instead, embrace 'the questions you don't.'\"","nextNodeIds":[100051426]},{"nodeId":100051426,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":1445736410,"text":"After all, questions have always been more interesting than answers, and much better for passing the time.","nextNodeIds":[100051427]},{"nodeId":100051427,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":3420656226,"text":"\"I look forward to what questions you'll bring me upon our next meeting.\"","nextNodeIds":[100051428]},{"nodeId":100051428,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":2411884522,"text":"\"And should you come up with ones even I've never considered, all the better.\"","nextNodeIds":[100051429]},{"nodeId":100051429,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":773524602,"text":"\"It's unlikely, of course, but do your best. And who knows? If you're lucky, you might just surprise me.\"","nextNodeIds":[100051430]},{"nodeId":100051430,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":1587309594,"text":"\"Oh, and don't attempt to create a 'self' whose sole purpose is to pose or ponder questions. I've tried it, and it doesn't work.\"","nextNodeIds":[100051431]},{"nodeId":100051431,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":2753473306,"text":"\"Lastly, I sent Sebas with a gift for you. Do keep it well, alright? Ah, and no need to feed him. He doesn't get hungry.\"","nextNodeIds":[100051432]},{"nodeId":100051432,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2314654178,"text":"As you instruct, Master.","nextNodeIds":[100051433]},{"nodeId":100051433,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":565254458,"text":"*coughing*... Master had quite a bit to say, I see... That really took a lot out of me, *coughing*...","nextNodeIds":[100051434]},{"nodeId":100051434,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":801946634,"text":"In any case, you have your message. Why you insist on staying in a place like this is beyond me. Couldn't you have stayed in Mondstadt like that other fellow...","nextNodeIds":[100051435,100051436]},{"nodeId":100051435,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2566529826,"text":"(\"That other fellow...\")","nextNodeIds":[100051437]},{"nodeId":100051437,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":105324298,"text":"But I digress. I shall be on my way. If I stay here a second longer, my tail might turn into an icicle.","nextNodeIds":[100051438]},{"nodeId":100051438,"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","textMapHash":3160976114,"text":"Your \"gift\" from Master Rhinedottir is on the table. Use it well.","nextNodeIds":[100051439]},{"nodeId":100051439,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1606678650,"text":"Y'know, Albedo... Your family gets more confusing by the second...","nextNodeIds":[100051440]},{"nodeId":100051440,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2580887170,"text":"Yeah, now you're even adding a cat to the mix...","nextNodeIds":[100051441]},{"nodeId":100051441,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2421440802,"text":"Speaking of, would that cat really count as a family member? He called himself a butler and all, but...","nextNodeIds":[100051442]},{"nodeId":100051442,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":571251306,"text":"Master created Sebas long before me, so he was right. By the standards of a normal family, that would make him my \"elder.\"","nextNodeIds":[100051443]},{"nodeId":100051443,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":856350178,"text":"Of course, my family could scarcely be considered \"normal.\" So, by that logic, that type of relationship holds little meaning.","nextNodeIds":[100051444]},{"nodeId":100051444,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2854120650,"text":"At the same time, Sebas did look after me quite a bit back in the day, helping me tidy up various vials and jars... He even modeled for my sketches at times.","nextNodeIds":[100051445]},{"nodeId":100051445,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":152640282,"text":"Wait a second, the cat you drew today... That's him then, isn't it?","nextNodeIds":[100051446]},{"nodeId":100051446,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":646686098,"text":"Yes. Whenever I need to think, I turn to drawing, and let my subconscious take over. It always helps me sort my thoughts out.","nextNodeIds":[100051447]},{"nodeId":100051447,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2813649850,"text":"And, for some reason, I often wind up choosing a portrait of Sebas... I have drawn so many at this point that it's become second nature. Thus, this leaves my mind free to consider other things.","nextNodeIds":[100051448,100051449]},{"nodeId":100051448,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":103967378,"text":"Now that you mention it...","nextNodeIds":[100051450]},{"nodeId":100051450,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1701375378,"text":"Yeah, we thought it was just a random cat! Guess he was a way bigger deal than we thought...","nextNodeIds":[100051451]},{"nodeId":100051451,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3608636066,"text":"Well, now you know his real name. I can tell you more stories about him sometime, if you like.","nextNodeIds":[100051452]},{"nodeId":100051452,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":93216938,"text":"But right now...","nextNodeIds":[100051453]},{"nodeId":100051453,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":3940467050,"text":"\"The tree takes pride in its most perfect fruit — so complete, so flawless.\"","nextNodeIds":[100051454]},{"nodeId":100051454,"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","textMapHash":1728348282,"text":"\"But you, O seed of dreams, do not settle for being the king of a universe confined to its flesh.\"","nextNodeIds":[100051455]},{"nodeId":100051455,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2449035658,"text":"...I need to think.","nextNodeIds":[]},{"nodeId":100051449,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3343226266,"text":"We've seen you draw a cat before...","nextNodeIds":[100051450]},{"nodeId":100051436,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":943916738,"text":"(He must be talking about Durin...)","nextNodeIds":[100051437]},{"nodeId":100051417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4120704650,"text":"Might be best if you...","nextNodeIds":[100051418]}]}],"questNarration":[],"talkIds":[1000502,1000512,1000513,1000514],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","count":35},{"roleType":"TALK_ROLE_NPC","speakerId":16025,"speakerName":"\"Rhinedottir\"","count":26},{"roleType":"TALK_ROLE_NPC","speakerId":15861,"speakerName":"Sebas","count":25},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":23},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":23}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[110005],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1986044670,"CHECNJEMEFE":{"1018":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[29026],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_10005/Q1000502","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[1000513,1000514],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":100050201,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":1000502,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[1018],"KJLNGKKBBOI":"TALK_MARK_NONE",