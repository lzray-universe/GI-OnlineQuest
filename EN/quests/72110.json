C_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7211014","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7211003,"initDialog":721100301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20297],"performCfg":"","priority":6,"questId":72110,"showRandomTalkCount":0},"dialogs":[{"nodeId":721100301,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3335234738,"text":"Why did I leave the dojo to become Lord Kujou's instructor...","nextNodeIds":[721100302]},{"nodeId":721100302,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3055773090,"text":"Yanagiha and Okazaki, as well as Mifune... why did they all leave me...","nextNodeIds":[721100303]},{"nodeId":721100303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2037223154,"text":"I've encountered the disciples of the Iwakura Art.","nextNodeIds":[721100304]},{"nodeId":721100304,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":2802166610,"text":"Is that so...","nextNodeIds":[721100305]},{"nodeId":721100305,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3269615002,"text":"Are there still people who claim to be from Iwakura? Their Master was such an incompetent soul, after all.","nextNodeIds":[721100306]},{"nodeId":721100306,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":256086226,"text":"I am Iwakura Mitsunari. You could consider me a sword instructor here. And who might you be?","nextNodeIds":[721100307]},{"nodeId":721100307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2919669538,"text":"#I'm {NICKNAME}.","nextNodeIds":[721100308]},{"nodeId":721100308,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3049802258,"text":"Mifune, Tanba... did you see them? The Okazaki brothers, too?","nextNodeIds":[721100309]},{"nodeId":721100309,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":2417656930,"text":"Ah, yes, there's also Katayama. He always loved coming up with names for duels before they started.","nextNodeIds":[721100310]},{"nodeId":721100310,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":1611968058,"text":"He'd say, \"If I become a real master swordsman in the future, then all these duels can written into stories.\" Hahaha, such nonsense...","nextNodeIds":[721100311]},{"nodeId":721100311,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":2181759602,"text":"Right, and we mustn't forget Shimada, who spent the entire \"Eiin\" and \"Kouin\" eras training, yet could never advance beyond the rank of Shoden.","nextNodeIds":[721100312]},{"nodeId":721100312,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3153861978,"text":"They fled and became bandits because they could not fathom the power of the Almighty Shogun's Vision Hunt Decree.","nextNodeIds":[721100313]},{"nodeId":721100313,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":2849541330,"text":"I miss the good old days of teaching them how to wield a sword. Why in the world did I shut the dojo down and join the army?","nextNodeIds":[721100314]},{"nodeId":721100314,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":1433671010,"text":"#{NICKNAME}, how're their abilities?","nextNodeIds":[721100315,721100316]},{"nodeId":721100315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1319866034,"text":"I'm sorry to say this, but...","nextNodeIds":[721100317]},{"nodeId":721100317,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":1519283746,"text":"Really...","nextNodeIds":[721100318]},{"nodeId":721100318,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":1058136106,"text":"#Then, {NICKNAME}, who is your master? Is it Domon? Or Shousen? Or perhaps Narukami herself?","nextNodeIds":[721100319]},{"nodeId":721100319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":91069450,"text":"I think I might be considered \"self-taught.\"","nextNodeIds":[721100320]},{"nodeId":721100320,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3692698482,"text":"I see.","nextNodeIds":[721100321]},{"nodeId":721100321,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3236329386,"text":"It seems like the Iwakura Art has waned under my watch. None of my students were able to defeat a self-learned swordsman.","nextNodeIds":[721100322]},{"nodeId":721100322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1577915314,"text":"...","nextNodeIds":[721100323]},{"nodeId":721100323,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":2270938492,"text":"Is that so? I understand.","nextNodeIds":[721100324]},{"nodeId":721100324,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":1049027898,"text":"Whatever your school of swordsmanship is, it doesn't matter.","nextNodeIds":[721100325]},{"nodeId":721100325,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3050169498,"text":"It seems like the Iwakura Art has waned under my watch. None of my students were able to defeat someone who is unwilling to reveal the name of their school.","nextNodeIds":[721100326]},{"nodeId":721100326,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":955350298,"text":"I truly am an incompetent Master of the Iwakura Art. As a swordsman, they call me Iwakura Kouin.","nextNodeIds":[721100327]},{"nodeId":721100327,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3275662826,"text":"Although I have forgotten the key to our secret blade technique and my Vision was surrendered to the Almighty Shogun...","nextNodeIds":[721100328]},{"nodeId":721100328,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":3646517754,"text":"...If you asked me if I still wish to avenge those disciples of mine who could not bear to see my degradation and wound up pursuing the path of wicked ghosts...","nextNodeIds":[721100329]},{"nodeId":721100329,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":506656498,"text":"...Yet who were incompetent and lost to you, then I do still have some of that fire within me.","nextNodeIds":[721100330]},{"nodeId":721100330,"roleType":"TALK_ROLE_NPC","speakerId":20297,"speakerName":"Iwakura Mitsunari","textMapHash":1717104858,"text":"This space is too small. It would be no place for even you to show off your swordsmanship. Come, follow me down.","nextNodeIds":[]},{"nodeId":721100316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2085853474,"text":"I learned quite a bit.","nextNodeIds":[721100317]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7211003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7211007,"order":9,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"fin_7211007"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7211002],"talks":[{"talkId":7211002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7211007","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7211015","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7211002,"initDialog":721100201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20298,20299],"performCfg":"QuestDialogue/WQ/Inazuma_72110/Q7211002","priority":5,"questId":72110,"showRandomTalkCount":0},"dialogs":[{"nodeId":721100201,"roleType":"TALK_ROLE_NPC","speakerId":20298,"speakerName":"Okazaki Toraemon","textMapHash":3003635186,"text":"...now, the blade of Iwakura Kouin is the only thing we're missing.","nextNodeIds":[721100202]},{"nodeId":721100202,"roleType":"TALK_ROLE_NPC","speakerId":20299,"speakerName":"Yanagiha Arashi","textMapHash":3220094762,"text":"The ancestral \"Hakuen Michimitsu Amenoma\" of the Iwakura Clan, huh... Say, do you remember, when you and Kunihiko were first adopted, while Master Eiin wasn't looking...","nextNodeIds":[721100203]},{"nodeId":721100203,"roleType":"TALK_ROLE_NPC","speakerId":20298,"speakerName":"Okazaki Toraemon","textMapHash":1497907274,"text":"We have already been expelled. There's no need to call him \"Master.\"","nextNodeIds":[721100204]},{"nodeId":721100204,"roleType":"TALK_ROLE_NPC","speakerId":20299,"speakerName":"Yanagiha Arashi","textMapHash":3115103034,"text":"But Okazaki...","nextNodeIds":[721100205]},{"nodeId":721100205,"roleType":"TALK_ROLE_NPC","speakerId":20299,"speakerName":"Yanagiha Arashi","textMapHash":3649744602,"text":"\"When you weigh affection against righteousness on a scale, a real swordsman must walk the path of righteousness.\"","nextNodeIds":[721100206]},{"nodeId":721100206,"roleType":"TALK_ROLE_NPC","speakerId":20299,"speakerName":"Yanagiha Arashi","textMapHash":520869474,"text":"Since Master said so, it means he was not willing to expel us, but had no other choice.","nextNodeIds":[721100207]},{"nodeId":721100207,"roleType":"TALK_ROLE_NPC","speakerId":20298,"speakerName":"Okazaki Toraemon","textMapHash":2829565194,"text":"Of course he was unwilling. But since he has already decided to become the sword of the Shogun and carry out the Vision Hunt Decree, then we can only...","nextNodeIds":[721100208]},{"nodeId":721100208,"roleType":"TALK_ROLE_NPC","speakerId":20299,"speakerName":"Yanagiha Arashi","textMapHash":3055661626,"text":"We can only choose our own righteous path. After all, \"a real swordsman must walk the path of righteousness.\"","nextNodeIds":[721100209]},{"nodeId":721100209,"roleType":"TALK_ROLE_NPC","speakerId":20299,"speakerName":"Yanagiha Arashi","textMapHash":730536130,"text":"And yet, Master's own righteousness was defeated in the end.","nextNodeIds":[721100210]},{"nodeId":721100210,"roleType":"TALK_ROLE_NPC","speakerId":20298,"speakerName":"Okazaki Toraemon","textMapHash":1276990370,"text":"That's right. We must avenge them all. Kunihiko, the others — even Iwakura Kouin.","nextNodeIds":[721100211]},{"nodeId":721100211,"roleType":"TALK_ROLE_NPC","speakerId":20298,"speakerName":"Okazaki Toraemon","textMapHash":1623203378,"text":"Such is the righteousness of expelled disciples like ourselves.","nextNodeIds":[721100212]},{"nodeId":721100212,"roleType":"TALK_ROLE_NPC","speakerId":20299,"speakerName":"Yanagiha Arashi","textMapHash":2089604170,"text":"This must also be Master's blessing. Our first object of vengeance came to us, just like that.","nextNodeIds":[721100213]},{"nodeId":721100213,"roleType":"TALK_ROLE_NPC","speakerId":20298,"speakerName":"Okazaki Toraemon","textMapHash":2356570858,"text":"#You are right. You must be {NICKNAME}. I've heard about your story.","nextNodeIds":[721100214]},{"nodeId":721100214,"roleType":"TALK_ROLE_NPC","speakerId":20298,"speakerName":"Okazaki Toraemon","textMapHash":3504610322,"text":"In the world of swordsmen, only blood can cleanse blood. I assume you are prepared to face the Ex-Iwakura Art Menkyo Kaiden?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"fin_7211007"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133220016"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7211015,"order":10,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7211002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLET