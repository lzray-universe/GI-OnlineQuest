","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7050601,"initDialog":705060101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1007,1006],"performCfg":"QuestDialogue/WQ/Mengde_70506/Q7050601","priority":5,"questId":70506,"showRandomTalkCount":0},"dialogs":[{"nodeId":705060101,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2135563738,"text":"Hi there, cutie. It's good to see you.","nextNodeIds":[705060102]},{"nodeId":705060102,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3414802354,"text":"It is certainly unusual for us to meet in a place like this, but as Lisa said, I'm glad to see you.","nextNodeIds":[705060103]},{"nodeId":705060103,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2023681866,"text":"Hey, what do you mean by \"a place like this\"? The tavern is a wonderful place to relax and unwind a little.","nextNodeIds":[705060104]},{"nodeId":705060104,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3273120978,"text":"*sigh* Do you have any idea how hard it was for me to drag the Acting Grand Master away from her desk?","nextNodeIds":[705060105]},{"nodeId":705060105,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3249596106,"text":"We've only been here for a few minutes and worry is already written all over her face.","nextNodeIds":[705060106]},{"nodeId":705060106,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3981943594,"text":"*sigh* Lisa...","nextNodeIds":[705060107]},{"nodeId":705060107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1194949466,"text":"Well, the Knights of Favonius do have a lot to handle...","nextNodeIds":[705060108]},{"nodeId":705060108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2123133906,"text":"Yeah, this is the Acting Grand Master we're talking about. It's only natural that she has a lot on her plate!","nextNodeIds":[705060109]},{"nodeId":705060109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2581684722,"text":"But you know what they say... \"Now that we're already here...\"","nextNodeIds":[705060110]},{"nodeId":705060110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1740358730,"text":"#Why don't you let {F#her}{M#him} mix a couple of drinks for you two. It'll make you feel a lot better!","nextNodeIds":[705060111]},{"nodeId":705060111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2643145522,"text":"Think of it as a way to unwind.","nextNodeIds":[705060112]},{"nodeId":705060112,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3888059042,"text":"Honestly, Jean is the only person I know who needs to be taught how to relax.","nextNodeIds":[705060113]},{"nodeId":705060113,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2768749618,"text":"Hey cutie, whip me up a Love Poem. Medium, extra sweet.","nextNodeIds":[705060114]},{"nodeId":705060114,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":205594858,"text":"And how about you, Jean? What are you in the mood for?","nextNodeIds":[705060115]},{"nodeId":705060115,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2102291026,"text":"I'll just have... coffee. Medium, please.","nextNodeIds":[705060116]},{"nodeId":705060116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1046806250,"text":"Master Jean, you drink coffee all the time. Wouldn't you like to try something else?","nextNodeIds":[705060117]},{"nodeId":705060117,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":699276618,"text":"Thanks, but no. I want something to help keep me awake.","nextNodeIds":[705060118]},{"nodeId":705060118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4075479266,"text":"Got it. Coming right up!","nextNodeIds":[705060119]},{"nodeId":705060119,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3094762194,"text":"Thanks.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050603,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050603,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,40],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1006"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7050604,"order":6,"stepDescription":"Give the drinks to Lisa and Jean","stepDescTextMapHash":683514804,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1006"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7050602],"talks":[{"talkId":7050602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7050604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7050602,"initDialog":705060201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1007,1006],"performCfg":"QuestDialogue/WQ/Mengde_70506/Q7050602","priority":5,"questId":70506,"showRandomTalkCount":0},"dialogs":[{"nodeId":705060201,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1230351602,"text":"Mmm... The sweetness is just right. Very good.","nextNodeIds":[705060202]},{"nodeId":705060202,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1941416370,"text":"The coffee is strong and rich with just a nice hint of bitterness to it.","nextNodeIds":[705060203]},{"nodeId":705060203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2438890418,"text":"I'm glad you both like the drinks.","nextNodeIds":[705060204]},{"nodeId":705060204,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2529092050,"text":"Actually, I do understand what you meant, Lisa.","nextNodeIds":[705060205]},{"nodeId":705060205,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2323998490,"text":"Hmm?","nextNodeIds":[705060206]},{"nodeId":705060206,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2340852258,"text":"I've been reflecting on my weaknesses lately. There's still room for me to improve in many areas, such as my productivity and management...","nextNodeIds":[705060207]},{"nodeId":705060207,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1112081914,"text":"I'm concerned my stress may even be starting to somehow affect you as well...","nextNodeIds":[705060208]},{"nodeId":705060208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":973648034,"text":"I think you still don't quite understand.","nextNodeIds":[705060209]},{"nodeId":705060209,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4249676906,"text":"What?","nextNodeIds":[705060210]},{"nodeId":705060210,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":698459042,"text":"Hehe. See? Cutie knows.","nextNodeIds":[705060211]},{"nodeId":705060211,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":618623570,"text":"You were working yourself way too hard, so I thought I'd take you out for some drinks. All I wanted was for you to have some fun.","nextNodeIds":[705060212]},{"nodeId":705060212,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1909531434,"text":"But even in the tavern, you're still thinking about work. That's what's most concerning.","nextNodeIds":[705060213]},{"nodeId":705060213,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3366307042,"text":"If you're constantly under stress like this, it's only a matter of time before you burn out.","nextNodeIds":[705060214]},{"nodeId":705060214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1303599658,"text":"Exactly.","nextNodeIds":[705060215]},{"nodeId":705060215,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1188572650,"text":"#Oh... You also agree with Lisa, {NICKNAME}?","nextNodeIds":[705060216]},{"nodeId":705060216,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2340448050,"text":"Hmm, so... is learning to relax actually my biggest challenge?","nextNodeIds":[705060217]},{"nodeId":705060217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2646781562,"text":"To quote a saying from Liyue: \"Everything has a balance.\"","nextNodeIds":[705060218]},{"nodeId":705060218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1636324826,"text":"Yep! Work hard, play hard, and rest even harder. The two of you may need even more rest than you'd expect!","nextNodeIds":[705060219]},{"nodeId":705060219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1967450946,"text":"That's an... interesting way to put it.","nextNodeIds":[705060220]},{"nodeId":705060220,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":324439514,"text":"Hehe.","nextNodeIds":[705060221]},{"nodeId":705060221,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1259846162,"text":"Alright, I... I understand.","nextNodeIds":[705060222]},{"nodeId":705060222,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3932423578,"text":"Thank you, all of you. Now I know that this place serves refreshments for both the body and the mind. Is that why you and Kaeya like the tavern so much?","nextNodeIds":[705060223]},{"nodeId":705060223,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3366284546,"text":"Yes, and no. It really depends on who's making the drinks.","nextNodeIds":[705060224]},{"nodeId":705060224,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":90543346,"text":"Speaking of which, we couldn't have changed Jean's mind without you today. You sure have a way with words, Cutie.","nextNodeIds":[705060225,705060226]},{"nodeId":705060225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":404785130,"text":"Don't mention it.","nextNodeIds":[705060227]},{"nodeId":705060227,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2382236858,"text":"Hehe, then we'll see you later.","nextNodeIds":[705060228]},{"nodeId":705060228,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1635007538,"text":"I'll consider coming here to relax if I have another opportunity.","nextNodeIds":[705060229]},{"nodeId":705060229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":262625210,"text":"Sounds great. Take care, you two!","nextNodeIds":[]},{"nodeId":705060226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3046900042,"text":"I'm glad I could help.","nextNodeIds":[705060227]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,50],"PAINLIBBLD