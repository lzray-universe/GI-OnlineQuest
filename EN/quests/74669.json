leCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7466902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7466901,"initDialog":746690101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30418],"performCfg":"QuestDialogue/WQ/Fontaine_74669/Q7466901","priority":0,"questId":74669,"showRandomTalkCount":0},"dialogs":[{"nodeId":746690101,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":1617875050,"text":"Have faith in yourself, Bresson... Have faith. All the tools have been prepared...","nextNodeIds":[746690102]},{"nodeId":746690102,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":2918561018,"text":"You just need to... go underwater. Yes, underwater... Go there and prove that these tools are reliable, and your work will be complete!","nextNodeIds":[746690103]},{"nodeId":746690103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2383754138,"text":"What are you doing?","nextNodeIds":[746690104]},{"nodeId":746690104,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":2331469826,"text":"Eh? Where did you come from? I didn't hear you coming at all!","nextNodeIds":[746690105]},{"nodeId":746690105,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":3137919778,"text":"I almost fell into the water, you know — if I hadn't regained my balance, the future of photography in Fontaine would have gone down the... water!","nextNodeIds":[746690106,746690107]},{"nodeId":746690106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2751574042,"text":"Sorry about that.","nextNodeIds":[746690108]},{"nodeId":746690108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4129523162,"text":"Wait, don't you know how to swim?","nextNodeIds":[746690109]},{"nodeId":746690109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1984192186,"text":"And you're from Fontaine, aren't you?","nextNodeIds":[746690110]},{"nodeId":746690110,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":1277266266,"text":"Who... Who said that people from Fontaine must know how to swim? Not every person from Liyue can cook, and not every Mondstadter's a poet!","nextNodeIds":[746690111]},{"nodeId":746690111,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":4038314474,"text":"Whatever. I went through all this effort to get diving apparatus. Today, I must go underwater to take some pictures...","nextNodeIds":[746690112]},{"nodeId":746690112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2284134058,"text":"Oh, so that's what going on...","nextNodeIds":[746690113]},{"nodeId":746690113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1624978602,"text":"Is there something special about this Kamera?","nextNodeIds":[746690114]},{"nodeId":746690114,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":2898232850,"text":"Special? I, Bresson Cartier, modified the Kamera personally. This is why it's \"special.\"","nextNodeIds":[746690115]},{"nodeId":746690115,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":3586219250,"text":"My modification techniques are strict and ingenious, and I only use the very finest materials.","nextNodeIds":[746690131]},{"nodeId":746690131,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":3026576474,"text":"The lens is countless times better than those you'll find on any other Kameras. Indeed, there will be no loss in image quality even if you go underwater!","nextNodeIds":[746690116]},{"nodeId":746690116,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":4034236522,"text":"But those people in the Kamera Club... They don't care about my new techniques at all. They claim that the key to photography lies in the skill of the photographers themselves, and not their tools...","nextNodeIds":[746690117]},{"nodeId":746690117,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":3943812146,"text":"But just you wait, I say. I will take some brilliant pictures, and shut those ignoramuses right up!","nextNodeIds":[746690118]},{"nodeId":746690118,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":1547037250,"text":"Phew... Come on, Bresson. Believe in yourself... Believe... the water is warm and comfy, and it's definitely not full of man-eating fish...","nextNodeIds":[746690119]},{"nodeId":746690119,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":2362424010,"text":"I... I... Ugh, will this divesuit really work? Will it suddenly explode underwater!?","nextNodeIds":[746690120]},{"nodeId":746690120,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":179134154,"text":"After which I shall be dragged into the watery depths, never to be seen again... I... Oh, Archons...","nextNodeIds":[746690121,746690122]},{"nodeId":746690121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2586876538,"text":"If you really can't do it, I can help you...","nextNodeIds":[746690123]},{"nodeId":746690123,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":2962225930,"text":"Really? Would you do this? Would you aid me? A most generous soul, you are! Indeed, my savior!","nextNodeIds":[746690124,746690125]},{"nodeId":746690124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1043190498,"text":"Well, I expect to be paid, regardless.","nextNodeIds":[746690126]},{"nodeId":746690126,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":2401946,"text":"Well, of course I won't be making you do this for free. Your recompense will be rich, trust me!","nextNodeIds":[746690127]},{"nodeId":746690127,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":1763077850,"text":"Ah yes, right. Allow me to mark some good underwater scenery on your map...","nextNodeIds":[746690128]},{"nodeId":746690128,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":2459423938,"text":"There are also some on land... Uh... That should be around here... This is brand-new equipment, after all. It wouldn't hurt to test them out at a few more spots.","nextNodeIds":[746690129]},{"nodeId":746690129,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":3174096858,"text":"Alright, this will do. I leave Fontaine's technical photographic future and my vision for Kamera tools in your capable hands.","nextNodeIds":[746690130]},{"nodeId":746690130,"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","textMapHash":3344530970,"text":"I shall... uh, wait for you on the shore.","nextNodeIds":[]},{"nodeId":746690125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4272065866,"text":"I'll need remuneration according to Guild rules.","nextNodeIds":[746690126]},{"nodeId":746690122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4163134338,"text":"Why don't I take some photos underwater for you?","nextNodeIds":[746690123]},{"nodeId":746690107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4289479610,"text":"I didn't expect you to react that intensely...","nextNodeIds":[746690108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7466901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30418"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7466901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30418,"speakerName":"Bresson","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCM