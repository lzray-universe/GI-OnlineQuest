{"mainQuestId":71671,"title":"A Defensive Strategy","description":"Having successfully ventured into the Ley Line disturbance's hidden Domain and emerged victorious from its trials, it's time to report back to Keqing and Yelan...","titleTextMapHash":700845391,"descTextMapHash":2363301582,"mainQuestExcel":{"mainQuestId":71671,"titleTextMapHash":700845391,"title":"A Defensive Strategy","descTextMapHash":2363301582,"description":"Having successfully ventured into the Ley Line disturbance's hidden Domain and emerged victorious from its trials, it's time to report back to Keqing and Yelan...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ71671","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":2363301582,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71671,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2852760129,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71671","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171671],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":700845391,"type":"WQ","unlockDescTextMapHash":3209621422}},"flow":[{"subQuestId":7167101,"order":1,"stepDescription":"Talk to Keqing and Yelan","stepDescTextMapHash":3021713412,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_310500128:980.867,260.701,-194.405]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7167101],"talks":[{"talkId":7167101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7167101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7167101,"initDialog":716710101,"nextRandomTalks":[],"nextTalks":[],"npcId":[15517],"performCfg":"QuestDialogue/WQ/LeyLineChallenge_71671/Q7167101","priority":5,"questId":71671,"showRandomTalkCount":0},"dialogs":[{"nodeId":716710101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1304155906,"text":"Whew, this domain is messed up — no wonder even Yelan found it dicey...","nextNodeIds":[716710102]},{"nodeId":716710102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3340805250,"text":"Which major historical battle do you think is being re-enacted here? Feels like one where most soldiers would be way out of their depth...","nextNodeIds":[716710103,716710104]},{"nodeId":716710103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3691442162,"text":"Maybe it's the Archon War?","nextNodeIds":[716710105]},{"nodeId":716710105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1304175962,"text":"Yikes, hopefully not! ...Surely not, right? Please tell Paimon you're exaggerating!","nextNodeIds":[716710106]},{"nodeId":716710106,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2112490242,"text":"Ah, you're back.","nextNodeIds":[716710107]},{"nodeId":716710107,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2400909834,"text":"And... by the look on your face, I'm guessing this is a triumphant return after all?","nextNodeIds":[716710108]},{"nodeId":716710108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4241940146,"text":"Sure is! But it was really, really scary in there!","nextNodeIds":[716710109]},{"nodeId":716710109,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":1181505362,"text":"You describe the battles you fought to Keqing and Yelan...","nextNodeIds":[716710110]},{"nodeId":716710110,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3307138682,"text":"Incredible... You did very well to brave all of that and still emerge victorious. Good work!","nextNodeIds":[716710111]},{"nodeId":716710111,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2059702674,"text":"After you entered the domain, there was a sharp drop in stray monsters out here.","nextNodeIds":[716710112]},{"nodeId":716710112,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":1386296554,"text":"And although you didn't eliminate the root of the problem, it's plain to see you've weakened the Ley Line disturbance considerably.","nextNodeIds":[716710113]},{"nodeId":716710113,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3252541474,"text":"Which means you've weakened the monsters as well. Now, any rank-and-file soldiers can comfortably fend them off.","nextNodeIds":[716710115,716710116]},{"nodeId":716710115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2751858066,"text":"Or... they could enter the domain and get a taste of real danger.","nextNodeIds":[716710117]},{"nodeId":716710117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":687565410,"text":"#Why do you sound weirdly excited about this, {NICKNAME}? Don't go getting too bloodthirsty!","nextNodeIds":[716710118]},{"nodeId":716710118,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1147609794,"text":"#Oh, one other thing. We received a response from Yujing Terrace. Both the Tianquan and the Kaiyang have agreed to establish a long-term partnership with {NICKNAME}.","nextNodeIds":[716710119]},{"nodeId":716710119,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3778131402,"text":"Thanks to your tireless efforts, we may even be able to turn this Ley Line disturbance to our advantage.","nextNodeIds":[716710120]},{"nodeId":716710120,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2185478578,"text":"Moving forward, you'll have the full support of this garrison.","nextNodeIds":[716710121]},{"nodeId":716710121,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1393563218,"text":"While the disturbance remains active, the Millelith will take care of any monsters that escape from the domain, using the opportunity to hone their combat skills. You, of course, are free to enter the domain if you so wish.","nextNodeIds":[716710122]},{"nodeId":716710122,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2450168530,"text":"We've turned the tables on this situation. What started as a potential crisis is now a major asset to Millelith recruits.","nextNodeIds":[716710123,716710124]},{"nodeId":716710123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4153943938,"text":"Great news. I'll keep giving it my all!","nextNodeIds":[716710125]},{"nodeId":716710125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":449782866,"text":"Ahh... That's a big weight off our shoulders...","nextNodeIds":[716710126]},{"nodeId":716710126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2674857826,"text":"Anyway, where were we?","nextNodeIds":[716710127]},{"nodeId":716710127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2460559770,"text":"Oh yeah — Ley Lines are pretty fascinating things, aren't they? If only there was a way to grab them and shake all the secrets out...","nextNodeIds":[716710128]},{"nodeId":716710128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3976490314,"text":"Or who knows, maybe one day we'll run into some smart cookie who hands us a big, thick book called \"Everything You Always Wanted to Know About Ley Lines\"!","nextNodeIds":[]},{"nodeId":716710124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":270193410,"text":"With the immediate danger gone, I'll support as needed!","nextNodeIds":[716710125]},{"nodeId":716710116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":793522634,"text":"The Ley Line disturbance is a stubborn foe. It will take time to conquer it.","nextNodeIds":[716710117]},{"nodeId":716710104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1547247802,"text":"The Khaenri'ahn cataclysm, perhaps?","nextNodeIds":[716710105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_310500128:980.867,260.701,-194.405]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7167101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","count":4},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171671],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":23