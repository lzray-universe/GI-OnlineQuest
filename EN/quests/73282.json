ialog":732822801,"nextRandomTalks":[],"nextTalks":[],"npcId":[20842],"performCfg":"","priority":1,"questId":73282,"showRandomTalkCount":0},"dialogs":[{"nodeId":732822801,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":3166844698,"text":"(Tadhla avoids eye contact and lowers her head nervously.)","nextNodeIds":[732822802,732822805]},{"nodeId":732822802,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":506278930,"text":"Are you alright?","nextNodeIds":[732822803]},{"nodeId":732822803,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":1579437218,"text":"Sorry, the hunt is over. I am Father's \"Falcon.\"","nextNodeIds":[732822804]},{"nodeId":732822804,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":2940788354,"text":"But I'm feeling great. Don't worry about me.","nextNodeIds":[732822808,732822810]},{"nodeId":732822808,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":245231178,"text":"That's pretty extreme...","nextNodeIds":[732822809]},{"nodeId":732822809,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":2748206962,"text":"Extreme, huh? I'm not sure about that. I've always lived like this ever since I was a child.","nextNodeIds":[732822814]},{"nodeId":732822814,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":3271183050,"text":"Well... But, the stories of you and Paimon, and the adventures that you two experienced...","nextNodeIds":[732822815]},{"nodeId":732822815,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":3644669578,"text":"Should there be a chance, I would really want to hear more of them.","nextNodeIds":[732822816]},{"nodeId":732822816,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3387094202,"text":"No problem! We have tons of stories to tell!","nextNodeIds":[732822817,732822818]},{"nodeId":732822817,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2776755306,"text":"Yes, I'll tell you all of them.","nextNodeIds":[732822819]},{"nodeId":732822819,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":3327931058,"text":"Pfft...","nextNodeIds":[732822820]},{"nodeId":732822820,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":553900282,"text":"#Ahem, sorry. I'm just very happy. Thank you, the Master of the Jinni. Um, I mean, thank you, {NICKNAME}.","nextNodeIds":[]},{"nodeId":732822818,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1483806770,"text":"We can talk about them any time you want.","nextNodeIds":[732822819]},{"nodeId":732822810,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1467353530,"text":"Haven't you ever thought about living for yourself?","nextNodeIds":[732822811]},{"nodeId":732822811,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":2709284866,"text":"...","nextNodeIds":[732822812]},{"nodeId":732822812,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":3981161682,"text":"No. Never. I never had such thoughts, or expectations.","nextNodeIds":[732822813]},{"nodeId":732822813,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":4186885570,"text":"The desert is a place of indifference and brutality, where I have no time to think for my own good. Without me, my tribe lives on just the same. However, without my tribe, there is no way I will survive.","nextNodeIds":[732822814]},{"nodeId":732822805,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3179083778,"text":"About your relationship with Masseira...","nextNodeIds":[732822806]},{"nodeId":732822806,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":3389078186,"text":"As I said, he is my father, and I am his Falcon. I follow his orders. I hunt for him, risk my life for him, as he is the will of the Tanit.","nextNodeIds":[732822807]},{"nodeId":732822807,"roleType":"TALK_ROLE_NPC","speakerId":20842,"speakerName":"Tadhla","textMapHash":394983034,"text":"When the day comes that I cannot fully execute Father's orders, then my life as a Falcon will end.","nextNodeIds":[732822808,732822810]}]},{"talkId":7328229,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7328207","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"