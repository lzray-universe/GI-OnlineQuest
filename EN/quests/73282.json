"text":"Eh? Why so formal?","nextNodeIds":[732820107]},{"nodeId":732820107,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"Masseira","textMapHash":3194608170,"text":"The ruins in the north, around where you first met each other.","nextNodeIds":[732820108,732820110]},{"nodeId":732820108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1900006482,"text":"What did you say?","nextNodeIds":[732820109]},{"nodeId":732820109,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"Masseira","textMapHash":378451498,"text":"The ruins in the north, around where you first met each other. Don't forget.","nextNodeIds":[]},{"nodeId":732820110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":788345042,"text":"I understand.","nextNodeIds":[732820111]},{"nodeId":732820111,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"Masseira","textMapHash":4050085762,"text":"Yes. Please, treat her well.","nextNodeIds":[]},{"nodeId":732820104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3096757410,"text":"I have other things to do...","nextNodeIds":[732820105]},{"nodeId":732820105,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"Masseira","textMapHash":2601503882,"text":"Please, hear me out. Tadhla wants to talk to you.","nextNodeIds":[732820106]}]},{"talkId":7328202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUE