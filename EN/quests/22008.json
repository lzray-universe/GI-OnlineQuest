{"mainQuestId":22008,"title":"Good Medicine Tastes Bitter","description":"Chenxiang's daughter Hongdou refuses to take her medicine. Perhaps a spoonful of Almond Tofu could help the medicine go down...","titleTextMapHash":427720129,"descTextMapHash":2592336791,"mainQuestExcel":{"mainQuestId":22008,"titleTextMapHash":427720129,"title":"Good Medicine Tastes Bitter","descTextMapHash":2592336791,"description":"Chenxiang's daughter Hongdou refuses to take her medicine. Perhaps a spoonful of Almond Tofu could help the medicine go down...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ22008","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":2592336791,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":22008,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2155171351,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ22008","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":27000,"titleTextMapHash":427720129,"type":"IQ","unlockDescTextMapHash":1713275075}},"flow":[{"subQuestId":2200801,"order":1,"stepDescription":"Talk to Chenxiang","stepDescTextMapHash":1564743410,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2027"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2200801],"talks":[{"talkId":2200801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200801","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200801,"initDialog":220080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2027],"performCfg":"","priority":5,"questId":22008,"showRandomTalkCount":0},"dialogs":[{"nodeId":220080101,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":1296450469,"text":"Doudou, be a good girl, you'll only get better if you take your medicine...","nextNodeIds":[220080102]},{"nodeId":220080102,"roleType":"TALK_ROLE_NPC","speakerId":2028,"speakerName":"Hongdou","textMapHash":4127757725,"text":"No! I don't want to! I hate it, it tastes gross...","nextNodeIds":[220080103]},{"nodeId":220080103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1395119957,"text":"What's wrong?","nextNodeIds":[220080104]},{"nodeId":220080104,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":4032771589,"text":"Oh, hello Traveler. Doudou is quite a sickly child. This is the medicine she needs to take, according to the prescription Dr. Baizhu gave me.","nextNodeIds":[220080105]},{"nodeId":220080105,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":1813499517,"text":"But she refuses to take it. She complains she doesn't like the taste... *sigh* Unfortunately, herbal medicine is bitter, that's just how it is...","nextNodeIds":[220080106]},{"nodeId":220080106,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":1819023989,"text":"The only time she ever agrees to take it is if she gets to have a bowl of Almond Tofu afterwards.","nextNodeIds":[220080107]},{"nodeId":220080107,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":85002909,"text":"Traveler, if you have the time, could you go and pick me up a portion of Almond Tofu? I should stay here — I may still need to talk her into it...","nextNodeIds":[220080108,220080110,220080115]},{"nodeId":220080108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":626801253,"text":"Okay.","nextNodeIds":[220080109]},{"nodeId":220080109,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":67580821,"text":"Thank you. Just one portion for Doudou is enough.","nextNodeIds":[]},{"nodeId":220080110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2061797637,"text":"What illness does she have?","nextNodeIds":[220080111]},{"nodeId":220080111,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":3015213341,"text":"*sigh* I wish I knew. Whatever it is, Dr. Baizhu says it's nearly impossible to cure, and that just keeping the symptoms at bay takes a lot of medication.","nextNodeIds":[220080112]},{"nodeId":220080112,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":3503664165,"text":"I fear she might need to take medicine her whole life. And starting at such a young age... It doesn't bear thinking about.","nextNodeIds":[220080113]},{"nodeId":220080113,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":2659690549,"text":"I just wish I were the one with the illness... But the best I can hope for is that things don't get any worse for the poor child.","nextNodeIds":[220080114]},{"nodeId":220080114,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":1792883069,"text":"Anyway. Please go and fetch me a portion of Almond Tofu, just the one will do.","nextNodeIds":[]},{"nodeId":220080115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":740445733,"text":"Hey kiddo. Not liking the medicine, huh?","nextNodeIds":[220080116]},{"nodeId":220080116,"roleType":"TALK_ROLE_NPC","speakerId":2028,"speakerName":"Hongdou","textMapHash":2802601325,"text":"It's sooooo bitter!!! Lulu's medicine is way less bitter than mine!","nextNodeIds":[220080117]},{"nodeId":220080117,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":3187858965,"text":"Doudou... Lulu and her friends were just pretending. That wasn't real medicine they were drinking, it was some leftover sugary water from a bowl of Almond Tofu.","nextNodeIds":[220080118]},{"nodeId":220080118,"roleType":"TALK_ROLE_NPC","speakerId":2028,"speakerName":"Hongdou","textMapHash":3718480381,"text":"Oh... So Almond Tofu won't make me get better? Then... I guess I do have to take that icky medicine...","nextNodeIds":[220080119]},{"nodeId":220080119,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":2579272493,"text":"That's right! Good girl. As soon as you're better you can eat whatever you like!","nextNodeIds":[220080120]},{"nodeId":220080120,"roleType":"TALK_ROLE_NPC","speakerId":2028,"speakerName":"Hongdou","textMapHash":2393087341,"text":"Why can't they make medicine taste sweet like Almond Tofu? So unfair...","nextNodeIds":[220080121]},{"nodeId":220080121,"roleType":"TALK_ROLE_NPC","speakerId":2027,"speakerName":"Chenxiang","textMapHash":4204216685,"text":"*sigh* There's no getting through to her... Anyway. Please go and fetch me a portion of Almond Tofu, just the one will do.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2027"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2200802,"order":2,"stepDescription":"Give the Almond Tofu to Chenxiang","stepDescTextMapHash":2566671338,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200802,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2027"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2200802,2200803],"talks":[{"talkId":2200802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_E