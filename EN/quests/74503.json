"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30411"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7450301],"talks":[{"talkId":7450301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7450301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450301,"initDialog":745030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30411],"performCfg":"QuestDialogue/WQ/Fontaine_74503/Q7450301","priority":5,"questId":74503,"showRandomTalkCount":0},"dialogs":[{"nodeId":745030101,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":2895358042,"text":"Welcome, dear guests, we meet again. It has not been long, and yet I miss you a little already.","nextNodeIds":[745030102]},{"nodeId":745030102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1944903506,"text":"Hmph, you sweet talker.","nextNodeIds":[745030103]},{"nodeId":745030103,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":4046565170,"text":"Ah, woe is me, loathed am I! How the pain stings. Perhaps I'd best get back to work.","nextNodeIds":[745030104]},{"nodeId":745030104,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":3857590306,"text":"Let me state first that the planned data collection project will be divided into two parts. One will be run by Alberre, and the other by me.","nextNodeIds":[745030105]},{"nodeId":745030105,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":35288242,"text":"On my side, we wish to model the agility of a Champion Duelist, and so we'll need you to complete a few underwater speed challenges.","nextNodeIds":[745030106]},{"nodeId":745030106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2833440530,"text":"Huh, do Champion Duelists have to train underwater?","nextNodeIds":[745030107]},{"nodeId":745030107,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":3056125938,"text":"Who knows? I do not know one personally, and I don't think the boss knows any either. He probably just thinks that it's cooler this way.","nextNodeIds":[745030108]},{"nodeId":745030108,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":2783922610,"text":"He originally wanted to install 10 different water-drawing mechanisms that can spray jets of water, but eventually gave up on this idea due to the high cost.","nextNodeIds":[745030109,745030110]},{"nodeId":745030109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":951768154,"text":"That does sound pretty cool.","nextNodeIds":[745030111]},{"nodeId":745030111,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":2993891290,"text":"Well, Fontaine is the realm of water, after all, and if this is to be sold in other nations, a little Fontainian flair is needed.","nextNodeIds":[745030112]},{"nodeId":745030112,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":2513029570,"text":"Anyway, we've prepared a handbook with relevant details. Please peruse it at your disposal.","nextNodeIds":[745030113]},{"nodeId":745030113,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":3954421994,"text":"Well, are you two raring to go already?","nextNodeIds":[745030114]},{"nodeId":745030114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1234929378,"text":"Let me make some preparations.","nextNodeIds":[745030115]},{"nodeId":745030115,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"Arbon","textMapHash":2556892506,"text":"No problem. The data collection devices have already been placed over there, so you need not worry about them. You just need to focus on completing the challenge.","nextNodeIds":[]},{"nodeId":745030110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3699139634,"text":"Only kids would find that cool.","nextNodeIds":[745030111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":