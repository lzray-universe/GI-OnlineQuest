{"mainQuestId":74515,"title":"","description":"","titleTextMapHash":305186271,"descTextMapHash":3273937382,"mainQuestExcel":{"mainQuestId":74515,"titleTextMapHash":305186271,"title":"","descTextMapHash":3273937382,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ74515","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":3273937382,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74515,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2051212273,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74515","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":305186271,"type":"WQ","unlockDescTextMapHash":946306710}},"flow":[{"subQuestId":7451501,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7451501],"talks":[{"talkId":7451501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7451501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7451501,"initDialog":745150101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30611],"performCfg":"QuestDialogue/WQ/Fontaine_74515/Q7451501","priority":5,"questId":74515,"showRandomTalkCount":0},"dialogs":[{"nodeId":745150101,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":3227322802,"text":"#Hmm? Is that you, {NICKNAME}, Paimon? Ah, wonderful, excellent timing! I was just about to head to the Adventurers' Guild to post a commission!","nextNodeIds":[745150102]},{"nodeId":745150102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1686067754,"text":"#Well, well, well! A commission, coming right to us? Guess we're eating good tonight, {NICKNAME}!","nextNodeIds":[745150103]},{"nodeId":745150103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3086389570,"text":"Ahem... Paimon...","nextNodeIds":[745150104]},{"nodeId":745150104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":614255578,"text":"Oh, uh, that's right. As famed adventurers, we've got some standards when it comes to our fees...","nextNodeIds":[745150105]},{"nodeId":745150105,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":1276001970,"text":"Don't you worry about that! As long as you manage the various experimental modules as you did before, you'll be well compensated — I guarantee it!","nextNodeIds":[745150106]},{"nodeId":745150106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2203680338,"text":"B—Before? Wait, have we met?","nextNodeIds":[745150107]},{"nodeId":745150107,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":75807490,"text":"*sigh* Have you forgotten me again? It's me, Hosseini, a researcher from Sumeru. We've worked together a bunch of times already, you know...?","nextNodeIds":[745150108]},{"nodeId":745150108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":505430818,"text":"S—Sorry, we just, uh...","nextNodeIds":[745150109]},{"nodeId":745150109,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":1913171322,"text":"I hope you recall the Energy Amplifier, at least?","nextNodeIds":[745150110,745150111]},{"nodeId":745150110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1151531210,"text":"Wait, you're Amplifier Man, aren't you?","nextNodeIds":[745150113]},{"nodeId":745150113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2459984682,"text":"...Oh, right! It's you! You're the one from The Chasm!","nextNodeIds":[745150114]},{"nodeId":745150114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1545564442,"text":"You're a lot more cheerful than when we saw you last... No wonder we didn't recognize you.","nextNodeIds":[745150115]},{"nodeId":745150115,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":3566414754,"text":"Hehe, is that so? I guess I'm just that happy, then — I haven't been this lucky in a long while.","nextNodeIds":[745150116]},{"nodeId":745150116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3341858210,"text":"Huh. What happened? C'mon, tell us!","nextNodeIds":[745150117]},{"nodeId":745150117,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":2963448778,"text":"Well, it's a long story. After we parted last time, I returned straight to the Akademiya and proposed the idea of an artificial Energy Amplifier based on the data we collected.","nextNodeIds":[745150118]},{"nodeId":745150118,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":1909233994,"text":"At first, my mentor seemed very excited by the proposal. Gave it the \"highest praise\" right on the spot, in fact. And then...","nextNodeIds":[745150119]},{"nodeId":745150119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1775951802,"text":"Then...?","nextNodeIds":[745150120]},{"nodeId":745150120,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":1586216346,"text":"He booted me out of Sumeru to make me run errands for him in Fontaine.","nextNodeIds":[745150121]},{"nodeId":745150121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1406299506,"text":"Wait, what? Why? Didn't he praise you?","nextNodeIds":[745150122]},{"nodeId":745150122,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":247054218,"text":"Oh, he did praise me! For having the gall to submit a fantasy novel as a project proposal, I mean.","nextNodeIds":[745150123]},{"nodeId":745150123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":664596450,"text":"Err, no matter how you spin it, that's definitely not praise...","nextNodeIds":[745150124]},{"nodeId":745150124,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":2268580434,"text":"Indeed. I, too, found myself trapped in a pit of despair for some time. However, I had the good fortune of encountering some fine partners and investors here — they took up my project immediately.","nextNodeIds":[745150125]},{"nodeId":745150125,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":3540609882,"text":"With their assistance, I've successfully integrated my previous research with Fontainian techniques to create an artificial Energy Amplifier — the \"Hosseini Amplifier.\"","nextNodeIds":[745150126]},{"nodeId":745150126,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":1900163682,"text":"As long as it passes the tests as my calculations predict it should, forget the trials of the God of Wisdom — I may yet even become a Sage.","nextNodeIds":[745150127]},{"nodeId":745150127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3972388298,"text":"Haven't even graduated yet, have we?","nextNodeIds":[745150128]},{"nodeId":745150128,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":1392199466,"text":"Ahem! No need to fuss over meaningless confounding variables like that. That's just a tiny twist on the road to success.","nextNodeIds":[745150129]},{"nodeId":745150129,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":50758194,"text":"The most important thing now is to experimentally verify the actual performance of my Amplifier. That's why I need volunteers to test it within Domains.","nextNodeIds":[745150130]},{"nodeId":745150130,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":164534714,"text":"#Well, then, {NICKNAME}, would you like to volunteer to test my Hosseini Amplifier?","nextNodeIds":[745150131,745150133]},{"nodeId":745150131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2629129618,"text":"Simply put, you need me to use it while I beat up baddies.","nextNodeIds":[745150132]},{"nodeId":745150132,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":3431942954,"text":"Yes, precisely. I have nothing but faith in your capabilities, but the current Amplifier design isn't quite up to mark, so do be careful.","nextNodeIds":[]},{"nodeId":745150133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2716211570,"text":"Alright. Leave it to me!","nextNodeIds":[745150134]},{"nodeId":745150134,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":1564821410,"text":"#Now, {NICKNAME}, I have nothing but faith in your capabilities, but the current Amplifier design isn't quite up to mark, so do be careful.","nextNodeIds":[]},{"nodeId":745150111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3137763026,"text":"Nothing comes to mind there either...","nextNodeIds":[745150112]},{"nodeId":745150112,"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","textMapHash":2906285570,"text":"What about \"Amplifier Man,\" then? Surely that rings a bell!","nextNodeIds":[745150113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7451501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30611,"speakerName":"Hosseini","count":18},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3273937382,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74515/Q7451501","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":745150101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7451501,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30611],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"ME