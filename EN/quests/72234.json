TalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7223402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7223401,"initDialog":722340101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20343],"performCfg":"","priority":5,"questId":72234,"showRandomTalkCount":0},"dialogs":[{"nodeId":722340101,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":4044175130,"text":"How's things going? Sitting pretty?","nextNodeIds":[722340102]},{"nodeId":722340102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1857482594,"text":"Whoa, that was sudden!","nextNodeIds":[722340103]},{"nodeId":722340103,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":630349098,"text":"Oh, uh, terribly sorry. That wasn't my intention to scare you.","nextNodeIds":[722340104]},{"nodeId":722340104,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":4028986722,"text":"I'm Kabayama, and I often sit in the spot where you're sitting now. It's a nice, quiet place where you can just think about life.","nextNodeIds":[722340105]},{"nodeId":722340105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1627303426,"text":"Would you like it back?","nextNodeIds":[722340106]},{"nodeId":722340106,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":1156623162,"text":"Thanks, but it's alright. By the way, you're not from here, are you?","nextNodeIds":[722340107]},{"nodeId":722340107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4189551010,"text":"That's right.","nextNodeIds":[722340108]},{"nodeId":722340108,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":1977448410,"text":"Then you must be quite knowledgeable indeed. I've never seen the outside world, though I've had a lot of experience moving house.","nextNodeIds":[722340109]},{"nodeId":722340109,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":4067994242,"text":"*sigh* Speaking of that...","nextNodeIds":[722340110]},{"nodeId":722340110,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":1174902858,"text":"We moved so often when I was young that I never really had the chance to make good friends. I saw many a fine sight while wandering about, but there was no one to share them with...","nextNodeIds":[722340111]},{"nodeId":722340111,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":2862155970,"text":"You know what? Why don't I show those places to you? If you pass by spots like this, take a seat and have a look about — then come back and tell me what you think.","nextNodeIds":[722340112]},{"nodeId":722340112,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":4096757154,"text":"One such place is beneath a stone gate at the highest point in The Narrows. One of them is an open space surrounded by corals near the Evernight Temple, and the last one is beside the towering ruins at the Serpent's Heart.","nextNodeIds":[722340113]},{"nodeId":722340113,"roleType":"TALK_ROLE_NPC","speakerId":20343,"speakerName":"Kabayama","textMapHash":3403897426,"text":"I've left markings on all these places, and hung a lamp there to light my way. You should find them, easy-peasy.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7223401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7223403,"order":3,"stepDescription":"","stepDescTextMapHash":2201970484,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7223403,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7223403,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","ID