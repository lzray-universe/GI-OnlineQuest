UEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3107","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2201101],"talks":[{"talkId":2201101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2201101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2201101,"initDialog":220110101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3107],"performCfg":"","priority":5,"questId":22011,"showRandomTalkCount":0},"dialogs":[{"nodeId":220110101,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":1287293058,"text":"Ugh... who on earth is spreading this rumor?...","nextNodeIds":[220110102]},{"nodeId":220110102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2496374658,"text":"What rumor?","nextNodeIds":[220110103]},{"nodeId":220110103,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":363036834,"text":"About the fortune slips at the shrine.","nextNodeIds":[220110104]},{"nodeId":220110104,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":2539051586,"text":"You know what fortune slips are, right? To put it simply, they are a form of astrology done by drawing lots.","nextNodeIds":[220110105]},{"nodeId":220110105,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":1397854850,"text":"You can reveal some simple fortunes from the wording on the slip you get.","nextNodeIds":[220110106]},{"nodeId":220110106,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":3692888594,"text":"If you get a good sign, great. But people usually leave the bad signs at the shrine to rid themselves of the bad fortune.","nextNodeIds":[220110107]},{"nodeId":220110107,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":3941534858,"text":"But... a rumor has somehow spread that if you throw the bad slips to the top of the tree, your bad luck will be dispelled by the archon.","nextNodeIds":[220110108]},{"nodeId":220110108,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":3966553610,"text":"Here's the funniest part: some people even think that the higher you throw it, the faster the good luck will come and the faster the bad luck will dissipate. What nonsense!","nextNodeIds":[220110109]},{"nodeId":220110109,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":532979858,"text":"As the rumors got more and more outrageous, people have started throwing Mora up the tree, too!","nextNodeIds":[220110110]},{"nodeId":220110110,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":1507904258,"text":"It's said that if the Mora you threw gets stuck in the branches, that means that your prayer has been accepted. Not only will your wish come true, but you will also enjoy good luck for a whole year.","nextNodeIds":[220110111,220110114]},{"nodeId":220110111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":898769386,"text":"Is that true?","nextNodeIds":[220110112]},{"nodeId":220110112,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":2363725730,"text":"Of course not! Let's put aside whether individual prayers can be heard or not... throwing Mora is just way off. Besides, Mora all look the same, don't they?","nextNodeIds":[220110113]},{"nodeId":220110113,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":1867515850,"text":"Are they expecting the archon to pick up the Mora one by one to figure out who they are from?","nextNodeIds":[220110116]},{"nodeId":220110116,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":2559224626,"text":"I understand that they want to pray for blessings, but... throwing things up there won't get them any.","nextNodeIds":[220110117]},{"nodeId":220110117,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":1750685642,"text":"Besides, it all falls down once the wind kicks up.","nextNodeIds":[220110118]},{"nodeId":220110118,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":604141682,"text":"I've tried to clean the tree up by myself, but I'm not very athletic. Not only did I fail to clean it up, but I got stuck for a long time and couldn't get down...","nextNodeIds":[220110119]},{"nodeId":220110119,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":4145991866,"text":"But I can't just leave it unattended... Traveler, could you help me go up the roof to clean up a little?","nextNodeIds":[220110120,220110122]},{"nodeId":220110120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2835930370,"text":"No problem. Leave it to me.","nextNodeIds":[220110121]},{"nodeId":220110121,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":132244746,"text":"Well, I'm counting on you then, Traveler. Go to the roof and clean it up, and if you get any fortune slips, please bring them to me.","nextNodeIds":[]},{"nodeId":220110122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3686623490,"text":"What will you do with them?","nextNodeIds":[220110123]},{"nodeId":220110123,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":3471759050,"text":"Well... Ms. Hotomi says that no matter what, those are the fortunes that people sought.","nextNodeIds":[220110124]},{"nodeId":220110124,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":818590466,"text":"It would be inappropriate to just throw them away. So I'll put them where they belong once they are collected.","nextNodeIds":[220110125]},{"nodeId":220110125,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":3224526562,"text":"*sigh* If everyone had followed the rules from the beginning, we wouldn't have so much trouble...","nextNodeIds":[220110126]},{"nodeId":220110126,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":899691890,"text":"Well, I'm counting on you then, Traveler. Go to the roof and clean it up, and if you get any fortune slips, please bring them to me.","nextNodeIds":[]},{"nodeId":220110114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2094217666,"text":"Can't we just clear the air to solve the problem?","nextNodeIds":[220110115]},{"nodeId":220110115,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"Maki","textMapHash":4287437018,"text":"There are too many people doing it now. I don't think I can convince everyone...","nextNodeIds":[220110116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3107","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2201102,"order":2,"stepDescription":"Go to the roof to clean up","stepDescTextMapHash":507803876,"finishConds":[{"BFGALAINLMD":3,"LNHLPKELCAL":[100883,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""},{"BFGALAINLMD":3,"LNHLPKELCAL":[100884,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22011GreatTree","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2201103],"talks":[{"talkId":2201103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{