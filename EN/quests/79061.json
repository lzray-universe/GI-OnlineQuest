{"mainQuestId":79061,"title":"","description":"","titleTextMapHash":2945910943,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":79061,"titleTextMapHash":2945910943,"title":"","descTextMapHash":3673441998,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":2032,"luaPath":"Actor/Quest/WQ79061","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2032,"chapterId":0,"descTextMapHash":3673441998,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":79061,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1890970889,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ79061","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":79060,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2945910943,"type":"WQ","unlockDescTextMapHash":1756344142}},"flow":[{"subQuestId":7906101,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7906102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7906103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7906101,7906102,7906103],"talks":[{"talkId":7906101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7906101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7906101,"initDialog":790610101,"nextRandomTalks":[],"nextTalks":[7906102,7906103],"npcId":[21611],"performCfg":"QuestDialogue/WQ/FairyBook_79061/Q7906101","priority":5,"questId":79061,"showRandomTalkCount":0},"dialogs":[{"nodeId":790610101,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":1749870866,"text":"No matter how many times you ask, Rozel, I will not go out venturing with you.","nextNodeIds":[790610102]},{"nodeId":790610102,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":1661061210,"text":"You're my friend, yes, and that will never change. I do not dislike you. But... I do not enjoy traveling.","nextNodeIds":[790610103]},{"nodeId":790610103,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":586878058,"text":"Esnoir. It is nowhere near as frightening as you imagine. It's just a trip, that's all.","nextNodeIds":[790610104]},{"nodeId":790610104,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":2490538402,"text":"The outside world plays host to many flowers that cannot be found in our village and many people we've never met — even the shapes of the clouds are different there.","nextNodeIds":[790610105]},{"nodeId":790610105,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":1442691034,"text":"Remember the seed I brought you from outside? I can guarantee that you've never seen any flower with its shape or color before.","nextNodeIds":[790610106]},{"nodeId":790610106,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":4293414226,"text":"It's still a seed now. I'll plant it, and then we'll see.","nextNodeIds":[790610107]},{"nodeId":790610107,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":3046085490,"text":"If you're willing to go with me, we might be able to see this flower with our own eyes.","nextNodeIds":[790610108]},{"nodeId":790610108,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":2561419354,"text":"Rozel... I'm sorry, I have no wish to travel abroad, nor do I want to become like those venturers.","nextNodeIds":[790610109]},{"nodeId":790610109,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":4251406058,"text":"They always fret about the value of carpets, and pay no mind to beautiful hats...","nextNodeIds":[790610110]},{"nodeId":790610110,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":1212622090,"text":"This is how your travels change you, and it scares me.","nextNodeIds":[790610111]},{"nodeId":790610111,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":3435915674,"text":"That is true. But have you noticed the maps, the plant samples, and the travelogues that fill their luggage to bursting?","nextNodeIds":[790610112]},{"nodeId":790610112,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":3622386738,"text":"We surge through different bushes and shrubs like a gust of wind, like rivers passing through another lake... We encounter different things, and we, too, become different people.","nextNodeIds":[790610113]},{"nodeId":790610113,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":3448623010,"text":"This is how travel changes you, and it scares me too... But I'm thankful for those changes as well.","nextNodeIds":[790610114]},{"nodeId":790610114,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":2407479714,"text":"I'd compare it to a slice of bread with cream slathered on both sides. You're going to make a mess no matter how carefully you try to hold it.","nextNodeIds":[790610115]},{"nodeId":790610115,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":644021666,"text":"In that case, I'd spread the cream on separately. That way, I can even smear on different flavors.","nextNodeIds":[790610116,790610117]},{"nodeId":790610116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1031832234,"text":"Not a bad call. I'm sure it'll be a filling meal.","nextNodeIds":[790610118]},{"nodeId":790610118,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":2132741538,"text":"Ah, it's you, here at last! Rozel has been telling me how wonderful the outside world is, inviting me along to venture...","nextNodeIds":[790610119]},{"nodeId":790610119,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":2045607874,"text":"Do you know much of that world? Is it... as he says it is?","nextNodeIds":[]},{"nodeId":790610117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2102264858,"text":"Not a bad idea. That should keep your hands clean.","nextNodeIds":[790610118]}]},{"talkId":7906102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["0","1","79061","",""],"type":"TALK_EXEC_SET_QUEST_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7906101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7906102,"initDialog":790610201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21611],"performCfg":"QuestDialogue/WQ/FairyBook_79061/Q7906102","priority":5,"questId":79061,"showRandomTalkCount":0},"dialogs":[{"nodeId":790610201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1706611106,"text":"Yes, it is. In the <color=#FFCC33FF>outside world</color>, there's no lack of new things to discover.","nextNodeIds":[790610202]},{"nodeId":790610202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3954724858,"text":"Right! There's lots to eat, and many fun things to do, and you'll even get to encounter many interesting things and awesome people. For example...","nextNodeIds":[790610203,790610204,790610205]},{"nodeId":790610203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":307781946,"text":"You'll find those who focus on the beautiful essence of all things.","nextNodeIds":[790610206]},{"nodeId":790610206,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":4238861746,"text":"Really? Dear me. I'd believed the outside world to only be conscious of \"value,\" and to be full of those who wish to wear hats but dare not.","nextNodeIds":[790610207]},{"nodeId":790610207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2986753946,"text":"Hmm, well, you can think of it... Like a cake with various chocolates scattered on top! Every bite's a whole new experience.","nextNodeIds":[790610208]},{"nodeId":790610208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1839761866,"text":"That's way better than having all the chocs taste the same — 'cause that would make for a super ordinary cake, right?","nextNodeIds":[790610209,790610210]},{"nodeId":790610209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":290996530,"text":"Well said, Paimon, well said.","nextNodeIds":[790610211]},{"nodeId":790610211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3498803482,"text":"Well, who wouldn't after listening to it for this long?","nextNodeIds":[790610212]},{"nodeId":790610212,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":2537253410,"text":"Is that so? Well, I... I'll need more time to think about this. But perhaps a little... Just a little venturing couldn't hurt, surely?","nextNodeIds":[790610213]},{"nodeId":790610213,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":1958059954,"text":"No need to rush into things, Esnoir. There is still much time before my next voyage. Until then, let us consider this issue together.","nextNodeIds":[]},{"nodeId":790610210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1599198482,"text":"You've mastered the local lingo, I see.","nextNodeIds":[790610211]},{"nodeId":790610204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3027194842,"text":"You'll bear witness to radiant, unfading ideals.","nextNodeIds":[790610206]},{"nodeId":790610205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":816250034,"text":"You'll get to meet those who work hard to realize their dreams.","nextNodeIds":[790610206]}]},{"talkId":7906103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["0","2","79061","",""],"type":"TALK_EXEC_SET_QUEST_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7906101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7906103,"initDialog":790610301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21611],"performCfg":"QuestDialogue/WQ/FairyBook_79061/Q7906103","priority":5,"questId":79061,"showRandomTalkCount":0},"dialogs":[{"nodeId":790610301,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1874079474,"text":"The <color=#FFCC33FF>world inside</color> isn't too bad.","nextNodeIds":[790610302]},{"nodeId":790610302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":663850386,"text":"That's true. This is your home, after all, Esnoir. Paimon's sure you like it here. Also...","nextNodeIds":[790610303,790610304,790610305]},{"nodeId":790610303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":266609794,"text":"Friends you are familiar with live here.","nextNodeIds":[790610306]},{"nodeId":790610306,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":8713178,"text":"Indeed! I worry about losing these, and I fret about them constantly.","nextNodeIds":[790610307]},{"nodeId":790610307,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":2317759802,"text":"This is all good. Wonderful, even. I have no wish for them to change, nor do I wish to change.","nextNodeIds":[790610308]},{"nodeId":790610308,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":2289821242,"text":"But... Venturing abroad will cause everything to change. Won't it? Rozel?","nextNodeIds":[790610309]},{"nodeId":790610309,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":3333670610,"text":"Yes. It definitely will. I will not deceive you, nor do I wish to sadden you, dear Esnoir.","nextNodeIds":[790610310]},{"nodeId":790610310,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":4048040482,"text":"Alright... Alright. I understand where you're coming from, as I'm sure you do me.","nextNodeIds":[790610311]},{"nodeId":790610311,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":1844782610,"text":"I need time to consider your invitation before making my decision. If nothing else, let us simply enjoy this spot of tea in peace.","nextNodeIds":[790610312]},{"nodeId":790610312,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":4031909810,"text":"Alright. I will accompany you, Esnoir. There is still much time before my next voyage. Until then, let us consider this issue together.","nextNodeIds":[]},{"nodeId":790610304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1500550690,"text":"There are many pretty flowers...","nextNodeIds":[790610306]},{"nodeId":790610305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3052400282,"text":"And delicious cakes.","nextNodeIds":[790610306]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7906102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7906103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7906102,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7906104,7906105],"talks":[{"talkId":7906104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7906102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","1","79061","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7906104,"initDialog":790610401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21611],"performCfg":"","priority":5,"questId":79061,"showRandomTalkCount":0},"dialogs":[{"nodeId":790610401,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":3404401946,"text":"Rozel, maybe... I can go with you. But... I just don't know where to even begin preparing.","nextNodeIds":[790610402]},{"nodeId":790610402,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":2464838946,"text":"That's easy. Prepare your jam, bread, and curiosity. Put on some comfortable clothes, and bring a spare set as well.","nextNodeIds":[790610403]},{"nodeId":790610403,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":2319020850,"text":"Finally, prepare yourself — Because you might have to throw some of those things out along the way.","nextNodeIds":[790610404]},{"nodeId":790610404,"roleType":"TALK_ROLE_NPC","speakerId":21448,"speakerName":"Esnoir","textMapHash":1362332578,"text":"Oh. It all sounds so complicated. And I don't want to throw them away, because they're mine, they're precious, and I like them.","nextNodeIds":[790610405]},{"nodeId":790610405,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":3414710138,"text":"And you'll discover new precious things after those leave you, my dear Esnoir.","nextNodeIds":[790610406]},{"nodeId":790610406,"roleType":"TALK_ROLE_NPC","speakerId":21450,"speakerName":"Rozel","textMapHash":3347285810,"text":"Believe me, this will be a fascinating journey.","nextNodeIds":[]}]},{"talkId":7906105,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7906102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","2","79061","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUES