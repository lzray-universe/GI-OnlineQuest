ticipantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7505802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7505802,"initDialog":750013301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21459],"performCfg":"QuestDialogue/WQ/Natlan_75001/Q7500133","priority":5,"questId":75058,"showRandomTalkCount":0},"dialogs":[{"nodeId":750013301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4124233258,"text":"Strange... The golden patterns flew right over, just as before, but the Inscription hasn't appeared beneath this pillar... Why's that?","nextNodeIds":[750013302]},{"nodeId":750013302,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":724384546,"text":"That indicates that not only has the Inscription been squeezed out, but it's also become fragmented... This is bad. We need to find any scattered bits, and fast.","nextNodeIds":[750013303]},{"nodeId":750013303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":344377162,"text":"So, where do we find them?","nextNodeIds":[750013304]},{"nodeId":750013304,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":227532330,"text":"...I don't know either.","nextNodeIds":[750013305]},{"nodeId":750013305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3168538298,"text":"Huh...","nextNodeIds":[750013306]},{"nodeId":750013306,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":314727818,"text":"They should still be held down by some power despite being scattered, so my guess is that they're nearby. Maybe we just need to look around...","nextNodeIds":[750013307]},{"nodeId":750013307,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1357986554,"text":"Rawr, rawr!","nextNodeIds":[750013308]},{"nodeId":750013308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3362688946,"text":"Hmm? You wanna go over? We're doing something important right now — we'll play with you later, alright?","nextNodeIds":[750013309]},{"nodeId":750013309,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1452729234,"text":"Mrrraa... Rawr! Rawr!","nextNodeIds":[750013310]},{"nodeId":750013310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1395029354,"text":"Do you mean that the Inscription is over there?","nextNodeIds":[750013311]},{"nodeId":750013311,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3050815450,"text":"Rawr!","nextNodeIds":[750013312]},{"nodeId":750013312,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":962294250,"text":"Oh wow! I've heard that even now, there are still Saurians who can sense an Inscription's power, but I always thought it was hearsay — could it be true?","nextNodeIds":[750013313]},{"nodeId":750013313,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3378663978,"text":"#I suppose you really are no ordinary Tepetlisaurus, {REALNAME[ID(2)|SHOWHOST(true)]}.","nextNodeIds":[750013314]},{"nodeId":750013314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2068558762,"text":"So you can do that too, huh? ...Hmph! You've got some way to go before you can be as good a guide as Paimon.","nextNodeIds":[750013315]},{"nodeId":750013315,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":4247659954,"text":"Hmm?","nextNodeIds":[750013316,750013318]},{"nodeId":750013316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4145035226,"text":"Paimon's jealous.","nextNodeIds":[750013317]},{"nodeId":750013317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3832228578,"text":"Says who? Paimon's way more broad-minded than she looks! That was just her way of praising him!","nextNodeIds":[750013320]},{"nodeId":750013320,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":343056394,"text":"Err... Err?","nextNodeIds":[750013321]},{"nodeId":750013321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4277427234,"text":"*sigh* The little guy didn't catch that at all. Bah, if only he was a little smarter...","nextNodeIds":[750013322]},{"nodeId":750013322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":964320266,"text":"I'm sure he'll understand someday...","nextNodeIds":[750013323]},{"nodeId":750013323,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":2191365298,"text":"Precisely. Those in the tribe responsible for Saurian care always say that it takes time to truly establish a rapport with them.","nextNodeIds":[750013324]},{"nodeId":750013324,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"Titu","textMapHash":3135284810,"text":"The secret to success is as follows — exercise patience, and constantly communicate. Whether humans wish to understand Saurians, or Saurians humans, they both need... lots and lots of time.","nextNodeIds":[750013325]},{"nodeId":750013325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":768836746,"text":"#True... Just like Paimon didn't get what {REALNAME[ID(2)|SHOWHOST(true)]} was trying to tell us just now either.","nextNodeIds":[750013326]},{"nodeId":750013326,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1767432674,"text":"#Sorry, {REALNAME[ID(2)|SHOWHOST(true)]}.","nextNodeIds":[750013327]},{"nodeId":750013327,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3768367850,"text":"Rrraa, Rawr!","nextNodeIds":[750013328]},{"nodeId":750013328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3806090730,"text":"You're quick to reply though, Paimon'll give you that!","nextNodeIds":[750013329]},{"nodeId":750013329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1155271986,"text":"Alright, we'll follow you and see if we can find any golden patterns.","nextNodeIds":[]},{"nodeId":750013318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3042715794,"text":"See, Paimon's praising you!","nextNodeIds":[750013319]},{"nodeId":750013319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3290484482,"text":"Well, that's true, but don't let it go to your head now...","nextNodeIds":[750013320]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7500121,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7505801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NON