inishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7333007","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7333007,"initDialog":733300701,"nextRandomTalks":[],"nextTalks":[],"npcId":[20883,20966,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73330/Q7333007","priority":5,"questId":73330,"showRandomTalkCount":0},"dialogs":[{"nodeId":733300701,"roleType":"TALK_ROLE_NPC","speakerId":20883,"speakerName":"Sorush","textMapHash":2182328834,"text":"Hey, you scheming humans! I suggest leaving this place at once — the heritage and secrets of us Pari are not for you to covet, and certainly not within your reach.","nextNodeIds":[733300702]},{"nodeId":733300702,"roleType":"TALK_ROLE_NPC","speakerId":20966,"speakerName":"Markozov","textMapHash":2672916194,"text":"...Pari? You're a Pari! Oh, what an amazing experience!","nextNodeIds":[733300703]},{"nodeId":733300703,"roleType":"TALK_ROLE_NPC","speakerId":20966,"speakerName":"Markozov","textMapHash":1600764514,"text":"#Oh! And there's also a {M#wiry young man}{F#little young lady} with {M#his}{F#her}... pet?","nextNodeIds":[733300704]},{"nodeId":733300704,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2308626322,"text":"#Hey, watch what you say! Paimon's {M#his}{F#her} best friend!","nextNodeIds":[733300705]},{"nodeId":733300705,"roleType":"TALK_ROLE_NPC","speakerId":20966,"speakerName":"Markozov","textMapHash":1280420818,"text":"Friend... Why, of course! \"Best friend\"... What a beautiful sound! I've always wanted to have a \"best friend\" since childhood...","nextNodeIds":[733300706]},{"nodeId":733300706,"roleType":"TALK_ROLE_NPC","speakerId":20966,"speakerName":"Markozov","textMapHash":2073935674,"text":"#{M#Wiry young man}{F#Little young lady}, you're certainly not in need of two best friends, are you?","nextNodeIds":[733300707,733300708]},{"nodeId":733300707,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1031582866,"text":"What do you mean?","nextNodeIds":[733300710]},{"nodeId":733300710,"roleType":"TALK_ROLE_NPC","speakerId":20966,"speakerName":"Markozov","textMapHash":3157618722,"text":"I mean... Even if you're the one having two best friends, don't you think it's a little unfair?","nextNodeIds":[733300711]},{"nodeId":733300711,"roleType":"TALK_ROLE_NPC","speakerId":20966,"speakerName":"Markozov","textMapHash":2747292186,"text":"Inequities like this are impossible to forgive... So please, hand the Pari over to me. As for how I'll treat it... you wouldn't have to worry. I'll make sure it's used to its full potential.","nextNodeIds":[733300712]},{"nodeId":733300712,"roleType":"TALK_ROLE_NPC","speakerId":20883,"speakerName":"Sorush","textMapHash":2685451146,"text":"Insolent fool...","nextNodeIds":[733300713]},{"nodeId":733300713,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3118738746,"text":"Whoa, he's being so unreasonable... There's no getting through to him!","nextNodeIds":[733300714]},{"nodeId":733300714,"roleType":"TALK_ROLE_NPC","speakerId":20883,"speakerName":"Sorush","textMapHash":3892064834,"text":"We can always make him understand without wasting our words... My clever Yasnapati, surely you know what I mean?","nextNodeIds":[733300715]},{"nodeId":733300715,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2786176930,"text":"Oh, Paimon knows! Sorush wants us to teach him a lesson!","nextNodeIds":[733300716]},{"nodeId":733300716,"roleType":"TALK_ROLE_NPC","speakerId":20883,"speakerName":"Sorush","textMapHash":3478280506,"text":"Hmph! Silence, Pale Floater!","nextNodeIds":[]},{"nodeId":733300708,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1454066146,"text":"I actually wouldn't mind.","nextNodeIds":[733300709]},{"nodeId":733300709,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":958504018,"text":"No way! Only Paimon can be your best friend!","nextNodeIds":[733300710]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7333007,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20966"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7333008,"order":13,"stepDescription":"Defeat all opponents","stepDescTextMapHash":258163636,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7333008"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKE