{"mainQuestId":22111,"title":"New Horizons of Adventure","description":"Looks like Katheryne has something to tell you...","titleTextMapHash":3910839937,"descTextMapHash":62084359,"mainQuestExcel":{"mainQuestId":22111,"titleTextMapHash":3910839937,"title":"New Horizons of Adventure","descTextMapHash":62084359,"description":"Looks like Katheryne has something to tell you...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":62084359,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":22111,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2218840447,"LEFIHLHODBM":[],"luaPath":"","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[122111],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3910839937,"type":"WQ","unlockDescTextMapHash":1941879883}},"flow":[{"subQuestId":2211101,"order":1,"stepDescription":"Talk to Katheryne in Mondstadt","stepDescTextMapHash":1348701534,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2211101],"talks":[{"talkId":2211101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":true,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211101","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":2211101,"initDialog":221110101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1512],"performCfg":"","priority":1,"questId":22111,"showRandomTalkCount":0},"dialogs":[{"nodeId":221110101,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3350201536,"text":"Any new Commissions?","nextNodeIds":[221110102]},{"nodeId":221110102,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2348202144,"text":"Greetings, Adventurer. The tales of your deeds are now known to all in Mondstadt.","nextNodeIds":[221110103]},{"nodeId":221110103,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":4034026424,"text":"Continue in this fashion and you are destined to become one of the great Adventurers of our age.","nextNodeIds":[221110104,221110107]},{"nodeId":221110104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3641430320,"text":"Got anything for me to do?","nextNodeIds":[221110105]},{"nodeId":221110105,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1697803552,"text":"If you wish to become a great Adventurer, there comes a time when you must move beyond the places you know.","nextNodeIds":[221110106]},{"nodeId":221110106,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3946436216,"text":"Now you have amassed such a wealth of adventuring experience, perhaps it is time for you to explore somewhere new.","nextNodeIds":[221110110]},{"nodeId":221110110,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":2230900024,"text":"Take this letter and deliver it to Liyue Katheryne.","nextNodeIds":[221110111,221110113]},{"nodeId":221110111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1087965848,"text":"...There's a Katheryne in Liyue too?","nextNodeIds":[221110112]},{"nodeId":221110112,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3950713912,"text":"Yes. I'm sure you will have no trouble finding her.","nextNodeIds":[221110115]},{"nodeId":221110115,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1283769992,"text":"Anyway, once Liyue Katheryne has this letter, she will be your point of contact there for all your adventuring needs.","nextNodeIds":[221110116]},{"nodeId":221110116,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3243067760,"text":"Of course, whenever you are back in Mondstadt I will still be delighted to be of service.","nextNodeIds":[221110117]},{"nodeId":221110117,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3945581216,"text":"I would ask that you refrain from opening the letter en route. If anything were to fall out, it could cause complications.","nextNodeIds":[221110118]},{"nodeId":221110118,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":3236720200,"text":"Adventurer! The time has come for you to take the next step towards the stars and the abyss. Ad astra abyssosque!","nextNodeIds":[]},{"nodeId":221110113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1742904584,"text":"Should I call you \"Mondstadt Katheryne\" in the future, then?","nextNodeIds":[221110114]},{"nodeId":221110114,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":246791368,"text":"If it helps advance your adventuring career, call me whatever you like.","nextNodeIds":[221110115]},{"nodeId":221110107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1490723208,"text":"But Mondstadt is all I know...","nextNodeIds":[221110108]},{"nodeId":221110108,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":388514080,"text":"That is because your adventures this far have all been limited to the Mondstadt area.","nextNodeIds":[221110109]},{"nodeId":221110109,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"Katheryne","textMapHash":1422897256,"text":"But all that is about to change. Soon, you will be able to venture into the world beyond.","nextNodeIds":[221110110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1512"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2211102,"order":2,"stepDescription":"Talk to Katheryne in Liyue Harbor","stepDescTextMapHash":2482051614,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["2078"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2211102],"talks":[{"talkId":2211102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":true,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211102","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":2211102,"initDialog":221110201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2078],"performCfg":"","priority":1,"questId":22111,"showRandomTalkCount":0},"dialogs":[{"nodeId":221110201,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3942051552,"text":"I have a letter for you.","nextNodeIds":[221110202]},{"nodeId":221110202,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3540786672,"text":"Ad astra abyssosque! Welcome to the Adventurers' Guild.","nextNodeIds":[221110203]},{"nodeId":221110203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3558699304,"text":"I suspect this is for you...","nextNodeIds":[221110204]},{"nodeId":221110204,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":634258696,"text":"A letter? For me? Oh... So, you're an Adventurer from Mondstadt?","nextNodeIds":[221110205]},{"nodeId":221110205,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1126609064,"text":"What's this — a Dandelion? Why is there a Dandelion in the envelope?","nextNodeIds":[221110206]},{"nodeId":221110206,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":189372152,"text":"Adventurer, did you place a Dandelion in this envelope to try and prove you are from Mondstadt?","nextNodeIds":[221110207]},{"nodeId":221110207,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3390016472,"text":"There's really no need. There is more than enough information contained in this letter to establish your identity and background.","nextNodeIds":[221110208,221110210]},{"nodeId":221110208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1971828792,"text":"It wasn't me.","nextNodeIds":[221110209]},{"nodeId":221110209,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":4216819920,"text":"Not that it really matters, of course.","nextNodeIds":[221110214]},{"nodeId":221110214,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3509513320,"text":"This letter from the Mondstadt Adventurers' Guild says that you are a highly experienced Adventurer.","nextNodeIds":[221110215]},{"nodeId":221110215,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3538179008,"text":"If that's true, I'm sure you are ready to take on Commissions from the Liyue Adventurers' Guild.","nextNodeIds":[221110216]},{"nodeId":221110216,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":3561463448,"text":"A whole new world of wild adventure awaits you. Ad astra abyssosque!","nextNodeIds":[]},{"nodeId":221110210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1029877728,"text":"I bet it was Katheryne...","nextNodeIds":[221110211]},{"nodeId":221110211,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":4153209848,"text":"Katheryne? ...Oh, you must mean Mondstadt Katheryne.","nextNodeIds":[221110212]},{"nodeId":221110212,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":2936619456,"text":"Why did she put a Dandelion in with the letter? Very odd... A Dandelion isn't much use to an Adventurer, now, is it?","nextNodeIds":[221110213]},{"nodeId":221110213,"roleType":"TALK_ROLE_NPC","speakerId":2078,"speakerName":"Katheryne","textMapHash":1144401816,"text":"Not that it really matters, of course.","nextNodeIds":[221110214]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2211102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100398","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["2078"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2211101,2211102],"speakerCounts":[{"roleTy