665801","priority":5,"questId":76658,"showRandomTalkCount":0},"dialogs":[{"nodeId":766580101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2340957634,"text":"Heya, Ginette! Did you get all the robots we found?","nextNodeIds":[766580102]},{"nodeId":766580102,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":4241481090,"text":"I did! Good work, you two.","nextNodeIds":[766580103]},{"nodeId":766580103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4013424466,"text":"Speaking of which, we made some new discoveries!","nextNodeIds":[766580104]},{"nodeId":766580104,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":4225555042,"text":"You did? Please tell me everything!","nextNodeIds":[766580105]},{"nodeId":766580105,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3445443298,"text":"You and Paimon tell Ginette about what you witnessed not long ago.","nextNodeIds":[766580106]},{"nodeId":766580106,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":3092970370,"text":"The behaviors you described... The robots seemed to like you very much, and thus sent you a message. An invitation to \"play together.\"","nextNodeIds":[766580107]},{"nodeId":766580107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3210786794,"text":"Really? Whoa, that's so cool!","nextNodeIds":[766580108]},{"nodeId":766580108,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":4036147178,"text":"Hmm-hmm... I knew it!","nextNodeIds":[766580109]},{"nodeId":766580109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2926767202,"text":"Knew what?","nextNodeIds":[766580110]},{"nodeId":766580110,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":1391872258,"text":"Now I'm certain — my vision can only be realized through interactions between these robots. The more units we can retrieve, the closer we get to my original plan...","nextNodeIds":[766580111]},{"nodeId":766580111,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":495851146,"text":"Now, they can already communicate with others. All we have to do is find the rest of the robots, and... Yes! I can see my creativity bearing fruit...!","nextNodeIds":[766580112]},{"nodeId":766580112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2114281826,"text":"Well, well, someone's excited!","nextNodeIds":[766580113]},{"nodeId":766580113,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","textMapHash":459741618,"text":"Ah! Sorry, I'm getting a bit worked up... I'll still need your help for the rest. Here, I've marked out the next area on the map.","nextNodeIds":[766580114]},{"nodeId":766580114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1967228834,"text":"Then let's get going! Paimon's just as curious to see where this'll lead!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7665801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"Ginette","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":6},{"role