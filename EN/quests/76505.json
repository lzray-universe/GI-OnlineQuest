GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7650501,7650504,7650507,7650508],"talks":[{"talkId":7650501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7650501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","0","76505","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["220122","1","","",""],"type":"QUEST_COND_PACK_HAVE_ITEM_WITH_ID"},{"param":["5285","5285009","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7650501,"initDialog":765050101,"nextRandomTalks":[],"nextTalks":[],"npcId":[6640],"performCfg":"QuestDialogue/WQ/NodKrai_76505/Q7650501","priority":5,"questId":76505,"showRandomTalkCount":0},"dialogs":[{"nodeId":765050101,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":1619107858,"text":"#{NICKNAME}? Paimon? What are the chances? I heard you'd gone to Nod-Krai, but I didn't think we'd meet up again so soon!","nextNodeIds":[765050102]},{"nodeId":765050102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1680319730,"text":"Yeah! Paimon thought she was seeing things, too! Why're you so far from home, Varesa? Are you traveling as well?","nextNodeIds":[765050103]},{"nodeId":765050103,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":1893363890,"text":"Hehe, you could say that! I'm here to buy a batch of agricultural machinery for our orchard.","nextNodeIds":[765050104]},{"nodeId":765050104,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":2534835466,"text":"Dad says that Nod-Krai's got some good stuff that can make our fruit grow better and save me some effort. Y'know, so I'll have more time to sleep... uh, and work out, of course!","nextNodeIds":[765050105]},{"nodeId":765050105,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":987434,"text":"And when I got here, I found sooo much delicious stuff you can't find in Natlan! So apart from official business, I've been spending most of my time feasting!","nextNodeIds":[765050106]},{"nodeId":765050106,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":1378712858,"text":"...Honestly, now that it's almost time to leave, I don't quite want to...","nextNodeIds":[765050107]},{"nodeId":765050107,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":367044362,"text":"So I'm going to walk around while I still can — I'll try everything I haven't tried, and see everything I haven't seen yet!","nextNodeIds":[765050108]},{"nodeId":765050108,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":2737134106,"text":"#What about you? Let me guess... Our hero, {NICKNAME}, is out defending justice in a new land. Am I right?","nextNodeIds":[765050109,765050110]},{"nodeId":765050109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2966687178,"text":"We're just looking around at the moment.","nextNodeIds":[765050111]},{"nodeId":765050111,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":1423107074,"text":"Ooh, I get that too! Getting to a new place means having loads of new stuff to see — just makes you want to get it all on Kamera, doesn't it?","nextNodeIds":[765050112]},{"nodeId":765050112,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":1610306562,"text":"Speaking of which... Agh! I should be taking more photos of the awesome grub I've been having, too!","nextNodeIds":[765050113]},{"nodeId":765050113,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":545595794,"text":"That way, I might be able to get Uncle Atolli to recreate those dishes via the pictures once I'm back home!","nextNodeIds":[765050114]},{"nodeId":765050114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2707102922,"text":"And who knows, a career in food photography might await you.","nextNodeIds":[765050115]},{"nodeId":765050115,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":3936489138,"text":"Ehe, you think so? Me, a food photographer... That sounds awesome, to be honest! Coming into contact with great food every day, then taking pictures of them at their best and most mouth-watering...","nextNodeIds":[765050116,765050117]},{"nodeId":765050116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3920473306,"text":"But before you go take pictures of delicious food...","nextNodeIds":[765050118]},{"nodeId":765050118,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":516805450,"text":"Eh? You wanna take a picture of me? You really wanna?","nextNodeIds":[765050119]},{"nodeId":765050119,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":3339038354,"text":"H—Hang on. My hair's not all messy, is it? Do I still have sauce around my mouth? Ohh, if I knew I'd meet you here, I'd have put on some of the accessories I bought at the market yesterday!","nextNodeIds":[765050120,765050121]},{"nodeId":765050120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3538177010,"text":"You're great just as you are!","nextNodeIds":[765050122]},{"nodeId":765050122,"roleType":"TALK_ROLE_NPC","speakerId":6640,"speakerName":"Varesa","textMapHash":3415537482,"text":"Okay! I—I'll leave it up to you, then!","nextNodeIds":[]},{"nodeId":765050121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1556815514,"text":"Your happy face is more than good enough for a photo.","nextNodeIds":[765050122]},{"nodeId":765050117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":676319066,"text":"Could we take a picture of you?","nextNodeIds":[765050118]},{"nodeId":765050110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1366253258,"text":"And looking for some photo-op material while we're at it.","nextNodeIds":[765050111]}]},{"talkId":7650504,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRul