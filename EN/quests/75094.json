{"nodeId":751260603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4137079194,"text":"This is... This is that hibernating Saurian egg mentioned in those notes!","nextNodeIds":[751260604]},{"nodeId":751260604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1328439642,"text":"#Are you trying to say that we should use the incubator to hatch it, {REALNAME[ID(2)|SHOWHOST(true)]}?","nextNodeIds":[751260605]},{"nodeId":751260605,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":4123593730,"text":"Rawr! Rawr!","nextNodeIds":[751260606]},{"nodeId":751260606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2413634650,"text":"Hmm, the egg does look like it's in good shape, and there's a manual for the incubator. Let's give it a try, shall we?","nextNodeIds":[751260607,751260608]},{"nodeId":751260607,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4207470066,"text":"No clue if it'll work, but we can give it a go.","nextNodeIds":[751260609]},{"nodeId":751260609,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1337953802,"text":"Rawr!","nextNodeIds":[]},{"nodeId":751260608,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1431194218,"text":"Nice, looks like our little buddy's about to meet a new friend!","nextNodeIds":[751260609]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7512606,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133512012"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFD