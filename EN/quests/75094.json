,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":true,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7509406","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7509406,"initDialog":750940601,"nextRandomTalks":[],"nextTalks":[],"npcId":[21460,1005],"performCfg":"QuestDialogue/WQ/Natlan_75094/Q7509406","priority":5,"questId":75094,"showRandomTalkCount":0},"dialogs":[{"nodeId":750940601,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":915453218,"text":"Whew... That sure was scary, with those monsters attacking out of nowhere like that. Good thing we're super strong, huh?","nextNodeIds":[750940602,750940604]},{"nodeId":750940602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2291740330,"text":"Guess I'll be counting on you next time, Paimon.","nextNodeIds":[750940603]},{"nodeId":750940603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":141419882,"text":"Huh? No no no, Paimon can't do that! Who'd want to fight those scary monsters, anyway!?","nextNodeIds":[750940606]},{"nodeId":750940606,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1146154058,"text":"Rawr! Rawr!","nextNodeIds":[750940607]},{"nodeId":750940607,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1748139906,"text":"Heh, looks like he's getting anxious already. Let's just find a way to hatch the egg first!","nextNodeIds":[750940608]},{"nodeId":750940608,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1646577594,"text":"Activate the incubator.","nextNodeIds":[750940609]},{"nodeId":750940609,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1581526658,"text":"The incubator is back in action...\\nAll you need to do now is wait...\\nHours pass, but nothing happens to the Saurian egg. It doesn't change at all...","nextNodeIds":[750940610]},{"nodeId":750940610,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":18280186,"text":"Err... Errh?","nextNodeIds":[750940611]},{"nodeId":750940611,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2634605242,"text":"Weird. Nothing seems to have happened. Have we messed something up? Let's try again!","nextNodeIds":[750940612,750940632]},{"nodeId":750940612,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":44251058,"text":"Let's try again...","nextNodeIds":[750940613]},{"nodeId":750940613,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3524765138,"text":"You reboot the incubator as the instructions indicate...\\nBut just as with your previous attempt, nothing happens to the Saurian egg...","nextNodeIds":[750940614]},{"nodeId":750940614,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1812229410,"text":"Aw... How long do we need to wait? Paimon's zoning out over here... Also, she's getting dizzy... and hungry...","nextNodeIds":[750940615]},{"nodeId":750940615,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":881773418,"text":"Rrah... Grgh...","nextNodeIds":[750940616]},{"nodeId":750940616,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2747677202,"text":"Huh!? Wait! Wait! It moved!","nextNodeIds":[750940617,750940627]},{"nodeId":750940617,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1597899450,"text":"Let's wait a little longer, shall we?","nextNodeIds":[750940618]},{"nodeId":750940618,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2848394370,"text":"After a long while...\\nThe Saurian egg remains unchanged. No reaction, no sign of hatching.","nextNodeIds":[750940619]},{"nodeId":750940619,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3206758858,"text":"Still nothing... Could this incubator be broken? But its lights are on! Hmm. Is the problem with the egg, then?","nextNodeIds":[750940620]},{"nodeId":750940620,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":103920634,"text":"...Hmm, waiting around doesn't seem like it'll help... Should we just take the egg with us?","nextNodeIds":[750940621,750940624]},{"nodeId":750940621,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1157415810,"text":"No matter how hungry you get, don't even think about eating it, alright...","nextNodeIds":[750940622]},{"nodeId":750940622,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1564544794,"text":"Wraah! Wraah!","nextNodeIds":[750940623]},{"nodeId":750940623,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1298213802,"text":"#Come on, of course not! Also, don't give {REALNAME[ID(2)|SHOWHOST(true)]} any strange ideas!","nextNodeIds":[750940626]},{"nodeId":750940626,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1339494138,"text":"Well, little fella, Paimon means that... if the problem's with the egg, it might never...","nextNodeIds":[750940634]},{"nodeId":750940634,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2701303794,"text":"Rroo...","nextNodeIds":[750940635]},{"nodeId":750940635,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3034044170,"text":"#Don't be sad, {REALNAME[ID(2)|SHOWHOST(true)]}. There's nothing we can do about it...","nextNodeIds":[750940636,750940637]},{"nodeId":750940636,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1926185706,"text":"Perhaps the environment here isn't suitable...","nextNodeIds":[750940638]},{"nodeId":750940638,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1600595458,"text":"Y'know, you're right! Maybe the egg isn't hatching because it thinks Natlan hasn't changed and isn't suited to be its home!","nextNodeIds":[750940639]},{"nodeId":750940639,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3683571698,"text":"After all, it's been hiding inside here for so long, right? Of course it doesn't know what a wonderful place Natlan's become!","nextNodeIds":[750940640]},{"nodeId":750940640,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4256747362,"text":"So, let's take it back and take good care of it! We'll tell it stories about beautiful landscapes, thrilling adventures, and all the wonderful people we've met — every single day!","nextNodeIds":[750940641]},{"nodeId":750940641,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":958362610,"text":"In short, we'll let it know how great Natlan is now! Once it gets excited enough, it'll surely hatch on its own!","nextNodeIds":[750940642]},{"nodeId":750940642,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3113166922,"text":"...Brwarh.","nextNodeIds":[]},{"nodeId":750940637,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3537348394,"text":"Or perhaps... the egg doesn't believe that this is the right time...","nextNodeIds":[750940638]},{"nodeId":750940624,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2985239906,"text":"#What do you think, {REALNAME[ID(2)|SHOWHOST(true)]}?","nextNodeIds":[750940625]},{"nodeId":750940625,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":842411682,"text":"Err... Errh?","nextNodeIds":[750940626]},{"nodeId":750940627,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1060063890,"text":"No, it didn't.","nextNodeIds":[750940628]},{"nodeId":750940628,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3880066266,"text":"#Huh!? But... Just now... Was Paimon imagining things? No, it can't be. Did you see that, {REALNAME[ID(2)|SHOWHOST(true)]}?","nextNodeIds":[750940629]},{"nodeId":750940629,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2797453978,"text":"Err... Errh?","nextNodeIds":[750940630]},{"nodeId":750940630,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3977715050,"text":"#Ah... So you didn't see it either? Was it really just Paimon's imagination, then? So, what do we do, {NICKNAME}? Are we gonna just wait?","nextNodeIds":[750940631]},{"nodeId":750940631,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4091195546,"text":"Or... could the problem be with the egg? B—But, if that's the case, does that mean it'll never hatch?","nextNodeIds":[750940634]},{"nodeId":750940632,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1689875986,"text":"The egg itself might be the issue here.","nextNodeIds":[750940633]},{"nodeId":750940633,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2209692962,"text":"Huh? So, does... does this mean that it might never hatch?","nextNodeIds":[750940634]},{"nodeId":750940604,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":616529442,"text":"Hmph, is that all they've got?","nextNodeIds":[750940605]},{"nodeId":750940605,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1871360482,"text":"Exactly! You'd think they'd be super strong with how scary they looked! But really, our little fella hits harder than they do!","nextNodeIds":[750940606]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7509406,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133504640,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["3","133512012"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["133512012","12092"