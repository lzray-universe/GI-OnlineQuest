ram":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7050503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7050502,"initDialog":705050201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1009],"performCfg":"QuestDialogue/WQ/Mengde_70505/Q7050502","priority":5,"questId":70505,"showRandomTalkCount":0},"dialogs":[{"nodeId":705050201,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":412903690,"text":"Mmm. Not bad, not bad at all.","nextNodeIds":[705050202]},{"nodeId":705050202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3643160938,"text":"It's all about the ingredients! If the fruit are fresh and juicy, then the drink will naturally be sweet and tasty without adding anything extra.","nextNodeIds":[705050203]},{"nodeId":705050203,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":4073054474,"text":"Sounds like I should thank the soil of Mondstadt.","nextNodeIds":[705050204]},{"nodeId":705050204,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1306440842,"text":"It just so happens that Gray Valley Sunset is the first drink I ever mixed.","nextNodeIds":[705050205]},{"nodeId":705050205,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":58549954,"text":"I was still quite young. My father laid out several ingredients and told me to experiment with them.","nextNodeIds":[705050206]},{"nodeId":705050206,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":400835786,"text":"No requirements and no instruction. In hindsight, he probably just wanted to test my creativity.","nextNodeIds":[705050207]},{"nodeId":705050207,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1902735594,"text":"In the end, I just made a glass of fruit punch, much like this one.","nextNodeIds":[705050208]},{"nodeId":705050208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3484332922,"text":"Oh? But why fruit punch?","nextNodeIds":[705050209]},{"nodeId":705050209,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3639072034,"text":"My father was equally surprised. I didn't really put much thought into it, I just figured that it would taste sweet.","nextNodeIds":[705050210]},{"nodeId":705050210,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1550147066,"text":"Looking back on it, I was so young and naive.","nextNodeIds":[705050211]},{"nodeId":705050211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":852330618,"text":"I wouldn't be so sure.","nextNodeIds":[705050212]},{"nodeId":705050212,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3474401498,"text":"Oh?","nextNodeIds":[705050213,705050214]},{"nodeId":705050213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1998393210,"text":"I'm sure your father thought it was a good drink.","nextNodeIds":[705050215]},{"nodeId":705050215,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3422651098,"text":"I've never thought about it, I suppose... My father didn't say a word at the time.","nextNodeIds":[705050216]},{"nodeId":705050216,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1171772298,"text":"But, thank you.","nextNodeIds":[705050217]},{"nodeId":705050217,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3092058794,"text":"By the way, there's something I'd like to give you.","nextNodeIds":[705050218]},{"nodeId":705050218,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":99924234,"text":"But, I suppose it's better to wait until you have more experience with your bartender job. I have no doubt that you'll do very well.","nextNodeIds":[705050219]},{"nodeId":705050219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":568143994,"text":"And Paimon will... uh, be rooting for you! Hehe.","nextNodeIds":[705050220]},{"nodeId":705050220,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":761538954,"text":"Very well. Then, I look forward to seeing your good work. See you around.","nextNodeIds":[705050221]},{"nodeId":705050221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4221613026,"text":"Come back soon when you have a minute!","nextNodeIds":[]},{"nodeId":705050214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":626175810,"text":"He must have enjoyed it.","nextNodeIds":[705050215]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLM