{"mainQuestId":73651,"title":"The Cliffside Weirdo and a Risky Study?","description":"You hear that a strange person is wandering in the mountain to the east of Sumeru City...","titleTextMapHash":646461503,"descTextMapHash":2139817382,"mainQuestExcel":{"mainQuestId":73651,"titleTextMapHash":646461503,"title":"The Cliffside Weirdo and a Risky Study?","descTextMapHash":2139817382,"description":"You hear that a strange person is wandering in the mountain to the east of Sumeru City...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5087,"luaPath":"Actor/Quest/WQ73651","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5087,"chapterId":0,"descTextMapHash":2139817382,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73651,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3533660465,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73651","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173651],"series":5087,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":646461503,"type":"WQ","unlockDescTextMapHash":341048990}},"flow":[{"subQuestId":7365101,"order":1,"stepDescription":"Talk to the strange person on the cliff","stepDescTextMapHash":843307292,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7365101],"talks":[{"talkId":7365101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7365101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7365101,"initDialog":736510101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30226,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73651/Q7365101","priority":5,"questId":73651,"showRandomTalkCount":0},"dialogs":[{"nodeId":736510101,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1661367170,"text":"Hehehe... Hahaha...","nextNodeIds":[736510102]},{"nodeId":736510102,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2590954930,"text":"It is finally complete! The next step: demonstration! I will prove to all of them that this is the greatest of alchemical potions!","nextNodeIds":[736510103]},{"nodeId":736510103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1567277658,"text":"What is this person giggling by a cliff and talking to herself for...?","nextNodeIds":[736510104]},{"nodeId":736510104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4155589426,"text":"#Geez, she gives Paimon the creeps. {NICKNAME}, let's keep our distance, shall we?","nextNodeIds":[736510105,736510106]},{"nodeId":736510105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3393423202,"text":"What if she's at the end of her rope?","nextNodeIds":[736510107]},{"nodeId":736510107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4021435402,"text":"Hey, hey! You don't have to worry so much about random strangers, you know?","nextNodeIds":[736510108]},{"nodeId":736510108,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":702259874,"text":"Huh? When did you get here?","nextNodeIds":[736510109]},{"nodeId":736510109,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3299154834,"text":"Talking bad behind someone else's back is rude, you know!","nextNodeIds":[736510110]},{"nodeId":736510110,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2875442122,"text":"I, Hajanad, am Spantamad's Star of Tomorrow! Just you wait! When I become a famous researcher, I shall dedicate a trash-talk paper specially for you...","nextNodeIds":[736510111]},{"nodeId":736510111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2635525002,"text":"Wow, she's a real meanie! And her name sounds so difficult to say!","nextNodeIds":[736510112]},{"nodeId":736510112,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":359883730,"text":"Wait! Could this little fellow... be the \"White High-Intelligence Floating Assistive Unit\" from those rumors?","nextNodeIds":[736510113]},{"nodeId":736510113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":364409826,"text":"What kinds of rumors were those!? Paimon's never heard of that nickname!","nextNodeIds":[736510114]},{"nodeId":736510114,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1126531666,"text":"#Anyway, a {M#blond-haired}{F#blonde-haired} outlander with a \"White High-Intelligence Floating Assistive Unit\"... Today is my lucky day.","nextNodeIds":[736510115]},{"nodeId":736510115,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3820464730,"text":"Ahem! Listen, I can make fighters stronger, so let's make a deal, alright?","nextNodeIds":[736510116,736510117]},{"nodeId":736510116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2513329426,"text":"This sounds familiar...","nextNodeIds":[736510118]},{"nodeId":736510118,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1540767338,"text":"Of course. There are tons of alchemists around Teyvat just like me, and we strive to explore the full potential of alchemy.","nextNodeIds":[736510119]},{"nodeId":736510119,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":990331442,"text":"Supporting battles is one of the most essential services alchemy has to offer. If we can exercise the full potential of our potions, we can even rewrite the rules of battle.","nextNodeIds":[736510120]},{"nodeId":736510120,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4193430938,"text":"I believe you must have run into other alchemists studying potions during your travels.","nextNodeIds":[736510121]},{"nodeId":736510121,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":491904978,"text":"But compared to me, most of them are dabblers, with only a few of them having made any progress.","nextNodeIds":[736510122]},{"nodeId":736510122,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4217035114,"text":"I recall that a Mondstadt alchemist once published a research paper named \"Combat Environment Changes Made by the Spread of Aerolized Liquid Potions\"...","nextNodeIds":[736510123]},{"nodeId":736510123,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1873874130,"text":"Oh, the naivety! It doesn't matter if you add volatizing elements to the solution, your potion will still fail in spreading speed and density!","nextNodeIds":[736510124]},{"nodeId":736510124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":614891394,"text":"Whew, look at her go. Seems like somebody's trying to convince us that she's the best at what she does.","nextNodeIds":[736510125]},{"nodeId":736510125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1459306298,"text":"So about this deal of yours...","nextNodeIds":[736510126]},{"nodeId":736510126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":326018770,"text":"Yeah! So, Ms. Hajanad, you have the strongest potions around, do you? Are you gonna sell them to us at a discount?","nextNodeIds":[736510127]},{"nodeId":736510127,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2986184946,"text":"Good question! I was just about to show you my newest invention.","nextNodeIds":[736510128]},{"nodeId":736510128,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1235362970,"text":"I have compressed two types of highly concentrated potions into crystallized flakes and divided them into equal pieces. Then I placed them into a sealed and high-pressure environment using an alchemy device.","nextNodeIds":[736510129]},{"nodeId":736510129,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1594301994,"text":"When you need to use the potion, you just ignite the small explosives inside the device. This way, parts of the two flakes will be instantly vaporized and sufficiently mixed together.","nextNodeIds":[736510130]},{"nodeId":736510130,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1361317626,"text":"The pressure caused by the explosion will push the potion vapor out of the device and spread it evenly across a vast area, thus providing support in battle.","nextNodeIds":[736510131]},{"nodeId":736510131,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3339605266,"text":"I call this process the \"Remelting Effect,\" the device the \"Remelting Device,\" and the potion \"Remelting Tablets.\"","nextNodeIds":[736510132]},{"nodeId":736510132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3590320818,"text":"Remelting...?","nextNodeIds":[736510133]},{"nodeId":736510133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3867204938,"text":"An... explosion?","nextNodeIds":[736510134]},{"nodeId":736510134,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2161617722,"text":"The air will be filled with a refreshing fragrance after the powerful explosion, and the one inhaling it will experience a drastic increase in power.","nextNodeIds":[736510135]},{"nodeId":736510135,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":4038210962,"text":"What do you think? Very tempting, right? Don't you want to try it? Now, all you need to do is watch out for the effects of the potion during battle and help me record any minor performance issues that crop up.","nextNodeIds":[736510136]},{"nodeId":736510136,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":269055722,"text":"Of course, I won't take your help for granted. You will be well paid for your trouble.","nextNodeIds":[736510137]},{"nodeId":736510137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":38161162,"text":"So you just see us as test subjects, huh? Also, this sounds super dangerous! We're definitely out!","nextNodeIds":[736510138]},{"nodeId":736510138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3887611330,"text":"We'll consider the offer if you promise 100,000% compensation if something goes wrong...","nextNodeIds":[736510139]},{"nodeId":736510139,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2025911954,"text":"Not a problem. I have done the necessary experiments many times, so I can guarantee that it is safe!","nextNodeIds":[736510140]},{"nodeId":736510140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2801107642,"text":"No hesitation at all!?","nextNodeIds":[736510141,736510142]},{"nodeId":736510141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4244737586,"text":"It's not as if we're lacking Mora or anything.","nextNodeIds":[736510143]},{"nodeId":736510143,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":608655338,"text":"Hmm... That's true. For someone who has had such fantastic tales published about them, you must be beyond wealthy...","nextNodeIds":[736510144]},{"nodeId":736510144,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2861770578,"text":"Well, then... pretty please...?","nextNodeIds":[736510145]},{"nodeId":736510145,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3671849770,"text":"I sincerely apologize for treating you badly earlier, and for trying to buy you over with Mora!","nextNodeIds":[736510146]},{"nodeId":736510146,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3345070578,"text":"I will owe you the world if you can help me complete my experiments! When I become a famous researcher, I will never forget what you've done for me!","nextNodeIds":[736510147]},{"nodeId":736510147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1419407138,"text":"Eh... This drastic attitude change and that promise...","nextNodeIds":[736510148]},{"nodeId":736510148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4149972938,"text":"That's opportunism for you...","nextNodeIds":[736510149]},{"nodeId":736510149,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":2832718730,"text":"Come to think of it, I'm the one who's seeking for your help, so I should've been more proper when asking you for help.","nextNodeIds":[736510150]},{"nodeId":736510150,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3747274250,"text":"I know that this doesn't look good on my side, but you will only meet more people who are just like me in the future.","nextNodeIds":[736510151]},{"nodeId":736510151,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3489790802,"text":"If nothing else, I gave you my word and promised you Mora. Others might treat you as free labor. All things considered, our encounter was a rather realistic one, eh?","nextNodeIds":[736510152]},{"nodeId":736510152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1631997050,"text":"Hmm... Isn't it kinda rude to assume people would just take advantage of us? Still, she does have a point...","nextNodeIds":[736510153]},{"nodeId":736510153,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2290798642,"text":"Wavering, are we, Paimon?","nextNodeIds":[736510154]},{"nodeId":736510154,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2213605130,"text":"Come on! She begged us and everything! Also, Paimon's kinda curious as to how powerful her potions might be.","nextNodeIds":[736510155]},{"nodeId":736510155,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4215789306,"text":"Plus, Paimon doesn't think she has bad intentions. Maybe it's just her eagerness toward her studies that made her a bit weird.","nextNodeIds":[736510156]},{"nodeId":736510156,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1899156682,"text":"Maybe she'll be a bit nicer once her research is complete.","nextNodeIds":[736510157]},{"nodeId":736510157,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":1560456186,"text":"Oh? Are you discussing how to test the device?","nextNodeIds":[736510158]},{"nodeId":736510158,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3555238514,"text":"There's a domain nearby, actually. According to feedback from other adventurers, it's suitable for the combat tests we wish to conduct.","nextNodeIds":[736510159]},{"nodeId":736510159,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2816302266,"text":"I haven't said yes yet, you know...","nextNodeIds":[736510160]},{"nodeId":736510160,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":3920677426,"text":"I've entrusted my fate to you two, so please, help me!","nextNodeIds":[736510161]},{"nodeId":736510161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2099518586,"text":"Well... This one can't be harder than a regular adventure commission, so let's just go and test this device out in that domain, shall we?","nextNodeIds":[736510162]},{"nodeId":736510162,"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","textMapHash":502124746,"text":"Alright, it's a deal then! I will wait for good news from you here.","nextNodeIds":[]},{"nodeId":736510142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1211219682,"text":"I don't need alchemy to be stronger.","nextNodeIds":[736510143]},{"nodeId":736510117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":233799714,"text":"I think I've heard this one before...","nextNodeIds":[736510118]},{"nodeId":736510106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2731809474,"text":"We probably need to stop her from acting impulsively...","nextNodeIds":[736510107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7365101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30226"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7365101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30226,"speakerName":"Hajanad","count":34},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":11}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173651],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2139817382,"CHECNJEMEFE":{"30226":[1120]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73651/Q7365101","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":736510101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7365101,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30226,1005],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[{"_param":["7365101","2"],"_type":"QUEST_COND_STATE_EQUAL"}],"NIJAPEJKLDI":false,"NMKNFLIHHHE":false,"NMMOKMEKDJO":false,"NPGONNBAOOI":3647722552027370989,"OAIIIMFGNGM":false,"OAOCMNEPKOG":73651,"ODEOIJMOMPL":[],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST","PCCKKGAHFFJ":false,"PNACKFKJJHM":[]}],"IBNCKLKHAKG":0,"IEGCPJALJOA":0,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","ILHDNJDDEOP":73651,"ILICEMABDDI":[],"JAPLGJLDPHJ":[],"JDCIPCDDDPK":0,"JDEFCNEDMLL":5087,"KCONOGOIGIH":0,"LEFIHLHODBM":[],"LMCFKPMJGEO":false,"MEJIMPLKPHN":0,"MHHFFHCLDKI":false,"MMOEEOFGHHG":646461503,"NJGLJLODPBN":true,"NKAKCKAJCLD":5087,"NOCNCPAGOPC":"Actor/Quest/WQ73651","OPIDGNOCOHD":"QUEST_SHOW","PAINLIBBLDK":"