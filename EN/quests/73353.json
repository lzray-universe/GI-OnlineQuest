DE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30651"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7335301],"talks":[{"talkId":7335301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7335301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7335301,"initDialog":733530101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30651],"performCfg":"QuestDialogue/WQ/SumeruBirth_73353/Q7335301","priority":5,"questId":73353,"showRandomTalkCount":0},"dialogs":[{"nodeId":733530101,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":626015082,"text":"#Excuse me. Are you {NICKNAME}, by any chance?","nextNodeIds":[733530102,733530103]},{"nodeId":733530102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4059125602,"text":"That's me.","nextNodeIds":[733530104]},{"nodeId":733530104,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":1262783978,"text":"Ah, good! Good thing I didn't get the wrong person.","nextNodeIds":[733530105]},{"nodeId":733530105,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":3058522250,"text":"Allow me to introduce myself. I'm Dharmakirti, a Dastur from Amurta.","nextNodeIds":[733530106]},{"nodeId":733530106,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":4041164146,"text":"We've heard of you, of course, but in truth, we don't know much about you.","nextNodeIds":[733530107]},{"nodeId":733530107,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":3968966786,"text":"But we've been doing research on dreamscapes lately, and the Dendro Archon informed us that you were the most cool-headed person she's ever seen when distinguishing dreams from reality.","nextNodeIds":[733530108]},{"nodeId":733530108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3179093338,"text":"Ah, she flatters me...","nextNodeIds":[733530109]},{"nodeId":733530109,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":1696298018,"text":"Nay, don't be so modest. Anyway, that's precisely what our project is about, and our data indicates that people struggle to consciously wake up after falling asleep.","nextNodeIds":[733530110]},{"nodeId":733530110,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":440988386,"text":"We intend to utilize the psychological influence that dreams have on people to help regulate various psychological disorders.","nextNodeIds":[733530111]},{"nodeId":733530111,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":3512625042,"text":"Specifically, we will use targeted environmental hints and guidance based on each patient's individual situation to create a suitable dreamscape for them.","nextNodeIds":[733530112]},{"nodeId":733530112,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":2611817186,"text":"The technology to enter shared dreamscapes is still rather new, and advancements are mainly thanks to the many improvements made by the Dendro Archon. Simply put, our goal is to address patients' psychological problems by adjusting their cognitive states within dreamscapes.","nextNodeIds":[733530113]},{"nodeId":733530113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3980165290,"text":"That seems... complicated.","nextNodeIds":[733530114]},{"nodeId":733530114,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":2780657778,"text":"Ah, right. Sorry. Couldn't help rambling on about our project a bit. It is quite complicated, yes...","nextNodeIds":[733530115]},{"nodeId":733530115,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":13038002,"text":"Simply put, we're conducting medical research on the psychological effects of dreams, but we've gotten a bit stuck when it comes to practical implementation...","nextNodeIds":[733530116,733530117]},{"nodeId":733530116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":377241466,"text":"And so you need my help?","nextNodeIds":[733530118]},{"nodeId":733530118,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":3171793202,"text":"Got it in one go. Heh, this is embarrassing.","nextNodeIds":[733530119]},{"nodeId":733530119,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":1394977290,"text":"None of our project members have any experience maintaining awareness within a dreamscape, so that left us all feeling really depressed. But now that we know people like you exist, hope has been rekindled!","nextNodeIds":[733530120]},{"nodeId":733530120,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":1006164290,"text":"We also have our Archon to thank for this. Had she not heard our report and suggested we discuss things with you, I'm afraid our project would've had to be abandoned, never to be completed.","nextNodeIds":[733530121]},{"nodeId":733530121,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":1898496402,"text":"I have faith that if this psychotherapy is popularized... then we'll be able to significantly reduce the rate of mental disorders in the Akademiya's annual statistics.","nextNodeIds":[733530122]},{"nodeId":733530122,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":271747498,"text":"So, from what you said just before, I can assume you're willing to help?","nextNodeIds":[733530123]},{"nodeId":733530123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2936089250,"text":"Sure thing.","nextNodeIds":[733530124]},{"nodeId":733530124,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":2667413922,"text":"Great! I'll organize the patient files right away. Come find me whenever you're free.","nextNodeIds":[733530125]},{"nodeId":733530125,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":58624466,"text":"The experimental process works like this. You just need to relax and enter the dreamscape together with the patient. That's half the battle.","nextNodeIds":[733530126]},{"nodeId":733530126,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":764492954,"text":"Next, when you're inside the dreamscape, you just need to follow the instructions given in the file to find the anomalous aspects related to the patient in question. Correct them, leave the dream, and that's that.","nextNodeIds":[733530127]},{"nodeId":733530127,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":2603946002,"text":"We've also prepared emergency measures to get you out of the dreamscape if needed. The safety of our volunteers and patients is far more important than the success of any experiment.","nextNodeIds":[733530128]},{"nodeId":733530128,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":4235241954,"text":"Every patient has unique circumstances and must be handled carefully. Well then, come find me whenever you're free.","nextNodeIds":[733530129]},{"nodeId":733530129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1672966826,"text":"Understood.","nextNodeIds":[733530130]},{"nodeId":733530130,"roleType":"TALK_ROLE_NPC","speakerId":30651,"speakerName":"Dharmakirti","textMapHash":2956111250,"text":"Thanks for your generosity. See you later!","nextNodeIds":[]},{"nodeId":733530117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4130999610,"text":"How are we calculating my payment?","nextNodeIds":[733530118]},{"nodeId":733530103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2408481858,"text":"What can I do for you?","nextNodeIds":[733530104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_