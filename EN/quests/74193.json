e,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7419305","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7419305,"initDialog":741930501,"nextRandomTalks":[],"nextTalks":[],"npcId":[5325,1005],"performCfg":"QuestDialogue/WQ/Fontaine_74193/Q7419305","priority":5,"questId":74193,"showRandomTalkCount":0},"dialogs":[{"nodeId":741930501,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":2296312650,"text":"Boxes... Treasures... Melusine...","nextNodeIds":[741930502]},{"nodeId":741930502,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":184159642,"text":"Um, Pahsiv, did we run you all outta stuff?","nextNodeIds":[741930503]},{"nodeId":741930503,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":332924882,"text":"Pahsiv... go out! Pahsiv... find!","nextNodeIds":[741930504]},{"nodeId":741930504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":562827402,"text":"It's fine if you don't have anything with you.","nextNodeIds":[741930505]},{"nodeId":741930505,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1250475578,"text":"That's right. We can just give you Tidalga anyway!","nextNodeIds":[741930506]},{"nodeId":741930506,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3448684194,"text":"Melusine!","nextNodeIds":[741930507]},{"nodeId":741930507,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1779782722,"text":"#Paimon, friend... earnest! {NICKNAME}, friend... earnest! So... swap!","nextNodeIds":[741930508]},{"nodeId":741930508,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2218232034,"text":"Um, well, alright then. How long will you be out, Pahsiv? Are we gonna see you around?","nextNodeIds":[741930509]},{"nodeId":741930509,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1078077642,"text":"See... around?","nextNodeIds":[741930510]},{"nodeId":741930510,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1680319610,"text":"Well, that's how we express the desire to meet again!","nextNodeIds":[741930511]},{"nodeId":741930511,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3045193066,"text":"\"See you around\" is how we say goodbye.","nextNodeIds":[741930512]},{"nodeId":741930512,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3017170682,"text":"That's right. We did say previously that we'll teach you how to say goodbye, didn't we? Well, why don't you try saying it?","nextNodeIds":[741930513]},{"nodeId":741930513,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1565915850,"text":"Good... bye?","nextNodeIds":[741930514]},{"nodeId":741930514,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2105608898,"text":"Uh, do you not know what that means?","nextNodeIds":[741930515]},{"nodeId":741930515,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2086291386,"text":"Hmm... Well, you can consider it a sort of exchange or swap, too. Kinda like swapping one tomorrow for another...","nextNodeIds":[741930516]},{"nodeId":741930516,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3467950178,"text":"You take a bit of your tomorrow and give it to us, and we'll give a bit of ours to you — and that's how we'll meet again! What do you think? Get it now?","nextNodeIds":[741930517]},{"nodeId":741930517,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1446651250,"text":"Swap tomorrow... for tomorrow! Pahsiv!","nextNodeIds":[741930518]},{"nodeId":741930518,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2793842738,"text":"Hehe, looks like you get it! In that case, let's say \"see you around\" for now — that way, we'll definitely meet again!","nextNodeIds":[741930519]},{"nodeId":741930519,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":675863618,"text":"See you around! Pahsiv!","nextNodeIds":[741930520]},{"nodeId":741930520,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3305335194,"text":"See ya!","nextNodeIds":[741930521]},{"nodeId":741930521,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1723928450,"text":"#See you, {NICKNAME}! See you, Paimon!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7419305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7419301","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE",