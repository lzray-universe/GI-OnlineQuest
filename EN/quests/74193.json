extNodeIds":[741930102]},{"nodeId":741930102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2521994002,"text":"Wow, it's you, Pahsiv! Nice to see you again! What are you doing around here?","nextNodeIds":[741930103]},{"nodeId":741930103,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":2490945426,"text":"Pahsiv... working! Pahsiv... tired! Pahsiv... lie down!","nextNodeIds":[741930104]},{"nodeId":741930104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1841834810,"text":"Huh? You're... working?","nextNodeIds":[741930105]},{"nodeId":741930105,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":2712645786,"text":"Foggy Forest Branch... Foggy Forest Branch... very throw!","nextNodeIds":[741930106]},{"nodeId":741930106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":68790146,"text":"Huh? What's a Foggy Forest Branch?","nextNodeIds":[741930107]},{"nodeId":741930107,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":2559699298,"text":"Foggy Forest Branch... Information!","nextNodeIds":[741930108]},{"nodeId":741930108,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":2364264490,"text":"Willow, collect. Fog, handle. Spring, send.","nextNodeIds":[741930109]},{"nodeId":741930109,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":4230820770,"text":"Foggy Forest Branch... Mist information!","nextNodeIds":[741930110]},{"nodeId":741930110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":560880186,"text":"So you mean it's information about the Foggy Forest Path?","nextNodeIds":[741930111]},{"nodeId":741930111,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1433337666,"text":"Pahsiv!","nextNodeIds":[741930112]},{"nodeId":741930112,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3372305426,"text":"Foggy Forest Branch... very throw! Very many places!","nextNodeIds":[741930113]},{"nodeId":741930113,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":2217303506,"text":"Pahsiv... searching! Pahsiv... tired! Pahsiv... eat! Pahsiv... lie down!","nextNodeIds":[741930114]},{"nodeId":741930114,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":999893410,"text":"Foggy Forest Branch... Very not many! But boxes, very many!","nextNodeIds":[741930115]},{"nodeId":741930115,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3157830370,"text":"#Ah... Thank you Paimon, thank you {NICKNAME}, here!","nextNodeIds":[741930116]},{"nodeId":741930116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2900969122,"text":"You found us a treasure chest again?","nextNodeIds":[741930117]},{"nodeId":741930117,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":140424738,"text":"Pahsiv! Box, treasure, flower, shiny, sweet, very many!","nextNodeIds":[741930118]},{"nodeId":741930118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3864167178,"text":"Whoa, so there's other stuff, too? Y'know, Pahsiv, you're real nice, but it'd be bad if we kept taking your stuff for free. Why don't we exchange things instead?","nextNodeIds":[741930119]},{"nodeId":741930119,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3209727010,"text":"Ex... change?","nextNodeIds":[741930120]},{"nodeId":741930120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3577637922,"text":"That's right! We're friends, and friends should exchange gifts in earnest with one another!","nextNodeIds":[741930121]},{"nodeId":741930121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3835937602,"text":"So, we're gonna help you find your Foggy Forest Branches, and exchange those for your stuff. Whaddya say?","nextNodeIds":[741930122]},{"nodeId":741930122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2463375266,"text":"And we can get you some stuff to eat, too.","nextNodeIds":[741930123]},{"nodeId":741930123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4169967930,"text":"Right, we can do that! You're having a hard time by yourself, after all.","nextNodeIds":[741930124]},{"nodeId":741930124,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":324429610,"text":"Eat! Tidalga! Pahsiv!","nextNodeIds":[741930125]},{"nodeId":741930125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1369130650,"text":"You like Tidalga?","nextNodeIds":[741930126]},{"nodeId":741930126,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1811814426,"text":"Tidalga! Tidalga! Tidalga Tidalga Tidalga!","nextNodeIds":[741930127]},{"nodeId":741930127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1090652642,"text":"Uh, does that mean you eat five meals, or five Tidalga a day? Uh... Wow, you might have Paimon beat for appetite!","nextNodeIds":[741930128]},{"nodeId":741930128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3376107866,"text":"Well, what about the Branches, then? Can we find 'em by following the Foggy Forest Path?","nextNodeIds":[741930129]},{"nodeId":741930129,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3827402066,"text":"Melusine...","nextNodeIds":[741930130]},{"nodeId":741930130,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1263353994,"text":"Foggy Forest Branch... very throw! Very many places! Very Erinnyes!","nextNodeIds":[741930131]},{"nodeId":741930131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1622657626,"text":"The Branches are all over Erinnyes, then?","nextNodeIds":[741930132]},{"nodeId":741930132,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3877287450,"text":"#Smart {NICKNAME}! Pahsiv!","nextNodeIds":[741930133]},{"nodeId":741930133,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":1451205210,"text":"Foggy Path has flowers. Branches, also flowers!","nextNodeIds":[741930134]},{"nodeId":741930134,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":558359146,"text":"Branch, branch, branch, branch, branch, branch... Number!","nextNodeIds":[741930135]},{"nodeId":741930135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3506621170,"text":"Huh. Ooh, Paimon gets it now. The Branches can be found in places with the same flowers as the Foggy Forest Path, and there are six locations, right?","nextNodeIds":[741930136]},{"nodeId":741930136,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3069235530,"text":"Smart Paimon! Pahsiv!","nextNodeIds":[741930137]},{"nodeId":741930137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":73322010,"text":"Hehe, guess we're all clear now, eh? Make sure you rest up, Pahsiv. Just leave this to us!","nextNodeIds":[741930138]},{"nodeId":741930138,"roleType":"TALK_ROLE_NPC","speakerId":5325,"speakerName":"Pahsiv","textMapHash":3955796634,"text":"#Paimon, {NICKNAME}, good thing! So, slowly, slowly! Pahsiv!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7419301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":