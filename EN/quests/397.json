{"mainQuestId":397,"title":"Abyss Mage","description":"You used the Holy Lyre der Himmel to summon Stormterror, only to be prevented from saving it due to the interference of the Abyss Order. But you haven't given up yet — and Diluc has been able to swiftly obtain a new lead...","titleTextMapHash":2779564865,"descTextMapHash":3837585879,"mainQuestExcel":{"mainQuestId":397,"titleTextMapHash":2779564865,"title":"Abyss Mage","descTextMapHash":3837585879,"description":"You used the Holy Lyre der Himmel to summon Stormterror, only to be prevented from saving it due to the interference of the Abyss Order. But you haven't given up yet — and Diluc has been able to swiftly obtain a new lead...","chapterId":1003,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/MQ397","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":1003,"descTextMapHash":3837585879,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":397,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3816663511,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/MQ397","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":1003,"rewardIdList":[100397],"series":1003,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[388],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2779564865,"type":"AQ","unlockDescTextMapHash":3151077963}},"flow":[{"subQuestId":39701,"order":1,"stepDescription":"Meet Diluc at the Winery","stepDescTextMapHash":619580703,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1123,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q39702Diluc"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1123,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q39702Diluc"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":39702,"order":2,"stepDescription":"Talk to Diluc","stepDescTextMapHash":3821761479,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[39702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1009"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[39702],"talks":[{"talkId":39702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["39702","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":39702,"initDialog":3970201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1009],"performCfg":"QuestDialogue/AQ/Mengde3_397/Q39702","priority":1,"questId":397,"showRandomTalkCount":0},"dialogs":[{"nodeId":3970201,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3667357795,"text":"The Abyss Order... Enemies of the human race. Even the underground networks rarely come across any information on them.","nextNodeIds":[3970202]},{"nodeId":3970202,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":4201434507,"text":"With that said, it was a bit of a hassle, but I managed to dig up a few clues.","nextNodeIds":[3970203]},{"nodeId":3970203,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":271567411,"text":"Really? That quickly? You really are well connected, Master Diluc.","nextNodeIds":[3970204]},{"nodeId":3970204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":804657483,"text":"Come to think of it, Mr. Big Anemo God Barbatos — why exactly do you need the help of mere humans...?","nextNodeIds":[3970205]},{"nodeId":3970205,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2206013819,"text":"Ahh... How do I put it...","nextNodeIds":[3970206]},{"nodeId":3970206,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1485891499,"text":"\"The Seven\" as people now know them, were once known as \"The Seven Archons.\"","nextNodeIds":[3970207]},{"nodeId":3970207,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4200020235,"text":"Each archon presides over their own part of Teyvat. That is the role the archons play.","nextNodeIds":[3970208]},{"nodeId":3970208,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3164646851,"text":"Only in performing this duty can we attain power, but I don't like the idea of \"ruling\" Mondstadt — and I don't feel Mondstadt would really like it either.","nextNodeIds":[3970209]},{"nodeId":3970209,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3863663699,"text":"\"Go forth and establish a city of freedom without rule.\" We have not forgotten Barbatos' wish for Mondstadt.","nextNodeIds":[3970210]},{"nodeId":3970210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":998869683,"text":"Jean... You're such a devotee!","nextNodeIds":[3970211]},{"nodeId":3970211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4215722555,"text":"Maybe someone got a little too free and is just too lazy to care...","nextNodeIds":[3970212]},{"nodeId":3970212,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1000543643,"text":"Ahh... However it may have come to be... I haven't been back to Mondstadt for an extended period of time.","nextNodeIds":[3970213]},{"nodeId":3970213,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2853598107,"text":"Without a doubt, I am now the weakest archon among The Seven!","nextNodeIds":[3970214,3970215]},{"nodeId":3970214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1181123059,"text":"And yet you sound almost proud...","nextNodeIds":[3970216]},{"nodeId":3970216,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1846443595,"text":"Aww, you flatter me.","nextNodeIds":[3970217]},{"nodeId":3970217,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3441777291,"text":"Oh, such a humble god... Is it a blessing, or a curse?","nextNodeIds":[3970218]},{"nodeId":3970218,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2620893619,"text":"But we digress. Let's get back to the topic at hand: the common enemy of all mankind.","nextNodeIds":[3970219]},{"nodeId":3970219,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2611333811,"text":"We have tracked the <color=#00E1FFFF>Abyss Mage</color> to the vicinity of the <color=#00E1FFFF>winery</color>.","nextNodeIds":[3970220]},{"nodeId":3970220,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2652369099,"text":"I cannot stress enough how important it is to not let it escape.","nextNodeIds":[3970221]},{"nodeId":3970221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1461038899,"text":"Let's hunt it down!","nextNodeIds":[]},{"nodeId":3970215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":807661971,"text":"Guess that's why you're god to the City of Freedom...","nextNodeIds":[3970216]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[39702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMA