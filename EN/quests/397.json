_NONE","LNHLPKELCAL":["Q38406Player","60"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[133002233,0],"PAINLIBBLDK":"QUEST_CONTENT_CLEAR_GROUP_MONSTER","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_TEAM_DEAD","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[39703,0],"PAINLIBBLDK":"QUEST_CONTENT_NOT_FINISH_PLOT","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q38406Player","60"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":39704,"order":5,"stepDescription":"Talk to Venti","stepDescTextMapHash":1144244215,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[39704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[39704],"talks":[{"talkId":39704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["39704","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":39704,"initDialog":3970401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/AQ/Mengde3_397/Q39704","priority":1,"questId":397,"showRandomTalkCount":0},"dialogs":[{"nodeId":3970401,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2685633203,"text":"Huh? What's this...","nextNodeIds":[3970402]},{"nodeId":3970402,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3677085227,"text":"After the Abyss Mage was defeated, a certain energy dispersed from its body...","nextNodeIds":[3970403]},{"nodeId":3970403,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1985561283,"text":"It seems that energy was being used to cut off the connection between me and Dvalin.","nextNodeIds":[3970404]},{"nodeId":3970404,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1920632523,"text":"...","nextNodeIds":[3970405]},{"nodeId":3970405,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":132390699,"text":"#{NICKNAME}, do you know of <color=#00E1FFFF>Stormterror's Lair</color>?","nextNodeIds":[3970406,3970408]},{"nodeId":3970406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3240272587,"text":"Nope.","nextNodeIds":[3970407]},{"nodeId":3970407,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3726999211,"text":"But Jean and Master Diluc are no doubt aware of it.","nextNodeIds":[3970410]},{"nodeId":3970410,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3144063691,"text":"After Dvalin woke up, he took the ancient ruins as his lair.","nextNodeIds":[3970411]},{"nodeId":3970411,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1951558179,"text":"As it was with the storms that previously cut Mondstadt off from the outside world, the entrance to the ruins is also sealed by a special barrier.","nextNodeIds":[3970412]},{"nodeId":3970412,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":793797379,"text":"But now, as the energy dispersed from the Abyss Mage, I was able to read the rhythmic flow of how the barrier's magic was woven.","nextNodeIds":[3970413]},{"nodeId":3970413,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2130786219,"text":"I must admit, it sounds even more horrendous than a chorus of hilichurls, but...","nextNodeIds":[3970414]},{"nodeId":3970414,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4061847283,"text":"...It should be enough to let us break through the storm barrier and reach <color=#00E1FFFF>Stormterror's Lair</color>.","nextNodeIds":[3970415]},{"nodeId":3970415,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":3863795067,"text":"Which means we're going to confront Dvalin?","nextNodeIds":[3970416]},{"nodeId":3970416,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1306669827,"text":"I'm fine with that... Jean is the one who wishes to avoid any direct confrontation.","nextNodeIds":[3970417]},{"nodeId":3970417,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1427057571,"text":"No. When there are no other options left, it is my responsibility to alter our course of action.","nextNodeIds":[3970418]},{"nodeId":3970418,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3239640091,"text":"If slaying him is our only choice, I will gladly become the knight that leads the charge.","nextNodeIds":[3970419]},{"nodeId":3970419,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1426550795,"text":"Fortunately, we have yet to need to go that far.","nextNodeIds":[3970420]},{"nodeId":3970420,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":1384174939,"text":"Hmm?","nextNodeIds":[3970421]},{"nodeId":3970421,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":39579507,"text":"By that, you mean...","nextNodeIds":[3970422]},{"nodeId":3970422,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2402143291,"text":"I mean that the Holy Lyre is not our trump card.","nextNodeIds":[3970423]},{"nodeId":3970423,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2154448643,"text":"#Our real trump card? {NICKNAME} of course.","nextNodeIds":[3970424]},{"nodeId":3970424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":648751987,"text":"#{NICKNAME}?","nextNodeIds":[3970425,3970427]},{"nodeId":3970425,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3439743891,"text":"Is it because I purified the Teardrop Crystal?","nextNodeIds":[3970426]},{"nodeId":3970426,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":342617403,"text":"Agreed.","nextNodeIds":[3970430]},{"nodeId":3970430,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2844158859,"text":"The impurities in the tears, and the curse that binds Dvalin belong to the same maleficent power.","nextNodeIds":[3970431]},{"nodeId":3970431,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2392095267,"text":"Which means...","nextNodeIds":[3970432]},{"nodeId":3970432,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":965373147,"text":"You Tone-Deaf Bard, don't you see how crazy this is?","nextNodeIds":[3970433]},{"nodeId":3970433,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1893512107,"text":"#You've seen what Dvalin is like when he's ticked off! {NICKNAME} will be swallowed whole before {M#he}{F#she} even gets to lift a finger!","nextNodeIds":[3970434,3970435]},{"nodeId":3970434,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1421242051,"text":"Weren't we just talking about how I can fight?","nextNodeIds":[3970436]},{"nodeId":3970436,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2251473987,"text":"...Hey.","nextNodeIds":[3970437]},{"nodeId":3970437,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":937375299,"text":"Nice plan. Worth a shot.","nextNodeIds":[3970438]},{"nodeId":3970438,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2348207555,"text":"I am with you, Honorary Knight!","nextNodeIds":[3970439]},{"nodeId":3970439,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3469500283,"text":"Ho~! So we just need to fight monsters from the abyss... and a dragon! No pressure or anything.","nextNodeIds":[3970440]},{"nodeId":3970440,"roleType":"TALK_ROLE_NPC","speakerId":1009,"speakerName":"Diluc","textMapHash":2636131299,"text":"Humans aren't without their strengths. Let's go.","nextNodeIds":[3970441]},{"nodeId":3970441,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3337865563,"text":"And so...","nextNodeIds":[3970442]},{"nodeId":3970442,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2823519811,"text":"The epic actions of brave heroes finally leads to this eleventh hour.","nextNodeIds":[]},{"nodeId":3970435,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3981637555,"text":"This battle... it's going to take everything everyone's got.","nextNodeIds":[3970436]},{"nodeId":3970427,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3228172315,"text":"Is it because I can fight?","nextNodeIds":[3970428]},{"nodeId":3970428,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2193713683,"text":"Well, you could say that... You're definitely a force to be reckoned with.","nextNodeIds":[3970429]},{"nodeId":3970429,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2565464051,"text":"But you have a much more precious forte.","nextNodeIds":[3970430]},{"nodeId":3970408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":315592763,"text":"I think I've heard people talking about it in Mondstadt.","nextNodeIds":[3970409]},{"nodeId":3970409,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":519203971,"text":"Of course. I believe the people of Mondstadt all know of it.","nextNodeIds":[3970410]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[39704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133002233,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE