{"mainQuestId":72143,"title":"","description":"","titleTextMapHash":2782180791,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":72143,"titleTextMapHash":2782180791,"title":"","descTextMapHash":144510430,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_RANK_ZERO_WQ","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ72143","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":144510430,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72143,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2745509265,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72143","mainQuestTag":"MAINQUEST_TAG_RANK_ZERO_WQ","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":true,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[72145,72146,72147,72148],"suggestTrackOutOfOrder":true,"taskID":0,"titleTextMapHash":2782180791,"type":"WQ","unlockDescTextMapHash":3586703726}},"flow":[{"subQuestId":7214301,"order":1,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7214301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7214301,7214302],"talks":[{"talkId":7214301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_BILLBOARD_ONLY","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7214301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7214301,"initDialog":721430101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3193],"performCfg":"QuestDialogue/WQ/Daoqi_72143/Q7214301","priority":5,"questId":72143,"showRandomTalkCount":0},"dialogs":[{"nodeId":721430101,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3353021346,"text":"Hello, guests from afar. My name is Tsuyuko, and I am a shrine maiden at the Sangonomiya Shrine. Are you here to help?","nextNodeIds":[721430102]},{"nodeId":721430102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":433961730,"text":"Help...?","nextNodeIds":[721430103]},{"nodeId":721430103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":698545010,"text":"We've only just met! What does she mean, \"help\"?","nextNodeIds":[721430104]},{"nodeId":721430104,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3182291034,"text":"Haha, sorry for being rude...","nextNodeIds":[721430105]},{"nodeId":721430105,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2742853290,"text":"It's just that I made a wish previously, and according to the divination result, there will always be help on the way whenever I am troubled or having a hard time.","nextNodeIds":[721430106]},{"nodeId":721430106,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3814946218,"text":"So you, O helpful guests, must be here to assist me, right?","nextNodeIds":[721430107,721430109]},{"nodeId":721430107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3507852122,"text":"That's just an excuse, isn't it?","nextNodeIds":[721430108]},{"nodeId":721430108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1086983426,"text":"Well, whatever, let's just hear what she has to say first...","nextNodeIds":[721430111]},{"nodeId":721430111,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":976273706,"text":"Thank you so much, then. Let me give you the backstory.","nextNodeIds":[721430112]},{"nodeId":721430112,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2525773658,"text":"The deep pool directly across from the Sangonomiya Shrine is the entrance to Enkanomiya. Legend has it that this place was the origin of the Watatsumi people.","nextNodeIds":[721430113]},{"nodeId":721430113,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3750185498,"text":"In days of old, the beauties of Watatsumi were renowned for their soft skin, which would conceal seven types of skin blemish...","nextNodeIds":[721430114]},{"nodeId":721430114,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3507719970,"text":"...This, of course, being mostly a consequence of our ancestors' lack of sunlight in the depths of Enkanomiya...","nextNodeIds":[721430115,721430116]},{"nodeId":721430115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1592037554,"text":"*coughs*","nextNodeIds":[721430117]},{"nodeId":721430117,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1113694146,"text":"Oh, sorry. In the past, I would usually give guided tours to people coming to Watatsumi Island, so I just...","nextNodeIds":[721430118]},{"nodeId":721430118,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1817123722,"text":"Well. In order to commemorate Watatsumi Omikami and our ancestors, we traditionally bring tributes that we let sink down towards Enkanomiya.","nextNodeIds":[721430119]},{"nodeId":721430119,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1311736554,"text":"It has been said, and it is recorded in our ancient writings, that our ancestors from Byakuyakoku relied on the meager light of the Dainichi Mikoshi in order to survive the sharpened claws of the Dragonheir of the Depths.","nextNodeIds":[721430120]},{"nodeId":721430120,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2554074346,"text":"That was up until a few thousand years ago, when the Watatsumi Omikami came and defeated the Dragonheir of the Depths and led us back to dry land. That was where we would build our new home on Watatsumi Island — Sangonomiya.","nextNodeIds":[721430121]},{"nodeId":721430121,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1913046370,"text":"And the underwater nation of Byakuyakoku was henceforth named Enkanomiya, in juxtaposition to our new homeland Sangonomiya, which stood high above the ocean surface.","nextNodeIds":[721430122]},{"nodeId":721430122,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1750315010,"text":"Of course, legends are just legends. For example, the Shogun's Army rallies itself around the god-subduing legends from Narukami.","nextNodeIds":[721430123]},{"nodeId":721430123,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1836898610,"text":"The theme of sacrifice and remembrance serves a similar purpose for us. It is a weapon we arm ourselves with as we battle to protect what is ours.","nextNodeIds":[721430124]},{"nodeId":721430124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2539035290,"text":"Is this something a shrine maiden should be saying...?","nextNodeIds":[721430125]},{"nodeId":721430125,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2226913946,"text":"It's true that shrine maidens shouldn't be speaking like this, but I am only human. I believe that we should look at history and folklore in a critical light.","nextNodeIds":[721430126]},{"nodeId":721430126,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3274670226,"text":"I apologize, I digressed again... In short, Watatsumi Island's \"Holy Soil\" problem is acting up again.","nextNodeIds":[721430127]},{"nodeId":721430127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3732206522,"text":"\"Holy Soil\"...What is that?","nextNodeIds":[721430128]},{"nodeId":721430128,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1236828466,"text":"Just as the human heart runs deep and water flows downhill, the spirit of Watatsumi Island constantly feels the call of Enkanomiya, down in the depths.","nextNodeIds":[721430129]},{"nodeId":721430129,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2568908258,"text":"As a result, our soil is slowly bleaching, becoming Holy Soil. If this continues, Watatsumi Island will one day become a desert as pale as the moonlight.","nextNodeIds":[721430130,721430132]},{"nodeId":721430130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":448323386,"text":"That sounds scary...","nextNodeIds":[721430131]},{"nodeId":721430131,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1272947658,"text":"Does it, though? To me, it's nothing more than just a superstition spread by the elderly. Although there may be some truth to it, it still lacks logical credibility.","nextNodeIds":[721430133]},{"nodeId":721430133,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3438730938,"text":"According to tradition, every several centuries, we must take advantage of a moment when the spirit veins flow smoothly to break the barrier that blocks the connection between Enkanomiya and Sangonomiya...","nextNodeIds":[721430134]},{"nodeId":721430134,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4232367522,"text":"We will need to dive down to Enkanomiya and retrieve a Jade Coral Branch left behind by our Omikami, which was used to suppress the Dragonheir of the Depths.","nextNodeIds":[721430135]},{"nodeId":721430135,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":568663370,"text":"Then, we must use the Jade Coral Branch to perform the Watatsumi Mitama Omatsuri ritual, thus causing the sunken \"spirit\" to return, which will stop the erosion of the Holy Soil.","nextNodeIds":[721430136]},{"nodeId":721430136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":667914058,"text":"Wait, if we remove the thing that's suppressing the Dragonheir of the Depths...","nextNodeIds":[721430137]},{"nodeId":721430137,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1194262970,"text":"You deduce correctly.","nextNodeIds":[721430138]},{"nodeId":721430138,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4250773730,"text":"We have many Jade Coral Branches that can be used for this suppression, but if this continues, the Dragonheir of the Depths may one day break through the barrier and invade Watatsumi on the surface.","nextNodeIds":[721430139]},{"nodeId":721430139,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1049623386,"text":"So, I want to ask you if you could...","nextNodeIds":[721430140,721430142]},{"nodeId":721430140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3202344290,"text":"Retrieve the Jade Coral Branch?","nextNodeIds":[721430141]},{"nodeId":721430141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1080197474,"text":"#{NICKNAME}'s really good at finding things!","nextNodeIds":[721430144]},{"nodeId":721430144,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":193485146,"text":"At this stage, that is not what we need...","nextNodeIds":[721430145]},{"nodeId":721430145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":901834978,"text":"You mean you're gonna ask for our help again at a later stage?","nextNodeIds":[721430146]},{"nodeId":721430146,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2528977090,"text":"...Hmmm... Well, let's see how it goes?","nextNodeIds":[721430147]},{"nodeId":721430147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1944252802,"text":"How what goes? Your next fortune slip!?","nextNodeIds":[721430148]},{"nodeId":721430148,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4070423842,"text":"Ahem. I will need to trouble you to visit the Goshou Rocks on Watatsumi Island.","nextNodeIds":[721430149]},{"nodeId":721430149,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1333338066,"text":"The Goshou Rocks are the five nodes of the barrier that separates Sangonomiya and Enkanomiya. They were set up by the founding clergy of the Sangonomiya along with our Omikami.","nextNodeIds":[721430150]},{"nodeId":721430150,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1747814586,"text":"If you want to dispel the barrier and enter Enkanomiya, you will have to break these five seals.","nextNodeIds":[721430151]},{"nodeId":721430151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1615844762,"text":"Sounds dangerous...","nextNodeIds":[721430152]},{"nodeId":721430152,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4105138058,"text":"Indeed, it would be very risky to break the seals rashly. After all, many years have passed, and no one in our generation knows what dangers lie beneath.","nextNodeIds":[721430153]},{"nodeId":721430153,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2556385106,"text":"Very few reliable records exist to begin with, and most of them are ancient texts lacking in detail. They offer little of value.","nextNodeIds":[721430154]},{"nodeId":721430154,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":964002474,"text":"Perhaps the Dragonheir of the Depths is waiting below for a chance to strike... Or who knows? There might be a more dangerous monster than the Dragonheir that has infiltrated the area, waiting for the moment when the seal is loosened?","nextNodeIds":[721430155]},{"nodeId":721430155,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1565282330,"text":"Or perhaps the ruins of the past have been buried under coral and sponges, never to be found again?","nextNodeIds":[721430156]},{"nodeId":721430156,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":103585530,"text":"Or worse still... maybe there's nothing to be found down there but a hollow cavern and lots of seawater?","nextNodeIds":[721430157]},{"nodeId":721430157,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4229389226,"text":"Whatever the case may be, standing here wildly speculating will not bring us the answer.","nextNodeIds":[721430158]},{"nodeId":721430158,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":563091138,"text":"She makes a lot of good points, but let's face it — it'll still be us doing the work.","nextNodeIds":[721430159]},{"nodeId":721430159,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3807063418,"text":"Anyway. Since Enkanomiya has not been visited for so many years, perhaps some treasures left by the ancestors are still in there.","nextNodeIds":[721430160]},{"nodeId":721430160,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":526823754,"text":"#Trea— Ahem! {NICKNAME}, Paimon thinks that helping locals to solve their problems is cause enough for us to act!","nextNodeIds":[721430161]},{"nodeId":721430161,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3773681602,"text":"...You have a way with words, Miss Tsuyuko.","nextNodeIds":[721430162]},{"nodeId":721430162,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3346678810,"text":"You flatter me. So, let's get to the point. The Goshou Rocks are in five locations, namely the \"eye,\" \"fang,\" \"fin,\" \"tail,\" and \"heart.\"","nextNodeIds":[721430163]},{"nodeId":721430163,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2038294906,"text":"First is the seal known as the \"eye\" on <color=#00E1FFFF>the island to the west</color>. Look, it's right over there.","nextNodeIds":[721430164]},{"nodeId":721430164,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":47377098,"text":"Then why don't you just go yourself?","nextNodeIds":[721430165]},{"nodeId":721430165,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1264050770,"text":"Hehe...","nextNodeIds":[721430166]},{"nodeId":721430166,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2771963122,"text":"What do you mean, \"hehe\"!?","nextNodeIds":[721430167]},{"nodeId":721430167,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":598857538,"text":"The seal has been in place for a long time, and the ritual to break the seal is now unknown to most people...","nextNodeIds":[721430168]},{"nodeId":721430168,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4001021290,"text":"In addition, due to the current situation, it is difficult for the Divine Priestess to spare time to hold a grand ceremony to break the five seals in time.","nextNodeIds":[721430169]},{"nodeId":721430169,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3639544226,"text":"I'm ashamed to have to admit all of this to an outlander, but... the only person I can rely on is someone knowledgeable and well-informed, like you.","nextNodeIds":[721430170]},{"nodeId":721430170,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":438935266,"text":"Plus, if everything goes wrong, your identity as an outlander will help us to...","nextNodeIds":[721430171]},{"nodeId":721430171,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3752819914,"text":"Find a scapegoat?","nextNodeIds":[721430172]},{"nodeId":721430172,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3895029586,"text":"No, no... nothing like that... I would call this a case where \"ignorance absolves guilt.\"","nextNodeIds":[721430173]},{"nodeId":721430173,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":507407802,"text":"If the <color=#00E1FFFF>Sangonomiya Shrine</color> is used as the base of orientation, the \"fang\" is located in the <color=#00E1FFFF>northwest</color> and the \"fin\" is located in <color=#00E1FFFF>the north</color>.","nextNodeIds":[721430174]},{"nodeId":721430174,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3351487330,"text":"Lastly, there is the \"tail\" on the <color=#00E1FFFF>eastern shoal</color>.","nextNodeIds":[721430175]},{"nodeId":721430175,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":707331906,"text":"Near each of the four seals is a stone tablet that records ritual-related matters... But they have stood for many an age, and the handwriting is now barely legible.","nextNodeIds":[721430176]},{"nodeId":721430176,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":665090394,"text":"By obtaining the \"Spirit Pearl\" of these four seals, you can unlock the fifth seal — the \"heart.\"","nextNodeIds":[721430177]},{"nodeId":721430177,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1868071714,"text":"Sounds complicated...","nextNodeIds":[721430178]},{"nodeId":721430178,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1510760874,"text":"It's okay, if you are afraid that you will forget, please look for me at the Sangonomiya Shrine, and I will go over the steps with you again.","nextNodeIds":[721430179]},{"nodeId":721430179,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2785674250,"text":"Finally... I know it is poor etiquette to simply stop you in your tracks and entrust such an important matter to you on an unofficial basis. Please accept my apologies for this.","nextNodeIds":[721430180]},{"nodeId":721430180,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4196996738,"text":"But in any case, this is a matter of great importance to Watatsumi Island... The Sangonomiya Shrine will be very grateful for your aid.","nextNodeIds":[]},{"nodeId":721430142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":851635034,"text":"Eliminate the Dragonheir of the Depths?","nextNodeIds":[721430143]},{"nodeId":721430143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2247270306,"text":"#{NICKNAME} is great at fighting all kinds of monsters!","nextNodeIds":[721430144]},{"nodeId":721430132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3778477874,"text":"So how can we solve this problem?","nextNodeIds":[721430133]},{"nodeId":721430116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":345937522,"text":"So, uh, about the reason you need help...","nextNodeIds":[721430117]},{"nodeId":721430109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":485440106,"text":"Okay.","nextNodeIds":[721430110]},{"nodeId":721430110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2078698234,"text":"How is this any way to ask for help...","nextNodeIds":[721430111]}]},{"talkId":7214302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7214301","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7214302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7214302,"initDialog":721430201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3193],"performCfg":"","priority":5,"questId":72143,"showRandomTalkCount":0},"dialogs":[{"nodeId":721430201,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1682028498,"text":"You're back. Is there something I can do for you?","nextNodeIds":[721430202,721430206,721430211]},{"nodeId":721430202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2743893330,"text":"About the locations of the Goshou Rocks...","nextNodeIds":[721430203]},{"nodeId":721430203,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1461036314,"text":"The <color=#00E1FFFF>\"eye\"</color> is on the <color=#00E1FFFF>island to the west</color>, the <color=#00E1FFFF>\"fang\"</color> is on the <color=#00E1FFFF>northwest coast</color>, the <color=#00E1FFFF>\"fin\"</color> is on the <color=#00E1FFFF>coast due north</color>, and the <color=#00E1FFFF>\"tail\"</color> is on the <color=#00E1FFFF>shoal in the southeast</color>.","nextNodeIds":[721430204]},{"nodeId":721430204,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3086869770,"text":"Near each of the four seals is a stone tablet that records ritual-related matters... But they have stood for many an age, and the handwriting is now barely legible.","nextNodeIds":[721430205]},{"nodeId":721430205,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":835733690,"text":"By obtaining the four \"Spirit Pearls\" of these four seals, you can unlock the seal of the \"heart\".","nextNodeIds":[721430214]},{"nodeId":721430214,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3652731250,"text":"And at the appointed, critical time, we break the barrier, retrieve the Jade Coral Branch, perform the Watatsumi Mitama Omatsuri ritual...","nextNodeIds":[721430215]},{"nodeId":721430215,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1881091530,"text":"...But the knowledge I gained at the Akademiya tells me that the spread of Holy Soil is due to Watatsumi Island's geological make-up.","nextNodeIds":[721430216]},{"nodeId":721430216,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1746759290,"text":"As the seawater encroaches on land, the soil dries and hardens. The saline and alkaline components will leach the land's nutrients away and render the soil inert, thus rendering it no longer suitable for agriculture.","nextNodeIds":[721430217]},{"nodeId":721430217,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":1345913426,"text":"The Jade Coral Branches contain Omikami's power, and they can replenish the missing elements in the soil, thus staving off the effects of bleaching.","nextNodeIds":[721430218]},{"nodeId":721430218,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2930718098,"text":"Ahem. Sorry, I digress.","nextNodeIds":[]},{"nodeId":721430206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3637075946,"text":"About the names of the Goshou Rocks...","nextNodeIds":[721430207]},{"nodeId":721430207,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":311175586,"text":"Ah, you must want to know why these seals are named the way they are?","nextNodeIds":[721430208]},{"nodeId":721430208,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":729855418,"text":"The Omikami has an envoy, and the clergy set a seal upon its skeleton and used its power to break the connection between Watatsumi and Enkanomiya.","nextNodeIds":[721430209]},{"nodeId":721430209,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":3043170850,"text":"If you don't believe me, you can look at the map yourself. The bulge on the left is the \"eye\" and the one stretching out at the bottom right is the \"tail\"...","nextNodeIds":[721430210]},{"nodeId":721430210,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":2226739946,"text":"Okay, don't look at me like that! That's the explanation I got from my fellow shrine maidens! It's hard for me to accept it too!","nextNodeIds":[]},{"nodeId":721430211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3388110066,"text":"So, what's with the \"Holy Soil\"...","nextNodeIds":[721430212]},{"nodeId":721430212,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":794749586,"text":"Basically, the bleaching of the soil is said to be due to absorption of the spirit of Watatsumi Island by Byakuyakoku. If it sinks all the way to the bottom, then Watatsumi will become a desert.","nextNodeIds":[721430213]},{"nodeId":721430213,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"Tsuyuko","textMapHash":4261020186,"text":"But thanks to the suppressive power of Sangonomiya Shrine and our Omikami's might, which our Divine Priestess has inherited, this Holy Soil has not spread to encompass the rest of the island.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7214301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7214302,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7214507,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7214604,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7214704,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7214805,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"