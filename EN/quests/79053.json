:"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7905314],"talks":[{"talkId":7905314,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["1","1","79053","",""],"type":"TALK_EXEC_SET_QUEST_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7905304","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["120462","1","","",""],"type":"QUEST_COND_PACK_HAVE_ITEM"},{"param":["1","0","79053","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7905314,"initDialog":790531401,"nextRandomTalks":[],"nextTalks":[],"npcId":[13247],"performCfg":"QuestDialogue/WQ/Penumbra_79041/Q7905314","priority":6,"questId":79053,"showRandomTalkCount":0},"dialogs":[{"nodeId":790531401,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":1705748354,"text":"Oh, it's you two. What is it? You look like you have questions.","nextNodeIds":[790531402]},{"nodeId":790531402,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":62118290,"text":"If it's answers about Veluriyam Mirage that you seek, then you've come to the right person. I know Veluriyam Mirage like the ripples on my palm.","nextNodeIds":[790531403,790531405]},{"nodeId":790531403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1201072098,"text":"You have... wave-like wrinkles?","nextNodeIds":[790531404]},{"nodeId":790531404,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":812285626,"text":"It's just a metaphor! I'd never have any wrinkles, never!","nextNodeIds":[790531407]},{"nodeId":790531407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":393531474,"text":"Anyway, let Paimon bring you up to speed! We found this letter in the park!","nextNodeIds":[790531408]},{"nodeId":790531408,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1504039394,"text":"Idyia, you must know where this came from, right?","nextNodeIds":[790531409]},{"nodeId":790531409,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":3840403090,"text":"Of course, it's obviously from... Huh? It's my first time seeing such a letter...","nextNodeIds":[790531410]},{"nodeId":790531410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2024882410,"text":"The ripples on your palm aren't looking too clear now...","nextNodeIds":[790531411]},{"nodeId":790531411,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":3702540202,"text":"S-Someone must have buried it while I wasn't paying attention. It's not surprising that I'm seeing it for the first time now.","nextNodeIds":[790531412]},{"nodeId":790531412,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":4133440346,"text":"And based on its contents, it's closer to a will and a chronicle than a letter. But who? The tone of the writing feels quite familiar...","nextNodeIds":[790531413]},{"nodeId":790531413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":74935066,"text":"It seems related to the Shinrou Casket?","nextNodeIds":[790531414]},{"nodeId":790531414,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":1871210498,"text":"Ah! Now that you mentioned it, you're right, it is from the old man who brought the Shinrou Casket. It's... it's something that happened not too long after I arrived in the bottle.","nextNodeIds":[790531415]},{"nodeId":790531415,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":3802367530,"text":"The old man was from Inazuma. His first question upon arriving here was whether this Domain fulfills wishes, and he wanted to be sent to a battlefield of the past...","nextNodeIds":[790531416]},{"nodeId":790531416,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":1322680450,"text":"I tried to explain it to him, but... His physical condition was terrible when he arrived, and even his mind was clearly at its limit from his arduous journey...","nextNodeIds":[790531417]},{"nodeId":790531417,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":830051890,"text":"He kept repeating things like \"I beg you, send me back to that day\" or \"send me back to that war...\"","nextNodeIds":[790531418]},{"nodeId":790531418,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":333503106,"text":"So, I used the bottle's mirage to recreate the battlefield from his mind.","nextNodeIds":[790531419]},{"nodeId":790531419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1706530994,"text":"Oh! So when he mentioned \"finally returning\" in the letter...","nextNodeIds":[790531420]},{"nodeId":790531420,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":4042864634,"text":"It's probably because when he woke up in a daze, the mirage surrounding him was already the image of the battlefield in his memories. It was quite a scary battlefield, but he had such a big smile on his face.","nextNodeIds":[790531421]},{"nodeId":790531421,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":879154898,"text":"Why would someone wish to see something so terrifying in their last moments?","nextNodeIds":[790531422,790531423]},{"nodeId":790531422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":361221050,"text":"Maybe it means something special to him?","nextNodeIds":[790531424]},{"nodeId":790531424,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":4232147346,"text":"I don't know. But he looked very satisfied, in the end.","nextNodeIds":[790531425]},{"nodeId":790531425,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":4026192874,"text":"If there was a wish he had to fulfill in a place like that, the years he spent carrying that burden must have been really hard.","nextNodeIds":[790531426]},{"nodeId":790531426,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":4166747122,"text":"The Shinrou Casket was a big help in restarting the Central Hub. So, I owe Mr. Hideie a debt of gratitude.","nextNodeIds":[]},{"nodeId":790531423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1436016266,"text":"Maybe it's more exciting that way.","nextNodeIds":[790531424]},{"nodeId":790531405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2150570906,"text":"Really? Let me have a look!","nextNodeIds":[790531406]},{"nodeId":790531406,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","textMapHash":3411331730,"text":"I-It's just a metaphor. It's no different from your palm print. Nothing special, really.","nextNodeIds":[790531407]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7905314,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7905301,7905313,7905314],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"Idyia","count":41},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_AND","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPD