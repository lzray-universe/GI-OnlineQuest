:false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1900306","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1900306,"initDialog":190030601,"nextRandomTalks":[],"nextTalks":[],"npcId":[147101],"performCfg":"QuestDialogue/COOP/Coop101401SimpleTalk/Q1900306","priority":5,"questId":19003,"showRandomTalkCount":0},"dialogs":[{"nodeId":190030601,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2800317938,"text":"Yes, my child?","nextNodeIds":[190030602]},{"nodeId":190030602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3732016290,"text":"About Barbara's time off...","nextNodeIds":[190030603]},{"nodeId":190030603,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":4011158634,"text":"Oh yes, Sister Barbara just submitted her request for half a day's leave. She said she had plans with a friend.","nextNodeIds":[190030604]},{"nodeId":190030604,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":3621869978,"text":"I must say though, it is quite unusual for Barbara to request time off just to see a friend...","nextNodeIds":[190030605]},{"nodeId":190030605,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2106085458,"text":"But that's beside the point. What is it you'd like to ask me?","nextNodeIds":[190030606]},{"nodeId":190030606,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":188560938,"text":"About \"Fantastic Summer-Serendipity Coral Sparkling Tea\"...","nextNodeIds":[190030607]},{"nodeId":190030607,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":573933682,"text":"Oh? You mean to tell me that Barbara intends to accompany you to buy this... special drink?","nextNodeIds":[190030608]},{"nodeId":190030608,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2963886746,"text":"Then you must be the friend that she mentioned, I presume?","nextNodeIds":[190030609]},{"nodeId":190030609,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":794129522,"text":"Hmm, seeing as you're the Honorary Knight, I guess that's fine...","nextNodeIds":[190030610]},{"nodeId":190030610,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":3760705034,"text":"Well then, please take good care of Sister Barbara.","nextNodeIds":[190030611]},{"nodeId":190030611,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1205218370,"text":"Why does Barbara always have to report her plans?","nextNodeIds":[190030612]},{"nodeId":190030612,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2670994050,"text":"Well, as you may already know, Sister Barbara is quite popular in Mondstadt for several reasons...","nextNodeIds":[190030613]},{"nodeId":190030613,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":3545256266,"text":"Although the citizens here may only be acting out of good intention, there are too many of them, and Sister Barbara can't handle it all.","nextNodeIds":[190030614]},{"nodeId":190030614,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2202516890,"text":"If they appear while she is working here at the Church, we can come and intervene.","nextNodeIds":[190030615]},{"nodeId":190030615,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2921695450,"text":"But if she's approached by fans during her time off, then she can only fend for herself.","nextNodeIds":[190030616]},{"nodeId":190030616,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":4127276274,"text":"And not to mention, she's too... kind. She'll always try to fulfill the requests of the citizens of Mondstadt, even when it takes a heavy toll and leaves her more exhausted than actual working hours.","nextNodeIds":[190030617]},{"nodeId":190030617,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2604421650,"text":"So with that in mind, we thought we'd have Sister Barbara always tell us where she'd be, just in case we need to come rescue her from the crowds.","nextNodeIds":[190030618]},{"nodeId":190030618,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":1064016978,"text":"My hope is that Sister Barbara stops pushing herself so hard...","nextNodeIds":[0]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1900306,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["147101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENA