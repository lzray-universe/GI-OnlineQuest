"PLAY_MODE_SINGLE","beginCond":[{"param":["1900303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1900303,"initDialog":190030301,"nextRandomTalks":[],"nextTalks":[],"npcId":[147101],"performCfg":"QuestDialogue/COOP/Coop101401SimpleTalk/Q1900303","priority":5,"questId":19003,"showRandomTalkCount":0},"dialogs":[{"nodeId":190030301,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":171291178,"text":"Oh, you're back again. If you're looking for Sister Barbara... she's yet to return.","nextNodeIds":[190030302,190030303]},{"nodeId":190030302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1432672874,"text":"We found Barbara in Wolvendom.","nextNodeIds":[190030304]},{"nodeId":190030304,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":1857491722,"text":"Oh, I see... Thank Barbatos that she's alright.","nextNodeIds":[190030305]},{"nodeId":190030305,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":533385010,"text":"But it sounds like she won't be back any time soon... Hmm, perhaps I'll have to pass her responsibilities in the Cathedral to someone else...","nextNodeIds":[190030306]},{"nodeId":190030306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2392741778,"text":"We can help.","nextNodeIds":[190030307]},{"nodeId":190030307,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":1392423050,"text":"Oh, well that's most kind of you. I certainly wouldn't want to trouble you...","nextNodeIds":[190030308]},{"nodeId":190030308,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":3559622130,"text":"Hmm... Let me think for a moment... Ah yes, you could help tidy up around the Cathedral a bit.","nextNodeIds":[190030309]},{"nodeId":190030309,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":4067765098,"text":"People tend to bring dust in as they come into the Cathedral, so the floor is often quite dirty.","nextNodeIds":[190030310]},{"nodeId":190030310,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":680853138,"text":"Cleaning and the like have always been Sister Barbara's responsibility... So the moment she's gone, everything starts getting dirty...","nextNodeIds":[190030311]},{"nodeId":190030311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1625364314,"text":"Barbara is responsible for cleaning a place this huge by herself?","nextNodeIds":[190030312]},{"nodeId":190030312,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":79764234,"text":"Yes, that's right. She always said that she could handle it herself and that there's no need to ask anyone else to help her.","nextNodeIds":[190030313]},{"nodeId":190030313,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":3207794762,"text":"But she does often appear quite exhausted after she's finished with the cleaning.","nextNodeIds":[190030314]},{"nodeId":190030314,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":3084109802,"text":"To be honest, I'm most surprised that you are willing to help... Or rather, that Barbara is willing to let you help.","nextNodeIds":[190030315]},{"nodeId":190030315,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2036015930,"text":"However, this would help to lighten her burden.","nextNodeIds":[190030316]},{"nodeId":190030316,"roleType":"TALK_ROLE_NPC","speakerId":147101,"speakerName":"Victoria","textMapHash":2583656610,"text":"Anyway, I'll let you handle the cleaning for now, Honorary Knight.","nextNodeIds":[0]},{"nodeId":190030303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1592567066,"text":"Barbara is at Dawn Winery checking on Tunner.","nextNodeIds":[190030304]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1900303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["147101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1900304,"order":4,"stepDescription":"Clean the Cathedral grounds","stepDescTextMapHash":3996333284,"finishConds":[{"BFGALAINLMD":4,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"133004434"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["COOP101401_Play_Pos_02","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[1900304],"talks":[{"talkId":1900304,"talkConfig":{"checkAct