R_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1006"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[35801],"talks":[{"talkId":35801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["35802","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":35801,"initDialog":3580101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1006],"performCfg":"QuestDialogue/AQ/Mengde1_358/Q35801","priority":5,"questId":358,"showRandomTalkCount":0},"dialogs":[{"nodeId":3580101,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3064629019,"text":"...And once it was over I brought them straight here.","nextNodeIds":[3580102]},{"nodeId":3580102,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1183640883,"text":"Mondstadt welcomes you, windborne travelers.","nextNodeIds":[3580103]},{"nodeId":3580103,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1083307115,"text":"I am Jean, Acting Grand Master of the Knights of Favonius. This is Lisa, our resident Librarian.","nextNodeIds":[3580104]},{"nodeId":3580104,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1645092275,"text":"Oh! Are you sweeties here to help us out?","nextNodeIds":[3580105]},{"nodeId":3580105,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2074632419,"text":"You're both so adorable!","nextNodeIds":[3580106]},{"nodeId":3580106,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":4264469275,"text":"Sadly, the timing is regrettable...","nextNodeIds":[3580107]},{"nodeId":3580107,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":513836891,"text":"Stormterror has caused quite a ruckus in the region since its recent resurgence.","nextNodeIds":[3580108]},{"nodeId":3580108,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3210583515,"text":"Simply put, Mondstadt's elemental sphere and ley lines are now akin to a yarn ball in the paws of a kitten.","nextNodeIds":[3580109]},{"nodeId":3580109,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2851134571,"text":"For a mage, it couldn't get much worse. My skin is one elemental particle away from a full-blown breakout.","nextNodeIds":[3580110]},{"nodeId":3580110,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2843996075,"text":"If it weren't for this interference, the Knights of Favonius would have better ways to help you than just putting up missing person posters.","nextNodeIds":[3580111]},{"nodeId":3580111,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3141303843,"text":"#We simply ask that you repose in Mondstadt while we help you seek out your {F#brother}{M#sister}.","nextNodeIds":[3580112,3580114]},{"nodeId":3580112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3557129147,"text":"I really should help out as well.","nextNodeIds":[3580113]},{"nodeId":3580113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2968614235,"text":"Paimon will help too!","nextNodeIds":[3580116]},{"nodeId":3580116,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":404453579,"text":"Good. In that case we need a plan.","nextNodeIds":[3580117]},{"nodeId":3580117,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1812449515,"text":"With Stormterror now directly attacking Mondstadt, we may have an opportunity to cut this problem off at the source.","nextNodeIds":[3580118]},{"nodeId":3580118,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2390732043,"text":"Lisa has revealed the sources of Stormterror's power with her detection magic.","nextNodeIds":[3580119]},{"nodeId":3580119,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":1291594403,"text":"Is that so?","nextNodeIds":[3580120]},{"nodeId":3580120,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3147200667,"text":"They're located in the abandoned <color=#00E1FFFF>Four Winds' Temples</color>.","nextNodeIds":[3580121]},{"nodeId":3580121,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":482447755,"text":"Stormterror's ability to whip up these kinds of storms can be attributed to it drawing power from the temples.","nextNodeIds":[3580122]},{"nodeId":3580122,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2618077571,"text":"Our objective is to deal with <color=#00E1FFFF>three</color> of the four temples.","nextNodeIds":[3580123]},{"nodeId":3580123,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":211192819,"text":"I trust everyone understands why we are only dealing with three.","nextNodeIds":[3580124]},{"nodeId":3580124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2912617667,"text":"Paimon doesn't.","nextNodeIds":[3580125,3580126]},{"nodeId":3580125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1752905259,"text":"It must be a local thing...","nextNodeIds":[3580127]},{"nodeId":3580127,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2158555899,"text":"Knights of Favonius, time is against us.","nextNodeIds":[3580128]},{"nodeId":3580128,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":126098059,"text":"The storm is rampant. There is no point in maintaining a defensive position.","nextNodeIds":[3580129]},{"nodeId":3580129,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2826187115,"text":"Alright. We need to take initiative and act before the situation escalates.","nextNodeIds":[]},{"nodeId":3580126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2404335267,"text":"We'll ask later...","nextNodeIds":[3580127]},{"nodeId":3580114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1258747075,"text":"Guess we leave it up to you then. Where's the inn?","nextNodeIds":[3580115]},{"nodeId":3580115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":257699403,"text":"Hey! Don't be such a slug! We should be a part of this too!","nextNodeIds":[3580116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[35801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1004","201004902,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIB