OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2211001,2211002],"talks":[{"talkId":2211001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211001","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2211001,"initDialog":221100101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2016],"performCfg":"","priority":6,"questId":22110,"showRandomTalkCount":0},"dialogs":[{"nodeId":221100101,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1764743328,"text":"Useless... Utterly useless.","nextNodeIds":[221100102]},{"nodeId":221100102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":328886344,"text":"What's wrong?","nextNodeIds":[221100103]},{"nodeId":221100103,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3626787704,"text":"...You really don't have anything to do, do you? Either you're too good at what you do, or hopelessly inadequate...","nextNodeIds":[221100104]},{"nodeId":221100104,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2326235008,"text":"I doubt it's the latter though — you've been doing a fine job with my Commissions so far.","nextNodeIds":[221100105]},{"nodeId":221100105,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1776731440,"text":"If you're at a loose end, there is something else you could do for me.","nextNodeIds":[221100106]},{"nodeId":221100106,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2157699048,"text":"But this time things are more dangerous. I need you to defeat a Ruin Hunter. Think you can handle it?","nextNodeIds":[221100107,221100108]},{"nodeId":221100107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1429448960,"text":"Consider it done.","nextNodeIds":[221100109]},{"nodeId":221100109,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2498995640,"text":"My, you are self-assured. My brother was the same way... Perhaps you will one day achieve the heights of greatness that he did.","nextNodeIds":[221100113]},{"nodeId":221100113,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3983656648,"text":"That's all. The location is Guili Plains. Get yourself ready, then go and take down that Ruin Hunter.","nextNodeIds":[221100114]},{"nodeId":221100114,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1840322728,"text":"Once you've taken him down, remember to look around for sword-related items; anything you find, bring it back.","nextNodeIds":[221100115]},{"nodeId":221100115,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3560258328,"text":"...But if there's nothing, just bring yourself.","nextNodeIds":[221100116]},{"nodeId":221100116,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":4160294040,"text":"Good luck with the Commission, and... I hope this time the search will prove more fruitful.","nextNodeIds":[]},{"nodeId":221100108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2431066760,"text":"Should I keep an eye out for a sword?","nextNodeIds":[221100110]},{"nodeId":221100110,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":1770708760,"text":"Yes please. When you've defeated the Ruin Hunter, please check around for a sword or any sword-related items.","nextNodeIds":[221100111]},{"nodeId":221100111,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2678907576,"text":"I must warn you that Ruin Hunters are tough opponents. You must keep your attention fixed on them at all times if you wish to defeat them.","nextNodeIds":[221100112]},{"nodeId":221100112,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2406848936,"text":"And as for the sword — it would be wonderful if you found something, but not to worry if you don't. You will be paid as long as you defeat the Ruin Hunter.","nextNodeIds":[221100113]}]},{"talkId":2211002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2211001","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2211002","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LO