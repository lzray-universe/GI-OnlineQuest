Priority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7609402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7609405","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7609401,"initDialog":760940101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7673],"performCfg":"","priority":5,"questId":76094,"showRandomTalkCount":0},"dialogs":[{"nodeId":760940101,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":2691131674,"text":"How am I supposed to get that fellow out? This is giving me a headache...","nextNodeIds":[760940102]},{"nodeId":760940102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1138472402,"text":"Is there anything I can do?","nextNodeIds":[760940103]},{"nodeId":760940103,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":1224966634,"text":"Hm? Oh! A kind adventurer, what good timing.","nextNodeIds":[760940104]},{"nodeId":760940104,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":910616250,"text":"Here's the thing. There used to be a tunnel here that led north, but it collapsed recently after some sort of anomaly with the kuuvahki.","nextNodeIds":[760940105]},{"nodeId":760940105,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":761490234,"text":"Thankfully no one was hurt, but a traveling merchant from overseas claims his \"companion\" is trapped inside...","nextNodeIds":[760940106]},{"nodeId":760940106,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":2067267626,"text":"It's a Slothsheep he met and befriended around here. Stay in these parts long enough and you'll notice that Slothsheep usually follow people just to scatter the seeds they're carrying.","nextNodeIds":[760940107]},{"nodeId":760940107,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":1356849754,"text":"But no matter how we explained it, that gentleman just wouldn't listen. He insisted we find a way to rescue it.","nextNodeIds":[760940108]},{"nodeId":760940108,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":4278940794,"text":"To reconnect the path leading deeper into the cave, we'd have to use these Intricate Blooms. The problem is that I can't use the Frostmoon Scions' magic, and I don't have any kuuvahki devices strong enough for the job...","nextNodeIds":[760940109]},{"nodeId":760940109,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":800624810,"text":"Luckily you came by. If anyone can get that Slothsheep out of there, it would be an adventurer like you, right?","nextNodeIds":[760940110]},{"nodeId":760940110,"roleType":"TALK_ROLE_NPC","speakerId":7673,"speakerName":"Vacarao","textMapHash":495573082,"text":"I'll thank you on behalf of that gentleman.","nextNodeIds":[]}]},{"talkId":7609405,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{