":["4233"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7320401],"talks":[{"talkId":7320401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7320401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7320401,"initDialog":732040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4233],"performCfg":"QuestDialogue/WQ/Sumeru_73204/Q7320401","priority":5,"questId":73204,"showRandomTalkCount":0},"dialogs":[{"nodeId":732040101,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3980781090,"text":"What are you kids doing? Come to laugh at this old man \"growing rocks,\" have you?","nextNodeIds":[732040102]},{"nodeId":732040102,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3268417882,"text":"I'm fine! I don't need the other villagers to worry about me.","nextNodeIds":[732040103]},{"nodeId":732040103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1687518330,"text":"Whoa, no need to be so hostile from the get-go.","nextNodeIds":[732040104]},{"nodeId":732040104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2902524042,"text":"You're mistaken. We're not from Aaru Village, and we're not here to laugh at you.","nextNodeIds":[732040105,732040107]},{"nodeId":732040105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3618710642,"text":"We're just passing by.","nextNodeIds":[732040106]},{"nodeId":732040106,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2841359130,"text":"Passers-by? Uh...","nextNodeIds":[732040110]},{"nodeId":732040110,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3602399162,"text":"Normally, only some old friends of mine would come over to tell me to give up on the nursery and move back to the village.","nextNodeIds":[732040111]},{"nodeId":732040111,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3802619898,"text":"And a few bad kids too. They keep coming over here to cause trouble.","nextNodeIds":[732040112]},{"nodeId":732040112,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":322183690,"text":"It's my first time seeing children dressed up like this. What is it that you do?","nextNodeIds":[732040113,732040116]},{"nodeId":732040113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":232392034,"text":"I'm a traveler looking for my family.","nextNodeIds":[732040114]},{"nodeId":732040114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":185657618,"text":"Yes, we've traveled a long way for this, and gone through many adventures together.","nextNodeIds":[732040115]},{"nodeId":732040115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1485849762,"text":"#{NICKNAME}'s a righteous soul through and through.","nextNodeIds":[732040119]},{"nodeId":732040119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2764037122,"text":"We don't do things like bullying lonely old folks.","nextNodeIds":[732040120]},{"nodeId":732040120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3705542914,"text":"So there's no need to worry, gramps. We're not bad guys.","nextNodeIds":[732040121]},{"nodeId":732040121,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2288528586,"text":"Ahem. How embarrassing, to have to apologize to two children. But I am sorry. I shouldn't have made assumptions.","nextNodeIds":[732040122]},{"nodeId":732040122,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":695022738,"text":"Children, please accept my — Affan's — most sincere apologies.","nextNodeIds":[732040123]},{"nodeId":732040123,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2936525658,"text":"You children are very capable to be supporting yourselves at such a young age. Quite impressive. Much better than me at your age.","nextNodeIds":[732040124]},{"nodeId":732040124,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":884928058,"text":"So based on what you just said, I can request your help when I have a problem that I can't solve, yes?","nextNodeIds":[732040125]},{"nodeId":732040125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1866385194,"text":"Oh? Do you mean you have a commission for us?","nextNodeIds":[732040126]},{"nodeId":732040126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3153221138,"text":"What's the problem?","nextNodeIds":[732040127]},{"nodeId":732040127,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3369572378,"text":"I originally had two nurseries. One is here, and the other is to the west of the village.","nextNodeIds":[732040128]},{"nodeId":732040128,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2849259482,"text":"I've gotten quite old, so it's getting harder for me to tend to both places. I didn't check on the other nursery for just a few days, and it was destroyed by some strange black stuff.","nextNodeIds":[732040129]},{"nodeId":732040129,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3850654610,"text":"It's terribly dangerous. Once I went in, I thought I wouldn't be able to come back out. I know better than to try to go in there again.","nextNodeIds":[732040130]},{"nodeId":732040130,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3787792634,"text":"My greatest hope now is to restore that nursery so that I can grow flowers there again.","nextNodeIds":[732040131]},{"nodeId":732040131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":56622754,"text":"#It doesn't sound too complicated. What do you think? Should we accept this commission, {NICKNAME}?","nextNodeIds":[732040132]},{"nodeId":732040132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1262354866,"text":"Sure.","nextNodeIds":[732040133]},{"nodeId":732040133,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3086818082,"text":"The nursery is to the west of the village. Don't get lost!","nextNodeIds":[732040134]},{"nodeId":732040134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2279802762,"text":"No problem! Don't worry about it.","nextNodeIds":[]},{"nodeId":732040116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2607946026,"text":"I'm an adventurer exploring the world.","nextNodeIds":[732040117]},{"nodeId":732040117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1593234682,"text":"Yep! We've climbed many, many mountains, and crossed lakes and seas to get to Sumeru.","nextNodeIds":[732040118]},{"nodeId":732040118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4182606090,"text":"What do you call it? Uh, we're... big-hearted adventurers.","nextNodeIds":[732040119]},{"nodeId":732040107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3219953594,"text":"I heard that someone's growing flowers here.","nextNodeIds":[732040108]},{"nodeId":732040108,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2465549818,"text":"Yeah, I'm growing flowers, not some dumb rocks.","nextNodeIds":[732040109]},{"nodeId":732040109,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1331333434,"text":"I thought... Ugh. Never mind, what am I even supposed to say now...","nextNodeIds":[732040110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4233"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},