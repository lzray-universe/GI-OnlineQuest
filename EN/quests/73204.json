ent":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7320404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7320404,"initDialog":732040401,"nextRandomTalks":[],"nextTalks":[],"npcId":[4233],"performCfg":"QuestDialogue/WQ/Sumeru_73204/Q7320404","priority":5,"questId":73204,"showRandomTalkCount":0},"dialogs":[{"nodeId":732040401,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3981230818,"text":"You two are back? How is the nursery? Do you think it can be saved?","nextNodeIds":[732040402]},{"nodeId":732040402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2545028842,"text":"We've taken care of it.","nextNodeIds":[732040403]},{"nodeId":732040403,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3062573850,"text":"You explain the Withering to Affan.","nextNodeIds":[732040404]},{"nodeId":732040404,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":592354650,"text":"I see. So that's why. I knew something was off when so much black stuff just appeared out of the ground.","nextNodeIds":[732040405]},{"nodeId":732040405,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3414176322,"text":"Good, good. Now I can finally plant some seeds without worries.","nextNodeIds":[732040406]},{"nodeId":732040406,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3579968090,"text":"When these three seeds sprout, bloom and produce seeds again, I'll plant them in the ground there. Then the land will be covered with these flowers.","nextNodeIds":[732040407]},{"nodeId":732040407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3430573834,"text":"Eh? These strangely-shaped rocks...? Can flowers grow out of them?","nextNodeIds":[732040408]},{"nodeId":732040408,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3272812730,"text":"Where did you buy these from, Grandpa Affan? Did you get scammed or something?","nextNodeIds":[732040409]},{"nodeId":732040409,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3553011866,"text":"You have good hearts. But don't worry, children. Mora can't buy these flower seeds.","nextNodeIds":[732040410]},{"nodeId":732040410,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2299420914,"text":"The old... I mean, a friend of mine gave me these three precious seeds. So of course they are different from normal seedlings.","nextNodeIds":[732040411]},{"nodeId":732040411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3929320618,"text":"The more Paimon hears about it, the weirder it sounds. Grandpa Affan, just what are you growing?","nextNodeIds":[732040412]},{"nodeId":732040412,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":2165725114,"text":"Hehe, what I'm planting is a friend's wish.","nextNodeIds":[732040413]},{"nodeId":732040413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3861701266,"text":"What a strange answer. Can you really plant that sort of thing?","nextNodeIds":[732040414]},{"nodeId":732040414,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3834084538,"text":"Child, you wouldn't understand even if I told you. Come visit me again when you get the chance.","nextNodeIds":[732040415]},{"nodeId":732040415,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":1684495738,"text":"This field might look empty now, but these three seeds will one day sprout and bloom in this nursery.","nextNodeIds":[732040416]},{"nodeId":732040416,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3806965586,"text":"There will be more and more of them in the future. Haha, and they will surely create a beautiful scene.","nextNodeIds":[732040417]},{"nodeId":732040417,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":334725330,"text":"Alright, alright. Since I asked for your help, I will be sure to compensate you.","nextNodeIds":[732040418]},{"nodeId":732040418,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"Affan","textMapHash":3144124218,"text":"Take this, children. I can't give you much, so this is all.","nextNodeIds":[732040419]},{"nodeId":732040419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":84103210,"text":"Phew, commission complete! Paimon's a little hungry after all that running around.","nextNodeIds":[732040420]},{"nodeId":732040420,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2795551498,"text":"I was the one running though...","nextNodeIds":[732040421]},{"nodeId":732040421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":152391554,"text":"Well, Paimon was providing running commentary. That takes energy too!","nextNodeIds":[732040422]},{"nodeId":732040422,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1559610650,"text":"Don't sweat the small stuff! How about we use our payment to buy ourselves a treat, hmm?","nextNodeIds":[732040423]},{"nodeId":732040423,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3124070482,"text":"C'mon, let's see how much we got and how many meals we can buy.","nextNodeIds":[732040424]},{"nodeId":732040424,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":979729010,"text":"Let's see...","nextNodeIds":[732040425]},{"nodeId":732040425,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2870459442,"text":"Ah, most of the stuff here is food instead of Mora... Shawarma, Tahchin, and lots of vegetables.","nextNodeIds":[732040426]},{"nodeId":732040426,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2810245754,"text":"This is way too much. Did we take a whole day's rations away from Grandpa Affan?","nextNodeIds":[732040427]},{"nodeId":732040427,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":672609554,"text":"But he lives alone outside the village. It can't be easy for him, right?","nextNodeIds":[732040428]},{"nodeId":732040428,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1998903786,"text":"Never mind the Mora. If he gave us all his rations, then... It just feels wrong.","nextNodeIds":[732040429]},{"nodeId":732040429,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":707819330,"text":"And he was planting seeds that looked like stones, saying that he was planting... a wish?","nextNodeIds":[732040430]},{"nodeId":732040430,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1548214202,"text":"Is it possible that he's been living on his own for so long that he's started to imagine things?","nextNodeIds":[732040431]},{"nodeId":732040431,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4102568794,"text":"This is worrying. Let's pay him a visit when we can find the time.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320404,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4233"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7320408,"order":6,"stepDescription":"","stepDescTextMapHash":4266231340,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320406,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7320406],"talks":[{"talkId":7320406,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],