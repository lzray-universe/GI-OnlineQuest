GJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["14267"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2502201],"talks":[{"talkId":2502201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2502201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2502201,"initDialog":250220101,"nextRandomTalks":[],"nextTalks":[],"npcId":[14267],"performCfg":"QuestDialogue/IQ/Natlan_25022/Q2502201","priority":5,"questId":25022,"showRandomTalkCount":0},"dialogs":[{"nodeId":250220101,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":1208716202,"text":"Hmm... Looks like we'll need to try a different recipe...","nextNodeIds":[250220102]},{"nodeId":250220102,"roleType":"TALK_ROLE_NPC","speakerId":14268,"speakerName":"Hora","textMapHash":1878904498,"text":"Oroooo! Rrroooo!","nextNodeIds":[250220103,250220104]},{"nodeId":250220103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1894187298,"text":"Another bright idea? Let's hear it then.","nextNodeIds":[250220106]},{"nodeId":250220106,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":952794642,"text":"R—Roar!","nextNodeIds":[250220107]},{"nodeId":250220107,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":1975420642,"text":"Normally Hora can finish a whole bowl of fruit, and once he's done, he'll go on playing all day long.","nextNodeIds":[250220108]},{"nodeId":250220108,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":1565844242,"text":"But now, he only eats half a bowl, then he just sits there not moving a muscle...","nextNodeIds":[250220109]},{"nodeId":250220109,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":388687266,"text":"I was so worried he might be ill that I went to find a vet in the middle of the night to ask his advice.","nextNodeIds":[250220110]},{"nodeId":250220110,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":785887890,"text":"The two of us spent the entire night trying to figure out what was wrong with him, only to realize he wasn't ill at all, just... a very picky eater.","nextNodeIds":[250220111]},{"nodeId":250220111,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":2967338114,"text":"The vet said that the best solution would be to find a new recipe.","nextNodeIds":[250220112]},{"nodeId":250220112,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":3693745074,"text":"He also said that I could try playing some music for Hora during mealtimes, that it might stimulate his appetite...","nextNodeIds":[250220113,250220114]},{"nodeId":250220113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4022298546,"text":"That sounds like a great idea...","nextNodeIds":[250220115]},{"nodeId":250220115,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":1392634930,"text":"Hahaha, yeah, I did find a record, and Hora was pretty into it, too.","nextNodeIds":[250220116]},{"nodeId":250220116,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":3862165762,"text":"But we were forced to abandon that idea... when Hora jumped up and bit the record in half.","nextNodeIds":[250220117]},{"nodeId":250220117,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":3075488154,"text":"Don't look so shocked. From a Tepetlisaurus's point of view, a record made from obsidian and phlogiston is a tasty treat in itself...","nextNodeIds":[250220118]},{"nodeId":250220118,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":445167170,"text":"Now, my only option is to head over to the Scions of the Canopy and see if anyone there can help me find some new ingredients to try out.","nextNodeIds":[250220119,250220120]},{"nodeId":250220119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3518574906,"text":"I'll go find some ingredients for you.","nextNodeIds":[250220121]},{"nodeId":250220121,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":4283470786,"text":"You'd really help me out? That would be terrific! My Scion friends can only search within Natlan, but you could source ingredients from anywhere, couldn't you?","nextNodeIds":[250220124]},{"nodeId":250220124,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":3368153346,"text":"Hold up, let me look at the list of ingredients the vet recommended. That doc knows a lot, even about things beyond our borders...","nextNodeIds":[250220125]},{"nodeId":250220125,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":3655560274,"text":"Huh... It says that we can try <color=#00E1FFFF>\"Rainbow Roses,\" \"Lavender Melons,\"</color> and <color=#00E1FFFF>\"Qingxin.\"</color>","nextNodeIds":[250220122]},{"nodeId":250220122,"roleType":"TALK_ROLE_NPC","speakerId":14267,"speakerName":"Cazcal","textMapHash":3722342322,"text":"Thanks so much for doing this. If you come across any unique ingredients, just bring them straight back to me.","nextNodeIds":[250220123]},{"nodeId":250220123,"roleType":"TALK_ROLE_NPC","speakerId":14268,"speakerName":"Hora","textMapHash":1451646690,"text":"Orrooo, orrooo!","nextNodeIds":[]},{"nodeId":250220120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3248366522,"text":"I'm a pro when it comes to ingredient gathering.","nextNodeIds":[250220121]},{"nodeId":250220114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":958349426,"text":"I had no idea such records existed.","nextNodeIds":[250220115]},{"nodeId":250220104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3404227986,"text":"(Pet Hora.)","nextNodeIds":[250220105]},{"nodeId":250220105,"roleType":"TALK_ROLE_NPC","speakerId":14268,"speakerName":"Hora","textMapHash":3364322722,"text":"R—Roar!","nextNodeIds":[250220106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2502201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NON