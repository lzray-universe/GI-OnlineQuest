],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150401,"initDialog":715040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150401","priority":15,"questId":71504,"showRandomTalkCount":0},"dialogs":[{"nodeId":715040101,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3015682634,"text":"*cough*","nextNodeIds":[715040102]},{"nodeId":715040102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1452366154,"text":"Hosseini, are you alright?","nextNodeIds":[715040103]},{"nodeId":715040103,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":127398834,"text":"I think I must be feeling the effects myself. Must've stayed here too long while thinking about how to move the Pursina's Spike towards the Ley Line rupture.","nextNodeIds":[715040104]},{"nodeId":715040104,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":51998850,"text":"It's not a big deal though. I've had some rest and I'm much better already.","nextNodeIds":[715040105]},{"nodeId":715040105,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2705361002,"text":"At the same time, I've also thought of a solution, it's just that... well, I must say that finding a way to move the Pursina's Spike around is actually not as hard as finding excuses to extend report submission dates.","nextNodeIds":[715040106]},{"nodeId":715040106,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3305936146,"text":"Since the mud covers the ground, we can make it float just a little by using hot air balloons and transport the Spike that way.","nextNodeIds":[715040107]},{"nodeId":715040107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4115553434,"text":"Ooh, that sounds like a pretty good idea.","nextNodeIds":[715040108]},{"nodeId":715040108,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":263961322,"text":"Of course, this will help us solve our dark mud problem to some extent, but in areas where it has blocked up the tunnel, we might still have trouble getting the hot air balloon through.","nextNodeIds":[715040109]},{"nodeId":715040109,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3442768834,"text":"And this is without speaking of the monsters that the mud will attract...","nextNodeIds":[715040110]},{"nodeId":715040110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":464692778,"text":"I'm afraid that we'll have to leave such things to you.","nextNodeIds":[715040111]},{"nodeId":715040111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3274165754,"text":"#Don't worry! Between Paimon and {NICKNAME}, all these monsters won't even know what hit 'em!","nextNodeIds":[715040112,715040113]},{"nodeId":715040112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":141326682,"text":"Guess you're the star of the show, Paimon.","nextNodeIds":[715040114]},{"nodeId":715040114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3001442418,"text":"Eh? W—Well, Paimon's mostly just cheering you on from the sides, y'know...","nextNodeIds":[715040115]},{"nodeId":715040115,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3580627602,"text":"Hahaha—hurk *cough* *cough*","nextNodeIds":[715040116]},{"nodeId":715040116,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":1490342570,"text":"Ugh, to think that laughing just a little would make me cough this much... Whatever the case, Tu and Hao are packaging the Pursina's Spike and getting the balloon ready.","nextNodeIds":[715040117]},{"nodeId":715040117,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":3614047418,"text":"I'd have packaged the Pursina's Spike myself, but the mere effort of standing up for a while was enough to send me into coughing fits.","nextNodeIds":[715040118]},{"nodeId":715040118,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":130371194,"text":"How embarrassing... Looks like I'll have to train my body as well as my academic mind in the future.","nextNodeIds":[715040119]},{"nodeId":715040119,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":2344545818,"text":"Go and look for them.","nextNodeIds":[]},{"nodeId":715040113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3629271282,"text":"I'll lend you my sword for a while.","nextNodeIds":[715040114]}]},{"talkId":7150405,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150401","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150405,"initDialog":715040501,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181],"performCfg":"","priority":11,"questId":71504,"showRandomTalkCount":0},"dialogs":[{"nodeId":715040501,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"Hosseini","textMapHash":916664946,"text":"I hope you succeed in transporting the Pursina's Spike.","nextNode