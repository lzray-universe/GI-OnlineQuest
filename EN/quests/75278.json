ceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7527801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7527801,"initDialog":752780101,"nextRandomTalks":[],"nextTalks":[],"npcId":[6503,21960],"performCfg":"QuestDialogue/WQ/5.8_75278/Q7527801","priority":5,"questId":75278,"showRandomTalkCount":0},"dialogs":[{"nodeId":752780101,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":2231983946,"text":"W—Wait a second! Please stop!","nextNodeIds":[752780102]},{"nodeId":752780102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2478121554,"text":"How can we help you, little girl?","nextNodeIds":[752780103]},{"nodeId":752780103,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":1244292946,"text":"\"Bear the miracle of the blooming Guiztli, and let the Sacred Flame ignite your smile!\"","nextNodeIds":[752780104]},{"nodeId":752780104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2375005938,"text":"Huh? What's going on...","nextNodeIds":[752780105]},{"nodeId":752780105,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":3498043210,"text":"\"In the name of the Easybreeze Holiday Resort, I present to you a dance of welcome! Shine on, Pipilpan Idol!\"","nextNodeIds":[752780106]},{"nodeId":752780106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":640165490,"text":"Ah! That line again!?","nextNodeIds":[752780107]},{"nodeId":752780107,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":1456922986,"text":"#That's right, it's me, \"Chiton\"! Hehe, long time no see, {M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon!","nextNodeIds":[752780108]},{"nodeId":752780108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2696954018,"text":"Oh! It's you, \"Chiton\"! Paimon thought we'd run into someone scary again...","nextNodeIds":[752780109,752780110]},{"nodeId":752780109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":982748042,"text":"You seem happy. Good news?","nextNodeIds":[752780111]},{"nodeId":752780111,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":3144367658,"text":"Hehe, guess what? Dad's gonna train me personally to become a proper performer!","nextNodeIds":[752780112]},{"nodeId":752780112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3555092234,"text":"See? He acts all tough, but he really cares about you! Paimon just hopes he can be a little more... conventional in his teaching methods...","nextNodeIds":[752780113]},{"nodeId":752780113,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":4172978514,"text":"Oh, I almost forgot, this is for you!","nextNodeIds":[752780114]},{"nodeId":752780114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2583739330,"text":"Wait, isn't this your performance outfit? But without it...","nextNodeIds":[752780115]},{"nodeId":752780115,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":1672072730,"text":"Don't worry! Dad made me a new one that fits better! No more falling off the stage for me!","nextNodeIds":[752780116]},{"nodeId":752780116,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":108400274,"text":"Consider this old outfit a keepsake! Take it, please, and think of it as a symbol of our friendship!","nextNodeIds":[752780117]},{"nodeId":752780117,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":2273532274,"text":"Next time we meet, I'll wear my new outfit and dance just for you. Promise you'll come see me!","nextNodeIds":[752780118]},{"nodeId":752780118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3319901714,"text":"We promise!","nextNodeIds":[752780119]},{"nodeId":752780119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3976476202,"text":"\"Chiton\"! Training time!","nextNodeIds":[752780120]},{"nodeId":752780120,"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","textMapHash":577674818,"text":"#Okay, gotta go work on these muscles. Bye bye, {M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon!","nextNodeIds":[752780121]},{"nodeId":752780121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4115700234,"text":"Bye-bye!","nextNodeIds":[752780122]},{"nodeId":752780122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1785698434,"text":"(You're really gonna go?)","nextNodeIds":[752780123]},{"nodeId":752780123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2210643410,"text":"Of course! Though... it would be nice if she puts on a regular idol performance...","nextNodeIds":[]},{"nodeId":752780110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1969974722,"text":"How've things been going lately?","nextNodeIds":[752780111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7527801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_11479:681.697,205.148,14270.990]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_DISABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7527801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21960,"speakerName":"\"Chiton\"","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[175278],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4250133070,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/5.8_75278/Q7527801","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBG