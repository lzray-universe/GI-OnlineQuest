20525,"speakerName":"Fatuus' Journal","textMapHash":402263850,"text":"\"...Ten were lost, two vanguard squads took immense damage. The Kapitan-Poruchik ordered a retreat...\"","nextNodeIds":[710430106]},{"nodeId":710430106,"roleType":"TALK_ROLE_NPC","speakerId":20525,"speakerName":"Fatuus' Journal","textMapHash":1301387034,"text":"(A simple map falls out from the diary. The map marks out the two bells in the northwest and the southeast, with two ominous skulls to go with them.)","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7104301,7104302,7104303],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20525,"speakerName":"Fatuus' Journal","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":20588,"speakerName":"The Sunken Ruins Bell's Toll","count":1},{"roleType":"TALK_ROLE_NPC","speakerId":20587,"speakerName":"The Submerged Ruins Bell's Toll","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171043],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1330581134,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_RANK_ZERO_WQ","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[71045],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_AND","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":710430101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7104301,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[20525],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM