E_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4007508_N10095","0"],"NOCCOBOFKHP":9,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[4007508],"talks":[{"talkId":4007508,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4007508","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4007508,"initDialog":400750801,"nextRandomTalks":[],"nextTalks":[],"npcId":[1042,10095,1032,10011,10012],"performCfg":"QuestDialogue/EQ/DreamIsland_40075/Q4007508","priority":5,"questId":40075,"showRandomTalkCount":0},"dialogs":[{"nodeId":400750801,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3726542346,"text":"Oh, we're back again!","nextNodeIds":[400750802]},{"nodeId":400750802,"roleType":"TALK_ROLE_NPC","speakerId":1042,"speakerName":"Xinyan","textMapHash":1947012490,"text":"So uh, Mona, is that adventurer... dead now?","nextNodeIds":[400750803]},{"nodeId":400750803,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2580841746,"text":"...","nextNodeIds":[400750804]},{"nodeId":400750804,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2116991450,"text":"That was the only time I ever saw him. And that was more than three years ago, which means... he's no longer alive.","nextNodeIds":[400750805]},{"nodeId":400750805,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3111192010,"text":"But isn't there still a chance that he's alive? You know, like maybe you just made a mistake?","nextNodeIds":[400750806]},{"nodeId":400750806,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4203729954,"text":"But that's not fair.","nextNodeIds":[400750807]},{"nodeId":400750807,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2458210074,"text":"You can't call it divination if you reject anything bad and believe the good unreservedly. That's just self-deception.","nextNodeIds":[400750808]},{"nodeId":400750808,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2538428706,"text":"Of course, casually performing divination for fun might be a different matter, but in my field of expertise, there's no room for lies.","nextNodeIds":[400750809]},{"nodeId":400750809,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1600845570,"text":"To contradict my own reading would be a blasphemy against astrology.","nextNodeIds":[400750810]},{"nodeId":400750810,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1348888922,"text":"Cruel, but truthful. Such is fate.","nextNodeIds":[400750811]},{"nodeId":400750811,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2966592426,"text":"I don't usually say things like this, but while we're on the topic, I really hope you don't confuse astrology with those fortune stick peddlers that you see along the streets.","nextNodeIds":[400750812]},{"nodeId":400750812,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1710169906,"text":"Astrology does not exist to please. We astrologists are here to verify and witness the truths of this world.","nextNodeIds":[400750813]},{"nodeId":400750813,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1695689690,"text":"...","nextNodeIds":[400750814]},{"nodeId":400750814,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":951450106,"text":"Which is why astrology is a disdained profession! It is a mighty art, but unfortunately one that annoys people nonetheless.","nextNodeIds":[400750815]},{"nodeId":400750815,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":2522941746,"text":"Why dost thou protest so much, Lady Megistus? Thou seemst not to be the sort with whom one would be loathe to be associated.","nextNodeIds":[400750816]},{"nodeId":400750816,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":1981233586,"text":"What mein Fräulein means is that she's glad to be friends with you.","nextNodeIds":[400750817]},{"nodeId":400750817,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":965182234,"text":"No! That was not what I said!","nextNodeIds":[400750818]},{"nodeId":400750818,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":3437477522,"text":"Whatever has gotten into you, Oz! You misinterpret my utterances with an increasingly alarming frequency!","nextNodeIds":[400750819]},{"nodeId":400750819,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":720470250,"text":"Oh my, why could that be? Perhaps I have been concerned that mein Fräulein could offend her friends and have been attempting to soften her words?","nextNodeIds":[400750820]},{"nodeId":400750820,"roleType":"TALK_ROLE_NPC","speakerId":1042,"speakerName":"Xinyan","textMapHash":4084291162,"text":"Although you're the only astrologist I know, you've left an awesome impression on me. You're not annoying at all!","nextNodeIds":[400750821]},{"nodeId":400750821,"roleType":"TALK_ROLE_NPC","speakerId":1042,"speakerName":"Xinyan","textMapHash":2315473498,"text":"Those who go snooping around for secrets, yet ignore whatever they don't wanna hear? They're the ones who should reflect on themselves. Knowing your fate doesn't come cheap.","nextNodeIds":[400750822]},{"nodeId":400750822,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":2914196458,"text":"If one could simply avoid fate with just a few words, no one would have to endure the pain of parting. Mona, don't take others' comments to heart.","nextNodeIds":[400750823]},{"nodeId":400750823,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":3998377826,"text":"Follow your heart and never forget what's right.","nextNodeIds":[400750824]},{"nodeId":400750824,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2099813290,"text":"I—I don't need comforting, thank you very much! I'm very tough, you know!","nextNodeIds":[400750825]},{"nodeId":400750825,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2225319146,"text":"Then why are your ears red?","nextNodeIds":[400750826]},{"nodeId":400750826,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":2943184882,"text":"Oh, uh...","nextNodeIds":[400750827]},{"nodeId":400750827,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":1193246330,"text":"Well, then... Umm...","nextNodeIds":[400750828]},{"nodeId":400750828,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":4001334610,"text":"Th—Thank you.","nextNodeIds":[400750829]},{"nodeId":400750829,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":721702994,"text":"What dost thou say? Speak up, and offer your highest reverence and blessings to the Prinzessin.","nextNodeIds":[400750830]},{"nodeId":400750830,"roleType":"TALK_ROLE_NPC","speakerId":1042,"speakerName":"Xinyan","textMapHash":151074938,"text":"Okay, okay, Your Highness... Instead of making a scene, why don't you go collect the other fragments in the new location reflected by the pool? We can't enter the mirage without 'em.","nextNodeIds":[400750831]},{"nodeId":400750831,"roleType":"TALK_ROLE_NPC","speakerId":10012,"speakerName":"Oz","textMapHash":2889358858,"text":"Mein Fräulein, you are the only one with eyes sharp enough to locate the secrets.","nextNodeIds":[400750832]},{"nodeId":400750832,"roleType":"TALK_ROLE_NPC","speakerId":10011,"speakerName":"Fischl","textMapHash":4091332762,"text":"If that's the case, very well, I shall proceed to the beach...","nextNodeIds":[400750833]},{"nodeId":400750833,"roleType":"TALK_ROLE_NPC","speakerId":1042,"speakerName":"Xinyan","textMapHash":2830650594,"text":"Let's go, Mona.","nextNodeIds":[400750834]},{"nodeId":400750834,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"Mona","textMapHash":883667306,"text":"Oh, okay! Coming!","nextNodeIds":[400750835]},{"nodeId":400750835,"roleType":"TALK_ROLE_NPC","speakerId":1032,"speakerName":"Kaedehara Kazuha","textMapHash":1226022730,"text":"...Haha.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4007508,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4007508_N10095","0"],"NOCCOBOFKHP":9,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4007511,"order":12,"stepDescription":"","stepDescTextMapHash":3677123284,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4007511,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4007511,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["9","199003123"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["9","199003157"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKE