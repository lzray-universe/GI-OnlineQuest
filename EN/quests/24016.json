{"mainQuestId":24016,"title":"Science of Data Management","description":"It seems that Chalmet is still buried under various chores at the Materials Office...","titleTextMapHash":1948493343,"descTextMapHash":177217134,"mainQuestExcel":{"mainQuestId":24016,"titleTextMapHash":1948493343,"title":"Science of Data Management","descTextMapHash":177217134,"description":"It seems that Chalmet is still buried under various chores at the Materials Office...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/IQ24016","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":0,"descTextMapHash":177217134,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":24016,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":180174585,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/IQ24016","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":true,"resId":0,"rewardIdList":[],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":43210,"titleTextMapHash":1948493343,"type":"IQ","unlockDescTextMapHash":3068932870}},"flow":[{"subQuestId":2401601,"order":1,"stepDescription":"Talk to Chalmet","stepDescTextMapHash":2806236508,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2401601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5256"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2401601],"talks":[{"talkId":2401601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2401601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2401601,"initDialog":240160101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5256],"performCfg":"QuestDialogue/IQ/Fontaine_24016/Q2401601","priority":5,"questId":24016,"showRandomTalkCount":0},"dialogs":[{"nodeId":240160101,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":2605992250,"text":"That should do it... I hope these materials will actually be useful.","nextNodeIds":[240160102]},{"nodeId":240160102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1219605586,"text":"Are you still organizing files?","nextNodeIds":[240160103]},{"nodeId":240160103,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":3318969706,"text":"Oho! Pleasure to see you, Honorary Senior Researcher.","nextNodeIds":[240160104]},{"nodeId":240160104,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":4092854506,"text":"That's correct! I am continuing to organize the documents and files according to Mr. Raimondo's instructions... Wait, haven't I said this before?","nextNodeIds":[240160105]},{"nodeId":240160105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3829374258,"text":"But this place is huge! It's way too much work for one person. Why didn't he assign anyone to help you?","nextNodeIds":[240160106]},{"nodeId":240160106,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":3457237954,"text":"The Research Institute has many pressing matters to deal with. It's normal that there's no one available to help me.","nextNodeIds":[240160107]},{"nodeId":240160107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":763310042,"text":"And you're a Director too...","nextNodeIds":[240160108]},{"nodeId":240160108,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":373122762,"text":"You mean my title as Fontaine Research Institute Materials Retrieval Project Director? *sigh* Please don't mock me so...","nextNodeIds":[240160109]},{"nodeId":240160109,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":4173609026,"text":"In what way am I actually a Director? From the very beginning, I have been no more than an ordinary staffer responsible for organizing files.","nextNodeIds":[240160110]},{"nodeId":240160110,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":1266505626,"text":"After Mr. Raimondo assigned me here to organize the files, I was suddenly informed of my new title.","nextNodeIds":[240160111]},{"nodeId":240160111,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":2538489458,"text":"Someone said this was Mr. Choiseul's idea. Apparently he thinks that since our work is so onerous, giving us such titles will make providing additional compensation easier...","nextNodeIds":[240160112]},{"nodeId":240160112,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":385171434,"text":"Ah! Don't tell anyone else, how could I... how could I just say it out loud like that...","nextNodeIds":[240160113]},{"nodeId":240160113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4244064170,"text":"I'm the silent type, relax.","nextNodeIds":[240160114]},{"nodeId":240160114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4284430202,"text":"That sounds not bad at all! And after all, it's only fair that those who do all the work should receive a bit more compensation.","nextNodeIds":[240160115]},{"nodeId":240160115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4052443634,"text":"But why use such a roundabout method? Can't they just give everyone more Mora?","nextNodeIds":[240160116,240160117]},{"nodeId":240160116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":103863002,"text":"This seems par for the course here at the Research Institute.","nextNodeIds":[240160118]},{"nodeId":240160118,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":4247479074,"text":"*sigh* I can never understand just what the two of them are thinking...","nextNodeIds":[240160119]},{"nodeId":240160119,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":167343498,"text":"But I have to keep working, no matter what! There's too much to do.","nextNodeIds":[240160120]},{"nodeId":240160120,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":3634508890,"text":"Honorary Senior Researcher, if you are willing, could you please give me a hand?","nextNodeIds":[240160121,240160122]},{"nodeId":240160121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1648901266,"text":"It is my duty.","nextNodeIds":[240160124]},{"nodeId":240160124,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":3501606578,"text":"In that case, please help me clear out some of the filth around here.","nextNodeIds":[240160125]},{"nodeId":240160125,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":2259764322,"text":"Be sure to do your best <color=#00E1FFFF>not to touch the nearby books and files</color> while you're cleaning. It would be absolutely awful if they were damaged by the cleaning...","nextNodeIds":[240160126]},{"nodeId":240160126,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":3259268242,"text":"I'll leave that to you then! As for me, I'll keep organizing the files here. *sigh* I never noticed there were so many files in the Institute before...","nextNodeIds":[]},{"nodeId":240160122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2628665146,"text":"Don't forget to make the \"honorary\" in my title even more honorable!","nextNodeIds":[240160123]},{"nodeId":240160123,"roleType":"TALK_ROLE_NPC","speakerId":5256,"speakerName":"Chalmet","textMapHash":2040853378,"text":"Hahaha, not a problem! I will testify to your kindness and contributions.","nextNodeIds":[240160124]},{"nodeId":240160117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3655502562,"text":"As long as you actually receive the extra Mora.","nextNodeIds":[240160118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2401601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133409385"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5256"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2401602,"order":2,"stepDescription":"Clean up the filth","stepDescTextMapHash":736370444,"finishConds":[{"BFGALAINLMD":3,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q2401602"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_6352:4369.781,514.339,3944.758]","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2401602],"talks":[{"talkId":2401602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],