akerId":1005,"speakerName":"Paimon","textMapHash":3767235194,"text":"Eh? Didn't you like the flowers? Why aren't you looking after them?","nextNodeIds":[740490105]},{"nodeId":740490105,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":411918986,"text":"Ohh... They were so hard to get, so I do want to take good care of them, so, so much... But when I think that they might wither before my eyes, I... I'm scared to go...","nextNodeIds":[740490106]},{"nodeId":740490106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":804235098,"text":"Oh wow, you really are very concerned about them... Why don't we go have a look together? If anything bad happens, we'll help you out!","nextNodeIds":[740490107]},{"nodeId":740490107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1372309082,"text":"There's no point in worrying too much.","nextNodeIds":[740490108]},{"nodeId":740490108,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":541926786,"text":"You're right... Let's go together! With the two of you to help me, I feel like we can handle this!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7404901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["5315"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7404903,"order":3,"stepDescription":"Go to the flower garden","stepDescTextMapHash":3013888940,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7404903,0],"PAINLIBBLDK