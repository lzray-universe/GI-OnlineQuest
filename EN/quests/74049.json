BBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7404903],"talks":[{"talkId":7404903,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7404908","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7404903,"initDialog":740490301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5315],"performCfg":"QuestDialogue/WQ/Fontaine_74049/Q7404903","priority":5,"questId":74049,"showRandomTalkCount":0},"dialogs":[{"nodeId":740490301,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":840749506,"text":"#Awesome, {NICKNAME}! You turned that ugly machine into beautiful components — \"kabam,\" just like that!","nextNodeIds":[740490302]},{"nodeId":740490302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":423531962,"text":"Well, it won't be troubling this garden again.","nextNodeIds":[740490303]},{"nodeId":740490303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2464924906,"text":"Some of the flowers have been damaged, but the rest still look like they're in good shape. There shouldn't be any Breacher Primuses coming around to trouble your garden again, so your flowers can now grow strong and healthy!","nextNodeIds":[740490304]},{"nodeId":740490304,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":939817738,"text":"This is great... Still, I've learned my lesson. Such precious flowers require attentive care and diligent protection.","nextNodeIds":[740490305]},{"nodeId":740490305,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":3632085050,"text":"#{NICKNAME}, Paimon... You've brought me such exotic flowers, and you've even helped me defend my garden. How can I ever repay you...","nextNodeIds":[740490306]},{"nodeId":740490306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1113241474,"text":"Aw, no need to be so polite about it!","nextNodeIds":[740490307]},{"nodeId":740490307,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":811903402,"text":"Ah, yes, I know! I picked these flowers myself — they're very precious to me! Can I give them to you?","nextNodeIds":[740490308]},{"nodeId":740490308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":516966026,"text":"#Huh! Um, if these flowers really are that precious, then you should probably start your own garden to plant them in, {NICKNAME}...","nextNodeIds":[740490309]},{"nodeId":740490309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1517983586,"text":"Speaking of which, uh, aren't these Tidalga? Do they really count as flowers?","nextNodeIds":[740490310]},{"nodeId":740490310,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":3432422378,"text":"Tidalga are plants, and they are very beautiful, so of course they're flowers. This is what humans call \"biology\" — I've spent some time studying it so that I can become a great florist in the future. Hehe.","nextNodeIds":[740490311]},{"nodeId":740490311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3572467154,"text":"Paimon feels like there's something kinda off about this, but it's not like Paimon knows too much about plant taxonomy either...","nextNodeIds":[740490312]},{"nodeId":740490312,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":701607890,"text":"I'll continue to work hard towards my goal. I've heard humans say that excellent florists are able to breed new types of flowers, which they then bring to \"horticultural fairs.\"","nextNodeIds":[740490313]},{"nodeId":740490313,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":1254494738,"text":"I want to do that, too — and I want to win \"awards\" there!","nextNodeIds":[740490314]},{"nodeId":740490314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2717792714,"text":"Well, that's very commendable and everything, but Paimon feels like there are still some misunderstandings here that will be hard to explain...","nextNodeIds":[740490315]},{"nodeId":740490315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1036997722,"text":"Her purpose for taking part in a horticultural fair is to show off the new varieties of plants she's made and let humans appreciate them, right?","nextNodeIds":[740490316]},{"nodeId":740490316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2328621690,"text":"The thing is, her senses and aesthetics might be a bit too different from those of humans... Do you think they might find the flowers she breeds... weird?","nextNodeIds":[740490317]},{"nodeId":740490317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1017457154,"text":"You're rather invested in her horticultural career, I see.","nextNodeIds":[740490318]},{"nodeId":740490318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1972959042,"text":"Of course! Paimon's her teacher, you know. If she wins, Paimon'll look good too!","nextNodeIds":[740490319,740490323]},{"nodeId":740490319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":455265394,"text":"There's no need to be too obsessed with winning awards. The most important thing is to be happy with your work.","nextNodeIds":[740490320]},{"nodeId":740490320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":233199682,"text":"That's true. The only person who needs to find the flowers you raise beautiful is you! You don't have to worry too much about what other people think.","nextNodeIds":[740490321]},{"nodeId":740490321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":452038666,"text":"You just need to take care of your garden, watch the lovely flowers, and be happy every day!","nextNodeIds":[740490322]},{"nodeId":740490322,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":2073351042,"text":"Yes! I'll make sure they grow up healthy and strong!","nextNodeIds":[]},{"nodeId":740490323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2346183450,"text":"You've taken your first step toward success.","nextNodeIds":[740490324]},{"nodeId":740490324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":130760130,"text":"That's true. The varieties you come up with will probably be pretty unique, but some people will like that kinda thing!","nextNodeIds":[740490325]},{"nodeId":740490325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1661358098,"text":"Once you finish breeding a new variety, make sure you tell us first, alright?","nextNodeIds":[740490326]},{"nodeId":740490326,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","textMapHash":2983850674,"text":"Of course! You've helped me so much, after all!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7404903,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7404901","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5315"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7404901,7404902,7404903,7404904,7404905],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"Cosanzeana","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174049],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4094720670,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[174049],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHM