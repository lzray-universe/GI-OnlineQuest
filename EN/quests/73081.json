{"mainQuestId":73081,"title":"Encounter in the Woods","description":"Talk to Arakavi in Vanarana, which might help the groundwork for Festival Utsava.","titleTextMapHash":3855179327,"descTextMapHash":947046254,"mainQuestExcel":{"mainQuestId":73081,"titleTextMapHash":3855179327,"title":"Encounter in the Woods","descTextMapHash":947046254,"description":"Talk to Arakavi in Vanarana, which might help the groundwork for Festival Utsava.","chapterId":10076,"mainQuestTag":"MAINQUEST_TAG_RANK_ZERO_WQ","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ73081","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":10076,"descTextMapHash":947046254,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"DIRECT_USE","id":220055},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73081,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1225943337,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73081","mainQuestTag":"MAINQUEST_TAG_RANK_ZERO_WQ","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":73081,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[73033],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3855179327,"type":"WQ","unlockDescTextMapHash":3446753462}},"flow":[{"subQuestId":7308102,"order":1,"stepDescription":"Talk to Arakavi","stepDescTextMapHash":4128983100,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7308103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7308103],"talks":[{"talkId":7308103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7308102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7308103","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7308103,"initDialog":730810301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20656,20646],"performCfg":"QuestDialogue/WQ/Sumeru_73081/Q7308103","priority":5,"questId":73081,"showRandomTalkCount":0},"dialogs":[{"nodeId":730810301,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":3319773546,"text":"It's Arama and the Golden Nara. You are so tall. But the silver one by your side...","nextNodeIds":[730810302]},{"nodeId":730810302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3691516226,"text":"Hmm? What about the silver one?","nextNodeIds":[730810303]},{"nodeId":730810303,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":3624468202,"text":"How should I put it... You must be able to squeeze into the narrowest tree hollows. How convenient!","nextNodeIds":[730810304]},{"nodeId":730810304,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":3100279714,"text":"#Well, based on Nara customs, we should do introductions first. This is Nara {NICKNAME} and Paimon. This is Arakavi. You guys shake hands.","nextNodeIds":[730810305]},{"nodeId":730810305,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":704237482,"text":"You are a little lost, but you shake hands with Arakavi anyway...\\nYou try not to use too much strength.\\nArakavu's hand feels... interesting to the touch.","nextNodeIds":[730810306]},{"nodeId":730810306,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":1735187082,"text":"How fascinating. I've heard a lot about Nara before, but this is the first time I've ever touched one. It's a very special feeling!","nextNodeIds":[730810307]},{"nodeId":730810307,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":3072900050,"text":"It's been a long time since we last hosted a Nara here. Many seeds have grown into trees, and many stories have become legends. That Nara was a good Nara — or so we've heard.","nextNodeIds":[730810308]},{"nodeId":730810308,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":939812546,"text":"#Nara {NICKNAME} is good, too. Strong and brave, like a sapling sprouting out of a rock wall. And they are here to help Arana.","nextNodeIds":[730810309]},{"nodeId":730810309,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":2824690978,"text":"Ah, Arana... It's been a while since we last met. I hope all is well, and that the little Nara at Vimara Village are well, too.","nextNodeIds":[730810310]},{"nodeId":730810310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1738950178,"text":"You know the kids of Vimara Village?","nextNodeIds":[730810311]},{"nodeId":730810311,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":3465271394,"text":"Of course I do!","nextNodeIds":[730810312]},{"nodeId":730810312,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":316491906,"text":"We all do! Arana came back and told us stories about the little Nara. Nara Iotham, Nara Bahram, and Narana are our friends.","nextNodeIds":[730810313]},{"nodeId":730810313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4227834202,"text":"Paimon's not sure that counts as \"knowing someone\"...","nextNodeIds":[730810314]},{"nodeId":730810314,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":702265530,"text":"What counts, then? Do we need to \"shake hands\" after the \"introduction\" like Nara do?","nextNodeIds":[730810315]},{"nodeId":730810315,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":3910946026,"text":"I know what Paimon means. Nara eat and look for \"treasures\" together. Then they know each other, right?","nextNodeIds":[730810316,730810317,730810318]},{"nodeId":730810316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4043922266,"text":"It's not quite that simple, either...","nextNodeIds":[730810321]},{"nodeId":730810321,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":230516074,"text":"As long as we know each other's stories, we know each other. This is because the Aranara's world is a place for songs and dreams.","nextNodeIds":[730810322]},{"nodeId":730810322,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":2125602114,"text":"#Arakavi is right. As long as we hear about Nara {NICKNAME} through songs and see what Nara {NICKNAME} looks like through dreams, it'll count as knowing you.","nextNodeIds":[730810323]},{"nodeId":730810323,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":751145618,"text":"Paimon thinks that we can leave this aside for now... After all, we're already friends!","nextNodeIds":[730810324]},{"nodeId":730810324,"roleType":"TALK_ROLE_NPC","speakerId":20825,"speakerName":"Arama and Arakavi","textMapHash":4202010802,"text":"Good friends!","nextNodeIds":[730810325,730810327]},{"nodeId":730810325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1582730962,"text":"Good friends!","nextNodeIds":[730810328]},{"nodeId":730810328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2941924594,"text":"Yes. Since we're going to celebrate Festival Utsava, Arakavi needs to make some preparations!","nextNodeIds":[730810329]},{"nodeId":730810329,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":2088174266,"text":"That's true. We need the Bija, right? I've sent Arayasa, Aradasa, and Arasudraka to look for Ashvattha's Concourses.","nextNodeIds":[730810330]},{"nodeId":730810330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1616529034,"text":"Spot on! But Paimon's wondering... Why don't you guys know where these concourses are?","nextNodeIds":[730810331]},{"nodeId":730810331,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":3450168938,"text":"Ashvattha's Concourses are very, very sacred places. We don't usually go there. We would prefer to let the Vasara Trees sleep and dream, until all memories come together in Sarva.","nextNodeIds":[730810332]},{"nodeId":730810332,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":2969899602,"text":"The forest will remember. No good thing will ever fade away, and all suffering will come to nourish something beautiful...","nextNodeIds":[730810333]},{"nodeId":730810333,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":64746450,"text":"Anyway, you can find Arayasa, Aradasa, and Arasudraka looking for Ashvattha's Concourses out there. Arama, you go and help them.","nextNodeIds":[730810334]},{"nodeId":730810334,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":1782535066,"text":"#I will. If Nara {NICKNAME} and Paimon run into us in the forest, we can go adventuring together!","nextNodeIds":[730810335]},{"nodeId":730810335,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"Arakavi","textMapHash":3444834338,"text":"#Very well. Nice to have met you, Nara {NICKNAME} and Paimon!","nextNodeIds":[]},{"nodeId":730810327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2928454810,"text":"Now let's talk about business...","nextNodeIds":[730810328]},{"nodeId":730810317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3903316786,"text":"How should I explain this...","nextNodeIds":[730810321]},{"nodeId":730810318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2867429954,"text":"I eat and search for treasures with Paimon.","nextNodeIds":[730810319]},{"nodeId":730810319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1395712986,"text":"Yes! And we're not just \"people who know each other,\" but the best of companions!","nextNodeIds":[730810320]},{"nodeId":730810320,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"Arama","textMapHash":2883923698,"text":"#Good for you, Nara {NICKNAME}, Paimon!","nextNodeIds":[730810321]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7308103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7308103,"order":2,"stepDescription":"Talk to Arakavi","stepDescTextMapHash":2475683844,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7308103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["20656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7308103],"talks":[{"talkId":7308103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","",""