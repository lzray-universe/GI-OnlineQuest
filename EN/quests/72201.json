idden":false,"talkIds":[7220101,7220103],"talks":[{"talkId":7220101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7220101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7220101,"initDialog":722010101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20423],"performCfg":"","priority":5,"questId":72201,"showRandomTalkCount":0},"dialogs":[{"nodeId":722010101,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3258094466,"text":"Ah, kind passers-by, please, please take pity on me...","nextNodeIds":[722010102,722010103]},{"nodeId":722010102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3848911010,"text":"What's happening?","nextNodeIds":[722010104]},{"nodeId":722010104,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":2580949834,"text":"Thank you, thank you for listening to these old bones pour out their woes... *sigh* Come here, come here, do let me say a little more...","nextNodeIds":[722010105]},{"nodeId":722010105,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1299855842,"text":"I have not seen my life take a single good turn, not ever...","nextNodeIds":[722010106]},{"nodeId":722010106,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1484807210,"text":"When I was but a newborn, the presiding priest accidentally knocked a lamp over, burning all the long hair on my aunt's head.","nextNodeIds":[722010107]},{"nodeId":722010107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3258546466,"text":"Oh dear...","nextNodeIds":[722010108]},{"nodeId":722010108,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1879670018,"text":"Later, I contracted some strange illness, and from then on suffered from a chronic ungainliness. Still later on, I fell from my cradle, breaking six ribs...","nextNodeIds":[722010109]},{"nodeId":722010109,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":798952266,"text":"And when I grew a little older, my father hit me over the head with his shovel by mistake as he fought to save my cousin, who had almost choked to death on mushrooms...","nextNodeIds":[722010110]},{"nodeId":722010110,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":2384786282,"text":"And then there was the time when my beloved finch was eaten by the Wen Kamuy our family kept, before that same Wen Kamuy was knocked off a cliff by a boar...","nextNodeIds":[722010111]},{"nodeId":722010111,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":2787292970,"text":"After that, the girl I liked accidentally sacrificed the priest to the Great Thunderbird, and she was exiled from the island...","nextNodeIds":[722010112]},{"nodeId":722010112,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":2282012346,"text":"When I grew up, my grandma died from grief at my ugliness and gloominess, and my grandpa soon followed...","nextNodeIds":[722010113]},{"nodeId":722010113,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":812410978,"text":"Then after that...","nextNodeIds":[722010114]},{"nodeId":722010114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4178390834,"text":"You could at least take comfort in your family, right?","nextNodeIds":[722010115]},{"nodeId":722010115,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":356995226,"text":"Ah, speaking of my family... When I came of age, our witch doctor told me that I wouldn't be able to have children, because I'd grown a... One moment, let me show you...","nextNodeIds":[722010116,722010117]},{"nodeId":722010116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3844527970,"text":"Uh, I'll pass!","nextNodeIds":[722010118]},{"nodeId":722010118,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3462392602,"text":"*sigh* Alright. But would you listen to just one last thing? If you don't mind, I'd like you to do just this last thing for me...","nextNodeIds":[722010119,722010120]},{"nodeId":722010119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1137726642,"text":"Well, go ahead.","nextNodeIds":[722010121]},{"nodeId":722010121,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":4267442042,"text":"Some time ago, I accidentally dropped my golden ring into my wife's grave as I was burying her...","nextNodeIds":[722010122]},{"nodeId":722010122,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1316116706,"text":"That is the last thing I have in my possession, but I dare not dig it out, for fear that her spirit might be angered...","nextNodeIds":[722010123]},{"nodeId":722010123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1687427426,"text":"Uh, so this is a grave-robbing gig?","nextNodeIds":[722010124]},{"nodeId":722010124,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3676195514,"text":"Well, uh... I mean, you're an outsider... You do all sorts of strange things, don't you?","nextNodeIds":[722010125]},{"nodeId":722010125,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":4185144394,"text":"Um. No, no, wait... I meant to say that an outsider like you would be able to avoid angering the local spirits, yes...","nextNodeIds":[722010126]},{"nodeId":722010126,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1721401042,"text":"Go to Chirai Shrine. Her grave should be right beside it...","nextNodeIds":[]},{"nodeId":722010120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2706328458,"text":"As long as it's not some weird stuff again...","nextNodeIds":[722010121]},{"nodeId":722010117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3883306354,"text":"Too much information, thank you!","nextNodeIds":[722010118]},{"nodeId":722010103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2720101658,"text":"Do you need help?","nextNodeIds":[722010104]}]},{"talkId":7220103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7220102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7220101","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7220103,"initDialog":722010301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20423],"performCfg":"","priority":5,"questId":72201,"showRandomTalkCount":0},"dialogs":[{"nodeId":722010301,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":146958650,"text":"Go to Chirai Shrine. Her grave should be right beside it...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7220101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"gui