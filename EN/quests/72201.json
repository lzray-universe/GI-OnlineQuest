yle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7220102","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7220103","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7220102,"initDialog":722010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20423],"performCfg":"","priority":5,"questId":72201,"showRandomTalkCount":0},"dialogs":[{"nodeId":722010201,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1973765386,"text":"Ah-hahahahah! Ah my, ah me... I'm all out of breath...","nextNodeIds":[722010202]},{"nodeId":722010202,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3045879074,"text":"Ahaha... I'm tearing up over here! Ah, dear Chikapu, if only you were here to see this!","nextNodeIds":[722010203,722010204]},{"nodeId":722010203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":602399130,"text":"I gotta admit, you're pissing me off.","nextNodeIds":[722010205]},{"nodeId":722010205,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":138238354,"text":"Hahaha... I'm sorry, I'm sorry. Please, don't be angry...","nextNodeIds":[722010206]},{"nodeId":722010206,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1976343042,"text":"I and my wife have always enjoyed playing pranks on others. We've never pulled the same trick twice, you know? And everyone enjoyed them, too!","nextNodeIds":[722010207]},{"nodeId":722010207,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3225474802,"text":"Later, she suffered from a serious illness and left this world early... She told me then that I had to play a trick on someone in front of her grave, or her spirit wouldn't be able to move on...","nextNodeIds":[722010208]},{"nodeId":722010208,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":844139930,"text":"So I did. It was Chikapu's wish. How did it go? Pretty good, huh?","nextNodeIds":[722010209,722010210,722010211]},{"nodeId":722010209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4076612466,"text":"It was kinda lame.","nextNodeIds":[722010212]},{"nodeId":722010212,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3386274938,"text":"Ah, come on! You outsiders are no fun!","nextNodeIds":[722010213]},{"nodeId":722010213,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3658852538,"text":"Well, I've still got a trusty water-spraying trick, if you'd like to see it... No? Aw, come on!","nextNodeIds":[722010214]},{"nodeId":722010214,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3139014426,"text":"Alright, alright, I'm leaving! See you!","nextNodeIds":[]},{"nodeId":722010210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2477345754,"text":"You nearly got us killed!","nextNodeIds":[722010212]},{"nodeId":722010211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2198318058,"text":"I'm gonna have trouble trusting you from now on...","nextNodeIds":[722010212]},{"nodeId":722010204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":703833394,"text":"Care to share what this is all about?","nextNodeIds":[722010205]}]},{"talkId":7220103,"talkConfi