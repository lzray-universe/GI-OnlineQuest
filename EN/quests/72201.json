tIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7220102","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7220103","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7220102,"initDialog":722010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20423],"performCfg":"","priority":5,"questId":72201,"showRandomTalkCount":0},"dialogs":[{"nodeId":722010201,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1973765386,"text":"Ah-hahahahah! Ah my, ah me... I'm all out of breath...","nextNodeIds":[722010202]},{"nodeId":722010202,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3045879074,"text":"Ahaha... I'm tearing up over here! Ah, dear Chikapu, if only you were here to see this!","nextNodeIds":[722010203,722010204]},{"nodeId":722010203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":602399130,"text":"I gotta admit, you're pissing me off.","nextNodeIds":[722010205]},{"nodeId":722010205,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":138238354,"text":"Hahaha... I'm sorry, I'm sorry. Please, don't be angry...","nextNodeIds":[722010206]},{"nodeId":722010206,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":1976343042,"text":"I and my wife have always enjoyed playing pranks on others. We've never pulled the same trick twice, you know? And everyone enjoyed them, too!","nextNodeIds":[722010207]},{"nodeId":722010207,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3225474802,"text":"Later, she suffered from a serious illness and left this world early... She told me then that I had to play a trick on someone in front of her grave, or her spirit wouldn't be able to move on...","nextNodeIds":[722010208]},{"nodeId":722010208,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":844139930,"text":"So I did. It was Chikapu's wish. How did it go? Pretty good, huh?","nextNodeIds":[722010209,722010210,722010211]},{"nodeId":722010209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4076612466,"text":"It was kinda lame.","nextNodeIds":[722010212]},{"nodeId":722010212,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3386274938,"text":"Ah, come on! You outsiders are no fun!","nextNodeIds":[722010213]},{"nodeId":722010213,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3658852538,"text":"Well, I've still got a trusty water-spraying trick, if you'd like to see it... No? Aw, come on!","nextNodeIds":[722010214]},{"nodeId":722010214,"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","textMapHash":3139014426,"text":"Alright, alright, I'm leaving! See you!","nextNodeIds":[]},{"nodeId":722010210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2477345754,"text":"You nearly got us killed!","nextNodeIds":[722010212]},{"nodeId":722010211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2198318058,"text":"I'm gonna have trouble trusting you from now on...","nextNodeIds":[722010212]},{"nodeId":722010204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":703833394,"text":"Care to share what this is all about?","nextNodeIds":[722010205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7220102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["72201","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["72174","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["3","133223481,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7220101,7220102,7220103],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20423,"speakerName":"Rero","count":27},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":14}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":722010101,"ILHDCGDKKK