NCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2400"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2103501],"talks":[{"talkId":2103501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2103501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2103501,"initDialog":210350101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2400],"performCfg":"","priority":5,"questId":21035,"showRandomTalkCount":0},"dialogs":[{"nodeId":210350101,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1905774290,"text":"*sigh* Que'er...","nextNodeIds":[210350102,210350103]},{"nodeId":210350102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2407296074,"text":"Sun Yu?","nextNodeIds":[210350104]},{"nodeId":210350104,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":764380746,"text":"Traveler? What a coincidence! I didn't expect to see you here...","nextNodeIds":[210350105]},{"nodeId":210350105,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1183406746,"text":"I... I'm doing some training here, and I'm about to leave Liyue soon to travel abroad.","nextNodeIds":[210350106,210350107]},{"nodeId":210350106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":723559842,"text":"What's with the trip away all of a sudden?","nextNodeIds":[210350108]},{"nodeId":210350108,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2044285938,"text":"*sigh* Well, this is kind of embarrassing... I've long been talking about reviving the Guhua Clan, but what I've been doing all this time... This so-called \"seeking the guidance of the adepti\" is merely just me hanging about in Jueyun Karst...","nextNodeIds":[210350109]},{"nodeId":210350109,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1919040562,"text":"Although I'm grateful to Que'er for her company, deep down I'm aware that such behavior is nothing but meaningless to the revival of the Guhua Clan...","nextNodeIds":[210350110]},{"nodeId":210350110,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":417847346,"text":"Some time ago, when I was doing grocery shopping back in the city, I happened to have a conversation with a merchant from Fontaine.","nextNodeIds":[210350111]},{"nodeId":210350111,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":219405346,"text":"He said to me, \"You can't find the solution to a problem at the place of its occurrence.\"","nextNodeIds":[210350112]},{"nodeId":210350112,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":2172401650,"text":"I've pondered over these words for quite a while. Perhaps, this Fontaine merchant was suggesting that I travel to places other than Liyue.","nextNodeIds":[210350113,210350114]},{"nodeId":210350113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":720649154,"text":"Traveling can be eye-opening.","nextNodeIds":[210350115]},{"nodeId":210350115,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1518315962,"text":"That's exactly what I thought! But... Que'er doesn't want to leave Liyue.","nextNodeIds":[210350116]},{"nodeId":210350116,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1421013562,"text":"Usually, her bouts of temper aren't serious and can often even be meant in jest. It doesn't take much for me to placate her.","nextNodeIds":[210350117]},{"nodeId":210350117,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":4037154538,"text":"But this time, she seemed to be really infuriated. No matter what I said, she refused to listen, and she even ran back to the city alone... *sigh*","nextNodeIds":[210350118]},{"nodeId":210350118,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":485891178,"text":"But I'm not gonna bore you further with these trivial things. That aside, Traveler, can I ask you for a favor?","nextNodeIds":[210350119]},{"nodeId":210350119,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":1255235810,"text":"Although I've learned some defensive techniques before, I hardly ever really tried my skills out. If I'm going to travel abroad, I'll definitely run into some sort of fight sooner or later...","nextNodeIds":[210350120]},{"nodeId":210350120,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":3771415234,"text":"Traveler, I've heard many stories of you adventuring all over the world, and you must know a lot of ways to deal with monsters.","nextNodeIds":[210350121]},{"nodeId":210350121,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":4068883586,"text":"Can you accompany me to find some monsters around and fight them? You know, offer me some guidance along the way as well?","nextNodeIds":[210350122,210350123]},{"nodeId":210350122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3792430458,"text":"No problem.","nextNodeIds":[210350125]},{"nodeId":210350125,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":438068418,"text":"Let's see... There's one place where monsters gather right ahead. Let's go there first, shall we?","nextNodeIds":[]},{"nodeId":210350123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1624485930,"text":"I'm afraid you can't see my moves clearly.","nextNodeIds":[210350124]},{"nodeId":210350124,"roleType":"TALK_ROLE_NPC","speakerId":2400,"speakerName":"Sun Yu","textMapHash":3924079418,"text":"Y—You are really that skilled? Hahaha, well, then please do me another favor and slow down a bit.","nextNodeIds":[210350125]},{"nodeId":210350114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3673542106,"text":"Take it simply as a distraction even.","nextNodeIds":[210350115]},{"nodeId":210350107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1922361322,"text":"Aren't you going to revive the Guhua Clan?","nextNodeIds":[210350108]},{"nodeId":210350103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3263613482,"text":"What are you doing here?","nextNodeIds":[210350104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2103501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2400"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2103502,"order":2,"stepDescription":"Defeat all opponents","stepDescTextMapHash":950960540,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q2103501"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q2103503","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q2103501"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133106034","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE