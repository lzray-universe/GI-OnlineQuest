,"IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1405"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2002001],"talks":[{"talkId":2002001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2002001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2002001,"initDialog":200200101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1405,1408],"performCfg":"QuestDialogue/IQ/Mengde_20020/Q2002001","priority":5,"questId":20020,"showRandomTalkCount":0},"dialogs":[{"nodeId":200200101,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":2108755594,"text":"Oh, so that's how it is...","nextNodeIds":[200200102]},{"nodeId":200200102,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3886153314,"text":"Brother, do you know what these plants can do aside from being edible?","nextNodeIds":[200200103]},{"nodeId":200200103,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":1798175210,"text":"How am I supposed to know that?","nextNodeIds":[200200104]},{"nodeId":200200104,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":3959754674,"text":"I just know where you can find them and whether you can eat them or not.","nextNodeIds":[200200105]},{"nodeId":200200105,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3042044098,"text":"Huh... Then I guess I should go check them out myself. Don't worry, I'm just going to gather some plants. I won't go anywhere near those monsters.","nextNodeIds":[200200106]},{"nodeId":200200106,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":896942370,"text":"...Oh, just be careful, will you?","nextNodeIds":[200200107]},{"nodeId":200200107,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":17360906,"text":"I know, I know. Well, I'll be a bit late back today, then.","nextNodeIds":[200200108,200200109]},{"nodeId":200200108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":93900986,"text":"Still training, Anna?","nextNodeIds":[200200110]},{"nodeId":200200110,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3433023626,"text":"Hey there, Traveler! Great timing — I was just planning to go out to observe some plants.","nextNodeIds":[200200111]},{"nodeId":200200111,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3674452266,"text":"Cyrus told me that adventurers will often camp out in the wilds, where foraging is a very important skill.","nextNodeIds":[200200112]},{"nodeId":200200112,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":1336706034,"text":"As such, I'm planning to go investigate some wild plants, check out their features and characteristics, and then commit them to memory slowly.","nextNodeIds":[200200113]},{"nodeId":200200113,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":1414644794,"text":"That way, I'll at least know what I can and cannot eat out there in the future.","nextNodeIds":[200200114]},{"nodeId":200200114,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3141470378,"text":"However, I don't think that pure writing is going to be very intuitive.","nextNodeIds":[200200115]},{"nodeId":200200115,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3866370354,"text":"Traveler, I've heard that you have a gadget known as the Kamera. Is that true?","nextNodeIds":[200200116]},{"nodeId":200200116,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":212369474,"text":"If so, could you help me snap some photos of a few plant species in their natural habitats?","nextNodeIds":[200200117]},{"nodeId":200200117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":907059642,"text":"Sure.","nextNodeIds":[200200118]},{"nodeId":200200118,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":1014038050,"text":"Nice! In that case, could you get me photos of Calla Lilies, Small Lamp Grass, and Cecilias?","nextNodeIds":[200200119]},{"nodeId":200200119,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":225133210,"text":"After that, please help me gather these three plant species. I'd like to keep them as samples.","nextNodeIds":[200200120]},{"nodeId":200200120,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":2558277378,"text":"Images of these plants in their natural habitats, live specimens, and detailed descriptions...","nextNodeIds":[200200121]},{"nodeId":200200121,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3034048058,"text":"The botany section of my handbook looks to be in pretty good shape!","nextNodeIds":[200200122]},{"nodeId":200200122,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":675302930,"text":"Alright then, Traveler, I'm counting on you.","nextNodeIds":[200200123]},{"nodeId":200200123,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":926256810,"text":"The spring in Springvale plays host to large numbers of Calla Lilies, while Small Lamp Grass is common in Wolvendom.","nextNodeIds":[200200124]},{"nodeId":200200124,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":2753397906,"text":"As for Cecilias... it's got to be Starsnatch Cliff.","nextNodeIds":[200200125]},{"nodeId":200200125,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":3315875082,"text":"I'll continue my own plant observations elsewhere in the meantime.","nextNodeIds":[200200126]},{"nodeId":200200126,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"Anna","textMapHash":2843887866,"text":"Once you've got the pictures, let's meet up in the city.","nextNodeIds":[]},{"nodeId":200200109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4216004866,"text":"How's your training coming along?","nextNodeIds":[200200110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2002001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST