pe":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7418102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7418101,"initDialog":741810101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21284,1005],"performCfg":"QuestDialogue/WQ/Fontaine_74181/Q7418101","priority":5,"questId":74181,"showRandomTalkCount":0},"dialogs":[{"nodeId":741810101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2812406778,"text":"What are you doing here? Madame Melo?","nextNodeIds":[741810102]},{"nodeId":741810102,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":1829497402,"text":"Oh, it's you. I heard that no-good husband of mine has a little spot around here, so I figured I'd drop by and check up on him.","nextNodeIds":[741810103]},{"nodeId":741810103,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":4249061210,"text":"But look what I've found.","nextNodeIds":[741810104]},{"nodeId":741810104,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":3137101234,"text":"He actually keeps the photo with him!","nextNodeIds":[741810105]},{"nodeId":741810105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1205104586,"text":"Heh, Uncle Rocher cares deeply about you, Madame.","nextNodeIds":[741810106]},{"nodeId":741810106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":365680762,"text":"We've had our suspicions on you, and Uncle Rocher was the sole voice of dissent. He alone assured us that you could never have committed the crime. We were wondering where he found the confidence to stand up to us...","nextNodeIds":[741810107]},{"nodeId":741810107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":290645906,"text":"Probably used up every last ounce of masculinity he had in him.","nextNodeIds":[741810108]},{"nodeId":741810108,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":2072921962,"text":"Oh... Really?","nextNodeIds":[741810109]},{"nodeId":741810109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":258922682,"text":"Yeah! And didn't he tell you that he lost your locket in gambling? That's not true. He was merely too ashamed to tell the truth.","nextNodeIds":[741810110]},{"nodeId":741810110,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":145371802,"text":"Oh, that? I heard that story a long time ago, but I never believed it.","nextNodeIds":[741810111]},{"nodeId":741810111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1235007578,"text":"Eh?","nextNodeIds":[741810112]},{"nodeId":741810112,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":1211393498,"text":"My husband is many things. He may be timorous, somewhat cowardly, and a bit awkward, but he's also a salt-of-the-earth individual. He could be bamboozled, but he's no degenerate gambler.","nextNodeIds":[741810113]},{"nodeId":741810113,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":2652151762,"text":"I didn't call him out because I was waiting for him to tell me the truth of his own accord.","nextNodeIds":[741810114]},{"nodeId":741810114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3432681138,"text":"Wow, how nice of you. If only we could find him right now...","nextNodeIds":[741810115]},{"nodeId":741810115,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":1366878674,"text":"(Shush... Look over there! I'm 100% certain that he's hiding in that box.)","nextNodeIds":[741810116]},{"nodeId":741810116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3308750898,"text":"(...Huh?)","nextNodeIds":[741810117]},{"nodeId":741810117,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":2467911770,"text":"(It's an old habit of his. Whenever we'd get into a tiff, he'd go and hide in the nearest closet. And to think he thought I didn't know.)","nextNodeIds":[741810118]},{"nodeId":741810118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1009204458,"text":"(Do you want us to fetch him for you?)","nextNodeIds":[741810119]},{"nodeId":741810119,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":97265106,"text":"(No need to inconvenience yourself. Let's see how long he can hold out in there.)","nextNodeIds":[741810120]},{"nodeId":741810120,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":660876690,"text":"Right, there's one other thing I could use your help with. If you ever run into Curve and Agent Talochard, please tell them the following:","nextNodeIds":[741810121]},{"nodeId":741810121,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":1642652146,"text":"I've tidied up a few of the rooms, so they're welcome here any time. Of course, the House of Lombroso is also open to the two of you.","nextNodeIds":[741810122]},{"nodeId":741810122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1693940770,"text":"#But... {NICKNAME}...","nextNodeIds":[741810123]},{"nodeId":741810123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3484053386,"text":"Alright, we get it, Madame.","nextNodeIds":[741810124]},{"nodeId":741810124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":181421130,"text":"Okay... then we'll get out of your hair. Paimon does hope Uncle Rocher will come out soon. Have a nice day!","nextNodeIds":[741810125]},{"nodeId":741810125,"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","textMapHash":1789994522,"text":"Thank you. And best wishes to you, too. May you find the answers to all your questions.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7418101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7418101,7418102],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21284,"speakerName":"Melo Lombroso","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","co