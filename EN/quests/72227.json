ority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7222701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7216712","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7222701,"initDialog":722270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20453],"performCfg":"QuestDialogue/WQ/Inazuma_72227/Q7222701","priority":5,"questId":72227,"showRandomTalkCount":0},"dialogs":[{"nodeId":722270101,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":3768529274,"text":"You two look so cool while you're fighting!","nextNodeIds":[722270102]},{"nodeId":722270102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3166303306,"text":"Oh, you're here too, Ruu!","nextNodeIds":[722270103,722270104]},{"nodeId":722270103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3008626978,"text":"Are you alright?","nextNodeIds":[722270105]},{"nodeId":722270105,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2532271122,"text":"I'm fine, don't worry!","nextNodeIds":[722270106]},{"nodeId":722270106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3684582554,"text":"About those monsters...","nextNodeIds":[722270108]},{"nodeId":722270108,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2567684642,"text":"I don't know where they came from either.","nextNodeIds":[722270109]},{"nodeId":722270109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3518644418,"text":"They sure don't look native to this place.","nextNodeIds":[722270110]},{"nodeId":722270110,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":3394968274,"text":"Mm-hmm. In the past, we didn't have any such monsters on our island. There weren't any furry people or big machines either.","nextNodeIds":[722270111]},{"nodeId":722270111,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2842202538,"text":"In the past, we used to have this native animal we called \"Wen Kamuy.\" They were very gentle... and very delicious, too.","nextNodeIds":[722270112]},{"nodeId":722270112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4006864786,"text":"Haven't seen those around.","nextNodeIds":[722270113]},{"nodeId":722270113,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2415233386,"text":"I thought so too. I don't know when it happened, but they all seem to have vanished, and these monsters appeared in their place.","nextNodeIds":[722270114]},{"nodeId":722270114,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":251841082,"text":"Maybe they came in from outside the Sea of Fog...","nextNodeIds":[722270115]},{"nodeId":722270115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":822790810,"text":"There are hilichurls in the outside world too.","nextNodeIds":[722270116]},{"nodeId":722270116,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":4212134642,"text":"Isn't that really dangerous?","nextNodeIds":[722270117,722270119]},{"nodeId":722270117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2463774906,"text":"It can be, yes.","nextNodeIds":[722270118]},{"nodeId":722270118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1416176794,"text":"But adventuring is really fun, too!","nextNodeIds":[722270120]},{"nodeId":722270120,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2316848602,"text":"I'd love to go on adventures, too!","nextNodeIds":[722270121]},{"nodeId":722270121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2154010170,"text":"Hehe, Paimon's sure that you'll be a wonderful adventurer when you're all grown up!","nextNodeIds":[722270122]},{"nodeId":722270122,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2078559146,"text":"You bet!","nextNodeIds":[722270123]},{"nodeId":722270123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2917296114,"text":"Leave this perch to us as well. There are monsters about, so you might be in danger if you just run around like that.","nextNodeIds":[722270124]},{"nodeId":722270124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3504737250,"text":"Leave this to us.","nextNodeIds":[]},{"nodeId":722270119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2206076586,"text":"Adventuring is still really fun, though.","nextNodeIds":[722270120]},{"nodeId":722270104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4060707058,"text":"I hope you weren't injured.","nextNodeIds":[722270105]}]},{"talkId":7222702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"para