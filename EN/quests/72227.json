bleTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7222705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7222703,"initDialog":722270301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20453],"performCfg":"QuestDialogue/WQ/Inazuma_72227/Q7222703","priority":5,"questId":72227,"showRandomTalkCount":0},"dialogs":[{"nodeId":722270301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3732415210,"text":"Looks like we're done here as well!","nextNodeIds":[722270302]},{"nodeId":722270302,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":4141073826,"text":"Wow, so this is what a real adventurer can do, huh?","nextNodeIds":[722270303]},{"nodeId":722270303,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":1130400146,"text":"I mean, other people did come here before.","nextNodeIds":[722270304]},{"nodeId":722270304,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2597221746,"text":"But none of them were as strong as you and Paimon!","nextNodeIds":[722270305]},{"nodeId":722270305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2131795634,"text":"Others!","nextNodeIds":[722270306]},{"nodeId":722270306,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":4050283354,"text":"Yeah, they came to look for Maushiro.","nextNodeIds":[722270307,722270308]},{"nodeId":722270307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1399467218,"text":"Huh, then Sumida must've...","nextNodeIds":[722270309]},{"nodeId":722270309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1119474946,"text":"Paimon doesn't get it, though. What are these Maushiro? We've heard that they're traditional instruments that the people here use...","nextNodeIds":[722270310]},{"nodeId":722270310,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2424459946,"text":"Yup~ They make sounds and stuff.","nextNodeIds":[722270311]},{"nodeId":722270311,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":3864156250,"text":"It's hard for us to see in this fog, right? That's why we use the Maushiro to tell others where we are.","nextNodeIds":[722270312]},{"nodeId":722270312,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2629882442,"text":"I mean, it sure beats yelling! That really hurts the throat.","nextNodeIds":[722270313]},{"nodeId":722270313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2745465370,"text":"It's true that you can't see anything around here...","nextNodeIds":[722270314]},{"nodeId":722270314,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":1757524090,"text":"Right?","nextNodeIds":[722270315]},{"nodeId":722270315,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2708112330,"text":"Da... Grandpa Mata said that the Maushiro can help the souls of those lost in the fog to find their way back home, so they're very important.","nextNodeIds":[722270316]},{"nodeId":722270316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3635905714,"text":"So they're that important, huh?","nextNodeIds":[722270317]},{"nodeId":722270317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2928532690,"text":"No wonder you need them in the ceremony.","nextNodeIds":[722270318]},{"nodeId":722270318,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":2564528130,"text":"That's right. I'm sure you'll both enjoy it very much!","nextNodeIds":[722270319]},{"nodeId":722270319,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":3736936746,"text":"You guys go first. I'd like to stay under the tree for while more.","nextNodeIds":[722270320]},{"nodeId":722270320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2183156562,"text":"Sure you'll be alright? There might be monsters out there...","nextNodeIds":[722270321]},{"nodeId":722270321,"roleType":"TALK_ROLE_NPC","speakerId":20453,"speakerName":"Ruu","textMapHash":1320475586,"text":"I'll be fine!","nextNodeIds":[]},{"nodeId":722270308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4053251402,"text":"No wonder Katheryne had this pegged as a toughie...","nextNodeIds":[722270309]}]},{"talkId":7222706,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID