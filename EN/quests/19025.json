,"roleType":"TALK_ROLE_NPC","speakerId":1023,"speakerName":"Chongyun","textMapHash":738281626,"text":"Let's go.","nextNodeIds":[]},{"nodeId":190250515,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1240561922,"text":"Good thing you weren't the ghost.","nextNodeIds":[190250516]},{"nodeId":190250516,"roleType":"TALK_ROLE_NPC","speakerId":1023,"speakerName":"Chongyun","textMapHash":4033857410,"text":"Hehe, right. It might've taken me hours to find anyone.","nextNodeIds":[190250517]},{"nodeId":190250509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2764112634,"text":"But you can be easily seen here.","nextNodeIds":[190250510]},{"nodeId":190250510,"roleType":"TALK_ROLE_NPC","speakerId":1023,"speakerName":"Chongyun","textMapHash":4224960810,"text":"Hmm... I guess I was so nervous that I neglected the most important thing.","nextNodeIds":[190250511]},{"nodeId":190250503,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1734675226,"text":"...Why would you hide here?","nextNodeIds":[190250504]}]}],"questNarration":[],"talkIds":[1902503,1902504,1902505,1902506,1902507,1902508],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1023,"speakerName":"Chongyun","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":10902,"speakerName":"Little Le","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":10901,"speakerName":"Dalong","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3137010382,"CHECNJEMEFE":{"10901":[5030],"10902":[5030]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":3003,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/COOP