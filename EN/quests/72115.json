,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7211502,"order":2,"stepDescription":"Talk to Xavier","stepDescTextMapHash":383756548,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7211501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3162","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7211501,7211502],"talks":[{"talkId":7211501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7211502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7211501,"initDialog":721150101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3162],"performCfg":"","priority":5,"questId":72115,"showRandomTalkCount":0},"dialogs":[{"nodeId":721150101,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":675340698,"text":"#Hello there, my dear, gallant {F#girl}{M#boy}! I have good news and bad news regarding the Mikage Furnace. Which would you like to hear first?","nextNodeIds":[721150102,721150106]},{"nodeId":721150102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":467319306,"text":"Let's have the good news.","nextNodeIds":[721150103]},{"nodeId":721150103,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2697980346,"text":"The good news is that the core's only suffered some minor damage. It is still within my power to fix it.","nextNodeIds":[721150104]},{"nodeId":721150104,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":4129016882,"text":"The bad news, however, is that the Fatui poking around in there don't seem to appreciate this piece of good news.","nextNodeIds":[721150105]},{"nodeId":721150105,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2341203258,"text":"They very much seem to be searching for a way to get their grubby hands on the Tatarigami core.","nextNodeIds":[721150111]},{"nodeId":721150111,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1930991898,"text":"But if we let them meddle any further, the Tatarigami's power will get out of control. This entire island will be blown sky-high with us still on it.","nextNodeIds":[721150112]},{"nodeId":721150112,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1768505634,"text":"However, if we focus solely on the Fatui, the Tatarigami energy built up inside the containment dome will eventually reach its limit all the same...","nextNodeIds":[721150113]},{"nodeId":721150113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":658889826,"text":"So we need to deal with both of them at the same time?","nextNodeIds":[721150114]},{"nodeId":721150114,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2769973474,"text":"Well... Put simply, academically speaking, in an objective sense...","nextNodeIds":[721150115]},{"nodeId":721150115,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2682621330,"text":"We are facing two separate problems here: the Fatui and the Tatarigami.","nextNodeIds":[721150116]},{"nodeId":721150116,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2980668698,"text":"But with how the situation is inside the Mikage Furnace, whichever problem we choose to tackle, we're likely to have to face the other in the process.","nextNodeIds":[721150117]},{"nodeId":721150117,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3729882018,"text":"So, ultimately, the fact of the matter is—","nextNodeIds":[721150118]},{"nodeId":721150118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2848098314,"text":"You mean to say, \"yes.\"","nextNodeIds":[721150119]},{"nodeId":721150119,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":4025893498,"text":"Um, yes, that's correct. We need to deal with both of them at the same time.","nextNodeIds":[721150120]},{"nodeId":721150120,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1526137986,"text":"But one step at a time. As the Liyue saying goes, \"don't rush to eat hot tofu, or you'll burn your tongue.\"","nextNodeIds":[721150121]},{"nodeId":721150121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3979949954,"text":"How come you know Liyue proverbs?","nextNodeIds":[721150122]},{"nodeId":721150122,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3039635450,"text":"We've been to Liyue before. I'd consider this little gem of wisdom a souvenir from the trip.","nextNodeIds":[721150123]},{"nodeId":721150123,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1456689954,"text":"I have a lot more of these souvenirs where that one came from. I must confess to having imbibed all of my \"souvenirs\" from Mondstadt, though... they were really very good.","nextNodeIds":[721150124]},{"nodeId":721150124,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":4058683378,"text":"Let's get back on track. I have a teensy-tiny plan to fix this Mikage Furnace situation, but I will need your help.","nextNodeIds":[721150125,721150127]},{"nodeId":721150125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2263423530,"text":"You got it!","nextNodeIds":[721150126]},{"nodeId":721150126,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3286305666,"text":"Ha! Forthright and ready for a fight! That's what I like about you!","nextNodeIds":[721150131]},{"nodeId":721150131,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":4020585674,"text":"Ahem. I digress. Now, hold on to these Sensor Beacons, if you please.","nextNodeIds":[721150132]},{"nodeId":721150132,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2647201050,"text":"I need you to place them in a number of locations for me.","nextNodeIds":[721150133]},{"nodeId":721150133,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":546234114,"text":"What these Sensor Beacons will do is gather data on the density and distribution of Tatarigami energy within the Mikage Furnace. Once armed with this data, I should be able to come up with a more detailed plan.","nextNodeIds":[721150134,721150136]},{"nodeId":721150134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1994263202,"text":"Leave it to me, then.","nextNodeIds":[721150135]},{"nodeId":721150135,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":597352786,"text":"I shall leave it in your hands, indeed.","nextNodeIds":[721150141]},{"nodeId":721150141,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":948497410,"text":"I will mark the locations for the beacons on your map. I'll be counting on you, Traveler!","nextNodeIds":[]},{"nodeId":721150136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4263277890,"text":"How do these beacons work?","nextNodeIds":[721150137]},{"nodeId":721150137,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2162518754,"text":"The simplest way to explain it is that they are instruments that use elemental power to quantify and calculate all other sorts of energy.","nextNodeIds":[721150138]},{"nodeId":721150138,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":4149280266,"text":"Well, I say \"simple,\" but it's not actually that easy to explain... But I suppose we could start from the theory of the seven elements! Now then—","nextNodeIds":[721150139]},{"nodeId":721150139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1913015138,"text":"No, no, you don't need to go on.","nextNodeIds":[721150140]},{"nodeId":721150140,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1092158906,"text":"Well, as you wish.","nextNodeIds":[721150141]},{"nodeId":721150127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3994857666,"text":"Well, what do I get out of this?","nextNodeIds":[721150128]},{"nodeId":721150128,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":1379504218,"text":"Hmm... how about the undiscovered treasures of this island, and some \"leftover materials\" from inside the Mikage Furnace?","nextNodeIds":[721150129]},{"nodeId":721150129,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3238331818,"text":"I'm sure there must some things of note inside the Mikage Furnace, what with it being the largest smelting facility in Inazuma and all.","nextNodeIds":[721150130]},{"nodeId":721150130,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2828722418,"text":"Of course, as someone who does not possess a Vision, I am unable to enter the Mikage Furnace at present, nor would I really know about what's going on in there.","nextNodeIds":[721150131]},{"nodeId":721150106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1903268402,"text":"*sigh* Let's hear the bad news.","nextNodeIds":[721150107]},{"nodeId":721150107,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3225523178,"text":"The bad news is that the Fatui are still poking around inside the Furnace.","nextNodeIds":[721150108]},{"nodeId":721150108,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":2808864370,"text":"They very much seem to be searching for a way to get their grubby hands on the Tatarigami core.","nextNodeIds":[721150109]},{"nodeId":721150109,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":3733514978,"text":"The good news is that the core hasn't suffered much damage, so I can take care of it myself.","nextNodeIds":[721150110]},{"nodeId":721150110,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"Xavier","textMapHash":4289991802,"text":"Obviously, the Fatui will be none too pleased to hear that.","nextNodeIds":[721150111]}]},{"talkId":7211502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7211502","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7211508","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"para