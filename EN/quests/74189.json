rity":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7418905","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7418905,"initDialog":741890501,"nextRandomTalks":[],"nextTalks":[],"npcId":[5285],"performCfg":"QuestDialogue/WQ/Fontaine_74189/Q7418905","priority":5,"questId":74189,"showRandomTalkCount":0},"dialogs":[{"nodeId":741890501,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2557398586,"text":"One moment please. Would you like to hear a secret about the treasure?","nextNodeIds":[741890502]},{"nodeId":741890502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2638381266,"text":"What secret?","nextNodeIds":[741890503]},{"nodeId":741890503,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":3941067410,"text":"It has to do with treasure and the key to opening the gate. How does that sound? Interested?","nextNodeIds":[741890504,741890505]},{"nodeId":741890504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2041490122,"text":"You're not asking me to fight monsters again, are you?","nextNodeIds":[741890506]},{"nodeId":741890506,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":3471207298,"text":"Of course not! We wouldn't dream of asking tavern guests to run errands.","nextNodeIds":[741890507]},{"nodeId":741890507,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":3961728034,"text":"See this naval artillery by my side and the rubble it's pointed at?","nextNodeIds":[741890508]},{"nodeId":741890508,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2507444514,"text":"Activate the cannon and blow up those rocks, and any treasure you uncover is yours for the taking.","nextNodeIds":[741890509]},{"nodeId":741890509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1151146026,"text":"Who on Teyvat named that cannon?","nextNodeIds":[741890510]},{"nodeId":741890510,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":389508442,"text":"The helmsman did. I'm not entirely sure myself where he acquired it.","nextNodeIds":[741890511,741890512]},{"nodeId":741890511,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3280237490,"text":"Out with it. What parts are missing?","nextNodeIds":[741890513]},{"nodeId":741890513,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":3418744746,"text":"I think you've been misinformed, friend. The cannon is entirely intact and fully powered. I tend to it every day.","nextNodeIds":[741890514]},{"nodeId":741890514,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2177907106,"text":"But before you activate the cannon, I would like you to answer several questions.","nextNodeIds":[741890515]},{"nodeId":741890515,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2010825922,"text":"It's per the request from the helmsman. He called it a good source of amusement for guests at the tavern, something to slow down their drinking and keep them here longer.","nextNodeIds":[741890516]},{"nodeId":741890516,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3116261066,"text":"I'm not sure about this, but ask away.","nextNodeIds":[741890517]},{"nodeId":741890517,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":3041699514,"text":"Question 1: How many tables are there in The Rusty Rudder?","nextNodeIds":[741890518]},{"nodeId":741890518,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":1361050434,"text":"Question 2: How many employees do we have at The Rusty Rudder?","nextNodeIds":[741890519]},{"nodeId":741890519,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":3501087562,"text":"Question 3: What is not served in The Rusty Rudder?","nextNodeIds":[741890520]},{"nodeId":741890520,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":4127163762,"text":"That's it. You only need to answer these three questions correctly to activate the cannon, blow up the rubble, and get the treasure.","nextNodeIds":[741890521]},{"nodeId":741890521,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3974110658,"text":"What will happen after I get the treasure?","nextNodeIds":[741890522]},{"nodeId":741890522,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2093068826,"text":"After that, I'll find the right time to place another suitable prize in the cave and seal it with rubble.","nextNodeIds":[741890523]},{"nodeId":741890523,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2749740186,"text":"The treasure is waiting to be claimed once the next guest activates the artillery.","nextNodeIds":[741890524,741890525]},{"nodeId":741890524,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2719199114,"text":"That's a lot of work for you.","nextNodeIds":[741890528]},{"nodeId":741890528,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":616698482,"text":"That's all. You may look for the answers now. Meanwhile, I'll stay here and wait for you.","nextNodeIds":[]},{"nodeId":741890525,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":931299330,"text":"Talk about a horrible boss.","nextNodeIds":[741890526]},{"nodeId":741890526,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2685543738,"text":"I find it hard to disagree with your remark, but I have yet to find a way to point the cannon at the helmsman without him detecting it.","nextNodeIds":[741890527]},{"nodeId":741890527,"roleType":"TALK_ROLE_NPC","speakerId":5285,"speakerName":"Permingeat","textMapHash":2042888034,"text":"Besides, rashly shooting in the wrong direction may harm other guests at the tavern, which stands in conflict with my moral principles.","nextNodeIds":[741890528]},{"nodeId":741890512,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1150301274,"text":"Out with it. How is it powered?","nextNodeIds":[741890513]},{"nodeId":741890505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1966059874,"text":"You're not asking me to find someone or something for you again, are you?","nextNodeIds":[741890506]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7418905,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133412072"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST