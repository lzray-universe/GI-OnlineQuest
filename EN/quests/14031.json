inishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1403104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1403101,"initDialog":140310101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1077,1075],"performCfg":"QuestDialogue/LQ/Clorinde_14031/Q1403101","priority":5,"questId":14031,"showRandomTalkCount":0},"dialogs":[{"nodeId":140310101,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":3746722218,"text":"...Still no dice?","nextNodeIds":[140310102]},{"nodeId":140310102,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":227859178,"text":"Not at all, and I've asked pretty much everyone in the Court of Fontaine already.","nextNodeIds":[140310103]},{"nodeId":140310103,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":2349570418,"text":"Lynette's ears drooped as soon as she heard that we'd have to be out and about for days on end. And Freminet... he hid himself under his helmet as soon as he realized there'd be people around that he didn't know.","nextNodeIds":[140310104]},{"nodeId":140310104,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":1159237674,"text":"What about Chiori and Charlotte? I feel like both of them would be more than up to it.","nextNodeIds":[140310105]},{"nodeId":140310105,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":4264223354,"text":"I've asked them already, but they're both pretty busy right now. I just gave the members of the Spina a few days off, too, so I don't want to bother them, either...","nextNodeIds":[140310106]},{"nodeId":140310106,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":2428432178,"text":"Hmm... This is getting pretty difficult.","nextNodeIds":[140310107]},{"nodeId":140310107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2207224434,"text":"Navia! Clorinde! What's up?","nextNodeIds":[140310108]},{"nodeId":140310108,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":445725250,"text":"Oh my! Well if it isn't my dear partners! How are you all doing?","nextNodeIds":[140310109]},{"nodeId":140310109,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":298265154,"text":"Ha... Navia!","nextNodeIds":[140310110]},{"nodeId":140310110,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":160270314,"text":"Huh? ...Ooh! You mean...","nextNodeIds":[140310111]},{"nodeId":140310111,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":1826863970,"text":"Yep, this is our chance...","nextNodeIds":[140310112,140310113]},{"nodeId":140310112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3414748730,"text":"...Wh—What are you going to do!?","nextNodeIds":[140310114]},{"nodeId":140310114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3256281498,"text":"Do you need our help with something...?","nextNodeIds":[140310115]},{"nodeId":140310115,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":2554334682,"text":"Precisely! My dear partners, we've got a huge problem right now that only you can solve!","nextNodeIds":[140310116]},{"nodeId":140310116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3666229474,"text":"Woah! For real?","nextNodeIds":[140310117]},{"nodeId":140310117,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":1848922202,"text":"Absolutely. We've already exhausted all our other options.","nextNodeIds":[140310118,140310119]},{"nodeId":140310118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":974393186,"text":"What kind of problem?","nextNodeIds":[140310120]},{"nodeId":140310120,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":234826506,"text":"#{NICKNAME}, Paimon...","nextNodeIds":[140310121]},{"nodeId":140310121,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":883530698,"text":"Would you join us, and play \"Marechaussee Hunter: Judgment Day\"!?","nextNodeIds":[140310122]},{"nodeId":140310122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4236244586,"text":"Marechaussee what now?","nextNodeIds":[140310123]},{"nodeId":140310123,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":1530380058,"text":"It's a new game script by the Tabletop Troupe, a local roleplay adventure club.","nextNodeIds":[140310124]},{"nodeId":140310124,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":946144962,"text":"Ever heard of the Tabletop Troupe? They put out games that allow you to participate in a story and roleplay characters with your friends. I've loved their stuff ever since I was a kid.","nextNodeIds":[140310125]},{"nodeId":140310125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1837185242,"text":"That sounds super interesting!","nextNodeIds":[140310126]},{"nodeId":140310126,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":2006376754,"text":"Clorinde and I are both veteran members of the club. Recently, someone came up with a new script and was looking for people to help playtest it for them.","nextNodeIds":[140310127]},{"nodeId":140310127,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":1605234754,"text":"And when they asked, of course I couldn't refuse. I mean, come on, a brand new script! Nobody has ever played it before!","nextNodeIds":[140310128]},{"nodeId":140310128,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":256814658,"text":"Mm-hmm. Generally speaking, scripts at that level of development have a lot of issues, but I think this one is pretty solid. The author obviously put a lot of work into the story, and the worldbuilding is also quite credible.","nextNodeIds":[140310129]},{"nodeId":140310129,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":1306632986,"text":"Woah, woah, woah! I know I was the one that handed you the script, but some of us haven't read it yet! No spoilers, please!","nextNodeIds":[140310130]},{"nodeId":140310130,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":297690370,"text":"...Anyway, the script calls for a team of four. Ah, yes. We're missing one final player right now.","nextNodeIds":[140310131]},{"nodeId":140310131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2685663370,"text":"You were right, that is a big problem!","nextNodeIds":[140310132]},{"nodeId":140310132,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":557393754,"text":"So... you're saying you'll help us out? I knew I could count on you, partner!","nextNodeIds":[140310133]},{"nodeId":140310133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1598870354,"text":"#Paimon and {NICKNAME} are kind of a package deal. Is that okay?","nextNodeIds":[140310134]},{"nodeId":140310134,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":3225899658,"text":"That's not a problem. I'll adjust the pace based on the actual number of players and ensure that everyone has a good time.","nextNodeIds":[140310135]},{"nodeId":140310135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2913255490,"text":"#Well, {NICKNAME}, what do you think? Wanna play? Paimon will follow your lead.","nextNodeIds":[140310136,140310137]},{"nodeId":140310136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":755857394,"text":"I always help a friend in need.","nextNodeIds":[140310138]},{"nodeId":140310138,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":4237824914,"text":"Well, that solves our problem. You have our thanks.","nextNodeIds":[140310139]},{"nodeId":140310139,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":2498665562,"text":"Woo-hoo! I'll go grab the script manager from the club right away.","nextNodeIds":[140310140]},{"nodeId":140310140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":213349026,"text":"The script manager? Didn't you just say that you gave Clorinde the script?","nextNodeIds":[140310141]},{"nodeId":140310141,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":2988881458,"text":"The club introduced a completely new kind of gameplay for this script.","nextNodeIds":[140310142]},{"nodeId":140310142,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":1111852754,"text":"In this iteration, the Game Master's version of the script is incomplete. The script manager provides the next part of the script only after players have completed the current list of objectives.","nextNodeIds":[140310143]},{"nodeId":140310143,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":2079974690,"text":"On top of that, in order to increase player immersion, the club has created some of the story's sets and scenes in real life. We'll only know where we should go once the script manager reveals the starting location.","nextNodeIds":[140310144]},{"nodeId":140310144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2493705554,"text":"Wow, you're right, whoever wrote this script really did put in a lot of work!","nextNodeIds":[140310145]},{"nodeId":140310145,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":2530212962,"text":"Hehe, and it's got a real healthy amount of suspense, right? I mean, even the GM doesn't know how the story will end!","nextNodeIds":[140310146]},{"nodeId":140310146,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":3404610074,"text":"I look forward to experiencing it with you all.","nextNodeIds":[140310147]},{"nodeId":140310147,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":29483826,"text":"Why don't you go meet up with the others first? They should all be waiting at Chioriya Boutique. I'll come over with the script manager as soon as I find them.","nextNodeIds":[140310148]},{"nodeId":140310148,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":1246415586,"text":"Sounds good. Remember to always watch where you're going, and don't rush.","nextNodeIds":[140310149]},{"nodeId":140310149,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":1980858482,"text":"You say that like I'm six years old or something!","nextNodeIds":[140310150]},{"nodeId":140310150,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":3896438378,"text":"Hmm... Let me think, what kind of character should I play this time?","nextNodeIds":[140310151]},{"nodeId":140310151,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":2650408218,"text":"...I just hope you'll pick up some useful skills this time. Oh, and stop trying to \"persuade\" every animal you come across...","nextNodeIds":[]},{"nodeId":140310137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3784171434,"text":"Count me in for a great script!","nextNodeIds":[140310138]},{"nodeId":140310119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2575645626,"text":"Tell me about it...","nextNodeIds":[140310120]},{"nodeId":140310113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3078523074,"text":"We were just passing through...","nextNodeIds":[140310114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1403101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1077"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1403102,"order":3,"stepDescription":"Meet up with the others at Chioriya Boutique","stepDescTextMapHash":326871060,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1403102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1071"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1403102],"talks":[{"talkId":1403102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1403102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1403102,"initDialog":140310201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1071],"performCfg":"QuestDialogue/LQ/Clorinde_14031/Q1403102","priority":5,"questId":14031,"showRandomTalkCount":0},"dialogs":[{"nodeId":140310201,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":4209363130,"text":"Sorry to keep you waiting.","nextNodeIds":[140310202]},{"nodeId":140310202,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":784705290,"text":"#Ah, you're back! Huh? And you've got {NICKNAME} and Paimon with you, too.","nextNodeIds":[140310203]},{"nodeId":140310203,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":1415715066,"text":"What a pleasant surprise. I assume you'll be joining us for the game, then?","nextNodeIds":[140310204]},{"nodeId":140310204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1603175898,"text":"Lyney! Furina! Paimon didn't know you were playing, too! Are you also members of the Tabletop Troupe?","nextNodeIds":[140310205]},{"nodeId":140310205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":777853234,"text":"Hey, you two.","nextNodeIds":[140310206]},{"nodeId":140310206,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":717657522,"text":"Hmm, I'm more of a casual member, if anything. I haven't taken part in many formal club activities. Lynette, Freminet, and I play something similar at the Hotel Bouffes d'ete sometimes, but I'm usually the GM.","nextNodeIds":[140310207]},{"nodeId":140310207,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":3896539402,"text":"Still, I'm sure it'll be fun being a player for the first time. I'm looking forward to it.","nextNodeIds":[140310208]},{"nodeId":140310208,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":2815448946,"text":"Well, I'm not a member of the club at all. Clorinde simply woke me up first thing this morning, said there was a good script worth experiencing, and asked if I wanted in.","nextNodeIds":[140310209]},{"nodeId":140310209,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":1529020346,"text":"If you're interested, I can give you a referral. That should give you a 40% discount on membership fees.","nextNodeIds":[140310210]},{"nodeId":140310210,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":282181498,"text":"I think I'll wait to see how this experience plays out first, especially when it comes to the quality of the script. If it's sufficiently fun, then I'll join.","nextNodeIds":[140310211]},{"nodeId":140310211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2926477170,"text":"Do you participate in a lot of Tabletop Troupe activities, Clorinde?","nextNodeIds":[140310212]},{"nodeId":140310212,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":2283154850,"text":"You could say that. She's actually one of the few \"Senior Game Masters\" of the Troupe.","nextNodeIds":[140310213]},{"nodeId":140310213,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":377262946,"text":"Ah, right. I knew about that even when she was still my subordinate.","nextNodeIds":[140310214]},{"nodeId":140310214,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":504193594,"text":"...It's nothing, really. Just a small hobby of mine.","nextNodeIds":[140310215]},{"nodeId":140310215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":846755898,"text":"Wow, Paimon's so used to seeing you be all upstanding and intimidating as the Champion Duelist. It's kinda hard to imagine you roleplaying with a bunch of friends...","nextNodeIds":[140310216,140310217]},{"nodeId":140310216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4175920658,"text":"So, if we have a problem with any of the rules...","nextNodeIds":[140310218]},{"nodeId":140310218,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":2635112154,"text":"Surely you jest. I would never intentionally make things difficult for my players.","nextNodeIds":[140310219]},{"nodeId":140310219,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":2909258802,"text":"I maintain a clear boundary between my professional and personal lives. The me you see at court represents the law and order of Fontaine. I put all personal feelings to the side and grant a fair duel to all who seek to defend their honor.","nextNodeIds":[140310220]},{"nodeId":140310220,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":382797994,"text":"But in my personal life, I'm just an ordinary person — someone who feels anger and sadness, just like everyone else.","nextNodeIds":[140310221]},{"nodeId":140310221,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":3277188778,"text":"Well, you say that, but for all the time I've known you, I don't think I've ever seen you cry... I've seen you get angry, sure, but... now I'm wondering whether you were actually mad or if it just looked that way from the outside?","nextNodeIds":[140310222]},{"nodeId":140310222,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":3748907298,"text":"I was probably in work mode during those times.","nextNodeIds":[140310223]},{"nodeId":140310223,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":200000034,"text":"Is that so? Well, in any case, I just feel like even in your personal life, you don't get emotional very often.","nextNodeIds":[140310224]},{"nodeId":140310224,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":297842386,"text":"So, you want to see me cry? That might be a little difficult. A show of anger, though... That might be something I could accomplish.","nextNodeIds":[140310225]},{"nodeId":140310225,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":1087998714,"text":"N—No, that's not what I meant...","nextNodeIds":[140310226]},{"nodeId":140310226,"roleType":"TALK_ROLE_NPC","speakerId":1075,"speakerName":"Navia","textMapHash":4290793778,"text":"I'm back! Here, allow me to introduce you to the script manager, Mr. Florian!","nextNodeIds":[140310227]},{"nodeId":140310227,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":3055609618,"text":"Pleasure to meet you all.","nextNodeIds":[140310228]},{"nodeId":140310228,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3324936026,"text":"Hello! Wait, are you a Champion Duelist too, Mr. Florian?","nextNodeIds":[140310229]},{"nodeId":140310229,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":2539788050,"text":"Oh, no. This is just the costume provided by the club. I occasionally play a few roles in my scripts.","nextNodeIds":[140310230]},{"nodeId":140310230,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"Lyney","textMapHash":719314,"text":"That sounds like a lot of work.","nextNodeIds":[140310231]},{"nodeId":140310231,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":3000890282,"text":"It's nothing. It's the least we can do to give the players a more immersive experience.","nextNodeIds":[140310232]},{"nodeId":140310232,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":66746410,"text":"Anyway, allow me to give you a brief introduction of the script—","nextNodeIds":[140310233]},{"nodeId":140310233,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":3913782914,"text":"This script was adapted from the real history of the Marechaussee Hunters. You all will play the role of Hunters from a bygone era, and resolve a series of events unfolding in the capital.","nextNodeIds":[140310234]},{"nodeId":140310234,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3438352810,"text":"Erm... Paimon's not super familiar with the history of the Marechaussee Hunters. Is that a problem...?","nextNodeIds":[140310235]},{"nodeId":140310235,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":577987946,"text":"Oh, no problem at all. I can give you a brief run down. So, basically, Marechaussee Hunters were people who dedicated themselves to hunting monsters and protecting the city by using a special swordsmanship technique passed down over generations.","nextNodeIds":[140310236]},{"nodeId":140310236,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":173203442,"text":"Their story can be traced back to the ancient Remurian dynasty, as well as the first hunter, Cassiodor...","nextNodeIds":[140310237]},{"nodeId":140310237,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":1647560466,"text":"But, I'll leave the finer details for you to seek out and discover later.","nextNodeIds":[140310238]},{"nodeId":140310238,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":3496138954,"text":"Mhm, and I'll provide additional commentary as the story progresses.","nextNodeIds":[140310239]},{"nodeId":140310239,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":3845460410,"text":"In that case... Ahem! Brave hunters, are you ready to set out on an unknown adventure?","nextNodeIds":[140310240]},{"nodeId":140310240,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4206637962,"text":"Whoa! Just one sentence, and it's like we're in the story already!","nextNodeIds":[140310241]},{"nodeId":140310241,"roleType":"TALK_ROLE_NPC","speakerId":14092,"speakerName":"Florian","textMapHash":894057258,"text":"Aha, I see many a determined gaze before me. Very well. Head over to this location, and begin your heroic journey!","nextNodeIds":[140310242]},{"nodeId":140310242,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"Furina","textMapHash":1493166266,"text":"So as we follow the story, it leads us to specific scenes? Sounds pretty innovative. What does the message in the envelope say?","nextNodeIds":[140310243]},{"nodeId":140310243,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":3138130138,"text":"It's the exact location of the scene, as well as the formal permission to use the venue. Seems like they have everything prepared.","nextNodeIds":[140310244]},{"nodeId":140310244,"roleType":"TALK_ROLE_NPC","speakerId":1077,"speakerName":"Clorinde","textMapHash":2635255066,"text":"Please check all your belongings, everyone, and make sure you haven't forgotten anything. Once you're ready, please follow me to the designated location.","nextNodeIds":[140310245]},{"nodeId":140310245,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1364070514,"text":"Sounds good! Hunter squad, move out!","nextNodeIds":[]},{"nodeId":140310217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":543813722,"text":"Do we have to submit a duel request to you...?","nextNodeIds":[140310218]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1403102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCE