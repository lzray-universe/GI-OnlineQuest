omTalkCount":0},"dialogs":[{"nodeId":716665101,"roleType":"TALK_ROLE_NPC","speakerId":30473,"speakerName":"No-Frills Instant Kill","textMapHash":3879119826,"text":"Nicely done. You beat me.","nextNodeIds":[716665102]},{"nodeId":716665102,"roleType":"TALK_ROLE_NPC","speakerId":30473,"speakerName":"No-Frills Instant Kill","textMapHash":3850865202,"text":"#I'd go as far as to say that it's an honor to lose against {NICKNAME}.","nextNodeIds":[716665103]},{"nodeId":716665103,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":330621914,"text":"Ahhh, so that's how you do it! I never would've thought of that!","nextNodeIds":[716665104]},{"nodeId":716665104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":161803322,"text":"Yup! When you're up against a cunning enemy, you gotta get creative.","nextNodeIds":[716665105]},{"nodeId":716665105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3892854922,"text":"When your tactics fail, you have to change your point of view. In our journeys far and wide, we often have to think on our feet!","nextNodeIds":[716665106]},{"nodeId":716665106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":139959626,"text":"Clinging to old methods can never solve the problem, no matter how hard you try!","nextNodeIds":[716665107]},{"nodeId":716665107,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":429543794,"text":"I think Shinobu said something like that once, too. I guess there's something to it after all...","nextNodeIds":[716665108]},{"nodeId":716665108,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1644271986,"text":"But I'll mull it over some other time. Right now, my focus is on the task at hand — more beetle-fighting!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166651,0],"PAINLIBBLDK":"QUEST_CONTENT_CO