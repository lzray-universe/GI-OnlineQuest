BLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7166650],"talks":[{"talkId":7166650,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["5173","5173006","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["7152901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166650,"initDialog":716665001,"nextRandomTalks":[],"nextTalks":[],"npcId":[30473],"performCfg":"QuestDialogue/WQ/ElectroherculesBattleV2_71666/Q7166650","priority":5,"questId":71529,"showRandomTalkCount":0},"dialogs":[{"nodeId":716665001,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":866404154,"text":"This makes no sense... How did you do that!? My... my reputation is destroyed!","nextNodeIds":[716665002]},{"nodeId":716665002,"roleType":"TALK_ROLE_NPC","speakerId":30473,"speakerName":"No-Frills Instant Kill","textMapHash":1227961794,"text":"It was an honor doing battle with you, good Sir.","nextNodeIds":[716665003]},{"nodeId":716665003,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2624706714,"text":"What the... So polite!","nextNodeIds":[716665004]},{"nodeId":716665004,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3296234626,"text":"Haha! So, been busy losing while we were away, Bull-Chu{RUBY#[S]\"Bona-Fide Beetle Battle King\"}cker?","nextNodeIds":[716665005]},{"nodeId":716665005,"roleType":"TALK_ROLE_NPC","speakerId":30473,"speakerName":"No-Frills Instant Kill","textMapHash":3410750402,"text":"I don't see it that way. Unless the Bona-Fide Beetle Battle King is ready to give up now, he hasn't lost to me yet.","nextNodeIds":[716665006]},{"nodeId":716665006,"roleType":"TALK_ROLE_NPC","speakerId":30473,"speakerName":"No-Frills Instant Kill","textMapHash":2714575178,"text":"In battle, and in life, it's normal to hit setbacks every once in a while. But a setback only turns into a failure if you make the decision to stop trying.","nextNodeIds":[716665007]},{"nodeId":716665007,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1303849970,"text":"Word! Heck yeah! I ain't about to admit defeat yet!","nextNodeIds":[716665008]},{"nodeId":716665008,"roleType":"TALK_ROLE_NPC","speakerId":30473,"speakerName":"No-Frills Instant Kill","textMapHash":2938598522,"text":"Still, there's nothing to be gained from constantly making excuses. Don't put all your energy into talking garbage — spend it on fighting a little harder instead.","nextNodeIds":[716665009]},{"nodeId":716665009,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":702335330,"text":"Oof, burn...","nextNodeIds":[716665010]},{"nodeId":716665010,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":3184389018,"text":"Oni King, this brand of enemy doesn't seem to be your area of expertise. I advise you send in another of your generals and observe the duel in detail.","nextNodeIds":[716665011]},{"nodeId":716665011,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"Grandmaster Hanakado","textMapHash":214197506,"text":"Watching others do battle is also a crucial part of a warrior's training. Some skills, one learns by doing. Others, one learns through observation.","nextNodeIds":[716665012]},{"nodeId":716665012,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3443681522,"text":"Good point, Grandmaster! And good timing, compadre! Oni King's Right Hand, I'm handing the fight over to you!","nextNodeIds":[716665013]},{"nodeId":716665013,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3176555418,"text":"#Hehe, finally it's your turn! Make it count, {NICKNAME}!","nextNodeIds":[716665014,716665015]},{"nodeId":716665014,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4178528538,"text":"Hehe! Piece of cake!","nextNodeIds":[716665016]},{"nodeId":716665016,"roleType":"TALK_ROLE_NPC","speakerId":30473,"speakerName":"No-Frills Instant Kill","textMapHash":4144441754,"text":"#So I'm going head-to-head with the legendary {NICKNAME}? Guess I'd better look sharp...","nextNodeIds":[]},{"nodeId":716665015,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2872331402,"text":"Uh-oh! I'm scared!","nextNodeIds":[716665016]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166650,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE