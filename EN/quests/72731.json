27310706,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":4284354754,"text":"If you'll admit that I'm the stronger beetle fighter, I'll fight you for as many rounds as you want!","nextNodeIds":[727310707]},{"nodeId":727310707,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3777665890,"text":"Huh, looks like Bull-Chucker and Grandmaster Hanakado are still raring to go... Well, let's leave them to it! They can battle beetles till the beetle-battling's done!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7273102,"order":4,"stepDescription":"Talk to Arataki Itto","stepDescTextMapHash":2689993292,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7273102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7273102],"talks":[{"talkId":7273102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7273102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7273102,"initDialog":727310201,"nextRandomTalks":[],"nextTalks":[],"npcId":[13019,1044],"performCfg":"QuestDialogue/WQ/Daoqi_72731/Q7273102","priority":5,"questId":72731,"showRandomTalkCount":0},"dialogs":[{"nodeId":727310201,"roleType":"TALK_ROLE_NPC","speakerId":13019,"speakerName":"Grandmaster Hanakado","textMapHash":598437234,"text":"Hahahahaha...","nextNodeIds":[727310202]},{"nodeId":727310202,"roleType":"TALK_ROLE_NPC","speakerId":13019,"speakerName":"Grandmaster Hanakado","textMapHash":3383421346,"text":"Astounding!","nextNodeIds":[727310203]},{"nodeId":727310203,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1465905258,"text":"Hahahahaha...","nextNodeIds":[727310204]},{"nodeId":727310204,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2363072986,"text":"Amazing!","nextNodeIds":[727310205]},{"nodeId":727310205,"roleType":"TALK_ROLE_NPC","speakerId":13019,"speakerName":"Grandmaster Hanakado","textMapHash":125518250,"text":"Even though your fighting style differs greatly from mine, I resonate strongly with the passion you imbue into your Onikabuto.","nextNodeIds":[727310206]},{"nodeId":727310206,"roleType":"TALK_ROLE_NPC","speakerId":13019,"speakerName":"Grandmaster Hanakado","textMapHash":3623376994,"text":"In time, you shall surely become a true champion of the beetle-fighting world.","nextNodeIds":[727310207]},{"nodeId":727310207,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":157490290,"text":"You're pretty good yourself! You managed to win an impressive 570 out of our 1,141 matches!","nextNodeIds":[727310208]},{"nodeId":727310208,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2233483458,"text":"Of all the beetle-battle marathons I've fought in my time, you've lasted the longest by far! Not gonna lie, I'm impressed!","nextNodeIds":[727310209]},{"nodeId":727310209,"roleType":"TALK_ROLE_NPC","speakerId":13019,"speakerName":"Grandmaster Hanakado","textMapHash":1901402570,"text":"No, I won 571 rounds, so I'm ahead. Also, you have the home advantage. Taking that into account, it is in fact I who am the superior warrior.","nextNodeIds":[727310210]},{"nodeId":727310210,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1833966298,"text":"Huh? Why you gotta be so stubborn? I remember our score clear as day, and Mamoru is our witness!","nextNodeIds":[727310211]},{"nodeId":727310211,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":286584954,"text":"Ain't that right, Mamoru?","nextNodeIds":[727310212]},{"nodeId":727310212,"roleType":"TALK_ROLE_NPC","speakerId":12278,"speakerName":"Mamoru","textMapHash":2721705370,"text":"Boss, I... I really can't take it anymore... Please let me sleep for a while...","nextNodeIds":[727310213]},{"nodeId":727310213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1700650506,"text":"Uhh... Have they been going at it this whole time without a break!?","nextNodeIds":[727310214]},{"nodeId":727310214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":318499706,"text":"Have they been going at it without a break!?","nextNodeIds":[727310215,727310216]},{"nodeId":727310215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":381452714,"text":"The arena must be about to collapse...","nextNodeIds":[727310217]},{"nodeId":727310217,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":686943770,"text":"Fine! Since I'm a generous guy, I can give you one round, no problemo. I'll just defeat you next time!","nextNodeIds":[727310218]},{"nodeId":727310218,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":927411138,"text":"And if you're still not convinced, we'll do the next battle on your home turf. I'll prove that it's about the beetle fighter, not the location!","nextNodeIds":[727310219]},{"nodeId":727310219,"roleType":"TALK_ROLE_NPC","speakerId":13019,"speakerName":"Grandmaster Hanakado","textMapHash":3928940514,"text":"That suits me just fine. Follow me.","nextNodeIds":[727310220]},{"nodeId":727310220,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2254582058,"text":"Oh? Hey, compadre, Flying Lavender Melon, you're finally here!","nextNodeIds":[727310221]},{"nodeId":727310221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2990959154,"text":"Wait a minute, why's Paimon back to Flying Lavender Melon again? Does Paimon only get a good nickname when she's fighting for you?","nextNodeIds":[727310222]},{"nodeId":727310222,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2991879706,"text":"Uh, never mind that for now! Here's your 2-month free ramen voucher, as agreed. Take it!","nextNodeIds":[727310223]},{"nodeId":727310223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3163427154,"text":"Ramen voucher? Oh yeah, right! The ramen!","nextNodeIds":[727310224]},{"nodeId":727310224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2246331922,"text":"Now that's more like it!","nextNodeIds":[727310225,727310226]},{"nodeId":727310225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3963085122,"text":"Time to celebrate!","nextNodeIds":[727310227]},{"nodeId":727310227,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":448175802,"text":"Oh, no, no, no, no. This was just the warmup. The Almighty Arataki Extraordinary and Exhilarating Extreme Beetle Brawl is still to come!","nextNodeIds":[727310228]},{"nodeId":727310228,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":21296154,"text":"After all, things are way too quiet without an audience. We can't just end the event like this!","nextNodeIds":[727310229]},{"nodeId":727310229,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":2059723706,"text":"But the good news is, Grandmaster Hanakado finally let go of his pride and admitted that I'm a strong beetle fighter!","nextNodeIds":[727310230]},{"nodeId":727310230,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":1083225442,"text":"Still, we ain't done with each other just yet. I'll be heading to his home turf alone soon, where I'm gonna defeat him once and for all.","nextNodeIds":[727310231]},{"nodeId":727310231,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":417724530,"text":"Once that happens, he'll have to follow my orders — and by that, I mean he'll help us make the Almighty Arataki Extraordinary and Exhilarating Extreme Beetle Brawl the biggest, baddest event ever!","nextNodeIds":[727310232]},{"nodeId":727310232,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","textMapHash":3112366274,"text":"Thanks again to the two of you. Now, wait here — I'll be back with good news in no time at all!","nextNodeIds":[727310233]},{"nodeId":727310233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3189763634,"text":"Bull-Chucker sure seems like he's having fun, and we got two months' worth of ramen out of it, hee-hee!","nextNodeIds":[727310234,727310235]},{"nodeId":727310234,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3040090410,"text":"It's a win-win situation!","nextNodeIds":[727310236]},{"nodeId":727310236,"roleType":"TALK_ROLE_NPC","speakerId":12276,"speakerName":"Akira","textMapHash":1786665154,"text":"Boss, Boss! There's a letter from Shinobu. Take a look at this...","nextNodeIds":[727310237]},{"nodeId":727310237,"roleType":"TALK_ROLE_NPC","speakerId":12276,"speakerName":"Akira","textMapHash":1353260930,"text":"Huh? Where'd the Boss go? He was beetle fighting right here just a moment ago...","nextNodeIds":[727310238]},{"nodeId":727310238,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1760661762,"text":"Uh, is it urgent? Because Bull-Chucker just left with Grandmaster Hanakado. They said they were going to continue their battle...","nextNodeIds":[727310239]},{"nodeId":727310239,"roleType":"TALK_ROLE_NPC","speakerId":12276,"speakerName":"Akira","textMapHash":125803498,"text":"Well, it's not urgent, just a little unexpected...","nextNodeIds":[727310240]},{"nodeId":727310240,"roleType":"TALK_ROLE_NPC","speakerId":12276,"speakerName":"Akira","textMapHash":2954651642,"text":"You can read it for yourself if you want.","nextNodeIds":[727310241]},{"nodeId":727310241,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3670803618,"text":"What the... So Grandmaster Hanakado is actually part of the Arataki Gang? But his... communication style made Bull-Chucker feel like he was facing a mortal enemy...","nextNodeIds":[727310242]},{"nodeId":727310242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":61687938,"text":"Just as Shinobu expected, Bull-Chucker is spending all his time beetle fighting without resting or eating.","nextNodeIds":[727310243]},{"nodeId":727310243,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":847479434,"text":"But he did get us to organize the Beetle Brawl event for him...","nextNodeIds":[727310244]},{"nodeId":727310244,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4292336546,"text":"I still wouldn't really call that resting, per se.","nextNodeIds":[727310245]},{"nodeId":727310245,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3786824610,"text":"Y'know, Paimon thinks Shinobu deserves to enjoy the ramen voucher more than we do! Why don't we take her for ramen when she gets back?","nextNodeIds":[727310246]},{"nodeId":727310246,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4189402146,"text":"Hmm... Actually, wait a moment.","nextNodeIds":[727310247]},{"nodeId":727310247,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":123650906,"text":"Bull-Chucker didn't tell us which ramen stall this voucher's meant to be used at...","nextNodeIds":[727310248]},{"nodeId":727310248,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2282086762,"text":"...Are we supposed to find the store by ourselves!?","nextNodeIds":[]},{"nodeId":727310235,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1439445346,"text":"Everyone's happy, that's all that matters.","nextNodeIds":[727310236]},{"nodeId":727310226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":467676018,"text":"And the \"Extreme Beetle Brawl\" is a wrap!","nextNodeIds":[727310227]},{"nodeId":727310216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2305952794,"text":"The Onikabuto must be exhausted...","nextNodeIds":[727310248]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7273102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7273101","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1044"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3178279578,"text":"After defeating Grandmaster Hanakado earlier, Bull-Chucker said that he wanted to carry on sparring with him."}],"talkIds":[7273102,7273107],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"Arataki Itto","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":13019,"speakerName":"Grandmaster Hanakado","count":9},{"roleType":"TALK_R