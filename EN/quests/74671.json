{"mainQuestId":74671,"title":"The Peaks and Troughs of Life","description":"Researcher Macadell of the institute seems to be troubled by something...","titleTextMapHash":2568105567,"descTextMapHash":3928397694,"mainQuestExcel":{"mainQuestId":74671,"titleTextMapHash":2568105567,"title":"The Peaks and Troughs of Life","descTextMapHash":3928397694,"description":"Researcher Macadell of the institute seems to be troubled by something...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5159,"luaPath":"Actor/Quest/WQ74671","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5159,"chapterId":0,"descTextMapHash":3928397694,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74671,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3845653961,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74671","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174671],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2568105567,"type":"WQ","unlockDescTextMapHash":1183833710}},"flow":[{"subQuestId":7467101,"order":1,"stepDescription":"Talk to Macadell","stepDescTextMapHash":4262953476,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30395"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467101],"talks":[{"talkId":7467101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7467101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467101,"initDialog":746710101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30395],"performCfg":"QuestDialogue/WQ/Fontaine_74671/Q7467101","priority":5,"questId":74671,"showRandomTalkCount":0},"dialogs":[{"nodeId":746710101,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1721932778,"text":"Blast! Core output is still too inconsistent. My project is done for if it goes on like this...","nextNodeIds":[746710102]},{"nodeId":746710102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2289908978,"text":"What are you doing?","nextNodeIds":[746710103]},{"nodeId":746710103,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":3208254898,"text":"AAAAH! Y—You scared me! It could have turned messy had I pushed this button!","nextNodeIds":[746710104]},{"nodeId":746710104,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1076058234,"text":"Judging by your look... You're not from the Adventurers' Guild.","nextNodeIds":[746710105,746710107]},{"nodeId":746710105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":506243450,"text":"Did you publish a commission with the Guild?","nextNodeIds":[746710106]},{"nodeId":746710106,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1809620810,"text":"No, I don't have the money for that... And I'm no good at dealing with adventurers.","nextNodeIds":[746710109]},{"nodeId":746710109,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1218476410,"text":"I'm just \"collaborating\" on a project with the Adventurers' Guild...","nextNodeIds":[746710110]},{"nodeId":746710110,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":967218874,"text":"Oops, I forgot to introduce myself. I am Macadell, a researcher with the Fontaine Research Institute.","nextNodeIds":[746710111]},{"nodeId":746710111,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1474721186,"text":"The project I worked on was the \"Portable Mini Pneumousia Storage Device.\"","nextNodeIds":[746710112]},{"nodeId":746710112,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":3786285306,"text":"Thanks to the combined efforts of my fellow team members, we built the first prototype.","nextNodeIds":[746710113]},{"nodeId":746710113,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2643103290,"text":"Then... Well, like everyone knows, a huge explosion occurred at the Institute.","nextNodeIds":[746710114]},{"nodeId":746710114,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":252499610,"text":"The project leader and most of the members of the project team perished in the blast.","nextNodeIds":[746710115]},{"nodeId":746710115,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":656155074,"text":"Apart from me, there's basically nobody else who can continue the work and push the research forward...","nextNodeIds":[746710116]},{"nodeId":746710116,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1690695106,"text":"But... given the turmoil within the Institute, I must demonstrate its value as soon as possible in order to keep the project alive.","nextNodeIds":[746710117]},{"nodeId":746710117,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2213936530,"text":"So, after consulting with all parties, the Adventurers' Guild and I reached an accord.","nextNodeIds":[746710118]},{"nodeId":746710118,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":662249266,"text":"I wanted to use the prototype Portable Mini Pneumousia Storage Device as the core to create a Pressurized Impactor.","nextNodeIds":[746710119]},{"nodeId":746710119,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":3691234866,"text":"I wanted to use the operational performance of the Pressurized Impactors to prove the Portable Mini Pneumousia Storage Device's reliability.","nextNodeIds":[746710120]},{"nodeId":746710120,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2889536946,"text":"And I did successfully build the machine, and began operating it.","nextNodeIds":[746710121,746710123]},{"nodeId":746710121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":47150450,"text":"Sounds like everything went fine.","nextNodeIds":[746710122]},{"nodeId":746710122,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":411769322,"text":"Hahaha, yes, indeed... Until the Pressurized Impactor started running.","nextNodeIds":[746710125]},{"nodeId":746710125,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":859768506,"text":"*sigh* I'd get a headache every time I talk about this.","nextNodeIds":[746710126]},{"nodeId":746710126,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1192680354,"text":"I have no idea if the problem is with the prototype's design, or flaws in the Pressurized Impactor's method of energy transfer...","nextNodeIds":[746710127]},{"nodeId":746710127,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1306862738,"text":"The power going from the Portable Mini Pneumousia Storage Device to the Pressurized Impactor always fluctuated wildly.","nextNodeIds":[746710128]},{"nodeId":746710128,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1988041498,"text":"And that made the Impactor's output unpredictable as well!","nextNodeIds":[746710129]},{"nodeId":746710129,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2906705946,"text":"When the output is high, this machine can easily crush rocks. But when output is low, even drilling a hole in mud is challenging.","nextNodeIds":[746710130]},{"nodeId":746710130,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2286645282,"text":"Given the situation with the Institute, it was basically impossible for me to go back and rebuild the Portable Mini Pneumousia Storage Device...","nextNodeIds":[746710131]},{"nodeId":746710131,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2298878714,"text":"I can only install an extra surveillance device on the prototype to monitor the strength of its energy output in real-time.","nextNodeIds":[746710132]},{"nodeId":746710132,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":407528282,"text":"I just have to activate the Pressurized Impactor when the output is at its highest peak to maximize the potential!","nextNodeIds":[746710133,746710135]},{"nodeId":746710133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3789690170,"text":"That's way too convoluted!","nextNodeIds":[746710134]},{"nodeId":746710134,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":823955682,"text":"But that's the best and cheapest solution I could think of... What else can I do?","nextNodeIds":[746710137]},{"nodeId":746710137,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":3178449914,"text":"*sigh* The Adventurers' Guild is probably thinking the same thing. That's why they haven't sent anyone yet...","nextNodeIds":[746710138]},{"nodeId":746710138,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":627968146,"text":"What are we going to do? If we don't have the test data, I can't report back to the Institute...","nextNodeIds":[746710139]},{"nodeId":746710139,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2529814794,"text":"Traveler, if you don't mind, could you help me out?","nextNodeIds":[746710140]},{"nodeId":746710140,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":3441578194,"text":"I assure you, my device is totally reliable! I even made a bunch of plug-ins for it that can enhance its various functionalities!","nextNodeIds":[746710141,746710144]},{"nodeId":746710141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":944427338,"text":"What if I can't get the timing right?","nextNodeIds":[746710142]},{"nodeId":746710142,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1827849698,"text":"It's okay, the worst scenario is... that it doesn't have enough output. It won't blow up or anything.","nextNodeIds":[746710143]},{"nodeId":746710143,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":924746330,"text":"All you have to do is wait for the next energy peak, then turn the machine on to get the maximum output.","nextNodeIds":[746710148]},{"nodeId":746710148,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2885143258,"text":"Relax, Traveler. This machine is totally safe, and... after the test is over, I'll even pay you!","nextNodeIds":[746710149]},{"nodeId":746710149,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2556534962,"text":"Then I'll leave it to you! My future, the future of this machine... And my future place in this project! It's all in your hands!","nextNodeIds":[]},{"nodeId":746710144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1230575706,"text":"It won't blow up on me, will it?","nextNodeIds":[746710145]},{"nodeId":746710145,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":842854818,"text":"That's absolutely not possible. I added a lot of safety and monitoring devices, so the worst case scenario that it doesn't have enough output. An explosion is impossible.","nextNodeIds":[746710146]},{"nodeId":746710146,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":1631795658,"text":"And even if you miss an energy peak, that's all right too.","nextNodeIds":[746710147]},{"nodeId":746710147,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":2882668594,"text":"Just wait for the next energy peak, then turn the machine on to get the maximum output.","nextNodeIds":[746710148]},{"nodeId":746710135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1070862298,"text":"That's not going to work...","nextNodeIds":[746710136]},{"nodeId":746710136,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":3960910018,"text":"Please don't say that! It's the best solution I've got. I swear, it's really useful!","nextNodeIds":[746710137]},{"nodeId":746710123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3729553010,"text":"That doesn't sound like a problem.","nextNodeIds":[746710124]},{"nodeId":746710124,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":199177722,"text":"Yes, other than the machine itself, everything worked perfectly.","nextNodeIds":[746710125]},{"nodeId":746710107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1545807082,"text":"Did you hire adventurers for protection?","nextNodeIds":[746710108]},{"nodeId":746710108,"roleType":"TALK_ROLE_NPC","speakerId":30395,"speakerName":"Macadell","textMapHash":420169906,"text":"I can't afford them. They ask far too much for their services...","nextNodeIds":[746710109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":