BLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[4011713,4011714,4011715,4011716],"talks":[{"talkId":4011713,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4011701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4011713,"initDialog":401171301,"nextRandomTalks":[],"nextTalks":[],"npcId":[10090,1004],"performCfg":"QuestDialogue/EQ/Penumbra_40117/Q4011713","priority":5,"questId":40117,"showRandomTalkCount":0},"dialogs":[{"nodeId":401171301,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":2490211170,"text":"Hey Kaeya, you promised to tell me the story about the Jinni-in-a-bottle if I didn't run off. Remember?","nextNodeIds":[401171302]},{"nodeId":401171302,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":241759130,"text":"Ah, yes. Alright, where did I leave off...?","nextNodeIds":[401171303]},{"nodeId":401171303,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":4159991050,"text":"Oh, I remember! The Jinni came out, and was going to eat the shepherd boy who opened the bottle.","nextNodeIds":[401171304]},{"nodeId":401171304,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3523558978,"text":"Right, as the Jinni opened its wide, menacing mouth, the shepherd boy suddenly had an idea.","nextNodeIds":[401171305]},{"nodeId":401171305,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":3080987346,"text":"Did he throw a Jumpy Dumpty into the Jinni's mouth?","nextNodeIds":[401171306]},{"nodeId":401171306,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":456242154,"text":"Haha, I'm sure that's what he would have done if he had a Jumpy Dumpty.","nextNodeIds":[401171307]},{"nodeId":401171307,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3995942362,"text":"But the shepherd boy didn't have anything like that.","nextNodeIds":[401171314]},{"nodeId":401171314,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2775676338,"text":"He said to the Jinni, \"Wait, how could your massive body fit inside such a small bottle? I won't ever believe it unless I see with my own eyes!\"","nextNodeIds":[401171308]},{"nodeId":401171308,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":2996877026,"text":"The Jinni became angry, and said, \"Mwahaha. Foolish boy, you dare question my powers!?\"","nextNodeIds":[401171309]},{"nodeId":401171309,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":4228829058,"text":"The Jinni then returned inside the bottle and the boy swiftly sealed it shut.","nextNodeIds":[401171310]},{"nodeId":401171310,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":3012527994,"text":"Yay! That mean Jinni won't ever come out again!","nextNodeIds":[401171311]},{"nodeId":401171311,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"Klee","textMapHash":1174258258,"text":"But, can the Jinni sleep inside such a tiny bottle? It's probably not very comfortable...","nextNodeIds":[401171312]},{"nodeId":401171312,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3982909762,"text":"No, but the Jinni was captured and sealed away in the bottle because it did many bad things.","nextNodeIds":[401171313]},{"nodeId":401171313,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"Kaeya","textMapHash":3933882490,"text":"So the most important thing to remember is, if you do something bad and don't want to get locked up, then don't get caught.","nextNodeIds":[401171314]}]},{"talkId":4011714,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4011701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4011714,"initDialog":401171401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1051,1029],"performCfg":"QuestDialogue/EQ/Penumbra_40117/Q4011714","priority":5,"questId":40117,"showRandomTalkCount":0},"dialogs":[{"nodeId":401171401,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":859568498,"text":"Klee said that they discovered some mysterious tracks that you can ride on using a \"super fun Choo-Choo Cart.\"","nextNodeIds":[401171402]},{"nodeId":401171402,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":2122928490,"text":"Ah, I heard something about that, too. Apparently it's a cart that goes zipping along a \"terrifying\" course at an \"uncontrollable\" speed...","nextNodeIds":[401171403]},{"nodeId":401171403,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":51675466,"text":"Yeah, that should be the one. It seems that when the cart rolls down a steep drop, your body would start floating as if it was weightless.","nextNodeIds":[401171404]},{"nodeId":401171404,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":4123337218,"text":"Really? Huh, I heard that Klee's bag almost flew away on the ride. If Kaeya hadn't managed to quickly catch it, countless Jumpy Dumpties would have been thrown into the air.","nextNodeIds":[401171405]},{"nodeId":401171405,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":1990964842,"text":"Oh no, that sounds pretty dangerous...","nextNodeIds":[401171406]},{"nodeId":401171406,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":1277504202,"text":"*sigh* But, if you really want to go for a ride, I'll accompany you if I have time.","nextNodeIds":[401171407]},{"nodeId":401171407,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":2945166106,"text":"Huh? But Eula, how did you know...","nextNodeIds":[401171408]},{"nodeId":401171408,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"Eula","textMapHash":4290333778,"text":"I could tell that you wanted to try it... But let me make this clear, I won't be helping you pick up anything that flies out during the ride. So make sure you take everything out of your pockets beforehand.","nextNodeIds":[401171409]},{"nodeId":401171409,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"Collei","textMapHash":3229736186,"text":"Ah, yes, of course!","nextNodeIds":[]}]},{"talkId":4011715,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"