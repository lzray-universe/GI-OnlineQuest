T","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30349"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369001],"talks":[{"talkId":7369001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7369001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369001,"initDialog":736900101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30349],"performCfg":"QuestDialogue/WQ/Sumeru_73690/Q7369001","priority":5,"questId":73690,"showRandomTalkCount":0},"dialogs":[{"nodeId":736900101,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":1567917906,"text":"Hello there! I'm Daya from Kshahrewar. Are you here to take part in the Wisdom Gala too?","nextNodeIds":[736900102]},{"nodeId":736900102,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":2298564122,"text":"This is the new game that our Darshan has put forth: \"Project Connectivity\"!","nextNodeIds":[736900103]},{"nodeId":736900103,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":2412295362,"text":"Would you like to have a go at it?","nextNodeIds":[736900104]},{"nodeId":736900104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":100844274,"text":"If I recall, Kshahrewar's specialty is...","nextNodeIds":[736900105]},{"nodeId":736900105,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":3265675490,"text":"We study mechanics and architecture, yes.","nextNodeIds":[736900107]},{"nodeId":736900107,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":3799380202,"text":"Uh, seems like I've gone off-topic. So, to take part in this Gala, many of our students put their heads together...","nextNodeIds":[736900108]},{"nodeId":736900108,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":3124051114,"text":"...And the result was \"Project Connectivity!\"","nextNodeIds":[736900109]},{"nodeId":736900109,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":243141482,"text":"Basically, players will need to use the various objects that we have prepared to... well, create a pathway.","nextNodeIds":[736900110]},{"nodeId":736900110,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":1086976658,"text":"Laying down bridges, setting up stairs... The eventual goal is to create a path for people to travel on that can reach its destination.","nextNodeIds":[736900111]},{"nodeId":736900111,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":906802930,"text":"Once you have finished constructing that road, we will conduct a final verification, just like how we would test completed buildings.","nextNodeIds":[736900112]},{"nodeId":736900112,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":421319794,"text":"Essentially, you just need to set up a safe road to attain success.","nextNodeIds":[736900113,736900114]},{"nodeId":736900113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2862122762,"text":"That sounds rather complicated...","nextNodeIds":[736900115]},{"nodeId":736900115,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":2162050642,"text":"Don't worry, don't worry! You're not being asked to construct anything in real life.","nextNodeIds":[736900116]},{"nodeId":736900116,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":2913749826,"text":"If something goes wrong and the road collapses, we'll just have to rebuild it. We're not putting limits on the number of tries you have either.","nextNodeIds":[736900117]},{"nodeId":736900117,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":3349348762,"text":"Just let your imagination run free and build as beautiful as a road can be!","nextNodeIds":[736900118,736900120]},{"nodeId":736900118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2860097618,"text":"I'll give it a go.","nextNodeIds":[736900119]},{"nodeId":736900119,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":4058594858,"text":"Alright. In that case, if you'll look over this way...","nextNodeIds":[]},{"nodeId":736900120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3782199394,"text":"Sorry, I'm a little busy right now.","nextNodeIds":[736900121]},{"nodeId":736900121,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":432038330,"text":"Ah, is that so... It's alright. Our booth will be open for the entire duration of the Gala.","nextNodeIds":[736900122]},{"nodeId":736900122,"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","textMapHash":1177470186,"text":"Whenever you feel like having a go, you can just come to me.","nextNodeIds":[]},{"nodeId":736900114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3424188202,"text":"I haven't much of a knack for architecture.","nextNodeIds":[736900115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30349"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7369001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30349,"speakerName":"Daya","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173690],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4191531886,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73690/Q7369001","A