E_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[45201],"talks":[{"talkId":45201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["45201","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":45201,"initDialog":4520101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/LQ/Razor1_452/Q45201","priority":1,"questId":452,"showRandomTalkCount":0},"dialogs":[{"nodeId":4520101,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4284973459,"text":"#Hi Paimon, hi {NICKNAME}! What can I do for you?","nextNodeIds":[4520102]},{"nodeId":4520102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2226425107,"text":"Hi Amber~","nextNodeIds":[4520103,4520124]},{"nodeId":4520103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":389507747,"text":"Amber, something has come up...","nextNodeIds":[4520104]},{"nodeId":4520104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3148365851,"text":"Amber, do you know a wolf boy from Wolvendom?","nextNodeIds":[4520105]},{"nodeId":4520105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3783283299,"text":"Who?","nextNodeIds":[4520106]},{"nodeId":4520106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1513759995,"text":"He said you guys hit it off like a mountain on fire...","nextNodeIds":[4520107]},{"nodeId":4520107,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1149385731,"text":"What on earth are you talking about?","nextNodeIds":[4520108]},{"nodeId":4520108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1367473995,"text":"Strange... He said he would wait for you at your regular spot. Did you lose your memory or something?","nextNodeIds":[4520109]},{"nodeId":4520109,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3037303987,"text":"My memory is fine. But you've been eating magic matsutake again, haven't you Paimon?","nextNodeIds":[4520110]},{"nodeId":4520110,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":571797915,"text":"I have no idea what you're talking about.","nextNodeIds":[4520111]},{"nodeId":4520111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3453422291,"text":"Magic matsutake... Remind me what color they are?","nextNodeIds":[4520112]},{"nodeId":4520112,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4018474403,"text":"Purple.","nextNodeIds":[4520113]},{"nodeId":4520113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":88198883,"text":"...Paimon may have had a couple the other day.","nextNodeIds":[4520114]},{"nodeId":4520114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1684536507,"text":"But that's not the point! Paimon's not loopy!","nextNodeIds":[4520115]},{"nodeId":4520115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1853154747,"text":"Do you really not know that boy that lives with the wolves?","nextNodeIds":[4520116]},{"nodeId":4520116,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2159090651,"text":"I. don't. know. what. you're. talking. about.","nextNodeIds":[4520117]},{"nodeId":4520117,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1583031147,"text":"But on the subject of wolves, I've been investigating something recently.","nextNodeIds":[4520118]},{"nodeId":4520118,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1584396043,"text":"In the past, the wolves never dared venture outside of Wolvendom. But now they're getting braver.","nextNodeIds":[4520119]},{"nodeId":4520119,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4049365723,"text":"I heard they attacked a cart fleet near Drunkard Gorge.","nextNodeIds":[4520120]},{"nodeId":4520120,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2534718875,"text":"If you have time, could you come and check out the situation with me?","nextNodeIds":[4520121,4520122]},{"nodeId":4520121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3869425203,"text":"Sure.","nextNodeIds":[4520123]},{"nodeId":4520123,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2012216883,"text":"Awesome! I knew I could count on you, let's go.","nextNodeIds":[]},{"nodeId":4520122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":722034859,"text":"Let's get to it.","nextNodeIds":[4520123]},{"nodeId":4520124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1089655491,"text":"Hey Amber, what's up?","nextNodeIds":[4520125]},{"nodeId":4520125,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3207786555,"text":"Hi... Looks like you've got a bit of time on your hands.","nextNodeIds":[4520126]},{"nodeId":4520126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1014590867,"text":"Uh-oh, here it comes...","nextNodeIds":[4520127]},{"nodeId":4520127,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3409290291,"text":"I've been rushed off my feet recently. An Outrider's duties never end, so... Wanna help?","nextNodeIds":[4520129]},{"nodeId":4520129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1898783275,"text":"Told you so!","nextNodeIds":[4520130,4520131]},{"nodeId":4520130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":776114195,"text":"Sure.","nextNodeIds":[4520132]},{"nodeId":4520132,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3712357731,"text":"Recently, wolves have been attacking the carts at Drunkard Gorge.","nextNodeIds":[4520133]},{"nodeId":4520133,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":418578731,"text":"As you know, wolves are dangerous, but they do have their own rules.","nextNodeIds":[4520134]},{"nodeId":4520134,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1665931523,"text":"Mondstadt's wolves don't normally venture outside of the Brightcrown Mountains and Wolvendom.","nextNodeIds":[4520135]},{"nodeId":4520135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1308383563,"text":"Yes, Paimon heard someone say that those areas do have their own set of rules, even though they are wild and untouched by humans.","nextNodeIds":[4520136]},{"nodeId":4520136,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1853706251,"text":"That's right. So for wolves to be showing up around Drunkard Gorge is very unusual.","nextNodeIds":[4520137]},{"nodeId":4520137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":22090707,"text":"Speaking of wolves, do you happen to know a wolf boy from Wolvendom?","nextNodeIds":[4520138]},{"nodeId":4520138,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3675562499,"text":"Who? I've never heard of anyone like that around Mondstadt.","nextNodeIds":[4520139]},{"nodeId":4520139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4236948747,"text":"Um... What?","nextNodeIds":[4520140]},{"nodeId":4520140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1985207587,"text":"\"The red one, burny girl...\" That ain't you?","nextNodeIds":[4520141]},{"nodeId":4520141,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":493545379,"text":"Burny...? What are you talking about?","nextNodeIds":[4520142]},{"nodeId":4520142,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":263386083,"text":"Anyway, I'm off to Drunkard Gorge to investigate.","nextNodeIds":[4520143]},{"nodeId":4520143,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":319367251,"text":"Come with me!","nextNodeIds":[]},{"nodeId":4520131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1331153115,"text":"What's the issue?","nextNodeIds":[4520132]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[45201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN