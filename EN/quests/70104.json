m":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7010406","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7010402,"initDialog":701040201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1666],"performCfg":"","priority":0,"questId":70104,"showRandomTalkCount":0},"dialogs":[{"nodeId":701040201,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":2767333010,"text":"Did you find my beacons?","nextNodeIds":[701040202]},{"nodeId":701040202,"roleType":"TALK_ROLE_PLAYER","speakerId":0,"speakerName":"Traveler","textMapHash":2111681546,"text":"I did indeed.","nextNodeIds":[701040203]},{"nodeId":701040203,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":3553604858,"text":"Let me see... Yes, these are the ones, alright!","nextNodeIds":[701040204]},{"nodeId":701040204,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":1005915682,"text":"Ugh, look at the state of them... Those monsters clearly weren't gentle with them. But thankfully, they're not completely ruined.","nextNodeIds":[701040205]},{"nodeId":701040205,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":1777419530,"text":"*sigh* Still, I guess I won't be using them in the near future... Ah, can't be helped. I will have to make do with a smaller-scale survey...","nextNodeIds":[701040206]},{"nodeId":701040206,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":3597533106,"text":"I have some other beacons here. Could you set them up on the mountain for me?","nextNodeIds":[701040207,701040209]},{"nodeId":701040207,"roleType":"TALK_ROLE_PLAYER","speakerId":0,"speakerName":"Traveler","textMapHash":1200105298,"text":"Where exactly?","nextNodeIds":[701040208]},{"nodeId":701040208,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":3495846938,"text":"...Is that a yes? I'll take that as a yes! Thanks! I'll mark the spot on the map for you.","nextNodeIds":[701040215]},{"nodeId":701040215,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":742178554,"text":"...There. I've marked them all out. Just put the beacons in those general areas.","nextNodeIds":[701040216]},{"nodeId":701040216,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":2420238306,"text":"Make sure to put them up in high spots. The higher the altitude, the more accurate the survey.","nextNodeIds":[]},{"nodeId":701040209,"roleType":"TALK_ROLE_PLAYER","speakerId":0,"speakerName":"Traveler","textMapHash":3305246362,"text":"Why can't you do it yourself?","nextNodeIds":[701040210]},{"nodeId":701040210,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":322210002,"text":"I don't dare... If not even a whole team of explorers could stand up to those monsters, I'm certainly not going back up there alone.","nextNodeIds":[701040211]},{"nodeId":701040211,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":3012553914,"text":"I can't find any other explorers planning a trip up there at the moment, but I also can't delay this indefinitely.","nextNodeIds":[701040212]},{"nodeId":701040212,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":3397857554,"text":"So, you're the only chance I've got. Seeing as you managed to fetch my beacons back so effortless last time, I think you're more than up to the task.","nextNodeIds":[701040213]},{"nodeId":701040213,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":3877169274,"text":"Thanks once again. I'll be sure to compensate you well!","nextNodeIds":[701040214]},{"nodeId":701040214,"roleType":"TALK_ROLE_NPC","speakerId":1666,"speakerName":"Esther","textMapHash":3529233778,"text":"Wait, let me mark the locations on the map for you...","nextNodeIds":[701040215]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7010402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1666"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7010407,"order":9,"stepDescription":"","stepDescTextMapHash":594918372,"finishConds":[{"BFGALAINLMD":4,"LNHLPKELCAL":[701040701,0],"PAINLIBBLDK":"QUEST_CONTENT_ADD_QUEST_PROGRESS","PPFLKMOMKAI"