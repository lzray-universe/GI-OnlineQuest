{"mainQuestId":75504,"title":"On the Graffiti Road","description":"During this time, you've visited many places in Natlan to gather inspiration at Dopey Dazzler's suggestion, and you've learned a lot. It's time to report back to her...","titleTextMapHash":4115822879,"descTextMapHash":2031533374,"mainQuestExcel":{"mainQuestId":75504,"titleTextMapHash":4115822879,"title":"On the Graffiti Road","descTextMapHash":2031533374,"description":"During this time, you've visited many places in Natlan to gather inspiration at Dopey Dazzler's suggestion, and you've learned a lot. It's time to report back to her...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":2033,"luaPath":"Actor/Quest/WQ75504","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2033,"chapterId":0,"descTextMapHash":2031533374,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75504,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3826675185,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75504","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175504],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4115822879,"type":"WQ","unlockDescTextMapHash":294041022}},"flow":[{"subQuestId":7550401,"order":1,"stepDescription":"Report your recent progress to Dopey Dazzler","stepDescTextMapHash":1511786844,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30609"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7550401],"talks":[{"talkId":7550401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7550401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550401,"initDialog":755040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30609],"performCfg":"QuestDialogue/WQ/Natlan_75504/Q7550401","priority":5,"questId":75504,"showRandomTalkCount":0},"dialogs":[{"nodeId":755040101,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2559064714,"text":"Heya! You're back!","nextNodeIds":[755040102]},{"nodeId":755040102,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":298317106,"text":"Judging by your looks, I assume you've seen some spots, gathered some materials, and found your inspiration?","nextNodeIds":[755040103]},{"nodeId":755040103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1284434346,"text":"Well... sorta? We certainly had fun along the way!","nextNodeIds":[755040104]},{"nodeId":755040104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":333866986,"text":"Having a specific goal in mind helped us notice lots of details we wouldn't have before...","nextNodeIds":[755040105]},{"nodeId":755040105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":881480578,"text":"This material-gathering project's been a real eye-opener for us, and we've come away with lots of samples too!","nextNodeIds":[755040106,755040107]},{"nodeId":755040106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":735636474,"text":"Just a shame that we might not be able to use them all in our graffiti.","nextNodeIds":[755040108]},{"nodeId":755040108,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3605042570,"text":"Oh, take your time, no rush! The whole point of the tour around Natlan was to help you realize what \"avant-garde\" is in the first place.","nextNodeIds":[755040109]},{"nodeId":755040109,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2712104106,"text":"Speaking of which, mind telling me what you've seen and heard?","nextNodeIds":[755040110]},{"nodeId":755040110,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":30609,"speakerName":"Black Screen","textMapHash":3168289586,"text":"You show Dopey Dazzler the graffiti guidebook and the various photos you've taken...","nextNodeIds":[755040111]},{"nodeId":755040111,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":2353279234,"text":"Hmm... Well. Aren't you the conscious photo-taker?","nextNodeIds":[755040112]},{"nodeId":755040112,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3548769290,"text":"I didn't expect you to be so experienced with Kameras as to subconsciously select excellent compositions for all these pictures.","nextNodeIds":[755040113]},{"nodeId":755040113,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3194183082,"text":"If anything, there's a danger I'll be stunting your growth if I say too much. Just a little guidance is all you'll need.","nextNodeIds":[755040114]},{"nodeId":755040114,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":670259610,"text":"Please, take these notes of mine. Just give them a quick flick through when you encounter scenery on your journey. Perhaps they'll help you take pictures of even greater artistry!","nextNodeIds":[755040115]},{"nodeId":755040115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":982906370,"text":"Huh. And here Paimon thought we'd be treated to a picture-by-picture analysis and... Y'know, avant-garde introductory lectures!","nextNodeIds":[755040116]},{"nodeId":755040116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":125459826,"text":"Paimon's also tempted to try doing some graffiti herself...","nextNodeIds":[755040117]},{"nodeId":755040117,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3927051650,"text":"All the more reason to think that you're talented enough for self-driven learning!","nextNodeIds":[755040118]},{"nodeId":755040118,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":480193746,"text":"If anything, too much by-the-books learning might snuff that sort of potential out.","nextNodeIds":[755040119]},{"nodeId":755040119,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":757642762,"text":"As such, I think I need to adjust my role from responsible mentor to an assisting senior artist.","nextNodeIds":[755040120]},{"nodeId":755040120,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1423617346,"text":"Just wait for a rush of inspiration at the opportune moment, then pick your paint jar up and show the world what you've got!","nextNodeIds":[755040121]},{"nodeId":755040121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":579488882,"text":"Huh. We're that talented, are we?","nextNodeIds":[755040122]},{"nodeId":755040122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1732992394,"text":"Hehe... Looks like all the commissions we took from painters and film directors haven't gone to waste!","nextNodeIds":[755040123,755040124]},{"nodeId":755040123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":804381610,"text":"My thanks for the compliments, then.","nextNodeIds":[755040125]},{"nodeId":755040125,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":1335892850,"text":"Relax! You'll get the hang of avant-garde aesthetics on your own in no time!","nextNodeIds":[755040126]},{"nodeId":755040126,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3264181010,"text":"I'm usually over in the Masters of the Night-Wind's lands, prepping for the construction of the Graffiti Alliance's headquarters. If you have any questions, feel free to head over and ask me.","nextNodeIds":[755040127]},{"nodeId":755040127,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","textMapHash":3248345810,"text":"I'll be sure to kit you out with a fine set of graffiti-making implements next time you pop by!","nextNodeIds":[755040128]},{"nodeId":755040128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":755435290,"text":"Nice! So that's where your headquarters are going to be... We'll remember that. Best of luck!","nextNodeIds":[755040129,755040130]},{"nodeId":755040129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1200535130,"text":"This was a pretty great time!","nextNodeIds":[755040131]},{"nodeId":755040131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3751332130,"text":"Let's not forget to flick through Dopey Dazzler's notes when we're free. Can't do our artistic instincts any harm, huh?","nextNodeIds":[755040132]},{"nodeId":755040132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1873405506,"text":"Who knows, we might make a fortune from showing off our skills as graffiti grandmasters someday!","nextNodeIds":[]},{"nodeId":755040130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1812289466,"text":"See you again!","nextNodeIds":[755040131]},{"nodeId":755040124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3039804250,"text":"We'll do our best to figure this out.","nextNodeIds":[755040125]},{"nodeId":755040107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2264484154,"text":"My avant-garde philosophy still needs some refinement.","nextNodeIds":[755040108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30609"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7550401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"\"Dopey Dazzler\"","count":15},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":30609,"speakerName":"Black Screen","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[175504],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2031533374,"CHECNJEMEFE":{"30609":[1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75504/Q7550401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":755040101,"ILHDCGDKKKA":"TALK_