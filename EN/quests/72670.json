{"mainQuestId":72670,"title":"I, Researcher","description":"You meet Hosseini once more as the researcher makes his way back to Sumeru from Inazuma...","titleTextMapHash":3034928031,"descTextMapHash":3764260878,"mainQuestExcel":{"mainQuestId":72670,"titleTextMapHash":3034928031,"title":"I, Researcher","descTextMapHash":3764260878,"description":"You meet Hosseini once more as the researcher makes his way back to Sumeru from Inazuma...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5053,"luaPath":"Actor/Quest/WQ72670","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5053,"chapterId":0,"descTextMapHash":3764260878,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":72670,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3437263401,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ72670","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[172670],"series":5053,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[172670],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3034928031,"type":"WQ","unlockDescTextMapHash":735172670}},"flow":[{"subQuestId":7267001,"order":1,"stepDescription":"Talk to Hosseini","stepDescTextMapHash":4096622844,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30084"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7267001],"talks":[{"talkId":7267001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267001,"initDialog":726700101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30084],"performCfg":"","priority":5,"questId":72670,"showRandomTalkCount":0},"dialogs":[{"nodeId":726700101,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3683245818,"text":"*cough*...","nextNodeIds":[726700102]},{"nodeId":726700102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2408501930,"text":"Hello there.","nextNodeIds":[726700103]},{"nodeId":726700103,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3566165826,"text":"Why hello! Someone suitable's arrived at last, I suppose... *cough*","nextNodeIds":[726700104]},{"nodeId":726700104,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":985241066,"text":"And it's someone I know, too! Well, that's my worries about insufficient samples gone out the window!","nextNodeIds":[726700105]},{"nodeId":726700105,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":649791442,"text":"I've been waiting this whole time, and if it isn't old folks, it's children... That's simply insufficient...","nextNodeIds":[726700106,726700109]},{"nodeId":726700106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":710924250,"text":"...I'm sorry, who are you again?","nextNodeIds":[726700107]},{"nodeId":726700107,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":158403538,"text":"Eh? You've forgotten me already?","nextNodeIds":[726700108]},{"nodeId":726700108,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":95273162,"text":"Oh, come on, I'm not some kind of nefarious villain, there's no need to pretend that we're not familiar or anything.","nextNodeIds":[726700111]},{"nodeId":726700111,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1126542010,"text":"I mean, look, it's me! We met on Ritou, remember? *cough*","nextNodeIds":[726700112]},{"nodeId":726700112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3447402522,"text":"You still seem shady to me...","nextNodeIds":[726700113]},{"nodeId":726700113,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3872266650,"text":"Ugh, alright, maybe you did forget me. *sigh* Alright, let me introduce myself again.","nextNodeIds":[726700114]},{"nodeId":726700114,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1795093074,"text":"I'm Hosseini, a scholar from the Sumeru Akademiya. After a great many tribulations, I finally reached Inazuma to conduct research there.","nextNodeIds":[726700115]},{"nodeId":726700115,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":4256314890,"text":"Unfortunately, doing research on those islands was just too restrictive.","nextNodeIds":[726700116]},{"nodeId":726700116,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2005587586,"text":"I did not leave empty-handed, of course, but considering all the trouble I went through, I have to say that it doesn't quite feel worth it in the end.","nextNodeIds":[726700117]},{"nodeId":726700117,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1660634138,"text":"With few research funds remaining, I had to return to Sumeru via Liyue, but I did hope to rescue the situation during my travels...","nextNodeIds":[726700118]},{"nodeId":726700118,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":430911122,"text":"And so I thought — why not return to the topic of the Energy Amplifier, my efforts in which the Akademiya had acknowledged prior?","nextNodeIds":[726700119]},{"nodeId":726700119,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":193870778,"text":"Now, I'm not sure if you remember that whole affair...","nextNodeIds":[726700120]},{"nodeId":726700120,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3607507322,"text":"But the Energy Amplifier is a precious ancient artifact that can use the ubiquitous ley lines to strengthen its user.","nextNodeIds":[726700121]},{"nodeId":726700121,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2257101674,"text":"*cough* This research is still in its preliminary stages, and my previous report on it was only equivalent to a preface on the topic.","nextNodeIds":[726700122]},{"nodeId":726700122,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1207248194,"text":"Much work remains to be done if we are to understand the workings of the Energy Amplifier in their entirety.","nextNodeIds":[726700123]},{"nodeId":726700123,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3174648898,"text":"As such, I have been asking for volunteers and inviting them to use the Amplifier to obtain new data to support my research.","nextNodeIds":[726700124]},{"nodeId":726700124,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3186623242,"text":"So I'm not... *cough* Not some kind of suspicious character. Please do not misunderstand.","nextNodeIds":[726700125]},{"nodeId":726700125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":984214234,"text":"Ah, I see.","nextNodeIds":[726700126]},{"nodeId":726700126,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2171277146,"text":"Exactly. *cough* So, Traveler, if I might ask, would you be willing to be my volunteer and help to trial the Energy Amplifier?","nextNodeIds":[726700127]},{"nodeId":726700127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2742591370,"text":"Sure, I guess.","nextNodeIds":[726700128]},{"nodeId":726700128,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2677462706,"text":"Then allow me to express my thanks for your willingness thus far to make sacrifices in pursuit of ever-greater wisdom.","nextNodeIds":[726700129]},{"nodeId":726700129,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":4205581850,"text":"However, before I give the Energy Amplifier into your keeping, could we do a little warmup first?","nextNodeIds":[726700130]},{"nodeId":726700130,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1689648242,"text":"It is proper procedure to first ascertain if the volunteer can defend themselves... *cough* No responsible academic study should play around with the lives of its volunteers, after all.","nextNodeIds":[726700131]},{"nodeId":726700131,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":95239402,"text":"Once you are ready, head to the designated locations and clear out the monster encampments there.","nextNodeIds":[726700132]},{"nodeId":726700132,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1341079938,"text":"I will wait for your return. Do remember to stay safe.","nextNodeIds":[]},{"nodeId":726700109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2970560642,"text":"What are you planning to do!?","nextNodeIds":[726700110]},{"nodeId":726700110,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1149729226,"text":"Oh, come on! Do I look like some mad scientist who grabs passersby to use for human experimentation? There's no need to take that cautious tone with me...","nextNodeIds":[726700111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ