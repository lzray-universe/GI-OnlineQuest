FLKMOMKAI":"1331046891"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7267005_310400432","50"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7267003,"order":5,"stepDescription":"Report back to Hosseini","stepDescTextMapHash":2073001148,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30084"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7267002],"talks":[{"talkId":7267002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267003","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267002,"initDialog":726700201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30084],"performCfg":"","priority":5,"questId":72670,"showRandomTalkCount":0},"dialogs":[{"nodeId":726700201,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2301014698,"text":"Ah, you've returned.","nextNodeIds":[726700202]},{"nodeId":726700202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4187719090,"text":"And without a scratch, too!","nextNodeIds":[726700203]},{"nodeId":726700203,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1279424994,"text":"Haha. *cough* Well, I suppose I worried over-much. You are very strong indeed — I shall have no fear in leaving the Energy Amplifier to you.","nextNodeIds":[726700204]},{"nodeId":726700204,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1500560002,"text":"Its operation is very elementary — I trust you will understand it with a single glance.","nextNodeIds":[726700205]},{"nodeId":726700205,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":501017642,"text":"However, do note that this is an authentic ancient relic. You will land me in no small amount of hot water should you lose it or break it.","nextNodeIds":[726700206]},{"nodeId":726700206,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1029748130,"text":"As such, take your time to get used to it first before using it in tests.","nextNodeIds":[726700301]},{"nodeId":726700301,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2930555370,"text":"How are things going? Is the Energy Amplifier proving easy to use?","nextNodeIds":[726700302,726700304]},{"nodeId":726700302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1283399754,"text":"It's not too complicated.","nextNodeIds":[726700303]},{"nodeId":726700303,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2140359258,"text":"Indeed. Compared to some of the instruments we use at the Akademiya, the Energy Amplifier certainly is a simpler tool.","nextNodeIds":[726700306]},{"nodeId":726700306,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1980656794,"text":"At your level, larger-scale tests should be no problem at all.","nextNodeIds":[726700307]},{"nodeId":726700307,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2360566514,"text":"I've heard passing adventurers mention that they've discovered some strange new Domain of late.","nextNodeIds":[726700308]},{"nodeId":726700308,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":298696338,"text":"No one has ever traversed this terrain before, and it is teeming with monsters that are stronger than the ones you see wandering about in the wilds.","nextNodeIds":[726700309]},{"nodeId":726700309,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":655340874,"text":"I reckon that if you use that for your testing site, we might be able to obtain better data.","nextNodeIds":[726700310]},{"nodeId":726700310,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3233617386,"text":"I mean, your previous performances... *cough* I must say that they've been very impressive indeed. In fact, it is the data recorded by the Energy Amplifier that has been the limiting reactant here.","nextNodeIds":[726700311]},{"nodeId":726700311,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":965884434,"text":"I reckon that even this domain shall not prove too difficult for you.","nextNodeIds":[726700312]},{"nodeId":726700312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":200403842,"text":"That's a given.","nextNodeIds":[726700313]},{"nodeId":726700313,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":2454668538,"text":"You know, I wouldn't have believed a word of it if someone else had told me that, but on the other hand, I have full faith that you'll be fine... *cough*","nextNodeIds":[726700314]},{"nodeId":726700314,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":1728529282,"text":"Well then, allow me to mark the location of this domain for you on your map. Happy testing!","nextNodeIds":[]},{"nodeId":726700304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2577666234,"text":"There are still some things I don't get.","nextNodeIds":[726700305]},{"nodeId":726700305,"roleType":"TALK_ROLE_NPC","speakerId":30084,"speakerName":"Hosseini","textMapHash":3579499498,"text":"Well, that's normal. Don't worry, as a non-professional user, you only need to grasp its basic operations.","nextNodeIds":[726700306]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide