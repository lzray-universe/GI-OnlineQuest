{"mainQuestId":71670,"title":"Tumult Subduer","description":"The Adventurers' Guild has reported strange activity in Liyue's Sal Terrae, and the Millelith have sealed the area off. Sensing danger, you and Paimon decide to head over to investigate...","titleTextMapHash":2631943495,"descTextMapHash":251042678,"mainQuestExcel":{"mainQuestId":71670,"titleTextMapHash":2631943495,"title":"Tumult Subduer","descTextMapHash":251042678,"description":"The Adventurers' Guild has reported strange activity in Liyue's Sal Terrae, and the Millelith have sealed the area off. Sensing danger, you and Paimon decide to head over to investigate...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ71670","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":251042678,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71670,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2505039297,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71670","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171670],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2631943495,"type":"WQ","unlockDescTextMapHash":1901840886}},"flow":[{"subQuestId":7167001,"order":1,"stepDescription":"","stepDescTextMapHash":3480243628,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","1700"],"PAINLIBBLDK":"QUEST_EXEC_ADD_SCENE_TAG"},{"LNHLPKELCAL":["3","133105039,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7167002,"order":2,"stepDescription":"Go to the area around Sal Terrae","stepDescTextMapHash":528902044,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_310500127:975.844,260.604,-187.825,0.000,320.995,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7167002],"talks":[{"talkId":7167002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7167002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7167002,"initDialog":716700201,"nextRandomTalks":[],"nextTalks":[],"npcId":[15331,1016,1048],"performCfg":"QuestDialogue/WQ/LeyLineChallenge_71670/Q7167002","priority":5,"questId":71670,"showRandomTalkCount":0},"dialogs":[{"nodeId":716700201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":449026834,"text":"Uhhh... Yeah, something's definitely off here. Look at all that spooky smoke around the Ley Line deposit over there... Could that be where the monsters are coming from?","nextNodeIds":[716700202]},{"nodeId":716700202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3238609530,"text":"Looks like the Millelith have set up camp to deal with this. There are soldiers and fortifications everywhere!","nextNodeIds":[716700203,716700204]},{"nodeId":716700203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":964431746,"text":"That deposit looks familiar...","nextNodeIds":[716700205]},{"nodeId":716700205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1628819890,"text":"Yeah! Let's fight side by side with the Millelith and send those monsters packing — just like old times! Then we can focus on what to do about that weird deposit.","nextNodeIds":[716700206]},{"nodeId":716700206,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"Fangjin","textMapHash":1564786986,"text":"Halt, you two! There's danger up ahead. I'll have to ask you to turn back.","nextNodeIds":[716700207]},{"nodeId":716700207,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"Fangjin","textMapHash":2393125850,"text":"#No, wait... I think I recognize you. Are you Sergeant {NICKNAME}?","nextNodeIds":[716700208]},{"nodeId":716700208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2060340130,"text":"Sergeant? What the heck? Have you been doing night shifts in the Millelith while Paimon's asleep?","nextNodeIds":[716700209,716700210]},{"nodeId":716700209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1717587866,"text":"Me? Absolutely not...","nextNodeIds":[716700211]},{"nodeId":716700211,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"Fangjin","textMapHash":3797937530,"text":"I am Fangjin, leader of this Millelith platoon. Staff Officer Su Ding has mentioned you before, and had nothing but praise for your extraordinary talents.","nextNodeIds":[716700212]},{"nodeId":716700212,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"Fangjin","textMapHash":748033402,"text":"Our reports also list you as an Honorary Knight in the Knights of Favonius, granted captain-level authority in times of crisis. Therefore, it seems only appropriate to address you as Sergeant.","nextNodeIds":[716700213]},{"nodeId":716700213,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"Fangjin","textMapHash":2334045202,"text":"But now that introductions are out of the way, let's get back to business. Please, come with me — we should meet with Lady Yuheng.","nextNodeIds":[716700214]},{"nodeId":716700214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1026246226,"text":"Wait, Keqing's here too?","nextNodeIds":[716700215]},{"nodeId":716700215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2900082354,"text":"Huh, this situation must be more complicated than we thought. So much for solving this one with a quick fight...","nextNodeIds":[716700216]},{"nodeId":716700216,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"Fangjin","textMapHash":3175119586,"text":"#Lady Yuheng. As you predicted, {NICKNAME} and {M#his}{F#her} second-in-command are here to see you.","nextNodeIds":[716700217]},{"nodeId":716700217,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1616252922,"text":"Good work, Fangjin.","nextNodeIds":[716700218]},{"nodeId":716700218,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":103006170,"text":"It's been a while, you two. I see you're still chasing danger. The news has barely gone out and here you are, first at the front line as ever.","nextNodeIds":[716700219,716700220]},{"nodeId":716700219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3250774242,"text":"#Sergeant {NICKNAME}, reporting for duty!","nextNodeIds":[716700221]},{"nodeId":716700221,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2394799506,"text":"Let me start by giving you a brief background of the situation.","nextNodeIds":[716700222]},{"nodeId":716700222,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":404452634,"text":"For many years, this Ley Line deposit has been very stable. However, for reasons we have not yet determined, it recently became unusually active, which has led to an alarming surge in monster attacks.","nextNodeIds":[716700223]},{"nodeId":716700223,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2714864930,"text":"Worse still, eliminating the monsters seems to have no effect. The Ley Line disturbance remains and anyone who comes into contact with it is transported to a strange domain. This is the first time we've seen this sort of anomaly.","nextNodeIds":[716700224]},{"nodeId":716700224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3415092426,"text":"Yikes, that's really weird... So somehow, this Ley Line deposit has turned into a sort of... teleport waypoint?","nextNodeIds":[716700225]},{"nodeId":716700225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":898888466,"text":"And shouldn't you guys be calling for more backup? There's no way a camp this size can withstand an otherworldly invasion!","nextNodeIds":[716700226]},{"nodeId":716700226,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1344972778,"text":"Please don't worry, Paimon. Our defenses are as stable as can be, and all units are elite officers who have served in the Guili Plains. With their experience, each one of them is easily worth a hundred troops.","nextNodeIds":[716700227]},{"nodeId":716700227,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":149413226,"text":"Still, the longer this garrison stays up, the more costly it will be. If we don't find the source of the Ley Line disturbance soon, we run the risk of depleted resources and troop fatigue.","nextNodeIds":[716700228]},{"nodeId":716700228,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3895551002,"text":"Military action should be taken with precision and prudence — every attack has to count. A passive defense is always a losing strategy.","nextNodeIds":[716700229]},{"nodeId":716700229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":393537874,"text":"That makes a lotta sense... Sitting around and waiting for the enemy to attack sounds like it would really suck!","nextNodeIds":[716700230]},{"nodeId":716700230,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3248132626,"text":"Yes, which is why Yelan has taken a team to infiltrate and investigate the domain. They should be back in a few hours with the intel we need.","nextNodeIds":[716700231]},{"nodeId":716700231,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2795995106,"text":"#A few hours? I'm sorry, I would've taken my time if I'd known the Lady Yuheng wanted to catch up with {NICKNAME} in private...","nextNodeIds":[716700232]},{"nodeId":716700232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3240735706,"text":"Waaah! Why'd you have to sneak up on us like that, Yelan!?","nextNodeIds":[716700233]},{"nodeId":716700233,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2052386010,"text":"You're back early. I'm guessing things didn't go according to plan?","nextNodeIds":[716700234]},{"nodeId":716700234,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":4104397562,"text":"Well... There's good news and bad news.","nextNodeIds":[716700235]},{"nodeId":716700235,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":163557746,"text":"The good news is that we now have a rough idea of what's going on. In short, this anomaly is a vestige of a past Ley Line disturbance.","nextNodeIds":[716700236]},{"nodeId":716700236,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2659268498,"text":"By examining on-site samples and cross-checking them against our war records, I was able to confirm that the Ley Lines are currently re-enacting major historical battles inside the domain. This likely explains the monsters that managed to slip out, too.","nextNodeIds":[716700237]},{"nodeId":716700237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2249003354,"text":"Another Ley Line disturbance, huh...","nextNodeIds":[716700238]},{"nodeId":716700238,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":681686242,"text":"Sounds familiar? Thought it might.","nextNodeIds":[716700239]},{"nodeId":716700239,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":3509236922,"text":"My sources tell me that Mondstadt has experienced a similar phenomenon in the recent past.","nextNodeIds":[716700240]},{"nodeId":716700240,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":458693778,"text":"Fortunately, the situation never spiraled out of control, thanks to a relentless effort by a certain Honorary Knight and Darknight Hero to keep the monsters at bay.","nextNodeIds":[716700241]},{"nodeId":716700241,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":3746406978,"text":"This eventually depleted all the information stored in the Ley Line, after which it returned to normal. Basically, they waged a war of attrition, and won.","nextNodeIds":[716700242]},{"nodeId":716700242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2118749778,"text":"Well, that explains why the Ley Line deposit is bright red. There was one just like it back then too... Big and red and plump, like a juicy apple ripe for the picking!","nextNodeIds":[716700243,716700244]},{"nodeId":716700243,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3468552346,"text":"Tell me more about this \"Honorary Knight.\" Sounds like a cool person!","nextNodeIds":[716700245]},{"nodeId":716700245,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":1748881130,"text":"#Heh, I see what you're doing, {NICKNAME}. Making light of the situation signals to the person trying to hire you that if they want you to take things seriously, they need to make you a serious offer... But don't worry, we won't disappoint you on that front.","nextNodeIds":[716700246]},{"nodeId":716700246,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2522383226,"text":"Umm, you're starting to lose Paimon a little!","nextNodeIds":[716700247]},{"nodeId":716700247,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":132417394,"text":"...And the bad news, Yelan? Give it to us straight.","nextNodeIds":[716700248]},{"nodeId":716700248,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2394502858,"text":"Sure. As you've already noticed, this Ley Line disturbance differs from previous cases in that defeating the monsters here in the outside world will not suffice.","nextNodeIds":[716700249]},{"nodeId":716700249,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":3758986154,"text":"So, unless we target the deepest recesses of this domain and defeat all the monsters lurking within, this battle could drag on forever.","nextNodeIds":[716700250]},{"nodeId":716700250,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":3243237738,"text":"To complicate things further, there seems to be a strange set of rules at play in the domain. While we were inside, my team and I started to notice that something was working against us, forbidding us from reaching the core.","nextNodeIds":[716700251]},{"nodeId":716700251,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":4200509858,"text":"Things went smoothly at first. We were collecting and analyzing items without too much trouble. But once we pushed deeper, the team was overcome with a sudden sense of weakness. They could no longer fight at full strength.","nextNodeIds":[716700252]},{"nodeId":716700252,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":3396299682,"text":"Meanwhile, the monsters only got stronger. Some of them even showed traits we've never observed before. It got pretty dicey at points.","nextNodeIds":[716700253]},{"nodeId":716700253,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2830863274,"text":"My verdict is, we need to find someone highly resistant to Ley Line interference who can look into the domain's rules undisturbed.","nextNodeIds":[716700254]},{"nodeId":716700254,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":752429602,"text":"If they led a squad inside, they could figure out how to navigate the environment, then strike at the heart of the domain and quell this Ley Line disturbance once and for all.","nextNodeIds":[716700255,716700256]},{"nodeId":716700255,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1730842954,"text":"Heh, I see what you're doing...","nextNodeIds":[716700257]},{"nodeId":716700257,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1444607114,"text":"So to summarize, we have two options. The first is to strengthen our defenses, keep fending off the monster attacks, and hope the disturbance dies down in due course.","nextNodeIds":[716700258]},{"nodeId":716700258,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1535731402,"text":"#Option two is to send {NICKNAME} inside the domain with a team of troops to eliminate the disturbance at the source...","nextNodeIds":[716700259]},{"nodeId":716700259,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":1766572298,"text":"Understood. I'll prepare for both courses of action.","nextNodeIds":[716700260]},{"nodeId":716700260,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":178509642,"text":"I'll need to contact Ningguang and request additional funding for our defenses. At the same time, I'll reach out to the Kaiyang to discuss manpower. We need to get our troops on rotation as soon as possible.","nextNodeIds":[716700261]},{"nodeId":716700261,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2172194538,"text":"Hey, isn't this the part where you're supposed to tell us to \"get out there and give 'em what for\"?","nextNodeIds":[716700262]},{"nodeId":716700262,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2845829730,"text":"Sorry, but peacekeeping in Liyue is a duty that belongs to the Millelith and the Qixing. It's my role as commander to keep my officers from taking on unnecessary risks.","nextNodeIds":[716700263]},{"nodeId":716700263,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2794377602,"text":"Plus, I don't want you taking this on all by yourself... for reasons both professional and personal.","nextNodeIds":[716700264]},{"nodeId":716700264,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":626677250,"text":"So if you don't want to get involved, I won't force you. I'll simply treat this like a long-term training exercise for the Millelith, with several platoons working in rotation to eliminate each wave of monsters.","nextNodeIds":[716700265]},{"nodeId":716700265,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":167263242,"text":"Meanwhile, I'll have scouts keep up the intelligence-gathering work inside the domain. Once we understand it sufficiently well, we can put a strike team together to head in and neutralize the threat.","nextNodeIds":[716700266]},{"nodeId":716700266,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3262298050,"text":"Of course, if you do wish to participate, you'll have my full support, and the entire garrison at your disposal.","nextNodeIds":[716700267]},{"nodeId":716700267,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":357014930,"text":"And once the Ley Line disturbance has been brought under control, I will review your record and compensate you accordingly.","nextNodeIds":[716700268,716700269]},{"nodeId":716700268,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2283303170,"text":"I'll help, for reasons both professional and personal.","nextNodeIds":[716700270]},{"nodeId":716700270,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1581297674,"text":"Paimon too. Whichever way you cut it, we can't sit this one out: We're allies of Liyue, we're the best adventurer duo around, and we're friends of Keqing and Yelan.","nextNodeIds":[716700271]},{"nodeId":716700271,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2761649546,"text":"...Plus, we don't need to worry about being shortchanged! Keqing and Yelan will definitely make it worth our time!","nextNodeIds":[716700272]},{"nodeId":716700272,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":808762290,"text":"That looks like determination to me...","nextNodeIds":[716700273]},{"nodeId":716700273,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":2057869850,"text":"I like what I see! Alright, here's how we're going to do this:","nextNodeIds":[716700274]},{"nodeId":716700274,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3502385258,"text":"#Yelan, tell your team to prepare for another trip into the domain, this time with {NICKNAME} joining them.","nextNodeIds":[716700275]},{"nodeId":716700275,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":3437623962,"text":"Not so fast, I need some time to think this through. The situation at the site is in constant fluctuation, so we can't just go rushing in. We have to time it just right.","nextNodeIds":[716700276]},{"nodeId":716700276,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2772583970,"text":"#{NICKNAME}, take this time to rest up and assemble your A-Team. Be ready for anything — this will be a fiercer battle than most.","nextNodeIds":[716701201]},{"nodeId":716701201,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2211559722,"text":"Now's the perfect time. If we seize this chance, we should be able to go deeper into the domain's core...","nextNodeIds":[716701202]},{"nodeId":716701202,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"Yelan","textMapHash":2191089634,"text":"Of course, that's assuming we can figure out the \"rules\" along the way, as well as how to deal with our foes.","nextNodeIds":[716701203]},{"nodeId":716701203,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3548683274,"text":"Keep your eyes peeled and your blades ready. Be aware of your surroundings at all times, and look out for one another.","nextNodeIds":[716701204]},{"nodeId":716701204,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":3151370882,"text":"Remember, whenever the situation takes a turn for the worse, it never hurts to retreat and regroup. Don't go pushing yourselves too hard, alright?","nextNodeIds":[716701205]},{"nodeId":716701205,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"Keqing","textMapHash":208350042,"text":"With that said, I await your triumphant return.","nextNodeIds":[716701206,716701207]},{"nodeId":716701206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":116999066,"text":"And a triumphant return you shall have!","nextNodeIds":[716701208]},{"nodeId":716701208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1487774746,"text":"Yeah! We'll be back with good news for the both of you!","nextNodeIds":[]},{"nodeId":716701207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2143637154,"text":"I'm ready for whatever this domain throws at me!","nextNodeIds":[716701208]},{"nodeId":716700269,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2493136258,"text":"As a friend I must stay and fight!","nextNodeIds":[716700270]},{"nodeId":716700256,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1550895938,"text":"I'm the only viable candidate!","nextNodeIds":[716700257]},{"nodeId":716700244,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1285449394,"text":"I don't remember that... Maybe I really do work when Paimon's asleep!","nextNodeIds":[716700245]},{"nodeId":716700220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2662952362,"text":"Well, second this time, but we'll do our best to help!","nextNodeIds":[716700221]},{"nodeId":716700210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2045899394,"text":"\"Sergeant,\" huh? I could get used to that!","nextNodeIds":[716700211]},{"nodeId":716700204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3701852930,"text":"We'd best stay on our guard and prepare for a fight.","nextNodeIds":[716700205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167002,0],"PAINLIBB