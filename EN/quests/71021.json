210108,"roleType":"TALK_ROLE_NPC","speakerId":20127,"speakerName":"Henry Morton","textMapHash":488410962,"text":"Who knows how long a round trip will take, either...","nextNodeIds":[710210109]},{"nodeId":710210109,"roleType":"TALK_ROLE_NPC","speakerId":20127,"speakerName":"Henry Morton","textMapHash":3599768874,"text":"But I couldn't possibly construct my own boat. I mean, I learned nothing about that in the Academia...","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7102101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20127,"speakerName":"Henry Morton","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":0,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_NONE","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":710210101,"ILHDCGDKKKA":"TALK_HERO_LOCAL","ILHDNJDDEOP":7102101,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[20127],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[],"NIJAPEJKLDI":false,"NMKNFLIHHHE":false,"NMMOKMEKDJO":false,"NPGONNBAOOI":2651135705970351568,"OAIIIMFGNGM":false,"OAOCMNEPKOG":71021,"ODEOIJMOMPL":[],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST",