{"mainQuestId":70677,"title":"","description":"","titleTextMapHash":4213765519,"descTextMapHash":553393062,"mainQuestExcel":{"mainQuestId":70677,"titleTextMapHash":4213765519,"title":"","descTextMapHash":553393062,"description":"","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ70677","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":553393062,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70677,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":691499897,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70677","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[],"series":5003,"showRedPoint":false,"showType":"QUEST_HIDDEN","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4213765519,"type":"WQ","unlockDescTextMapHash":2796759694}},"flow":[{"subQuestId":7067701,"order":1,"stepDescription":"","stepDescTextMapHash":3407843236,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7067701],"talks":[{"talkId":7067701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7067701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067701,"initDialog":706770101,"nextRandomTalks":[],"nextTalks":[],"npcId":[9500],"performCfg":"QuestDialogue/WQ/Wolf_70677/Q7067701","priority":5,"questId":70677,"showRandomTalkCount":0},"dialogs":[{"nodeId":706770101,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3084320786,"text":"Oh no! Sorry! Guests, hello!","nextNodeIds":[706770102]},{"nodeId":706770102,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3320391530,"text":"I've been waiting here for the longest time, and nobody came... I was only planning to rest my eyes for a bit, but the sofa was so comfy, I guess I dozed off...","nextNodeIds":[706770103]},{"nodeId":706770103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4251469834,"text":"Eek! The toy can talk!","nextNodeIds":[706770104]},{"nodeId":706770104,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":469332922,"text":"Sure can! Talking is one of the things I can do. Alright, sooo... Ah, yes! Introductions are in order, aren't they?","nextNodeIds":[706770105]},{"nodeId":706770105,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3685167226,"text":"Greetings, my dear guests. My name is... uh...","nextNodeIds":[706770106]},{"nodeId":706770106,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1304906514,"text":"...Wait. What's my name?","nextNodeIds":[706770107]},{"nodeId":706770107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2690557962,"text":"Uh, not sure we can help you with that one, buddy... Guess you were in a pretty deep sleep, huh? Seems like you're still waking up.","nextNodeIds":[706770108,706770109]},{"nodeId":706770108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1444170074,"text":"You're Sir Howlsworth.","nextNodeIds":[706770110]},{"nodeId":706770110,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2935526858,"text":"Huh? Really!?","nextNodeIds":[706770111]},{"nodeId":706770111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2571490290,"text":"We're, uh, just messing with you, hehe...","nextNodeIds":[706770112]},{"nodeId":706770112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":428491426,"text":"#Anyway, Paimon's name is Paimon, and this is {NICKNAME}. ...Okay, great, that went well. At least this mysterious room doesn't rob everyone of their memories.","nextNodeIds":[706770113]},{"nodeId":706770113,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2410326314,"text":"I must apologize... I must have slept for so long that I can't remember what's real and what was a dream anymore. I did have a lot of dreams while I was asleep...","nextNodeIds":[706770114]},{"nodeId":706770114,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2702243098,"text":"Okay, concentrate... Alright, so — if I'm not mistaken... the current me is a \"concierge,\" in charge of attending to any guests that find themselves here. Ah yes, and you may call me \"Wolfy.\"","nextNodeIds":[706770115]},{"nodeId":706770115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":398860082,"text":"Okay. But, um, if all you can remember are your dreams, what makes you think any of them are real experiences? They're just products of your imagination, right?","nextNodeIds":[706770116]},{"nodeId":706770116,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2012315698,"text":"You mean... If it comes from my imagination, it... can't be real life? Well, it sounds like you know more about that kind of thing than I do. I can't tell the difference at all...","nextNodeIds":[706770117]},{"nodeId":706770117,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3041583914,"text":"I remember a time when a horrid curse was put on me. My heart was cased in unmelting ice, and I had to spend my days in agonizing solitude, surrounded by nothing but boundless tundra...","nextNodeIds":[706770118]},{"nodeId":706770118,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3810295026,"text":"I also remember playing with White Fang in the misty forest. We chased golden butterflies, waded through rushing streams, and shattered the very moon beneath our feet...","nextNodeIds":[706770119]},{"nodeId":706770119,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2000550226,"text":"And I'll never forget marching in that celebratory procession with the other troops, being showered in confetti as I excitedly waited for Her Majesty the Queen to bestow her honor upon me... Ah, it was glorious!","nextNodeIds":[706770120]},{"nodeId":706770120,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":905430306,"text":"To me, all these events are indistinguishable from real experiences. Take my latest dream for instance. I remember being in a garden of forking paths, and Madame Mage said to me...","nextNodeIds":[706770121]},{"nodeId":706770121,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":4060312514,"text":"\"From now on, you are a concierge. Be sure to treat your guests well!\"","nextNodeIds":[706770122]},{"nodeId":706770122,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1173937186,"text":"Then I found myself here. And like I said, I waited, and waited, and waited... and now, finally, two guests have arrived! At last, I can fulfill my duty.","nextNodeIds":[706770123]},{"nodeId":706770123,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1860261458,"text":"Is there anything else you'd like to ask me?","nextNodeIds":[706770124,706770131,706770139,706770147]},{"nodeId":706770124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4145908122,"text":"About Madame Mage...","nextNodeIds":[706770125]},{"nodeId":706770125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2158001858,"text":"Yeah, who is this Madame Mage? Is she really just a figure from your dream? Seems like there could be more to it than just that...","nextNodeIds":[706770126]},{"nodeId":706770126,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2292179978,"text":"Well... Madame Mage is Madame Mage. Just as you, dear guests, are guests.","nextNodeIds":[706770127]},{"nodeId":706770127,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":250021170,"text":"Her and her friends — oh, yes, and they're all mages, too! Each one of them is a master of their own type of magic. Conjuring, illusions, and so on.","nextNodeIds":[706770128]},{"nodeId":706770128,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":4154615714,"text":"One of them uses a quill pen to cast her spells. She has a very mysterious ink bottle that contains \"fantasy truth.\" I had a little taste when she wasn't looking, and oh my goodness, it was bitter... blech...","nextNodeIds":[706770129]},{"nodeId":706770129,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":144711522,"text":"But the other mages all love her magic. They use their powers of creation to transform her \"fantasy truth\" into \"true fantasy.\"","nextNodeIds":[706770130]},{"nodeId":706770130,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":898053682,"text":"How do they do that? I haven't the slightest idea. I'm just a toy, with stuffing for brains...","nextNodeIds":[706770123]},{"nodeId":706770131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2892200458,"text":"About this room...","nextNodeIds":[706770132]},{"nodeId":706770132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2182912970,"text":"Yeah, what is this place? We came in here through this one door in the library, but we were never able to open it before...","nextNodeIds":[706770133]},{"nodeId":706770133,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2083613762,"text":"Ah, well, congratulations on your successful entry, dear guests! This is a special room, one that can only be accessed by those who are invited!","nextNodeIds":[706770134]},{"nodeId":706770134,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3258563298,"text":"Seeing as you two have this privilege, you can invite your friends to enter as well!","nextNodeIds":[706770135]},{"nodeId":706770135,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":441532594,"text":"On that note, I'd better tidy up this place as quickly as possible. Oh, and I should prepare some tea and snacks too. You don't mind if they're on the sweeter side, do you?","nextNodeIds":[706770136]},{"nodeId":706770136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3447369146,"text":"Of course not! ...Wait, before we get ahead of ourselves, mind telling us where we are exactly? Are we even still in Mondstadt?","nextNodeIds":[706770137]},{"nodeId":706770137,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1013227906,"text":"Hmm. That is a difficult question. Madame Mage created this room using magic, and I don't know magic...","nextNodeIds":[706770138]},{"nodeId":706770138,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":671446714,"text":"Still, you have my guarantee as concierge that this is a safe and comfortable place. I sincerely hope you enjoy your time here.","nextNodeIds":[706770123]},{"nodeId":706770139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":487830106,"text":"About that book and the battle we just fought...","nextNodeIds":[706770140]},{"nodeId":706770140,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":675623914,"text":"Yes, I saw! You were magnificent! I was completely enraptured by your performance.","nextNodeIds":[706770141]},{"nodeId":706770141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3845351122,"text":"...What do you mean \"performance\"?","nextNodeIds":[706770142]},{"nodeId":706770142,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2228838114,"text":"Well, Madame Mage says that every page of a storybook is a segment of the \"present.\"","nextNodeIds":[706770143]},{"nodeId":706770143,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1955614066,"text":"I'm sure only the most distinguished of guests are able to take the stage as the story's protagonists, and put on a show as spectacular as yours!","nextNodeIds":[706770144]},{"nodeId":706770144,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":2705772482,"text":"What a thrilling battle... Yes, that's what every story needs to spice things up! Naturally, those are the kinds of stories I love reading the most.","nextNodeIds":[706770145]},{"nodeId":706770145,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1103981570,"text":"I wonder what would make a good title for a book about your magnificent performance? Should we call it a saga? An epic? A tale of conquest? A chronicle of combat? Ah, choices, choices.","nextNodeIds":[706770146]},{"nodeId":706770146,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1523651010,"text":"In any case, I do hope you will be so kind as to indulge us with more of your fine performances. ...In fact, scratch that — I'm afraid I shall have to insist! The story of the \"present\" is waiting to be written, and you, dear guests, are the ones to fill its pages!","nextNodeIds":[706770123]},{"nodeId":706770147,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":396619234,"text":"That's all I wanted to ask.","nextNodeIds":[706770148]},{"nodeId":706770148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":269741578,"text":"This place is getting more confusing by the second... But Wolfy seems alright. So... we should be fine, right? Besides...","nextNodeIds":[706770149]},{"nodeId":706770149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":697727738,"text":"Our goal is to set foot in every corner of Teyvat... And the courage to boldly go where others dare not to tread is what will take us there.","nextNodeIds":[706770150]},{"nodeId":706770150,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3682847930,"text":"Wow, what a wonderful line! Spoken like a true adventurer!","nextNodeIds":[706770151]},{"nodeId":706770151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1070802962,"text":"You bet! We're the real deal!","nextNodeIds":[706770152]},{"nodeId":706770152,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":1521635866,"text":"Is that so? Well then, I'd better make sure I do my duty as concierge of this place. I hope this can be somewhere for you to rest and recuperate when you're weary, so that you can embark on your next adventure refreshed and renewed.","nextNodeIds":[706770153]},{"nodeId":706770153,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"Wolfy","textMapHash":3746906802,"text":"Come back here anytime if you get tired. I'll be sure to take good care of you!","nextNodeIds":[]},{"nodeId":706770109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":131119338,"text":"An Honorary Knight, much renowned and loved by all.","nextNodeIds":[706770110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"