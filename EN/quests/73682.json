{"mainQuestId":73682,"title":"Exemplary Adventurer!","description":"An adventurer named Leni seems to be planning a special challenge event during Weinlesefest...","titleTextMapHash":3748224599,"descTextMapHash":2702372174,"mainQuestExcel":{"mainQuestId":73682,"titleTextMapHash":3748224599,"title":"Exemplary Adventurer!","descTextMapHash":2702372174,"description":"An adventurer named Leni seems to be planning a special challenge event during Weinlesefest...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2016,"luaPath":"Actor/Quest/WQ73682","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2016,"chapterId":0,"descTextMapHash":2702372174,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73682,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2484472577,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73682","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173682],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3748224599,"type":"WQ","unlockDescTextMapHash":1858900814}},"flow":[{"subQuestId":7368201,"order":1,"stepDescription":"Talk to Leni","stepDescTextMapHash":325005500,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368201,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30249"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7368201],"talks":[{"talkId":7368201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7368201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2016","2016020","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7368201,"initDialog":736820101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30249],"performCfg":"QuestDialogue/WQ/Mengde_73682/Q7368201","priority":5,"questId":73682,"showRandomTalkCount":0},"dialogs":[{"nodeId":736820101,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":944176962,"text":"I have waited so long for you, my brave friends! Seize this awesome opportunity! Explore the art of adventure with me! Try to surpass yourself!","nextNodeIds":[736820102,736820103]},{"nodeId":736820102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2221817250,"text":"Art of adventure?","nextNodeIds":[736820104]},{"nodeId":736820104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3101351290,"text":"Paimon doesn't completely understand what you're saying, but it sure sounds impressive! Care to explain?","nextNodeIds":[736820105]},{"nodeId":736820105,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":840965578,"text":"Of course... Hold on, I know you... It's you!","nextNodeIds":[736820106]},{"nodeId":736820106,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":717186986,"text":"The hero who fought Stormterror in the skies, the ever-dutiful commission shredder, the finder of hidden chests, the breacher of the unknown mists...","nextNodeIds":[736820107]},{"nodeId":736820107,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2687298346,"text":"With you leading the charge, everyone will surely be fired up for this great event!","nextNodeIds":[736820108]},{"nodeId":736820108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1882272250,"text":"What's with all the titles?","nextNodeIds":[736820109]},{"nodeId":736820109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3591942058,"text":"Paimon's never heard of them before!","nextNodeIds":[736820110]},{"nodeId":736820110,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2823703194,"text":"Such titles are usually coined around drinks, campfires, and for children's bedtime stories. They are only passed on by word of mouth, so it's normal for you to not have heard of them.","nextNodeIds":[736820111]},{"nodeId":736820111,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2806297458,"text":"Anyway, your presence encourages many adventurers, giving them the motivation to keep getting stronger!","nextNodeIds":[736820112]},{"nodeId":736820112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":109498002,"text":"#So {NICKNAME} has become this famous in the Mondstadt Adventurers' Guild already? How about Paimon? Does Paimon have any titles?","nextNodeIds":[736820113]},{"nodeId":736820113,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":1718445154,"text":"Ahem! I think I heard a friend mention that some call you... \"The Great Paimon, light as a bird's feather, and as unfettered as the north wind itself.\"","nextNodeIds":[736820114]},{"nodeId":736820114,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2229043962,"text":"\"Light as a bird's feather\" describes your small and agile body, while \"unfettered as the north wind\" refers to your appetite, which is on par with a Knight of Boreas!","nextNodeIds":[736820115,736820116]},{"nodeId":736820115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2534817922,"text":"It sounds like someone's idea of a joke...","nextNodeIds":[736820117]},{"nodeId":736820117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":607066106,"text":"Paimon doesn't really get it... But since they're calling Paimon \"the Great Paimon,\" it's gotta sound impressive, right? Paimon'll remember it!","nextNodeIds":[736820118]},{"nodeId":736820118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":117443186,"text":"#It's decided! No matter what your request is, Paimon, the Great Paimon, and the... Hero-Shredder, Aerial Combat Treasure Chest, and Commission Breacher {NICKNAME} will help you out!","nextNodeIds":[736820119]},{"nodeId":736820119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1874456098,"text":"Paimon heard you mention adventure and something about surpassing just now... So, is the guild holding some special challenge event?","nextNodeIds":[736820120]},{"nodeId":736820120,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2115016970,"text":"You're absolutely correct! You have probably heard that the Adventurers' Guild often holds special training for new members. This round happens to coincide with Weinlesefest, the occasion upon which the west wind has brought us some special Anemograna.","nextNodeIds":[736820121]},{"nodeId":736820121,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2370797514,"text":"These Anemograna can strengthen the abilities of adventurers, and will let everyone experience what it's like to become stronger. It also gives them a goal to work towards.","nextNodeIds":[736820122]},{"nodeId":736820122,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":167077362,"text":"This is why Guild Master Cyrus has appointed me to scout the areas where these Anemograna have been scattered to find out where fierce monsters and bandits lurk.","nextNodeIds":[736820123]},{"nodeId":736820123,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2839721258,"text":"Adventurers participating in the trials need to use the special Anemograna to defeat these enemies. They will be able to improve their skills, ascend to greater heights, and have something to look forward to in the future!","nextNodeIds":[736820124]},{"nodeId":736820124,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":3125340322,"text":"What do you think? Exciting, isn't it?","nextNodeIds":[736820125]},{"nodeId":736820125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":231525826,"text":"Hehe, Paimon was right! Paimon's intuition is really accurate!","nextNodeIds":[736820126]},{"nodeId":736820126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":380331146,"text":"Well, we did have lots to eat and drink, so it's best if we got ourselves some exercise.","nextNodeIds":[736820127]},{"nodeId":736820127,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":4025026682,"text":"Right? Right? Let's roll up our sleeves and give it a go! If you participate in this trial, I think a lot of adventurers will come just to see you.","nextNodeIds":[736820128]},{"nodeId":736820128,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2055849026,"text":"Next, I'll show you the first challenge area.","nextNodeIds":[736820129]},{"nodeId":736820129,"roleType":"TALK_ROLE_NPC","speakerId":30249,"speakerName":"Leni","textMapHash":2244703826,"text":"Go for it! I'll record your heroic actions and tell all the other adventurers about them!","nextNodeIds":[]},{"nodeId":736820116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2111130610,"text":"Sounds like someone made that up on the spot...","nextNodeIds":[736820117]},{"nodeId":736820103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1298230066,"text":"Surpass myself?","nextNodeIds":[736820104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368201,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCEN