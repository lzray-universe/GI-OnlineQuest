"The Damselette","textMapHash":2339266026,"text":"That's right. I need to go collect some more.","nextNodeIds":[760300111]},{"nodeId":760300111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":665211666,"text":"Oh, so you're heading out?","nextNodeIds":[760300112]},{"nodeId":760300112,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":84252298,"text":"Yes, I know just the place — it's graced by the moon, so these kinds of stones are abundant.","nextNodeIds":[760300113]},{"nodeId":760300113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2601652490,"text":"Want us to come with?","nextNodeIds":[760300114]},{"nodeId":760300114,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1761643618,"text":"Sure.","nextNodeIds":[760300115]},{"nodeId":760300115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1038099330,"text":"Alright, then let's get collecting! We wanna see what the finished picture looks like, too!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1318"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7603006,"order":2,"stepDescription":"Head to the designated location to collect ores","stepDescTextMapHash":1219739324,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603006,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALN