{"mainQuestId":71669,"title":"Our Animal Friends: Epilogue","description":"The Claw Convoy animal rescue society's gift-swapping event has ended. Zhenchen is sorting through the gifts that the society has received...","titleTextMapHash":3109069511,"descTextMapHash":126716886,"mainQuestExcel":{"mainQuestId":71669,"titleTextMapHash":3109069511,"title":"Our Animal Friends: Epilogue","descTextMapHash":126716886,"description":"The Claw Convoy animal rescue society's gift-swapping event has ended. Zhenchen is sorting through the gifts that the society has received...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5238,"luaPath":"Actor/Quest/WQ71669","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5238,"chapterId":0,"descTextMapHash":126716886,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71669,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1130048009,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71669","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171669],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3109069511,"type":"WQ","unlockDescTextMapHash":1527533598}},"flow":[{"subQuestId":7166901,"order":1,"stepDescription":"Talk to Zhenchen","stepDescTextMapHash":839498684,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30673"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166901,7166902],"talks":[{"talkId":7166901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166901,"initDialog":716690101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30673],"performCfg":"QuestDialogue/WQ/AnimalView_71669/Q7166901","priority":5,"questId":71669,"showRandomTalkCount":0},"dialogs":[{"nodeId":716690101,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1064416882,"text":"#{NICKNAME}, I've heard from the staff that you've found all the transmitter-equipped animals.","nextNodeIds":[716690102]},{"nodeId":716690102,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":2762393890,"text":"To be honest, that was quite a surprise to hear! Some of them are naturally sensitive and will flee the moment an unknown creature approaches.","nextNodeIds":[716690103]},{"nodeId":716690103,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":4082635026,"text":"But they didn't seem to mind you getting close. Quite curious.","nextNodeIds":[716690104,716690105]},{"nodeId":716690104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3666254106,"text":"Well, I am a friend to all animals.","nextNodeIds":[716690106]},{"nodeId":716690106,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3734394362,"text":"Haha! Enviable indeed.","nextNodeIds":[716690107]},{"nodeId":716690107,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":4209428186,"text":"I was growled at or bitten the last few times the staff accompanied me to go feed the animals.","nextNodeIds":[716690112]},{"nodeId":716690112,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1194104794,"text":"I've even got scars on my arm to show for it... they hurt quite a bit, too.","nextNodeIds":[716690113]},{"nodeId":716690113,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1518852258,"text":"But even though these lovely creatures don't seem to like me much, I'm just glad that they're all well and happy.","nextNodeIds":[716690114]},{"nodeId":716690114,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3472358970,"text":"It's the same for all our adopters. Everyone just wants to protect the animals' habitat and leave them undisturbed.","nextNodeIds":[716690115]},{"nodeId":716690115,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1786174514,"text":"I know that for many adventurers, wild animals are an important source of food, and we're not asking Claw Convoy members to not hunt at all.","nextNodeIds":[716690116]},{"nodeId":716690116,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":601508282,"text":"But we do advocate against wanton capture and slaughter. If everyone could do that, there's no doubt that our environment would be even more diverse and beautiful.","nextNodeIds":[716690117]},{"nodeId":716690117,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1773598570,"text":"As one of our members, if would be great if you'd acknowledge and accept this principle as well.","nextNodeIds":[716690118,716690120]},{"nodeId":716690118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3648497690,"text":"I shall.","nextNodeIds":[716690119]},{"nodeId":716690119,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":785175330,"text":"I knew a reasonable person like you would see eye to eye with us on this!","nextNodeIds":[716690122]},{"nodeId":716690122,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":61804946,"text":"Just putting that thought into peoples' minds is success enough for us.","nextNodeIds":[716690123]},{"nodeId":716690123,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":2919737834,"text":"If we get the chance, I'd love to see you at our next Claw Convoy event.","nextNodeIds":[716690124]},{"nodeId":716690124,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1304728386,"text":"With any luck, though, I won't be sporting any fresh scars on my arm when that time comes.","nextNodeIds":[]},{"nodeId":716690120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1825683442,"text":"I'll reserve judgment for now.","nextNodeIds":[716690121]},{"nodeId":716690121,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":672945794,"text":"That's fine, we're not forcing everyone to accept this. Personally, I just think it would be great if everyone thought things through before taking an animal's life.","nextNodeIds":[716690122]},{"nodeId":716690105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2221366018,"text":"It's one of my gifts as an adventurer.","nextNodeIds":[716690106]}]},{"talkId":7166902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166901","2","","",""],"type":