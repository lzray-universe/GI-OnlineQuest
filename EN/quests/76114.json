antId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7611401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7611401,"initDialog":761140101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1316,1317],"performCfg":"QuestDialogue/WQ/NodKrai_76114/Q7611401","priority":5,"questId":76114,"showRandomTalkCount":0},"dialogs":[{"nodeId":761140101,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":19576394,"text":"So, this time we're investigating... a suspicious hermit?","nextNodeIds":[761140102]},{"nodeId":761140102,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3546213274,"text":"Aren't hermits all suspicious by nature? Anyone who runs off to live halfway up a remote mountain can't be entirely normal...","nextNodeIds":[761140103]},{"nodeId":761140103,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3595400658,"text":"People don't change for no reason, regardless of whether those changes are driven by internal or external factors.","nextNodeIds":[761140104]},{"nodeId":761140104,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3847718146,"text":"Besides, that missing merchant raises questions...","nextNodeIds":[761140105]},{"nodeId":761140105,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3843170714,"text":"Huh? But that area's full of dangers — everyone knows that. Bandits, monsters... There are a million ways a traveling merchant might meet their end out there.","nextNodeIds":[761140106]},{"nodeId":761140106,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3283269306,"text":"Seeing as everyone knows how dangerous it is, don't you think a merchant who regularly passes through would be well prepared?","nextNodeIds":[761140107]},{"nodeId":761140107,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":3488302386,"text":"Despite knowing the lay of the land, an experienced merchant just disappeared. Something like that rightly raises suspicion.","nextNodeIds":[761140108]},{"nodeId":761140108,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1081290250,"text":"Jahoda, I'm leaving it to you to visit this \"suspicious hermit.\"","nextNodeIds":[761140109]},{"nodeId":761140109,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"Nefer","textMapHash":1010670994,"text":"It's a long road — make sure you don't stray from the path.","nextNodeIds":[761140110]},{"nodeId":761140110,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1268867906,"text":"Oh... Sure thing, Boss Nef! Leave it to me!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7611402,"order":2,"stepDescription":"Investigate the hermit's hut","stepDescTextMapHash":1902230244,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360500010:2561.479,344.670,8997.385,0.000,241.888,0.000]","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7611402],"talks":[{"talkId":7611402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7611402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7611402,"initDialog":761140201,"nextRandomTalks":[],"nextTalks":[],"npcId":[15923],"performCfg":"QuestDialogue/WQ/NodKrai_76114/Q7611402","priority":5,"questId":76114,"showRandomTalkCount":0},"dialogs":[{"nodeId":761140201,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":95862442,"text":"Hello? Is anybody there?","nextNodeIds":[761140202]},{"nodeId":761140202,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":239026850,"text":"Mr. Derwent? Are you home?","nextNodeIds":[761140203]},{"nodeId":761140203,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":3402284098,"text":"...Who's there?","nextNodeIds":[761140204]},{"nodeId":761140204,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1672696594,"text":"The name's Jahoda. I'm here from the Curatorium of Secrets. I was wondering if I could ask you a few questions...","nextNodeIds":[761140205]},{"nodeId":761140205,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":3705859066,"text":"...You can ask from there. I'm ill, don't expect me to get up for you.","nextNodeIds":[761140206]},{"nodeId":761140206,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2213018986,"text":"(How strange... The Conch Gang kids said Mr. Derwent taught them how to read. They said he always spoke softly...)","nextNodeIds":[761140207]},{"nodeId":761140207,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":4050971530,"text":"(This voice is hoarse, but he doesn't sound ill. It sounds like his voice is naturally rough...)","nextNodeIds":[761140208]},{"nodeId":761140208,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1681957234,"text":"Are you alright? If it's serious, I could help you find a doctor...","nextNodeIds":[761140209]},{"nodeId":761140209,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":2197154186,"text":"...No need. I'll be right in a bit.","nextNodeIds":[761140210]},{"nodeId":761140210,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":3300704530,"text":"Alright. In that case, you should head to Nasha Town when you're better — your friends have been worried about you.","nextNodeIds":[761140211]},{"nodeId":761140211,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":1436495554,"text":"...","nextNodeIds":[761140212]},{"nodeId":761140212,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1053151626,"text":"(...Why's he not saying anything? I can hear someone walking around in there, but the footsteps are heavy...)","nextNodeIds":[761140213]},{"nodeId":761140213,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1041303602,"text":"Have you not been outside much recently?","nextNodeIds":[761140214]},{"nodeId":761140214,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":2452129866,"text":"...I've been cultivating myself.","nextNodeIds":[761140215]},{"nodeId":761140215,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2599344754,"text":"Yeah, word on the street is that you've recently had a bit of a makeover... Someone was saying they couldn't believe how strong you look — they said you used to look so thin when you were wearing robes.","nextNodeIds":[761140216]},{"nodeId":761140216,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":340155634,"text":"And a mask to block out kuuvahki... Is that the latest fashion?","nextNodeIds":[761140217]},{"nodeId":761140217,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":1897985690,"text":"...It's to block out the noise.","nextNodeIds":[761140218]},{"nodeId":761140218,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":398398170,"text":"So you can better cultivate yourself...?","nextNodeIds":[761140219]},{"nodeId":761140219,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":1004055610,"text":"...","nextNodeIds":[761140220]},{"nodeId":761140220,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1967050498,"text":"Anyway, there was a merchant who came to visit you not long ago. Do you know where he went?","nextNodeIds":[761140221]},{"nodeId":761140221,"roleType":"TALK_ROLE_NPC","speakerId":7125,"speakerName":"Derwent","textMapHash":1076557378,"text":"...No idea.","nextNodeIds":[761140222]},{"nodeId":761140222,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2302556914,"text":"A—Alright, then... Sorry to bother you.","nextNodeIds":[761140223]},{"nodeId":761140223,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":884958970,"text":"(I'm not sure why, but I feel it in my bones — this is getting dangerous...)","nextNodeIds":[761140224]},{"nodeId":761140224,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":2067580690,"text":"(They weren't wrong. This seems like a completely different guy...)","nextNodeIds":[761140225]},{"nodeId":761140225,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"Jahoda","textMapHash":1970337562,"text":"(I can't go back to Boss Nef having only learned so little. I'd better stay close and investigate the surrounding area.)","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360500010:2561.479,344.670,8997.385,0.000,241.888,0.000]","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7611403,"order":3,"stepDescription":"Look for clues outside the hut","stepDescTextMapHash":1728778452,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_360500011:2563.807,346.132,8986.408,0.000,274.500,0.000]","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7611403],"talks":[{"talkId":7611403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDr