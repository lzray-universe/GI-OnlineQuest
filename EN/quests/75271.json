eal?","nextNodeIds":[752710606]},{"nodeId":752710606,"roleType":"TALK_ROLE_NPC","speakerId":22032,"speakerName":"Ziki","textMapHash":2940147610,"text":"I am! My lovely lady, Yopoyi, please, say you'll go out on a date with me!","nextNodeIds":[752710607]},{"nodeId":752710607,"roleType":"TALK_ROLE_NPC","speakerId":21976,"speakerName":"Yopoyi","textMapHash":1557175906,"text":"Did you hit your head getting into that costume or something? This is our third anniversary! We're MARRIED!","nextNodeIds":[752710608]},{"nodeId":752710608,"roleType":"TALK_ROLE_NPC","speakerId":22032,"speakerName":"Ziki","textMapHash":935281218,"text":"I know that! It's just... you're always telling me how unromantic I am... and I never properly confessed my love before our marriage... I know it's late, but this is my confession to you!","nextNodeIds":[752710609]},{"nodeId":752710609,"roleType":"TALK_ROLE_NPC","speakerId":21976,"speakerName":"Yopoyi","textMapHash":3167744154,"text":"Haha... So that's it, huh? Alright then, of course I'll go out with you.","nextNodeIds":[752710610]},{"nodeId":752710610,"roleType":"TALK_ROLE_NPC","speakerId":22032,"speakerName":"Ziki","textMapHash":931431842,"text":"For real?","nextNodeIds":[752710611]},{"nodeId":752710611,"roleType":"TALK_ROLE_NPC","speakerId":21976,"speakerName":"Yopoyi","textMapHash":3615693874,"text":"Yes, for real, you silly romantic fool, you.","nextNodeIds":[752710612]},{"nodeId":752710612,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1471305290,"text":"A gust of wind blows by, and the lovers embrace.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7527106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133520241"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHE