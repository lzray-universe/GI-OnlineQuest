e":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7224805","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7224803,"initDialog":722480301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005,20356],"performCfg":"QuestDialogue/WQ/Inazuma_72248/Q7224803","priority":5,"questId":72248,"showRandomTalkCount":0},"dialogs":[{"nodeId":722480301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4280724418,"text":"Here comes one of those spirits...","nextNodeIds":[722480302]},{"nodeId":722480302,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3468862626,"text":"My name is...","nextNodeIds":[722480303]},{"nodeId":722480303,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":1062381370,"text":"Aberaku, Helios-Forger!","nextNodeIds":[722480304]},{"nodeId":722480304,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":1899259330,"text":"How could I have been felled by your vile slander, or imprisoned by your puppet infants!?","nextNodeIds":[722480305]},{"nodeId":722480305,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":2692996194,"text":"I— No, wait. I was imprisoned for months and years beyond count, was I not? Then... This must be my post-life form?","nextNodeIds":[722480306]},{"nodeId":722480306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4194841658,"text":"\"Post-life form\"? You mean that you're already dead, right?","nextNodeIds":[722480307]},{"nodeId":722480307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":205696938,"text":"Takes a pretty rare spirit to realize that.","nextNodeIds":[722480308]},{"nodeId":722480308,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3723042058,"text":"And yet, though it shames me to say so, I know not just how I died...","nextNodeIds":[722480309]},{"nodeId":722480309,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3655386306,"text":"But I recall that I was imprisoned on orders from a child.","nextNodeIds":[722480310]},{"nodeId":722480310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3657517802,"text":"A child?","nextNodeIds":[722480311]},{"nodeId":722480311,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":4174479202,"text":"Indeed. But till today, I can never feel any hatred for that child, only pity.","nextNodeIds":[722480312]},{"nodeId":722480312,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":2124634162,"text":"He was not at fault. The blame should fall upon those who controlled him like a puppet in their palms... Forget it. Such things are best left unsaid.","nextNodeIds":[722480313]},{"nodeId":722480313,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":2748513338,"text":"After that, I was imprisoned...","nextNodeIds":[722480314]},{"nodeId":722480314,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3141407690,"text":"Imprisoned in a...","nextNodeIds":[722480315]},{"nodeId":722480315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2692120786,"text":"In a...?","nextNodeIds":[722480316]},{"nodeId":722480316,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":318134618,"text":"In a very high place.","nextNodeIds":[722480317]},{"nodeId":722480317,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":1025161354,"text":"But though it was high up, it was dark, lightless, and cold as the ice itself.","nextNodeIds":[722480318]},{"nodeId":722480318,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3981686698,"text":"...Strange. Why is that?","nextNodeIds":[722480319]},{"nodeId":722480319,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":618795410,"text":"Why do I feel that a high place should have brought a person warmth and comfort?","nextNodeIds":[722480320]},{"nodeId":722480320,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3280852010,"text":"Why... Why can't I remember any of this?","nextNodeIds":[722480321]},{"nodeId":722480321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":687974858,"text":"Are you hungry, maybe?","nextNodeIds":[722480322]},{"nodeId":722480322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3699206170,"text":"Whenever Paimon's famished, forget thinking, she can barely even talk straight!","nextNodeIds":[722480323,722480325]},{"nodeId":722480323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4221992882,"text":"I don't think that's his issue...","nextNodeIds":[722480324]},{"nodeId":722480324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":763160130,"text":"Come on, it's gotta be! Look at him, he can hardly speak clearly!","nextNodeIds":[722480327]},{"nodeId":722480327,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2658208954,"text":"#Actually, {NICKNAME}, could you check if there's something to eat amongst the offerings?","nextNodeIds":[722480328]},{"nodeId":722480328,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":4244401682,"text":"Wait! That's it! The offerings!","nextNodeIds":[722480329]},{"nodeId":722480329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":971919482,"text":"What, do you wanna eat them?","nextNodeIds":[722480330]},{"nodeId":722480330,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":1046330778,"text":"No, I just remembered...","nextNodeIds":[722480331]},{"nodeId":722480331,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":2941189770,"text":"When I died in prison, my attire and body were enshrined in various places due to my contribution in creating the Helios.","nextNodeIds":[722480332]},{"nodeId":722480332,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3344069714,"text":"But that also caused my spirit to be separated and rendered unable to rest.","nextNodeIds":[722480333]},{"nodeId":722480333,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":561224626,"text":"This place should have been the resting place of my sacred crown, though it has surely decayed by now. This must surely be why my thoughts are so... stuck.","nextNodeIds":[722480334]},{"nodeId":722480334,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3751927082,"text":"If this persists, I doubt that even my current state can be sustained for long...","nextNodeIds":[722480335]},{"nodeId":722480335,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":15032834,"text":"But these offerings can be used to replace the remnants of my body and my attire in sustaining an ounce of my thoughts.","nextNodeIds":[722480336]},{"nodeId":722480336,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":622683026,"text":"As such, please take them with you.","nextNodeIds":[722480337]},{"nodeId":722480337,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3576101066,"text":"However, there are many perils on the enshrining path. So though it may seem rude of me, could you accept a certain test first?","nextNodeIds":[722480338]},{"nodeId":722480338,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2289427690,"text":"Test? What test?","nextNodeIds":[722480339]},{"nodeId":722480339,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":3717261306,"text":"Please defeat the monsters hereabouts, the prison wardens of my spirit.","nextNodeIds":[722480340]},{"nodeId":722480340,"roleType":"TALK_ROLE_NPC","speakerId":20356,"speakerName":"Aberaku","textMapHash":2378469898,"text":"This matter is perilous. Tell me once you are ready, O Traveler, and we shall begin.","nextNodeIds":[]},{"nodeId":722480325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3870515258,"text":"Well, it just so happens that we have some emergen—","nextNodeIds":[722480326]},{"nodeId":722480326,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2892026810,"text":"Hey!","nextNodeIds":[722480327]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7224803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PP