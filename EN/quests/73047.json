NE"},"isHidden":false,"talkIds":[7304701],"talks":[{"talkId":7304701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7304701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7304701,"initDialog":730470101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20648,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73047/Q7304701","priority":5,"questId":73047,"showRandomTalkCount":0},"dialogs":[{"nodeId":730470101,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":2446988170,"text":"#Nara {NICKNAME}, Paimon, we meet again. Hehehe...","nextNodeIds":[730470102]},{"nodeId":730470102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1706115714,"text":"You look very happy, Araja!","nextNodeIds":[730470103]},{"nodeId":730470103,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":487481562,"text":"Hoho... I am indeed very happy to see Vanarana so lively, with so many Aranara having returned home. Ah, I never thought that I'd be able to participate in Festival Utsava in person...","nextNodeIds":[730470104,730470105]},{"nodeId":730470104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1649668514,"text":"You haven't participated in it before?","nextNodeIds":[730470107]},{"nodeId":730470107,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":3525723762,"text":"The stories say that I did participate. It was a long, long time ago...","nextNodeIds":[730470108]},{"nodeId":730470108,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":1313159642,"text":"I, Aramuhukunda, Arana, Araji... Many of us Aranara celebrated Festival Utsava together with Nara Varuna.","nextNodeIds":[730470109]},{"nodeId":730470109,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":4095833778,"text":"It was a very difficult time. But we still laughed and sang together during Festival Utsava. I like this story very much.","nextNodeIds":[730470110]},{"nodeId":730470110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3822206154,"text":"Huh? Then you did participate, didn't you?","nextNodeIds":[730470111]},{"nodeId":730470111,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":3030624954,"text":"Oh, I did participate, in the stories. But I no longer remember that. Those stories were all things that Arana and the others told me later.","nextNodeIds":[730470112]},{"nodeId":730470112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1088364658,"text":"Hmmm... Araja is starting to sound a lot like a grandpa. Maybe Araja's just getting too old and can't remember clearly!","nextNodeIds":[730470113]},{"nodeId":730470113,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":2512876810,"text":"#Perhaps this is for the best... Anyway, Nara {NICKNAME}, Paimon, will you take this?","nextNodeIds":[730470114]},{"nodeId":730470114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3333528402,"text":"It's a flower...","nextNodeIds":[730470115]},{"nodeId":730470115,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":1973572530,"text":"Yes. I hope that this flower will follow you in your future travels.","nextNodeIds":[730470116,730470117]},{"nodeId":730470116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1727252194,"text":"I'll accept it.","nextNodeIds":[730470118]},{"nodeId":730470118,"roleType":"TALK_ROLE_NPC","speakerId":20648,"speakerName":"Araja","textMapHash":2712794474,"text":"Nara time is much more precious than Aranara time, so I will not keep you from enjoying yourselves. Go look for Arakavi later. He is also preparing for the Festival Utsava ceremony.","nextNodeIds":[]},{"nodeId":730470117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3748555930,"text":"Thanks.","nextNodeIds":[730470118]},{"nodeId":730470105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1163440210,"text":"I'm very happy too.","nextNodeIds":[730470106]},{"nodeId":730470106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3951830690,"text":"Paimon's really happy too! But haven't you ever participated in Festival Utsava before, Araja?","nextNodeIds":[730470107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LN