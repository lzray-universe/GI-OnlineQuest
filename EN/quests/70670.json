{"mainQuestId":70670,"title":"Windtrace","description":"Gygax from Mondstadt seems to be busy with something...","titleTextMapHash":3543249567,"descTextMapHash":2299322366,"mainQuestExcel":{"mainQuestId":70670,"titleTextMapHash":3543249567,"title":"Windtrace","descTextMapHash":2299322366,"description":"Gygax from Mondstadt seems to be busy with something...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":5111,"luaPath":"Actor/Quest/WQ70670","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5111,"chapterId":0,"descTextMapHash":2299322366,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70670,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":322070801,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70670","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170670],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3543249567,"type":"WQ","unlockDescTextMapHash":4093740518}},"flow":[{"subQuestId":7067001,"order":1,"stepDescription":"Talk to Gygax","stepDescTextMapHash":3550024284,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30051","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7067001],"talks":[{"talkId":7067001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7067001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067001,"initDialog":706700101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30051],"performCfg":"QuestDialogue/WQ/Mengde_70670/Q7067001","priority":5,"questId":70670,"showRandomTalkCount":0},"dialogs":[{"nodeId":706700101,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1069304122,"text":"Hey there, fancy trying your hand at Windtrace?","nextNodeIds":[706700102,706700107]},{"nodeId":706700102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":934173258,"text":"Still looking for people to have a go at it, huh?","nextNodeIds":[706700103]},{"nodeId":706700103,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3015766626,"text":"Oh, it's you! I was really impressed with the technique you exhibited the last time you played Windtrace.","nextNodeIds":[706700104]},{"nodeId":706700104,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":891045098,"text":"Though you seem to be adept at the game, a lot of people say that the game is pretty tough. Be it Rebels claiming that they have few escape options, or the Hunters complaining that they can't find anyone.","nextNodeIds":[706700105]},{"nodeId":706700105,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1971233850,"text":"Some people also complained to me that the Rebels caught by the Hunters have utterly nothing to do until the end of the game, and can only watch from the side, which is really boring for them...","nextNodeIds":[706700106]},{"nodeId":706700106,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":513804634,"text":"*sigh* I don't know who to listen to, so I decided to invite another batch of people to play-test the game and share their feedback.","nextNodeIds":[706700120]},{"nodeId":706700120,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1633652010,"text":"Heh. But don't take my word for it — try it out for yourself!","nextNodeIds":[706700121,706700122]},{"nodeId":706700121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3188123370,"text":"Play Windtrace.","nextNodeIds":[706700123]},{"nodeId":706700123,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3628131450,"text":"Alright, well, if you're ever interested to try it out, you know where to find me.","nextNodeIds":[]},{"nodeId":706700122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":181974906,"text":"Leave.","nextNodeIds":[706700123]},{"nodeId":706700107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":840052362,"text":"What's Windtrace?","nextNodeIds":[706700108]},{"nodeId":706700108,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4154422506,"text":"I'm glad you asked. Windtrace is a game that's all about Mondstadt's history!","nextNodeIds":[706700109]},{"nodeId":706700109,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1945282274,"text":"I suppose you've heard of the aristocrats who once lived in the city of Mondstadt?","nextNodeIds":[706700110]},{"nodeId":706700110,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":107350506,"text":"They were tyrants, and their rule was brutal. Words cannot do justice to the way that people suffered at their hands...","nextNodeIds":[706700111]},{"nodeId":706700111,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":2018596698,"text":"To fight back against their oppression, a group of brave citizens came together and formed an underground resistance.","nextNodeIds":[706700112]},{"nodeId":706700112,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":2066383698,"text":"These valiant rebels engaged in operations throughout the city, becoming a major thorn in the side of the aristocrats.","nextNodeIds":[706700113]},{"nodeId":706700113,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":3025018690,"text":"But the aristocrats retaliated, quickly training up their own team of henchmen to suppress the rebels.","nextNodeIds":[706700114]},{"nodeId":706700114,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":142312554,"text":"And so, the rebels fought duel after duel with the aristocrats' lackeys all across Mondstadt.","nextNodeIds":[706700115]},{"nodeId":706700115,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":4173506802,"text":"Windtrace takes its inspiration from this thrilling chapter of Mondstadt's history! And it used to be quite popular, too...","nextNodeIds":[706700116]},{"nodeId":706700116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1269165698,"text":"Used to be?","nextNodeIds":[706700117]},{"nodeId":706700117,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":2105490682,"text":"Sadly, yes. Young people these days don't seem very interested in the game...","nextNodeIds":[706700118]},{"nodeId":706700118,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":2373848482,"text":"But I can't let Windtrace fade into obscurity. So, I tweaked the rules a little to make it easier to get into and more fun.","nextNodeIds":[706700119]},{"nodeId":706700119,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"Gygax","textMapHash":1553862978,"text":"I also added a whole load of brand-new maps in. Hopefully, this will help to attract more people...","nextNodeIds":[706700120]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"