IDE_NONE"},"isHidden":false,"talkIds":[7223101,7223102],"talks":[{"talkId":7223101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7223101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7223101,"initDialog":722310101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3182],"performCfg":"","priority":5,"questId":72231,"showRandomTalkCount":0},"dialogs":[{"nodeId":722310101,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":441870202,"text":"Haha, the Lady Priestess is so overjoyed. This \"Hibiki\" must really have been someone of great importance to it.","nextNodeIds":[722310102]},{"nodeId":722310102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":484664402,"text":"Trouble is, we don't know where she is...","nextNodeIds":[]}]},{"talkId":7223102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7223101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7223102,"initDialog":722310201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3180,3181],"performCfg":"","priority":5,"questId":72231,"showRandomTalkCount":0},"dialogs":[{"nodeId":722310201,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":664640842,"text":"Indeed, \"Hibiki,\" \"Asase Shrine,\" \"Domeki\"... these names are all quite concerning, actually.","nextNodeIds":[722310202,722310207]},{"nodeId":722310202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1478573658,"text":"And where did you two pop out from?","nextNodeIds":[722310203]},{"nodeId":722310203,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1283913498,"text":"Well, you were all making such a racket, so of course we'd come over.","nextNodeIds":[722310204]},{"nodeId":722310204,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1598643130,"text":"Still, there's something that I think you must know.","nextNodeIds":[722310205]},{"nodeId":722310205,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1309610778,"text":"Taisuke, if you'd do the honors.","nextNodeIds":[722310206]},{"nodeId":722310206,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":14872834,"text":"Ah right, of course, Miss Etsuko. So what we're going to say... concerns Seirai Island.","nextNodeIds":[722310208]},{"nodeId":722310208,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":2674824826,"text":"The history of this place is very obscure, and while the Guild has attempted to specifically search for information regarding it, we've found very little...","nextNodeIds":[722310209]},{"nodeId":722310209,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1356056346,"text":"According to what information we did manage to get, this was a gathering place for pirates several centuries ago. Then, the Shogunate cleared all the pirates out and moved the inhabitants to other places...","nextNodeIds":[722310210]},{"nodeId":722310210,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1929402554,"text":"Unless I'm mistaken, this \"Domeki\" we speak of may well have been the pirate leader \"Ako Domeki,\" who chose to fight the Shogunate head-on. The records do clearly record his name.","nextNodeIds":[722310211]},{"nodeId":722310211,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":2940166050,"text":"According to that same information we have, this Ako Domeki led his pirate fleet in a naval battle against the Shogunate.","nextNodeIds":[722310212]},{"nodeId":722310212,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":51617498,"text":"They were quickly suppressed and forced to flee back to Seirai Island...","nextNodeIds":[722310213]},{"nodeId":722310213,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1866421674,"text":"But as the Shogunate fleet pursued him, a sudden storm erupted on Seirai Island.","nextNodeIds":[722310214]},{"nodeId":722310214,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":238505994,"text":"Ako Domeki's fleet and the Shogunate's were both caught in the ensuing storm... and they were all lost.","nextNodeIds":[722310215]},{"nodeId":722310215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1335948730,"text":"A storm...","nextNodeIds":[722310216]},{"nodeId":722310216,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3607919658,"text":"I'll pick things up from there. The biggest mystery here, of course, is the sudden emergence of that storm.","nextNodeIds":[722310217]},{"nodeId":722310217,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1112138938,"text":"Although Ako Domeki's fleet was also hit by the storm and was nearly wiped out as a result, the fleet that the Shogunate sent was also all but lost with all hands, with the remnants being forced to retreat to Narukami Island. It would be quite some time before the fleet was ready again.","nextNodeIds":[722310218]},{"nodeId":722310218,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":2171377242,"text":"So the timing of that storm was just too coincidental. Almost as if... someone was specifically controlling it.","nextNodeIds":[722310219]},{"nodeId":722310219,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":2671997370,"text":"I'm sure you remember the Warding Stones on this island. Those had been intentionally unsealed.","nextNodeIds":[722310220]},{"nodeId":722310220,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":24655818,"text":"And once we sealed them again, the storm on the island became calm once more.","nextNodeIds":[722310221]},{"nodeId":722310221,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":2207231946,"text":"I'm not going to jump to conclusions immediately, but my gut says that those incidents are definitely related.","nextNodeIds":[722310222]},{"nodeId":722310222,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1229484842,"text":"Well, we could ask Lady Neko...","nextNodeIds":[722310223]},{"nodeId":722310223,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":896469314,"text":"...Eh, I say forget it. The record states that Domeki went missing — well, that's what it says anyway, but if he was hit by that storm, he probably...","nextNodeIds":[722310224]},{"nodeId":722310224,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1312212402,"text":"We'll continue exploring this island and collecting more information about this incident for a while, and then we'll report back to the Guild.","nextNodeIds":[722310225]},{"nodeId":722310225,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1034573770,"text":"Who knows? Maybe we'll have the pleasure of working together again some time.","nextNodeIds":[722310226]},{"nodeId":722310226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3954822882,"text":"I look forward to it.","nextNodeIds":[722310227]},{"nodeId":722310227,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":2273573482,"text":"The feeling's mutual.","nextNodeIds":[722310228]},{"nodeId":722310228,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1655517370,"text":"Well, Taisuke, let's ready up. We've got some exploring to do.","nextNodeIds":[722310229]},{"nodeId":722310229,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1876088626,"text":"Uh, so Miss Etsuko, about Lady Neko...","nextNodeIds":[722310230]},{"nodeId":722310230,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":2118272730,"text":"You can keep treating that cat just as you did before, of course.","nextNodeIds":[722310231]},{"nodeId":722310231,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":4289157970,"text":"Just remember to refrain from saying anything you shouldn't.","nextNodeIds":[722310232]},{"nodeId":722310232,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":986140530,"text":"She's a real happy camper right now. No need for you to be a wet blanket.","nextNodeIds":[722310233]},{"nodeId":722310233,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":4290932466,"text":"I got it. Haha, Miss Etsuko, you really are...","nextNodeIds":[722310234]},{"nodeId":722310234,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":2590804138,"text":"...Just trying to finish our commissions more efficiently. C'mon, let's get to work.","nextNodeIds":[722310235]},{"nodeId":722310235,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1357739242,"text":"Seirai Island... It seems that this place is still full of many mysteries...","nextNodeIds":[]},{"nodeId":722310207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":400163578,"text":"Do you know something?","nextNodeIds":[722310208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7223101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7223101,7223102],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","count":20},{"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1414956910,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[]