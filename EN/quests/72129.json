0248,"speakerName":"Kaji","textMapHash":1982300034,"text":"Next, the two wards at the Serpent's Head and Jakotsu Mine still need to be repaired.","nextNodeIds":[721290403]},{"nodeId":721290403,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":3686681602,"text":"If you don't mind, I'll leave those two wards to you, too.","nextNodeIds":[721290404]},{"nodeId":721290404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4262026,"text":"You got it!","nextNodeIds":[721290405]},{"nodeId":721290405,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":800992498,"text":"Thank you very much for your help. Although I am by no means a man of wealth, I promise that you will be paid fairly.","nextNodeIds":[721290406]},{"nodeId":721290406,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":530154778,"text":"I still don't know when it'll happen, but it seems that the time for my reunion with family and friends is drawing a little closer...","nextNodeIds":[721290407]},{"nodeId":721290407,"roleType":"TALK_ROLE_NPC","speakerId":20248,"speakerName":"Kaji","textMapHash":241926354,"text":"By the way, you can find me on the west side of the island once you're done. Fort Mumei came under rebel assault previously, and I suspect that the attack is related to these changes.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7212904,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q3_72129_0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAIN