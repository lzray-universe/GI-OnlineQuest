E_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21958"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7601903],"talks":[{"talkId":7601903,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7601903","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7601903,"initDialog":760190301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21958],"performCfg":"QuestDialogue/WQ/NodKrai_76019/Q7601903","priority":5,"questId":76019,"showRandomTalkCount":0},"dialogs":[{"nodeId":760190301,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":3257493146,"text":"...If you plan to kill me or chop me into pieces, go ahead. I won't resist.","nextNodeIds":[760190302]},{"nodeId":760190302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3314401834,"text":"#Whoa, whoa! {NICKNAME} and Paimon would never do anything like that! You just promise us you won't trick anyone else, okay?","nextNodeIds":[760190303]},{"nodeId":760190303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2791019946,"text":"Even a blockhead like Vieri... Wait, where did he slip off to? ...A—Anyway, you shouldn't take advantage of people — not even the dumb ones!","nextNodeIds":[760190304]},{"nodeId":760190304,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2005272530,"text":"You're kinder than most. If I'd met more folks like you back in Sumeru... maybe I wouldn't have ended up like this.","nextNodeIds":[760190305]},{"nodeId":760190305,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":4055892610,"text":"...","nextNodeIds":[760190306]},{"nodeId":760190306,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2290151082,"text":"Aren't you curious to find out what happened to me?","nextNodeIds":[760190307,760190308]},{"nodeId":760190307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":933835266,"text":"Something tells me I'm better off not knowing...","nextNodeIds":[760190309]},{"nodeId":760190309,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":503940546,"text":"Sharp little thing, aren't you... *sigh* Haven't made a proper deal in ages. Maybe it's time I switched careers — better that than having the Voynich Guild on my case.","nextNodeIds":[760190310]},{"nodeId":760190310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1970040730,"text":"If you'd figured that out earlier, you wouldn't have ended up getting smacked around just now!","nextNodeIds":[760190311]},{"nodeId":760190311,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":3819279106,"text":"Sometimes you need a wake-up call to force a real choice. Good or bad, it gets you moving.","nextNodeIds":[760190312]},{"nodeId":760190312,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":4127213530,"text":"Kid, flying one, if either of you ever needs that kind of a push... come find me.","nextNodeIds":[760190313]},{"nodeId":760190313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3042539250,"text":"Uhm... Thanks and all, but Paimon hopes that won't be necessary!","nextNodeIds":[760190314]},{"nodeId":760190314,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":406850298,"text":"Hidimbi leaves her piece of red satin behind and waves goodbye as she leaves...","nextNodeIds":[]},{"nodeId":760190308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3637469378,"text":"2,000,000 Mora and I'll lend an ear.","nextNodeIds":[760190309]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7601903,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7601901","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,