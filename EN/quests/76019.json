se,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7601901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7601901,"initDialog":760190101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21958],"performCfg":"QuestDialogue/WQ/NodKrai_76019/Q7601901","priority":5,"questId":76019,"showRandomTalkCount":0},"dialogs":[{"nodeId":760190101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2874025098,"text":"\"Proof of the Cognoscenti\"? Wait... Are you talking about what Paimon thinks you're talking about...?","nextNodeIds":[760190102]},{"nodeId":760190102,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":4029373842,"text":"Wh—Why are you crowding around?! We're discussing something super top-secret here — a clue about Reed Miller's \"Great Treasure\"...","nextNodeIds":[760190103,760190104]},{"nodeId":760190103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":91092202,"text":"Fantastic! Count me in!","nextNodeIds":[760190105]},{"nodeId":760190105,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":2356328594,"text":"Hmm... fair point. In that case, let's team up! I've been struggling to scrape together enough startup money anyway.","nextNodeIds":[760190106]},{"nodeId":760190106,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":4158981154,"text":"One share for me, one for you... and one for the flying one. That's three shares. 500,000 Mora each.","nextNodeIds":[760190107]},{"nodeId":760190107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1113348474,"text":"500,000 Mora!?","nextNodeIds":[760190108]},{"nodeId":760190108,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2491225730,"text":"*sigh* Vieri, didn't we agree this was supposed to stay between the two of us? I only told you because I trust you.","nextNodeIds":[760190109]},{"nodeId":760190109,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":3541094362,"text":"But 1,500,000 Mora... That's way beyond the sort of startup money I could raise on my own. I can just about scrape together 500,000...","nextNodeIds":[760190110]},{"nodeId":760190110,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":3272308794,"text":"And these two look like seasoned adventurers. If we team up, won't our chances of success go way up?","nextNodeIds":[760190111]},{"nodeId":760190111,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2103574834,"text":"I have high hopes for you, Vieri. And if you think you've found the right people, then I'm willing to give you a shot.","nextNodeIds":[760190112]},{"nodeId":760190112,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2002046322,"text":"Now, as for our flying friend here — given her... unique physique, it's only fair she receives special consideration.","nextNodeIds":[760190113]},{"nodeId":760190113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3358739754,"text":"Ooh! Is that a gift for Paimon?","nextNodeIds":[760190114]},{"nodeId":760190114,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":792611890,"text":"Sort of! It's a special version of Natlan's standard Strength Tonic. We tweaked it so it works for more people — even people who fly. It's totally safe.","nextNodeIds":[760190115]},{"nodeId":760190115,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":829834370,"text":"As for the price... Normally, it goes for 2,000,000 Mora. But since you're with Vieri, I'll give you the friends' rate — just 1,000,000. What do you say?","nextNodeIds":[760190116]},{"nodeId":760190116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3116314370,"text":"1,000,000 Mora!?","nextNodeIds":[760190117,760190119]},{"nodeId":760190117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":385765146,"text":"It's a special surprise gift, Paimon!","nextNodeIds":[760190118]},{"nodeId":760190118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2495659242,"text":"More like a special surprise heart attack!","nextNodeIds":[760190121]},{"nodeId":760190121,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":670174890,"text":"Exactly! Miss Hidimbi, I don't expect the flying one to be of much use anyway. It would be silly to waste the Strength Tonic on her.","nextNodeIds":[760190122]},{"nodeId":760190122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3068061778,"text":"Hey! Just what are you trying to say about Paimon!?","nextNodeIds":[760190123]},{"nodeId":760190123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":706806186,"text":"Hmph, all we wanted was to see if you had any good clues for finding treasure, but look at you two! One's shady, the other's just dumb!","nextNodeIds":[760190124]},{"nodeId":760190124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3068426754,"text":"#If you think you can trick the great adventurers, {NICKNAME} and Paimon, you'd better think again!","nextNodeIds":[760190125]},{"nodeId":760190125,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":1748826626,"text":"Shady? Trick you? I assure you this clue's entirely genuine, and so is the tonic. As for the price... that's just business. But as for you, little loudmouth...","nextNodeIds":[760190126]},{"nodeId":760190126,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2500766434,"text":"...You're exactly the sort of person I can't stand dealing with — loud, full of yourself, all bark and no bite, riding on someone else's coattails like you're a big deal yourself.","nextNodeIds":[760190127]},{"nodeId":760190127,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":169308850,"text":"M—Miss Hidimbi...?","nextNodeIds":[760190128]},{"nodeId":760190128,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2978342410,"text":"And you, Vieri. Didn't we agree this was supposed to stay between us? When something's meant to be secret, you lean in close and whisper — not shout for the whole world to hear and attract unwanted company.","nextNodeIds":[760190129]},{"nodeId":760190129,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":2999101562,"text":"You've put me in a foul mood now, and I won't feel any better until I've taught you a lesson!","nextNodeIds":[760190130]},{"nodeId":760190130,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":3368950962,"text":"Take this!","nextNodeIds":[]},{"nodeId":760190119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2678137178,"text":"500,000. Not a Mora more. Shake now, or we walk.","nextNodeIds":[760190120]},{"nodeId":760190120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4210883010,"text":"Why are you bargaining?! We don't even need this thing!","nextNodeIds":[760190121]},{"nodeId":760190104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3894510970,"text":"If somebody overhears it, it's not really a secret.","nextNodeIds":[760190105]}]},{"talkId":7601902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7601901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7600341","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","",