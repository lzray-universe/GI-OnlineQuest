60190217,760190219]},{"nodeId":760190217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":308890290,"text":"It's a special surprise gift, Paimon!","nextNodeIds":[760190218]},{"nodeId":760190218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":857453554,"text":"More like a special surprise heart attack!","nextNodeIds":[760190221]},{"nodeId":760190221,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":221155138,"text":"Exactly! Miss Hidimbi, I don't expect the flying one to be of much use anyway. It would be silly to waste the Strength Tonic on her.","nextNodeIds":[760190222]},{"nodeId":760190222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":352089138,"text":"Wait a second... Hidimbi!? You're the one who scammed Netochka!","nextNodeIds":[760190223]},{"nodeId":760190223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1208170546,"text":"Hmph, all we wanted was to see if you had any good clues for finding treasure, but it turns out you're shady, and he's just dumb!","nextNodeIds":[760190224]},{"nodeId":760190224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1914835730,"text":"#If you think you can trick the great adventurers, {NICKNAME} and Paimon, you'd better think again!","nextNodeIds":[760190225]},{"nodeId":760190225,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":3056935058,"text":"Shady? Trick you? I assure you this clue's entirely genuine, and so is the tonic. As for the price... that's just business. But as for you, little loudmouth...","nextNodeIds":[760190226]},{"nodeId":760190226,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":94102642,"text":"...You're exactly the sort of person I can't stand dealing with — loud, full of yourself, all bark and no bite, riding on someone else's coattails like you're a big deal yourself.","nextNodeIds":[760190227]},{"nodeId":760190227,"roleType":"TALK_ROLE_NPC","speakerId":21959,"speakerName":"Vieri","textMapHash":816544586,"text":"M—Miss Hidimbi...?","nextNodeIds":[760190228]},{"nodeId":760190228,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":205694938,"text":"And you, Vieri. Didn't we agree this was supposed to stay between us? When something's meant to be secret, you lean in close and whisper — not shout for the whole world to hear and attract unwanted company.","nextNodeIds":[760190229]},{"nodeId":760190229,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":4021093650,"text":"You've put me in a foul mood now, and I won't feel any better until I've taught you a lesson!","nextNodeIds":[760190230]},{"nodeId":760190230,"roleType":"TALK_ROLE_NPC","speakerId":21958,"speakerName":"Hidimbi","textMapHash":3506372594,"text":"Take this!","nextNodeIds":[]},{"nodeId":760190219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2389963482,"text":"500,000. Not a Mora more. Shake now, or we walk.","nextNodeIds":[760190220]},{"nodeId":760190220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1417664090,"text":"Why are you bargaining?! We don't even need this thing!","nextNodeIds":[760190221]},{"nodeId":760190204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4000068858,"text":"If somebody overhears it, it's not really a secret.","nextNodeIds":[760190205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7601901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7601902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA