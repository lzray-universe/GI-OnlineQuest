],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7422201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7422201,"initDialog":742220101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5343],"performCfg":"","priority":5,"questId":74222,"showRandomTalkCount":0},"dialogs":[{"nodeId":742220101,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":3943670298,"text":"Stay on your guard, citizen!","nextNodeIds":[742220102,742220106,742220109,742220116]},{"nodeId":742220102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3619835642,"text":"What are you doing?","nextNodeIds":[742220103]},{"nodeId":742220103,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":1449013714,"text":"Me? It is as you see. I am busy dealing with the barbarian threat! They have been stepping up their attacks — perhaps they might even have sent spies!","nextNodeIds":[742220104]},{"nodeId":742220104,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":3821087610,"text":"This is no trivial matter! Vigilance must be maintained until reinforcements arrive!","nextNodeIds":[742220105]},{"nodeId":742220105,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":1138837570,"text":"If there is anything else, please bring it up with my adjutant, citizen.","nextNodeIds":[]},{"nodeId":742220106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3119207522,"text":"A child, out here on their own...","nextNodeIds":[742220107]},{"nodeId":742220107,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":434022170,"text":"Hmm? A child? Where from? Did some new legionnaire disobey orders and bring their family into the camp again...?","nextNodeIds":[742220108]},{"nodeId":742220108,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":2102978922,"text":"*sigh* Dominus Cassiodor is far too gentle with these greenhorns. If this were to have happened three decades prior, a Tribunus would've had a whip out by now...","nextNodeIds":[]},{"nodeId":742220109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3943752074,"text":"Have there been any suspicious happenings lately?","nextNodeIds":[742220110]},{"nodeId":742220110,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":3699837410,"text":"Not at present. That said, the barbarians are akin to cunning beasts. Ever will they strike when your guard has been lowered, for surprise is their greatest weapon!","nextNodeIds":[742220111]},{"nodeId":742220111,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":2535115250,"text":"By methods most foul they infiltrate our cities and seek out our secrets. Even the slightest lapse in discipline may lead to catastrophe.","nextNodeIds":[742220112]},{"nodeId":742220112,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":3532076146,"text":"*sigh* Thirty years ago, when I followed Dominus Boethius to conquest in the far north, they were but a pack of primitives without any such skill for subterfuge. Where did they learn these tricks?","nextNodeIds":[742220113]},{"nodeId":742220113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2404500162,"text":"Thirty years ago... Your parents wouldn't even have been born yet...","nextNodeIds":[742220114]},{"nodeId":742220114,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":3233181242,"text":"Hmm? What did you just say, citizen? I fear my hearing's been going as I age.","nextNodeIds":[742220115]},{"nodeId":742220115,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":1657555690,"text":"*sigh* Time truly is cruel. During the conquest of Bituria, I could hear the barbarians' bells calling them to muster from miles away.","nextNodeIds":[]},{"nodeId":742220116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1707676338,"text":"Goodbye.","nextNodeIds":[742220117]},{"nodeId":742220117,"roleType":"TALK_ROLE_NPC","speakerId":5343,"speakerName":"Moce","textMapHash":1173886426,"text":"Fare ye well, citizen! You may report suspicious people to me at any time!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7422208,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7419616,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7422202,"order":3,"stepDescription":"","stepDescTextMapHash":684450404,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7422202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7422202],"talks":[{"talkId":7422202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7422202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7422202,"initDialog":742220201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5337],"performCfg":"","priority":5,"questId":74222,"showRandomTalkCount":0},"dialogs":[{"nodeId":742220201,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":1427814106,"text":"*sigh* I wonder when this war will finally be over...","nextNodeIds":[742220202]},{"nodeId":742220202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":299392674,"text":"What are you doing up there on the roof?","nextNodeIds":[742220203]},{"nodeId":742220203,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":3079503562,"text":"Hmmm? I'm monitoring the area for any suspicious barbarian activity, of course! Recently... Wait a moment. How did you get up this watchtower, citizen?","nextNodeIds":[742220204]},{"nodeId":742220204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4181864554,"text":"That's my line, really...","nextNodeIds":[742220205]},{"nodeId":742220205,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":3752031906,"text":"*sigh* Whatever, that isn't important. Tribunus Mettius says that the savages' assaults are advancing apace. The latest news is that they might have sent spies among us. We must be on guard.","nextNodeIds":[742220206]},{"nodeId":742220206,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":3713223890,"text":"But would those brutes really be interested in our remote little city? To the extent that they would go through all the trouble of sending spies?","nextNodeIds":[742220207]},{"nodeId":742220207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":639240058,"text":"Meat is meat, no matter how small the portion.","nextNodeIds":[742220208]},{"nodeId":742220208,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":3752716818,"text":"Ah, citizen, you speak true! It seems I must keep to my task. Hmm... Judging by how you spoke, might you be experienced in such matters?","nextNodeIds":[742220209]},{"nodeId":742220209,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":3031401138,"text":"In which case, could I entreat you to survey the surrounding area? Should the barbarians have been active, they must have left some trail. Like a wooden sword, perhaps...","nextNodeIds":[742220210]},{"nodeId":742220210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3362104314,"text":"Uh, like kids play-fighting?","nextNodeIds":[742220211]},{"nodeId":742220211,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":2123195122,"text":"Well now, they *are* savages. Would it be so strange that they would use sticks as weapons?","nextNodeIds":[742220212]},{"nodeId":742220212,"roleType":"TALK_ROLE_NPC","speakerId":5337,"speakerName":"Giovanni","textMapHash":310344322,"text":"In any case, I am counting on you. Should you discover anything, report back to me — consider it your joyous duty as a Remurian.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7422202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7419616,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,