0604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":273687642,"text":"We're here because we care about you, just like you do us! That's what makes us Lupical, right?","nextNodeIds":[100080605]},{"nodeId":100080605,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":3153665714,"text":"Right... We are Lupical forever.","nextNodeIds":[100080606]},{"nodeId":100080606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":363343090,"text":"Aww.. and now, there won't be any more intruders in Wolvendom!","nextNodeIds":[100080607]},{"nodeId":100080607,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":1156647490,"text":"No... Dark wolf pack, rip open sky. They... could come again.","nextNodeIds":[100080608]},{"nodeId":100080608,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":3415344178,"text":"But, me and Lupical will hunt them down... no matter what.","nextNodeIds":[100080609]},{"nodeId":100080609,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1999032114,"text":"...Don't forget about us, now.","nextNodeIds":[100080610]},{"nodeId":100080610,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2558824322,"text":"Yeah, if you ever need help, just say the word! We're here for you!","nextNodeIds":[100080611]},{"nodeId":100080611,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":3151461026,"text":"I... appreciate it.","nextNodeIds":[100080612]},{"nodeId":100080612,"roleType":"TALK_ROLE_NPC","speakerId":15880,"speakerName":"Distant Howl","textMapHash":213627842,"text":"Awoo!","nextNodeIds":[100080613]},{"nodeId":100080613,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":1832128306,"text":"They... call for me.","nextNodeIds":[100080614]},{"nodeId":100080614,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1600101570,"text":"Sounds like they wanna make sure you're safe.","nextNodeIds":[100080615]},{"nodeId":100080615,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":3608536162,"text":"Then... I should go. Thank you... for the help.","nextNodeIds":[100080616]},{"nodeId":100080616,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":990942338,"text":"Don't mention it! That's what Lupical is for!","nextNodeIds":[100080617]},{"nodeId":100080617,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":4056682706,"text":"With Wolvendom safe for now, Razor bids you farewell and head into the forest.","nextNodeIds":[100080618]},{"nodeId":100080618,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3882893586,"text":"Amid the dense foliage, you notice several pairs of eyes regarding him with warmth, waiting to welcome him home.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1000806,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20301,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["3","1809"],"PAINLIBBLDK":"QUEST_EXEC_LOCK_POINT"},{"LNHLPKELCAL":["1000801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[20301_1:1990.616,250.190,-267.299,0.000,82.650,0.000]"],"NOCCOBOFKHP":20301,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarrat