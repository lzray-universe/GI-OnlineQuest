pantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1000809","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1000801,"initDialog":100080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1011],"performCfg":"QuestDialogue/WQ/Mengde_10008/Q1000801","priority":5,"questId":10008,"showRandomTalkCount":0},"dialogs":[{"nodeId":100080101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3018754298,"text":"Razor!","nextNodeIds":[100080102]},{"nodeId":100080102,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":3135114178,"text":"*sniff* Familiar scent. Ah, you two.","nextNodeIds":[100080103]},{"nodeId":100080103,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":1681677458,"text":"You have been good?","nextNodeIds":[100080104]},{"nodeId":100080104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2294363026,"text":"Hehe, yep! We're doing great! Oh, but what happened to Boreas, Razor? We saw you talking just now. Is it a secret?","nextNodeIds":[100080105]},{"nodeId":100080105,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":919112370,"text":"We go on hunt. I try to convince... wolf lord.","nextNodeIds":[100080106]},{"nodeId":100080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3799442106,"text":"A hunt?","nextNodeIds":[100080107]},{"nodeId":100080107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2005243530,"text":"#(Oh, {NICKNAME}, is that Razor's \"task\"?)","nextNodeIds":[100080108]},{"nodeId":100080108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1441204546,"text":"Are the wolves out of food? Is that why you're going on a hunt?","nextNodeIds":[100080109,100080110]},{"nodeId":100080109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2524344122,"text":"Give me some beast traps...","nextNodeIds":[100080111]},{"nodeId":100080111,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":1766950706,"text":"No. This hunt is not for food.","nextNodeIds":[100080112]},{"nodeId":100080112,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":382574690,"text":"We hunt... enemies. The dark wolf pack. Strange scent coming from land they took. Getting stronger...","nextNodeIds":[100080113]},{"nodeId":100080113,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":747132330,"text":"We must hunt enemies to purify the forest.","nextNodeIds":[100080114]},{"nodeId":100080114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":664418106,"text":"Oh, so did Boreas agree? Paimon remembers last time he said something like...","nextNodeIds":[100080115]},{"nodeId":100080115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1159710898,"text":"\"Razor, you must not get involved. This is for the wolves to settle between themselves.\"","nextNodeIds":[100080116]},{"nodeId":100080116,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":528233122,"text":"...","nextNodeIds":[100080117]},{"nodeId":100080117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4061368666,"text":"Ah, sorry, Razor. Paimon didn't mean to dig that up again...","nextNodeIds":[100080118]},{"nodeId":100080118,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":3516691826,"text":"It's okay. I know Lupical means no harm. Besides, teacher taught me how to talk to wolf lord.","nextNodeIds":[100080119]},{"nodeId":100080119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2748923738,"text":"Lisa taught you how to talk to him...?","nextNodeIds":[100080120]},{"nodeId":100080120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1419083346,"text":"Oh! Like, she told you what to say? So that means you got him to agree then, right?","nextNodeIds":[100080121]},{"nodeId":100080121,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":3635293394,"text":"Yes. Words were... hard. But I did it.","nextNodeIds":[100080122]},{"nodeId":100080122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1514169314,"text":"Hah, so you actually managed to convince that giant, stubborn old fella! That's super impressive, Razor!","nextNodeIds":[100080123]},{"nodeId":100080123,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":1210336282,"text":"Dark wolves are enemies of the whole world. Teacher said this is not wolf problem. This is world problem... And wolf lord agreed.","nextNodeIds":[100080124]},{"nodeId":100080124,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":1649431434,"text":"But, because of that, other wolves won't join. This war is between me and dark wolf pack...","nextNodeIds":[100080125]},{"nodeId":100080125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":912071770,"text":"Then, count us in too! Those awful Rifthounds have been getting on our nerves for a while!","nextNodeIds":[100080126]},{"nodeId":100080126,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":630690586,"text":"Th—Thank you... Help makes for easy hunt.","nextNodeIds":[100080127]},{"nodeId":100080127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1121034954,"text":"Speaking of, how is this hunt gonna work?","nextNodeIds":[100080128]},{"nodeId":100080128,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":761227570,"text":"We set trap. Chase dark wolves here. Into trap.","nextNodeIds":[100080129]},{"nodeId":100080129,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":2308781834,"text":"Then wolf lord pin them down, and we... finish hunt.","nextNodeIds":[100080130]},{"nodeId":100080130,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"Razor","textMapHash":12631506,"text":"Tell me when ready. We start hunt.","nextNodeIds":[100080401]},{"nodeId":100080401,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1818202410,"text":"Let's do this!","nextNodeIds":[]},{"nodeId":100080110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3461799026,"text":"The forest boars have grown big enough.","nextNodeIds":[100080111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1000801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20301,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET"