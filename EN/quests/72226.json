eType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4150238514,"text":"It was pretty dicey.","nextNodeIds":[722260305]},{"nodeId":722260305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2327817042,"text":"Hehe. We're pretty seasoned travelers, after all!","nextNodeIds":[722260306]},{"nodeId":722260306,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":2913785802,"text":"#Actually, {NICKNAME}, where are you from?","nextNodeIds":[722260307]},{"nodeId":722260307,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":1872489962,"text":"The people who came before talked about places called Inazuma and Narukami Island. Are you from Inazuma?","nextNodeIds":[722260308,722260312]},{"nodeId":722260308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":805477218,"text":"If you're speaking relatively...","nextNodeIds":[722260309]},{"nodeId":722260309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2104391882,"text":"Huh, that's right, we did come from Narukami Island, didn't we... Wait a moment!","nextNodeIds":[722260310]},{"nodeId":722260310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2845582674,"text":"Paimon's almost forgotten that we're here for the Maushiro!","nextNodeIds":[722260312]},{"nodeId":722260311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4100459706,"text":"We're from a very, very distant place...","nextNodeIds":[722260312]},{"nodeId":722260312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1649609946,"text":"That's true...","nextNodeIds":[722260313]},{"nodeId":722260313,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":230207922,"text":"...","nextNodeIds":[722260314]},{"nodeId":722260314,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":322350034,"text":"Wow! You even climbed on top of a dragon?","nextNodeIds":[722260315,722260316]},{"nodeId":722260315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3991066802,"text":"Well, it was a pretty uncomfortable affair.","nextNodeIds":[722260317]},{"nodeId":722260316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3673615826,"text":"It was alright.","nextNodeIds":[722260317]},{"nodeId":722260317,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":514600946,"text":"That's so awesome...","nextNodeIds":[722260318]},{"nodeId":722260318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2394748498,"text":"The world's a big place, kiddo!","nextNodeIds":[722260319]},{"nodeId":722260319,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":3389596650,"text":"I never knew that there were so many places outside the Sea of Fog. If I leave someday, I'd love to see all of them!","nextNodeIds":[722260320]},{"nodeId":722260320,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":2733879738,"text":"They always tell us that our souls will become lost if we leave the fog, and that the fog protects us from the darkness outside.","nextNodeIds":[722260321]},{"nodeId":722260321,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":68109586,"text":"But I've met quite a few people from the outside. That's why I know that the Sea of Silence must be inhabited somehow.","nextNodeIds":[722260322]},{"nodeId":722260322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2588993474,"text":"You can come with us if you have the chance.","nextNodeIds":[722260323]},{"nodeId":722260323,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":1293394218,"text":"Alright! It's a deal, then!","nextNodeIds":[722260324]},{"nodeId":722260324,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":206301498,"text":"You two go ahead first!","nextNodeIds":[722260325]},{"nodeId":722260325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2288588050,"text":"Once the ceremony's over, let's explore the world outside Tsurumi Island together!","nextNodeIds":[722260326]},{"nodeId":722260326,"roleType":"TALK_ROLE_NPC","speakerId":20452,"speakerName":"Ruu","textMapHash":1173151978,"text":"Sure!","nextNodeIds":[]}]},{"talkId":7222606,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7222605","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}