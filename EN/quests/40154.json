_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_300300740:2515.331,202.810,-1136.838]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4015402,"order":3,"stepDescription":"Talk to Lisa","stepDescTextMapHash":651016956,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4015401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_300300735:2529.301,204.921,-1126.802,0.000,221.111,0.000]","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[4015401],"talks":[{"talkId":4015401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4015402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4015401,"initDialog":401540101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1007,1006],"performCfg":"QuestDialogue/EQ/V4.5AlchemySim_40154/Q4015401","priority":5,"questId":40154,"showRandomTalkCount":0},"dialogs":[{"nodeId":401540101,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3213801050,"text":"You continue to run the potion shop. Thanks to all your hard work, your earnings surpass expectations...","nextNodeIds":[401540102]},{"nodeId":401540102,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1479719058,"text":"Wow, I have to hand it to you, cuties. I never imagined that you'd be able to bring in so much Mora in such a short amount of time...","nextNodeIds":[401540103]},{"nodeId":401540103,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2557071938,"text":"You're practically geniuses when it comes to business.","nextNodeIds":[401540104,401540107]},{"nodeId":401540104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":693636474,"text":"It's all thanks to your help.","nextNodeIds":[401540105]},{"nodeId":401540105,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1325909746,"text":"Hehe, always so humble...","nextNodeIds":[401540106]},{"nodeId":401540106,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2999247154,"text":"Although, with results this impressive, I would say you could stand to take a bit more credit.","nextNodeIds":[401540109]},{"nodeId":401540109,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3215929450,"text":"If I had your help all the time, I bet I could take double the amount of vacation without a care in the world.","nextNodeIds":[401540110]},{"nodeId":401540110,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":491246850,"text":"With all your hard work up to this point, we've already collected enough sales data for our research. Thank you so much for all your help.","nextNodeIds":[401540111]},{"nodeId":401540111,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2763530506,"text":"Of course, if you're interested in continuing to run the shop, you'd make me a very happy Lisa.","nextNodeIds":[401540112]},{"nodeId":401540112,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1175108322,"text":"In either case, I should already have more than enough to report back to Jean with.","nextNodeIds":[401540113]},{"nodeId":401540113,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2820594,"text":"#{NICKNAME}, Paimon, it's been a long time.","nextNodeIds":[401540114]},{"nodeId":401540114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3808428778,"text":"Jean!","nextNodeIds":[401540115]},{"nodeId":401540115,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2389917866,"text":"Oh, you're here! I wrapped up some business with my cuties, and was just about to go report back to you at headquarters.","nextNodeIds":[401540116]},{"nodeId":401540116,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4092088002,"text":"No need. I already talked to some other knights, so I think I have fairly good understanding of the situation.","nextNodeIds":[401540117]},{"nodeId":401540117,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4251422378,"text":"#Looks like you've troubled {NICKNAME} to help you once again?","nextNodeIds":[401540118]},{"nodeId":401540118,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3892787170,"text":"Hehe, how could I not? When it comes to work as important as this, a smart and capable partner is simply a must have — especially if we want good results.","nextNodeIds":[401540119]},{"nodeId":401540119,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":571453850,"text":"Look at the success of the shop! I could have never produced that kind of result on my own.","nextNodeIds":[401540120]},{"nodeId":401540120,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2549252234,"text":"Well, I do have to admit, your success is remarkable.","nextNodeIds":[401540121]},{"nodeId":401540121,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":1780563250,"text":"I've been meaning to come see you for some time now, but work kept getting in the way, and I simply couldn't find the time... Regardless, I just knew I had to come thank you in person.","nextNodeIds":[401540122,401540123]},{"nodeId":401540122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1673983130,"text":"We should thank you for your support as well.","nextNodeIds":[401540124]},{"nodeId":401540124,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":535317810,"text":"It's truly reassuring to have such outstanding members among our ranks.","nextNodeIds":[401540125]},{"nodeId":401540125,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2021192770,"text":"Hehe, once this is all over, I do believe I'm due for a vacation.","nextNodeIds":[401540126]},{"nodeId":401540126,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":2382720698,"text":"I've lost quite a few strands of hair to all the stress.","nextNodeIds":[401540127]},{"nodeId":401540127,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":2403371226,"text":"Of course. Thank you for all your hard work.","nextNodeIds":[401540128]},{"nodeId":401540128,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":336632226,"text":"Seeing you cooped up in that library all the time, I was worried you might be bored. So I thought I'd give you an opportunity to truly make use of your talents.","nextNodeIds":[401540129]},{"nodeId":401540129,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3707331058,"text":"Perhaps I put too much on your plate at once...","nextNodeIds":[401540130]},{"nodeId":401540130,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":838562994,"text":"#It wasn't that bad. After all, it's not like I was in it alone. All the help from the Knights and {NICKNAME} really helped to lessen the load.","nextNodeIds":[401540131]},{"nodeId":401540131,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":1224242498,"text":"Plus, it was fun to get back into research. It's nice to relive those days every once in a while.","nextNodeIds":[401540132]},{"nodeId":401540132,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":437507866,"text":"I'm glad to hear that.","nextNodeIds":[401540133]},{"nodeId":401540133,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3417893074,"text":"#Thank you again for all your help, {NICKNAME}. Please take this as your compensation.","nextNodeIds":[401540134]},{"nodeId":401540134,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3103122778,"text":"Ah, speaking of compensation, I've also prepared a little memento for you. Here, I hope you like it!","nextNodeIds":[]},{"nodeId":401540123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3617212210,"text":"It was a group effort.","nextNodeIds":[401540124]},{"nodeId":401540107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":464764306,"text":"We just got the hang of it along the way.","nextNodeIds":[401540108]},{"nodeId":401540108,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","textMapHash":3184153034,"text":"Hm, a testament to your ability to learn on the job.","nextNodeIds":[401540109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4015401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_300300735:2529.301,204.921,-1126.802,0.000,221.111,0.000]","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4015401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"Lisa","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","count":1},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[140154],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":625735446,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[33485],"EPJHBBIC