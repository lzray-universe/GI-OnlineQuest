QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7600801],"talks":[{"talkId":7600801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7600801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7600801,"initDialog":760080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7109],"performCfg":"QuestDialogue/WQ/NodKrai_76008/Q7600801","priority":5,"questId":76008,"showRandomTalkCount":0},"dialogs":[{"nodeId":760080101,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":2422304282,"text":"Ah, may the moonlight shine upon your path ahead! Are you two here to pray to Lady Kuu{RUBY#[S]Moon Maiden}tar as well?","nextNodeIds":[760080102]},{"nodeId":760080102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1158714402,"text":"Prayer... you mean, in front of this statue? Huh, it really is huge...","nextNodeIds":[760080103]},{"nodeId":760080103,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":838711794,"text":"Hehe, beautiful, isn't it? This \"Idol of the New Moon\" was reportedly carved by a Moonchanter from five hundred years ago, depicting Lady Kuu{RUBY#[S]Moon Maiden}tar's original form.","nextNodeIds":[760080104]},{"nodeId":760080104,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":205999578,"text":"As for Lady Kuu{RUBY#[S]Moon Maiden}tar's birth and the miracles she performed in this sublunary sphere... I am but a humble acolyte, so I shall refrain from going into too many details with you both.","nextNodeIds":[760080105]},{"nodeId":760080105,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":110199234,"text":"In any case, this is the final destination of the pilgrimage route where wishes are offered to Lady Kuu{RUBY#[S]Moon Maiden}tar. Even if you didn't come here to pray, I hope you shall feel her blessings.","nextNodeIds":[760080106]},{"nodeId":760080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4025058258,"text":"Oh, Paimon understands now... Eh? Wait, this is the end? Then what's that super imposing pillar up ahead?","nextNodeIds":[760080107]},{"nodeId":760080107,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":2034408354,"text":"Ahaha... that's not actually a pillar. Beneath it is the \"Court of the First Edict\", an ancient sanctuary that was sealed off 500 years ago by Moonchanter decree.","nextNodeIds":[760080108]},{"nodeId":760080108,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":3401891570,"text":"In a sense... you could say it's forbidden ground for us Frostmoon Scions. And because of the Moonchanter's seal, no one can enter anymore, so it's better not to get too close.","nextNodeIds":[760080109]},{"nodeId":760080109,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":575864410,"text":"And as for that huge edifice up there... it actually fell from the sky. By Lady Kuu{RUBY#[S]Moon Maiden}tar's grace, none of the falling debris hurt anyone...","nextNodeIds":[760080110]},{"nodeId":760080110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3911964026,"text":"Um, debris?","nextNodeIds":[760080111]},{"nodeId":760080111,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":4058623842,"text":"Yes, when it came down, several fragments fell from it. One of them fell into the <color=#00E1FFFF>camp below</color>... You two must have seen it on your way here, right?","nextNodeIds":[760080112]},{"nodeId":760080112,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":3644696938,"text":"As for the other, slightly larger fragments, I remember that they mostly fell to the <color=#00E1FFFF>west</color>...","nextNodeIds":[760080113]},{"nodeId":760080113,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"Eveliina","textMapHash":3128074458,"text":"In any case, it was surely Lady Kuutar's guidance that brought you both here. Even if you did not come to pray, may the moonlight bless your path ahead.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7600801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7601101,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_