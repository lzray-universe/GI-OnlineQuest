{"mainQuestId":71673,"title":"Vigorous Brushstrokes","description":"You bump into a painter who offers free souvenir paintings for tourists in Liyue Harbor...","titleTextMapHash":2922271951,"descTextMapHash":3409539006,"mainQuestExcel":{"mainQuestId":71673,"titleTextMapHash":2922271951,"title":"Vigorous Brushstrokes","descTextMapHash":3409539006,"description":"You bump into a painter who offers free souvenir paintings for tourists in Liyue Harbor...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2045,"luaPath":"Actor/Quest/WQ71673","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2045,"chapterId":0,"descTextMapHash":3409539006,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71673,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2120484793,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71673","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171673],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2922271951,"type":"WQ","unlockDescTextMapHash":3837149318}},"flow":[{"subQuestId":7167301,"order":1,"stepDescription":"Talk to Wenji","stepDescTextMapHash":56933748,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30952"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7167301],"talks":[{"talkId":7167301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7167301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7167301,"initDialog":716730101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30952],"performCfg":"QuestDialogue/WQ/HDJ_71673/Q7167301","priority":5,"questId":71673,"showRandomTalkCount":0},"dialogs":[{"nodeId":716730101,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":3421214826,"text":"Hmm... Something feels missing from this painting. Maybe I need a bit more inspiration...","nextNodeIds":[716730102]},{"nodeId":716730102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3130466578,"text":"What are you...","nextNodeIds":[716730103]},{"nodeId":716730103,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":76510306,"text":"#Wow, look who it is! {NICKNAME}, I've heard so much about you — what an honor to finally meet you.","nextNodeIds":[716730104]},{"nodeId":716730104,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":2416568402,"text":"As you can see, I'm setting up a festival venue following the plans from the Ministry of Civil Affairs.","nextNodeIds":[716730105]},{"nodeId":716730105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1440457794,"text":"Umm... Are you gonna teach others to draw?","nextNodeIds":[716730106]},{"nodeId":716730106,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":2941471642,"text":"Ah, not quite! Instead of \"teaching others to draw,\" I am going to \"draw for others.\"","nextNodeIds":[716730107]},{"nodeId":716730107,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":3820307762,"text":"As the Lantern Rite grows bigger each year, more and more people come to join in, and many of them are tourists from faraway lands.","nextNodeIds":[716730108]},{"nodeId":716730108,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":534180506,"text":"Although the Ministry of Civil Affairs offers complimentary souvenir photos, that still doesn't quite embody the spirit of Liyue.","nextNodeIds":[716730109]},{"nodeId":716730109,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":1949274970,"text":"That's why they sent me here — to create hand-drawn souvenirs for the visitors.","nextNodeIds":[716730110]},{"nodeId":716730110,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":1993852826,"text":"I noticed that the legend of the \"White Horse Adeptus\" is pretty well-known around Liyue Harbor, so I figured it'd make a great theme for a drawing.","nextNodeIds":[716730111]},{"nodeId":716730111,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":3994248810,"text":"You know how the saying goes: vibrant as dragons, spirited as steeds. So really, what's more auspicious than a \"flying gallop\" painting with a white horse? It's got that same bold, uplifting energy people associate with dragons and tigers.","nextNodeIds":[716730112]},{"nodeId":716730112,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":3211902274,"text":"#What do you think, {NICKNAME}? Got any ideas for a drawing?","nextNodeIds":[716730113]},{"nodeId":716730113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3594640242,"text":"Well, I have quite a lot...","nextNodeIds":[716730114]},{"nodeId":716730114,"roleType":"TALK_ROLE_NPC","speakerId":30952,"speakerName":"Wenji","textMapHash":443808442,"text":"Oh? Hahaha, great! Just tell me your idea, and I'll make it happen.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"