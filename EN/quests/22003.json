performCfg":"","priority":3,"questId":22003,"showRandomTalkCount":0},"dialogs":[{"nodeId":220030401,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":403655941,"text":"And don't delay! A happy cheapskate is preferable to a hungry cheapskate, trust me.","nextNodeIds":[220030402]},{"nodeId":220030402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1690135973,"text":"Why do you cook for him?","nextNodeIds":[220030403]},{"nodeId":220030403,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3995599957,"text":"If you must know, it's because he's got no one else. I'm the only person he knows in the whole of Liyue. And this is the only place he dares to try and scrounge from.","nextNodeIds":[220030404]},{"nodeId":220030404,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":2505916629,"text":"...What's the reason? Why does it matter? Fine... It's because I'm willing to cook for him. Happy now?","nextNodeIds":[220030405]},{"nodeId":220030405,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3348784269,"text":"If I wasn't willing to cook for him, he'd probably go and do something stupid down at Dihua Marsh again. And we can't be having that.","nextNodeIds":[220030406]},{"nodeId":220030406,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":1008409909,"text":"What are you still hanging round here for? Quit dawdling and get going!","nextNodeIds":[]}]},{"talkId":2200305,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200304","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["100376","1",""],"type":"QUEST_COND_PACK_HAVE_ITEM"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200305,"initDialog":220030501,"nextRandomTalks":[],"nextTalks":[],"npcId":[220101],"performCfg":"","priority":3,"questId":22003,"showRandomTalkCount":0},"dialogs":[{"nodeId":220030501,"roleType":"TALK_ROLE_NPC","speakerId":220101,"speakerName":"Jiangxue","textMapHash":3797854749,"text":"Hello? Is it me you're looking for?","nextNodeIds":[220030502]},{"nodeId":220030502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3102109693,"text":"This is from Smiley Yanxiao.","nextNodeIds":[220030503]},{"nodeId":220030503,"roleType":"TALK_ROLE_NPC","speakerId":220101,"speakerName":"Jiangxue","textMapHash":2195264861,"text":"Aha! I was wondering where that delicious smell was coming from. He's a really talented chef, you know.","nextNodeIds":[220030504]},{"nodeId":220030504,"roleType":"TALK_ROLE_NPC","speakerId":220101,"speakerName":"Jiangxue","textMapHash":187314061,"text":"Thanks for bringing this. And make sure you thank him profusely for me when you get back.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100376"],"PAINLIBBLDK":"QUEST_EXEC_DEL_ALL_SPECIFIC_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCL