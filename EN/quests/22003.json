dden":false,"talkIds":[2200301],"talks":[{"talkId":2200301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200301","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200301,"initDialog":220030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[220401],"performCfg":"","priority":3,"questId":22003,"showRandomTalkCount":0},"dialogs":[{"nodeId":220030101,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":447522189,"text":"Hmph, he's got some nerve scrounging off me all this time...","nextNodeIds":[220030102]},{"nodeId":220030102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2763344861,"text":"What are you doing?","nextNodeIds":[220030103]},{"nodeId":220030103,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":1912189405,"text":"I'm cooking for someone who doesn't deserve it, that's what!","nextNodeIds":[220030104]},{"nodeId":220030104,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":1225244053,"text":"Unbelievable! He whiles away his time doing whatever he pleases and doesn't even offer to help at the inn.","nextNodeIds":[220030105]},{"nodeId":220030105,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":1496513021,"text":"He spends most of his day fishing, but I've never seen him catch more than a couple of tiddlers.","nextNodeIds":[220030106]},{"nodeId":220030106,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3395369381,"text":"If it wasn't for me, he'd starve to death!","nextNodeIds":[220030107]},{"nodeId":220030107,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3970029901,"text":"Ugh, what's the use in complaining. He can't hear me — and even if he could, he'd act like he hadn't.","nextNodeIds":[220030108]},{"nodeId":220030108,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":766168781,"text":"If you've got nothing better to do, you can go grab me a couple of extra ingredients. I'm running low here.","nextNodeIds":[220030109]},{"nodeId":220030109,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3282714741,"text":"Don't need much. Just one <color=#00E1FFFF>Jueyun Chili</color> and one <color=#00E1FFFF>Lotus Head</color> will do it.","nextNodeIds":[220030110,220030112]},{"nodeId":220030110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3642993765,"text":"Okay.","nextNodeIds":[220030111]},{"nodeId":220030111,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":649552085,"text":"Bring them back here as soon as you find them. I want to get this done and dusted.","nextNodeIds":[]},{"nodeId":220030112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3621176901,"text":"But there's plenty of ingredients here...","nextNodeIds":[220030113]},{"nodeId":220030113,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":2488002053,"text":"My boss paid good money for those. Do you think this freeloader's gonna pay my boss back? I think not.","nextNodeIds":[220030114]},{"nodeId":220030114,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":67158405,"text":"Everything I cook for him comes out of my own pocket... Hmph, he owes me big time!","nextNodeIds":[220030115]},{"nodeId":220030115,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":1340242941,"text":"Just go fetch the vegetables, will you? It's not a huge ask, and it won't take you long.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["220401"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2200302,"order":2,"stepDescription":"Help Smiley Yanxiao find Jueyun Chili and Lotus Head","stepDescTextMapHash":3954064754,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200302,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["220401"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE