":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200306,"initDialog":220030601,"nextRandomTalks":[],"nextTalks":[],"npcId":[220401],"performCfg":"","priority":3,"questId":22003,"showRandomTalkCount":0},"dialogs":[{"nodeId":220030601,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3967890509,"text":"Did you deliver the food?","nextNodeIds":[220030602]},{"nodeId":220030602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2631453085,"text":"Yes, and he said to make sure I—","nextNodeIds":[220030603]},{"nodeId":220030603,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":1609670669,"text":"Thank me profusely? Please. Spare me that charade.","nextNodeIds":[220030604]},{"nodeId":220030604,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":665545437,"text":"The number of times I've heard those words these last few years... drives me mad.","nextNodeIds":[220030605]},{"nodeId":220030605,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3387222045,"text":"Thanking me profusely seems to be his only other pastime aside from fishing. Tell you what, how about pack all that in, stop wasting time, and come earn your keep at the inn?","nextNodeIds":[220030606]},{"nodeId":220030606,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3487554381,"text":"Ah, there's no use me venting at you. Here's your reward — you've earned it, unlike some people. Now you can get back to living your life.","nextNodeIds":[]}]},{"talkId":2200307,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200305","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200307,"initDialog":220030701,"nextRandomTalks":[],"nextTalks":[],"npcId":[220101],"performCfg":"","priority":3,"questId":22003,"showRandomTalkCount":0},"dialogs":[{"nodeId":220030701,"roleType":"TALK_ROLE_NPC","speakerId":220101,"speakerName":"Jiangxue","textMapHash":2979600077,"text":"You're still here? ...It's probably best that you get back; when you keep him waiting he tends to throw one of his temper tantrums.","nextNodeIds":[220030702]},{"nodeId":220030702,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":158835437,"text":"Why does he cook for you?","nextNodeIds":[220030703]},{"nodeId":220030703,"roleType":"TALK_ROLE_NPC","speakerId":220101,"speakerName":"Jiangxue","textMapHash":800926237,"text":"We're... friends. We've known each other a very long time.","nextNodeIds":[220030704]},{"nodeId":220030704,"roleType":"TALK_ROLE_NPC","speakerId":220101,"speakerName":"Jiangxue","textMapHash":2531189037,"text":"I, uh... I went to Dihua Marsh once to do... a bad thing. But something I had to do.","nextNodeIds":[220030705]},{"nodeId":220030705,"roleType":"TALK_ROLE_NPC","speakerId":220101,"speakerName":"Jiangxue","textMapHash":375903261,"text":"This is the only place in the whole of Liyue where they let me stay, and the chef here makes sure I'm fed.","nextNode