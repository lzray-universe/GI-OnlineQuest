omTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200303","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200303,"initDialog":220030301,"nextRandomTalks":[],"nextTalks":[],"npcId":[220401],"performCfg":"","priority":3,"questId":22003,"showRandomTalkCount":0},"dialogs":[{"nodeId":220030301,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":2327690277,"text":"Wait here. When the food's ready, I'll get you to take it over to him.","nextNodeIds":[220030302]},{"nodeId":220030302,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":2169719557,"text":"Don't look so hard done by! I'm not making you do this for free. You'll get what you deserve, don't you worry.","nextNodeIds":[220030303]},{"nodeId":220030303,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":3314656525,"text":"Alright. It's ready. Take this over to Mr. Doesn't-Know-How-Lucky-He-Is...","nextNodeIds":[220030304]},{"nodeId":220030304,"roleType":"TALK_ROLE_NPC","speakerId":220401,"speakerName":"Smiley Yanxiao","textMapHash":4153318661,"text":"His name is <color=#00E1FFFF>Jiangxue</color>. He'll be fishing down by the water, you can't miss him.","nextNodeIds":[220030305]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2200303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP"