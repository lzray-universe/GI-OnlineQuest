{"mainQuestId":73354,"title":"Shadow of the Knight's Blade","description":"Vihar and the researcher Safi are currently preparing for a special event that will tell the tale of \"The Unknown Battles of the Knight of Flowers\"...","titleTextMapHash":666007671,"descTextMapHash":835320902,"mainQuestExcel":{"mainQuestId":73354,"titleTextMapHash":666007671,"title":"Shadow of the Knight's Blade","descTextMapHash":835320902,"description":"Vihar and the researcher Safi are currently preparing for a special event that will tell the tale of \"The Unknown Battles of the Knight of Flowers\"...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2034,"luaPath":"Actor/Quest/WQ73354","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2034,"chapterId":0,"descTextMapHash":835320902,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73354,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2713419345,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73354","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173354],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":666007671,"type":"WQ","unlockDescTextMapHash":3394853654}},"flow":[{"subQuestId":7335401,"order":1,"stepDescription":"Talk to the two people in trouble","stepDescTextMapHash":1918151236,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30657"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7335401],"talks":[{"talkId":7335401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7335401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7335401,"initDialog":733540101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30657,30658],"performCfg":"QuestDialogue/WQ/SumeruBirth_73354/Q7335401","priority":5,"questId":73354,"showRandomTalkCount":0},"dialogs":[{"nodeId":733540101,"roleType":"TALK_ROLE_NPC","speakerId":30657,"speakerName":"Vihar","textMapHash":1620058834,"text":"The color and intensity of the lighting are perfectly calibrated, and the special effects are simply spectacular. It wouldn't be an exaggeration to name this \"effect-ion perfection.\"","nextNodeIds":[733540102]},{"nodeId":733540102,"roleType":"TALK_ROLE_NPC","speakerId":30657,"speakerName":"Vihar","textMapHash":3694126578,"text":"Amazing, Safi! It's all thanks to you that we were able to see the Knight of Flowers in all his glory, just like in the legends.","nextNodeIds":[733540103]},{"nodeId":733540103,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":928837194,"text":"Oh, pish-posh! I can't take all the credit myself, now can I? Just think of all the work you did. It was far more exhausting than the papers I pushed around.","nextNodeIds":[733540104]},{"nodeId":733540104,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":3200462794,"text":"The most important thing now is the candidate we choose to play the Knight of Flowers... The performer must possess extraordinary skill, with an aura that can compare to the legendary Farris himself. Hmm, those requirements do seem to be a bit steep, don't they?","nextNodeIds":[733540105,733540106]},{"nodeId":733540105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3265935234,"text":"Hey there, whatcha talkin' about?","nextNodeIds":[733540107]},{"nodeId":733540107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3170685130,"text":"Lighting? Special effects? Are you guys worried about putting on a show?","nextNodeIds":[733540108]},{"nodeId":733540108,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":2474705706,"text":"They have appeared! The one and only, the illustrious hero without equal, the supreme candidate to play the Knight of Flowers...","nextNodeIds":[733540109]},{"nodeId":733540109,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":206838642,"text":"No, what I should say is that you yourself fully deserve the title \"Knight of Flowers.\" No asterisks attached!","nextNodeIds":[733540110]},{"nodeId":733540110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3169566762,"text":"#Yikes, this is one excited scholar! His eyes lit up the second he saw you, {NICKNAME}...","nextNodeIds":[733540111,733540112]},{"nodeId":733540111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":339041586,"text":"Oh my, that's a little much.","nextNodeIds":[733540113]},{"nodeId":733540113,"roleType":"TALK_ROLE_NPC","speakerId":30657,"speakerName":"Vihar","textMapHash":963624770,"text":"#Ahem! It is an honor to see you once more, {M#Mr.}{F#Miss} {NICKNAME}. This is a folklorist from Vahumana, Safi.","nextNodeIds":[733540114]},{"nodeId":733540114,"roleType":"TALK_ROLE_NPC","speakerId":30657,"speakerName":"Vihar","textMapHash":577309618,"text":"He's been taking advantage of Sabzeruz Festival fever to plan a film based on various historical documents and folklore, using the latest Fontainian technology.","nextNodeIds":[733540115]},{"nodeId":733540115,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":913533506,"text":"The film focuses on \"The Unknown Battles of the Knight of Flowers.\" It revolves around how the Knight descended into mysterious and profoundly perilous places on the Dendro Archon's behalf, slaying many evils...","nextNodeIds":[733540116]},{"nodeId":733540116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2255269706,"text":"Just hold it right there, Paimon can guess where this is going... You don't have any actors who can fight, so you can't shoot the fight scenes?","nextNodeIds":[733540117]},{"nodeId":733540117,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":2876911458,"text":"#Strictly speaking, whether acting in regular scenes or fight scenes, there is no performer more suitable than {M#Mr.}{F#Miss} {NICKNAME}.","nextNodeIds":[733540118]},{"nodeId":733540118,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":2872370282,"text":"Should you be willing to perform, this film will surely become the single greatest cinematographic work regarding the Knight of Flowers, and will earn substantial revenue from its theater run...","nextNodeIds":[733540119]},{"nodeId":733540119,"roleType":"TALK_ROLE_NPC","speakerId":30657,"speakerName":"Vihar","textMapHash":2386589698,"text":"Naturally, both of you will be adequately compensated.","nextNodeIds":[733540120]},{"nodeId":733540120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2598177858,"text":"#Hehe, with {NICKNAME}'s looks, {M#he}{F#she} deserves to be a star!","nextNodeIds":[733540121]},{"nodeId":733540121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4195332210,"text":"Since this Sabzeruz Festival is kind of a vacation for us, we aren't that busy. We should have time to help shoot a few scenes.","nextNodeIds":[733540122]},{"nodeId":733540122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3027279042,"text":"#What do you think, {NICKNAME}?","nextNodeIds":[733540123,733540126]},{"nodeId":733540123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":250014298,"text":"I'm no actor, but I'm the best at kicking butt.","nextNodeIds":[733540124]},{"nodeId":733540124,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":1000712850,"text":"That you are willing to join our project is truly amazing! Very well, we shall only film the action scenes!","nextNodeIds":[733540125]},{"nodeId":733540125,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":3835756210,"text":"At the same time, we will redesign the Knight of Flowers based on your appearance, and adjust the makeup and costumes of the performers in the other scenes as well.","nextNodeIds":[733540129]},{"nodeId":733540129,"roleType":"TALK_ROLE_NPC","speakerId":30657,"speakerName":"Vihar","textMapHash":1731241370,"text":"#Time waits for no one. If you're ready, {M#Mr.}{F#Miss} {NICKNAME}, shall we begin immediately?","nextNodeIds":[733540130]},{"nodeId":733540130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":836964514,"text":"#Alrighty! It's acting time — for {NICKNAME}'s future as a movie star, and for the Knight of Flowers's heroic legend!","nextNodeIds":[]},{"nodeId":733540126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1624139978,"text":"Fight scenes are really easy. I can give the other scenes a shot, too.","nextNodeIds":[733540127]},{"nodeId":733540127,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":2436334250,"text":"That you are willing to join our project is truly amazing! Words cannot express how grateful we are to you!","nextNodeIds":[733540128]},{"nodeId":733540128,"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","textMapHash":3816414226,"text":"However, the fight scenes are filmed independently from the rest, and we will need to schedule those separately. Once we're ready, I'll have to call you back in again.","nextNodeIds":[733540129]},{"nodeId":733540112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":596449874,"text":"Mmm, music to my ears. Keep the compliments coming, would you?","nextNodeIds":[733540113]},{"nodeId":733540106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1722600146,"text":"Seems like you've got a problem.","nextNodeIds":[733540107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30657"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7335401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30658,"speakerName":"Safi","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":30657,"speakerName":"Vihar","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173354],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":835320902,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/SumeruBirth_73354/Q7335401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"