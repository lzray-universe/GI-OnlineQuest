10105]},{"nodeId":221010105,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":3562806632,"text":"They wouldn't dare come anywhere near the inn itself, but guests need to get in and out and the Millelith can't be here all the time.","nextNodeIds":[221010106]},{"nodeId":221010106,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":2000836312,"text":"If you're free, do you think you could take a look around and clear out any monsters nearby?","nextNodeIds":[221010107,221010108]},{"nodeId":221010107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2163918728,"text":"Okay.","nextNodeIds":[221010109]},{"nodeId":221010109,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":2643955208,"text":"Haha... Ah, I must say I do find your forthrightness refreshing...","nextNodeIds":[221010113]},{"nodeId":221010113,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":632488488,"text":"Speaking of tiring jobs... I do feel bad making you do this.","nextNodeIds":[221010114]},{"nodeId":221010114,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":18472584,"text":"But I promise I will make it worth your time.","nextNodeIds":[221010115]},{"nodeId":221010115,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":3852175976,"text":"Best of luck, and thank you.","nextNodeIds":[]},{"nodeId":221010108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3699845168,"text":"This issue seems self-inflicted...","nextNodeIds":[221010110]},{"nodeId":221010110,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMapHash":995463192,"text":"Yes, we should have known what we were getting into when we chose the location.","nextNodeIds":[221010111]},{"nodeId":221010111,"roleType":"TALK_ROLE_NPC","speakerId":2202,"speakerName":"Huai'an","textMa