LETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3180"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7215801],"talks":[{"talkId":7215801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7215805","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7215801,"initDialog":721580101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3180,3181],"performCfg":"QuestDialogue/WQ/Inazuma_72158/Q7215801","priority":5,"questId":72158,"showRandomTalkCount":0},"dialogs":[{"nodeId":721580101,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":485840938,"text":"The storm... has passed.","nextNodeIds":[721580102]},{"nodeId":721580102,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":2587880410,"text":"It seems like all four Warding Stones have been sealed.","nextNodeIds":[721580103]},{"nodeId":721580103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4062860018,"text":"That they have.","nextNodeIds":[721580104]},{"nodeId":721580104,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1330895850,"text":"I—It's you! How did you get up there?","nextNodeIds":[721580105]},{"nodeId":721580105,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3337484282,"text":"Taisuke said that you passed through some kind of door — and then you disappeared.","nextNodeIds":[721580106]},{"nodeId":721580106,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3931699730,"text":"What on earth is with that door? How strange...","nextNodeIds":[721580107]},{"nodeId":721580107,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":2704369106,"text":"What happened up there, exactly?","nextNodeIds":[721580108]},{"nodeId":721580108,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1991169138,"text":"Etsuko and I heard a sudden rumbling from above, almost like thunder.","nextNodeIds":[721580109]},{"nodeId":721580109,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":4191025890,"text":"But the storm should have abated already...","nextNodeIds":[721580110]},{"nodeId":721580110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1378009106,"text":"Well, here's what happened...","nextNodeIds":[721580111]},{"nodeId":721580111,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":3761396242,"text":"Rocks floating in the sky... formed a platform...","nextNodeIds":[721580112]},{"nodeId":721580112,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1410354834,"text":"Huh. That's... I must confess that I've never heard of such a natural phenomenon occurring on Seirai Island...","nextNodeIds":[721580113]},{"nodeId":721580113,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1622848602,"text":"...Which part of that sounds like a natural phenomenon, seriously...","nextNodeIds":[721580114]},{"nodeId":721580114,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1325893090,"text":"It's super unnatural no matter how you look at it.","nextNodeIds":[721580115,721580116]},{"nodeId":721580115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4250635458,"text":"Agreed.","nextNodeIds":[721580117]},{"nodeId":721580117,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":618091570,"text":"Well, natural or otherwise, the storm over Seirai Island has been calmed, and our commission is complete...","nextNodeIds":[721580118]},{"nodeId":721580118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3516371282,"text":"You know, we also found this strange feather...","nextNodeIds":[721580119]},{"nodeId":721580119,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3694983162,"text":"This is... Taisuke, you have a look.","nextNodeIds":[721580120]},{"nodeId":721580120,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":3480256674,"text":"Alright, allow me...","nextNodeIds":[721580121]},{"nodeId":721580121,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1910459474,"text":"Apologies, but I have no idea where this feather came from.","nextNodeIds":[721580122]},{"nodeId":721580122,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":3751334570,"text":"This feather's pattern and texture are nothing like any birds I know of.","nextNodeIds":[721580123]},{"nodeId":721580123,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":182236482,"text":"And if you study its dimensions and the ratios involved, this bird would have been as large as that stone platform up there in the sky.","nextNodeIds":[721580124]},{"nodeId":721580124,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":2604630034,"text":"Is this feather that important? If you want to figure its history out, why don't you put up a commission at the Guild? Who knows, you might run into someone who can give you a lead.","nextNodeIds":[721580125,721580126]},{"nodeId":721580125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1416109018,"text":"Alright.","nextNodeIds":[721580127]},{"nodeId":721580127,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1133991418,"text":"Well, in that case, thanks again for your help, Adventurer. Taisuke and I will head back to the Guild to make our reports.","nextNodeIds":[721580128]},{"nodeId":721580128,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3137417362,"text":"Ah, right. This is for you. It's not much... But I'd say you're still owed some payment for your help.","nextNodeIds":[721580129]},{"nodeId":721580129,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":4077445226,"text":"Taisuke, get ready to pack it up. We're headed back to the Guild.","nextNodeIds":[721580130]},{"nodeId":721580130,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":3876474218,"text":"Uh, so, Etsuko... Let's drop by that shrine real quick and see Lady Neko, shall we?","nextNodeIds":[721580131]},{"nodeId":721580131,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":899566546,"text":"...Taisuke...","nextNodeIds":[721580132]},{"nodeId":721580132,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":803265194,"text":"Come on! It's a cat that can talk! A talking cat!","nextNodeIds":[721580133]},{"nodeId":721580133,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3371897554,"text":"*sigh* Seriously...","nextNodeIds":[]},{"nodeId":721580126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":174865474,"text":"I'll give it some thought myself...","nextNodeIds":[721580127]},{"nodeId":721580116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":988619666,"text":"You'd be right to say so.","nextNodeIds":[721580117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7215801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3180"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7215801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","count":14},{"roleType":"TALK_ROLE_NPC","speakerId"