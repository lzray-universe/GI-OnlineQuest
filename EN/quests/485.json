"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":48503,"initDialog":4850301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/LQ/Ambor1_485/Q48503","priority":0,"questId":485,"showRandomTalkCount":0},"dialogs":[{"nodeId":4850301,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":882440827,"text":"It looks like there's no way across... Ugh, he must be around here somewhere.","nextNodeIds":[4850302]},{"nodeId":4850302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2878885419,"text":"Amber, over there!","nextNodeIds":[4850303]},{"nodeId":4850303,"roleType":"TALK_ROLE_NPC","speakerId":1485,"speakerName":"Raptor","textMapHash":1388192707,"text":"If you insist on chasing me, so be it... Huh? Who brought the little girl?","nextNodeIds":[4850304]},{"nodeId":4850304,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4163727747,"text":"You must be Raptor! You can't escape!","nextNodeIds":[4850305]},{"nodeId":4850305,"roleType":"TALK_ROLE_NPC","speakerId":1485,"speakerName":"Raptor","textMapHash":4191065275,"text":"Haha, I don't need to escape! There's no way you can make it over here.","nextNodeIds":[4850306]},{"nodeId":4850306,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3978098747,"text":"Oh... It is pretty high... and quite far...","nextNodeIds":[4850307]},{"nodeId":4850307,"roleType":"TALK_ROLE_NPC","speakerId":1485,"speakerName":"Raptor","textMapHash":4198035155,"text":"Oh, little girl, why don't you run along home now and let your leader deal with this? Don't worry, I promise that once the Grand Master gets here, I'll surrender immediately! Haha!","nextNodeIds":[4850308]},{"nodeId":4850308,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":959806043,"text":"Hey, watch it! You're talking to a Knights of Favonius Outrider! You'll be sorry when I arrest you!","nextNodeIds":[4850309,4850310]},{"nodeId":4850309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2822681963,"text":"Deep breaths, Amber.","nextNodeIds":[4850311]},{"nodeId":4850311,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":413243315,"text":"...You're right.","nextNodeIds":[4850312]},{"nodeId":4850312,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3415267723,"text":"Ugh... He's right there in front of us... If only we could glide across.","nextNodeIds":[4850313]},{"nodeId":4850313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3760908427,"text":"So how did HE get across?","nextNodeIds":[4850314,4850317,4850319]},{"nodeId":4850314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3662261291,"text":"Some sort of mechanism?","nextNodeIds":[4850315]},{"nodeId":4850315,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1565725235,"text":"I don't see a mechanism, and I have good eyesight.","nextNodeIds":[4850316]},{"nodeId":4850316,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1988000531,"text":"Besides, there's nowhere on the ledge that you could build one.","nextNodeIds":[4850322]},{"nodeId":4850322,"roleType":"TALK_ROLE_NPC","speakerId":1485,"speakerName":"Raptor","textMapHash":4043506483,"text":"Bye-bye, kiddo...","nextNodeIds":[4850323]},{"nodeId":4850323,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":680176323,"text":"Oh no! He's getting away!","nextNodeIds":[4850324]},{"nodeId":4850324,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1734873315,"text":"We can't hesitate any longer. The only way to get across is to glide there.","nextNodeIds":[4850325]},{"nodeId":4850325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4163970291,"text":"But... but...","nextNodeIds":[4850326]},{"nodeId":4850326,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1198028739,"text":"Don't worry — I'm the Gliding Champion of Mondstadt, remember! If Raptor can do it, I can do it too.","nextNodeIds":[4850327]},{"nodeId":4850327,"roleType":"TALK_ROLE_NPC","speakerId":1485,"speakerName":"Raptor","textMapHash":83760747,"text":"Oi, Outrider! You have less chance of surviving this than jumping off the Anemo God statue in Mondstadt without your wind glider! Haha!","nextNodeIds":[4850328,4850329]},{"nodeId":4850328,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1154703643,"text":"I'm with Amber.","nextNodeIds":[4850330]},{"nodeId":4850330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1254176859,"text":"#Paimon sees your point {NICKNAME}... If you rule out everything that's completely impossible, gliding is the only idea left.","nextNodeIds":[4850331]},{"nodeId":4850331,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1148509731,"text":"#{NICKNAME}, remember that book I lent you? The one I thought was the gliding manual, but wasn't?","nextNodeIds":[4850332]},{"nodeId":4850332,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3394737611,"text":"The first birds couldn't fly. Flight was their reward for their courage to plunge into the canyon.","nextNodeIds":[4850333]},{"nodeId":4850333,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3469580691,"text":"Be my witness.","nextNodeIds":[4850334]},{"nodeId":4850334,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3062577627,"text":"Go! Go! Outrider!","nextNodeIds":[4850335]},{"nodeId":4850335,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4049923011,"text":"Roger! Let's show this guy what an Outrider is made of!","nextNodeIds":[4850336]},{"nodeId":4850336,"roleType":"TALK_ROLE_NPC","speakerId":1485,"speakerName":"Raptor","textMapHash":684377971,"text":"Wait... Stop! You'll never make it! Come on, off you go now, back home like a good little girl.","nextNodeIds":[4850337]},{"nodeId":4850337,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3207406139,"text":"Raptor says I'll never make it. But, if you listen carefully...","nextNodeIds":[4850338]},{"nodeId":4850338,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1799475803,"text":"The wind! The wind says I WILL make it, and that's good enough for me!","nextNodeIds":[]},{"nodeId":4850329,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1242248883,"text":"This will take some serious guts, but it's not completely impossible.","nextNodeIds":[4850330]},{"nodeId":4850317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1459782459,"text":"Some kind of elemental magic?","nextNodeIds":[4850318]},{"nodeId":4850318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1185984995,"text":"#{NICKNAME}, can you see anything with your Elemental Sight...? No? Oh, okay... Never mind...","nextNodeIds":[4850322]},{"nodeId":4850319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2877683715,"text":"A grappling hook, or spikes, or something?","nextNodeIds":[4850320]},{"nodeId":4850320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4264186731,"text":"If it's too far to glide, it's definitely too far for anything like that.","nextNodeIds":[4850321]},{"nodeId":4850321,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3963595059,"text":"There's also no sign of an anchor point.","nextNodeIds":[4850322]},{"nodeId":4850310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3163494147,"text":"Let's examine our surroundings — just like you taught me.","nextNodeIds":[4850311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2006,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":1016,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":48504,"order":8,"stepDescription":"Glide over the chasm","stepDescTextMapHash":1176404559,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48504,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q48504Area"],"NOCCOBOFKHP":1016,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48504,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2006,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q48504Area"],"NOCCOBOFKHP":1016,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":48505,"order":9,"stepDescription":"Track down Raptor and arrest him!","stepDescTextMapHash":1928452183,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[201016005,0],"PAINLIBBLDK":"QUEST_CONTENT_CLEAR_GROUP_MONSTER","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[201016005,0],"PAINLIBBLDK":"QUEST_CONTENT_CLEAR_GROUP_MONSTER","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2006,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":48506,"order":10,"stepDescription":"Talk to Amber","stepDescTextMapHash":1628924447,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48506,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":1016,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[48506],"talks":[{"talkId":48506,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["48506","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":48506,"initDialog":4850601,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/LQ/Ambor1_485/Q48506","priority":0,"questId":485,"showRandomTalkCount":0},"dialogs":[{"nodeId":4850601,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2217594011,"text":"Alright! I got him!","nextNodeIds":[4850602]},{"nodeId":4850602,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4034951267,"text":"I only noticed the wind current from in the air — and it's the only one.","nextNodeIds":[4850603]},{"nodeId":4850603,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3289420827,"text":"It would be suicide to try and escape in the direction Raptor was going.","nextNodeIds":[4850604]},{"nodeId":4850604,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":792851,"text":"In other words, the only way Raptor could have gotten out would be this way — past us.","nextNodeIds":[4850605]},{"nodeId":4850605,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2286032915,"text":"Aha! So he was just trying to fool us by acting smug, in the hope that we would just give up and leave.","nextNodeIds":[4850606]},{"nodeId":4850606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3819203387,"text":"Little did he know, we're not so easily fooled.","nextNodeIds":[4850607]},{"nodeId":4850607,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2747625851,"text":"#It was all thanks to {NICKNAME}'s sharp thinking! Just like a wise man once said, \"Once you eliminate the impossible, whatever remains, no matter how improbable, must be the truth.\"","nextNodeIds":[4850608]},{"nodeId":4850608,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1927380739,"text":"At the end of the day, gliding is seven parts technique, three parts instinct — and then 90 parts courage.","nextNodeIds":[4850609]},{"nodeId":4850609,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2741415091,"text":"What you did now looked more like 99 parts courage...","nextNodeIds":[4850610]},{"nodeId":4850610,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1292635659,"text":"Ah, it was just like in my first gliding exam... I was super nervous, but in the end, there was nothing to be afraid of and I passed no problem.","nextNodeIds":[4850611]},{"nodeId":4850611,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3302034187,"text":"I kinda missed that nervous rush in the exams I've done since then... It just wasn't the same.","nextNodeIds":[4850612]},{"nodeId":4850612,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3259846971,"text":"...Erm, sorry — Paimon thought you said you passed no problem? What do you mean, exams since then?","nextNodeIds":[4850613]},{"nodeId":4850613,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3217184019,"text":"Ah... Well you see, the thing is, Mondstadt is all \"no glide zone\" this, \"no landing zone\" that...","nextNodeIds":[4850614]},{"nodeId":4850614,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1116756955,"text":"*sigh* Every time I get my license it keeps getting revoked. I must have taken the exam about 15 times altogether...","nextNodeIds":[4850615]},{"nodeId":4850615,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":195758339,"text":"But I always pass the first time. I guess my little gliding manual ain't so bad after all!","nextNodeIds":[4850616]},{"nodeId":4850616,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2544879027,"text":"#...{NICKNAME}, let's go and get a copy of the real gliding manual from Acting Grand Master Jean some time.","nextNodeIds":[4850617,4850618]},{"nodeId":4850617,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2017698195,"text":"Sounds good.","nextNodeIds":[4850619]},{"nodeId":4850619,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":213094587,"text":"I'll head off first because I need to escort Raptor back to the city.","nextNodeIds":[4850620]},{"nodeId":4850620,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":622235779,"text":"Once you're back in the city don't forget to come find me at the Cathedral. I'll issue your gliding license there.","nextNodeIds":[]},{"nodeId":4850618,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2642272939,"text":"I feel sorry for Jean...","nextNodeIds":[4850619]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48506,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2006,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["8"],"PAINLIBBLDK":"QUEST_EXEC_REMOVE_TRIAL_AVATAR"},{"LNHLPKELCAL":["3","102"],"PAINLIBBLDK":"QUEST_EXEC_LOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":1016,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":48507,"order":11,"stepDescription":"Go to the Cathedral to get your gliding license","stepDescTextMapHash":2553494855,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1008,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q48508Ambor"],"NOCCOBOFKHP":1008,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":fal