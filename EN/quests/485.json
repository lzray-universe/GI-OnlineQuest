e,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["48511","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":48511,"initDialog":4851101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/LQ/Ambor1_485/Q48511","priority":0,"questId":485,"showRandomTalkCount":0},"dialogs":[{"nodeId":4851101,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2101566827,"text":"There's only one way over there. Raptor must be up ahead.","nextNodeIds":[]},{"nodeId":4851102,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3913340843,"text":"However, it looks like the only way we can catch up is if we glide.","nextNodeIds":[]},{"nodeId":4851103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1295628923,"text":"But there's a ton of enemies below... They'll definitely attack us after we take off.","nextNodeIds":[]},{"nodeId":4851104,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3814811987,"text":"If we're gonna do this, <color=#00E1FFFF>we'll have to glide and defeat them in one fell swoop</color>...","nextNodeIds":[]},{"nodeId":4851105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":753202259,"text":"#{NICKNAME}, you still had one stage to go in your exam, right?","nextNodeIds":[]},{"nodeId":4851106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1615563907,"text":"Yeah, but what's that got to do with anything?","nextNodeIds":[]},{"nodeId":4851107,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":315829531,"text":"#How about we make this the third and final stage of your gliding exam, {NICKNAME}?","nextNodeIds":[]},{"nodeId":4851108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3023836403,"text":"Are you sure that's how the exam is supposed to go!?","nextNodeIds":[]},{"nodeId":4851109,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2421846155,"text":"#It's a custom version of the exam for {NICKNAME}, designed by yours truly!","nextNodeIds":[]},{"nodeId":4851110,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1801361987,"text":"#Besides, the normal version of the exam wouldn't be fit for the hero of Mondstadt {M#himself}{F#herself}!","nextNodeIds":[]},{"nodeId":4851112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4200891923,"text":"Watch me nail this exam.","nextNodeIds":[]},{"nodeId":4851113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2536726707,"text":"Watch me nail Raptor.","nextNodeIds":[]},{"nodeId":4851111,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1448268267,"text":"#So, what do you say, {NICKNAME}?","nextNodeIds":[]},{"nodeId":4851114,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3953949435,"text":"Woohoo! Good answer.","nextNodeIds":[]},{"nodeId":4851115,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1216460603,"text":"#{NICKNAME}, prepare for take-off! Raptor awaits you once you <color=#00E1FFFF>defeat all these enemies</color>, then that gliding license is yours!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48511,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"trig