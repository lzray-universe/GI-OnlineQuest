gs":[{"nodeId":700030601,"roleType":"TALK_ROLE_NPC","speakerId":1445,"speakerName":"Aramis","textMapHash":3567260362,"text":"I'm sorry, I don't think I've seen it. If I did, I'm sure I would have had some impression.","nextNodeIds":[700030602]},{"nodeId":700030602,"roleType":"TALK_ROLE_NPC","speakerId":1431,"speakerName":"Margaret","textMapHash":45307010,"text":"Oh, I see... That little darling really loves flowers. I thought that she might have chased them here.","nextNodeIds":[700030603]},{"nodeId":700030603,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3594677466,"text":"Someone looking for a cat?","nextNodeIds":[700030604]},{"nodeId":700030604,"roleType":"TALK_ROLE_NPC","speakerId":20219,"speakerName":"Lost Cat","textMapHash":3081324794,"text":"Meow... Meow!","nextNodeIds":[700030605]},{"nodeId":700030605,"roleType":"TALK_ROLE_NPC","speakerId":1431,"speakerName":"Margaret","textMapHash":1486173546,"text":"Is that... Butterfly? Oh, it really is you! Where have you been?","nextNodeIds":[700030606]},{"nodeId":700030606,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1164094906,"text":"On the city walls.","nextNodeIds":[700030607]},{"nodeId":700030607,"roleType":"TALK_ROLE_NPC","speakerId":1431,"speakerName":"Margaret","textMapHash":95911962,"text":"So it's just as I thought, then... Thank you so much. Butterfly here loves to chase flowers. She's been a real headache during this time, what with there being flowers all over the city and all.","nextNodeIds":[700030608]},{"nodeId":700030608,"roleType":"TALK_ROLE_NPC","speakerId":1431,"speakerName":"Margaret","textMapHash":3003074258,"text":"Thank you once again — your next drink's on me the next time you visit The Cat's Tail. Well, the non-alcoholic ones, at least.","nextNodeIds":[700030609,700030610]},{"nodeId":700030609,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1545041754,"text":"Oh, joy, this again...","nextNodeIds":[700030611]},{"nodeId":700030611,"roleType":"TALK_ROLE_NPC","speakerId":1431,"speakerName":"Margaret","textMapHash":519100418,"text":"Haha... Once again, thank you. See you around, and happy Windblume Festival.","nextNodeIds":[700030612]},{"nodeId":700030612,"roleType":"TALK_ROLE_NPC","speakerId":1445,"speakerName":"Aramis","textMapHash":3533312226,"text":"Well, I never — so cats are attracted to the flowers too. What a busy festival... Still, it's good that you found that cat.","nextNodeIds":[700030613]},{"nodeId":700030613,"roleType":"TALK_ROLE_NPC","speakerId":1445,"speakerName":"Aramis","textMapHash":3114256282,"text":"If you'd asked me to climb up there to rescue it, I'm afraid my knees would have given up the ghost...","nextNodeIds":[700030614]},{"nodeId":700030614,"roleType":"TALK_ROLE_NPC","speakerId":1445,"speakerName":"Aramis","textMapHash":3927953514,"text":"Well then, thank you for your trouble. Here's a little something for your work.","nextNodeIds":[]},{"nodeId":700030610,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3867133978,"text":"Let's save that tab for next time, I suppose.","nextNodeIds":[700030611]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7000306,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133004932"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1445","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7000301,7000302,7000305,70003