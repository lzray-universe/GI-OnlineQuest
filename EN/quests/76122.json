ialogue/WQ/NodKrai_76122/Q7612204","priority":5,"questId":76122,"showRandomTalkCount":0},"dialogs":[{"nodeId":761220401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":754580282,"text":"Wow! This must be the place you were talking about, right? Paimon wasn't there last time, so she didn't get to see it.","nextNodeIds":[761220402]},{"nodeId":761220402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3977968914,"text":"It truly is lovely.","nextNodeIds":[761220403]},{"nodeId":761220403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2771420034,"text":"Can Paimon fly around and check it out?","nextNodeIds":[761220404]},{"nodeId":761220404,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3394647210,"text":"Of course.","nextNodeIds":[761220405]},{"nodeId":761220405,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1721763842,"text":"If it pleases you, I could bring you back again someday.","nextNodeIds":[761220406]},{"nodeId":761220406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4040620370,"text":"So, this is the \"pleasant surprise,\" then?","nextNodeIds":[761220407]},{"nodeId":761220407,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":3841508738,"text":"Oh? So this is enough to pass as a \"pleasant surprise\" in your eyes? No, the real surprise is yet to come.","nextNodeIds":[761220408]},{"nodeId":761220408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2084400978,"text":"There's more?","nextNodeIds":[761220409]},{"nodeId":761220409,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":2240577018,"text":"Come. Let us paint.","nextNodeIds":[761220410]},{"nodeId":761220410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4111327274,"text":"Wait. Here? But Paimon doesn't see canvas, brushes, or paints anywhere.","nextNodeIds":[761220411]},{"nodeId":761220411,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1499415850,"text":"Oh. That's simple.","nextNodeIds":[761220412]},{"nodeId":761220412,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":212074130,"text":"The water's surface is our canvas, the moonlight our brushes, and the paths we take shall serve as the brushstrokes.","nextNodeIds":[761220413]},{"nodeId":761220413,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"The Damselette","textMapHash":1503576562,"text":"With the moon's reflection to guide us, pure thought shall flow beneath our feet.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7612204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20325,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[1298,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7612202,"order":4,"stepDescription":"Follow the moon's guide and paint the pattern","stepDescTextMapHash":2554640252,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7612202"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHED