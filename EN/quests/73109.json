{"mainQuestId":73109,"title":"For a Dream I Tarry","description":"You meet a strange person outside the forest.","titleTextMapHash":891136279,"descTextMapHash":1161650302,"mainQuestExcel":{"mainQuestId":73109,"titleTextMapHash":891136279,"title":"For a Dream I Tarry","descTextMapHash":1161650302,"description":"You meet a strange person outside the forest.","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ73109","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":1161650302,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73109,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3599262041,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73109","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173109],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":891136279,"type":"WQ","unlockDescTextMapHash":333700446}},"flow":[{"subQuestId":7310901,"order":1,"stepDescription":"","stepDescTextMapHash":2120887268,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7310901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20819"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7310901],"talks":[{"talkId":7310901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7310901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7310901,"initDialog":731090101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20819],"performCfg":"QuestDialogue/WQ/Sumeru_73109/Q7310901","priority":5,"questId":73109,"showRandomTalkCount":0},"dialogs":[{"nodeId":731090101,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1254040410,"text":"This is strange... It should be around here. Why can't I find it?","nextNodeIds":[731090102]},{"nodeId":731090102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":7011434,"text":"What are you looking for?","nextNodeIds":[731090103]},{"nodeId":731090103,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2513394306,"text":"You're... Oh, the Traveler, right? I've heard about you.","nextNodeIds":[731090104]},{"nodeId":731090104,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3710852754,"text":"I'm Javi, a... normal salesperson. I'm looking for the \"Dream Box\" I buried before.","nextNodeIds":[731090105]},{"nodeId":731090105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1717057386,"text":"That's a strange name... What is in it?","nextNodeIds":[731090106]},{"nodeId":731090106,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":467298466,"text":"Well... If I have to put it into words, it contains my childhood \"dreams to be realized.\"","nextNodeIds":[731090107]},{"nodeId":731090107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1680807250,"text":"Why did you do that?","nextNodeIds":[731090108]},{"nodeId":731090108,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2431110282,"text":"Hahaha, that was a childhood game I played with friends.","nextNodeIds":[731090109]},{"nodeId":731090109,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3445558418,"text":"We each wrote down the most precious dream we had then, and buried it here. We have agreed on a time when we are gonna gather here again and dig our \"Dream Boxes\" out.","nextNodeIds":[731090110]},{"nodeId":731090110,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":211545106,"text":"Now the time comes, but... Seems that I'm the only one remembering the promise.","nextNodeIds":[731090111]},{"nodeId":731090111,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3720354250,"text":"*sigh* That's okay, though... As long as they keep their dreams.","nextNodeIds":[731090112]},{"nodeId":731090112,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2302326306,"text":"Anyway, I'm coming to dig my box out, so that I can have some closure.","nextNodeIds":[731090113]},{"nodeId":731090113,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2872946226,"text":"But I searched around and found nothing. Could it be that someone took it?","nextNodeIds":[731090114,731090115]},{"nodeId":731090114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2465563970,"text":"Did you leave a mark?","nextNodeIds":[731090118]},{"nodeId":731090118,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3761387386,"text":"I remember burying it beside a tree...","nextNodeIds":[731090119]},{"nodeId":731090119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1871729122,"text":"A tree? B—But Paimon sees lots of trees here!","nextNodeIds":[731090120]},{"nodeId":731090120,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2747884290,"text":"I didn't expect this as a child, you know. We only set up a tiny sign as a reminder.","nextNodeIds":[731090121]},{"nodeId":731090121,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":194529914,"text":"But it's all gone after all this time, and the trees nearby have totally grown different...","nextNodeIds":[731090122]},{"nodeId":731090122,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2624586322,"text":"I just got the vague impression that the box was buried somewhere near.","nextNodeIds":[731090123]},{"nodeId":731090123,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":544895442,"text":"Traveler, could you help me find it?","nextNodeIds":[731090124,731090127]},{"nodeId":731090124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3074621994,"text":"But how?","nextNodeIds":[731090125]},{"nodeId":731090125,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1637964642,"text":"I buried the box near a tree, so... let's try digging beside the trees.","nextNodeIds":[731090126]},{"nodeId":731090126,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":359257138,"text":"Please, lend me a hand, Traveler. I'll pay you.","nextNodeIds":[731090130]},{"nodeId":731090130,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1800389770,"text":"Look at all the trees here. I will never find it without help...","nextNodeIds":[731090131]},{"nodeId":731090131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":605673130,"text":"Fine...","nextNodeIds":[731090132]},{"nodeId":731090132,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1639526802,"text":"Hehe, thank you. We'll split, then. I'm staying here, and you can search there.","nextNodeIds":[]},{"nodeId":731090127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1848698546,"text":"It has already flown away...","nextNodeIds":[731090128]},{"nodeId":731090128,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2278175474,"text":"Yes, my dream has flown away, and that's exactly why I'm digging the box out to see my dream back then.","nextNodeIds":[731090129]},{"nodeId":731090129,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":896655058,"text":"Please, Traveler, just a tiny favor here. I'll have your payment ready.","nextNodeIds":[731090130]},{"nodeId":731090115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1558887754,"text":"So your dream has flown away...","nextNodeIds":[731090116]},{"nodeId":731090116,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1957582594,"text":"Hahaha... Can't say I disagree, since I can't even remember what I wrote...","nextNodeIds":[731090117]},{"nodeId":731090117,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1472215410,"text":"But even if my dream can fly away, the box cannot.","nextNodeIds":[731090118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7310901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20819"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7310902,"order":2,"stepDescription":"Help Javi look for his \"dream\"","stepDescTextMapHash":2448852140,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7310902"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7310902_guide","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_G