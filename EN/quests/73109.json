,"","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7310903","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7310903,"initDialog":731090301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20819],"performCfg":"QuestDialogue/WQ/Sumeru_73109/Q7310903","priority":5,"questId":73109,"showRandomTalkCount":0},"dialogs":[{"nodeId":731090301,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1335749482,"text":"Oh no. This isn't my Dream Box.","nextNodeIds":[731090302,731090304]},{"nodeId":731090302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1372999370,"text":"We've got a box.","nextNodeIds":[731090303]},{"nodeId":731090303,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1422439450,"text":"Haha... I've got one, too...","nextNodeIds":[731090305]},{"nodeId":731090305,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1960404178,"text":"I even opened it, and found a piece of paper with Ami's name on it.","nextNodeIds":[731090306]},{"nodeId":731090306,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3864341258,"text":"I remember that kid, the daughter of Jahangir, who was always found near the food shop.","nextNodeIds":[731090307]},{"nodeId":731090307,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2162156626,"text":"So she dreamed of becoming a florist, who would care for a lot of flowers...","nextNodeIds":[731090308]},{"nodeId":731090308,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3732380554,"text":"That was unexpected. I always thought Jahangir was gonna pass the shop to her.","nextNodeIds":[731090309,731090310]},{"nodeId":731090309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1708760418,"text":"Let's see your dream first.","nextNodeIds":[731090311]},{"nodeId":731090311,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1028810906,"text":"Oh! I almost forgot, I must take a look at my own dream first...","nextNodeIds":[731090312]},{"nodeId":731090312,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1049418018,"text":"Lemme see...","nextNodeIds":[731090313]},{"nodeId":731090313,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":743599210,"text":"\"I hope to be a Vanara, and live in the forest forever...\"","nextNodeIds":[731090314]},{"nodeId":731090314,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2909185626,"text":"So that's my childhood dream? My goodness, I can't believe that's what I wished for...","nextNodeIds":[731090315]},{"nodeId":731090315,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1962120042,"text":"Come on... Kiddo, being a Vanara won't pay you much.","nextNodeIds":[731090316,731090317]},{"nodeId":731090316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2103650778,"text":"I don't see anything wrong with that.","nextNodeIds":[731090318]},{"nodeId":731090318,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3063879178,"text":"That's just some childish ideas. For someone at my age, dreams...","nextNodeIds":[731090319]},{"nodeId":731090319,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":4194756226,"text":"...","nextNodeIds":[731090320]},{"nodeId":731090320,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1851650842,"text":"Better think about ways to get more Mora, and that's what gives some good sleep.","nextNodeIds":[731090321]},{"nodeId":731090321,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3107375170,"text":"Enough about my boring dream, let's talk about Ami.","nextNodeIds":[731090322]},{"nodeId":731090322,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3349149058,"text":"I should definitely do something to make amends to her since I opened her \"Dream Box\" without consent.","nextNodeIds":[731090323]},{"nodeId":731090323,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":132427162,"text":"Well... Let me think, being a florist starts with learning how to plant flowers.","nextNodeIds":[731090324]},{"nodeId":731090324,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":4156821258,"text":"I happened to have a spare flower pot that I can give her.","nextNodeIds":[731090325]},{"nodeId":731090325,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2622477298,"text":"Traveler, do you happen to know somewhere to get some flower seeds?","nextNodeIds":[731090326,731090327]},{"nodeId":731090326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3578327362,"text":"Leave it to me.","nextNodeIds":[731090332]},{"nodeId":731090332,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":378551570,"text":"I'm counting on you for the seeds, Traveler. See you beside Jahangir's shop.","nextNodeIds":[]},{"nodeId":731090327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3498494938,"text":"Why are you doing this?","nextNodeIds":[731090328]},{"nodeId":731090328,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":194040706,"text":"Hahaha... Let's just say I'm being spontaneous.","nextNodeIds":[731090329]},{"nodeId":731090329,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2916904922,"text":"I will never realize my dream, because of all the years behind me, and... the fact that I don't actually care about the dream anymore.","nextNodeIds":[731090330]},{"nodeId":731090330,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1276147306,"text":"But Ami is still young. She can still try to realize her dream.","nextNodeIds":[731090331]},{"nodeId":731090331,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3968098858,"text":"As a boring adult, gifting her a flower pot is the least I can do. Hope that would show my support and encourage her.","nextNodeIds":[731090332]},{"nodeId":731090317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3839569266,"text":"Dreams are never good or bad.","nextNodeIds":[731090318]},{"nodeId":731090310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2065343738,"text":"Here, your \"Dream Box.\"","nextNodeIds":[731090311]},{"nodeId":731090304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":109671970,"text":"You got one, too?","nextNodeIds":[731090305]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7310903,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["120016","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20819"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7310904,"order":4,"stepDescription":"Collect Sumeru Rose Seeds","stepDescTextMapHash":3600303340,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[130027,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7310904,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[130027,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7310904,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7310905,"order":5,"stepDescription":"Talk to Ami","stepDescTextMapHash":1882102716,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7310905,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7310905],"talks":[{"talkId":7310905,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7310905","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7310905,"initDialog":731090501,"nextRandomTalks":[],"nextTalks":[],"npcId":[4160,20819],"performCfg":"QuestDialogue/WQ/Sumeru_73109/Q7310905","priority":5,"questId":73109,"showRandomTalkCount":0},"dialogs":[{"nodeId":731090501,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":2249384690,"text":"Is this... for me?","nextNodeIds":[731090502]},{"nodeId":731090502,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":808184026,"text":"I wasn't serious about the box or the paper! So it's alright, you don't need to apologize!","nextNodeIds":[731090503]},{"nodeId":731090503,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1751379866,"text":"Don't worry, this flower pot has no use for me anyway. Please take it.","nextNodeIds":[731090504]},{"nodeId":731090504,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3552197890,"text":"I've asked someone to find some seeds. They should arrive at any minute...","nextNodeIds":[731090505,731090506]},{"nodeId":731090505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2946755018,"text":"Seeds are coming!","nextNodeIds":[731090507]},{"nodeId":731090507,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1267398514,"text":"Huh? When did you arrive? I didn't even notice...","nextNodeIds":[731090508]},{"nodeId":731090508,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2148883074,"text":"Ahem... Ami, you wanted to be a florist, right? You can start with planting these.","nextNodeIds":[731090509]},{"nodeId":731090509,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":436630322,"text":"Thanks... But if I do that beside my dad's shop, bugs might get into the pot...","nextNodeIds":[731090510]},{"nodeId":731090510,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":1757252050,"text":"That would be a pity, for the bugs in the pot, and the grown-ups having bugs in their food.","nextNodeIds":[731090511]},{"nodeId":731090511,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":2563608946,"text":"But if I move the flowers further, I might forget about them. That's also a pity, for the dying flowers...","nextNodeIds":[731090512]},{"nodeId":731090512,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":3296880938,"text":"Besides, dad is always busy, and he never lets me go far...","nextNodeIds":[731090513]},{"nodeId":731090513,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2960893322,"text":"Um... We can take care of it together, if you want. How about that?","nextNodeIds":[731090514]},{"nodeId":731090514,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1128455498,"text":"Although I could only visit after work, I do have some free time.","nextNodeIds":[731090515]},{"nodeId":731090515,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":159190682,"text":"Great! But dad might say no...","nextNodeIds":[731090516]},{"nodeId":731090516,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":4248767842,"text":"Mr. Jahangir and I are basically friends. He should agree if we talk to him together.","nextNodeIds":[731090517]},{"nodeId":731090517,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":2360328378,"text":"Okay! I... I want more flowers, then! Sumeru Rose is my favorite! Someday... I'll surround my dad's shop with Sumeru Roses!","nextNodeIds":[731090518]},{"nodeId":731090518,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":4185785074,"text":"Good, that's a beautiful dream, little girl. Let's do our best for that!","nextNodeIds":[731090519,731090520]},{"nodeId":731090519,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1365430034,"text":"Please save one for me.","nextNodeIds":[731090521]},{"nodeId":731090521,"roleType":"TALK_ROLE_NPC","speakerId":4160,"speakerName":"Ami","textMapHash":1459017018,"text":"Thank you! Lemme think... I want a Sweet Flower, too, and what else...","nextNodeIds":[731090522]},{"nodeId":731090522,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":3913650658,"text":"So the kid is really into flowers. Hope she could stick to that dream...","nextNodeIds":[731090523]},{"nodeId":731090523,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":350677434,"text":"Hehe... Hope she won't grow up like me, a common and boring guy.","nextNodeIds":[731090524]},{"nodeId":731090524,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":666922690,"text":"Ahem! Thanks for your help, Traveler. Please take this as compensation for your trouble.","nextNodeIds":[731090525,731090526]},{"nodeId":731090525,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2373003962,"text":"Living with all your heart is more than common.","nextNodeIds":[731090527]},{"nodeId":731090527,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2003055818,"text":"Thanks. I'm not complaining, though.","nextNodeIds":[731090528]},{"nodeId":731090528,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2763918538,"text":"I was just... having some thoughts after seeing the \"dream\" I've buried.","nextNodeIds":[731090529]},{"nodeId":731090529,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":1555857506,"text":"Alright, I should leave now. Thanks for your help today, Traveler.","nextNodeIds":[731090530]},{"nodeId":731090530,"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","textMapHash":2455193282,"text":"Maybe I should... write down another \"dream\" and bury it back there...","nextNodeIds":[]},{"nodeId":731090526,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":422435762,"text":"Living with all your heart is never boring.","nextNodeIds":[731090527]},{"nodeId":731090520,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3456845626,"text":"You can do it!","nextNodeIds":[731090521]},{"nodeId":731090506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1745527210,"text":"Here, the flower seeds.","nextNodeIds":[731090507]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7310905,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["130027","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4160"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7310901,7310903,7310905,7310930],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20819,"speakerName":"Javi","count":64},{"roleType":"TALK_ROLE_PLAYER","speakerId