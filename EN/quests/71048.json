:0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2061"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7104802],"talks":[{"talkId":7104802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7104802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7104802,"initDialog":710480201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2016],"performCfg":"","priority":5,"questId":71048,"showRandomTalkCount":0},"dialogs":[{"nodeId":710480201,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":906038906,"text":"You're back. The Adventurers' Guild welcomes you.","nextNodeIds":[710480202,710480206,710480208,710480211]},{"nodeId":710480202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":678606746,"text":"Tell me about The Chasm...","nextNodeIds":[710480203]},{"nodeId":710480203,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3936560002,"text":"What, you want me to tell you what's in there? Who knows, seriously?","nextNodeIds":[710480204]},{"nodeId":710480204,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":3248300162,"text":"Some say that the some miners dug up what they call \"Wish Granter,\" but that they got the opposite of what they wished for when they wished upon it. Others say that they dug up some old dragon-king's tail down there. All tales as tall as mountains, of course.","nextNodeIds":[710480205]},{"nodeId":710480205,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2211106922,"text":"Really, there's no point asking me about The Chasm. I'm not actually sure what happened there either. Just go ask Muning — this was also one of the Ministry's requirements, by the way.","nextNodeIds":[]},{"nodeId":710480206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":558159634,"text":"Tell me more about the commission...","nextNodeIds":[710480207]},{"nodeId":710480207,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":4117515106,"text":"*cough* Well, you can see the people who depend on The Chasm for their livelihood everywhere you go out there. I'm sure you don't mind spending time interviewing them, but I've got Guild business to attend to.","nextNodeIds":[]},{"nodeId":710480208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1664917762,"text":"Tell me about Muning.","nextNodeIds":[710480209]},{"nodeId":710480209,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":4209033970,"text":"Oh, him? Heh. I suspect that the Ministry sent him out to The Chasm to get him to shape up a bit.","nextNodeIds":[710480210]},{"nodeId":710480210,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":4121641250,"text":"He's pretty good at what he does, alright, but he's one cocky kid as well. You can't have that kind of flighty character in the Ministry, you know? So yeah. The Chasm might help him grow up a bit.","nextNodeIds":[]},{"nodeId":710480211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2738048674,"text":"See you.","nextNodeIds":[710480212]},{"nodeId":710480212,"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","textMapHash":2400443770,"text":"Yeah, sure. Oh, right... Ad astra abyssosque!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104405,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7104405,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[800402,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2061"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7104802],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2016,"speakerName":"Lan","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerN