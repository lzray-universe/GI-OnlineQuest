pe":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1102108,"initDialog":110210801,"nextRandomTalks":[],"nextTalks":[],"npcId":[10303,10302],"performCfg":"QuestDialogue/LQ/Zhongli1_11021/Q1102108","priority":0,"questId":11022,"showRandomTalkCount":0},"dialogs":[{"nodeId":110210801,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2331820370,"text":"Argh! You're simply a money-grubber!","nextNodeIds":[110210802]},{"nodeId":110210802,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":1967528506,"text":"And what are you then? All you think about is digging up valuable relics every day!","nextNodeIds":[110210803]},{"nodeId":110210803,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1232041962,"text":"They're still arguing? Ugh... let's not bother them...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102201,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q11022Gad1"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1102202,"order":2,"stepDescription":"Talk to the people","stepDescTextMapHash":3731769036,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1102202],"talks":[{"talkId":1102202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1102202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1102202,"initDialog":110220201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/LQ/Zhongli1_11022/Q1102202","priority":0,"questId":11022,"showRandomTalkCount":0},"dialogs":[{"nodeId":110220201,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":165362770,"text":"I heard that Sal Terrae was once the home of the God of Salt's people. Therefore... hehehe. There are sure to be loads of valuable relics nearby.","nextNodeIds":[110220202]},{"nodeId":110220202,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":344299626,"text":"According to legend, the people of the God of Salt, Havria, enjoyed prosperous lives under her protection.","nextNodeIds":[110220203]},{"nodeId":110220203,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1685405138,"text":"But this legend has been around for ages. With the countless scrap collectors and Treasure Hoarders in the area, there probably aren't many valuable things left here.","nextNodeIds":[110220204]},{"nodeId":110220204,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":844219298,"text":"Gah, that's just great... If I knew it was picked this clean before, I wouldn't have come.","nextNodeIds":[110220205]},{"nodeId":110220205,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":1047539570,"text":"About that, I know there's a ruin deep in this cave here. It's related to the God of Salt, which is actually how the area originally got its name of Sal Terrae.","nextNodeIds":[110220206]},{"nodeId":110220206,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":3037788666,"text":"However, the ruin entrance has been sealed by a mysterious power. Nobody has been able to break the seal.","nextNodeIds":[110220223]},{"nodeId":110220223,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":3464788834,"text":"I found a mechanism that seemed to be related to the seal. But when I undid the mechanism, the seal wasn't affected at all.","nextNodeIds":[110220207]},{"nodeId":110220207,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":103453458,"text":"So at the moment, the seal's origin and how to break it are very important topics in my research on the God of Salt.","nextNodeIds":[110220208,110220209]},{"nodeId":110220208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2332522754,"text":"Is it related to the God of Salt's people?","nextNodeIds":[110220210]},{"nodeId":110220210,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2410674890,"text":"I don't know, there's no concrete evidence. But I'm pretty sure the seal is meant to hide some kind of long-forgotten truth.","nextNodeIds":[110220211]},{"nodeId":110220211,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":555064602,"text":"The God of Salt was a benevolent god adored by the people, not to mention powerful. She wouldn't have any kind of shameful secrets to hide.","nextNodeIds":[110220212]},{"nodeId":110220212,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":4239230866,"text":"So... the one who wants to hide some truth is very possibly her killer, Morax.","nextNodeIds":[110220213]},{"nodeId":110220213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4216978354,"text":"This doesn't sound like something the Lord of Geo would do, though...","nextNodeIds":[110220214]},{"nodeId":110220214,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":204151898,"text":"Who cares about all that? It sounds like countless treasures of the God of Salt lie within this ruin, just waiting for someone to find them, right!?","nextNodeIds":[110220215]},{"nodeId":110220215,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":3732083370,"text":"You weren't listening at all, were you? Argh... Even if there's a mountain of treasures inside, nobody can get in if the seal isn't broken.","nextNodeIds":[110220216]},{"nodeId":110220216,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":869107434,"text":"Ah, but we have the illustrious Mr. Zhongli with us! He looks like he knows just about everything — a little seal shouldn't be any trouble for him.","nextNodeIds":[110220217]},{"nodeId":110220217,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":1515399818,"text":"This seal seems to be quite ancient. Even Mr. Zhongli may not know all of its secrets...","nextNodeIds":[110220218]},{"nodeId":110220218,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2441665026,"text":"I may know something about it.","nextNodeIds":[110220219]},{"nodeId":110220219,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2794367626,"text":"Wh—What!?","nextNodeIds":[110220220]},{"nodeId":110220220,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2854736290,"text":"Over the years, I've heard various rumors with bits of knowledge about seals. Although their references seem rather disorderly, they do in fact contain the secret to breaking seals.","nextNodeIds":[110220221]},{"nodeId":110220221,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1749360194,"text":"Let's go take a look at the mechanism Miss Wanyan just mentioned.","nextNodeIds":[110220222]},{"nodeId":110220222,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":1609004274,"text":"Okay, since Mr. Zhongli says so... Follow me, then.","nextNodeIds":[]},{"nodeId":110220209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":239763114,"text":"Is it related to Rex Lapis?","nextNodeIds":[110220210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1102208,"order":3,"stepDescription":"Go to the first mechanism","stepDescTextMapHash":4209467196,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102208,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q11022Gad2","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102208,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUE