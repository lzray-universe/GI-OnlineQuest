GBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[1102206],"talks":[{"talkId":1102206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1102206","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1102206,"initDialog":110220601,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/LQ/Zhongli1_11022/Q1102206","priority":0,"questId":11022,"showRandomTalkCount":0},"dialogs":[{"nodeId":110220601,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":3028437938,"text":"Before entering the ruin, I have a proposal that will help us prevent the kind of senseless arguing between you two that we saw at Guyun Stone Forest.","nextNodeIds":[110220602]},{"nodeId":110220602,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":511260346,"text":"Okay, what is it?","nextNodeIds":[110220603]},{"nodeId":110220603,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":2297731562,"text":"I propose you two agree upon a contract, stipulating that we alternate who gets claim to each treasure we encounter, with only one object permitted per claim.","nextNodeIds":[110220604]},{"nodeId":110220604,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1628864570,"text":"To show my sincerity, I won't be taking any treasure — this will just be between you all.","nextNodeIds":[110220605]},{"nodeId":110220605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2094173018,"text":"I won't take any either.","nextNodeIds":[110220606]},{"nodeId":110220606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1217468522,"text":"Hey! Don't pass an opportunity like this up so easily!","nextNodeIds":[110220607]},{"nodeId":110220607,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":3221715866,"text":"I don't agree! I mean... You want me to split the treasure with this amateur archaeologist? No, absolutely not!","nextNodeIds":[110220608]},{"nodeId":110220608,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2039672330,"text":"I don't agree either! Hmph, he will only defile the precious relics left behind by the God of Salt! I—I can't accept this.","nextNodeIds":[110220609]},{"nodeId":110220609,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":86839346,"text":"Well then... If the contract is not agreed upon, I will no longer serve as your consultant on this expedition.","nextNodeIds":[110220610]},{"nodeId":110220610,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1323441770,"text":"You will have to rely on your own experience to find whatever treasures are hidden in this ruin, as well as traps.","nextNodeIds":[110220611]},{"nodeId":110220611,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"Kliment","textMapHash":4292048386,"text":"Y—You have the audacity to demand this... Okay then. Even half of the treasure in the long-sealed ruin of the God of Salt should be enough to make a fortune.","nextNodeIds":[110220612]},{"nodeId":110220612,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2942317458,"text":"If you want me to agree upon this contract, so be it... I just have one request, Mr. Zhongli.","nextNodeIds":[110220613]},{"nodeId":110220613,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"Wanyan","textMapHash":2735018122,"text":"If we discover the truth behind the God of Salt, you must judge it fairly, even if the truth harms Morax's image.","nextNodeIds":[110220614]},{"nodeId":110220614,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1046360498,"text":"I can accept this arrangement.","nextNodeIds":[110220615]},{"nodeId":110220615,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"Zhongli","textMapHash":1448937610,"text":"Well then, let's go.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133102795"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDL