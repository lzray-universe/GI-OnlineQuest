{"mainQuestId":11022,"title":"A Ruin Under Lock and Key","description":"The expedition to investigate Osial in the Guyun Stone Forest came away with slim pickings. Kliment and Wanyan also clashed vociferously over their differing perspectives, which has greatly displeased the former. During the argument, he heard Wanyan mention the tale of the God of Salt, and decided to take the party there to try their luck, lest he finishes this venture empty-handed.","titleTextMapHash":1065329863,"descTextMapHash":127402118,"mainQuestExcel":{"mainQuestId":11022,"titleTextMapHash":1065329863,"title":"A Ruin Under Lock and Key","descTextMapHash":127402118,"description":"The expedition to investigate Osial in the Guyun Stone Forest came away with slim pickings. Kliment and Wanyan also clashed vociferously over their differing perspectives, which has greatly displeased the former. During the argument, he heard Wanyan mention the tale of the God of Salt, and decided to take the party there to try their luck, lest he finishes this venture empty-handed.","chapterId":2014,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/LQ11022","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":2014,"descTextMapHash":127402118,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":11022,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1845806537,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/LQ11022","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":2014,"rewardIdList":[111022],"series":2014,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialS