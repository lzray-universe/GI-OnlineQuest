,"talkIds":[2050401],"talks":[{"talkId":2050401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["2050401","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2050401,"initDialog":205040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1435],"performCfg":"","priority":9,"questId":20504,"showRandomTalkCount":0},"dialogs":[{"nodeId":205040101,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":324017585,"text":"Welcome. Every treasure here is unique, guaranteed.","nextNodeIds":[205040102]},{"nodeId":205040102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1782324033,"text":"Hehe... Yep, there's nothing here that Paimon recognizes, that's for sure.","nextNodeIds":[205040103]},{"nodeId":205040103,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":1661842481,"text":"Haha, what did I tell you! These are all rare items brought back by adventurers from all corners of the world.","nextNodeIds":[205040104]},{"nodeId":205040104,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":2558514201,"text":"Is there anything that catches your eye?","nextNodeIds":[205040105,205040106]},{"nodeId":205040105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":523186081,"text":"It's all so exquisite...","nextNodeIds":[205040107]},{"nodeId":205040107,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":375898937,"text":"No need! I forgot to mention, I operate on a trading basis. Goods for goods — no Mora accepted here.","nextNodeIds":[205040108]},{"nodeId":205040108,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":3356191545,"text":"I've been trying to make something a bit special recently, and I need a lot of <color=#00E1FFFF>Anemo Sigils</color> to decorate it with.","nextNodeIds":[205040109]},{"nodeId":205040109,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":2632991881,"text":"Do you have any <color=#00E1FFFF>Anemo Sigils</color> with you?","nextNodeIds":[205040110,205040112]},{"nodeId":205040110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3035875169,"text":"I have a few.","nextNodeIds":[205040111]},{"nodeId":205040111,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":2407128833,"text":"Haha, it seems the Anemo Archon approves of your adventures then.","nextNodeIds":[205040114]},{"nodeId":205040114,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":1577743753,"text":"More to the point, any <color=#00E1FFFF>Anemo Sigils</color> you find you can trade in here for items in the shop.","nextNodeIds":[205040115]},{"nodeId":205040115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2861038705,"text":"Browse items.","nextNodeIds":[]},{"nodeId":205040112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4275077489,"text":"What are those?","nextNodeIds":[205040113]},{"nodeId":205040113,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":3104731505,"text":"It's like a seal or emblem that the Anemo Archon gives to adventurers as a form of acknowledgment.","nextNodeIds":[205040114]},{"nodeId":205040106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2520952761,"text":"I daren't ask about the price!","nextNodeIds":[205040107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2050401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1435"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2050402,"order":2,"stepDescription":"","stepDescTextMapHash":16094400,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1141,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1141,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","C