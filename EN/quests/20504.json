alk":"TALK_HERO_LOCAL","id":2050403,"initDialog":205040301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1435],"performCfg":"","priority":9,"questId":20504,"showRandomTalkCount":0},"dialogs":[{"nodeId":205040301,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":835856489,"text":"<color=#00E1FFFF>Anemo Sigils</color> appear all over Mondstadt. If you find yourself short, just keep exploring.","nextNodeIds":[205040302]},{"nodeId":205040302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2631723121,"text":"Are they really just for decoration?","nextNodeIds":[205040303]},{"nodeId":205040303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1855511921,"text":"Absolutely! What could be more beautiful than a gift from the Anemo Archon?","nextNodeIds":[205040304]},{"nodeId":205040304,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":1259763809,"text":"Haha, okay, you got me.","nextNodeIds":[205040305]},{"nodeId":205040305,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":3706455521,"text":"It's actually more complicated than that, but it's easier for people to understand if I just say it's for decoration.","nextNodeIds":[205040306]},{"nodeId":205040306,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":1002580233,"text":"Obviously the reason I need <color=#00E1FFFF>Anemo Sigils</color> is because they have properties that other materials cannot provide.","nextNodeIds":[205040307,205040309]},{"nodeId":205040307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3222988641,"text":"Let me see it when it's finished.","nextNodeIds":[205040308]},{"nodeId":205040308,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":2286376153,"text":"Haha, of course! I guarantee you will be quite surprised at the result.","nextNodeIds":[205040312]},{"nodeId":205040312,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":2416479313,"text":"Do come again soon — and bring me lots and lots of <color=#00E1FFFF>Anemo Sigils</color> next time!","nextNodeIds":[205040313]},{"nodeId":205040313,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":3472847641,"text":"Please also visit if you come across any weird and wonderful treasures on your adventures!","nextNodeIds":[]},{"nodeId":205040309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":136915313,"text":"I feel like you're making this sound more mysterious than it actually is.","nextNodeIds":[205040310]},{"nodeId":205040310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":400094873,"text":"But it's working... Paimon's curious now!","nextNodeIds":[205040311]},{"nodeId":205040311,"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","textMapHash":1809575753,"text":"Haha! Well it wouldn't be much of a surprise if I gave everything away, now would it?","nextNodeIds":[205040312]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2050403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2050401,2050403],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1435,"speakerName":"Marjorie","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","