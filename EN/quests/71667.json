AYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7166701,"order":3,"stepDescription":"Go to Nantianmen","stepDescTextMapHash":1788553356,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30547"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166701],"talks":[{"talkId":7166701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7166701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166701,"initDialog":716670101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30547],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_71667/Q7166701","priority":5,"questId":71667,"showRandomTalkCount":0},"dialogs":[{"nodeId":716670101,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":1125281546,"text":"Ah, it's you two! I've been waiting for ages!","nextNodeIds":[716670102]},{"nodeId":716670102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2301761818,"text":"Befriended the Pyro Regisvine yet?","nextNodeIds":[716670103]},{"nodeId":716670103,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":4014011018,"text":"Agh, don't even talk about it. You \"negotiated\" a period of calm... a very, very brief one.","nextNodeIds":[716670104]},{"nodeId":716670104,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":3397573474,"text":"The moment it recovered, it started trying to bump me off again! ... You know what? You were right. It's not possible to make friends with this creature.","nextNodeIds":[716670105]},{"nodeId":716670105,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":2972809370,"text":"Still, its fruit does taste pretty good — like Pyro, in fact. Reckon my Natlan friends will like it!","nextNodeIds":[716670106]},{"nodeId":716670106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2975621418,"text":"What does that even taste like...?","nextNodeIds":[716670107]},{"nodeId":716670107,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":2453871874,"text":"Wanna give it a try? If you want, I could...","nextNodeIds":[716670108]},{"nodeId":716670108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3487021770,"text":"E—Err, yeah, no, it's fine! Anyway, are you gonna move on to a Primo Geovishap next?","nextNodeIds":[716670109]},{"nodeId":716670109,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":3784472266,"text":"That's right. I think this one's a winner, to be honest. Primo Geovishaps are quite like the Tepetlisauri, after all.","nextNodeIds":[716670110]},{"nodeId":716670110,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":3696187026,"text":"If you travel to Natlan from Sumeru like I did, I reckon they'll be one of the first things you'll meet.","nextNodeIds":[716670111]},{"nodeId":716670111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3776569906,"text":"Sure, whatever you say. Paimon doesn't have high hopes for this one either, though... Why couldn't you have gone with the Hatchlings?","nextNodeIds":[716670112]},{"nodeId":716670112,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":4012988426,"text":"...They don't have round tummies.","nextNodeIds":[716670113]},{"nodeId":716670113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2393933122,"text":"What?","nextNodeIds":[716670114]},{"nodeId":716670114,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":2614432594,"text":"Geovishap Hatchlings don't have round tummies. I imagine it's all that incredibly quick rolling they do. That can't leave you much of a chance to store up fat...","nextNodeIds":[716670115]},{"nodeId":716670115,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":518217474,"text":"*sigh* But the main reason's still the lack of... impact. What's a Hatchling to those friends of mine who live alongside Saurians?","nextNodeIds":[716670116]},{"nodeId":716670116,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":945475354,"text":"But a Primo Geovishap, now that's a different story. Even as a tale, it'll be worth the time of day. And anyway, a strong protagonist's gotta have strong opponents, you dig?","nextNodeIds":[716670117]},{"nodeId":716670117,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":2013047178,"text":"Alright. Let's not tarry, shall we? The Primo Geovishap awaits!","nextNodeIds":[716670118,716670119]},{"nodeId":716670118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2612758082,"text":"Let's away, good sir.","nextNodeIds":[]},{"nodeId":716670119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2071399402,"text":"I've got other things to handle. See you in a bit.","nextNodeIds":[716670120]},{"nodeId":716670120,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"Ranjit","textMapHash":2171610746,"text":"No worries. I'll wait for you here.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30547"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIB