ST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["4024"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2300201,2300205],"talks":[{"talkId":2300201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["23002","1","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2300201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["23002","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2300201,"initDialog":230020101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4024],"performCfg":"QuestDialogue/IQ/Xumi_23002/Q2300201","priority":5,"questId":23002,"showRandomTalkCount":0},"dialogs":[{"nodeId":230020101,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":2671561658,"text":"The mushrooms here don't look too bad. I'll put them on my shopping list...","nextNodeIds":[230020102]},{"nodeId":230020102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1631378306,"text":"Hanbei? Now that's a familiar name. Paimon's sure we've heard that one somewhere...","nextNodeIds":[230020103,230020104]},{"nodeId":230020103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1366344714,"text":"...Was it the guy at Tatarasuna?","nextNodeIds":[230020105]},{"nodeId":230020105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":293459058,"text":"Yikes! He's the guy who made a complete mess of the Mikage Furnace!","nextNodeIds":[230020106,230020107]},{"nodeId":230020106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3818707682,"text":"I think he's here as a foreign attaché...","nextNodeIds":[230020108]},{"nodeId":230020108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2289118986,"text":"So he really is here in Sumeru. Paimon thought that whole foreign attaché thing was just a joke...","nextNodeIds":[230020109]},{"nodeId":230020109,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":1172788146,"text":"#Eh? {M#Blond}{F#Blonde} hair... and a small flying thing...","nextNodeIds":[230020110]},{"nodeId":230020110,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":2468021754,"text":"Are you the Traveler?","nextNodeIds":[230020111,230020112]},{"nodeId":230020111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4205167658,"text":"That's right.","nextNodeIds":[230020114]},{"nodeId":230020114,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":2305334810,"text":"Haha, so it really is you. Yousuke's letter mentioned how you helped Mr. Xavier deal with the Mikage Furnace.","nextNodeIds":[230020115]},{"nodeId":230020115,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":189966170,"text":"*sigh* I feel so ashamed. I was tied up with administrative work when the two of you were fixing the Mikage Furnace.","nextNodeIds":[230020116]},{"nodeId":230020116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1078024682,"text":"Is administrative work really more important than the Mikage Furnace...","nextNodeIds":[230020117]},{"nodeId":230020117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":464869610,"text":"You've got your priorities all wrong!","nextNodeIds":[230020118]},{"nodeId":230020118,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":3821179618,"text":"The Mikage Furnace's maintenance wouldn't have progressed so smoothly without administrative work, you know.","nextNodeIds":[230020119]},{"nodeId":230020119,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":1552026994,"text":"I was evacuating the people nearby, prepping the materials for repairs, redirecting the appropriate manpower, and even coordinating production...","nextNodeIds":[230020120]},{"nodeId":230020120,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":2595396754,"text":"All these things would have been a complete mess without administrative support.","nextNodeIds":[230020121]},{"nodeId":230020121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2305271818,"text":"It's just like Toranosuke said...","nextNodeIds":[230020122]},{"nodeId":230020122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2479280826,"text":"You live up to your reputation...","nextNodeIds":[230020123]},{"nodeId":230020123,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":621293306,"text":"Toranosuke... That man has such blatant disregard for administrative work. I always end up with extra work when working with him.","nextNodeIds":[230020124]},{"nodeId":230020124,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":3131202954,"text":"But I'm not in charge of the Mikage Furnace anymore. I'm serving as foreign attaché in Sumeru now, and I manage the mushroom trade.","nextNodeIds":[230020125]},{"nodeId":230020125,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":1408125602,"text":"Ah, Traveler, I've heard about your deeds from Yousuke, and I do believe that you are a truly reliable person.","nextNodeIds":[230020126]},{"nodeId":230020126,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":998941818,"text":"If you don't mind, could you help me with something?","nextNodeIds":[230020127]},{"nodeId":230020127,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":1051265490,"text":"I've been searching for a reliable mushroom supplier, and I've met with many merchants here.","nextNodeIds":[230020128]},{"nodeId":230020128,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":3885915258,"text":"But they always select only their best to put on display...","nextNodeIds":[230020129]},{"nodeId":230020129,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":3853508738,"text":"I think a visit to their farms is necessary to assess the quality of their supply.","nextNodeIds":[230020130]},{"nodeId":230020130,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":424402306,"text":"But as you can see, I have no experience in conducting surveys in the wild. And I don't think I'll make it out of the forest alive if I go alone.","nextNodeIds":[230020131]},{"nodeId":230020131,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":3299388186,"text":"So, I would like you to help me go there and gather some mushrooms...","nextNodeIds":[230020132,230020133]},{"nodeId":230020132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":364093634,"text":"Well, I can do that...","nextNodeIds":[230020134]},{"nodeId":230020134,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":1987031730,"text":"You'll do it? Wonderful! Don't worry about your payment, I've even prepared the contract documentation.","nextNodeIds":[230020135]},{"nodeId":230020135,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":2445600314,"text":"Take a look at this. Yes, this document. This is your hiring contract, compensation breakdown, and a disclosure and confidentiality agreement. Oh, I almost forgot, here's a map of the mushroom farm...","nextNodeIds":[230020136]},{"nodeId":230020136,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":225281018,"text":"You are exhausted after carefully looking through all the documents with Hanbei...","nextNodeIds":[230020137]},{"nodeId":230020137,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":102565562,"text":"Good, now you're fully informed. I'll be sending a report to the Shogunate, and we can finalize everything once I have the Shogunate's approval.","nextNodeIds":[230020138]},{"nodeId":230020138,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":931236642,"text":"But I'll pay you out of my own pocket until then. After all, I can't delay this any longer.","nextNodeIds":[230020139]},{"nodeId":230020139,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":1677024178,"text":"Of course, I'll be filing the necessary documents for this as well. Your compensation does come with tax implications.","nextNodeIds":[230020140]},{"nodeId":230020140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2552147546,"text":"I... I'm going to gather mushrooms now!","nextNodeIds":[230020141]},{"nodeId":230020141,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":2021993906,"text":"Eh? Oh... I'll leave it to you then.","nextNodeIds":[230020142]},{"nodeId":230020142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1809620042,"text":"We won't get caught up in some trouble again, right?","nextNodeIds":[230020143,230020145]},{"nodeId":230020143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3270065290,"text":"We won't if I keep an eye on him.","nextNodeIds":[230020144]},{"nodeId":230020144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2947138818,"text":"Really? Okay, you do have a point...","nextNodeIds":[230020147]},{"nodeId":230020147,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":112535306,"text":"Eh? Why do you look so doubtful... Don't you worry, I've made very thorough preparations, so there won't be any issues during this process.","nextNodeIds":[230020148]},{"nodeId":230020148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":478821386,"text":"We're not talking about that kind of trouble... *sigh* Let's just get his mushrooms for him, shall we?","nextNodeIds":[]},{"nodeId":230020145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":748790786,"text":"I wonder what kind of trouble he'll cause this time.","nextNodeIds":[230020146]},{"nodeId":230020146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1229408410,"text":"Hey! If that really happens, we won't have anyone to help us out here!","nextNodeIds":[230020147]},{"nodeId":230020133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1298953834,"text":"Let's talk about payment first...","nextNodeIds":[230020134]},{"nodeId":230020112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3210653226,"text":"This is Paimon...","nextNodeIds":[230020113]},{"nodeId":230020113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":195316530,"text":"Paimon's Paimon! Not some \"small flying thing\"!","nextNodeIds":[230020114]},{"nodeId":230020107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3906507674,"text":"I think he's here for the mushrooms...","nextNodeIds":[230020108]},{"nodeId":230020104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":993627554,"text":"Toranosuke and Yousuke both mentioned him...","nextNodeIds":[230020105]}]},{"talkId":2300205,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2300201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["23002","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2300205,"initDialog":230020501,"nextRandomTalks":[],"nextTalks":[],"npcId":[4024],"performCfg":"QuestDialogue/IQ/Xumi_23002/Q2300205","priority":5,"questId":23002,"showRandomTalkCount":0},"dialogs":[{"nodeId":230020501,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":4175601898,"text":"This merchant's mushroom supply doesn't look very reliable either...","nextNodeIds":[230020502]},{"nodeId":230020502,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":879689322,"text":"Why does he look so troubled? Has he gotten himself into some kind of trouble again?","nextNodeIds":[230020503]},{"nodeId":230020503,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":1613125650,"text":"Traveler, you're here. The quality of the mushrooms you gathered was really good.","nextNodeIds":[230020504]},{"nodeId":230020504,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"Hanbei","textMapHash":364470698,"text":"Can I ask you to gather more for me? I plan to compare them with the mushrooms from other suppliers.","nextNodeIds":[230020505,230020507]},{"nodeId":230020505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":208183970,"text":"Leave it to me.","nextNodeIds":[230020506]},{"nodeId":230020506,"roleType":"TALK_ROLE_NPC",