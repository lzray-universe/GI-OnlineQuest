ority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7109702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7109702,"initDialog":710970201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2061,1005],"performCfg":"QuestDialogue/WQ/Liyue_71097/Q7109702","priority":6,"questId":71097,"showRandomTalkCount":0},"dialogs":[{"nodeId":710970201,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2117816490,"text":"With these three included, it's nine in total. They should be enough.","nextNodeIds":[710970202]},{"nodeId":710970202,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":227603802,"text":"You managed to gather what Huishan Hall needs so quickly. No wonder they speak so highly of you!","nextNodeIds":[710970203]},{"nodeId":710970203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1592285970,"text":"Eh, it was easy! Easy-peasy, lemon-breezy!","nextNodeIds":[710970204]},{"nodeId":710970204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":125531610,"text":"I'm sure it's \"lemon-squeezy,\" Paimon...","nextNodeIds":[710970205]},{"nodeId":710970205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2403358586,"text":"Eh? Uh, well, lemons can be breezy too!","nextNodeIds":[710970206]},{"nodeId":710970206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":840809138,"text":"Oh, look at you, forcing your logic through. Most impressive.","nextNodeIds":[710970207]},{"nodeId":710970207,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":272015818,"text":"Haha... We've all witnessed your heroic deeds of fighting the sea monster. I believe it was no challenge for you to accomplish such a feat.","nextNodeIds":[710970208,710970209]},{"nodeId":710970208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2500331402,"text":"No challenge at all indeed.","nextNodeIds":[710970210]},{"nodeId":710970210,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1051501106,"text":"Well, so much for working at the Ministry of Civil Affairs. They still ask you to do stuff like \"look for Archaic Stone in The Chasm\"...","nextNodeIds":[710970211]},{"nodeId":710970211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":998074594,"text":"Speaking of which, you said you often argued with your father back then and didn't have a job.","nextNodeIds":[710970212]},{"nodeId":710970212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2364335418,"text":"Then how did you make it into the Ministry later?","nextNodeIds":[710970213]},{"nodeId":710970213,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":98439138,"text":"You know how I owed a big sum at the time? I could turn to no one, nor was I willing to go home.","nextNodeIds":[710970214]},{"nodeId":710970214,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1491797226,"text":"In the end, the debt collectors came looking for my old man at the Shenglu Hall... I thought he'd come find me to break my legs upon hearing the news.","nextNodeIds":[710970215]},{"nodeId":710970215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1764614466,"text":"But your legs look fine.","nextNodeIds":[710970216]},{"nodeId":710970216,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2508107778,"text":"Yes... It's embarrassing to say, but he cleared my debt and came looking for me. By the time he found me, I was almost like a beaten-up dog on the street. He said, \"I have all your IOUs, so now you're indebted to me.\"","nextNodeIds":[710970217]},{"nodeId":710970217,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":1492024322,"text":"With that, he forced me to work — to pay my debt.","nextNodeIds":[710970218]},{"nodeId":710970218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1984903506,"text":"So your father is your creditor now.","nextNodeIds":[710970219]},{"nodeId":710970219,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3906170498,"text":"You can say that...","nextNodeIds":[710970220]},{"nodeId":710970220,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3436707258,"text":"Back then, with the debt collectors after me, I couldn't even fall asleep at night. So, I swore that I'd mend my ways if I was given a second chance.","nextNodeIds":[710970221]},{"nodeId":710970221,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3448150882,"text":"But I didn't expect the chance to come from my father, who always disapproved of my behaviors...","nextNodeIds":[710970222]},{"nodeId":710970222,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3108467098,"text":"He didn't lash out at me as usual. Instead, we had a talk — an honest and sincere one. How I wish we could've talked this way earlier.","nextNodeIds":[710970223]},{"nodeId":710970223,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":4294146778,"text":"But even if he'd been open for a talk, I wouldn't have been willing to listen.","nextNodeIds":[710970224]},{"nodeId":710970224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1540638186,"text":"Looks like your father treats you well.","nextNodeIds":[710970225]},{"nodeId":710970225,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":635560994,"text":"Yeah.","nextNodeIds":[710970226]},{"nodeId":710970226,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3169918306,"text":"So I have to get my job done well under whatever circumstances.","nextNodeIds":[710970227]},{"nodeId":710970227,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3062095434,"text":"Whether it's the incident in The Chasm or the search for Archaic Stone requested by Huishan Hall.","nextNodeIds":[710970228]},{"nodeId":710970228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":677138730,"text":"I believe I'm the one who did the job for you this time...","nextNodeIds":[710970229]},{"nodeId":710970229,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":2442854186,"text":"Having people get the job done also counts.","nextNodeIds":[710970230]},{"nodeId":710970230,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"Muning","textMapHash":3858398010,"text":"But still, it's all thanks to you that we moved swimmingly — I'd say it was way more quickly than I expected.","nextNodeIds":[710970231]},{"nodeId":710970231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1032868074,"text":"Huh, Paimon finally senses a touch of gratitude there.","nextNodeIds":[]},{"nodeId":710970209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2042734842,"text":"It's actually a bit of a challenge...","nextNodeIds":[710970210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7109702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[{"talkId":7109701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7107403","","","",""],"type":"QUEST_COND_ITEM_GIVING_ACTIVED"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QU