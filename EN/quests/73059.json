"",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7305902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7305901,"initDialog":730590101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20744,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73059/Q7305901","priority":5,"questId":73059,"showRandomTalkCount":0},"dialogs":[{"nodeId":730590101,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":3603735842,"text":"\"The pomegranate sings, the apples clap...\"","nextNodeIds":[730590102]},{"nodeId":730590102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3739918594,"text":"Hello, Mr. Khayyam! What are you doing here?","nextNodeIds":[730590103]},{"nodeId":730590103,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":485070410,"text":"Oh, hello, hello. Child in white, and... *sigh* Apologies, my children. My memories are getting blurry, and names just fade after a while...","nextNodeIds":[730590104]},{"nodeId":730590104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":652438786,"text":"#Just call me {NICKNAME}.","nextNodeIds":[730590105]},{"nodeId":730590105,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":290599330,"text":"Haha... Okay, so you were the...","nextNodeIds":[730590106]},{"nodeId":730590106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":508837138,"text":"Yes! We were the Javans - the brave young ones!","nextNodeIds":[730590107]},{"nodeId":730590107,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":4092428434,"text":"Hmm... So, please tell me, do the Aranara still remember me? Do they remember us all?","nextNodeIds":[730590108]},{"nodeId":730590108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2194735938,"text":"Oh, uh...","nextNodeIds":[730590109,730590112]},{"nodeId":730590109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3096829042,"text":"They remember.","nextNodeIds":[730590110]},{"nodeId":730590110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2592501370,"text":"...","nextNodeIds":[730590111]},{"nodeId":730590111,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":3187401922,"text":"I see... But I can't see them anymore, nor can I know how much they miss me... What a pity.","nextNodeIds":[730590114]},{"nodeId":730590114,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":2894877114,"text":"Hehe... I can't see them anymore. I am too old to see their faces or hear their voices... Gone, it's all gone.","nextNodeIds":[730590115]},{"nodeId":730590115,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":1035055522,"text":"*cough*... Apologies, I have to take my leave now. Perhaps a miracle is my only hope...","nextNodeIds":[730590116]},{"nodeId":730590116,"roleType":"TALK_ROLE_NPC","speakerId":20744,"speakerName":"Khayyam","textMapHash":2299435666,"text":"One cannot understand or chase after a miracle. The only thing one can do is wait.","nextNodeIds":[730590117]},{"nodeId":730590117,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":2301057474,"text":"Khayyam unsteadily walks away...","nextNodeIds":[]},{"nodeId":730590112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1622758706,"text":"They forgot.","nextNodeIds":[730590113]},{"nodeId":730590113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":443385482,"text":"But... We can befriend them all over again!","nextNodeIds":[730590114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7305901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133315010,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20744"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7305904,"order":4,"stepDescription":"","stepDescTextMapHash":4223243140,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7305904,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP"