":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1903201,"initDialog":1903203101,"nextRandomTalks":[],"nextTalks":[],"npcId":[10907],"performCfg":"QuestDialogue/COOP/CoopChongyun/coop_1903201","priority":5,"questId":19032,"showRandomTalkCount":0},"dialogs":[{"nodeId":1903203101,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":1281993485,"text":"*sobbing* Huh...? Um...","nextNodeIds":[1903203102]},{"nodeId":1903203102,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":1749556021,"text":"Um... Can... C—Can you help me...?","nextNodeIds":[1903203103,1903203104]},{"nodeId":1903203103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3332828925,"text":"Help you?","nextNodeIds":[1903203105]},{"nodeId":1903203105,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":1938802389,"text":"Um, that exorcist... with that blue hair... is so scary!","nextNodeIds":[1903203106]},{"nodeId":1903203106,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":167088053,"text":"C—Can you lead him away from here? He makes me feel so frightened...","nextNodeIds":[1903203107,1903203108]},{"nodeId":1903203107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":172863485,"text":"Are you being affected by his yang energy?","nextNodeIds":[1903203109]},{"nodeId":1903203109,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":3298385877,"text":"I wouldn't dare get anywhere near him... His energy... It's so horrible! It'll make me disappear!","nextNodeIds":[1903203110]},{"nodeId":1903203110,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":3169150925,"text":"...I don't want to disappear! Please, help me...","nextNodeIds":[1903203111,1903203112]},{"nodeId":1903203111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1588848733,"text":"I wonder if he'd consider you an evil spirit...","nextNodeIds":[1903203113]},{"nodeId":1903203113,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":272398621,"text":"...Well... I—I have an idea.","nextNodeIds":[1903203114]},{"nodeId":1903203114,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":976370413,"text":"Um... I—I saw the exorcist with blue hair a—arguing with someone over there a few minutes ago.","nextNodeIds":[1903203115]},{"nodeId":1903203115,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":3237062445,"text":"I'll scare those troublemakers away, but y—you have to ask the exorcist to let me go, okay?","nextNodeIds":[1903203116,1903203118]},{"nodeId":1903203116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2255091733,"text":"Are you telling the truth?","nextNodeIds":[1903203117]},{"nodeId":1903203117,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":3434739253,"text":"O—Of course... Qianqian never lies.","nextNodeIds":[1903203120]},{"nodeId":1903203120,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":3054362501,"text":"So, um... What do you say?","nextNodeIds":[1903203121]},{"nodeId":1903203121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1172834429,"text":"He'll be the one that decides, but I'll try to explain the situation as best I can.","nextNodeIds":[1903203122]},{"nodeId":1903203122,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":1457972709,"text":"Um... Uh, okay... So, I'll take that as a \"yes\"?","nextNodeIds":[1903203123]},{"nodeId":1903203123,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":2957958381,"text":"I hope the exorcist with blue hair is a good person.","nextNodeIds":[1903203124]},{"nodeId":1903203124,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":1277091125,"text":"Um... So, I'll help him, and you'll go talk to him. Hopefully, then he'll leave me alone... Sound good?","nextNodeIds":[]},{"nodeId":1903203118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4038776325,"text":"I can get him out of trouble myself.","nextNodeIds":[1903203119]},{"nodeId":1903203119,"roleType":"TALK_ROLE_NPC","speakerId":10907,"speakerName":"Qianqian","textMapHash":1422837189,"text":"...Yeah but... it'll be complicated. I've already got a plan, you must believe me!","nextNodeIds":[1903203120]},{"nodeId":1903203112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":356524197,"text":"He'll have to be the one that decides what to do.","nextNodeIds":[1903203113]},{"nodeId":1903203108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":876312197,"text":"No wonder we haven't seen you all day.","nextNodeIds":[1903203109]},{"nodeId":1903203104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2805283509,"text":"Why me?","nextNodeIds":[1903203105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1903201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER