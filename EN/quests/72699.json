1,"initDialog":726990101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30167],"performCfg":"QuestDialogue/WQ/Inazuma_72699/Q7269901","priority":5,"questId":72699,"showRandomTalkCount":0},"dialogs":[{"nodeId":726990101,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3265774658,"text":"I greatly look forward to this duel. I wonder what the extent of your skills is.","nextNodeIds":[726990102]},{"nodeId":726990102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1112207442,"text":"Uh, what are you doing here...","nextNodeIds":[726990103]},{"nodeId":726990103,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":4235086426,"text":"Actually, when I said previously that 4 warriors had joined, I was including myself in that list.","nextNodeIds":[726990104]},{"nodeId":726990104,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3594455842,"text":"I'm the organizer, yes, but there were just too few participants...","nextNodeIds":[726990105]},{"nodeId":726990105,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":2842685162,"text":"And anyway, I was born for combat! Since there is a mighty foe before me, I must have my duel!","nextNodeIds":[726990106]},{"nodeId":726990106,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3380588194,"text":"...Hehe, I've been waiting to say that for a long time now!","nextNodeIds":[726990107]},{"nodeId":726990107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2601856138,"text":"Uh, Paimon's not sure this person is right in the head.","nextNodeIds":[726990108]},{"nodeId":726990108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3158052210,"text":"Best not to underestimate him all the same.","nextNodeIds":[726990109]},{"nodeId":726990109,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":578442770,"text":"Exactly! Your desire to show no partiality to your foes fills me with respect for you!","nextNodeIds":[726990110]},{"nodeId":726990110,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3730314154,"text":"Previously, if I had not looked down on our fourth contestant, I would not have suffered such a terrible defeat.","nextNodeIds":[726990111]},{"nodeId":726990111,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":4271163330,"text":"#But the man I am today is not the man I was yesterday! Come on then, {NICKNAME}, let us duel!","nextNodeIds":[726990114,726990112]},{"nodeId":726990114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1365283778,"text":"Let us cross swords.","nextNodeIds":[726990115]},{"nodeId":726990115,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":3252142266,"text":"Bring it on.","nextNodeIds":[]},{"nodeId":726990112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4110303674,"text":"Give me a second to prepare.","nextNodeIds":[726990113]},{"nodeId":726990113,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"Yasuhiko Tarou","textMapHash":523206394,"text":"I understand. Take your time to prepare.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269901,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30167"],"NOCCOBOFKHP":3,"OFEB