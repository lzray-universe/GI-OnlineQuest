_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1501601],"talks":[{"talkId":1501601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1501601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1501601,"initDialog":150160101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1095],"performCfg":"QuestDialogue/LQ/Xilonen_15016/Q1501601","priority":5,"questId":15016,"showRandomTalkCount":0},"dialogs":[{"nodeId":150160101,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2311155722,"text":"Ah, you're here. Everything's been taken care of now. I was just about to go have a rest.","nextNodeIds":[150160102]},{"nodeId":150160102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1147433042,"text":"So what about Tlazolli? Will she be punished?","nextNodeIds":[150160103]},{"nodeId":150160103,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1139070994,"text":"Well, the tribe is still discussing that. I mean, not many have ever used Ancient Names to commit a crime... Pacal will have a lot on his plate.","nextNodeIds":[150160104]},{"nodeId":150160104,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":403595138,"text":"What I do know is that Tlazolli's workshop will be closed permanently, and any remaining incomplete Blazegem Inscriptions will be completely destroyed.","nextNodeIds":[150160105]},{"nodeId":150160105,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3436370466,"text":"As for the completed Blazegem Inscriptions, I'll be handling them, which, yeah, yet another hassle to deal with...","nextNodeIds":[150160106]},{"nodeId":150160106,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2444163786,"text":"Anyway, at least her Ancient Name is fine, otherwise, we'd have a real mess on our hands...","nextNodeIds":[150160107]},{"nodeId":150160107,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":138691450,"text":"Oh, and speaking of Ancient Names, I actually have some good news. The memories that were absorbed by the Blazegem Inscriptions can be restored to their owners.","nextNodeIds":[150160108]},{"nodeId":150160108,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":832796730,"text":"Once all the Blazegem Inscriptions stop working, the memories will return to their respective owners.","nextNodeIds":[150160109,150160110]},{"nodeId":150160109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3519586362,"text":"So everyone's memories of Nechca...","nextNodeIds":[150160111]},{"nodeId":150160111,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":1248940386,"text":"Yeah, that's right. Huh, wait, now that I think about it... In her attempt to get Nechca to come back, Auntie made the entire tribe forget about her.","nextNodeIds":[150160112]},{"nodeId":150160112,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2559993658,"text":"Now, Nechca really is gone, but everyone is about to remember her... What a bizarre turn of events.","nextNodeIds":[150160113]},{"nodeId":150160113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":661398586,"text":"How's Nepecha doing?","nextNodeIds":[150160114]},{"nodeId":150160114,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3632642946,"text":"She's resting in my workshop. I contacted others from the tribe, and told them about my plan to conduct an official investigation into her history.","nextNodeIds":[150160115]},{"nodeId":150160115,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":2384350370,"text":"The tribe hasn't responded yet, so I'm planning to take her in for now, and teach her some crafting skills.","nextNodeIds":[150160116]},{"nodeId":150160116,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":87848618,"text":"But that's for another time. For now, she should just rest and sleep.","nextNodeIds":[150160117]},{"nodeId":150160117,"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","textMapHash":3684535730,"text":"After all, she's got a busy future ahead of her.","nextNodeIds":[]},{"nodeId":150160110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":418052338,"text":"Will all come back?","nextNodeIds":[150160111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1501601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1501601","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1501601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1095,"speakerName":"Xilonen","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[115016],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2839365046,"CHECNJEMEFE":{"1095":[1120]},"CJPLOBIFHLG":"MAINQUEST_TAG_NATLAN_TRIBAL","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":2068,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/LQ/Xilonen_15016/Q1501601","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":150160101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":1501601,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":true,"KINCAGMDMHH":[1095],"KJLNGKKBBOI":"TALK_MARK_NONE","K