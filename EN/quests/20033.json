301","priority":5,"questId":20033,"showRandomTalkCount":0},"dialogs":[{"nodeId":200330101,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":3620509666,"text":"Traveler, come have a look! What do you think? Does this look good on me?","nextNodeIds":[200330102]},{"nodeId":200330102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":392064706,"text":"Oh, this uniform...!","nextNodeIds":[200330103]},{"nodeId":200330103,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":2994497554,"text":"That's right! I passed the Adventurers' Guild exam. That makes me an officially-recognized adventurer!","nextNodeIds":[200330104,200330105]},{"nodeId":200330104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2568819026,"text":"You look awesome!","nextNodeIds":[200330106]},{"nodeId":200330106,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":3234694706,"text":"Hehe, thanks. I tried to persuade my brother to give the exam a go too, but he refused no matter what I said...","nextNodeIds":[200330107]},{"nodeId":200330107,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":2348837466,"text":"I've got no interest in adventures... And anyway, who'll take care of our parents if we both become adventurers?","nextNodeIds":[200330108]},{"nodeId":200330108,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":1092106514,"text":"Well, then we can bring them along! We can travel the whole world together!","nextNodeIds":[200330109]},{"nodeId":200330109,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":3613109034,"text":"You... Alright, alright. You're an adventurer now, so do your best. Leave matters at home to me.","nextNodeIds":[200330110]},{"nodeId":200330110,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"Anthony","textMapHash":3122680594,"text":"But remember, don't get yourself injured, and don't overtax yourself...","nextNodeIds":[200330111]},{"nodeId":200330111,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":2847703098,"text":"Oh, fine, fine, I get it! Heading out now, I've got a commission to finish!","nextNodeIds":[200330112]},{"nodeId":200330112,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":3755054842,"text":"Traveler, do you mind coming with me? I've got so many things I want to ask you about being an adventurer!","nextNodeIds":[200330113,200330114]},{"nodeId":200330113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2769020994,"text":"Sure.","nextNodeIds":[200330115]},{"nodeId":200330115,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":910687466,"text":"Now let me see. This commission is...","nextNodeIds":[200330116]},{"nodeId":200330116,"roleType":"TALK_ROLE_NPC","speakerId":1700,"speakerName":"Anna","textMapHash":851008682,"text":"Transport Balloon Escort!","nextNodeIds":[]},{"nodeId":200330114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3443758946,"text":"Okay. Let's go!","nextNodeIds":[200330115]},{"nodeId":200330105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1853808434,"text":"Congratulations!","nextNodeIds":[200330106]}]},{"talkId":2003303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"li