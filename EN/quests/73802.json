:0},"dialogs":[{"nodeId":738020101,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":2044187338,"text":"Ad astra abyssosque! Welcome to the Adventurers' Guild.","nextNodeIds":[738020102]},{"nodeId":738020102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2659654882,"text":"Hi, Katheryne.","nextNodeIds":[738020103]},{"nodeId":738020103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2063747194,"text":"Hello, Katheryne...","nextNodeIds":[738020104]},{"nodeId":738020104,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":4090537866,"text":"Greetings. You both look great today. Are you here to take commissions or deal with other affairs?","nextNodeIds":[738020105]},{"nodeId":738020105,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":1471358802,"text":"Why are you both staring at me? Is there something of significance that you would like to inquire about?","nextNodeIds":[738020106,738020107]},{"nodeId":738020106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3820460826,"text":"No!","nextNodeIds":[738020108]},{"nodeId":738020108,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":1215637578,"text":"Understood. You seem like a seasoned adventurer already.","nextNodeIds":[738020109]},{"nodeId":738020109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1827120194,"text":"You could say that.","nextNodeIds":[738020110]},{"nodeId":738020110,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":2899286546,"text":"Then you must be well acquainted with the Adventurers' Guild's way of operation. Therefore, I won't waste your time going over it.","nextNodeIds":[738020111]},{"nodeId":738020111,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":740801914,"text":"If you have any questions for the Guild, please feel free to ask me at any time.","nextNodeIds":[738020112]},{"nodeId":738020112,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":2976061626,"text":"Please pitch in with the commissions in Sumeru City. Outstanding adventurers like you will surely be a great help to the people here.","nextNodeIds":[738020113]},{"nodeId":738020113,"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","textMapHash":3675767570,"text":"Safe travels, Traveler. Ad astra abyssosque!","nextNodeIds":[]},{"nodeId":738020107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3105999402,"text":"W—We just want to take commissions...","nextNodeIds":[738020108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7380201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3013","0"],"PAINLIBBLDK":"QUEST_EXEC_CLEAR_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["4019"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7380201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":4019,"speakerName":"Katheryne","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173802],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2063190758,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBB