":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2002702","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2002701,"initDialog":200270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[153301],"performCfg":"","priority":5,"questId":20027,"showRandomTalkCount":0},"dialogs":[{"nodeId":200270101,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":3722832417,"text":"#Thank you, {NICKNAME}...","nextNodeIds":[200270102]},{"nodeId":200270102,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":2894255609,"text":"I just wanted to tend to the grape vines, and then... this happened.","nextNodeIds":[200270103]},{"nodeId":200270103,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":3805368409,"text":"*sigh* Please don't say a word about this to my son. He's one of the Knights of Favonius, so I'm sure he has enough to worry about as it is.","nextNodeIds":[200270104]},{"nodeId":200270104,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":3925525153,"text":"There's no need to bother him over a silly old man getting himself into a bit of a pickle.","nextNodeIds":[200270105]},{"nodeId":200270105,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":3945071817,"text":"Recently, though, we do seem to be having a bit of a slime problem around the winery area. I worry constantly that they'll demolish my grape vines. It's keeping me up at night.","nextNodeIds":[200270106]},{"nodeId":200270106,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":2266851025,"text":"I don't know if you have the time to spare for an old man like me... but if so, could you chase off the slimes in the area for me, to stop them from getting at my grapes?","nextNodeIds":[200270107,200270108]},{"nodeId":200270107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":123610537,"text":"Sure thing, old man.","nextNodeIds":[200270109]},{"nodeId":200270109,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":327767425,"text":"Bless you, child! I will rest better for it.","nextNodeIds":[]},{"nodeId":200270108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":607200489,"text":"No way, old man.","nextNodeIds":[200270110]},{"nodeId":200270110,"roleType":"TALK_ROLE_NPC","speakerId":153301,"speakerName":"Tunner","textMapHash":1410322993,"text":"*sigh* I would happily do it myself, but at my age my strength is not what it used to be... For a youngster like you, this should be no problem. Come on, make an old man's day.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"13300228101"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Event_20201","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":2002703,"order":3,"stepDescription":"Talk to Tunner","stepDescTextMapHash":851193248,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2002701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NON