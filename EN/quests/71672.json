{"mainQuestId":71672,"title":"The Moonlit Adeptus's Trail","description":"You run into someone who loves listening to stories in Liyue Harbor...","titleTextMapHash":627763087,"descTextMapHash":3172016830,"mainQuestExcel":{"mainQuestId":71672,"titleTextMapHash":627763087,"title":"The Moonlit Adeptus's Trail","descTextMapHash":3172016830,"description":"You run into someone who loves listening to stories in Liyue Harbor...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2045,"luaPath":"Actor/Quest/WQ71672","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2045,"chapterId":0,"descTextMapHash":3172016830,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71672,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2893091849,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71672","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171672],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":627763087,"type":"WQ","unlockDescTextMapHash":372291238}},"flow":[{"subQuestId":7167201,"order":1,"stepDescription":"Talk to Baofei","stepDescTextMapHash":1145875012,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30951"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7167201],"talks":[{"talkId":7167201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7167201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7167201,"initDialog":716720101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30951],"performCfg":"QuestDialogue/WQ/HDJ_71672/Q7167201","priority":5,"questId":71672,"showRandomTalkCount":0},"dialogs":[{"nodeId":716720101,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":1079756554,"text":"...Hehe, yesterday I heard another story about the White Horse Adeptus, and now I'm feeling inspired again.","nextNodeIds":[716720102,716720103]},{"nodeId":716720102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2553112450,"text":"Inspired how?","nextNodeIds":[716720104]},{"nodeId":716720104,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":3903497954,"text":"Eh? Ah! H—Hello, hello, hello! W—Welcome to Liyue Harbor! Welcome to the Lantern Rite... No, wait... Welcome to Liyue Harbor!","nextNodeIds":[716720105]},{"nodeId":716720105,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":3104310602,"text":"Phew, Miss Pingxi didn't see that, right? Okay... looks like she didn't...","nextNodeIds":[716720106]},{"nodeId":716720106,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":2991940482,"text":"Welcome to Liyue Harbor! You must be here for the Lantern Rite, right? Then you've gotta check out my mini-game, \"The Moonlit Adeptus's Trail\"...","nextNodeIds":[716720107]},{"nodeId":716720107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1680466874,"text":"You've switched straight into work mode, huh...","nextNodeIds":[716720108]},{"nodeId":716720108,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":3468032538,"text":"D—Don't sell me out! If Miss Pingxi caught me distracted, she'd definitely give me an earful!","nextNodeIds":[716720109]},{"nodeId":716720109,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":1186678338,"text":"It took me ages to talk her into letting me run this stall, just let me finish up...","nextNodeIds":[716720110]},{"nodeId":716720110,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":154649034,"text":"Ahem, ahem. \"The Moonlit Adeptus's Trail\" is based on the legend of the \"White Horse Adeptus,\" a story shared throughout the Liyue Harbor.","nextNodeIds":[716720111]},{"nodeId":716720111,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":4018958498,"text":"Legend has it that this adeptus would often travel through the skies by moonlight, protecting Liyue Harbor from evil spirits and monsters...","nextNodeIds":[716720112]},{"nodeId":716720112,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":3262699298,"text":"...Well, I found that legend so uninspired, so... hehe, I chose to blend in some other stories I've heard for this mini-game.","nextNodeIds":[716720113]},{"nodeId":716720113,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":3377627914,"text":"For example, there have been monsters in the sky, who were always itching to swallow the whole moon! But thanks to the White Horse Adeptus, these monsters didn't get their way...","nextNodeIds":[716720114]},{"nodeId":716720114,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":726998618,"text":"I can't imagine what the moon would look like while being eaten... but in Liu Su's story, the monsters chew it down slowly, piece by piece — kind of like how we work through a pancake.","nextNodeIds":[716720115]},{"nodeId":716720115,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":797240706,"text":"But when I went to listen a couple of days later, his story was put in another way. This time, a monster gulped down the whole moon in one bite, just like eating a riceball.","nextNodeIds":[716720116]},{"nodeId":716720116,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":1074566146,"text":"Fortunately, the story always ended with the White Horse Adeptus wiping out all the monsters in one fell swoop, guided by the light from the Xiao Lanterns.","nextNodeIds":[716720117]},{"nodeId":716720117,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":298211410,"text":"That's part of the legend too?","nextNodeIds":[716720118]},{"nodeId":716720118,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":288145362,"text":"Anyway, that's how Liu Su's story goes. I thought it was cool, so I included it into \"The Moonlit Adeptus's Trail.\"","nextNodeIds":[716720119]},{"nodeId":716720119,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":2038265282,"text":"Oh, no! Enough chitchat, I need to get back to work...","nextNodeIds":[716720120]},{"nodeId":716720120,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Baofei","textMapHash":538074538,"text":"If you'd like to try \"The Moonlit Adeptus's Trail,\" just let me know. Everything's ready, we can start whenever you want.","nextNodeIds":[]},{"nodeId":716720103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3636453218,"text":"Are you planning to become a storyteller?","nextNodeIds":[716720104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30951"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7167201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"Ba