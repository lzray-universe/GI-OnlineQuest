pe":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351701,"initDialog":735170101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342,30343],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351701","priority":5,"questId":73517,"showRandomTalkCount":0},"dialogs":[{"nodeId":735170101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2235319122,"text":"...So as far as the conclusion is concerned, we've made a convincing case for using the Wenutslayer Cannon to get rid of the Wenut, right?","nextNodeIds":[735170102]},{"nodeId":735170102,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1613037954,"text":"That's different! Don't give me that \"told you so\" look!","nextNodeIds":[735170103,735170104]},{"nodeId":735170103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1815440186,"text":"Here we go again...","nextNodeIds":[735170105]},{"nodeId":735170105,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2617021866,"text":"#Ah, {M#Mr.}{F#Ms.} Adventurer! Listen to me! I've found out what the cause is!","nextNodeIds":[735170106]},{"nodeId":735170106,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3723986650,"text":"The frequent activity of the Wenut underground had caused a disturbance in the Elemental Energy in this region.","nextNodeIds":[735170107]},{"nodeId":735170107,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3747694962,"text":"This Energy, in turn, affects the behavior of the Wenut, causing them to start running amok on the surface, further exacerbating the environmental imbalance.","nextNodeIds":[735170108]},{"nodeId":735170108,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1288218730,"text":"The abnormality in the charging device's efficiency was also due to the disturbance of Elemental Energy in the environment.","nextNodeIds":[735170109]},{"nodeId":735170109,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2462642514,"text":"I knew the machine that I designed would never break down so easily!","nextNodeIds":[735170110]},{"nodeId":735170110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3920206034,"text":"If you don't consider the surrounding environment, wouldn't that be a design problem?","nextNodeIds":[735170111,735170112]},{"nodeId":735170111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3273955410,"text":"And since the cause is overactive Wenut...","nextNodeIds":[735170113]},{"nodeId":735170113,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1966745938,"text":"So, after going around in several circles, we're back to where we started?","nextNodeIds":[735170114]},{"nodeId":735170114,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2034555482,"text":"Knowing what to do and knowing why you should do it are two different things. As a researcher, you couldn't even grasp that? And that isn't even the end of it.","nextNodeIds":[735170115]},{"nodeId":735170115,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":943069690,"text":"Normally, nature sets limits on the ecology and behavior of populations to keep the environment stable.","nextNodeIds":[735170116]},{"nodeId":735170116,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":599667394,"text":"The chaotic Elemental Energy disrupts this balance, which makes the Wenut extremely active...","nextNodeIds":[735170117]},{"nodeId":735170117,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":4011222194,"text":"As long as we can find a way to return the elemental environment to its normal state, we can reduce Wenut activity. After a while, the balance should restore itself.","nextNodeIds":[735170118]},{"nodeId":735170118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1319434922,"text":"Redirect the flow of Elemental Energy? But how do we do that?","nextNodeIds":[735170119]},{"nodeId":735170119,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1430182186,"text":"Well, as long as we figure out where the strongest concentration of Elemental Energy is, we'll be able to direct the flow of that energy with a device...","nextNodeIds":[735170120]},{"nodeId":735170120,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2167951362,"text":"...We unclog the flow of energy, and nature should take care of the rest.","nextNodeIds":[735170121]},{"nodeId":735170121,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1888101154,"text":"I've already calculated the location of the node. It's somewhere around here. As for a device that can redirect the flow of the energy, we already have one...","nextNodeIds":[735170122]},{"nodeId":735170122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3198179322,"text":"You mean the Wenutslayer Cannon?","nextNodeIds":[735170123]},{"nodeId":735170123,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":3717834874,"text":"Precisely. The Wenutslayer Cannon can channel the surrounding Elemental Energy before discharging it all in one go.","nextNodeIds":[735170124]},{"nodeId":735170124,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2128421114,"text":"Next, we just have to set up the Wenutslayer Cannon and go through the same process as yesterday.","nextNodeIds":[735170125]},{"nodeId":735170125,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":354391170,"text":"There may also be monsters and Wenut that will be drawn to the weapon during this time... Heh... perhaps a small reduction in their numbers would help expedite the natural balance.","nextNodeIds":[735170126]},{"nodeId":735170126,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2425555130,"text":"...So as far as the conclusion is concerned, we still have to use the Wenutslayer Cannon to shoot at monsters, right?","nextNodeIds":[735170127]},{"nodeId":735170127,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":593950130,"text":"Ugh! Don't give me that \"told you so\" look!","nextNodeIds":[]},{"nodeId":735170112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3030689194,"text":"Is the solution to just keep fighting more Wenut?","nextNodeIds":[735170113]},{"nodeId":735170104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2511287538,"text":"What are you squabbling about this time?","nextNodeIds":[735170105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173517],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":878525902,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/V3.6SandSworm/Q7351701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNF