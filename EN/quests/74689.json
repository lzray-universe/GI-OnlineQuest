{"mainQuestId":74689,"title":"Hot in a Flash, or Cold Just as Fast?","description":"It is said that Lepine-Pauline has developed a groundbreaking new lens. But why does her apprentice Ninette look on the verge of tears?","titleTextMapHash":259107823,"descTextMapHash":3088390454,"mainQuestExcel":{"mainQuestId":74689,"titleTextMapHash":259107823,"title":"Hot in a Flash, or Cold Just as Fast?","descTextMapHash":3088390454,"description":"It is said that Lepine-Pauline has developed a groundbreaking new lens. But why does her apprentice Ninette look on the verge of tears?","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5307,"luaPath":"Actor/Quest/WQ74689","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5307,"chapterId":0,"descTextMapHash":3088390454,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74689,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":626888873,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74689","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174689],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":259107823,"type":"WQ","unlockDescTextMapHash":3754330038}},"flow":[{"subQuestId":7468901,"order":1,"stepDescription":"Talk to Ninette","stepDescTextMapHash":2223574580,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30920"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7468901],"talks":[{"talkId":7468901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7468901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468901,"initDialog":746890101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30920],"performCfg":"QuestDialogue/WQ/Fontaine_74689/Q7468901","priority":5,"questId":74689,"showRandomTalkCount":0},"dialogs":[{"nodeId":746890101,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2023160026,"text":"(...Could they be the ones Master mentioned? The golden-haired traveler, and that flying fairy dressed in white...)","nextNodeIds":[746890102]},{"nodeId":746890102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2419078706,"text":"Huh? Why are you staring at us and muttering like that? Is there something weird on our faces?","nextNodeIds":[746890103]},{"nodeId":746890103,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":1005104194,"text":"Ah! M—My apologies! I didn't mean to! I just... I just thought...","nextNodeIds":[746890104,746890105]},{"nodeId":746890104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":209353882,"text":"There's no rush. Please, take your time.","nextNodeIds":[746890106]},{"nodeId":746890106,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":4125460762,"text":"#I... I'm Ninette, and my master is Lepine-Pauline. She told me about you... said you're the legendary adventurer {NICKNAME}, and that you travel with your best companion, Paimon!","nextNodeIds":[746890107]},{"nodeId":746890107,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2363552226,"text":"I... I never imagined I'd really get to see you in person...","nextNodeIds":[746890108]},{"nodeId":746890108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3720458002,"text":"Oh! So you're Lepine-Pauline's apprentice! Guess her business has really been booming lately, huh?","nextNodeIds":[746890109]},{"nodeId":746890109,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":1113919954,"text":"Yes! And it's all thanks to her that I was able to get back on my feet after a really hard time.","nextNodeIds":[746890110]},{"nodeId":746890110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":614743674,"text":"Did something happen?","nextNodeIds":[746890111]},{"nodeId":746890111,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":3548733810,"text":"I used to study photography under another teacher.","nextNodeIds":[746890112]},{"nodeId":746890112,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":1353782698,"text":"I wanted to make it on my own someday, so I spent all my savings on the best Kamera equipment I could afford.","nextNodeIds":[746890113]},{"nodeId":746890113,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":3471686746,"text":"My teacher said my skills weren't bad, and I really believed that if I just took good photos, I'd be able to make a living.","nextNodeIds":[746890114]},{"nodeId":746890114,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2251274514,"text":"But... when I actually went out on the streets and saw people, I got so nervous that I couldn't get a single word out.","nextNodeIds":[746890115]},{"nodeId":746890115,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":1458817714,"text":"Every time I tried to say, \"Hello, would you like a photo?\", the words just got stuck in my throat.","nextNodeIds":[746890116]},{"nodeId":746890116,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2456758130,"text":"In the end, everyone just went to the photographers who were friendlier and better at talking to people.","nextNodeIds":[746890117]},{"nodeId":746890117,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":4014579994,"text":"Before I knew it, I'd almost run out of Mora... and I even thought about selling my Kamera just to get by...","nextNodeIds":[746890118]},{"nodeId":746890118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2678609642,"text":"That must've been really hard.","nextNodeIds":[746890119]},{"nodeId":746890119,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":1186183762,"text":"It was right then that I met Master Lepine-Pauline.","nextNodeIds":[746890120]},{"nodeId":746890120,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2912691826,"text":"When she saw my equipment and the photos I'd taken, she encouraged me and had me work with her to test a new lens.","nextNodeIds":[746890121]},{"nodeId":746890121,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":4084125794,"text":"She said there was a calm, gentle quality in my photos... something she didn't see in anyone else's.","nextNodeIds":[746890122]},{"nodeId":746890122,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":705140602,"text":"So when Master finally finished developing the Shutterflash lens, I was really happy! Probably even more than she was!","nextNodeIds":[746890123]},{"nodeId":746890123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4020998794,"text":"The Shutterflash lens? What kind of lens is that?","nextNodeIds":[746890124]},{"nodeId":746890124,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":4067222450,"text":"It captures every movement and expression perfectly, even when the subject's moving really fast!","nextNodeIds":[746890125]},{"nodeId":746890125,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":3507239658,"text":"But... it's still in the final testing phase, so we need to take a lot of real-world photos to gather data and make sure it works properly.","nextNodeIds":[746890126]},{"nodeId":746890126,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":1662071402,"text":"Since Master's been tied up with other work, she handed this task to me. I was thinking I could try finding a few people to help with the testing...","nextNodeIds":[746890127]},{"nodeId":746890127,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2331197842,"text":"But... it happened again. Whenever I tried to talk to someone I didn't know, I got all flustered and couldn't make any sense...","nextNodeIds":[746890128]},{"nodeId":746890128,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":3532054786,"text":"Everyone just looked at me kind of confused... they probably thought I was acting suspicious or something. A few days went by, and I still couldn't find anyone willing to help.","nextNodeIds":[746890129]},{"nodeId":746890129,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":242966322,"text":"*sobbing*... I couldn't even handle something this easy... I guess I really am hopeless...","nextNodeIds":[746890130]},{"nodeId":746890130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2326402346,"text":"Hey, hey, don't cry! It's really not your fault, okay?","nextNodeIds":[746890131]},{"nodeId":746890131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":272425058,"text":"Really, asking strangers for help like that is hard for anyone!","nextNodeIds":[746890132,746890133]},{"nodeId":746890132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1559598338,"text":"Don't beat yourself up over it. You've already tried your best.","nextNodeIds":[746890134]},{"nodeId":746890134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3484409154,"text":"#Uh-huh! {NICKNAME}'s got great photo skills! And {M#he}{F#she} knows tons of people all over the place, so getting models should be super easy!","nextNodeIds":[746890135]},{"nodeId":746890135,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":3130175586,"text":"R—Really? You'd actually help me?","nextNodeIds":[746890136]},{"nodeId":746890136,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":176056834,"text":"#W—Whoa! Thank you so, so much, {NICKNAME}!","nextNodeIds":[746890137]},{"nodeId":746890137,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":138598354,"text":"Then... please take this special Kamera with the Shutterflash lens. I'll be counting on you to handle it!","nextNodeIds":[746890138]},{"nodeId":746890138,"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"Ninette","textMapHash":2932316538,"text":"Please take some photos of your friends. Try to capture their most natural, expressive moments!","nextNodeIds":[]},{"nodeId":746890133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1517357922,"text":"In that case... maybe we could lend a hand.","nextNodeIds":[746890134]},{"nodeId":746890105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1718466362,"text":"Do I know you?","nextNodeIds":[746890106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30920"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"q