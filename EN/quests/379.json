lkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["37904","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":37904,"initDialog":3790401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1006],"performCfg":"QuestDialogue/AQ/Mengde2_379/Q37904","priority":1,"questId":379,"showRandomTalkCount":0},"dialogs":[{"nodeId":3790401,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2715364099,"text":"It worked, as expected.","nextNodeIds":[3790402]},{"nodeId":3790402,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":206752627,"text":"This youthful glow...","nextNodeIds":[3790403]},{"nodeId":3790403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":774185491,"text":"Praising yourself? Really?","nextNodeIds":[3790404]},{"nodeId":3790404,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":4083993067,"text":"...I was talking about the Holy Lyre.","nextNodeIds":[3790405]},{"nodeId":3790405,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3501317243,"text":"#Thanks to {NICKNAME} having purified the crystal, the Holy Lyre won't continue to lose power.","nextNodeIds":[3790406]},{"nodeId":3790406,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":4075671195,"text":"That said, its power is far from replenished. It'd be great if we could get more tears.","nextNodeIds":[3790407,3790409,3790410]},{"nodeId":3790407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3485036571,"text":"We'll help.","nextNodeIds":[3790408]},{"nodeId":3790408,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2153053427,"text":"How can we gather more?","nextNodeIds":[3790411]},{"nodeId":3790411,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3131197579,"text":"I can surmise that Dvalin will already be crying...","nextNodeIds":[3790412]},{"nodeId":3790412,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":3229972779,"text":"Suffering alone in some deserted place...","nextNodeIds":[3790413]},{"nodeId":3790413,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3883193835,"text":"Dvalin...","nextNodeIds":[3790414]},{"nodeId":3790414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2519708555,"text":"Poor baby...","nextNodeIds":[3790415]},{"nodeId":3790415,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":783658251,"text":"This is not something that an Honorary Knight can accomplish alone. I will mobilize the rest of the knights to assist.","nextNodeIds":[3790416]},{"nodeId":3790416,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"Jean","textMapHash":3632365027,"text":"#When you get the Teardrop Crystal, please let {NICKNAME} perform the purification process.","nextNodeIds":[3790417]},{"nodeId":3790417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":496987747,"text":"Leave it to me.","nextNodeIds":[3790418]},{"nodeId":3790418,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":1863868691,"text":"Heroes supporting each other and setting out on a journey together... How exciting!","nextNodeIds":[3790419]},{"nodeId":3790419,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2841185011,"text":"Lemme come up with a song for you...","nextNodeIds":[3790420]},{"nodeId":3790420,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":919636691,"text":"Is that all you're going to do? Just sing?","nextNodeIds":[3790421]},{"nodeId":3790421,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"Venti","textMapHash":2113219235,"text":"Wouldn't be much of a bard if I didn't now, would I?","nextNodeIds":[3790422]},{"nodeId":3790422,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3500906899,"text":"Hmph. You're so cheeky... You deserve an ugly nickname.","nextNodeIds":[3790423]},{"nodeId":3790423,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3639658419,"text":"Oh, Paimon knows! From now on, you'll be known as \"<color=#00E1FFFF>Tone-Deaf Bard</color>\"!","nextNodeIds":[]},{"nodeId":3790409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2133531987,"text":"Right. How do we do that?","nextNodeIds":[3790411]},{"nodeId":3790410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3645937675,"text":"How can we make Dvalin cry? By hitting him?","nextNodeIds":[3790411]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[37904,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1006"],"NOCCOBOFKHP":1009,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":37903,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBl