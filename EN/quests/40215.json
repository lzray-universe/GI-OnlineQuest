{"mainQuestId":40215,"title":"A Mysterious Outsourced Contract","description":"It seems the Kuuvahki Experimental Design Bureau has business with Aino...","titleTextMapHash":403561439,"descTextMapHash":1489654446,"mainQuestExcel":{"mainQuestId":40215,"titleTextMapHash":403561439,"title":"A Mysterious Outsourced Contract","descTextMapHash":1489654446,"description":"It seems the Kuuvahki Experimental Design Bureau has business with Aino...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2042,"luaPath":"Actor/Quest/WQ40215","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2042,"chapterId":0,"descTextMapHash":1489654446,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":40215,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":3031584617,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ40215","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[140215],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":403561439,"type":"WQ","unlockDescTextMapHash":4136351814}},"flow":[{"subQuestId":4021501,"order":1,"stepDescription":"Talk to Gaudenty","stepDescTextMapHash":522610580,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7053"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7665304],"talks":[{"talkId":7665304,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4021501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7665304,"initDialog":766530401,"nextRandomTalks":[],"nextTalks":[],"npcId":[7053],"performCfg":"QuestDialogue/EQ/V6.0ActivityNodKraiTour_76653/Q7665304","priority":5,"questId":40215,"showRandomTalkCount":0},"dialogs":[{"nodeId":766530401,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":3987645986,"text":"You're finally here. You didn't forget about this rare outsourced work opportunity now, did you?","nextNodeIds":[766530402]},{"nodeId":766530402,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":2439180986,"text":"Wait, hold on. Which order's yours again?","nextNodeIds":[766530403]},{"nodeId":766530403,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":1466843586,"text":"...I'm Gaudenty, expatriate representative from the Kuuvahki Experimental Design Bureau. That should be enough to jog your memory, no?","nextNodeIds":[766530404]},{"nodeId":766530404,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1499249186,"text":"Too long, didn't hear. Gimme the deets of your order.","nextNodeIds":[766530405]},{"nodeId":766530405,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":2334540218,"text":"You...! Tch, I'll only say it once more. Recently, a batch of out-of-control recon bots flew out of the Design Bureau, and it's my job to retrieve the wandering units.","nextNodeIds":[766530406]},{"nodeId":766530406,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":2038462786,"text":"But the robots tend to fly rather high, and handling them alone will prove a tall order. That's why I offered you this opportunity.","nextNodeIds":[766530407]},{"nodeId":766530407,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":2318336866,"text":"Honestly, you can either retrieve them or destroy them on the spot. Our goal is simply to prevent them from falling into outsiders' hands.","nextNodeIds":[766530408]},{"nodeId":766530408,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":3022807298,"text":"Oh, that one! Yeah, those recon bots can go really, REALLY high, and most ordinary people can't even touch them. But that's why I mastered a way to simply make the Moonlanes we need to get up there.","nextNodeIds":[766530409]},{"nodeId":766530409,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1969707922,"text":"#You can get the kuuhenki to help out, right, {NICKNAME}? Let's test and see if they can use our Moonlanes and help us take down those recon bots!","nextNodeIds":[766530410]},{"nodeId":766530410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3910667146,"text":"#No problem! Just leave it to {NICKNAME}!","nextNodeIds":[766530411,766530412]},{"nodeId":766530411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":996347122,"text":"No problem indeed.","nextNodeIds":[766530413]},{"nodeId":766530413,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":3608983218,"text":"Oh, right. I'm not going to pay you in Mora. You can take the components of the recon bots as compensation instead.","nextNodeIds":[766530414]},{"nodeId":766530414,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":2475489650,"text":"This was stipulated in my order when I placed it, and I don't take retractions.","nextNodeIds":[766530415]},{"nodeId":766530415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3760018578,"text":"...You're giving us spare parts for payment? Didn't you just say the robots weren't supposed to fall into outsiders' hands?","nextNodeIds":[766530416]},{"nodeId":766530416,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","textMapHash":4082336162,"text":"Which is why this is a rare and valuable opportunity for you! If everything goes well, I don't mind turning a blind eye as thanks for your hard work.","nextNodeIds":[766530417]},{"nodeId":766530417,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2194698690,"text":"That's strange. It just sounds like you don't want to pay us...","nextNodeIds":[766530418]},{"nodeId":766530418,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":3730875218,"text":"Well, Mora or no Mora, doesn't matter to me. I want those parts, though. I'm thinking of using them for my future research projects...","nextNodeIds":[766530419]},{"nodeId":766530419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":161980066,"text":"Well, since you're okay with it, Aino...","nextNodeIds":[]},{"nodeId":766530412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3900517898,"text":"Sounds a little tricky...","nextNodeIds":[766530413]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7053"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7665304],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"Gaudenty","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[140215],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1489654446,"CHECNJEMEF