{"mainQuestId":74680,"title":"Rescue the Poor Contract Employee!","description":"During the joyous festival, some involved with the filmmaking industry are wearing frowns. You and Paimon encounter an unfortunate contracted employee...","titleTextMapHash":3354930711,"descTextMapHash":615266334,"mainQuestExcel":{"mainQuestId":74680,"titleTextMapHash":3354930711,"title":"Rescue the Poor Contract Employee!","descTextMapHash":615266334,"description":"During the joyous festival, some involved with the filmmaking industry are wearing frowns. You and Paimon encounter an unfortunate contracted employee...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2027,"luaPath":"Actor/Quest/WQ74680","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2027,"chapterId":0,"descTextMapHash":615266334,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74680,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1585445793,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74680","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174680],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3354930711,"type":"WQ","unlockDescTextMapHash":271557638}},"flow":[{"subQuestId":7468001,"order":1,"stepDescription":"Talk to the staff member","stepDescTextMapHash":1251011620,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30486"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7468001],"talks":[{"talkId":7468001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7468001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7468001,"initDialog":746800101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30486],"performCfg":"QuestDialogue/WQ/Filmfest_74680/Q7468001","priority":5,"questId":74680,"showRandomTalkCount":0},"dialogs":[{"nodeId":746800101,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":712190130,"text":"Fontinalia Film Festival... Great job! You really outdid yourself this time!","nextNodeIds":[746800102]},{"nodeId":746800102,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1805592714,"text":"As things stand, finishing the project before the deadline is nothing but a pipe dream...","nextNodeIds":[746800103]},{"nodeId":746800103,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3178424842,"text":"*sob* *wailing* I'm not just in for a scolding... the boss is literally going to kill me!","nextNodeIds":[746800104]},{"nodeId":746800104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2299820634,"text":"Why's that young lady over there crying?","nextNodeIds":[746800105]},{"nodeId":746800105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":650293306,"text":"D'you think she needs a doctor? I wonder if there are any professional therapists in Fontaine?","nextNodeIds":[746800106]},{"nodeId":746800106,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3362786074,"text":"*sobbing* When did you get here...","nextNodeIds":[746800107]},{"nodeId":746800107,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":2632316186,"text":"Thanks for your concern, but right now what I need is a doctor that can resurrect my dying career!","nextNodeIds":[746800108]},{"nodeId":746800108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3566921426,"text":"Paimon's pretty sure that isn't something a doctor can fix!","nextNodeIds":[746800109,746800111]},{"nodeId":746800109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1594992682,"text":"It's only a job! Worst case scenario, you can always get another one!","nextNodeIds":[746800110]},{"nodeId":746800110,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1529237618,"text":"Gah! Getting a new job's worse than dying... Everything you've learned goes out the window, and you have to start over from scratch!","nextNodeIds":[746800113]},{"nodeId":746800113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2381987266,"text":"Just talking about it like this won't solve anything, though! Why don't you tell us more about your problem?","nextNodeIds":[746800114]},{"nodeId":746800114,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3311951578,"text":"That might be a bit hard, considering it's a technical issue. Now, just how can I explain it...","nextNodeIds":[746800115]},{"nodeId":746800115,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1886903866,"text":"Well, first things first — my name's Helene and I'm an engineer working for the Fontinalia Film Festival's equipment supplier. I'm mainly responsible for developing audiovisual equipment.","nextNodeIds":[746800116]},{"nodeId":746800116,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1584519762,"text":"To achieve a certain effect when filming, our client requested us to develop a kind of \"stabilization platform\" that can carry Film Kameras while moving at high speed...","nextNodeIds":[746800117]},{"nodeId":746800117,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":832474314,"text":"These \"stabilization platforms\" also needed to be able to carry puppets that look like actors or model animals, playing the part of groups in the background.","nextNodeIds":[746800118]},{"nodeId":746800118,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3762530066,"text":"That way, they'd be able to keep the Kameras fixed on actors while moving at high speeds, or save them from having to splash out the cash to hire hordes of extras.","nextNodeIds":[746800119]},{"nodeId":746800119,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3997703602,"text":"On top of that, they insisted that each platform had to be less than a third of the cost of a Kamera, and that its lifespan had to be at least thirty years.","nextNodeIds":[746800120]},{"nodeId":746800120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2486881890,"text":"How is anyone that picky!? Even for a master craftsman, producing something cheap but durable that works well is nigh-on impossible!","nextNodeIds":[746800121]},{"nodeId":746800121,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3557813970,"text":"But I managed it.","nextNodeIds":[746800122]},{"nodeId":746800122,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3783480514,"text":"After all, the customer is always right! We've had even fussier clients before, and I've nearly run myself into the ground trying to satisfy them.","nextNodeIds":[746800123]},{"nodeId":746800123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":502220146,"text":"...","nextNodeIds":[746800124]},{"nodeId":746800124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":188501946,"text":"...Then what's got you in such a huff?","nextNodeIds":[746800125]},{"nodeId":746800125,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":815794514,"text":"The problem is I don't have anyone to test it! I've created the product, but unless I can get it tested, the project can't be considered complete!","nextNodeIds":[746800126]},{"nodeId":746800126,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1491954962,"text":"All the testers who have a basic grasp of mechanics or are physically fit enough have already been employed by the Fontinalia Film Festival for more important work...","nextNodeIds":[746800127]},{"nodeId":746800127,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1802952810,"text":"If the client receives a product that hasn't undergone proper testing, and it turns out there's something wrong with it, I'll have to cough up ten times the original payment amount in compensation!","nextNodeIds":[746800128]},{"nodeId":746800128,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3814913298,"text":"All I can do is hang around trying to sell our products while I look for some outside assistance...","nextNodeIds":[746800129]},{"nodeId":746800129,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3978126770,"text":"Even if it means I end up losing money on this contract in the end, so be it. After all, it was my boss that signed the agreement with the client. But I'll be the one on the hook if we have to compensate them ten times the value of the contract!","nextNodeIds":[746800130]},{"nodeId":746800130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":147156018,"text":"We've come this far, might as well tell us what testing involves...","nextNodeIds":[746800131]},{"nodeId":746800131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1948280578,"text":"That's right! As long as it's nothing too complex, perhaps we can handle some of the simpler stuff.","nextNodeIds":[746800132]},{"nodeId":746800132,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":271887106,"text":"It might not sound difficult, but it's harder than you think...","nextNodeIds":[746800133]},{"nodeId":746800133,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":4110150834,"text":"To confirm how the stabilization platforms perform when running at extremely high speeds, I set them to \"avoid anyone who gets too close\" mode.","nextNodeIds":[746800134]},{"nodeId":746800134,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":150902330,"text":"The tester has to run after stabilization platforms within a specified area, and chase as many platforms as possible into the target area as quickly as possible.","nextNodeIds":[746800135]},{"nodeId":746800135,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1769061986,"text":"For someone with poor stamina like me, chasing a stabilization platform more than a few steps is enough to make them collapse from exhaustion...","nextNodeIds":[746800136,746800137]},{"nodeId":746800136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3358557506,"text":"What's so hard about that!?","nextNodeIds":[746800138]},{"nodeId":746800138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3879911498,"text":"Now that you've described it, Paimon's positive this'll be a piece of cake!","nextNodeIds":[746800139]},{"nodeId":746800139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2951070938,"text":"It's just a few machines! Just you wait, we'll be hot on their tails in no time! We might even end up overtaking them if you're lucky. Testing limits and that sorta thing is a walk in the park!","nextNodeIds":[746800140]},{"nodeId":746800140,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":2901315042,"text":"For real? What, genuinely? You're actually serious!?","nextNodeIds":[746800141]},{"nodeId":746800141,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":4070829786,"text":"Then I—I—I'll pay you! Please!","nextNodeIds":[746800142]},{"nodeId":746800142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":225367338,"text":"Ah, the commission... We won't say no to that! But under the circumstances, if we accept too much of your money, our consciences wouldn't forgive us!","nextNodeIds":[746800143]},{"nodeId":746800143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":606065674,"text":"Just pay us however much you'd usually pay your testers.","nextNodeIds":[746800144]},{"nodeId":746800144,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":1484813978,"text":"Miracle workers, that's what you are! Not just doctors, but miracle workers — here to resurrect my dying career!","nextNodeIds":[746800145]},{"nodeId":746800145,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":993626938,"text":"The testing site is in an empty Domain near the city. Well, I'll leave it to you two then! You have my undying gratitude!","nextNodeIds":[746800146]},{"nodeId":746800146,"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","textMapHash":3653464450,"text":"After this many years in the business, finally a bit of luck! The boss won't be killing me tomorrow after all!","nextNodeIds":[746800147]},{"nodeId":746800147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1175353754,"text":"Umm... After you've finished this job, maybe you should consider switching bosses...","nextNodeIds":[]},{"nodeId":746800137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2124009034,"text":"It's just a bit of running around!","nextNodeIds":[746800138]},{"nodeId":746800111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3877234154,"text":"Work is pretty important... Maybe we should help?","nextNodeIds":[746800112]},{"nodeId":746800112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3963587066,"text":"With how high she's made the stakes seem, we can't stand by and do nothing.","nextNodeIds":[746800113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30486"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30486,"speakerName":"Helene","count":28},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174680],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":615266334,"CHECNJEMEFE":{"30486":[1160]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Filmfest_74680/Q7468001","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":7