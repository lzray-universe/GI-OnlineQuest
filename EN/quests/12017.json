FDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["12076"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1201705],"talks":[{"talkId":1201705,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1201705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1201705,"initDialog":120170501,"nextRandomTalks":[],"nextTalks":[],"npcId":[12076],"performCfg":"QuestDialogue/LQ/Shougun1_12017/Q1201705","priority":5,"questId":12017,"showRandomTalkCount":0},"dialogs":[{"nodeId":120170501,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":147391298,"text":"It's a wrap! Take a look, here's the photo we took of you.","nextNodeIds":[120170502]},{"nodeId":120170502,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":246404378,"text":"Wow... this is astonishing. Is it some kind of magic? It seems to be... another copy of me?","nextNodeIds":[120170503]},{"nodeId":120170503,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1605854298,"text":"But she doesn't seem to be able to move or talk...","nextNodeIds":[120170504,120170505]},{"nodeId":120170504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4164565458,"text":"It's just a record.","nextNodeIds":[120170506]},{"nodeId":120170506,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":4028847746,"text":"I thought it would turn out poorly because I felt rather rigid. But it actually looks much more natural than I'd imagined.","nextNodeIds":[120170507]},{"nodeId":120170507,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":2574206226,"text":"The pose is exactly the same and so is the scenery in the background... I can't imagine how it's achieved.","nextNodeIds":[120170508]},{"nodeId":120170508,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3372854674,"text":"That's what makes it so special.","nextNodeIds":[120170509]},{"nodeId":120170509,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1383609794,"text":"Hang on, I'm still struggling to understand this. I need you to explain it again...","nextNodeIds":[120170510]},{"nodeId":120170510,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1033043370,"text":"So the one in this photo... are you sure it isn't me?","nextNodeIds":[120170511]},{"nodeId":120170511,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1408042010,"text":"If it's not me, then why does she look exactly like me? And if she is me, then... who am I?","nextNodeIds":[120170512]},{"nodeId":120170512,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3463509658,"text":"#Uh... okay, way above Paimon's head— over to you, {NICKNAME}!","nextNodeIds":[120170513]},{"nodeId":120170513,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":670616074,"text":"It's a little bit like you and the Shogun.","nextNodeIds":[120170514]},{"nodeId":120170514,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3753141298,"text":"Hey, that's right. Do you think the Shogun counts as you?","nextNodeIds":[120170515]},{"nodeId":120170515,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":3735343602,"text":"Of course I do. It was never my intention to place control of Inazuma into anybody else's hands.","nextNodeIds":[120170516]},{"nodeId":120170516,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3270567802,"text":"So then, who does that make you, here and now?","nextNodeIds":[120170517]},{"nodeId":120170517,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":3630200458,"text":"Well I'm still me. There is no doubt about that.","nextNodeIds":[120170518]},{"nodeId":120170518,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":95981826,"text":"So your existence isn't singular.","nextNodeIds":[120170519]},{"nodeId":120170519,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1124604794,"text":"My existence, hmm...","nextNodeIds":[120170520]},{"nodeId":120170520,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1131686394,"text":"I think I understand.","nextNodeIds":[120170521]},{"nodeId":120170521,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1311087554,"text":"I am me. There is only one of me, but I can exist in many different forms. It's not important what form I exist in.","nextNodeIds":[120170522]},{"nodeId":120170522,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":3811092658,"text":"The Shogun, for example, is one of my forms of existence. The question of whether or not she is me is not determined by any of her components.","nextNodeIds":[120170523]},{"nodeId":120170523,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4101853186,"text":"In that case, this picture is one of your forms of existence, too.","nextNodeIds":[120170524]},{"nodeId":120170524,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1811791842,"text":"Hmm. So even I, who seeks Eternity, am constantly changing my form of existence...","nextNodeIds":[120170525]},{"nodeId":120170525,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":3812602506,"text":"Then, how can I ask Inazuma and everyone who lives here to remain unchanging?","nextNodeIds":[120170526,120170527]},{"nodeId":120170526,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":852719290,"text":"Inazuma will always be Inazuma.","nextNodeIds":[120170528]},{"nodeId":120170528,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":3457812114,"text":"Everything I have encountered on this journey with you has been from beyond my existing sphere of knowledge.","nextNodeIds":[120170529]},{"nodeId":120170529,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":3739812314,"text":"*sigh* You've seen a lot of my ignorant side today. Maybe you can't tell, but all this has challenged my understanding of things.","nextNodeIds":[120170530]},{"nodeId":120170530,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":974905394,"text":"Based on what I have seen today, I am forced to accept that Inazuma is a completely different place from the one I remember.","nextNodeIds":[120170531]},{"nodeId":120170531,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":2114723418,"text":"But it would be incorrect to conclude from this that the Inazuma of today is no longer Inazuma.","nextNodeIds":[120170532]},{"nodeId":120170532,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2707872514,"text":"Right.","nextNodeIds":[120170533]},{"nodeId":120170533,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1025693650,"text":"Both the Vision Hunt Decree and the Statue of the Omnipresent God were conceived as a means of bringing about Eternity. But if I were really getting closer to Eternity, none of this ever would have happened.","nextNodeIds":[120170534]},{"nodeId":120170534,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":2455751266,"text":"Hmm...","nextNodeIds":[120170535]},{"nodeId":120170535,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1473106562,"text":"Perhaps... perhaps I've been holding on to everything too tightly.","nextNodeIds":[120170536]},{"nodeId":120170536,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":140359154,"text":"Sounds to Paimon like Ei's figured things out!","nextNodeIds":[120170537]},{"nodeId":120170537,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2668980314,"text":"And that means that we've done a really great job as her guides!","nextNodeIds":[120170538]},{"nodeId":120170538,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":2462339730,"text":"Master Kamaji! Master Kamaji!","nextNodeIds":[120170539]},{"nodeId":120170539,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1737493466,"text":"Hmm? Why's it getting so noisy down there?","nextNodeIds":[120170540]},{"nodeId":120170540,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4233528698,"text":"That sounded like Ippei. What could be the matter?","nextNodeIds":[120170541]},{"nodeId":120170541,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1309357642,"text":"Ippei? Is that someone from the Tenryou Commission?","nextNodeIds":[120170542]},{"nodeId":120170542,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2352794978,"text":"Yep. Let's find out what's going on.","nextNodeIds":[]},{"nodeId":120170527,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1921665162,"text":"Human beings will always be human.","nextNodeIds":[120170528]},{"nodeId":120170505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2142254290,"text":"It's not the real you.","nextNodeIds":[120170506]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1201705,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["12076"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1201706,"order":5,"stepDescription":"Follow the voice to see what's happening","stepDescTextMapHash":897343732,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1201706,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q12017Yiping1","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1201706,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q12017Yiping1","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1201707,"order":6,"stepDescription":"Talk to the hurried Ippei","stepDescTextMapHash":1615947948,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1201707,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["12077"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1201707],"talks":[{"talkId":1201707,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1201707","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1201707,"initDialog":120170701,"nextRandomTalks":[],"nextTalks":[],"npcId":[12077],"performCfg":"QuestDialogue/LQ/Shougun1_12017/Q1201707","priority":5,"questId":12017,"showRandomTalkCount":0},"dialogs":[{"nodeId":120170701,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3046968426,"text":"Hey, Ippei, what's the matter?","nextNodeIds":[120170702]},{"nodeId":120170702,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":659798354,"text":"Ah, it's you. I...","nextNodeIds":[120170703]},{"nodeId":120170703,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":2658531482,"text":"Huh? Th—The Almighty Shogun!?","nextNodeIds":[120170704]},{"nodeId":120170704,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":3999490042,"text":"You must be looking for my master, Kujou Kamaji? I'm very sorry, he's not here at the moment. But if it pleases you, I will gladly deliver a message on your behalf?","nextNodeIds":[120170705]},{"nodeId":120170705,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1540452578,"text":"It's okay, I'm not here to see him. We just heard you calling out, so we came to see what was going on.","nextNodeIds":[120170706]},{"nodeId":120170706,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3749516050,"text":"Are you looking for your master?","nextNodeIds":[120170707]},{"nodeId":120170707,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":1695957906,"text":"Yes. Master Kamaji still hasn't returned from the negotiations, and I'm starting to get worried.","nextNodeIds":[120170708]},{"nodeId":120170708,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":3501372082,"text":"In fairness, he does have a habit of taking long walks and coming back late. It's perfectly possible that he just found somewhere he likes and lost track of time.","nextNodeIds":[120170709]},{"nodeId":120170709,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":3031745874,"text":"But for some reason, today I'm particularly nervous.","nextNodeIds":[120170710]},{"nodeId":120170710,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":437512634,"text":"Kujou Kamaji... A descendant of the Kujou Clan, I presume.","nextNodeIds":[120170711]},{"nodeId":120170711,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":148295650,"text":"That's right. Apologies, since the head of the clan is in poor health at the moment, and Master Masahito is rarely home, Master Kamaji is currently serving as representative of the Kujou Clan.","nextNodeIds":[120170712]},{"nodeId":120170712,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1180886322,"text":"I have heard that things are quite tumultuous within the Tenryou Commission at present. Does this have anything to do with Kujou Kamaji?","nextNodeIds":[120170713]},{"nodeId":120170713,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":2084767322,"text":"Forgive us, Almighty Shogun. The Kujou Clan has failed in its duty.","nextNodeIds":[120170714]},{"nodeId":120170714,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":296854922,"text":"The Kujou Clan's reputation is damaged and its power over the Tenryou Commission is in decline. Plus you, um... ahem, you have yet to issue a verdict on the Commission's future...","nextNodeIds":[120170715]},{"nodeId":120170715,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":1910228234,"text":"So, Master Kamaji decided to enter negotiations with the Takatsukasa Clan with a view of having them take over...","nextNodeIds":[120170716]},{"nodeId":120170716,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":239381794,"text":"Surely they would be discussing something like that at their headquarters, right? Why are you looking for them here?","nextNodeIds":[120170717]},{"nodeId":120170717,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":1892184330,"text":"Actually, they decided to hold this one elsewhere. I'm a little confused as to why, to be honest, but I didn't feel it was my place to question the higher-ups.","nextNodeIds":[120170718]},{"nodeId":120170718,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":367501482,"text":"The meeting place is in the mountains near the Grand Narukami Shrine. I believe the Takatsukasa Clan have some kind of base there.","nextNodeIds":[120170719]},{"nodeId":120170719,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":225648050,"text":"Takatsukasa... another familiar name. They have been faithfully serving the Kujou Clan all these years?","nextNodeIds":[120170720]},{"nodeId":120170720,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":1490485146,"text":"Yes, yes. That's why Master Kamaji decided to discuss things with them. I understand they must have had a lot of ground to cover, but still, there's no way it should have gone on this long.","nextNodeIds":[120170721]},{"nodeId":120170721,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":820471322,"text":"I've searched all over the city. If he really hasn't returned yet, then...","nextNodeIds":[120170722,120170723]},{"nodeId":120170722,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":207019698,"text":"Maybe they haven't finished.","nextNodeIds":[120170724]},{"nodeId":120170724,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":3787469962,"text":"Yeah, I thought of that possibility too... but someone of my rank can't just go venturing into Takatsukasa Clan territory like that.","nextNodeIds":[120170725]},{"nodeId":120170725,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3246296530,"text":"We can go check things out for you.","nextNodeIds":[120170726]},{"nodeId":120170726,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":2763580026,"text":"No, no need. I'm probably just overthinking things. Besides, if they're still at it, they'll only blame me for interrupting the negotiations.","nextNodeIds":[120170727]},{"nodeId":120170727,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":445648330,"text":"I'm only a lowly servant, but Master Kamaji and I grew up together... It'd be terrible if anything ever happened to him.","nextNodeIds":[120170728]},{"nodeId":120170728,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":3976600138,"text":"I'm not as smart as Master, so I can't really share his burdens. But the last thing I'd want would be for him to come to harm when I could've done something about it.","nextNodeIds":[120170729]},{"nodeId":120170729,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":255628602,"text":"Hmm... what do you think, Almighty Shogun?","nextNodeIds":[120170730]},{"nodeId":120170730,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":222004226,"text":"Let's go see what's happening.","nextNodeIds":[120170731]},{"nodeId":120170731,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1398018634,"text":"With me present, they are unlikely to blame you even if we do happen to interrupt the negotiations.","nextNodeIds":[120170732]},{"nodeId":120170732,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":3985483378,"text":"Besides, this has only come about because I failed to make a timely decision. This issue started with me, and I shall be the one to finish it.","nextNodeIds":[120170733,120170734]},{"nodeId":120170733,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":683032042,"text":"That's commitment, right there.","nextNodeIds":[120170735]},{"nodeId":120170735,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":3403611626,"text":"Thank you so much, Shogun! I'll keep looking around in the meantime, too!","nextNodeIds":[120170736]},{"nodeId":120170736,"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","textMapHash":1050966322,"text":"Let me mark out the location of the base for you. I hope everything goes smoothly!","nextNodeIds":[]},{"nodeId":120170734,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2671168410,"text":"Awesome stuff.","nextNodeIds":[120170735]},{"nodeId":120170723,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3452609930,"text":"Maybe something's happened.","nextNodeIds":[120170724]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1201707,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["12077"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1201702,1201704,1201705,1201707,1201751],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","count":42},{"roleType":"TALK_ROLE_NPC","speakerId":12077,"speakerName":"Ippei","count":21},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":17}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[112017],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1603576566,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[12018],"GMENNHMBBOH":[],"HCJHEADFCAO":2025,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/LQ/Shougun1_12017/Q1201702","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":fa