lockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1201702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1201702,"initDialog":120170201,"nextRandomTalks":[],"nextTalks":[],"npcId":[12076],"performCfg":"QuestDialogue/LQ/Shougun1_12017/Q1201702","priority":5,"questId":12017,"showRandomTalkCount":0},"dialogs":[{"nodeId":120170201,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1673701746,"text":"So, uh, what are we supposed to be doing?","nextNodeIds":[120170202]},{"nodeId":120170202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":987447346,"text":"We're taking a photo of you. Just leave the hard work to us, all you need to do is stand over there and strike a pose.","nextNodeIds":[120170203]},{"nodeId":120170203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":920313594,"text":"Basically, a photo makes a visual record of you at this very moment in time, so it makes a great souvenir.","nextNodeIds":[120170204]},{"nodeId":120170204,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":2520759162,"text":"Okay, so what exactly is \"striking a pose\"?","nextNodeIds":[120170205]},{"nodeId":120170205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":334311938,"text":"The photo is a visual representation.","nextNodeIds":[120170206]},{"nodeId":120170206,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":2980379802,"text":"Ah, I see. So in other words, I need to do some sort of visually agreeable action in front of you, right?","nextNodeIds":[120170207]},{"nodeId":120170207,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1332385890,"text":"The more I think about it, the more embarrassing it seems.","nextNodeIds":[120170208]},{"nodeId":120170208,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":469165410,"text":"How should I pose? Help me out here. It should look good but not too over the top. This isn't coming naturally to me at all.","nextNodeIds":[120170209,120170211,120170213]},{"nodeId":120170209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3857065538,"text":"Try graceful and dignified.","nextNodeIds":[120170210]},{"nodeId":120170210,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1563208002,"text":"Okay... I'll try that.","nextNodeIds":[120170215,120170216]},{"nodeId":120170215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1830682626,"text":"That works.","nextNodeIds":[120170218]},{"nodeId":120170218,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1809893930,"text":"Okay, let's get started.","nextNodeIds":[120170219]},{"nodeId":120170219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":159124906,"text":"Let's pick a good angle to record this moment from.","nextNodeIds":[]},{"nodeId":120170216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":270712690,"text":"Maybe try another one.","nextNodeIds":[120170217]},{"nodeId":120170217,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":4151300874,"text":"Alright. Well, I'll leave the decision to you.","nextNodeIds":[120170208]},{"nodeId":120170211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3469683250,"text":"Try stern and serious.","nextNodeIds":[120170212]},{"nodeId":120170212,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":59108626,"text":"This doesn't feel very \"me.\" Is this okay?","nextNodeIds":[120170215,120170216]},{"nodeId":120170213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2962547130,"text":"Try relaxed and casual.","nextNodeIds":[120170214]},{"nodeId":120170214,"roleType":"TALK_ROLE_NPC","speakerId":12076,"speakerName":"Ei","textMapHash":1814883138,"text":"Casual... How about this? This feels quite natural.","nextNodeIds":[120170215,120170216]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1201702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"