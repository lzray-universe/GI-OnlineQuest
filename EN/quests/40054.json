{"mainQuestId":40054,"title":"Festive Elegance","description":"","titleTextMapHash":1682196567,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":40054,"titleTextMapHash":1682196567,"title":"Festive Elegance","descTextMapHash":4190636494,"description":"","chapterId":10065,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":2012,"luaPath":"Actor/Quest/EQ40054","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2012,"chapterId":10065,"descTextMapHash":4190636494,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":40054,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4098668089,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/EQ40054","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[140054],"series":10065,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[40055],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1682196567,"type":"EQ","unlockDescTextMapHash":1198574894}},"flow":[{"subQuestId":4005401,"order":1,"stepDescription":"Talk to Katheryne in Inazuma","stepDescTextMapHash":1334905012,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4005401],"talks":[{"talkId":4005401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4005401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4005401,"initDialog":400540101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3004],"performCfg":"QuestDialogue/EQ/RongCaiJi_40054/Q4005401","priority":5,"questId":40054,"showRandomTalkCount":0},"dialogs":[{"nodeId":400540101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3921443210,"text":"Hi Katheryne, we heard that you have a new commission for us?","nextNodeIds":[400540102]},{"nodeId":400540102,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":3834186130,"text":"That's correct. There's a requester who has submitted a designated commission for the two of you.","nextNodeIds":[400540103]},{"nodeId":400540103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1969957450,"text":"A designated commission? Sounds like it must be pretty important. Uh, what kind of task is it, exactly?","nextNodeIds":[400540104]},{"nodeId":400540104,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":136083970,"text":"Hehe, there's no need to worry. This commission is not dangerous by any means. Perhaps you have heard that Inazuma will soon be holding a major festival — the \"Magnificent Irodori Festival.\"","nextNodeIds":[400540105]},{"nodeId":400540105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2207086922,"text":"Yay! A festival! Come to think of it, we haven't attended a festival in Inazuma for a while.","nextNodeIds":[400540106]},{"nodeId":400540106,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":2708076274,"text":"The Yashiro Commission and Lady Yae are responsible for all the festival preparations. The one who has requested your help is none other than Lady Yae herself.","nextNodeIds":[400540107]},{"nodeId":400540107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4285394274,"text":"Oh, so it's Miko's commission.","nextNodeIds":[400540108]},{"nodeId":400540108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3134581866,"text":"Hehe, you know Miko... She always has some unusual ideas in her head. You can bet a festival planned by her is gonna be one to remember.","nextNodeIds":[400540109]},{"nodeId":400540109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1748482650,"text":"We'd better go to Grand Narukami Shrine and see what she needs us to do.","nextNodeIds":[400540110]},{"nodeId":400540110,"roleType":"TALK_ROLE_NPC","speakerId":3004,"speakerName":"Katheryne","textMapHash":518639442,"text":"Lady Yae is currently at Yae Publishing House in Hanamizaka, so there's no need to go all the way to the shrine. In fact, she has instructed me to have you directly meet with her there.","nextNodeIds":[400540111]},{"nodeId":400540111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2345013922,"text":"Oh, well that's convenient enough. Let's go then!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4005402,"order":2,"stepDescription":"Go to Yae Publishing House to look for Yae Miko","stepDescTextMapHash":2893151436,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1034"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4005402],"talks":[{"talkId":4005402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4005402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4005402,"initDialog":400540201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1034],"performCfg":"QuestDialogue/EQ/RongCaiJi_40054/Q4005402","priority":5,"questId":40054,"showRandomTalkCount":0},"dialogs":[{"nodeId":400540201,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":245851530,"text":"Aratani and Kuroda, how are things coming along?","nextNodeIds":[400540202]},{"nodeId":400540202,"roleType":"TALK_ROLE_NPC","speakerId":3030,"speakerName":"Aratani","textMapHash":782630114,"text":"All the books and commissioned prints for Yae Publishing House were bound and sent out yesterday afternoon, Lady Yae.","nextNodeIds":[400540203]},{"nodeId":400540203,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3020103930,"text":"Very good. And Murata?","nextNodeIds":[400540204]},{"nodeId":400540204,"roleType":"TALK_ROLE_NPC","speakerId":3190,"speakerName":"Murata","textMapHash":660872826,"text":"We have already received word from Eipekkusu and Sailing Breeze that the materials are all in place for \"Shogun Almighty: Reborn as Raiden With Unlimited Power\" and \"Pretty Please, Kitsune Guuji?\"!","nextNodeIds":[400540205]},{"nodeId":400540205,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1365246962,"text":"Well done. And what about you, Onodera?","nextNodeIds":[400540206]},{"nodeId":400540206,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":328514186,"text":"...","nextNodeIds":[400540207]},{"nodeId":400540207,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2736613298,"text":"Ahem. O—no—de—ra?","nextNodeIds":[400540208]},{"nodeId":400540208,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":3646867210,"text":"Oh, uh, yes Lady Yae! Everything is ready for the new issue release party.","nextNodeIds":[400540209]},{"nodeId":400540209,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":4274771538,"text":"You are the one who organized the plans for this release party. In other words, you are the team's fearless leader now. So please, show some confidence.","nextNodeIds":[400540210]},{"nodeId":400540210,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1642581234,"text":"Besides, there's no need to be nervous. This project is destined for success, I feel quite optimistic about it.","nextNodeIds":[400540211]},{"nodeId":400540211,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2224912538,"text":"I shall specially grant you leave for the next couple of days, Onodera. Please take the opportunity to have a good rest. After all, you will be very busy on the day of the release party.","nextNodeIds":[400540212]},{"nodeId":400540212,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"Onodera","textMapHash":948033802,"text":"Yes, Lady Yae. Thank you very much!","nextNodeIds":[400540213]},{"nodeId":400540213,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3607867186,"text":"Alright then, is everyone clear about their assignments? Good. We are running out of time, so let's get moving! Chop chop!","nextNodeIds":[400540215]},{"nodeId":400540215,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1272457674,"text":"Ah, hello little ones. I take it you have received my commission, hmm?","nextNodeIds":[400540216]},{"nodeId":400540216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1222328290,"text":"Some organizer you are! It's nearly time for the festival and you're still over here ramping things up for your light novel business! Shouldn't you be getting back to the Grand Narukami Shrine?","nextNodeIds":[400540217]},{"nodeId":400540217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4285083162,"text":"You weren't thinking of dumping all the festival preparations on us, were you? Hmph, if so, then you can forget it, Paimon won't accept such a commission!","nextNodeIds":[400540218]},{"nodeId":400540218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1393220202,"text":"Yeah, forget it!","nextNodeIds":[400540219]},{"nodeId":400540219,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":310314314,"text":"My my, such harsh words... It hurts to hear that kind of talk from you two. But, as you can clearly see, I'm here working like a dog for the festival, yet you say I'm not doing my job.","nextNodeIds":[400540220]},{"nodeId":400540220,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3656510186,"text":"Let me ask you, little ones, who ever said that the festival must involve the Grand Narukami Shrine?","nextNodeIds":[400540221]},{"nodeId":400540221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1063826314,"text":"Huh? But isn't that a given? This is Inazuma, after all.","nextNodeIds":[400540222]},{"nodeId":400540222,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":4255077210,"text":"Yes, that is true. But now that the Sakoku Decree has been lifted, Inazuma is no longer the same nation that once resisted change tooth and nail.","nextNodeIds":[400540223]},{"nodeId":400540223,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3499272194,"text":"Therefore, rather than sticking to the same old traditional festival, the Yashiro Commission and I have decided to shake things up a little... This time, we'll be holding an international cultural festival, distinctly Inazuman but with a unique twist.","nextNodeIds":[400540224,400540225]},{"nodeId":400540224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":518788234,"text":"International...","nextNodeIds":[400540226]},{"nodeId":400540226,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3664017834,"text":"Hehe, I suppose I should start by telling you the origins of the Irodori Festival.","nextNodeIds":[400540227]},{"nodeId":400540227,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":4204903346,"text":"Legend has it that there were five poets in ancient Inazuma who were supremely gifted in singing and writing poetry. They are known as \"The Five Kasen.\"","nextNodeIds":[400540228]},{"nodeId":400540228,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3621673770,"text":"Every year, one of the five would present a collection of the group's poems to the Shogun for review, which would then spark cultured discussions regarding those works.","nextNodeIds":[400540229]},{"nodeId":400540229,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3435063138,"text":"Thanks to them, Inazuma's culture blossomed and gained great influence at that time.","nextNodeIds":[400540230]},{"nodeId":400540230,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1550035322,"text":"As time passed, people began creating various tales based on The Five Kasen. The Irodori Festival was also developed as a result to show appreciation for their works which so greatly enriched our lives.","nextNodeIds":[400540231]},{"nodeId":400540231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4147250370,"text":"Sounds like a festival that's really rooted in culture.","nextNodeIds":[400540232]},{"nodeId":400540232,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1340401754,"text":"Indeed, to describe it in the words of the ancients, it'd be \"refined elegance.\" Unfortunately, with the flow of time, people have gradually forgotten about The Five Kasen and the festival.","nextNodeIds":[400540233]},{"nodeId":400540233,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3490308634,"text":"Which is precisely why I've decided to revive the Irodori Festival by...","nextNodeIds":[400540234]},{"nodeId":400540234,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2988397234,"text":"Holding a cultural convention featuring light novels!","nextNodeIds":[400540235]},{"nodeId":400540235,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1398896482,"text":"Wa—Wait a minute... light novels!?","nextNodeIds":[400540236]},{"nodeId":400540236,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2225608738,"text":"What about all that \"refined elegance\" stuff you just said?","nextNodeIds":[400540237]},{"nodeId":400540237,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2677120018,"text":"Please stop looking at me with those baffled expressions. In ancient times, poetry was all the rage. But nowadays, the entertainment format of choice is light novels.","nextNodeIds":[400540238]},{"nodeId":400540238,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":1746710842,"text":"The important thing is not the format but the creative work itself. It is impossible to come up with anything fresh if you're stuck using some rigid format of the past.","nextNodeIds":[400540239]},{"nodeId":400540239,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2255789138,"text":"Speaking of which, don't you think that the concept of \"focusing on the now\" perfectly suits the current Inazuma?","nextNodeIds":[400540240]},{"nodeId":400540240,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2598197474,"text":"And besides, it's a great opportunity to reintroduce Inazuma to all Teyvat through light novels. As they say, it's two birds with one stone.","nextNodeIds":[400540241,400540242]},{"nodeId":400540241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3255414434,"text":"Sounds like...","nextNodeIds":[400540243]},{"nodeId":400540243,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3504178634,"text":"Whoa, that was close... Paimon was nearly carried away by Miko's persuasive tongue.","nextNodeIds":[400540244]},{"nodeId":400540244,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1071731866,"text":"C'mon Miko, you can't fool us! We know you by now, this is all definitely stemming from your own personal interests!","nextNodeIds":[400540245]},{"nodeId":400540245,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3639658074,"text":"Haha, I can't deny that my hobbies had no part to play in this. However, regardless of whether it's light novels or a festival, catching people's attention with a fresh concept is the essence here.","nextNodeIds":[400540246]},{"nodeId":400540246,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3993336082,"text":"Well, what do you say? Aren't you two even a little curious about what interesting things you might see at the festival?","nextNodeIds":[400540247]},{"nodeId":400540247,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3712709762,"text":"Uh, maybe a little... Ah alright, Paimon's super curious now!","nextNodeIds":[400540248]},{"nodeId":400540248,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":4266558890,"text":"Hehe. Come, let's pay a visit to the venue in Ritou together. I promise that it will give you a whole new perspective on the festival.","nextNodeIds":[400540249]},{"nodeId":400540249,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2285382730,"text":"There we'll meet a special someone who will tell you more about your tasks.","nextNodeIds":[]},{"nodeId":400540242,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3800830786,"text":"A whole lot of thinly veiled self-justifications?","nextNodeIds":[400540243]},{"nodeId":400540225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":229084402,"text":"Cultural festival?","nextNodeIds":[400540226]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1034"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4005403,"order":3,"stepDescription":"Go to the Irodori Festival site on Ritou","stepDescTextMapHash":1011304524,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005403,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q4005403_guide_WuGeXianGuangChang","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005403,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["Q4005403_guide_WuGeXianGuangChang","10"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4005404,"order":4,"stepDescription":"Talk to Yae Miko","stepDescTextMapHash":1832405372,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1034"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4005403],"talks":[{"talkId":4005403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4005404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4005403,"initDialog":400540301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1034],"performCfg":"QuestDialogue/EQ/RongCaiJi_40054/Q4005403","priority":5,"questId":40054,"showRandomTalkCount":0},"dialogs":[{"nodeId":400540301,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":4268631170,"text":"During the Irodori Festival, the area around the Outlander Affairs Agency will become the main exhibition space for light novels.","nextNodeIds":[400540302]},{"nodeId":400540302,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":434713242,"text":"Once things are in full swing, not only will there be lots of official and fan-created work on display, there'll also be exclusive giveaways, prizes, and new release parties.","nextNodeIds":[400540303]},{"nodeId":400540303,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3176260042,"text":"This small plaza in front of the International Trade Association will be called \"The Five Kasen Plaza\" during the festival, and nearby shops will be selling special light novel merchandise. You certainly won't want to miss out.","nextNodeIds":[400540304]},{"nodeId":400540304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":982343738,"text":"Wow, how should Paimon put this... It's definitely not your typical festival, but it sure looks like it'll be quite the party!","nextNodeIds":[400540305]},{"nodeId":400540305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1410339778,"text":"Yeah, it's like a light novel paradise.","nextNodeIds":[400540306]},{"nodeId":400540306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3584716570,"text":"Huh? Uh, Miko, what are these blank boards in the center of the plaza?","nextNodeIds":[400540307]},{"nodeId":400540307,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":249714970,"text":"Yes, those are—","nextNodeIds":[400540308]},{"nodeId":400540308,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":1310376042,"text":"Ah, Lady Yae did mention that there would be some reliable helpers coming to assist with the festivities. It appears she meant you two.","nextNodeIds":[400540309]},{"nodeId":400540309,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":1542535570,"text":"At last, we meet again, Traveler and Paimon. Tell me, how are you faring recently?","nextNodeIds":[400540310]},{"nodeId":400540310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2764354826,"text":"Oh, it's Ayato! Wow, so even a busy guy like yourself is here to attend the Irodori Festival.","nextNodeIds":[400540311]},{"nodeId":400540311,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":826495394,"text":"Preparing festivals falls under the Yashiro Commission's scope of responsibilities. Seeing as Lady Yae has poured her heart and soul into the preparations, I'm obliged to be equally dedicated.","nextNodeIds":[400540312]},{"nodeId":400540312,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":908683370,"text":"Hehe. Come now Ayato, we're not strangers here. There's no need to sound so formal.","nextNodeIds":[400540313]},{"nodeId":400540313,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":780804690,"text":"We were just about to discuss the boards over here. They're related to our little helpers' tasks, so I'll let you give them a detailed rundown.","nextNodeIds":[400540314]},{"nodeId":400540314,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":468671858,"text":"Certainly. I assume you two already know that the Irodori Festival originated from The Five Kasen. These five boards are here for painting their portraits.","nextNodeIds":[400540315]},{"nodeId":400540315,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":4097888466,"text":"This Irodori Festival is not only the first major festival to be held in Inazuma since the lifting of the Sakoku Decree, it is also an event deeply rooted in culture and the arts.","nextNodeIds":[400540316]},{"nodeId":400540316,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":1187697906,"text":"Therefore, the Yashiro Commission has personally invited several cultural celebrities from other nations.","nextNodeIds":[400540317]},{"nodeId":400540317,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":682256946,"text":"For example, the artist we have invited to paint these portraits hails from the distant land of Mondstadt.","nextNodeIds":[400540318]},{"nodeId":400540318,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":969949186,"text":"The Yashiro Commission will arrange accommodations and food in Inazuma for each of the distinguished guests. However, we fear that staying in a foreign land may feel a little uncomfortable.","nextNodeIds":[400540319]},{"nodeId":400540319,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":1661642178,"text":"Which is precisely why it would be ideal to have someone familiar with both Inazuma and other nations of Teyvat to serve as a guide for our guests.","nextNodeIds":[400540320,400540321]},{"nodeId":400540320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3141664002,"text":"I get it now.","nextNodeIds":[400540322]},{"nodeId":400540322,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":1856404770,"text":"I knew you would catch on. It is our hope that you would be able to guide the guests from the harbor to their residence at the International Trade Association while providing any necessary assistance along the way.","nextNodeIds":[400540323]},{"nodeId":400540323,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":3995899458,"text":"This Arrival Schedule includes the details of the ships on which the guests will be arriving. All you simply have to do is go to the docks at the indicated times.","nextNodeIds":[400540324]},{"nodeId":400540324,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":455615626,"text":"It's settled then. My, look at the time. I have to meet with my editors, so I must be going now.","nextNodeIds":[400540325]},{"nodeId":400540325,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":4132222618,"text":"During the festival, most of the Yae Publishing House's editors will be staying near the Outlander Affairs Agency. If you run into any problems, you may find them there.","nextNodeIds":[400540326]},{"nodeId":400540326,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"Kamisato Ayato","textMapHash":739612618,"text":"This festival requires the full cooperation of the Tri-Commission, and there are still many minor details which require my attention, so I must excuse myself for now. I'll leave the guests in your hands.","nextNodeIds":[]},{"nodeId":400540321,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1756656546,"text":"So this is our commission.","nextNodeIds":[400540322]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLP