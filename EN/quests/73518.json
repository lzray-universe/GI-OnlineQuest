"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351801,"initDialog":735180101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342,30343],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351801","priority":5,"questId":73518,"showRandomTalkCount":0},"dialogs":[{"nodeId":735180101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":983713002,"text":"Sure enough, the charging unit is running more smoothly... As you said, the elemental environment in this area is returning to normal.","nextNodeIds":[735180102]},{"nodeId":735180102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3945650298,"text":"...The activity of affected Wenut will calm down after some time, too.","nextNodeIds":[735180103]},{"nodeId":735180103,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2507896258,"text":"Yeah, yeah... Thanks to your precious Wenutslayer Cannon, we can report back our success and go home.","nextNodeIds":[735180104]},{"nodeId":735180104,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":4112677538,"text":"It's OUR precious Wenutslayer Cannon, Shriya. I never forgot that this assignment was a joint effort.","nextNodeIds":[735180105]},{"nodeId":735180105,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3046592610,"text":"...We definitely had our share of disagreements, but without you, the cannon wouldn't have been a success.","nextNodeIds":[735180106]},{"nodeId":735180106,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1005053306,"text":"What's... gotten into you? Is this about wanting me to put in a good word for you in my report?","nextNodeIds":[735180107]},{"nodeId":735180107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":585497386,"text":"Well, I just suddenly feel that what we went through just now is quite similar to our experience from that other year: it wasn't always smooth sailing, but we still made it in the end.","nextNodeIds":[735180108]},{"nodeId":735180108,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2845327746,"text":"And let's face it. In the end, your solution proved more efficient.","nextNodeIds":[735180109]},{"nodeId":735180109,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":991744002,"text":"I... uh... I can't take all the credit...","nextNodeIds":[735180110]},{"nodeId":735180110,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2335264754,"text":"...Because you were onto something, too. If you hadn't tested the Wenutslayer Cannon, I wouldn't have obtained the necessary data...","nextNodeIds":[735180111]},{"nodeId":735180111,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":2019555066,"text":"\"To fix a machine you may only need to replace one gear, but the true challenge is finding that gear...\" These words from my mentor are beginning to make sense to me.","nextNodeIds":[735180112]},{"nodeId":735180112,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":1728656210,"text":"I'm so glad you're here, Shriya.","nextNodeIds":[735180113]},{"nodeId":735180113,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":2923725634,"text":"Uh... I'm glad you're here, too...","nextNodeIds":[735180114]},{"nodeId":735180114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3239779970,"text":"Huh? The atmosphere between these two became so different all of a sudden...","nextNodeIds":[735180115,735180116]},{"nodeId":735180115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1373905178,"text":"Paimon...","nextNodeIds":[735180117]},{"nodeId":735180117,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1123578698,"text":"Ahem! When we were cooperating on our graduation project, our relationship was rather rocky because we weren't very mature.","nextNodeIds":[735180118]},{"nodeId":735180118,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","textMapHash":3686876458,"text":"Yeah. Looking back on it, it wasn't anything too serious...","nextNodeIds":[735180119]},{"nodeId":735180119,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","textMapHash":1283182338,"text":"Well... How about meeting at the café for a drink next time? We could discuss how to write the report.","nextNodeIds":[]},{"nodeId":735180116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3788603058,"text":"Just leave it.","nextNodeIds":[735180117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"Vinayak","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"Shriya","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":2},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173518],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1755825726,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/V3.6SandSworm/Q7351801","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":735180101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7351801