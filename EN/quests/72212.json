eTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7221204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7221203,"initDialog":722120301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20455,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72212/Q7221203","priority":5,"questId":72212,"showRandomTalkCount":0},"dialogs":[{"nodeId":722120301,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":3798557954,"text":"*sigh* When will I be able to find some work...","nextNodeIds":[722120302]},{"nodeId":722120302,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":1605220386,"text":"Are you looking for me? What is this about?","nextNodeIds":[722120303,722120304]},{"nodeId":722120303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2861882370,"text":"Do you know how to make stone carvings?","nextNodeIds":[722120305]},{"nodeId":722120305,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":2090800202,"text":"Eh? Well... Well then, that's great!","nextNodeIds":[722120306]},{"nodeId":722120306,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":2433378562,"text":"Wait, sorry, I forgot to introduce myself. I'm Ooshima Junpei, and I used to work at Tatarasuna.","nextNodeIds":[722120307]},{"nodeId":722120307,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":1001125138,"text":"After that accident, we were all evacuated.","nextNodeIds":[722120308]},{"nodeId":722120308,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":2522482226,"text":"But till now, I haven't received any notice that we might be returning to work, so I've been idle here this whole time.","nextNodeIds":[722120309]},{"nodeId":722120309,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":2731112714,"text":"So you're looking for someone who can do some stone carving, right? Well, that's not my specialty per se, but I do have some skill in it...","nextNodeIds":[722120310]},{"nodeId":722120310,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":3076586178,"text":"What sort of stone carving do you need made? Could you tell me?","nextNodeIds":[722120311]},{"nodeId":722120311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3897604130,"text":"Well, here's the situation...","nextNodeIds":[722120312]},{"nodeId":722120312,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":2312554682,"text":"Uh... So, let me get this straight. A talking cat wants you to find a craftsman to make a carved statue of it?","nextNodeIds":[722120313]},{"nodeId":722120313,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":314861050,"text":"It's not like I don't believe you or anything. It's just a bit... You know, outrageous...","nextNodeIds":[722120314]},{"nodeId":722120314,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":956767498,"text":"And even if I agreed, how is that... that provisional head priestess supposed to pay me? I'm not going to work for free, no matter what anyone says.","nextNodeIds":[722120315]},{"nodeId":722120315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1250574338,"text":"Relax, it'll be fine.","nextNodeIds":[722120316]},{"nodeId":722120316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1945987138,"text":"(...Will it really, though...)","nextNodeIds":[722120317]},{"nodeId":722120317,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":925310146,"text":"Will it? I... Hmm, it just feels like you're swindling me...","nextNodeIds":[722120318]},{"nodeId":722120318,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":133772634,"text":"Still... You know what? Never mind. I'm a pair of idle hands anyway. Might as well go with you to have a look.","nextNodeIds":[722120319]},{"nodeId":722120319,"roleType":"TALK_ROLE_NPC","speakerId":20455,"speakerName":"???","textMapHash":3588567506,"text":"I really hope that I can get paid...","nextNodeIds":[]},{"nodeId":722120304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1292733858,"text":"We're looking for an artisan who can work with stone.","nextNodeIds":[722120305]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["20455"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7221205,"order":5,"stepDescription":"Report back to Neko together with Ooshima Junpei","stepDescTextMapHash":2224707700,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3189"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7221204,7221206],"talks":[{"talkId":7221204,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7221205","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7221204,"initDialog":722120401,"nextRandomTalks":[],"nextTalks":[7221206],"npcId":[3189,3182,1005],"performCfg":"QuestDialogue/WQ/Inazuma_72212/Q7221204","priority":5,"questId":72212,"showRandomTalkCount":0},"dialogs":[{"nodeId":722120401,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1856880530,"text":"Ah, you have returned. This human must be the stone human, yes?","nextNodeIds":[722120402,722120403]},{"nodeId":722120402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3598427362,"text":"This is the artisan we hired.","nextNodeIds":[722120404]},{"nodeId":722120404,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3649391986,"text":"...What!? The cat... it really can talk!","nextNodeIds":[722120405]},{"nodeId":722120405,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3635958282,"text":"Meow meow meow, such ado about nothing... Is it so strange that I speak?","nextNodeIds":[722120406,722120407]},{"nodeId":722120406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1894468794,"text":"No need to make a fuss.","nextNodeIds":[722120408]},{"nodeId":722120408,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3751586322,"text":"Wait. Are you saying that this is something super normal for you!?","nextNodeIds":[722120409]},{"nodeId":722120409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":960187722,"text":"That certainly has been the case so far.","nextNodeIds":[722120410]},{"nodeId":722120410,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":88589042,"text":"What in the world have you experienced...","nextNodeIds":[722120411]},{"nodeId":722120411,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3658269514,"text":"Come now, we are not here to merely talk.","nextNodeIds":[722120412]},{"nodeId":722120412,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":890330042,"text":"Back to our main point. Stone human, can you knock on stone and cause it to look like me?","nextNodeIds":[722120413]},{"nodeId":722120413,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3913561954,"text":"Eh? Stone human? You mean me?","nextNodeIds":[722120414]},{"nodeId":722120414,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3909415378,"text":"\"Knock on stone,\" you say... Well, I can give stone-working a go...","nextNodeIds":[722120415]},{"nodeId":722120415,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3333902082,"text":"Is that so? Wonderful, meow meow meow.","nextNodeIds":[722120416]},{"nodeId":722120416,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":870110442,"text":"S—So this is how it is, huh... Well, having a job is better than nothing. I mean, I've never worked for a cat before, so... I guess we'll just discuss my salary later?","nextNodeIds":[722120417]},{"nodeId":722120417,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3910698034,"text":"Hmm. Either way, I'll need to make some preparations. There are quite a few rocks here on this island. I'll need to pick a good one.","nextNodeIds":[722120418]},{"nodeId":722120418,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":3192889418,"text":"Ah, yes. How should I address you?","nextNodeIds":[722120419]},{"nodeId":722120419,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3126812514,"text":"I am the Neko, the provisional head priestess of the Asase Shrine.","nextNodeIds":[722120420]},{"nodeId":722120420,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":1600867986,"text":"As to terms of address, you may call me whatever you please, tall, stone-knocking human.","nextNodeIds":[722120421]},{"nodeId":722120421,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1273592194,"text":"Is that so? Well then, I suppose I shall call you Lady Priestess. You are my employer, after all.","nextNodeIds":[722120422]},{"nodeId":722120422,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":909454842,"text":"...What is an \"envoyer\"?","nextNodeIds":[722120423]},{"nodeId":722120423,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":1405630474,"text":"...","nextNodeIds":[722120424]},{"nodeId":722120424,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":356792034,"text":"W—Well, I'll go look around and pick a rock to use, then. You all just stay here for now.","nextNodeIds":[722120425]},{"nodeId":722120425,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"Ooshima Junpei","textMapHash":436555586,"text":"Working for a cat. Well, that's a first...","nextNodeIds":[722120426]},{"nodeId":722120426,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2168035138,"text":"Mr. Ooshima seems to have forgotten all about that payment.","nextNodeIds":[]},{"nodeId":722120407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2373865242,"text":"It's just a talking cat.","nextNodeIds":[722120408]},{"nodeId":722120403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3591108538,"text":"Yes, the stone human.","nextNodeIds":[722120404]}]},{"talkId":7221206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7221205","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7221206,"initDialog":722120601,"nextRandomTalks":[],"nextTalks":[],"npcId":[3189],"performCfg":"","priority":4,"questId":72212,"showRandomTalkCount":0},"dialogs":[{"nodeId":722120601,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3404520162,"text":"Still, I am curious. How will a thing as hard as stone take on my countenance?","nextNodeIds":[722120602]},{"nodeId":722120602,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":3510622194,"text":"Is that stone human very powerful? Can he use some magic?","nextNodeIds":[722120603,722120605]},{"nodeId":722120603,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":251874714,"text":"Oh, he's super powerful.","nextNodeIds":[722120604]},{"nodeId":722120604,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":2586657066,"text":"Ah, I understand. Lovely!","nextNodeIds":[]},{"nodeId":722120605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2152650258,"text":"It's like that time with the meal we made...","nextNodeIds":[722120606]},{"nodeId":722120606,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":128876666,"text":"Ah, I understand. The meals you and Hibiki made were all good things. The stone that the stone human will make must then also be a good thing.","nextNodeIds":[722120607]},{"nodeId":722120607,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","textMapHash":4210437042,"text":"Humans can be quite skilled sometimes, it seems. You have my thanks.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3189"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7221201,7221202,7221203,7221204,7221205,7221206],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"Neko","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speake