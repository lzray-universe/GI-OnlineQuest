estDialogue/WQ/Inazuma_72212/Q7221202","priority":5,"questId":72212,"showRandomTalkCount":0},"dialogs":[{"nodeId":722120201,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":3625374978,"text":"Ah, hello there. What are you busy with today?","nextNodeIds":[722120202]},{"nodeId":722120202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3514030722,"text":"Helping Neko make a statue.","nextNodeIds":[722120203]},{"nodeId":722120203,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":1838303050,"text":"Uh... What? A statue, here? Really?","nextNodeIds":[722120204]},{"nodeId":722120204,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":4240700578,"text":"I—I'll pick up carving immediately!","nextNodeIds":[722120205]},{"nodeId":722120205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1853239594,"text":"I doubt you'll make it in time...","nextNodeIds":[722120206]},{"nodeId":722120206,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":228319978,"text":"Hmm, is this another one of Neko's requests?","nextNodeIds":[722120207]},{"nodeId":722120207,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1211333322,"text":"You know what, I don't think it'll be that hard to find craftsmen looking for work, what with the issues we've been having in Tatarasuna.","nextNodeIds":[722120208]},{"nodeId":722120208,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3217092090,"text":"The Guild's received quite a few commissions related to this, and I've heard that some people are still in Tatarasuna looking for work.","nextNodeIds":[722120209]},{"nodeId":722120209,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":4127015042,"text":"I encountered just such an encampment while on a commission.","nextNodeIds":[722120210]},{"nodeId":722120210,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":351634258,"text":"So if you want, you can try your luck there.","nextNodeIds":[722120211,722120212]},{"nodeId":722120211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2833534898,"text":"Thank you.","nextNodeIds":[722120214]},{"nodeId":722120214,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1522510322,"text":"Heh, don't pay it any mind. It wasn't that hard.","nextNodeIds":[722120215]},{"nodeId":722120215,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3357138474,"text":"And you know what? I'd like to see what might happen if that shrine really does thrive again...","nextNodeIds":[722120216]},{"nodeId":722120216,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":3963832354,"text":"Especially that \"Hibiki\" Neko keeps talking about. What sort of person could be so beloved by that cat?","nextNodeIds":[722120217]},{"nodeId":722120217,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1984924106,"text":"Alright, don't worry, I'm just talking to myself. Go look for that artisan.","nextNodeIds":[722120218]},{"nodeId":722120218,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1718545730,"text":"As for whether they know how to carve rock or not... Well, I guess that's up to luck, eh?","nextNodeIds":[722120219]},{"nodeId":722120219,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":2075330250,"text":"Come on, Miss Etsuko, you just want to help Lady Neko as well, don't you? Haha, you're such a—","nextNodeIds":[722120220]},{"nodeId":722120220,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":1559382626,"text":"Taisuke, is our survey plan ready yet?","nextNodeIds":[722120221]},{"nodeId":722120221,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"Taisuke","textMapHash":3211466946,"text":"Uh, I—I'm almost done. Sorry...","nextNodeIds":[]},{"nodeId":722120212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3634892546,"text":"You don't seem like your usual self, Etsuko.","nextNodeIds":[722120213]},{"nodeId":722120213,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"Etsuko","textMapHash":793012346,"text":"What, not used to me giving you information first?","nextNodeIds":[722120214]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["3181"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7221203,"order":3,"stepDescription":"Go to Tatarasuna to look for an artisan","stepDescTextMapHash":276295868,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221203,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["WQ72212_Dadao01","60"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7221203,0],"PAINLIBBLDK":"QUEST_CONTENT_FIN