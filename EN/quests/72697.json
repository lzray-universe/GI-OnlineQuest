EST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30187"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7269701],"talks":[{"talkId":7269701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7269701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7269701,"initDialog":726970101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30187],"performCfg":"QuestDialogue/WQ/Inazuma_72697/Q7269701","priority":5,"questId":72697,"showRandomTalkCount":0},"dialogs":[{"nodeId":726970101,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2645266858,"text":"#Hah, {NICKNAME} and Paimon. You've arrived!","nextNodeIds":[726970102]},{"nodeId":726970102,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":4055528762,"text":"My Toy Factory shall soon be open!","nextNodeIds":[726970103]},{"nodeId":726970103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3278050314,"text":"Toy Factory?","nextNodeIds":[726970104]},{"nodeId":726970104,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":4065150130,"text":"*coughs* Well, I mean, it's just me and my Great Machine at the moment.","nextNodeIds":[726970105]},{"nodeId":726970105,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3576093562,"text":"So, I streamlined the Machine's processes. Now, production should take a lot less time.","nextNodeIds":[726970106]},{"nodeId":726970106,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":548329818,"text":"Of course, we're not talking about \"instantaneous\" levels of speed, but I would at least rate it at \"rapid.\"","nextNodeIds":[726970107]},{"nodeId":726970107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3050257098,"text":"Wow, that sounds impressive.","nextNodeIds":[726970108]},{"nodeId":726970108,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3997393402,"text":"Speaking of which, I made some improvements to the Material Collector as well.","nextNodeIds":[726970109]},{"nodeId":726970109,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2532383394,"text":"Previously, you'd need to come back here after each process.","nextNodeIds":[726970110]},{"nodeId":726970110,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3977057386,"text":"I thought that was inefficient, so I made some adjustments, and now it updates the current process based on your collection progress.","nextNodeIds":[726970111]},{"nodeId":726970111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1173966226,"text":"So it changes the process...","nextNodeIds":[726970112]},{"nodeId":726970112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2571801362,"text":"...based on what we've collected?","nextNodeIds":[726970113]},{"nodeId":726970113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3825746602,"text":"I'm confused...","nextNodeIds":[726970114]},{"nodeId":726970114,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":106617810,"text":"Hmm, how should I put this?","nextNodeIds":[726970115]},{"nodeId":726970115,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3923585290,"text":"Let's say that the first process requires 10 Sunsettias, the second needs Hydro and the third will see you defeating 2 Hydro Slimes.","nextNodeIds":[726970116]},{"nodeId":726970116,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":4244243306,"text":"And let's say that now you've collected 10 Sunsettias with the Material Collector equipped. Well, in that case, it will consider the materials for the first process collected in full.","nextNodeIds":[726970117]},{"nodeId":726970117,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3417636234,"text":"And then it will...","nextNodeIds":[726970118]},{"nodeId":726970118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":50885818,"text":"Ooh, and then it will automatically start the process of collecting materials for the next stage!","nextNodeIds":[726970119]},{"nodeId":726970119,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3196614954,"text":"Bingo! It will enter Elemental Charge mode, which will let it collect Hydro energy. And once it finishes collecting Hydro, it will change processes again.","nextNodeIds":[726970120,726970121]},{"nodeId":726970120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4047245346,"text":"It will go on to the third process...","nextNodeIds":[726970122]},{"nodeId":726970122,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1960230298,"text":"Yep, and all you will have to do once that happens is to defeat 2 Hydro Slimes.","nextNodeIds":[726970123]},{"nodeId":726970123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1028062154,"text":"That does sound a lot more convenient.","nextNodeIds":[726970124]},{"nodeId":726970124,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":461532626,"text":"Tell me about it. I pulled an all-nighter to improve it, you know? I personally call it the ultimate foolproof three-in-one...","nextNodeIds":[726970125]},{"nodeId":726970125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1163121338,"text":"Huh. This Material Collector is truly amazing.","nextNodeIds":[726970126]},{"nodeId":726970126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3535965130,"text":"Indeed.","nextNodeIds":[726970127]},{"nodeId":726970127,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3173052482,"text":"Heh...","nextNodeIds":[726970128]},{"nodeId":726970128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2315856914,"text":"Why would you give this Material Collector to us, though?","nextNodeIds":[726970129]},{"nodeId":726970129,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":4277476946,"text":"Hehe, I'm temporarily grounded in Ritou... So I can't collect materials at the moment.","nextNodeIds":[726970130]},{"nodeId":726970130,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3041910210,"text":"Come on, help me out here. You can have a bit of the Mora from selling toys and one of the toys for free!","nextNodeIds":[726970141]},{"nodeId":726970141,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2818269002,"text":"Remember the ticket you got? Hehe, well, it can get you one free redemption...","nextNodeIds":[726970142]},{"nodeId":726970142,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":402956314,"text":"Well, as long as you've already created that particular toy model, of course.","nextNodeIds":[726970131]},{"nodeId":726970131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":522856234,"text":"Excuse me? You mean with all the materials we collected and all the effort we put in, we only deserve a bit of the Mora and one toy?","nextNodeIds":[726970132]},{"nodeId":726970132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2257768858,"text":"#That's preposterous! Let's get outta here, {NICKNAME}!","nextNodeIds":[726970133]},{"nodeId":726970133,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":694882538,"text":"Wait... How about a bigger share of the profits and two... maybe three toys?","nextNodeIds":[726970134]},{"nodeId":726970134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4292510474,"text":"OK, that's it. Let's go, Paimon.","nextNodeIds":[726970135]},{"nodeId":726970135,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1141504314,"text":"Four! You can have four! But come on, that's as far as I can go!","nextNodeIds":[726970136]},{"nodeId":726970136,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":3646639762,"text":"*sigh* You could have all of them, really, if only I wasn't in debt. Sadly, I still owe the International Trade Association a sum of Mora...","nextNodeIds":[726970137]},{"nodeId":726970137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":657289234,"text":"All right, I'll let you off easy this time.","nextNodeIds":[726970138]},{"nodeId":726970138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":37109802,"text":"*sigh* Listen, we chose to help because you needed help, not for the Mora or toys.","nextNodeIds":[726970139]},{"nodeId":726970139,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":1671038778,"text":"Hehe, and your aid is most appreciated.","nextNodeIds":[726970140]},{"nodeId":726970140,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"Bertrand","textMapHash":2460501426,"text":"A relief, finally...","nextNodeIds":[]},{"nodeId":726970121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1124227658,"text":"It will proceed to Core Activation...","nextNodeIds":[726970122]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["30187"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],