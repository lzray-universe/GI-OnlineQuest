PKELCAL":["[3_8228:-2439.256,202.410,8154.888]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7501505],"talks":[{"talkId":7501505,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":true,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7501505","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7501505,"initDialog":750150501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21549],"performCfg":"QuestDialogue/WQ/Natlan_75015/Q7501505","priority":5,"questId":75015,"showRandomTalkCount":0},"dialogs":[{"nodeId":750150501,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2095247338,"text":"Phew, nice and tidy at last... G—Guess it's time for Paimon to get started with the fishing!","nextNodeIds":[750150502]},{"nodeId":750150502,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1799724178,"text":"Just you wait and see, Paimon's gonna catch a big one!","nextNodeIds":[750150503]},{"nodeId":750150503,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":97098858,"text":"Sadly, the surface stays as still as a mirror, without a ripple in sight.","nextNodeIds":[750150504]},{"nodeId":750150504,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4272329082,"text":"Uhh... Is there something wrong with the water here? The fish don't seem to want to come out, at all!","nextNodeIds":[750150505,750150508]},{"nodeId":750150505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2134747090,"text":"So close, hehe...","nextNodeIds":[750150506]},{"nodeId":750150506,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":130749042,"text":"So close! Yet... so far. Ugh, why does it feel like this is gonna take forever...","nextNodeIds":[750150507]},{"nodeId":750150507,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3572974298,"text":"It's a bit early to be getting Paimon's hopes up!","nextNodeIds":[750150511]},{"nodeId":750150511,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1788039074,"text":"Rawr...","nextNodeIds":[750150512]},{"nodeId":750150512,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2269662818,"text":"You've got it! You've got it!","nextNodeIds":[750150513]},{"nodeId":750150513,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2248615730,"text":"Hey, stop being such a distraction... Jeez!","nextNodeIds":[750150514]},{"nodeId":750150514,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3144062562,"text":"Ehh!? We've got a bite, we've got a bite! Time to reel it in and see what Paimon's caught!","nextNodeIds":[750150515]},{"nodeId":750150515,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1859314682,"text":"#What the... that's not a fish, it's a bottle! And it's even tied to one of the wooden planks at the fishing spot... Ugh, well, the fact that you always catch strange things too makes Paimon feel a little better, {NICKNAME}...","nextNodeIds":[750150516]},{"nodeId":750150516,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":221562970,"text":"You seem to be able to catch anything... but fish.","nextNodeIds":[750150517]},{"nodeId":750150517,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2313230602,"text":"Hey, you catch weird stuff all the time too! Anyway, seeing as Paimon already caught it, we might as well take a look at what's inside...","nextNodeIds":[750150518]},{"nodeId":750150518,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":968990458,"text":"Could it have been these two that left behind that pile of stuff just now? People who are this obsessed with fishing are... pretty scary, huh...","nextNodeIds":[750150519]},{"nodeId":750150519,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4131203106,"text":"Seems like they're using this bottle to pass messages to one another... We'd better throw it back.","nextNodeIds":[750150520]},{"nodeId":750150520,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":726141650,"text":"Aaaanyway, Paimon has a funny feeling that it'll definitely be a fish next time!","nextNodeIds":[750150521]},{"nodeId":750150521,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2205541370,"text":"The rod suddenly drops downwards and starts being violently tugged.\\nSeems like something big and heavy deep down below has taken the bait...","nextNodeIds":[750150522]},{"nodeId":750150522,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3408831594,"text":"A bite, at last! Must be one heckuva fish... Up you come, you big lump!","nextNodeIds":[750150523]},{"nodeId":750150523,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1592841474,"text":"That's right, you big lump! Up you come!","nextNodeIds":[750150524]},{"nodeId":750150524,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":2148868490,"text":"R—Rawr!","nextNodeIds":[750150525]},{"nodeId":750150525,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3668023426,"text":"#Seeing Paimon struggling,\\nyou and {REALNAME[ID(2)|SHOWHOST(true)]} grab hold of her...\\nBut the line is being pulled with such unstoppable force...","nextNodeIds":[750150526]},{"nodeId":750150526,"roleType":"TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":594699874,"text":"Finally, with a mighty plop, the fish escapes...","nextNodeIds":[750150527]},{"nodeId":750150527,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2034183730,"text":"*sobs* That must have been a huge one, otherwise it would never have gotten away!","nextNodeIds":[750150528]},{"nodeId":750150528,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2233095290,"text":"Ugh, so annoying... Huh? It's still swimming around near the surface! Seriously!?","nextNodeIds":[750150529]},{"nodeId":750150529,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1315100186,"text":"Rawrr—","nextNodeIds":[750150530]},{"nodeId":750150530,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3686517298,"text":"No no no, the sea's too dangerous! And you'll never catch up with it anyway...","nextNodeIds":[750150531]},{"nodeId":750150531,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1669860234,"text":"Rawr...","nextNodeIds":[750150532]},{"nodeId":750150532,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3163937594,"text":"#If only we could find a way to catch that fish, {NICKNAME}...","nextNodeIds":[]},{"nodeId":750150508,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2581867922,"text":"It won't be long, trust me! Just stay cool!","nextNodeIds":[750150509]},{"nodeId":750150509,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3639456810,"text":"Hmm, you're probably right. After all, once the bites start coming, it all happens so fast. Like when you go to pick a Sweet Flower, but it turns out to be a Whopperflower...","nextNodeIds":[750150510]},{"nodeId":750150510,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1480231330,"text":"All you gotta do is stay focused and wait... and wait...","nextNodeIds":[750150511]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7501505,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_8228:-2439.256,202.410,8154.888]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE