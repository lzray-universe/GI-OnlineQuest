,"KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["155301"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1143,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["155301"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2003702,"order":2,"stepDescription":"Talk to Godwin","stepDescTextMapHash":489028136,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["155301"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2003701,2003702],"talks":[{"talkId":2003701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2003702","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2003701,"initDialog":200370101,"nextRandomTalks":[],"nextTalks":[],"npcId":[155301],"performCfg":"","priority":5,"questId":20037,"showRandomTalkCount":0},"dialogs":[{"nodeId":200370101,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":3074868233,"text":"...Ugh, I am so ready to just get back to Mondstadt...","nextNodeIds":[200370102]},{"nodeId":200370102,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":1008653425,"text":"Oh, Traveler! Hi! Can I ask you a favor?","nextNodeIds":[200370103]},{"nodeId":200370103,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":3318063633,"text":"As you can see, I'm with the Knights, and I'm on patrol right now.","nextNodeIds":[200370104]},{"nodeId":200370104,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":1542955601,"text":"I told my girlfriend I would send her a letter before too long, just to let her know I'm safe and sound.","nextNodeIds":[200370105]},{"nodeId":200370105,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":2357315833,"text":"Then things got busy and I forgot all about it... dear me. Could you deliver this <color=#00E1FFFF>letter</color> to her for me? Her name's <color=#00E1FFFF>Glory</color>...","nextNodeIds":[200370106]},{"nodeId":200370106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1688757113,"text":"Wait— Glory?","nextNodeIds":[200370107]},{"nodeId":200370107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1062118657,"text":"The blind girl... Dandelion Seed collector...","nextNodeIds":[200370108]},{"nodeId":200370108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":30770481,"text":"Aha! You must be Godwin? Glory mentioned you!","nextNodeIds":[200370109]},{"nodeId":200370109,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":3067882001,"text":"Wha— How do you know Glory?","nextNodeIds":[200370110]},{"nodeId":200370110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1069304089,"text":"She had us run an errand for her.","nextNodeIds":[200370111]},{"nodeId":200370111,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":165251753,"text":"She made you run an errand, you say? I hope it wasn't anything dangerous...","nextNodeIds":[200370112]},{"nodeId":200370112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2478037729,"text":"She just asked us to get her some Dandelion Seeds, that's all. She said by releasing them into the wind, they would convey her heart's desires to you.","nextNodeIds":[200370113]},{"nodeId":200370113,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":359163553,"text":"Dandelion Seeds, eh? That does sound like my Glory alright.","nextNodeIds":[200370114]},{"nodeId":200370114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1235682537,"text":"Hang on, she said you were supposed to be somewhere far away from Mondstadt?","nextNodeIds":[200370115]},{"nodeId":200370115,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":2463131657,"text":"Yes— erm, well that was the plan... Let me, uh, fill you in.","nextNodeIds":[200370116]},{"nodeId":200370116,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":3398647329,"text":"Did you hear about the time the Grand Master left Mondstadt and took four out of every five knights with him?","nextNodeIds":[200370117]},{"nodeId":200370117,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":2740069025,"text":"Right, well, I was one of the ones assigned to that expedition. But unfortunately... just as we were getting ready to set off, I realized I'd lost the keepsake that Glory gave me. By the time I was done looking for it, they'd already left...","nextNodeIds":[200370118]},{"nodeId":200370118,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":252918833,"text":"I—I still haven't figured out how to catch up with them, and in the meantime I've just been milling around here...","nextNodeIds":[200370119]},{"nodeId":200370119,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":2129737865,"text":"I can't bring myself to go back to Mondstadt. I can only imagine what the knights would think of me if I just came crawling back...","nextNodeIds":[200370120]},{"nodeId":200370120,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":3925964489,"text":"Also... I promised Glory I would send her letters and gifts from all around the world. I said I would send her the world!","nextNodeIds":[200370121]},{"nodeId":200370121,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":404827809,"text":"If she found out I'd never even made it out of Mondstadt...","nextNodeIds":[200370122]},{"nodeId":200370122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3180407889,"text":"You don't want to lose face.","nextNodeIds":[200370123]},{"nodeId":200370123,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":201238465,"text":"Please, deliver this <color=#00E1FFFF>letter</color> to <color=#00E1FFFF>Glory</color> for me won't you? I bet she's worried sick about me.","nextNodeIds":[200370124,200370126]},{"nodeId":200370124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":241728257,"text":"Okay.","nextNodeIds":[200370125]},{"nodeId":200370125,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":4250102145,"text":"I can't thank you enough, Traveler! Please keep everything I just told you a secret though.","nextNodeIds":[]},{"nodeId":200370126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":898885785,"text":"Why not try the dandelion hotline?","nextNodeIds":[200370127]},{"nodeId":200370127,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":1642372689,"text":"There is so much I want to say to Glory, far more than a handful of Dandelion Seeds could ever hope to carry.","nextNodeIds":[200370128]},{"nodeId":200370128,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":894452537,"text":"Thank you for taking her my letter. And remember, not a word about any of this!","nextNodeIds":[]}]},{"talkId":2003702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2003702","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2003703","3",""],"type":"QUEST_COND_STATE_NOT_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2003702,"initDialog":200370201,"nextRandomTalks":[],"nextTalks":[],"npcId":[155301],"performCfg":"","priority":5,"questId":20037,"showRandomTalkCount":0},"dialogs":[{"nodeId":200370201,"roleType":"TALK_ROLE_NPC","speakerId":155301,"speakerName":"Godwin","textMapHash":2128353785,"text":"Thank you for delivering my letter. *sigh* All I want to do is go back and see Glory... If only...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["155301"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2003703,"order":3,"stepDescription":"Give the letter to Glory","stepDescTextMapHash":2460553552,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2003703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1521"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2003703,2003704],"talks":[{"talkId":2003703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2003703","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2003703,"initDialog":200370301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1521],"performCfg":"","priority":5,"questId":20037,"showRandomTalkCount":0},"dialogs":[{"nodeId":200370301,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":2363747121,"text":"Hello. I know that voice... Traveler! It's you, isn't it?","nextNodeIds":[200370302]},{"nodeId":200370302,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":1612765729,"text":"What brings you here today?","nextNodeIds":[200370303]},{"nodeId":200370303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":663892297,"text":"Someone told me to bring you this letter.","nextNodeIds":[200370304]},{"nodeId":200370304,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":3020954081,"text":"A letter... for me? Who would do that...","nextNodeIds":[200370305]},{"nodeId":200370305,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":1779382017,"text":"...Godwin.","nextNodeIds":[200370306]},{"nodeId":200370306,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":3825748121,"text":"Have you seen him? I guess that must mean he's okay— Did he say when he'll be back?","nextNodeIds":[200370307]},{"nodeId":200370307,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":2455442217,"text":"Sorry, forget all that. I'm sure he must be far too busy to answer all these questions, I don't want to put any more pressure on him.","nextNodeIds":[200370308]},{"nodeId":200370308,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":302510169,"text":"But could you read the letter to me?","nextNodeIds":[200370309]},{"nodeId":200370309,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":2294534905,"text":"Quietly... No one needs to hear this but the two of us.","nextNodeIds":[200370310]},{"nodeId":200370310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2954930497,"text":"Okay.","nextNodeIds":[200370311]},{"nodeId":200370311,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":1121155153,"text":"Wow, you read it so nicely... Is this something you do a lot?","nextNodeIds":[200370312]},{"nodeId":200370312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":55970489,"text":"That's the end of the letter.","nextNodeIds":[200370313]},{"nodeId":200370313,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":1130150137,"text":"Liyue Harbor... Wow, Godwin really is seeing the world after all!","nextNodeIds":[200370314]},{"nodeId":200370314,"roleType":"TALK_ROLE_NPC","speakerId":1521,"speakerName":"Glory","textMapHash":2028305225,"text":"Thank you, I will treasure this letter. Next time you see <color=#00E1FFFF>Godwin</color>, do tell him I'm thinking of him.","nextNodeIds":[200370315]}]},{"talkId":200