"","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7012801,"initDialog":701280101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20216],"performCfg":"","priority":0,"questId":70128,"showRandomTalkCount":0},"dialogs":[{"nodeId":701280101,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":2686851338,"text":"Hmm, this bottle feels heavy. Seems like there's something inside it...","nextNodeIds":[701280102]},{"nodeId":701280102,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":3998455962,"text":"\"An old friend of ours came over yesterday bearing ill tidings...\"","nextNodeIds":[701280103]},{"nodeId":701280103,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":77197314,"text":"\"I have not received a reply from you in a long while. Perhaps he is right, and I should accept reality.\"","nextNodeIds":[701280104]},{"nodeId":701280104,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":1251547738,"text":"\"But nonetheless, if you are still wandering the land, should you receive this missive, I hope that you can send me a reply.\"","nextNodeIds":[701280105]},{"nodeId":701280105,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":2899817354,"text":"\"Attach your insignia to your letter, that I may recognize you by its presence when the time comes.\"","nextNodeIds":[701280106]},{"nodeId":701280106,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":909537338,"text":"\"Do you remember Uyuu Restaurant? We shall meet there. You will find money for wine attached herein.\"","nextNodeIds":[701280107]},{"nodeId":701280107,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":3831077690,"text":"\"But if you are not the one I was expecting to receive this letter...\"","nextNodeIds":[701280108]},{"nodeId":701280108,"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","textMapHash":2204106482,"text":"\"Then please, take this keepsake all the same. Perhaps you might be able to find its original owner for me — do also take the Mora in here as thanks.\"","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7012801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20216,"speakerName":"Drifting Bottle","count":8}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[170128],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":0,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":701280101,"ILHDCGDKKKA":"TALK_HERO_LOCAL","ILHDNJDDEOP":7012801,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":true,"KINCAGMDMHH":[20216],"KJLNGKKBBOI":"TALK_MARK_NONE","KNBDEPPFNBN":0,"LCIDOOMOIPM":0,"LIJPPLJCHGI":0,"LMAPLNHKPOH":[],"MBDOOOMPFCD":false,"MEGMNOELHAO":false,"MMCFFPNNDDP":false,"MOAKNHNKCON":0,"MOFGBFLPGDM":[],"NGNGBPOHNJF":[],"NIJAPEJKLDI":false,"NMKNFLIHHHE":false,"NMMOKMEKDJO":false,"NPGONNBAOOI":4240140623429809466,"OAIIIMFGNGM":false,"OAOCMNEPKOG":70128,"ODEOIJMOMPL":[],"OMLNDCDBHEO":false,"PBFMFECIGDG":"TALK_NORMAL_QUEST","PCC