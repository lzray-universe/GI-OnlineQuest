{"mainQuestId":73679,"title":"Target: Master of the Snowy Peaks!","description":"Farabi has sent a message asking you to meet him at Dragonspine. The target for today seems to be the legendary king of Snowboars...","titleTextMapHash":3458246055,"descTextMapHash":240383918,"mainQuestExcel":{"mainQuestId":73679,"titleTextMapHash":3458246055,"title":"Target: Master of the Snowy Peaks!","descTextMapHash":240383918,"description":"Farabi has sent a message asking you to meet him at Dragonspine. The target for today seems to be the legendary king of Snowboars...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2016,"luaPath":"Actor/Quest/WQ73679","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2016,"chapterId":0,"descTextMapHash":240383918,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":73679,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":735532633,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ73679","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[173679],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3458246055,"type":"WQ","unlockDescTextMapHash":793322598}},"flow":[{"subQuestId":7367901,"order":1,"stepDescription":"Meet up with Farabi","stepDescTextMapHash":2989446804,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30247"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7367901],"talks":[{"talkId":7367901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2016","2016017","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367901,"initDialog":736790101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30247,30259],"performCfg":"QuestDialogue/WQ/Mengde_73679/Q7367901","priority":5,"questId":73679,"showRandomTalkCount":0},"dialogs":[{"nodeId":736790101,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"Edmund","textMapHash":683770466,"text":"You're here, Traveler. Phew... That's a relief.","nextNodeIds":[736790102]},{"nodeId":736790102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4280087218,"text":"Whoa, it's Edmund and Farabi. Why did you suddenly come to Dragonspine? Paimon was pretty surprised that you'd ask to meet here.","nextNodeIds":[736790103]},{"nodeId":736790103,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":1780315778,"text":"Haha, this is quite sudden, but since an \"unexpected research target\" has appeared, I can't let go of this opportunity.","nextNodeIds":[736790104]},{"nodeId":736790104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":438004530,"text":"\"Unexpected research target\"?","nextNodeIds":[736790105]},{"nodeId":736790105,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":123047962,"text":"Yes. Mr. Edmund says that he's seen huge animal footprints at the foot of the snowy mountain, and we finally found similar prints around this area.","nextNodeIds":[736790106]},{"nodeId":736790106,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":731986178,"text":"I can thus confirm that a huge Snowboar does indeed live there!","nextNodeIds":[736790107]},{"nodeId":736790107,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":3317336842,"text":"If we can get samples of its hair and blood, they will be a huge help in figuring out Snowboars' living conditions, and why they appeared at the foot of the mountain.","nextNodeIds":[736790108]},{"nodeId":736790108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2376259530,"text":"So our objective today is to hunt down that huge Snowboar?","nextNodeIds":[736790109]},{"nodeId":736790109,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"Edmund","textMapHash":1724391090,"text":"No, it's not a hunt. In the legends we hunters tell, the huge Snowboar is the true master of Dragonspine, and it is not something you can just hunt.","nextNodeIds":[736790110]},{"nodeId":736790110,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"Edmund","textMapHash":104329690,"text":"But I suppose it'll be alright if we trap it for a short while for research purposes, right? You gotta help me out on this, Farabi.","nextNodeIds":[736790111]},{"nodeId":736790111,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":3962666826,"text":"Mm, don't you worry. Honestly, after learning that Mondstadt is always plagued by Forest Boars during harvest season, I've been thinking a lot.","nextNodeIds":[736790112]},{"nodeId":736790112,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":3412385794,"text":"If all goes well, I'll continue my research on Forest Boars and maybe even find a solution to the problem.","nextNodeIds":[736790113]},{"nodeId":736790113,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":4165915610,"text":"After all, one of the most important purposes of studying creatures is to find a way to live in harmony with them.","nextNodeIds":[736790114]},{"nodeId":736790114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1733585258,"text":"Hehe, looks like you've learned a lot from your Weinlesefest vacation.","nextNodeIds":[736790115]},{"nodeId":736790115,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":2553784186,"text":"Yeah. I had great wine, made friends, and found a goal to work towards. But let's hold the sentimental stuff off for after we get down from this mountain.","nextNodeIds":[736790116]},{"nodeId":736790116,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"Edmund","textMapHash":1417317698,"text":"Traveler, judging by the size of those prints, I strongly doubt I'll be a match for that Snowboar. So I'm gonna have to leave it to an expert like you, if that's alright.","nextNodeIds":[736790117]},{"nodeId":736790117,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"Edmund","textMapHash":1477526354,"text":"But please rest assured that I've set up the bait and some traps. Those should be of some help.","nextNodeIds":[736790118]},{"nodeId":736790118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2760099290,"text":"Okay, leave it to me.","nextNodeIds":[736790119]},{"nodeId":736790119,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":1100549610,"text":"Traveler, if you're ready, I'm going to ignite the bait and lure the Snowboar over.","nextNodeIds":[736790120,736790121]},{"nodeId":736790120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2322234066,"text":"Giant Snowboar, here I come!","nextNodeIds":[]},{"nodeId":736790121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2828455098,"text":"Hold on, I need more time to prepare.","nextNodeIds":[736790122]},{"nodeId":736790122,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"Farabi","textMapHash":4234960922,"text":"It's okay, take your time. We're dealing with a chunky fellow, after all.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"