23020301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1627],"performCfg":"","priority":5,"questId":22302,"showRandomTalkCount":0},"dialogs":[{"nodeId":223020301,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":196123868,"text":"Where has the master gone this time...","nextNodeIds":[223020302]},{"nodeId":223020302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1046802348,"text":"I have a book from Chang the Ninth.","nextNodeIds":[223020303]},{"nodeId":223020303,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":1487359284,"text":"Huh? ...Seriously, he still writes?","nextNodeIds":[223020304]},{"nodeId":223020304,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":1299731308,"text":"Oh... I remember now, he said something about entering a novel-writing competition in Inazuma...","nextNodeIds":[223020305]},{"nodeId":223020305,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":44276588,"text":"What did he write about this time, then? Last time he wrote a book about the Qixing and kept insisting that we publish it for him.","nextNodeIds":[223020306]},{"nodeId":223020306,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":2121220332,"text":"Even without it being published, I still almost had the Millelith on my case...","nextNodeIds":[223020307]},{"nodeId":223020307,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":4192921492,"text":"At least this time it's going all the way to Inazuma for a competition. They probably wouldn't be able to trace it back to me.","nextNodeIds":[223020308]},{"nodeId":223020308,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":3023378436,"text":"Give it here. I'll get one of the sailors bound for Inazuma to take it with them.","nextNodeIds":[223020309]},{"nodeId":223020309,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":2818512748,"text":"I don't think Chang stands a chance of winning though. I hear a novel called \"A Legend of Sword\" is all the rage in Inazuma right now.","nextNodeIds":[223020310]},{"nodeId":223020310,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":1836983548,"text":"The author of that one is also from Liyue, though I don't know who it is.","nextNodeIds":[223020311]},{"nodeId":223020311,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"Xu","textMapHash":1813321572,"text":"Thanks for bringing the book. Chang the Ninth had originally asked us to collect it, he'd even paid up front. Please take this for your trouble.","nextNodeIds":[]}]},{"talkId":2230204,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["25700","",""],"type":"QUEST_COND_DAILY_TASK_IN_PROGRESS"},{"param":["2230202","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2230203","2",""],"type":"QUEST_COND_STATE_EQUAL"}],"beginCondComb":"LOGIC_A_AND_ETCOR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2230204,"initDialog":223020401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1624],"performCfg":"","priority":5,"questId":22302,"showRandomTalkCount":0},"dialogs":[{"nodeId":223020401,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":1864897756,"text":"Definitely going to win. Definitely...","nextNodeIds":[223020402]},{"nodeId":223020402,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":2603525324,"text":"I am going to win this, and then my book is going to be sold all around the world... And then, she will read it... She is sure to...","nextNodeIds":[223020403]},{"nodeId":223020403,"roleType":"TALK_ROLE_NPC","speakerId":1624,"speakerName":"Chang the Ninth","textMapHash":75399468,"text":"...What are you still doing here? Get my book down to the <color=#00E1FFFF>Feiyun Commerce Guild</color>, now!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2230203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100386,100387"],"PAINLIBBLDK":"QUEST_EXEC_DEL_ALL_SPECIFIC_PACK_ITEM"},{"LNHLPKELCAL":["25700"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["1627"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":2230205,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk