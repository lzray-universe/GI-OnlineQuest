{"mainQuestId":74064,"title":"Scenes from Life in Meropide: Every Debt has a Creditor","description":"The gear patterns on the wall are troubling the guards...","titleTextMapHash":4236531471,"descTextMapHash":1345096150,"mainQuestExcel":{"mainQuestId":74064,"titleTextMapHash":4236531471,"title":"Scenes from Life in Meropide: Every Debt has a Creditor","descTextMapHash":1345096150,"description":"The gear patterns on the wall are troubling the guards...","chapterId":10156,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ74064","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":10156,"descTextMapHash":1345096150,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74064,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1027623785,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74064","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174064],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4236531471,"type":"WQ","unlockDescTextMapHash":3008188550}},"flow":[{"subQuestId":7406401,"order":1,"stepDescription":"","stepDescTextMapHash":3818042564,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7406401],"talks":[{"talkId":7406401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406401,"initDialog":740640101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5214],"performCfg":"QuestDialogue/Q7406401","priority":5,"questId":74064,"showRandomTalkCount":0},"dialogs":[{"nodeId":740640101,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":3950963210,"text":"I said, either find a way to remove it or figure out who's behind it.","nextNodeIds":[740640102]},{"nodeId":740640102,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":2071935426,"text":"Easy for you to say... I've tried all kinds of cleaners, and none of 'em worked. If it needs something stronger... We have to try Hydro Phantasm Taint-B-Gone.","nextNodeIds":[740640103]},{"nodeId":740640103,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":1547409170,"text":"Hydro Phantasm Taint-B-Gone? Are you trying to burn a hole through the wall!? We'll all be sleeping with the fishes in no time!","nextNodeIds":[740640104]},{"nodeId":740640104,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":666075490,"text":"Then we'll have to locate the culprit. But we don't have any clues regarding their identity.","nextNodeIds":[740640105]},{"nodeId":740640105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2906522386,"text":"What's wrong? Is there anything we can do for you?","nextNodeIds":[740640106]},{"nodeId":740640106,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":119319170,"text":"Well... See that mark on the wall? Graffiti is prohibited in the Fortress of Meropide...","nextNodeIds":[740640107]},{"nodeId":740640107,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":2865944818,"text":"We've tried everything, but we still can't remove it, so if we could at least locate the culprit...","nextNodeIds":[740640108]},{"nodeId":740640108,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":346441386,"text":"Wait, hold on, now that I think about it, we aren't completely without leads. I remember Clynes mentioning that the Fontaine Research Institute has a mark that requires a special method to decipher.","nextNodeIds":[740640109]},{"nodeId":740640109,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":1302389586,"text":"Are you trying to say that it's the same type of mark?","nextNodeIds":[740640110]},{"nodeId":740640110,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":2303307146,"text":"I wasn't interested in the slightest back then, so I didn't bother asking for more information. Maybe he could give us an answer if he was here.","nextNodeIds":[740640111,740640113]},{"nodeId":740640111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":75094674,"text":"Maybe he's the culprit.","nextNodeIds":[740640112]},{"nodeId":740640112,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":2698057114,"text":"Indeed, we cannot rule out that possibility. But if that's the case, hehe... He should know the rules.","nextNodeIds":[740640115]},{"nodeId":740640115,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":4290342402,"text":"#{NICKNAME}, Paimon, you're knowledgeable adventurers with a wealth of experience, so do you have any ideas?","nextNodeIds":[740640116]},{"nodeId":740640116,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":3513403570,"text":"Help us locate the culprit behind the graffiti, or bring Clynes here to have a look. Hmm... Consider it an official commission then — with Coupons as compensation.","nextNodeIds":[740640117]},{"nodeId":740640117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1952584674,"text":"Alright. If it's an official commission, then we'll give it a go.","nextNodeIds":[740640118]},{"nodeId":740640118,"roleType":"TALK_ROLE_NPC","speakerId":5214,"speakerName":"Galvaryet","textMapHash":3438985314,"text":"Thank you. In the meantime, I'll try to find other means of removing it.","nextNodeIds":[]},{"nodeId":740640113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1380567778,"text":"Then shall we go get him?","nextNodeIds":[740640114]},{"nodeId":740640114,"roleType":"TALK_ROLE_NPC","speakerId":21107,"speakerName":"Maupoil","textMapHash":1921557338,"text":"I have no idea where he is, though... Haven't seen him all day. And are we really going to ask for his help? I lose a little bit of self-respect every time I ask him for something.","nextNodeIds":[740640115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7406402,"order":2,"stepDescription":"Examine the gear patterns on the wall","stepDescTextMapHash":916105428,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7406402"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["133408084","84003","4372.838:121.6821:4625.254"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_GADGET"},"isHidden":false,"talkIds":[7406402],"talks