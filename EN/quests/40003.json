k":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4000304","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":4000304,"initDialog":400030401,"nextRandomTalks":[],"nextTalks":[],"npcId":[242801],"performCfg":"QuestDialogue/EQ/Sealamp1_40003/Q4000304","priority":5,"questId":40003,"showRandomTalkCount":0},"dialogs":[{"nodeId":400030401,"roleType":"TALK_ROLE_NPC","speakerId":242801,"speakerName":"Xinghuo","textMapHash":2492735478,"text":"The monster presence has been duly investigated. Dismissed! ...Huh?","nextNodeIds":[400030402]},{"nodeId":400030402,"roleType":"TALK_ROLE_NPC","speakerId":242801,"speakerName":"Xinghuo","textMapHash":3199829566,"text":"Who are you with?","nextNodeIds":[400030403]},{"nodeId":400030403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3081062390,"text":"Jiayi sent us to find you, he said...","nextNodeIds":[400030404]},{"nodeId":400030404,"roleType":"TALK_ROLE_NPC","speakerId":242801,"speakerName":"Xinghuo","textMapHash":1216882486,"text":"I see. I understand.","nextNodeIds":[400030405]},{"nodeId":400030405,"roleType":"TALK_ROLE_NPC","speakerId":242801,"speakerName":"Xinghuo","textMapHash":2830732718,"text":"The Ministry of Civil Affairs is grateful for your support. Your case is well noted and will be scheduled for investigation as soon as possible.","nextNodeIds":[400030406]},{"nodeId":400030406,"roleType":"TALK_ROLE_NPC","speakerId":242801,"speakerName":"Xinghuo","textMapHash":2099923110,"text":"May our paths cross again in Liyue, kind travelers.","nextNodeIds":[400030407]},{"nodeId":400030407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2816808174,"text":"#{NICKNAME}, Paimon is starting to feel like...","nextNodeIds":[400030408,400030413]},{"nodeId":400030408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3852931702,"text":"The ministry isn't taking this seriously.","nextNodeIds":[400030409]},{"nodeId":400030409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3077381654,"text":"Exactly! Paimon thinks so too!","nextNodeIds":[400030410]},{"nodeId":400030410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1121492710,"text":"The locals must take all their tasty treats for granted by now.","nextNodeIds":[400030411]},{"nodeId":400030411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2817554814,"text":"But for a poor traveler, all alone out in the wilderness, often forced to survive on nothing but the most mysterious of mushrooms...","nextNodeIds":[400030412]},{"nodeId":400030412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4288075086,"text":"For you, the Lantern Rite is the most important of all festivals!","nextNodeIds":[400030416]},{"nodeId":400030416,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1837218054,"text":"So let's go back to the place where we witnessed the shady-looking guy.","nextNodeIds":[400030417]},{"nodeId":400030417,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3088960350,"text":"Paimon hears from patrol officers that criminals love to go back for another look at the crime scene after the event. Eh, it's a psychological thing, apparently.","nextNodeIds":[400030418]},{"nodeId":400030418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":754789678,"text":"But the crime hasn't even happened yet...","nextNodeIds":[400030419]},{"nodeId":400030419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2529075094,"text":"That's why there's no time to lose! When there's highly flammable materials involved, once the crime happens it'll be too late!","nextNodeIds":[]},{"nodeId":400030413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2866605214,"text":"We should take this into our own hands.","nextNodeIds":[400030414]},{"nodeId":400030414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1534976966,"text":"Paimon thinks so too!","nextNodeIds":[400030415]},{"nodeId":400030415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1300631278,"text":"With our wealth of experience adventuring far and wide, we should be able to get to the bottom of this.","nextNodeIds":[400030416]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4000304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1001","10019"],"PAINLIBBLDK":"QUEST_EXEC_INACTIVE_ACTIVITY_COND_STATE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["242801"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4000306,"order":6,"stepDescription":"Go back to the crime scene","stepDescTextMapHash":893254470,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1158,0],"PAINLIBBLDK":"QUEST_CONTENT_TRIGGER_FIRE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT",