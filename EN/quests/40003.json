EBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4000309],"talks":[{"talkId":4000309,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4000309","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":4000309,"initDialog":400030901,"nextRandomTalks":[],"nextTalks":[],"npcId":[10204],"performCfg":"QuestDialogue/EQ/Sealamp1_40003/Q4000309","priority":5,"questId":40003,"showRandomTalkCount":0},"dialogs":[{"nodeId":400030901,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":608452862,"text":"...","nextNodeIds":[400030902]},{"nodeId":400030902,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":3252891150,"text":"...","nextNodeIds":[400030903]},{"nodeId":400030903,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3062407262,"text":"#Hey {NICKNAME}, Paimon reckons this guy is gonna make a difficult conversation partner...","nextNodeIds":[400030904]},{"nodeId":400030904,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3651556078,"text":"If Paimon was gonna hazard a guess, Paimon would say he's definitely not one of the good guys!","nextNodeIds":[400030905]},{"nodeId":400030905,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":2322003542,"text":"Your hazardous guesswork is a woefully insufficient means of judging between good and evil.","nextNodeIds":[400030906]},{"nodeId":400030906,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":1843768470,"text":"Nevertheless, you surmise correctly. I am a malevolent spirit. A guardian yaksha, slaughterer of monsters and vanquisher of demons - Xiao.","nextNodeIds":[400030907]},{"nodeId":400030908,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1124765406,"text":"I'm sure I heard that term the other day.","nextNodeIds":[400030910]},{"nodeId":400030909,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4053430462,"text":"Paimon, do you know what a yaksha is?","nextNodeIds":[400030910]},{"nodeId":400030907,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":853626254,"text":"Guardian Yaksha!","nextNodeIds":[400030908,400030909]},{"nodeId":400030910,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":83492254,"text":"Yes... Someone from Liyue was telling us that yakshas are also a kind of adeptus. Supernatural beings that protect Liyue.","nextNodeIds":[400030911]},{"nodeId":400030911,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":665192766,"text":"They stand guard over the human world in secret, protecting it from monsters and demons. But most people don't even know they exist.","nextNodeIds":[400030912]},{"nodeId":400030912,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3933246006,"text":"...Wait, doesn't that make you the good guys by most definitions?","nextNodeIds":[400030913]},{"nodeId":400030913,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":2105969670,"text":"...No. Do not mistake the yakshas' guardianship for some sort of good will towards humanity.","nextNodeIds":[400030914]},{"nodeId":400030914,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":532052542,"text":"Hmph, charming! There's a whole city of humans out there working hard to prepare for Lantern Rite, all for the sake of honoring the heroes of Liyue's history...","nextNodeIds":[400030915]},{"nodeId":400030915,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":401388462,"text":"...Turns out we have here an actual historical hero, who has miraculously survived through to this day... and yet, he doesn't even appreciate the gesture!","nextNodeIds":[400030916]},{"nodeId":400030916,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":1964081126,"text":"...","nextNodeIds":[400030917]},{"nodeId":400030917,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3433857894,"text":"So, Mr. Xiao... Uh, that is, assuming \"Mr.\" is the correct way to address an adeptus... Why didn't you stop that shady character earlier?","nextNodeIds":[400030918]},{"nodeId":400030918,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":1439694870,"text":"I sensed a malign influence here. I'm here to investigate.","nextNodeIds":[400030919]},{"nodeId":400030919,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":4256152702,"text":"When a shackle is loosened in the realms of deities and demons, I take full responsibility.","nextNodeIds":[400030920]},{"nodeId":400030920,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":3239193510,"text":"But this time, the threat comes from the mortal world — your world. Thus you shall take full responsibility, mortal traveler.","nextNodeIds":[400030921]},{"nodeId":400030921,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":111486054,"text":"When the time comes, I hope you shall act promptly and decisively...","nextNodeIds":[400030922]},{"nodeId":400030922,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":3766255614,"text":"I do not wish for the tassel of the polearm that has slaughtered countless demons to become stained with mortal blood.","nextNodeIds":[400030923]},{"nodeId":400030923,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1903634398,"text":"What's this?","nextNodeIds":[400030924]},{"nodeId":400030925,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1307709518,"text":"Paimon, do you recognize it?","nextNodeIds":[400030926]},{"nodeId":400030924,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":1928690494,"text":"A symbol that your suspected evildoer left behind.","nextNodeIds":[400030925]},{"nodeId":400030926,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2762123262,"text":"Doesn't look familiar to Paimon.","nextNodeIds":[400030927]},{"nodeId":400030927,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":1449160630,"text":"Well, you will have to show me how much you can accomplish on your own strength.","nextNodeIds":[400030928]},{"nodeId":400030929,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2892397670,"text":"Actually, quite a festive color in this part of the world...","nextNodeIds":[400030930]},{"nodeId":400030928,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":2326911734,"text":"Because if I become involved, there is a possibility that the streets of Liyue Harbor will be painted red this Lantern Rite.","nextNodeIds":[400030929]},{"nodeId":400030930,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":749208326,"text":"That sounds terrible!","nextNodeIds":[400030932]},{"nodeId":400030931,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3727327702,"text":"Ahh, let's not be impulsive. Why don't we figure out the origins of this symbol first?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4000309,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10204"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4000302,4000304,4000307,4000309],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":28},{"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":2056,"speakerName":"Jiayi","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":242801,"speakerName":"Xinghuo","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1056995535,"CHECNJEMEFE":{"1005":[1190],"10204":[1190],"242801":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[40004],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/EQ/Sealamp1_40003/Q4000302","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKD