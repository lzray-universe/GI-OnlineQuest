{"mainQuestId":71513,"title":"Vigilance at Sea","description":"During Lantern Rite, Huixing, the navigator of the Crux fleet seems to be preparing for a unique training test...","titleTextMapHash":2424681911,"descTextMapHash":797016590,"mainQuestExcel":{"mainQuestId":71513,"titleTextMapHash":2424681911,"title":"Vigilance at Sea","descTextMapHash":797016590,"description":"During Lantern Rite, Huixing, the navigator of the Crux fleet seems to be preparing for a unique training test...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_ALL","activityId":2019,"luaPath":"Actor/Quest/WQ71513","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2019,"chapterId":0,"descTextMapHash":797016590,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71513,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":68446201,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71513","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171513],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2424681911,"type":"WQ","unlockDescTextMapHash":2293175870}},"flow":[{"subQuestId":7151301,"order":1,"stepDescription":"Talk to Huixing","stepDescTextMapHash":1837373124,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2434"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7151301,7151302,7151303],"talks":[{"talkId":7151301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7151301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7151301,"initDialog":715130101,"nextRandomTalks":[],"nextTalks":[7151303],"npcId":[2434],"performCfg":"","priority":5,"questId":71513,"showRandomTalkCount":0},"dialogs":[{"nodeId":715130101,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":759689202,"text":"#Hello, {NICKNAME} and Paimon. Happy Lantern Rite!","nextNodeIds":[715130102]},{"nodeId":715130102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3572483986,"text":"Thank you! Paimon also wishes you well!","nextNodeIds":[715130103]},{"nodeId":715130103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1648283130,"text":"Happy Lantern Rite!","nextNodeIds":[715130104]},{"nodeId":715130104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":68090018,"text":"Wait, how do you know us? Are you...","nextNodeIds":[715130105]},{"nodeId":715130105,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":2159331482,"text":"I'm Huixing, the navigator of the Crux fleet. I'm also responsible for fleet-related events for this Lantern Rite.","nextNodeIds":[715130106]},{"nodeId":715130106,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3463794066,"text":"I heard about your stories from Captain Beidou. You guys are also brave heroes, how admirable!","nextNodeIds":[715130107]},{"nodeId":715130107,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3100952770,"text":"If you have any questions about the Alcor, I will do my best to give you a detailed, thorough answer!","nextNodeIds":[715130108]},{"nodeId":715130108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3546653562,"text":"How nice!","nextNodeIds":[715130109]},{"nodeId":715130109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2515850594,"text":"We definitely want to know more about the Alcor, and if we're curious about anything, we'll definitely ask you.","nextNodeIds":[715130110]},{"nodeId":715130110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2103632866,"text":"In fact, this time, the Alcor has a lot of seaborne goods and decorations, and it's as bustling as in the city!","nextNodeIds":[]}]},{"talkId":7151302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7151301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["201107","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7151302,"initDialog":715130201,"nextRandomTalks":[],"nextTalks":[7151303],"npcId":[2434],"performCfg":"","priority":6,"questId":71513,"showRandomTalkCount":0},"dialogs":[{"nodeId":715130201,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":1420165666,"text":"#Long time no see, {NICKNAME} and Paimon! Happy Lantern Rite!","nextNodeIds":[715130202]},{"nodeId":715130202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2385388026,"text":"Thank you, Huixing! Paimon also wishes you well!","nextNodeIds":[715130203]},{"nodeId":715130203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1631291874,"text":"Happy Lantern Rite!","nextNodeIds":[715130204]},{"nodeId":715130204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3905262578,"text":"We've seen that the Alcor has a lot of seaborne goods and decorations, and it's as bustling as in the city!","nextNodeIds":[]}]},{"talkId":7151303,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7151301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7151303,"initDialog":715130301,"nextRandomTalks":[],"nextTalks":[],"npcId":[2434],"performCfg":"","priority":3,"questId":71513,"showRandomTalkCount":0},"dialogs":[{"nodeId":715130301,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3643039402,"text":"Looking great, no? All of the decorations were handpicked by the Captain. She wanted her brothers and sisters on duty to feel like they were at home for the festival!","nextNodeIds":[715130302]},{"nodeId":715130302,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":682696906,"text":"Not only that, before the Lantern Rite, the Captain gave each of us a bonus and organized several big feasts.","nextNodeIds":[715130303]},{"nodeId":715130303,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3250693970,"text":"The food for every feast is ordered from reputable restaurants, such as the Wanmin Restaurant, which we always frequent, and Xinyue Kiosk and Liuli Pavilion.","nextNodeIds":[715130304]},{"nodeId":715130304,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":1036517826,"text":"Everyone ate and drank their fill!","nextNodeIds":[715130305]},{"nodeId":715130305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3559480546,"text":"Paimon wants to check those out, too!","nextNodeIds":[715130306]},{"nodeId":715130306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1116026378,"text":"Wow, a bonus and a feast? That's great! Paimon had no idea that Beidou also had such an eye for detail!","nextNodeIds":[715130307]},{"nodeId":715130307,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3889863186,"text":"Actually, the Captain has always been meticulously keeping the fleet's affairs in order.","nextNodeIds":[715130308]},{"nodeId":715130308,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":358710906,"text":"Not only do we crew members get paid very well, but during past Lantern Rites, she's also prepared gifts for our families!","nextNodeIds":[715130309]},{"nodeId":715130309,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3368194362,"text":"Before, the Captain got some business information from the Tianquan on how to improve management strategy for the Crux.","nextNodeIds":[715130310]},{"nodeId":715130310,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":2562833610,"text":"The revenue of the fleet has soared, so the Captain has also increased our pay. In this way, the crew will be in tip-top shape for any challenge.","nextNodeIds":[715130311]},{"nodeId":715130311,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":2244854042,"text":"When the new recruits hear about how well the Crux fleet treats its crew, they'll be extra motivated.","nextNodeIds":[715130312,715130313]},{"nodeId":715130312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3465575146,"text":"Challenge?","nextNodeIds":[715130314]},{"nodeId":715130314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1706060298,"text":"Eh? During Lantern Rite, shouldn't everyone be on vacation? You guys seem to be... working overtime.","nextNodeIds":[715130315]},{"nodeId":715130315,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3537260058,"text":"It's not like that, don't worry!","nextNodeIds":[715130316]},{"nodeId":715130316,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":2432165242,"text":"The Captain has done all the research in advance. Some of the crew were given early leave, while the others were given days off later on.","nextNodeIds":[715130317]},{"nodeId":715130317,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":4185117050,"text":"Thus, everyone gets time off, and there will always be someone to man the Alcor!","nextNodeIds":[715130318]},{"nodeId":715130318,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":2340145178,"text":"I was among the group that got earlier vacation time, and I came back to my post completely refreshed! I'm currently getting ready for my training examination: \"Vigilance at Sea.\"","nextNodeIds":[715130319]},{"nodeId":715130319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2821078266,"text":"Vigilant... what now?","nextNodeIds":[715130320,715130321]},{"nodeId":715130320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3926775666,"text":"Is it a new challenge?","nextNodeIds":[715130322]},{"nodeId":715130322,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":726457458,"text":"Yup! You guessed it!","nextNodeIds":[715130323]},{"nodeId":715130323,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":4267778858,"text":"During the past two years, the volume of seaborne trade in Liyue Harbor has been soaring, and many people have joined up as sailors.","nextNodeIds":[715130324]},{"nodeId":715130324,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3374351762,"text":"Taking to the high seas is a matter of patience, bravery, and perception. These are highly demanded qualities. Sailors have to be well-trained in order to navigate safely.","nextNodeIds":[715130325]},{"nodeId":715130325,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":2572969762,"text":"In addition to obtaining the four major qualifications and the five minor qualifications, which total nine navigation-related qualifications stipulated by the Ministry of Civil Affairs, two years of maritime training and apprenticeship are also required.","nextNodeIds":[715130326]},{"nodeId":715130326,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1496407010,"text":"Nine qualifications and two more years of training!? Holy mackerel!!","nextNodeIds":[715130327]},{"nodeId":715130327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":535022674,"text":"That's so demanding!","nextNodeIds":[715130328]},{"nodeId":715130328,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":4006028826,"text":"It's no big deal. After all, it's far better to undergo rigorous training in preparation for work than to go out to sea and encountering an unpleasant surprise, unprepared.","nextNodeIds":[715130329]},{"nodeId":715130329,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":416853522,"text":"The Ministry of Civil Affairs organizes most of the training courses. Anyone with a passable knowledge of sailing could coast by them. These subjects aren't too difficult.","nextNodeIds":[715130330]},{"nodeId":715130330,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":4234966546,"text":"Of course, some ships will also have to traverse dangerous waters, which will hopefully give them some experience.","nextNodeIds":[715130331]},{"nodeId":715130331,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":2392121954,"text":"Given the experience of the Crux fleet in dealing with rough sea situations, we and the Ministry of Civil Affairs have organized an intensive navigation training program.","nextNodeIds":[715130332]},{"nodeId":715130332,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":3215701410,"text":"Sailors who pass the training will get a \"Deep Sea Navigation Qualification\" certificate on completion, as well as some rewards prepared by the Ministry of Civil Affairs.","nextNodeIds":[715130333]},{"nodeId":715130333,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":245821298,"text":"Considering I have the best knowledge of the surrounding waters, the Captain has tasked me with planning this training examination...","nextNodeIds":[715130334]},{"nodeId":715130334,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":557956130,"text":"Wait a minute. Speaking of sailing, you two are pretty good with that Waverider, no? Do you guys want to give it a try?","nextNodeIds":[715130335]},{"nodeId":715130335,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":667816378,"text":"If you don't mind, I would also like you guys to give me some feedback about this test, positive or negative. That way, I will be able to improve it in a timely manner!","nextNodeIds":[715130336]},{"nodeId":715130336,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2116257858,"text":"Well, Paimon wants to see how much skill the crew needs to navigate the high seas...","nextNodeIds":[715130337]},{"nodeId":715130337,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3802049874,"text":"And there's a bonus reward, too. It's a win-win for us!","nextNodeIds":[715130338,715130339]},{"nodeId":715130338,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1311281146,"text":"Let's give it a try!","nextNodeIds":[715130340]},{"nodeId":715130340,"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","textMapHash":1551869538,"text":"Such vigor! Then I'll mark you guys down for the \"Vigilance at Sea\" examination. Please do your best!","nextNodeIds":[]},{"nodeId":715130339,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1454700170,"text":"Let's experience what it's like to be a sailor!","nextNodeIds":[715130340]},{"nodeId":715130321,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3934781386,"text":"Is it to do with the new recruits?","nextNodeIds":[715130322]},{"nodeId":715130313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":254198994,"text":"New recruits?","nextNodeIds":[715130314]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2434"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7151301,7151302,7151303],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2434,"speakerName":"Huixing","count":31},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":9}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171513],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":797016590,"CHECNJEMEFE":{"2434":[1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"I