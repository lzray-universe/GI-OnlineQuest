GALAINLMD":0,"LNHLPKELCAL":[7506205,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7506201,7506202,7506203,7506204,7506205],"talks":[{"talkId":7506201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","2","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506201,"initDialog":750620101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21680],"performCfg":"QuestDialogue/WQ/Natlan_75062/Q7506201","priority":5,"questId":75062,"showRandomTalkCount":0},"dialogs":[{"nodeId":750620101,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":98819306,"text":"These inhuman creatures are truly tough adversaries... inhuman monsters, I should say. Greetings, brave warrior... I am Quenin, a member of this adventure team. My duty is...","nextNodeIds":[750620102]},{"nodeId":750620102,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":1771615722,"text":"My duty... is to eliminate these monsters. Yes, I am a warrior of the adventure team. Be careful, brave warrior...","nextNodeIds":[750620103]},{"nodeId":750620103,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":2717689434,"text":"These monsters... they are extremely cunning — capable of disguising themselves in different forms.","nextNodeIds":[750620104]},{"nodeId":750620104,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":3003240266,"text":"Every night, before I fall asleep, I hear... the sounds they make from their hiding spots in these ancient ruins. This... is why I cannot sleep at the encampment.","nextNodeIds":[750620105]},{"nodeId":750620105,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":3297981354,"text":"This place is filled with these monsters. You... must be careful, too.","nextNodeIds":[]}]},{"talkId":7506202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","3","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","2","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506202,"initDialog":750620201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21680],"performCfg":"QuestDialogue/WQ/Natlan_75062/Q7506202","priority":5,"questId":75062,"showRandomTalkCount":0},"dialogs":[{"nodeId":750620201,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":574523418,"text":"Ah, this place really is cursed...","nextNodeIds":[750620202]},{"nodeId":750620202,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":2403398682,"text":"Do not tarry here too long. You must leave, and quickly... Yes, you must leave before the coming of the pitch-black tide.","nextNodeIds":[750620203]},{"nodeId":750620203,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":2139328458,"text":"Yes, the pitch-black tide. Its vast shadow is almost upon us. We must... Must ensure that everyone gets to safety. That everyone... is safely evacuated.","nextNodeIds":[]}]},{"talkId":7506203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","4","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","3","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506203,"initDialog":750620301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21680],"performCfg":"QuestDialogue/WQ/Natlan_75062/Q7506203","priority":5,"questId":75062,"showRandomTalkCount":0},"dialogs":[{"nodeId":750620301,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":465053282,"text":"Why do you linger here still...?","nextNodeIds":[750620302]},{"nodeId":750620302,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":3183744650,"text":"Our adventure team's leader, the hero who wore a falcon's mask, is already... We cannot hold out against them any longer...","nextNodeIds":[750620303]},{"nodeId":750620303,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":2129045314,"text":"You must leave as soon as possible. This place is cursed, brave warrior. It is not somewhere that people should stay.","nextNodeIds":[]}]},{"talkId":7506204,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","5","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","4","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506204,"initDialog":750620401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21680],"performCfg":"QuestDialogue/WQ/Natlan_75062/Q7506204","priority":5,"questId":75062,"showRandomTalkCount":0},"dialogs":[{"nodeId":750620401,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":1282395842,"text":"So you are still here, brave warrior.","nextNodeIds":[750620402]},{"nodeId":750620402,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":2433989274,"text":"Once upon a time, so the scholars say, the ancient and tyrannical Lord of this Cinder City knew... a way to prevent Abyssal corrosion. So we...","nextNodeIds":[750620403]},{"nodeId":750620403,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":3792012514,"text":"But there really is something ominous about this place, brave warrior. Lately, I too have begun to feel a little... strange.","nextNodeIds":[750620404]},{"nodeId":750620404,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":1626927266,"text":"Sometimes, after waking, you'll find that a road that was perfectly intact just the day before has now become broken and dilapidated... And were those stone houses like that there to begin with? It feels like they should be more... complete.","nextNodeIds":[750620405]},{"nodeId":750620405,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":479731402,"text":"But sometimes, when I wake, I see friends who should not be here anymore... Are they monsters? That must be it... They're monsters that have taken the form of my friends.","nextNodeIds":[750620406]},{"nodeId":750620406,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":1083712346,"text":"My... My duty here is to eliminate those monsters, but... why? Why do I have to do that?","nextNodeIds":[750620407]},{"nodeId":750620407,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":883460330,"text":"Anyway, all things said and done, this is a very strange place. You should leave... as soon as possible.","nextNodeIds":[]}]},{"talkId":7506205,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","6","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","5","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506205,"initDialog":750620501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21680],"performCfg":"QuestDialogue/WQ/Natlan_75062/Q7506205","priority":5,"questId":75062,"showRandomTalkCount":0},"dialogs":[{"nodeId":750620501,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":2281525770,"text":"You'd better leave at once. If you stay any longer, it'll be too late...","nextNodeIds":[750620502]},{"nodeId":750620502,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":4037951826,"text":"Why will it be too late, you ask? Because... because our entire adventure team has been wiped out. That giant, pitch-black beast... They were all...","nextNodeIds":[750620503]},{"nodeId":750620503,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":577179042,"text":"They tasked me with protecting the evacuees, and at the very least, to ensure that they left the city. As we speak, a rescue team from the Flower-Feather Clan is on their way...","nextNodeIds":[750620504]},{"nodeId":750620504,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":2938857554,"text":"I must eliminate these evil monsters, so that the survivors can return to a land upon which the sun shines... Huh, but... Why am I here again?","nextNodeIds":[750620505]},{"nodeId":750620505,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":599482202,"text":"That sound in my ears... Ahh, it's getting louder and louder. I... I have to go back to the waterfall. Yes, I must... return to the waterfall.","nextNodeIds":[750620506]},{"nodeId":750620506,"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","textMapHash":141648914,"text":"Brave warrior, you too should leave... as soon as possible.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7506201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506205,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7506201,7506202,7506203,7506204,7506205],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21680,"speakerName":"Quenin","count":24}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4220418990,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75062/Q7506201","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DA