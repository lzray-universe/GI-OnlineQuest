":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30341"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369601],"talks":[{"talkId":7369601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7369601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369601,"initDialog":736960101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30341],"performCfg":"QuestDialogue/WQ/Sumeru_73696/Q7369601","priority":5,"questId":73696,"showRandomTalkCount":0},"dialogs":[{"nodeId":736960101,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":2249776802,"text":"Good day to you, Traveler. Given how you appear, you must be here to take part in the Wisdom Gala, yes?","nextNodeIds":[736960102]},{"nodeId":736960102,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":2065655122,"text":"If you're interested, would you like to try out the event that we, the Haravatat, are organizing?","nextNodeIds":[736960103]},{"nodeId":736960103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":324273762,"text":"If I recall, Haravatat studies...","nextNodeIds":[736960104]},{"nodeId":736960104,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":1132218338,"text":"\"Languages.\" Albeit that's a loose summary.","nextNodeIds":[736960105]},{"nodeId":736960105,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":3292223210,"text":"That is what we research here at Haravatat.","nextNodeIds":[736960106]},{"nodeId":736960106,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":3052403338,"text":"Well, what do you think? Sounds like a good fit for the Gala's festive and relaxed atmosphere, does it not?","nextNodeIds":[736960107]},{"nodeId":736960107,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":3777345650,"text":"Many of my fellow Darshan members do quite think so. Everyone is having fun to their heart's content, so surely we shall not spoil the mood by going around asking people riddles, yes?","nextNodeIds":[736960108]},{"nodeId":736960108,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":271076354,"text":"In any case, we shall be hard-pressed to drum up much interest if we make people guess riddles for our activity...","nextNodeIds":[736960109]},{"nodeId":736960109,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":1573653274,"text":"After much... friendly discussion, we have decided on a little game known as \"In Truth's Steps.\"","nextNodeIds":[736960110]},{"nodeId":736960110,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":3042661682,"text":"It does not require any tools or items. Just a settled mind and clear thoughts.","nextNodeIds":[736960111]},{"nodeId":736960111,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":1449681730,"text":"When this game starts, I will tell you a story. Now, it may seem to you that the tale is going nowhere. Indeed, some parts of it might even defy common sense!","nextNodeIds":[736960112]},{"nodeId":736960112,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":3057138506,"text":"And so you can question me, to which I will answer using three types of answers: <color=#00E1FFFF>\"Yes,\"</color> <color=#00E1FFFF>\"No,\"</color> or <color=#00E1FFFF>\"It doesn't matter.\"</color>","nextNodeIds":[736960113]},{"nodeId":736960113,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":517996170,"text":"What you need to do is to use your questions to find the \"truth\" to this story.","nextNodeIds":[736960114]},{"nodeId":736960114,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":2780668210,"text":"Don't be nervous, though. The correct answer isn't meant to be all that complicated.","nextNodeIds":[736960115]},{"nodeId":736960115,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":2057893250,"text":"What do you say? If you're interested, we can start now.","nextNodeIds":[736960116,736960118]},{"nodeId":736960116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":590780546,"text":"Alright, spin me a yarn.","nextNodeIds":[736960117]},{"nodeId":736960117,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":2607115218,"text":"Great! In that case, listen carefully now.","nextNodeIds":[]},{"nodeId":736960118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1817277658,"text":"I've got something else to do at the moment.","nextNodeIds":[736960119]},{"nodeId":736960119,"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","textMapHash":1988120978,"text":"That's alright. I'll be here, and you can come back whenever you'd like to have a go.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30341"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7369601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30341,"speakerName":"Bahar","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173696],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":92487206,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Sumeru_73696/Q7369601","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEH