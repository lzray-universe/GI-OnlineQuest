","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7000001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7000001,"initDialog":700000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[164201],"performCfg":"","priority":5,"questId":70000,"showRandomTalkCount":0},"dialogs":[{"nodeId":700000101,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":1363640778,"text":"What a romantic tradition. Now this is worth researching!","nextNodeIds":[700000102]},{"nodeId":700000102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2487731226,"text":"What are you doing?","nextNodeIds":[700000103]},{"nodeId":700000103,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":3516277450,"text":"Oh, it's you, Traveler. Have you come to the library due to your interest in Mondstadt's romantic songs as well?","nextNodeIds":[700000104]},{"nodeId":700000104,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":644668306,"text":"Still, words on a page can be read any time, but the history that happens all around us will slip by in but an instant.","nextNodeIds":[700000105]},{"nodeId":700000105,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":679631402,"text":"The people of Mondstadt have many special rituals during this cozy, romantic time known as the Windblume Festival.","nextNodeIds":[700000106]},{"nodeId":700000106,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":2078739858,"text":"What form do these traditions take, and what of the history behind them? These are both most promising research angles.","nextNodeIds":[700000107]},{"nodeId":700000107,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":4061725090,"text":"I'm currently writing a research report, and I believe that descriptions alone will not suffice. Could you help me take some pictures of the sights around the Windblume Festival?","nextNodeIds":[700000108,700000110]},{"nodeId":700000108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":670309458,"text":"Sure.","nextNodeIds":[700000109]},{"nodeId":700000109,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":3265418202,"text":"Thanks for helping with my research. I will certainly cite you in my acknowledgments.","nextNodeIds":[700000113]},{"nodeId":700000113,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":3406484450,"text":"All of the following deserve to be recorded: <color=#00E1FFFF>the floral decorations in the fountain plaza</color>, <color=#00E1FFFF>the Anemo Archon statue adorned with flowers in front of the Cathedral</color>, and the <color=#00E1FFFF>flower shop owner, hard at work</color>.","nextNodeIds":[700000115]},{"nodeId":700000115,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":215413602,"text":"Please help me take pictures of these sights, and pass those photos to me afterward.","nextNodeIds":[]},{"nodeId":700000110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2443239242,"text":"Best you go yourself.","nextNodeIds":[700000111]},{"nodeId":700000111,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":1506983506,"text":"No, no, I can't leave now. I just drafted the outline of my report. If I were to leave now, my train of thought would be interrupted.","nextNodeIds":[700000112]},{"nodeId":700000112,"roleType":"TALK_ROLE_NPC","speakerId":164201,"speakerName":"Sayid","textMapHash":2294281346,"text":"I'm counting on you, Traveler. Though it isn't much, I will prepare compensation for you.","nextNodeIds":[700000113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7000001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["164201"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7000002,"order":3,"stepDescription":"Take a picture of the floral decorations in the fountain square","stepDescTextMapHash":1973321716,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7000002,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,