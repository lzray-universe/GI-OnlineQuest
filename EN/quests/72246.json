sHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[72173,0],"PAINLIBBLDK":"QUEST_CONTENT_TIME_VAR_PASS_DAY","PPFLKMOMKAI":"1"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7224602,"order":2,"stepDescription":"","stepDescTextMapHash":3622500516,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7224601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7224601],"talks":[{"talkId":7224601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7224602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7224601,"initDialog":722460101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20321,20322],"performCfg":"","priority":5,"questId":72246,"showRandomTalkCount":0},"dialogs":[{"nodeId":722460101,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1211844202,"text":"What a pretty bracelet! What a pretty vase! Goods from Liyue sure are pretty!","nextNodeIds":[722460102]},{"nodeId":722460102,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1514172690,"text":"...Uh, wait, no. These simplistic terminologies will simply not do for a novelist like me.","nextNodeIds":[722460103]},{"nodeId":722460103,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1728794578,"text":"Perhaps I should purchase one of these ingeniously-made porcelain trinkets and use it as reference material for my next novel...","nextNodeIds":[722460104]},{"nodeId":722460104,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":2822666034,"text":"Mm, yes, yes! That's what we'll write.","nextNodeIds":[722460105]},{"nodeId":722460105,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":2816044362,"text":"\"The key to the turnaround was a Vision concealed within the vase!\"","nextNodeIds":[722460106]},{"nodeId":722460106,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":963611026,"text":"Yes, that could be quite interesting indeed! What do you think, Kama?","nextNodeIds":[722460107]},{"nodeId":722460107,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":2485055370,"text":"Lady Sumida, I don't really...","nextNodeIds":[722460108]},{"nodeId":722460108,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":4230787242,"text":"...","nextNodeIds":[722460109]},{"nodeId":722460109,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":2700944346,"text":"I feel that any descriptions of this vase should be well-controlled. If you spend too much time on it, the foreshadowing will become quite apparent. But at the same time, mentioning it too little will make that development seem abrupt.","nextNodeIds":[722460110]},{"nodeId":722460110,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3067225922,"text":"Hmm, you do have a point indeed! Let me write this down...","nextNodeIds":[722460111]},{"nodeId":722460111,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3828776970,"text":"Wait, no, let's do that somewhere else.","nextNodeIds":[722460112]},{"nodeId":722460112,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3438718522,"text":"Also, haven't I told you a thousand times before not to call me \"Lady\"?","nextNodeIds":[722460113]},{"nodeId":722460113,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":381172298,"text":"...But then again, having one of a pair of seemingly ordinary travelers call the other \"Lady\" or \"Lord\" isn't that uncommon a plot development either, is it?","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7224601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7224604,"order":3,"stepDescription":"","stepDescTextMapHash":3359089756,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1004,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7224603],"talks":[{"talkId":7224603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7224604","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7224603,"initDialog":722460301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20322,20321],"performCfg":"","priority":5,"questId":72246,"showRandomTalkCount":0},"dialogs":[{"nodeId":722460301,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":3616903626,"text":"Lady Sumida, do you have any plans as to where we should go next?","nextNodeIds":[722460302]},{"nodeId":722460302,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":2681072314,"text":"Hmm... Now I've heard that Mondstadt is home to a very large library...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1004,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_ROOM","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7224603,"order":4,"stepDescription":"","stepDescTextMapHash":2596526348,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7224602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7224602,7224604],"talks":[{"talkId":7224602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7224603","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7224602,"initDialog":722460201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20321,20322],"performCfg":"QuestDialogue/WQ/Inazuma_72173/Q7224602","priority":5,"questId":72246,"showRandomTalkCount":0},"dialogs":[{"nodeId":722460201,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1547910666,"text":"Phew— That felt good—","nextNodeIds":[722460202]},{"nodeId":722460202,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":2824728730,"text":"Or should I say \"this is how the largest library in the north should be\"? To think that I'd have the opportunity to finish the whole Vera's Melancholy series in one go! Ah, that was wonderful!","nextNodeIds":[722460203]},{"nodeId":722460203,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":1392546042,"text":"Lady Sumida, it might be best to keep your voice down.","nextNodeIds":[722460204]},{"nodeId":722460204,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1900543482,"text":"Ah, right. Sorry. I was getting too excited there...","nextNodeIds":[722460205]},{"nodeId":722460205,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":3565245130,"text":"No, I'm worried that you might get hurt. That librarian has an immense aura around her...","nextNodeIds":[722460206]},{"nodeId":722460206,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1372091722,"text":"Eh? Really? I thought she was a rather typical, slightly-lazy witch.","nextNodeIds":[722460207]},{"nodeId":722460207,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3061042154,"text":"...Hmm, but now that you mention it, these characters do tend to be the strongest. Um, right then, best not to get on her bad side...","nextNodeIds":[722460208]},{"nodeId":722460208,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":289920650,"text":"Actually, I could write a story based on just such a character, couldn't I? Something like \"The Mage of the Great Library\"...","nextNodeIds":[722460209]},{"nodeId":722460209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1238300938,"text":"How have your travels been going?","nextNodeIds":[722460210]},{"nodeId":722460210,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":3247958170,"text":"Ah. It's been a while.","nextNodeIds":[722460211]},{"nodeId":722460211,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1169998186,"text":"#Oh ho, if it isn't the legendary {NICKNAME}...","nextNodeIds":[722460212]},{"nodeId":722460212,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":2646772346,"text":"Our travels? ...Hmm, you know, I used to go out to travel to collect reference material a lot.","nextNodeIds":[722460213]},{"nodeId":722460213,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3275353658,"text":"I went to Musoujin Gorge to study how to write thunderstorms, headed to the Serpent's Head to learn how to describe a snake demon, I got Kama to join the military to better understand the lives of the Absconders...","nextNodeIds":[722460214]},{"nodeId":722460214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2661733482,"text":"Man, being Kama's a tough job.","nextNodeIds":[722460215]},{"nodeId":722460215,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":699430338,"text":"It wasn't much.","nextNodeIds":[722460216]},{"nodeId":722460216,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":978123330,"text":"But this on the other hand is a real journey. One with no real objective in mind.","nextNodeIds":[722460217]},{"nodeId":722460217,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3811195818,"text":"Only now have I discovered that there are just so many interesting things worth writing about in this world, just like in Kino's Travels.","nextNodeIds":[722460218]},{"nodeId":722460218,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1967894218,"text":"Kama and I visited the recommended sights and stores around these parts before camping out in the wild, exchanging stories with unfamiliar travelers by the campfire...","nextNodeIds":[722460219]},{"nodeId":722460219,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3744520554,"text":"...And when we woke up, we found our belongings all missing...","nextNodeIds":[722460220]},{"nodeId":722460220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":236437378,"text":"...Wait. So did that turn out okay in the end?","nextNodeIds":[722460221]},{"nodeId":722460221,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":89335290,"text":"It did. Honestly, when we found out that the gang of thieves had ten or more members, I thought we weren't getting our stuff back.","nextNodeIds":[722460222]},{"nodeId":722460222,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":2885919522,"text":"But somehow, Kama was able to convince them to return our things. They even gave him these coins with raven insignias on them to go!","nextNodeIds":[722460223]},{"nodeId":722460223,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":489284730,"text":"Shame... I thought that this would make for an interesting story, but Kama wouldn't tell me how it all went down.","nextNodeIds":[722460224,722460225]},{"nodeId":722460224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1724119946,"text":"...","nextNodeIds":[722460226]},{"nodeId":722460226,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":316624154,"text":"I simply did as I should. You need not worry, Lady Sumida.","nextNodeIds":[722460227]},{"nodeId":722460227,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":1734076722,"text":"You really are indispensable, Kama!","nextNodeIds":[722460228]},{"nodeId":722460228,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3117494682,"text":"With you by my side, I doubt we'd have any trouble, even if our adventures took us to the edge of the world itself!","nextNodeIds":[722460229]},{"nodeId":722460229,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3927918682,"text":"Speaking of which, you really have changed a lot since the whole incident with Tsurumi Island. There are things you want to do now, and opinions and doubts you want to express...","nextNodeIds":[722460230]},{"nodeId":722460230,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":1148797706,"text":"Well, if you do not find it suitable, Lady Sumida...","nextNodeIds":[722460231]},{"nodeId":722460231,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":548395714,"text":"No, no, I think it's great! Your views are all well-worth considering.","nextNodeIds":[722460232,722460233]},{"nodeId":722460232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1099100386,"text":"Well, I'll leave the two of you alone then.","nextNodeIds":[722460234]},{"nodeId":722460234,"roleType":"TALK_ROLE_NPC","speakerId":20321,"speakerName":"Sumida","textMapHash":3962365674,"text":"#Indeed. See you, {NICKNAME}. Let's meet at the end of all things, just like in \"Flowers for Princess Fischl.\"","nextNodeIds":[722460235]},{"nodeId":722460235,"roleType":"TALK_ROLE_NPC","speakerId":20322,"speakerName":"Kama","textMapHash":618421466,"text":"#See you, {NICKNAME}. Take care of yourself.","nextNodeIds":[]},{"nodeId":722460233,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3773492538,"text":"Perhaps we'll meet again in some other place.","nextNodeIds":[722460234]},{"nodeId":722460225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2330368826,"text":"You're pretty good, Kama.","nextNodeIds":[722460226]}]},{"talkId":7224604,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7224603","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND