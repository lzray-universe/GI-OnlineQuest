NodeIds":[710500403]},{"nodeId":710500403,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3396676714,"text":"Huh? Are you sure you found them here? How strange...","nextNodeIds":[710500404]},{"nodeId":710500404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2709956906,"text":"Is it strange for mushrooms to grow underground?","nextNodeIds":[710500405]},{"nodeId":710500405,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1227366570,"text":"That's not what I mean.","nextNodeIds":[710500406]},{"nodeId":710500406,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1766369066,"text":"It's just that they look similar to an indigenous mushroom in Sumeru.","nextNodeIds":[710500407]},{"nodeId":710500407,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":2060944434,"text":"I can't be sure yet with what we've got here. If I have enough samples, I might be able to arrive at a conclusion.","nextNodeIds":[710500408]},{"nodeId":710500408,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":2166478994,"text":"Speaking of which... Since you found it, you must know where to get more. Could you lend a hand?","nextNodeIds":[710500409]},{"nodeId":710500409,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3957369570,"text":"Bring me enough mushrooms and I'll pay you handsomely.","nextNodeIds":[710500410]},{"nodeId":710500410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4141351722,"text":"So, how many is enough?","nextNodeIds":[710500411]},{"nodeId":710500411,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":2595842,"text":"Mmm... Lemme think. Please bring me eight for starters.","nextNodeIds":[710500412]},{"nodeId":710500412,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1388323266,"text":"Don't worry. So long as you bring them to me, I'll make sure to repay you in full!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7105004,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2618"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7105002,"order":3,"stepDescription":"Collect 8 shining mushrooms","stepDescTextMapHash":2993906484,"finishConds":[{"BFGALAINLMD":8,"LNHLPKELCAL":[101212,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":8,"LNHLPKELCAL":[101212,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,