":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7105007,"initDialog":710500701,"nextRandomTalks":[],"nextTalks":[],"npcId":[2618],"performCfg":"","priority":5,"questId":71050,"showRandomTalkCount":0},"dialogs":[{"nodeId":710500701,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3617609034,"text":"Here're the mushrooms you asked for.","nextNodeIds":[710500702]},{"nodeId":710500702,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":2146825490,"text":"You have my thanks.","nextNodeIds":[710500703]},{"nodeId":710500703,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3886087226,"text":"With your help, my research is — what do they call it in Liyue? — \"as smooth as a cat soaring in the air.\"","nextNodeIds":[710500704]},{"nodeId":710500704,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4261341626,"text":"Like a winged tiger?","nextNodeIds":[710500705]},{"nodeId":710500705,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":198401602,"text":"Yes, like a winged tiger!","nextNodeIds":[710500706]},{"nodeId":710500706,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3157059426,"text":"What happened to these fungi?","nextNodeIds":[710500707]},{"nodeId":710500707,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1062540026,"text":"How strange. They look almost identical to an indigenous species in Sumeru save for the fluorescein. Why? Is it because they've evolved in the darkness?","nextNodeIds":[710500708]},{"nodeId":710500708,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3861861306,"text":"But why does their look remain the same after the evolution?","nextNodeIds":[710500709,710500710]},{"nodeId":710500709,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1362622650,"text":"You've lost me...","nextNodeIds":[710500711]},{"nodeId":710500711,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":2828777826,"text":"Hmm... Simply put, fungi evolve to adapt to their surrounding environment, but by the looks of it, this type of fungi is more suited to living in forest environments.","nextNodeIds":[710500712]},{"nodeId":710500712,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":796298378,"text":"That's why I'm so certain of their Sumeru origin.","nextNodeIds":[710500713]},{"nodeId":710500713,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":436327650,"text":"So, why do they glow?","nextNodeIds":[710500714]},{"nodeId":710500714,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3896940178,"text":"Since they aren't an indigenous species of The Chasm, they didn't evolve to glow. Rather, the glowing is a result of some abnormal ecological phenomenon...","nextNodeIds":[710500715]},{"nodeId":710500715,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":3480142426,"text":"It's probably because of the fragment that fell from the sky. After absorbing its energy...","nextNodeIds":[710500716,710500717]},{"nodeId":710500716,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1352753090,"text":"The fragment?","nextNodeIds":[710500718]},{"nodeId":710500718,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":743636306,"text":"Ahem... Huh? What did you say? Something about a \"fragment\"? Um, I mean, when the fragments of fungi fell from the sky, they must've...","nextNodeIds":[710500719]},{"nodeId":710500719,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":468914866,"text":"...Undergone some random mutation.","nextNodeIds":[710500720]},{"nodeId":710500720,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":4223498634,"text":"That must be it!","nextNodeIds":[710500721]},{"nodeId":710500721,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1687770962,"text":"Uh... Thank you for collecting these fungi. It's been a busy day. Please go get some rest, you've earned it!","nextNodeIds":[710500722]},{"nodeId":710500722,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"Khedive","textMapHash":1142534194,"text":"I'm gonna study them now, so if you wouldn't mind leaving me alone for a bit...","nextNodeIds":[]},{"nodeId":710500717,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3673881354,"text":"What is it?","nextNodeIds":[710500718]},{"nodeId":710500710,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2631443130,"text":"Is anything not adding up?","nextNodeIds":[710500711]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7105007,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["101212","8"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2618"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTal