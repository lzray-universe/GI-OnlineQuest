lks":[],"npcId":[20215],"performCfg":"","priority":0,"questId":70127,"showRandomTalkCount":0},"dialogs":[{"nodeId":701270201,"roleType":"TALK_ROLE_NPC","speakerId":20215,"speakerName":"Drifting Bottle","textMapHash":4031892906,"text":"\"If you are reading this message, I hope that you are the one I am expecting.\"","nextNodeIds":[701270202]},{"nodeId":701270202,"roleType":"TALK_ROLE_NPC","speakerId":20215,"speakerName":"Drifting Bottle","textMapHash":414029714,"text":"\"We once believed that war was something that only happened in fairy tales and legends. But now, each and every one of us trembles under Her Excellency's thundering wrath.\"","nextNodeIds":[701270203]},{"nodeId":701270203,"roleType":"TALK_ROLE_NPC","speakerId":20215,"speakerName":"Drifting Bottle","textMapHash":904727210,"text":"\"The beach that we used to go to has been sealed, but I found a way to get this letter out nonetheless.\"","nextNodeIds":[701270204]},{"nodeId":701270204,"roleType":"TALK_ROLE_NPC","speakerId":20215,"speakerName":"Drifting Bottle","textMapHash":1864224114,"text":"\"Do not worry, or blame yourself for this. This deed is but trivial for one who once ventured alongside you such as I.\"","nextNodeIds":[701270205]},{"nodeId":701270205,"roleType":"TALK_ROLE_NPC","speakerId":20215,"speakerName":"Drifting Bottle","textMapHash":2008173378,"text":"\"I will wait for your reply, even if you write but a single word.\"","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7012701,7012702],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20215,"speakerName":"Drifting Bottle","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":20214,"speakerName":"Drifting Bottle","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IB