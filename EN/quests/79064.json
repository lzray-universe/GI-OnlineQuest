D_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":7906408,"initDialog":790640801,"nextRandomTalks":[],"nextTalks":[],"npcId":[21550],"performCfg":"QuestDialogue/WQ/Fairybook_79064/Q7906408","priority":5,"questId":79064,"showRandomTalkCount":0},"dialogs":[{"nodeId":790640801,"roleType":"TALK_ROLE_NPC","speakerId":21439,"speakerName":"Albizzi","textMapHash":149937138,"text":"This is the guards' headquarters. If we can just explain the situation, I'm sure the giant guard will be less hostile towards us.","nextNodeIds":[790640802]},{"nodeId":790640802,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1208444514,"text":"Hello...","nextNodeIds":[790640803]},{"nodeId":790640803,"roleType":"TALK_ROLE_NPC","speakerId":21550,"speakerName":"Knock on Door","textMapHash":1130999106,"text":"What are you doing? I'm busy reminiscing about old times with a photo of my friend.","nextNodeIds":[790640804]},{"nodeId":790640804,"roleType":"TALK_ROLE_NPC","speakerId":21439,"speakerName":"Albizzi","textMapHash":812005066,"text":"I know that voice. Is that Winston?","nextNodeIds":[790640805]},{"nodeId":790640805,"roleType":"TALK_ROLE_NPC","speakerId":21550,"speakerName":"Knock on Door","textMapHash":1489734338,"text":"Hahaha, so, you come crawling back... I told you, I am your only friend in this world. What were you thinking, running off on a mission with two complete strangers?","nextNodeIds":[790640806]},{"nodeId":790640806,"roleType":"TALK_ROLE_NPC","speakerId":21550,"speakerName":"Knock on Door","textMapHash":1533924570,"text":"You were so naive. \"Oh, I'll make friends with them, I know I will!\" But in the end, I alone am waiting for you. I alone am your friend.","nextNodeIds":[790640807]},{"nodeId":790640807,"roleType":"TALK_ROLE_NPC","speakerId":21439,"speakerName":"Albizzi","textMapHash":498812042,"text":"#That's not true... It's not just those two. There's {NICKNAME}-Marquis and {M#his}{F#her} companion, too.","nextNodeIds":[790640808]},{"nodeId":790640808,"roleType":"TALK_ROLE_NPC","speakerId":21550,"speakerName":"Knock on Door","textMapHash":1473625762,"text":"...You made other friends behind my back!? Well, look at you, Albizzi, all grown up... That's the last straw. Get out of here! I never want to see your face again!","nextNodeIds":[790640809]},{"nodeId":790640809,"roleType":"TALK_ROLE_NPC","speakerId":21439,"speakerName":"Albizzi","textMapHash":2046918426,"text":"Actually, no. Why don't you lift the emergency measures for a second and let me in? I have a VIP with me and we're very close to solving the mystery of our sacred site.","nextNodeIds":[790640810]},{"nodeId":790640810,"roleType":"TALK_ROLE_NPC","speakerId":21550,"speakerName":"Knock on Door","textMapHash":489853522,"text":"I said, get out!!!","nextNodeIds":[790640811]},{"nodeId":790640811,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1505510306,"text":"Winston sounds the alarm. The giant guards arrive, scoop everyone up, and place you outside.\\n\"You and Winston both need your own space right now. Your friendship needs a cooling-off period.\"\\nThe guards kindly offer relationship advice.\\nThe whole process is unusually civilized.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7906408,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7906410"}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7906401","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["7906401"],"PAINLIBBLDK":"QUEST_EXEC_ROLLBACK_QUEST"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":