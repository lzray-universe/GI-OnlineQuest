DE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30673"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166801],"talks":[{"talkId":7166801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166801,"initDialog":716680101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30672,30673],"performCfg":"QuestDialogue/WQ/AnimalView_71668/Q7166801","priority":5,"questId":71668,"showRandomTalkCount":0},"dialogs":[{"nodeId":716680101,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3936717450,"text":"All are welcome to join the \"Claw Convoy\" animal rescue society...","nextNodeIds":[716680102]},{"nodeId":716680102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2761599114,"text":"Greetings!","nextNodeIds":[716680104]},{"nodeId":716680104,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1830329530,"text":"#Ah, {NICKNAME}, it's you. How do you do?","nextNodeIds":[716680105]},{"nodeId":716680105,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3948886954,"text":"Our guild is currently holding an event. Might that interest you?","nextNodeIds":[716680106]},{"nodeId":716680106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":316091570,"text":"What sort of event are we talking about?","nextNodeIds":[716680107]},{"nodeId":716680107,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1407647818,"text":"Simply put, we're asking people to join the Claw Convoy, an animal rescue society sponsored by the Feiyun Commerce Guild, and help us take care of abandoned or endangered animals.","nextNodeIds":[716680108]},{"nodeId":716680108,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3796993378,"text":"The Guild has been working with volunteers from the various nations, helping to solve the widespread problem of stray animals through communal adoption.","nextNodeIds":[716680109]},{"nodeId":716680109,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3972083050,"text":"We've seen major expansion in recent years, which led us to start thinking about working with researchers like Ms. Lamiya in the field of endangered animal conservation.","nextNodeIds":[716680110]},{"nodeId":716680110,"roleType":"TALK_ROLE_NPC","speakerId":30672,"speakerName":"Lamiya","textMapHash":1812794602,"text":"Honestly, I'm glad to see my research bear fruit in this way too.","nextNodeIds":[716680111]},{"nodeId":716680111,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1161991962,"text":"Haha! Then we're of the same mind.","nextNodeIds":[716680112]},{"nodeId":716680112,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3901699114,"text":"Thanks to our volunteers and visionary researchers like Ms. Lamiya, many stray animals now have a home, and endangered species are being protected.","nextNodeIds":[716680113]},{"nodeId":716680113,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":2238456154,"text":"Aside from Liyue, the Claw Convoy's animal care facilities may be found everywhere the Feiyun Commerce Guild is active, like in Mondstadt and Sumeru...","nextNodeIds":[716680114]},{"nodeId":716680114,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":2959797258,"text":"As such, we're running this event to show our gratitude to our volunteers and to let everyone know just how many Convoy companions we've got out there.","nextNodeIds":[716680115]},{"nodeId":716680115,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":4069284770,"text":"You can head over to the area where the adopted animals are staying to check on their actual living conditions, and take a small gift to go.","nextNodeIds":[716680116]},{"nodeId":716680116,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":3575017954,"text":"The gifts were prepared by our staff and other animal adopters. Of course, before you claim a gift, you'll need to prepare something for other adopters as well.","nextNodeIds":[716680117]},{"nodeId":716680117,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":2866504810,"text":"When the time comes, all gifts will be retrieved by a professional and delivered to the original adopter. No need for expensive gifts — they're just meant to convey your feelings.","nextNodeIds":[716680118]},{"nodeId":716680118,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":4244766178,"text":"#So how about it, {NICKNAME}? Interested?","nextNodeIds":[716680119,716680120]},{"nodeId":716680119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3157664042,"text":"Sure, I'll give it a go.","nextNodeIds":[716680121]},{"nodeId":716680121,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":251329626,"text":"Wonderful! It would be amazing to have a celebrity like you taking part.","nextNodeIds":[716680122]},{"nodeId":716680122,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1552930194,"text":"If you're ready, you can hand over your gift now. Our staff will pass it to the relevant adopter once the event ends.","nextNodeIds":[716680123]},{"nodeId":716680123,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"Zhenchen","textMapHash":1886191058,"text":"By the way, based on my personal experience, some of our adopters are interested in regional specialties, and others prefer good food.","nextNodeIds":[]},{"nodeId":716680120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":814679138,"text":"Absolutely, sign me up!","nextNodeIds":[716680121]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STY