":[730552502,730552507,730552511]},{"nodeId":730552502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3889883650,"text":"Let's talk about Jebrael.","nextNodeIds":[730552503]},{"nodeId":730552503,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":3072760866,"text":"To think that I remained doubtful of him until the end. I'm such an awful person...","nextNodeIds":[730552504]},{"nodeId":730552504,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":2860617098,"text":"Now, all I have for him is gratitude...","nextNodeIds":[730552505]},{"nodeId":730552505,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":1962263234,"text":"I've never been able to commit before this, whether in academics or in life... But that ends now. I will take the path I believe in, no matter how difficult it may be...","nextNodeIds":[730552506]},{"nodeId":730552506,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":3756116914,"text":"This is the least I can do to pay my respects to him...","nextNodeIds":[]},{"nodeId":730552507,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1235414194,"text":"I want to talk about King Deshret.","nextNodeIds":[730552508]},{"nodeId":730552508,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":800816106,"text":"To be honest, I'm starting to doubt the credibility of the articles I've read...","nextNodeIds":[730552509]},{"nodeId":730552509,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":297862338,"text":"That prayer... It gives me a strange feeling that I can't put a finger on. And Samail too... What he said... I think I should study it further once I get back.","nextNodeIds":[730552510]},{"nodeId":730552510,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":467894058,"text":"Of course, my main mission is still to write my paper like I originally planned.","nextNodeIds":[]},{"nodeId":730552511,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":722327754,"text":"Let's talk about Jeht for a moment.","nextNodeIds":[730552512]},{"nodeId":730552512,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":1561129466,"text":"*sigh* I, too, wish that I could do something for her, but...","nextNodeIds":[730552513]},{"nodeId":730552513,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":199096618,"text":"I can't...","nextNodeIds":[730552514]},{"nodeId":730552514,"roleType":"TALK_ROLE_NPC","speakerId":4218,"speakerName":"Tirzad","textMapHash":499311466,"text":"And she refuses to say anything. If she would just speak her desire, I would be willing to do anything in my power to help her...!","nextNodeIds":[]}]},{"talkId":7305526,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7330601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}