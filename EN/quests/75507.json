{"mainQuestId":75507,"title":"Whither Shall a Member of a \"Secret Organization\" Go?","description":"You've completed the commission, but some questions remain...","titleTextMapHash":2282146767,"descTextMapHash":57032710,"mainQuestExcel":{"mainQuestId":75507,"titleTextMapHash":2282146767,"title":"Whither Shall a Member of a \"Secret Organization\" Go?","descTextMapHash":57032710,"description":"You've completed the commission, but some questions remain...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":5245,"luaPath":"Actor/Quest/WQ75507","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":5245,"chapterId":0,"descTextMapHash":57032710,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":75507,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3125934817,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ75507","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[175507],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2282146767,"type":"WQ","unlockDescTextMapHash":2835562574}},"flow":[{"subQuestId":7550701,"order":1,"stepDescription":"Return to the camp in Natlan and talk to Helka","stepDescTextMapHash":130720100,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30718"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7550701],"talks":[{"talkId":7550701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7550701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7550701,"initDialog":755070101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30718],"performCfg":"QuestDialogue/WQ/EffigyChallengeV6_75507/Q7550701","priority":5,"questId":75507,"showRandomTalkCount":0},"dialogs":[{"nodeId":755070101,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3246434986,"text":"#Thank you, {NICKNAME}, Paimon. I couldn't have completed my task without your help.","nextNodeIds":[755070102]},{"nodeId":755070102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1955778666,"text":"Will you let me join your organization now?","nextNodeIds":[755070103]},{"nodeId":755070103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1050086618,"text":"Wait, you actually wanna join, don't you?","nextNodeIds":[755070104]},{"nodeId":755070104,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3485502106,"text":"Hmm... Your age might complicate things somewhat, but the real issue is that I've gotta hear what the others think. If all votes say yea... Well, it's not as if there's no precedent for this.","nextNodeIds":[755070105]},{"nodeId":755070105,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":1835096378,"text":"If you ever find yourself in Nod-Krai, hit up the \"Speranza\" in Nasha Town. Katya's not one of us, but she's a trustworthy sort. She'll help you out.","nextNodeIds":[755070106]},{"nodeId":755070106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":531864210,"text":"#Sure. Speaking of, you were taking all those photos and drawing in your notebook while {NICKNAME} was fighting. It all looked pretty professional!","nextNodeIds":[755070107,755070108]},{"nodeId":755070107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1971652578,"text":"Not trying to secretly study my fighting style, I hope...","nextNodeIds":[755070109]},{"nodeId":755070109,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":4181456754,"text":"Hmm... Well, I suppose I can tell you. My task is to collect information on 100 monster varieties. Thanks to you, my Natlan and Fontaine series are all squared away.","nextNodeIds":[755070110]},{"nodeId":755070110,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":879356514,"text":"Next up, I've got to head to Sumeru, where I'll likely hire some Eremites. That said, I should remember to send the illustrated handbook I've made back to Nasha Town.","nextNodeIds":[755070111]},{"nodeId":755070111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1877991674,"text":"Wow, so you're making some sort of monster index?","nextNodeIds":[755070112]},{"nodeId":755070112,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3053806202,"text":"Indeed. There's no monster in Nod-Krai that I don't know, so I decided to get acquainted with those from further afield.","nextNodeIds":[755070113]},{"nodeId":755070113,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":531403010,"text":"Maisie's a timid girl, but she loves hearing stories about these monsters. You should see her every time I give her a newly-made handbook of mine — she's pleased as pie!","nextNodeIds":[755070114]},{"nodeId":755070114,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":142705730,"text":"Shame that her constitution's too frail for travel, though, or I'd have brought her along. Plus, Katya's also said that if I produce a good enough book, I might even be able to get myself published.","nextNodeIds":[755070115]},{"nodeId":755070115,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3190996498,"text":"Now, I'd love to give Maisie a real surprise — take a copy of my newly-published handbook, hide it under her pillow, and... *cough* Ahem. Sorry, I got a bit distracted there.","nextNodeIds":[755070116]},{"nodeId":755070116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":64029546,"text":"Hehe, you sure do care about your friends, don'cha?","nextNodeIds":[755070117]},{"nodeId":755070117,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":3214223426,"text":"Friends, huh... I'd say they're more like family, even though we're not related by blood. *sigh* Let's not dwell on things like that!","nextNodeIds":[755070118]},{"nodeId":755070118,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":2850394754,"text":"Oh, right! Let me give you a copy of my handbook, too. Now, I need to keep a copy of the pictures and send them to Maisie, so, as for your copy...","nextNodeIds":[755070119,755070120]},{"nodeId":755070119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":123877882,"text":"Don't worry, I know a thing or two about photography too.","nextNodeIds":[755070121]},{"nodeId":755070121,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":818279890,"text":"That's great, then. I should be setting off for my next destination, so I'll probably head out sometime over the next few days.","nextNodeIds":[755070122]},{"nodeId":755070122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3942573882,"text":"Safe travels!","nextNodeIds":[755070123]},{"nodeId":755070123,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","textMapHash":2712988666,"text":"You too. Best of luck in your travels!","nextNodeIds":[]},{"nodeId":755070120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3898052922,"text":"Don't worry, I can see these monsters anytime I want.","nextNodeIds":[755070121]},{"nodeId":755070108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4208711834,"text":"Are you an artist doing sketches, or a director shooting a film reel, by any chance?","nextNodeIds":[755070109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30718"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7550701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"Helka","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[175507],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":57032710,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/EffigyChallengeV6_75507/Q7550701","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":755070101,"ILHDCGDKKKA":"TALK_HERO_MAIN","ILHDNJDDEOP":7550701,"JGFEJPBPHGJ":[],"JNFAMBOFGHJ":false,"KINCAGMDMHH":[30718],"KJLNGKKBBOI