1,"initDialog":200680101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1429],"performCfg":"","priority":5,"questId":20068,"showRandomTalkCount":0},"dialogs":[{"nodeId":200680101,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":2105736402,"text":"Ah, whatever shall I do...","nextNodeIds":[200680102]},{"nodeId":200680102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1677573682,"text":"Um, what happened?","nextNodeIds":[200680103]},{"nodeId":200680103,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":2821559658,"text":"Oh, it's you. You've come at just the right moment. Timmie's told me what you did to the ducks.","nextNodeIds":[200680104]},{"nodeId":200680104,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":3110912834,"text":"You... you... How should I say this? It's not as if I haven't heard of your deeds...","nextNodeIds":[200680105]},{"nodeId":200680105,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":1318714194,"text":"But did you really have to use your courage and strength in that way?","nextNodeIds":[200680106,200680107,200680108]},{"nodeId":200680106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":353156626,"text":"I was too hungry...","nextNodeIds":[200680109]},{"nodeId":200680109,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":3969057962,"text":"If you really were hungry, you could have done some honest work.","nextNodeIds":[200680110]},{"nodeId":200680110,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":369293114,"text":"With your capabilities, you'd definitely have a place at the Adventurers' Guild.","nextNodeIds":[200680113]},{"nodeId":200680113,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":887714586,"text":"Ah, it's all water under the bridge at this point. But Timmie's been quite down because of this.","nextNodeIds":[200680114]},{"nodeId":200680114,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":3170898026,"text":"I... Timmie's father once taught me how to make a certain dish. Mondstadt Hash Brown with Philanemo Mushrooms is Timmie's favorite.","nextNodeIds":[200680115]},{"nodeId":200680115,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":4075193722,"text":"Why don't you help me find three Philanemo Mushrooms, so we can make some for Timmie? That should perk him up a bit, and also serve by way of apology.","nextNodeIds":[200680116,200680117]},{"nodeId":200680116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1491018962,"text":"Leave it to me.","nextNodeIds":[200680118]},{"nodeId":200680118,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":926676626,"text":"Well then, off you go.","nextNodeIds":[200680120]},{"nodeId":200680120,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":725081354,"text":"As for the Philanemo Mushrooms... I remember that you can find some under the eaves of the houses in the southern part of the city.","nextNodeIds":[200680121]},{"nodeId":200680121,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":2552458418,"text":"Please come back soon!","nextNodeIds":[]},{"nodeId":200680117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1050517778,"text":"It shall be done!","nextNodeIds":[200680119]},{"nodeId":200680119,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":2783443922,"text":"Just three is enough! What are you planning to do with this many mushrooms? Are you going to bribe Timmie with a meal every time you annoy him?","nextNodeIds":[200680120]},{"nodeId":200680107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3262035370,"text":"It was an accident, really!","nextNodeIds":[200680111]},{"nodeId":200680111,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":3183982874,"text":"You accidentally hit those ducks and pigeons? Did you accidentally defeat the tough enemies you've encountered on your adventures too?","nextNodeIds":[200680113]},{"nodeId":200680108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3400071114,"text":"Strength comes from daily practice such as this.","nextNodeIds":[200680112]},{"nodeId":200680112,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":678983378,"text":"You... I... Forget it. Looks like your \"strength\" really is all-rounded.","nextNodeIds":[200680113]}]},{"talkId":2006802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2006802","3","","",""],"type":"QUEST_COND_ITEM_GIVING_ACTIVED"},{"param":["2006801","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"para