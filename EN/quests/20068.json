200680301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1567],"performCfg":"","priority":5,"questId":20068,"showRandomTalkCount":0},"dialogs":[{"nodeId":200680301,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":983741962,"text":"...Eat, eat. Eat and go, quickly...","nextNodeIds":[200680302,200680303,200680304]},{"nodeId":200680302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":11211258,"text":"What's up?","nextNodeIds":[200680305]},{"nodeId":200680305,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":626526618,"text":"You again!","nextNodeIds":[200680308]},{"nodeId":200680308,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":1694660234,"text":"What are you planning? Are you trying to hurt the ducks and the pigeons?","nextNodeIds":[200680309,200680310]},{"nodeId":200680309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":739459026,"text":"This hash brown is for you.","nextNodeIds":[200680311]},{"nodeId":200680311,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":1356509578,"text":"A hash brown? Huh. How did you know how to make this?","nextNodeIds":[200680312]},{"nodeId":200680312,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":380056154,"text":"I know, you must have asked Mommy!","nextNodeIds":[200680313]},{"nodeId":200680313,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":3630698562,"text":"Hmph. Are you trying to bribe me, just like that? I know what you've done to the birds!","nextNodeIds":[200680314]},{"nodeId":200680314,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":1969188242,"text":"...Still, since Mommy's sent you over with the hash brown, I guess that's her way of telling me to stop making trouble.","nextNodeIds":[200680315]},{"nodeId":200680315,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":915376266,"text":"She still needs to take care of Nora and Glory. It would be immature of me to make things harder for her.","nextNodeIds":[200680316]},{"nodeId":200680316,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":387141690,"text":"But let's be clear, I haven't forgiven you! I just don't wanna make trouble for Mommy. Got it?","nextNodeIds":[200680317]},{"nodeId":200680317,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":264531114,"text":"Still... Hmph. I bet that because I'm a kid, you're just going to forget your promise whenever you feel like it.","nextNodeIds":[200680318]},{"nodeId":200680318,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":1639424458,"text":"Once Daddy is back, I'm telling him all about you!","nextNodeIds":[]},{"nodeId":200680310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3395921514,"text":"Please take this hash brown!","nextNodeIds":[200680311]},{"nodeId":200680303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":726796706,"text":"Hey, Timmie...","nextNodeIds":[200680306]},{"nodeId":200680306,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":3024038842,"text":"You again? Leave me alone!","nextNodeIds":[200680308]},{"nodeId":200680304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":305559842,"text":"Has something happened?","nextNodeIds":[200680307]},{"nodeId":200680307,"roleType":"TALK_ROLE_NPC","speakerId":1567,"speakerName":"Timmie","textMapHash":2460118474,"text":"How can you even ask me that?","nextNodeIds":[200680308]}]},{"talkId":2006805,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"