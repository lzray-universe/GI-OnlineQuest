akerName":"Grace","textMapHash":3043194706,"text":"It's me. I've been taking care of the children who need care for a while now.","nextNodeIds":[200680504]},{"nodeId":200680504,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":925035586,"text":"Timmie's the one I've looked after longest. He's even come to call me Mommy.","nextNodeIds":[200680505]},{"nodeId":200680505,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":1993398554,"text":"But in truth, I'm not his real family.","nextNodeIds":[]},{"nodeId":200680506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2594686690,"text":"Why's Timmie so mad?","nextNodeIds":[200680507]},{"nodeId":200680507,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":2674620114,"text":"How can you even ask such a thing?","nextNodeIds":[200680508]},{"nodeId":200680508,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":2803473842,"text":"That child hasn't got many friends or people he's close to in this city. So other than Nora and Glory, he only has the small animals to keep him company.","nextNodeIds":[200680509]},{"nodeId":200680509,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":189599610,"text":"In fact, those pigeons even...","nextNodeIds":[200680510]},{"nodeId":200680510,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":693549474,"text":"...No, never mind. Please give the hash brown to Timmie as soon as you can.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2006803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100453","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"},{"LNHLPKELCAL":["23100"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE