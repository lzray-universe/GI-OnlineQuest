erId":1429,"speakerName":"Grace","textMapHash":3501437922,"text":"Thank you, these should be enough. Please wait a moment...","nextNodeIds":[200680402]},{"nodeId":200680402,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":3539069922,"text":"This should be fine. Please give this Mondstadt Hash Brown to Timmie.","nextNodeIds":[200680403]},{"nodeId":200680403,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":3507183082,"text":"And please, don't... do such things in the future. It's not worth the trouble.","nextNodeIds":[200680404]},{"nodeId":200680404,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":2432691674,"text":"Please listen to my advice. Don't disappoint Timmie... or me.","nextNodeIds":[200680405]},{"nodeId":200680405,"roleType":"TALK_ROLE_NPC","speakerId":1429,"speakerName":"Grace","textMapHash":659057138,"text":"Well, if only everyone listened to advice. If that were the case, Sister Victoria wouldn't be so busy.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2006804,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1429"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2006803,"order":4,"stepDescription":"Talk to Timmie","stepDescTextMapHash":962273740,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2006803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLN