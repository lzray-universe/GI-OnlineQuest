s":[],"nextTalks":[],"npcId":[1664],"performCfg":"","priority":5,"questId":20521,"showRandomTalkCount":0},"dialogs":[{"nodeId":205210101,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":197017754,"text":"How can she go adventuring without her adventure fuel...","nextNodeIds":[205210102]},{"nodeId":205210102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2027369786,"text":"\"Adventure fuel\"?","nextNodeIds":[205210103]},{"nodeId":205210103,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":3309610858,"text":"Oh, I mean hot food. I was talking about Iris, the explorer — she should really get some hot food in her...","nextNodeIds":[205210104]},{"nodeId":205210104,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":2028416642,"text":"She wants to organize an expedition into the mountains for a team of explorers. But she plans to head up alone first, camp out for a bit, and observe the conditions before coming up with a definite plan.","nextNodeIds":[205210105]},{"nodeId":205210105,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":3928872378,"text":"The camp isn't all that far away, and it's still easy enough getting supplies delivered there...","nextNodeIds":[205210106]},{"nodeId":205210106,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":2325791266,"text":"But still, camping up in the mountain, out in the snow... I feel like a hot meal would give her the extra energy she needs.","nextNodeIds":[205210107]},{"nodeId":205210107,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":506352482,"text":"I, however, wouldn't dare make the trip myself... what about you? Could you deliver this Cream Stew to Iris for me?","nextNodeIds":[205210108,205210110]},{"nodeId":205210108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1870662978,"text":"Leave it to me.","nextNodeIds":[205210109]},{"nodeId":205210109,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":1525556682,"text":"Thanks.","nextNodeIds":[205210113]},{"nodeId":205210113,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":494950810,"text":"This dish has been made fresh and is still piping hot. You'd better get it to Iris quickly. In these conditions, it'll go cold fast, and it won't be worth eating if that happens.","nextNodeIds":[205210114]},{"nodeId":205210114,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":233642034,"text":"That said, worst-case scenario, if you run into trouble along the way and the food becomes collateral damage, just come back here and I'll cook you a new one.","nextNodeIds":[]},{"nodeId":205210110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1214189314,"text":"Where do I find her?","nextNodeIds":[205210111]},{"nodeId":205210111,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":4075975746,"text":"She said that the camp is partway up the mountain.","nextNodeIds":[205210112]},{"nodeId":205210112,"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","textMapHash":3722186690,"text":"She's a seasoned adventurer and knows to exercise caution. She won't have strayed far from the camp.","nextNodeIds":[205210113]}]},{"talkId":2052102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,