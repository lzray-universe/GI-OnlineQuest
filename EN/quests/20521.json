lk":"TALK_HERO_LOCAL","id":2052103,"initDialog":205210301,"nextRandomTalks":[],"nextTalks":[],"npcId":[166501],"performCfg":"","priority":5,"questId":20521,"showRandomTalkCount":0},"dialogs":[{"nodeId":205210301,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3104655010,"text":"This Cream Stew is for you.","nextNodeIds":[205210302]},{"nodeId":205210302,"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","textMapHash":3145276146,"text":"Ah, Harris must have sent you. Thank you.","nextNodeIds":[205210303]},{"nodeId":205210303,"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","textMapHash":1242638730,"text":"I'd better not get too used to his delicious cooking, or I'll never be able to go back to those dehydrated meal replacements...","nextNodeIds":[205210304]},{"nodeId":205210304,"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","textMapHash":2554314370,"text":"Haha, I'm just joking. As an adventurer, I know when to grin and bear it when it comes to food.","nextNodeIds":[205210305]},{"nodeId":205210305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2176892658,"text":"Will you climb further up the mountain?","nextNodeIds":[205210306]},{"nodeId":205210306,"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","textMapHash":3861774298,"text":"Of course, this camp is just a stopover. I'll wait for a good opportunity, then see if I can set up camp a bit further on.","nextNodeIds":[205210307]},{"nodeId":205210307,"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","textMapHash":1931974242,"text":"Safe to say there'll be no hot food after that point.","nextNodeIds":[205210308]},{"nodeId":205210308,"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","textMapHash":1001788474,"text":"I'm not going to advance before it's safe to do so, though. After a little more observation here, I'll head back to camp, draw up a plan of action, and then make my decision.","nextNodeIds":[205210309]},{"nodeId":205210309,"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","textMapHash":1814508642,"text":"Thanks for coming all this way just to get some food to me. Here, take these in return.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2052103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133002937"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["29200"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["166501"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2052101,2052102,2052103,2052105],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1664,"speakerName":"Harris","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":166501,"speakerName":"Iris","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":true,"CBBBCAKOFGO":3315155478,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDIN