_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30774"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7566401],"talks":[{"talkId":7566401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7566401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7566401,"initDialog":756640101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30774],"performCfg":"QuestDialogue/WQ/Natlan_75664/Q7566401","priority":5,"questId":75664,"showRandomTalkCount":0},"dialogs":[{"nodeId":756640101,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":4154948746,"text":"#{NICKNAME} and Paimon! We meet at last.","nextNodeIds":[756640102]},{"nodeId":756640102,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":1784717106,"text":"Welcome to the Bloomflower Trials! I heard from our chief that you're here to sign up for the competition?","nextNodeIds":[756640103]},{"nodeId":756640103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2688287522,"text":"Yeah! But we were wondering, what exactly are the Bloomflower Trials about?","nextNodeIds":[756640104]},{"nodeId":756640104,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":3924117546,"text":"Ah, I'll give you a quick rundown.","nextNodeIds":[756640105]},{"nodeId":756640105,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":514163962,"text":"First of all, the Bloomflower Trials are divided into \"Offensive Battles\" and \"Defensive Battles.\"","nextNodeIds":[756640106]},{"nodeId":756640106,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":3518763234,"text":"Defensive battles are simple, just stop your opponents from attacking the tribe. Playing offense is trickier. Assuming your tribe's lost its defense, they have to sound a horn and counterattack.","nextNodeIds":[756640107]},{"nodeId":756640107,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":976519914,"text":"To spice things up, we've added special ritual items into the mix. Attackers can charge them up to destroy the defenders' special barriers.","nextNodeIds":[756640108]},{"nodeId":756640108,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":1392998738,"text":"And even if this is a competition, we don't want to see uncalled-for violence or conflicts. Anything broken should be fixed, and if you see monsters, please clear them out.","nextNodeIds":[756640109]},{"nodeId":756640109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2890019746,"text":"#Whoa... Paimon's head is spinning. {NICKNAME}, did you catch all that?","nextNodeIds":[756640110,756640111]},{"nodeId":756640110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2250520282,"text":"More or less...","nextNodeIds":[756640112]},{"nodeId":756640112,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","textMapHash":3188624874,"text":"Don't sweat it! If you've got questions, come find me. The competition isn't that complicated, I'm sure you'll get the hang of it in no time if you participate.","nextNodeIds":[]},{"nodeId":756640111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1217794178,"text":"Um... Definitely one of the quick rundowns of all time.","nextNodeIds":[756640112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7566401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30774"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7566401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"Ballo","count":8},{"roleType":"TAL