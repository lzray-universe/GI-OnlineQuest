DK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30895"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7069301],"talks":[{"talkId":7069301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7069301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7069301,"initDialog":706930101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002,30895],"performCfg":"QuestDialogue/WQ/DPEQ_70693/Q7069301","priority":5,"questId":70693,"showRandomTalkCount":0},"dialogs":[{"nodeId":706930101,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1472780842,"text":"That's what I'm saying! We've figured it out.","nextNodeIds":[706930102]},{"nodeId":706930102,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1354033946,"text":"Eula detests rigid, stuffy people the most! You know, the kind with 'narrow-mindedness' written all over their faces. They always get stuck obsessing over the tiniest details, and all they do is trip people up on every little step!","nextNodeIds":[706930103]},{"nodeId":706930103,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":3334396570,"text":"Maybe they even wear a monocle and can't go anywhere without a book in their hands. But when you take a closer look, you realize they haven't really read it though, and are just using it as a prop...","nextNodeIds":[706930104]},{"nodeId":706930104,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":3388357474,"text":"What they're really trying to do is to put on a so-called intellectual aura, and get a leg up on you before the conversation even starts!","nextNodeIds":[706930105]},{"nodeId":706930105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3854874018,"text":"Haha, that was spot on. I can picture it already!","nextNodeIds":[706930106]},{"nodeId":706930106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1299119786,"text":"Yanfei and... Amber? Now that's a duo Paimon's never seen before!","nextNodeIds":[706930107,706930108]},{"nodeId":706930107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1777608738,"text":"Hey! What are you two chatting about?","nextNodeIds":[706930109]},{"nodeId":706930109,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3423601610,"text":"Oh hey, Honorary Knight and Paimon! You're here!","nextNodeIds":[706930110]},{"nodeId":706930110,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3961191210,"text":"Yanfei and I were just discussing if we should have a few \"Big Bad Snowman\" as Easter eggs in our game.","nextNodeIds":[706930111]},{"nodeId":706930111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4167339882,"text":"Ooh, like targets that look like monsters?","nextNodeIds":[706930112]},{"nodeId":706930112,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1738356114,"text":"We were thinking that, apart from the more typical monsters, we could also include some less traditional characters.","nextNodeIds":[706930113]},{"nodeId":706930113,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2910971714,"text":"Looks like Yanfei and I share too many similar ideas about the casting!","nextNodeIds":[706930114,706930115]},{"nodeId":706930114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3585301090,"text":"Yanfei, didn't expect to see you here. What a pleasant surprise!","nextNodeIds":[706930116]},{"nodeId":706930116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":530824378,"text":"It's kind of amazing. Seeing you side by side, Paimon can tell right away you really click!","nextNodeIds":[706930117]},{"nodeId":706930117,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":3093758426,"text":"#Yeah, I'm really surprised to run into {NICKNAME} and Paimon in Mondstadt too!","nextNodeIds":[706930118]},{"nodeId":706930118,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":1169857370,"text":"You know, this isn't actually my first time in Mondstadt. I've helped with several civil lawsuits here before...","nextNodeIds":[706930119]},{"nodeId":706930119,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":4216347898,"text":"This time, Yaoyao and I had just finished up our work when I happened to hear about the opening of the Dragonspine International Cross Country Challenge, so I thought I'd check it out.","nextNodeIds":[706930120]},{"nodeId":706930120,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":2717042154,"text":"As it turns out, after I reached the venue, I ran into Amber while asking for directions. We hit it off immediately.","nextNodeIds":[706930121]},{"nodeId":706930121,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":2664549434,"text":"So, I decided to come try out the game Amber's managing, and chip in with some suggestions!","nextNodeIds":[706930122]},{"nodeId":706930122,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1703285890,"text":"Heh, any friend of Eula is my friend too. And fun games are meant to be enjoyed together with other people!","nextNodeIds":[706930123]},{"nodeId":706930123,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":804166474,"text":"Want to give this a try, Honorary Knight and Paimon? This mini-game is called \"Jade Pitching,\" and it's designed to help our guests from far and wide to unwind and ease their stress.","nextNodeIds":[706930124]},{"nodeId":706930124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1365398402,"text":"Yeah! Let's practice our snowball fight skills, it might come in handy in the future!","nextNodeIds":[706930125]},{"nodeId":706930125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2434478514,"text":"And if we ever find ourselves bored with little to do, we can play to see who's better. The loser has to cook!","nextNodeIds":[706930126,706930127]},{"nodeId":706930126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1070419970,"text":"In that case, I can't miss out!","nextNodeIds":[706930128]},{"nodeId":706930128,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2221167426,"text":"Snowballs, fireballs... You know, all elemental projectiles have something in common.","nextNodeIds":[706930129]},{"nodeId":706930129,"roleType":"TALK_ROLE_NPC","speakerId":30895,"speakerName":"Yanfei","textMapHash":1558560210,"text":"For someone as skilled in combat as you are, this should be a piece of cake!","nextNodeIds":[]},{"nodeId":706930127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1655105626,"text":"I'm pretty good at throwing snowballs.","nextNodeIds":[706930128]},{"nodeId":706930115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2974241354,"text":"I've never imagined the two of you would meet up.","nextNodeIds":[706930116]},{"nodeId":706930108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":690064418,"text":"Is there someone Eula detests?","nextNodeIds":[706930109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30895"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GU