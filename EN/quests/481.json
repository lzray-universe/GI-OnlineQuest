{"mainQuestId":481,"title":"Glide With the Wind","description":"Amber wishes to discuss the matter of how you've been using your wind glider...","titleTextMapHash":559170065,"descTextMapHash":4024094799,"mainQuestExcel":{"mainQuestId":481,"titleTextMapHash":559170065,"title":"Glide With the Wind","descTextMapHash":4024094799,"description":"Amber wishes to discuss the matter of how you've been using your wind glider...","chapterId":2003,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/LQ481","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":2003,"descTextMapHash":4024094799,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0}],"id":481,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":188329431,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/LQ481","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":2003,"rewardIdList":[100481],"series":2003,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[480],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":559170065,"type":"LQ","unlockDescTextMapHash":3205591419}},"flow":[{"subQuestId":48101,"order":1,"stepDescription":"Talk to Amber","stepDescTextMapHash":632675343,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[48101],"talks":[{"talkId":48101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["48101","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":48101,"initDialog":4810101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1002],"performCfg":"QuestDialogue/LQ/Ambor1_481/Q48101","priority":0,"questId":481,"showRandomTalkCount":0},"dialogs":[{"nodeId":4810102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1267090963,"text":"Pretty good.","nextNodeIds":[4810104]},{"nodeId":4810103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3246219555,"text":"I keep getting carried away and gliding too high.","nextNodeIds":[4810104]},{"nodeId":4810101,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":620467123,"text":"#Hey {NICKNAME}! I've been looking for you everywhere! How's that wind glider I gave you last time?","nextNodeIds":[4810102,4810103]},{"nodeId":4810104,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4243052115,"text":"Seems like it's really growing on you!","nextNodeIds":[4810105]},{"nodeId":4810105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1651899275,"text":"But then again, you don't have a gliding license, do you?","nextNodeIds":[4810106]},{"nodeId":4810106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":559589371,"text":"A gliding license? Hmm... What's that?","nextNodeIds":[4810107]},{"nodeId":4810107,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2490250371,"text":"Isn't it obvious? You gotta have a gliding license to legally glide in Mondstadt.","nextNodeIds":[4810108]},{"nodeId":4810108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":431973363,"text":"#Oh... but {NICKNAME} and Paimon have been gliding for ages now. This is the first we've heard about it!","nextNodeIds":[4810109]},{"nodeId":4810109,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3246926699,"text":"Yeah, you've been gliding all over the place... Everyone's noticed!","nextNodeIds":[4810110]},{"nodeId":4810110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4247783395,"text":"Eh-he.","nextNodeIds":[4810111]},{"nodeId":4810111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1015928595,"text":"Sooo... You came looking for us because you wanna give us a gliding license?","nextNodeIds":[4810112]},{"nodeId":4810112,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1400109347,"text":"No way! The Knights of Favonius have strict rules.","nextNodeIds":[4810113]},{"nodeId":4810113,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":2074277067,"text":"You need to pass an exam, and only then will the Knights issue your license.","nextNodeIds":[4810114]},{"nodeId":4810114,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":302286843,"text":"#Today I'm here as an examiner, to oversee {NICKNAME}'s official gliding exam!","nextNodeIds":[4810115]},{"nodeId":4810115,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3411189099,"text":"I gave you your wind glider, so this is my responsibility — at least, that's what Acting Grand Master Jean would say.","nextNodeIds":[4810116]},{"nodeId":4810117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":805693955,"text":"...Maybe you can cut me some slack?","nextNodeIds":[4810118]},{"nodeId":4810119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2130999835,"text":"It's fine. I can do this.","nextNodeIds":[4810120]},{"nodeId":4810116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2320592755,"text":"An exam! What a pain in the butt. Then again, since Amber is the examiner...","nextNodeIds":[4810117,4810119]},{"nodeId":4810118,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":689761243,"text":"No with a capital N-O! Do not challenge the authority of examiner Amber!","nextNodeIds":[4810121]},{"nodeId":4810120,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":1937051123,"text":"#I'm sure {NICKNAME} will glide through it!","nextNodeIds":[4810121]},{"nodeId":4810121,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3414461267,"text":"I mean... The whole city saw how well you flew the day that Stormterror attacked, so I'm sure you'll have no problems!","nextNodeIds":[4810122]},{"nodeId":4810122,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":949480091,"text":"But we do need to respect the rules and glide properly.","nextNodeIds":[4810123]},{"nodeId":4810123,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":3907304907,"text":"Here. Take this gliding manual. No need to memorize it, just be familiar with everything in there.","nextNodeIds":[4810124]},{"nodeId":4810124,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":242870179,"text":"For example: only one person per wind glider, no carrying anything over the set weight limit, no taking off using an Anemo Slime, and so on and so forth.","nextNodeIds":[4810125]},{"nodeId":4810125,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":4275023419,"text":"Anyway, be sure to read it, okay? I had to read a load of big, thick books too when Lisa was teaching me magic...","nextNodeIds":[4810126]},{"nodeId":4810126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":595253539,"text":"Wow, that's a big old book... Paimon thinks we best get started!","nextNodeIds":[4810127]},{"nodeId":4810127,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"Amber","textMapHash":859243331,"text":"Great. Come find me when you're done, I'll be at Windrise.","nextNodeIds":[]},{"nodeId":4810401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2377423531,"text":"*sigh* The Knights of Favonius gliding manual does NOT sound like a fun read...","nextNodeIds":[4810402]},{"nodeId":4810402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3871310491,"text":"Well, guess I'd better get started.","nextNodeIds":[]},{"nodeId":4810602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":151875731,"text":"It reads like a fairytale...","nextNodeIds":[4810604]},{"nodeId":4810603,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3106494707,"text":"People in Mondstadt really understand the romance in learning to glide.","nextNodeIds":[4810604]},{"nodeId":4810601,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3151902955,"text":"Hmm... That's a cool story... But is the Knights' gliding manual really written in that style?","nextNodeIds":[4810602,4810603]},{"nodeId":4810604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":782974307,"text":"Huh. Anyway, let's go find Amber.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1002"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":48102,"order":2,"stepDescription":"Read Amber's Gliding Guide (Hidden)","stepDescTextMapHash":3390120327,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QU