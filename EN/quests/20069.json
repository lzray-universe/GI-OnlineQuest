_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1425"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2006901,2006903,2006999],"talks":[{"talkId":2006901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2006901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["40002","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2006901,"initDialog":200690101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1425],"performCfg":"","priority":5,"questId":20069,"showRandomTalkCount":0},"dialogs":[{"nodeId":200690101,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":2553142778,"text":"These flowers aren't looking so good, either. What a shame...","nextNodeIds":[200690102]},{"nodeId":200690102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":168335090,"text":"Something the matter?","nextNodeIds":[200690103]},{"nodeId":200690103,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":859220874,"text":"Well, lots of people tend to buy single flowers to give as gifts, so I usually cut some flowers specifically for that purpose.","nextNodeIds":[200690104]},{"nodeId":200690104,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":1383504914,"text":"But the flowers I trim don't stay fresh for long. If they don't sell out, they'll wilt...","nextNodeIds":[200690105]},{"nodeId":200690105,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":3307336082,"text":"I've tried many methods in the past, but the flowers degrade by the end of the day all the same.","nextNodeIds":[200690106]},{"nodeId":200690106,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":1149654970,"text":"I wonder if there's any way to preserve those flowers for longer...","nextNodeIds":[200690107,200690111]},{"nodeId":200690107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1488513114,"text":"Preservation, you say...","nextNodeIds":[200690108]},{"nodeId":200690108,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":389414410,"text":"I've heard Sara from Good Hunter say that they put unused ingredients in a cool place, or preserve them using blocks of ice...","nextNodeIds":[200690109]},{"nodeId":200690109,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":1555793330,"text":"I've tried these methods too, but flowers stored using ice blocks always end up looking weird.","nextNodeIds":[200690110]},{"nodeId":200690110,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":989947626,"text":"They won't have withered, but I wouldn't call them fresh either... and either way, they wouldn't be presentable anymore...","nextNodeIds":[200690114]},{"nodeId":200690114,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":1093780802,"text":"I asked a lot of people, and Mr. Sayid... You know who he is, right? He's that researcher.","nextNodeIds":[200690115]},{"nodeId":200690115,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":3870913418,"text":"One day, when he came to buy flowers, he told me that he once read about putting flowers in cold storage in a book.","nextNodeIds":[200690116]},{"nodeId":200690116,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":654848914,"text":"Specifically... it involves using a container to store the flowers before placing that container near blocks of ice...","nextNodeIds":[200690117]},{"nodeId":200690117,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":1346341482,"text":"He also mentioned that if I wanted to do some experiments, the most suitable place would be the low-temperature environment on Dragonspine.","nextNodeIds":[200690118]},{"nodeId":200690118,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":95199218,"text":"But I've heard that Dragonspine's a very dangerous place, and I couldn't find any adventurers willing to help me on such short notice...","nextNodeIds":[200690119]},{"nodeId":200690119,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":2614358338,"text":"Traveler, could you help me bury these three flower containers in the Dragonspine snow?","nextNodeIds":[200690120,200690121]},{"nodeId":200690120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3947546290,"text":"Consider it done.","nextNodeIds":[200690122]},{"nodeId":200690122,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":2224058050,"text":"Thanks for your help. Let me think... I've heard that Dragonspine is huge, and has a lot of different regions, which could lead to very different results...","nextNodeIds":[200690123]},{"nodeId":200690123,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":3948148954,"text":"Perhaps a comparison might be in order...","nextNodeIds":[200690124]},{"nodeId":200690124,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":2674003114,"text":"Please help me place these flowers <color=#00E1FFFF>beside the Statue of The Seven</color>, <color=#00E1FFFF>beside the water</color>, and... <color=#00E1FFFF>at a cavern entrance</color>, then.","nextNodeIds":[]},{"nodeId":200690121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2518097434,"text":"Where should I bury them?","nextNodeIds":[200690122]},{"nodeId":200690111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1124118818,"text":"Best to sell them all on the day itself, then.","nextNodeIds":[200690112]},{"nodeId":200690112,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":1209156026,"text":"That would be best. But there are always one or two flowers that don't get sold.","nextNodeIds":[200690113]},{"nodeId":200690113,"roleType":"TALK_ROLE_NPC","speakerId":1425,"speakerName":"Flora","textMapHash":1873052978,"text":"I know it's only one or two, but I don't want to just let them wither away.","nextNodeIds":[200690114]}]},{"talkId":2006903