:{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1018"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[4121103],"talks":[{"talkId":4121103,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4121112","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":4121103,"initDialog":412110301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1018],"performCfg":"QuestDialogue/EQ/Dragonspine1_41211/Q4121103","priority":5,"questId":41211,"showRandomTalkCount":0},"dialogs":[{"nodeId":412110301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1462490266,"text":"So, how did it feel?","nextNodeIds":[412110302,412110303]},{"nodeId":412110302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4026138586,"text":"The sword's power has increased.","nextNodeIds":[412110304]},{"nodeId":412110304,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2783510610,"text":"I have a hypothesis concerning this.","nextNodeIds":[412110305]},{"nodeId":412110305,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3325543506,"text":"Each time this sword absorbs power from the bodies of fallen enemies, it will resonate with Durin's remains, hidden somewhere on this mountain.","nextNodeIds":[412110306]},{"nodeId":412110306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1469828922,"text":"Holy moly, that sounds amazing!","nextNodeIds":[412110307]},{"nodeId":412110307,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2965959562,"text":"If my theory proves correct, this could mean that all the monsters here may be resonating with Durin's body.","nextNodeIds":[412110308]},{"nodeId":412110308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2195972130,"text":"But why would they do that?","nextNodeIds":[412110309]},{"nodeId":412110309,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2393127514,"text":"I fear this may have to do with the origin of these monsters' powers.","nextNodeIds":[412110310]},{"nodeId":412110310,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":357352018,"text":"Durin is no ordinary beast. Even though it is long dead, the entire mountain is still held in thrall by its corpse.","nextNodeIds":[412110311]},{"nodeId":412110311,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2654434098,"text":"The dragon's mysterious power... may itself be a form of curse.","nextNodeIds":[412110312]},{"nodeId":412110312,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1457763138,"text":"We still don't have enough information. If we wish to understand more, more data is required. This is where you come in.","nextNodeIds":[412110313]},{"nodeId":412110313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2908573010,"text":"Guess story-time's become work-time...","nextNodeIds":[412110314]},{"nodeId":412110314,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":908032442,"text":"I have some research work that needs settling, so we will have to work separately for now. Let's meet up again near the broken bridge.","nextNodeIds":[]},{"nodeId":412110303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2114732490,"text":"There are different responses... but there is an identical flow of energy.","nextNodeIds":[412110304]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4121103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133002413"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133008285"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133002414"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE"