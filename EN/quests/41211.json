,"",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":4121102,"initDialog":412110201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1018],"performCfg":"QuestDialogue/EQ/Dragonspine1_41211/Q4121102","priority":5,"questId":41211,"showRandomTalkCount":0},"dialogs":[{"nodeId":412110201,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3844609802,"text":"The Fatui? And they chose to attack us within the Treasure Hoarders' camp... Did they follow us here?","nextNodeIds":[412110202]},{"nodeId":412110202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1735060042,"text":"But why would they do that?","nextNodeIds":[412110203]},{"nodeId":412110203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3856063954,"text":"Did you go rile them up while we weren't looking?","nextNodeIds":[412110204]},{"nodeId":412110204,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1387070450,"text":"Did you?","nextNodeIds":[412110205,412110206]},{"nodeId":412110205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2514247786,"text":"Why, I never!","nextNodeIds":[412110207]},{"nodeId":412110207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1189697706,"text":"Um, maybe it's something we all did, then...","nextNodeIds":[412110208]},{"nodeId":412110208,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3437184826,"text":"I think the Fatui are looking for this sword.","nextNodeIds":[412110209]},{"nodeId":412110209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1997027242,"text":"Eh!? Weren't you keeping this sword super secret? How did they know it existed?","nextNodeIds":[412110210]},{"nodeId":412110210,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3459262338,"text":"Perhaps they caught sight of you using it on the mountain.","nextNodeIds":[412110211]},{"nodeId":412110211,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":32505058,"text":"If their eyes are any good, they'll definitely have seen how this sword stands out from the rest.","nextNodeIds":[412110212]},{"nodeId":412110212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2362810690,"text":"They really want everything, don't they?","nextNodeIds":[412110213]},{"nodeId":412110213,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":129095154,"text":"Not quite, no.","nextNodeIds":[412110214]},{"nodeId":412110214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1218675618,"text":"I remember hearing more about their activities recently too...","nextNodeIds":[412110215]},{"nodeId":412110215,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":278828850,"text":"The Fatui are collecting things related to the archons. This, I believe, is known to you.","nextNodeIds":[412110216]},{"nodeId":412110216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":283622074,"text":"Huh. Now that you mention it, we did hear Master Diluc say that.","nextNodeIds":[412110217]},{"nodeId":412110217,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":2333841170,"text":"Durin is the sworn enemy of the Anemo Archon, and had power comparable to his.","nextNodeIds":[412110218]},{"nodeId":412110218,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3539536122,"text":"To say that it could rival the archons, or was related to them... Neither is an overstatement.","nextNodeIds":[412110219]},{"nodeId":412110219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":693239786,"text":"No wonder they've set their sights on this sword.","nextNodeIds":[412110220]},{"nodeId":412110220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2173240274,"text":"So that's how it is...","nextNodeIds":[412110221]},{"nodeId":412110221,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":87764202,"text":"I made a new discovery while sketching nearby.","nextNodeIds":[412110222]},{"nodeId":412110222,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3490236738,"text":"There's an area up ahead that's quite remarkable. Its ley lines flow differently from any other.","nextNodeIds":[412110223]},{"nodeId":412110223,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":1390548330,"text":"Nearby monsters have been attracted to it and have fallen under its influence. As a result, their constitutions have come to far surpass others of the same kind.","nextNodeIds":[412110224]},{"nodeId":412110224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4162904738,"text":"That seems convenient.","nextNodeIds":[412110225]},{"nodeId":412110225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":248145106,"text":"Well, we're here to help this sword grow, aren't we? Might as well go try it out on those monsters!","nextNodeIds":[412110226]},{"nodeId":412110226,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"Albedo","textMapHash":3632947042,"text":"Precisely my intention. Oh, and do remember to observe how various enemies affect this sword differently while you're at it, please.","nextNodeIds":[]},{"nodeId":412110206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":381279698,"text":"I wouldn't do something like that.","nextNodeIds":[412110207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4121102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1018"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4121110,"order":40,"stepDescription":"Investigate the ley line disorder","stepDescTextMapHash":778199452,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"4121110"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q41211_Camp"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"4121110"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUE