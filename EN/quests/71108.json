eroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7110906","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["7110722","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7110825,"initDialog":711082501,"nextRandomTalks":[],"nextTalks":[],"npcId":[2520,2484],"performCfg":"","priority":5,"questId":71108,"showRandomTalkCount":0},"dialogs":[{"nodeId":711082501,"roleType":"TALK_ROLE_NPC","speakerId":2520,"speakerName":"Wen the Fourth","textMapHash":356093098,"text":"Sigh... To think that after a thousand years of heritage, the Guhua Clan's head doorkeeper must cheat others to survive... What shall we do, what can be done...","nextNodeIds":[711082502]},{"nodeId":711082502,"roleType":"TALK_ROLE_NPC","speakerId":2484,"speakerName":"Huang the Third","textMapHash":2605790186,"text":"Ugh... Alright, come on now. Am I not sparing my junior from starving to death while guarding our gates...?","nextNodeIds":[711082503]},{"nodeId":711082503,"roleType":"TALK_ROLE_NPC","speakerId":2484,"speakerName":"Huang the Third","textMapHash":1296677394,"text":"#And don't look at me like that. You're always depressed... But you were pleased to see {NICKNAME}'s performance just now, weren't you?","nextNodeIds":[711082504]},{"nodeId":711082504,"roleType":"TALK_ROLE_NPC","speakerId":2520,"speakerName":"Wen the Fourth","textMapHash":3464630538,"text":"That fool from before? They get to take a look around for making you some rice with bacon? And I would be pleased about that? I would slap you to death if I were a few years younger...","nextNodeIds":[711082505]},{"nodeId":711082505,"roleType":"TALK_ROLE_NPC","speakerId":2484,"speakerName":"Huang the Third","textMapHash":989927098,"text":"Heh! Your technique was inferior to mine just a few years ago!","nextNodeIds":[711082506]},{"nodeId":711082506,"roleType":"TALK_ROLE_NPC","speakerId":2484,"speakerName":"Huang the Third","textMapHash":3123189962,"text":"...Anyway, listen... Only a few of us geezers are left. What do you plan to do after we stop testing those who may be destined to join us? Take those books with us to our graves?","nextNodeIds":[711082507]},{"nodeId":711082507,"roleType":"TALK_ROLE_NPC","speakerId":2520,"speakerName":"Wen the Fourth","textMapHash":2339671850,"text":"...","nextNodeIds":[711082508]},{"nodeId":711082508,"roleType":"TALK_ROLE_NPC","speakerId":2484,"speakerName":"Huang the Third","textMapHash":3197691938,"text":"Hah... Just forget it. What's the point of saying such depressing things?","nextNodeIds":[711082509]},{"nodeId":711082509,"roleType":"TALK_ROLE_NPC","speakerId":2484,"speakerName":"Huang the Third","textMapHash":1570038186,"text":"Oh, why don't you try the food those kids made me? Hehe! I think it's better than Wanmin Restaurant's fare! Here, take a bite! Just a bite!","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7110802,7110803,7110804,7110825],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2230,"speakerName":"\"Guhua Notes\"","count":37},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":15},{"r