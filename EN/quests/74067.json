742,4783.659]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7406704,"order":4,"stepDescription":"Talk to Clynes","stepDescTextMapHash":104303788,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7406704],"talks":[{"talkId":7406704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406704","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406704,"initDialog":740670401,"nextRandomTalks":[],"nextTalks":[],"npcId":[5252],"performCfg":"QuestDialogue/Q7406704","priority":5,"questId":74067,"showRandomTalkCount":0},"dialogs":[{"nodeId":740670401,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2114314370,"text":"We meet again. I made a bet with myself on whether it would be you who came.","nextNodeIds":[740670402,740670404]},{"nodeId":740670402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1504004858,"text":"So, did you win or lose?","nextNodeIds":[740670403]},{"nodeId":740670403,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":4089711394,"text":"Heh, I won, and I lost too.","nextNodeIds":[740670406]},{"nodeId":740670406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2606339818,"text":"Why would you do that using a loudspeaker? Wouldn't you be in trouble if Galvaryet caught you? Aren't you terrified of her?","nextNodeIds":[740670407]},{"nodeId":740670407,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2604240770,"text":"Terrified of her? Why would I be? It's just a bit annoying when she catches you. But she spends most of her time in the administrative area. She doesn't get involved with issues in the production zone unless there's good reason to.","nextNodeIds":[740670408]},{"nodeId":740670408,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3690722714,"text":"As for why I use a loudspeaker for things like this, naturally it's because it's way too boring here.","nextNodeIds":[740670409]},{"nodeId":740670409,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2032459210,"text":"I think I get Teilhard now. He must be bored out of his mind, so he's always trying to find ways to entertain himself. In that sense, I'm just copying him.","nextNodeIds":[740670410]},{"nodeId":740670410,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1196512970,"text":"You've got a friend like him, right? One who's always full of crazy ideas, sometimes making a ridiculous mess of things.","nextNodeIds":[740670411,740670412]},{"nodeId":740670411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":405828330,"text":"Naturally.","nextNodeIds":[740670413]},{"nodeId":740670413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3972089890,"text":"Paimon doesn't get you at all! If you think it's boring here and have a friend like that, why don't you just leave the Fortress of Meropide? Or are you actually guilty of some really serious crimes...?","nextNodeIds":[740670414]},{"nodeId":740670414,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":907877810,"text":"I can leave any time I want. I choose to stay of my own volition.","nextNodeIds":[740670415]},{"nodeId":740670415,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1266614978,"text":"It's much better in here than out there. Nothing to worry about, life is stable, and no need to ponder complicated questions.","nextNodeIds":[740670416]},{"nodeId":740670416,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":247096554,"text":"I really envy that Lanoire girl. If I were her, I'd choose to never leave here. I'd rather be ignorant of the world outside.","nextNodeIds":[740670417,740670419]},{"nodeId":740670417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":592166698,"text":"That's because you've already seen the outside world.","nextNodeIds":[740670418]},{"nodeId":740670418,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3916250834,"text":"You're right there. You can't make a judgment without having seen the evidence.","nextNodeIds":[740670421]},{"nodeId":740670421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1801844986,"text":"But wouldn't it mean you won't see any friends if you stay here? Unless they come down as well...","nextNodeIds":[740670422]},{"nodeId":740670422,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1635695874,"text":"Good news: That's not a problem for me. Bad news: It's not a problem because all my friends are gone.","nextNodeIds":[740670423]},{"nodeId":740670423,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1502151450,"text":"*sigh* I'm just not good with topics like this.","nextNodeIds":[740670424]},{"nodeId":740670424,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3417318946,"text":"When they were still around, life wasn't bad. Even though our research field wasn't particularly hot, and getting funding approved was next to impossible.","nextNodeIds":[740670425]},{"nodeId":740670425,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":3040079794,"text":"But then the accidents and misfortune started piling up. Butor passed away due to illness, the Central Laboratory blew up, and Teilhard perished in the blast.","nextNodeIds":[740670426]},{"nodeId":740670426,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":600050650,"text":"And the one who got fired... Never mind, I won't mention him.","nextNodeIds":[740670427]},{"nodeId":740670427,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":4127869994,"text":"Anyway, there was absolutely nothing I could do about any of it. But life in the Fortress is simple, and any problems that crop up are easy to deal with.","nextNodeIds":[740670428]},{"nodeId":740670428,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":1122441802,"text":"Even if something major does happen, it's not like I'm the one that'll have to deal with it. So, I'm quite content with my life now. It's just that I'd like to have someone to reminisce with now and then.","nextNodeIds":[740670429,740670430]},{"nodeId":740670429,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1069964338,"text":"Understandable.","nextNodeIds":[740670431]},{"nodeId":740670431,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2744490482,"text":"Though it was nice chatting with you today, so thank you. Let me give you these Coupons. You can think of it as a free round on me next time you're in the Rag and Bone Shop.","nextNodeIds":[740670432]},{"nodeId":740670432,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":80390602,"text":"#Cheers, {M#Mister}{F#Miss}, and the little lady too. Smile, and may you have a wonderful day.","nextNodeIds":[]},{"nodeId":740670430,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2971984970,"text":"I respect your decision.","nextNodeIds":[740670431]},{"nodeId":740670419,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3187613826,"text":"You shouldn't judge others so casually.","nextNodeIds":[740670420]},{"nodeId":740670420,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":4106262986,"text":"Yeah, true enough. Heh, now that you mention it, I don't know her well at all, so who knows what she thinks.","nextNodeIds":[740670421]},{"nodeId":740670412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1096674514,"text":"Nope.","nextNodeIds":[740670413]},{"nodeId":740670404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4072326562,"text":"Why would you bet with yourself?","nextNodeIds":[740670405]},{"nodeId":740670405,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","textMapHash":2456642778,"text":"Good question, but an easy one to answer... It's because nobody here was willing to make such a boring wager with me.","nextNodeIds":[740670406]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["74025","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["133408161","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7406704],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"Clynes","count":21},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174067],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1417626718,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__Backi