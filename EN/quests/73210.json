lkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7321005","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7321005,"initDialog":732100501,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"QuestDialogue/WQ/Sumeru_73210/Q7321005","priority":5,"questId":73210,"showRandomTalkCount":0},"dialogs":[{"nodeId":732100501,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4214841418,"text":"Hm... Paimon wonders what sort of treasure we'll find here.","nextNodeIds":[732100502]},{"nodeId":732100502,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2162586322,"text":"The shelves are full of thin books. You browse through them, and find that they seem to be hospital documents such as medical records or financial statements.\\nYou shut the door in disappointment.","nextNodeIds":[732100503]},{"nodeId":732100503,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3197419698,"text":"Paimon thought there would be some special treasure inside... Even the wooden barrels and crates we find on our adventures are better than this! At least those had cabbage or fowl inside...","nextNodeIds":[732100504]},{"nodeId":732100504,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":386971362,"text":"Eh? What's this? It looks like it fell out from over here...","nextNodeIds":[732100505]},{"nodeId":732100505,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1918054178,"text":"Let Paimon see... Maybe it'll lead us to treasure!","nextNodeIds":[732100507]},{"nodeId":732100507,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":570867658,"text":"Uhh... Eleazar is so scary...","nextNodeIds":[732100508]},{"nodeId":732100508,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2120732394,"text":"Hmm, what does the other document say...?","nextNodeIds":[732100510]},{"nodeId":732100510,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1860886114,"text":"Hmm... Paimon didn't understand a thing!","nextNodeIds":[732100511,732100513]},{"nodeId":732100511,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3934900114,"text":"I didn't get it either...","nextNodeIds":[732100512]},{"nodeId":732100512,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3349217362,"text":"Paimon only understood the part that goes \"God's voice guides me\"... Does that mean there'll be unique voices guiding us here?","nextNodeIds":[732100515]},{"nodeId":732100515,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":139965586,"text":"It could be underground water flow or creature activity...","nextNodeIds":[732100516]},{"nodeId":732100516,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2753321666,"text":"Yeah! Who knows, there might be some underground ruins! Let's listen for any sounds and take a closer look when we hear something!","nextNodeIds":[]},{"nodeId":732100513,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1737131498,"text":"Ignorance might be bliss here, to be honest...","nextNodeIds":[732100514]},{"nodeId":732100514,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2720083746,"text":"Eh? You understood it? Paimon only got the bit that goes \"God's voice guides me\"... Does that mean there'll be unique voices guiding us here?","nextNodeIds":[732100515]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7321005,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7321003,"order":97,"stepDescription":"","stepDescTextMapHash":2203543284,"finishConds":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7321002,"order":98,"stepDescription":"","stepDescTextMa