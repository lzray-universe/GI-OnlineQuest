EST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":2201706,"initDialog":220170601,"nextRandomTalks":[],"nextTalks":[],"npcId":[3033,3032],"performCfg":"","priority":5,"questId":22017,"showRandomTalkCount":0},"dialogs":[{"nodeId":220170601,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1556257242,"text":"I think this novel has the same fantasy background as \"Onibudou\"...","nextNodeIds":[220170602]},{"nodeId":220170602,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":755634002,"text":"Yes. The setting in this novel is very popular. The author even wrote a book just about the details of the world, and that one sold like hotcakes!","nextNodeIds":[220170603]},{"nodeId":220170603,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":380437314,"text":"However, the features of the setting are presented to the reader from the very beginning and more aren't added in halfway through. Plus, it's all relevant to the plot.","nextNodeIds":[220170604]},{"nodeId":220170604,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":4059770402,"text":"Uh... well... Traveler, do we have any other books here...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201706,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["2201703"],"PAINLIBBLDK":"QUEST_EXEC_ROLLBACK_QUEST"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJA