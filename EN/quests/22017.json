01,"nextRandomTalks":[],"nextTalks":[],"npcId":[3032,3033],"performCfg":"","priority":5,"questId":22017,"showRandomTalkCount":0},"dialogs":[{"nodeId":220170101,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2161647658,"text":"I'm done! I don't care how much you beg! I quit being a writer!","nextNodeIds":[220170102]},{"nodeId":220170102,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":639736746,"text":"Archons... this is the seventh time you've threatened me with a strike... and not once was it a serious threat.","nextNodeIds":[220170103]},{"nodeId":220170103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1029489138,"text":"What are you guys fighting about this time...","nextNodeIds":[220170104]},{"nodeId":220170104,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":727070090,"text":"You're finally here, Traveler! You have to help me!","nextNodeIds":[220170105]},{"nodeId":220170105,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2775669186,"text":"He's been going overboard ever since you took his side the last time. He's been laying down dozens of rules for me!","nextNodeIds":[220170106]},{"nodeId":220170106,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":4185520634,"text":"From naming to plot design. He wants to make a set of... writing standards!","nextNodeIds":[220170107]},{"nodeId":220170107,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3522875338,"text":"How am I supposed to write like this!? Why doesn't he just write it then!?","nextNodeIds":[220170108]},{"nodeId":220170108,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":982012826,"text":"These are principles of writing that I've extracted from successful novels. They are tried and true guidelines.","nextNodeIds":[220170109]},{"nodeId":220170109,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3636138314,"text":"That's imposing the formula of other novels onto my work. Am I writing my own novel, or am I copying someone else's?","nextNodeIds":[220170110]},{"nodeId":220170110,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2227080954,"text":"I would never write so rigidly... If you want something like that, you should write it yourself!","nextNodeIds":[220170111]},{"nodeId":220170111,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":4264693186,"text":"Besides, aren't there already a lot of these novels rotting away in the Yae Publishing House?","nextNodeIds":[220170112]},{"nodeId":220170112,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":3605028402,"text":"That's just poor marketing, not the novel itself...","nextNodeIds":[220170113]},{"nodeId":220170113,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":157369450,"text":"It had nothing to do with the sales strategy. It's purely because of the way those authors wrote their novels.","nextNodeIds":[220170114]},{"nodeId":220170114,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1760707194,"text":"You may not know them all, but I, as an author, have read every book published by Yae Publishing House.","nextNodeIds":[220170115]},{"nodeId":220170115,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1176654362,"text":"Traveler, could you get some novels for me? Shigeru and I need to have an important discussion.","nextNodeIds":[220170116,220170117]},{"nodeId":220170116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3220112418,"text":"I've got you.","nextNodeIds":[]},{"nodeId":220170117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2390135154,"text":"What novels should I bring?","nextNodeIds":[220170118]},{"nodeId":220170118,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":936028562,"text":"Just bring me the novels that I keep around. I often use them as a warning to myself... of what not to write.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["3033","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2201702,"order":2,"stepDescription":"Collect three light novels that meet the requirements","stepDescTextMapHash":379109996,"finishConds":[{"BFGALAINLMD":3,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1332201501"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22017_Target","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[2201702],"talks":[{"talkId":2201702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""]