STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":2201704,"initDialog":220170401,"nextRandomTalks":[],"nextTalks":[],"npcId":[3033,3032],"performCfg":"","priority":5,"questId":22017,"showRandomTalkCount":0},"dialogs":[{"nodeId":220170401,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1490187410,"text":"I remember this one. This suspense novel was popular for a long time, wasn't it?","nextNodeIds":[220170402]},{"nodeId":220170402,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":4186727490,"text":"The reason for its success is because of the clever mysteries and plot structure.","nextNodeIds":[220170403]},{"nodeId":220170403,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":2194205642,"text":"Although many readers have said that part of the plot is impossible to follow, the author still stuck to their own principles.","nextNodeIds":[220170404]},{"nodeId":220170404,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1342225450,"text":"That's why this novel stands out from other suspense novels.","nextNodeIds":[220170405]},{"nodeId":220170405,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1074860122,"text":"But doesn't this novel also have a solid setting? A solid setting that isn't easily altered is the key to support the plot of this sort of suspense novel.","nextNodeIds":[220170406]},{"nodeId":220170406,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2301071074,"text":"Uh... well... Traveler, do we have any other books here...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["2201703"],"PAINLIBBLDK":"QUEST_EXEC_ROLLBACK_QUEST"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":2201705,"order":6,"stepDescription":"Talk to Shigeru","stepDescTextMapHash":3071624084,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201705,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3033","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2201705],"talks":[{"talkId":2201705,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2201705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":2201705,"initDialog":220170501,"nextRandomTalks":[],"nextTalks":[],"npcId":[3033,3032],"performCfg":"","priority":5,"questId":22017,"showRandomTalkCount":0},"dialogs":[{"nodeId":220170501,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":191194850,"text":"How about this one, then? I remember its writing was excellent and its plot was well-designed. It was highly praised by the editors. Also, its sales were excellent.","nextNodeIds":[220170502]},{"nodeId":220170502,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1472193226,"text":"...Was it, though?","nextNodeIds":[220170503]},{"nodeId":220170503,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1627115930,"text":"It was so caught up with the rigid plot and setting that it didn't have any room for expansion in the story. In the end, it just became repetitive.","nextNodeIds":[220170504]},{"nodeId":220170504,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1896572738,"text":"It gradually lost readers because it lacked fresh stories. In the end, it lost all of its readers and fizzled out ignominiously.","nextNodeIds":[220170505]},{"nodeId":220170505,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":2011702362,"text":"Whether it's the setting or the plot, if you put yourself inside a box, all your stories will look the same. You'll stagnate.","nextNodeIds":[220170506]},{"nodeId":220170506,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3037428938,"text":"I don't want my novel to be like that! The most important thing a story should have is life!","nextNodeIds":[220170507]},{"nodeId":220170507,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3858435090,"text":"If... if the author himself is not interested in his own story, how can he make the reader feel that same passion?","nextNodeIds":[220170508]},{"nodeId":220170508,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3522608906,"text":"Shigeru!","nextNodeIds":[220170509]},{"nodeId":220170509,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":2884189370,"text":"...I see.","nextNodeIds":[220170510]},{"nodeId":220170510,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":176002034,"text":"I didn't know that you thought so much about these things. No wonder you wrote a novel like \"Onibudou.\"","nextNodeIds":[220170511]},{"nodeId":220170511,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":984185834,"text":"I don't want to limit your creativity, but I've seen too many authors ruin their work because of their excessive imagination...","nextNodeIds":[220170512]},{"nodeId":220170512,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":3585986378,"text":"Junkichi, what do you think of creativity as a writer?","nextNodeIds":[220170513]},{"nodeId":220170513,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1588726858,"text":"I believe that it's the desire to create. A writer who has no desire to create won't be able to write words that attract readers.","nextNodeIds":[220170514]},{"nodeId":220170514,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1235843690,"text":"In my opinion, it's more important still for a writer to exercise restraint in expressing that creative desire.","nextNodeIds":[220170515,220170516]},{"nodeId":220170515,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":509648554,"text":"You two still can't reach a consensus...","nextNodeIds":[220170517]},{"nodeId":220170517,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3506604002,"text":"Shigeru, I...","nextNodeIds":[220170518]},{"nodeId":220170518,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":450958682,"text":"But I'm not the author of this novel. You are. I'm just an editor who needs to help you finish it.","nextNodeIds":[220170519]},{"nodeId":220170519,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":135751522,"text":"If you insist on your ideas, then create them as you wish.","nextNodeIds":[220170520]},{"nodeId":220170520,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":3895154402,"text":"I can't say that I agree with you. But I will try to understand you.","nextNodeIds":[220170521]},{"nodeId":220170521,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":3980779410,"text":"Ah... thank you, Shigeru!","nextNodeIds":[220170522]},{"nodeId":220170522,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":1067634882,"text":"You're welcome. Of course, I get where you're coming from. But you need to understand my position, too. For example...","nextNodeIds":[220170523]},{"nodeId":220170523,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","textMapHash":1567646370,"text":"Uh, what is it?","nextNodeIds":[220170524]},{"nodeId":220170524,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","textMapHash":3408394162,"text":"For example, it's been another day, where is your manuscript!?","nextNodeIds":[]},{"nodeId":220170516,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2520231682,"text":"I guess he is not convinced...","nextNodeIds":[220170517]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201705,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["100861,100862,100863"],"PAINLIBBLDK":"QUEST_EXEC_DEL_ALL_SPECIFIC_PACK_ITEM"},{"LNHLPKELCAL":["22017","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["41030"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3033","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2201701,2201702,2201703,2201704,2201705,2201706],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"Junkichi","count":29},{"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"Shigeru","count":21