{"mainQuestId":71531,"title":"Paper Shadow Ruminations","description":"On the bustling streets of Liyue Harbor, you and Paimon are drawn to a painter making paper cutouts. You spy two familiar silhouettes among the items she is preparing...","titleTextMapHash":1215171663,"descTextMapHash":2120929662,"mainQuestExcel":{"mainQuestId":71531,"titleTextMapHash":1215171663,"title":"Paper Shadow Ruminations","descTextMapHash":2120929662,"description":"On the bustling streets of Liyue Harbor, you and Paimon are drawn to a painter making paper cutouts. You spy two familiar silhouettes among the items she is preparing...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":2028,"luaPath":"Actor/Quest/WQ71531","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2028,"chapterId":0,"descTextMapHash":2120929662,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71531,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2721882249,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71531","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171531],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1215171663,"type":"WQ","unlockDescTextMapHash":832757686}},"flow":[{"subQuestId":7153101,"order":1,"stepDescription":"Talk to Wenxun","stepDescTextMapHash":1043616692,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30458"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7153101],"talks":[{"talkId":7153101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7153101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7153101,"initDialog":715310101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30458],"performCfg":"QuestDialogue/WQ/Liyue_71531/Q7153101","priority":5,"questId":71531,"showRandomTalkCount":0},"dialogs":[{"nodeId":715310101,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":1919536330,"text":"Round and fluffy, soft and bouncy, jump and bump...","nextNodeIds":[715310102]},{"nodeId":715310102,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":3307509274,"text":"Oh my! Guests! Welcome, welcome, and allow me, Wenxun, to be the first to wish the two of you a joyous Lantern Rite!","nextNodeIds":[715310103]},{"nodeId":715310103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2426779882,"text":"Happy Lantern Rite, Ms. Wenxun!","nextNodeIds":[715310104]},{"nodeId":715310104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4140188522,"text":"You seemed to be reciting something just now. What were you talking to yourself about?","nextNodeIds":[715310105,715310106]},{"nodeId":715310105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2074791010,"text":"Considering some delectable dessert?","nextNodeIds":[715310107]},{"nodeId":715310107,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":1970756674,"text":"Not far off the mark — nearly a hole-in-one! I was just thinking about the food Guoba and Yuegui are gonna make!","nextNodeIds":[715310108]},{"nodeId":715310108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2739361690,"text":"Eh? Now those are names we know... You know Guoba and Yuegui too?","nextNodeIds":[715310109]},{"nodeId":715310109,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":1267051738,"text":"Hehe, how could I not? You're looking at one of Wanmin Restaurant's regulars, you know!","nextNodeIds":[715310110]},{"nodeId":715310110,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":3839299930,"text":"As long as I'm not on the road, I eat at least seven meals a week at Wanmin Restaurant!","nextNodeIds":[715310111]},{"nodeId":715310111,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":2669220290,"text":"When paired with my hometown style of cooking — first some lightly seasoned fare, then a spicy flavor bomb — it's just a smash hit!","nextNodeIds":[715310112]},{"nodeId":715310112,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":651128722,"text":"If I end up with too much heatiness, just need to down some of the right meds and flush it right out, and then after a couple of days recuperating, it's back to gorging myself in chow-town!","nextNodeIds":[715310113,715310114]},{"nodeId":715310113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3764194522,"text":"That sounds amazing...","nextNodeIds":[715310115]},{"nodeId":715310115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2746467602,"text":"P—P—Paimon also wants to try living like that...","nextNodeIds":[715310116]},{"nodeId":715310116,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":2985893170,"text":"Anyway, I get to see Guoba and Xiangling pretty much every week, and sometimes even little Yaoyao.","nextNodeIds":[715310117]},{"nodeId":715310117,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":1851398242,"text":"When Yaoyao brings Yuegui along to see Xiangling, Guoba and Yuegui end up playing together.","nextNodeIds":[715310118]},{"nodeId":715310118,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":2757615250,"text":"Ahh, it's wonderful! No matter how exhausting work is, just watching them shake and sway is enough to sweep all your cares away!","nextNodeIds":[715310119]},{"nodeId":715310119,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":576513938,"text":"But I can't be the only one being cured by Guoba and Yuegui! I want everyone to bear witness to their cuteness for themselves!","nextNodeIds":[715310120]},{"nodeId":715310120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":919430954,"text":"Well said! Now this is something important! But just how do you plan to do it?","nextNodeIds":[715310121]},{"nodeId":715310121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":926863010,"text":"Unless... These things on the table are...","nextNodeIds":[715310122]},{"nodeId":715310122,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":3198813554,"text":"Bingo! I just made a \"paper theater\" featuring Guoba and Yuegui as the stars! Everything you see here at this stall is a prop for the paper theater!","nextNodeIds":[715310123]},{"nodeId":715310123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2454238794,"text":"\"Paper Theater\"... That name sounds kinda familiar, doesn't it? Is it about the canvas behind you, and watching the... shadows on it?","nextNodeIds":[715310124]},{"nodeId":715310124,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":1641441050,"text":"You guys may have heard of \"Paper Plays,\" a traditional Liyue art form. By artfully using the pictures and lights, you can make the scenes on the screen come to life.","nextNodeIds":[715310125]},{"nodeId":715310125,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":3191655978,"text":"I've loved paper plays since I was a kid, and learned a bit about them from Master Yinggong. After I grew up, I became a painter, studying and traveling all over.","nextNodeIds":[715310126]},{"nodeId":715310126,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":440340170,"text":"While I was in Fontaine, I learned a few new drawing techniques and a thing or two about filming. I had quite a few sparks of inspiration, too.","nextNodeIds":[715310127]},{"nodeId":715310127,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":2116670770,"text":"So, using paper plays as a basis, I tried creating a novel interactive game, and thus, the \"paper theater\" you see before you was born!","nextNodeIds":[715310128]},{"nodeId":715310128,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":37512898,"text":"Paper theater and paper plays also have very different styles. Paper theater focuses on simple, short stories that'll bring a smile to the audience.","nextNodeIds":[715310129]},{"nodeId":715310129,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":2823830482,"text":"So, that's why this year's first paper theater will be all about an especially amiable story — Guoba and Yuegui looking for ingredients to cook up something delicious together!","nextNodeIds":[715310130]},{"nodeId":715310130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4126442930,"text":"Guoba and Yuegui cooking together? That sounds really interesting!","nextNodeIds":[715310131,715310132]},{"nodeId":715310131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":623017842,"text":"Fun and food in one place!","nextNodeIds":[715310133]},{"nodeId":715310133,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":2231600386,"text":"Hehe, looks like you two are totally on board! Your excitement is inspiring!","nextNodeIds":[715310134]},{"nodeId":715310134,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","textMapHash":1067342194,"text":"Then there's no time to lose! Please, just relax, and get ready to enjoy this paper theater performance!","nextNodeIds":[]},{"nodeId":715310132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2493532314,"text":"Now that's worth paying attention to.","nextNodeIds":[715310133]},{"nodeId":715310114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":875182410,"text":"Best take it easy...","nextNodeIds":[715310115]},{"nodeId":715310106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1336420458,"text":"Or perhaps a revolutionary recipe?","nextNodeIds":[715310107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30458"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7153101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"Wenxun","count":20},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171531],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2120929662,"CHECNJEMEFE":{"30458":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Liyue_7