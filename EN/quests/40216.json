ULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_12552:1726.389,259.084,9860.606,0.000,42.547,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7665305],"talks":[{"talkId":7665305,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4021601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7665305,"initDialog":766530501,"nextRandomTalks":[],"nextTalks":[],"npcId":[15897],"performCfg":"QuestDialogue/EQ/V6.0ActivityNodKraiTour_76653/Q7665305","priority":5,"questId":40216,"showRandomTalkCount":0},"dialogs":[{"nodeId":766530501,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":3145715778,"text":"Hmm... Should I continue my research or not?","nextNodeIds":[766530502]},{"nodeId":766530502,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3881012434,"text":"What's this?","nextNodeIds":[766530503]},{"nodeId":766530503,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1342072170,"text":"Zip-Zap Spy-Bot Number 1!","nextNodeIds":[766530504]},{"nodeId":766530504,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":352613330,"text":"Zip-Zap what now?","nextNodeIds":[766530505]},{"nodeId":766530505,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3632639370,"text":"To be precise, this is a testing platform for Zip-Zap Spy-Bot Number 1, the latest stealth robot of Aino's design.","nextNodeIds":[766530506]},{"nodeId":766530506,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3858822682,"text":"She recently purchased an abandoned cleaning bot from the black market. After modifying it, she created the Zip-Zap Spy-Bot Number 1 you see here today.","nextNodeIds":[766530507]},{"nodeId":766530507,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3353220010,"text":"This platform has simulated several hostile environments to test the robot's ability to maintain stealth under pressure.","nextNodeIds":[766530508]},{"nodeId":766530508,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2448475266,"text":"Why's Aino making this stealth robot again?","nextNodeIds":[766530509]},{"nodeId":766530509,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2294054090,"text":"After the theft of Krum-Clank 70% Sweet, Aino made up her mind, and declared: \"No matter how powerful the foe, we have to rescue our friends!\"","nextNodeIds":[766530510]},{"nodeId":766530510,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":747614106,"text":"Then she quickly completed the draft of Zip-Zap Spy-Bot Number 1 and started its development.","nextNodeIds":[766530511]},{"nodeId":766530511,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1800646210,"text":"According to her plan, once the development is complete, it should be able to infiltrate even the heavily guarded Kuuvahki Experimental Design Bureau with ease to rescue our friends.","nextNodeIds":[766530512]},{"nodeId":766530512,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":352855146,"text":"That sounds pretty awesome!","nextNodeIds":[766530513]},{"nodeId":766530513,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3041734698,"text":"But Aino soon realized that perfecting the plan would take far too long — so she wanted to abandon the idea. As per her calculations, it would be much faster to just turn all of Nod-Krai upside down.","nextNodeIds":[766530514]},{"nodeId":766530514,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","textMapHash":1224506258,"text":"I've made up my mind! Since we're taking things nice, chill, and easy, I'll just keep working on Zip-Zap Spy-Bot Number 1! It'll definitely help us save our friends!","nextNodeIds":[766530515]},{"nodeId":766530515,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":3171975938,"text":"In that case, could we ask you two to assist with the tests?","nextNodeIds":[766530516]},{"nodeId":766530516,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":1017006874,"text":"Based on past statistics, having data provided by other testers as reference will increase Aino's development speed by at least 30%.","nextNodeIds":[766530517]},{"nodeId":766530517,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2141831874,"text":"Count Paimon in! This sounds like fun!","nextNodeIds":[766530518]},{"nodeId":766530518,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2625891074,"text":"I'll help too.","nextNodeIds":[766530519]},{"nodeId":766530519,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","textMapHash":2348450474,"text":"Then I thank you both on Aino's behalf. I will grant you access permissions to the platform — from now on, you can use it for any testing you need to conduct.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_12552:1726.389,259.084,9860.606,0.000,42.547,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7665305],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"Ineffa","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"Aino","count":3},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[140216],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3258293662,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAG