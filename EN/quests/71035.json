:["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7103506","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7103503,"initDialog":710350301,"nextRandomTalks":[],"nextTalks":[],"npcId":[12326,1005,10204],"performCfg":"QuestDialogue/WQ/Liyue_71035/Q7103503","priority":5,"questId":71035,"showRandomTalkCount":0},"dialogs":[{"nodeId":710350301,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":893495026,"text":"Thank you, O mighty adeptus, thank you, mighty hero! ...Oh, what are the odds? We meet again.","nextNodeIds":[710350302]},{"nodeId":710350302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4066377554,"text":"You know us?","nextNodeIds":[710350303]},{"nodeId":710350303,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3045594634,"text":"How could I forget you...","nextNodeIds":[710350304]},{"nodeId":710350304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1968489890,"text":"You're...","nextNodeIds":[710350305]},{"nodeId":710350305,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3745022122,"text":"I'm Wang Ping'an! Don't you remember me?","nextNodeIds":[710350306,710350308]},{"nodeId":710350306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4288931450,"text":"Ah, \"Starsnatcher\"?","nextNodeIds":[710350307]},{"nodeId":710350307,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":329168906,"text":"Huh!? What? What \"Starsnatcher\"? ...Please, l—let's not bring that up, not in front of the adeptus...","nextNodeIds":[710350310]},{"nodeId":710350310,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":4222786826,"text":"I was just getting ready to make an offering at the temple of the Yaksha, Pervases.","nextNodeIds":[710350311]},{"nodeId":710350311,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1716706474,"text":"But not long after I entered the mountains, I was set upon by those Treasure Hoarders... Thank you for saving me...","nextNodeIds":[710350312]},{"nodeId":710350312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1166115610,"text":"Wait a moment. What were you going to do at Pervases' temple?","nextNodeIds":[710350313]},{"nodeId":710350313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2750683234,"text":"Were you planning to do something bad to his statue?","nextNodeIds":[710350314]},{"nodeId":710350314,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":4014861170,"text":"No, no! I wouldn't dream of it!","nextNodeIds":[710350315]},{"nodeId":710350315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3536117986,"text":"Then what were you planning to do?","nextNodeIds":[710350316]},{"nodeId":710350316,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":2782220578,"text":"I... I wanted to restore the temple.","nextNodeIds":[710350317]},{"nodeId":710350317,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":472314106,"text":"My plan today was to closely examine the temple's current condition and arrange for the purchase of the appropriate materials.","nextNodeIds":[710350318]},{"nodeId":710350318,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":2964318618,"text":"I never expected to be targeted halfway by Treasure Hoarders and forced to flee.","nextNodeIds":[710350319]},{"nodeId":710350319,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1288997850,"text":"But as I ran, I... lost my way. As for the rest, you know what happened.","nextNodeIds":[710350320]},{"nodeId":710350320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3021137266,"text":"Let's speak further at the temple.","nextNodeIds":[710350321]},{"nodeId":710350321,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":2653965546,"text":"Right, this is hardly the place for conversation. Let's go to the temple first.","nextNodeIds":[710350322]},{"nodeId":710350322,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3104059058,"text":"We'll speak there.","nextNodeIds":[710350323]},{"nodeId":710350323,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":2501669714,"text":"Go. I have other things to handle.","nextNodeIds":[710350324]},{"nodeId":710350324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2451965634,"text":"Eh? You're leaving already?","nextNodeIds":[710350325]},{"nodeId":710350325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2219528818,"text":"...And he's gone.","nextNodeIds":[]},{"nodeId":710350308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1636775370,"text":"Yeah, I remember you.","nextNodeIds":[710350309]},{"nodeId":710350309,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":4225698362,"text":"Ah, good, good.","nextNodeIds":[710350310]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12326"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7103507,"order":7,"stepDescription":"Go back to the Pervases statue","stepDescTextMapHash":2532799876,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103507,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7103503_N10204_310701425","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103507,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7103503_N10204_310701425","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7103508,"order":8,"stepDescription":"Talk to Wang Ping'an","stepDescTextMapHash":4293074340,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12326"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7103504],"talks":[{"talkId":7103504,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7103508","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7103504,"initDialog":710350401,"nextRandomTalks":[],"nextTalks":[],"npcId":[12326,1005],"performCfg":"QuestDialogue/WQ/Liyue_71035/Q7103504","priority":5,"questId":71035,"showRandomTalkCount":0},"dialogs":[{"nodeId":710350401,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":4147721114,"text":"This temple is in a terrible state...","nextNodeIds":[710350402]},{"nodeId":710350402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":383215634,"text":"Alright, mister, where did you suddenly get the idea to come and fix this temple?","nextNodeIds":[710350403]},{"nodeId":710350403,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3752397114,"text":"Heh... Well, that's a long story...","nextNodeIds":[710350404]},{"nodeId":710350404,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":2584725058,"text":"Back when I was pretending to be an adeptus, I gathered a lot of resources to help me keep up the act...","nextNodeIds":[710350405]},{"nodeId":710350405,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1966071482,"text":"But remember how I swore to do good after that adeptus taught me a lesson? Well, after I returned, I was planning to destroy all those materials of mine.","nextNodeIds":[710350406]},{"nodeId":710350406,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1911946722,"text":"But then I had a thought... Rather than destroying all this information, wouldn't it be better to write up my code of charlatanry and share it with others?","nextNodeIds":[710350407]},{"nodeId":710350407,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3409728618,"text":"That way, I can help others to see through scams and cheaters...","nextNodeIds":[710350408]},{"nodeId":710350408,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1897777762,"text":"To my surprise, the guidebook I wrote proved helpful to a lot of people. Even the Ministry of Civil Affairs said that it was very useful.","nextNodeIds":[710350409]},{"nodeId":710350409,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":4020107786,"text":"They even provided me with some additional scam countermeasures to add to the stuff that I'd written myself...","nextNodeIds":[710350410]},{"nodeId":710350410,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":512522202,"text":"To that end, they paid me a pretty hefty sum.","nextNodeIds":[710350411]},{"nodeId":710350411,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3385262618,"text":"Apart from that guidebook, I'm currently planning to write a book about the Vigilant Yaksha.","nextNodeIds":[710350412]},{"nodeId":710350412,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1892070186,"text":"Its purpose, of course, is to share the stories of the Vigilant Yaksha with as many people as possible.","nextNodeIds":[710350413]},{"nodeId":710350413,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1926547058,"text":"That way, I'll be able to put the folklore knowledge I possess to good use.","nextNodeIds":[710350414]},{"nodeId":710350414,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":2053042986,"text":"As for this temple to Pervases, I discovered it while I was compiling material for this second book.","nextNodeIds":[710350415]},{"nodeId":710350415,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3647946802,"text":"I found sources saying that this temple was built by our forebears to remember the Yaksha, Pervases.","nextNodeIds":[710350416]},{"nodeId":710350416,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1766335906,"text":"But I never expected to find the temple in such a state of disrepair...","nextNodeIds":[710350417]},{"nodeId":710350417,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1826521074,"text":"When I returned and thought about it, I decided to fund the repair of this temple from my own pocket.","nextNodeIds":[710350418]},{"nodeId":710350418,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":711150674,"text":"After all, I, too, was guided back to the right path by an adeptus.","nextNodeIds":[710350419]},{"nodeId":710350419,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":2003329858,"text":"I suppose repairing this temple can be considered atonement for my previous wrongdoings.","nextNodeIds":[710350420]},{"nodeId":710350420,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1485631066,"text":"Hmm... sounds genuine enough...","nextNodeIds":[710350421]},{"nodeId":710350421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1762228138,"text":"#What do you think, {NICKNAME}?","nextNodeIds":[710350422,710350424]},{"nodeId":710350422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":839638650,"text":"Sounds kinda genuine.","nextNodeIds":[710350423]},{"nodeId":710350423,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3390370178,"text":"What do you mean \"kinda\"? I AM being genuine! One hundred percent genuine!","nextNodeIds":[710350426]},{"nodeId":710350426,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":1664919674,"text":"*sigh* Oh, fine, think whatever you like.","nextNodeIds":[710350427]},{"nodeId":710350427,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":4097522890,"text":"If you don't trust me, then come back once work has started. You'll see.","nextNodeIds":[]},{"nodeId":710350424,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2973950978,"text":"That said, you've tried to fool us before...","nextNodeIds":[710350425]},{"nodeId":710350425,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":3839317346,"text":"But I gave all that up! I'm an upstanding citizen now! Didn't I swear to that before that adeptus?","nextNodeIds":[710350426]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDAN