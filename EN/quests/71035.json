":710350206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2355001514,"text":"...Aw, but this place is in as much of a mess as last time...","nextNodeIds":[710350207]},{"nodeId":710350207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2284739522,"text":"There's a temple here, and a statue, too... Why doesn't anyone come to maintain this place?","nextNodeIds":[710350208]},{"nodeId":710350208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4270348522,"text":"Perhaps this place has been forgotten.","nextNodeIds":[710350209]},{"nodeId":710350209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3129833794,"text":"How could people forget something like this? The Yakshas are heroes who defended Liyue Harbor...","nextNodeIds":[710350210]},{"nodeId":710350210,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":2048155610,"text":"...","nextNodeIds":[710350211]},{"nodeId":710350211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1388284698,"text":"Xiao, are... are you angry?","nextNodeIds":[710350212]},{"nodeId":710350212,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":1809343234,"text":"No. The Yakshas did not perform their duty for any form of recognition.","nextNodeIds":[710350213]},{"nodeId":710350213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1605080994,"text":"...Eh, let's not talk about this stuff right now. Grilled Tiger Fish first!","nextNodeIds":[710350214]},{"nodeId":710350214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":104888290,"text":"Uh, and if you wanna have some, Xiao, we can give you half of our share each.","nextNodeIds":[710350215]},{"nodeId":710350215,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":2964574842,"text":"It's fine...","nextNodeIds":[710350216]},{"nodeId":710350216,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"Wang Ping'an","textMapHash":829938466,"text":"Help! Help me!","nextNodeIds":[710350217]},{"nodeId":710350217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2676654330,"text":"Huh? Did you hear that?","nextNodeIds":[710350218]},{"nodeId":710350218,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"Xiao","textMapHash":228072378,"text":"There. Someone's calling for help.","nextNodeIds":[710350219]},{"nodeId":710350219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1098276898,"text":"Let's go!","nextNodeIds":[710350220]},{"nodeId":710350220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":968639322,"text":"Eh!? What about the Grilled Tiger Fish? Paimon hasn't eaten yet!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10204"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7103505,"order":5,"stepDescription":"Save the person in danger","stepDescTextMapHash":1593650964,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q71035SaveWPA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLN