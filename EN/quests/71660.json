OHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1587"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166001],"talks":[{"talkId":7166001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7166002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166001,"initDialog":716600101,"nextRandomTalks":[],"nextTalks":[],"npcId":[2083,1587],"performCfg":"QuestDialogue/WQ/Liyue_71660/Q7166001","priority":5,"questId":71660,"showRandomTalkCount":0},"dialogs":[{"nodeId":716600101,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":941644490,"text":"You're back! How are the Smoldersleet Potions performing?","nextNodeIds":[716600102,716600105]},{"nodeId":716600102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2564780514,"text":"I just wish we could use it outside Domains.","nextNodeIds":[716600103]},{"nodeId":716600103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3965409082,"text":"Yup! That would take the cake!","nextNodeIds":[716600104]},{"nodeId":716600104,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2423778114,"text":"Oh? Seems like you liked it. Go on then, give us the details!","nextNodeIds":[716600108]},{"nodeId":716600108,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":772616978,"text":"You explain what happened during the test run in detail.","nextNodeIds":[716600109]},{"nodeId":716600109,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":499181106,"text":"It's just as you predicted, Ms. Ying'er!","nextNodeIds":[716600110]},{"nodeId":716600110,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2394166282,"text":"Our path for improvement is clear — we must somehow contain the sublimated substances within a set area.","nextNodeIds":[716600111]},{"nodeId":716600111,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":100992026,"text":"Perhaps we could reverse the special characteristics of dandelions to create special excipients that can prevent the substances from being affected by the flow of air.","nextNodeIds":[716600112]},{"nodeId":716600112,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":549133450,"text":"There is no precedent to such a method though, and we will need a great number of trials to prove its feasibility.","nextNodeIds":[716600113]},{"nodeId":716600113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":199665858,"text":"Wow, Paimon couldn't make sense of that at all.","nextNodeIds":[716600114]},{"nodeId":716600114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":349982690,"text":"Still, it feels like you made some important suggestions each time, Ms. Ying'er.","nextNodeIds":[716600115]},{"nodeId":716600115,"roleType":"TALK_ROLE_NPC","speakerId":2083,"speakerName":"Ying'er","textMapHash":17948338,"text":"Ah, I don't think I ever came up with such a detailed postulation.","nextNodeIds":[716600116]},{"nodeId":716600116,"roleType":"TALK_ROLE_NPC","speakerId":2083,"speakerName":"Ying'er","textMapHash":3714506058,"text":"Well, my hardworking alchemist, are you trying to fathom my depths, or are you just trying to please me through flattery?","nextNodeIds":[716600117]},{"nodeId":716600117,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":712594122,"text":"I—I'm just expressing my admiration for your knowledge!","nextNodeIds":[716600118]},{"nodeId":716600118,"roleType":"TALK_ROLE_NPC","speakerId":2083,"speakerName":"Ying'er","textMapHash":1180396154,"text":"Alright, alright. You'd best give it your all, now. Who knows? You might have to use some alternative sources of knowledge in the future, too.","nextNodeIds":[716600119]},{"nodeId":716600119,"roleType":"TALK_ROLE_NPC","speakerId":2083,"speakerName":"Ying'er","textMapHash":3602515474,"text":"Don't forget to keep me posted once your research succeeds.","nextNodeIds":[716600120]},{"nodeId":716600120,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2496201778,"text":"Of course! When that time comes, I'll send you my best potions as a memento!","nextNodeIds":[716600121]},{"nodeId":716600121,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2160688370,"text":"You know, Ms. Ying'er, if you have the time, would you like to come with us to Wanmin Restaurant...?","nextNodeIds":[716600122]},{"nodeId":716600122,"roleType":"TALK_ROLE_NPC","speakerId":2083,"speakerName":"Ying'er","textMapHash":4116413122,"text":"Oh, I'm afraid our academic exchange must come to an end for now. There are still many matters I must attend to at Scent of Spring.","nextNodeIds":[716600123]},{"nodeId":716600123,"roleType":"TALK_ROLE_NPC","speakerId":2083,"speakerName":"Ying'er","textMapHash":4170422090,"text":"Don't forget to drop by often~","nextNodeIds":[716600124]},{"nodeId":716600124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2356589546,"text":"We will!","nextNodeIds":[716600125]},{"nodeId":716600125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2980108626,"text":"Thanks, Ms. Ying'er!","nextNodeIds":[716600126]},{"nodeId":716600126,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3586732362,"text":"Ying'er leaves.","nextNodeIds":[716600127]},{"nodeId":716600127,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":106628578,"text":"*sigh* I couldn't say it in the end, huh?","nextNodeIds":[716600128]},{"nodeId":716600128,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3660745298,"text":"But considering that I'd already given her so much trouble, it was probably for the best that I didn't take up any more of her time.","nextNodeIds":[716600129]},{"nodeId":716600129,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":2479906914,"text":"Alright then. We'll calm down a bit, and wait for a suitable opportunity...","nextNodeIds":[716600130]},{"nodeId":716600130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3677250906,"text":"What are you talking to yourself about, Timaeus?","nextNodeIds":[716600131]},{"nodeId":716600131,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":367728378,"text":"Uh, N—Nothing!","nextNodeIds":[716600132]},{"nodeId":716600132,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":954744354,"text":"Thanks for your help so far! As we agreed, I'll treat you both to a great meal at Wanmin Restaurant.","nextNodeIds":[716600133]},{"nodeId":716600133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":16488754,"text":"I'd almost forgotten...","nextNodeIds":[716600134]},{"nodeId":716600134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3888097026,"text":"Ooh, that's right! Alright, alright, alright! Time for a great big meal!","nextNodeIds":[716600135]},{"nodeId":716600135,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"Black Screen","textMapHash":3941591370,"text":"You go to Wanmin Restaurant with Timaeus and have a hearty meal.","nextNodeIds":[716600136]},{"nodeId":716600136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":862293226,"text":"Whew! Paimon's super full!","nextNodeIds":[716600137]},{"nodeId":716600137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4157192506,"text":"Actually, this research was pretty cool! You should bring us along next time you come to Liyue, Timaeus!","nextNodeIds":[716600138,716600139]},{"nodeId":716600138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":92073666,"text":"You know, Paimon, somehow I doubt that you're in it for the research.","nextNodeIds":[716600140]},{"nodeId":716600140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3821930562,"text":"C'mon! Paimon did help... ask for directions!","nextNodeIds":[716600141]},{"nodeId":716600141,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":601766178,"text":"Haha! Whatever the case, thank you both so much!","nextNodeIds":[716600142]},{"nodeId":716600142,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3797742802,"text":"But once I return to Mondstadt, I'll be throwing myself into improving the Smoldersleet Potion, so I'm afraid I won't be coming back to Liyue for some time.","nextNodeIds":[716600143]},{"nodeId":716600143,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":4040361546,"text":"Maybe I'll have to ask you to help me deliver a letter. I mean, I still haven't properly thanked Ms. Ying'er for her help.","nextNodeIds":[716600144]},{"nodeId":716600144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3595191546,"text":"Eh? Weren't you two discussing stuff the whole time? Why didn't you just tell her?","nextNodeIds":[716600145]},{"nodeId":716600145,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3776611482,"text":"*cough* Well, uh, Ms. Ying'er's manner of speech is just too... too special! I must consider my words very carefully, and in such cases, penning a letter is naturally superior to speaking face-to-face...","nextNodeIds":[716600146]},{"nodeId":716600146,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":3562231098,"text":"Well now, time presses. Let's head back to Mondstadt right now. Why, I can't wait to create the perfected version of my Smoldersleet Potion!","nextNodeIds":[716600147]},{"nodeId":716600147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2557324362,"text":"Traveler, do you get the feeling that Timaeus has been acting all weird ever since we said bye to Ms. Ying'er?","nextNodeIds":[716600148]},{"nodeId":716600148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3334220650,"text":"Paimon doesn't get it...","nextNodeIds":[]},{"nodeId":716600139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2146565802,"text":"You're just here for the free meal, aren't you?","nextNodeIds":[716600140]},{"nodeId":716600105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2968316634,"text":"I think there's room for improvement.","nextNodeIds":[716600106]},{"nodeId":716600106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2469632186,"text":"That's true... For example, it would be better if we could use it outside Domains!","nextNodeIds":[716600107]},{"nodeId":716600107,"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","textMapHash":288254850,"text":"True. I was just discussing the issue with Ms. Ying'er. Please, give us all the details.","nextNodeIds":[716600108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1587"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7166001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1587,"speakerName":"Timaeus","count":20},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":2083,"speakerName":"Ying'er","count":6},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"spe