{"mainQuestId":76500,"title":"A Gift of Memories","description":"In Nod-Krai, Paimon purchases a special gift for you at the market...","titleTextMapHash":4019883919,"descTextMapHash":1463769230,"mainQuestExcel":{"mainQuestId":76500,"titleTextMapHash":4019883919,"title":"A Gift of Memories","descTextMapHash":1463769230,"description":"In Nod-Krai, Paimon purchases a special gift for you at the market...","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5285,"luaPath":"Actor/Quest/WQ76500","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5285,"chapterId":0,"descTextMapHash":1463769230,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76500,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":1050499921,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76500","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176500],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4019883919,"type":"WQ","unlockDescTextMapHash":1994707006}},"flow":[{"subQuestId":7650001,"order":1,"stepDescription":"Go to Nasha Town","stepDescTextMapHash":4254536852,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_12536:1631.833,225.032,9442.872,0.000,340.537,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7650001],"talks":[{"talkId":7650001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7650001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7650001,"initDialog":765000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"QuestDialogue/WQ/NodKrai_76500/Q7650001","priority":5,"questId":76500,"showRandomTalkCount":0},"dialogs":[{"nodeId":765000101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1889574514,"text":"#{NICKNAME}! Over here! Paimon's got something awesome to show you!","nextNodeIds":[765000102]},{"nodeId":765000102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":454497290,"text":"Ta-da! Look at this! It took Paimon forever to dig up this treasure from that bustling market!","nextNodeIds":[765000103,765000104]},{"nodeId":765000103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4122266698,"text":"I say, this is... an elder statesman amongst Kameras.","nextNodeIds":[765000106]},{"nodeId":765000106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3847131474,"text":"According to the mysterious shopkeeper, this was the Kamera used by that super famous Fontainian photographer from a few decades ago: the legendary Pierre Leblanc!","nextNodeIds":[765000107]},{"nodeId":765000107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1075243562,"text":"Rumor has it that the photos he took with this Kamera were all smash hits, and they'd often make it onto the front page of The Steambird!","nextNodeIds":[765000108]},{"nodeId":765000108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":38385138,"text":"If you use this legendary Kamera, your photos will be like... doubly legendary! And then we can sell them for Mora!","nextNodeIds":[765000109,765000112]},{"nodeId":765000109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3083308538,"text":"This Kamera... was expensive, wasn't it?","nextNodeIds":[765000110]},{"nodeId":765000110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":385963842,"text":"It was okay! After all, Paimon's got her emergency funds to fall back on!","nextNodeIds":[765000111]},{"nodeId":765000111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2070543338,"text":"As long as you like it, Paimon's willing to empty her pockets!","nextNodeIds":[765000116,765000117]},{"nodeId":765000116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":202977466,"text":"Wow. In that case, thank you, Paimon. It's a wonderful gift.","nextNodeIds":[765000118]},{"nodeId":765000118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2447804538,"text":"Yay! Paimon's happy if you're happy! Now that we've arrived in a new nation, let's put this Kamera to good use and take pictures of all the new things we see!","nextNodeIds":[765000119]},{"nodeId":765000119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3831021106,"text":"Paimon's also prepared a new photo album for you, just for the occasion. Paimon's reliable AND thoughtful, you see!","nextNodeIds":[765000120]},{"nodeId":765000120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":709133242,"text":"Okie dokie, enough chitchat! Those photos aren't going to take themselves. Let's go!","nextNodeIds":[]},{"nodeId":765000117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3245981666,"text":"I'll make sure to take many legendary photos with it.","nextNodeIds":[765000118]},{"nodeId":765000112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1789721506,"text":"You didn't run into any shady merchants, did you, Paimon?","nextNodeIds":[765000113]},{"nodeId":765000113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":808175554,"text":"Relax! To be absolutely sure, Paimon already had a very reliable engineer verify it — this is definitely the exact model the great master Leblanc used back in the day, no doubt about it!","nextNodeIds":[765000114]},{"nodeId":765000114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1313263914,"text":"But wait, there's more! When the engineer opened it up, they found a tiny engraving inside with Leblanc's initials! That's hard evidence right there, hehe!","nextNodeIds":[765000115]},{"nodeId":765000115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":367454786,"text":"Paimon's such a reliable guide, isn't she? Come rain or shine, she won't let you down!","nextNodeIds":[765000116,765000117]},{"nodeId":765000104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1646422018,"text":"Are you getting into antiques, Paimon?","nextNodeIds":[765000105]},{"nodeId":765000105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1361113090,"text":"No, silly! This is a surprise gift Paimon prepared just for you!","nextNodeIds":[765000106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_12536:1631.833,225.032,9442.872,0.000,340.537,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7650001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[176500],"B