GUIDE_NONE"}}},{"subQuestId":1100003,"order":3,"stepDescription":"Talk to Xiangling","stepDescTextMapHash":3453989838,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1012"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1100003],"talks":[{"talkId":1100003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100003","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100003,"initDialog":110000301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1012],"performCfg":"QuestDialogue/LQ/Xiangling1_11000/Q1100003","priority":5,"questId":11000,"showRandomTalkCount":0},"dialogs":[{"nodeId":110000301,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":103901494,"text":"Shh! Keep it down, I'm hunting...","nextNodeIds":[110000302]},{"nodeId":110000302,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3990103550,"text":"I've always heard about the wide range of ingredients you can find in Mondstadt, and it looks like it's true!","nextNodeIds":[110000303,110000304]},{"nodeId":110000303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1886604438,"text":"Are you a hunter?","nextNodeIds":[110000305]},{"nodeId":110000305,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3925843278,"text":"No — I'm a chef! A chef on a mission to find rare and exotic ingredients from all corners of the world!","nextNodeIds":[110000306]},{"nodeId":110000306,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2356741734,"text":"My name's Xiangling, I'm from Liyue Harbor. And you?","nextNodeIds":[110000307]},{"nodeId":110000307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3318504694,"text":"#I'm {NICKNAME}.","nextNodeIds":[110000308]},{"nodeId":110000308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1665304990,"text":"Hello, my name's Paimon!","nextNodeIds":[110000309]},{"nodeId":110000309,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2092041366,"text":"Paimon!","nextNodeIds":[110000310]},{"nodeId":110000310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4292602606,"text":"Why are you looking at me like that?","nextNodeIds":[110000311]},{"nodeId":110000311,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":240512318,"text":"What an exotic creature, is it edible?","nextNodeIds":[110000312,110000314]},{"nodeId":110000312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2902851990,"text":"We're friends.","nextNodeIds":[110000313]},{"nodeId":110000313,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3140414054,"text":"What a bummer. Can't eat it if it's your friend.","nextNodeIds":[110000316]},{"nodeId":110000316,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":935767870,"text":"You seem like good friends. I have a good friend too, called Guoba.","nextNodeIds":[110000317]},{"nodeId":110000317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2951285222,"text":"Isn't that the name of a Liyue snack?","nextNodeIds":[110000318]},{"nodeId":110000318,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":723749046,"text":"Hee-hee... Both the snack and my friend have a special place in my heart.","nextNodeIds":[110000319]},{"nodeId":110000319,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":913412990,"text":"Anyway — can you do some hunting for me?","nextNodeIds":[110000320]},{"nodeId":110000320,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2269939694,"text":"There's lots of game around here that would be amazing to cook with.","nextNodeIds":[110000321]},{"nodeId":110000321,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2653165446,"text":"I can't catch anything to save my life and I don't want to miss out!","nextNodeIds":[110000322]},{"nodeId":110000322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2415443398,"text":"Sounds like a bit of an ordeal...","nextNodeIds":[110000323]},{"nodeId":110000323,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2371839446,"text":"Don't be like that... C'mon, I'll whip you up a tasty snack later!","nextNodeIds":[110000324]},{"nodeId":110000324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":38813670,"text":"Ooh, you had me at tasty snack! Don't worry, we're the bestest hunters ever!","nextNodeIds":[110000325,110000326]},{"nodeId":110000325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3148290774,"text":"Whose side are you on!?","nextNodeIds":[110000327]},{"nodeId":110000327,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":265224902,"text":"Hee-hee, don't worry about it, your friend has already given me a response.","nextNodeIds":[110000328]},{"nodeId":110000328,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1606684598,"text":"I don't care how it's done, so long as you bring me back some raw meat.","nextNodeIds":[110000329]},{"nodeId":110000329,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2365008246,"text":"Great, then I'll leave you to it!","nextNodeIds":[]},{"nodeId":110000326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2432380030,"text":"You could always ask me first...","nextNodeIds":[110000327]},{"nodeId":110000314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1474321006,"text":"Dig in.","nextNodeIds":[110000315]},{"nodeId":110000315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":209172470,"text":"No! For the last time, Paimon is NOT EMERGENCY FOOD!","nextNodeIds":[110000316]},{"nodeId":110000304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1051543654,"text":"Are you an adventurer?","nextNodeIds":[110000305]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133002125"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_MONSTER"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFM