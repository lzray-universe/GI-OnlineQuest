ONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100004,"initDialog":110000401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1012],"performCfg":"","priority":5,"questId":11000,"showRandomTalkCount":0},"dialogs":[{"nodeId":110000401,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3558819302,"text":"These boars look healthy, and active too. I bet their meat is superb quality!","nextNodeIds":[110000402]},{"nodeId":110000402,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2511416534,"text":"Ugh, just thinking about it is making me hungry...","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":3,"LNHLPKELCAL":[100061,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":1100005,"order":5,"stepDescription":"Give three chunks of Raw Meat to Xiangling","stepDescTextMapHash":2018398014,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100005,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1012"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1100005,1100099],"talks":[{"talkId":1100005,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100005","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["100061","3",""],"type":"QUEST_COND_PACK_HAVE_ITEM"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100005,"initDialog":110000501,"nextRandomTalks":[],"nextTalks":[],"npcId":[1012],"performCfg":"QuestDialogue/LQ/Xiangling1_11000/Q1100005","priority":5,"questId":11000,"showRandomTalkCount":0},"dialogs":[{"nodeId":110000501,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":555532142,"text":"Wowee! This is great! Some of it I'll shallow fry, some of it I'll deep fry with mushrooms— ooh, and I wonder how well it goes with Slime Condensate...","nextNodeIds":[110000502,110000504]},{"nodeId":110000502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3446382718,"text":"She's off in her own world...","nextNodeIds":[110000503]},{"nodeId":110000503,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1410224838,"text":"Paimon thinks she's forgotten about us...","nextNodeIds":[110000506]},{"nodeId":110000506,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3606192750,"text":"Uh, sorry! I got all excited thinking about new recipes.","nextNodeIds":[110000507]},{"nodeId":110000507,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2811987998,"text":"As promised, a tasty snack! Go on, try it! And tell me what you think.","nextNodeIds":[110000508]},{"nodeId":110000508,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":426051862,"text":"Are we your food testers now?","nextNodeIds":[110000509]},{"nodeId":110000509,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3547138310,"text":"Oh gosh, this is... delicious!","nextNodeIds":[110000510]},{"nodeId":110000510,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2658630494,"text":"Can you tell us how to make it?","nextNodeIds":[110000511]},{"nodeId":110000511,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2579962606,"text":"Hee-hee, sure! The only thing is I haven't written down the recipe yet, hmm...","nextNodeIds":[110000512]},{"nodeId":110000512,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1196649998,"text":"I got it! I'll make another one now so you can watch. I'm sure you'll pick it up straight away.","nextNodeIds":[110000513]},{"nodeId":110000513,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3038449430,"text":"This seems pretty hard to make, it'll take more than that to learn how to make it. And we don't have a frying pan or any condiments.","nextNodeIds":[110000514]},{"nodeId":110000514,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":940628046,"text":"Come on, it's simple!","nextNodeIds":[110000515]},{"nodeId":110000515,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":470517206,"text":"We can fry on a slab of stone and cook using some boar fat. Build a stove from rocks, use dry grass for kindling, twigs for firewood...","nextNodeIds":[110000516]},{"nodeId":110000516,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":281395822,"text":"Sweet flowers will do for sugar. As for salt, I found a load of rock salt in a cave the other day, there's still plenty left.","nextNodeIds":[110000517,110000518]},{"nodeId":110000517,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3316538958,"text":"Seems like she's done this a million times before...","nextNodeIds":[110000519]},{"nodeId":110000519,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1682821358,"text":"Hee-hee, I just can't help myself when there's a chance to try something new. But I can't exactly bring my whole kitchen with me every time I leave the house either.","nextNodeIds":[110000520]},{"nodeId":110000520,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3489955870,"text":"Give me a second while I get everything ready.","nextNodeIds":[110000521]},{"nodeId":110000521,"roleType":"TALK_ROLE_NPC","speakerId":153901,"speakerName":"Allan","textMapHash":4041265294,"text":"Hey! What do you think you're doing?","nextNodeIds":[110000601]},{"nodeId":110000601,"roleType":"TALK_ROLE_NPC","speakerId":153901,"speakerName":"Allan","textMapHash":3276224934,"text":"This is the boars' natural habitat, you can't hunt them here! You'll send them all running.","nextNodeIds":[110000602]},{"nodeId":110000602,"roleType":"TALK_ROLE_NPC","speakerId":153901,"speakerName":"Allan","textMapHash":3148718926,"text":"We hunters know better than to kill the chicken to get at the egg.","nextNodeIds":[110000603]},{"nodeId":110000603,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":2073427734,"text":"Oh! I get it.","nextNodeIds":[110000604]},{"nodeId":110000604,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1390894206,"text":"The freshest, best-quality meat comes from free-range boars that grow up in the environment nature intended for them! If they all ran off...","nextNodeIds":[110000605]},{"nodeId":110000605,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":791557710,"text":"...It would be a major blow to gastronomy— no, to all mankind!","nextNodeIds":[110000606,110000607]},{"nodeId":110000606,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2943641078,"text":"That's, uh, one way of understanding it.","nextNodeIds":[110000608]},{"nodeId":110000608,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3366938654,"text":"I'm sorry. I got excited and didn't think of the impact we'd have.","nextNodeIds":[110000609]},{"nodeId":110000609,"roleType":"TALK_ROLE_NPC","speakerId":153901,"speakerName":"Allan","textMapHash":215261030,"text":"*sigh* You should apologize to Draff.","nextNodeIds":[110000610]},{"nodeId":110000610,"roleType":"TALK_ROLE_NPC","speakerId":153901,"speakerName":"Allan","textMapHash":1480614422,"text":"As our leader, he always stresses the importance of respecting the rules of the hunt. I'm afraid he is very upset right now.","nextNodeIds":[110000611,110000612]},{"nodeId":110000611,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":404133750,"text":"What are we going to do?","nextNodeIds":[110000613]},{"nodeId":110000613,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":3881365246,"text":"I made a mistake, and I should go and apologize.","nextNodeIds":[110000614]},{"nodeId":110000614,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2609778262,"text":"Let us come with you.","nextNodeIds":[110000615]},{"nodeId":110000615,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"Xiangling","textMapHash":1170817494,"text":"Hee-hee, thanks guys. I'll cook up some more tasty snacks for you once this is over.","nextNodeIds":[110000616]},{"nodeId":110000616,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":650731350,"text":"Okay. Don't worry, Paimon'll remember even if you forget.","nextNodeIds":[110000617]},{"nodeId":110000617,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3427252990,"text":"Draff ought to be in Springvale. Let's go!","nextNodeIds":[]},{"nodeId":110000612,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":747267950,"text":"I think the hunter is right.","nextNodeIds":[110000613]},{"nodeId":110000607,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1254642998,"text":"That's not even close to what he meant...","nextNodeIds":[110000608]},{"nodeId":110000518,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3337030406,"text":"I'm tired just listening to it!","nextNodeIds":[110000519]},{"nodeId":110000504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3479710974,"text":"I want to try Slime Condensate!","nextNodeIds":[110000505]},{"nodeId":110000505,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":305407118,"text":"#Yay! {NICKNAME} has finally come around to my food preferences.","nextNodeIds":[110000506]}]},{"talkId":1100099,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCf