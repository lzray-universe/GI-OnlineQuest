"priority":5,"questId":76501,"showRandomTalkCount":0},"dialogs":[{"nodeId":765010101,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":1288054050,"text":"#Ah. {NICKNAME}, Paimon. It's you. The birds of the woods just spoke of your coming. Do you come with some important matter, or... do you perhaps require my guidance?","nextNodeIds":[765010102,765010103]},{"nodeId":765010102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1453143210,"text":"We're just looking around.","nextNodeIds":[765010104]},{"nodeId":765010104,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":738593114,"text":"This place is well-nourished by the moon's radiance. The plant and animal life dwelling within it are both different from those anywhere else in the world.","nextNodeIds":[765010105]},{"nodeId":765010105,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":1818073242,"text":"So yes, I would call it a good place to take excellent photos.","nextNodeIds":[765010106]},{"nodeId":765010106,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":73378130,"text":"Please, feel free to look around. Should you have any questions, do not hesitate to approach me. I shall answer as best I can.","nextNodeIds":[765010107,765010108]},{"nodeId":765010107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2234160442,"text":"This place really gives off a sense of tranquility.","nextNodeIds":[765010109]},{"nodeId":765010109,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":804070234,"text":"Yes. This is where I meditate, where I commune with all living things in whispers.","nextNodeIds":[765010110]},{"nodeId":765010110,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":3235381610,"text":"Just standing here helps set my heart at ease.","nextNodeIds":[765010111]},{"nodeId":765010111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2868924834,"text":"Hehe, you're a real poet, Lauma!","nextNodeIds":[765010112,765010113]},{"nodeId":765010112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2333291658,"text":"I do, in fact, have a small request...","nextNodeIds":[765010114]},{"nodeId":765010114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2327900234,"text":"Yeah. You fit super well with the background, like the center of a beautiful painting! You'd look awesome in a photo, for sure!","nextNodeIds":[765010115]},{"nodeId":765010115,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":3780924346,"text":"You'd like to... take a picture of me? That would be a novel experience. If you believe that the serenity of this place and my form are worth immortalizing through the frame, I'd be glad to oblige.","nextNodeIds":[765010116]},{"nodeId":765010116,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":1221691810,"text":"Indeed, I would be honored to add another lovely memory to your journey.","nextNodeIds":[765010117]},{"nodeId":765010117,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":425876546,"text":"So, how may I assist you? Will you need me to look in a certain direction, or will things work as-is?","nextNodeIds":[765010118,765010119]},{"nodeId":765010118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1423717714,"text":"Just be yourself.","nextNodeIds":[765010120]},{"nodeId":765010120,"roleType":"TALK_ROLE_NPC","speakerId":7174,"speakerName":"Lauma","textMapHash":3386109466,"text":"Alright, I will leave it to you, then. May inspiration, fleeting though it should be, grace you with its presence.","nextNodeIds":[]},{"nodeId":765010119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2613765626,"text":"I'll catch you at your most inspiring, don't you worry.","nextNodeIds":[765010120]},{"nodeId":765010113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2210640706,"text":"We'd like to take a picture of you.","nextNodeIds":[765010114]},{"nodeId":765010108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":549928354,"text":"Do you usually hang out in this area, Lauma?","nextNodeIds":[765010109]},{"nodeId":765010103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2293256106,"text":"And looking for some photo-op material while we're at it.","nextNodeIds":[765010104]}]},{"talkId":7650104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7650101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","1","76501","",""],"type":"QUEST_COND_QUEST_VAR_EQUAL"},{"param":["220122","1","","",""],"type":"QUEST_COND_PACK_HAVE_ITEM_WITH_ID"},{"param":["5285","5285005","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":