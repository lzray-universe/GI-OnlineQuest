TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[1202_4:-12.976,2.036,-11.668,0.000,251.819,0.000]","20"],"NOCCOBOFKHP":1202,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[1204801,1204802,1204803,1204804,1204805],"talks":[{"talkId":1204801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1204801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1204801,"initDialog":120480101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1034],"performCfg":"QuestDialogue/LQ/Mizuki_12048/Q1204801","priority":5,"questId":12048,"showRandomTalkCount":0},"dialogs":[{"nodeId":120480101,"roleType":"TALK_ROLE_NPC","speakerId":3210,"speakerName":"Hyakujitsuhaku Shion","textMapHash":991504002,"text":"Scuse me, hello! Please come register over here!","nextNodeIds":[120480102]},{"nodeId":120480102,"roleType":"TALK_ROLE_NPC","speakerId":3211,"speakerName":"Shiba Murasaki","textMapHash":1982951130,"text":"What's going on? Why are there so many guests? Had I known, I'd have definitely turned some of them back...","nextNodeIds":[120480103]},{"nodeId":120480103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":2301916482,"text":"Whoa, looks like business is booming with Emura Ichigensai out of the picture! And it's good to see that Murasaki and Shion are well on the road to recovery.","nextNodeIds":[120480104]},{"nodeId":120480104,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3969502202,"text":"#Morning, {NICKNAME}, Paimon. Want to make an appointment?","nextNodeIds":[120480105]},{"nodeId":120480105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1120801498,"text":"Yes please! For today, if possible!","nextNodeIds":[120480106]},{"nodeId":120480106,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3568977506,"text":"Then, I'd better get you another VIP pass. You're our most important customers, after all.","nextNodeIds":[120480107]},{"nodeId":120480107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1570087610,"text":"Hee-hee, awesome! In that case, Very Important Paimon would like to start with the fine dining this time.","nextNodeIds":[120480108]},{"nodeId":120480108,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":982866218,"text":"Oh my... Imagine if you'd taken my advice and sold your shares the other day. It could have cost you dearly now that business is booming again. I hope you're not too upset with me, old friend?","nextNodeIds":[120480109]},{"nodeId":120480109,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":99970650,"text":"Why would I be upset? It's not as if I ever took your suggestion seriously.","nextNodeIds":[120480110]},{"nodeId":120480110,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":899651890,"text":"Ah, I've missed that way with words. So affectionate...","nextNodeIds":[120480111]},{"nodeId":120480111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":1072226602,"text":"Would it kill you to not sneak up on people every darn time...","nextNodeIds":[120480112]},{"nodeId":120480112,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3505085986,"text":"Morning, little ones. Did you enjoy the scenery last night?","nextNodeIds":[120480113]},{"nodeId":120480113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4232085130,"text":"What? ...You were spying on us?","nextNodeIds":[120480114]},{"nodeId":120480114,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":244747458,"text":"Hardly. That tree was directly beneath the Grand Narukami Shrine. What was I supposed to do, move the entire shrine to give you some privacy?","nextNodeIds":[120480115]},{"nodeId":120480115,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3431053242,"text":"Is there a reason you're here, Lady Guuji?","nextNodeIds":[120480116]},{"nodeId":120480116,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3728851258,"text":"Heh... Mostly because I felt like a walk. But I do have a message from the Tenryou Commission to pass on, as it happens.","nextNodeIds":[120480117]},{"nodeId":120480117,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":2133520354,"text":"The gentleman who your fellow yumekui-baku fished out of the water last night is no longer in a critical condition. Although, his mind seems to have regressed to that of a young child.","nextNodeIds":[120480118]},{"nodeId":120480118,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":2280770306,"text":"It could have been worse, I suppose... Lady Guuji, I owe you my thanks. Without your help, things might've gone a lot less smoothly yesterday.","nextNodeIds":[120480119]},{"nodeId":120480119,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":596142122,"text":"Hmm?","nextNodeIds":[120480120]},{"nodeId":120480120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":678395386,"text":"Wasn't me...","nextNodeIds":[120480121]},{"nodeId":120480121,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":2677939082,"text":"Come on, Miko. You've always been worse than me at keeping secrets.","nextNodeIds":[120480122]},{"nodeId":120480122,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":2145824658,"text":"I admit that I feel inferior around you, and have an urge to prove myself. How could I not? But maybe these feelings are what have driven me to take this business as far as I have.","nextNodeIds":[120480123]},{"nodeId":120480123,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":30345962,"text":"My sense of inferiority keeps my ego in check, and my desire to prove myself gives me the strength to persevere. I'm able to accept these parts of me for what they are — there's no need for you to tiptoe around them.","nextNodeIds":[120480124]},{"nodeId":120480124,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":3256643498,"text":"#*sigh* You could have told me sooner... The poor {NICKNAME} here has been doing all my running around for me.","nextNodeIds":[120480125]},{"nodeId":120480125,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":1623206042,"text":"#True. But then again, without {NICKNAME}'s help, you'd have been placed in a difficult position.","nextNodeIds":[120480126]},{"nodeId":120480126,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":1296905026,"text":"Emura Ichigensai had amassed a huge following. For the Guuji of the Grand Narukami Shrine to publicly go against him would have been a dangerous move.","nextNodeIds":[120480127]},{"nodeId":120480127,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":1475260930,"text":"An angry mob of zealots could have done some serious damage to the shrine's reputation... Much safer for the Guuji not to get personally involved. It was the right decision.","nextNodeIds":[120480128]},{"nodeId":120480128,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":346322066,"text":"While that's all true, my main concern was that I didn't want to upset an old friend. Otherwise, I could have taken a much more direct approach.","nextNodeIds":[120480129]},{"nodeId":120480129,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":418692442,"text":"Miko...","nextNodeIds":[120480130]},{"nodeId":120480130,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"Yae Miko","textMapHash":129573082,"text":"I always seem to forget that you're more cunning and less adorable than you look... Seems like my worries about upsetting you were unfounded.","nextNodeIds":[120480131]},{"nodeId":120480131,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":2380159842,"text":"...It's not that I don't get upset. Everyone has their fair share of troubles... But every sorrow has its cure.","nextNodeIds":[120480132]},{"nodeId":120480132,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"Yumemizuki Mizuki","textMapHash":3957292922,"text":"Here's your new VIP Pass. Please take good care of it.","nextNodeIds":[]}]},{"talkId":1204802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1204801","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","","