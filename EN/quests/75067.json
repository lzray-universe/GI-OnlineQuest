EST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506701,"initDialog":750670101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21682],"performCfg":"QuestDialogue/WQ/Natlan_75067/Q7506701","priority":5,"questId":75067,"showRandomTalkCount":0},"dialogs":[{"nodeId":750670101,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":4112912106,"text":"These inhuman creatures are truly tough adversaries... inhuman monsters, I should say. Greetings, brave warrior... I am Quenin, a member of this adventure team. My duty is...","nextNodeIds":[750670102]},{"nodeId":750670102,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":4063767634,"text":"My duty... is to eliminate these monsters. Yes, I am a warrior of the adventure team. Be careful, brave warrior...","nextNodeIds":[750670103]},{"nodeId":750670103,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":1353785954,"text":"These monsters... they are extremely cunning — capable of disguising themselves in different forms.","nextNodeIds":[750670104]},{"nodeId":750670104,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":2594171026,"text":"Every night, before I fall asleep, I hear... the sounds they make from their hiding spots in these ancient ruins. This... is why I cannot sleep at the encampment.","nextNodeIds":[750670105]},{"nodeId":750670105,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":1805807466,"text":"This place is filled with these monsters. You... must be careful, too.","nextNodeIds":[]}]},{"talkId":7506702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","3","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506704","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","2","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506702,"initDialog":750670201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21682],"performCfg":"QuestDialogue/WQ/Natlan_75067/Q7506702","priority":5,"questId":75067,"showRandomTalkCount":0},"dialogs":[{"nodeId":750670201,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":4119928714,"text":"Ah, this place really is cursed...","nextNodeIds":[750670202]},{"nodeId":750670202,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":1870541554,"text":"Do not tarry here too long. You must leave, and quickly... Yes, you must leave before the coming of the pitch-black tide.","nextNodeIds":[750670203]},{"nodeId":750670203,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":3816974562,"text":"Yes, the pitch-black tide. Its vast shadow is almost upon us. We must... Must ensure that everyone gets to safety. That everyone... is safely evacuated.","nextNodeIds":[]}]},{"talkId":7506703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","4","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506704","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","3","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506703,"initDialog":750670301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21682],"performCfg":"QuestDialogue/WQ/Natlan_75067/Q7506703","priority":5,"questId":75067,"showRandomTalkCount":0},"dialogs":[{"nodeId":750670301,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":844170802,"text":"Why do you linger here still...?","nextNodeIds":[750670302]},{"nodeId":750670302,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":4142942858,"text":"Our adventure team's leader, the hero who wore a falcon's mask, is already... We cannot hold out against them any longer...","nextNodeIds":[750670303]},{"nodeId":750670303,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":1452635154,"text":"You must leave as soon as possible. This place is cursed, brave warrior. It is not somewhere that people should stay.","nextNodeIds":[]}]},{"talkId":7506704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","5","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506704","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","4","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506704,"initDialog":750670401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21682],"performCfg":"QuestDialogue/WQ/Natlan_75067/Q7506704","priority":5,"questId":75067,"showRandomTalkCount":0},"dialogs":[{"nodeId":750670401,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":980560602,"text":"So you are still here, brave warrior.","nextNodeIds":[750670402]},{"nodeId":750670402,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":755306554,"text":"Once upon a time, so the scholars say, the ancient and tyrannical Lord of this Cinder City knew... a way to prevent Abyssal corrosion. So we...","nextNodeIds":[750670403]},{"nodeId":750670403,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":823688786,"text":"But there really is something ominous about this place, brave warrior. Lately, I too have begun to feel a little... strange.","nextNodeIds":[750670404]},{"nodeId":750670404,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":3145549602,"text":"Sometimes, after waking, you'll find that a road that was perfectly intact just the day before has now become broken and dilapidated... And were those stone houses like that there to begin with? It feels like they should be more... complete.","nextNodeIds":[750670405]},{"nodeId":750670405,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":1119362930,"text":"But sometimes, when I wake, I see friends who should not be here anymore... Are they monsters? That must be it... They're monsters that have taken the form of my friends.","nextNodeIds":[750670406]},{"nodeId":750670406,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":2855900922,"text":"My... My duty here is to eliminate those monsters, but... why? Why do I have to do that?","nextNodeIds":[750670407]},{"nodeId":750670407,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":3816419610,"text":"Anyway, all things said and done, this is a very strange place. You should leave... as soon as possible.","nextNodeIds":[]}]},{"talkId":7506705,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","6","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7506704","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7504101","5","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7506705,"initDialog":750670501,"nextRandomTalks":[],"nextTalks":[],"npcId":[21682],"performCfg":"QuestDialogue/WQ/Natlan_75067/Q7506705","priority":5,"questId":75067,"showRandomTalkCount":0},"dialogs":[{"nodeId":750670501,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":823428450,"text":"You'd better leave at once. If you stay any longer, it'll be too late...","nextNodeIds":[750670502]},{"nodeId":750670502,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":3069817282,"text":"Why will it be too late, you ask? Because... because our entire adventure team has been wiped out. That giant, pitch-black beast... They were all...","nextNodeIds":[750670503]},{"nodeId":750670503,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":2119481442,"text":"They tasked me with protecting the evacuees, and at the very least, to ensure that they left the city. As we speak, a rescue team from the Flower-Feather Clan is on their way...","nextNodeIds":[750670504]},{"nodeId":750670504,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":1889677090,"text":"I must eliminate these evil monsters, so that the survivors can return to a land upon which the sun shines... Huh, but... Why am I here again?","nextNodeIds":[750670505]},{"nodeId":750670505,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":3227444002,"text":"That sound in my ears... Ahh, it's getting louder and louder. I... I have to go back to the waterfall. Yes, I must... return to the waterfall.","nextNodeIds":[750670506]},{"nodeId":750670506,"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","textMapHash":2688495538,"text":"Brave warrior, you too should leave... as soon as possible.","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7506701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7506705,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7506701,7506702,7506703,7506704,7506705],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21682,"speakerName":"Quenin","count":24}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4245119134,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75067/Q7506701","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":