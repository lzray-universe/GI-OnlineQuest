IDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4032 "],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2301901],"talks":[{"talkId":2301901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2301901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2301901,"initDialog":230190101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4032],"performCfg":"","priority":5,"questId":23019,"showRandomTalkCount":0},"dialogs":[{"nodeId":230190101,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2626239466,"text":"I knew it, doing it this way is more expensive...","nextNodeIds":[230190102]},{"nodeId":230190102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3051833242,"text":"What are you talking about?","nextNodeIds":[230190103]},{"nodeId":230190103,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1883791946,"text":"Ah, hello. I'm studying a ship design problem and I've now hit a bottleneck.","nextNodeIds":[230190104]},{"nodeId":230190104,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":781704778,"text":"I'll give it to you straight. I want to make ships carry more things without raising their cost.","nextNodeIds":[230190105]},{"nodeId":230190105,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":967150930,"text":"If the weight is too great, the structure becomes more prone to breakage. Uneven weight distribution affects balance, and so on...","nextNodeIds":[230190106]},{"nodeId":230190106,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1104990194,"text":"The best way to solve these problems is to use better materials, but if we do, we risk incurring greater costs. This is the crux of the issue.","nextNodeIds":[230190107]},{"nodeId":230190107,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1884143066,"text":"*sigh* To be honest, I just don't have the Mora, but I still want to build a good ship.","nextNodeIds":[230190108]},{"nodeId":230190108,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1680602738,"text":"So for some problems that would normally be solved with Mora, I must instead find some technical means to circumvent them.","nextNodeIds":[230190109]},{"nodeId":230190109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2601948146,"text":"Can you really do this...?","nextNodeIds":[230190110]},{"nodeId":230190110,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":272116146,"text":"Hahaha, you might not believe it, but a lot of people actually do this.","nextNodeIds":[230190111]},{"nodeId":230190111,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":3588827306,"text":"The ships we build are shoreline fishing boats after all. They will not encounter any storms.","nextNodeIds":[230190112]},{"nodeId":230190112,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2496052538,"text":"When it comes to shipbuilding, we subscribe to the principle of saving whatever costs can be saved, and fixing and mending whatever we can... So long as it can be used, we will improvise.","nextNodeIds":[230190113]},{"nodeId":230190113,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2361291882,"text":"Thanks to this principle, our ship repair business does well every day.","nextNodeIds":[230190114]},{"nodeId":230190114,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":3593350146,"text":"Traveler, if you're willing, please help me go check the ship over there that just returned to port. It seems to be having some problems because it often carries heavy loads.","nextNodeIds":[230190115]},{"nodeId":230190115,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":407759490,"text":"I happen to be researching this very topic, so perhaps I can find some inspiration from it.","nextNodeIds":[230190116,230190118]},{"nodeId":230190116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":4248662650,"text":"Leave it to me.","nextNodeIds":[230190117]},{"nodeId":230190117,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1627425426,"text":"I'll leave it in your hands then! I have to hurry to repair another ship now...","nextNodeIds":[]},{"nodeId":230190118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1092268114,"text":"Why don't you go yourself?","nextNodeIds":[230190119]},{"nodeId":230190119,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":1029000746,"text":"I'd like to do it myself, but I was asked to repair another ship, which needs to go out to sea again to fish...","nextNodeIds":[230190120]},{"nodeId":230190120,"roleType":"TALK_ROLE_NPC","speakerId":4032,"speakerName":"Rafiq","textMapHash":2571872530,"text":"So I can only leave it to you, Traveler!","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4032 "],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2301902,"order":2,"stepDescription":"Go to investigate the ship","stepDescTextMapHash":1087722796,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2301902,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q2301901_GUIDE","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GU