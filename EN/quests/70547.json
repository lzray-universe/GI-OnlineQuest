AINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7054701],"talks":[{"talkId":7054701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7054701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["5280","5280001","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7054701,"initDialog":705470101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30531],"performCfg":"QuestDialogue/WQ/Mengde_70547/Q7054701","priority":5,"questId":70547,"showRandomTalkCount":0},"dialogs":[{"nodeId":705470101,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3422776506,"text":"Whoa! The Cat Savior and Paimon the Cat Whisperer! I can't believe you actually came!","nextNodeIds":[705470102]},{"nodeId":705470102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":682837850,"text":"Huh? What did you just call us?","nextNodeIds":[705470103,705470104]},{"nodeId":705470103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":3357561434,"text":"That sounds familiar...","nextNodeIds":[705470105]},{"nodeId":705470105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3296894202,"text":"Umm... Have we met somewhere before?","nextNodeIds":[705470106]},{"nodeId":705470106,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":1221955002,"text":"Haha! I can't believe the Cat Whisperer still remembers me! You go, Valerina!","nextNodeIds":[705470107]},{"nodeId":705470107,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":603869154,"text":"Let's save the catching up for later — for now, how about trying my newly sponsored game? This one's that's kept me grinning for a whole week...","nextNodeIds":[705470108]},{"nodeId":705470108,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":4079104314,"text":"Dodoco's Blow-Up-Erative Bomb-Nanza!","nextNodeIds":[705470109]},{"nodeId":705470109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":390617914,"text":"Whoa! So many Dodocos!","nextNodeIds":[705470110,705470111]},{"nodeId":705470110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":619381810,"text":"And they're all familiar faces.","nextNodeIds":[705470112]},{"nodeId":705470112,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":4099311970,"text":"Look, Cat Savior... Hehe, or perhaps I should say — our glittering, admirable, Honorary Knight!","nextNodeIds":[705470113]},{"nodeId":705470113,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":1258577106,"text":"This Dodoco doll was designed in your image!","nextNodeIds":[705470114]},{"nodeId":705470114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":4051365474,"text":"#She's right! Wow, right down to the colors and patterns... Ehe, it's a spitting image of you, {NICKNAME}!","nextNodeIds":[705470115]},{"nodeId":705470115,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":801660946,"text":"In this game, Sparky Dodoco, Flashy Dodoco, Knightly Dodoco, and Witchy Dodoco have to join forces, and use explosives to blast their never-seen-before opponents away...","nextNodeIds":[705470116]},{"nodeId":705470116,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":948140426,"text":"I'm only responsible for the operation and sponsorship of the game, so I'm not really clear on its development. These enemies are just as mysterious to me as they are to you...","nextNodeIds":[705470117]},{"nodeId":705470117,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":1426977810,"text":"But I'm sure that even if we meet in real life, the amazing Dodocos will definitely send them flying back to whence they came!","nextNodeIds":[705470118]},{"nodeId":705470118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","textMapHash":3392708098,"text":"Of course! No monster can stand against Klee and her best buddy Dodoco!","nextNodeIds":[705470119,705470120]},{"nodeId":705470119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2203898658,"text":"Well, let's give it a try then!","nextNodeIds":[705470121]},{"nodeId":705470121,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","textMapHash":3382669114,"text":"Hehe, I'm sure you'll have a blast!","nextNodeIds":[]},{"nodeId":705470120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":1183949882,"text":"A new Dodoco game!","nextNodeIds":[705470121]},{"nodeId":705470111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2252115098,"text":"Well, the prototype's pretty hard to miss!","nextNodeIds":[705470112]},{"nodeId":705470104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","textMapHash":2225843898,"text":"That's a new one to me...","nextNodeIds":[705470105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30531"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7054701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"Valerina","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"Traveler","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"Paimon","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":306462638,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70547/Q7054701","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[]