rId":20523,"speakerName":"志琼","textMapHash":3844582466,"text":"呼…最近层岩巨渊似乎停止了地形上的异变，这也说明我只需要对已有的地图进行一点小小的增补就够了。","nextNodeIds":[710360304]},{"nodeId":710360304,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":1894076202,"text":"多谢了前辈的冒险，我们的工作也相对轻松了很多。","nextNodeIds":[710360305]},{"nodeId":710360305,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":2386930794,"text":"啊，我就不多留前辈啦。如果想要休息或者继续探险，就请自便吧！","nextNodeIds":[710360306]},{"nodeId":710360306,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":212370194,"text":"呼…距离回收信标还有挺长时间的，如果下次冒险也能再叫上前辈就好了。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0"],"PAINLIBBLDK":"QUEST_EXEC_INIT_TIME_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20523"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":7104116,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7103713","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7104116,"initDialog":710411201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20523,1005],"performCfg":"QuestDialogue/WQ/Liyue_71041/Q7104112","priority":4,"questId":71036,"showRandomTalkCount":0},"dialogs":[{"nodeId":710411201,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":849215946,"text":"请问前辈有什么事吗？","nextNodeIds":[710411202,710411212,710411223,710411232]},{"nodeId":710411202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":2399620082,"text":"关于地图…","nextNodeIds":[710411203]},{"nodeId":710411203,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":745577170,"text":"前辈是说地图吗？没什么好提的啦…在加入冒险家协会之前，我曾经是矿上的制图员。","nextNodeIds":[710411204]},{"nodeId":710411204,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":3211044866,"text":"当然啦，我说的不是那些坐办公室画图的制图师…嘿嘿，我还差得远呢。","nextNodeIds":[710411234]},{"nodeId":710411234,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":165000938,"text":"之前受过他们的委托，在翘英庄跑上跑下测绘地形…结果完事建筑计划却取消了…也都是他们一句话的事。","nextNodeIds":[710411205]},{"nodeId":710411205,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":3858232738,"text":"他们可以只用委托助手现场勘探，给他们收集地图信息，然后自己才动手工作…但我们这些制图员可不行。","nextNodeIds":[710411206]},{"nodeId":710411206,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":1193240546,"text":"所以…身为半个矿工，我也早就习惯在危险的地下通道中穿梭了——工作要求如此，没办法嘛。","nextNodeIds":[710411207]},{"nodeId":710411207,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":4032758554,"text":"而且…在异变发生后，层岩巨渊下层其实很…不稳定。","nextNodeIds":[710411208]},{"nodeId":710411208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","textMapHash":214623810,"text":"欸…不稳定？很危险吗？","nextNodeIds":[710411209]},{"nodeId":710411209,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":3545111450,"text":"嗯，地质结构一直在缓慢地变化，今天的通路，可能到下个月就变成了石壁…就像…唔，我想想怎么说…","nextNodeIds":[710411210]},{"nodeId":710411210,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":3621261746,"text":"就像层岩巨渊在随着自己的心思发生变化一样。","nextNodeIds":[710411211]},{"nodeId":710411211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","textMapHash":166944418,"text":"哇…这么邪门的吗…","nextNodeIds":[]},{"nodeId":710411212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":610262154,"text":"关于冒险家生涯…","nextNodeIds":[710411213]},{"nodeId":710411213,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":1005661114,"text":"哈哈，这才哪到哪呀，就「生涯」了！前辈请不要太客气啦，我还只是个新人冒险家而已…跟前辈差得太远啦。","nextNodeIds":[710411214]},{"nodeId":710411214,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":3930295074,"text":"虽然之前完成过一些冒险家协会的委托，但我经验尚浅，也并没有独立探索过什么地点，更没有在哪里留下自己的故事…","nextNodeIds":[710411215]},{"nodeId":710411215,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":1560732162,"text":"所以我一直在想，层岩巨渊这个地方，说不定能让我留下足迹，让后人记得，我这个人曾经来过。","nextNodeIds":[710411216]},{"nodeId":710411216,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":297312474,"text":"就像大冒险家艾莉丝曾经说的那样，层岩巨渊说不定会是「我的『卢比孔河』」！","nextNodeIds":[710411217,710411220]},{"nodeId":710411217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":2094425154,"text":"「鹿鼻孔河」…是丘丘语吗？","nextNodeIds":[710411218]},{"nodeId":710411218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","textMapHash":2296352650,"text":"没听说过呢…","nextNodeIds":[710411219]},{"nodeId":710411219,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":3465453410,"text":"唔…我也不是很懂…艾莉丝毕竟是穿梭诸世界的大冒险家，或许也是她去过的地方之一吧…？","nextNodeIds":[]},{"nodeId":710411220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":774026754,"text":"是「露鼻孔盒」呀！真厉害！","nextNodeIds":[710411221]},{"nodeId":710411221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","textMapHash":2804427218,"text":"喂，你自己也不知道那是什么东西吧！","nextNodeIds":[710411222]},{"nodeId":710411222,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":3484816106,"text":"哈哈，不管怎样，多谢前辈的鼓励！","nextNodeIds":[]},{"nodeId":710411223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":2410118354,"text":"关于克里托夫…","nextNodeIds":[710411224]},{"nodeId":710411224,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":697649570,"text":"他呀…哼，他这个人我是信不过。我们在矿上和盗宝团不知道周旋过多久了，还能不知道他们的坏心眼？","nextNodeIds":[710411225]},{"nodeId":710411225,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":2464048914,"text":"这些人呀…我劝你千万别信他们那套说辞，什么「改过自新」什么「金盆洗手」…","nextNodeIds":[710411226]},{"nodeId":710411226,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":1079152514,"text":"如果你认真在听他们说话，他们一定已经把脏手伸到你的口袋里了。","nextNodeIds":[710411227]},{"nodeId":710411227,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":2049355618,"text":"假如你相信了他们的鬼话，恐怕岩王爷他老人家也保不住你的钱包咯。","nextNodeIds":[710411228]},{"nodeId":710411228,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":924811882,"text":"哼，我当然不是对他们有偏见…我只是想提醒你小心一点，盗宝团是不可相信的。","nextNodeIds":[710411229]},{"nodeId":710411229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":4143969010,"text":"你这显然是偏见。","nextNodeIds":[710411230]},{"nodeId":710411230,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":415773194,"text":"也许吧…你作为前辈比我更加见多识广，对盗宝团那些家伙也能更宽容。但我总还要留些心眼盯着他们。","nextNodeIds":[710411231]},{"nodeId":710411231,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":1922357186,"text":"除非这家伙能证明，他和那群走私犯同伙没有关系。","nextNodeIds":[]},{"nodeId":710411232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":312816690,"text":"再见。","nextNodeIds":[710411233]},{"nodeId":710411233,"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","textMapHash":1518793474,"text":"前辈再见！","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7103602,7103603,7104116],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20523,"speakerName":"志琼","count":41},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171036],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2645275358,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Liyue_71036/Q7103602","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],