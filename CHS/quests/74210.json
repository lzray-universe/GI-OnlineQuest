E"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7413612,"initDialog":741361201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5257,1005],"performCfg":"QuestDialogue/WQ/Fontaine_74136/Q7413612","priority":3,"questId":74210,"showRandomTalkCount":0},"dialogs":[{"nodeId":741361201,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":934332866,"text":"您有什么想问的话，荣誉高级研究员？","nextNodeIds":[741361202,741361208,741361220]},{"nodeId":741361202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":3001379682,"text":"关于纳克和艾德温的处理…","nextNodeIds":[741361203]},{"nodeId":741361203,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":4140570098,"text":"他们会暂时待在梅洛彼得堡里，为他们所犯下的罪行悔过。","nextNodeIds":[741361204]},{"nodeId":741361204,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":2920522338,"text":"当然，以艾德温的性格，大概率也不会做「悔过」这种事。","nextNodeIds":[741361205]},{"nodeId":741361205,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":4226080378,"text":"但无论如何，只要能让艾德温远离研究器材和始基矿就好。","nextNodeIds":[741361206]},{"nodeId":741361206,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":4170706330,"text":"至于纳克…我想他不会再给我们添麻烦了。","nextNodeIds":[741361207]},{"nodeId":741361207,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":476871826,"text":"唉，希望我不要遇见那种…非启用他们不可的事务…","nextNodeIds":[]},{"nodeId":741361208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":3065523106,"text":"菲希里耶之前很崇拜艾德温？","nextNodeIds":[741361209]},{"nodeId":741361209,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":3881957290,"text":"…艾德温·伊斯丁豪斯先生是一个天才。和他在同一领域工作的人要么自暴自弃，要么就成为他的信徒。","nextNodeIds":[741361210]},{"nodeId":741361210,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":1856835906,"text":"菲希里耶小姐是一位非常有热情和创意的研究员，经常用很小的成本做出精彩的成果。","nextNodeIds":[741361211]},{"nodeId":741361211,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":356546618,"text":"在加入始基矿研究项目的第三技术组后，她负责抑制器的结构设计工作，和艾德温的接触次数很多。","nextNodeIds":[741361212]},{"nodeId":741361212,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":2346774610,"text":"也许，她就是那个时候成为了艾德温的信徒吧。和其他的信徒一样，艾德温的认可是她唯一的追求。","nextNodeIds":[741361213]},{"nodeId":741361213,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":2429701066,"text":"在爆炸后，她不愿意相信艾德温是爆炸的肇事者，主动申请参与调查，试图为艾德温翻案。","nextNodeIds":[741361214]},{"nodeId":741361214,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":1201114514,"text":"你也和艾德温打过交道了，对他感觉如何？","nextNodeIds":[741361215]},{"nodeId":741361215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","textMapHash":2067712938,"text":"是个除了研究之外什么都不管的怪人！就会推卸责任，而且连菲希里耶小姐的名字都记不住！","nextNodeIds":[741361216]},{"nodeId":741361216,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":67716146,"text":"没错，他就是这样的人。除了手头的研究之外，几乎没有任何东西和人值得他注意。","nextNodeIds":[741361217]},{"nodeId":741361217,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":988550314,"text":"只要研究顺利，他也几乎不会管其他任何事务，就连他手下的研究员偷偷倒卖研究资产也毫不关心。","nextNodeIds":[741361218]},{"nodeId":741361218,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":1663170906,"text":"我之所以答应菲希里耶参与调查…只是希望她能早日明白，自己所追逐的一个由她自己想象出来的幻影。","nextNodeIds":[741361219]},{"nodeId":741361219,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":2818778106,"text":"现在，幻影终于破灭了。希望她能早日振作起来…枫丹科学院不能再失去任何研究员了。","nextNodeIds":[]},{"nodeId":741361220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":4117978002,"text":"再见。","nextNodeIds":[741361221]},{"nodeId":741361221,"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多","textMapHash":2657828122,"text":"再见，荣誉高级研究员。","nextNodeIds":[]}]},{"talkId":7413613,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7413611","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7413613,"initDialog":741361301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5258],"performCfg":"","priority":3,"questId":74210,"showRandomTalkCount":0},"dialogs":[{"nodeId":741361301,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"舒瓦瑟尔","textMapHash":1413441202,"text":"呼…没关系，没关系，噩梦都结束了…","nextNodeIds":[741361302,741361305,741361309]},{"nodeId":741361302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":3459260218,"text":"对艾德温复活有什么感想？","nextNodeIds":[741361303]},{"nodeId":741361303,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"舒瓦瑟尔","textMapHash":2598753674,"text":"哎哟！您吓我一跳，感想？我没什么感想，只希望这不负责任的混账能付出代价！","nextNodeIds":[741361304]},{"nodeId":741361304,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"舒瓦瑟尔","textMapHash":1064487650,"text":"如果可能的话，我恨不得把他的手脚都绑上，眼睛蒙起来，免得他再接触始基矿！","nextNodeIds":[]},{"nodeId":741361305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":1761765362,"text":"现在能放下心了吗？","nextNodeIds":[741361306]},{"nodeId":741361306,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"舒瓦瑟尔","textMapHash":109242522,"text":"与之前相比，我的确能稍微安心一些了。","nextNodeIds":[741361307]},{"nodeId":741361307,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"舒瓦瑟尔","textMapHash":3493594802,"text":"但说实话…把纳克和艾德温关在一起？天哪！我都不知道他们会做什么事！","nextNodeIds":[741361308]},{"nodeId":741361308,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"舒瓦瑟尔","textMapHash":20968810,"text":"上次是爆炸，下次是什么？用枫达淹没整个枫丹？我真是不敢想…","nextNodeIds":[]},{"nodeId":741361309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":1111882426,"text":"祝你有个好心情。","nextNodeIds":[741361310]},{"nodeId":741361310,"roleType":"TALK_ROLE_NPC","speakerId":5258,"speakerName":"舒瓦瑟尔","textMapHash":1625022826,"text":"也祝您有美好的一天，荣誉高级研究员。","nextNodeIds":[]}]},{"talkId":7413614,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7413611","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7413614,"initDialog":741361401,"nextRandomTalks":[],"nextTalks":[],"npcId":[5275,5274,5273,1005],"performCfg":"QuestDialogue/WQ/Fontaine_74136/Q7413614","priority":3,"questId":74210,"showRandomTalkCount":0},"dialogs":[{"nodeId":741361401,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"菲希里耶","textMapHash":3825626,"text":"…没有价值…我的研究没价值…","nextNodeIds":[741361402]},{"nodeId":741361402,"roleType":"TALK_ROLE_NPC","speakerId":5274,"speakerName":"勒马克","textMapHash":1407651314,"text":"小姐，您不必这么想，您的发明可是救了我一命啊。","nextNodeIds":[741361403]},{"nodeId":741361403,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"菲希里耶","textMapHash":883481866,"text":"但…但艾德温前辈…呜呜…艾德温先生说，说这个东西没价值！呜呜呜…","nextNodeIds":[741361404]},{"nodeId":741361404,"roleType":"TALK_ROLE_NPC","speakerId":5273,"speakerName":"肖西韦尔","textMapHash":4034891298,"text":"是那个叫艾德温的人没眼力，明明是个宝贝！什么叫没价值？我都想给我手下的兄弟每人配一个了。","nextNodeIds":[741361405]},{"nodeId":741361405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":1886215570,"text":"艾德温是坏人，他说的是谎话。","nextNodeIds":[741361406]},{"nodeId":741361406,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"菲希里耶","textMapHash":1106405298,"text":"艾德温前辈不是坏人！他…他…反正…他都不记得我的名字！我还给他看过好多次设计图，呜呜呜…","nextNodeIds":[741361407]},{"nodeId":741361407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","textMapHash":2501965130,"text":"菲希里耶小姐，你明明就是一个很厉害的人呀，为什么一定要让艾德温那家伙评价你呢？","nextNodeIds":[741361408]},{"nodeId":741361408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":925418674,"text":"他觉得坏，我觉得好！","nextNodeIds":[741361409]},{"nodeId":741361409,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"菲希里耶","textMapHash":1855122282,"text":"真…真的？","nextNodeIds":[741361410]},{"nodeId":741361410,"roleType":"TALK_ROLE_NPC","speakerId":5273,"speakerName":"肖西韦尔","textMapHash":464102266,"text":"真的啊，你看我们都这么觉得。","nextNodeIds":[741361411]},{"nodeId":741361411,"roleType":"TALK_ROLE_NPC","speakerId":5275,"speakerName":"菲希里耶","textMapHash":2304866602,"text":"可是，你们又不懂研究——呜呜呜——","nextNodeIds":[741361412]},{"nodeId":741361412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"派蒙","textMapHash":1955551074,"text":"菲希里耶小姐…完全陷入混乱状态了呢。不然…我们还是让她一个人静一会吧…","nextNodeIds":[741361413]},{"nodeId":741361413,"roleType":"TALK_ROLE_NPC","speakerId":5273,"speakerName":"肖西韦尔","textMapHash":3669097506,"text":"行…我和勒马克就在旁边等着，有什么事叫我们。","nextNodeIds":[]}]}],"questNarration":[],"talkIds":[7413612,7413613,7413614],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5257,"speakerName":"雷蒙多