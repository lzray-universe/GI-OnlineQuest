xtNodeIds":[701440103]},{"nodeId":701440103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":1196114002,"text":"有这些发现。","nextNodeIds":[701440104]},{"nodeId":701440104,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":203489514,"text":"这种东西是什么时候出现在雪山里的…","nextNodeIds":[701440105]},{"nodeId":701440105,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2820846962,"text":"谢谢你帮忙调查，我会向协会报告这件事的，这些报酬给你，辛苦了。","nextNodeIds":[]}]},{"talkId":7014402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7014402,"initDialog":701440201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1665],"performCfg":"","priority":5,"questId":70144,"showRandomTalkCount":0},"dialogs":[{"nodeId":701440201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":381955618,"text":"有什么委托吗？","nextNodeIds":[701440202]},{"nodeId":701440202,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":694144834,"text":"委托？唔，你来得正好，我正好想要找一位经验丰富的冒险家，帮我去调查一股奇怪的寒流。","nextNodeIds":[701440203]},{"nodeId":701440203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":2906797770,"text":"寒流？","nextNodeIds":[701440204]},{"nodeId":701440204,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2695363002,"text":"是这样的。之前有一支小队进山考察，有几位经验丰富的冒险家同行。走的路线也是最安全的，绕开了一切危险的区域。","nextNodeIds":[701440205]},{"nodeId":701440205,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2368281346,"text":"但是，不知道发生了什么，他们在考察的途中突然遭到了一阵猛烈的寒流，被迫撤回了营地。","nextNodeIds":[701440206]},{"nodeId":701440206,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":3592694466,"text":"据回来的冒险家说，他们走的那条路根本不可能出现那种强度的寒流，而且，那股寒流来得毫无征兆，感觉根本不像什么自然现象。","nextNodeIds":[701440207]},{"nodeId":701440207,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2638084226,"text":"之后，又有好几个在山里考察或者勘探的人报告了这种情况，在组织了几次调查行动后，我们总算确定了那股寒流的来源。","nextNodeIds":[701440208]},{"nodeId":701440208,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2088401698,"text":"但是，在那么多次调查后，调查队里的冒险家们要么冻伤，要么脱力，必须在营地里休息，我们暂时也抽调不出能继续深入调查的人手…","nextNodeIds":[701440209]},{"nodeId":701440209,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":3370812226,"text":"旅行者，如果你愿意帮忙的话，可以代我们去那股严寒的源头看一看吗？","nextNodeIds":[701440210,701440212]},{"nodeId":701440210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":2511728890,"text":"交给我吧。","nextNodeIds":[701440211]},{"nodeId":701440211,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":3174174466,"text":"那就拜托你了，那股严寒十分诡异，请一定要做好准备。","nextNodeIds":[701440215]},{"nodeId":701440215,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2248644858,"text":"那么，就请你快去那里调查一下吧，拜托你了。","nextNodeIds":[]},{"nodeId":701440212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅行者","textMapHash":4066288850,"text":"关于报酬…","nextNodeIds":[701440213]},{"nodeId":701440213,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2826905258,"text":"喔？你倒是很直接嘛。放心吧，协会可不会亏待冒险家，我会准备好报酬，在营地等着你的。","nextNodeIds":[701440214]},{"nodeId":701440214,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":44027922,"text":"至于具体的数目…那就要视你带回来的调查结果而定了，规矩你懂的，对吧？","nextNodeIds":[701440215]}]},{"talkId":7014403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUE