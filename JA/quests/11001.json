Npc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100102","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100102,"initDialog":110010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[153701],"performCfg":"QuestDialogue/LQ/Xiangling1_11001/Q1100102","priority":5,"questId":11001,"showRandomTalkCount":0},"dialogs":[{"nodeId":110010201,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":2213579126,"text":"お前が香菱、だな？","nextNodeIds":[110010202]},{"nodeId":110010202,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":249325334,"text":"ごめんなさい、ドゥラフさん、アタシが全部悪いの。","nextNodeIds":[110010203]},{"nodeId":110010203,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":1289941974,"text":"お前がしたことは全部聞いた。ここに来たからには——","nextNodeIds":[110010204]},{"nodeId":110010204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":831125566,"text":"ひやうっ！","nextNodeIds":[110010205,110010206]},{"nodeId":110010205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3172641334,"text":"ぼ、暴力反対！","nextNodeIds":[110010207]},{"nodeId":110010207,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":2256496238,"text":"——俺たちの食用肉を広めてくれないか？","nextNodeIds":[110010208]},{"nodeId":110010208,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":2543441222,"text":"…へっ？","nextNodeIds":[110010209]},{"nodeId":110010209,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":2013972686,"text":"突然ですまない。詳しく説明する。","nextNodeIds":[110010210]},{"nodeId":110010210,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":236634398,"text":"清泉町の肉は高品質で有名だが、その名がモンドだけに留まるのはもったいないと思っているんだ。","nextNodeIds":[110010211]},{"nodeId":110010211,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":3227985430,"text":"そんな時、ちょうど香菱シェフがモンドに来たと耳にしてな。呼んで来いとエレンに言っておいたんだ。","nextNodeIds":[110010212]},{"nodeId":110010212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":639035878,"text":"シェフ？","nextNodeIds":[110010213]},{"nodeId":110010213,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":1616828974,"text":"聞いたことないか？璃月港で庶民向けの料理を出すことで有名な「万民堂」、そこのシェフが香菱なんだ。","nextNodeIds":[110010214]},{"nodeId":110010214,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":649055510,"text":"食材に対して独特の解釈を持っていて、その料理は璃月の人々に愛されている。観光客の間でも評判がいいんだ。","nextNodeIds":[110010215]},{"nodeId":110010215,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":2192788870,"text":"へへっ、褒めすぎだよ。アタシはただ安くて美味しい料理を作りたいだけだから。","nextNodeIds":[110010216]},{"nodeId":110010216,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":2366239654,"text":"香菱のような一流シェフが一流の肉を使って一流の料理を作れば、この清泉町の肉も広く知れ渡るだろう。","nextNodeIds":[110010217]},{"nodeId":110010217,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":775169494,"text":"えっと、でも…そのお願いは叶えられそうにないかも。","nextNodeIds":[110010218]},{"nodeId":110010218,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":3354403670,"text":"アタシ、美味しい料理を作ることだけ考えてきたから、食材が限定されてたり、宣伝したりするのは苦手で…","nextNodeIds":[110010219]},{"nodeId":110010219,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":3481016150,"text":"ここの肉はお前の使いたい食材なんだろ？何の問題もないと思うが。","nextNodeIds":[110010220]},{"nodeId":110010220,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":3618432262,"text":"ううん、違う、全然違うよ！たとえば、料理にスライムの液体を入れたいってアタシが言ったら、同意してくれる？","nextNodeIds":[110010221]},{"nodeId":110010221,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":2049146086,"text":"そ、それは…もう少し普通の食材ではダメなのか？","nextNodeIds":[110010222]},{"nodeId":110010222,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":1243549070,"text":"食材に普通もなにもないよ！調理法さえ合っていれば、どんな食材でも美味しい料理になるんだから！","nextNodeIds":[110010223]},{"nodeId":110010223,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":1818048718,"text":"食材によってインスピレーションが制限されるのは、アタシの信条に欠けるの。だって、そんなのつまらない料理しかできないもん。","nextNodeIds":[110010224,110010225]},{"nodeId":110010224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2106057470,"text":"急に強気になった…","nextNodeIds":[110010226]},{"nodeId":110010226,"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","textMapHash":1834735214,"text":"はぁ、決心が固いようだな、この話は諦めよう。しかし、本当に残念だ…","nextNodeIds":[]},{"nodeId":110010225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4104978822,"text":"これがシェフのこだわり？","nextNodeIds":[110010226]},{"nodeId":110010206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4116616918,"text":"殴るなら…こっちを！","nextNodeIds":[110010207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["153701"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1100103,"order":3,"stepDescription":"出て行くつもりの香菱について行く","stepDescT