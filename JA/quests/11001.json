,"isHidden":false,"talkIds":[1100104],"talks":[{"talkId":1100104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1100104","2"],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1100104,"initDialog":110010401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1012],"performCfg":"QuestDialogue/LQ/Xiangling1_11001/Q1100104","priority":5,"questId":11001,"showRandomTalkCount":0},"dialogs":[{"nodeId":110010401,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":3805762686,"text":"あの、この料理、食べてみてもいいかな？","nextNodeIds":[110010402]},{"nodeId":110010402,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":1151215102,"text":"ごめんなさい、予約でいっぱいでね。今からだと食べれるのは7日後になるけど、大丈夫かしら？","nextNodeIds":[110010403]},{"nodeId":110010403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1575540294,"text":"大人気だな…きっと美味しいに違いない！","nextNodeIds":[110010404]},{"nodeId":110010404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1825801398,"text":"おかしい、こんな人気のシェフがいるのに…","nextNodeIds":[110010405]},{"nodeId":110010405,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1335026686,"text":"そうだな、なんでドゥラフは香菱に依頼したんだ？","nextNodeIds":[110010406]},{"nodeId":110010406,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":3077096294,"text":"はぁ…たぶん璃月港のような商業の中心地と比べて、モンドの味は万人受けじゃないとでも思ってるんでしょうね。","nextNodeIds":[110010407]},{"nodeId":110010407,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":1614721294,"text":"でも、私はそうは思わない！私の肉料理は誰にも負けないわ！","nextNodeIds":[110010408]},{"nodeId":110010408,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":3361811966,"text":"ねぇ、特別に食べさせてよ。何かアドバイスできるかもしれない。","nextNodeIds":[110010409]},{"nodeId":110010409,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":2578488166,"text":"みんな「美味しい」しか言わないのよ、だから、あんただって…待って…まさか、あんたが香菱！？","nextNodeIds":[110010410]},{"nodeId":110010410,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":3247104686,"text":"うん、そうだよ。","nextNodeIds":[110010411]},{"nodeId":110010411,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":1954788822,"text":"そう、あんたがね。じゃあ、あんたも肉料理が得意なわけだ。","nextNodeIds":[110010412]},{"nodeId":110010412,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":3610108614,"text":"実は、今日一番のお肉をまだ取ってあるの。あんたならどう調理する？","nextNodeIds":[110010413]},{"nodeId":110010413,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":2692012518,"text":"うーん、肉の質と脂肪量で変わってくるけど、このお肉なら岩焼きにして、海塩、絶雲の唐辛子、清心の花を合わせるかな。","nextNodeIds":[110010414]},{"nodeId":110010414,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":2847214902,"text":"清心の花だって！？でも、熱い油と一緒にしたら香りが数倍にも膨れ上がって、肉本来の香りが台無しになるわよ！","nextNodeIds":[110010415]},{"nodeId":110010415,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":623178270,"text":"うん、知ってるよ。でも、この清心の花は香料ではなく付け合わせにするの。","nextNodeIds":[110010416]},{"nodeId":110010416,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":3849573022,"text":"試したことがあるんだ。火加減を上手く調節すれば、清心の花の花びらは苦みが取れて、すっきりとした味わいになるの。","nextNodeIds":[110010417]},{"nodeId":110010417,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":479319622,"text":"そこに標高の高い山で取れた絶雲の唐辛子を合わせると、低い湿度と高い温度が相まって独特の風味が生まれる。","nextNodeIds":[110010418]},{"nodeId":110010418,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":1191878030,"text":"海塩のしょっぱさ、唐辛子の辛さ、肉のジューシーな香りが全て花びらに集まって、噛むたびに植物の爽やかさを感じられるんだ。","nextNodeIds":[110010419]},{"nodeId":110010419,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":2220005126,"text":"ごちゃ混ぜになって、味がまとまらなくなりそうだけど？","nextNodeIds":[110010420]},{"nodeId":110010420,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":1286295110,"text":"焼肉の主役はお肉よ、肉の香りを損なったら本末転倒だわ！","nextNodeIds":[110010421]},{"nodeId":110010421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3628821126,"text":"わわっ、ケンカはよくない、ダメだって！","nextNodeIds":[110010422,110010423]},{"nodeId":110010422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1735100710,"text":"もうこっちの声が届いてない…","nextNodeIds":[110010424]},{"nodeId":110010424,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":108266358,"text":"そう、なら料理のことは料理で解決するしかないよね。","nextNodeIds":[110010425]},{"nodeId":110010425,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":939205326,"text":"料理対決を申し込むよ！","nextNodeIds":[110010426]},{"nodeId":110010426,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":461006702,"text":"受けて立つわ！私が勝てば、ドゥラフさんの見る目がなかったことも証明できる。","nextNodeIds":[110010427]},{"nodeId":110010427,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":419652678,"text":"じゃあ、こうしよう！もしアタシが勝ったら、その勝った料理を清泉町の宣伝に使っていい。","nextNodeIds":[110010428]},{"nodeId":110010428,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":3214330694,"text":"ええ、なら私が勝ったら、私の料理を「万民堂」のメニューに入れてもらうわよ。","nextNodeIds":[110010429]},{"nodeId":110010429,"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerName":"ブロック","textMapHash":1817454838,"text":"「清泉町のお肉専門シェフ、ブロックの一品」って言葉も入れてもらうわ。","nextNodeIds":[110010430]},{"nodeId":110010430,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":1195324670,"text":"問題ない、約束するよ！","nextNodeIds":[110010431]},{"nodeId":110010431,"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","textMapHash":2782869918,"text":"じゃあ、食材を探してくる！","nextNodeIds":[110010432]},{"nodeId":110010432,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":10191374,"text":"おい、待てよ！","nextNodeIds":[110010433]},{"nodeId":110010433,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2745288806,"text":"#{NICKNAME}、追いかけるしかないな。","nextNodeIds":[]},{"nodeId":110010423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":779764358,"text":"これがライバルか。","nextNodeIds":[110010424]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1100104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1012"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1100102,1100104],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1012,"speakerName":"香菱","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":153701,"speakerName":"ドゥラフ","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":154101,"speakerN