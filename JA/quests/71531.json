531,"showRandomTalkCount":0},"dialogs":[{"nodeId":715310101,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":1919536330,"text":"まんまるふわふわ、ぷにぷにぴょんぴょん…","nextNodeIds":[715310102]},{"nodeId":715310102,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":3307509274,"text":"あら、お客様でしたか。こんにちは。まずはこの文尋から、お二人に海灯祭のご挨拶を申し上げます。","nextNodeIds":[715310103]},{"nodeId":715310103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2426779882,"text":"海灯祭を祝して！文尋さん！","nextNodeIds":[715310104]},{"nodeId":715310104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4140188522,"text":"さっきなんかつぶやいてたよな。なにぶつぶつ言ってたんだ？","nextNodeIds":[715310105,715310106]},{"nodeId":715310105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2074791010,"text":"美味しいおやつのこととか？","nextNodeIds":[715310107]},{"nodeId":715310107,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":1970756674,"text":"まぁ、そんなところです。グゥオパァーと月桂が作る美食について考えていたんですよ。","nextNodeIds":[715310108]},{"nodeId":715310108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2739361690,"text":"えっ？突然聞き慣れた名前が…おまえもグゥオパァーと月桂を知ってるのか？","nextNodeIds":[715310109]},{"nodeId":715310109,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":1267051738,"text":"ふふっ、それは当然です。私は万民堂の常連ですから！","nextNodeIds":[715310110]},{"nodeId":715310110,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":3839299930,"text":"旅行中でない限りは、一週間に最低七回は万民堂に通っているんですよ。","nextNodeIds":[715310111]},{"nodeId":715310111,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":2669220290,"text":"我が家の定番メニューと合わせれば、一食はあっさり系、一食はピリ辛系になって最高なんですよ！","nextNodeIds":[715310112]},{"nodeId":715310112,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":651128722,"text":"たとえ辛さで体が火照っても、熱冷ましの生薬をいくつか摂って、二日ほどゆっくり休めば、また思う存分食べられるようになります。","nextNodeIds":[715310113,715310114]},{"nodeId":715310113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3764194522,"text":"すごいね…","nextNodeIds":[715310115]},{"nodeId":715310115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2746467602,"text":"おおお…！オイラもそんな暮らしがしてみたいぞ…","nextNodeIds":[715310116]},{"nodeId":715310116,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":2985893170,"text":"とにかく、ほぼ毎週グゥオパァーと香菱さんには会っていますし、時々ヨォーヨに会う事もあるんですよ。","nextNodeIds":[715310117]},{"nodeId":715310117,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":1851398242,"text":"ヨォーヨが月桂を連れて香菱さんを訪ねると、グゥオパァーと月桂が一緒にその辺で遊んでいるんです。","nextNodeIds":[715310118]},{"nodeId":715310118,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":2757615250,"text":"それがいいんですよねぇ。グゥオパァーと月桂がよちよち歩いているのを見るだけで、仕事の疲れが吹き飛びます。","nextNodeIds":[715310119]},{"nodeId":715310119,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":576513938,"text":"私だけがグゥオパァーと月桂の癒しを独り占めするわけにはいきません。皆さんにも二人の愛らしさを見ていただかないと！","nextNodeIds":[715310120]},{"nodeId":715310120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":919430954,"text":"おう！そういうの、大事だと思うぞ。でも、どうやるんだ？","nextNodeIds":[715310121]},{"nodeId":715310121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":926863010,"text":"まさかそのテーブルの上にあるのが…","nextNodeIds":[715310122]},{"nodeId":715310122,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":3198813554,"text":"その通り！さっき、グゥオパァーと月桂を主役にした「紙映影」が完成したんです。この屋台にあるのは全部「紙映影」の道具なんですよ。","nextNodeIds":[715310123]},{"nodeId":715310123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2454238794,"text":"「紙映影」…なんか聞いた覚えがあるような？おまえの後ろにある画板で観る…映影だっけか？","nextNodeIds":[715310124]},{"nodeId":715310124,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":1641441050,"text":"「紙映戯」といえばご存知かもしれませんね。璃月に古くから伝わる芸術です。写真と照明を巧みに活用して、幕に映る絵を「生き生き」させるのです。","nextNodeIds":[715310125]},{"nodeId":715310125,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":3191655978,"text":"私は小さい頃から「紙映戯」が大好きで、応公師匠のもとで修業をしました。大人になってからは絵師になって、あちこちに遊学していたんです。","nextNodeIds":[715310126]},{"nodeId":715310126,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":440340170,"text":"フォンテーヌを旅している時、新しい絵画技法や映影技術に触れて、たくさんの着想を得ました。","nextNodeIds":[715310127]},{"nodeId":715310127,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":2116670770,"text":"そこで「紙映戯」を元に、より斬新なインタラクティブゲームを作ったんです。それがあなた方の目の前にある「紙映影」です！","nextNodeIds":[715310128]},{"nodeId":715310128,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":37512898,"text":"「紙映影」は「紙映戯」とは異なり、単純明快な物語で観衆をくすっと笑わせることに重点を置いています。","nextNodeIds":[715310129]},{"nodeId":715310129,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":2823830482,"text":"ということで、今年最初の「紙映影」では、皆さんに非常に親しみやすい物語——グゥオパァーと月桂が力を合わせて食材を探し、美食を作るお話です！","nextNodeIds":[715310130]},{"nodeId":715310130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4126442930,"text":"グゥオパァーと月桂が一緒に料理するのか？なんだかおもしろそうだな！","nextNodeIds":[715310131,715310132]},{"nodeId":715310131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":623017842,"text":"楽しそうで美味しそうな話！","nextNodeIds":[715310133]},{"nodeId":715310133,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":2231600386,"text":"ふふっ、興味津々なお二人を見て、私も凄くやる気が湧いてきました！","nextNodeIds":[715310134]},{"nodeId":715310134,"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","textMapHash":1067342194,"text":"それでは早速、お二人にはごゆっくり「紙映影」を体験していただければと思います！","nextNodeIds":[]},{"nodeId":715310132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2493532314,"text":"#{M#俺}{F#私}もじっくり観てみたい！","nextNodeIds":[715310133]},{"nodeId":715310114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":875182410,"text":"やり過ぎはよくないよ…","nextNodeIds":[715310115]},{"nodeId":715310106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1336420458,"text":"それとも新メニューのこと？","nextNodeIds":[715310107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30458"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7153101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30458,"speakerName":"文尋","count":20},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171531],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2120929662,"CHECNJEMEFE":{"30458":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Liyue_71531/Q7153101","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJ