tions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[41220,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2944554642,"text":"久しぶりっす。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":838375546,"text":"立本さん、最近はどう？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":4076279874,"text":"転機が訪れたって感じっすね。スメールを出た後、俺は稲妻で商品を仕入れてたんっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1976617938,"text":"スメールの情勢がなーんか微妙な感じだったんで、運試しのつもりでフォンテーヌに行ったっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2929397522,"text":"現地の市場を研究するつもりで、元手さえ取り返せればそれでいいって感じだったんすよ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3963832490,"text":"まさか、稲妻の商品がフォンテーヌ人に大人気とは思わなかったっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":4173765882,"text":"他の国では売れない在庫…例えばヒナさんのグッズなんかが、なんと売り切れになったんすよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4189447978,"text":"よかったね。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3972704762,"text":"ヒナさんの魅力が認められたんだ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":686777730,"text":"フォンテーヌ人は機械をいじるのが好きで、こういう小物に時間を費やす人はほとんどいないんっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2105219650,"text":"これがいわゆる、珍しいものほど価値が高いってことなんすかね。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":8431890,"text":"もし状況がやばそうじゃなかったら、もう何回か行きたいところだったんすけど。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2304024258,"text":"何があったの？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1911695706,"text":"窮屈で危なくて、もうすぐ嵐が来るーって感じっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":114017450,"text":"地元の人がみんな気を張ってて、裁きが下るとか言ってるんすよ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":887238138,"text":"暫くはあそこ、行かないほうがいいっすよ。何かトラブルにでも遭ったら、簡単に抜け出せないかもっすし。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3062504098,"text":"気に留めておくよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3745628074,"text":"#{M#君}{F#あなた}も気を付けて。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3435678194,"text":"それじゃ、いつも通り。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2367937762,"text":"もう一度自己紹介してくれる？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3884666346,"text":"俺は立本っす、昔は珍貨商人で食ってたっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":807863322,"text":"最近は良い商売ができてるんっすよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2169635250,"text":"儲け話って？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1844119634,"text":"俺は様々な宝物が入ってる珍品の箱を食材の原料や日用品と交換してるっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2770666418,"text":"箱には珍貨商人時代の全財産が入ってるんす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1316824602,"text":"なんで福袋みたいなものにしたかって？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":563465538,"text":"みんなこういうの、好きじゃないっすか。こうした方が交換してくれる人が多いんすよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4039549098,"text":"もう一度自己紹介してくれる？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2863979482,"text":"俺は立本っす。前は珍貨商人で食ってたんすけど。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":295394042,"text":"最近は良い商売ができてるんっすよ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3500332338,"text":"この前、販路を拡大して一儲けしようと思って、ナド・クライってところに行ってきたんす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3100551890,"text":"まあ…ここにいるってことは、失敗したんすけどね。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1713494362,"text":"何の商売をしてるの？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1237393074,"text":"この珍品の箱には色々宝物が入ってるんすけど、これを食材とか日用品と交換してるんす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3362641978,"text":"箱には珍貨商人時代の全財産を入れてあるんすよ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":944798594,"text":"なんで福袋みたいにしたかって？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":543796090,"text":"みんなこういうの、好きじゃないっすか。こうした方が交換してくれる人が多いんすよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1911539242,"text":"それで儲かるの？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":4227475746,"text":"んー…ナタに販路を見出したほうがよかったんすかね？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":802513938,"text":"それか、護衛を雇って、もう一回ナド・クライに行ってみるのもありかもしれないっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2036194714,"text":"正直、ちょっと疲れたんで…"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":981749602,"text":"しばらく休んで、また考えようかなって！"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2325751778,"text":"久しぶりっすね。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1316573002,"text":"どう、順調？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2087192002,"text":"人生山あり谷あり…もう慣れっこっす。ちっちゃい病気や赤字なんて、気にしない気にしない。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1909871898,"text":"つまり、順調にやってるって言っていいかもっすね、ははっ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":514929746,"text":"そっちはどっすか？"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3219672458,"text":"悪くない。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3251788858,"text":"そりゃよかったっす。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":729943882,"text":"あまり良くない。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2362242394,"text":"そうなんすか？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":809278586,"text":"俺は今日めちゃくちゃ嬉しいっすよ、こうしてまたダチに会えたっすから。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2340403658,"text":"最近はどう？また面白い話はある？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3030690482,"text":"俺がビジネスチャンスを求めてそろそろナタに行くと思って、情報を聞き出しに来たんすか～？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":97559834,"text":"ははは、今回はナタに行こうとは思ってないっすけどね。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2200452946,"text":"こないだ、うっかりでっかい穴に落ちちゃって、一晩中星空を眺めて過ごしたんすよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3482835978,"text":"それは「順調」とは言えないね…"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3828933162,"text":"でも最後は通りすがりの冒険者のお姉さんに助けてもらえたんで、空腹に悩まされることはなかったんす。これで順調ってことになるっしょ？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1434968858,"text":"夜の星を見ながら考えたんすよね、この世界の向こうにはいったい何があるんだろうって。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2513825394,"text":"えっと、果てなき彼方と無限の世界…かな。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2961214938,"text":"君もそう思うっすか？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1408951858,"text":"俺が考えたのは、もし見えてる星が実はぜんぶ太陽で、それぞれの太陽の近くに、行くことのできる世界があったらどうだろう…ってことっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1378994194,"text":"それかいっそ、見えてる星がぜんぶ行ける場所だとしたら？光ってるだけっすし、もしかしたら熱くないってこともあるっしょ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4119057362,"text":"あんなに光ってたら、夜眠れないよ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2547436850,"text":"それもそうっすね。じゃあ観光しに行くだけでいいっす。それなら生きてる人間もいないだろうから、商売もできないし。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1946499978,"text":"販路を拡張しようとしてるの？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1593705658,"text":"さあ、空の上にある国もモラを使うんすかね？ただ、一日中光ってるから、ああいうところに生きた人間はいないんじゃないすかね。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3069472954,"text":"話を戻しますけど、ダチのほうはいつも通りなんすか？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":4155516482,"text":"久しぶりっす！"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":540877074,"text":"立本さん、久しぶり！"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1534926298,"text":"へへっ、相変わらずフレンドリーっすね…俺、老けたりしてないっすよね？"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2242014506,"text":"変わってないよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2693231402,"text":"ますますフレンドリーになったね。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":4096995914,"text":"ならよかったっす。実は今回、危うく帰れなくなるとこだったっんすよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2628490018,"text":"ナタに行ってきたの？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1347068074,"text":"いや、ナタは情勢が不安定だって聞いて、別んとこにしたんす。「ナド・クライ」ってとこなんすけど。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":4106044138,"text":"ナド・クライには行ったことあります？"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4045851738,"text":"行ったことない。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3401788362,"text":"どんなところ？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2286237442,"text":"そうなんすね。そしたら俺が教えるっすよ。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":456184338,"text":"ナド・クライは、スネージナヤの南端なんすけど、世界中の人が集まってるところなんっす。事情を知らない人には、ビジネスチャンスがごろごろ転がってるように見えるかもっすね。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3772073530,"text":"でも実際行ってみると、かなり荒れてて…なんつーか…独特な秩序で成り立ってるっていうか。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3770606314,"text":"独特な秩序？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2308104586,"text":"具体的に言うと、着いたとたん、流浪者に襲われたんっすよ。よそ者だから甘く見られたんすかね。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":1583553890,"text":"でも、あそこには騎士団も法廷もなくって。周りの人から「ヴォイニッチ商会」ってところに行ってみなさいって勧められたんす——"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3469454954,"text":"現地じゃ一番の勢力を誇るとこだから、なんとかしてくれるかもって。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":4254760882,"text":"最初は半信半疑だったんすけど、なんと商会の人はあっという間に俺のものを全部取り戻してくれたんっすよ。マジすごかったっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2200619146,"text":"がっぽり稼いだモラを何度も数えながら、天にも昇る思いだったっす——"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2547860330,"text":"商売大成功ってこと？よかったね！"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3014067706,"text":"帰れなくなるかもってどういうこと？"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":3081466242,"text":"はぁ、それが…町を出る時、また流浪者と鉢合わせして、モラを全部取られてしまったんっす。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":409995714,"text":"町にいる時から狙われてたのかも…"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":764870114,"text":"はぁ…ま、そういう紆余曲折も俺っつー人間の人生っすからね。とにかく、ナド・クライにはしばらく行かないっす。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":2004981770,"text":"もしナド・クライに行くなら、くれぐれも気を付けるんすよ。モラをたくさん持ってるって知られないように注意したほうがいいっす。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2757891986,"text":"ありがとう。気を付けるね。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3145073738,"text":"#{M#君}{F#あなた}も気を付けて。"},{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","textMapHash":275104314,"text":"じゃあ今回も、いつも通りでいいっすか？"}],"talkIds":[],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30001,"speakerName":"立本","count":68},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":29}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[],"IBNCKLKHAKG":0,"IEGCPJALJOA":0,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","ILHDNJDDEOP":41220,"ILICEMABDDI":[],"JAPLGJLDPHJ":[],"JDCIPCDDDPK":0,"JDEFCNEDMLL":0,"KCONOGOIGIH":0,"LEFIHLHODBM":[],"LMCFKPMJGEO":false,"MEJIMPLKPHN":0,"MHHFFHCLDKI":false,"MMOEEOFGHHG":1548182127,"NJGLJLODPBN":false,"NKAKCKAJCLD":0,"NOCNCPAGOPC":"","OPIDGNOCOHD":"QUEST_HIDDEN","PAINLIBBLDK":"EQ","PEDANLIDLGE":0,"PEFIFLDHPEE":false,"PIGI