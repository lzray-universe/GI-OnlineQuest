:["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1500501,"initDialog":150050101,"nextRandomTalks":[],"nextTalks":[],"npcId":[14227,14228],"performCfg":"QuestDialogue/LQ/Mualani_15005/Q1500501","priority":5,"questId":15005,"showRandomTalkCount":0},"dialogs":[{"nodeId":150050101,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":2849889178,"text":"コホラ竜たちは逃げていった。","nextNodeIds":[150050102]},{"nodeId":150050102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":319704578,"text":"その格好…もしかしてスメールから来た学者か？","nextNodeIds":[150050103]},{"nodeId":150050103,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","textMapHash":1145098434,"text":"はい、カーリャと申します。こちらはヴィランドラさんです。危ないところを助けていただき本当にありがとうございました…！","nextNodeIds":[150050104]},{"nodeId":150050104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1722990562,"text":"お礼なんかいいぞ、このくらいお安い御用だからな。オイラはパイモン、こいつは旅人だ。","nextNodeIds":[150050105]},{"nodeId":150050105,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"ヴィランドラ","textMapHash":1704002818,"text":"はぁ…コホラ竜たちがみんな逃げてしまった。せめて一匹だけでも生け捕りできていれば…","nextNodeIds":[150050106]},{"nodeId":150050106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1691779314,"text":"生け捕り？","nextNodeIds":[150050107]},{"nodeId":150050107,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"ヴィランドラ","textMapHash":1487826082,"text":"君たち、それなりの腕の持ち主のようだな。僕がおとりになるから、コホラ竜が来たら、一匹でいいから生け捕りにしてくれないか！もちろん報酬はちゃんと払う！","nextNodeIds":[150050108]},{"nodeId":150050108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3320374258,"text":"えっと…","nextNodeIds":[150050109]},{"nodeId":150050109,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","textMapHash":4246465714,"text":"申し訳ありません。ヴィランドラ先輩は研究のことになると熱くなってしまうんです…どうかお気になさらずに…","nextNodeIds":[150050110]},{"nodeId":150050110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":362187098,"text":"気にしないでいいぞ！それで、どうして野生のコホラ竜にちょっかいかけてたんだ？それに生け捕りだなんて…","nextNodeIds":[150050111]},{"nodeId":150050111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3816087434,"text":"#{M#君}{F#あなた}たちも記念写真を撮りたいの？","nextNodeIds":[150050112]},{"nodeId":150050112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2972206346,"text":"そんなんじゃないに決まってるだろ！","nextNodeIds":[150050113]},{"nodeId":150050113,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","textMapHash":3387602138,"text":"お見苦しいところをお見せしてしまいましたね…実は私たち、伝説の「神秘の島」を探しているんです。重要な手がかりがコホラ竜にあると風の噂で耳にしまして…","nextNodeIds":[150050114]},{"nodeId":150050114,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","textMapHash":3840189930,"text":"「流泉の衆」のガイドもいないのに、コホラ竜に接触するのはやはり無謀でしたね。","nextNodeIds":[150050115]},{"nodeId":150050115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4066384338,"text":"神秘の島…？","nextNodeIds":[150050116]},{"nodeId":150050116,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","textMapHash":2786458874,"text":"ええ。「流泉の衆」の伝説には、ある謎の島が出てくるんです。先輩は自分の研究目標がその島にあると信じていらっしゃるんですよ。","nextNodeIds":[150050117]},{"nodeId":150050117,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"ヴィランドラ","textMapHash":983576610,"text":"コホン…というわけだ。さっきの件、もう一度検討してみてくれないか？","nextNodeIds":[150050118]},{"nodeId":150050118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1830413338,"text":"さっきの件って…人間をおとりにするなんて真似、絶対にやらないぞ！","nextNodeIds":[150050119]},{"nodeId":150050119,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"ヴィランドラ","textMapHash":2234184914,"text":"そうか。ならこれ以上話を続けても時間の無駄だな。他の方法を考えないと…","nextNodeIds":[150050120]},{"nodeId":150050120,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","textMapHash":3369478298,"text":"先輩！","nextNodeIds":[150050121]},{"nodeId":150050121,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"ヴィランドラ","textMapHash":2420396154,"text":"わかったわかった…さっきは確かに助けてもらった。感情からしても理屈からしても、ここは礼を言うべきだと思う…本当にありがとう。","nextNodeIds":[150050122]},{"nodeId":150050122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":470782058,"text":"素直じゃないやつだな…","nextNodeIds":[150050123]},{"nodeId":150050123,"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"ヴィランドラ","textMapHash":2957974642,"text":"カーリャ、そろそろ行こう。","nextNodeIds":[150050124]},{"nodeId":150050124,"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","textMapHash":4218239130,"text":"本当に申し訳ありません。ヴィランドラ先輩は人付き合いに疎くて…","nextNodeIds":[150050125]},{"nodeId":150050125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4161811202,"text":"気にしないでいいぞ。じゃあな！","nextNodeIds":[150050126]},{"nodeId":150050126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2742014178,"text":"あんな二人がチームを組んで冒険してるだなんて、不思議だな。","nextNodeIds":[150050127]},{"nodeId":150050127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":727505146,"text":"それにしても…あのお姉さんが言ってた「神秘の島」が気になるんだよなあ。","nextNodeIds":[150050128]},{"nodeId":150050128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3515904026,"text":"パイモンもそこに行きたいの？","nextNodeIds":[150050129]},{"nodeId":150050129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2142472826,"text":"だって、もしかしたらお宝があるかもしれないだろ！","nextNodeIds":[150050130]},{"nodeId":150050130,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2476329922,"text":"今まであれだけ不思議な場所を探索してきたんだし、神秘の島とやらを見つけるのだって楽勝だと思うぜ！","nextNodeIds":[150050131]},{"nodeId":150050131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":425245426,"text":"でも、何の情報もないよ。","nextNodeIds":[150050132]},{"nodeId":150050132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2010111114,"text":"それもそうだな…あっ、でもさっきのお姉さんが、神秘の島は「流泉の衆」の伝説に出てくる島だって言ってたよな。部族のやつらに聞いてみるのはどうだ？","nextNodeIds":[150050133]},{"nodeId":150050133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1968718762,"text":"善は急げだ。さっそく次の冒険を始めようぜ！","nextNodeIds":[150050134]},{"nodeId":150050134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3252115026,"text":"聞こうって決めたはいいけど…誰に聞けばいいんだろうな？","nextNodeIds":[150050135]},{"nodeId":150050135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3323617522,"text":"族長に直接聞くのもいいかも？","nextNodeIds":[150050136]},{"nodeId":150050136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4130021258,"text":"うーん…確かに、神秘の島は「流泉の衆」の伝説と関係してるって、あのお姉さん言ってたしな。「流泉の衆」の族長ならきっとなにか知ってるぞ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1500501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133502195"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q1500501_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1500501,1500502],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":24},{"roleType":"TALK_ROLE_NPC","speakerId":14228,"speakerName":"カーリャ","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":14227,"speakerName":"ヴィランドラ","count":6},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerI