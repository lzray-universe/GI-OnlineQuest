tNodeIds":[750960102]},{"nodeId":750960102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1739026906,"text":"オイラたち、下でいろんなことをしてきたぞ…","nextNodeIds":[750960103]},{"nodeId":750960103,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3048677362,"text":"ポカにフレイムグレネードの木の根っこで起こったことを話した…","nextNodeIds":[750960104]},{"nodeId":750960104,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":3037300466,"text":"ティザコのやつ、本当にやっつけてくれたのね…よし、これでワイナ兄貴に報告ができる。もう謎煙の主や豊穣の邦に頭を下げる必要はないわ。","nextNodeIds":[750960105]},{"nodeId":750960105,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":3179467354,"text":"彼ならできるって、私信じてたから。","nextNodeIds":[750960106]},{"nodeId":750960106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4160899218,"text":"えっ、ワイナ兄貴って、最初からフレイムグレネードの木の根っこに問題があるって知ってたのかよ…","nextNodeIds":[750960107]},{"nodeId":750960107,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":784551570,"text":"そりゃもちろん、フレイムグレネードの母樹の情況ならみんな知ってたわよ。誰もまだ知らないと思い込んでたのは、ティザコだけ。おまけに意地でも自分で解決しようとしていたんだから…","nextNodeIds":[750960108]},{"nodeId":750960108,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":2754112650,"text":"頑固なところはあるけど、多分そういうところがみんなから好かれているんだろうね。","nextNodeIds":[750960109]},{"nodeId":750960109,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":428451466,"text":"#今回も本当にありがとう。あはは、実を言えば、あなたたちの名前はとっくに知ってたんだ、パイモン、{NICKNAME}。なんたって伝達使は、情報で食っているからね。","nextNodeIds":[750960110]},{"nodeId":750960110,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":3553056682,"text":"だから少し利用させてもらったよ…君たちが現れる場所に通行証を置いたりしてね。","nextNodeIds":[750960111]},{"nodeId":750960111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3035389146,"text":"えっ！？全部おまえの仕業だったのか！","nextNodeIds":[750960112]},{"nodeId":750960112,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":713065290,"text":"あはは、もちろん。あの石頭から多分報酬をもらってるだろうから、こっちも負けてらんないわ。はい、これをどうぞ！","nextNodeIds":[750960113]},{"nodeId":750960113,"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","textMapHash":3106373530,"text":"だから報酬に免じてさ、二人とも大目に見てくれないかしら…","nextNodeIds":[]}]},{"talkId":7509602,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7509601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7509602,"initDialog":750960201,"nextRandomTalks":[],"nextTalks":[],"npcId":[6132],"performCfg":"","priority":5,"questId":75096,"showRandomTalkCount":0},"dialogs":[{"nodeId":750960201,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":3416728674,"text":"「山の王のフレイムグレネード」がやっと熟しましたか。これでやっと、一息つけますね。","nextNodeIds":[750960202]},{"nodeId":750960202,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":2828251018,"text":"おや、あなたたちでしたか。どうしました？もし入るのなら、ささっと終わらせてくださいね、部族の人にバレたら大変ですから！","nextNodeIds":[750960203,750960208,750960212]},{"nodeId":750960203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4120880570,"text":"「山の王」について…","nextNodeIds":[750960204]},{"nodeId":750960204,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":1434730858,"text":"ほう、「山の王」についてですか…","nextNodeIds":[750960205]},{"nodeId":750960205,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":922942162,"text":"「山の王」コンガマトーとは、その昔、英傑らと一緒にアビスに対抗した偉大な竜なんです。部族のみんなからとても尊敬されています。","nextNodeIds":[750960206]},{"nodeId":750960206,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":3867097434,"text":"この「山の王のフレイムグレネード」を献上する専属の人もいますが、噂によれば、ユムカ竜もこっそりそれを「山の王」に与えてるとの話もありましてね…","nextNodeIds":[750960207]},{"nodeId":750960207,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":865863570,"text":"だから、「山の王」は他のユムカ竜よりも…その、幾分逞しいというか…","nextNodeIds":[]},{"nodeId":750960208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2033668802,"text":"フレイムグレネードの実について…","nextNodeIds":[750960209]},{"nodeId":750960209,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":1721109594,"text":"いいことを聞いてくれましたね。フレイムグレネードは実に立派な燃素植物です。自分の根っこを液体燃素に伸ばすことは、大抵の植物にとってかなり勇気がいる行為でしょう。","nextNodeIds":[750960210]},{"nodeId":750960210,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":1574897098,"text":"それに、その実も燃素を豊富に含んでいることから、たくさん食べればユムカ竜にとってはいいこと尽くめです…ユムカ竜が投げ出したりしなければ、の話ですがね…","nextNodeIds":[750960211]},{"nodeId":750960211,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":3249947674,"text":"なんせ強い衝撃が加わると、フレイムグレネードの実は爆発してしまいますから…","nextNodeIds":[]},{"nodeId":750960212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3432126810,"text":"通りかかっただけ…","nextNodeIds":[750960213]},{"nodeId":750960213,"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","textMapHash":119590482,"text":"そうですか…「山の王のフレイムグレネード」を一目見ておかなくて、本当によろしいのですか？見ておけば、きっといい気分になれると思いますよ…もし悩み事があれば、ぜひご覧にいらしてください。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7509601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7509601,7509602],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":6132,"speakerName":"ティザコ","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":6133,"speakerName":"ポカ","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":3},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":3},{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[175096],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLG