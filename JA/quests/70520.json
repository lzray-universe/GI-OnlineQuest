70520/Q7052001","priority":5,"questId":70520,"showRandomTalkCount":0},"dialogs":[{"nodeId":705200101,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":3370878130,"text":"栄誉騎士とパイモン！いい知らせだ！僕たちに新たな助っ人が加わった！","nextNodeIds":[705200102]},{"nodeId":705200102,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":4196572154,"text":"この二人の店主はチャリティーショップのことを聞いて、仲間になりたいと思ったらしい。しかも収益も寄付するつもりだそうだ。","nextNodeIds":[705200103]},{"nodeId":705200103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3768510690,"text":"えっ？寄付するって、本当にいいのか？","nextNodeIds":[705200104]},{"nodeId":705200104,"roleType":"TALK_ROLE_NPC","speakerId":30243,"speakerName":"マーツ","textMapHash":3490707514,"text":"いいんだいいんだ！","nextNodeIds":[705200105]},{"nodeId":705200105,"roleType":"TALK_ROLE_NPC","speakerId":30243,"speakerName":"マーツ","textMapHash":3375807010,"text":"収入源が増えれば、助かる人も増えるだろ。俺とポリーンさんも黙々と自分だけ稼ぐより、そのほうがいいと思ったんだ。","nextNodeIds":[705200106]},{"nodeId":705200106,"roleType":"TALK_ROLE_NPC","speakerId":30244,"speakerName":"ポリーン","textMapHash":3538670154,"text":"今年のブリュー祭はお客さんが例年よりも多いので、早めに売上目標を達成できました。だからもう十分満足ですよ。","nextNodeIds":[705200107]},{"nodeId":705200107,"roleType":"TALK_ROLE_NPC","speakerId":30244,"speakerName":"ポリーン","textMapHash":2508004610,"text":"あなたたちがお年寄りと子供たちのために駆け回っているのを見て、私たちも協力したいと思ったのです。あまり気にしないでください。","nextNodeIds":[705200108]},{"nodeId":705200108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3859048314,"text":"本当にありがとう。","nextNodeIds":[705200109]},{"nodeId":705200109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1148148898,"text":"ああ、なんだか心が温かくなってきたぜ…","nextNodeIds":[705200110]},{"nodeId":705200110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":284252842,"text":"となると、名前を変えないとな！よし…「西風ヒューヒューチャリティー連盟」にしようぜ。","nextNodeIds":[705200111,705200112]},{"nodeId":705200111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3895926922,"text":"西風が強くなった？","nextNodeIds":[705200113]},{"nodeId":705200113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":143744314,"text":"力を合わせて、今回のチャリティーイベントを成功させよう！","nextNodeIds":[705200114]},{"nodeId":705200114,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1169409682,"text":"店主二人が加わり、チャリティーイベントの規模が拡大した…","nextNodeIds":[705200115]},{"nodeId":705200115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1673735930,"text":"寄ってらっしゃい見てらっしゃい。「西風ヒューヒューチャリティー連盟」の特製料理に、日用雑貨、それからお花はどうだ…","nextNodeIds":[705200116]},{"nodeId":705200116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2385998042,"text":"おっ！見ろよ、アルベドが来たぞ！","nextNodeIds":[705200117]},{"nodeId":705200117,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":881988266,"text":"やあ、元気かい？","nextNodeIds":[705200118,705200119]},{"nodeId":705200118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1265630146,"text":"いらっしゃい。","nextNodeIds":[705200120]},{"nodeId":705200120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2283413994,"text":"アルベドもなにか買いに来たのか？","nextNodeIds":[705200121]},{"nodeId":705200121,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3786189354,"text":"必要なものは特にないけど、キミたちが騎士団の店を管理していると聞いて来たんだ。","nextNodeIds":[705200122]},{"nodeId":705200122,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2488726026,"text":"ちょうどティマイオスとの研究に進展があってね、その完成品を少し持ってきた。チャリティーイベントに対するちょっとした支援だと思ってくれ。","nextNodeIds":[705200123]},{"nodeId":705200123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2508007746,"text":"わざわざ支援しに来てくれたのか！オイラ、感激したぞ！","nextNodeIds":[705200124]},{"nodeId":705200124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":224024202,"text":"どれどれ…ボトルに入ってるのは…","nextNodeIds":[705200125]},{"nodeId":705200125,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2714304826,"text":"特製酔い覚ましポーションだよ。酔いを早く覚まし、頭痛を効果的に和らげることができる。","nextNodeIds":[705200126]},{"nodeId":705200126,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3815270770,"text":"これを必要としている人に試供品として配ってみてくれ。そうすれば、より多くのお客さんを惹きつけられるはずだ。","nextNodeIds":[705200127]},{"nodeId":705200127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4001899698,"text":"こんなにすごいもの、相当苦労して作ったんじゃないか？","nextNodeIds":[705200128]},{"nodeId":705200128,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2077491578,"text":"おや？長い間、ボクの実力を見せてこなかったからかな？","nextNodeIds":[705200129]},{"nodeId":705200129,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1837322722,"text":"昔のボクなら、このような研究にあまり興味なかったかもしれない。","nextNodeIds":[705200130]},{"nodeId":705200130,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2081304250,"text":"しかし、錬金術の成果物で人々の生活を便利にするのは、素晴らしいことだろう？","nextNodeIds":[705200131]},{"nodeId":705200131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3658766034,"text":"そうだな！オイラ酔っ払ったことはないけど、想像はできるぜ。","nextNodeIds":[705200132]},{"nodeId":705200132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2464028442,"text":"お酒を楽しんだ後に足を滑らせて湖に落ちたり、石につまづいて転んだりしたら、せっかくの良い気分も台無しだもんな。","nextNodeIds":[705200133]},{"nodeId":705200133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2186088306,"text":"#{M#俺}{F#私}たちもタダで受け取ることはできない。","nextNodeIds":[705200134]},{"nodeId":705200134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4025119202,"text":"そうだ、この店の料理を持って帰って、クレーと一緒に食べてくれよ。オイラたちのおごりだ！","nextNodeIds":[705200135]},{"nodeId":705200135,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":574153314,"text":"ああ、じゃあ遠慮なくもらっていくよ。","nextNodeIds":[705200136]},{"nodeId":705200136,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2066645106,"text":"まさか、これほど見事な商才を持っていたなんてね。","nextNodeIds":[705200137]},{"nodeId":705200137,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2506062954,"text":"料理店の立地が絶妙だ。祭りの雰囲気に合っているだけでなく、役割分担も合理的だよ。","nextNodeIds":[705200138]},{"nodeId":705200138,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2168842506,"text":"他の騎士団メンバーが担当していたら、きっと普通の雑貨しか売っていなかっただろう。","nextNodeIds":[705200139]},{"nodeId":705200139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":797120938,"text":"おっ、アルベドに褒められたぜ。オイラ、酔い覚ましポーションを飲んだみたいに気分がいいぞ。","nextNodeIds":[705200140]},{"nodeId":705200140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3893141658,"text":"でも、アルベドって意外とチャリティーショップに詳しいんだな！","nextNodeIds":[705200141]},{"nodeId":705200141,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1701806210,"text":"ああ。以前、騎士団がチャリティーイベントのために雑貨を集めた時、風景画を十数枚ほど提供したことがあってね。","nextNodeIds":[705200142]},{"nodeId":705200142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2395267282,"text":"アルベドの絵なら、きっと高く売れるだろうな！","nextNodeIds":[705200143]},{"nodeId":705200143,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1759752146,"text":"パイモンの考えは、一般的な商人と似ているようだ。","nextNodeIds":[705200144]},{"nodeId":705200144,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2469932866,"text":"確かにボクの絵を独特だと思い、投資価値を見出して、高額で購入してくれる人もいる。","nextNodeIds":[705200145]},{"nodeId":705200145,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":934515346,"text":"以前のオークションで、ボクのスケッチの売り上げが良かったから…アリスさんも何かを感じ取ったんだろう。","nextNodeIds":[705200146]},{"nodeId":705200146,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":263732034,"text":"彼女は独自のルートでボクの作品にある認定を授けてくれた…確か「特許」という名前だったかな。","nextNodeIds":[705200147]},{"nodeId":705200147,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1088539866,"text":"その後、多くの画家がボクの風景画を模倣して、モンドによく飾られるようにもなった。","nextNodeIds":[705200148,705200149]},{"nodeId":705200148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1743706842,"text":"なんとなく見た覚えがある…","nextNodeIds":[705200150]},{"nodeId":705200150,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":496418554,"text":"アリスさんの「特許」のルールでは、画家はその類の風景画を売るたびに、報酬の何割かをボクに支払わなければならないことになっている。","nextNodeIds":[705200151]},{"nodeId":705200151,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1231554962,"text":"だがお金の行き先に興味はない、その管理は騎士団に任せている。富はボクの目的じゃないからね。","nextNodeIds":[705200152]},{"nodeId":705200152,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":4278718258,"text":"もし何に使えばいいかと聞かれたら…うん、アリスさんが壊したものの修繕費に充てればいいと答えるだろう。","nextNodeIds":[705200153]},{"nodeId":705200153,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3048222818,"text":"でも、結局はチャリティー活動に使ったと聞いているよ。","nextNodeIds":[705200154,705200155]},{"nodeId":705200154,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1378818234,"text":"チャリティーに参加したことがないのに…","nextNodeIds":[705200156]},{"nodeId":705200156,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1922068418,"text":"さすがはアルベドと言うべきか…","nextNodeIds":[705200157]},{"nodeId":705200157,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1226648106,"text":"結果は本意から逸れたものだったけど、予想外の収穫を得られたし、ボクも少しずつそれを受け入れたよ。","nextNodeIds":[705200158,705200160]},{"nodeId":705200158,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1294174402,"text":"よかった。","nextNodeIds":[705200159]},{"nodeId":705200159,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":384177098,"text":"ありがとう。","nextNodeIds":[705200162]},{"nodeId":705200162,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2033900522,"text":"じゃあ、そろそろボクは工房に帰るよ。商売がうまくいくことを祈ってる。","nextNodeIds":[705200163]},{"nodeId":705200163,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1987956650,"text":"協力してくれてありがとな。アルベドも研究、頑張れよ！","nextNodeIds":[705200164]},{"nodeId":705200164,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":2707028218,"text":"アルベドのために、お持ち帰り用の料理を作った…","nextNodeIds":[705200165]},{"nodeId":705200165,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1745009434,"text":"時間があったら、また遊びに来いよ！","nextNodeIds":[]},{"nodeId":705200160,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":792033522,"text":"絵を学びたい。","nextNodeIds":[705200161]},{"nodeId":705200161,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3697856306,"text":"もちろん、喜んでボクの経験を共有するよ。でも…うん、やっぱりたくさん練習するのが一番だろう。","nextNodeIds":[705200162]},{"nodeId":705200155,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2214120714,"text":"偶然にも同じ目標を達成している…","nextNodeIds":[705200156]},{"nodeId":705200149,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1860254194,"text":"アルベドの絵だったんだね…","nextNodeIds":[705200150]},{"nodeId":705200119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3971148458,"text":"久しぶり。","nextNodeIds":[705200120]},{"nodeId":705200112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2793203778,"text":"ヒューヒュー？","nextNodeIds":[705200113]}]},{"talkId":7052002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TA