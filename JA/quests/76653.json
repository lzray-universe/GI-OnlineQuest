domTalkCount":0},"dialogs":[{"nodeId":766530201,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":851171682,"text":"どこが間違ってるのかしら？理論を知ってるだけじゃ、やっぱり…","nextNodeIds":[766530202]},{"nodeId":766530202,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"アイノ","textMapHash":1801550658,"text":"この依頼は確認するまでもないね。ジェネット、フォンテーヌから来たエンジニア…この注文が一番気になってたんだ！","nextNodeIds":[766530203]},{"nodeId":766530203,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":2569374426,"text":"やっと来てくれたのね！これで希望が見えてきた…","nextNodeIds":[766530204]},{"nodeId":766530204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1366265234,"text":"よう！オイラたちは…アイノの助手みたいなもんだ。なにを手伝ってほしいんだ？","nextNodeIds":[766530205]},{"nodeId":766530205,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"アイノ","textMapHash":1481916434,"text":"この人はクーヴァキを利用して、遠距離で交信できるロボットを設計したの。すごく面白いんだけど、故障が多いから調整してほしいんだって！","nextNodeIds":[766530206]},{"nodeId":766530206,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":4233020602,"text":"恥ずかしながら、「やってみよう」って好奇心だけじゃ上手くいかなくって。やっぱり、理論だけじゃなく実践経験も必要みたい…","nextNodeIds":[766530207]},{"nodeId":766530207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3253622170,"text":"それなら、オイラたちに任せとけ！","nextNodeIds":[766530208]},{"nodeId":766530208,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":185305242,"text":"ただ、依頼内容を追加したいの。返事を待っている間に…他にやることがなかったせいで、またやらかしてしまって…","nextNodeIds":[766530209]},{"nodeId":766530209,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":386753218,"text":"場所を変えたら故障も直るんじゃないかと思って、クーヴァキの状況が異なるいくつかのエリアで、それぞれテストしてみたの。","nextNodeIds":[766530210]},{"nodeId":766530210,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":4187991770,"text":"それでもロボットは上手く動かなかったわ。しかも、すべてのロボットと連絡が取れなくなってしまって…だから調整だけじゃなく、そのロボットたちも探してほしいの。","nextNodeIds":[766530211]},{"nodeId":766530211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1033455850,"text":"全員いなくなっちゃったのか！？","nextNodeIds":[766530212]},{"nodeId":766530212,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":2771210154,"text":"追加料金が必要なら、何とかするわ！","nextNodeIds":[766530213]},{"nodeId":766530213,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"アイノ","textMapHash":714511354,"text":"うーん…探知する方法はいくらでもあるよ。そのロボットたちはクーヴァキで動いてるから、通った場所に「クーヴァキの紋様」が残るはず。","nextNodeIds":[766530214]},{"nodeId":766530214,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"アイノ","textMapHash":3022220202,"text":"特殊な道具を貸してあげるから、それを使って十分な「クーヴァキの紋様」を集めれば、ロボットがどこに隠れてるかを探知できるよ。","nextNodeIds":[766530215]},{"nodeId":766530215,"roleType":"TALK_ROLE_NPC","speakerId":1313,"speakerName":"アイノ","textMapHash":4090517082,"text":"ふふん…面白くなりそうだし、追加料金はいらないよ。","nextNodeIds":[766530216]},{"nodeId":766530216,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":3725076306,"text":"本当？ありがとう！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7665301,"order":2,"stepDescription":"","stepDescTextMapHash":945074812,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665301,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,