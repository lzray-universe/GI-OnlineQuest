estId":75041,"showRandomTalkCount":0},"dialogs":[{"nodeId":750410401,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"クエニン","textMapHash":1938740322,"text":"まだいるのか、勇士よ。","nextNodeIds":[750410402]},{"nodeId":750410402,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"クエニン","textMapHash":3781069506,"text":"かつて、とある学者が言った——この灰燼の都の残虐な主は、アビスの侵食を止める方法を持っていると。それで我々は…","nextNodeIds":[750410403]},{"nodeId":750410403,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"クエニン","textMapHash":532056978,"text":"だが、ここは実に不気味だ。この頃そう思えてきた。何かがおかしい、とな。","nextNodeIds":[750410404]},{"nodeId":750410404,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"クエニン","textMapHash":4274185330,"text":"昨日まで綺麗だった道が次の日にはボロボロになっている…あの石造りの家は初めからあんな風だったか？もっと…まともだった気がするんだ。","nextNodeIds":[750410405]},{"nodeId":750410405,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"クエニン","textMapHash":489169258,"text":"それから、目が覚めたら、二度と現れるはずのない友人を見ることもある…あれは魔物だったんだろうか？友人の姿に化けた魔物だったのかもな。","nextNodeIds":[750410406]},{"nodeId":750410406,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"クエニン","textMapHash":1179520834,"text":"私の…私の責務は、ここの魔物を片付けることだ。だが、なぜ…そうしなければならない…？","nextNodeIds":[750410407]},{"nodeId":750410407,"roleType":"TALK_ROLE_NPC","speakerId":21679,"speakerName":"クエニン","textMapHash":4225138642,"text":"とにかく、ここはおかしいんだ…早く離れたほうがいい。","nextNodeIds":[]}]},{"talkId":7504105,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7504101","6","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"T