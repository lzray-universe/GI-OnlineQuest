k":"TALK_HERO_MAIN","id":7335003,"initDialog":733500301,"nextRandomTalks":[],"nextTalks":[],"npcId":[4456],"performCfg":"","priority":5,"questId":73350,"showRandomTalkCount":0},"dialogs":[{"nodeId":733500301,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":1256116666,"text":"この写真は…とても素敵です、あなたには撮影の才能があると思いますよ。","nextNodeIds":[733500302]},{"nodeId":733500302,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":635301314,"text":"私が旅を始めてからというもの、ここまで構図と色彩の扱いに長けた方は、あなたが初めてです。","nextNodeIds":[733500303]},{"nodeId":733500303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2297669018,"text":"どんなところを旅したの？","nextNodeIds":[733500304]},{"nodeId":733500304,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":493108978,"text":"そうですね…本来なら、フォンテーヌから直接スメールに行くこともできたのですが…何しろフォンテーヌには、スメールのバイダ港への直行便がありますから。","nextNodeIds":[733500312]},{"nodeId":733500312,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":2614400770,"text":"でも、「旅で一番大切なのは過程だ」という言葉があるでしょう？だから私は…もっと面白いルートを選んだのです。","nextNodeIds":[733500313]},{"nodeId":733500313,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":823115114,"text":"まず、ルミドゥースハーバーを経由して沈玉の谷まで行き、軽策荘の道を辿ってモンドと璃月を分かつ石門まで行きました。","nextNodeIds":[733500310]},{"nodeId":733500310,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":3767356026,"text":"アカツキワイナリーを訪問してから、南にある璃月港へ行くことにしました。","nextNodeIds":[733500305]},{"nodeId":733500305,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":2383429458,"text":"璃月港でオルモス港行きの船に乗って、そのまま川を遡って北へ向かい、ここに辿り着きました。それで、あなたと出会ったというわけです。","nextNodeIds":[733500306]},{"nodeId":733500306,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":2862584890,"text":"いかんせん、今回の旅の目的は気晴らしですからね。もし私が冒険好きな勇者だったら…","nextNodeIds":[733500311]},{"nodeId":733500311,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":3771595458,"text":"ロマリタイムハーバーから出発して、古代の巡礼の道を辿り、南向きに砂漠に入ったかもしれません。","nextNodeIds":[733500307]},{"nodeId":733500307,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":1654127882,"text":"…どうでしょうね？もしかすると、帰りは砂漠を越えるルートを選ぶかもしれません。そういう意味では、予算がまだ潤沢にありますから…砂漠を越えてナタに行ってみるのもいいかもしれませんね…","nextNodeIds":[733500308]},{"nodeId":733500308,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":1837668186,"text":"ええ、お時間をいただきましてありがとうございました。そしてこちら、写真撮影を手伝ってくださったお礼です。どうぞお納めください。","nextNodeIds":[733500309]},{"nodeId":733500309,"roleType":"TALK_ROLE_NPC","speakerId":4456,"speakerName":"オーガスタス·ラヴレス","textMapHash":4080936258,"text":"私は急ぎ、グザヴィエ宛てに手紙を書かないといけません。彼がさっさとスメールに来てくれないなら、私はフォンテーヌに戻った方がいいかもしれませんから…","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7335003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4456"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3658861210,"text":"他に人がいっぱいいるのに。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4217049122,"text":"#どうして{M#俺}{F#私}？"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2181084274,"text":"他に人がいっぱいいるのに。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":387740354,"text":"#どうして{M#俺}{F#私}？"},{"roleType":"TALK_