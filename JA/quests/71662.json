EST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166203,"initDialog":716620301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30153],"performCfg":"QuestDialogue/WQ/Liyue_71662/Q7166203","priority":5,"questId":71662,"showRandomTalkCount":0},"dialogs":[{"nodeId":716620301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4015716314,"text":"ここは…","nextNodeIds":[716620302]},{"nodeId":716620302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":46053954,"text":"ここがおまえの言った、「空っぽの家」みたいな秘境なのか？","nextNodeIds":[716620303,716620304]},{"nodeId":716620303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1058657874,"text":"どう見てもただの普通の秘境…","nextNodeIds":[716620305]},{"nodeId":716620305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3994560450,"text":"そうだぞ！オイラたちがいつも探索する遺跡とかもこんな感じだよな？","nextNodeIds":[716620306]},{"nodeId":716620306,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":1299132706,"text":"間違ってなんかない。ここが俺たちを困らせた秘境だ。","nextNodeIds":[716620307]},{"nodeId":716620307,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":825857058,"text":"この秘境が今の見た目に変化したのは…","nextNodeIds":[716620308]},{"nodeId":716620308,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2144261170,"text":"最近の出来事だ。","nextNodeIds":[716620309]},{"nodeId":716620309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3713049338,"text":"えっ？","nextNodeIds":[716620310]},{"nodeId":716620310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2594482930,"text":"今の見た目に「変化」した？","nextNodeIds":[716620311]},{"nodeId":716620311,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2353270450,"text":"ああその通り。この秘境は…人の心境と共に変化する。","nextNodeIds":[716620312]},{"nodeId":716620312,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":190142922,"text":"当時の冒険者小隊のリーダーによると、彼らはあの濃霧に覆われた秘境の中で、随分と手こずっていた。みんな我慢の限界にきていたらしい。","nextNodeIds":[716620313]},{"nodeId":716620313,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":644405146,"text":"その時、小隊の一人が泣き言を言い始めた。","nextNodeIds":[716620314]},{"nodeId":716620314,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3192196714,"text":"「普通の遺跡だったら、探索はとっくに終わっているはずだ。」","nextNodeIds":[716620315]},{"nodeId":716620315,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":455862098,"text":"飢饉と眠気に襲われたみんなは、彼の意見に賛同した。","nextNodeIds":[716620316]},{"nodeId":716620316,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2639343778,"text":"そして、この意見に賛同する人が段々と増え、気が付くと冒険者小隊がいる場所は「普通の遺跡」になっていた。","nextNodeIds":[716620317]},{"nodeId":716620317,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3205234546,"text":"その「普通の遺跡」にはからくり、通路や宝箱があり…たいまつも燃えていた。","nextNodeIds":[716620318]},{"nodeId":716620318,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":1830828146,"text":"冒険者小隊は自らでは対応できないと判断し、すぐに協会に戻り報告したんだ。","nextNodeIds":[716620319]},{"nodeId":716620319,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":950759314,"text":"我々はすぐさま人手を増やし、この秘境の徹底調査を開始した。","nextNodeIds":[716620320]},{"nodeId":716620320,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2327648282,"text":"しかし恥ずかしながら、今はこの秘境が人の心によって変化することだけしか分かっていない。","nextNodeIds":[716620321]},{"nodeId":716620321,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2463674690,"text":"同時に複数の人が秘境に入れば、最も強烈な思いによって変化する。","nextNodeIds":[716620322]},{"nodeId":716620322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3036899098,"text":"そんなにすごいのか！じゃあ璃月港をもう一つ作れたりして！","nextNodeIds":[716620323]},{"nodeId":716620323,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":1043048258,"text":"それはもう試したが、失敗に終わった…恐らく璃月港を作ろうという願いが足りなかったのだろう。","nextNodeIds":[716620324]},{"nodeId":716620324,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2761835690,"text":"とにかく、俺たちは冒険者たちを募って、思うがままに秘境に変化を起こしてほしいんだ。","nextNodeIds":[716620325]},{"nodeId":716620325,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":599478578,"text":"そして、その変化の裏にある規則や原理を理解し、答えを導き出したい。","nextNodeIds":[716620326,716620327]},{"nodeId":716620326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1792932202,"text":"じゃあどうすればいい？","nextNodeIds":[716620328]},{"nodeId":716620328,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":4078371162,"text":"そこに装置があるのは分かるか？それが俺たちが配置した「トリガー」だ。とある冒険者が考えた方法なんだ。","nextNodeIds":[716620329]},{"nodeId":716620329,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2746935042,"text":"わかりやすく言うと、「このトリガーに触れて初めて、秘境を変化させることができる」というのが、彼の願ったことだ。","nextNodeIds":[716620330]},{"nodeId":716620330,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":4073373794,"text":"その時、秘境は彼の願いに応えたが、装置が消えないように、定期的に彼を連れてこなければいけない…","nextNodeIds":[716620331]},{"nodeId":716620331,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1542809922,"text":"そんな方法があったなんて…","nextNodeIds":[716620332]},{"nodeId":716620332,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":1254181826,"text":"これもとっさに思いついた方法に過ぎない。そうしないと、この秘境は変化し続けるかもな…","nextNodeIds":[716620333]},{"nodeId":716620333,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2558257170,"text":"でもこの秘境は、あらゆる装置や地形を思いのままに変化させることができる。だから冒険者を鍛えるには、とても適しているんだ。","nextNodeIds":[716620334]},{"nodeId":716620334,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2109338314,"text":"話しているだけじゃ理解できないと思うから、自分で試してみてよ。","nextNodeIds":[716620335]},{"nodeId":716620335,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3760605682,"text":"あそこの「冒険コイン」は見えるか？それも俺たちの思いで作り出したものだ。","nextNodeIds":[716620336]},{"nodeId":716620336,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3171472850,"text":"旅人、まずはその「冒険コイン」を手に入れてみてよ。","nextNodeIds":[]},{"nodeId":716620327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2108458762,"text":"なにか特別な方法を使う必要は？","nextNodeIds":[716620328]},{"nodeId":716620304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":557721154,"text":"見慣れた場所…","nextNodeIds":[716620305]}]},{"talkId":7166206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":true,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166204","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7166206","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"typ