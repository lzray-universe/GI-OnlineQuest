NE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352404,"initDialog":401060201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1064,1053],"performCfg":"QuestDialogue/EQ/AkaFes_40106/Q7352404","priority":5,"questId":73524,"showRandomTalkCount":0},"dialogs":[{"nodeId":401060201,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":2898887898,"text":"会食のとき、どこへ行ってたんだ？","nextNodeIds":[401060202]},{"nodeId":401060202,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":1837881130,"text":"君に報告する義務はないと思うが。","nextNodeIds":[401060203]},{"nodeId":401060203,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":3591375170,"text":"まさか、またどこかで本でも読んでたのか？君もいい加減生き方を変えるべきだと思うぞ。本を読むだけじゃ人は生きていけない。","nextNodeIds":[401060204]},{"nodeId":401060204,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":793907146,"text":"そうか？君の奢りで生きていくほうが、よほど難しいと思うぞ。","nextNodeIds":[401060205]},{"nodeId":401060205,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1838028394,"text":"君ってやつは…！","nextNodeIds":[401060206]},{"nodeId":401060206,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1524044562,"text":"ふん、想像に難くないぞ。どうせサーチェンのことを調べに行ってきたんだろ？あのメモを見れば分かるさ。でも意外だな、君がサーチェンの研究に興味を持つとは思わなかった。","nextNodeIds":[401060207]},{"nodeId":401060207,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1520969266,"text":"あいつのやり方は本当に気に食わない。君の…確かに君の観点も嫌いだ、でも君はサーチェンとは異なるタイプの人間だし、その観点において重なってる部分はないはずだ。利己主義と虚無は違うからな。","nextNodeIds":[401060208]},{"nodeId":401060208,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":719821554,"text":"興味なんてものは置いておくとして、サーチェンは一人の力で、これだけの規模の実験結果を遺した。そこにまったく意味がないわけではない。","nextNodeIds":[401060209]},{"nodeId":401060209,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":2151842586,"text":"それと、褒めてくれてありがとう。ただ、俺は院へ行く途中というだけで、君のそういう話を聞きたかったわけじゃないんだ。","nextNodeIds":[401060210]},{"nodeId":401060210,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":3730534330,"text":"おい、学者にとって、理念を討論するよりも尊い話題ってなんだ？","nextNodeIds":[401060211]},{"nodeId":401060211,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":2109377146,"text":"俺の知る限り、君の言う気に食わないサーチェンは、二十年前に君の父親と会っていた可能性が高い。","nextNodeIds":[401060212]},{"nodeId":401060212,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":2682957594,"text":"…何だって？","nextNodeIds":[401060213]},{"nodeId":401060213,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":986451010,"text":"…まさか…いや、そういうことか…","nextNodeIds":[401060214]},{"nodeId":401060214,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":2958237026,"text":"はぁ、だからサーチェンは僕を見て、懐かしさを覚えたのか。父さんが砂漠へ行ったのは、あいつの影響を受けたからだったのか…","nextNodeIds":[401060215]},{"nodeId":401060215,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":3137660306,"text":"恐らく、そうだろう。","nextNodeIds":[401060216]},{"nodeId":401060216,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1102015090,"text":"……","nextNodeIds":[401060217]},{"nodeId":401060217,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":620635226,"text":"冠を壊してよかったよ。これからは…こんなことも、もうないはずだ。","nextNodeIds":[401060218]},{"nodeId":401060218,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":97744306,"text":"知識の境界線は、遠く外へと伸びている。将来、必ず同じことを研究する人間が現れるだろう。因論派にとって、それは合理的な研究方針だ。","nextNodeIds":[401060219]},{"nodeId":401060219,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":4230469002,"text":"また君の講義が始まったのか？たとえ本当に君の言う通り、人間が知識の罠に落ちやすいとしても、必ずしもあんなふうになるとは限らないだろう。","nextNodeIds":[401060220]},{"nodeId":401060220,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":4212681186,"text":"それに…一部の個体と全体の行動は、必ずしも一致するものではないんだということも、君は認めなければならない。サーチェンは、極めて特別なケースだったんだ。","nextNodeIds":[401060221]},{"nodeId":401060221,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":830091722,"text":"彼を止めた君も、またそうだろう。この種の争い自体は特別なものだが、今の時代に限ったことじゃない。","nextNodeIds":[401060222]},{"nodeId":401060222,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":1325459146,"text":"君も言ったじゃないか、「一部の個体」だと。誰もが君のような選択をするわけじゃないと、ちゃんと分かっている。","nextNodeIds":[401060223]},{"nodeId":401060223,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":3166860154,"text":"……","nextNodeIds":[401060224]},{"nodeId":401060224,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":2739971882,"text":"…それでも、僕は自分の論点を諦めない。僕を説得しようとするな。","nextNodeIds":[401060225]},{"nodeId":401060225,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":3092281674,"text":"構わない。俺たちは長いこと、こうした言い争いをしてきた。今更分かってもらえるとは期待していないさ。正しいか、間違いか、それはもう話の核心じゃなくなっているからな。","nextNodeIds":[401060226]},{"nodeId":401060226,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":4168989858,"text":"…教えてくれて、ありがとう。","nextNodeIds":[401060227]},{"nodeId":401060227,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":3785261050,"text":"何？","nextNodeIds":[401060228]},{"nodeId":401060228,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1576076850,"text":"教えてくれてありがとうって言ったんだ。おい！聞こえてないふりをするな！わざとやってるだろ！","nextNodeIds":[401060229]},{"nodeId":401060229,"roleType":"TALK_ROLE_NPC","speakerId":1053,"speakerName":"アルハイゼン","textMapHash":866058074,"text":"感謝がしたいなら、普段の三倍は誠意を見せろ。さあ、もう一回だ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352404,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1064"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7352404,"order":6,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_NONE","speakerId":null,"speakerName":"","textMapHash":3746542738,"text":"カーヴェと別れの挨拶を交わした後、しばらく辺りをうろうろした…"}],"talkIds":[7352401,7352402,7352403,7352404],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1064,"s