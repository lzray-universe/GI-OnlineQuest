E","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352401,"initDialog":401060101,"nextRandomTalks":[],"nextTalks":[7352402,7352403],"npcId":[1064],"performCfg":"QuestDialogue/EQ/AkaFes_40106/Q7352401","priority":5,"questId":73524,"showRandomTalkCount":0},"dialogs":[{"nodeId":401060101,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1985365026,"text":"二十年前、教令院はサーチェンの資産を手に入れたばかりだった。まるでその巨額の投資を祝うように、その年の学院祭は特別盛大に行われた。","nextNodeIds":[401060102]},{"nodeId":401060102,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":711751706,"text":"あの頃、僕はまだ幼かった。シティを歩いていたら、あちこちに学院トーナメントのポスターがあって…思わず父さんにそのことを聞いた。あの冠が特別に見えて、とてもキレイだとも言った。","nextNodeIds":[401060103]},{"nodeId":401060103,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":3777307834,"text":"父さんは、「じゃあ父さんが優勝して、冠で遊ばせてやろうか？」と聞いてきたよ。","nextNodeIds":[401060104]},{"nodeId":401060104,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":651381098,"text":"僕は嬉しくて、一生懸命頷いた。でも、その試合で、父さんは冠を手に入れることはできなかった。帰ってきたときは、とてもがっかりしてたな。","nextNodeIds":[401060105]},{"nodeId":401060105,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":3141817938,"text":"その後、父さんは砂漠へ調査に行くと言って、家を出た。そしてしばらくもしないうちに、流砂に…","nextNodeIds":[401060106]},{"nodeId":401060106,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":2044309634,"text":"…どんなに経っても、僕はこのことを思い出す勇気がなかった。僕が余計なことを言わなかったら、あんなことにはならなかったかもしれない、ってね。","nextNodeIds":[]}]},{"talkId":7352402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7352402,"initDialog":401060107,"nextRandomTalks":[],"nextTalks":[],"npcId":[1064],"performCfg":"QuestDialogue/EQ/AkaFes_40106/Q7352402","priority":5,"questId":73524,"showRandomTalkCount":0},"dialogs":[{"nodeId":401060107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3168201258,"text":"お父さんは、その時サーチェンに会ったかも。","nextNodeIds":[401060108]},{"nodeId":401060108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3440307306,"text":"え？まさか…オイラたちが聞いた、二十年前砂漠に行ったっていう人だけど、あれって実は——","nextNodeIds":[401060109]},{"nodeId":401060109,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1877773402,"text":"……","nextNodeIds":[401060110]},{"nodeId":401060110,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":3502628186,"text":"…ははっ、だからサーチェンは僕を見て、懐かしいなんて感じたのか？これはまったく…","nextNodeIds":[401060111]},{"nodeId":401060111,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":1935816290,"text":"…優しすぎる父さんのことだ、サーチェンの理論を聞いたときは辛かっただろう。だから砂漠へ行って、苦しむ人々を探そうとした…僕にはそれがよくわかる。","nextNodeIds":[401060112]},{"nodeId":401060112,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":620309506,"text":"……","nextNodeIds":[401060113]},{"nodeId":401060113,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":3365314482,"text":"何度も自分に言い聞かせた。父さんは優勝できなくてがっかりしたんじゃない、見たままのことが全てじゃないと。でも…結局は、僕が試合のことを話したせいだ。","nextNodeIds":[401060114]},{"nodeId":401060114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1872000298,"text":"カーヴェ…","nextNodeIds":[401060115]},{"nodeId":401060115,"roleType":"TALK_ROLE_NPC","speakerId":1064,"speakerName":"カーヴェ","textMapHash":377432586,"text":"心配するな。僕は…僕はあの冠を壊したんだ。これからはそんな悲劇は起きない。もう、起きないんだ…","nextNodeIds":[]}]},{"talkId":7352403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"