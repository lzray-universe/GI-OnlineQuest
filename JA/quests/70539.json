","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7053901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7053901,"initDialog":705390101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1431,30531],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7053901","priority":5,"questId":70539,"showRandomTalkCount":0},"dialogs":[{"nodeId":705390101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":719411194,"text":"ん？マーガレットのやつ、話し中みたいだな？","nextNodeIds":[705390102]},{"nodeId":705390102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":354715202,"text":"待てよ…あれ、ロサリアじゃないか？隣にいるのは冒険者か？会ったことないやつみたいだけど。","nextNodeIds":[705390103,705390104]},{"nodeId":705390103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1230572786,"text":"ロサリアも猫と遊びに来たの？","nextNodeIds":[705390105]},{"nodeId":705390105,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":124598426,"text":"分かったわ、ヴァレリナ。ヴィクトリアに言われた通り、引き続き手を貸してあげるから。","nextNodeIds":[705390106]},{"nodeId":705390106,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":1542683946,"text":"猫の様子をチェックしたり、お風呂に入れたりするぐらい、なんてことないわ。","nextNodeIds":[705390107]},{"nodeId":705390107,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":2281091250,"text":"でも、肝心な問題はまだ解決してませんよ、ロサリアさん！私たちがずっと、二人とも猫ちゃんと仲良くなれずにいたら…いつまで経っても猫ちゃんはみんな緊張しっぱなしです…","nextNodeIds":[705390108]},{"nodeId":705390108,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":2607546298,"text":"そのせいで猫ちゃんが病気にでもなったら…「ネコモコの城」は開業早々潰れちゃいますよ！","nextNodeIds":[705390109]},{"nodeId":705390109,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2708718834,"text":"焦ったってしょうがないじゃない。仲良くなれないのは客観的事実であって、私にどうこうできる問題じゃないわ。","nextNodeIds":[705390110]},{"nodeId":705390110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1374678794,"text":"よう、ロサリア！それから、そっちは初めまして！","nextNodeIds":[705390111]},{"nodeId":705390111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4031979530,"text":"なにか悩み事でもあるのか？","nextNodeIds":[705390112]},{"nodeId":705390112,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":20551306,"text":"ネコネコ救世主様！こんなに早く現れてくださるとは！","nextNodeIds":[705390113]},{"nodeId":705390113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3875284554,"text":"うわっ…いきなり救世主様だなんて、びっくりしたぞ！","nextNodeIds":[705390114,705390115]},{"nodeId":705390114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1095965914,"text":"様呼びには、それなりの責務が付きもの。","nextNodeIds":[705390116]},{"nodeId":705390116,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":438032130,"text":"かいつまんでお話ししますね！私はヴァレリナと申します。動物が大好きで、野良猫の専門的な保護施設——名付けて「ネコモコの城」を築こうと、今全力で取り組んでいるところなんです。","nextNodeIds":[705390117]},{"nodeId":705390117,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3761562314,"text":"行き場のない子たちを保護すれば、みんなを不幸な運命から救い出せますし、モンドのイメージアップや生態環境の改善にも寄与できて…まさに一石二鳥です！","nextNodeIds":[705390118]},{"nodeId":705390118,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3408461154,"text":"そこで教会のシスターたちに相談したところ、私をサポートするために、優しいロサリアさんを派遣してくださいました。","nextNodeIds":[705390119]},{"nodeId":705390119,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2444858490,"text":"別に優しいからじゃなくて、ヴィクトリアに頼まれたからよ。医学をかじったことがある暇なシスターは、私しかいなかったってだけ。","nextNodeIds":[705390120]},{"nodeId":705390120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2512220898,"text":"なかなかやり手の冒険者だな。理路整然としてて、まとめ方が上手かったぞ！","nextNodeIds":[705390121]},{"nodeId":705390121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2830720146,"text":"それで、おまえたちが悩んでるのは…モラが足りないからか？それとも、他になにか足りないものでもあるのか？","nextNodeIds":[705390122]},{"nodeId":705390122,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3306034466,"text":"モラなら十分あります！それに、敷地や関連する物資、規定に則った手続きにもまったく問題はありません！","nextNodeIds":[705390123]},{"nodeId":705390123,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":4092204834,"text":"なのですが…えーっと…その…私、猫ちゃんたちに猫パンチされちゃうんです！","nextNodeIds":[705390124]},{"nodeId":705390124,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":1822109186,"text":"どんな姿勢で近づいても、威嚇されちゃって…食べ物を持って試してもダメでした。","nextNodeIds":[705390125]},{"nodeId":705390125,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2293004018,"text":"私も猫たちに怖がられてるみたい。私が近づくと、逃げちゃうのよね。","nextNodeIds":[705390126]},{"nodeId":705390126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1522987530,"text":"うーん、生まれつき、猫に避けられちゃう体質の人がいるっていうのは聞いたことあるぞ。","nextNodeIds":[705390127]},{"nodeId":705390127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3906388162,"text":"でも、猫の保護活動をしようとしてるのに、猫と仲良くなれなかったら…保護施設の運営どころか、キャッツテールに来るのでさえ、ハードルが高いんじゃないのか…？","nextNodeIds":[705390128]},{"nodeId":705390128,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":2304011906,"text":"ええ…それでその方面の専門家に相談しに来たんですが、マーガレットさんもこれと言ったコツは思いつかないそうで…だからと言って、お店の人手をこちらに割いていただけるほどの余力もないみたいです…","nextNodeIds":[705390129]},{"nodeId":705390129,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":2125645474,"text":"でも、こうも言ってくださいました。「困ったときは、栄誉騎士と白い助手さんに頼めば、なんとかしてくれるわよ！」って。","nextNodeIds":[705390130]},{"nodeId":705390130,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":2736121890,"text":"まさか、そんなところへちょうど来てくださるなんて、思ってもみませんでした。お二人はまるでバルバトス様が派遣してくださった使者…救世主です！","nextNodeIds":[705390131]},{"nodeId":705390131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":479061970,"text":"バルバトスに猫の世話についての知識があるかどうかはさておき…オイラたちも保護施設の運営経験なんてないぞ。急に救世主だなんて言われても…","nextNodeIds":[705390132,705390133]},{"nodeId":705390132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":324601474,"text":"ちょうどよかったかも？","nextNodeIds":[705390134]},{"nodeId":705390134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4095808866,"text":"たしかにそうだな！猫と仲良くするってことなら、オイラ自信があるぜ！","nextNodeIds":[705390135]},{"nodeId":705390135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1556928266,"text":"そう考えると、おまえらの悩みも別に難しくなさそうだな。ヴァレリナとロサリアに、どうやれば猫と仲良くできるのか、見せてやればいいんだろ？安心して任せろ！","nextNodeIds":[705390136]},{"nodeId":705390136,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":826377330,"text":"私は別にいいから、ヴァレリナにたっぷり教えてあげて。治療が必要な子がいたら、また呼んでちょうだい。","nextNodeIds":[705390137]},{"nodeId":705390137,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":1509615298,"text":"とにかく、君たちが保護施設を問題なく運営してくれるのなら、私が手を貸すまでもないわけで…","nextNodeIds":[705390138]},{"nodeId":705390138,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2740815202,"text":"そんなに暇そうな仕事なら、引き続き関わってもいいわ。教会の行事よりは、よっぽど楽みたいだし。","nextNodeIds":[705390139]},{"nodeId":705390139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3434026290,"text":"おい、教会の仕事をサボりたいだけじゃないか…","nextNodeIds":[705390140]},{"nodeId":705390140,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":2390881962,"text":"ではさっそく、「ネコモコの城」までご案内しますね！","nextNodeIds":[]},{"nodeId":705390133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2804785530,"text":"元々猫と遊びたいと思ってたし。","nextNodeIds":[705390134]},{"nodeId":705390115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3807161866,"text":"こういう時は、ぜったい依頼がある！","nextNodeIds":[705390116]},{"nodeId":705390104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1266753026,"text":"カードゲームをしに来たの？","nextNodeIds":[705390105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","1160,1159"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1431"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7053902,"order":3,"stepDescription":"「ネコモコの城」に行く","stepDescTextMapHash":1327694140,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053902,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"