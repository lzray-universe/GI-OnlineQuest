extMapHash":135967026,"text":"あのうっかり屋ども、また荷物をいくつか失くしたんだな。配達の時はそんな派手な動きをするなとあれほど言ったのに…","nextNodeIds":[250350102]},{"nodeId":250350102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1825554626,"text":"何かあったの？","nextNodeIds":[250350103]},{"nodeId":250350103,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":2637647058,"text":"「伝達使」の何人かが言いつけを守らずに、客の荷物を失くしたんだ。","nextNodeIds":[250350104]},{"nodeId":250350104,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":2900332866,"text":"はぁ、それが俺たち「懸木の民」の名誉を傷つける行為だと、あいつらは分からないのか？","nextNodeIds":[250350105]},{"nodeId":250350105,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":1283138170,"text":"配達ならちゃんと配達すればいいし、坂に出くわしたら普通に乗り越えればいいのに、どうして途中でスライドをやり出すんだ？","nextNodeIds":[250350106]},{"nodeId":250350106,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":3945879482,"text":"何度も言ったのに、あの若いやつらは全然聞き耳を持ちやしない。毎日毎日刺激を求めるばっかりで…","nextNodeIds":[250350107]},{"nodeId":250350107,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":786890642,"text":"はぁ、また誰かに頼んで荷物を探さないと。そうだな、誰か時間があるやついるかな…","nextNodeIds":[250350108,250350111]},{"nodeId":250350108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1802608050,"text":"手伝うよ。","nextNodeIds":[250350109]},{"nodeId":250350109,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":2869979898,"text":"え？手伝ってくれるのか？そりゃ、ありがたい。","nextNodeIds":[250350110]},{"nodeId":250350110,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":2949013298,"text":"すぐには手伝ってくれる人が見つかりそうにないし、俺が自分で探しに行くと、「伝達局」の店番をする人がいなくなっちまうからな。","nextNodeIds":[250350117]},{"nodeId":250350117,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":3229844010,"text":"と言っても、当てもなく探させはしないさ。あいつらがいつもどの辺を通るかは知ってるから、荷物を失くした場所もなんとなく見当がつく。","nextNodeIds":[250350118]},{"nodeId":250350118,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":2208505642,"text":"おおよその紛失した地点をマップにマークしておくから、後は頼んだぜ。","nextNodeIds":[]},{"nodeId":250350111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1032563842,"text":"荷物って、大きい？","nextNodeIds":[250350112]},{"nodeId":250350112,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":1027810210,"text":"いや、全然。むしろ大きくないから、毎回探すのに手間取るんだ。はぁ、あのうっかり屋たちめ…","nextNodeIds":[250350113]},{"nodeId":250350113,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":3613700658,"text":"…時間があるんだったら、荷物を探してきてくれないか？","nextNodeIds":[250350114]},{"nodeId":250350114,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":43908058,"text":"今、うちの人手が足りてないんだ。俺が自分で探しに行くと、店を空けることになっちまう。","nextNodeIds":[250350115]},{"nodeId":250350115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1181819202,"text":"分かった。手伝うよ。","nextNodeIds":[250350116]},{"nodeId":250350116,"roleType":"TALK_ROLE_NPC","speakerId":6101,"speakerName":"ミチカ","textMapHash":2801255858,"text":"いいのか！？本当に助かるよ！","nextNodeIds":[250350117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6101"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2503502,"order":2,"stepDescription":"失くした郵便物を探す","stepDescTextMapHash":2699370396,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2503502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":