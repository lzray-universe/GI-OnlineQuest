ype":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7050404","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7050402,"initDialog":705040201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1020,1004],"performCfg":"QuestDialogue/WQ/Mengde_70504/Q7050402","priority":5,"questId":70504,"showRandomTalkCount":0},"dialogs":[{"nodeId":705040201,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":3848521330,"text":"あっ…","nextNodeIds":[705040202]},{"nodeId":705040202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3439932154,"text":"どうした、ロサリアの口に合わなかったか？","nextNodeIds":[705040203]},{"nodeId":705040203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1333548266,"text":"作り直すこともできるけど…","nextNodeIds":[705040204]},{"nodeId":705040204,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":492588178,"text":"大丈夫、君の腕に問題はないわ。ただ、これを飲んでちょっとしたことを思い出しただけよ。お茶を口にする機会ってあまりないから。","nextNodeIds":[705040205]},{"nodeId":705040205,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":497195354,"text":"教会に関することか？","nextNodeIds":[705040206]},{"nodeId":705040206,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":639397690,"text":"ええ。前に教会で行事があってね…私は参加しなかったんだけど、バーバラが私の分のお茶とお菓子を残しておいてくれたのよ…","nextNodeIds":[705040207]},{"nodeId":705040207,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":2056630538,"text":"だけど、お菓子は長いこと置いておくと味が落ちてしまうでしょ。だからいつの間にか片付けられてしまって、残されたお茶だけをいただいたの。そのとき飲んだお茶と同じ味だと思って。","nextNodeIds":[705040208]},{"nodeId":705040208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":399208226,"text":"ロサリアがこんな表情をするなんて…珍しいな。","nextNodeIds":[705040209]},{"nodeId":705040209,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":1090394114,"text":"どうやらモンドに、紅茶愛好家が一人増えたみたいだな。","nextNodeIds":[705040210]},{"nodeId":705040210,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":2240985658,"text":"あら、それならお酒のほうがいいわ。","nextNodeIds":[705040211]},{"nodeId":705040211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2475349866,"text":"ガイアはどう？満足した？","nextNodeIds":[705040212]},{"nodeId":705040212,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":3628090818,"text":"俺が良くないところを指摘したら、お前は作り直してくれるのか？","nextNodeIds":[705040213]},{"nodeId":705040213,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":1327708738,"text":"ハハハッ、冗談だ。俺がお前に嫌われるようなことをするはずがないだろう？","nextNodeIds":[705040214]},{"nodeId":705040214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1468772458,"text":"ったく、ガイアはいっつも話が脱線するよな！よくこんなやつとお酒が飲めるな、ロサリアは…","nextNodeIds":[705040215]},{"nodeId":705040215,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":3089362434,"text":"そう？私は彼のこういうところを気にしたことないけど。それに飲む時は、いつもお酒の話ばかりだし。","nextNodeIds":[705040216]},{"nodeId":705040216,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":3354583922,"text":"それに彼は興味を持った人や物…そう、たとえば君やここのオーナーみたいな人にしか、ちょっかいを出さないもの。","nextNodeIds":[705040217]},{"nodeId":705040217,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":3164327594,"text":"おいおい、俺たち酒を飲む仲間だろう？そうあっさりと裏切らないでくれよ？","nextNodeIds":[705040218]},{"nodeId":705040218,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":981190554,"text":"あら、これが裏切り？別に君は気にしていないでしょ。","nextNodeIds":[705040219]},{"nodeId":705040219,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":824172698,"text":"時折思うの、私の周りには「堅い人」が多すぎるってね。みんながのんびりと過ごしている酒場のほうが、私には合っているわ。","nextNodeIds":[705040220]},{"nodeId":705040220,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":2846253386,"text":"ん？なんだ、今度は堅いヤツへの愚痴か？","nextNodeIds":[705040221]},{"nodeId":705040221,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":2947778786,"text":"そういうことなら、俺の知ってる誰かさんが「モンドの堅物ランキング」トップスリーに入ると思うぜ。","nextNodeIds":[705040222]},{"nodeId":705040222,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":1344378466,"text":"どれくらい堅物かと言うと…そうだな、面と向かってそれを指摘しても眉一つ動かさないくらいだ。","nextNodeIds":[705040223]},{"nodeId":705040223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1895538764,"text":"そんなランキングあるのかよ！","nextNodeIds":[705040224]},{"nodeId":705040224,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":2000192434,"text":"ああ。それに…連続飲酒日数ランキング、最長労働時間ランキング、暗黒料理人ランキング、禁忌とされる知識量ランキングとかもあるぜ…","nextNodeIds":[705040225]},{"nodeId":705040225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2639312018,"text":"モンド人、ヒマすぎだろ！","nextNodeIds":[705040226]},{"nodeId":705040226,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":2359703658,"text":"そんなにヒマを持て余してる人なんて、そういるのかしら？","nextNodeIds":[705040227,705040228]},{"nodeId":705040227,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3135242602,"text":"いや…","nextNodeIds":[705040229]},{"nodeId":705040229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1256660826,"text":"なあ！だったら、オイラとこいつが一緒に入りそうなランキングはないか？","nextNodeIds":[705040230]},{"nodeId":705040230,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":2430716162,"text":"ああ、あるぞ。「ベストバーテンダー」とかな。","nextNodeIds":[705040231]},{"nodeId":705040231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1704557658,"text":"ほ、ほんとか！","nextNodeIds":[705040232]},{"nodeId":705040232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2400570170,"text":"やった！オイラたちの名前もこれで残せるぞ！","nextNodeIds":[705040233]},{"nodeId":705040233,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":4098515290,"text":"……","nextNodeIds":[705040234]},{"nodeId":705040234,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":1179283978,"text":"ふふっ、こういう雰囲気も悪くないわね。","nextNodeIds":[705040235]},{"nodeId":705040235,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":4248781834,"text":"そうだな。こいつらを見ているだけで飽きない。","nextNodeIds":[705040236]},{"nodeId":705040236,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":1871140506,"text":"こんな風に、人に伝染する雰囲気を持っているというのは、酒場のバーテンダーにとって大事なことだ。どうやら…「ベストバーテンダー」の称号をこいつらにやったのも、間違いじゃないみたいだな。","nextNodeIds":[705040237]},{"nodeId":705040237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2025492210,"text":"ん？どうしたんだ？","nextNodeIds":[705040238]},{"nodeId":705040238,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":995093666,"text":"いや、なんでもない。今日は美味かったぜ。","nextNodeIds":[705040239]},{"nodeId":705040239,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":4280829026,"text":"それじゃ、私もそろそろ失礼するわ。","nextNodeIds":[705040240]},{"nodeId":705040240,"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","textMapHash":1432238130,"text":"ああ、そうだ。紅茶、美味しかったわ。あとで自分でも淹れてみようかしら…もし朝起きれたらだけど。","nextNodeIds":[705040241]},{"nodeId":705040241,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":352809754,"text":"それじゃあな。","nextNodeIds":[705040242]},{"nodeId":705040242,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3479217482,"text":"また今度。","nextNodeIds":[]},{"nodeId":705040228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3062904034,"text":"誰のことか大体分かる…","nextNodeIds":[705040229]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,50],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1004"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7050401,7050402],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":1020,"speakerName":"ロサリア","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170504],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3014407534,"CHECNJEMEFE":{"1004":[1220],"1020":[1120]},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ"