NE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30718"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7565801],"talks":[{"talkId":7565801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7565801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7565801,"initDialog":756580101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30718],"performCfg":"QuestDialogue/WQ/EffigyChallengeV6_75507/Q7565801","priority":5,"questId":75658,"showRandomTalkCount":0},"dialogs":[{"nodeId":756580101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3032650970,"text":"ん？冒険者協会は、「詳細非公開組織」からの超高難易度依頼だって言ってたよな？でも、こいつ…子供だぞ？","nextNodeIds":[756580102]},{"nodeId":756580102,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":385352466,"text":"#{NICKNAME}とパイモンだね？初めまして、僕はヘルカ。今回の依頼人だ。依頼の内容は把握しているね？","nextNodeIds":[756580103]},{"nodeId":756580103,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":3365896218,"text":"巨大な魔物の情報を集めるために力を貸してもらいたい。戦闘パフォーマンス面のデータも含めてね。じゃあ、よろしく。","nextNodeIds":[756580104]},{"nodeId":756580104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2950880442,"text":"おう！任せろ…じゃなくて！オイラたち、自己紹介もしてないのに…なんで名前を知ってるんだ？","nextNodeIds":[756580105]},{"nodeId":756580105,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":370166626,"text":"依頼の難易度を考えれば、おそらく冒険者協会は経験と実績を兼ね揃えた冒険者に回すだろうと予想できる。","nextNodeIds":[756580106]},{"nodeId":756580106,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":2592651162,"text":"そうして絞られた数少ない候補者の中で、金髪の旅人と小さな白いガイドのコンビとなると、必然的にね…","nextNodeIds":[756580107]},{"nodeId":756580107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1315278226,"text":"なるほど。子供なのに物知りだな！喋り方も、なんか老け…","nextNodeIds":[756580108]},{"nodeId":756580108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2981893874,"text":"コホン。すごく落ち着いてるね。","nextNodeIds":[756580109]},{"nodeId":756580109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1754207330,"text":"あっ、そうそう！えっと、話を戻すけど、本当におまえが依頼人なのか？「詳細非公開組織」って一体なんなんだ…？","nextNodeIds":[756580110]},{"nodeId":756580110,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":2806031050,"text":"ああ、依頼を出したのは確かに僕だ。「詳細非公開組織」を名乗ったのは、カーリャのアイデアさ。","nextNodeIds":[756580111]},{"nodeId":756580111,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":3159162866,"text":"悔しいが、バックグラウンドのない子供よりも、正体不明な組織からの依頼のほうが、協会も真剣に取り組んでくれる。","nextNodeIds":[756580112]},{"nodeId":756580112,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":3801352018,"text":"言っておくが、「組織」については嘘じゃない。僕は確かに「詳細非公開組織」の一員だからね。","nextNodeIds":[756580113]},{"nodeId":756580113,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":3347061098,"text":"僕はただ、相手に伝えるべきと判断したことのみを伝えただけだ。そこからどんな情報を汲み取るかは、想像力次第さ。","nextNodeIds":[756580114,756580116]},{"nodeId":756580114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":592512626,"text":"おやつを一緒に食べる会とかじゃないよね？","nextNodeIds":[756580115]},{"nodeId":756580115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2854598530,"text":"なんだよ、そんな「秘密組織」って…ただの友達の集まりじゃないか！","nextNodeIds":[756580117]},{"nodeId":756580117,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":4153789122,"text":"ああ、出発前にメイジーと約束したんだ。嘘はつかない、そして危険なことはしないと——それを破ったことはない。","nextNodeIds":[756580118]},{"nodeId":756580118,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":2747222226,"text":"真実だけを話すことで、事を有利に進められる。さらに頼れる助っ人がいれば、危険な地だって安全だ。","nextNodeIds":[756580119]},{"nodeId":756580119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3752182906,"text":"そ、そういうもんか？","nextNodeIds":[756580120]},{"nodeId":756580120,"roleType":"TALK_ROLE_NPC","speakerId":30718,"speakerName":"ヘルカ","textMapHash":2057700986,"text":"ああ。二人の準備ができたら、さっそく出発しよう。","nextNodeIds":[]},{"nodeId":756580116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3877841818,"text":"わぁ、「秘密組織」ってことだね。","nextNodeIds":[756580117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7565801,0],"PAINLIBBLDK"