220713,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"宛煙","textMapHash":3383008154,"text":"でも…その安らぎも、モラクスに壊された。","nextNodeIds":[110220714]},{"nodeId":110220714,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"クリメント","textMapHash":596636546,"text":"そんな古臭い伝説の話よりも、早く封印を解除しよう！せっかくヒントがあるんだから、さあさあ！","nextNodeIds":[110220715]},{"nodeId":110220715,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3559188458,"text":"#{NICKNAME}、<color=#00E1FFFF>天衡は南、瑶光は東、絶雲は西、軽策は北。</color>","nextNodeIds":[110220716]},{"nodeId":110220716,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":513153442,"text":"このヒントがあれば、お前も分かるだろう？","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102207,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133002910,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q1102207ZL"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1102209,"order":6,"stepDescription":"","stepDescTextMapHash":4118987028,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102209,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEP