tDialog":110220601,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/LQ/Zhongli1_11022/Q1102206","priority":0,"questId":11022,"showRandomTalkCount":0},"dialogs":[{"nodeId":110220601,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3028437938,"text":"無用の争いを避けるため、遺跡に入る前に一つ提案があるんだが。","nextNodeIds":[110220602]},{"nodeId":110220602,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"宛煙","textMapHash":511260346,"text":"何でしょう。","nextNodeIds":[110220603]},{"nodeId":110220603,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2297731562,"text":"契約を結んでほしい、内容は「順番にものを取る、一度に一点のみ」。","nextNodeIds":[110220604]},{"nodeId":110220604,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1628864570,"text":"誠意を示すため、俺はカウントしなくていい。","nextNodeIds":[110220605]},{"nodeId":110220605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2094173018,"text":"右に同じ。","nextNodeIds":[110220606]},{"nodeId":110220606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1217468522,"text":"おい、せっかくのチャンスを諦めるのか！","nextNodeIds":[110220607]},{"nodeId":110220607,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"クリメント","textMapHash":3221715866,"text":"俺は認めない！…この半人前の考古学者と収穫を等分しろってか？ありえない！","nextNodeIds":[110220608]},{"nodeId":110220608,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"宛煙","textMapHash":2039672330,"text":"それはこっちのセリフよ！「塩の魔神」の文化財が台無しになるわ、絶対に無理。","nextNodeIds":[110220609]},{"nodeId":110220609,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":86839346,"text":"ふむ…もし「契約」を結べないのなら、顧問を降りるしかないな。","nextNodeIds":[110220610]},{"nodeId":110220610,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1323441770,"text":"この遺跡にある宝と罠の対処は二人の判断に任せる。","nextNodeIds":[110220611]},{"nodeId":110220611,"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"クリメント","textMapHash":4292048386,"text":"そ、それは…分かった。「塩の魔神」の宝物だ、その半分でも十分金になるだろう。","nextNodeIds":[110220612]},{"nodeId":110220612,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"宛煙","textMapHash":2942317458,"text":"契約に応じてもいいけど…鍾離殿、一つ条件があるわ。","nextNodeIds":[110220613]},{"nodeId":110220613,"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"宛煙","textMapHash":2735018122,"text":"「塩の魔神」の真相を見つけたら、たとえモラクスに不利なことであっても公正に判断してほしい。","nextNodeIds":[110220614]},{"nodeId":110220614,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1046360498,"text":"その条件なら、受け入れよう。","nextNodeIds":[110220615]},{"nodeId":110220615,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1448937610,"text":"では、行こうか。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1102206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133102795"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q11022ZL3"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1102108,1102202,1102206,1102207],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":10303,"speakerName":"宛煙","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":10302,"speakerName":"クリメント","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":3},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCF