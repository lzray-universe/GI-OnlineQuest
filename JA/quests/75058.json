eId":750013306,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":314727818,"text":"散らばっても力に縛られているから、今も近くにあるはずだ。探しに行った方がいいな…","nextNodeIds":[750013307]},{"nodeId":750013307,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1357986554,"text":"キュイッ、キュイッ！","nextNodeIds":[750013308]},{"nodeId":750013308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3362688946,"text":"#どうした、あっちに行きたいのか？いま{NICKNAME}とオイラにはやらなきゃいけない大事なことがあるんだ。また後で遊んでやるからさ…","nextNodeIds":[750013309]},{"nodeId":750013309,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1452729234,"text":"キュイッ…キュイッ！キュイッ！","nextNodeIds":[750013310]},{"nodeId":750013310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1395029354,"text":"刻印があそこにあるの？","nextNodeIds":[750013311]},{"nodeId":750013311,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3050815450,"text":"キュイッ！","nextNodeIds":[750013312]},{"nodeId":750013312,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":962294250,"text":"ふむ、今でも「光の刻印」の力を感知できる竜がいると聞いたことはあったが、ただの噂だと思っていた…まさか本当だったのか？","nextNodeIds":[750013313]},{"nodeId":750013313,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3378663978,"text":"#やはり{REALNAME[ID(2)|SHOWHOST(true)]}は普通のテペトル竜の子供ではないようだ。","nextNodeIds":[750013314]},{"nodeId":750013314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2068558762,"text":"おまえ、そんな能力持ってたのか！オイラと比べて、案内役としてはまだまだだけどな。","nextNodeIds":[750013315]},{"nodeId":750013315,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":4247659954,"text":"キュー？","nextNodeIds":[750013316,750013318]},{"nodeId":750013316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4145035226,"text":"パイモンが嫉妬してる。","nextNodeIds":[750013317]},{"nodeId":750013317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3832228578,"text":"そんなことないぞ！オイラは見た目以上に心が広いんだからな！こ、これがオイラなりの褒め方ってだけだ！","nextNodeIds":[750013320]},{"nodeId":750013320,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":343056394,"text":"キュ…キュウ？","nextNodeIds":[750013321]},{"nodeId":750013321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4277427234,"text":"って、こいつには言ってもわからないよな。まったく、おまえがもっと賢かったらよかったぜ…","nextNodeIds":[750013322]},{"nodeId":750013322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":964320266,"text":"いつか理解できるときが来るよ…","nextNodeIds":[750013323]},{"nodeId":750013323,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2191365298,"text":"うむ。だが、部族で竜の世話をする人々によれば、竜と気持ちを通わせるには、長い時間をかける必要があるらしいぞ。","nextNodeIds":[750013324]},{"nodeId":750013324,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3135284810,"text":"竜と打ち解ける秘訣は、辛抱強く継続的にコミュニケーションを続けることだ。人が竜を理解しようとする場合も、竜が人を理解しようとする場合のどちらでもとても長い時間が必要だ。","nextNodeIds":[750013325]},{"nodeId":750013325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":768836746,"text":"#そっか…さっきオイラが{REALNAME[ID(2)|SHOWHOST(true)]}の言おうとしてることを理解できなかったのと同じなのかな。","nextNodeIds":[750013326]},{"nodeId":750013326,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1767432674,"text":"#ごめんな、{REALNAME[ID(2)|SHOWHOST(true)]}。","nextNodeIds":[750013327]},{"nodeId":750013327,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3768367850,"text":"キュイッ、キュイッ！","nextNodeIds":[750013328]},{"nodeId":750013328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3806090730,"text":"今回は反応が早いな！","nextNodeIds":[750013329]},{"nodeId":750013329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1155271986,"text":"よし。じゃあさっきおまえが行きたがってた場所で、金色の模様がないか探してみようぜ。","nextNodeIds":[]},{"nodeId":750013318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3042715794,"text":"パイモンに褒められてるよ！","nextNodeIds":[750013319]},{"nodeId":750013319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3290484482,"text":"そうだけど、だからって調子に乗るのはダメだぞ…","nextNodeIds":[750013320]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7500121,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7505801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7505801,7505802],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4},{"roleType":"TALK_ROLE_NONE","speakerId":null,"speakerName":"","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":23803902,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBB