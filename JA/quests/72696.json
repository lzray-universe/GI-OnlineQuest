":[{"nodeId":726960101,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":765595690,"text":"ふぅ…危なかった…","nextNodeIds":[726960102]},{"nodeId":726960102,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":614552290,"text":"あと少し、あと少しで…","nextNodeIds":[726960103]},{"nodeId":726960103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3866583346,"text":"バートランドのやつ、汗だくになってどうしたんだろ。なんだか、ぐったりしてるみたいだけど…","nextNodeIds":[726960104]},{"nodeId":726960104,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1905382842,"text":"「してるみたい」じゃなくて、本当にぐったり「してる」んだ。","nextNodeIds":[726960105,726960106]},{"nodeId":726960105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4119980178,"text":"どうかしたの？","nextNodeIds":[726960107]},{"nodeId":726960107,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":4210079162,"text":"ふふっ、あとちょっとで失敗するところだった。だが、俺の機転により緊急調整したおかげで、やっと安定したんだ。","nextNodeIds":[726960108]},{"nodeId":726960108,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2556176594,"text":"今、それら元素が少しずつ、以前収集した原材料と組み合わさってる。","nextNodeIds":[726960109]},{"nodeId":726960109,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3151062290,"text":"はぁ、まさに九死に一生とはこのことだろう。もし元素力を抑えられていなかったら、長野原家の花火とどっちが輝いているか勝負するところになっていた。","nextNodeIds":[726960110]},{"nodeId":726960110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2565871970,"text":"爆発しないって言ってたのに…","nextNodeIds":[726960111]},{"nodeId":726960111,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1451895850,"text":"俺が言ったのは、あくまで「おもちゃは爆発しない」だ。おもちゃの製造マシンが爆発しないことを保証した覚えはない。","nextNodeIds":[726960112]},{"nodeId":726960112,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1932331026,"text":"だが、今回は君たちが実験に協力してくれて本当によかった。もしあのまま生産過程に入っていたら、おもちゃが一つも作れないどころか、「大工機」も失っていたかもしれない。","nextNodeIds":[726960113]},{"nodeId":726960113,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":4094669522,"text":"よし、あとは最後の工程、「コア活性化」だけだな。","nextNodeIds":[726960114]},{"nodeId":726960114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2095568954,"text":"コア活性化…前に聞いた感じだと、元素生物と関係があるんだよな？","nextNodeIds":[726960115]},{"nodeId":726960115,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1617748882,"text":"ああ。元素生物には、元素力を流動させるための動力があるんだ。その動力をマシンに入れることが、最後の工程だ。","nextNodeIds":[726960116]},{"nodeId":726960116,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3566641930,"text":"もし、おもちゃ作りに無事成功して、生産を続けられたら…大金を稼いで、借金を返済できる。そしたら、稲妻で幸せに暮らすんだ…","nextNodeIds":[726960117]},{"nodeId":726960117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1581184770,"text":"あれ？フォンテーヌには帰らないのか？","nextNodeIds":[726960118]},{"nodeId":726960118,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":447971042,"text":"フォンテーヌか…ふっ、フォンテーヌ…","nextNodeIds":[726960119]},{"nodeId":726960119,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":800575122,"text":"#{NICKNAME}、パイモン、君たちはまだフォンテーヌに行ったことがなかったね。行けば分かるさ…","nextNodeIds":[726960120]},{"nodeId":726960120,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3207069562,"text":"一部の人からすれば、確かにあの国の生活は便利だろう。だが、ある一部の人にとっては、あそこは悲しみに満ちた失意の地なんだ。","nextNodeIds":[726960121]},{"nodeId":726960121,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1417669546,"text":"あそこのエネルギーシステムは少し特殊でな。いつまで続くか誰にも分からない。本当の崩壊が起こる前に、代わりとなるエネルギー資源を見つける必要がある。","nextNodeIds":[726960122]},{"nodeId":726960122,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3308049346,"text":"しかし、変化とは想像よりも難しいもの。結果的に…俺は今、フォンテーヌ以外の地で、エネルギー源を自分で研究しなければならなくなった。","nextNodeIds":[726960123]},{"nodeId":726960123,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1072276322,"text":"実は「大工機」も、新しいエネルギー源を研究していた際の産物なんだ。だから、まだ安定性に欠けていて、気をつけないと爆発してしまう…","nextNodeIds":[726960124]},{"nodeId":726960124,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2915140130,"text":"だがいつか必ず、最高のエネルギー源を見つけてみせる。","nextNodeIds":[726960125]},{"nodeId":726960125,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3770033642,"text":"フォンテーヌに帰るのは、その時が来てからでも遅くはない。","nextNodeIds":[726960126]},{"nodeId":726960126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2866867370,"text":"バートランド…","nextNodeIds":[726960127]},{"nodeId":726960127,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1146050506,"text":"おしゃべりはこの辺にして、最後の工程を始めよう。","nextNodeIds":[726960128]},{"nodeId":726960128,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":80611634,"text":"#フォンテーヌへ帰るまで、稲妻でどんな生活を送れるのかは、君にかかってる、{NICKNAME}！","nextNodeIds":[]},{"nodeId":726960106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2669628914,"text":"元素反応に失敗したの？","nextNodeIds":[726960107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30187"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7269602,"order":2,"stepDescription":"スライムを3体倒し、コア動力を3個獲得する","stepDescTextMapHash":3522517028,"finishConds":[{"BFGALAINL