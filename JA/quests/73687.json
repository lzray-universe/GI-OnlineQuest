7368701BillboardPos"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[47302,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7368701BillboardPos"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7368701,"order":2,"stepDescription":"投票結果を確認する","stepDescTextMapHash":861084332,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7368701BillboardPos","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7368701],"talks":[{"talkId":7368701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7368701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7368701,"initDialog":736870101,"nextRandomTalks":[],"nextTalks":[],"npcId":[13073,13074],"performCfg":"QuestDialogue/WQ/Pindao_73687/Q7368701","priority":5,"questId":73687,"showRandomTalkCount":0},"dialogs":[{"nodeId":736870101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1734514730,"text":"もう人がいっぱい集まってるな。オイラにも見せてくれ！","nextNodeIds":[736870102]},{"nodeId":736870102,"roleType":"TALK_ROLE_NPC","speakerId":13073,"speakerName":"由宇","textMapHash":1020081154,"text":"はぁ、こんなにも票に差が開くとは。「演武伝心」のような稲妻ならではの試合なら、絶対政子さんのほうが勝つと思ってたのに！","nextNodeIds":[736870103]},{"nodeId":736870103,"roleType":"TALK_ROLE_NPC","speakerId":13074,"speakerName":"鉄也","textMapHash":27684482,"text":"予想通りの結果だ。「オルツィ嬢事件簿」は気鋭の人気作品だからな。物語も面白いし、挿絵のフォンテーヌ衣装も特徴的だ。","nextNodeIds":[736870104]},{"nodeId":736870104,"roleType":"TALK_ROLE_NPC","speakerId":13074,"speakerName":"鉄也","textMapHash":2265062378,"text":"それに、オルツィ嬢の身分は神里家のご令嬢に相応しいと思わないか？","nextNodeIds":[736870105]},{"nodeId":736870105,"roleType":"TALK_ROLE_NPC","speakerId":13073,"speakerName":"由宇","textMapHash":3645273346,"text":"う～ん…オルツィ嬢は強気で、悪戯好きだし、神里家のお嬢様とは全然似ても似つかないけど。でもフォンテーヌ衣装を着る彼女を見れるのはなかなか新鮮でいいかもな。","nextNodeIds":[736870106]},{"nodeId":736870106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2231335562,"text":"あれ、なに言ってんだこいつら。なんか状況がイマイチわからないな。","nextNodeIds":[736870107]},{"nodeId":736870107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1222049098,"text":"えっ、掲示板を見てみろ！演武伝心の衣装の投票項目は…えっと、「お願いっ！私の仙狐宮司」に「オルツィ嬢事件簿」…","nextNodeIds":[736870108]},{"nodeId":736870108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2089218250,"text":"待て待て、このあいだ言ってた投票って、稲妻の四季の風物詩じゃなかったか？いつの間に娯楽小説の主人公の衣装になったんだよ？","nextNodeIds":[736870109,736870110]},{"nodeId":736870109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1111953970,"text":"案を修正した？","nextNodeIds":[736870111]},{"nodeId":736870111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1263483698,"text":"これはちゃんと聞かないとな。今すぐ社奉行へ行って綾華に聞いてみようぜ！","nextNodeIds":[]},{"nodeId":736870110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3491906042,"text":"投票に何か問題があった？","nextNodeIds":[736870111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q7368701BillboardPos","15"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7368702,"order":3,"stepDescription":"神里屋敷に行く","stepDescTextMapHash":4195211252,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7368702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1013"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7368702,7368703],"talks":[{"talkId":7368702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7368702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7368702,"initDialog":736870201,"nextRandomTalks":[],"nextTalks":[],"npcId":[13082,30139,1013],"performCfg":"QuestDialogue/WQ/Pindao_73687/Q7368702","priority":5,"questId":73687,"showRandomTalkCount":0},"dialogs":[{"nodeId":736870201,"roleType":"TALK_ROLE_NPC","speakerId":13082,"speakerName":"水田","textMapHash":3891697130,"text":"申し訳ございません、投票用紙が入った二つの箱を取り違えてしまいました！小野寺さんが出張先から帰って気づいた時には、既に結果が公表された後でして","nextNodeIds":[736870202]},{"nodeId":736870202,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"小野寺","textMapHash":3198733546,"text":"はぁ、機密漏洩を防ぐために、わざわざ投票用紙に題名を書かなかったことが、かえってあだになってしまいましたか。","nextNodeIds":[736870203]},{"nodeId":736870203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":959809666,"text":"えっ、嘘だろ…本当に演武伝心で着る衣装の投票にこんな問題が起きてるなんて。","nextNodeIds":[736870204]},{"nodeId":736870204,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1515632922,"text":"旅人さん、パイモンさん、貴方たちも投票の結果をご存じのようですね。","nextNodeIds":[736870205]},{"nodeId":736870205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3531746610,"text":"おう。オイラたちどころか、ここに来る途中みんなこの話題で持ちきりだったぞ。どうするつもりだ？","nextNodeIds":[736870206]},{"nodeId":736870206,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"小野寺","textMapHash":3803644274,"text":"神里さん、このような重大な失態を犯したのは私たちの責任です。今すぐもう一度投票を行い、その際にしっかりと説明します。","nextNodeIds":[736870207]},{"nodeId":736870207,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3611666258,"text":"いいえ、小野寺さん、少々お待ちください。まだ他の解決方法があるかもしれません。","nextNodeIds":[736870208]},{"nodeId":736870208,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3931622106,"text":"票を取り違えたことは、私たち大会陣営しか知らないこと。一般の民衆は投票に問題があったことにまだ気づいていません。","nextNodeIds":[736870209]},{"nodeId":736870209,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2474943666,"text":"それに、模擬試合で流行りの作品の衣装が出てくることについて、特に不平や不満の声は上がっていませんでした。むしろ逆に、それに驚いて喜んでいるようです。","nextNodeIds":[736870210]},{"nodeId":736870210,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3838680882,"text":"大会の目的は、より多くの人に試合に興味を持っていただくことである以上、この不手際がもたらした結果を「失態」のままにすべきではないでしょう。","nextNodeIds":[736870211]},{"nodeId":736870211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1164673298,"text":"綾華、それってつまり…","nextNodeIds":[736870212]},{"nodeId":736870212,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2965022722,"text":"はい。この結果を利用しましょう。最後の模擬試合で、私は投票結果の衣装を着て登場します。","nextNodeIds":[736870213]},{"nodeId":736870213,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"小野寺","textMapHash":973513042,"text":"しかし…それではご迷惑をかけてしまいます。なにしろ小説の登場人物の衣装は、演武の衣装のように戦闘のために設計されてはいません。","nextNodeIds":[736870214]},{"nodeId":736870214,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2729993434,"text":"大丈夫です。小説に登場したフォンテーヌ様式の衣装は、複雑なものではありませんし、あまり影響はないと思います。","nextNodeIds":[736870215]},{"nodeId":736870215,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2465761770,"text":"普段の服装とは違いますが、慣れるように頑張ります。","nextNodeIds":[736870216]},{"nodeId":736870216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2533266370,"text":"おお、平然としてるけど、なんだか迫力がひしひしと伝わってくるぞ！","nextNodeIds":[736870217]},{"nodeId":736870217,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"小野寺","textMapHash":972266770,"text":"はい。分かりました…それでは、神里さんの提案で行きましょう。","nextNodeIds":[736870218]},{"nodeId":736870218,"roleType":"TALK_ROLE_NPC","speakerId":30139,"speakerName":"小野寺","textMapHash":2777546578,"text":"模擬試合で最大限の実力を発揮していただくために、読者用の行事の衣装を、この二日間で神里さんの体型に合わせて調整します！","nextNodeIds":[736870219]},{"nodeId":736870219,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":797537466,"text":"はい、お願いします。","nextNodeIds":[736870220]},{"nodeId":736870220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":968360562,"text":"綾華、小説の登場人物の衣装を着て模擬試合に出るなんて、本当に大丈夫なのか？オイラたちの前で無理してないよな？","nextNodeIds":[736870221]},{"nodeId":736870221,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2518766098,"text":"ご安心ください、無理はしていませんよ。それにちょっとだけ嬉しいんです。","nextNodeIds":[736870222]},{"nodeId":736870222,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1843768730,"text":"今まで、華麗な衣装を着て舞台に上がることを考えると、動きがキレイかどうか、観客たちの期待に応えられるかどうかと、色々と心配してきました。","nextNodeIds":[736870223]},{"nodeId":736870223,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1325322010,"text":"しかし、小説の登場人物の衣装であれば、そのように考える必要はありません。なぜなら、作中の探偵のお嬢さんは、我が道を行くいたずらっ子で有名ですから。","nextNodeIds":[736870224]},{"nodeId":736870224,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":452761546,"text":"これで模擬試合を観る皆様も、伝統の形を新たな楽しみと共に味わえるでしょう。","nextNodeIds":[736870225]},{"nodeId":736870225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":67785162,"text":"（綾華はそんな風に考えてるんだ…）","nextNodeIds":[736870226]},{"nodeId":736870226,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":4038276978,"text":"いえ、これだけではありませんね。私は心の中で、いつか普段とは違う姿になることを、ずっと望んでいたのかもしれません。","nextNodeIds":[736870227]},{"nodeId":736870227,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1247659442,"text":"旅人さん、知り合ったばかりの頃に貴方はこうおっしゃっていました。璃月、モンド…それぞれの国の服装には違った特徴があると。","nextNodeIds":[736870228]},{"nodeId":736870228,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1960376282,"text":"あの時の私は、自分もこの異国様式を体験できる日が来るとは、思いもしませんでした。でも今は、かつて叶えられないと思っていた願いも、こうしてすぐ届くところにあります。","nextNodeIds":[736870229]},{"nodeId":736870229,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":45364090,"text":"それにお母様も昔、異国の服装に憧れていました。今回また、お母様の願いを一つ叶えてあげられます。","nextNodeIds":[736870230]},{"nodeId":736870230,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":128310314,"text":"こう考えると、この特別な衣装は確かに喜ばしいものと呼べるかもしれません。","nextNodeIds":[736870231]},{"nodeId":736870231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3515876962,"text":"へへっ、投票を取り違えはしたけど、結果的にいいほうに転んだみたいだな。よし、問題も無事解決できたし、試合会場へ向かおうぜ。","nextNodeIds":[736870232]},{"nodeId":736870232,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1286268690,"text":"はい。旅人さんの実力を信じています。","nextNodeIds":[736870233]},{"nodeId":736870233,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":224948738,"text":"小野寺さんと服の採寸を済ませたら、会場へ行って貴方たちの試合を観に行きますね。","nextNodeIds":[]}]},{"talkId":7368703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7368702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":[""