oTalk":"TALK_HERO_LOCAL","id":7223703,"initDialog":722370301,"nextRandomTalks":[],"nextTalks":[],"npcId":[20480],"performCfg":"QuestDialogue/WQ/Inazuma_72237/Q7223703","priority":5,"questId":72237,"showRandomTalkCount":0},"dialogs":[{"nodeId":722370301,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":4106908042,"text":"お前たちは…","nextNodeIds":[722370302]},{"nodeId":722370302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3022744634,"text":"おまえが安貞か？","nextNodeIds":[722370303]},{"nodeId":722370303,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":3763924282,"text":"ああ、そうだが…なんだか妙だ…","nextNodeIds":[722370304]},{"nodeId":722370304,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":3976059946,"text":"たしか…ずっとあいつらを追っていて、コアを引き抜いた後、拠点に捨てたのまでは覚えている。だが、大怪我をしていたせいか徐々に眠くなっていき…","nextNodeIds":[722370305]},{"nodeId":722370305,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":2931277146,"text":"目が覚めたらお前たちがいた。そして体の具合も良くなってる。これは、死ぬ寸前の幻覚か何かか？","nextNodeIds":[722370306]},{"nodeId":722370306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":439028042,"text":"…","nextNodeIds":[722370307]},{"nodeId":722370307,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":3552356162,"text":"それよりも、お前たちは俺を連れ戻しに来たのか？あいにく、俺はもう自分の潔白を証明している。","nextNodeIds":[722370308]},{"nodeId":722370308,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":919501882,"text":"図書館の本を盗んだのは、カーンルイアのやつらだ。確かに俺はやつらを迎えた際に護衛をしていたが、やつらと共謀するなど断じてありえない。","nextNodeIds":[722370309]},{"nodeId":722370309,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":1032625234,"text":"俺はここで使節団の痕跡を調べ、やつらを全員倒した。","nextNodeIds":[722370310]},{"nodeId":722370310,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":2602001250,"text":"だが、やつらの巨大機関を止めるために、長い時間を費やしてしまってな。コアを引き抜くことには成功したが、俺も重傷を負ってしまった。","nextNodeIds":[722370311]},{"nodeId":722370311,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":478458818,"text":"動力を失った機械は、失われた本の上に倒れた。だから、もう取り戻すことはできない。","nextNodeIds":[722370312]},{"nodeId":722370312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2453700538,"text":"白夜国の地走官ってすごいんだな…","nextNodeIds":[722370313]},{"nodeId":722370313,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":4185843258,"text":"お前たちは地走官かその候補なんだろ？いや、まあどうだっていいか。その昔、地走官はアビサルヴィシャップと対抗する勇士だったんだ。その後、法の執行者、つまり幽冥判官となった。","nextNodeIds":[722370314]},{"nodeId":722370314,"roleType":"TALK_ROLE_NPC","speakerId":20480,"speakerName":"安貞","textMapHash":3346752082,"text":"コアは拠点にある。信じられないのなら、自分で見に行ってくるといい。","nextNodeIds":[]}]},{"talkId":7223704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7223705","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7223708","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{