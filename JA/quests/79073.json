tionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7907305,"initDialog":790730501,"nextRandomTalks":[],"nextTalks":[],"npcId":[30604],"performCfg":"QuestDialogue/WQ/Island_79073/Q7907305","priority":5,"questId":79073,"showRandomTalkCount":0},"dialogs":[{"nodeId":790730501,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":1724990714,"text":"ああ、そうだ！私のとっておきの作品をご紹介するのを忘れていました。この素晴らしい棚も。","nextNodeIds":[790730502]},{"nodeId":790730502,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":3282519154,"text":"こちらの「抽選ボックス」をご覧ください！私がこれまでに作ってきた紙模型が全部この中に入っています。","nextNodeIds":[790730503]},{"nodeId":790730503,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":4247554714,"text":"このボックスを作るために、世界中を歩き回りました…正確には「跳び回り」ましたが、新たな友人にも多く出会いました。","nextNodeIds":[790730504]},{"nodeId":790730504,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":3577825466,"text":"風域で私に飛行テストを受けさせようとしてくるモモンガのクランシェ、私と同じで模型作りが好きなデヴィット…それから、いつも真剣な顔のエロフ…","nextNodeIds":[790730505]},{"nodeId":790730505,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":224827994,"text":"みんなとても優しくて、紙模型のモデルになってほしい、それをみんなに紹介させてほしいと言ったら快く承諾してくれました！","nextNodeIds":[790730506]},{"nodeId":790730506,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":2732687186,"text":"どうぞ、こちらの「星旅コイン」は私からのプレゼントです。「星旅コイン」を「抽選ボックス」に入れてレバーを引くと、露からの贈り物を受け取れますよ。","nextNodeIds":[790730507]},{"nodeId":790730507,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":3240181738,"text":"コインを使い終わった後は、ご自身でコインを手に入れて「抽選ボックス」を回してくださいね。","nextNodeIds":[790730508]},{"nodeId":790730508,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":3465607082,"text":"どうやって手に入れるかは…ふふふ…私の友人たちに聞いてみてください。きっとアドバイスをくれると思います。","nextNodeIds":[790730509]},{"nodeId":790730509,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":1697020130,"text":"贈り物を受け取ったら、後ろにある「立派な棚」に飾ってくださいね。","nextNodeIds":[790730510]},{"nodeId":790730510,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":3288304762,"text":"実はこの棚こそ、私が「抽選ボックス」と「紙模型」を作ったきっかけなんです…","nextNodeIds":[790730511]},{"nodeId":790730511,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName":"シュティ","textMapHash":3484053426,"text":"詳しくはとある物語と関係しているのですが…お望みなら、あとで聞かせて差し上げますね。","nextNodeIds":[790730512]},{"nodeId":790730512,"roleType":"TALK_ROLE_NPC","speakerId":30604,"speakerName