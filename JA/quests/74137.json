{"mainQuestId":74137,"title":"光と彩を集めて·因果","description":"ロマリタイムハーバーの岸辺で、キセアンという商人が何か悩んでいるようだ…","titleTextMapHash":2613096919,"descTextMapHash":3866782326,"mainQuestExcel":{"mainQuestId":74137,"titleTextMapHash":2613096919,"title":"光と彩を集めて·因果","descTextMapHash":3866782326,"description":"ロマリタイムハーバーの岸辺で、キセアンという商人が何か悩んでいるようだ…","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5157,"luaPath":"Actor/Quest/WQ74137","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5157,"chapterId":0,"descTextMapHash":3866782326,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74137,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":1282956801,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74137","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174137],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2613096919,"type":"WQ","unlockDescTextMapHash":1537197454}},"flow":[{"subQuestId":7413701,"order":1,"stepDescription":"ロマリタイムハーバーの近くに行く","stepDescTextMapHash":236043444,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7413701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30420"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7413701],"talks":[{"talkId":7413701,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7413701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7413701,"initDialog":741370101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5133,30420],"performCfg":"QuestDialogue/WQ/Fontaine_74137/Q7413701","priority":5,"questId":74137,"showRandomTalkCount":0},"dialogs":[{"nodeId":741370101,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":2174251778,"text":"「…専門家チームの検証によって、被告人が販売した商品『蛍光ムラサキクラゲ』は現地の生態系に深刻な影響を及ぼし、水中生物の正常な活動を阻害したものと認めた」","nextNodeIds":[741370102]},{"nodeId":741370102,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":807797890,"text":"「…『生態系破壊罪』の証拠は決定的であり、罪状をここに確定する」","nextNodeIds":[741370103]},{"nodeId":741370103,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":2005732186,"text":"ま、待ってくれ…本当に何も知らないんだ！あれは僕が放したものじゃない！","nextNodeIds":[741370104]},{"nodeId":741370104,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":3057716706,"text":"「…被告には主観的な犯罪意識がないことから、今回は奉仕活動により罪を償うことを特別に許可する。」","nextNodeIds":[741370105]},{"nodeId":741370105,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":2842361066,"text":"「期限内に指定水域において『蛍光ムラサキクラゲ』を回収できれば、情状酌量により一部の処罰を免除するものとする…」","nextNodeIds":[741370106]},{"nodeId":741370106,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":579229146,"text":"回収なんて無理だよ！こ…交渉の余地はないのかい？罰金を重くしたって構わないから…","nextNodeIds":[741370107]},{"nodeId":741370107,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":3175648234,"text":"「…期限の詳細については附録を参照のこと」——あのなぁ、俺と交渉したってどうにもならないよ。今だって時間が過ぎてるんだから、早く回収方法を考えたほうがいいと思うぞ。","nextNodeIds":[741370108]},{"nodeId":741370108,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":1854362434,"text":"はぁ、クラゲを買った人たちがあちこちで放流したなんて。泳ぎは得意じゃないし…どうしろっていうんだ…あいつらに売るんじゃなかったよ…","nextNodeIds":[741370109]},{"nodeId":741370109,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":1006548026,"text":"勝手に放流した人たちについては警察隊が引き続き捜査するさ。まぁ何にしても…","nextNodeIds":[741370110]},{"nodeId":741370110,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":3026952826,"text":"クラゲを繁殖させたのも、届けを出さずに販売したのも、購入者に「放流は禁止」って伝えるのを忘れていたのも全部君だろ。","nextNodeIds":[741370111]},{"nodeId":741370111,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":3447018546,"text":"正直、もう十分に寛大な措置だと思うぞ。","nextNodeIds":[741370112]},{"nodeId":741370112,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":3818141450,"text":"うぅ…こうなるってわかってたら、取引する時に免責事項に署名しておくんだったよ…","nextNodeIds":[741370113]},{"nodeId":741370113,"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","textMapHash":3072091658,"text":"とにかく、この機会にしっかり反省しておくんだな——それと、次会う時はメロピデ要塞以外であることを願うよ。","nextNodeIds":[741370114]},{"nodeId":741370114,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1630798490,"text":"キセアンはしょげた様子でオージュローを見送った…","nextNodeIds":[741370115]},{"nodeId":741370115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3609655986,"text":"おい、大丈夫か？すごい顔色になってるけど…","nextNodeIds":[741370116,741370117]},{"nodeId":741370116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3540673234,"text":"「蛍光ムラサキクラゲ」って何？","nextNodeIds":[741370118]},{"nodeId":741370118,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":3917509506,"text":"…聞いてたのかい？悪いけど、今は話してる時間がないんだ。急いで冒険者協会に行って依頼を出すか、潜水士を雇って…","nextNodeIds":[741370119]},{"nodeId":741370119,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":2502319858,"text":"…でも、協会に申請するにも手続きが必要だし、潜水士にお願いする方法もわからないし——ああ、このままじゃ本当にメロピデ要塞行きか？","nextNodeIds":[741370120]},{"nodeId":741370120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3977723842,"text":"#{NICKNAME}、こりゃビジネスの…いやいや、人助けの予感がするぞ！","nextNodeIds":[741370121,741370122]},{"nodeId":741370121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2041144186,"text":"冒険者が必要なんだね。","nextNodeIds":[741370123]},{"nodeId":741370123,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":3048844202,"text":"そうさ…ん、待てよ…まさに君がその冒険者じゃないのか！","nextNodeIds":[741370124]},{"nodeId":741370124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":219237058,"text":"#へへっ！そういうことだぜ。{NICKNAME}は冒険者の中で一番ダイビングが得意なんだぞ！","nextNodeIds":[741370125]},{"nodeId":741370125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3988611706,"text":"潜水士の中で一番冒険が得意。","nextNodeIds":[741370126]},{"nodeId":741370126,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":1800170674,"text":"ああ、なんてツイてるんだ！ずっとひどい目に遭っていたけど、ようやく運が回ってきた！冒険者さん、僕に力を貸してくれないかい？報酬なら心配ないよ！","nextNodeIds":[741370127]},{"nodeId":741370127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3589852442,"text":"先に事情を教えてくれる？","nextNodeIds":[741370128]},{"nodeId":741370128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4190331810,"text":"そうそう。さっき罪状を言い渡されてたけど…なんか悪いことしたんじゃないよな？そうなら手伝わないぞ！","nextNodeIds":[741370129]},{"nodeId":741370129,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":2900442066,"text":"いやいや、まさか…実は僕は生物学者でね。実験をしているときに偶然、発光するクラゲが生まれたんだよ。","nextNodeIds":[741370130]},{"nodeId":741370130,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":688934306,"text":"もともとこのクラゲは実験が終わったら処分するつもりだったんだけど、あまりに見た目がキレイだったもので、ペットとして売ればお金になるかなと思って…","nextNodeIds":[741370131]},{"nodeId":741370131,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":2325056682,"text":"普段から生物を研究していても、あまり儲からないからね…","nextNodeIds":[741370132]},{"nodeId":741370132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4088742682,"text":"はぁ…それで？儲かったのかよ？","nextNodeIds":[741370133]},{"nodeId":741370133,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":3022557354,"text":"そりゃあ、生物の研究に比べれば商売は儲かるよ…でもそれと同時に、トラブルが舞い込んだんだ。","nextNodeIds":[741370134]},{"nodeId":741370134,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":3945818858,"text":"僕はペットビジネスなんて初めてだったしよく考えていなかったんだ。まさか購入者の中に、飼育目的じゃなくて、放流する目的の人たちがいるなんて…","nextNodeIds":[741370135]},{"nodeId":741370135,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":175074674,"text":"きっと彼らは実験室で生まれた小さな命を哀れに思ったんだろうね。それでクラゲたちを野外に放ったんだ。","nextNodeIds":[741370136]},{"nodeId":741370136,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":655358130,"text":"でも特殊な生態環境で育てられたクラゲは、この地域の生態環境とは相容れないんだ。とりわけ彼らは集まって発光する特徴を持っているし…","nextNodeIds":[741370137]},{"nodeId":741370137,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":4048349314,"text":"…クラゲたちがいると水中の照度条件はすぐに変化してしまい、他種の正常な活動を阻害し、更には生態系のバランスにまで影響を及ぼすというわけさ…","nextNodeIds":[741370138]},{"nodeId":741370138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2295658754,"text":"ま、待てよ！集まって発光するとか照度条件だとか…もうちょっと簡単に説明してくれないか？","nextNodeIds":[741370139]},{"nodeId":741370139,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":4152198370,"text":"おっと、すまない。また悪いクセが出てしまったね…例えばだけど、君たちも昼もしくは夜にしか活動しない魚を見たことがあるだろう？","nextNodeIds":[741370140]},{"nodeId":741370140,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":1305389162,"text":"水中生物の習性っていうのは、その水域の光環境と切っても切れない関係にあるんだ。自然のものではない光源がいきなり現れたら、彼らの活動は阻害されてしまう…","nextNodeIds":[741370141]},{"nodeId":741370141,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":1063777674,"text":"…以前、同業者が照明で魚を釣る原理を研究していたけど…","nextNodeIds":[741370142,741370143]},{"nodeId":741370142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":744670234,"text":"また話が逸れた。","nextNodeIds":[741370144]},{"nodeId":741370144,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":870774346,"text":"あぁ…ごめんごめん。とにかく、最近になって警察隊が各地の水域で異常な発光現象を発見したんだ。","nextNodeIds":[741370145]},{"nodeId":741370145,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":1530134226,"text":"詳しく調査したところ、それらの光源はすべて群れをなして発光する「蛍光ムラサキクラゲ」だと判明してね…","nextNodeIds":[741370146]},{"nodeId":741370146,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":2699087802,"text":"僕が直接放ったわけじゃないけど、僕が売ったものだ。今、僕は彼らに、少なくとも安全なラインまで数を減らすよう、事態の収拾を命じられているんだよ。","nextNodeIds":[741370147]},{"nodeId":741370147,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":3774987410,"text":"でも僕は一介の学者で、水中に潜ることなんてできないしね…君たちに会えてよかったよ。でなきゃこの不運で一気にどん底へ落ちるところだった…","nextNodeIds":[741370148]},{"nodeId":741370148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3465833010,"text":"確かに運が悪かったな…でもおまえにだって責任はあるよな。","nextNodeIds":[741370149]},{"nodeId":741370149,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":1270702922,"text":"——冒険者さん。報酬は弾むから、ぜひとも僕に手を貸してくれ！","nextNodeIds":[741370150]},{"nodeId":741370150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3922936714,"text":"#報酬は弾む…{NICKNAME}、オイラ、こいつは更生できると思うぞ！","nextNodeIds":[741370151,741370152]},{"nodeId":741370151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":434691202,"text":"…分かった。","nextNodeIds":[741370153]},{"nodeId":741370153,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":91549530,"text":"おおっ、ありがとう！警察隊がいま「蛍光ムラサキクラゲ」の放流された場所を調べてる。そのエリアに行って、できるだけ多くのクラゲを捕まえてほしい。","nextNodeIds":[741370154]},{"nodeId":741370154,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":399829314,"text":"クラゲたちの活動範囲は広くないし、移動速度も遅い…","nextNodeIds":[741370155]},{"nodeId":741370155,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":1803325042,"text":"君のようなダイビングの達人にかかれば、楽勝さ。","nextNodeIds":[741370156]},{"nodeId":741370156,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":2884626994,"text":"「蛍光ムラサキクラゲ」は水中でもよく目立つから、光源を追って泳ぎ回るといいだろう。","nextNodeIds":[741370157]},{"nodeId":741370157,"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","textMapHash":3726963866,"text":"僕はずっとここにいるから、何かわからない事があればいつでも聞いてくれ…まぁ、メロピデ要塞に連行されなければの話だけど…","nextNodeIds":[]},{"nodeId":741370152,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2075510602,"text":"具体的にどうすればいい？","nextNodeIds":[741370153]},{"nodeId":741370143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1765379330,"text":"要点だけ話して。","nextNodeIds":[741370144]},{"nodeId":741370122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":959550922,"text":"潜水士が必要なんだね。","nextNodeIds":[741370123]},{"nodeId":741370117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3843680058,"text":"「生態系破壊罪」ってどういうこと？","nextNodeIds":[741370118]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7413701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30420"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7413701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30420,"speakerName":"キセアン","count":29},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":5133,"speakerName":"オージュロー","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":8},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174137],"BHCBFLFOGJN":0,"BPEIDGPCLG