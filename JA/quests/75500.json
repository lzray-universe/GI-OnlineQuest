y":5,"questId":75500,"showRandomTalkCount":0},"dialogs":[{"nodeId":755000101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2702185058,"text":"わぁ…！","nextNodeIds":[755000102]},{"nodeId":755000102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":837210450,"text":"よく見ると、ステージで踊ってる「こだまの子」のやつ、動きがハンパないぞ！人間の身体って、あんなすごい動きができるもんなんだな…","nextNodeIds":[755000103]},{"nodeId":755000103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":921355634,"text":"リズムミカルな音楽と激しい火柱！他の国の芸術と比べると、まったく雰囲気が違うな！","nextNodeIds":[755000104]},{"nodeId":755000104,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3505581466,"text":"#そこの活力に満ちた{M#少年}{F#少女}と、浮かんでいる「わぁわぁ人形」！","nextNodeIds":[755000105]},{"nodeId":755000105,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1124518498,"text":"君たちは素晴らしいセンスと、ズバ抜けた才覚を持っていると見た。間違いなく前衛芸術の先駆者となり、ラクガキ絵師の超新星となれるだろう！","nextNodeIds":[755000106]},{"nodeId":755000106,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1345990690,"text":"この「カラフルノロマ」とともに、最新鋭の芸術を学んでみないか？","nextNodeIds":[755000107]},{"nodeId":755000107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1682001474,"text":"わぁ…また変なあだ名が登場したぞ！","nextNodeIds":[755000108,755000109]},{"nodeId":755000108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1090830428,"text":"また「わぁ」って言ってる。","nextNodeIds":[755000110]},{"nodeId":755000110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":521546882,"text":"今回は話をすり替えさせないからな——いまツッコむべきは「わぁわぁ」とか新しいあだ名とかじゃなくて、この「カラフルノロマ」のことだろ！","nextNodeIds":[755000111]},{"nodeId":755000111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3486726434,"text":"「前衛芸術」って言ってたけど…ナタの芸術が他とはぜんぜん違う理由って、そこにあるんじゃないか？","nextNodeIds":[755000112]},{"nodeId":755000112,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3058271298,"text":"ほほう、察しが良いな！","nextNodeIds":[755000113]},{"nodeId":755000113,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2904307610,"text":"ご覧のとおり…迫力満点のダンス、小刻みに跳ねる音楽、そして鮮やかな色使いのラクガキ。どれも前衛的理念と分けて考えることはできない。","nextNodeIds":[755000114]},{"nodeId":755000114,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2348111258,"text":"ナタの人々が言う流行、潮流、奇抜とは、どれも前衛的理念と同義語なのだよ。","nextNodeIds":[755000115]},{"nodeId":755000115,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3833024762,"text":"そして、私「カラフルノロマ」は「ラクガキユニオン」の大黒柱として、より多くの人に前衛を理解してもらい、前衛を実践し、前衛でもって世界を打ち砕かんとしている…","nextNodeIds":[755000116]},{"nodeId":755000116,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":998455234,"text":"そうすることで多くの芸術は進化し続け、非凡なる美学の産物を創造し、より猛々しい巨大なラクガキアートを描き出せるのだ！","nextNodeIds":[755000117,755000118]},{"nodeId":755000117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2164809714,"text":"よく分からない。","nextNodeIds":[755000119]},{"nodeId":755000119,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2944180906,"text":"ならばもっと具体的に言おう。例えばステージ背景の大型のラクガキだが、あれには私も制作に加わっている。","nextNodeIds":[755000120]},{"nodeId":755000120,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1304552186,"text":"もし背景を写実的な風景画、フォンテーヌの耽美的な油絵、あるいはスメールの壁画に変えたとしたら…","nextNodeIds":[755000121]},{"nodeId":755000121,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3505855930,"text":"君は、合うと思うかね？","nextNodeIds":[755000122]},{"nodeId":755000122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":77683906,"text":"今の具体的な例のおかげで、オイラもわかった気がするぜ…","nextNodeIds":[755000123]},{"nodeId":755000123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3072597258,"text":"もし背景の図形とか色が今のラクガキほど誇張したものじゃなかったら、確かに音楽とダンスの迫力も落ちそうだよな？","nextNodeIds":[755000124]},{"nodeId":755000124,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":895694202,"text":"もちろん、私は風景画や油絵、壁画が良くないと言っているのではない。ただ、緊張感や鋭さを強調させる必要がある場合、前衛的ラクガキほど適してはいないのだよ！","nextNodeIds":[755000125]},{"nodeId":755000125,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":529369938,"text":"私に言わせれば、すべてのナタの部族には向上心や勢いを追い求める気概がある。だから前衛もナタの基調なのだ！","nextNodeIds":[755000126]},{"nodeId":755000126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1027661450,"text":"名前に「ノロマ」なんて入ってるのに、いろんなことを知っててスゴいな！","nextNodeIds":[755000127,755000128]},{"nodeId":755000127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3128000626,"text":"弟子にしてほしい。","nextNodeIds":[755000129]},{"nodeId":755000129,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":660509458,"text":"おいおい！その返しはあんまりではないか？","nextNodeIds":[755000130]},{"nodeId":755000130,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":774342002,"text":"そう不安がるな。私たちは堅苦しい師弟関係なんぞにこだわらないし、富や名声も気にしない。重んじるのは経験の共有。そして、至るところで共有したものが花開くのを期待しているのだ。","nextNodeIds":[755000131]},{"nodeId":755000131,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":4241208914,"text":"君が前衛芸術の真髄を見抜き、相応しいラクガキアートを創り出してくれれば、私はそれで満足なのだよ。","nextNodeIds":[755000132]},{"nodeId":755000132,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3722733794,"text":"むしろ、君が頼れるラクガキマスターに一刻も早く成長できるよう、多額のモラや物資を提供することだってあり得る…","nextNodeIds":[755000133]},{"nodeId":755000133,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2047400954,"text":"その後は、私のラフ画作成を手伝ってもらう。","nextNodeIds":[755000134,755000135]},{"nodeId":755000134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2463481978,"text":"#えっ？{M#俺}{F#私}がラフ画を？","nextNodeIds":[755000136]},{"nodeId":755000136,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2831147234,"text":"もしくはラクガキアートをよそで宣伝してもらい、より多くの人材を惹きつけ、ラクガキユニオンへの新規加入を手伝ってもらうつもりだ。","nextNodeIds":[755000137]},{"nodeId":755000137,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1661657002,"text":"なにせ、私たちの目標はナタのすべての山に比類なき前衛的ラクガキを描くことだからね。たった十数人じゃとても足りん。","nextNodeIds":[755000138]},{"nodeId":755000138,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2397946762,"text":"うっ…背中と腰が…一日中、塗料缶を持ってあちこちで絵を描いていたから、骨が歪んで肩や太ももに影響が出てしまったか…","nextNodeIds":[755000139]},{"nodeId":755000139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":309393754,"text":"お金を渡してまで教えようとするなんて、普通は絶対なんか企んでるって考えるし…もし他の人だったら、詐欺なんじゃないかって心配すると思うけど…","nextNodeIds":[755000140]},{"nodeId":755000140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3643406234,"text":"おまえの話からは真剣な感じが伝わってくるな。信じてもよさそうだぞ。","nextNodeIds":[755000141]},{"nodeId":755000141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2863428810,"text":"#ラクガキの技を学べたら、いつか使えるときが来るかもしれないぜ！例えば…「{NICKNAME}とパイモン領地の壁」を描いて、魔物とか悪いやつを追い払うとかな！","nextNodeIds":[755000142]},{"nodeId":755000142,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1403831634,"text":"やはり、私の目に狂いはなかった！では、さっそく本題に入ろう——","nextNodeIds":[755000143]},{"nodeId":755000143,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":735309730,"text":"ラクガキというものは、高い画力を必要としない。だから、絵の練習をするよりも先に、前衛的理念の準則を掴んだほうがいいと思っているんだ。","nextNodeIds":[755000144]},{"nodeId":755000144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1368507906,"text":"じゅんそく？えっと…原則って意味か？","nextNodeIds":[755000145]},{"nodeId":755000145,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1776729514,"text":"まぁそんなところさ！つまり、制約に縛られずにアイデアを見つけ出し、それを自由自在に表現する必要があるということだ。","nextNodeIds":[755000146]},{"nodeId":755000146,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2200124658,"text":"そのためには、ハイスピードで動き回るタイムトライアル中に風景がぐにゃりと曲がる様を捉えてもらい、また近接戦闘で人体の動きの極限を見つけてもらう…私がそうしてきたようにね。","nextNodeIds":[755000147]},{"nodeId":755000147,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":786998506,"text":"そうすれば、ラクガキに必要なデフォルメされた線を描けるようになるだろう。","nextNodeIds":[755000148]},{"nodeId":755000148,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3750413666,"text":"色彩についてだが、自然界の様々なものを混ぜて色を組み合わせてみれば、予想外の驚きを得られるものだ…","nextNodeIds":[755000149]},{"nodeId":755000149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":694030170,"text":"たしかにそういうのを聞いたことあるような…でもよくわからないぞ。","nextNodeIds":[755000150,755000151]},{"nodeId":755000150,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2519171162,"text":"タイムトライアルや戦闘で線を観察する。","nextNodeIds":[755000152]},{"nodeId":755000152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1723558042,"text":"「芸術の理念」を研究する方法って変わってるな。やっぱりナタの人の考え方って、すごく特別な気がするぞ…","nextNodeIds":[755000153]},{"nodeId":755000153,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2674987834,"text":"では、私のラクガキ指南書とこの写真機を持ってナタの各地を回り、ついでにこの国独自の雰囲気をよく感じ取ってみてくれ。","nextNodeIds":[755000154]},{"nodeId":755000154,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3286727402,"text":"君たちが戻ってきたとき、その見聞きしたものに基づき、理解しやすい形で前衛的理念というものを総括してあげよう！","nextNodeIds":[]},{"nodeId":755000151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3406830490,"text":"色々なものを集めて色を研究する。","nextNodeIds":[755000152]},{"nodeId":755000135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4095747426,"text":"えっ？そうやって助手を捕まえてるの？","nextNodeIds":[755000136]},{"nodeId":755000128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2687989282,"text":"その知識、教えてもらうにはいくら？","nextNodeIds":[755000129]},{"nodeId":755000118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2772416042,"text":"抽象的すぎる。","nextNodeIds":[755000119]},{"nodeId":755000109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3229826946,"text":"わぁわぁパイモンだね。","nextNodeIds":[755000110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7550001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30609"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7550001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","count":29},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[175500],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1392515022,"CHECNJEMEFE":{"30609":[1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Natlan_75500/Q7550001","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false