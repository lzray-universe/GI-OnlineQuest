DK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7214301,7214302],"talks":[{"talkId":7214301,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_BILLBOARD_ONLY","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7214301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7214301,"initDialog":721430101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3193],"performCfg":"QuestDialogue/WQ/Daoqi_72143/Q7214301","priority":5,"questId":72143,"showRandomTalkCount":0},"dialogs":[{"nodeId":721430101,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3353021346,"text":"こんにちは、遠くからいらしたお客さん。私は露子、珊瑚宮の巫女です。お客さんは何か手伝いをしに来られたのでしょうか？","nextNodeIds":[721430102]},{"nodeId":721430102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":433961730,"text":"手伝い…？","nextNodeIds":[721430103]},{"nodeId":721430103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":698545010,"text":"なんで会ったばかりなのに手伝いを求めるんだよ！","nextNodeIds":[721430104]},{"nodeId":721430104,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3182291034,"text":"あははっ、失礼しました…","nextNodeIds":[721430105]},{"nodeId":721430105,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2742853290,"text":"以前くじを引いたら、私がいま悩んでいること、困っていることについて、誰かが解決してくれると書かれてあったんです。","nextNodeIds":[721430106]},{"nodeId":721430106,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3814946218,"text":"そして今、まさにそのお方が手助けをしに来てくださった。そうですよね？","nextNodeIds":[721430107,721430109]},{"nodeId":721430107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3507852122,"text":"それは言い訳でしょ！","nextNodeIds":[721430108]},{"nodeId":721430108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1086983426,"text":"しょうがないな…まずは事情を聞いてみよう。","nextNodeIds":[721430111]},{"nodeId":721430111,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":976273706,"text":"ありがとうございます。では、事の詳細を説明いたします。","nextNodeIds":[721430112]},{"nodeId":721430112,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2525773658,"text":"珊瑚宮の正面に位置する深潭は、「淵下宮」の入り口で、海祇人の起源という言い伝えがあります。","nextNodeIds":[721430113]},{"nodeId":721430113,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3750185498,"text":"古代には、「海祇美人」という言い伝えがあります。海祇人はきめ細かな肌を持ち、隠すのが難しい7つの傷も目立たなくすることができると言います。","nextNodeIds":[721430114]},{"nodeId":721430114,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3507719970,"text":"その言い伝えは、我々の祖先が淵下宮にいたため、日光に当たっていなかったことに由来するそうです…","nextNodeIds":[721430115,721430116]},{"nodeId":721430115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1592037554,"text":"コホン。","nextNodeIds":[721430117]},{"nodeId":721430117,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1113694146,"text":"あっ、すみません。私は日ごろから、旅行者の方に海祇島を紹介しているので、つい…","nextNodeIds":[721430118]},{"nodeId":721430118,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1817123722,"text":"海祇大御神と先人を記念して、我々には祭物を淵下宮に沈めるという伝統があります。","nextNodeIds":[721430119]},{"nodeId":721430119,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1311736554,"text":"我々の祖先の起源は「白夜国」にあり、文献に記された大日御輿の微かな光を頼りに、アビサルドラゴエアの爪から生き残ってきたと言われています。","nextNodeIds":[721430120]},{"nodeId":721430120,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2554074346,"text":"そして、数千年前。海祇大御神が降臨し、アビサルドラゴエアを倒し、我々を地上へと連れてきました。そこに珊瑚宮を建て、海祇島を新たな故郷としたのです。","nextNodeIds":[721430121]},{"nodeId":721430121,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1913046370,"text":"それから、海の下の白夜国は、淵下宮と呼ばれるようになりました。海の上にある、珊瑚宮と対になる存在として。","nextNodeIds":[721430122]},{"nodeId":721430122,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1750315010,"text":"もちろん…伝説はあくまでも伝説に過ぎません。鳴神人が幕府軍に語るような、魔神征服論と同じく…","nextNodeIds":[721430123]},{"nodeId":721430123,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1836898610,"text":"犠牲と追憶という概念は、我々自身を守る武器の一つでもあるのです。","nextNodeIds":[721430124]},{"nodeId":721430124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2539035290,"text":"それって巫女さんが話していいような内容なのか？","nextNodeIds":[721430125]},{"nodeId":721430125,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2226913946,"text":"確かに、巫女がこのようなことを言うべきではありません。しかし、一人の人間として、歴史や民俗は批判的な目で見るべきだと思います。","nextNodeIds":[721430126]},{"nodeId":721430126,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3274670226,"text":"すみません、話を戻しましょう…現在、海祇島の「聖土」問題がますます深刻な状況になっているのです。","nextNodeIds":[721430127]},{"nodeId":721430127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3732206522,"text":"「聖土」…って何？","nextNodeIds":[721430128]},{"nodeId":721430128,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1236828466,"text":"人の心と水は低い方へ流れると言うように、海祇島の「霊」も、淵下宮の深くに吸い寄せられるのです…","nextNodeIds":[721430129]},{"nodeId":721430129,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2568908258,"text":"そのため土が白化する、いわゆる聖土化が発生します。このまま続いてしまうと、海祇島もいつの日か、月光のように白い砂漠になってしまうでしょう。","nextNodeIds":[721430130,721430132]},{"nodeId":721430130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":448323386,"text":"なんだか怖い…","nextNodeIds":[721430131]},{"nodeId":721430131,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1272947658,"text":"そうですか？私からすれば、お年寄りたちの迷信に過ぎません。確かに真実味があるかもしれませんが、論理的な繋がりは乏しいです。","nextNodeIds":[721430133]},{"nodeId":721430133,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3438730938,"text":"伝統的な言い伝えでは、数百年に一度、霊脈の流れが順調になる時に、淵下宮と珊瑚宮を阻んでいる結界を解く必要があります…","nextNodeIds":[721430134]},{"nodeId":721430134,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4232367522,"text":"淵下宮に潜り、大御神が残した、アビサルドラゴエアを鎮圧する珊瑚の石枝を取り出すのです。","nextNodeIds":[721430135]},{"nodeId":721430135,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":568663370,"text":"その石枝を利用して海祇御霊祭を行えば、沈んだ「霊」を帰らせることができ、聖土の侵食を止められるのです。","nextNodeIds":[721430136]},{"nodeId":721430136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":667914058,"text":"でもアビサルドラゴエアを鎮圧する物を取ったら…","nextNodeIds":[721430137]},{"nodeId":721430137,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1194262970,"text":"鋭い洞察力ですね。","nextNodeIds":[721430138]},{"nodeId":721430138,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4250773730,"text":"鎮圧用の珊瑚の石枝はたくさんあります。しかしこのままいけば、深海の龍はいつの日か鎮圧を破り、海祇の地を浸食するでしょう。","nextNodeIds":[721430139]},{"nodeId":721430139,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1049623386,"text":"ですので、お願いしたいことがあるのです…","nextNodeIds":[721430140,721430142]},{"nodeId":721430140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3202344290,"text":"珊瑚の石枝を取ってくること？","nextNodeIds":[721430141]},{"nodeId":721430141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1080197474,"text":"#{NICKNAME}は物探しが得意だぞ！","nextNodeIds":[721430144]},{"nodeId":721430144,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":193485146,"text":"現段階では、それらではありません…","nextNodeIds":[721430145]},{"nodeId":721430145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":901834978,"text":"あとの段階でそういうことをやるんだな！","nextNodeIds":[721430146]},{"nodeId":721430146,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2528977090,"text":"あとの段階は…そうですね…一旦状況を見てからでいいでしょうか？","nextNodeIds":[721430147]},{"nodeId":721430147,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1944252802,"text":"…おみくじの結果でも見るのか？","nextNodeIds":[721430148]},{"nodeId":721430148,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4070423842,"text":"コホンッ、今あなたたちにお願いしたいのは、海祇島の「五傷岩」を訪ねることです。","nextNodeIds":[721430149]},{"nodeId":721430149,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1333338066,"text":"五傷岩は珊瑚宮と淵下宮を阻む結界にある5つの関所です。珊瑚宮初代の神人たちが大御神と共に設置したものです。","nextNodeIds":[721430150]},{"nodeId":721430150,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1747814586,"text":"結界を解いて淵下宮に入るには、その5つの封印を解かなければなりません。","nextNodeIds":[721430151]},{"nodeId":721430151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1615844762,"text":"なんか危なそうだぞ…","nextNodeIds":[721430152]},{"nodeId":721430152,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4105138058,"text":"確かに、軽率に封印を開けるのは非常に危険です。何しろすでに長い年月が経ち、我々の世代ではその下にどのような危険が潜んでいるか知る者はいません。","nextNodeIds":[721430153]},{"nodeId":721430153,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2556385106,"text":"頼れる記録も少なく、そのほとんどが参考価値の低い古代の文書です。","nextNodeIds":[721430154]},{"nodeId":721430154,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":964002474,"text":"もしかしたら、アビサルドラゴエアが下で待ち構えているかもしれません。あるいは、龍よりも危険な魔物が潜んでいて、封印が解かれるのを待っているかもしれません…","nextNodeIds":[721430155]},{"nodeId":721430155,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1565282330,"text":"過去の遺跡も珊瑚と海綿の下に埋もれているかもしれませんし…","nextNodeIds":[721430156]},{"nodeId":721430156,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":103585530,"text":"最悪の場合——下には何もなく、空洞と海水しかない可能性も…？","nextNodeIds":[721430157]},{"nodeId":721430157,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4229389226,"text":"とにかく、我々がここで何を考えようと結果を知ることはできません。","nextNodeIds":[721430158]},{"nodeId":721430158,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":563091138,"text":"そうは言っても、実際にやるのはオイラたちなんだぞ。","nextNodeIds":[721430159]},{"nodeId":721430159,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3807063418,"text":"しかし、淵下宮は長年誰も訪れたことがないので、祖先が残したお宝も中にあるかもしれませんよ。","nextNodeIds":[721430160]},{"nodeId":721430160,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":526823754,"text":"#お宝…えへへ。{NICKNAME}、現地の人を助けることは、いい経験になるとオイラは思うぞ。","nextNodeIds":[721430161]},{"nodeId":721430161,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3773681602,"text":"…露子さん、口上手だね。","nextNodeIds":[721430162]},{"nodeId":721430162,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3346678810,"text":"いえいえ。では、本題に入りましょう。五傷岩の5つの関所は、「目」、「牙」、「鰭」、「尾」、そして「心」。","nextNodeIds":[721430163]},{"nodeId":721430163,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2038294906,"text":"まずは<color=#00E1FFFF>西側の島</color>に、「目」と呼ばれる封印があります。ほら、あちらにありますよ。","nextNodeIds":[721430164]},{"nodeId":721430164,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":47377098,"text":"じゃあ自分で行けばいいだろ！","nextNodeIds":[721430165]},{"nodeId":721430165,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1264050770,"text":"えへへ…","nextNodeIds":[721430166]},{"nodeId":721430166,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2771963122,"text":"真面目にやれよ！","nextNodeIds":[721430167]},{"nodeId":721430167,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":598857538,"text":"封印自体は長く維持されてきたので、封印を解くための儀式を知る者はほとんどいません…","nextNodeIds":[721430168]},{"nodeId":721430168,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4001021290,"text":"それに、現人神の巫女様は現在の情勢から、五重封印を解く盛大な儀式を行う時間がないのです。","nextNodeIds":[721430169]},{"nodeId":721430169,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3639544226,"text":"外部の方にこんなことを言うのは非常にお恥ずかしいのですが。今はあなたのような、知識豊富で信頼できる外国の方に頼るしかありません。","nextNodeIds":[721430170]},{"nodeId":721430170,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":438935266,"text":"万が一失敗しても、あなたが外国の方であることを理由に…","nextNodeIds":[721430171]},{"nodeId":721430171,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3752819914,"text":"罪を着せる？","nextNodeIds":[721430172]},{"nodeId":721430172,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3895029586,"text":"いえ…それは考えすぎです。「知らぬ者に罪はなし」と言うじゃないですか。","nextNodeIds":[721430173]},{"nodeId":721430173,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":507407802,"text":"もし<color=#00E1FFFF>珊瑚宮</color>を基準とした場合、「牙」は<color=#00E1FFFF>北西側</color>、「鰭」は<color=#00E1FFFF>北</color>にあります。","nextNodeIds":[721430174]},{"nodeId":721430174,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3351487330,"text":"そして最後、<color=#00E1FFFF>東の浅瀬</color>に「尾」があります。","nextNodeIds":[721430175]},{"nodeId":721430175,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":707331906,"text":"この4か所の封印の近くには、それぞれ石碑があり、儀式に関する事柄を記載されています…ただ、年代が古い物なので、字はかすれて読めないかもしれません。","nextNodeIds":[721430176]},{"nodeId":721430176,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":665090394,"text":"その4か所の封印にある「御霊真珠」を取れば、5つ目の「心」の封印を解くことができます。","nextNodeIds":[721430177]},{"nodeId":721430177,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1868071714,"text":"なんか難しそう…","nextNodeIds":[721430178]},{"nodeId":721430178,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1510760874,"text":"大丈夫です、もし忘れた場合は珊瑚宮で私に聞きに来てください。もう一度説明しますので。","nextNodeIds":[721430179]},{"nodeId":721430179,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2785674250,"text":"最後に…あなたを呼び止め、このような大事に巻き込んでしまい、誠に申し訳ございません。","nextNodeIds":[721430180]},{"nodeId":721430180,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4196996738,"text":"しかしこれは海祇島にとってとても重要なことで…手伝っていただけると幸いです。","nextNodeIds":[]},{"nodeId":721430142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":851635034,"text":"アビサルドラゴエアを倒すこと？","nextNodeIds":[721430143]},{"nodeId":721430143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2247270306,"text":"#{NICKNAME}は戦闘が得意だぞ！","nextNodeIds":[721430144]},{"nodeId":721430132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3778477874,"text":"じゃあどう解決すればいいの？","nextNodeIds":[721430133]},{"nodeId":721430116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":345937522,"text":"手伝いの内容について…","nextNodeIds":[721430117]},{"nodeId":721430109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":485440106,"text":"問題ない。","nextNodeIds":[721430110]},{"nodeId":721430110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2078698234,"text":"色んな人助けのお願いがあるんだな…","nextNodeIds":[721430111]}]},{"talkId":7214302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7214301","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7214302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7214302,"initDialog":721430201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3193],"performCfg":"","priority":5,"questId":72143,"showRandomTalkCount":0},"dialogs":[{"nodeId":721430201,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1682028498,"text":"おかえりなさい。どうされましたか？","nextNodeIds":[721430202,721430206,721430211]},{"nodeId":721430202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2743893330,"text":"「五傷岩」の位置について…","nextNodeIds":[721430203]},{"nodeId":721430203,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1461036314,"text":"<color=#00E1FFFF>「目」</color>は<color=#00E1FFFF>西にある島の上</color>。<color=#00E1FFFF>「牙」</color>は<color=#00E1FFFF>北西方向にある海岸の上</color>。<color=#00E1FFFF>「鰭」</color>は<color=#00E1FFFF>北にある海岸の上</color>、そして<color=#00E1FFFF>「尾」</color>は<color=#00E1FFFF>南東方向にある浅瀬の上</color>です。","nextNodeIds":[721430204]},{"nodeId":721430204,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3086869770,"text":"この4か所の封印の近くには、それぞれ石碑があり、儀式に関する事柄を記載されています…ただ、年代が古い物なので、字はかすれて読めないかもしれません。","nextNodeIds":[721430205]},{"nodeId":721430205,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":835733690,"text":"この4か所の封印から「御霊真珠」を取り出せば、「心」の封印を解くことができます。","nextNodeIds":[721430214]},{"nodeId":721430214,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3652731250,"text":"そして必要な時に、封印を解いて石枝を取り出し、海祇御霊祭を行います…","nextNodeIds":[721430215]},{"nodeId":721430215,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1881091530,"text":"ですが私が教令院で学んだ知識によれば、聖土化は海祇島の地質構造によって決まっているらしいのです。","nextNodeIds":[721430216]},{"nodeId":721430216,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1746759290,"text":"海水が浸ることで、土が固くなり、元々そこにあった養分が塩分によって排除されます。土にある元素反応が不活性化し、その土は農業に適さなくなります。","nextNodeIds":[721430217]},{"nodeId":721430217,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":1345913426,"text":"石枝には大御神の力が込められているため、土に元素を補充することができ、白化の影響を防ぐことができます。","nextNodeIds":[721430218]},{"nodeId":721430218,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2930718098,"text":"コホンッ、すみません、また話が逸れてしまいましたね。","nextNodeIds":[]},{"nodeId":721430206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3637075946,"text":"「五傷岩」の名前について…","nextNodeIds":[721430207]},{"nodeId":721430207,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":311175586,"text":"封印がどうしてそのように呼ばれているかについてですか？","nextNodeIds":[721430208]},{"nodeId":721430208,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":729855418,"text":"大御神様には神使がいました。神人たちがその亡骸に封印を設置し、その力で海祇と淵下の繋がりを遮断したのです。","nextNodeIds":[721430209]},{"nodeId":721430209,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":3043170850,"text":"地図を確認すれば分かります。左にある膨らみが「目」で、右下に伸びているのが「尾」…","nextNodeIds":[721430210]},{"nodeId":721430210,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":2226739946,"text":"そ、そのような目で見ないでください…私も同僚から聞かされただけですので！私もおかしいと思ってますよ！","nextNodeIds":[]},{"nodeId":721430211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3388110066,"text":"「聖土化」について…","nextNodeIds":[721430212]},{"nodeId":721430212,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":794749586,"text":"土の白化は、海祇の地にある「霊」が白夜国に吸い寄せられて沈み、最終的に海祇を砂漠にしてしまうといいます。","nextNodeIds":[721430213]},{"nodeId":721430213,"roleType":"TALK_ROLE_NPC","speakerId":3193,"speakerName":"露子","textMapHash":4261020186,"text":"珊瑚宮の鎮圧作用、そして現人神の巫女様が受け継いだ大御神の神力により、「聖土化」が島全体に拡散することを防いでいるのです。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7214301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NO