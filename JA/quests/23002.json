Xumi_23002/Q2300201","priority":5,"questId":23002,"showRandomTalkCount":0},"dialogs":[{"nodeId":230020101,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":2671561658,"text":"この店のキノコは質が良さそうだ。調達リストに載せておこう…","nextNodeIds":[230020102]},{"nodeId":230020102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1631378306,"text":"範兵衛？なんか、聞いたことのある名前だぞ？どこかで誰かが話してたような…","nextNodeIds":[230020103,230020104]},{"nodeId":230020103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1366344714,"text":"も、もしかしてこの前のたたら砂の…","nextNodeIds":[230020105]},{"nodeId":230020105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":293459058,"text":"うわあ！グズグズ事務仕事をやって、「御影炉心」をめちゃくちゃにしたヤツじゃないか！","nextNodeIds":[230020106,230020107]},{"nodeId":230020106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3818707682,"text":"「遠国御用」として来たんだと思う…","nextNodeIds":[230020108]},{"nodeId":230020108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2289118986,"text":"アイツ、本当にスメールに来てたのか？あの「遠国御用」ってのは冗談だと思ってたぞ…","nextNodeIds":[230020109]},{"nodeId":230020109,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":1172788146,"text":"おや？金髪の…それに、隣でふわふわ浮いてるチビ…","nextNodeIds":[230020110]},{"nodeId":230020110,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":2468021754,"text":"あなたはもしや、あの「旅人」殿では？","nextNodeIds":[230020111,230020112]},{"nodeId":230020111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4205167658,"text":"そうだよ。","nextNodeIds":[230020114]},{"nodeId":230020114,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":2305334810,"text":"おお、やはりそうでしたか。陽介が手紙に書いておりました。あなたがグザヴィエさんと一緒に「御影炉心」を修理してくださったと。","nextNodeIds":[230020115]},{"nodeId":230020115,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":189966170,"text":"いやはや、お恥ずかしながら、あなたとグザヴィエさんが「御影炉心」を修理していたとき、私は事務処理で手が放せませんで……","nextNodeIds":[230020116]},{"nodeId":230020116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1078024682,"text":"事務処理って「御影炉心」より大事なの…？","nextNodeIds":[230020117]},{"nodeId":230020117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":464869610,"text":"仕事の優先が完全に間違ってる…！","nextNodeIds":[230020118]},{"nodeId":230020118,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":3821179618,"text":"何をおっしゃいますやら。事務処理をきちんとしなければ、「御影炉心」の修理だって順序よく進められないのですよ？","nextNodeIds":[230020119]},{"nodeId":230020119,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":1552026994,"text":"ほら、周りの人たちを避難させ、修理物資を準備し、修理要員を動員し、各方面の生産需要を調整しなければならないでしょう。","nextNodeIds":[230020120]},{"nodeId":230020120,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":2595396754,"text":"事務方の支えがなければ、大混乱に陥ってしまいます。","nextNodeIds":[230020121]},{"nodeId":230020121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2305271818,"text":"やっぱり虎之助の言った通り…","nextNodeIds":[230020122]},{"nodeId":230020122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2479280826,"text":"評判通りだな…","nextNodeIds":[230020123]},{"nodeId":230020123,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":621293306,"text":"虎之助…あの方は、事務手続きをまるで気にかけない人でして。一緒に仕事をすると、いつも余計な仕事が増えます。","nextNodeIds":[230020124]},{"nodeId":230020124,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":3131202954,"text":"しかし、私はもう「御影炉心」の担当ではありません。今はスメールで「遠国御用」として、キノコ貿易を管理しておりまして。","nextNodeIds":[230020125]},{"nodeId":230020125,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":1408125602,"text":"ふむ…旅人殿の功績は陽介から聞いております。とても信頼できる方だと。","nextNodeIds":[230020126]},{"nodeId":230020126,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":998941818,"text":"よろしければ、ひとつお手伝いをお願いできませんか？","nextNodeIds":[230020127]},{"nodeId":230020127,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":1051265490,"text":"信頼のおける、安定したキノコの仕入れ先を探していまして。ここでたくさん店を訪ねたのですが——","nextNodeIds":[230020128]},{"nodeId":230020128,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":3885915258,"text":"彼らが持ってきてくれた見本のキノコは、わざわざ選りすぐられたであろう、お行儀の良い品ばかりでして…","nextNodeIds":[230020129]},{"nodeId":230020129,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":3853508738,"text":"ですからその産地に行き、直に品質を確かめて、実際に納品される商品の質を評価すべきだと思うのです。","nextNodeIds":[230020130]},{"nodeId":230020130,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":424402306,"text":"しかしご覧のように、私は野外で実地調査をした経験がありません。一人で森に入れば、危険のほうが大きいでしょう。","nextNodeIds":[230020131]},{"nodeId":230020131,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":3299388186,"text":"そこで、代わりに森へキノコを採集に行っていただきたいのです。いかがでしょう？","nextNodeIds":[230020132,230020133]},{"nodeId":230020132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":364093634,"text":"だめじゃないけど…","nextNodeIds":[230020134]},{"nodeId":230020134,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":1987031730,"text":"おお、引き受けてくださいますか？助かります！報酬のことはご心配なく、既に書類を用意してあります。","nextNodeIds":[230020135]},{"nodeId":230020135,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":2445600314,"text":"こちらをご覧ください。ええ、まずはこの書類を。これが雇用契約で、報酬の計算方法も記してあります。こちらが義務の告知と秘密保持契約です。そうそう、キノコの産地の地図もございまして……","nextNodeIds":[230020136]},{"nodeId":230020136,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":225281018,"text":"範兵衛と一緒にすべての書類を細かく確認して、へとへとになった…","nextNodeIds":[230020137]},{"nodeId":230020137,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":102565562,"text":"はい、これですべての書類の説明をいたしました。先に幕府に報告いたしますので、受理されるのを待って、正式な雇用関係を結びましょう。","nextNodeIds":[230020138]},{"nodeId":230020138,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":931236642,"text":"ですがその前に、ひとまず私が自腹で報酬を支払います。なにしろキノコの仕入れを、遅らせるわけにはいきませんので。","nextNodeIds":[230020139]},{"nodeId":230020139,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":1677024178,"text":"もちろん、この件も文書にまとめて幕府に届け出ます。あなたの報酬も税務上、申告が必要ですので。","nextNodeIds":[230020140]},{"nodeId":230020140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2552147546,"text":"と、とりあえず、キノコ狩りに行ってくる！","nextNodeIds":[230020141]},{"nodeId":230020141,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":2021993906,"text":"あ、はあ…左様ですか。ではお願いします…","nextNodeIds":[230020142]},{"nodeId":230020142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1809620042,"text":"もう面倒事には巻き込まれないだろうな？オイラ心配になってきたぞ…","nextNodeIds":[230020143,230020145]},{"nodeId":230020143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3270065290,"text":"彼をしっかり見張っておける。","nextNodeIds":[230020144]},{"nodeId":230020144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2947138818,"text":"そうとも言えるな…わかったよ、それも一理あるかもな…","nextNodeIds":[230020147]},{"nodeId":230020147,"roleType":"TALK_ROLE_NPC","speakerId":4024,"speakerName":"範兵衛","textMapHash":112535306,"text":"おや？何だか私を信じていないような表情ですね…ご安心ください。私の準備は完璧です。この段取りなら決して、問題は起きませんよ。","nextNodeIds":[230020148]},{"nodeId":230020148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":478821386,"text":"まさにそういうところが心配なんだぞ！…はあ、とにかく森に行って、キノコを採って来てやろう。","nextNodeIds":[]},{"nodeId":230020145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":748790786,"text":"…次にどんな騒ぎを起こすのか見たい。","nextNodeIds":[230020146]},{"nodeId":230020146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1229408410,"text":"おい！もし本当に騒ぎになったら、オイラたちだけでどうにかしないといけないんだぞ！","nextNodeIds":[230020147]},{"nodeI