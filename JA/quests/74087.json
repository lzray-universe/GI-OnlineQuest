{"nodeId":740870203,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":2584168362,"text":"#僕がクロニエさんの質問に答えている間、「サーベイランスアンカー」の回収作業は{NICKNAME}さんにお任せしましたよ。","nextNodeIds":[]}]},{"talkId":7408703,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7408702","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7408703,"initDialog":740870301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21084,5259],"performCfg":"QuestDialogue/WQ/Fontaine_74053/Q7408703","priority":5,"questId":74087,"showRandomTalkCount":0},"dialogs":[{"nodeId":740870301,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":1953872146,"text":"「宿舎」は他の区域に比べれば、爆発の影響はそれほどでもなかったと言えます。","nextNodeIds":[740870302]},{"nodeId":740870302,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":3112850082,"text":"宿舎？でもここにはベッドの一つもないわ。研究員はどうやって休むの？椅子の上で眠るわけにはいかないでしょう？","nextNodeIds":[740870303]},{"nodeId":740870303,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":3696702714,"text":"クロニエさん、あなたの理解する「休息」と研究員たちに必要な「休息」は少し異なるんです。","nextNodeIds":[740870304]},{"nodeId":740870304,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":525478722,"text":"フォンテーヌ科学院の研究員が「休みが必要だ」と言う時、ただ自分の頭が考え事をするのをしばらく止めたいというだけなんですよ。","nextNodeIds":[740870305]},{"nodeId":740870305,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":144266346,"text":"それで普通はここへ来て、ピアノを弾いたり、気軽に読める本を読んだり、必要であれば飲んだりするわけです。","nextNodeIds":[740870306]},{"nodeId":740870306,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":3679620474,"text":"あら…でも、それなら寝た方が頭を休ませられるんじゃないかしら？","nextNodeIds":[740870307]},{"nodeId":740870307,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":3537142322,"text":"それはそうです。でも…我々研究員からすれば、睡眠をとるということはあまりにも時間のムダなんです。","nextNodeIds":[740870308]},{"nodeId":740870308,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":1123380026,"text":"睡眠が時間のムダですって？必要な休息よ！","nextNodeIds":[740870309]},{"nodeId":740870309,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":601948802,"text":"睡眠は研究の思考を完全に断ってしまいます。研究という仕事において、そんなことは全く受け入れがたいんですよ。","nextNodeIds":[740870310,740870311]},{"nodeId":740870310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3035249650,"text":"（聞き続ける…）","nextNodeIds":[740870312]},{"nodeId":740870312,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":1119384914,"text":"真面目に言ってるの？睡眠をとらなければ、絶たれるのは命のほうよ。","nextNodeIds":[740870313]},{"nodeId":740870313,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":2949470914,"text":"そんなことはありませんよ。以前の科学院には優れた医療保障がありましたから。一研究員の健康を保証するのは全く難しくないことですよ。","nextNodeIds":[740870314]},{"nodeId":740870314,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":832469874,"text":"それは眠らない理由にはならないでしょう？","nextNodeIds":[740870315]},{"nodeId":740870315,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":3338413642,"text":"それに…研究員は一時的に頭を休ませるためにここへ来るわけでしょう？研究のための思考はそもそも中断されてるわ。","nextNodeIds":[740870316]},{"nodeId":740870316,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":950635426,"text":"いいえ、頭を一時休ませているとは言っても、実際は学術的な問題を本能的に考え続けています。","nextNodeIds":[740870317]},{"nodeId":740870317,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":4262802042,"text":"広大な大海原で、波がしばらく消えたかのように見えても、深い所でひそかに沸き立っているのと同じようなことですよ。","nextNodeIds":[740870318]},{"nodeId":740870318,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":1924136322,"text":"時には、このひっそりとしたうねりの持つ力の方が、表面の大波よりもさらに巨大なことがありますから。","nextNodeIds":[740870319]},{"nodeId":740870319,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":2561180202,"text":"分かったわ。あなたが言いたいのはつまり、フォンテーヌ科学院の研究員なら、研究中は休むことなく研究するしかないってことね？","nextNodeIds":[740870320]},{"nodeId":740870320,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":1196109826,"text":"それは客観性に欠ける言い方ですね。本当に睡眠が必要なら、帰って寝ればいいんです。","nextNodeIds":[740870321]},{"nodeId":740870321,"roleType":"TALK_ROLE_NPC","speakerId":5259,"speakerName":"クロニエ","textMapHash":2393228378,"text":"だったらこうね。フォンテーヌ科学院の研究員はフォンテーヌ科学院にいる限り、休むことなく研究を続けるしかない。","nextNodeIds":[740870322]},{"nodeId":740870322,"roleType":"TALK_ROLE_NPC","speakerId":21084,"speakerName":"ナッカー","textMapHash":2402609346,"text":"あなたのレトリックの腕には脱帽です、クロニエさん。","nextNodeIds":[