":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7370106","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370106,"initDialog":737010601,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7370106","priority":5,"questId":73701,"showRandomTalkCount":0},"dialogs":[{"nodeId":737010601,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3145003690,"text":"見慣れた風景のはずなのに、なんだか複雑な気持ちだワ…","nextNodeIds":[737010602]},{"nodeId":737010602,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2093457050,"text":"えーと…ポジティブに考えれば、ソルシュが前より成長したってことだろ？","nextNodeIds":[737010603]},{"nodeId":737010603,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2617629826,"text":"成長か、はたまた退化なのか…","nextNodeIds":[737010604]},{"nodeId":737010604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3332695130,"text":"元気出せよ、ソルシュ！そんなしょんぼりした姿、おまえらしくないぞ。","nextNodeIds":[737010605]},{"nodeId":737010605,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":687660474,"text":"そうだ、せっかくここまで来たんだし、「スケプティック団」設立当初の歴史を話してくれよ？","nextNodeIds":[737010606]},{"nodeId":737010606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1044602818,"text":"今はこんな有り様とは言え…設立当初はそれなりに良いところがあったんじゃないのか？じゃないと、ズルヴァーンがあいつらを助けたり、ソルシュが惹きつけられたりすることもないはずだろ？","nextNodeIds":[737010607]},{"nodeId":737010607,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":521889626,"text":"分かったワ。どうしても聞きたいのなら…でも前も言った通り、私が生まれたのはスケプティック団の設立後のことヨ。だから当時のことは、私も聞いた話でしか知らないワ。","nextNodeIds":[737010608]},{"nodeId":737010608,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":364342226,"text":"全てが起こる前——その災難がもうすぐ起きるコトを伝えようとした純白の群れがいたそうなノ。","nextNodeIds":[737010609]},{"nodeId":737010609,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":1290483882,"text":"でも情報を伝えるだけでは、災厄の降臨を阻止することはできなかった。間もなく、大地は漆黒の波に呑み込まれ、万物の命は恐怖に震えたワ。","nextNodeIds":[737010610]},{"nodeId":737010610,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":4173235706,"text":"この間、風蝕ウェネトの結晶を見たデショ？あのように、どんなに屈強な命あっても、あの災難から逃れることはできなかった。","nextNodeIds":[737010611]},{"nodeId":737010611,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3533886722,"text":"比べれば軟弱極まりない人類が、一目散に逃げたとしても責められはしないワ。","nextNodeIds":[737010612]},{"nodeId":737010612,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":1511773330,"text":"でも、その中には災厄の渦中を目指して突き進む人間もいた。","nextNodeIds":[737010613]},{"nodeId":737010613,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1885598346,"text":"それが当時のスケプティック団だったのか？","nextNodeIds":[737010614]},{"nodeId":737010614,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2600444362,"text":"そう。そしてその筆頭がナガルジュナだったノ。彼らは元々森の中の学者だったんだケド、災厄の余波を鎮圧するため、この地に根を下ろした。","nextNodeIds":[737010615]},{"nodeId":737010615,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3585524810,"text":"そうそう、それから金髪の人間もいた…先輩はあまり言及してなかったケド、少なくとも「面白い」人間だったに違いないワ。","nextNodeIds":[737010616]},{"nodeId":737010616,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3289887362,"text":"#うーん…何百年も前の人じゃなかったら、{NICKNAME}とどっちが面白いか、対決してほしかったけどな。","nextNodeIds":[737010617,737010618]},{"nodeId":737010617,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3057555138,"text":"対決して何の意味が…","nextNodeIds":[737010619]},{"nodeId":737010619,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3496157514,"text":"——続けるわヨ。私が生まれた頃には、災厄の余波もだいぶ落ち着いていたワ。","nextNodeIds":[737010620]},{"nodeId":737010620,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1668556226,"text":"そしたら、ソルシュがやることってあまりなかったのか？","nextNodeIds":[737010621]},{"nodeId":737010621,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3495091842,"text":"うぅ…そうでもないワ。穢れが完全になくなることはないもの。でも…神鳥「シームルグ」のような壮絶な犠牲を払う必要はなくなったワ。","nextNodeIds":[737010622]},{"nodeId":737010622,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2777648178,"text":"それに私よりも前に、ミヒルやラシュヌたちが既に、それぞれの役割を果たしていた。","nextNodeIds":[737010623]},{"nodeId":737010623,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2857729722,"text":"ナガルジュナの後、先輩は次第にスケプティック団の人間との交流を断っていったケド、スケプティック団の人間は相変わらず花霊のことを気にしていたワ。","nextNodeIds":[737010624]},{"nodeId":737010624,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":4224676138,"text":"無理もナイと思う。彼らにとって、我ら花霊は頌歌の主人公なんだもノ。憧れの気持ちを抱くのも当たり前ネ。","nextNodeIds":[737010625]},{"nodeId":737010625,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2735473922,"text":"あの頃、彼らが声高らかに詩を詠みあげるのをよく見かけたワ。そうして神鳥の献身も、だんだん鮮明に見えてきた気がした。でも、先輩はいつもさらっと流すだけ…","nextNodeIds":[737010626]},{"nodeId":737010626,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3824183554,"text":"それって…","nextNodeIds":[737010627]},{"nodeId":737010627,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3763187866,"text":"人間の甘言につられた…","nextNodeIds":[737010628]},{"nodeId":737010628,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2753816610,"text":"そんなハズないワ。私は神鳥の慈悲と覚悟に感動したカラ、模倣することを決めたのヨ。","nextNodeIds":[737010629]},{"nodeId":737010629,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3730527970,"text":"スケプティック団の人間と付き合ったのは、彼らが過去のことを隠さずに教えてくれたからヨ…ま、まあ適度な褒め言葉もなくはなかったケド。","nextNodeIds":[737010630]},{"nodeId":737010630,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3880788650,"text":"同じ話でも、ちょっと尾ひれをつけたほうが聞き手を惹きつけるもんだしな。オイラも面白い話を聞くのが大好きだぜ！","nextNodeIds":[737010631]},{"nodeId":737010631,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1673337002,"text":"あっ！でも、真実の歴史を記録するって目的だったら、かなり問題だけどな。","nextNodeIds":[737010632]},{"nodeId":737010632,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3047254778,"text":"そうね…私もスケプティック団も、尾ひれをつけるのに慣れすぎてしまったのカモ。その結果が今に繋がっているんだと思う。","nextNodeIds":[737010633]},{"nodeId":737010633,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3508008298,"text":"スケプティック団の文献書籍には、単なる事実の記録のほかに、修飾語や主観的な解釈が溢れかえるようになった。","nextNodeIds":[737010634]},{"nodeId":737010634,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2090838506,"text":"…そして私は、行動よりも名声を重要視してしまうようになったノ。","nextNodeIds":[737010635]},{"nodeId":737010635,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3216879178,"text":"ソルシュ…遂に悟ったのか？","nextNodeIds":[737010636]},{"nodeId":737010636,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1092025802,"text":"少なくとも来た時と比べたら元気になったみたい。","nextNodeIds":[737010637]},{"nodeId":737010637,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3978321394,"text":"うんうん、いいことだよな。へへ、これならズルヴァーンも花冠を没収だなんて言わないだろ？","nextNodeIds":[737010638]},{"nodeId":737010638,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":489530082,"text":"ソルシュの訓練も残りあとちょっとだ。きっとズルヴァーンに認めてもらえるぞ！","nextNodeIds":[]},{"nodeId":737010618,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":650986898,"text":"#もちろん{M#俺}{F#私}の圧勝。","nextNodeIds":[737010619]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7370106_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7370101,7370106],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","count":22},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173701],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2902207326,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPB