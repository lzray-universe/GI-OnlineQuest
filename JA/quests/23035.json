e":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2303504,"initDialog":230350401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1058],"performCfg":"QuestDialogue/IQ/Xumi_23035/Q2303504","priority":5,"questId":23035,"showRandomTalkCount":0},"dialogs":[{"nodeId":230350401,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":3555280418,"text":"…うん、こういうデッキも悪くないかも。","nextNodeIds":[230350402]},{"nodeId":230350402,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":2667568610,"text":"だが、このデッキだとクイックアタックに対応する能力が弱すぎるか…","nextNodeIds":[230350403]},{"nodeId":230350403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2379019090,"text":"セノ、何をしてるの？","nextNodeIds":[230350404]},{"nodeId":230350404,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":927707530,"text":"#{NICKNAME}？まさかこんなところで会えるとは。","nextNodeIds":[230350405]},{"nodeId":230350405,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":4254710474,"text":"攻撃のテンポがやや遅い「七聖召喚」のデッキを組もうとしてるんだ。","nextNodeIds":[230350406]},{"nodeId":230350406,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":3366813330,"text":"俺の予想では、こういうデッキを組むプレイヤーは豊富なリソースと、様々な強カードを持つはずだ…","nextNodeIds":[230350407]},{"nodeId":230350407,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":3606674202,"text":"でも正直、こういうデッキを組むのはなかなか難しくて…","nextNodeIds":[230350408]},{"nodeId":230350408,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":1601297634,"text":"「七聖召喚」プレイヤーの中には、攻撃のテンポが速めのデッキを使うのが好きなプレイヤーもいる。","nextNodeIds":[230350409]},{"nodeId":230350409,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":2496315242,"text":"ゲームの序盤から、一気に大量のカードで攻撃を繰り出して、高速で相手を倒すんだ。","nextNodeIds":[230350410]},{"nodeId":230350410,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":2550347570,"text":"でも、俺はこの戦術が好きじゃない。色んな方法でリソースを貯めていく戦術の方が好きだ…","nextNodeIds":[230350411]},{"nodeId":230350411,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":1411972634,"text":"あらゆるチャンスを捉えて優勢を保ち続け、最終的な勝利を掴み取る…","nextNodeIds":[230350412]},{"nodeId":230350412,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"福本","textMapHash":2594627170,"text":"そうです！まさにその通りです！よかった、本当によかった！セノさんはまさに私の小説の主人公です！","nextNodeIds":[230350413]},{"nodeId":230350413,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"福本","textMapHash":1102980386,"text":"あっ、すみません！えっと…私は…","nextNodeIds":[230350414,230350415]},{"nodeId":230350414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2759456418,"text":"こちらは福本さん。","nextNodeIds":[230350416]},{"nodeId":230350415,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1341127866,"text":"こちらは小説『召喚王』の作者。","nextNodeIds":[230350416]},{"nodeId":230350416,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"福本","textMapHash":4086520938,"text":"初めまして、大マハマトラ様。その…私のことはご存じないと思いますが…","nextNodeIds":[230350417]},{"nodeId":230350417,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":1522758850,"text":"お前の小説を読んだことがある。悪くなかったよ。","nextNodeIds":[230350418]},{"nodeId":230350418,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"福本","textMapHash":2643941874,"text":"それは、本当に光栄です！","nextNodeIds":[230350419]},{"nodeId":230350419,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":1985144930,"text":"あの小説で一番印象に残っているのは、主人公が不利になると、いつも色んな方法でデッキに存在しないカードを手に入れて相手を倒し、勝利を勝ち取るところだ。","nextNodeIds":[230350420]},{"nodeId":230350420,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":3540017146,"text":"物語作りのために必要なのだと理解はできるが、この勝ち方が「七聖召喚」というゲームの本質から外れていることは確かだ。","nextNodeIds":[230350421]},{"nodeId":230350421,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"福本","textMapHash":2379221018,"text":"あっ、それは…私もよく「七聖召喚」をプレイしているのですが、実はあまり上手ではなくて…それに、実際の競技の意識でカード対戦を書いても、いい小説にはならないでしょうから。","nextNodeIds":[230350422]},{"nodeId":230350422,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":1071082522,"text":"…そうか。ならちょうどいい、デッキを二セット組んだところなんだ。ここで「七聖召喚」を何回かやってみないか。何かヒントが得られるかもしれない。","nextNodeIds":[230350423,230350424]},{"nodeId":230350423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3151422090,"text":"（いきなりカードゲームを始めるんだ…）","nextNodeIds":[230350425]},{"nodeId":230350424,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":356604218,"text":"（ただ単にやりたくなっただけなんじゃ…）","nextNodeIds":[230350425]},{"nodeId":230350425,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"福本","textMapHash":3574861746,"text":"え？セ、セノ様とゲームをですか？もちろん喜んで。でも、実は…","nextNodeIds":[230350426,230350427]},{"nodeId":230350426,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":26098370,"text":"#{M#俺}{F#私}が説明するよ。","nextNodeIds":[]},{"nodeId":230350427,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2629247450,"text":"福本の頼み事について…","nextNodeIds":[]},{"nodeId":230350428,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":3546276378,"text":"旅人は福本の頼み事について話した…","nextNodeIds":[]},{"nodeId":230350429,"roleType":"TALK_ROLE_NPC","speakerId":1058,"speakerName":"セノ","textMapHash":3033522498,"text":"『召喚王』の挿し絵のモデルを、俺がか？それはもちろん、問題ないが。","nextNodeIds":[230350430]},{"nodeId":230350430,"roleType":"TALK_ROLE_NPC","speakerId":12717,"speakerName":"福本","textMapHash":4121263770,"text":"よかったです！旅人さん、早く、写真をいっぱい撮ってください！！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2303504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMC