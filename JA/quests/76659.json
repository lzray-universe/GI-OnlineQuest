{"mainQuestId":76659,"title":"暗闇のルール","description":"パイモンと一緒にジェネットの研究の完成を期待していたが、この研究は想像以上に多くの人や事柄と絡み合っていたようだ…","titleTextMapHash":2539708487,"descTextMapHash":456356254,"mainQuestExcel":{"mainQuestId":76659,"titleTextMapHash":2539708487,"title":"暗闇のルール","descTextMapHash":456356254,"description":"パイモンと一緒にジェネットの研究の完成を期待していたが、この研究は想像以上に多くの人や事柄と絡み合っていたようだ…","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_ALL","activityId":2042,"luaPath":"Actor/Quest/WQ76659","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":2042,"chapterId":0,"descTextMapHash":456356254,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76659,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":888635817,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76659","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176659],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2539708487,"type":"WQ","unlockDescTextMapHash":739148838}},"flow":[{"subQuestId":7665901,"order":1,"stepDescription":"ジェネットから話を聞く","stepDescTextMapHash":1199721052,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7665901],"talks":[{"talkId":7665901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7665901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7665901,"initDialog":766590101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1312,7016,7048,7053],"performCfg":"QuestDialogue/EQ/V6.0ActivityNodKraiTour_76659/Q7665901","priority":5,"questId":76659,"showRandomTalkCount":0},"dialogs":[{"nodeId":766590101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":444806146,"text":"そういえば、あのロボットたちが直った後、どうなったのかまだ見てないよな。ジェネットのところに行ってみようぜ！","nextNodeIds":[766590102]},{"nodeId":766590102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":519507186,"text":"ん？なにかあったみたいだぞ。","nextNodeIds":[766590103]},{"nodeId":766590103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3834380482,"text":"みんな集まってどうしたんだ？ゴウデンティがなにかしたのか…？","nextNodeIds":[766590104]},{"nodeId":766590104,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":1591890690,"text":"この人、私が開発したロボットを盗もうとしたのよ。イネファとサリーン先輩が気づいてくれてなかったら…","nextNodeIds":[766590105]},{"nodeId":766590105,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"ゴウデンティ","textMapHash":2867386610,"text":"盗むだと？俺はただ投資する価値があるか調べてようとしただけだ。","nextNodeIds":[766590106]},{"nodeId":766590106,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":2837963554,"text":"貴方が前科者だという事実を鑑みれば、今の発言に説得力がないことが分かります。","nextNodeIds":[766590107]},{"nodeId":766590107,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"ゴウデンティ","textMapHash":408097562,"text":"前科？なんの話だ…","nextNodeIds":[766590108]},{"nodeId":766590108,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":2111564746,"text":"アイノは工房のすべてを大切にしています。そのため、映像装置を使って完璧な監視システムを構築しました。","nextNodeIds":[766590109]},{"nodeId":766590109,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":2609047282,"text":"部外者が監視カメラを避けて工房から物を盗むなんて、内部からの支援がない限り不可能です。","nextNodeIds":[766590110]},{"nodeId":766590110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":135092882,"text":"まさか…！","nextNodeIds":[766590111]},{"nodeId":766590111,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":826951146,"text":"留守番している間、工房の隅々まで細かく調べました。そして、人為的に壊された複数の映像装置を発見しました。","nextNodeIds":[766590112]},{"nodeId":766590112,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":1677856970,"text":"アイノに直してもらって、映像を復旧したところ、ゴウデンティがその支援者であることが判明しました。","nextNodeIds":[766590113]},{"nodeId":766590113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2428550882,"text":"あの闇市のカウンターのやつと組んでたのか！？","nextNodeIds":[766590114]},{"nodeId":766590114,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":3841345538,"text":"#{NICKNAME}さんとパイモンは最後のロボットを探している時に襲われましたよね？その人たちも、彼と関係があるのかもしれません。","nextNodeIds":[766590115]},{"nodeId":766590115,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"ゴウデンティ","textMapHash":1380182794,"text":"お…俺はクーヴァキ実験設計局から派遣された代表だぞ！勝手に触るんじゃねぇ！","nextNodeIds":[766590116]},{"nodeId":766590116,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":3061348762,"text":"私があなたの正体を知らないとでも？あなたが代表なわけありません。","nextNodeIds":[766590117]},{"nodeId":766590117,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":3519017706,"text":"この人は昔、冒険者協会のメンバーでした。ですが、非行を繰り返したため除名され、賞金稼ぎに転身したんです。","nextNodeIds":[766590118]},{"nodeId":766590118,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":3368329354,"text":"噂によると、自分の態度を正すことなく悪事を働くせいで、ヴォイニッチ商会の認証を得られなかったようです。なので、日に当たらないような仕事をやっているんでしょうね。","nextNodeIds":[766590119]},{"nodeId":766590119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3838488322,"text":"そうだったのか！最初から詐欺師っぽいと思ってたぞ！こいつをどうするんだ？","nextNodeIds":[766590120]},{"nodeId":766590120,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":2109349362,"text":"悪いが、その人は私に任せてくれないか？","nextNodeIds":[766590121]},{"nodeId":766590121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2539831634,"text":"えっと…あっ、おまえこの前、闇市で会った商人！","nextNodeIds":[766590122]},{"nodeId":766590122,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":2745423018,"text":"実は、私とその賞金稼ぎの間にはちょっとした債務トラブルがあるんだ。それに、私の債務処理担当者から、彼は何日も前から工房の所有地に隠れていたことを聞かされた。","nextNodeIds":[766590123]},{"nodeId":766590123,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":185091010,"text":"工房の主への敬意から、担当者はこの借金をあえて回収しなかった。そこで私が直接足を運び、できるだけ穏やかな形で交渉を試みようと考えたんだ。","nextNodeIds":[766590124]},{"nodeId":766590124,"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"ゴウデンティ","textMapHash":3813399426,"text":"アシッコさん、助けてくれ！俺がこんなことをしたのも、お前から借りたモラを返すためなんだ！","nextNodeIds":[766590125]},{"nodeId":766590125,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1511474034,"text":"ゴウデンティさん、もし私が君を助けたくないと思っていたら、クーヴァキ実験設計局の外注仕事を代わりに引き受けて、君に渡すわけないだろう？それも、君の散々な評判を無視してまでね。","nextNodeIds":[766590126]},{"nodeId":766590126,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":2791617770,"text":"あきれたものだ…良い機会だったのに、この仕事を完遂できる能力がないとは思わなかったよ。そのうえ、工房の主の手を焼かせるだなんて…","nextNodeIds":[766590127]},{"nodeId":766590127,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":2680385482,"text":"しかも、雇用主の要求を無視し、廃棄処分するはずの偵察ユニットを大量に闇市に流すとは…君の債務返済能力を評価し直す必要があるようだな。","nextNodeIds":[766590128]},{"nodeId":766590128,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":223878298,"text":"今までの情報を整理すると、貴方は自身の影響を揉み消そうとしているように見えます。","nextNodeIds":[766590129]},{"nodeId":766590129,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1575654938,"text":"どういう意味だ？","nextNodeIds":[766590130]},{"nodeId":766590130,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":2238111722,"text":"貴方は以前、アイノの作品を高額で買い取ると発表しましたね。あまりに高額な報酬は人々に強い影響を与えます。","nextNodeIds":[766590131]},{"nodeId":766590131,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":2597845922,"text":"そのため、私はとある推測をしました。こちらの賞金稼ぎの行動も、あのカウンターの管理人の行動も、本質的にはあの募集に「影響された」と言えます。","nextNodeIds":[766590132]},{"nodeId":766590132,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":425070418,"text":"ずいぶんと酷いことを言うじゃないか、ロボットのお嬢ちゃん。最初から最後まで、私は二つのことしかやっていないよ。","nextNodeIds":[766590133]},{"nodeId":766590133,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":295427274,"text":"一つ、アイノの技術に対する賛辞を示した。二つ、自分の財力を以ってその技術の商業的価値を担保した。","nextNodeIds":[766590134]},{"nodeId":766590134,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1227355354,"text":"誰かが自身の欲望のために常軌を逸した行動に出たとしても、その責任は彼ら自身が負うべきだよ。","nextNodeIds":[766590135]},{"nodeId":766590135,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":3528888314,"text":"確かに、貴方がこの二人を裏で操っていたという証拠は、私のもとにはありません。そのため、論理的な反論もできません。ですが、論理よりも大事なことがあります。","nextNodeIds":[766590136]},{"nodeId":766590136,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":1434465754,"text":"とにかく、あの募集を取り消していただきたいのです。アイノはロボットの仲間たちをとても大切にしています。どの個体も値段をつけられるべきではありません。","nextNodeIds":[766590137]},{"nodeId":766590137,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1112623066,"text":"ふむ、その件についてだが…私の情報提供者によると、あの機械たちの本質は、とても…子供心に満ちたもので、私のような大人が興味を持つようなものではないらしい。","nextNodeIds":[766590138]},{"nodeId":766590138,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":3094117098,"text":"だが、これまで投資した分の資金は、他の形で補填してもらう予定だ。そのため、予備プランを用意した——","nextNodeIds":[766590139]},{"nodeId":766590139,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1917128090,"text":"フォンテーヌよりいらっしゃったこちらのエンジニアさんですが…まさか工房の主以外にもこのような作品を作れる人がいるとは思わなかった。君の才能を私は高く評価している。どうだろう、私と提携しないか？","nextNodeIds":[766590140]},{"nodeId":766590140,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":3087914362,"text":"え、えっ？私と？","nextNodeIds":[766590141]},{"nodeId":766590141,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1532981306,"text":"もし私が手に入れた情報が正しければ、君の作品は偶然にも完璧な商品としての可能性を秘めているはずだ。違うかな？","nextNodeIds":[766590142]},{"nodeId":766590142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3208239042,"text":"それって、あのロボットたちが少し前に手にした戦闘能力のことか？","nextNodeIds":[766590143]},{"nodeId":766590143,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":2331541970,"text":"ええと…申し訳ございません。私の作品もあなたが言ったように「子供心」に満ちているので、興味を引くことはないと思います。","nextNodeIds":[766590144]},{"nodeId":766590144,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1996827810,"text":"ほう？","nextNodeIds":[766590145]},{"nodeId":766590145,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":1397919474,"text":"私がこの子たちを作ったのは、クーヴァキを使った兵器にするためではないわ。","nextNodeIds":[766590146]},{"nodeId":766590146,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":1793768778,"text":"本来の目的は、クーヴァキの相互作用能力を利用して、ある程度の知能を生み出すことよ。","nextNodeIds":[766590147]},{"nodeId":766590147,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":3459404626,"text":"そしてテストをしているうちに、私が設計したシステムにおいて、クーヴァキは「ロジック」ではなく、「感情」に似ていることに気づいたの。","nextNodeIds":[766590148]},{"nodeId":766590148,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":3761562946,"text":"だから、緻密に作ろうとすればするほど、故障しやすかったのよ。","nextNodeIds":[766590149]},{"nodeId":766590149,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":2610561042,"text":"でも、ロボットに十分な数の仲間を用意して、思いっきり遊ばせてあげれば、逆にシステムはスムーズに動く。","nextNodeIds":[766590150]},{"nodeId":766590150,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":3440554714,"text":"#この子たちの戦闘能力が目覚めたのも、元を辿れば{NICKNAME}という大好きな遊び相手を守りたかったからなのよ。","nextNodeIds":[766590151]},{"nodeId":766590151,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":3136352658,"text":"まるで子供でしょう？だから、あなたの望むような兵器にはならないわ。子供は命令に従わない生き物よ。","nextNodeIds":[766590152]},{"nodeId":766590152,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":3222554642,"text":"ふむ…少なくとも、可能性があるとは思わないか？厳しい訓練さえ積めば兵士になれるだろう。","nextNodeIds":[766590153]},{"nodeId":766590153,"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","textMapHash":1187070130,"text":"ちょっと…","nextNodeIds":[766590154]},{"nodeId":766590154,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":919134666,"text":"できるもんならやってみる？","nextNodeIds":[766590155]},{"nodeId":766590155,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":910338194,"text":"アイノさんとジェネットさんの研究は、ナド・クライの冒険者協会に多大な貢献をしています。不要なトラブルは起こさないほうが賢明ですよ。","nextNodeIds":[766590156]},{"nodeId":766590156,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":834403658,"text":"もし何かあったら、冒険者協会も必ず介入しますので。","nextNodeIds":[766590157]},{"nodeId":766590157,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":1163670770,"text":"冒険者協会…君たちが先にここに目をつけたのか？まあいい、商売は商売だ。面倒なトラブルは避けたい。","nextNodeIds":[766590158]},{"nodeId":766590158,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":3196169452,"text":"では、こちらのロボットさんの要求通り、お二人の作品には商業的な勧誘をしないと約束しよう。","nextNodeIds":[766590159]},{"nodeId":766590159,"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","textMapHash":2532192890,"text":"代わりに、この賞金稼ぎを連れて行かせてもらう。彼には私の損失を埋めてもらわないと。","nextNodeIds":[766590160]},{"nodeId":766590160,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":3158989410,"text":"…いいですよ、どうぞ連れて行ってください。","nextNodeIds":[766590161]},{"nodeId":766590161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1750508978,"text":"イネファ、本当にいいのか？あいつを庇おうとしてるのかもしれないぞ？","nextNodeIds":[766590162]},{"nodeId":766590162,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":2604160682,"text":"ナド・クライには暗黙の了解があります。私はこういったルールに同意しかねますが、それを破った影響でアイノの生活が脅かされるのは容認できません。","nextNodeIds":[766590163]},{"nodeId":766590163,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":2660283578,"text":"ここには工房の外に締め出しておいたほうがいい物事が、たくさんあるのです。","nextNodeIds":[766590164]},{"nodeId":766590164,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":423467978,"text":"そうなのか…わかったぞ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7665901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7048"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7665901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":15543,"speakerName":"アシッコ","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":7048,"speakerName":"ジェネット","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":7053,"speakerName":"ゴウデンティ","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[176659],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":456356254,"CHECNJEMEFE":{"1312":[1120],"7016":[1230],"7048":[1060],"7053":[1283]},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC