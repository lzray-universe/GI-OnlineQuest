oadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7104602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":7104602,"initDialog":710460201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2151],"performCfg":"QuestDialogue/WQ/Liyue_71046/Q7104602","priority":5,"questId":71046,"showRandomTalkCount":0},"dialogs":[{"nodeId":710460201,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":859874450,"text":"待ってくれ！層岩巨淵は禁止区域だから、旅人は…きっ、君は！","nextNodeIds":[710460202]},{"nodeId":710460202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":308280658,"text":"しまった、逃げるぞ！","nextNodeIds":[710460203,710460204,710460205]},{"nodeId":710460203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4012986970,"text":"パイモン、騒がない。","nextNodeIds":[710460206]},{"nodeId":710460206,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":4082501370,"text":"ははははっ…すまん、驚かせてしまったようだな。命の恩人を忘れるわけがない！","nextNodeIds":[710460207]},{"nodeId":710460207,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":2186190954,"text":"俺もここ最近、護衛に来たんだが…まさかここで恩人に出会えるとは、なんて巡り合わせなんだ。","nextNodeIds":[710460208]},{"nodeId":710460208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":175897450,"text":"恩人…？オイラたち、なにかいいことしたのか？","nextNodeIds":[710460209]},{"nodeId":710460209,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":3487415642,"text":"何を言うんだ！みなが海中の魔物と戦っていた時、俺も群玉閣にいたんだ。ちょっとした傷を負ってな…この間治ったばかりだ。","nextNodeIds":[710460210]},{"nodeId":710460210,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":3658357602,"text":"君は俺を覚えてないかもしれんが、俺は君のことを忘れない。共に戦った仲間たちも、みんな璃月に傾けてくれた努力を見届けたんだ。","nextNodeIds":[710460211]},{"nodeId":710460211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":405905530,"text":"層岩巨淵について…","nextNodeIds":[710460212]},{"nodeId":710460212,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":2688910274,"text":"二年前、鉱洞で原因不明の事故があって、七星によって封鎖されたんだ。幸い、鉱夫たちはほぼ全員無事に避難できたが…","nextNodeIds":[710460213]},{"nodeId":710460213,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":2978982554,"text":"ただ、残念なことに、こんなに大きなところが閉山して生産停止になるとな。労働者たちも補助金を使って、別の方法で生計を立て始めた…はぁ、一度散り散りになってしまうと、なかなか再会できなくなるよな。","nextNodeIds":[710460214]},{"nodeId":710460214,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":281619954,"text":"あっ、すまん、話題がずれた。ここに来るのは用事があってのことだろう。引き留めはしない。もし何かあったら、沐寧に直接会いに行くといい。彼は入り口の拠点にいるから。","nextNodeIds":[710460215]},{"nodeId":710460215,"roleType":"TALK_ROLE_NPC","speakerId":2151,"speakerName":"鉄弘","textMapHash":1167848010,"text":"えっと…君を信用しないわけじゃないが、これが俺の責務でな。——もう聞き飽きたかもしれないが、ここで違法なことをしないようにな！","nextNodeIds":[710460216]},{"nodeId":710460216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3069211386,"text":"安心しろ、なんたって、オイラたちなんだぜ！","nextNodeIds":[]},{"nodeId":710460204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3989286306,"text":"#{M#俺}{F#私}のこと知ってるの？","nextNodeIds":[710460206]},{"nodeId":710460205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1222473026,"text":"バレた、逃げろ！","nextNodeIds":[710460206]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7104603,"order":3,"stepDescription":"","stepDescTextMapHash":140748068,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104429,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104429,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NO