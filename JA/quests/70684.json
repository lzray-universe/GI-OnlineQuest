{"mainQuestId":70684,"title":"自由の風に向かって","description":"吟遊詩人サンサは何か悩んでいるようだ…","titleTextMapHash":2183222287,"descTextMapHash":1358592406,"mainQuestExcel":{"mainQuestId":70684,"titleTextMapHash":2183222287,"title":"自由の風に向かって","descTextMapHash":1358592406,"description":"吟遊詩人サンサは何か悩んでいるようだ…","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ70684","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":1358592406,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70684,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3616357553,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70684","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170684],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2183222287,"type":"WQ","unlockDescTextMapHash":3621775238}},"flow":[{"subQuestId":7068401,"order":1,"stepDescription":"サンサと会話する","stepDescTextMapHash":128431532,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7068401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1645"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7068401],"talks":[{"talkId":7068401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7068401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7068401,"initDialog":706840101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1645],"performCfg":"QuestDialogue/WQ/MusicGame_70684/Q7068401","priority":5,"questId":70684,"showRandomTalkCount":0},"dialogs":[{"nodeId":706840101,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1291948418,"text":"こ、こんにちは！わ、私は…サンサ。吟遊詩人を目指してるの。きょ…今日は私の演奏を聴きに来てくれて、ありがとう。そ、それじゃあ、始めるね。","nextNodeIds":[706840102]},{"nodeId":706840102,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":2241090554,"text":"「星拾いの崖の頂上は、一切が静まりかえっている。ど、ど、どの梢にも…」あっ…またやっちゃった。","nextNodeIds":[706840103]},{"nodeId":706840103,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3783909586,"text":"「どの梢にも、小鳥の姿は見えず、風の音もき、聞こえない…」次は、えっと…「あ、足を止めてひと休みしよう…」","nextNodeIds":[706840104]},{"nodeId":706840104,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":2492481074,"text":"うまく歌えなくてごめんなさい…四十二回目と九十回目はどもらなかったのに、なんでダメだったんだろう？","nextNodeIds":[706840105]},{"nodeId":706840105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2307946130,"text":"四十二回目と九十回目…？","nextNodeIds":[706840106]},{"nodeId":706840106,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3510883370,"text":"うん！みんなに完璧な演奏を聴いてもらいたくて、百回練習したんだよ。だから、今ので百一回目。今日が初めての公演だったの…","nextNodeIds":[706840107]},{"nodeId":706840107,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":950069394,"text":"はぁ、うまくいくと思ったのに…準備が足りなかったのかも。四十二回目や九十回目と何が違ったのかよく振り返って、もっともっと練習しないと…","nextNodeIds":[706840108,706840109]},{"nodeId":706840108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1099735450,"text":"百回だって十分多いよ。","nextNodeIds":[706840110]},{"nodeId":706840110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1158106810,"text":"そうそう！そんなに練習したのに、さっきみたいになっちゃうってことは…練習の仕方に問題があるんじゃないか？","nextNodeIds":[706840111]},{"nodeId":706840111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2805689762,"text":"実は、こいつもそこそこ演奏できるんだ。いつもどうやって練習してるか教えてくれないか？なにかアドバイスできるかもしれないぜ。","nextNodeIds":[706840112,706840113]},{"nodeId":706840112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4216253146,"text":"少しかじった程度だけどね。","nextNodeIds":[706840114]},{"nodeId":706840114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3427237170,"text":"そしてオイラは…プロの観客だ！観客の目線でプロフェッショナルなアドバイスをしてやるぜ！","nextNodeIds":[706840115]},{"nodeId":706840115,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1369658946,"text":"うぅ…私なんかのために…本当にありがとう！ノートに書いてあるから、ちょっと待っててね！あ、直接見せたほうが早いかな？","nextNodeIds":[706840116]},{"nodeId":706840116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2227279378,"text":"ん？ノート？","nextNodeIds":[706840117]},{"nodeId":706840117,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1368553954,"text":"練習するときはいつもメモを取ってるの。注意点とか直したほうがいいところとかね…あ、後ろのページにあるのは他の人の演奏を聴いたり、他の楽器を試したりしたときの感想だから、あまり気にしないで…","nextNodeIds":[706840118]},{"nodeId":706840118,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1449631322,"text":"表紙のくたびれたノートには、サンサの言った通り、練習時のメモが書き込まれている。後半の「感想」はさらに膨大で、むしろ論文のようになっていた…","nextNodeIds":[706840119]},{"nodeId":706840119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1234255010,"text":"うわっ、モンドの図書館にある百科事典より分厚いぞ！サンサって音楽の研究家とかコレクターなのか？いや、もしかして図書館司書？","nextNodeIds":[706840120]},{"nodeId":706840120,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3677961234,"text":"えへへっ、両親は私に学者になってほしいみたい。それで、こんな勉強方法を身につけさせられたんだ。今は…吟遊詩人になるために活用してるけどね。","nextNodeIds":[706840121]},{"nodeId":706840121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2267693970,"text":"何か間違ってるような…","nextNodeIds":[706840122]},{"nodeId":706840122,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1232069666,"text":"先生、どこが良くないと思う？音楽への理解？それとも練習の仕方？","nextNodeIds":[706840123,706840124]},{"nodeId":706840123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":888250738,"text":"#{M#俺}{F#私}の知識じゃ指導役は無理…","nextNodeIds":[706840125]},{"nodeId":706840125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":317679194,"text":"その…吟遊詩人になるのってそんなに難しいことなのか？うーん…吟遊野郎が演奏してるときって、いつも緊張とは無縁って感じがしてるけど…","nextNodeIds":[706840126]},{"nodeId":706840126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2762889298,"text":"でも、楽器も歌もうまいってことは、やっぱり見えないところで努力してるのかな…？","nextNodeIds":[706840127]},{"nodeId":706840127,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":345356226,"text":"ヤッホー、旅人。もしかしてボクを探してる？","nextNodeIds":[706840128]},{"nodeId":706840128,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":2509277730,"text":"ウェ、ウェンティさま！","nextNodeIds":[706840129]},{"nodeId":706840129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4102002258,"text":"うわっ！ビ、ビックリしたぞ！なんでここにいるんだ、吟遊野郎！","nextNodeIds":[706840130]},{"nodeId":706840130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1463871010,"text":"今日はまた、どういう風の吹き回し？","nextNodeIds":[706840131]},{"nodeId":706840131,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1285532682,"text":"それはもちろん、異郷の花の香りと想いをたっぷり乗せた「風」だよ。","nextNodeIds":[706840132]},{"nodeId":706840132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":72391698,"text":"また適当なこと言ってるぞ…","nextNodeIds":[706840133]},{"nodeId":706840133,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3031611938,"text":"ヘヘッ、さっき散歩してたら、アイデアが降ってきたんだ。木から落ちたリンゴが頭にぶつかるみたいにね。だから、頭に浮かんだ詩を葉っぱに書いてたんだけど…","nextNodeIds":[706840134]},{"nodeId":706840134,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2048281210,"text":"まだ書き終わってないのに「ヒュー」って音がしてね…","nextNodeIds":[706840135]},{"nodeId":706840135,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1480018362,"text":"「ヒュー」？","nextNodeIds":[706840136]},{"nodeId":706840136,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3132252442,"text":"やんちゃな風がボクの最初の読者になりたいって、葉っぱを持って行っちゃったんだ。追いかけようとすると、今度は黒い影が目の前に出てきて、葉っぱをくわえて行っちゃってさ。","nextNodeIds":[706840137]},{"nodeId":706840137,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1817937978,"text":"おかげでくしゃみを何度もしたよ…そうしてる間に二番目の読者はあっという間にどこかへ行っちゃってね。","nextNodeIds":[706840138]},{"nodeId":706840138,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2878924514,"text":"うぅ…思い出すだけで鼻がムズムズしてくる。","nextNodeIds":[706840139]},{"nodeId":706840139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":484442026,"text":"うーん、葉っぱをくわえて逃げたのって、もしかして猫か？おまえ一人で猫を捕まえるのは無理だと思うぞ…","nextNodeIds":[706840140,706840141]},{"nodeId":706840140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2582702666,"text":"手伝うよ。","nextNodeIds":[706840142]},{"nodeId":706840142,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1900198690,"text":"私にも手伝わせて！ウェンティさまの歌と演奏にずっと憧れてたの！もしお力になれるならすっごく嬉しい！","nextNodeIds":[706840143]},{"nodeId":706840143,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1324935674,"text":"そ、その…もし新作を取り戻せたら、詩の書き方についていくつか聞いてもいいかな？","nextNodeIds":[706840144]},{"nodeId":706840144,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3771882362,"text":"ごめんなさい！急なお願いだってことは分かってるけど今言わないと言う勇気すらなくなっちゃうと思って！！！","nextNodeIds":[706840145]},{"nodeId":706840145,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2455007138,"text":"あははっ、もちろんいいよ。目の前に立ちふさがる壁は葉脈みたいなもので、インスピレーションっていう養分を運んできてくれるんだ。養分が届いたら、すぐに捕まえておかないとね。","nextNodeIds":[706840146]},{"nodeId":706840146,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3776693146,"text":"何でも聞いて。全部答えてあげる。今からでもいいよ。","nextNodeIds":[706840147]},{"nodeId":706840147,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1710232306,"text":"ほ、ほんとに！？ノート、ノート…どこやったっけ？あっ、あった…！ちょっと待ってて！","nextNodeIds":[706840148]},{"nodeId":706840148,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3059329906,"text":"サンサは素早くページをめくって「質問」の箇所を開くと、深く息を吸い込み、これまでの勉強や練習のこと、ぶつかった問題について話し始めた…","nextNodeIds":[706840149]},{"nodeId":706840149,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2803404074,"text":"なるほど…聞いた感じじゃ、理論、実践の両方とも十分だと思うよ。ボクのアドバイスなんてなくても平気なんじゃないかな？","nextNodeIds":[706840150]},{"nodeId":706840150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3080013778,"text":"でも、どんだけ頑張っても公演がうまくいかないんだぞ？なにか原因があるはずだろ？","nextNodeIds":[706840151]},{"nodeId":706840151,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":2463584978,"text":"きっと才能がないんだよ…私、吟遊詩人に向いてないのかもね。あはは…","nextNodeIds":[706840152]},{"nodeId":706840152,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3161351482,"text":"君はどうして吟遊詩人になろうと思ったんだい？","nextNodeIds":[706840153]},{"nodeId":706840153,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3688331146,"text":"どうして…憧れてたから、かな。昔、両親の言いつけで部屋にこもって勉強してたの。その時、窓の外から吟遊詩人の歌声が聞こえてきて…","nextNodeIds":[706840154]},{"nodeId":706840154,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":563010546,"text":"美しい歌声とメロディーはそよ風みたいに心を満たしてくれた…吟遊詩人になったら、私もあの人みたいになれるかなって思ったの。","nextNodeIds":[706840155]},{"nodeId":706840155,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":23349922,"text":"あんな風に自由に、楽しく生きてみたい。それでその喜びをみんなと分かち合えたらって…","nextNodeIds":[706840156]},{"nodeId":706840156,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":2906836490,"text":"でも、いざみんなの前に立つとどうしようもなく緊張しちゃって。失敗しないようにたくさん練習したのに、本番になるとどもっちゃうし…","nextNodeIds":[706840157]},{"nodeId":706840157,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1018562778,"text":"君は立派な詩人だと思うよ。","nextNodeIds":[706840158]},{"nodeId":706840158,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3714111434,"text":"えっ？で、でも私…歌も満足に歌えないのに…","nextNodeIds":[706840159]},{"nodeId":706840159,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":583667346,"text":"さっき、自由に楽しく生きるために吟遊詩人になりたいって言ったでしょ？","nextNodeIds":[706840160]},{"nodeId":706840160,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1573919994,"text":"吟遊詩人の歌声っていうのはね、風のように、何かに縛られることなく、どこまでも響くものなんだ。じゃないと、君があの日部屋でその歌声を聞くこともなかったでしょ？","nextNodeIds":[706840161]},{"nodeId":706840161,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":205479074,"text":"君は立派な詩人だよ。ただ…雑音もたくさん聞こえちゃうせいで、発想が縛られて、動けなくなってるんだろうね。","nextNodeIds":[706840162]},{"nodeId":706840162,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2341381506,"text":"人の目は気にしなくていいよ。","nextNodeIds":[706840163]},{"nodeId":706840163,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2470916490,"text":"そうそう。自由と喜びを分かち合いたいなら、まずサンサがそうならなきゃな！","nextNodeIds":[706840164]},{"nodeId":706840164,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":733842290,"text":"おや、パイモン、吟遊詩人の素質があるみたいだね。","nextNodeIds":[706840165]},{"nodeId":706840165,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":298908330,"text":"まずは自分に自由と喜びを…そうだね、ありがとう！今教えてもらったこと、ずっと大切にするね！","nextNodeIds":[706840166]},{"nodeId":706840166,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1441734250,"text":"じゃあ、さっそく試してみようか？せっかくだし、ボクと旅人が楽器を担当するよ。","nextNodeIds":[706840167]},{"nodeId":706840167,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2792587946,"text":"喜んで。","nextNodeIds":[706840168]},{"nodeId":706840168,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1363584962,"text":"それじゃ、オイラは観客な。一番自由でプロフェッショナルな観客だ！へへっ。","nextNodeIds":[706840169]},{"nodeId":706840169,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":4206473410,"text":"ひ、ひ、人前で初めてうまく歌えた…あっ、今のは緊張じゃなくて嬉しかったから…","nextNodeIds":[706840170]},{"nodeId":706840170,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":658868994,"text":"演奏してるとき、私もそよ風になってどこまででも行けるような気がしたの…","nextNodeIds":[706840171]},{"nodeId":706840171,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2110678842,"text":"おまえの気持ちはみんなにも伝わったと思うぜ。あっ、猫もサンサの歌を聞きに来たぞ！ん？猫？","nextNodeIds":[706840172]},{"nodeId":706840172,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":931442154,"text":"おや、ボクの新作を二番目に読んだ子だね？ぜひ感想を聞かせてく…は…は…はっくしょん！","nextNodeIds":[706840173]},{"nodeId":706840173,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":1755675098,"text":"クロ！ごめんなさい。お隣さんが飼ってる子で、練習のときによく窓のところに飛び乗って観客になってくれるの…","nextNodeIds":[706840174]},{"nodeId":706840174,"roleType":"TALK_ROLE_NPC","speakerId":14966,"speakerName":"「クロ」","textMapHash":3668768802,"text":"ニャオー。","nextNodeIds":[706840175]},{"nodeId":706840175,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":889076274,"text":"クロがくわえてるそれって、詩が書かれてる葉っぱか？","nextNodeIds":[706840176]},{"nodeId":706840176,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":238534218,"text":"それはウェンティさまにとって大事なものなの。返してくれる？","nextNodeIds":[706840177]},{"nodeId":706840177,"roleType":"TALK_ROLE_NPC","speakerId":14966,"speakerName":"「クロ」","textMapHash":1551265634,"text":"ニャ！","nextNodeIds":[706840178]},{"nodeId":706840178,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3249679522,"text":"いろいろアドバイスをもらったのに、全然お返しできなくて、ごめんなさい…","nextNodeIds":[706840179]},{"nodeId":706840179,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3530766626,"text":"いいや、君のおかげで「アイデア」を取り戻せた。これで十分…は…はっくしょん！","nextNodeIds":[706840180,706840181]},{"nodeId":706840180,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1841319434,"text":"感想を聞いてみよう。","nextNodeIds":[706840182]},{"nodeId":706840182,"roleType":"TALK_ROLE_NPC","speakerId":14966,"speakerName":"「クロ」","textMapHash":62739898,"text":"ニャオ～。","nextNodeIds":[706840183]},{"nodeId":706840183,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2046789866,"text":"おや、ボクの詩が気に入ったのかい？あ、近づかないで…はっくしょん！まだ出来上がってないから、完成を楽しみにしててね！","nextNodeIds":[706840184]},{"nodeId":706840184,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":122950546,"text":"コホン、熱心な読者だね…それじゃみんな、今度ボクの歌を聴きに来てね！","nextNodeIds":[706840185]},{"nodeId":706840185,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2134524322,"text":"まったく帰るときも風みたいなやつだな…","nextNodeIds":[706840186]},{"nodeId":706840186,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":3885974650,"text":"ウェンティさま直々の指導が受けられるなんて…今度お礼をしなくちゃ…二人も本当にありがとう。","nextNodeIds":[706840187]},{"nodeId":706840187,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":522563586,"text":"ほんの気持ちだけど、よかったらこれを受け取って。私がいろんなところで集めた楽譜をまとめたものなの。いつか役に立つかも。","nextNodeIds":[706840188]},{"nodeId":706840188,"roleType":"TALK_ROLE_NPC","speakerId":1645,"speakerName":"サンサ","textMapHash":600485850,"text":"あと、楽器も色々集めてるんだ！もし弾いてみたくなったら、いつでも私のところに来てね。演奏についてもおしゃべりしよう！","nextNodeIds":[706840189]},{"nodeId":706840189,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2188500834,"text":"へへっ！じゃあ、ありがたく受け取るぜ！","nextNodeIds":[]},{"nodeId":706840181,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":769045418,"text":"この詩は好き？","nextNodeIds":[706840182]},{"nodeId":706840141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1001504074,"text":"猫に新作の感想も聞きたいし。","nextNodeIds":[706840142]},{"nodeId":706840124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2758022602,"text":"努力の方向性の問題かも。","nextNodeIds":[706840125]},{"nodeId":706840113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2801958962,"text":"意見交換する感じで。","nextNodeIds":[706840114]},{"nodeId":706840109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3022489346,"text":"回数の問題じゃないかも…","nextNodeIds":[706840110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7068401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7068401","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["3","1452"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1645"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[{"talkId":7068402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityLi