45010105]},{"nodeId":745010105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3205093514,"text":"アルボン、アルベール、リーヴァはいるか？オイラたちに用事があるそうなんだけど。","nextNodeIds":[745010106]},{"nodeId":745010106,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":3078880754,"text":"よしよし、対策が来た。","nextNodeIds":[745010107]},{"nodeId":745010107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":349066266,"text":"対策？","nextNodeIds":[745010108]},{"nodeId":745010108,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":102999026,"text":"お二人さんのことや。これも店主のアイデアなんやけど、店主は今店にいないから、やっぱり俺たちが説明させてもらうで。","nextNodeIds":[745010109]},{"nodeId":745010109,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3242338522,"text":"じゃあざっと説明するで。","nextNodeIds":[745010110]},{"nodeId":745010110,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2561112514,"text":"先日うちの店は「決闘代理人」プロジェクトを公開して、街全体に広告を打ち出したんや。","nextNodeIds":[745010138]},{"nodeId":745010138,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":1901509002,"text":"購買予約の始まりや。手付金として半額を支払えば体験優先権がゲットできるで。","nextNodeIds":[745010111]},{"nodeId":745010111,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":402643682,"text":"それから評価欄も置いた。入口にある、あの掲示板。皆が高評価を書き残せるようにな。","nextNodeIds":[745010112]},{"nodeId":745010112,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":1727953770,"text":"ああ、新商品を盛り上げるってやつや。","nextNodeIds":[745010113]},{"nodeId":745010113,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":3975841770,"text":"最初は店主の思惑通り、店は一気に盛り上がった。でも予約までしてくれる人はあまりいなくて、掲示板にも特に好評らしきコメントはなかった。","nextNodeIds":[745010114]},{"nodeId":745010114,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":2076448746,"text":"「誠意が足りない」やの「中身が貧弱」やの「時代遅れ」やの…そんなコメントだらけや。","nextNodeIds":[745010115]},{"nodeId":745010115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3144285322,"text":"どうやら市場のニーズはおまえたちが思ってたのとは違ったみたいだな！","nextNodeIds":[745010116]},{"nodeId":745010116,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2695238138,"text":"そんな単純な話とちゃうんやで。フォンテーヌにはこんな言葉がある。「火のない所に煙は立たない」ってな。","nextNodeIds":[745010117]},{"nodeId":745010117,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2166520386,"text":"つまり、誰かがデマを流してるってことや！","nextNodeIds":[745010118]},{"nodeId":745010118,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":2266015594,"text":"悪質な誹謗中傷！","nextNodeIds":[745010119]},{"nodeId":745010119,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2727587410,"text":"真っ赤なウソ！","nextNodeIds":[745010120]},{"nodeId":745010120,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":2891807266,"text":"空騒ぎ！","nextNodeIds":[745010121]},{"nodeId":745010121,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":1588613714,"text":"店主が言うには、弟が人を雇ってデマを流してるに決まってるって。「決闘代理人」プロジェクトが成功したら、一番困るのは他でもないルポート時計店やからな。","nextNodeIds":[745010122]},{"nodeId":745010122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4064933170,"text":"それでおまえたちはどうするつもりだ？まさか、オイラたちを雇ってやり返させるつもりじゃないだろうな？","nextNodeIds":[745010123]},{"nodeId":745010123,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":678544138,"text":"フリーナ様のお膝元で、そんなことを考えるなんてありえへんやろ？","nextNodeIds":[745010139]},{"nodeId":745010139,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":4253466002,"text":"なんてったって、うちの店主はカロンの兄貴や。やつらがそんな手段を使ったとしても、うちは正々堂々やつらに勝てるはずやで！","nextNodeIds":[745010124]},{"nodeId":745010124,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":200114882,"text":"その通りや。兄貴として弟を教育せんとアカンしな。","nextNodeIds":[745010125]},{"nodeId":745010125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3579186826,"text":"#じゃあ{M#俺}{F#私}たちは何をすればいい？","nextNodeIds":[745010126]},{"nodeId":745010126,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":4286283690,"text":"やつらがやつらの誠意と中身をさらけ出すようにしてやってくれ！","nextNodeIds":[745010127]},{"nodeId":745010127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1933067322,"text":"さらけ出す？","nextNodeIds":[745010128]},{"nodeId":745010128,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":1033785442,"text":"だって、そうしてもらわへんかったら公平ちゃうやろ？フォンテーヌは公平さを重んじる国やから。","nextNodeIds":[745010129]},{"nodeId":745010129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4138247786,"text":"公平さってそんな意味じゃないだろ！","nextNodeIds":[745010130]},{"nodeId":745010130,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":3734222338,"text":"店主が言うに、人々が他のところのパッケージに誠意を感じる言うんやったら、俺たちも同じことをすればいいって。","nextNodeIds":[745010131]},{"nodeId":745010131,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":1357136186,"text":"彼らが冒険者をどうパッケージングしてるか…その方法を真似て、俺たちも決闘代理人をパッケージングすればいい。それに加えて俺たちは充実したデータがある。きっと逆転勝利やで。","nextNodeIds":[745010132]},{"nodeId":745010132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1191411818,"text":"パッケージングっていうけど、あいつはただ冒険者の物語をおもちゃにしただけだろ？","nextNodeIds":[745010133]},{"nodeId":745010133,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2264966594,"text":"まさにその物語や！どんな物語か聞いてきてくれへんか？頼む、きっとその物語がパッケージングに決まっとる。","nextNodeIds":[745010134]},{"nodeId":745010134,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":1517721922,"text":"俺が小耳に挟んだ噂によると、ある日カロンが酒を飲んでた時、そのおもちゃは誰かのために作ったんやって、こぼしたんやって。","nextNodeIds":[745010135]},{"nodeId":745010135,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":3843840162,"text":"そんなことを言うくらいだから、やつとその冒険者は何かものすごい事を経験したんちゃうか？","nextNodeIds":[745010136]},{"nodeId":745010136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":434425562,"text":"#えっ！？カロンとあの冒険者が、か？どんな物語か急に知りたくなってきたぞ。{NICKNAME}、もう一度行って聞いてみないか？","nextNodeIds":[745010137]},{"nodeId":745010137,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":4141682674,"text":"#ほんまに助かるわ！マドモワゼル·パイモン、{M#サー}{F#マドモワゼル}·{NICKNAME}、頼むで！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30411"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7450102,"order":3,"stepDescription":"店主のカロンと会話する","stepDescTextMapHash":4146235212,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5024"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7450102,7450104],"talks":[{"talkId":7450102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId"