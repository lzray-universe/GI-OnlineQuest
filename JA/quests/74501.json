],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450103,"initDialog":745010301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30411,5029,30412],"performCfg":"QuestDialogue/WQ/Fontaine_74501/Q7450103","priority":5,"questId":74501,"showRandomTalkCount":0},"dialogs":[{"nodeId":745010301,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2713418386,"text":"店主、お二人さんが戻ってきたで。","nextNodeIds":[745010302]},{"nodeId":745010302,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1961217562,"text":"やっぱりお前たちは仕事が速い。今回もきっと盛りだくさんの収穫を持ってきたんだろう？","nextNodeIds":[745010303]},{"nodeId":745010303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4045319538,"text":"リーヴァ、なんでおまえは毎回遅れて出てくるんだよ？","nextNodeIds":[745010304]},{"nodeId":745010304,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":3483975802,"text":"おっと、怠慢だったな。次は絶対に真っ先に出てくると約束しよう。ふふ、それであのおもちゃについては…","nextNodeIds":[745010305]},{"nodeId":745010305,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":4176592058,"text":"ベネットの物語をリーヴァに伝えると、彼は眉間に皺を寄せた。","nextNodeIds":[745010306]},{"nodeId":745010306,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2310402626,"text":"ベネットという冒険者のために作ったおもちゃだと？なるほどな…","nextNodeIds":[745010307]},{"nodeId":745010307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":485182298,"text":"リーヴァ、それから、あいつに聞いちゃいないけどさ、オイラはおまえの弟がおまえの店のデマを流したとは思えないし、そんなマネするようなやつとは思えないぞ。","nextNodeIds":[745010308]},{"nodeId":745010308,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1012818234,"text":"ほう？それで？","nextNodeIds":[745010309]},{"nodeId":745010309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4040706682,"text":"彼はリーヴァに申し訳なく思ってるみたい。","nextNodeIds":[745010310]},{"nodeId":745010310,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":4103319026,"text":"カロンから聞いた話を伝えると、リーヴァの目線は少しずつあなたたちをすり抜けていき、まるで焦点を合わせる写真機のように、どことなく遠くへと向けられた。","nextNodeIds":[745010311]},{"nodeId":745010311,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1697599026,"text":"そして…しばらくすると、不満げな声を小さく漏らした。","nextNodeIds":[745010312]},{"nodeId":745010312,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":3056116354,"text":"ふん…","nextNodeIds":[745010313]},{"nodeId":745010313,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2841990906,"text":"正直に言うと、俺もあいつがそんなことをするとは思っていなかった…","nextNodeIds":[745010314]},{"nodeId":745010314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3090544290,"text":"なんだよ、だったらなんで対策とやらを講じたんだよ？","nextNodeIds":[745010315]},{"nodeId":745010315,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":4045771906,"text":"店主は言い訳がほしかったんや。自分に逃げ道を用意して、ついでにあの物語について調べたかったんや。","nextNodeIds":[745010316]},{"nodeId":745010316,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3714753714,"text":"俺も大方同じ見解やで。","nextNodeIds":[745010317]},{"nodeId":745010317,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":366219794,"text":"商売をする者にとっては、メンツが大事やからな。","nextNodeIds":[745010318]},{"nodeId":745010318,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3184128554,"text":"しかも兄貴やし、余計にメンツが大事になってくるやろ？","nextNodeIds":[745010319]},{"nodeId":745010319,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":880605410,"text":"これ以上一言でも喋ったら、一発でぶっ飛ばすぞ。","nextNodeIds":[745010320]},{"nodeId":745010320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1614912154,"text":"リーヴァって、ホントにカロンの言ってた通りだな。","nextNodeIds":[745010321]},{"nodeId":745010321,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1719094114,"text":"お客さんたちよ…たった今思いついたんだが、私もそろそろあいつに会ってみるべきかな。","nextNodeIds":[745010322]},{"nodeId":745010322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3513080938,"text":"わあ！じゃあようやく兄貴としてのプライドを捨てて、謙虚に弟に教えを乞うってことか？","nextNodeIds":[745010323]},{"nodeId":745010323,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1439782946,"text":"そんなわけないだろう。私はただ、あいつに面と向かって私に謝る機会を与えてやろうとしてるんだ。あいつも私を裏切ったと思ってるんだろう？私に申し訳ないと思ってるんじゃなかったか？","nextNodeIds":[745010324]},{"nodeId":745010324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3018930274,"text":"うぅ…たしかにそうは言ったけど…でも謝らなきゃいけないような裏切りじゃない気が…","nextNodeIds":[745010325]},{"nodeId":745010325,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2842107346,"text":"ふん…とりあえず決まりだな。アルボン、購買予約の受付は中止だ。手付金も返金すべき分は返金しろ。掲示板も一旦撤収だ。","nextNodeIds":[745010326]},{"nodeId":745010326,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":332256218,"text":"何やて？店主！プロジェクトを取りやめるってことか？じゃこの先のデータ収集はどうするんや？","nextNodeIds":[745010327]},{"nodeId":745010327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3767740602,"text":"実はまだ調整の余地がある。","nextNodeIds":[745010328]},{"nodeId":745010328,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":3935783618,"text":"いや、データ収集は続ける。別の考えがあるんだ。それにせめてお前たちへの報酬はきちんと払わないとだろう？私は商売において、必ず信用を守るからな。","nextNodeIds":[745010329]},{"nodeId":745010329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4117909234,"text":"うっ、こんなところに信用を持ち出してきたぜ！","nextNodeIds":[745010343]},{"nodeId":745010343,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3514587786,"text":"さすがは店主。我がまま言うときでさえ店主らしいな。","nextNodeIds":[745010330]},{"nodeId":745010330,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1059399666,"text":"ふん、あいつのおもちゃに対する態度も、捨てたもんじゃないかもな。","nextNodeIds":[745010331]},{"nodeId":745010331,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1565375938,"text":"数日後、データ収集が終わったら、あいつのルポート時計店を訪ねてみよう。もしよかったら、当日はお前たちにも来てもらいたい。","nextNodeIds":[745010344]},{"nodeId":745010344,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":4271762442,"text":"今日はちょっと店のことがあるので、先に失礼させてもらう。","nextNodeIds":[745010345]},{"nodeId":745010345,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":932495602,"text":"リーヴァはきびすを返して店に入っていった。","nextNodeIds":[745010332]},{"nodeId":745010332,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1938847490,"text":"お、おう…。リーヴァってホントに変なやつだな…まさか本当に謝ってもらうつもりじゃないだろうな？","nextNodeIds":[745010333]},{"nodeId":745010333,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2066410370,"text":"おやおや、どうやら、今回もまた第三者によって転機が訪れたみたいやな。","nextNodeIds":[745010334]},{"nodeId":745010334,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3214635026,"text":"ん？第三者？","nextNodeIds":[745010335]},{"nodeId":745010335,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":3769523986,"text":"お二人さんのことや。君たちが来てくれたお陰で、リーヴァ店主とカロンの間にあるわだかまりが溶ける兆しが現れたんや。前もそうやったんやで。","nextNodeIds":[745010336]},{"nodeId":745010336,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3773294514,"text":"前もそうだった？","nextNodeIds":[745010337]},{"nodeId":745010337,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":1525523674,"text":"そうや。君たち気づいたか？うちの店とルポート時計店は北国銀行を挟む形になってるやろ？","nextNodeIds":[745010346]},{"nodeId":745010346,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":4067956858,"text":"実は店主は当初、ルポート時計店の隣に店を構えて、バッチバチの競争を繰り広げるつもりやったんやで。","nextNodeIds":[745010338]},{"nodeId":745010338,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3689669898,"text":"その場所は元々、北国銀行によって抑えられてしまってたんやで。北国銀行は店主のことを知らなかっただろうけど、ある意味、仲裁役を務めた第三者やって言えるんちゃうか？","nextNodeIds":[745010339]},{"nodeId":745010339,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1740627266,"text":"それは面白いな。ファデュイって他人の事に首を突っ込むのが大好きだけど、そんな形での首の突っ込み方はたぶん初めてなんじゃないか？","nextNodeIds":[745010340]},{"nodeId":745010340,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":2756118514,"text":"だから、第三者は大事だって話や。コントには観客が一人は必要なのと同じぐらい大事なんや。","nextNodeIds":[745010341]},{"nodeId":745010341,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":4215782058,"text":"じゃ、一人コントはどうなんや？演者一人に観客が一人いればええやろ？","nextNodeIds":[745010342]},{"nodeId":745010342,"roleType":"TALK_ROLE_NPC","speakerId":30411,"speakerName":"アルボン","textMapHash":1990992674,"text":"なんの話や？君も俺を裏切ろうとしてるんか？一発でぶっ飛ばされたいんか？","nextNodeIds":[]}]},{"talkId":7450105,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"