ONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166701,"initDialog":716670101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30547],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_71667/Q7166701","priority":5,"questId":71667,"showRandomTalkCount":0},"dialogs":[{"nodeId":716670101,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":1125281546,"text":"ああ。二人とも、待ってたよ。","nextNodeIds":[716670102]},{"nodeId":716670102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2301761818,"text":"爆炎樹と友達になれた？","nextNodeIds":[716670103]},{"nodeId":716670103,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":4014011018,"text":"はぁ、本当に大変だったよ。君の「交涉」のおかげで、あいつは大人しくなってくれたが、それもほんのちょっとの間だけでね…","nextNodeIds":[716670104]},{"nodeId":716670104,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":3397573474,"text":"元気を取り戻した途端、すぐにまた私を死に追いやろうとしてきた。本当に怖かったよ…。どうやら、君たちのほうが正しかったようだ。爆炎樹と友達になるのは、やはり無理がある。","nextNodeIds":[716670105]},{"nodeId":716670105,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":2972809370,"text":"あっ！でも爆炎樹の実は、なかなか美味かったぞ。炎元素の味がするんだ。これならナタの友人たちも気に入ってくれるはずだ！","nextNodeIds":[716670106]},{"nodeId":716670106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2975621418,"text":"どんな味がするんだ？まったく想像がつかないけど…","nextNodeIds":[716670107]},{"nodeId":716670107,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":2453871874,"text":"食べてみるか？食べたいなら今から…","nextNodeIds":[716670108]},{"nodeId":716670108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3487021770,"text":"い、いやいや、いいぞ！…で、次はエンシェントヴィシャップに挑戦しに行くんだよな？","nextNodeIds":[716670109]},{"nodeId":716670109,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":3784472266,"text":"ああ。今回は行けそうな気がするんだ。なにせ、エンシェントヴィシャップは、テペトル竜とかなり似てるからね。","nextNodeIds":[716670110]},{"nodeId":716670110,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":3696187026,"text":"私みたいにスメールからナタに行く場合、その道中で初めて会うのがテペトル竜だ。","nextNodeIds":[716670111]},{"nodeId":716670111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3776569906,"text":"へぇ、そうなんだな。でも、なんか今回もうまくいかなそうな気がするけど…そもそも、なんでベビーヴィシャップにしないんだ？","nextNodeIds":[716670112]},{"nodeId":716670112,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":4012988426,"text":"…丸っこい腹がないからだよ。","nextNodeIds":[716670113]},{"nodeId":716670113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2393933122,"text":"なんだって？","nextNodeIds":[716670114]},{"nodeId":716670114,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":2614432594,"text":"ベビーヴィシャップには丸っこい腹がないと言ったんだ。おそらく、いつも尋常じゃないスピードでグルグルしてるから、脂肪が落ちてるんだろう…","nextNodeIds":[716670115]},{"nodeId":716670115,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":518217474,"text":"はぁ…それと一番の理由はやっぱり、インパクトが足りない点だな。竜と一緒に暮らしてるナタの友人たちからしたら、きっとベビーヴィシャップなんて見向きもしない相手のはずだ…","nextNodeIds":[716670116]},{"nodeId":716670116,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":945475354,"text":"それに比べて、エンシェントヴィシャップは違う。物語の中に登場すれば、強敵と言えるような立派な存在だ。敵が強ければ強いほど、それに勝てる主人公もより強く見えるものだろう？","nextNodeIds":[716670117]},{"nodeId":716670117,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":2013047178,"text":"さて、話はここまでにしよう。エンシェントヴィシャップがこの先で私たちを待ってるぞ！","nextNodeIds":[716670118,716670119]},{"nodeId":716670118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2612758082,"text":"じゃあ、行こう。","nextNodeIds":[]},{"nodeId":716670119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2071399402,"text":"他に用事があるから、またあとで。","nextNodeIds":[716670120]},{"nodeId":716670120,"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","textMapHash":2171610746,"text":"ああ。じゃあ、ここで待ってるよ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30547"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7166701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30547,"speakerName":"ランジット","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171667],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2004233774,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/EffigyChallenge_V5_71667/Q7166701","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDI