00101","priority":5,"questId":23001,"showRandomTalkCount":0},"dialogs":[{"nodeId":230010101,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2218309834,"text":"うーむ…どれにしたものか？","nextNodeIds":[230010102]},{"nodeId":230010102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3392559954,"text":"何してるの？","nextNodeIds":[230010103]},{"nodeId":230010103,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1952500522,"text":"いや、今日の「千金料理」は何にしようかと考えていたんだ。","nextNodeIds":[230010104]},{"nodeId":230010104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1272433522,"text":"「千金料理」って…お金で作った料理か！？","nextNodeIds":[230010105]},{"nodeId":230010105,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3134785778,"text":"いや、食べると金運がアップする偉大な料理のことだ。","nextNodeIds":[230010106]},{"nodeId":230010106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2944034266,"text":"それ、オイラも食べてみたいぞ！…でも、そんなの本当にあるのか…？","nextNodeIds":[230010107]},{"nodeId":230010107,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3215102930,"text":"ハハハッ、それはお前が知らないだけだ。","nextNodeIds":[230010108]},{"nodeId":230010108,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":653314234,"text":"例えば、璃月には「モラミート」という貨幣の名を冠する高貴な料理があるが…当然、これには強力な金運が秘められている。","nextNodeIds":[230010109]},{"nodeId":230010109,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":697843706,"text":"次に「バターチキン」。にじみ出る黄金色の脂が、金貨が溢れんばかりの財布を連想させるだろう？","nextNodeIds":[230010110]},{"nodeId":230010110,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1061160338,"text":"それにモンドの「お肉ツミツミ」。名前も盛り付けも、いかにも積み上がる富の象徴という感じだ。","nextNodeIds":[230010111]},{"nodeId":230010111,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1545417922,"text":"そうした料理を食べて、カリミ取引所で先物取引に臨めば…きっと大儲けできるはずなんだ！","nextNodeIds":[230010112]},{"nodeId":230010112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3697704754,"text":"なんか、こじつけっぽいぞ…","nextNodeIds":[230010113,230010133]},{"nodeId":230010113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1753950890,"text":"先物ってなに？","nextNodeIds":[230010114]},{"nodeId":230010114,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":532363410,"text":"知らないのか？うーん…簡単に言えば、現物取引とは違って、未来の取引のことだ。たとえば、そこのチビ…","nextNodeIds":[230010115]},{"nodeId":230010115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1847184474,"text":"オイラはパイモンだ！そこのチビ、じゃない！","nextNodeIds":[230010116]},{"nodeId":230010116,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2944828626,"text":"ハハハッ、じゃあチビのパイモン、お前は何が好きだ？","nextNodeIds":[230010117]},{"nodeId":230010117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3677232298,"text":"え？オイラは…えっと…スライムが好きだぞ！","nextNodeIds":[230010118]},{"nodeId":230010118,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2601391898,"text":"ハハハッ、よし！では仮に、俺の手元にスライムの液体があったとする。価格は1瓶100モラとしよう。","nextNodeIds":[230010144]},{"nodeId":230010144,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3885907546,"text":"今日お前が5万モラ出して俺からスライムの液体を500瓶買う、これが現物取引だ。","nextNodeIds":[230010119]},{"nodeId":230010119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3174186978,"text":"そ、それは多すぎて飲みきれないぞ！","nextNodeIds":[230010120]},{"nodeId":230010120,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3523375730,"text":"これは「もしも」の話だ…仮にお前が今日500瓶買ったとする。でもお前はそんな大量のスライムの液体を毎日俺から購入するなんてこと、約束できないだろう？","nextNodeIds":[230010121]},{"nodeId":230010121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3981127434,"text":"う…うん。お腹ぱんぱんになったら、もう買わないだろうな。","nextNodeIds":[230010122]},{"nodeId":230010122,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1456801202,"text":"だろう？俺だって、いつでもスライムの液体を提供するとは約束できない。","nextNodeIds":[230010123]},{"nodeId":230010123,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1629931298,"text":"そういう時こそ、先物の出番だ。先物は目の前で代金と商品を交換する一般的な取引とは違い、ある種の「取引契約」だ。","nextNodeIds":[230010124]},{"nodeId":230010124,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2951433858,"text":"「スライムの液体を1瓶購入」することも、「スライムの液体の一部を販売」することも一種の「取引契約」なんだ。","nextNodeIds":[230010125]},{"nodeId":230010125,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1676547050,"text":"俺がまだスライムの液体を提供できる場合は、先物取引所にスライムの液体販売の「取引契約」を提出する。","nextNodeIds":[230010126]},{"nodeId":230010126,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3459950522,"text":"お前がスライムの液体を買いたければ、先物取引所に行ってスライムの液体の「取引契約」を検索すればいい。","nextNodeIds":[230010127]},{"nodeId":230010127,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":839182426,"text":"つまり「先物取引」は精確かつ巧妙に「取引契約」を売買することで、利益を得るんだ。","nextNodeIds":[230010128]},{"nodeId":230010128,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":4181734570,"text":"もちろん、今話したのはただの例えだ。スライムの液体が本当に先物取引で扱われるようになったら、野外のスライムは根こそぎ獲られてしまうだろう。","nextNodeIds":[230010129]},{"nodeId":230010129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4230599258,"text":"へえ…す、すごいな…","nextNodeIds":[230010130]},{"nodeId":230010130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3512860314,"text":"うーん…ちんぷんかんぷんだ…","nextNodeIds":[230010131]},{"nodeId":230010131,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3334338946,"text":"ただ、先物市場は変化が激しい。俺のように経験豊富なプロでも、買った先物が確実に儲かるとは言い切れない。","nextNodeIds":[230010132]},{"nodeId":230010132,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2342825442,"text":"だからこそ、取引前に金運をもたらす「千金料理」を食べて、運気をいい方に変えたいわけだ。そこで…今日はなにを食べるべきか、となってくるわけだな。","nextNodeIds":[230010136]},{"nodeId":230010136,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3324754946,"text":"ん…ちょっと待てよ？いま気づいたんだが、お前の髪…黄金色じゃないか！まぶしい、実にまぶしいぞ！","nextNodeIds":[230010137]},{"nodeId":230010137,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1647666730,"text":"黄金は富の象徴。お前に料理を選んでもらえば、きっと金運上昇間違いなしだ！","nextNodeIds":[230010138]},{"nodeId":230010138,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2189630578,"text":"俺に「千金料理」を一品選んでくれないか？ちゃんと報酬は用意する。","nextNodeIds":[230010139]},{"nodeId":230010139,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1805330194,"text":"取引で儲けが出たら、ボーナスもつけよう。どうだ？","nextNodeIds":[230010140]},{"nodeId":230010140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2288448258,"text":"もし損失が出たら…","nextNodeIds":[230010141]},{"nodeId":230010141,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1549066674,"text":"ハハハッ、心配御無用。このカリミの偉大なる富豪、ハティム様が約束しよう——利益は分配するが、損失は俺がかぶる。どうだ、これで心置きなく選べるだろう？","nextNodeIds":[230010142]},{"nodeId":230010142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3002798946,"text":"分かった。","nextNodeIds":[230010143]},{"nodeId":230010143,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1872523042,"text":"では、選んでもらおうか。<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>の3品のうち、今日の「千金料理」はどれだと思う？","nextNodeIds":[]},{"nodeId":230010133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3289665674,"text":"なんで3種類全部食べないの？","nextNodeIds":[230010134]},{"nodeId":230010134,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1140723602,"text":"うまい食材だからって見境なく混ぜたら、暗黒料理になってしまうだろう？","nextNodeIds":[230010135]},{"nodeId":230010135,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1157768042,"text":"それと同じだ。どれも金運が上がるとはいえ、全て食べては逆効果なのだ。最強の「千金料理」を一品選ばなくてはな。","nextNodeIds":[230010136]}]},{"talkId":2300106,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2300101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["42170","1","1","",""],"type":"QUEST_COND_DAILY_TASK_VAR_EQ"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2300106,"initDialog":230010601,"nextRandomTalks":[],"nextTalks":[2300102],"npcId":[4004],"performCfg":"QuestDialogue/IQ/Sumeru_23001/Q2300106","priority":5,"questId":23001,"showRandomTalkCount":0},"dialogs":[{"nodeId":230010601,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1914820314,"text":"うーむ…どれにしたものか？","nextNodeIds":[230010602]},{"nodeId":230010602,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":4065467842,"text":"おや、旅人じゃないか、ちょうどよかった！","nextNodeIds":[230010603]},{"nodeId":230010603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3661791010,"text":"おまえ…まさか、また「千金料理」を選んでるのか？","nextNodeIds":[230010604]},{"nodeId":230010604,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":137638722,"text":"ハハハ、ご明察！ちょうど「千金料理」を一つ選んで、先物市場へ出かけようとしていたところだ！","nextNodeIds":[230010605]},{"nodeId":230010605,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3953977706,"text":"どうだ？もう一回を手伝ってくれるか？","nextNodeIds":[230010606,230010608,230010614]},{"nodeId":230010606,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3085159434,"text":"わかった、今日もいつものやり方でいい？","nextNodeIds":[230010607]},{"nodeId":230010607,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2779608874,"text":"そうだ！話が早くて助かるな。<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>のうち、本物の「千金料理」を選んでくれ。","nextNodeIds":[]},{"nodeId":230010608,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1782748026,"text":"待って、「千金料理」って…","nextNodeIds":[230010609]},{"nodeId":230010609,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2106514410,"text":"食べると金運がアップする偉大な料理だ。","nextNodeIds":[230010610]},{"nodeId":230010610,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2085232130,"text":"例えば、璃月には「モラミート」という貨幣の名を冠する高貴な料理があるが…当然、これには強力な金運が秘められている。","nextNodeIds":[230010611]},{"nodeId":230010611,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":636956306,"text":"次に「バターチキン」。にじみ出る黄金色の脂が、金貨が溢れんばかりの財布を連想させるだろう？","nextNodeIds":[230010612]},{"nodeId":230010612,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1827353338,"text":"それにモンドの「お肉ツミツミ」。名前も盛り付けも、いかにも積み上がる富の象徴という感じだ。","nextNodeIds":[230010613]},{"nodeId":230010613,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1416871146,"text":"そうした料理を食べて、カリミ取引所で先物取引に臨めば…きっと大儲けできるはずなんだ！","nextNodeIds":[230010623]},{"nodeId":230010623,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2910109290,"text":"それじゃあ、俺の「先物取引」のために、<color=#00E1FFFF>モラミート</color>、<color=#00E1FFFF>バターチキン</color>、<color=#00E1FFFF>「お肉ツミツミ」</color>のうち、本物の「千金料理」を選んでくれ。","nextNodeIds":[]},{"nodeId":230010614,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":702891114,"text":"待って、先物ってなんだっけ…","nextNodeIds":[230010615]},{"nodeId":230010615,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":152048450,"text":"現物取引と対をなす、ある種の未来の取引だ。仮に俺の手元にスライムの液体があったとする。価格は1瓶100モラとしよう。","nextNodeIds":[230010616]},{"nodeId":230010616,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1156785754,"text":"今日お前が5万モラ出して俺からスライムの液体を500瓶買う、これが現物取引だ。","nextNodeIds":[230010617]},{"nodeId":230010617,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2023654106,"text":"だが、お前はそんな大量のスライムの液体を毎日俺から購入するなんて約束はできないだろうし、俺だって、いつでもスライムの液体を提供するとは約束できない。","nextNodeIds":[230010618]},{"nodeId":230010618,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":489890970,"text":"そういう時こそ、先物の出番だ。先物は目の前で代金と商品を交換する一般的な取引とは違い、ある種の「取引契約」だ。","nextNodeIds":[230010619]},{"nodeId":230010619,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":366631610,"text":"「スライムの液体を1瓶購入」することも、「スライムの液体の一部を販売」することも一種の「取引契約」なんだ。","nextNodeIds":[230010620]},{"nodeId":230010620,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2230399042,"text":"俺がまだスライムの液体を提供できる場合は、先物取引所にスライムの液体販売の「取引契約」を提出する。","nextNodeIds":[230010621]},{"nodeId":230010621,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":998482866,"text":"お前がスライムの液体を買いたければ、先物取引所に行ってスライムの液体の「取引契約」を検索すればいい。","nextNodeIds":[230010622]},{"nodeId":230010622,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":412599642,"text":"つまり「先物取引」は精確かつ巧妙に「取引契約」を売買することで、利益を得るんだ。","nextNodeIds":[230010623]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2300101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[2300106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2300102,"order":2,"stepDescription":"ハティムのために「千金料理」を一つ選ぶ","stepDescTextMapHash":3687857860,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2300102,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4004"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2300102],"talks":[{"talkId":2300102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,