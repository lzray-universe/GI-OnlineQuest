LPKELCAL":["5029"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400001],"talks":[{"talkId":2400001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400001,"initDialog":240000101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5029,5082],"performCfg":"QuestDialogue/IQ/Fontaine_24000/Q2400001","priority":5,"questId":24000,"showRandomTalkCount":0},"dialogs":[{"nodeId":240000101,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1936276250,"text":"もう一度言う——","nextNodeIds":[240000102]},{"nodeId":240000102,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":2471168706,"text":"リーヴァさん、あなたの要求はよくわかるし、できる限り力になってあげたいけど、この申請内容は…ほら、見てくださいよ。","nextNodeIds":[240000103]},{"nodeId":240000103,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":992210874,"text":"担当者はクラピエさんでしょ？あなたが提供したこれまでの書類は全部彼がまとめて提出するんです。つまり、担当者以外は処理しようがないのよ。","nextNodeIds":[240000104]},{"nodeId":240000104,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":594175354,"text":"クラピエさんはいま外回りに行ってるからオフィスにいないし…あなたの持って来てくれた書類にも彼の公印がないと、精算処理に回せなくて…","nextNodeIds":[240000105]},{"nodeId":240000105,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":3032731834,"text":"ハッ…！これで三度目だぞ。やる気はあるのか！？","nextNodeIds":[240000106]},{"nodeId":240000106,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":1784270586,"text":"リーヴァさん、落ち着いて…クラピエさんのいるオフィスって、二人だけで回してるんですよ。もう一人はモントワさんっていうんですけど…","nextNodeIds":[240000107]},{"nodeId":240000107,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":1180582554,"text":"もうお歳で定年前だから、最近はずっとオフィスにいないんです。もちろん給料も受け取ってないけど。","nextNodeIds":[240000108]},{"nodeId":240000108,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2961737234,"text":"わかった、なら自分でそのオフィスに行く。そのモントヴァって人にハンコをもらって自分で押すさ！","nextNodeIds":[240000109]},{"nodeId":240000109,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":2489928618,"text":"ごめんなさい、リーヴァさん…それはできないの。規則違反っていうのもあるけど、公印が入ってる棚の鍵はクラピエさんが持ってるから、結局彼じゃないと取り出せないんです。","nextNodeIds":[240000110]},{"nodeId":240000110,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":1816135554,"text":"それに私にも他にやらなきゃならない仕事があって…でも信じてください！クラピエ先生は絶対今日中に帰ってくるから、確実に処理してもらえるようにします。","nextNodeIds":[240000111]},{"nodeId":240000111,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":3222912658,"text":"わかったよ…それでは失礼、コーネリアさん。","nextNodeIds":[240000112]},{"nodeId":240000112,"roleType":"TALK_ROLE_NPC","speakerId":5082,"speakerName":"コーネリア","textMapHash":1844129450,"text":"ええ。あなたもお気をつけて。","nextNodeIds":[240000113]},{"nodeId":240000113,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":588415914,"text":"コーネリアは慌ただしく去っていった…","nextNodeIds":[240000114]},{"nodeId":240000114,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2614770146,"text":"今日もだめだったか…はぁ…","nextNodeIds":[240000115,240000116]},{"nodeId":240000115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4209368234,"text":"どうしたの？","nextNodeIds":[240000117]},{"nodeId":240000117,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":3416921354,"text":"大したことじゃない。無駄足を踏んで、貴重な半日を台無しにしてしまっただけさ。","nextNodeIds":[240000118]},{"nodeId":240000118,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":941443194,"text":"クラピエって野郎にはウンザリだ！パレ·メルモニアが私たちの工房でいくつかクロックワークを注文していったんだが、まだ支払いがない！","nextNodeIds":[240000119]},{"nodeId":240000119,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1567323506,"text":"最初に彼を訪ねた時は、「今は月末で月次会計監査があるから、来月頭にならないと出金できない」と言われて申請を断られた。","nextNodeIds":[240000120]},{"nodeId":240000120,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2794357682,"text":"二度目に来た時は「捺印用のインクを切らしているが、インク供給元の倉庫で火事があったので別の所から調達しないといけない」と言われてハンコを押してくれなかった。","nextNodeIds":[240000121]},{"nodeId":240000121,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":4253333834,"text":"そして三度目には、この外部支援者情報登録票が更新されたからもう一度記入しろと言ってきた。だがそれも、用紙を切らしているから、明日にならないとダメだとさ。","nextNodeIds":[240000122]},{"nodeId":240000122,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2791837762,"text":"それで今日その用紙を取りにきたら、やつは不在だというじゃないか。くそっ…","nextNodeIds":[240000123]},{"nodeId":240000123,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3579188018,"text":"あら…リーヴァさん、何か悩み事？私にお手伝いできることはあるかしら？","nextNodeIds":[240000124]},{"nodeId":240000124,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":353968994,"text":"ラミアさん、ちょうどよかった。実はこんな状況なんだ…","nextNodeIds":[240000125]},{"nodeId":240000125,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":2476901026,"text":"リーヴァは長々と事の経緯を話した…","nextNodeIds":[240000126]},{"nodeId":240000126,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3092852546,"text":"クラピエさんね…確かに付き合うには手を焼きがちな相手ではあるけど、彼は今日、本当にエリニュス島に行っていて、パレ·メルモニアにはいないの。","nextNodeIds":[240000127]},{"nodeId":240000127,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":1592740250,"text":"でも、彼がどこにいようと関係ないわ。とりあえず例の用紙を手に入れましょう。","nextNodeIds":[240000128]},{"nodeId":240000128,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2610100482,"text":"ん？しかしクラピエさんは用紙を切らしていると言っていたが…","nextNodeIds":[240000129]},{"nodeId":240000129,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3432245018,"text":"私に任せて。たしかパレ·メルモニアと長い付き合いのお店たちも、あなたと同じ状況に遭ったことがあったはずよ。","nextNodeIds":[240000130]},{"nodeId":240000130,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3860866762,"text":"それで彼らは、一定期間おきにパレ·メルモニアに来て、必要になるかもしれない記入用紙や書類をもらっていくの。","nextNodeIds":[240000131]},{"nodeId":240000131,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3388404626,"text":"そうすることで、書類の記入や提出を手っ取り早く済ませられるでしょう。それだけじゃないわ。記入用紙や書類に変更があるかどうかも、いち早く知ることができる…まさに「備えあれば憂いなし」ってところね。","nextNodeIds":[240000132]},{"nodeId":240000132,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":2692926826,"text":"も、もしかして用紙がなくなったのもそのせいなのか…","nextNodeIds":[240000133]},{"nodeId":240000133,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":2073888546,"text":"とにかく、きっと予備の最新版用紙を持っているお店があるはず。彼らの所に行って聞いてみましょう。","nextNodeIds":[240000134]},{"nodeId":240000134,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3135335690,"text":"あなたが何度も無駄足を踏んだことを知れば、きっと彼らも手を貸してくれると思うわ。","nextNodeIds":[240000135]},{"nodeId":240000135,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":471287770,"text":"そうね、パレ·メルモニアの業務終了時間までに用紙を手に入れて、記入してから、またクラピエさんのオフィスに届けないと…","nextNodeIds":[240000136]},{"nodeId":240000136,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":796797186,"text":"旅人さん、リーヴァさんに手を貸してあげてもらえない？","nextNodeIds":[240000137]},{"nodeId":240000137,"roleType":"TALK_ROLE_NPC","speakerId":5029,"speakerName":"リーヴァ","textMapHash":1286189586,"text":"どうか手を貸してくれ、旅人！これ以上この件を片付けられなければ、私は今日も眠れない夜を過ごす羽目になる…","nextNodeIds":[240000138,240000139]},{"nodeId":240000138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2762316754,"text":"わ、わかった…","nextNodeIds":[240000140]},{"nodeId":240000140,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3668783530,"text":"二か所のお店に行って、最新版の「外部支援者情報登録票」をもらってきてあげて。","nextNodeIds":[240000141]},{"nodeId":240000141,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":374696634,"text":"そうね…","nextNodeIds":[240000142]},{"nodeId":240000142,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":2526312082,"text":"エスタブレさんの鍛冶工房、それからカロンさんの時計店に行ってきてくれる？","nextNodeIds":[240000143]},{"nodeId":240000143,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3371583842,"text":"先日、エスタブレさんはパレ·メルモニアの街灯を修理してくれたし、カロンさんはパレ·メルモニアの時計を直してくれた。","nextNodeIds":[240000144]},{"nodeId":240000144,"roleType":"TALK_ROLE_NPC","speakerId":5046,"speakerName":"ラミア","textMapHash":3905608194,"text":"二人ともパレ·メルモニアの職員ではないけど、しょっちゅうパレ·メルモニアから仕事をもらってきてるから、きっと手元に「外部支援者情報登録票」を残してるはずよ。","nextNodeIds":[240000145]},{"nodeId":2400