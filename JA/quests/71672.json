":["30951"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7167201],"talks":[{"talkId":7167201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7167201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7167201,"initDialog":716720101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30951],"performCfg":"QuestDialogue/WQ/HDJ_71672/Q7167201","priority":5,"questId":71672,"showRandomTalkCount":0},"dialogs":[{"nodeId":716720101,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":1079756554,"text":"へへっ、昨日の「白馬の仙人」の講談のおかげで、新しい着想が湧いてきちゃったな。","nextNodeIds":[716720102,716720103]},{"nodeId":716720102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2553112450,"text":"どんな着想？","nextNodeIds":[716720104]},{"nodeId":716720104,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":3903497954,"text":"え…？わわっ！こんにちは！よよよ、ようこそ璃月港！じゃなくてようこそ海灯祭…でもなくて、璃月港へようこそ…！","nextNodeIds":[716720105]},{"nodeId":716720105,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":3104310602,"text":"萍{RUBY#[D]ひょうけい}渓姉さんには見られてないよね！？うん、多分大丈夫…","nextNodeIds":[716720106]},{"nodeId":716720106,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":2991940482,"text":"璃月港へようこそ！海灯祭を見に来られたのですね？では、私の作った「月影の仙跡」もぜひお見逃しなく…","nextNodeIds":[716720107]},{"nodeId":716720107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1680466874,"text":"仕事モードに入ったね。","nextNodeIds":[716720108]},{"nodeId":716720108,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":3468032538,"text":"あ、あの、秘密にしておいてください！他の事を考えてたのが姉さんにバレたら、また怒られてしまいます！","nextNodeIds":[716720109]},{"nodeId":716720109,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":1186678338,"text":"頼み込んでようやく屋台を出させてもらえたんです。ってことで、ついでに最後まで話を聞いてもらえると嬉しいです…","nextNodeIds":[716720110]},{"nodeId":716720110,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":154649034,"text":"えー、こほん、「月影の仙跡」はここ、璃月港に伝わる「白馬の仙人」伝説を題材にしているんです。","nextNodeIds":[716720111]},{"nodeId":716720111,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":4018958498,"text":"伝説によると、この仙人は月の光に導かれて空を巡り、璃月港から邪悪な魔物を追い払っていたといいます…","nextNodeIds":[716720112]},{"nodeId":716720112,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":3262699298,"text":"…でも、そんな伝説って退屈だと思いません？なので…えへへ、私が聞いた別の話をちょっと盛り込んでみました。","nextNodeIds":[716720113]},{"nodeId":716720113,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":3377627914,"text":"例えば…実は空には怪物がいて、月を食い尽くそうとしていたんですよ！そこを白馬の仙人が防いだってわけです。","nextNodeIds":[716720114]},{"nodeId":716720114,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":726998618,"text":"月が食べられるっていうのがどんな感じかは分からないですけど…劉蘇さんの話では、私たちが焼き餅を食べるみたいに、怪物はもぐもぐと月を食べていったんですって。","nextNodeIds":[716720115]},{"nodeId":716720115,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":797240706,"text":"数日後に聞きに行った時は、また違う説明を聞かされましたけどね。お団子を食べるみたいに、がぶっと一口で月を飲み込んだって言ってました。","nextNodeIds":[716720116]},{"nodeId":716720116,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":1074566146,"text":"そして物語の最後はいつも、白馬の仙人が霄灯の光で、すべての魔物を一気に追い払ってしまうんです。","nextNodeIds":[716720117]},{"nodeId":716720117,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":298211410,"text":"それも伝説なの？","nextNodeIds":[716720118]},{"nodeId":716720118,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":288145362,"text":"劉蘇さんが講談でそう語ってたんですよ。かっこいいなって思ったんで、「月影の仙跡」に取り入れちゃいました。","nextNodeIds":[716720119]},{"nodeId":716720119,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":2038265282,"text":"あっ、いけない、いけない。おしゃべりしてる場合じゃなかったんだ…仕事に戻らないと…","nextNodeIds":[716720120]},{"nodeId":716720120,"roleType":"TALK_ROLE_NPC","speakerId":30951,"speakerName":"バオフェイ","textMapHash":538074538,"text":"「月影の仙跡」を試してみたくなったら、声をかけてくださいね。準備はバッチリですから、いつでも始められますよ。","nextNodeIds":[]},{"nodeId":716720103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3636453218,"text":"何か物語でも思いついた？","nextNodeIds":[716720104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJ