en":false,"talkIds":[7108802],"talks":[{"talkId":7108802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7108801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7108802,"initDialog":710880201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2618],"performCfg":"","priority":5,"questId":71088,"showRandomTalkCount":0},"dialogs":[{"nodeId":710880201,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":1451385322,"text":"こんにちは！ああ、君か！","nextNodeIds":[710880221]},{"nodeId":710880221,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3411261682,"text":"ははっ、本当に君たちを探してくるなんて。","nextNodeIds":[710880202,710880203]},{"nodeId":710880202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3945603314,"text":"#そう、{M#俺}{F#私}だ。","nextNodeIds":[710880204]},{"nodeId":710880204,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":164509842,"text":"ああ、失礼失礼！俺はヘディーヴ、ヘディーヴ·プルシナだ。","nextNodeIds":[710880205]},{"nodeId":710880205,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3614214882,"text":"ははっ、もし君が学院の歴史に詳しければ、俺たちの創始者が占星学の分野で、プルビルニの宿敵だったことを知っていただろう。","nextNodeIds":[710880206,710880208]},{"nodeId":710880206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1306661082,"text":"#{M#俺}{F#私}は{NICKNAME}だ。","nextNodeIds":[710880207]},{"nodeId":710880207,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":1586828378,"text":"自己紹介はいらないよ、君の名はすでに聞き及んでいるからね。","nextNodeIds":[710880211]},{"nodeId":710880211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1118218538,"text":"ここで何してるの？","nextNodeIds":[710880212]},{"nodeId":710880212,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3016998570,"text":"俺は総務司から特別に招待されて来た調査学者なんだ。層岩巨淵の再開前に立て坑に入って、生態系の変化や古生物の考察をしている…","nextNodeIds":[710880213]},{"nodeId":710880213,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":2785719698,"text":"当然、その代わり、璃月の歴史学会にその研究成果を伝えなければならない。","nextNodeIds":[710880214]},{"nodeId":710880214,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3333543794,"text":"はぁ、言いたいことは分かる…原則、これは教令院の規則に反する行為だ。だが璃月のスタンスは強硬で、彼らを揺さぶることのできる人はいない。","nextNodeIds":[710880215]},{"nodeId":710880215,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":1282004346,"text":"それに、探検隊は名目上、俺が率いている。拠点にいる鉱夫たちの費用も負担しなければならない…はぁ、成果が出なければ、元も子もないんだよ。","nextNodeIds":[710880216,710880217]},{"nodeId":710880216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2565744682,"text":"なるほど…","nextNodeIds":[710880218]},{"nodeId":710880218,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":2689334474,"text":"でもまあ大丈夫さ、慰めてもらう必要はない。俺はお金持ちだからね。","nextNodeIds":[710880219]},{"nodeId":710880219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4237445506,"text":"ならいい。さようなら。","nextNodeIds":[710880220]},{"nodeId":710880220,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":1074979106,"text":"じゃあね！","nextNodeIds":[]},{"nodeId":710880217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1025950178,"text":"大変だね。","nextNodeIds":[710880218]},{"nodeId":710880208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1470315050,"text":"先生を紹介するのがスメールの伝統なの？","nextNodeIds":[710880209]},{"nodeId":710880209,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":482024850,"text":"ははっ、そうじゃないさ。なんというか…学者としての矜持かな。","nextNodeIds":[710880210]},{"nodeId":710880210,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3685238250,"text":"アニサ先輩のせいで…プルビルニの悪癖がうつってしまった。","nextNodeIds":[710880211]},{"nodeId":710880203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4018153714,"text":"誰？","nextNodeIds":[710880204]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104001,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LN