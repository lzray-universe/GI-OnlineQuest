",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7108803,"initDialog":710880301,"nextRandomTalks":[],"nextTalks":[],"npcId":[2197],"performCfg":"","priority":5,"questId":71088,"showRandomTalkCount":0},"dialogs":[{"nodeId":710880301,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":151137338,"text":"よ、見ない顔だね。こんにちは、若者！","nextNodeIds":[710880302]},{"nodeId":710880302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2812863818,"text":"見ない顔？","nextNodeIds":[710880303]},{"nodeId":710880303,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":3852782586,"text":"ははっ…鉱区の全員を知ってるとは言えないけど、名前くらいは言えるよ。あんたは…初めて鉱区に入ったんじゃないかい？","nextNodeIds":[710880304]},{"nodeId":710880304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2287738106,"text":"#{NICKNAME}だよ。よろしく。","nextNodeIds":[710880305]},{"nodeId":710880305,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":2119422378,"text":"設備を管理している瑾武だ。もう二十年ほど鉱区にいるから、こいつらの姉貴みたいなもんさ。何か分からないことがあったり、設備に問題があったりしたときは、あたしを探せばいい。","nextNodeIds":[710880306]},{"nodeId":710880306,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":1751906114,"text":"あとは、歴史や昔話などを聞きたきゃ大歓迎さ。まあ、暇してるからね。","nextNodeIds":[710880307,710880316,710880323,710880326]},{"nodeId":710880307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3868827650,"text":"層岩巨淵の歴史について…","nextNodeIds":[710880308]},{"nodeId":710880308,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":585557722,"text":"それは長い話になるよ…簡潔に説明してあげよう。","nextNodeIds":[710880309]},{"nodeId":710880309,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":3309315514,"text":"層岩巨淵は璃月最大の鉱床で、天衡山の鉱区に次いで二番目に古い鉱区なんだ。","nextNodeIds":[710880310]},{"nodeId":710880310,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":32963546,"text":"岩王帝君が現れる前は、琉璃晶砂を採掘して、陶磁器なんかの取引で生計を立てていた部族が住んでたって伝説もある…","nextNodeIds":[710880311]},{"nodeId":710880311,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":1378138930,"text":"その後、これらの部族は岩王帝君の使者である夜叉と血の誓いを交わして彼らに加わり、今の八門の一つ——盛露庁の前身となったんだ。","nextNodeIds":[710880312]},{"nodeId":710880312,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":2404200994,"text":"彼らは若陀龍王の鎮圧や、漆黒の災いの撃退にも参加した…本当に、璃月にすごく貢献したのさ。","nextNodeIds":[710880313]},{"nodeId":710880313,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":249813818,"text":"ほら、北西方向のあの谷…あれは、岩王帝君が若陀龍王を層岩巨淵から引きずり出した時にできた跡だって伝説もある。","nextNodeIds":[710880314]},{"nodeId":710880314,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":1157856746,"text":"その後、荒れ果てた土地を捨て、都市での生活に慣れた部族の人々は岩王帝君と共に都市に移り住むことにした。彼らは磁器を作って売ることを生業にし、戦のことなんざ気にもしなくなったのさ。","nextNodeIds":[710880315]},{"nodeId":710880315,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":56539306,"text":"ははっ…だから、今の盛露庁のやつを「細かいところにばかりこだわるただの磁器商人」と見ちゃいけないよ。彼らの先祖も、岩王帝君と肩を並べて激戦を戦い抜いて来たんだ。","nextNodeIds":[]},{"nodeId":710880316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1567027354,"text":"層岩巨淵について…","nextNodeIds":[710880317]},{"nodeId":710880317,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":500432770,"text":"数年前、鉱区が封鎖された時、あたしもここにいた。下層のやつらがえらいものを掘り出したって聞いたよ。","nextNodeIds":[710880318]},{"nodeId":710880318,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":939415050,"text":"その時は、負傷者が次から次へと上に運ばれてきた記憶しかないね…","nextNodeIds":[710880319]},{"nodeId":710880319,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":1478481450,"text":"また、おかしなことに、やつらが負った傷はよく見かける仕事中の怪我なんかじゃかった。そうだね…精神的な衝撃を受けたみたいな感じだ、分かるかい？","nextNodeIds":[710880320]},{"nodeId":710880320,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":3668588802,"text":"やつらを地上に送り出してからは、たったの数日で元の精神状態に戻ってくれた…大きな被害はなかったが、それでも七星の目を引いたのさ。","nextNodeIds":[710880321]},{"nodeId":710880321,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":1431996266,"text":"何を掘り出したのかは知らないが、ロクなものじゃないことは間違いない。玉京台のお方たちもそう考えていたのかもしれないね…それで、層岩巨淵は全面的に封鎖された。","nextNodeIds":[710880322]},{"nodeId":710880322,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":416871170,"text":"その結果、盛露庁はご機嫌斜めになっちまった…ははっ、それはまた別の話だけどね。","nextNodeIds":[]},{"nodeId":710880323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4013484138,"text":"#{M#君}{F#あなた}の仕事について…","nextNodeIds":[710880324]},{"nodeId":710880324,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":1733701626,"text":"あたし？ただ設備を管理してるだけさ。もう二十年くらい経つかね。他の子供が学校に通う年頃、あたしはもう採掘用の晶石ランプや浄水器をいじってた。特に言うことはないよ。","nextNodeIds":[710880325]},{"nodeId":710880325,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":3060022778,"text":"#{M#たくさんの鉱夫と知り合ってきた。あいつらが初めて鉱区に入ってきた時は、あんたよりかろうじて年上って程度の年頃だったよ。}{F#女の子がこんな仕事をするもんじゃない。あたしのように一日中汗をかきながら、鉱区で時間を費やすのはもったいないよ。}","nextNodeIds":[]},{"nodeId":710880326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":80665762,"text":"「七星陣法」について…","nextNodeIds":[710880327]},{"nodeId":710880327,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":2625135946,"text":"あれは「七星」が特別に設置したのさ。真面目な人には効くけど、卑怯者には…ははっ、冗談はここまでにしよう。","nextNodeIds":[710880328]},{"nodeId":710880328,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":826033866,"text":"とにかく、この陣法は政令上最高ランクの封印さ。見た人は、勝手に封印を解いたらどんな責を問われるか、想像に難くないね。","nextNodeIds":[710880329]},{"nodeId":710880329,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":3517739106,"text":"だから、「七星」はわざと目立つ「磐鍵」を用いて、陣法を固定するための結び目として使っているんだよ。これも権威を示すため…","nextNodeIds":[710880330]},{"nodeId":710880330,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":3431356050,"text":"賊に隙を与えたとしても、やつらはこの封印を解除して上の者を怒らせるほどの度胸はない。","nextNodeIds":[710880331]},{"nodeId":710880331,"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","textMapHash":3165336058,"text":"コホンッ…つまり、もし誰かが妨害されずに封印を解いたとしたら…少なくとも、その人は「七星」に黙認されてるってことさ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103701,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7108802,7108803],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2197,"speakerName":"瑾武","count":25},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":14},{"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","count":13}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPO