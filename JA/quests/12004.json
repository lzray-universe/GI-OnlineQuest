activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1200402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1200401,"initDialog":120040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1013],"performCfg":"QuestDialogue/LQ/Ayaka1_12004/Q1200401","priority":5,"questId":12004,"showRandomTalkCount":0},"dialogs":[{"nodeId":120040101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1187465138,"text":"うぅ、これからどうしよう…なにか計画とかないのか？","nextNodeIds":[120040102]},{"nodeId":120040102,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3882506370,"text":"旅人さん、パイモンさん、お待ちください。","nextNodeIds":[120040103]},{"nodeId":120040103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":730576642,"text":"あれ？綾華？","nextNodeIds":[120040104]},{"nodeId":120040104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":853171258,"text":"どうしたの？","nextNodeIds":[120040105]},{"nodeId":120040105,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3918700986,"text":"一つ頼みたいことがあるのですが。","nextNodeIds":[120040106]},{"nodeId":120040106,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":4196394618,"text":"ご心配なさらずに。今回の依頼は社奉行や神里家とは関係ございません。私個人のお願いです。","nextNodeIds":[120040107]},{"nodeId":120040107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2513520666,"text":"個人…ってことは、プライベートなことか？","nextNodeIds":[120040108]},{"nodeId":120040108,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1835542170,"text":"はい、私のお母様に関することでございます。","nextNodeIds":[120040109]},{"nodeId":120040109,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1994699970,"text":"突然で申し訳ないのですが…このことは貴方にしか頼めません。","nextNodeIds":[120040110]},{"nodeId":120040110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":983210410,"text":"詳しく教えて。","nextNodeIds":[120040111]},{"nodeId":120040111,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":227532242,"text":"先日、古い蔵の中からお母様が残した手記を見つけました。","nextNodeIds":[120040112]},{"nodeId":120040112,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3827472922,"text":"そこにはお母様が書き留めた様々な些事が記されていたのですが、その中に私の聞いたことのない人名が、頻繁に出てきていて…とても気になるのです…","nextNodeIds":[120040113]},{"nodeId":120040113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1768184314,"text":"お母さんの友達じゃないか？","nextNodeIds":[120040114]},{"nodeId":120040114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":892234194,"text":"綾華でさえ聞いたことない名前なの？","nextNodeIds":[120040115]},{"nodeId":120040115,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":806626842,"text":"はい。両親が亡くなってからすでに何年も経っているとはいえ、関わりがあった人物については私もお兄様も大抵は存じております。","nextNodeIds":[120040116]},{"nodeId":120040116,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2441194034,"text":"ですので…この名前も聞いたことのないお方が非常に気になるのです。ぜひお会いしてみたいと思い…","nextNodeIds":[120040117]},{"nodeId":120040117,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":296896218,"text":"手記には、相手の名前は「椿」と書かれていました。お母様から高く評価されていて、個性的で遊び心溢れる方だったようです。","nextNodeIds":[120040118]},{"nodeId":120040118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":536265738,"text":"聞いた感じ女の人の名前だな。","nextNodeIds":[120040119]},{"nodeId":120040119,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2403748130,"text":"はい。その女性に会ってみたいのです。","nextNodeIds":[120040120]},{"nodeId":120040120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3996546802,"text":"じゃあ、オイラたちはなにをすればいいんだ？","nextNodeIds":[120040121]},{"nodeId":120040121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3230202250,"text":"人探しか？","nextNodeIds":[120040122]},{"nodeId":120040122,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1341583818,"text":"いえ、手記には彼女の住所が記されていましたので、直接そちらへ赴けばいいでしょう。旅人さんに依頼したいのは…その…一緒に手土産を用意していただきたく思ったからで…","nextNodeIds":[120040123]},{"nodeId":120040123,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1801833810,"text":"それと、先ほど言ったことはどうかご内密にお願いします。","nextNodeIds":[120040124]},{"nodeId":120040124,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1248258594,"text":"元々このようなことはお兄様と一緒に対応するべきなのですが、今お兄様はとても忙しく…それに、この地にいる他の者にはこのことに関わらせたくないと思いまして。","nextNodeIds":[120040125]},{"nodeId":120040125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3357493826,"text":"#だから{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}みたいな異郷人の力を借りたいと。","nextNodeIds":[120040126]},{"nodeId":120040126,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1384102450,"text":"はい。貴方は礼儀作法に詳しく、人を思いやる心を持った優しいお方です。それにとても頼りになりますし、貴方といると安心できます。","nextNodeIds":[120040127]},{"nodeId":120040127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3483288042,"text":"おう！手土産の用意なら、オイラたちも手伝えるぞ。報酬はそうだな…美味いもんをごちそうしてくれるだけでいいぜ！","nextNodeIds":[120040128]},{"nodeId":120040128,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3075969850,"text":"それはよかったです。元々この機会を利用してお二方と一緒に歩きたいと思っていたのです。よろしければ、一緒に行動しましょう。","nextNodeIds":[120040129]},{"nodeId":120040129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1860062642,"text":"#もちろん！{NICKNAME}、いいよな？","nextNodeIds":[120040130]},{"nodeId":120040130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2487114578,"text":"うん。","nextNodeIds":[120040131]},{"nodeId":120040131,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3547455626,"text":"ありがとうございます！では、さっそく出発しましょう。まずは小倉屋へ。","nextNodeIds":[120040132]},{"nodeId":120040132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4145592194,"text":"おう、行こう！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1200401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q1200401Ayaka"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1200401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[112004],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3422030606,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[12005],"GMENNHMBBOH":[],"HCJHEADFCAO":2021,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"Ques