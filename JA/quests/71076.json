",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7106231,"initDialog":710621201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20536],"performCfg":"","priority":11,"questId":71076,"showRandomTalkCount":0},"dialogs":[{"nodeId":710621201,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":144000954,"text":"俺たちはすぐに撤退を始める。もしお前の冒険に支障をきたしてしまったのなら、本当にすまない。","nextNodeIds":[710621202,710621210,710621213,710621221]},{"nodeId":710621202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2715419634,"text":"千岩軍との協力について…","nextNodeIds":[710621203]},{"nodeId":710621203,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":4093442978,"text":"遥か前のことだ。ここが封鎖されたばかりのころ、俺たちは璃月の七星を訪ねた。","nextNodeIds":[710621204]},{"nodeId":710621204,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":1262788602,"text":"最初はうまく交渉してたんだ…「淑女」様も、双方に有益な貿易協定をいくつも立てた。","nextNodeIds":[710621205]},{"nodeId":710621205,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":1924370154,"text":"ファデュイ先遣隊が層岩巨淵に駐在することも、元は付加条件の一つだったんだ…俺たちがここに来たのも、異変の根源の調査と消滅を行うためだった。","nextNodeIds":[710621206]},{"nodeId":710621206,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":798149298,"text":"調査で得たすべての情報は、スネージナヤと璃月によって公平に共有される。","nextNodeIds":[710621207]},{"nodeId":710621207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1866982474,"text":"他に目的はないの？","nextNodeIds":[710621208]},{"nodeId":710621208,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":693982306,"text":"少なくとも俺たちの知る限りでは、ない。俺たちは出発する時、市民から祝福を受けたほどだ…自身を犠牲に他人を守る英雄の部隊だと、市民たちもそう思っていた。","nextNodeIds":[710621209]},{"nodeId":710621209,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":2254263650,"text":"はぁ…なのにまさか、こんなことになるなんて…","nextNodeIds":[]},{"nodeId":710621210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3657292042,"text":"「黒災」について…","nextNodeIds":[710621211]},{"nodeId":710621211,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":2807672138,"text":"またの名を「漆黒の災い」と言う。まあ呼び方はどうでもいいな…五百年前に起きた大災難のことだ。","nextNodeIds":[710621212]},{"nodeId":710621212,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":2407545514,"text":"とにかく…俺たちスネージナヤ人の永遠の敵さ。この五百年、災いは潜伏しているだけだと、俺たちはそう考えている。だから、警戒を解くことは永遠にない。","nextNodeIds":[]},{"nodeId":710621213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3240294858,"text":"#{M#君}{F#あなた}たち自身について…","nextNodeIds":[710621214]},{"nodeId":710621214,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":401491578,"text":"俺たちか？何も言うことはない…努力して戦ったが、失敗に終わった。それだけのことだ。","nextNodeIds":[710621215]},{"nodeId":710621215,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":2072004634,"text":"ここに来たばかりの頃、俺たち第九中隊は六十四人いたんだ。それが今はどうだ？隊長を含め…犠牲になった者や失踪した者が、半分を超えている…かもしれないし、超えていないかもしれない…","nextNodeIds":[710621216]},{"nodeId":710621216,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":4167379818,"text":"まあ、大体半分だろう…俺たちは散り散りになり、お互いに連絡する術を失った…俺たちは負けたんだから、すぐに撤退するべきだった…","nextNodeIds":[710621217]},{"nodeId":710621217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":141830394,"text":"#{M#君}{F#あなた}たちの地上の仲間が璃月港を攻撃した。","nextNodeIds":[710621218]},{"nodeId":710621218,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":1207320698,"text":"そうか…驚きはしたが、理解はできる。","nextNodeIds":[710621219]},{"nodeId":710621219,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":2433037354,"text":"より有意義な冒険にするために、「雄鶏」様は自ずと価値の低い資産を切り捨てる。それが「雄鶏」様の理性さ。","nextNodeIds":[710621220]},{"nodeId":710621220,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":1711327178,"text":"あのお方の直属部下として、俺たちに何も文句はない…","nextNodeIds":[]},{"nodeId":710621221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":396190234,"text":"カタリナについて…","nextNodeIds":[710621222]},{"nodeId":710621222,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":351634498,"text":"彼女に会ったのか？彼女は生きていたのか…？俺たちを許してくれているといいんだが。","nextNodeIds":[710621223]},{"nodeId":710621223,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":1276056034,"text":"彼女と彼女の弟、ニコライ伍長は、「壁炉の家」で育った…女皇陛下の子供たちなんだ。","nextNodeIds":[710621224]},{"nodeId":710621224,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":7627482,"text":"彼女はいつも、必ず弟を探し出すんだと言っていた。でも俺は…下の環境が彼女にそんな馬鹿な考えを与えたんだと思った…彼女の弟は、生きてるはずがないからな…","nextNodeIds":[710621225,710621230]},{"nodeId":710621225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3240409258,"text":"だから彼女を見捨てたの？","nextNodeIds":[710621226]},{"nodeId":710621226,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":3534936474,"text":"見捨てた…？いや、彼女は…自分の意志で残ったんだ。もしも懸念を心に抱える者がいれば…チーム全体の足を引っ張るだけだからな。","nextNodeIds":[710621227]},{"nodeId":710621227,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":1416414250,"text":"俺たちは…一人が大勢のために自分を犠牲に、そして大勢が重要なお方のために自分を犠牲にする…それがファデュイの覚悟なんだ。","nextNodeIds":[710621228]},{"nodeId":710621228,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":505403218,"text":"カティアはきっとその覚悟ができていた。もちろん、コーリャもだ。","nextNodeIds":[710621229]},{"nodeId":710621229,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":4132463402,"text":"あいつらが俺に同じことをしても、俺は理解できる。","nextNodeIds":[]},{"nodeId":710621230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3390575322,"text":"彼女の状況はそんなに悪くない。","nextNodeIds":[710621231]},{"nodeId":710621231,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":2345514810,"text":"お前は外の者だからな。ファデュイは平民に対し醜態を演じるわけにはいかない。","nextNodeIds":[710621232]},{"nodeId":710621232,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":3262758858,"text":"だが彼女にとって、俺たちは家族だ。彼女も、俺たちの家族だった…かつてはな。","nextNodeIds":[710621233]},{"nodeId":710621233,"roleType":"TALK_ROLE_NPC","speakerId":20536,"speakerName":"アントン","textMapHash":654081194,"text":"コーリャを探すと決めたのは、彼女自身だ…だから、俺たちを許してくれていることを願ってるよ。","nextNodeIds":[]}]},{"talkId":7106232,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7106207","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7105802","1","","",""],"type":"QUEST_COND_QUEST_NOT_RECEIVE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","","