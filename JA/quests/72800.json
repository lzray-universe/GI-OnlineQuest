eakerId":20268,"speakerName":"旭東","textMapHash":30472378,"text":"そうだ、旅人。長い時間付き合ってくれて、ご苦労だった。","nextNodeIds":[728000320]},{"nodeId":728000320,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"旭東","textMapHash":3488911434,"text":"料理を持ち帰れるようにしてやるよ。外で冒険するなら、お腹いっぱいにしておかないとな。","nextNodeIds":[728000321]},{"nodeId":728000321,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"旭東","textMapHash":1582032090,"text":"次回会う時は、必ず美味しい料理をご馳走するよ。","nextNodeIds":[]},{"nodeId":728000306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3458793386,"text":"また今度食べにくる。","nextNodeIds":[728000307]},{"nodeId":728000307,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"旭東","textMapHash":1026433898,"text":"ははっ、よし、約束だぞ。最高の料理を作ってやる。","nextNodeIds":[728000308]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280010,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7280010"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7280011,"order":11,"stepDescription":"旭東と会話する","stepDescTextMapHash":1283285796,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["20268","SELE