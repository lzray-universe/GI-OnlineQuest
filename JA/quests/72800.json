"questId":72800,"showRandomTalkCount":0},"dialogs":[{"nodeId":728000201,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":1286020090,"text":"…何か用ですか？","nextNodeIds":[728000202]},{"nodeId":728000202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":135268658,"text":"あなたは…","nextNodeIds":[728000203]},{"nodeId":728000203,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":4103253618,"text":"私は亀井宗久、ただの通りすがりの者です。","nextNodeIds":[728000204]},{"nodeId":728000204,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"ジュリー","textMapHash":1036865706,"text":"うわぁ…このおじさんの服、まるで「武士」みたいだ…","nextNodeIds":[728000205]},{"nodeId":728000205,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"パルヴァネ","textMapHash":3428407786,"text":"ぶ、武士か？まさか幕府のあの「武士」…聞いた話では、幕府は外国人に対して…微妙な態度をとる…","nextNodeIds":[728000206]},{"nodeId":728000206,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":2416828450,"text":"……","nextNodeIds":[728000207]},{"nodeId":728000207,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":3774620946,"text":"心配しないでください。私は既に幕府を離れた武士です。","nextNodeIds":[728000208]},{"nodeId":728000208,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":3461743058,"text":"食べ物を探しによく来るのですが、今日は魔物がうろついていました。","nextNodeIds":[728000209]},{"nodeId":728000209,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":3393629586,"text":"しかも周囲の食材は全部かき集められたようなので、全部倒すしかなかったのです。","nextNodeIds":[728000210,728000212,728000214]},{"nodeId":728000210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":789286298,"text":"よくここに来るの？","nextNodeIds":[728000211]},{"nodeId":728000211,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":2552767426,"text":"普段魔物は殆どいません。私はよく果物を採ったり、動物を狩ったりしています。","nextNodeIds":[728000217]},{"nodeId":728000217,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":2957415722,"text":"話はここまでにしましょう。ここの魔物は倒しましたので、周囲の魔物はしばらくは寄ってこないはずです。","nextNodeIds":[728000218]},{"nodeId":728000218,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":898404722,"text":"あなたたちも食べ物を探しに来たのであれば、周囲を探してみてください。私は一人分しか採っていないので、まだ残っていると思います。","nextNodeIds":[728000219]},{"nodeId":728000219,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":1893660466,"text":"では、これで失礼します。","nextNodeIds":[728000220]},{"nodeId":728000220,"roleType":"TALK_ROLE_NPC","speakerId":20269,"speakerName":"ジュリー","textMapHash":2347992114,"text":"も、もう行っちゃった。このおじさん、何だか噂で聞いた武士とそっくり…","nextNodeIds":[728000221]},{"nodeId":728000221,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"パルヴァネ","textMapHash":2971860002,"text":"だが、幕府を離れたってどういうことだ？幕府を離れた武士は、つまり…","nextNodeIds":[728000222,728000223]},{"nodeId":728000222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1895158242,"text":"この前会った敵みたい。","nextNodeIds":[728000224]},{"nodeId":728000224,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"パルヴァネ","textMapHash":1901106914,"text":"以前聞いたんだけど、幕府を離れてあちこちを流浪する武士たちがいて、生計のために通りすがりの人から窃盗するの…","nextNodeIds":[728000225]},{"nodeId":728000225,"roleType":"TALK_ROLE_NPC","speakerId":20270,"speakerName":"パルヴァネ","textMapHash":4149726050,"text":"あのおじさんは悪い人じゃないみたいだけど、やっぱり気を付けた方がいいわ。","nextNodeIds":[728000226]},{"nodeId":728000226,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"旭東","textMapHash":1994834346,"text":"まあまあ。俺たちは食材を探しに来たんだ。だが周囲のこの状況だと、やはり危険な目に遭わないために、深入りしないようにしよう。","nextNodeIds":[728000227]},{"nodeId":728000227,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"旭東","textMapHash":2684175626,"text":"旅人もずっといてくれたから、きっと疲れてる。ここで料理でも作って休んでから、町に帰ろう。","nextNodeIds":[728000228]},{"nodeId":728000228,"roleType":"TALK_ROLE_NPC","speakerId":20268,"speakerName":"旭東","textMapHash":3491448346,"text":"あのおじさん、周囲に食材があるって言ってたよな？探してみよう。","nextNodeIds":[]},{"nodeId":728000223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":73224122,"text":"「海乱鬼」みたい。","nextNodeIds":[728000224]},{"nodeId":728000212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":968091354,"text":"魔物は全部あなたが倒したの？","nextNodeIds":[728000213]},{"nodeId":728000213,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":3857371754,"text":"はい。全て普通の魔物なので、倒しやすいのです。","nextNodeIds":[728000217]},{"nodeId":728000214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2266706034,"text":"どうして野外で食べ物を探してるの？","nextNodeIds":[728000215]},{"nodeId":728000215,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":3833856218,"text":"……","nextNodeIds":[728000216]},{"nodeId":728000216,"roleType":"TALK_ROLE_NPC","speakerId":20329,"speakerName":"？？？","textMapHash":3174292698,"text":"それは私自身の事情が原因です。","nextNodeIds":[728000217]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20329","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7280005,"order":5,"stepDescription":"回りで食材を収集する","stepDescTextMapHash":4128518652,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7280001"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0