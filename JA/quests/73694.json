1"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7369401],"talks":[{"talkId":7369401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7369401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7369401,"initDialog":736940101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30351],"performCfg":"QuestDialogue/WQ/Sumeru_73694/Q7369401","priority":5,"questId":73694,"showRandomTalkCount":0},"dialogs":[{"nodeId":736940101,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":4201983434,"text":"うーん、なんで皆くたびれた顔をしてるんだ…","nextNodeIds":[736940102]},{"nodeId":736940102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":134182426,"text":"ここで何かイベントをやってるの？","nextNodeIds":[736940103]},{"nodeId":736940103,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":1476629290,"text":"君は…旅人だな？ハハハ、ご高名はかねがね伺ってるよ。","nextNodeIds":[736940104]},{"nodeId":736940104,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":3510157010,"text":"そうとも。ヴァフマナ学院では、ただいま「考古」に関するミニゲームを開催中だ。","nextNodeIds":[736940105]},{"nodeId":736940105,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":2973648802,"text":"なにせ、我が学院には歴史を研究している学者たちが多いからね。そして研究の過程で、自ら「考古」の旅に赴くこともよくある。","nextNodeIds":[736940106]},{"nodeId":736940106,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":4232509602,"text":"ああ、そう硬くならないでくれ。君たちを考古の旅に行かせようってわけじゃない。今回のイベントでは、ただ考古という「行動」を真似るだけなんだ。","nextNodeIds":[736940107]},{"nodeId":736940107,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":2217739090,"text":"私たちは予め、スメールシティ周辺に「文物模型」を多数埋めておいたんだ…それらを埋めた場所を、とりあえず「考古エリア」と呼ぼう。","nextNodeIds":[736940108]},{"nodeId":736940108,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":2474726098,"text":"イベント参加者は、私たちが特別に製作した探査機を使って、「考古エリア」に埋められた「文物模型」を発掘すればいいのさ。","nextNodeIds":[736940109]},{"nodeId":736940109,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":2379657698,"text":"他の学院の学生たちも、特製の容器や探査機の製作に協力してくれたんだ。","nextNodeIds":[736940110]},{"nodeId":736940110,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":2402496770,"text":"旅人、どうだ、興味があれば試してみないか？","nextNodeIds":[736940111,736940112]},{"nodeId":736940111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3971088898,"text":"そんなに難しくなさそう…","nextNodeIds":[736940113]},{"nodeId":736940113,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":4222295730,"text":"ハハハ、よし！この探査機を渡そう。「考古エリア」の場所は<color=#00E1FFFF>考古マニュアル</color>に記してあげるよ。","nextNodeIds":[736940114]},{"nodeId":736940114,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":1677361858,"text":"これで準備万端だ。旅人、さっそく考古学の醍醐味ってやつを味わってくれ。","nextNodeIds":[736940115]},{"nodeId":736940115,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":1796835082,"text":"すべての「文物模型」を見つけられたなら、忘れずに報酬を受け取りに来てくれよ。","nextNodeIds":[736940116]},{"nodeId":736940116,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":3630194514,"text":"模型を探す時は探査機に従えばいい。見分けやすいよう、元素タイプで区別してあるんだ。","nextNodeIds":[736940117]},{"nodeId":736940117,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":1547572986,"text":"ただ…これらの探査機は、本来は元素を測定するための機器をとりあえず改造したものなんだ。特定の元素の影響を受けやすい可能性もある…","nextNodeIds":[736940118]},{"nodeId":736940118,"roleType":"TALK_ROLE_NPC","speakerId":30351,"speakerName":"ダナ","textMapHash":2566886210,"text":"とにかく、全ての「文物模型」を発掘できたら、魅力的な報酬がもらえるぞ。","nextNodeIds":[]},{"nodeId":736940112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":725261050,"text":"試してみてもよさそう…","nextNodeIds":[736940113]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30351"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7369401],"speakerCounts":[{"roleType":"TALK_ROLE_NP