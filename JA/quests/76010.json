:["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7601002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7601002,"initDialog":760100201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21840],"performCfg":"QuestDialogue/WQ/NodKrai_76010/Q7601002","priority":5,"questId":76010,"showRandomTalkCount":0},"dialogs":[{"nodeId":760100201,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":1371421434,"text":"二十五、二十六…","nextNodeIds":[760100202]},{"nodeId":760100202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3907327362,"text":"なにを数えてるんだ？","nextNodeIds":[760100203]},{"nodeId":760100203,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":3914785162,"text":"シッ…！静かに…はぁ、まあいいか。どっちみち釣れなかったし。","nextNodeIds":[760100204]},{"nodeId":760100204,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":3203293298,"text":"見ればわかるだろう？釣りの時間を計ってるんだ。そうじゃなければ釣り竿で何をしてると思ったんだい？まじないかい？","nextNodeIds":[760100205,760100207]},{"nodeId":760100205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":432053714,"text":"霜月の子の人ならあり得るかも…","nextNodeIds":[760100206]},{"nodeId":760100206,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":2547742770,"text":"過大評価しすぎだよ。僕はせいぜい半分霜月の子の人間ってとこだし、侍祭のはしくれでもない。要するにクーヴァキを使えない凡人さ。","nextNodeIds":[760100210]},{"nodeId":760100210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3985972082,"text":"まあそんなことはいいや。釣りで秒数を気にするやつなんて初めて見たぞ…","nextNodeIds":[760100211]},{"nodeId":760100211,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":123261322,"text":"ああ、重要なのは釣りの技術であって、岸に立っている時間の長さじゃない。イルマリ爺さんはそこを理解していないから、まったく魚が釣れないんだ。","nextNodeIds":[760100212]},{"nodeId":760100212,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":2794560986,"text":"ん？そういえば君たちはトレジャーハンターかな？","nextNodeIds":[760100213]},{"nodeId":760100213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3430141674,"text":"違うぞ。オイラたちは冒険者で…えっ、もしかしてなにかさせるつもりか？","nextNodeIds":[760100214]},{"nodeId":760100214,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":2859432194,"text":"トレジャーハンターでも冒険者でも、報酬を受け取って仕事をしてくれるなら誰だって構わないよ。もし時間があったら、ちょっと手伝ってほしいことがあるんだ。","nextNodeIds":[760100215]},{"nodeId":760100215,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":1111647194,"text":"見てのとおり、僕の釣りの腕前はヒーシ島で一番なんだ。歴代の詠月使でさえも、釣りに関して僕の右に出る者はいない…","nextNodeIds":[760100216]},{"nodeId":760100216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1088807554,"text":"そ、そうなのか？そりゃすごい…って、あれ？よく考えたら別にすごくないよな。詠月使の本業は釣りじゃないし。","nextNodeIds":[760100217]},{"nodeId":760100217,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":1001698490,"text":"ところが、僕はこんなにすごいのに最近全然魚が釣れないんだよ！どうしてだろう？","nextNodeIds":[760100218]},{"nodeId":760100218,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":3037905346,"text":"明らかに原因は僕じゃなく、環境にある。呪われたケラティの眼と同じで、ここの水中には魚群に影響を与える何かがあるに違いないんだ。","nextNodeIds":[760100219]},{"nodeId":760100219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2603941146,"text":"よ、よくわからない推測だな…","nextNodeIds":[760100220]},{"nodeId":760100220,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":4292642370,"text":"そこで、君たちにはこの辺りの水域を調査して、いったい何が魚がかかるのを邪魔しているのかを調査してほしいんだ。報酬はしっかり用意するから安心してくれ。","nextNodeIds":[760100221]},{"nodeId":760100221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4034220466,"text":"まあ、報酬をくれるって言うなら見てみるけど…でも、変なものが見つかるかどうかまでは保証できないからな？","nextNodeIds":[]},{"nodeId":760100207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":379773674,"text":"もしかして最高の仲間を探してるとか…？","nextNodeIds":[760100208]},{"nodeId":760100208,"roleType":"TALK_ROLE_NPC","speakerId":21840,"speakerName":"ペカニー","textMapHash":3031117746,"text":"？","nextNodeIds":[760100209]},{"nodeId":760100209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1473956978,"text":"いや、誰でも釣りで最高の仲間を釣れるってわけじゃ…って、そういう問題じゃないだろ！","nextNodeIds":[760100210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7601002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21840"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7601003,"order":3,"stepDescription":"近くを調べる","stepDescTextMapHa