ash":587772362,"text":"なるべく死傷者を減らすことができる。","nextNodeIds":[745110114]},{"nodeId":745110114,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"シェニー","textMapHash":31543810,"text":"そういうこと！さすがは「フォンテーヌ科学院のオファーを三回も断った」フェルロイス先輩。こんな不思議な発明品をあっという間に作れちゃうなんて！","nextNodeIds":[745110115]},{"nodeId":745110115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":183619330,"text":"フォンテーヌ科学院のオファーを三回も断った？","nextNodeIds":[745110116]},{"nodeId":745110116,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"フェルロイス","textMapHash":2893416834,"text":"その…","nextNodeIds":[745110117]},{"nodeId":745110117,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"シェニー","textMapHash":4132031274,"text":"そうよ！フェルロイス先輩はね、フォンテーヌ科学院に才能を見込まれて、最先端の研究をしないかって大金を積まれて三回もオファーをされたのよ。","nextNodeIds":[745110118]},{"nodeId":745110118,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"シェニー","textMapHash":39712130,"text":"でも先輩は警察隊の仕事が大好きで、ずっとここに残ってくれているの。なんと感動的！","nextNodeIds":[745110119]},{"nodeId":745110119,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"シェニー","textMapHash":1614839146,"text":"それでも、先輩は自分の才能を無駄にしてしまわないように、時々こういった発明を作ったりして、私たちのいろんな悩みを解決してくれてるの！","nextNodeIds":[745110120]},{"nodeId":745110120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":705321346,"text":"なんだかすごそうだな！","nextNodeIds":[745110121]},{"nodeId":745110121,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"フェルロイス","textMapHash":2101203090,"text":"コホン、とんでもない。シェニー、私の教えを覚えているか？賢い人ほど、謙虚であることの大切さを心得ているものだ。","nextNodeIds":[745110122]},{"nodeId":745110122,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"シェニー","textMapHash":220375538,"text":"はい！フェルロイス先輩！","nextNodeIds":[745110123]},{"nodeId":745110123,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"フェルロイス","textMapHash":3083384306,"text":"とにかく、二人にはこのリモート砲台の有効性を試してほしい。「場所」と「標的」は、もう用意してあるし、報酬もケチったりしない。","nextNodeIds":[745110124]},{"nodeId":745110124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2245189074,"text":"へへっ、任せろ！","nextNodeIds":[745110125]},{"nodeId":745110125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2708404618,"text":"#オイラと{NICKNAME}は今までいろんな変わったものを見てきたんだ。おまえの発明が役に立つかどうか、見極めてやるぞ！","nextNodeIds":[745110126]},{"nodeId":745110126,"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"シェニー","textMapHash":4293307330,"text":"ファイト、お二人さん。ファイト、フェルロイス先輩！","nextNodeIds":[745110127]},{"nodeId":745110127,"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"フェルロイス","textMapHash":807222770,"text":"えっと…とにかく、こちらへどうぞ。","nextNodeIds":[]},{"nodeId":745110105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3352926874,"text":"まさか街中で剣を振るってたのが…","nextNodeIds":[745110106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30509"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7451101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30534,"speakerName":"シェニー","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":30509,"speakerName":"フェルロイス","count":7},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174511],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3147378662,"CHECNJEMEFE":{"30509":[1170],"30534":[1190]},"CJ