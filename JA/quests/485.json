NodeIds":[4850335]},{"nodeId":4850335,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":4049923011,"text":"うん！あいつに偵察騎士の勇気を見せてやる！","nextNodeIds":[4850336]},{"nodeId":4850336,"roleType":"TALK_ROLE_NPC","speakerId":1485,"speakerName":"「怪鳥」","textMapHash":684377971,"text":"お、おい、馬鹿な真似はやめろ！大人しく帰れ！小娘！","nextNodeIds":[4850337]},{"nodeId":4850337,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":3207406139,"text":"どうして？よく聞いてみてよ。周囲から聞こえてくる囁きを…","nextNodeIds":[4850338]},{"nodeId":4850338,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":1799475803,"text":"飛べる──風はそう言ってるよ。","nextNodeIds":[]},{"nodeId":4850329,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1242248883,"text":"勇気が必要なだけ、これは自殺じゃない。","nextNodeIds":[4850330]},{"nodeId":4850317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1459782459,"text":"元素魔法を使った可能性は？","nextNodeIds":[4850318]},{"nodeId":4850318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1185984995,"text":"#{NICKNAME}の元素視角で痕跡は見えないか？…うーん、やっぱないか？","nextNodeIds":[4850322]},{"nodeId":4850319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2877683715,"text":"カギ縄でも使ったのかも。","nextNodeIds":[4850320]},{"nodeId":4850320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4264186731,"text":"飛んでも辿り着けないのに、投げてどうにかなるわけないだろ。","nextNodeIds":[4850321]},{"nodeId":4850321,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":3963595059,"text":"地面に引っかき傷も見当たらないしね。","nextNodeIds":[4850322]},{"nodeId":4850310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3163494147,"text":"周りを観察しよう…そう言ったでしょ。","nextNodeIds":[4850311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[48503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKE