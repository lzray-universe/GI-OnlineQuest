]},{"nodeId":790700102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3055210314,"text":"これからどうするつもり？","nextNodeIds":[790700103]},{"nodeId":790700103,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":1067826370,"text":"そうですね…まず、レリックが判断を下したことを王国全体に発表します。","nextNodeIds":[790700104]},{"nodeId":790700104,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":745797530,"text":"守護者は…あの遠路はるばるいらしたフロベールさんだと。","nextNodeIds":[790700105]},{"nodeId":790700105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3678602378,"text":"ええ！？なんでそんなことするんだ？","nextNodeIds":[790700106]},{"nodeId":790700106,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":84900474,"text":"私たちが経験したことを皆に説明するのは、実際複雑すぎます。","nextNodeIds":[790700107]},{"nodeId":790700107,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":4142324490,"text":"それに、私がプリンセスであり、かつ守護者である理由は、皆すぐには理解できないでしょう。","nextNodeIds":[790700108]},{"nodeId":790700108,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":809342050,"text":"適切な時機が来たら、すべてを詳細に記して、全国民に書面で伝えます。","nextNodeIds":[790700109]},{"nodeId":790700109,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":3212790154,"text":"それまでは、私はやはりプリンセスとして王国の様々なことを取り仕切らねばなりません。","nextNodeIds":[790700110]},{"nodeId":790700110,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":3551533882,"text":"あの「試練の場」を正式に「鍛錬の場」に作り替えたら、私は旅立ちます。","nextNodeIds":[790700111,790700112]},{"nodeId":790700111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":727253114,"text":"旅立つ？","nextNodeIds":[790700113]},{"nodeId":790700113,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":3935197866,"text":"プリンセス…洞窟にいた時、レリックは誰のために光ったか、覚えていらっしゃいますか？","nextNodeIds":[790700114]},{"nodeId":790700114,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":2391911178,"text":"え？誰のために光ったか…ですか？","nextNodeIds":[790700115]},{"nodeId":790700115,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":3677909458,"text":"そうです。あのとき俺たちはみなレリックのそばにいました。プリンセスはもちろん認められるに値しますが、お、俺は…","nextNodeIds":[790700116]},{"nodeId":790700116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3163721714,"text":"#{M#君}{F#あなた}はあのチャンピオンに認められた。","nextNodeIds":[790700117]},{"nodeId":790700117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":42881850,"text":"そうだぞ。チャンピオンのシブレロがわざわざおまえに頼みに来たんだ。十分認められてるだろ？","nextNodeIds":[790700118]},{"nodeId":790700118,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":664781610,"text":"プリンセスの光が眩しすぎるあまり、みんな勘違いしているんだろう！","nextNodeIds":[790700119]},{"nodeId":790700119,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":2886663242,"text":"ふふっ…ではチャンピオンさん、もう一度試練を受けてみませんか？","nextNodeIds":[790700120]},{"nodeId":790700120,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":3412085418,"text":"このベルウインド王国のプリンセス·シメスト自ら、レリックを用いてあなたの証人となりましょう。","nextNodeIds":[790700121]},{"nodeId":790700121,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":1890567850,"text":"良いのですか！ぜひ受けたいです！","nextNodeIds":[790700122,790700123]},{"nodeId":790700122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2153454162,"text":"そう興奮しないで…","nextNodeIds":[790700124]},{"nodeId":790700124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1700005674,"text":"へへっ、プリンセスが言うとこんな張り切るんだな、フロベールって…","nextNodeIds":[790700125]},{"nodeId":790700125,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":330126746,"text":"誤解しないでくれ！これも雨歌の池の使命のためだ！これほどの訓練を積むのは、プリンセスを救うためであり…その、守るためだ。","nextNodeIds":[790700126]},{"nodeId":790700126,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":2797179314,"text":"こんなにも重要な任務なんだから、万全を期さないと…","nextNodeIds":[790700127]},{"nodeId":790700127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3641286946,"text":"プリンセスに同行したいの？","nextNodeIds":[790700128]},{"nodeId":790700128,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":2174536226,"text":"そ、そうだ…","nextNodeIds":[790700129]},{"nodeId":790700129,"roleType":"TALK_ROLE_NPC","speakerId":21470,"speakerName":"シメスト","textMapHash":4160357818,"text":"ふふっ、それなら良かった。ではチャンピオンさんことフロベール、私の試練を受ける準備はよろしいですか？","nextNodeIds":[790700130]},{"nodeId":790700130,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":3618217930,"text":"はい、プリンセス！いつでも結構です！","nextNodeIds":[790700131]},{"nodeId":790700131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":541142970,"text":"わっ、レリックがまた光り出したぞ！ま、眩しい…！","nextNodeIds":[]},{"nodeId":790700123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":977164018,"text":"み、耳がキーンとした。","nextNodeIds":[790700124]},{"nodeId":790700112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":144227858,"text":"何をするの？","nextNodeIds":[790700113]}]},{"talkId":7907002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907001","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7907002,"initDialog":790700201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21466,21467,21469],"performCfg":"","priority":5,"questId":79070,"showRandomTalkCount":0},"dialogs":[{"nodeId":790700201,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":311596714,"text":"エスタンプ！今までどこへ行っていたんだ！？","nextNodeIds":[790700202]},{"nodeId":790700202,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"エスタンプ","textMapHash":2572689082,"text":"ああ、周りを確認して、試練に挑戦してたんだ。なかなか面白いよ。ただ他の方法で突破しなきゃならないけど。","nextNodeIds":[790700203]},{"nodeId":790700203,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"エスタンプ","textMapHash":343415610,"text":"あなた方のことはホレロウさんから聞いたよ。すごいな「守護者殿」、かなりの実力者なんだって？","nextNodeIds":[790700204]},{"nodeId":790700204,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":4282260730,"text":"き、き、君…君が近くにいたら！絶対に君を推薦したのに！十回あれば、十回とも推したのに！","nextNodeIds":[790700205]},{"nodeId":790700205,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"エスタンプ","textMapHash":157999202,"text":"だからこそ試練に行ったんだよ。わが友フロベール。あなたならやれると信じていた。ほら、実際やれただろう。","nextNodeIds":[790700206]},{"nodeId":790700206,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"ホレロウ","textMapHash":3906768010,"text":"アッハハハ、二人とも実に好い。今日は我々雨歌の池にとってめでたい日です。","nextNodeIds":[790700207]},{"nodeId":790700207,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"ホレロウ","textMapHash":2479476514,"text":"ついに真のチャンピオンが誕生しました。フロベールにはまだプリンセスを救う機会が訪れていませんが、必ずや腕を見せる場面があると信じています。","nextNodeIds":[790700208]},{"nodeId":790700208,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":1064785922,"text":"いやいや！俺は何もしていないんだ、ホレロウさん。ただそばで見ていただけで、何もかもプリンセスがやってくれたんだよ。","nextNodeIds":[790700209]},{"nodeId":790700209,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"ホレロウ","textMapHash":2815382226,"text":"それなら、なおのこと良いではないですか。プリンセスが危険にさらされるところを見たかったのですか？","nextNodeIds":[790700210]},{"nodeId":790700210,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":581896594,"text":"そ…それは…","nextNodeIds":[790700211]},{"nodeId":790700211,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"ホレロウ","textMapHash":2151965186,"text":"やれやれ、いいですか、フロベールさん。君はあのシブレロから直々に託されたのですよ。","nextNodeIds":[790700212]},{"nodeId":790700212,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":1096288618,"text":"どうだか！あれが本当にシブレロだったかも分からないのに！俺は彼の噂を知っているだけで、実際の声なんて聞いたこともないんだからな。","nextNodeIds":[790700213]},{"nodeId":790700213,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"エスタンプ","textMapHash":4060384546,"text":"それに、あなたはあのプリンセスの試練を受けた。さすがはチャンピオンだよ。","nextNodeIds":[790700214]},{"nodeId":790700214,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":2168341954,"text":"もうこの話はやめにしないか？頼むから…","nextNodeIds":[790700215]},{"nodeId":790700215,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"ホレロウ","textMapHash":1376563946,"text":"とにかく、我ら雨歌の池の未来は、君に託しましたよ。","nextNodeIds":[790700216]},{"nodeId":790700216,"roleType":"TALK_ROLE_NPC","speakerId":21467,"speakerName":"ホレロウ","textMapHash":1586816610,"text":"これでやっと、何のプレッシャーもなくジャンプができるようになりました。帰って組織委員会に提案してみましょう。ジャンプコンテストに、もっと面白い内容を加えてみないかと。","nextNodeIds":[790700217]},{"nodeId":790700217,"roleType":"TALK_ROLE_NPC","speakerId":21469,"speakerName":"エスタンプ","textMapHash":861209290,"text":"それはいい考えだね。僕は司会をやりたい。さ、今すぐ帰ろう。","nextNodeIds":[790700218]},{"nodeId":790700218,"roleType":"TALK_ROLE_NPC","speakerId":21466,"speakerName":"フロベール","textMapHash":1800007066,"text":"俺をここに放置してかないでくれ！","nextNodeIds":[]}]},{"talkId":7907003,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7907001","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginW