","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7468502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468501,"initDialog":746850101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30565],"performCfg":"QuestDialogue/WQ/Watergun_74685/Q7468501","priority":5,"questId":74685,"showRandomTalkCount":0},"dialogs":[{"nodeId":746850101,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":2572815826,"text":"よし、威力はこれくらいでいいかな。水玉の威力を、的を壊せるぐらいにしておけば、娯楽性と安全性を両立できるし…","nextNodeIds":[746850102]},{"nodeId":746850102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4247220850,"text":"水玉？娯楽？なんだ、ただのウォーターキャノンのおもちゃだったのか。それなら安心したぜ…","nextNodeIds":[746850103]},{"nodeId":746850103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1317656730,"text":"でもこのウォーターキャノン、なんか見覚えがあるな？どこで見たんだっけ？","nextNodeIds":[746850104,746850108]},{"nodeId":746850104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":795356994,"text":"覚えてないから、見たことないってことで。","nextNodeIds":[746850105]},{"nodeId":746850105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1033235506,"text":"変わった見た目だな。モチーフはスピノクロコっぽいぞ…こいつを見てると、なんだか「ワニワニバンバンキャノン」ってあだ名をつけたくなってくるぜ…","nextNodeIds":[746850106]},{"nodeId":746850106,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":1574019594,"text":"「ワニワニバンバンキャノン」？へぇ、素敵な名前ね！「バンバン」ってまるで…砲弾が的に当たるときの音みたい。簡単で覚えやすいし、ピッタシだわ！","nextNodeIds":[746850107]},{"nodeId":746850107,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":1917680266,"text":"どうやら二人とも、このウォーターキャノンに興味津々のようね！どう、私の最初のお客さんになってみない？","nextNodeIds":[746850112]},{"nodeId":746850112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1500976642,"text":"へへ！おまえの次のセリフ、だいたい予想がつくぜ——","nextNodeIds":[746850113]},{"nodeId":746850113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":76462338,"text":"「このウォーターキャノンは調整が終わったばかりだから、誰かに遊んでもらって、アドバイスをもらいたい」だろ？","nextNodeIds":[746850114]},{"nodeId":746850114,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":1871935946,"text":"わっ、大正解！よく分かったね。過去にも色んな人の協力をしてきたのかな。話が早くて助かるよ！","nextNodeIds":[746850115]},{"nodeId":746850115,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":358743090,"text":"まずは自己紹介させて。私はブレスト。フォンテーヌ科学院兵器研究チームの元艦砲エンジニアだったんだけど、今は失業中なの。","nextNodeIds":[746850116]},{"nodeId":746850116,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":33176842,"text":"生計を立てるために、この「ワニ型サイクロン仕様ワニアーマー対海戦重艦砲式アミューズメント用ハイドロキャノン改良版」の研究を始めたのよ…ウォーターパークでも開こうかなって思ってね。","nextNodeIds":[746850117]},{"nodeId":746850117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3955613554,"text":"待て待て！艦砲エンジニア…失業…ウォーターパーク？だんだん話についていけなくなってきたぞ！","nextNodeIds":[746850118,746850119]},{"nodeId":746850118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2184703394,"text":"いったい何があったの？","nextNodeIds":[746850120]},{"nodeId":746850120,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":945502738,"text":"まあ、時代が変わったんだから仕方ないよ。確かに昔のフォンテーヌにはすごい艦隊があったし、当時は艦砲の需要があった。でも、結局ある戦争で全滅しちゃったから…","nextNodeIds":[746850121]},{"nodeId":746850121,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":2108008162,"text":"今のフォンテーヌはクロックワーク·マシナリーの国。パレ·メルモニアは艦隊を再建するつもりもない。艦砲は高いし、大きくて重いから、活躍する場面がなくなったの。大砲を研究するしか才能がない私みたいにね…","nextNodeIds":[746850122]},{"nodeId":746850122,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":4034865738,"text":"軍事分野にはもう望みがないし、他の分野に変えたほうがいいでしょ。それにどうせ生きるなら、楽しく過ごすのが一番大事だもの！","nextNodeIds":[746850123]},{"nodeId":746850123,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":3281149882,"text":"ウォーターパークを開いて、チケット代を稼いで、日々をのんびり過ごすのも悪くないじゃない？","nextNodeIds":[746850124]},{"nodeId":746850124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2326108794,"text":"ポ、ポジティブっていうか…ぜんぜん慰める必要がないみたいだな…","nextNodeIds":[746850125]},{"nodeId":746850125,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":308893042,"text":"とにかく！嫌なことは一旦忘れて、このワニワニバンバンキャノンの改良版を遊んでみて！すっごく面白いから！","nextNodeIds":[746850126]},{"nodeId":746850126,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":2590614002,"text":"シャティヨンさんの残した設計図をもとに改良を加えてみたの。この新モデルは装填する必要がない上に、弾薬を切り替える機能もついてるのよ！","nextNodeIds":[746850127]},{"nodeId":746850127,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":3587122794,"text":"それに、敵やステージのバリエーションをより豊富にして、アトラクションをもっと挑戦的なものにしてあるの！三日連続で遊んでもまったく飽きないのよ！","nextNodeIds":[746850128]},{"nodeId":746850128,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":1769798698,"text":"遊んだら、きっと悩みが吹き飛ぶくらい楽しいはず！ついでに、もしよかったら他の人にこのアトラクションを宣伝してちょうだい！","nextNodeIds":[746850129,746850130]},{"nodeId":746850129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2288267818,"text":"じゃあ、もう仕事や失業の話はしないよ。","nextNodeIds":[746850131]},{"nodeId":746850131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2142801178,"text":"そこまで言うなら、思いっきり遊ばせてもらうぜ！","nextNodeIds":[746850132]},{"nodeId":746850132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":204349890,"text":"ブレストの言う通り、話がすんなり進んでいい気分だぜ！他のやつも悩みごとがあったら…ブレストの心構えを見習ったらいいな！","nextNodeIds":[]},{"nodeId":746850130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":234124090,"text":"ワニワニバンバンキャノンで遊びたい。","nextNodeIds":[746850131]},{"nodeId":746850119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":410820250,"text":"職業が違いすぎる…","nextNodeIds":[746850120]},{"nodeId":746850108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2313914634,"text":"「ワニワニバンバンキャノン」じゃない？","nextNodeIds":[746850109]},{"nodeId":746850109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1579045042,"text":"あっ！そうそう思い出したぞ。これって「ヴェルーリヤ·ミラージュ」で見た「ワニワニバンバンキャノン」じゃんか！でもウォーターキャノンをいじってるのは…シャティヨンじゃないみたいだな？","nextNodeIds":[746850110]},{"nodeId":746850110,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":4225550010,"text":"シャティヨンさん？あの伝説の大砲設計士を知ってるの？…ってことは、君たちもプロね！","nextNodeIds":[746850111]},{"nodeId":746850111,"roleType":"TALK_ROLE_NPC","speakerId":30565,"speakerName":"ブレスト","textMapHash":2216756402,"text":"二人とも、このウォーターキャノンに縁があるみたいだし、私の最初のお客さんになってみない？","nextNodeIds":[746850112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133405112"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP