s":[745310112]},{"nodeId":745310112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2356208050,"text":"ふーん。まあいいけど、どんな儲け話なんだ？なーんか胡散臭いし、また変なニュースでも聞いて、全財産つぎ込もうとしてるんじゃないだろうな？","nextNodeIds":[745310113]},{"nodeId":745310113,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"レピーヌ・ポーリーン","textMapHash":204256970,"text":"まさか！このレピーヌ・ポーリーンは失敗から学ぶエンジニアですもの！今度こそ正真正銘、絶対に損しない超大型プロジェクトですよ！","nextNodeIds":[745310114]},{"nodeId":745310114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1820785458,"text":"（ちょっと不安になってきた…）","nextNodeIds":[745310115]},{"nodeId":745310115,"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"レピーヌ・ポーリーン","textMapHash":2761713778,"text":"ふふん、今言っちゃったら面白くないでしょう？完成したら、真っ先にご招待しますよ！","nextNodeIds":[]},{"nodeId":745310103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2658125130,"text":"「瞬影」レンズ、かなり良かったよ。","nextNodeIds":[745310104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7453101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30920"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7453101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30965,"speakerName":"レピーヌ・ポーリーン","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":30920,"speakerName":"ニネット","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY