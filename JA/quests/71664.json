erId":null,"speakerName":"旅人","textMapHash":4149745714,"text":"懐かしい内容…","nextNodeIds":[716640105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["2078"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7166402,"order":2,"stepDescription":"層岩巨淵の外に行って、パトリックを探す","stepDescTextMapHash":2515349692,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["30152"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166402],"talks":[{"talkId":7166402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7166402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166402,"initDialog":716640201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30152],"performCfg":"QuestDialogue/WQ/Liyue_71664/Q7166402","priority":5,"questId":71664,"showRandomTalkCount":0},"dialogs":[{"nodeId":716640201,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3915435786,"text":"これ以上遅れるわけにはいかない、一刻も早く検証に入らないと…いざとなったら、自らやるしかないか。","nextNodeIds":[716640202]},{"nodeId":716640202,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1044499890,"text":"「怪我を負って、やむを得ず研究を中止した」と…。この理由なら、時間が稼げるはずだ…","nextNodeIds":[716640203]},{"nodeId":716640203,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":305141770,"text":"命さえあればいいだろう、帰って審判を受けるよりましだ！","nextNodeIds":[716640204]},{"nodeId":716640204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4048344522,"text":"#こいつ、一人でなにをぶつぶつ言ってるんだ？声をかけようぜ、{NICKNAME}。","nextNodeIds":[716640205]},{"nodeId":716640205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":507474738,"text":"#こんにちは、{M#君}{F#あなた}がパトリック？","nextNodeIds":[716640206]},{"nodeId":716640206,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1231831538,"text":"びっくりした！あなたたち、どこから出てきたんだ？…それに、どうして私の名前を？","nextNodeIds":[716640207]},{"nodeId":716640207,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2117923314,"text":"待ってくれ、まさかあなたたちも私服千岩軍なのかい？また私を追い払いに来たとか…？現地考察の許可証ならもう見せたはずだろう！","nextNodeIds":[716640208]},{"nodeId":716640208,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2882793442,"text":"禁区には絶対入らないから！もし信じられないようなら、あの怖そうな短い黒髪のお姉さんに聞けばいいさ！","nextNodeIds":[716640209]},{"nodeId":716640209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":797453362,"text":"誰のことなのか知らないけど、まあまあ、落ち着けって。","nextNodeIds":[716640210]},{"nodeId":716640210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2219815762,"text":"オイラたちは善良な、プロの冒険者なんだ。協会の依頼を受けて、おまえの悩みを解決しに来たんだぞ。","nextNodeIds":[716640211]},{"nodeId":716640211,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":998650114,"text":"救援だったのか？よかった！やっと来てくれたんだね。これで私の研究にも光が見えてきた。そうでなければいずれ、研究のせいでひどい目に遭うところだったよ…","nextNodeIds":[716640212]},{"nodeId":716640212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3175761154,"text":"どうやらおまえは、大分その研究に苦しめられたみたいだな。","nextNodeIds":[716640213]},{"nodeId":716640213,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":626591122,"text":"何を言う！研究という行為そのものは、神聖で高貴なものなんだ！私を苦しめているのは、あくまでも「付加的な要因」だけなのさ。","nextNodeIds":[716640214]},{"nodeId":716640214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":394615354,"text":"「付加的な要因」？例えば？","nextNodeIds":[716640215]},{"nodeId":716640215,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3936807410,"text":"研究が失敗したら死ぬ。","nextNodeIds":[716640216]},{"nodeId":716640216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2965786746,"text":"えっ…？","nextNodeIds":[716640217,716640218]},{"nodeId":716640217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3779967178,"text":"…自暴自棄に聞こえるけど。","nextNodeIds":[716640219]},{"nodeId":716640219,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1632283058,"text":"はぁ、冗談を言ってるんじゃないんだ。","nextNodeIds":[716640220]},{"nodeId":716640220,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1791684874,"text":"個人の研究者は研究をするために資金を申請しなければならない。この資金を使うということは、フォンテーヌの社会的責任を担うに等しい。","nextNodeIds":[716640221]},{"nodeId":716640221,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2229770002,"text":"大金がかかった結果、もし成果を出せなかったら、その人は罪人扱いされて、審判されてしまうんだ！","nextNodeIds":[716640222]},{"nodeId":716640222,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":56962906,"text":"このまま手ぶらで帰ったりすれば、「公有財産の浪費」だけでなく、「学術資源」の占用だとか、他にも数十もの罪に問われるだろう。","nextNodeIds":[716640223]},{"nodeId":716640223,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1269997642,"text":"これらの罪状に対しては最も厳しい処罰が下るだろう…財産と名誉を失うだけならまだしも、審判の結果次第では本当に命を落としてしまうかもしれない！","nextNodeIds":[716640224]},{"nodeId":716640224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1075964298,"text":"えっ？さすがにひどくないか！？","nextNodeIds":[716640225]},{"nodeId":716640225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4154082898,"text":"だから慌てて大金で助手を雇ったのか？","nextNodeIds":[716640226,716640228]},{"nodeId":716640226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":143405114,"text":"フォンテーヌって怖い国だね。","nextNodeIds":[716640227]},{"nodeId":716640227,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":4174684106,"text":"恐ろしいのは「付加的な要因」だ！私の美しい故郷に罪はない！","nextNodeIds":[716640230]},{"nodeId":716640230,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3682256674,"text":"まあ落ち着けって。おまえの未来、それに命がこの研究にかかってるってことはよくわかったから。","nextNodeIds":[716640231]},{"nodeId":716640231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3938509914,"text":"安心しろ、全部オイラたちに任せてくれ！","nextNodeIds":[716640232]},{"nodeId":716640232,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3103181386,"text":"もう今や、あなたたちしか頼れないんだ。","nextNodeIds":[716640233,716640234]},{"nodeId":716640233,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3592060242,"text":"何をすればいい？","nextNodeIds":[716640235]},{"nodeId":716640235,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1628842298,"text":"ああ、さっそく本題に入ろう。私の研究テーマは「振晶映射」だ。","nextNodeIds":[716640236]},{"nodeId":716640236,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2148783010,"text":"簡単に説明すると、鉱物や宝石に含まれる元素力を引き出して、エネルギーとして利用するということさ。","nextNodeIds":[716640237]},{"nodeId":716640237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":431386738,"text":"便利そうだな！実用的だし、面白い機械を作れそうだ…","nextNodeIds":[716640238]},{"nodeId":716640238,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2493181394,"text":"でも、そこの宝石とおまえが言ったなんちゃら晶なんちゃら映とには、なんの関係があるんだ？","nextNodeIds":[716640239]},{"nodeId":716640239,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2817081138,"text":"「振晶」がこういう宝石のことなのかな。","nextNodeIds":[716640240]},{"nodeId":716640240,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":477216242,"text":"正解！少し前にある人が宝石の元素力を引き出した時、一部の特殊な宝石の間では奇妙な共鳴が起こるということに気付いたんだ。","nextNodeIds":[716640241]},{"nodeId":716640241,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":668897634,"text":"そして、このような宝石を「振晶」と呼ぶことにした。","nextNodeIds":[716640242]},{"nodeId":716640242,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2082344778,"text":"「振晶」中の「発振晶」が特定の刺激を受けるとエネルギーを放出し、「受振晶」の共鳴を引き出す。","nextNodeIds":[716640243]},{"nodeId":716640243,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2509870818,"text":"二つの「振晶」の放つエネルギーが重なり合えば、そのパワーは倍増する！私はこの共鳴を「映射」現象と名付けた。","nextNodeIds":[716640244]},{"nodeId":716640244,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":110213026,"text":"今、研究は私が導き出した「映射関係」を検証するという、重要な段階を迎えているのさ。","nextNodeIds":[716640245,716640246]},{"nodeId":716640245,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1919106474,"text":"何か、予感が…","nextNodeIds":[716640247]},{"nodeId":716640247,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1779021778,"text":"今までの経験から察するに、オイラたちに「振晶」の力を借りて魔物を倒してくれってことか？それで、さっき言ってたその「映射関係」を検証したがってる、そうだろ？","nextNodeIds":[716640248]},{"nodeId":716640248,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2788408066,"text":"大正解だ！あなたたちは呑み込みが早いな！","nextNodeIds":[716640249]},{"nodeId":716640249,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":644855946,"text":"適切なエリアに何セットかの「振晶」で作られた石碑をすでに設置したから、準備ができたら私を呼んでくれ。","nextNodeIds":[716640250]},{"nodeId":716640250,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":235500018,"text":"検証が必要な項目は詳しく説明するから、私のヒントに従って戦ってくれればいい。","nextNodeIds":[716640251]},{"nodeId":716640251,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3435799306,"text":"これって、オイラたちには退屈なほど、一番得意な仕事だよな。","nextNodeIds":[716640252,716640254]},{"nodeId":716640252,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":666641194,"text":"興味が湧いた…","nextNodeIds":[716640253]},{"nodeId":716640253,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2527097202,"text":"おまえはもう数え切れないほど強大な敵をやっつけて来ただろ？これくらい、ちょちょいのちょいだよな！","nextNodeIds":[716640256]},{"nodeId":716640256,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3161689106,"text":"すごい勢いだ！璃月はいいところだなぁ。宝石の原石だけでなく、こんなに頼もしい冒険者までいるなんて！","nextNodeIds":[716640257]},{"nodeId":716640257,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":608727130,"text":"材料の費用を節約するため、遠路はるばる来た甲斐があったよ。","nextNodeIds":[716640258]},{"nodeId":716640258,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2343953442,"text":"元々足が出ることに悩んでいたんだが、あなたたちの報酬を払っても尚、資金はまだ二割ほど残っているんだ。","nextNodeIds":[716640259]},{"nodeId":716640259,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1939304458,"text":"もしうまくいったら、その金で新聞社の人を雇って、私の成果をトップ記事として宣伝してもらおうと思ってね。","nextNodeIds":[716640260]},{"nodeId":716640260,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":94843202,"text":"タイトルはもう考えてある。それが、「衝撃の事実！パトリックの振晶に関する研究！」だ。","nextNodeIds":[716640261]},{"nodeId":716640261,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1592286682,"text":"真面目にやれよ！そのタイトル、どう聞いても学術的な文章に合ってないだろ！","nextNodeIds":[716640262]},{"nodeId":716640262,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":4014382426,"text":"投資してもらうには、奇抜で目立つタイトルが必要なんだ！そしたら、配当金の相談もできる。","nextNodeIds":[716640263]},{"nodeId":716640263,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3799795330,"text":"配当金？なにを言ってるんだ…","nextNodeIds":[716640264]},{"nodeId":716640264,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":76917394,"text":"もし「振晶映射」の理論が商品の生産に応用されれば、沢山の利益を得られるはずだ。そうすれば、一定の割合であなたたちに分けることもできる。","nextNodeIds":[716640265]},{"nodeId":716640265,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":729899818,"text":"当然、研究が上手く行けばだけどね…","nextNodeIds":[716640266]},{"nodeId":716640266,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":532392890,"text":"そんなうまい話があるのかよ！よっしゃー！やる気が出てきたぞ！タイトルなんか、好きなのを選べ！","nextNodeIds":[716640267,716640268]},{"nodeId":716640267,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2485797914,"text":"パイモン…","nextNodeIds":[716640269]},{"nodeId":716640269,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3902561562,"text":"#とにかく{NICKNAME}、さっさと終わらせようぜ！","nextNodeIds":[716640270]},{"nodeId":716640270,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":972806034,"text":"そしたら、パトリックとも配当金のことについて話せるしな、へへへっ…","nextNodeIds":[]},{"nodeId":716640268,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":286724498,"text":"よだれをたらさんばかりだね…","nextNodeIds":[716640269]},{"nodeId":716640254,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2006081538,"text":"パイモンもやってみる？","nextNodeIds":[716640255]},{"nodeId":716640255,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2477496450,"text":"オオオ、オイラはただ、おまえに面白くて挑戦に満ちた依頼を受けてほしいだけだ…別に文句を言ってるわけじゃないぞ！","nextNodeIds":[716640256]},{"nodeId":716640246,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":965045834,"text":"もう分かった…","nextNodeIds":[716640247]},{"nodeId":716640234,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1420845234,"text":"研究テーマを教えて。","nextNodeIds":[716640235]},{"nodeId":716640228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1776160818,"text":"「付加的な要因」、恐ろしい…","nextNodeIds":[716640229]},{"nodeId":716640229,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1555922218,"text":"その点については、まあ一長一短というところだな。罪人扱いされない限りは、様々な便宜を図ってもらえる。フォンテーヌ出身の人々なら誰でも、この恩恵を受けたことがあるだろう。","nextNodeIds":[716640230]},{"nodeId":716640218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2616421682,