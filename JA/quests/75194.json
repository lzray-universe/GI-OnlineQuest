":751940401,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":377032186,"text":"ふぅ…よかった。結果を見る限り、火山の状態は思ったより深刻じゃなかったみたい。これでみんなも安心して眠りにつけるわ…","nextNodeIds":[751940402]},{"nodeId":751940402,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":894201554,"text":"これもあなたたちが前のことを水に流して助けてくれたおかげね。じゃなかったらここまでスムーズにはいかなかったわ。","nextNodeIds":[751940403]},{"nodeId":751940403,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":3713620362,"text":"どうかこの報酬を受け取ってちょうだい。これは私個人のお詫びと感謝の気持ちよ！","nextNodeIds":[751940404]},{"nodeId":751940404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":540731466,"text":"へへっ、おまえがそう言うなら、遠慮なく！","nextNodeIds":[751940405]},{"nodeId":751940405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2193379754,"text":"これからどうするの？","nextNodeIds":[751940406]},{"nodeId":751940406,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1686232178,"text":"まだ手元に売れ残りの商品があるから、それをうまく捌けば資金のほうもなんとかなるわ。","nextNodeIds":[751940407]},{"nodeId":751940407,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":3430973930,"text":"もちろん、今回は緊急事態じゃないから、ちゃんと誠実に商売するわよ。安心してちょうだい。","nextNodeIds":[]}]},{"talkId":7519405,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7519404","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7519405,"initDialog":751940501,"nextRandomTalks":[],"nextTalks":[],"npcId":[6459],"performCfg":"","priority":5,"questId":75194,"showRandomTalkCount":0},"dialogs":[{"nodeId":751940501,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":4225126658,"text":"十、二十…これだけ売れたらしばらく資金には困らずに済みそうね…","nextNodeIds":[751940502,751940510]},{"nodeId":751940502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1291953586,"text":"もう少し稼いでおかなくていいの？","nextNodeIds":[751940503]},{"nodeId":751940503,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":886733074,"text":"ふふっ、もう十分よ。欲張らずにここでやめておくわ！もしあなたがあの時手を貸してくれなかったら、あの玉帛のせいで確実にトラブルに巻き込まれてたでしょうから。","nextNodeIds":[751940504]},{"nodeId":751940504,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":4142809010,"text":"それに、毎日お金のことばかり考えてるのも退屈でしょ？私にとって商売はただの趣味、本当に大事なのは火山の観測だからね。","nextNodeIds":[751940505]},{"nodeId":751940505,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1057037994,"text":"お金は稼げば済む話だけど、私がもし火山噴火の予兆を見逃したりしたら…それこそ取り返しがつかなくなるわ。","nextNodeIds":[751940506]},{"nodeId":751940506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":802258818,"text":"「談議室」から経費は出ないの？","nextNodeIds":[751940507]},{"nodeId":751940507,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":3552441594,"text":"申請なんてしてないわよ。「談議室」の族長たちも常にいろんな問題に悩まされてるからね…これ以上負担を増やすわけにはいかないでしょ？","nextNodeIds":[751940508]},{"nodeId":751940508,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1608310938,"text":"それに、彼らと私たちはちょっと違うから。普段から旅をしながら自分たちで稼いでる分、こういう生活にも慣れっこだからね。","nextNodeIds":[751940509]},{"nodeId":751940509,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":2489737594,"text":"旅のついでに火山を観察するくらい、別に大したことじゃないわ。あなたたちが困ってる人を見かけたら助けてるのと同じで、気楽なものよ！","nextNodeIds":[]},{"nodeId":751940510,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":291817554,"text":"またね。","nextNodeIds":[751940511]},{"nodeId":751940511,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1499708346,"text":"ふふ、またね！縁があったらまたどこかで会いましょ！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7519404,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133515117"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6459"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7519401,7519404,7519405,7519406,7519407,7519408,7519409],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","count