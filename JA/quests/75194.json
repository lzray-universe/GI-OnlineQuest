"","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7519401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7519401,"initDialog":751940101,"nextRandomTalks":[],"nextTalks":[],"npcId":[6459,1005],"performCfg":"QuestDialogue/WQ/Natlan_75194/Q7519401","priority":5,"questId":75194,"showRandomTalkCount":0},"dialogs":[{"nodeId":751940101,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1217420234,"text":"ちょっと、ちょっと待ちなさい！これは商品よ、買わないなら触らないで！…あら？そこの金髪のあなた、そう、あなたよ。そんなに急いでどこへ行くの？ちょっと顔を見せなさいな。","nextNodeIds":[751940102]},{"nodeId":751940102,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":4207451578,"text":"ふむ——やっぱりね。太陽みたいに輝く髪、夜神の国を思わせる深い瞳…これは予想じゃなくて確信よ。あなた、将来すごい人物になるわ。","nextNodeIds":[751940103]},{"nodeId":751940103,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":3589076466,"text":"見て、ちょうどいいものがあるの。はい、特別な翡翠をあしらった装飾品よ。この中には様々な旋律が宿ってて、大英雄のあなたにぴったりだと思うわ！","nextNodeIds":[751940104]},{"nodeId":751940104,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1867737898,"text":"ただ、これはとんでもないお宝だから、普通の人が買いに来たら最低でも一千万モラはもらうわ。でも、あなたとこの飾りには縁を感じるの…だから、特別に九割引きにしてあげる！どう？悪い話じゃないでしょ？","nextNodeIds":[751940105]},{"nodeId":751940105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2482719610,"text":"えっ、九割引き！？めちゃめちゃお得じゃないか！でも待てよ…それでも百万モラもするぞ！高すぎるだろ！","nextNodeIds":[751940106]},{"nodeId":751940106,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1639378706,"text":"はぁ、仕方ないでしょ…これでも経費ギリギリなんだから。私たちみたいなしがない商人は楽じゃないのよ…","nextNodeIds":[751940107,751940108]},{"nodeId":751940107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1177472522,"text":"だからってそんな稼ぎ方はダメだよ…","nextNodeIds":[751940109]},{"nodeId":751940109,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":4129646026,"text":"あら、聞かれてたのね。あはは…もう、私ったらつい独り言が…","nextNodeIds":[751940110]},{"nodeId":751940110,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":27546194,"text":"はぁ——この際だから正直に話すわ。この玉帛、実は拾ったものなの。だから、そんなに高い値がついてたわけじゃない。","nextNodeIds":[751940111]},{"nodeId":751940111,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1978287642,"text":"でも、どうしようもないのよ。見ての通りうちは資金不足で、浮標のデータ回収員すら雇えないんだから…","nextNodeIds":[751940112]},{"nodeId":751940112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1100028066,"text":"じゃあ、データなんか回収しなきゃいいだろ！人を騙すよりマシだぞ。","nextNodeIds":[751940113]},{"nodeId":751940113,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1801723890,"text":"それはダメよ…普通の組織なら活動を休止すればいいだけだけど、私たちのボランティア活動には火山観測の任務も入ってるの。","nextNodeIds":[751940114]},{"nodeId":751940114,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":3395364314,"text":"浮標を設置したのも、水温データなんかを集めて火山の活動を監視するためなのよ。","nextNodeIds":[751940115]},{"nodeId":751940115,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":2664366322,"text":"それに、今は火山の活動がどんどん活発になってきてるから、急いで浮標を回収しないと大変なことになるかもしれないの。","nextNodeIds":[751940116]},{"nodeId":751940116,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1196032474,"text":"私がケガさえしなければ、浮標を壊すことなく、中のデータもちゃんと回収できたはずなのに…","nextNodeIds":[751940117]},{"nodeId":751940117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3001035642,"text":"#なぁ{NICKNAME}、オイラたち、手伝ってあげたほうがいいんじゃないか…？火山の問題はみんなの安全にも関わるし、見て見ぬふりはできないよな…","nextNodeIds":[751940118]},{"nodeId":751940118,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":3481379354,"text":"ほ、ホント！？もしあなたたちが手伝ってくれるなら、この玉帛はタダであげるわ！報酬として受け取ってちょうだい。それでどうかしら？","nextNodeIds":[751940119,751940120]},{"nodeId":751940119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":115914562,"text":"百万って言ってたような…","nextNodeIds":[751940121]},{"nodeId":751940121,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":1204176346,"text":"心配しないで。あまり多くはないけど、玉帛のほかにも何か用意するから。","nextNodeIds":[751940122]},{"nodeId":751940122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4111208250,"text":"へへっ、玉帛だけで十分だぜ！火山周辺のみんなを守ることが最優先だからな！とにかく、安心して任せてくれ！","nextNodeIds":[751940123,751940124]},{"nodeId":751940123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2803169626,"text":"さっそく始めよう。","nextNodeIds":[]},{"nodeId":751940124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1048251434,"text":"もうちょっと準備させて。","nextNodeIds":[751940125]},{"nodeId":751940125,"roleType":"TALK_ROLE_NPC","speakerId":6459,"speakerName":"クリマナ","textMapHash":4270318634,"text":"ええ、こっちはいつでもOKよ！","nextNodeIds":[]},{"nodeId":751940120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1101481202,"text":"え…玉帛だけ？","nextNodeIds":[751940121]},{"nodeId":751940108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2468512578,"text":"百万モラはボッタクリじゃない？","nextNodeIds":[751940109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7519401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133515117"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6459"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7519402,"order":3,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[0,1],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_VAR_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["6459"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7519406,7519407,7519408],"talks":[{"talkId":7519406,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXE