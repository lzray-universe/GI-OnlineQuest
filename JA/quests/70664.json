:30153,"speakerName":"宏朗","textMapHash":611321834,"text":"毎回毎回、俺に面倒な仕事を押し付けて…","nextNodeIds":[706640102,706640103]},{"nodeId":706640102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1850375426,"text":"#あれ？{M#君}{F#あなた}は…","nextNodeIds":[706640104]},{"nodeId":706640104,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":189883794,"text":"おお、お前か！ここで会うなんて思わなかった、奇遇だね。","nextNodeIds":[706640105]},{"nodeId":706640105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1549571834,"text":"何してるの？","nextNodeIds":[706640106]},{"nodeId":706640106,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3911197282,"text":"はぁ、前回のあの変な秘境…覚えてるだろう？あの、内部構造が人の心によって変わる秘境のことだ。","nextNodeIds":[706640107]},{"nodeId":706640107,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":685960370,"text":"お前のおかげで俺は秘境に入り、たくさんの情報を得た。そしてあの秘境が消えた後、俺は嵐姉に報告をした。","nextNodeIds":[706640108]},{"nodeId":706640108,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":1565485338,"text":"お前の助けがあったから、俺はちょっとしたサポートしかしていないと、何度も彼女に説明したのに。","nextNodeIds":[706640109]},{"nodeId":706640109,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":917138098,"text":"嵐姉は俺の仕事を認めたとか言って、チームを連れてこの未知の秘境を探索してこいって言うんだ。","nextNodeIds":[706640110,706640111]},{"nodeId":706640110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2993312322,"text":"悪くない話だと思う。","nextNodeIds":[706640112]},{"nodeId":706640112,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3069770650,"text":"どこがいいんだよ。俺はただの普通の冒険者だ。自由気ままに、好きなことをしたい。","nextNodeIds":[706640113]},{"nodeId":706640113,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2491116898,"text":"稼ぎは多くないけど、自由は何ものにも代えがたい。でも嵐姉が肩書きを押し付けてきて、俺も断れなくて。はぁ…","nextNodeIds":[706640114]},{"nodeId":706640114,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":940683002,"text":"それより見てくれ、この扉。この向こうには、また奇妙な秘境が広がってる。","nextNodeIds":[706640115]},{"nodeId":706640115,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2337146274,"text":"そして、中に「風域」がたくさんあるんだ。","nextNodeIds":[706640116]},{"nodeId":706640116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":469127586,"text":"#{M#俺}{F#私}が知っている、あの「風域」？","nextNodeIds":[706640117]},{"nodeId":706640117,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2329794130,"text":"そうそう。野外にあるあれだ…風がヒューヒューと吹く風域だよ。冒険者たちは風の翼を使う時、風域の力を借りればさらに高く飛べる。","nextNodeIds":[706640118]},{"nodeId":706640118,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2814674218,"text":"でも、この秘境の「風域」はとても複雑だ。時に風域は互いに干渉しあい、飛行を阻むエリアを作る。","nextNodeIds":[706640119]},{"nodeId":706640119,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":300732882,"text":"風の翼の操作が得意な冒険者を何人か探索に行かせたけど、しばらくすると戻されてね。","nextNodeIds":[706640120]},{"nodeId":706640120,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2988519938,"text":"彼らの話によると、この秘境には装置がある。装置を起動すると、風域の状況も変わるらしい…","nextNodeIds":[706640121]},{"nodeId":706640121,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2507046962,"text":"でも彼らがその装置の役目を解明する前に、大量の魔物が現れた。彼らは撤退するしかなかったそうだよ。","nextNodeIds":[706640122]},{"nodeId":706640122,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2454051746,"text":"だが、それらの装置を活用すれば、この秘境を上手く探索できるのではないかと、俺たちは考えた…","nextNodeIds":[706640123,706640124]},{"nodeId":706640123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2935785962,"text":"探索に行ったことはあるの？","nextNodeIds":[706640125]},{"nodeId":706640125,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3886393130,"text":"それは…お前も知っての通り、俺はその…身体能力が低くてな。風の翼もうまく操れないんだ。","nextNodeIds":[706640126]},{"nodeId":706640126,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2289341514,"text":"普通の飛行ならまだしも、この秘境の風域の状況では…","nextNodeIds":[706640127]},{"nodeId":706640127,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3231604346,"text":"俺が探索に行っても、あちこち吹き飛ばされて、最終的に魔物の群れの中に落ちるだけだろう。","nextNodeIds":[706640128]},{"nodeId":706640128,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2534124586,"text":"旅人、お前の実力は前回の件で分かった。お前は身体能力も抜群で、頭の回転も速い…","nextNodeIds":[706640129]},{"nodeId":706640129,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":890610602,"text":"よかったら、この秘境を探索してきてくれないか？","nextNodeIds":[706640130]},{"nodeId":706640130,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3493789882,"text":"報酬は心配ない。前回のように、ちゃんとたっぷり用意するから。","nextNodeIds":[706640131,706640133]},{"nodeId":706640131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2646289514,"text":"やってみる。","nextNodeIds":[706640132]},{"nodeId":706640132,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":2563714946,"text":"よかった。それじゃ頼んだぞ！","nextNodeIds":[]},{"nodeId":706640133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2980945562,"text":"宝物はある？","nextNodeIds":[706640134]},{"nodeId":706640134,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":1914753210,"text":"それは俺にも分からない。俺たちはあまり探索できなかったから…","nextNodeIds":[706640135]},{"nodeId":706640135,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3133833618,"text":"まあでも…安心しろ！探索で発見した宝物は、お前がそのまま受け取ってくれていい。","nextNodeIds":[706640136]},{"nodeId":706640136,"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","textMapHash":3665244610,"text":"じゃあ頼んだよ、旅人。","nextNodeIds":[]},{"nodeId":706640124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2666237042,"text":"先陣を切ったりしなかったの？","nextNodeIds":[706640125]},{"nodeId":706640111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2095067322,"text":"いいことだと思う。","nextNodeIds":[706640112]},{"nodeId":706640103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3964394282,"text":"また会ったね。","nextNodeIds":[706640104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7066401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30153"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7066401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30153,"speakerName":"宏朗","count":26},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170664],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3678800334,"CHECNJEMEFE":{"30153":[1240]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70664/Q7066401","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIID