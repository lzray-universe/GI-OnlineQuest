{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7602104,"initDialog":760210401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"","priority":5,"questId":76021,"showRandomTalkCount":0},"dialogs":[{"nodeId":760210401,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":129603530,"text":"今日も収穫ナシか…","nextNodeIds":[760210402,760210405,760210412,760210417,760210421]},{"nodeId":760210402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":786864850,"text":"何してるの？","nextNodeIds":[760210403]},{"nodeId":760210403,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1174675906,"text":"釣りじゃ。今のとこ、魚じゃない変なものばかり釣れとるがな。","nextNodeIds":[760210404]},{"nodeId":760210404,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":210288682,"text":"もし沈没船の小物なんかが釣れれば、行商人が買い取ってくれるんじゃがな。前に釣り上げた靴なんか…おっと、あんまり話すと魚が逃げちまうな。","nextNodeIds":[]},{"nodeId":760210405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1326305682,"text":"この辺りで何か気になったことはない？","nextNodeIds":[760210406]},{"nodeId":760210406,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3623856010,"text":"また宝探しか？月の東、太陽の西にしかない「偉大なる財宝」なんてものは…聞いただけで、ここにはないとわかるじゃろう。","nextNodeIds":[760210407]},{"nodeId":760210407,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3599126202,"text":"ここは昔から船の海難事故が多い場所なんじゃ。沈没船の中には確かに価値のあるものもあるかもしれんがな、見つけ出すのはそう簡単じゃないぞ。","nextNodeIds":[760210408]},{"nodeId":760210408,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3061881066,"text":"これは酒場で生き残った船乗りから聞いた話なんじゃが…その夜は月もないのに、荒れ狂う大波の中に光る物が見えたんじゃと。","nextNodeIds":[760210409]},{"nodeId":760210409,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3977034210,"text":"間違いなく隻眼のケラティに違いないと言っておったのう。月さえも飲み込む怪物が、海の巨蛇と縄張り争いをしておったのじゃと。","nextNodeIds":[760210410]},{"nodeId":760210410,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3293174234,"text":"その後は長いこと、このあたり一帯が、まるでインク壺をひっくり返したみたいに真っ黒じゃったわい。どの船も怖がって、通らんようになってのう…みんな、水底の亡霊に引きずり込まれるんじゃないかと震え上がっとったもんじゃ。","nextNodeIds":[760210411]},{"nodeId":760210411,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3579681186,"text":"亡霊たちは今でもこの辺りを彷徨っておるかもしれんが…わしには見えとらんから気にならん。","nextNodeIds":[]},{"nodeId":760210412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2864552066,"text":"あの木について…","nextNodeIds":[760210413]},{"nodeId":760210413,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2155836994,"text":"あの木はちょっと不気味でのう。元々ここいらには渦が出るもんでな、船乗りたちはケラティの眼と呼んでおったんじゃが、ある日突然、生えてきおったんじゃ。","nextNodeIds":[760210414]},{"nodeId":760210414,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3176552162,"text":"あの頃起きたおかしなことと言えば、それだけじゃなかったのう。考えてみれば、石っころが空から降ってきた後のことじゃ…もしかしたら、この木も石っころと同じように天外から来たのやもしれんな。","nextNodeIds":[760210415]},{"nodeId":760210415,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1496692402,"text":"たびたび見かけるキラキラした小物も、珍しいものばかりじゃ。ひょっとして、新種の魚でもおるのかもしれんと思って、運試しに来とるんじゃ。","nextNodeIds":[760210416]},{"nodeId":760210416,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3240434842,"text":"もともとは、わしの釣り仲間も一緒に来とったんじゃが…妙な歌声が聞こえると言い出しおってな、怖じ気づいて来なくなってしもうた。半分霜月の子なんじゃが、悪癖はまるっきり、そのものじゃわい。","nextNodeIds":[]},{"nodeId":760210417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1674042794,"text":"「識者の証」について…","nextNodeIds":[760210418]},{"nodeId":760210418,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1897626010,"text":"「識者の証」だの、月の東、太陽の西に眠る「偉大なる財宝」だの…わしに言わせれば…","nextNodeIds":[760210419]},{"nodeId":760210419,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1071838946,"text":"欲に目がくらんで本来手にすべきでないものを追いかけるから、ろくなことにならんのじゃ。アトラス号船長のグレティルも、その「宝」に心を奪われて、破滅したそうじゃぞ。","nextNodeIds":[760210420]},{"nodeId":760210420,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":388382530,"text":"結局は海の底に沈む羽目になって、宝は何一つ手に入らんかった。骨折り損のくたびれ儲けじゃよ。","nextNodeIds":[]},{"nodeId":760210421,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1175378618,"text":"邪魔したね。","nextNodeIds":[760210422]},{"nodeId":760210422,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":512876026,"text":"構わん構わん。どうせ魚の影も見えんからの。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7602104,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7602101,7602102,7602103,7602104],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2059126086,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADF