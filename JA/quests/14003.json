uleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1400302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1400301,"initDialog":140030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1071,1070,1072],"performCfg":"QuestDialogue/LQ/Liney1_14003/Q1400301","priority":5,"questId":14003,"showRandomTalkCount":0},"dialogs":[{"nodeId":140030101,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":4251713706,"text":"ごめんね、シャルロットさん。今日は僕もリネットも忙しくて、取材はちょっと…","nextNodeIds":[140030102]},{"nodeId":140030102,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":719449434,"text":"さほどお時間は取らせませんから——どうかお願いします、リネさん！","nextNodeIds":[140030103]},{"nodeId":140030103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":447577466,"text":"えっ、なにかあったのか？","nextNodeIds":[140030104]},{"nodeId":140030104,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1632007930,"text":"遅くまで怪盗マーテンのコラムを書いてて、今朝新聞に発表しようと思ってたんだけど…","nextNodeIds":[140030105]},{"nodeId":140030105,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3868767898,"text":"——明け方急に情報が入ったの。なんと、セサルの婚約者だったジェマが、自分こそ真の怪盗マーテンだって警察隊に自首したそうよ！","nextNodeIds":[140030106]},{"nodeId":140030106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3394241914,"text":"もう認めたのか！？","nextNodeIds":[140030107]},{"nodeId":140030107,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":3315158730,"text":"コホンッ。","nextNodeIds":[140030108]},{"nodeId":140030108,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":658276850,"text":"あれ？","nextNodeIds":[140030109]},{"nodeId":140030109,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"リネット","textMapHash":2188655802,"text":"もう遅いよ、お兄ちゃん。","nextNodeIds":[140030110]},{"nodeId":140030110,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":177684546,"text":"ふふ…第一声が「もう認めたのか」ってことは、すでにあなたたちは真相を知ってたのね。","nextNodeIds":[140030111]},{"nodeId":140030111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3683238706,"text":"はっ！","nextNodeIds":[140030112]},{"nodeId":140030112,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3431598314,"text":"やっぱり私の予感は的中ね。何か、隠してるんでしょ？ジェマが自首したわけは…昨晩のリネさんのマジックショーと関わってるはずよ！","nextNodeIds":[140030113]},{"nodeId":140030113,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":823186570,"text":"高所脱出マジックを観たジェマさんは、セサルさんと過ごした日々を思い出して、良心が痛んだんじゃないかい？","nextNodeIds":[140030114]},{"nodeId":140030114,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1234161898,"text":"なるほど——って、そんなはずありません。そう簡単に良心が痛むなら、この十年間、彼女は一体何をしてたんですか？","nextNodeIds":[140030115]},{"nodeId":140030115,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":1370427634,"text":"それは…","nextNodeIds":[140030116]},{"nodeId":140030116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2050254146,"text":"（シャルロットの記者魂がメラメラ燃え盛っちゃってるみたい。何とか注意を引かないと…）","nextNodeIds":[140030117]},{"nodeId":140030117,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":2364992946,"text":"そういえば！昨日のマジックショーの後、あなたたちもジェマもいなくなりましたよね…まさかあの時に？","nextNodeIds":[140030118]},{"nodeId":140030118,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3393065250,"text":"突然ですが、聞かせてもらえますか。ショーの後、あなたたちはどこへ行ってたんです？","nextNodeIds":[140030119]},{"nodeId":140030119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3610961594,"text":"ショーの後？オイラたちとリネは墓地に行ったんだぞ。リネがオイラたちにだけ、マジックを見せてくれたんだ！","nextNodeIds":[140030120]},{"nodeId":140030120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":977571586,"text":"そういやおまえの話のおかげか、リネはマジックで「レインボーローズ」を使うようになってたよな！","nextNodeIds":[140030121]},{"nodeId":140030121,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":3520816186,"text":"コホン…","nextNodeIds":[140030122]},{"nodeId":140030122,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"リネット","textMapHash":3079313730,"text":"…ん？","nextNodeIds":[140030123]},{"nodeId":140030123,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"リネット","textMapHash":3508381442,"text":"私だってお兄ちゃんからレインボーローズをもらった記憶はないのに。つまりお兄ちゃんは、私より旅人たちのほうが大事なの…？","nextNodeIds":[140030124]},{"nodeId":140030124,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":1265347578,"text":"それは違う！あれは…","nextNodeIds":[140030125]},{"nodeId":140030125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2878778682,"text":"なな、なんでおまえまでそんな反応するんだ？オイラまたマズイこと言っちゃったのか？","nextNodeIds":[140030126]},{"nodeId":140030126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":269047602,"text":"変な空気になっちゃったぞ…旅人、オイラたちどうすればいいんだ…？","nextNodeIds":[140030127]},{"nodeId":140030127,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":94694394,"text":"はぁ、どうやら今日は取材できる感じじゃないみたい。まあいいか、また今度来るわ。","nextNodeIds":[140030128]},{"nodeId":140030128,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1789349938,"text":"しつこくしてごめんなさいね。でもこんなにインパクトのあるニュース、放っておくわけにはいかないわ！ジェマの情報が広がって、世の中は大騒ぎよ。この裏にある真実を必ずつきとめて見せる！","nextNodeIds":[140030129]},{"nodeId":140030129,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1369043010,"text":"彼女は警察隊にこう伝えたらしいわ——「最後の願いは、もう一度ロレンツォに会うことよ」って。はぁ…複雑な関係よね。とっても気になっちゃう。","nextNodeIds":[140030130]},{"nodeId":140030130,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":4214593882,"text":"とりあえずお先に失礼するわね。ごゆっくり！","nextNodeIds":[140030131]},{"nodeId":140030131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4286934082,"text":"えっと、リネット、実は…","nextNodeIds":[140030132]},{"nodeId":140030132,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"リネット","textMapHash":1759992546,"text":"大丈夫、別に怒ってない。彼女の注意をひきたかっただけ。","nextNodeIds":[140030133]},{"nodeId":140030133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3574025002,"text":"なるほど…オイラびっくりしちゃったぞ。","nextNodeIds":[140030134]},{"nodeId":140030134,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":3342832018,"text":"ふぅ、僕も危うく騙されるところだったよ…幸い効果はてきめんだったね？","nextNodeIds":[140030135]},{"nodeId":140030135,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"リネット","textMapHash":2766785362,"text":"…レインボーローズ、大切にして。","nextNodeIds":[140030136]},{"nodeId":140030136,"roleType":"TALK_ROLE_NPC","speakerId":1072,"speakerName":"リネット","textMapHash":737844762,"text":"失くしちゃったら、私も悲しくなるから。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1400301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1400301","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{