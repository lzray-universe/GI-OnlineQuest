295"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7151201],"talks":[{"talkId":7151201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7151201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7151201,"initDialog":715120101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30295],"performCfg":"","priority":5,"questId":71512,"showRandomTalkCount":0},"dialogs":[{"nodeId":715120101,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":2577862714,"text":"まったく…この区域はもう片付けたのか？ん…終わってるはずか…","nextNodeIds":[715120102]},{"nodeId":715120102,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":308995962,"text":"はぁ、参ったな…","nextNodeIds":[715120103]},{"nodeId":715120103,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":3444859754,"text":"ん…あっ！旅人！すまない。忙しすぎて、君が来たことに気付いていなかったよ。","nextNodeIds":[715120104]},{"nodeId":715120104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2135265362,"text":"何が忙しいの？","nextNodeIds":[715120105]},{"nodeId":715120105,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":2523893666,"text":"はぁ…今年の海灯祭では、俺たち璃月港の冒険者協会も総務司の管理のもとで、様々な手伝いをしてるんだ。","nextNodeIds":[715120106]},{"nodeId":715120106,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":2903457290,"text":"千岩軍は主に城内の重要区域の見回りを担当してる。俺たちはというと、野外にいる魔物の片付けとか…あとは、賊を追い払ったりしてる。","nextNodeIds":[715120107]},{"nodeId":715120107,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":1242906554,"text":"そうだ…そういえば君も協会に登録している冒険者だったよな。君の冒険譚をいくつも聞いたことがある。","nextNodeIds":[715120108]},{"nodeId":715120108,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":1321008586,"text":"もしよかったら、少し手伝ってくれないか？","nextNodeIds":[715120109,715120110]},{"nodeId":715120109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4134596594,"text":"お祭りなのに…","nextNodeIds":[715120111]},{"nodeId":715120111,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":868005674,"text":"まあ…祭り期間中は総務司の手伝いをするから、総務司からも特別に報酬が用意されてるんだ。","nextNodeIds":[715120112]},{"nodeId":715120112,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":4040439354,"text":"この類の依頼を引き受けてくれた冒険者は、依頼を完了した後、より多くの報酬を得られる…","nextNodeIds":[715120113,715120115]},{"nodeId":715120113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2044762602,"text":"具体的に…どれくらい？","nextNodeIds":[715120114]},{"nodeId":715120114,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":2681037074,"text":"絶対に納得のいく報酬だ、信じてくれ！","nextNodeIds":[715120123]},{"nodeId":715120123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":574674410,"text":"まずは仕事がどれくらいあるのか見ないと…","nextNodeIds":[715120116]},{"nodeId":715120116,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":1601583250,"text":"はははっ、よし！君ならきっとやってくれると思っていたよ。まずは協会が確認した地点をマークしておいてあげよう。それから、この小型の花火の筒を持っていくといい。","nextNodeIds":[715120117]},{"nodeId":715120117,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":1941780890,"text":"もし依頼を引き受けてくれるなら…区域を片付けた後、この花火の筒で花火を打ち上げてくれ。","nextNodeIds":[715120118]},{"nodeId":715120118,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":1157647218,"text":"花火が上がったら、こっちから記録員を派遣して、その区域を「片付け済み」に印付ける。","nextNodeIds":[715120119]},{"nodeId":715120119,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":2413506842,"text":"我々は、各区域の片付け具合に基づいて、リアルタイムで計画を調整する。","nextNodeIds":[715120120]},{"nodeId":715120120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":916159298,"text":"結構細かい計画だね…","nextNodeIds":[715120121]},{"nodeId":715120121,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":2069632962,"text":"はぁ…何といっても海灯祭だからな、間違いが起こってはならない。だから…息抜きをする余裕もなくて。","nextNodeIds":[715120122]},{"nodeId":715120122,"roleType":"TALK_ROLE_NPC","speakerId":30295,"speakerName":"詔勤","textMapHash":487611034,"text":"話はこれで終わりだ。そろそろ状況を確認しに行かないと。それと、嵐姉への報告も…","nextNodeIds":[]},{"nodeId":715120115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2993597122,"text":"先にどれくらいやらないとなのか見せて…","nextNodeIds":[715120116]},{"nodeId":715120110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":926413482,"text":"海灯祭なのに…","nextNodeIds":[715120111]}]}