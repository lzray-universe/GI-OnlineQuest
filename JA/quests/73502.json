{"nodeId":735020305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2134699210,"text":"どうして謎解きを作るの？","nextNodeIds":[735020306]},{"nodeId":735020306,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":2863712938,"text":"もちろん、「面白い」からだ。","nextNodeIds":[735020307]},{"nodeId":735020307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4247876450,"text":"即答したぞ！","nextNodeIds":[735020308]},{"nodeId":735020308,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":1512373978,"text":"それ以外に、俺が謎解きを作る理由があると思うか？","nextNodeIds":[735020309]},{"nodeId":735020309,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":4155174154,"text":"まさか、俺が他人を困らせて楽しんでいる…とでも思っているのか？","nextNodeIds":[735020310,735020311]},{"nodeId":735020310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3528148442,"text":"どうだろう…","nextNodeIds":[735020312]},{"nodeId":735020312,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":3825193610,"text":"はははっ、それじゃ君たちも教令院の連中と同じだ、俺を誤解している。","nextNodeIds":[735020313]},{"nodeId":735020313,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":1688556802,"text":"俺がなぞなぞを作るのは、単純に謎解きを解くときの考え悩む感覚が好きだからだ。","nextNodeIds":[735020314]},{"nodeId":735020314,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":1611955650,"text":"俺の謎解きを振り返ってみれば、そこには必ず謎解きを解くための「キーワード」があると気づくだろう。","nextNodeIds":[735020315]},{"nodeId":735020315,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":1950941218,"text":"そのキーワードを突破口にして考え続ければ、必ず謎解きは解ける。","nextNodeIds":[735020316]},{"nodeId":735020316,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":2865107874,"text":"もし俺が人を困らせたいだけなら、すべての手がかりを消して、この謎解きを本当に「解けない謎解き」に変えているさ。","nextNodeIds":[735020317]},{"nodeId":735020317,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":683427554,"text":"それはともかくとして、俺の謎解きを解いた君たちに報酬を渡そう。","nextNodeIds":[735020318]},{"nodeId":735020318,"roleType":"TALK_ROLE_NPC","speakerId":20847,"speakerName":"デルース","textMapHash":3354586346,"text":"これは君たちが自分で「考え」て勝ち取った報酬だからな、ちゃんと受け取ってくれ。","nextNodeIds":[]},{"nodeId":735020311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2397562794,"text":"なんとも言えない…","nextNodeIds":[735020312]}]},{"talkId":7350209,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7350202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7350206","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7350203","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LO