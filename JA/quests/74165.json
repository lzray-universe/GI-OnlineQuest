,""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7416502,"initDialog":741650201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21263,20995],"performCfg":"QuestDialogue/WQ/Fontaine_74165/Q7416502","priority":10,"questId":74165,"showRandomTalkCount":0},"dialogs":[{"nodeId":741650201,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":1467463186,"text":"バカな…私はすでにもう「不動」の座まで上り詰めたのに…どうしてここまで転落してしまったのだ？","nextNodeIds":[741650202]},{"nodeId":741650202,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":263857218,"text":"原始胎海の制御も完全にきかなくなってしまったとは…","nextNodeIds":[741650203]},{"nodeId":741650203,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":2235717538,"text":"なぜ、なぜこうなる？なぜ、なぜ君たちはこんなことをする！！！","nextNodeIds":[741650204]},{"nodeId":741650204,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3875540298,"text":"新たな世界は誕生できない。一人残らず、殻の夢の中で死んでしまう！","nextNodeIds":[741650205]},{"nodeId":741650205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":33753058,"text":"おまえこそ、早く自分の夢から覚めるべきだぞ。","nextNodeIds":[741650206]},{"nodeId":741650206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2686726338,"text":"世界の滅亡なんて話なら、全世界の人と一緒に解決方法を考えるべきだろ！","nextNodeIds":[741650207]},{"nodeId":741650207,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3924664930,"text":"分かった。聖剣だ…聖剣は私の味方となってはくれなかった。その剣が振るわれるたび、私の周りに集まる衆生の意志は削られていく…","nextNodeIds":[741650208]},{"nodeId":741650208,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":1344985938,"text":"そしてついに、私の惰弱な凡人性——私の人格も私の中に戻ってきてしまった。","nextNodeIds":[741650209,741650215]},{"nodeId":741650209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3600341362,"text":"胎海の氾濫は、そんなに近くないよ。","nextNodeIds":[741650210]},{"nodeId":741650210,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":875952194,"text":"ああ…最初に入力した「世界式」の値に変動があったことには、とうに気がついていた…","nextNodeIds":[741650211]},{"nodeId":741650211,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":4294436170,"text":"誰かが生命の力を掌握し、誰かが獣の国土を切り開いたのだ。","nextNodeIds":[741650212]},{"nodeId":741650212,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3061651042,"text":"そして「変数」…君だ。","nextNodeIds":[741650213]},{"nodeId":741650213,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":4107528090,"text":"すべてを呑み込むクジラの敗走を見届ける運命の者、すべてを見届ける者。","nextNodeIds":[741650214]},{"nodeId":741650214,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":764289762,"text":"そうだったのか…そうだったのか。","nextNodeIds":[741650221]},{"nodeId":741650221,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":434489162,"text":"私も君のようになりたいと、夢を見たことがある。しかしその夢は、たった今破れてしまった。","nextNodeIds":[741650222]},{"nodeId":741650222,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":2890679042,"text":"私のしたすべては無意味で…まるで空虚な夢のようだった…","nextNodeIds":[741650223]},{"nodeId":741650223,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":2592661970,"text":"違う、夢以下だ。夢は少なくとも無害だが、私は…いや、君たちや彼らはこの件のためにあれほどの代価を支払った。","nextNodeIds":[741650224]},{"nodeId":741650224,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":1433227498,"text":"ナルツィッセンクロイツ。","nextNodeIds":[741650225]},{"nodeId":741650225,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":2842551514,"text":"ああ、君か。気付かなかった。","nextNodeIds":[741650226]},{"nodeId":741650226,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":3791274338,"text":"あたしが誰だか知ってるの？","nextNodeIds":[741650227]},{"nodeId":741650227,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":547969802,"text":"名前など、呼称に過ぎない。君の魂に混ざる二つの色のことはとてもよく知っている。","nextNodeIds":[741650228]},{"nodeId":741650228,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":1671240618,"text":"リリス院長は何が起きたかもわからず、虫の息のマリアンを抱きとめた。","nextNodeIds":[741650229]},{"nodeId":741650229,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":2627975130,"text":"複雑すぎる今と未来を理解できなかった彼女は、過去をつなぎとめておきたいと思った。だから、自分にできる唯一のことをしたのだ。","nextNodeIds":[741650230]},{"nodeId":741650230,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":79874258,"text":"あたしの名前はアン。","nextNodeIds":[741650231]},{"nodeId":741650231,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":162092442,"text":"そうか、はじめまして、アン。","nextNodeIds":[741650232]},{"nodeId":741650232,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":1011605890,"text":"あたし、あなたを許してあげる。","nextNodeIds":[741650233]},{"nodeId":741650233,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":522194042,"text":"おかしなことを言う。最初から私の計画には崇高で神聖な目的があった。そこに私心などない。","nextNodeIds":[741650234]},{"nodeId":741650234,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":2690960106,"text":"誰も私を評価できないし、誰も私を裁けない。誰も私を許すことはできない。","nextNodeIds":[741650235]},{"nodeId":741650235,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":960606722,"text":"あなたの目的は崇高なものだったかもしれないけど、その狂気は多くの人を傷つけたんだよ。","nextNodeIds":[741650236]},{"nodeId":741650236,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":1187670242,"text":"あなたは数式の入力さえ正しくできなかった。間違いを犯して許されることに、何の問題があるの？","nextNodeIds":[741650237]},{"nodeId":741650237,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3130155402,"text":"…その通りだ。申し訳ない。","nextNodeIds":[741650238]},{"nodeId":741650238,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":1332311146,"text":"それからナルツィッセンクロイツ、あたしたちと戻ろう。あなたに会わせたい人がいるんだ。","nextNodeIds":[741650239]},{"nodeId":741650239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":492751922,"text":"こいつもだいぶ話がわかるようになったみたいだけど、流石にそんな要求は…","nextNodeIds":[741650240]},{"nodeId":741650240,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":826195602,"text":"いいだろう。","nextNodeIds":[741650241]},{"nodeId":741650241,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3141974314,"text":"おい！ここは悶々と悩んだ末にオイラたちに説得されるところじゃないのか？","nextNodeIds":[741650242]},{"nodeId":741650242,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3934306770,"text":"言ったように、私は自分に罪があるとは思っていない。今や偉業は惜しくも潰えてしまったが、世界はすでに救われた。","nextNodeIds":[741650243]},{"nodeId":741650243,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3857629530,"text":"叱責も嘲笑も気にしない。私の心はすでにがらんどうで、渇望だけが残されている。","nextNodeIds":[741650244]},{"nodeId":741650244,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4002566882,"text":"なにに対してだよ。","nextNodeIds":[741650245]},{"nodeId":741650245,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":11479418,"text":"私も、あの頃に戻りたい。水仙の勇者がまだ旅に出ていなかった頃。","nextNodeIds":[741650246]},{"nodeId":741650246,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":685821522,"text":"しかし今となっては無理な話だ。人の運命を決めるのは自分自身ではない。私はもう、何かの夢を見る力さえ失ってしまった。","nextNodeIds":[741650247]},{"nodeId":741650247,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":3816717794,"text":"#じゃあ、騎士{NICKNAME}、準備ができたら胎海をもう一度封印しに行って、それからここを離れよう。","nextNodeIds":[]},{"nodeId":741650215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3844267730,"text":"クジラはすでに打ち破られた。","nextNodeIds":[741650216]},{"nodeId":741650216,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3250328714,"text":"「世界式」の最初の入力値に変動があったことに、もっと早く気付くべきだった。「変数」はここに降臨したのだ。","nextNodeIds":[741650217]},{"nodeId":741650217,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3002264010,"text":"宇宙の外から来た事物をすべて、「降臨」あるいは「変数」と呼べるわけではない。","nextNodeIds":[741650218]},{"nodeId":741650218,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":1266380730,"text":"「変数」を一つ忘れていた…それは君だ。","nextNodeIds":[741650219]},{"nodeId":741650219,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":3385569210,"text":"すべてを見届ける者、すべてを記録する者、すべてを設計する者。","nextNodeIds":[741650220]},{"nodeId":741650220,"roleType":"TALK_ROLE_NPC","speakerId":21263,"speakerName":"ナルツィッセンクロイツ","textMapHash":1291854410,"text":"その地位を担えるのは、世界に等しい価値を持つ人間だけ。","nextNodeIds":[741650221]}]},{"talkId":7416503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],