,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7416503","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7416501,"initDialog":741650101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21262,20995],"performCfg":"QuestDialogue/WQ/Fontaine_74165/Q7416501","priority":5,"questId":74165,"showRandomTalkCount":0},"dialogs":[{"nodeId":741650101,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":499550802,"text":"ほう…「理性」を感じる。来たりし者たちよ、汝らは水仙十字の後継者か、それとも歯車の鷹犬か？","nextNodeIds":[741650102]},{"nodeId":741650102,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":982210034,"text":"しかし汝らは私に剣を向けてきた。どうやら、答えは明らかなようだ。","nextNodeIds":[741650103]},{"nodeId":741650103,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":3397536138,"text":"ナルツィッセンクロイツ…","nextNodeIds":[741650104]},{"nodeId":741650104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3654357154,"text":"え？これがナルツィッセンクロイツなのか？","nextNodeIds":[741650105]},{"nodeId":741650105,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":3102313194,"text":"我が名を聞いたことがあるなら、汝らは我が救世の道義を理解しているだろう。我が名を聞いたことがあるならば、汝らの意識には救いの種がある。","nextNodeIds":[741650106]},{"nodeId":741650106,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":1679108162,"text":"私に矛を向けてくるということは、きっと汝らは偽りに惑わされているのだろう。このタイミングで多くの力を無駄にすることは、私も避けたい。","nextNodeIds":[741650107]},{"nodeId":741650107,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":3579205450,"text":"喜べ、喝采せよ。すべてが終わったら私は答えを出し、汝らに示そう。聖剣を私に返し、安全な場所へ避難するがいい。","nextNodeIds":[741650108]},{"nodeId":741650108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3049470650,"text":"聖剣を渡すわけにはいかないぞ。","nextNodeIds":[741650109]},{"nodeId":741650109,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":541511594,"text":"愚かな、愚かな…だが、汝らを許そう。それでも私は汝らを救おう。","nextNodeIds":[741650110]},{"nodeId":741650110,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":3175185818,"text":"感じられるぞ。四象限は逆行したが、奔流の樹の全像は未だ完成していない。","nextNodeIds":[741650111]},{"nodeId":741650111,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":3934026538,"text":"すべての人を救う手段は、もはやない。私は己の命を削り、可能な限り広く慈悲を与えよう。","nextNodeIds":[741650112]},{"nodeId":741650112,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":3426578106,"text":"五割の者しか救えないとすれば、六割を救えるよう全力を尽くそう。","nextNodeIds":[741650113]},{"nodeId":741650113,"roleType":"TALK_ROLE_NPC","speakerId":21262,"speakerName":"ナルツィッセンクロイツ","textMapHash":2639252634,"text":"さあ、聖剣を渡してもらおう。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7416501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKEL