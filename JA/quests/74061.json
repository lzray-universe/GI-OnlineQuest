LAY_MODE_HOST","beginCond":[{"param":["7406104","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406104,"initDialog":740610401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21095],"performCfg":"QuestDialogue/Q7406104","priority":5,"questId":74061,"showRandomTalkCount":0},"dialogs":[{"nodeId":740610401,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":181108002,"text":"はぁ、はぁ、お二人さん。ふぅ——間に合いました。","nextNodeIds":[740610402]},{"nodeId":740610402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2264762810,"text":"そんなに息を切らしてどうしたんだよ？","nextNodeIds":[740610403]},{"nodeId":740610403,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":1257037746,"text":"廃棄された生産エリアでの作業を終わらせて、急いで走って来たんです。","nextNodeIds":[740610404]},{"nodeId":740610404,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":3839459922,"text":"頼んでいた用事は済みましたか？手紙はもう出せたんですよね？あぁ、よかった！","nextNodeIds":[740610405,740610406]},{"nodeId":740610405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":324005602,"text":"手紙の署名は純白のスズランだった。","nextNodeIds":[740610407]},{"nodeId":740610407,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":4254051650,"text":"ああ…あのお嬢さんはそういった名前を使っているんですね…","nextNodeIds":[740610408]},{"nodeId":740610408,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":1032741106,"text":"いいでしょう、本当のことをお話しします。あの手紙は、実はあるお嬢さんに頼まれたものなんです。病気で苦しんでいたので、私が代わりに出してあげることにしたんですよ。しかも報酬もなしに！君たちへの報酬は私の自腹になります…","nextNodeIds":[740610409]},{"nodeId":740610409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1003217146,"text":"えっ！？","nextNodeIds":[740610410,740610411]},{"nodeId":740610410,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2497188154,"text":"手紙の内容を見るに重病そう。","nextNodeIds":[740610412]},{"nodeId":740610412,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":1723680386,"text":"きっと外に出る際、手紙を取り違えたんでしょう。まずい、これじゃ息子の誕生日に間に合わなくなります…","nextNodeIds":[740610413]},{"nodeId":740610413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1865102274,"text":"…ん？送る手紙を間違えたのか？おまえってやっぱり噂通り、不運なんだな。","nextNodeIds":[740610414]},{"nodeId":740610414,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":4013441298,"text":"これが私の運命なのかもしれません。はぁ、私はそろそろ戻ります。手紙を取りに行かないと…まだ間に合うといいのですが。","nextNodeIds":[740610415]},{"nodeId":740610415,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":3727057914,"text":"こちらがお二人への報酬です。お手伝いいただき、ありがとうございました。私は息子に手紙を出さなければならないので、ここで失礼します。","nextNodeIds":[740610416]},{"nodeId":740610416,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":661711162,"text":"おい…ああ、もう行っちゃったぞ！まだ聞きたいことがたくさんあったのに…","nextNodeIds":[740610417]},{"nodeId":740610417,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2298585850,"text":"まあでも、特別許可券はもらえたし問題ないか。…って、あれ！？たったこれだけ？こんなんじゃ、一食分も買えないじゃんかよ！","nextNodeIds":[740610418,740610420]},{"nodeId":740610418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3020721610,"text":"今夜は空腹確定だね。","nextNodeIds":[740610419]},{"nodeId":740610419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1824722394,"text":"イヤだぞ、お腹空いた。ううぅ…","nextNodeIds":[]},{"nodeId":740610420,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2180236850,"text":"もう一回、列に並ぶ依頼を受ける？","nextNodeIds":[740610421]},{"nodeId":740610421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3688837706,"text":"それだったら、まだ腹ペコのほうがマシだぞ！","nextNodeIds":[]},{"nodeId":740610411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3019500690,"text":"その話、本当？","nextNodeIds":[740610412]},{"nodeId":740610406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":117295482,"text":"#{M#君}{F#あなた}が純白のスズラン？","nextNodeIds":[740610407]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["74025","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21095"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7406102,7406104],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":20},{"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":14},{"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","count":13},{"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174061],"BHCBFLFOGJN":0,"BPEIDGPCLGA":fals