{"mainQuestId":74061,"title":"メロピデの日常·裏取引","description":"郵便室の列はかなり長いようだ…","titleTextMapHash":409880815,"descTextMapHash":1884611926,"mainQuestExcel":{"mainQuestId":74061,"titleTextMapHash":409880815,"title":"メロピデの日常·裏取引","descTextMapHash":1884611926,"description":"郵便室の列はかなり長いようだ…","chapterId":10156,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_ALL","activityId":0,"luaPath":"Actor/Quest/WQ74061","mainQuestRaw":{"activeMode":"PLAY_MODE_ALL","activityId":0,"chapterId":10156,"descTextMapHash":1884611926,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74061,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3448501569,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74061","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174061],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":409880815,"type":"WQ","unlockDescTextMapHash":2300993398}},"flow":[{"subQuestId":7406101,"order":1,"stepDescription":"","stepDescTextMapHash":238290100,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7406102],"talks":[{"talkId":7406102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7406102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406102,"initDialog":740610201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21095],"performCfg":"QuestDialogue/Q7406102","priority":5,"questId":74061,"showRandomTalkCount":0},"dialogs":[{"nodeId":740610201,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":567130458,"text":"どなたか助けてくれませんか？お願いします。哀れな私に救いの手を！","nextNodeIds":[740610202]},{"nodeId":740610202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2170118018,"text":"どうしたんだ？大丈夫か？","nextNodeIds":[740610203]},{"nodeId":740610203,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":2150231154,"text":"ああ、神様！やっと優しい人に巡り合えました。その…実は明日、息子の誕生日なので手紙を送りたいのですが…","nextNodeIds":[740610204]},{"nodeId":740610204,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":710004514,"text":"しかし手紙を外へ送るには、並ばなくてはなりません。でも、私にはその時間がなく…","nextNodeIds":[740610205]},{"nodeId":740610205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3596184538,"text":"ん？どうしてだよ？","nextNodeIds":[740610206]},{"nodeId":740610206,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":1910106106,"text":"生産エリアで重大な事故が発生したんです。すぐ現場に行って処理しなければなりません。それで、誰かに代わりに並んでほしいんですけど…","nextNodeIds":[740610207]},{"nodeId":740610207,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":2406657010,"text":"はぁ…これもすべて私の自業自得だと分かっています。で、でも、息子にはなんの罪もありません。どうして私のせいで、息子が悲しい目に遭わなければならないんでしょう？","nextNodeIds":[740610208]},{"nodeId":740610208,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":3058804066,"text":"私はただ息子に手紙を書いて、父さんが誕生日を忘れてないことを…父さんが愛していることを伝えたいだけなのに。残念ながら、私にはそれすらできないようです…","nextNodeIds":[740610209]},{"nodeId":740610209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4149119586,"text":"#うぅ、可哀そうだな。{NICKNAME}、助けてやろうぜ？","nextNodeIds":[740610210]},{"nodeId":740610210,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":391607898,"text":"ほ、本当ですか？今、それほど手持ちに余裕はありませんが、必ず相場に見合った報酬をお支払いしましょう！","nextNodeIds":[740610211]},{"nodeId":740610211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1637394706,"text":"相場？","nextNodeIds":[740610212]},{"nodeId":740610212,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":818476962,"text":"はい、私も代わりに並んだことがあるので、相場を知っているんです。","nextNodeIds":[740610213]},{"nodeId":740610213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4198570362,"text":"別に気にしなくていいぞ。報酬は大して重要じゃないからな！","nextNodeIds":[740610214]},{"nodeId":740610214,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":3064910826,"text":"本当にありがとうございます！お優しいですね。そういえば、まだお名前を伺っていませんでした。私はデサンブル、お二人は？","nextNodeIds":[740610215]},{"nodeId":740610215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":967916338,"text":"#オイラはパイモン、こいつは{NICKNAME}だ。一緒に冒険してる仲間だぞ！","nextNodeIds":[740610216]},{"nodeId":740610216,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":2641162114,"text":"#これが送りたい手紙です。そこにいるルッツという人に直接渡してください。パイモンに{NICKNAME}、頼みましたよ。","nextNodeIds":[740610217]},{"nodeId":740610217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2643619658,"text":"へへっ、安心してオイラたちに任せてくれ！","nextNodeIds":[740610218]},{"nodeId":740610218,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3771251970,"text":"デサンブルは手紙を渡すと、急いで立ち去った。\\n長時間経ってからふと気づいた——まばらに並んでいた人の列が、まるで固まっているかのように進んでいないことに。\\nそして、とある二人の会話が後ろから聞こえてきて、あなたたちの興味を引いた。","nextNodeIds":[740610219]},{"nodeId":740610219,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3272809466,"text":"はぁ、遅いな。空気も悪いし、息が詰まりそうだ…","nextNodeIds":[740610220]},{"nodeId":740610220,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2481516834,"text":"若いの、ここに並ぶのは初めてかい？ここの行列は長いことで有名でな。メロピデ要塞じゃ誰もが知ってることさ。","nextNodeIds":[740610221]},{"nodeId":740610221,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2590226674,"text":"何しろ、ルッツは文字を打ちながら尾ひれを付け足すクセがある。みんな、チェックにかなりの時間がかかるんだよ。","nextNodeIds":[740610222]},{"nodeId":740610222,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3294945298,"text":"かなりの時間？あぁ、なんてこった。もう足が棒になりそうだ…","nextNodeIds":[740610223]},{"nodeId":740610223,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":3859236842,"text":"ははっ、気を失わないように、せいぜい気張れよ。万が一気絶でもしたら、明日はまた最初から並び直しだ。三回並んでもなお、まだ手紙を送れなかった人もいるくらいだしな。","nextNodeIds":[740610224]},{"nodeId":740610224,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":220806722,"text":"三回も？なんてツイてないやつだ…","nextNodeIds":[740610225]},{"nodeId":740610225,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1541968778,"text":"だろう？三回並んで、三回とも失敗するなんて偉業をなしたのは彼だけだ。だから皆、彼を不運なデサンブルって呼んでるよ。","nextNodeIds":[740610226]},{"nodeId":740610226,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2508640690,"text":"もし興味があるのなら、詳しく話してあげよう。","nextNodeIds":[740610227]},{"nodeId":740610227,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":2824513930,"text":"いや、正直なところ、今はそういう気分じゃなくって…","nextNodeIds":[740610228]},{"nodeId":740610228,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":438236778,"text":"まあまあ、そう言わずに。元気を出してくれ。オホンッ、これは一昨日のことだ。うだるような暑さの午後だった…","nextNodeIds":[740610229]},{"nodeId":740610229,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3872106802,"text":"いいって言ってるのに…はぁ、分かったよ。続けてくれ…","nextNodeIds":[740610230]},{"nodeId":740610230,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":3789674194,"text":"あの午後、デサンブルが私のところに来ると、「明日、手紙を送るために並ばなきゃいけないから、特別許可食堂での配膳の仕事を代わってほしい」と言ってきた。","nextNodeIds":[740610231]},{"nodeId":740610231,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":4284160578,"text":"面倒だから、引き受けるつもりなんてなかったんだが…あまりに悲しそうな顔をして、こう言ってきたんだ——「前回はうっかり寝坊して、並び損ねた」ってね。そして、息子は今も手紙を待ってると。","nextNodeIds":[740610232]},{"nodeId":740610232,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2991941010,"text":"結局、同情しちまって手伝うことにしたんだ。で、昨日仕事を終えた後、何があったと思う？あいつはまた、仕事を代わってくれる人を探してたんだ。手紙を送らなきゃっていう同じ理由でな。","nextNodeIds":[740610233]},{"nodeId":740610233,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1330264474,"text":"どういうことかあいつに聞くと、先日の教訓から早起きはしたが、今度はトラブルがあって手紙を出せなかったそうだ。","nextNodeIds":[740610234]},{"nodeId":740610234,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":1741724546,"text":"まさか…間違った列に並んだとか？","nextNodeIds":[740610235]},{"nodeId":740610235,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":107650842,"text":"それよりもっと面白い話さ。早朝から並ぶために食事も取らずにいたら、午後まで持たなかったそうだ。","nextNodeIds":[740610236]},{"nodeId":740610236,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1536321234,"text":"やせ我慢で何とか乗り切ろうとしたが、突然目の前が暗くなって、パタンと倒れちまったんだと。目が覚めたら、もう終わってたらしい。","nextNodeIds":[740610237]},{"nodeId":740610237,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":1173748722,"text":"はははっ、そんなやつがいるなんてな！…いや待った、そういえば自分もまだご飯を食べてない。やばい、お腹が鳴り出した…","nextNodeIds":[740610238]},{"nodeId":740610238,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3293884450,"text":"今のって、あのデサンブルのことだよな？ここに並ぶのがそんなに大変だなんて…食べ物を持っててよかったぜ！","nextNodeIds":[740610239,740610241]},{"nodeId":740610239,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3198272402,"text":"そうだね。幸いパイモンもいることだし！","nextNodeIds":[740610240]},{"nodeId":740610240,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4042669282,"text":"うう～ん？褒められてるみたいだけど、なんか別の意味を含んでるような…","nextNodeIds":[740610243]},{"nodeId":740610243,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":256510618,"text":"長い行列に並んでいる時間は退屈で、あなたたちは徐々に自分の任務を忘れていった。\\nここにいる数少ない人たちの少し騒がしいおしゃべりだけが、時の流れを思い起こさせる。","nextNodeIds":[740610244]},{"nodeId":740610244,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":320159794,"text":"クラクラしてきた…まさか、俺も手紙を送るのが明日になってしまうのか…","nextNodeIds":[740610245]},{"nodeId":740610245,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2447572218,"text":"これで腹ごしらえするといい。ここに並ぶときは、携帯食と水を用意するのが常識だ。次からは忘れんようにな。","nextNodeIds":[740610246]},{"nodeId":740610246,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":2496886706,"text":"あ、ありがとう。でも大げさだな…本当にそれって、ここの行列に並ぶときの常識なのか？","nextNodeIds":[740610247]},{"nodeId":740610247,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1018068194,"text":"ふん、いいか新入り、よく聞け。ここはメロピデ要塞で最も過酷な戦場だ。あの鉄拳闘技場だって、ここほどじゃない！","nextNodeIds":[740610248]},{"nodeId":740610248,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3244521530,"text":"あぁ、でもこれはいくら何でも…","nextNodeIds":[740610249]},{"nodeId":740610249,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":3016084354,"text":"列に並ぶ者は皆、綿密な計画を立ててるんだ。休憩用の椅子を持ってくる者もいれば、入口で徹夜して待つ者もいる！","nextNodeIds":[740610250]},{"nodeId":740610250,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3599184042,"text":"れ、列に並ぶだけで…","nextNodeIds":[740610251]},{"nodeId":740610251,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2382595378,"text":"若いの、これはただの列じゃない——そう、戦争なんだ！誰もが力を尽くしてる！あの不運なデサンブルでさえ、数多の作戦を用意してるほどだ。","nextNodeIds":[740610252]},{"nodeId":740610252,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":835703266,"text":"……","nextNodeIds":[740610253]},{"nodeId":740610253,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2731736362,"text":"しかし残念ながら、その作戦をもってしても、デサンブルは失敗の運命から逃れることができなかった。さっき生産エリアから戻ったとき、デサンブルが列から離れて特別許可食堂に向かっていくのを見てな。","nextNodeIds":[740610254]},{"nodeId":740610254,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2789530242,"text":"だから、どうして列に並ばないのかって聞いたら、なんて答えたと思う？","nextNodeIds":[740610255]},{"nodeId":740610255,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2979909306,"text":"これまでの経験にこだわりすぎた結果、最も重要なこと——つまり、送ろうとしてる手紙を持ってくるのを忘れたんだとよ！だから、最初からやり直すしかないって。","nextNodeIds":[740610256]},{"nodeId":740610256,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":1092465002,"text":"…なんだか話を聞いてたら、その人と会ってみたくなってきたぜ。","nextNodeIds":[740610257]},{"nodeId":740610257,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2730309978,"text":"うわっ…手紙を忘れたのかよ？デサンブルのやつ、本当にツイてないな…","nextNodeIds":[740610258,740610259]},{"nodeId":740610258,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1888834682,"text":"だったら、渡されたのはいったい？","nextNodeIds":[740610260]},{"nodeId":740610260,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3668158634,"text":"あっ、そうだった！手紙はオイラたちが持ってるんだよな？うーん、ちょっと訳がわからなくなってきたぞ…","nextNodeIds":[740610261]},{"nodeId":740610261,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2540211274,"text":"手紙を確認してみよう…","nextNodeIds":[740610262]},{"nodeId":740610262,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":152774602,"text":"どれどれ…うわっ！こ、怖いぞ、なんだよこれ…誕生日ともデサンブルとも、まったく関係ないじゃんか。","nextNodeIds":[740610263,740610264]},{"nodeId":740610263,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3450452922,"text":"（つじつまが全然合わない。）","nextNodeIds":[740610265]},{"nodeId":740610265,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2780072042,"text":"#{NICKNAME}、もうすぐオイラたちの番だ。とりあえず手紙を出そうぜ！","nextNodeIds":[740610266]},{"nodeId":740610266,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":102399490,"text":"苦痛に満ちた待ち時間はついに終わり、これですべてが報われる。\\nしかし、まだ解放されたわけではない。なぜなら、心にはまだ疑問が残っているからだ…","nextNodeIds":[]},{"nodeId":740610264,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2153076034,"text":"（あとで必ず聞かないと…）","nextNodeIds":[740610265]},{"nodeId":740610259,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3608465018,"text":"手紙を渡されたでしょ？","nextNodeIds":[740610260]},{"nodeId":740610241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1904621434,"text":"パイモンはいつもお腹が空いてるよね…","nextNodeIds":[740610242]},{"nodeId":740610242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1311244010,"text":"へへっ、お腹を満たすことは大事なことだぜ。","nextNodeIds":[740610243]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7406102,"order":2,"stepDescription":"デサンブルと会話する","stepDescTextMapHash":140573740,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_4852:4541.243,157.615,4594.094]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7406102],"talks":[{"talkId":7406102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7406102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406102,"initDialog":740610201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21095],"performCfg":"QuestDialogue/Q7406102","priority":5,"questId":74061,"showRandomTalkCount":0},"dialogs":[{"nodeId":740610201,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":567130458,"text":"どなたか助けてくれませんか？お願いします。哀れな私に救いの手を！","nextNodeIds":[740610202]},{"nodeId":740610202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2170118018,"text":"どうしたんだ？大丈夫か？","nextNodeIds":[740610203]},{"nodeId":740610203,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":2150231154,"text":"ああ、神様！やっと優しい人に巡り合えました。その…実は明日、息子の誕生日なので手紙を送りたいのですが…","nextNodeIds":[740610204]},{"nodeId":740610204,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":710004514,"text":"しかし手紙を外へ送るには、並ばなくてはなりません。でも、私にはその時間がなく…","nextNodeIds":[740610205]},{"nodeId":740610205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3596184538,"text":"ん？どうしてだよ？","nextNodeIds":[740610206]},{"nodeId":740610206,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":1910106106,"text":"生産エリアで重大な事故が発生したんです。すぐ現場に行って処理しなければなりません。それで、誰かに代わりに並んでほしいんですけど…","nextNodeIds":[740610207]},{"nodeId":740610207,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":2406657010,"text":"はぁ…これもすべて私の自業自得だと分かっています。で、でも、息子にはなんの罪もありません。どうして私のせいで、息子が悲しい目に遭わなければならないんでしょう？","nextNodeIds":[740610208]},{"nodeId":740610208,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":3058804066,"text":"私はただ息子に手紙を書いて、父さんが誕生日を忘れてないことを…父さんが愛していることを伝えたいだけなのに。残念ながら、私にはそれすらできないようです…","nextNodeIds":[740610209]},{"nodeId":740610209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4149119586,"text":"#うぅ、可哀そうだな。{NICKNAME}、助けてやろうぜ？","nextNodeIds":[740610210]},{"nodeId":740610210,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":391607898,"text":"ほ、本当ですか？今、それほど手持ちに余裕はありませんが、必ず相場に見合った報酬をお支払いしましょう！","nextNodeIds":[740610211]},{"nodeId":740610211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1637394706,"text":"相場？","nextNodeIds":[740610212]},{"nodeId":740610212,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":818476962,"text":"はい、私も代わりに並んだことがあるので、相場を知っているんです。","nextNodeIds":[740610213]},{"nodeId":740610213,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4198570362,"text":"別に気にしなくていいぞ。報酬は大して重要じゃないからな！","nextNodeIds":[740610214]},{"nodeId":740610214,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":3064910826,"text":"本当にありがとうございます！お優しいですね。そういえば、まだお名前を伺っていませんでした。私はデサンブル、お二人は？","nextNodeIds":[740610215]},{"nodeId":740610215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":967916338,"text":"#オイラはパイモン、こいつは{NICKNAME}だ。一緒に冒険してる仲間だぞ！","nextNodeIds":[740610216]},{"nodeId":740610216,"roleType":"TALK_ROLE_NPC","speakerId":21095,"speakerName":"デサンブル","textMapHash":2641162114,"text":"#これが送りたい手紙です。そこにいるルッツという人に直接渡してください。パイモンに{NICKNAME}、頼みましたよ。","nextNodeIds":[740610217]},{"nodeId":740610217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2643619658,"text":"へへっ、安心してオイラたちに任せてくれ！","nextNodeIds":[740610218]},{"nodeId":740610218,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3771251970,"text":"デサンブルは手紙を渡すと、急いで立ち去った。\\n長時間経ってからふと気づいた——まばらに並んでいた人の列が、まるで固まっているかのように進んでいないことに。\\nそして、とある二人の会話が後ろから聞こえてきて、あなたたちの興味を引いた。","nextNodeIds":[740610219]},{"nodeId":740610219,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3272809466,"text":"はぁ、遅いな。空気も悪いし、息が詰まりそうだ…","nextNodeIds":[740610220]},{"nodeId":740610220,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2481516834,"text":"若いの、ここに並ぶのは初めてかい？ここの行列は長いことで有名でな。メロピデ要塞じゃ誰もが知ってることさ。","nextNodeIds":[740610221]},{"nodeId":740610221,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2590226674,"text":"何しろ、ルッツは文字を打ちながら尾ひれを付け足すクセがある。みんな、チェックにかなりの時間がかかるんだよ。","nextNodeIds":[740610222]},{"nodeId":740610222,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3294945298,"text":"かなりの時間？あぁ、なんてこった。もう足が棒になりそうだ…","nextNodeIds":[740610223]},{"nodeId":740610223,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":3859236842,"text":"ははっ、気を失わないように、せいぜい気張れよ。万が一気絶でもしたら、明日はまた最初から並び直しだ。三回並んでもなお、まだ手紙を送れなかった人もいるくらいだしな。","nextNodeIds":[740610224]},{"nodeId":740610224,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":220806722,"text":"三回も？なんてツイてないやつだ…","nextNodeIds":[740610225]},{"nodeId":740610225,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1541968778,"text":"だろう？三回並んで、三回とも失敗するなんて偉業をなしたのは彼だけだ。だから皆、彼を不運なデサンブルって呼んでるよ。","nextNodeIds":[740610226]},{"nodeId":740610226,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2508640690,"text":"もし興味があるのなら、詳しく話してあげよう。","nextNodeIds":[740610227]},{"nodeId":740610227,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":2824513930,"text":"いや、正直なところ、今はそういう気分じゃなくって…","nextNodeIds":[740610228]},{"nodeId":740610228,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":438236778,"text":"まあまあ、そう言わずに。元気を出してくれ。オホンッ、これは一昨日のことだ。うだるような暑さの午後だった…","nextNodeIds":[740610229]},{"nodeId":740610229,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3872106802,"text":"いいって言ってるのに…はぁ、分かったよ。続けてくれ…","nextNodeIds":[740610230]},{"nodeId":740610230,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":3789674194,"text":"あの午後、デサンブルが私のところに来ると、「明日、手紙を送るために並ばなきゃいけないから、特別許可食堂での配膳の仕事を代わってほしい」と言ってきた。","nextNodeIds":[740610231]},{"nodeId":740610231,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":4284160578,"text":"面倒だから、引き受けるつもりなんてなかったんだが…あまりに悲しそうな顔をして、こう言ってきたんだ——「前回はうっかり寝坊して、並び損ねた」ってね。そして、息子は今も手紙を待ってると。","nextNodeIds":[740610232]},{"nodeId":740610232,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2991941010,"text":"結局、同情しちまって手伝うことにしたんだ。で、昨日仕事を終えた後、何があったと思う？あいつはまた、仕事を代わってくれる人を探してたんだ。手紙を送らなきゃっていう同じ理由でな。","nextNodeIds":[740610233]},{"nodeId":740610233,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1330264474,"text":"どういうことかあいつに聞くと、先日の教訓から早起きはしたが、今度はトラブルがあって手紙を出せなかったそうだ。","nextNodeIds":[740610234]},{"nodeId":740610234,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":1741724546,"text":"まさか…間違った列に並んだとか？","nextNodeIds":[740610235]},{"nodeId":740610235,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":107650842,"text":"それよりもっと面白い話さ。早朝から並ぶために食事も取らずにいたら、午後まで持たなかったそうだ。","nextNodeIds":[740610236]},{"nodeId":740610236,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1536321234,"text":"やせ我慢で何とか乗り切ろうとしたが、突然目の前が暗くなって、パタンと倒れちまったんだと。目が覚めたら、もう終わってたらしい。","nextNodeIds":[740610237]},{"nodeId":740610237,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":1173748722,"text":"はははっ、そんなやつがいるなんてな！…いや待った、そういえば自分もまだご飯を食べてない。やばい、お腹が鳴り出した…","nextNodeIds":[740610238]},{"nodeId":740610238,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3293884450,"text":"今のって、あのデサンブルのことだよな？ここに並ぶのがそんなに大変だなんて…食べ物を持っててよかったぜ！","nextNodeIds":[740610239,740610241]},{"nodeId":740610239,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3198272402,"text":"そうだね。幸いパイモンもいることだし！","nextNodeIds":[740610240]},{"nodeId":740610240,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4042669282,"text":"うう～ん？褒められてるみたいだけど、なんか別の意味を含んでるような…","nextNodeIds":[740610243]},{"nodeId":740610243,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":256510618,"text":"長い行列に並んでいる時間は退屈で、あなたたちは徐々に自分の任務を忘れていった。\\nここにいる数少ない人たちの少し騒がしいおしゃべりだけが、時の流れを思い起こさせる。","nextNodeIds":[740610244]},{"nodeId":740610244,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":320159794,"text":"クラクラしてきた…まさか、俺も手紙を送るのが明日になってしまうのか…","nextNodeIds":[740610245]},{"nodeId":740610245,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2447572218,"text":"これで腹ごしらえするといい。ここに並ぶときは、携帯食と水を用意するのが常識だ。次からは忘れんようにな。","nextNodeIds":[740610246]},{"nodeId":740610246,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":2496886706,"text":"あ、ありがとう。でも大げさだな…本当にそれって、ここの行列に並ぶときの常識なのか？","nextNodeIds":[740610247]},{"nodeId":740610247,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":1018068194,"text":"ふん、いいか新入り、よく聞け。ここはメロピデ要塞で最も過酷な戦場だ。あの鉄拳闘技場だって、ここほどじゃない！","nextNodeIds":[740610248]},{"nodeId":740610248,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3244521530,"text":"あぁ、でもこれはいくら何でも…","nextNodeIds":[740610249]},{"nodeId":740610249,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":3016084354,"text":"列に並ぶ者は皆、綿密な計画を立ててるんだ。休憩用の椅子を持ってくる者もいれば、入口で徹夜して待つ者もいる！","nextNodeIds":[740610250]},{"nodeId":740610250,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":3599184042,"text":"れ、列に並ぶだけで…","nextNodeIds":[740610251]},{"nodeId":740610251,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2382595378,"text":"若いの、これはただの列じゃない——そう、戦争なんだ！誰もが力を尽くしてる！あの不運なデサンブルでさえ、数多の作戦を用意してるほどだ。","nextNodeIds":[740610252]},{"nodeId":740610252,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":835703266,"text":"……","nextNodeIds":[740610253]},{"nodeId":740610253,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2731736362,"text":"しかし残念ながら、その作戦をもってしても、デサンブルは失敗の運命から逃れることができなかった。さっき生産エリアから戻ったとき、デサンブルが列から離れて特別許可食堂に向かっていくのを見てな。","nextNodeIds":[740610254]},{"nodeId":740610254,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2789530242,"text":"だから、どうして列に並ばないのかって聞いたら、なんて答えたと思う？","nextNodeIds":[740610255]},{"nodeId":740610255,"roleType":"TALK_ROLE_NPC","speakerId":21118,"speakerName":"陽気な男","textMapHash":2979909306,"text":"これまでの経験にこだわりすぎた結果、最も重要なこと——つまり、送ろうとしてる手紙を持ってくるのを忘れたんだとよ！だから、最初からやり直すしかないって。","nextNodeIds":[740610256]},{"nodeId":740610256,"roleType":"TALK_ROLE_NPC","speakerId":21117,"speakerName":"疲れた男","textMapHash":1092465002,"text":"…なんだか話を聞いてたら、その人と会ってみたくなってきたぜ。","nextNodeIds":[740610257]},{"nodeId":740610257,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2730309978,"text":"うわっ…手紙を忘れたのかよ？デサンブルのやつ、本当にツイてないな…","nextNodeIds":[740610258,740610259]},{"nodeId":740610258,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1888834682,"text":"だったら、渡されたのはいったい？","nextNodeIds":[740610260]},{"nodeId":740610260,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3668158634,"text":"あっ、そうだった！手紙はオイラたちが持ってるんだよな？うーん、ちょっと訳がわからなくなってきたぞ…","nextNodeIds":[740610261]},{"nodeId":740610261,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2540211274,"text":"手紙を確認してみよう…","nextNodeIds":[740610262]},{"nodeId":740610262,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":152774602,"text":"どれどれ…うわっ！こ、怖いぞ、なんだよこれ…誕生日ともデサンブルとも、まったく関係ないじゃんか。","nextNodeIds":[740610263,740610264]},{"nodeId":740610263,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3450452922,"text":"（つじつまが全然合わない。）","nextNodeIds":[740610265]},{"nodeId":740610265,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2780072042,"text":"#{NICKNAME}、もうすぐオイラたちの番だ。とりあえず手紙を出そうぜ！","nextNodeIds":[740610266]},{"nodeId":740610266,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":102399490,"text":"苦痛に満ちた待ち時間はついに終わり、これですべてが報われる。\\nしかし、まだ解放されたわけではない。なぜなら、心にはまだ疑問が残っているからだ…","nextNodeIds":[]},{"nodeId":740610264,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2153076034,"text":"（あとで必ず聞かないと…）","nextNodeIds":[740610265]},{"nodeId":740610259,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3608465018,"text":"手紙を渡されたでしょ？","nextNodeIds":[740610260]},{"nodeId":740610241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1904621434,"text":"パイモンはいつもお腹が空いてるよね…","nextNodeIds":[740610242]},{"nodeId":740610242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1311244010,"text":"へへっ、お腹を満たすことは大事なことだぜ。","nextNodeIds":[740610243]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_4852:4541.243,157.615,4594.094]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7406103,"order":3,"stepDescription":"郵便室を出る","stepDescTextMapHash":507991076,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406103,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_4852:4541.243,157.615,4594.094]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406103,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHE