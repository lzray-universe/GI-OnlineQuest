kerName":"旅人","textMapHash":1273465146,"text":"誤解でよかった…","nextNodeIds":[756700114]},{"nodeId":756700114,"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"コミナ","textMapHash":4087014954,"text":"すみません！クウェクさんが有意義なことに取り組んでいると聞いたので、私がそれなら「ちゃんとした」言葉を使ったほうがいいってアドバイスしたんです…かえって裏目に出ちゃったみたいで…","nextNodeIds":[756700115]},{"nodeId":756700115,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"クウェク","textMapHash":2302934010,"text":"ははっ、コミナ、謝らなくていいぜ。オレもこいつも、あんたがつけてくれた呼び名を気に入ってるしな。そうだろ、イェーイェー副教官？","nextNodeIds":[756700116]},{"nodeId":756700116,"roleType":"TALK_ROLE_NPC","speakerId":30883,"speakerName":"「イェーイェー副教官」","textMapHash":4236497074,"text":"キュキュ…イェー！","nextNodeIds":[756700117]},{"nodeId":756700117,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"クウェク","textMapHash":3851667314,"text":"#な？そうだ、{NICKNAME}、試してみたいか？あんたにとっては朝飯前かもしれないが、楽しめると思うぜ。","nextNodeIds":[756700118]},{"nodeId":756700118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1489500210,"text":"どんな風にやるの？","nextNodeIds":[756700119]},{"nodeId":756700119,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"クウェク","textMapHash":404523178,"text":"簡単だ。いろんな竜と一緒に、オレが設定した目標を達成してくれ。一番重要なのは、信頼と絆だ。","nextNodeIds":[756700120]},{"nodeId":756700120,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"クウェク","textMapHash":1850361114,"text":"一人で全ての目標をクリアしようなんて考えたら、一歩も進めなくなるぜ。常に仲間にも気を配ってくれよ。","nextNodeIds":[756700121]},{"nodeId":756700121,"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"クウェク","textMapHash":625701610,"text":"そうそう、まだ高所における安全対策ができてなくて…クク竜とは一緒に行けないんだ。安全第一だからな！","nextNodeIds":[756700122]},{"nodeId":756700122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2600009970,"text":"#やってみようぜ！{NICKNAME}は協力プレイが得意だもんな！","nextNodeIds":[756700123,756700124]},{"nodeId":756700123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4017356674,"text":"うん、やってみる。","nextNodeIds":[756700125]},{"nodeId":756700125,"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"コミナ","textMapHash":851745226,"text":"#よかった…もし{NICKNAME}さんも試してくれたことが広まれば、きっとみんな積極的に参加しにきてくれますよ！","nextNodeIds":[756700126]},{"nodeId":756700126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3715475498,"text":"それじゃあコミナ、オイラたちにも「正式」な呼び名を付けてくれよ。カッコイイので頼むぞ、へへっ…","nextNodeIds":[756700127]},{"nodeId":756700127,"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"コミナ","textMapHash":2005070738,"text":"うーん、じっくり考えませんと…","nextNodeIds":[]},{"nodeId":756700124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2480279506,"text":"パイモンがそういうなら…","nextNodeIds":[756700125]},{"nodeId":756700113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2574242274,"text":"通報するところだった…","nextNodeIds":[756700114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7567001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30879"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7567001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30880,"speakerName":"クウェク","count":12},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":30879,"speakerName":"コミナ","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":3},{"roleType":"TALK_ROLE_NPC","speakerId":30883,"speakerName":"「イェーイェー副教官」","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJ