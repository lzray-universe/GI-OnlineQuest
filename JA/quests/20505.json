,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["2050501","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2050501,"initDialog":205050101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1512],"performCfg":"","priority":8,"questId":20505,"showRandomTalkCount":0},"dialogs":[{"nodeId":205050101,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":3273419705,"text":"ごめんなさい、またあなたを呼んでしまって。","nextNodeIds":[205050102,205050104]},{"nodeId":205050102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1433532009,"text":"大丈夫、いつも世話になってるから。","nextNodeIds":[205050103]},{"nodeId":205050103,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":2549388633,"text":"そう言ってもらえると助かります。なるべく手短に言いますね。","nextNodeIds":[205050106]},{"nodeId":205050106,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":1887902657,"text":"この間は協会の依頼を達成してくださってありがとうございます、おかげで冒険者協会の評判もますますよくなりました。","nextNodeIds":[205050107]},{"nodeId":205050107,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":4133964249,"text":"でもその影響で依頼を出す人が増えてきて、正直手が回らないというか。","nextNodeIds":[205050108]},{"nodeId":205050108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":112245489,"text":"宣伝してほしいの？","nextNodeIds":[205050109]},{"nodeId":205050109,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":2285333249,"text":"あっ、違うんです、気持ちはありがたいですし、確かにもっといろんな人に協会に入ってほしいとは思っていますが…","nextNodeIds":[205050110]},{"nodeId":205050110,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":507942609,"text":"今新人を入れても間に合わない気がするんです。","nextNodeIds":[205050111]},{"nodeId":205050111,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":41270513,"text":"だからちょっと聞きたくて、あなたのご友人に任務を手伝ってもらうことってできますか？","nextNodeIds":[205050112,205050114]},{"nodeId":205050112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":60050505,"text":"話し合ってみる。","nextNodeIds":[205050113]},{"nodeId":205050113,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":2467986353,"text":"よかった、ありがとうございます。","nextNodeIds":[205050117]},{"nodeId":205050117,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":3169930217,"text":"とにかく説明しますね。今ある依頼で緊急なのは<color=#00E1FFFF>「探索派遣」</color>です。","nextNodeIds":[205050118]},{"nodeId":205050118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":852251953,"text":"「探索派遣」？","nextNodeIds":[205050119]},{"nodeId":205050119,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":1132483873,"text":"私たちは都市周辺や野外の状況を随時更新しています。たとえば潜在的な危険とか、地下遺跡の異常状況とか。","nextNodeIds":[205050120]},{"nodeId":205050120,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":959216073,"text":"他人からの依頼じゃないので、時間の制限はないんですけど…","nextNodeIds":[205050121]},{"nodeId":205050121,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":2059797945,"text":"長時間放置すれば、それが大きな災いになる可能性もあります。","nextNodeIds":[205050122]},{"nodeId":205050122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":537905937,"text":"確かに重要だ…","nextNodeIds":[205050123,205050125]},{"nodeId":205050123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2760593993,"text":"友人たちは理解できるはずだ。","nextNodeIds":[205050124]},{"nodeId":205050124,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":151333321,"text":"彼らが協力してくださるなら、後の手続きは私がしておきますので。","nextNodeIds":[205050127]},{"nodeId":205050127,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":2609024641,"text":"では早速、「探索派遣」について説明しますね。","nextNodeIds":[205050128]},{"nodeId":205050128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2832253617,"text":"「探索派遣」確認","nextNodeIds":[]},{"nodeId":205050125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3383169937,"text":"報酬は？","nextNodeIds":[205050126]},{"nodeId":205050126,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":1542886321,"text":"安心してください、探索中に入手したものは全部あなたたちのものですよ。","nextNodeIds":[205050127]},{"nodeId":205050114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1121040681,"text":"友達を勧誘したいの！？","nextNodeIds":[205050115]},{"nodeId":205050115,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":992432145,"text":"いえ、誤解しないでください。あなたのご友人にはそれぞれ肩書きがあって、入会してもらう事が難しいのは分かっています。","nextNodeIds":[205050116]},{"nodeId":205050116,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":1773432257,"text":"だからこれは協会の無理な頼みというか。","nextNodeIds":[205050117]},{"nodeId":205050104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2065908865,"text":"また報酬がもらえるの？","nextNodeIds":[205050105]},{"nodeId":205050105,"roleType":"TALK_ROLE_NPC","speakerId":1512,"speakerName":"キャサリン","textMapHash":3995187217,"text":"ふふ、確かにそうなります。興味ありそうですね。","nextNodeIds":[205050106]}]}],"conditions":{"finis