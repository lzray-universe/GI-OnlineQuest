eDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7403002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7403002,"initDialog":740300201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5252],"performCfg":"QuestDialogue/Q7403002","priority":5,"questId":74030,"showRandomTalkCount":0},"dialogs":[{"nodeId":740300201,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":3652573882,"text":"君たち、やっと来てくれたか。助けてくれるんだろう？","nextNodeIds":[740300202,740300206]},{"nodeId":740300202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1322197658,"text":"え、読心術？怖っ！","nextNodeIds":[740300203]},{"nodeId":740300203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":909346194,"text":"ガルヴァーヤから助けてやれって頼まれたんだけど…なんで知ってるんだ！？","nextNodeIds":[740300204]},{"nodeId":740300204,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":112571930,"text":"ん？だって、ここで手助けできるのなんて、君たち以外にいないだろう？","nextNodeIds":[740300205]},{"nodeId":740300205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2053993578,"text":"…それもそっか！","nextNodeIds":[740300210]},{"nodeId":740300210,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":3269672794,"text":"で、やってもらうことは別に難しくない。ここのリサーチ端末は、二人で同時に操作する必要があってね。具体的なコマンドはもう登録してあるから、君たちはあっちのバーを下げるだけでいい。","nextNodeIds":[740300211]},{"nodeId":740300211,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2369210138,"text":"おっと、そうだ…エネルギー蓄積装置が近くにある。まずはエネルギー蓄積装置を設置してから起動させてくれ。","nextNodeIds":[740300212]},{"nodeId":740300212,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2654320234,"text":"それと…ちょっと確認させてほしいんだが…君たち、「機械を壊す」ような人じゃないよな？","nextNodeIds":[740300213,740300214]},{"nodeId":740300213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2659692834,"text":"その「壊す」の定義にもよる。","nextNodeIds":[740300215]},{"nodeId":740300215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":83245018,"text":"なんでそんなこと聞くんだよ？","nextNodeIds":[740300216]},{"nodeId":740300216,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":4144945626,"text":"以前、ガルヴァーナに手伝ってもらったことがあるんだが…ちょっと目を離した隙に、リサーチ端末が壊れてたんだよ。ガルヴァーナに聞いたら、自分でもよく分からないって。","nextNodeIds":[740300217]},{"nodeId":740300217,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2720627290,"text":"あとで彼女の妹に聞いたんだが、ガルヴァーナの手にかかれば機械は半日でオジャンになるそうだ。アラン·ギヨタンもガルヴァーナに会ったら、ため息をつくしかないだろうな。","nextNodeIds":[740300218]},{"nodeId":740300218,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":3685516074,"text":"その時の修理代は、私の報酬から差し引かれた…もし君たちがガルヴァーナと同じタイプなら、私は長いこと働いた上に、最後には特別許可券まで渡さなきゃならない羽目になる…","nextNodeIds":[740300219]},{"nodeId":740300219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2601444218,"text":"そ、そんなことがあったのか…でも、オイラたちはあいつとは違うから安心してくれ！","nextNodeIds":[740300220]},{"nodeId":740300220,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":1442437562,"text":"そうか。じゃあ、頼んだぞ。","nextNodeIds":[]},{"nodeId":740300214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1965049474,"text":"端末が攻撃してきたら、壊すけど。","nextNodeIds":[740300215]},{"nodeId":740300206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4066280962,"text":"報酬なしに助けるわけには…","nextNodeIds":[740300207]},{"nodeId":740300207,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":199230970,"text":"その点については、あとでガルヴァーヤに申請してもらおう。","nextNodeIds":[740300208]},{"nodeId":740300208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3049975066,"text":"えっ？でもあいつはさっき、おまえから直接受け取れって言ってたけど…","nextNodeIds":[740300209]},{"nodeId":740300209,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":4089447226,"text":"そんなこと言ってたのか？そうか、仕方ない。ここで経費を申請するのは、フォンテーヌ科学院よりも難しいんだけどな…","nextNodeIds":[740300210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7403003,"order":3,"stepDescription":"クランツの端末操作を手伝う","stepDescTextMapHash":2865124692,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7403003"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["133408109","109002","4359.9:188.74:4788.602"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_GADGET"},"is