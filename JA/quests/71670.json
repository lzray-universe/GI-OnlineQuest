,"",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7167002","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7167002,"initDialog":716700201,"nextRandomTalks":[],"nextTalks":[],"npcId":[15331,1016,1048],"performCfg":"QuestDialogue/WQ/LeyLineChallenge_71670/Q7167002","priority":5,"questId":71670,"showRandomTalkCount":0},"dialogs":[{"nodeId":716700201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":449026834,"text":"うーん…なんか変だな。向こうに見える地脈の穢れの煙…見れば見るほど不気味だぞ。あそこからヤバい魔物でも湧いてるのか？","nextNodeIds":[716700202]},{"nodeId":716700202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3238609530,"text":"千岩軍がわざわざ拠点を作って、見回りの兵や防御施設をいっぱい置いてるみたいだな！","nextNodeIds":[716700203,716700204]},{"nodeId":716700203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":964431746,"text":"前にも似たような光景を見たかも。","nextNodeIds":[716700205]},{"nodeId":716700205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1628819890,"text":"おう！今まで通り、千岩軍と力を合わせて魔物をやっつけようぜ！地脈の穢れのことはその後で考えよう！","nextNodeIds":[716700206]},{"nodeId":716700206,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"方謹","textMapHash":1564786986,"text":"止まってください。この先は危険です。","nextNodeIds":[716700207]},{"nodeId":716700207,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"方謹","textMapHash":2393125850,"text":"…！？そのオーラ…まさか、教官ですか！？","nextNodeIds":[716700208]},{"nodeId":716700208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2060340130,"text":"教官？おまえ、オイラが寝てる間に千岩軍でバイトでもしてたのかよ？","nextNodeIds":[716700209,716700210]},{"nodeId":716700209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1717587866,"text":"ええ…","nextNodeIds":[716700211]},{"nodeId":716700211,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"方謹","textMapHash":3797937530,"text":"私は方謹——この千岩軍の分隊のリーダーを務めています。参謀の蘇定から、お噂はかねがね…百年に一人の素晴らしい才能をお持ちとか。","nextNodeIds":[716700212]},{"nodeId":716700212,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"方謹","textMapHash":748033402,"text":"西風騎士団の栄誉騎士は、緊急時には隊長級の指揮権を有すると聞きます。教官という呼び方も、あながち間違いではないでしょう。","nextNodeIds":[716700213]},{"nodeId":716700213,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"方謹","textMapHash":2334045202,"text":"そんなことより、玉衡様のところへご同行願えませんか。","nextNodeIds":[716700214]},{"nodeId":716700214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1026246226,"text":"刻晴もいたのか！","nextNodeIds":[716700215]},{"nodeId":716700215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2900082354,"text":"ってことは、事態はそう単純じゃなさそうだ。一発殴って解決、とはいかないだろうな…","nextNodeIds":[716700216]},{"nodeId":716700216,"roleType":"TALK_ROLE_NPC","speakerId":15331,"speakerName":"方謹","textMapHash":3175119586,"text":"玉衡様——予想通り、旅人と副官のパイモンが来てくださいました。","nextNodeIds":[716700217]},{"nodeId":716700217,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1616252922,"text":"ご苦労さま。","nextNodeIds":[716700218]},{"nodeId":716700218,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":103006170,"text":"久しぶり。相変わらず、情報が入るや否や、すぐ前線に駆けつけるのね。","nextNodeIds":[716700219,716700220]},{"nodeId":716700219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3250774242,"text":"手伝いに来てあげた！","nextNodeIds":[716700221]},{"nodeId":716700221,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2394799506,"text":"手短に話すわ。","nextNodeIds":[716700222]},{"nodeId":716700222,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":404452634,"text":"ここの地脈の穢れは長い間安定していたんだけど、なぜか最近急に活発になって、魔物の襲撃事件を何度も引き起こしているの。","nextNodeIds":[716700223]},{"nodeId":716700223,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2714864930,"text":"溢れ出る魔物を排除した後も、乱れが収まらなくて、触れた者を奇妙な秘境へと送り込んでいる…今までにないことよ。","nextNodeIds":[716700224]},{"nodeId":716700224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3415092426,"text":"おかしいな…まさか、この地脈の穢れが…行き来できるポイントになってるのか？","nextNodeIds":[716700225]},{"nodeId":716700225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":898888466,"text":"こんな人数じゃ足りないんじゃないのか？早く増援を呼ぼうぜ！","nextNodeIds":[716700226]},{"nodeId":716700226,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1344972778,"text":"それなら心配はいらないわ。今のところ、防衛線はとても安定している。みんな帰離原からの精鋭部隊で、経験豊富な兵士ばかりなの。一騎当千と言っても過言ではないわ。","nextNodeIds":[716700227]},{"nodeId":716700227,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":149413226,"text":"ただ…厄介なことに、地脈の乱れを引き起こした根本的な原因が見つからないの。このままずるずるとここに駐屯していても、人と資源を浪費して、部隊を疲弊させるだけよ。","nextNodeIds":[716700228]},{"nodeId":716700228,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3895551002,"text":"敵の弱点を狙って、無駄なく兵を遣るべきだわ。受け身ばかりでは、いつまでも勝てないもの。","nextNodeIds":[716700229]},{"nodeId":716700229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":393537874,"text":"確かにな…殴られるたびに反撃だなんて、そんなのやってられないぞ！","nextNodeIds":[716700230]},{"nodeId":716700230,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3248132626,"text":"すでに夜蘭が部下を連れて秘境を調査しているわ。あと数時間もしたら、重要情報を持って帰ってくるはずよ。","nextNodeIds":[716700231]},{"nodeId":716700231,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2795995106,"text":"あら、ごめんなさい。玉衡様が旅人と心ゆくまでおしゃべりできるように、ゆっくり帰ってきた方が良かったかしら？","nextNodeIds":[716700232]},{"nodeId":716700232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3240735706,"text":"うわっ、いつからいたんだよ！","nextNodeIds":[716700233]},{"nodeId":716700233,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2052386010,"text":"早かったわね。調査、うまくいかなかったの？","nextNodeIds":[716700234]},{"nodeId":716700234,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":4104397562,"text":"半々ってところね。","nextNodeIds":[716700235]},{"nodeId":716700235,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":163557746,"text":"良い知らせとしては、大まかな状況は見えてきたわ。今回の異常現象は、地脈の乱れの余韻によるものよ。","nextNodeIds":[716700236]},{"nodeId":716700236,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2659268498,"text":"既存のサンプルの調査結果と、軍事史の記述を照らし合わせた結果…地脈は記録のある悲惨な戦いを秘境の中で再現していることがわかったわ。溢れ出る魔物もその一部でしょうね。","nextNodeIds":[716700237]},{"nodeId":716700237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2249003354,"text":"地脈の乱れ…","nextNodeIds":[716700238]},{"nodeId":716700238,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":681686242,"text":"旅人はピンと来るんじゃないかしら？","nextNodeIds":[716700239]},{"nodeId":716700239,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3509236922,"text":"モンドでも似たような現象が起きたそうね。","nextNodeIds":[716700240]},{"nodeId":716700240,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":458693778,"text":"幸い、その時の状況はそれほど深刻ではなく、栄誉騎士と闇夜の英雄が力を合わせて、地脈の穢れから湧き出る魔物を排除し続け…","nextNodeIds":[716700241]},{"nodeId":716700241,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3746406978,"text":"地脈に蓄えられた「情報」をすべて消費することで、最終的には正常な状態に戻ったとか。つまり、消耗戦で勝利を収めたというわけね。","nextNodeIds":[716700242]},{"nodeId":716700242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2118749778,"text":"あの時と同じことが起きてたのか…どうりで今回も赤いわけだぜ。","nextNodeIds":[716700243,716700244]},{"nodeId":716700243,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3468552346,"text":"その栄誉騎士って誰だろう？すごい！","nextNodeIds":[716700245]},{"nodeId":716700245,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":1748881130,"text":"なるほど、あくまで軽快にあしらうことで、暗に今の自分ならもっと出来ることを伝えて報酬を吊り上げようって魂胆ね。大丈夫、今回はがっかりさせないわ。","nextNodeIds":[716700246]},{"nodeId":716700246,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2522383226,"text":"えっ…な、なにいってるんだ？","nextNodeIds":[716700247]},{"nodeId":716700247,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":132417394,"text":"それで、悪い知らせのほうは？","nextNodeIds":[716700248]},{"nodeId":716700248,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2394502858,"text":"ええ、見ての通り、今回の地脈の乱れは今までとは違う。外に出た魔物を片付けるだけでは不十分よ。","nextNodeIds":[716700249]},{"nodeId":716700249,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3758986154,"text":"全ての魔物を排除しながら、一気に秘境の最深部に向かわないと、何度でも繰り返されるわ。","nextNodeIds":[716700250]},{"nodeId":716700250,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3243237738,"text":"それに、乱れ地点に繋がる秘境には、なにか特殊なルールがあるみたいなの。私と兵士たちを警戒し、捜査を拒んでいるわ。","nextNodeIds":[716700251]},{"nodeId":716700251,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":4200509858,"text":"最初は、秘境の中にある物を採取したりもできたんだけど、奥へと進むうちに兵士たちは衰弱して、いつもの力を発揮できなくなった…","nextNodeIds":[716700252]},{"nodeId":716700252,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3396299682,"text":"進むにつれて魔物もどんどん凶暴になるし、性質も多種多様になって…かなり手ごわかったわ。","nextNodeIds":[716700253]},{"nodeId":716700253,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2830863274,"text":"地脈による制限を受けずに済む者だけが、妨害を無効化して、そこに存在する特殊なルールを調べられるみたい…","nextNodeIds":[716700254]},{"nodeId":716700254,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":752429602,"text":"そういう人材が兵を率いれば、危険な環境を乗り越え、地脈の乱れを根本から是正することができるでしょうね。","nextNodeIds":[716700255,716700256]},{"nodeId":716700255,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1730842954,"text":"理解した！","nextNodeIds":[716700257]},{"nodeId":716700257,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1444607114,"text":"つまり、地脈の乱れが活動を休止するまで、外で魔物を退治し続けるか——","nextNodeIds":[716700258]},{"nodeId":716700258,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1535731402,"text":"旅人が兵を率いてその中に突入し、その源を制圧するかってことね。","nextNodeIds":[716700259]},{"nodeId":716700259,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1766572298,"text":"二つのプランを考えないと。","nextNodeIds":[716700260]},{"nodeId":716700260,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":178509642,"text":"凝光に連絡して、防衛費を増やしてもらうわ。開陽にも、すぐに後続の交替部隊を手配するように伝えましょう。","nextNodeIds":[716700261]},{"nodeId":716700261,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2172194538,"text":"あれ？この流れでそのまま旅人に依頼しないのか？","nextNodeIds":[716700262]},{"nodeId":716700262,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2845829730,"text":"璃月の安寧を守るのは、千岩軍と七星の使命。人員をなるべく危険から遠ざけるのが、指揮者の責務よ。","nextNodeIds":[716700263]},{"nodeId":716700263,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2794377602,"text":"私個人の気持ちからしても、君にすべての危険を背負わせたくない。","nextNodeIds":[716700264]},{"nodeId":716700264,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":626677250,"text":"だから、気が乗らないなら千岩軍を長期的に駐屯させ、複数の部隊を交代で作戦に投入し、兵士の育成を兼ねて魔物を討伐させることもできる。","nextNodeIds":[716700265]},{"nodeId":716700265,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":167263242,"text":"同時に斥候を派遣して秘境内の情報を収集し、その特性を引き続き調べるわ。ゆくゆくは部隊を率いて、一気に制圧できるようにね。","nextNodeIds":[716700266]},{"nodeId":716700266,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3262298050,"text":"もちろん、君が手伝ってくれると言うなら、駐屯部隊の総力をあげて支援するわ。","nextNodeIds":[716700267]},{"nodeId":716700267,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":357014930,"text":"地脈の乱れを効果的に抑制できたら、それ相応の報酬も支払いましょう。","nextNodeIds":[716700268,716700269]},{"nodeId":716700268,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2283303170,"text":"#{M#俺}{F#私}には手伝う義理がある！","nextNodeIds":[716700270]},{"nodeId":716700270,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1581297674,"text":"そうだな。璃月の仲間としても、最強冒険者コンビとしても、刻晴と夜蘭の友達としても、見て見ぬふりなんかできないぞ！","nextNodeIds":[716700271]},{"nodeId":716700271,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2761649546,"text":"報酬については最初から心配してないぜ。刻晴も夜蘭も、オイラたちをぞんざいに扱わないって分かってるからな！","nextNodeIds":[716700272]},{"nodeId":716700272,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":808762290,"text":"いい目ね。","nextNodeIds":[716700273]},{"nodeId":716700273,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2057869850,"text":"ありがとう——じゃあ、協力をお願いするわ。","nextNodeIds":[716700274]},{"nodeId":716700274,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3502385258,"text":"夜蘭、旅人を秘境の奥へ連れていくよう部下に知らせて。","nextNodeIds":[716700275]},{"nodeId":716700275,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3437623962,"text":"待って、まずは分析しないと。乱れ地点は周期的に状態を変化させている。慎重に行くべきよ。","nextNodeIds":[716700276]},{"nodeId":716700276,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2772583970,"text":"旅人もその間に準備してちょうだい。最善のチームを組んで、激戦に備えましょう。","nextNodeIds":[716701201]},{"nodeId":716701201,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2211559722,"text":"チャンスよ。今入れば、秘境の中心に入っていけるはず…","nextNodeIds":[716701202]},{"nodeId":716701202,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2191089634,"text":"大事なのは進みながら「ルール」を見極め、適切な方法で敵を倒すことよ。","nextNodeIds":[716701203]},{"nodeId":716701203,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3548683274,"text":"周りの環境や味方の状況に注意しながら、慎重に進んでね。","nextNodeIds":[716701204]},{"nodeId":716701204,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3151370882,"text":"事態が思わしくない時は、一時撤退して態勢を整えてもいいのよ。無理はしないで。","nextNodeIds":[716701205]},{"nodeId":716701205,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":208350042,"text":"無事の帰還を祈ってるわ。","nextNodeIds":[716701206,716701207]},{"nodeId":716701206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":116999066,"text":"全力を尽くす！","nextNodeIds":[716701208]},{"nodeId":716701208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1487774746,"text":"おう！刻晴、夜蘭、朗報を待っててくれよな！","nextNodeIds":[]},{"nodeId":716701207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2143637154,"text":"頑張って戦う！","nextNodeIds":[716701208]},{"nodeId":716700269,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2493136258,"text":"一緒に戦う仲間もたくさんいる！","nextNodeIds":[716700270]},{"nodeId":716700256,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1550895938,"text":"#{M#俺}{F#私}以外にいないってことだね！","nextNodeIds":[716700257]},{"nodeId":716700244,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1285449394,"text":"そんなことあったっけ？","nextNodeIds":[716700245]},{"nodeId":716700220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2662952362,"text":"大げさだね——頑張るけど。","nextNodeIds":[716700221]},{"nodeId":716700210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2045899394,"text":"#{M#俺}{F#私}が教官？","nextNodeIds":[716700211]},{"nodeId":716700204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3701852930,"text":"気を抜かずに、戦いの準備を…","nextNodeIds":[716700205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_310500127:975.844,260.604,-187.825,0.000,320.995,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7167003,"order":3,"stepDescription":"乱れ地点を経由して秘境に向かう","stepDescTextMapHash":3309771396,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167011,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7167012,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIE