{"mainQuestId":71670,"title":"危機一掃","description":"冒険者協会からの情報によると、璃月の「地中の塩」一帯で、何らかの異変が発生したようだ。千岩軍はすでに現場を封鎖している。パイモンと一緒に、現場に行って状況を確かめることにした…","titleTextMapHash":2631943495,"descTextMapHash":251042678,"mainQuestExcel":{"mainQuestId":71670,"titleTextMapHash":2631943495,"title":"危機一掃","descTextMapHash":251042678,"description":"冒険者協会からの情報によると、璃月の「地中の塩」一帯で、何らかの異変が発生したようだ。千岩軍はすでに現場を封鎖している。パイモンと一緒に、現場に行って状況を確かめることにした…","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ71670","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":251042678,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71670,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":2505039297,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71670","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171670],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2631943495,"type":"WQ","unlockDescTextMapHash":1901840886}},"flow":[{"subQuestId":7167001,"order":1,"stepDescription":"","stepDescTextMapHash":3480243628,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7167001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_G