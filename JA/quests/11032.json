,"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1103203","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1103202,"initDialog":110320201,"nextRandomTalks":[],"nextTalks":[],"npcId":[202901,1015],"performCfg":"QuestDialogue/LQ/Ganyu1_11032/Q1103203","priority":5,"questId":11032,"showRandomTalkCount":0},"dialogs":[{"nodeId":110320201,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":2699370658,"text":"来てくれてありがとうございます、先輩。二人も、よく来てくれた。","nextNodeIds":[110320202]},{"nodeId":110320202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":350255266,"text":"気にするな！","nextNodeIds":[110320203]},{"nodeId":110320203,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":3744808762,"text":"準備ご苦労様です。そんなに気を遣わなくてもいいのに。","nextNodeIds":[110320204]},{"nodeId":110320204,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":1541753978,"text":"あー、実は…先輩、さっきのこと以外にも、まだ相談したいことがあるんです…","nextNodeIds":[110320205]},{"nodeId":110320205,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":2854535098,"text":"そうですか？助けが必要ならためらわず、直接言ってください。","nextNodeIds":[110320206]},{"nodeId":110320206,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":3501129314,"text":"えー、いや、助けが必要なわけでは…うーん…少しお話を聞いてくれますか？","nextNodeIds":[110320207]},{"nodeId":110320207,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":831830522,"text":"よろこんで。","nextNodeIds":[110320208]},{"nodeId":110320208,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":3695452162,"text":"ふふ…私は小さい頃から、甘雨先輩のお話をたくさん父上から聞かされてきました。","nextNodeIds":[110320209]},{"nodeId":110320209,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":349562146,"text":"父上のこともとても尊敬していますが、いつも甘雨先輩の優しさと頼りがいのある姿に惹かれていました…","nextNodeIds":[110320210]},{"nodeId":110320210,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":3445603202,"text":"あなたの背中を追いかけて、私は月海亭にやってきたのです。","nextNodeIds":[110320211]},{"nodeId":110320211,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":28936170,"text":"そのように思ってくれていたのですね…","nextNodeIds":[110320212]},{"nodeId":110320212,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":1612756778,"text":"でもやはり、月海亭の秘書の仕事はとても大変です。","nextNodeIds":[110320213]},{"nodeId":110320213,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":2264130154,"text":"私は先輩のように優秀ではありません。だから、よく悩んでしまうのです…","nextNodeIds":[110320214]},{"nodeId":110320214,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":2939151890,"text":"そんなことありません。慧心はとても良くやっていますよ。","nextNodeIds":[110320215]},{"nodeId":110320215,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":2676630690,"text":"ふふ、ありがとうございます、先輩。","nextNodeIds":[110320216]},{"nodeId":110320216,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":3481302586,"text":"数年前、私にも娘が生まれて…","nextNodeIds":[110320217]},{"nodeId":110320217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1084272114,"text":"えっ！天おじはもうおじいちゃんってことか！","nextNodeIds":[110320218]},{"nodeId":110320218,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":2725506322,"text":"私の影響で、娘も当時の私と同じように、月海亭の秘書になるのが夢です。","nextNodeIds":[110320219]},{"nodeId":110320219,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":3914064282,"text":"でも、正直心配でした。この仕事は一筋縄ではいかない上、あの子に素質があるかどうかもまだ分かりません。","nextNodeIds":[110320220]},{"nodeId":110320220,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":308430394,"text":"でも今回のことを通して、私はあの子を応援すると決めました。","nextNodeIds":[110320221]},{"nodeId":110320221,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":689518450,"text":"えっ、それはなぜ…","nextNodeIds":[110320222]},{"nodeId":110320222,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":1239177010,"text":"あの子が将来、甘雨という先輩に出会えるからです。","nextNodeIds":[110320223]},{"nodeId":110320223,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":2544895530,"text":"甘雨先輩は優しくあの子を導き、当時のあなたの母も同じようだった、と伝えてくれるはずです。","nextNodeIds":[110320224]},{"nodeId":110320224,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":617387026,"text":"その情景は素晴らしいものだと思いました。","nextNodeIds":[110320225]},{"nodeId":110320225,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":3276781890,"text":"だから——二十年後のことも先輩に頼みましたよ。","nextNodeIds":[110320226]},{"nodeId":110320226,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":1028026210,"text":"慧心…","nextNodeIds":[110320227]},{"nodeId":110320227,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":2251131418,"text":"…わ、私の存在があなたにとって、そんなに意味あるものだったなんて…","nextNodeIds":[110320228]},{"nodeId":110320228,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":825541842,"text":"ふふ、先輩が父上のやり方を見せてくれたのと同じように、先輩が「立会人」になってくれると安心するんです。","nextNodeIds":[110320229]},{"nodeId":110320229,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":3230422146,"text":"「立会人」…","nextNodeIds":[110320230]},{"nodeId":110320230,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":3555976746,"text":"…確かに、私は何千年も璃月の発展や変化に立ち会ってきました…","nextNodeIds":[110320231]},{"nodeId":110320231,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":2266045354,"text":"でも、それはずっと私に孤独しか与えていないと思っていました。","nextNodeIds":[110320232]},{"nodeId":110320232,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":893755818,"text":"慧心、あなたのさっきの話は、私にとってとても意味あるものです…","nextNodeIds":[110320233]},{"nodeId":110320233,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":4100740538,"text":"岩王帝君との「契約」以外にも、この璃月港の人々との繋がりがあったのだと感じさせてくれました。","nextNodeIds":[110320234]},{"nodeId":110320234,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":1518449154,"text":"私を頼り、認め、求めていた人がいたのですね。","nextNodeIds":[110320235]},{"nodeId":110320235,"roleType":"TALK_ROLE_NPC","speakerId":202901,"speakerName":"慧心","textMapHash":2968520850,"text":"当たり前です。あなたは私の唯一の先輩ですよ！","nextNodeIds":[110320236]},{"nodeId":110320236,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":964364794,"text":"ふふ…そうですね。しっかり皆さまに応えなければ。","nextNodeIds":[110320237]},{"nodeId":110320237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1601441338,"text":"そうだぞ！やっと元通りになったな！","nextNodeIds":[110320238]},{"nodeId":110320238,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":3451007938,"text":"仮に本当に追い出されてたとしても、少し抵抗してみます…","nextNodeIds":[110320239]},{"nodeId":110320239,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":2829321170,"text":"あなたの思いに応えるためにもこれからも「契約」を履行し、「七星」の秘書として居続けます。","nextNodeIds":[110320240,110320241]},{"nodeId":110320240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1342789346,"text":"はあ…最初からそう言ってたのに…","nextNodeIds":[110320242]},{"nodeId":110320242,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","tex