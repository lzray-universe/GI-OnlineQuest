apHash":78485682,"text":"大丈夫だって、オイラたちを誰と思ってるんだ！ほら、こうして無事に帰って来ただろ？しかも、ちゃんと調査も終わらせてきたぞ。","nextNodeIds":[80080105]},{"nodeId":80080105,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"玥輝","textMapHash":1305717962,"text":"なんと、そいつはすごいな！で、下はどんな様子だった？","nextNodeIds":[80080106]},{"nodeId":80080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":820591074,"text":"あっ、えっと…そうだな…","nextNodeIds":[80080107,80080109]},{"nodeId":80080107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3441764914,"text":"ヒルチャールたちが老後の生活を送ってた。","nextNodeIds":[80080108]},{"nodeId":80080108,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"玥輝","textMapHash":2655706298,"text":"老後の生活？","nextNodeIds":[80080111]},{"nodeId":80080111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2116149298,"text":"と…とにかく、そこへ行ったヒルチャールはもう攻撃してこないから、鉱夫さんたちも彼らを邪魔しないでやってくれ。","nextNodeIds":[80080112,80080113]},{"nodeId":80080112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2929316378,"text":"そういうこと。","nextNodeIds":[80080114]},{"nodeId":80080114,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"玥輝","textMapHash":3133543186,"text":"ああ、俺たち鉱夫は面倒事が一番嫌いだからな、こっちから手を出すことはまずないだろう。それに、俺たちの目には光り輝くものか、黄金色のものしか映らないから安心しろ。","nextNodeIds":[80080115]},{"nodeId":80080115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3027373450,"text":"お、おう…それなら大丈夫そうだな。","nextNodeIds":[80080116]},{"nodeId":80080116,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"玥輝","textMapHash":2253354218,"text":"まあ、あんたたちが報告してくれたことは、正直よく分からないが…二人が大丈夫だと言うのなら、作業を再開してもいいってことだろ？","nextNodeIds":[80080117]},{"nodeId":80080117,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"玥輝","textMapHash":4034155170,"text":"ありがとう！二人のおかげで俺たちも一安心だ！礼を受け取ってくれ。","nextNodeIds":[]},{"nodeId":80080113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2875450378,"text":"安心していい。","nextNodeIds":[80080114]},{"nodeId":80080109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":424356258,"text":"下はヒルチャールたちの理想郷だった。","nextNodeIds":[80080110]},{"nodeId":80080110,"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"玥輝","textMapHash":2902708578,"text":"理想郷？","nextNodeIds":[80080111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[800801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[800801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":12423,"speakerName":"玥輝","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[108008],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":0,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/AQ/Twins2_8008/Q800801","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TAL