logs":[{"nodeId":240200101,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":4231486242,"text":"本当にツイてないな。もう潜るのはごめんだ！","nextNodeIds":[240200102,240200103]},{"nodeId":240200102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2844821162,"text":"どうしたの？","nextNodeIds":[240200104]},{"nodeId":240200104,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":3135131770,"text":"お前か。会えてよかったぜ。ふぅ…あやうく命を落とすとこだった。","nextNodeIds":[240200105]},{"nodeId":240200105,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":637271274,"text":"さっき、いつものように水中に潜って仕事してたんだ。水草やごみを避けて、何かに引っかけたり刺されたりもせずに順調に進んでたんだが…","nextNodeIds":[240200106]},{"nodeId":240200106,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":1594133138,"text":"モノを持ち上げようとした時、水底の泥の中から魔物の群れが現れたんだ！","nextNodeIds":[240200107]},{"nodeId":240200107,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":2675118850,"text":"どんな魔物かはあまり覚えてないけど、急にぶつかってきてな。慌ててその場から逃げて、上に向かって必死に泳ぐしかなかった。","nextNodeIds":[240200108]},{"nodeId":240200108,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":3251837258,"text":"だが間もなくして、今度は変わった形のマシナリーにばったり遭遇したのさ。やつらは俺を見つけるなり、狂ったかのように突っ込んできた。","nextNodeIds":[240200109]},{"nodeId":240200109,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":731456618,"text":"どうやって岸まで逃げてきたのかさえ、覚えてない。だが特に怪我もしてないし、潜水服も破れてなくてほっとしたぜ…","nextNodeIds":[240200110,240200111]},{"nodeId":240200110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2356202434,"text":"危険だから、ここを潜るのはよそう。","nextNodeIds":[240200112]},{"nodeId":240200112,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":490206634,"text":"そうもいかないのさ。ここはゴールドマンが指定した場所でな…前もここで仕事してて、怪我をしたり、命を落としたりした人がいたんだ。","nextNodeIds":[240200113]},{"nodeId":240200113,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":2529494306,"text":"そんな事態が続いた結果、ゴールドマンに給料を減らされると脅されても、誰もここに来ようとしなくなった。","nextNodeIds":[240200114]},{"nodeId":240200114,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":4201102674,"text":"しばらく経ったら、ゴールドマンは他の手を打ったんだ。ここで働いてくれる人に、三倍の給料を払うとな。","nextNodeIds":[240200115]},{"nodeId":240200115,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":513010906,"text":"それで…俺と金欠で困ってる潜水士の何人かが名乗り出て、シフトを組んでここで働くことになった。水中の護身用に矛と銛まで買ったんだよ。","nextNodeIds":[240200116]},{"nodeId":240200116,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":200847746,"text":"ただ数日も経ってないのに、それらの武器は折れたり、失くなったりしてな…今、他のやつらが街に行って買いなおしてるところだ。で、俺はここで留守番中ってわけさ。","nextNodeIds":[240200117,240200118]},{"nodeId":240200117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":37314970,"text":"こんな状況でさっき潜ってたの？","nextNodeIds":[240200119]},{"nodeId":240200119,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":2345399290,"text":"あいつらが行って結構経ってるのにまだ帰ってこないし、もう仕事を始めないとならん。夜、どんだけ遅くなるか分かんないからな。","nextNodeIds":[240200120]},{"nodeId":240200120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3086039554,"text":"#{M#俺}{F#私}が手伝って…","nextNodeIds":[240200121]},{"nodeId":240200121,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":875394034,"text":"ダメだ！絶対ダメ。ここの水中には本当に魔物がいるんだぜ。普通の冒険者の手に負えやしない。お前をそんな危険に晒すわけにはいかん。","nextNodeIds":[240200122,240200123]},{"nodeId":240200122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2164833170,"text":"#{M#俺}{F#私}は普通の冒険者じゃない。","nextNodeIds":[240200124]},{"nodeId":240200124,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":2933125738,"text":"お前は…確かに普通には見えないけどよ…","nextNodeIds":[240200125]},{"nodeId":240200125,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":700514642,"text":"分かった。お前がそう言うなら、目標の位置をマークしておこう。くれぐれも気を付けるんだぞ。","nextNodeIds":[]},{"nodeId":240200123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1476362042,"text":"#{M#俺}{F#私}が普通の冒険者に見える？","nextNodeIds":[240200124]},{"nodeId":240200118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3189495858,"text":"護身用の武器がないのに潜ってたの？","nextNodeIds":[240200119]},{"nodeId":240200111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":422631458,"text":"危険だから、場所を変えたほうがいい。","nextNodeIds":[240200112]},{"nodeId":240200103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1717177618,"text":"何かあったの？","nextNodeIds":[240200104]}]},{"talkId":2402006,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["2401701","1","","",""],"type":"TALK_EXEC_INC_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2402001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2401701","2","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2402006,"initDialog":240200601,"nextRandomTalks":[],"nextTalks":[],"npcId":[5142],"performCfg":"","priority":8,"questId":24020,"showRandomTalkCount":0},"dialogs":[{"nodeId":240200601,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":3215178890,"text":"はぁ…マジでついてないな…","nextNodeIds":[240200602]},{"nodeId":240200602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1577688674,"text":"モノは売れたの？","nextNodeIds":[240200603]},{"nodeId":240200603,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":646495858,"text":"お前か。はぁ、実はこっそり買い手を探してたのに、ゴールドマンのやつが突然俺の部屋に押し入ってきてな。アクセサリーを全部かっさらって行ったんだ！","nextNodeIds":[240200604]},{"nodeId":240200604,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":1971771178,"text":"もし俺に働いてもらう必要がなかったら、やつはきっと俺をボコボコに殴ってたんだろう…二ヶ月分の給料が飛んじまった…","nextNodeIds":[240200616]},{"nodeId":240200616,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":1154959578,"text":"今年の仕事を全部完了したら、給料を払ってくれるって言うんだ。","nextNodeIds":[240200605]},{"nodeId":240200605,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":3217380058,"text":"はぁ…もういい。俺みたいなバカに幸運が訪れるわけがない…ゴールドマンはお前んとこに行ってないよな？","nextNodeIds":[240200606,240200609]},{"nodeId":240200606,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":804913170,"text":"来てないよ。","nextNodeIds":[240200607]},{"nodeId":240200607,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":1153454474,"text":"ならよかった。俺がやられるのは構わんけど、やつがお前に迷惑をかけるのは嫌なんだ。","nextNodeIds":[240200608]},{"nodeId":240200608,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":2181782410,"text":"お前が手伝ってくれたことは誰にも言ってない。なんとなくだけど、もし誰かに言ったら、あのケチにチクりそうな気がしてな。","nextNodeIds":[240200611]},{"nodeId":240200611,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":323225490,"text":"それはそうとして、今日はどうしてもお前に頼まないといけないことがある。潜水服はまだ直せてないのに、ゴールドマンのやつに催促されまくっててな。この数日で遅れた仕事を全部間に合わせろって。","nextNodeIds":[240200612]},{"nodeId":240200612,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":3426223154,"text":"仕方なく、他の人の潜水服を借りて、急いで仕事をしたけど…どうしても間に合わない。だから、お前に頼むしかないんだ。どうか、もう一回助けてくれ。","nextNodeIds":[240200613,240200614]},{"nodeId":240200613,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3116398130,"text":"いいよ！","nextNodeIds":[240200615]},{"nodeId":240200615,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":2629380714,"text":"ありがとう。位置をマークしてあげるから手分けして探そう。","nextNodeIds":[]},{"nodeId":240200614,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1344996826,"text":"任せて。","nextNodeIds":[240200615]},{"nodeId":240200609,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2620777194,"text":"彼が来たら、しっかり教育してあげる。","nextNodeIds":[240200610]},{"nodeId":240200610,"roleType":"TALK_ROLE_NPC","speakerId":5142,"speakerName":"イヴス","textMapHash":603621970,"text":"あの豚とは絶対に関わるな。やつは卑劣で恥知らずなんだ！お前のような尊敬に値する人は、やつと知り合うべきじゃない。","nextNodeIds":[240200611]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2402001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[2402006,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["0","0","2"],"PAINLIBBLDK":"QUEST_EXEC_RANDOM_CLOSED_QUEST_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDC