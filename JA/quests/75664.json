":0},"dialogs":[{"nodeId":756640101,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":4154948746,"text":"#{NICKNAME}とパイモン！ははっ、やっと会えたな。","nextNodeIds":[756640102]},{"nodeId":756640102,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":1784717106,"text":"栄華の演武へようこそ。ここがメイン会場だ。君たちが参加するという話は、族長たちから聞いてるよ。","nextNodeIds":[756640103]},{"nodeId":756640103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2688287522,"text":"よろしくな！でも、ルールとかあまり知らなくて…説明してくれないか？","nextNodeIds":[756640104]},{"nodeId":756640104,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":3924117546,"text":"じゃあ、簡単に紹介しよう。","nextNodeIds":[756640105]},{"nodeId":756640105,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":514163962,"text":"栄華の演武は「攻略戦」と「防衛戦」に分かれる。","nextNodeIds":[756640106]},{"nodeId":756640106,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":3518763234,"text":"防衛戦は簡単だ。相手が部族に攻め入るのを防げばいい。一方、攻略戦は少し複雑だ。自分たちの部族がすでに陥落したと仮定して、反撃に出るんだ。","nextNodeIds":[756640107]},{"nodeId":756640107,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":976519914,"text":"試合を面白くするために、特別な儀式道具も作ったんだ。攻撃側はその道具にエネルギーをチャージして、相手の張った結界を破らないといけない。","nextNodeIds":[756640108]},{"nodeId":756640108,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":1392998738,"text":"試合とはいえ、むやみな衝突や暴力は避けるべきだ。壊したものは直して、魔物に遭ったらできるだけ早めに倒してくれ。","nextNodeIds":[756640109]},{"nodeId":756640109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2890019746,"text":"#うぅ…オイラ、もう頭がパンパンだぞ。{NICKNAME}、覚えられたか？","nextNodeIds":[756640110,756640111]},{"nodeId":756640110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2250520282,"text":"パイモンと同じ…","nextNodeIds":[756640112]},{"nodeId":756640112,"roleType":"TALK_ROLE_NPC","speakerId":30774,"speakerName":"バロー","textMapHash":3188624874,"text":"心配するな。分