"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7182302,"initDialog":718230201,"nextRandomTalks":[],"nextTalks":[],"npcId":[213901],"performCfg":"","priority":0,"questId":71823,"showRandomTalkCount":0},"dialogs":[{"nodeId":718230201,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":612003890,"text":"うーん…やっぱり薬剤が足りないわ…","nextNodeIds":[718230202]},{"nodeId":718230202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3889800674,"text":"薬草採りに行くの？","nextNodeIds":[718230203]},{"nodeId":718230203,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":4085358546,"text":"うん、今薬草採りに行くところだったの。毎年この時期になると、薬をたくさん用意するの。","nextNodeIds":[718230204]},{"nodeId":718230204,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":3828687402,"text":"別にそんなに凄い薬でもないんだけどね…腸チフスを治療したり、消化を助ける薬なんだ。","nextNodeIds":[718230205]},{"nodeId":718230205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1894212978,"text":"どうして不卜廬で買わないの？","nextNodeIds":[718230206]},{"nodeId":718230206,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":3668596994,"text":"だってここから凄く遠いからだよ。ここから璃月港まで歩くのはとても時間がかかるの。","nextNodeIds":[718230207]},{"nodeId":718230207,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":3314757706,"text":"それに、軽策荘にいるのはお年寄りと子供ばかりだから、冒険者のあなたみたいにたくさん歩くことはできないの。","nextNodeIds":[718230208]},{"nodeId":718230208,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":1857888834,"text":"だから、もしもの時のために、私も事前に薬を用意してるんだ。","nextNodeIds":[718230209]},{"nodeId":718230209,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":1080227650,"text":"でも、もし本当に深刻な病気で、処方箋が必要な場合は、不卜廬に行くしかない…はぁ、そんなことにならないよう祈るしかないね…","nextNodeIds":[718230210]},{"nodeId":718230210,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":2226639050,"text":"私は薬草採りに行くから、話はここまで。採り終わったらすぐ他のことをやらなきゃ…","nextNodeIds":[718230211]},{"nodeId":718230211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":796247426,"text":"手伝うよ。","nextNodeIds":[718230212]},{"nodeId":718230212,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":590570394,"text":"えっ？手伝ってくれるの？嬉しい！正直一人でどれくらい採れるか心配だったの…","nextNodeIds":[718230213]},{"nodeId":718230213,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":522658706,"text":"えっと…今必要な薬剤はあと3つ…","nextNodeIds":[718230214]},{"nodeId":718230214,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":4132052578,"text":"…1つは山頂に生えてる清心。栄養があって消化を助ける作用もあるよ。","nextNodeIds":[718230215]},{"nodeId":718230215,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":2213661378,"text":"もう1つは川辺に生えてる新鮮なドドリアン。体内の湿気を調整する作用がある。","nextNodeIds":[718230216]},{"nodeId":718230216,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":981942874,"text":"あそこの川辺で採れるドドリアンは凄く良質な物なの。他の場所のだと薬の作用が薄くて…だから私はいつもそこで採ってるの。","nextNodeIds":[718230217]},{"nodeId":718230217,"roleType":"TALK_ROLE_NPC","speakerId":213901,"speakerName":"凪","textMapHash":2616903794,"text":"最後の1つは隣の池で採れるハスの花托。神経を落ち着かせ、心臓の働きを助ける作用がある。でも採る時にコツがいるの。夜中の0時から朝の6時までに採るのが一番いいんだ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7182302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"