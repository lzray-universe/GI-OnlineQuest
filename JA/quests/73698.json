6980114,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":158718202,"text":"私の知る限り、ウツァヴ祭はそんなふざけたお祭りではないワ。","nextNodeIds":[736980115]},{"nodeId":736980115,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3725525330,"text":"うぅ…","nextNodeIds":[736980116]},{"nodeId":736980116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2735039330,"text":"そもそも、自分の功績を人に記録させようなんて考えること自体、他の花霊とはかなり違うよな…これもスケプティック団の影響か？","nextNodeIds":[736980117]},{"nodeId":736980117,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":754552890,"text":"だからこそ、過去を振り返って反省するコトが大事なノ。","nextNodeIds":[736980118]},{"nodeId":736980118,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":718435418,"text":"ふふ、何はともあれ、ソルシュのパフォーマンスを楽しみにしているワ。","nextNodeIds":[]},{"nodeId":736980104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1158643050,"text":"それほどでもない。","nextNodeIds":[736980105]},{"nodeId":736980105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2258837874,"text":"ソルシュは本人が言う程にはすごくなかったな。もうちょっと努力が必要だぜ。","nextNodeIds":[736980106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7369802,"order":6,"stepDescription":"指定の場所に行き、試練をクリアする","stepDescTextMapHash":378201940,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QU