42"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2203401],"talks":[{"talkId":2203401,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2203401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2203401,"initDialog":220340101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3042],"performCfg":"","priority":5,"questId":22034,"showRandomTalkCount":0},"dialogs":[{"nodeId":220340101,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1543674634,"text":"旅人、お待ちください。所長からお願いがあるようです。","nextNodeIds":[220340102]},{"nodeId":220340102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2758714018,"text":"事件に進展があった？","nextNodeIds":[220340103]},{"nodeId":220340103,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2167835930,"text":"所長は、まだ準備が必要だと。それ以外は何も言っていませんでした。","nextNodeIds":[220340104]},{"nodeId":220340104,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":67162394,"text":"あなたを待ち、共に野外で探索するようお願いしろ、とおっしゃっていました。","nextNodeIds":[220340105,220340107]},{"nodeId":220340105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":656376554,"text":"所長は何がしたいの？","nextNodeIds":[220340106]},{"nodeId":220340106,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3872193106,"text":"それは…正直、私にもよく分かりません。しかし所長の言う通りにしていれば、大抵の場合、事件を解決できます。","nextNodeIds":[220340112]},{"nodeId":220340112,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2637112666,"text":"あっ、やはり本題に戻りましょう。","nextNodeIds":[220340113]},{"nodeId":220340113,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3611668802,"text":"所長によると、天野さんと安藤さんがあの事件を上に報告してから、城内の見回りが強化されたそうです。","nextNodeIds":[220340114]},{"nodeId":220340114,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":873431162,"text":"でもおかしなことに、城内のお店で窃盗被害が続いているんです。そのうえ、犯人は目標の品以外には手を付けないのです。","nextNodeIds":[220340115]},{"nodeId":220340115,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":238600498,"text":"所長は、町の外の宝盗団による犯行の可能性は限りなく低いと判断しました。","nextNodeIds":[220340116]},{"nodeId":220340116,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1266655090,"text":"この事件の犯人…または犯人たちには、明確な犯行目的があります。","nextNodeIds":[220340117]},{"nodeId":220340117,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":331746946,"text":"今わかっているのは、常に城内の中に潜み、外に情報を流し続けている「内通者」がいる可能性が、非常に高いということ。","nextNodeIds":[220340118]},{"nodeId":220340118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1461894002,"text":"同心たちの苦労が無駄になってしまう。","nextNodeIds":[220340119]},{"nodeId":220340119,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2868853082,"text":"いいえ、犯人は同心たちの目標が自分ではないと思っているからこそ、犯罪行為を続けているのでしょう。","nextNodeIds":[220340120]},{"nodeId":220340120,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1804918858,"text":"彼が罪を重ねれば、残す痕跡も必ず多くなります。そうしたら、所長も彼の正体を暴きやすくなる筈です。","nextNodeIds":[220340121]},{"nodeId":220340121,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":636800890,"text":"犯人を油断させるためには、続けるしかありません。","nextNodeIds":[220340122]},{"nodeId":220340122,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3931654610,"text":"旅人。今回の頼みごともそれ故です。私と共に野外に行き、宝盗団の邪魔をしていただけませんか？","nextNodeIds":[220340123]},{"nodeId":220340123,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3426557242,"text":"もちろん、報酬はちゃんとお支払いします。それに…この事件が解決できたら、更に報酬をお渡しします。","nextNodeIds":[220340124]},{"nodeId":220340124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3963788938,"text":"それも珊瑚に指示されたの？","nextNodeIds":[220340125]},{"nodeId":220340125,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2735213770,"text":"うぅ…気付かれましたか。さすが、あなたは本当に鋭い…","nextNodeIds":[220340126]},{"nodeId":220340126,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3584498474,"text":"そうです、先ほど言った内容は、全て所長に指示された事です。","nextNodeIds":[220340127]},{"nodeId":220340127,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2783803474,"text":"ですが、先ほどお話した内容に偽りはありません。信じてください、少なくとも…報酬はちゃんと私の手元にあります。","nextNodeIds":[220340128]},{"nodeId":220340128,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":178900818,"text":"だから、お願いします、旅人。","nextNodeIds":[220340129]},{"nodeId":220340129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3353307394,"text":"でもいったい何をすればいいの？","nextNodeIds":[220340130]},{"nodeId":220340130,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3881586282,"text":"簡単です。私たちはただ…野外の宝盗団を混乱させればいいのです。騒ぎは大きければ、大きいほどいい。","nextNodeIds":[220340131]},{"nodeId":220340131,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":699086986,"text":"宝盗団の拠点の場所は、所長が印をつけてくれました。私も、あなたの地図に印をつけておきますね。","nextNodeIds":[220340132]},{"nodeId":220340132,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":956441746,"text":"出来ました。では行動開始ですね、そこで合流しましょう。","nextNodeIds":[]},{"nodeId":220340107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4102491114,"text":"所長自身はどうして来ないの？","nextNodeIds":[220340108]},{"nodeId":220340108,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1780259562,"text":"所長はいつもこんな感じです。彼女は…「自分は考えるのは得意だが、行動は苦手」だと言っていました。","nextNodeIds":[220340109]},{"nodeId":220340109,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":282447642,"text":"以前、ある小説の作者が取材しに来て、所長の経験を題材とした小説を書くと言っていました。","nextNodeIds":[220340110]},{"nodeId":220340110,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3881860634,"text":"そして、所長のことを「安楽椅子探偵」と呼びました。所長はその名前が気に入っているようで、以前から安楽椅子を買いたいと思っていたようです。","nextNodeIds":[220340111]},{"nodeId":220340111,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":466529202,"text":"しかし、探偵所の経費の問題もあり、安楽椅子を買うことが出来なかったらしく…","nextNodeIds":[220340112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2203401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1","1","4"],"PAINLIBBLDK":"QUEST_EXEC_RANDOM_QUEST_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATO