COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7352032,"initDialog":735200203,"nextRandomTalks":[],"nextTalks":[],"npcId":[30353],"performCfg":"QuestDialogue/WQ/Sumeru_73520/Q7352032","priority":5,"questId":73520,"showRandomTalkCount":0},"dialogs":[{"nodeId":735200203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1923186874,"text":"「二十年前の出来事」","nextNodeIds":[735200204]},{"nodeId":735200204,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":4071403906,"text":"…言いふらすべきじゃなかった。この間は飲み過ぎてぼやいてしまったけど…まさかこんなに人が聞きに来るなんて。","nextNodeIds":[735200205]},{"nodeId":735200205,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":397066178,"text":"そんなに気になるなら、話してあげるよ。","nextNodeIds":[735200206]},{"nodeId":735200206,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":1774771338,"text":"二十年前、私はたった六歳の子供だった。当時のことはもうそんなに覚えてない。この前、子供の頃の日記を読み返して、ようやく当時のことを思い出した。","nextNodeIds":[735200207]},{"nodeId":735200207,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":3317060378,"text":"その年もちょうど学院トーナメントがあって、試合は三回行われた。最後の一回はシティの外でやるから、私は母さんに連れて行って欲しいとねだったんだが、応じてくれなかったからこっそり抜け出したんだ。","nextNodeIds":[735200208]},{"nodeId":735200208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2184917634,"text":"それで？","nextNodeIds":[735200209]},{"nodeId":735200209,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":3547535074,"text":"それで、シティの外で私は迷子になった。人っ子一人おらず、怖さのあまりつい泣いてしまったよ。","nextNodeIds":[735200210]},{"nodeId":735200210,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":1487340074,"text":"そのとき、不思議な生物を見たんだ…もう顔は覚えててないけど、子供だった私はそれを見た途端、泣き止んだのだけは覚えてる。","nextNodeIds":[735200211]},{"nodeId":735200211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3234834322,"text":"不思議な生物って、まさか…","nextNodeIds":[735200212]},{"nodeId":735200212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1015957610,"text":"（アランナラのことだろう。）","nextNodeIds":[735200213]},{"nodeId":735200213,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":2826334378,"text":"彼らは試合の会場に私を連れていってくれたが、残念なことに試合はもう終わってしまっていた。","nextNodeIds":[735200214]},{"nodeId":735200214,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":3238851530,"text":"しょんぼりしていたとき、不思議な生物の一匹が冠を引きずって歩いているのを見たんだ。","nextNodeIds":[735200215]},{"nodeId":735200215,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":2594230642,"text":"冠はとても綺麗で、月明かりの下で輝いてた。私はついそのあとをついていった。するとその小さいのは、冠をとある木のうろに隠したのち、姿を消したんだ。","nextNodeIds":[735200216]},{"nodeId":735200216,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":725316698,"text":"冠を触ってみたかったけど、ちょうどその時、遠くから母さんの声がした。私が迷子になったのに気づいて、隣人を呼んで私を探しに来てくれたんだ。","nextNodeIds":[735200217]},{"nodeId":735200217,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":1270820242,"text":"結局あの冠には触れずじまいだったな。大人になって、学院トーナメントの会場で「才識の冠」を見たとき、ようやくあれと同じものだと気づいたんだ。","nextNodeIds":[735200218]},{"nodeId":735200218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4130251594,"text":"そっか…それで、あの冠が最後にどこに置かれたのかは、覚えてるのか？","nextNodeIds":[735200219]},{"nodeId":735200219,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":2225368306,"text":"確か、アビディアの森だった。だが、その後何回も行ってみたんだけど、何の手がかりも見つけられなかったんだ。","nextNodeIds":[735200220]},{"nodeId":735200220,"roleType":"TALK_ROLE_NPC","speakerId":30353,"speakerName":"カシュミール","textMapHash":606135994,"text":"誰かに言っても信じてはもらえないだろうな。はぁ、私自身もはっきりと覚えてるわけじゃない。子供の頃に見た夢だったのかもしれないな。","nextNodeIds":[735200221]},{"nodeId":735200221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4185204930,"text":"#うーん…{NICKNAME}、探しに行ってみないか？","nextNodeIds":[]}]},{"talkId":7352033