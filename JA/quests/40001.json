oveDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4000106","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":4000106,"initDialog":400010601,"nextRandomTalks":[],"nextTalks":[],"npcId":[2093],"performCfg":"QuestDialogue/EQ/Sealamp1_40001/Q4000106","priority":5,"questId":40001,"showRandomTalkCount":0},"dialogs":[{"nodeId":400010601,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":3567329718,"text":"今年の「明霄の灯」のデザインは「移霄導天真君」か。見栄えを気にするあやつが喜びそうじゃのう…","nextNodeIds":[400010602,400010611]},{"nodeId":400010602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2676121694,"text":"「移霄導天真君」について…","nextNodeIds":[400010603]},{"nodeId":400010603,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":3776127582,"text":"今年の海灯祭の「明霄の灯」は「移霄導天真君」のイメージを参考にデザインされたんじゃ。","nextNodeIds":[400010604]},{"nodeId":400010604,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":367828982,"text":"鹿の角をもっと大きくしてくれるといいんじゃが。なにせ鹿の角はあの仙人の誇りじゃったからのう。","nextNodeIds":[400010605]},{"nodeId":400010605,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":933410686,"text":"その角には岩王帝君の力が込められておって、璃月で最も硬いものだった。","nextNodeIds":[400010606]},{"nodeId":400010606,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":836604030,"text":"しかし「あの決戦」で山が崩れそうになり、彼は麓にいた人々を守るため、自ら角を斬ってくれと友人に頼んだんじゃ…","nextNodeIds":[400010607]},{"nodeId":400010607,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":581131326,"text":"彼は斬り落とされた角を支点にして、山を支えた。彼自身も最後の一滴の血が流れるまで戦ったんじゃ…","nextNodeIds":[400010608]},{"nodeId":400010608,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":3768170422,"text":"今になってもなお、彼の角に支えられた「天衡山」は高くそびえ立っておる、そして彼が戦いで流した血は「碧水川」となった。","nextNodeIds":[400010609]},{"nodeId":400010609,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":855716646,"text":"ほぉっほぉっ…信じてくれるかどうかは別として、この話を聞いてくれただけで、ばあやは満足じゃ。","nextNodeIds":[400010610]},{"nodeId":400010610,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":3678483238,"text":"海灯祭が今も在り続けているのは、あの「旧友」たちが寂しがり屋だからかもしれないのう。","nextNodeIds":[]},{"nodeId":400010611,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3224485630,"text":"さようなら。","nextNodeIds":[400010612]},{"nodeId":400010612,"roleType":"TALK_ROLE_NPC","speakerId":2093,"speakerName":"ピンばあや","textMapHash":1823893462,"text":"さようなら。往古来今、美徳の精神が続かんことを。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4000106,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["40010601","1"],"PAINLIBBLDK":"QUEST_EXEC_ADD_QUEST_PROGRESS"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2093"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4000109,"order":11,"stepDescription":"霄市にいる人々と会話する","stepDescTextMapHash":3764343294,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4000109,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT