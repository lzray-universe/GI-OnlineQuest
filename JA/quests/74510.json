6],"performCfg":"QuestDialogue/WQ/V4.2FungusFighterV3/Q7451001","priority":5,"questId":74510,"showRandomTalkCount":0},"dialogs":[{"nodeId":745100101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1077433378,"text":"オイラたちの勝ちだ！仲間のキノコンたちの完全勝利！","nextNodeIds":[745100102]},{"nodeId":745100102,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2011011370,"text":"実に華麗な戦略だったわ。さすがはあなたたち「ゴールド流星」に「シルバー伴星」ね…","nextNodeIds":[745100103]},{"nodeId":745100103,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":1954004210,"text":"あなたたちのテイムは常識を超えている。たとえ思いがけない敵を相手にしても、あなたたちの指揮ならキノコンの仲間たちは負け知らずだわ！","nextNodeIds":[745100104,745100105]},{"nodeId":745100104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":422297482,"text":"へへっ！ハニヤーに褒められちゃった！","nextNodeIds":[745100106]},{"nodeId":745100106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3422631410,"text":"これまでも何度か雪のイノシシ王と魔偶剣鬼が登場したけど、今回は刀持ち犬まで出してくるとはな！","nextNodeIds":[745100107]},{"nodeId":745100107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2236578066,"text":"左右加さんが設置する敵の陣立てはやっぱり予想できないぜ…","nextNodeIds":[745100108]},{"nodeId":745100108,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":331194298,"text":"これらの強敵は各地の冒険物語における伝説のような存在なんですよ！その名は多少なりとも海を渡り、様々な土地の選手を共感させるでしょう。","nextNodeIds":[745100109]},{"nodeId":745100109,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2241907834,"text":"書き手である私も大のお気に入りで…元々無関係だった登場人物たちが実力を競い合うシーンは、考えただけで興奮してきます！","nextNodeIds":[745100110]},{"nodeId":745100110,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":3483015138,"text":"それでは、全ステージをプレイした、「才知と勇猛の双子星」であるお二人のご感想をお聞かせください！","nextNodeIds":[745100111,745100113,745100115]},{"nodeId":745100111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1484522850,"text":"ちょっとステージが少なく物足りなかった。","nextNodeIds":[745100112]},{"nodeId":745100112,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":373360346,"text":"そうね。それは私たちも二つ目に予想したわ。それじゃ、次回のウォーミングアップイベントでは最大限の準備をして、より多くのステージを作るとしましょう。","nextNodeIds":[745100117]},{"nodeId":745100117,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2894515842,"text":"ともかく、左右加は今後さらに多くの資料を参照して、より協力で面白い敵をたくさんデザインするわ。フォンテーヌの人たちに少しずつこのゲームを好きになってもらうためにね。","nextNodeIds":[745100118]},{"nodeId":745100118,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":1477079042,"text":"そうすれば私たちのスポンサーであるフォンタも、引き続き高額の資金を出してくれるわ。","nextNodeIds":[745100119]},{"nodeId":745100119,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":3241134378,"text":"十分な元手が揃えば、再び「サウマラタ蓮杯」のような規模のイベントも開催できる…","nextNodeIds":[745100120]},{"nodeId":745100120,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2317907218,"text":"いいえ、「サウマラタ蓮杯」以上に盛り上がるイベントにしましょう！大会のルールも大幅に改善して、皆を感動させられるような、活気ある面白いイベントにするのよ…！","nextNodeIds":[745100121]},{"nodeId":745100121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2149219746,"text":"へへっ、想像するとワクワクするな！","nextNodeIds":[745100122,745100123]},{"nodeId":745100122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":669025394,"text":"何かあれば言って！","nextNodeIds":[745100124]},{"nodeId":745100124,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2520829266,"text":"長期的な計画になるわ。急いで進める必要はないの。","nextNodeIds":[745100125]},{"nodeId":745100125,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2825185818,"text":"左右加とバルフォアさんの特訓のおかげで、私もいっぱしのビジネスパーソンとしてやれてるわ。細やかな問題解決のために、あなたたちの手を煩わせるわけにはいかない！","nextNodeIds":[745100126]},{"nodeId":745100126,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":416723810,"text":"ウォーミングアップイベントと商談が終わっても、私と左右加はフォンテーヌに長期滞在し、キノコンの仲間たちを連れて旅するつもりよ。","nextNodeIds":[745100127]},{"nodeId":745100127,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":334061666,"text":"定期的にあなたたちへ手紙を書きたいと思ってるの。キノコンの仲間たちの近況とプロジェクトの進捗報告を添えてね。","nextNodeIds":[745100128]},{"nodeId":745100128,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":1335829514,"text":"もちろん、そのためにはあなたたちが手紙を受け取る場所を教えてもらう必要があるわ。でないと、前みたいに連絡がつかなくなってしまうでしょ…","nextNodeIds":[745100129]},{"nodeId":745100129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2802313634,"text":"手紙を受け取る場所っていってもな…","nextNodeIds":[745100130,745100131]},{"nodeId":745100130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2770861274,"text":"毎週、数日は行きそうな場所かな…","nextNodeIds":[745100132]},{"nodeId":745100132,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":669291986,"text":"あそこなら完璧ね！それじゃ「才知と勇猛の双子星」宛に、ハニヤーとキノコンの仲間たちから定期報告をお届けするわ！","nextNodeIds":[745100133]},{"nodeId":745100133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":425654866,"text":"じゃあこれで決まりだな！","nextNodeIds":[745100134]},{"nodeId":745100134,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":4290851490,"text":"まだまだ「ちびチエキノコン大合戦」の人気が続いてるから、しばらくの間イベントを行うつもりよ。","nextNodeIds":[745100135]},{"nodeId":745100135,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":3909647674,"text":"時間があればまた遊びに来てちょうだいね。","nextNodeIds":[745100136,745100137]},{"nodeId":745100136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3492625586,"text":"オッケー！","nextNodeIds":[745100138]},{"nodeId":745100138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":21537202,"text":"へへっ。どうやら今回はハニヤー、左右加さん、それにキノコンの仲間たちがオイラたちと遠く離れることはなさそうだし、しばらく会えないってこともなさそうだな。ホッとしたぜ…","nextNodeIds":[745100139]},{"nodeId":745100139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4221805858,"text":"ますます楽しみになってきたぞ。次のテイマー大会はいったいどんな感じになるんだろうな！","nextNodeIds":[]},{"nodeId":745100137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1724454490,"text":"時間ならたくさんある！","nextNodeIds":[745100138]},{"nodeId":745100131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":488387890,"text":"冒険者協会くらいかな？","nextNodeIds":[745100132]},{"nodeId":745100123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2533215810,"text":"運営のことなら分かるからね！","nextNodeIds":[745100124]},{"nodeId":745100113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3933352978,"text":"ステージ数がちょうどよかった。","nextNodeIds":[745100114]},{"nodeId":745100114,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2954123010,"text":"褒めてくれて感謝するわ。でも、時間が足りないくらい忙しかったからそう感じた…って可能性もあるわよね？…もっとステージを用意するのがいいのかも。","nextNodeIds":[745100117]},{"nodeId":745100115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":89103962,"text":"キノコンの仲間たちがいれば何だってオッケー！","nextNodeIds":[745100116]},{"nodeId":745100116,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2663739266,"text":"あらら、あなたってやっぱり思い切りのいい性格だね。左右加の言う通り、今はあなたが私たちのオーナーだから、何か要求があれば直接言ってちょうだい。","nextNodeIds":[745100117]},{"nodeId":745100105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2975455122,"text":"いえいえ！ハニヤーだってとても強いよ！","nextNodeIds":[745100106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7451001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARG