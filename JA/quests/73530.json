":[{"nodeId":735300101,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3112751098,"text":"ハハッ、はぁ…ハハハ…","nextNodeIds":[735300102]},{"nodeId":735300102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4086006346,"text":"#{NICKNAME}、見ろよ、この泣いたり笑ったりしてるやつ…ん？どこかで見たことあるような…？","nextNodeIds":[735300103]},{"nodeId":735300103,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1907562978,"text":"あっ！久しぶりだね。僕のことは覚えているかい？","nextNodeIds":[735300104,735300106]},{"nodeId":735300104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2508832202,"text":"#{M#君}{F#あなた}は？","nextNodeIds":[735300105]},{"nodeId":735300105,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":244312154,"text":"僕だよ、僕！生論派の学者ジャミ、「フェーイズポーション」を作ったジャミだ！","nextNodeIds":[735300108]},{"nodeId":735300108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":429229362,"text":"ああ、ちょっと思い出してきたぞ。","nextNodeIds":[735300109]},{"nodeId":735300109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2846361458,"text":"どうだ、最近研究は順調か？","nextNodeIds":[735300110]},{"nodeId":735300110,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1636152690,"text":"ハハッ…それはだね…はぁ…","nextNodeIds":[735300111]},{"nodeId":735300111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1842758738,"text":"あまり順調じゃないみたいだね？","nextNodeIds":[735300112]},{"nodeId":735300112,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1587707066,"text":"いやいや、皆さんのおかげで、この前のフェーイズポーションに関する研究はかなりいい成果を収めた。","nextNodeIds":[735300113]},{"nodeId":735300113,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":555057482,"text":"昔は指導教員の期待に応えられないんじゃないかって、ずっとビクビクしていたけど、まさか僕の研究を見てあんなに褒めてくれるとはね。","nextNodeIds":[735300114]},{"nodeId":735300114,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1204524698,"text":"「ジャミ、よくやった！さすがは私の最も誇れる学生だ！」って。","nextNodeIds":[735300115]},{"nodeId":735300115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4268957098,"text":"いいことじゃないか？よかったな！","nextNodeIds":[735300116]},{"nodeId":735300116,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":756639826,"text":"ここまでだったら、確かにいい話だ…はぁ、その後に起きたことが、僕にとっては間違いなく悪夢なんだよ…","nextNodeIds":[735300117]},{"nodeId":735300117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":771183170,"text":"何があったの？","nextNodeIds":[735300118]},{"nodeId":735300118,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":437860050,"text":"前回のデータがあまりにも理想的だったのか、指導教員——あの笑うと顔がシワまみれになるジイさんが、なんと「自分で試してみたい」って言い始めたんだ。","nextNodeIds":[735300119]},{"nodeId":735300119,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3327125522,"text":"それで、実験場所をもう一回用意して、丹精込めて一番効果のあるフェーイズポーションを作ったら…","nextNodeIds":[735300120]},{"nodeId":735300120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1471833930,"text":"作ったら…？","nextNodeIds":[735300121]},{"nodeId":735300121,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1040693298,"text":"そしたら、なんというか…数え切れないほどの学生が見ている中、魔物の前で堂々とフェーイズポーションを飲み——そして、魔物にすぐコテンパンにやられたんだ…","nextNodeIds":[735300122]},{"nodeId":735300122,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":894682978,"text":"幸い、あの人は無事だった。しばらくベッドで休んでいればいいとのことだ。","nextNodeIds":[735300123]},{"nodeId":735300123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3069013434,"text":"ぷっ、あっはっはっはっ！","nextNodeIds":[735300124]},{"nodeId":735300124,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3987384234,"text":"ハハハ…コホンッ。なにはともあれ、僕の出来が悪いせいで、指導教員の顔に泥を塗ってしまった。","nextNodeIds":[735300125]},{"nodeId":735300125,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1100997194,"text":"その後、あの性格の悪いジイさんが、「お客さんのニーズを考慮していない」だとか「実際の場面に適用できてない」だとか言って、僕をこっぴどく叱ってね。","nextNodeIds":[735300126]},{"nodeId":735300126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1669701474,"text":"そんなの理不尽だろ。そいつ自身のせいでもあるのに！","nextNodeIds":[735300127]},{"nodeId":735300127,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1264944602,"text":"僕もそう思うよ。だから二人にお願いだ、どうか——","nextNodeIds":[735300128,735300129]},{"nodeId":735300128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3632807482,"text":"そいつを懲らしめる？","nextNodeIds":[735300130]},{"nodeId":735300130,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":4197008602,"text":"ちがうちがう！そんな恐ろしいこと考えてないよ、少なくとも今はない！","nextNodeIds":[735300131]},{"nodeId":735300131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3159405714,"text":"へへっ、てことは「昔は」あったんだな？","nextNodeIds":[735300132]},{"nodeId":735300132,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3629023682,"text":"うっ…少しだけ…まぁ、それは重要ではない。","nextNodeIds":[735300133]},{"nodeId":735300133,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1737871682,"text":"僕が言いたいのは、この前の実験を振り返って、「長時間持続フェーイズポーション」というのを新しく作ったんだ。","nextNodeIds":[735300134]},{"nodeId":735300134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1790789570,"text":"長時間持続フェーイズポーション？なんだそれ？","nextNodeIds":[735300135]},{"nodeId":735300135,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":4190543682,"text":"指導教員が襲われたときの反応を思い返して、こんな問題点に気がついたんだ——僕たち一般人が危機的状況に陥った時、頭は真っ白になって、身体は硬直するし、どうしたらいいのか分からなくなる…","nextNodeIds":[735300136]},{"nodeId":735300136,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":795881370,"text":"危険に遭遇してから、フェーイズポーションを探して飲んでいたら、その効果が出てくるまで待てないかもしれない。","nextNodeIds":[735300137]},{"nodeId":735300137,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1224242450,"text":"でも長時間持続フェーイズポーションは違う。一度飲めば、危険に遭遇するたびに勝手に効果が出るんだ。だから、一般人でも反応するまでの時間をもっと稼げるようになる。","nextNodeIds":[735300138]},{"nodeId":735300138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3683033418,"text":"「危険に遭遇」したかはどう判断するの？","nextNodeIds":[735300139]},{"nodeId":735300139,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3867750114,"text":"僕がさっき言ったことを覚えてるかな？一般人は危機的状況に陥ると、身体が硬直する。つまり、長時間持続フェーイズポーションを飲んでも、被験者が普通に行動している限り、効果は発揮されない。","nextNodeIds":[735300140]},{"nodeId":735300140,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":311663298,"text":"でも動きを止めて、その場で固まっていると、長時間持続フェーイズポーションは効果を発揮するようになる。時間の流れが遅くなったように感じるんだ。","nextNodeIds":[735300141]},{"nodeId":735300141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3445342586,"text":"なるほど、だいたいわかったぞ。つまり…実験が完了するよう、オイラたちに手伝ってもらいたいってことか？","nextNodeIds":[735300142]},{"nodeId":735300142,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3176324186,"text":"ああ、そうだ。長時間持続フェーイズポーションは一般人のために開発したものとはいえ、実験にはリスクも伴う。まずは戦闘経験のある人に手伝ってもらおうと思ってね。","nextNodeIds":[735300143]},{"nodeId":735300143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3638899050,"text":"うーん、どうしようかな。手伝うか？","nextNodeIds":[735300144]},{"nodeId":735300144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2484064298,"text":"#急に腹が減ってきたぞ。ランバド酒場でたらふく食べたい気分だぜ…{NICKNAME}、オイラたちのモラはまだ足りそうか？","nextNodeIds":[735300145,735300146]},{"nodeId":735300145,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1077003738,"text":"残念ながら…","nextNodeIds":[735300147]},{"nodeId":735300147,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1424232594,"text":"コホン。実は、指導教員にこっぴどく怒られたとはいえ、その後かなりの額の実験経費が下りた。だから、君たち二人を大金で雇おうと…","nextNodeIds":[735300148]},{"nodeId":735300148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1580894378,"text":"そういうことなら、オイラたちが力を貸すぜ！","nextNodeIds":[735300149]},{"nodeId":735300149,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":4134902466,"text":"本当にありがとう！あぁ…お二人はまさに救世主だ！どうかバラバラに砕けてしまった僕の学術界での名誉を挽回してほしい。","nextNodeIds":[]},{"nodeId":735300146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3630347626,"text":"今月は既に赤字。","nextNodeIds":[735300147]},{"nodeId":735300129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3535921258,"text":"そいつを買収する？","nextNodeIds":[735300130]},{"nodeId":735300106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3182684674,"text":"ずっとため息をついてた人？","nextNodeIds":[735300107]},{"nodeId":735300107,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":2208462234,"text":"まだあの「あだ名」を覚えていたんだね。そう、僕だよ…指導教員の期待を裏切り、ずっとため息ばかりついている生論派学者。今さら名乗るのは恥ずかしいけど、ジャミだ…","nextNodeIds":[735300108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7353001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7353001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","count":27},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":13},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":9}],"ra