stId":73526,"showRandomTalkCount":0},"dialogs":[{"nodeId":735260101,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":1523649202,"text":"最初から誰かに依頼すればよかった…","nextNodeIds":[735260102]},{"nodeId":735260102,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":2285733194,"text":"最初のテストで山を越えなきゃいけないなんて…どんな苦行よ…","nextNodeIds":[735260103]},{"nodeId":735260103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2982870562,"text":"おまえ、大丈夫か？喋る気力もなさそうだけど…","nextNodeIds":[735260104]},{"nodeId":735260104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2461265114,"text":"#{NICKNAME}、こいつ…弱りきってるみたいだぞ。なにか作って食べさせてやろうぜ！","nextNodeIds":[735260105]},{"nodeId":735260105,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":2512069538,"text":"近くのかまどで熱々の大根の揚げ団子とステーキを作って、衰弱した見知らぬ人の体力を回復させた…","nextNodeIds":[735260106]},{"nodeId":735260106,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":2408164866,"text":"うふふふ！おかげで復活しました！","nextNodeIds":[735260107]},{"nodeId":735260107,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":2398764330,"text":"良い腕なさってますね。食材と調味料の品質がよくないせいで、口当たりが少しパサパサしてましたが。","nextNodeIds":[735260108]},{"nodeId":735260108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1669486314,"text":"こういうときに文句言うなよな。腹いっぱい食べられたんだから、それでいいだろ！","nextNodeIds":[735260109]},{"nodeId":735260109,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":1648361586,"text":"いやいや！貧しいときこそ、贅沢な生活を想像するものですよ。そうすることで、戦い続けるモチベーションが生まれるんですから！","nextNodeIds":[735260110]},{"nodeId":735260110,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":717186410,"text":"資金が回らなくなったときこそ、多額の借金を作る——そうすることで転機を掴んで一発逆転できるんです！","nextNodeIds":[735260111]},{"nodeId":735260111,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":512251122,"text":"それでこそ私、「幻のおもちゃ王·マディーハ」の逆転法——局面を打破するビジネスの秘訣です。","nextNodeIds":[735260112]},{"nodeId":735260112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1639184802,"text":"ま…幻のおもちゃ王？たいそうな名前だけど、おまえのそのやつれた姿を見る限り、なんか裏がありそうだな…","nextNodeIds":[735260113,735260114]},{"nodeId":735260113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2107862002,"text":"おもちゃはまだ作れてないんでしょ？","nextNodeIds":[735260115]},{"nodeId":735260115,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":2574796722,"text":"あなたたち！どうやって見抜いたのですか…！！！","nextNodeIds":[735260116]},{"nodeId":735260116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2115495882,"text":"だってさっき、お腹が空きすぎて行き倒れそうになってたし、ぶつぶつとテストだの、誰かに依頼するだの、うわごとを言ってただろ…","nextNodeIds":[735260117]},{"nodeId":735260117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":808830570,"text":"どう見てもおまえはまだ看板おもちゃを作れてなさそうだよな？ご飯にすらありつけないなんて、憐れすぎるぞ！","nextNodeIds":[735260118]},{"nodeId":735260118,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":2157922218,"text":"くっ…そう言われると、なんだかすごく悔しいです！私の「ヒャッホーギツネ」はもう生産前の最終段階に来てるんですからね！","nextNodeIds":[735260119]},{"nodeId":735260119,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":1462824962,"text":"あとは「ヒャッホーギツネ」の飛行エンベロープさえ割り出せれば、キノコンにだって読める説明書が完成します。そこで更に借金をして大量生産すれば、利益を上げられるはずです！","nextNodeIds":[735260120]},{"nodeId":735260120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2247542170,"text":"飛行エンベロープってなんだ？なんの説明書だよ？専門用語を使わないでくれ！","nextNodeIds":[735260121]},{"nodeId":735260121,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":4043899778,"text":"言葉だけじゃ言い尽くせません。ご覧になっていただければ手っ取り早い！","nextNodeIds":[735260122]},{"nodeId":735260122,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":957231418,"text":"マディーハはバッグから青い包みを1つ取り出して、素早く空気を入れた。\\n少し経つと、独特な形のおもちゃが形を成して、目の前で穏やかに宙を浮かんだ。","nextNodeIds":[735260123]},{"nodeId":735260123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":785437650,"text":"これがおまえの看板おもちゃなのか？どう見ても「キツネ」じゃないだろ！いっそ、「デカミミ夕暮れの実爆弾·青い星限定版」みたいな名前にしちゃえよ！","nextNodeIds":[735260124]},{"nodeId":735260124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":468371546,"text":"それに、「ヒャッホー」ってなんだよ？どう見ても嬉しそうな表情じゃないよな？","nextNodeIds":[735260125]},{"nodeId":735260125,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":3752451066,"text":"いえいえいえいえ、それは空気噴射装置が作動する時、人が大笑いしているように聞こえるからですよ！ほら、聞いてみてください！","nextNodeIds":[735260126]},{"nodeId":735260126,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":1694686026,"text":"（おもちゃは形容し難い、低い唸り声をあげた。おそらく、多分、ギリギリ、「ヒャッホー」と表現できる…？）","nextNodeIds":[735260127]},{"nodeId":735260127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3898576450,"text":"#一体どこでこんな笑い声を聞いたんだよ…{NICKNAME}、こいつの精神状態がちょっと心配だぞ…","nextNodeIds":[735260128]},{"nodeId":735260128,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":3563739514,"text":"とにかく、「ヒャッホーギツネ」は小型の熱気球によって浮いていて、隠れた小さな空気噴射口が推進力を提供しています。操作性も悪くないはずです。","nextNodeIds":[735260129]},{"nodeId":735260129,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":3834181954,"text":"考えてみてくださいよ、これは自由自在に飛行させられるおもちゃなんですよ！普通の子どもは勿論、大人だってこの誘惑には抗えませんから！","nextNodeIds":[735260130,735260131]},{"nodeId":735260130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":776285090,"text":"そう言われると、確かに目新しい。","nextNodeIds":[735260132]},{"nodeId":735260132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1167402970,"text":"なんだかよく知った匂いだぞ…","nextNodeIds":[735260133]},{"nodeId":735260133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":981858138,"text":"次は——「報酬をお支払いしますので、最後のテストをあなたたちにお願いしたいです」って言うんだろ。","nextNodeIds":[735260134]},{"nodeId":735260134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1090172490,"text":"#それはちょっと、{NICKNAME}とじっくり話し合わないといけないぞ。オイラたちはすっごく忙しいからな。少しの報酬しかもらえないんじゃ、割に合わないぜ…","nextNodeIds":[735260135]},{"nodeId":735260135,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":2431419714,"text":"いえいえいえ、少しだけの報酬なんてとんでもない、そうですね…","nextNodeIds":[735260136]},{"nodeId":735260136,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":1545769810,"text":"「ヒャッホーギツネ」の一年間の売上のうち六割、いえ、七割を分け前とします。これならいかがです？","nextNodeIds":[735260137]},{"nodeId":735260137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3343650074,"text":"七割！それは多すぎるんじゃ——","nextNodeIds":[735260138]},{"nodeId":735260138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2267608546,"text":"コホン…それでこそ「幻のおもちゃ王」だな！","nextNodeIds":[735260139,735260140]},{"nodeId":735260139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1315444498,"text":"一年以内に量産できるの？","nextNodeIds":[735260141]},{"nodeId":735260141,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":1386103402,"text":"お二人とも、そこが重要なところです！早くテストを終わらせれば、「ヒャッホーギツネ」の生産販売にも早く着手できます。そうすれば分け前も増えますよ！","nextNodeIds":[735260142]},{"nodeId":735260142,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":1975787466,"text":"一緒に頑張って製品を最高な状態にできれば、ウィンウィンですから！","nextNodeIds":[735260143]},{"nodeId":735260143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2850706842,"text":"それもそうか、考えれば考えるほどその通りだぜ…","nextNodeIds":[735260144]},{"nodeId":735260144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1934077234,"text":"#へへっ、{NICKNAME}、これでオイラたちも、おもちゃ業界に足を踏み入れたことになるよな。つまり、ビジネス業界の人になったってことか？","nextNodeIds":[735260145]},{"nodeId":735260145,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":626932386,"text":"それでは早速始めましょう。以前、冒険者のみなさんに教えを乞うたことがありまして、彼らの経験を参考に、いくつかの地点に飛行エンベロープをテストする挑戦を配置しました。大まかな場所を教えますね…","nextNodeIds":[735260146]},{"nodeId":735260146,"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","textMapHash":55371474,"text":"「ヒャッホーギツネ」の未来、そして「幻のおもちゃ王」の看板を、あなたたちに託しましたよ！","nextNodeIds":[]},{"nodeId":735260140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1748656314,"text":"量産しても利益が出るとは限らない…","nextNodeIds":[735260141]},{"nodeId":735260131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":779105362,"text":"よく売れるかも。","nextNodeIds":[735260132]},{"nodeId":735260114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":887462666,"text":"破産済みとか？","nextNodeIds":[735260115]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30405"],"NOCCOBOFKHP":10,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7352601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30405,"speakerName":"マディーハ","count":21},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[173526],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3220365142,"CHECNJEMEFE":{"30405":[4120