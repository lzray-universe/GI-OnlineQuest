:"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067803,"initDialog":706780301,"nextRandomTalks":[],"nextTalks":[],"npcId":[9500],"performCfg":"QuestDialogue/WQ/Wolf_70678/Q7067803","priority":5,"questId":70678,"showRandomTalkCount":0},"dialogs":[{"nodeId":706780301,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":3999939354,"text":"へえ、パフォーマンスも順調みたいだな。","nextNodeIds":[706780302]},{"nodeId":706780302,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":829451394,"text":"もしお客さんが新しい「パフォーマンスのコツ」…つまり、「かっこよくて優雅な姿勢」を学びたいなら、友情の証として、宝箱から獲得したおもちゃの勲章と交換しよう。","nextNodeIds":[706780303]},{"nodeId":706780303,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":878023850,"text":"友情っていいもんだよな。この単語を聞いただけで、心も胃袋も暖かくなる気がするよ…","nextNodeIds":[706780304,706780306]},{"nodeId":706780304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2933281274,"text":"友情は確かにいいもの。","nextNodeIds":[706780305]},{"nodeId":706780305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1215805730,"text":"オイラもそう思うぜ！「胃袋も暖かく」ってところがちょっと気になるけどな…","nextNodeIds":[706780308]},{"nodeId":706780308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3397605498,"text":"話を戻すけど、おもちゃの勲章と交換って言ってたよな…おもちゃなのに、そんな価値があるのか？","nextNodeIds":[706780309]},{"nodeId":706780309,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":1106992706,"text":"「信じる」ことさえできれば、おもちゃの勲章は黄金だって超える価値を持つようになる。それこそが幻想の魔法のコツなんだって、魔女の姉ちゃんがよく言ってた。俺にはよく分からないけど…","nextNodeIds":[706780310]},{"nodeId":706780310,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":4243136994,"text":"まあ、「パフォーマンスのコツ」も魔女の姉ちゃんに願い事をすることで手に入る知識だから、姉ちゃんがそれでいいならいいんじゃないか？","nextNodeIds":[706780311]},{"nodeId":706780311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1044643282,"text":"うぅ、それでも安心できないぞ…だって、物語じゃよくあるだろ？軽い気持ちで魔法使いに願い事をしたら、後から払えない代償を求められたり…","nextNodeIds":[706780312]},{"nodeId":706780312,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":1002261890,"text":"お客さん、何の心配もないって。第一、そもそも魔女と魔法使いは違う。それに、代償には「おもちゃの勲章」を支払うんだからさ。","nextNodeIds":[706780313]},{"nodeId":706780313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2864465482,"text":"そ、そうなのか？","nextNodeIds":[706780314]},{"nodeId":706780314,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":1295207962,"text":"そうさ。それに…魔女に願い事をするのはこの俺なんだから、仮に他の代償が必要だとしても、払うのは俺だろ！","nextNodeIds":[706780315,706780316]},{"nodeId":706780315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1323151042,"text":"…どうしてそんなに誇らしげなの？","nextNodeIds":[706780317]},{"nodeId":706780317,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":1716794314,"text":"俺もお客さんのパフォーマンスが好きだから、やり甲斐があるさ。あれ、そういえば、物語の本の白紙ページはあと何枚だっけ…","nextNodeIds":[706780318]},{"nodeId":706780318,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":2886504010,"text":"あっ、二人は心配しなくていいぞ。たとえ今の分がすべてが埋まったとしても、後からまた新しい白紙が追加されるからな！","nextNodeIds":[706780319]},{"nodeId":706780319,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":3851899682,"text":"楽しみにしてるぞ。すべてのページが物語に満たされる日を…","nextNodeIds":[]},{"nodeId":706780316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2279250594,"text":"何だか申し訳ないな…","nextNodeIds":[706780317]},{"nodeId":706780306,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1273467626,"text":"胃袋を暖かくしてくれる最高の仲間…","nextNodeIds":[706780307]},{"nodeId":706780307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":70919674,"text":"最高の仲間の話になるたびに、「非常食」ネタを持ち出そうとするなよな！","nextNodeIds":[706780308]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7067803,7067851],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2484127174,"CHECNJEMEFE":{"9500":[1]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Wolf_70678/Q7067803","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDI