:0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["300010","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":300010,"initDialog":30001001,"nextRandomTalks":[],"nextTalks":[],"npcId":[1051],"performCfg":"QuestDialogue/AQ/Sumeru1_3000/Q300010","priority":5,"questId":3000,"showRandomTalkCount":0},"dialogs":[{"nodeId":30001001,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2936979906,"text":"…本当に大丈夫なのか？でも、こんなに時間が経ったのに…","nextNodeIds":[30001002]},{"nodeId":30001002,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":3520396530,"text":"焦らないでくれ…師匠は物知りだから。師匠が大丈夫と言ったら、きっと大丈夫だ。","nextNodeIds":[30001003]},{"nodeId":30001003,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":4197390426,"text":"あっ、起きたか？","nextNodeIds":[30001004]},{"nodeId":30001004,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2528138474,"text":"#{NICKNAME}、よかったぁ、やっと目を覚ましてくれたぜ。","nextNodeIds":[30001005]},{"nodeId":30001005,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2498291050,"text":"ここはどこ？","nextNodeIds":[30001006]},{"nodeId":30001006,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2147068386,"text":"ここは…うぅ、その…おまえが気を失ったんで、動転しすぎて、ここがどこなのか聞き忘れてたぜ。","nextNodeIds":[30001007]},{"nodeId":30001007,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":1877986018,"text":"ここは「ガンダルヴァー村」。最初はスメールの学者の一時的な休憩所だったんだけど、今は主に森を守るレンジャーが使ってる。","nextNodeIds":[30001008]},{"nodeId":30001008,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":1188973026,"text":"こんにちは、えっと…あたしはコレイ、見習いレンジャーなんだ。今日師匠と見回りをしたとき、気を失ったお前を見つけてここに連れてきた。","nextNodeIds":[30001009]},{"nodeId":30001009,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2194076154,"text":"助けてくれてありがとう。","nextNodeIds":[30001010]},{"nodeId":30001010,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":1504006138,"text":"いやいや、あたしは何もしてないよ。ところで、具合は大丈夫か？どこか痛いところとかないか？","nextNodeIds":[30001011,30001012]},{"nodeId":30001011,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3267996386,"text":"特にないけど…","nextNodeIds":[30001013]},{"nodeId":30001013,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":1674508818,"text":"ははっ…それは師匠が調合してくれた薬草スープだ。お前が気絶してる間に、ちょっとだけ口の中に入れさせてもらった。","nextNodeIds":[30001014]},{"nodeId":30001014,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":2926416722,"text":"あっ、そうだ。お前の目が覚めたら、もう一回飲んでもらわないとダメだって師匠が言ってた。すぐ取ってくるよ。","nextNodeIds":[30001015]},{"nodeId":30001015,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":621314194,"text":"わっ…！","nextNodeIds":[30001016]},{"nodeId":30001016,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":1096064578,"text":"コレイ、どうした？薬草をとりに来たの？言っただろ、触れるなって…後で僕がやるから。","nextNodeIds":[30001017]},{"nodeId":30001017,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":249365114,"text":"ごめんなさい、師匠…","nextNodeIds":[30001018]},{"nodeId":30001018,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":4195118210,"text":"はぁ…『アビディアの森·食用キノコ図鑑』は告知板に貼ってあるけど、ファーボッドがまた忘れちゃうって言うなら別のところ——彼の頭にでも貼って、他の人にリマインドしてもらうしかないね。","nextNodeIds":[30001019]},{"nodeId":30001019,"roleType":"TALK_ROLE_NPC","speakerId":4302,"speakerName":"ナスリン","textMapHash":238422410,"text":"本当に。今月だけでもう二回もお腹を壊したんですよ。説教しておかなくちゃ！","nextNodeIds":[30001020]},{"nodeId":30001020,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2072992242,"text":"まあ、もし彼が虹色の小人を目の前で踊らせるのが好きなんだったら、今言ったことは忘れていいよ。けど、今度またこういうことがあったらモラを出して貰おうかな。","nextNodeIds":[30001021]},{"nodeId":30001021,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":944653090,"text":"どう？元気になった？","nextNodeIds":[30001022]},{"nodeId":30001022,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":1390993170,"text":"これがあたしの師匠、レンジャー長のティナリさんだよ。ガンダルヴァー村にいるレンジャー全員のリーダーでもあるんだ。","nextNodeIds":[30001023]},{"nodeId":30001023,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2439247114,"text":"もうパイモンには君が意識を失った理由を説明したけど、君も目覚めたことだし、もう一回説明するね。","nextNodeIds":[30001024]},{"nodeId":30001024,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2258559810,"text":"スメールの学派には、学者が森で修行しないといけない決まりのところがあってね、「パラハァム」って植物のお香を使って心を安定させて、瞑想状態に入るんだ。","nextNodeIds":[30001025]},{"nodeId":30001025,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":3867202034,"text":"君たちは道を尋ねるために、学者のハイパシアが隠居している洞窟に近づいた。その時、洞窟の中ではそのお香が焚かれていた。","nextNodeIds":[30001026]},{"nodeId":30001026,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":3433749002,"text":"そのお香は大半の人には影響がないんだけど、ごく一部の人の精神を刺激してしまう。そして君はその一部の人だった。この説明で、伝わるかな？","nextNodeIds":[30001027]},{"nodeId":30001027,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4030387626,"text":"すごく分かりやすい。","nextNodeIds":[30001028]},{"nodeId":30001028,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":22637434,"text":"そっか、よかった。次は僕の質問に答えてほしいんだけど、倒れた後は、どんな感覚だった？例えば、自我はちゃんと保っていたのかとか、何かを見たとか。","nextNodeIds":[30001029]},{"nodeId":30001029,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":2188713346,"text":"暗闇で見たものを話した…","nextNodeIds":[30001030]},{"nodeId":30001030,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":137542322,"text":"なるほど…","nextNodeIds":[30001031]},{"nodeId":30001031,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":590101178,"text":"コレイ、とりあえずパトロール日誌をここに持ってこないよう、他の人に伝えてきて。","nextNodeIds":[30001032]},{"nodeId":30001032,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":3935565514,"text":"えっ？どうして？","nextNodeIds":[30001033]},{"nodeId":30001033,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2147977362,"text":"#もうしばらく、{M#彼ら}{F#彼女たち}には僕の部屋に泊まってもらう。僕はアミルのところで何とかするよ。ほら、早く行って来て。","nextNodeIds":[30001034]},{"nodeId":30001034,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":313060154,"text":"あっ、はい。行ってくる！","nextNodeIds":[30001035]},{"nodeId":30001035,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3968686026,"text":"ちょっと待った、どういうことだ？","nextNodeIds":[30001036]},{"nodeId":30001036,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":1534591410,"text":"ああ、説明するよ。薬草スープをもう一回飲んでもらえれば治ると思ってたんだけど、しばらくはガンダルヴァー村で療養してもらって経過観察をしたほうがいいと判断したんだ。","nextNodeIds":[30001037]},{"nodeId":30001037,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2322048618,"text":"「経過観察」？","nextNodeIds":[30001038]},{"nodeId":30001038,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2666329754,"text":"でも、スメールシティに行かないと…","nextNodeIds":[30001039]},{"nodeId":30001039,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":3822709682,"text":"落ち着いて。君が状況を見極められる人なら、僕の説明を聞いてくれれば、事態の深刻さが分かるはずだよ。","nextNodeIds":[30001040]},{"nodeId":30001040,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2052256970,"text":"さっきの君の話によると、お香のせいで君は強烈な「幻覚」を見てしまったらしい。精神状態も良いとは言えない。","nextNodeIds":[30001041]},{"nodeId":30001041,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":13939986,"text":"それでも深刻と思えないなら、これを嗅いでみてよ。","nextNodeIds":[30001042]},{"nodeId":30001042,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2828109154,"text":"うぅ——！","nextNodeIds":[30001043]},{"nodeId":30001043,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1051305450,"text":"おい、大丈夫か？","nextNodeIds":[30001044]},{"nodeId":30001044,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2261663282,"text":"倒れた時の感覚と似てるだろ？","nextNodeIds":[30001045]},{"nodeId":30001045,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":3829512690,"text":"今はちゃんと意識があるかもしれないけど、ここで君を放っておいたら、また突然どこかで意識不明になるかもしれない。","nextNodeIds":[30001046]},{"nodeId":30001046,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":1018086210,"text":"それに、ここには多くの猛獣が潜んでるし、危険なエリアだってある。今回みたいな幸運が続くとは限らない。","nextNodeIds":[30001047]},{"nodeId":30001047,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":4217401842,"text":"しばらくは、毎日時間通りに薬を飲んで。この匂いを嗅いで不快感を覚えなくなるまで、できるだけ単独行動しちゃだめだから。いいね？","nextNodeIds":[30001048]},{"nodeId":30001048,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1216439290,"text":"分かった…","nextNodeIds":[30001049]},{"nodeId":30001049,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":557200938,"text":"もうちょっと休んでおきなよ、薬草スープを作り直してあげる。","nextNodeIds":[30001050]},{"nodeId":30001050,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1820996754,"text":"はぁ、なんてこった…スメールについたばっかりで、おまえがこんなことになっちゃうなんて。","nextNodeIds":[30001051]},{"nodeId":30001051,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2941359234,"text":"#{NICKNAME}、早くクラクサナリデビに会いたいって気持ちはオイラにもわかるけど、今のおまえは確かにまずいぜ。まずは元気になってくれ。","nextNodeIds":[30001052]},{"nodeId":30001052,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1391646898,"text":"おい、オイラの話を聞いてるのか？オイラ、心配してるんだぞ！","nextNodeIds":[30001053]},{"nodeId":30001053,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2667898722,"text":"少し変だと思って。","nextNodeIds":[30001054]},{"nodeId":30001054,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":398625818,"text":"変？おまえの体のことか？","nextNodeIds":[30001055,30001056]},{"nodeId":30001055,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1148370138,"text":"体も変だけど、それより…","nextNodeIds":[30001057]},{"nodeId":30001057,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1276017450,"text":"ああ、おまえが見てた樹の根と赤い空のことか？でも、あれが幻覚じゃなかったら、なんだって言うんだ？","nextNodeIds":[30001058]},{"nodeId":30001058,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2871764194,"text":"分からない。","nextNodeIds":[30001059]},{"nodeId":30001059,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2660601346,"text":"（あの時、奥深い地の底に立っているような感じだった。あの赤い空は、もしかして…「カーンルイア」？）","nextNodeIds":[30001060]},{"nodeId":30001060,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1958962290,"text":"うーん…おまえの体質は特殊だからな。その判断を信じるぜ。でもだったらさっき、なんでそのことをティナリに言わなかったんだ？","nextNodeIds":[30001061]},{"nodeId":30001061,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":565726706,"text":"今、あいつはおまえの病状を勘違いしてるってことだけど、おまえの体がどんどん悪くなったりしないよな？","nextNodeIds":[30001062,30001063]},{"nodeId":30001062,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3590084738,"text":"彼の判断は間違ってないと思う。","nextNodeIds":[30001064]},{"nodeId":30001064,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":679061770,"text":"えっ、じゃあ…ティナリはおまえが見たやつが幻覚じゃないってわかってて、わざとオイラたちをごまかそうとしてたってことか？","nextNodeIds":[30001065]},{"nodeId":30001065,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":647567890,"text":"そう。だから、真相を突き止めたい。","nextNodeIds":[30001066]},{"nodeId":30001066,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2988150482,"text":"なるほど、だからさっきは黙ってたんだな。","nextNodeIds":[30001067]},{"nodeId":30001067,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4235746394,"text":"だったらここで静かに休んで体を回復しながら、おまえが見たものの真相を解明しようぜ。","nextNodeIds":[30001068]},{"nodeId":30001068,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3238150618,"text":"でも、直接ティナリに聞くのはダメっぽいよな…おまえ、なにか案があるのか？","nextNodeIds":[30001069]},{"nodeId":30001069,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":921242298,"text":"コレイと話してみよう。","nextNodeIds":[30001070]},{"nodeId":30001070,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":678725706,"text":"おお、コレイはオイラたちに親切だし、いいかもな。明日はまず、草神やスメールの風土と気質について聞いてみよう。","nextNodeIds":[30001071]},{"nodeId":30001071,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":3649397370,"text":"部屋で一晩休んだ…","nextNodeIds":[]},{"nodeId":30001063,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":498989162,"text":"ただ、本当のことを言ってないだけ。","nextNodeIds":[30001064]},{"nodeId":30001056,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2110925618,"text":"あれは「幻覚」なんかじゃなかった。","nextNodeIds":[30001057]},{"nodeId":30001012,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2360887314,"text":"口の中が…苦い！","nextNodeIds":[30001013]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[300010,0],