:[{"nodeId":30000301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":885776762,"text":"あれ？あそこの小さな滝のところで姿が消えたぞ、早く行ってみようぜ。","nextNodeIds":[30000302]},{"nodeId":30000302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3007801482,"text":"うぅ、この洞窟は村に繋がる入り口かなにかなんじゃないかと思ったけど、違ったみたいだな。","nextNodeIds":[30000303]},{"nodeId":30000303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2911498954,"text":"見ろ、あそこに座ったぞ。まさか、ここに住んでたりしないよな？","nextNodeIds":[30000304]},{"nodeId":30000304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1331497762,"text":"どうする？もう一回あいつに聞いてみるか？","nextNodeIds":[30000305,30000307]},{"nodeId":30000305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1971283514,"text":"頑張って交流を図ってみよう。","nextNodeIds":[30000306]},{"nodeId":30000306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":667432170,"text":"はぁ…そうだな、せっかく出会った通行人だしな。たとえオイラたちを歓迎してなくても、なんとか話してみて、方向だけでも示してもらえたらいいよな。","nextNodeIds":[30000309]},{"nodeId":30000309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1378579314,"text":"くんくん…あれ、なんかスッキリする匂いだぞ。","nextNodeIds":[30000310]},{"nodeId":30000310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":129330050,"text":"あの香炉から出てるやつだな。質素な住まいだけど、こんな香りの中で瞑想できるのって、悪くない暮らしかもな。","nextNodeIds":[30000311]},{"nodeId":30000311,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2148966946,"text":"——！！","nextNodeIds":[30000312]},{"nodeId":30000312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3193324498,"text":"おまえ、どうしたんだ？急に顔色が…","nextNodeIds":[30000313,30000314]},{"nodeId":30000313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":134706794,"text":"この香り…","nextNodeIds":[30000315]},{"nodeId":30000315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3520413898,"text":"えっ？香りでそんなに気分が悪くなったのか？でも、オイラは全然平気だけど…","nextNodeIds":[30000316]},{"nodeId":30000316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1176437290,"text":"（ここから離れないと…！）","nextNodeIds":[30000317]},{"nodeId":30000317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1664070770,"text":"（ダメだ、意識が…）","nextNodeIds":[30000318]},{"nodeId":30000318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4022324258,"text":"#おい、{NICKNAME}、どうしたんだよ！？しっかりしろ…","nextNodeIds":[]},{"nodeId":30000314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1858597602,"text":"何だか変だ…","nextNodeIds":[30000315]},{"nodeId":30000307,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1056224882,"text":"やっぱり邪魔しないでおこう。","nextNodeIds":[30000308]},{"nodeId":30000308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":336754554,"text":"うーん、あいつのアレ…「瞑想」ってやつなのか？もしまた邪魔しちゃったら、さっきみたいにただ睨むだけじゃ済まないかもしれないよな。","nextNodeIds":[30000309]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[300003,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12554"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":300004,"order":6,"stepDescription":"洞窟の状況を観察する","stepDescTextMapHash":2994242220,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1155,596],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_DUNGEON","PPFLKMOMKAI":"3"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NON