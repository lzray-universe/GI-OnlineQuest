lse,"talkIds":[7905202],"talks":[{"talkId":7905202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7905201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7905202,"initDialog":790520201,"nextRandomTalks":[],"nextTalks":[],"npcId":[13250,1005],"performCfg":"QuestDialogue/WQ/Penumbra_79052/Q7905202","priority":3,"questId":79052,"showRandomTalkCount":0},"dialogs":[{"nodeId":790520201,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":913529994,"text":"コースの傾斜がもっと大きければ、もっと刺激的な体験になるかもな。空中で旋回する角度は…ケホッ…","nextNodeIds":[790520202]},{"nodeId":790520202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3037543082,"text":"あっ、ハッドだ！","nextNodeIds":[790520203]},{"nodeId":790520203,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":2231505850,"text":"アンタたちか…ケホッ、ヴェルーリヤ·ミラージュを楽しんでるか？","nextNodeIds":[790520204,790520205]},{"nodeId":790520204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3400914906,"text":"楽しく遊べてる！","nextNodeIds":[790520206]},{"nodeId":790520206,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":1296696418,"text":"それなら良かった、ケホケホ…アンタたちが楽しく遊べているなら、俺も安心だ。","nextNodeIds":[790520208]},{"nodeId":790520208,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":261500442,"text":"ああ、そういえば…ケホケホケホ、実験用の小型爆速車のコースがあるんだが…試してみないか？","nextNodeIds":[790520209]},{"nodeId":790520209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":484358730,"text":"実験用？もしかして、爆速車も実験が要るのか？","nextNodeIds":[790520210]},{"nodeId":790520210,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":3336077906,"text":"そうだ、俺の後ろを見てくれ。ここが「びゅんびゅん爆速車」の実験場所だ。へへっ、「激流ツイスター」をまだ覚えてるか…？","nextNodeIds":[790520211]},{"nodeId":790520211,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":2535637018,"text":"あのコースはここで生まれたんだ…ケホケホ、先成図と集流映写灯があっても、コースの設計が基準をクリアしてなければ、正しく成型はできないんだ。","nextNodeIds":[790520212]},{"nodeId":790520212,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":2821759178,"text":"だから先に設計と実験をして、フィードバックをもとに修正を加えるのが大切だ…た、ただ、ここにあるのは多少…ジェローニの言葉を借りれば、刺激的すぎるかもしれない。","nextNodeIds":[790520213]},{"nodeId":790520213,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":1302123186,"text":"勾配のテストをするために、この小型試験場にはコースが3つ設置されている、ケホケホ…外の「びゅんびゅん爆速車」よりちょっと早いぞ…","nextNodeIds":[790520214]},{"nodeId":790520214,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":3898545898,"text":"それぞれ「まだ平気コース」、「ちょい酔うコース」と「は、早すぎる！コース」だ。ケホ…ああ、ついでに言っとくと、コースの名前は全部フェルディナンドが考えたやつだぞ。","nextNodeIds":[790520215]},{"nodeId":790520215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1832507898,"text":"えっと…フェルディナンドのやつ、大丈夫か…？","nextNodeIds":[790520216]},{"nodeId":790520216,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":361056738,"text":"あいつは問題ない。ただ、その、新鮮な空気を吸う必要があるだけさ…","nextNodeIds":[790520217]},{"nodeId":790520217,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":2113638698,"text":"本題に戻ろう、コースはどれも…ケホッ、外の「びゅんびゅん爆速車」のコースより速い。だからまず「まだ平気コース」からスタートすることをお勧めするよ。","nextNodeIds":[790520218]},{"nodeId":790520218,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":4182266490,"text":"どうだい？挑戦してみる勇気はあるか？","nextNodeIds":[790520219,790520220]},{"nodeId":790520219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2194199978,"text":"すぐに始めよう！","nextNodeIds":[790520221]},{"nodeId":790520221,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":1035292610,"text":"よし、気合入ってるな。3つのコースを担当している「水形幻霊」のところへ行ってくれ。アンタのために喜んでコースを開けてくれるよ。","nextNodeIds":[]},{"nodeId":790520220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3639107602,"text":"まだ他に用事がある…","nextNodeIds":[790520222]},{"nodeId":790520222,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":4214169378,"text":"急ぐ必要はない、ケホッ…3つのコースを担当する「水形幻霊」は試験場のすぐ傍にいる。時間がある時に行ってもらえれば良いさ…","nextNodeIds":[]},{"nodeId":790520205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1255177994,"text":"咳は少し良くなった？","nextNodeIds":[790520207]},{"nodeId":790520207,"roleType":"TALK_ROLE_NPC","speakerId":13250,"speakerName":"ハッド","textMapHash":2859575882,"text":"ケホケホ…多分、もう治らないかもな。でも平気さ。たかが咳だ、俺のコース設計への情熱は止められない…","nextNodeIds":[790520208]}]}],"conditions":{"finishCond":[{"B