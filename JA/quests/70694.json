Count":0},"dialogs":[{"nodeId":706940101,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":456638514,"text":"バンバンさん、まだ腰痛い？","nextNodeIds":[706940102]},{"nodeId":706940102,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","textMapHash":3047882138,"text":"とりあえずは大丈夫だ…温めると、本当に楽になるな！","nextNodeIds":[706940103]},{"nodeId":706940103,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":3464231234,"text":"へへっ、火薬で湿った包帯を温めるときは、ちゃんと時間を加減せなあかんで。ほっといたら、包帯に火ぃが燃え移ってまうからな。","nextNodeIds":[706940104]},{"nodeId":706940104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4081321506,"text":"そんな包帯の温め方、宵宮しか思いつかないだろ！","nextNodeIds":[706940105]},{"nodeId":706940105,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","textMapHash":395944354,"text":"おっと…これは！大英雄と白い仲間じゃないか！","nextNodeIds":[706940106]},{"nodeId":706940106,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","textMapHash":3678256802,"text":"マンガウォーベンの中のシーンが見られるのか？","nextNodeIds":[706940107,706940108]},{"nodeId":706940107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1071913002,"text":"これは治療中…？","nextNodeIds":[706940109]},{"nodeId":706940109,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","textMapHash":2691415218,"text":"心配しなくていい！外をぶらぶらしてたら、めったに見ない強敵に巡りあったもんで、ちょっと腕試ししてたんだけどさ。","nextNodeIds":[706940110]},{"nodeId":706940110,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","textMapHash":345181306,"text":"そしたら、腰をひねっちまって…雪玉になって転がり落ちたあたしを、宵宮さんが助けてくれたんだ！","nextNodeIds":[706940111]},{"nodeId":706940111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1108945882,"text":"うわぁ…聞いてるだけで痛そうだぞ…","nextNodeIds":[706940112]},{"nodeId":706940112,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":4022527306,"text":"はは、『炎魂戦記』の言葉を借りると——うちはただの通りすがりの戦士や。","nextNodeIds":[706940113]},{"nodeId":706940113,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":2498439506,"text":"それも、自由な雇われのな！騎士団から許可ももろたし、魔物討伐は自由にしてええんやって。","nextNodeIds":[706940114,706940115]},{"nodeId":706940114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3088409410,"text":"まだ魔物が徘徊してるってこと？","nextNodeIds":[706940116]},{"nodeId":706940116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1318053130,"text":"そうだな。騎士団に連絡して、もっと人手を回してもらうか？","nextNodeIds":[706940117]},{"nodeId":706940117,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":631014746,"text":"確かに油断はできひんけど、そこまで切羽詰まってへんで。","nextNodeIds":[706940118]},{"nodeId":706940118,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":2625704146,"text":"騎士団の人たちがクロスカントリー大会のフィールド周辺にいた魔物は片付けてくれはったみたいやし、もうあとチョロチョロしてるんは残党だけや。","nextNodeIds":[706940119]},{"nodeId":706940119,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":2189197642,"text":"参加選手の中にも、強い冒険者はいっぱいいはるしな。","nextNodeIds":[706940120]},{"nodeId":706940120,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":2966120194,"text":"体力も胆力もある人たちやから、こっちがあんまし気ぃ遣たら、かえって気ぃ悪しはるわ。","nextNodeIds":[706940121]},{"nodeId":706940121,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","textMapHash":624775874,"text":"だから、冒険者協会のやり方にならって、現地でチームを組ませ、残った魔物の処理を一種の試練としてるってわけだ！","nextNodeIds":[706940122]},{"nodeId":706940122,"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","textMapHash":1007397674,"text":"それが「バトルソウル試練」だ。魔物の一掃を基本としつつ、できる限り英雄たちの戦い方を真似て、自分を超えることを目指してもらう！","nextNodeIds":[706940123]},{"nodeId":706940123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3462123122,"text":"「豊穣の邦」らしいアイデアだな！","nextNodeIds":[706940124,706940125]},{"nodeId":706940124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2072301218,"text":"#{M#俺}{F#私}も参加するよ！","nextNodeIds":[706940126]},{"nodeId":706940126,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":212998346,"text":"#ええやん！久しぶりに{NICKNAME}の腕前、見してもらえるな！","nextNodeIds":[706940127]},{"nodeId":706940127,"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","textMapHash":4205247018,"text":"むっちゃ楽しみや。今のあんたの身のこなし…花火に喩えたらどんなんやろな？","nextNodeIds":[]},{"nodeId":706940125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1477174714,"text":"#{M#俺}{F#私}も参加しないと！","nextNodeIds":[706940126]},{"nodeId":706940115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3930530402,"text":"近くには住民もいるし、気を付けないとね。","nextNodeIds":[706940116]},{"nodeId":706940108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3683009586,"text":"戦ってたの？","nextNodeIds":[706940109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30896"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7069401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1035,"speakerName":"宵宮","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":30896,"speakerName":"「バンバンローリングストーン」","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170694],"BHC