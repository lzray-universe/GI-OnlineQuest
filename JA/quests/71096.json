riority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7109602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7109602,"initDialog":710960201,"nextRandomTalks":[],"nextTalks":[],"npcId":[2061,1005],"performCfg":"QuestDialogue/WQ/Liyue_71096/Q7109602","priority":6,"questId":71096,"showRandomTalkCount":0},"dialogs":[{"nodeId":710960201,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":3180836970,"text":"また「老石」三個だな。","nextNodeIds":[710960202]},{"nodeId":710960202,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":2205570730,"text":"「親切な民」二人から頂いた「老石」、確かに受け取った。","nextNodeIds":[710960203]},{"nodeId":710960203,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":4033041418,"text":"もう三枚も見つけてくれたのか。しかも品質もこれまで見たものより遥かに優れている。","nextNodeIds":[710960204]},{"nodeId":710960204,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":3659997186,"text":"はぁ…これは、俺が昔持ってたやつを思い出させるな。","nextNodeIds":[710960205]},{"nodeId":710960205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2939494850,"text":"おまえが持ってたやつ？","nextNodeIds":[710960206,710960207]},{"nodeId":710960206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4213311226,"text":"#持ってるのに{M#俺}{F#私}たちに探させたの？","nextNodeIds":[710960208]},{"nodeId":710960208,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":3145754762,"text":"「昔」持ってただけだ。","nextNodeIds":[710960209]},{"nodeId":710960209,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":3822815154,"text":"その「老石」は盛露庁にいた父が持っていた端材で、品質もいまいちだった。だからおもちゃとして俺に渡してくれたんだ。","nextNodeIds":[710960210]},{"nodeId":710960210,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":2036174906,"text":"あの頃は定職にも就かずにぶらぶらしてた。毎日のように父と喧嘩しては、当時の岩上茶室に居座ってたよ。借金までして、俺は絶体絶命だった…","nextNodeIds":[710960211]},{"nodeId":710960211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3983554786,"text":"あ…","nextNodeIds":[710960212]},{"nodeId":710960212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1378386634,"text":"酷かったんだね…","nextNodeIds":[710960213]},{"nodeId":710960213,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":4257097394,"text":"ああ、正に若気の至りだったよ。とにかく、俺が窮地に陥ったとき…","nextNodeIds":[710960214]},{"nodeId":710960214,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":3592181642,"text":"あれを「老石」だと見抜いた人物が現れたんだ。俺はただの石だと思ってたから、その石をモラに変えて窮地を何とか乗り越えた。","nextNodeIds":[710960215]},{"nodeId":710960215,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":1833681658,"text":"そしたらこの間、父に「沐寧、昔お前が遊んでた石はどこにやった？」と聞かれて…","nextNodeIds":[710960216]},{"nodeId":710960216,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":3257136474,"text":"「ただの石だ。まだ持ってるわけないだろ。」としか、答えようがなかった。","nextNodeIds":[710960217]},{"nodeId":710960217,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":436724306,"text":"そう答えながらも、心の中ではずっとモヤモヤしてた。もしあのとき石を売らなければ、父に見せてやれたのにってな…","nextNodeIds":[710960218]},{"nodeId":710960218,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":2304396138,"text":"…まあいい、こんな話をしても無駄だ。","nextNodeIds":[710960219]},{"nodeId":710960219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2960017010,"text":"おまえは正しい道に戻ってこれたんだから、もう大丈夫だ。","nextNodeIds":[710960220]},{"nodeId":710960220,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":938982138,"text":"そうだな…それでも借りた金はコツコツと返さないと。","nextNodeIds":[710960221]},{"nodeId":710960221,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":2734874234,"text":"この話は終わりだ。老石があったら、持ってきてくれよ。","nextNodeIds":[710960222,710960223]},{"nodeId":710960222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2593536634,"text":"まだ足りないの？","nextNodeIds":[710960224]},{"nodeId":710960224,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":953378194,"text":"あと三枚探してくれれば足りるだろう。","nextNodeIds":[710960225]},{"nodeId":710960225,"roleType":"TALK_ROLE_NPC","speakerId":2061,"speakerName":"沐寧","textMapHash":3064326018,"text":"老石は元から希少な鉱物なんだ。たとえ輝山庁がこれ以上の数を求めているとしても、恐らく層岩巨淵ではもう見つからない。","nextNodeIds":[]},{"nodeId":710960223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3673378066,"text":"あとどれくらい必要？","nextNodeIds":[710960224]},{"nodeId":710960207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1453217666,"text":"まずは自分のを上納するべきじゃない？","nextNodeIds":[710960208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7109602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUES