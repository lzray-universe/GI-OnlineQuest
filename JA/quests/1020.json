_LOCAL","id":102006,"initDialog":10200601,"nextRandomTalks":[],"nextTalks":[],"npcId":[1005],"performCfg":"QuestDialogue/AQ/Liyue3_1020/Q102006","priority":5,"questId":1020,"showRandomTalkCount":0},"dialogs":[{"nodeId":10200601,"roleType":"TALK_ROLE_NPC","speakerId":10262,"speakerName":"華清","textMapHash":2627183361,"text":"やめなさい！何事？","nextNodeIds":[10200602]},{"nodeId":10200602,"roleType":"TALK_ROLE_NPC","speakerId":10262,"speakerName":"華清","textMapHash":928066785,"text":"刻晴様、この不審者たちが帰終機に何かしようとしています。","nextNodeIds":[10200603]},{"nodeId":10200603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":218880857,"text":"だ、誰が不審者だ！","nextNodeIds":[10200604]},{"nodeId":10200604,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":549286017,"text":"群玉閣への道を探してるだけ。","nextNodeIds":[10200605]},{"nodeId":10200605,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":4169835113,"text":"ん？「群玉閣」？君たち、何者？","nextNodeIds":[10200606]},{"nodeId":10200606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":488024409,"text":"招待された客人で、「璃月七星」を探してる！そっちは？","nextNodeIds":[10200607]},{"nodeId":10200607,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":4132863361,"text":"……","nextNodeIds":[10200608]},{"nodeId":10200608,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1304435617,"text":"奇遇ね、私がその「璃月七星」よ。","nextNodeIds":[10200609]},{"nodeId":10200609,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1202570241,"text":"？？？","nextNodeIds":[10200610]},{"nodeId":10200610,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":4040326313,"text":"私は刻晴、璃月七星「玉衡」。","nextNodeIds":[10200611]},{"nodeId":10200611,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1163892873,"text":"旅人、君のことは知ってるわ。凝光の客人よね？まさかここで会うとは。","nextNodeIds":[10200612]},{"nodeId":10200612,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2219944633,"text":"おぉ——こんな荒野でお金持ちと会えるなんて思わなかった。","nextNodeIds":[10200613]},{"nodeId":10200613,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":805289945,"text":"壊れた天衡古城垣の帰終機が一夜で修復された。私がここに来たのはそのことを調べるためよ。","nextNodeIds":[10200614]},{"nodeId":10200614,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1050869065,"text":"この千岩軍たちがいるのも、現場を守るためだけだから。","nextNodeIds":[10200615]},{"nodeId":10200615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1072903457,"text":"誤解だったんだな？うん…全く思いつかなかった。","nextNodeIds":[10200616]},{"nodeId":10200616,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":666569745,"text":"ちゃんと考えれば分かる。","nextNodeIds":[10200617]},{"nodeId":10200617,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":353050249,"text":"そもそも、仙人の作った装置を直せる凡人がいるなんて、「七星」にとっては不思議な話よ。","nextNodeIds":[10200618]},{"nodeId":10200618,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1651313137,"text":"へへっ、それはな…","nextNodeIds":[10200619,10200620]},{"nodeId":10200619,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":469421001,"text":"（シッ…余計なことは言わない。）","nextNodeIds":[10200621]},{"nodeId":10200621,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":772371649,"text":"ん？あっ、ああ…そうだ、「玉衡」様は「天権」様がオイラたちを招待した理由を知ってるか？","nextNodeIds":[10200622]},{"nodeId":10200622,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2574846713,"text":"刻晴でいいわ。","nextNodeIds":[10200623]},{"nodeId":10200623,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1018944185,"text":"そうね、彼女が君を呼んだのは「モンドを救った英雄」に中立を保っていて欲しいからだと思うよ…完全に仙人の味方にならずにね。","nextNodeIds":[10200624]},{"nodeId":10200624,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3440274273,"text":"別に誰かの味方でもないよな！あの仙人たちだって、璃月を守ろうとしてるし…","nextNodeIds":[10200625]},{"nodeId":10200625,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1058649713,"text":"その「守る」は、上から目線の傲慢のことかしら？","nextNodeIds":[10200626]},{"nodeId":10200626,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3175325873,"text":"えっ？","nextNodeIds":[10200627]},{"nodeId":10200627,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":666693001,"text":"君たちは凡人。彼らの守る対象だから、彼らは君を「神を殺せる刺客」だとは思わないでしょう。","nextNodeIds":[10200628]},{"nodeId":10200628,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":743721801,"text":"だから凝光が現場を封じ、民を取り調べて刺客を探すなんて命令を…彼らは何かを隠すための工作だと思ってるでしょうね。","nextNodeIds":[10200629]},{"nodeId":10200629,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1829477649,"text":"そう、彼らは私たちを軽蔑してるわ。","nextNodeIds":[10200630]},{"nodeId":10200630,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3946148577,"text":"確かにそれも一理あるかも…","nextNodeIds":[10200631]},{"nodeId":10200631,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3555100433,"text":"でも、刻晴みたいな「仙人を敬わない」璃月人は初めて見た。","nextNodeIds":[10200632]},{"nodeId":10200632,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":361533721,"text":"ハッ…時間の概念が薄いだけで敬えと？彼らは凡人に対して傲慢だから、私たち「七星」にしばらく手は出してこないでしょうね？","nextNodeIds":[10200633]},{"nodeId":10200633,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1801547489,"text":"いい、今のは忘れて。「敬わない」はあくまで私個人の信条だから、凝光はそんなこと言わないわ。","nextNodeIds":[10200634]},{"nodeId":10200634,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":785280649,"text":"とにかく、今回彼らの行動は十分自制があるものだと認めるわ。","nextNodeIds":[10200635]},{"nodeId":10200635,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":1727730225,"text":"帝君の殺害は尋常じゃない。こんな事態を前に、彼らは直接攻撃してくるのではなく、他の仙人を招集して話し合うことにした…","nextNodeIds":[10200636]},{"nodeId":10200636,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3173772257,"text":"思いのほか理性的ね、意外だわ。","nextNodeIds":[10200637,10200638]},{"nodeId":10200637,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1162823905,"text":"つまり、和解の可能性もあると？","nextNodeIds":[10200639]},{"nodeId":10200639,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":598146361,"text":"凝光はね…何でも交渉で解決しようと思ってるけど——それは詭弁だわ。","nextNodeIds":[10200640]},{"nodeId":10200640,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":2873404729,"text":"「仙人」の時代は終わった。「璃月七星」さえもそれを受け入れなければ、璃月の未来はどうなるの？","nextNodeIds":[10200641]},{"nodeId":10200641,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2770127865,"text":"わっ…また大胆な発言だな。","nextNodeIds":[10200642]},{"nodeId":10200642,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":905793489,"text":"まあ…話は以上よ。ここまで話すつもりはなかったけど、君はいい聞き手よね、旅人。","nextNodeIds":[10200643]},{"nodeId":10200643,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3579710513,"text":"さあ、群玉閣に行きなさい。ちゃんと時間を守ってよ？凝光に会いたい人はたくさんいるんだから。","nextNodeIds":[10200644]},{"nodeId":10200644,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":779751473,"text":"璃月の富豪たちにとって、「群玉閣に登る」ことは最高の栄誉よ。なんたってメリットしかないもの。","nextNodeIds":[10200645]},{"nodeId":10200645,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3867813977,"text":"メ、メリット！？","nextNodeIds":[10200646,10200647]},{"nodeId":10200646,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1207613289,"text":"パイモン、そこじゃない。","nextNodeIds":[10200648]},{"nodeId":10200648,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2822424217,"text":"でも…でも！","nextNodeIds":[10200649]},{"nodeId":10200649,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2961176033,"text":"そうだ！「手土産」も璃月の文化だぞ。メリットのためじゃない、璃月の伝統文化のためだぞ…","nextNodeIds":[10200650]},{"nodeId":10200650,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":121251649,"text":"パイモン、また始まった…","nextNodeIds":[10200651]},{"nodeId":10200651,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":412542609,"text":"まあまあ、手土産はあとでいいから、まずは群玉閣に行く方法を教えるわ。","nextNodeIds":[10200652]},{"nodeId":10200652,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":3934391641,"text":"本当はここに来なくてもいいの。璃月港に戻って、月海亭で「案内人」を探せばね。それから…","nextNodeIds":[10200653]},{"nodeId":10200653,"roleType":"TALK_ROLE_NPC","speakerId":1016,"speakerName":"刻晴","textMapHash":929360529,"text":"では、また会いましょう、旅人。","nextNodeIds":[10200654]},{"nodeId":10200654,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1090459329,"text":"うん…あの「玉衡」は仙人を敬わないけど、あっさりした人だな。","nextNodeIds":[10200655,10200656]},{"nodeId":10200655,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2051254873,"text":"いい人だね。","nextNodeIds":[10200657]},{"nodeId":10200657,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2098800961,"text":"そうだ、凝光への手土産はどうする…うーん…","nextNodeIds":[10200658]},{"nodeId":10200658,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2557437641,"text":"パイモンの優先事項が手土産になった…","nextNodeIds":[10200659]},{"nodeId":10200659,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2498783385,"text":"そうだ！昨日、夢で素敵な料理を思いついたんだ。その名も——<color=#00E1FFFF>「アイシングスライム」</color>！","nextNodeIds":[10200660]},{"nodeId":10200660,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":445754561,"text":"凝光みたいな大富豪にピッタリだと思うぞ。","nextNodeIds":[10200661]},{"nodeId":10200661,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1372973265,"text":"それを手土産にしようぜ！","nextNodeIds":[10200662,10200664]},{"nodeId":10200662,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3658310097,"text":"レシピは？","nextNodeIds":[10200663]},{"nodeId":10200663,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3450508809,"text":"ない！でも「ピキーン」って感じでやればいいぞ！","nextNodeIds":[10200666]},{"nodeId":10200666,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1586373297,"text":"まずは材料だ！急げ、栄光と富が待ってるぞ！","nextNodeIds":[]},{"nodeId":10200664,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2860742393,"text":"夢で思いついたものをどう作るの？","nextNodeIds":[10200665]},{"nodeId":10200665,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2274120913,"text":"「ピキーン」って感じでやればいいんだ！","nextNodeIds":[10200666]},{"nodeId":10200656,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3489360417,"text":"彼女の話には同感できる。","nextNodeIds":[10200657]},{"nodeId":10200647,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":558100225,"text":"パイモン、真面目な話の途中。","nextNodeIds":[10200648]},{"nodeId":10200638,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2835806081,"text":"凝光も仙人と交渉したいの？","nextNodeIds":[10200639]},{"nodeId":10200620,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3255452257,"text":"（大したことしてないよ…）","nextNodeIds":[10200621]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102006,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q101503Trigger","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUID