163162,"text":"他の出場選手の「叡智宝珠」を集めて、キノコンの仲間に相応しい生息地を選んだわ。周囲の生態環境に影響を及ぼすこともない。","nextNodeIds":[400860303]},{"nodeId":400860303,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"ハニヤー","textMapHash":571075418,"text":"さあ、皆に挨拶して、「喜炎」。","nextNodeIds":[400860304]},{"nodeId":400860304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":744379682,"text":"「喜炎」？","nextNodeIds":[400860305]},{"nodeId":400860305,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"ハニヤー","textMapHash":2647194050,"text":"「炎1」の新しい名前なの。最初この子と出会った時…あまりにも大人しかったから、内心、喜んだ気持ちがあった。","nextNodeIds":[400860306]},{"nodeId":400860306,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"ハニヤー","textMapHash":146094298,"text":"私が偏見を取り去り、自分の本当の心に向き合って、キノコンを憎まずにいられたら…この気持ちもずっと続くでしょう。","nextNodeIds":[400860307]},{"nodeId":400860307,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"レイラ","textMapHash":401449122,"text":"ハニヤーさん、心のわだかまりがやっと解けたんだね…","nextNodeIds":[400860308]},{"nodeId":400860308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":167817178,"text":"そう来なくっちゃ！炎1って名前にちょっと慣れちゃってたけど、この新しい名前はもっと深い意味があるよな！","nextNodeIds":[400860309,400860310]},{"nodeId":400860309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1209806346,"text":"よかったね、ハニヤー。","nextNodeIds":[400860311]},{"nodeId":400860311,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"ハニヤー","textMapHash":2027975010,"text":"一番厳しく自分を律して、この優しいキノコンたちを必ず大切にするから…仲間を安心して私に託して。","nextNodeIds":[400860312]},{"nodeId":400860312,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"レイラ","textMapHash":3869788122,"text":"もう別れの時だね…","nextNodeIds":[400860313]},{"nodeId":400860313,"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"レイラ","textMapHash":1860182570,"text":"さようなら、テンテンヨーヨー獣。ハニヤーさんの言うことをちゃんと聞くんだよ…","nextNodeIds":[400860314]},{"nodeId":400860314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1019941570,"text":"百雷遮羅、今度「テイマー大会」が開催されることになったら、神子はきっとおまえを見に来るぞ。","nextNodeIds":[400860315]},{"nodeId":400860315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":474414530,"text":"ポコポコビーニー…もう一回ハイタッチしようぜ！短い間だったけど楽しかった。おまえも楽しく生きて、オイラたちと再会できる日を楽しみにしろよな！","nextNodeIds":[400860316]},{"nodeId":400860316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4200639818,"text":"きっとまた会える！","nextNodeIds":[400860317]},{"nodeId":400860317,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"ハニヤー","textMapHash":1115270650,"text":"人とキノコンが共存できる日が早く来ることを願っているわ。","nextNodeIds":[400860318]},{"nodeId":400860318,"roleType":"TALK_ROLE_NPC","speakerId":12855,"speakerName":"ハニヤー","textMapHash":4109882930,"text":"信じてるわよ！君たちの朗報を待ってるから！","nextNodeIds":[]},{"nodeId":400860310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3429887194,"text":"喜炎も、よかったね。","nextNodeIds":[400860311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4008603,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["4008603","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q4008603_guide"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4008601,4008602,4008603],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1063,"speakerName":"レイラ","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","count":8},{"roleType":"