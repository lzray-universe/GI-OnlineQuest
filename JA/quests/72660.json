pHash":354064122,"text":"興奮してきた。","nextNodeIds":[726600205]},{"nodeId":726600205,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":1338879450,"text":"「天狗党」はとっくに公序良俗に反するという理由で禁じられていたが、時折こうして秘密裏に百人一揆の乱闘大会を開催している。","nextNodeIds":[726600206]},{"nodeId":726600206,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":2385905842,"text":"そして世界各地から、戦いに飢える魔物、冒険者、戦士たちが引きつけられ、その舞台で大いに力を振るう。","nextNodeIds":[726600207]},{"nodeId":726600207,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":1539389906,"text":"君も志を共にした仲間や戦友と参戦してみるといい。なんと言っても「百人」だから、人が多いほどいいだろう。","nextNodeIds":[726600208]},{"nodeId":726600208,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":2022974930,"text":"四方を旅する冒険者の君なら、一緒に参加してくれる友達もいるだろ。","nextNodeIds":[726600209]},{"nodeId":726600209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1178070170,"text":"#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は参加しないの？","nextNodeIds":[726600210]},{"nodeId":726600210,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":1289988714,"text":"俺か？俺は傍観者の身分で、君を応援するよ。","nextNodeIds":[726600211]},{"nodeId":726600211,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":2413678698,"text":"実は、俺の目的は面白い格闘系小説を書き、八重堂の「この小説はすごい」の賞を取ることなんだ。","nextNodeIds":[726600212]},{"nodeId":726600212,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":555424082,"text":"そして、君こそが格闘場で最も輝く星だと、俺の直感が教えてくれた。","nextNodeIds":[726600213,726600214]},{"nodeId":726600213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3387275634,"text":"がんばる。","nextNodeIds":[726600215]},{"nodeId":726600215,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":2207896778,"text":"小説の名前も考えてある。『百人一揆——最強武闘大会編』。いつの日か八重堂でこの本を見かけたら、金髪異邦戦士の登場をぜひ確認してみてくれ。","nextNodeIds":[726600216]},{"nodeId":726600216,"roleType":"TALK_ROLE_NPC","speakerId":30065,"speakerName":"茅葺一慶","textMapHash":3734781530,"text":"期待してるぞ。","nextNodeIds":[]},{"nodeId":726600214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1581110450,"text":"もちろん。","nextNodeIds":[726600215]},{"nodeId":726600204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2369478434,"text":"なんか怪しい。","nextNodeIds":[726600205]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30065"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7266003,"order":3,"stepDescription":"","stepDescTextMapHash":1949536268,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":