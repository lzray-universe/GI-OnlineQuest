_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7403304,"initDialog":740330401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21048,21076],"performCfg":"QuestDialogue/Q7403304","priority":5,"questId":74033,"showRandomTalkCount":0},"dialogs":[{"nodeId":740330401,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":437915978,"text":"ミトゥル、大丈夫ですか？閉じ込められてから、まださほど経っていませんよね？","nextNodeIds":[740330402]},{"nodeId":740330402,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":179104322,"text":"おお、救世主よ！来てくれたか！","nextNodeIds":[740330403]},{"nodeId":740330403,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":1558762146,"text":"で、コブレンツは？一緒じゃないのか？","nextNodeIds":[740330404]},{"nodeId":740330404,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":386726922,"text":"あなたがここに閉じ込められていることは彼から聞いたんです——それで助けてくれと。ただ…途中で看守の邪魔が入り、彼は離れざるを得なくなり…","nextNodeIds":[740330405]},{"nodeId":740330405,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":634737986,"text":"はぁ、コブレンツが信頼できるやつじゃないってことは知ってたさ！きっと怖気づいて、後ろめたさから逃げ出したんだろう。","nextNodeIds":[740330406]},{"nodeId":740330406,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":4195305170,"text":"商売をするには、それなりの度胸がなきゃ利益は出せない、そうだろ？","nextNodeIds":[740330407]},{"nodeId":740330407,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":2029486026,"text":"やつの不器用さはともかく、優柔不断なところがな……今がどんな状況だか分かるか？「純潔の水」どころか、フォンタまで入ってきた！","nextNodeIds":[740330408]},{"nodeId":740330408,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":3084262730,"text":"フォンタが入ってきたら、オレたちが生き残る道なんてないだろ。そう思わないか？","nextNodeIds":[740330409]},{"nodeId":740330409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2484625930,"text":"えーっと…","nextNodeIds":[740330410]},{"nodeId":740330410,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":3773004442,"text":"なんだ、お前たちもフォンタが好きなのか？","nextNodeIds":[740330411,740330413]},{"nodeId":740330411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":418454362,"text":"#{M#君}{F#あなた}は好きじゃないの？","nextNodeIds":[740330412]},{"nodeId":740330412,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":1756857642,"text":"もちろん好きさ！だからこそ、とても手ごわい競争相手だと認めてる…","nextNodeIds":[740330415]},{"nodeId":740330415,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":3990684690,"text":"まあ、雑談はここまでにしよう。コブレンツとケリをつけなきゃならないしな。そうだ、あいつは報酬を払ってないだろう？","nextNodeIds":[740330416]},{"nodeId":740330416,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3017477834,"text":"確かに払ってない。","nextNodeIds":[740330417]},{"nodeId":740330417,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":2886291370,"text":"…たまにあいつをバケツに詰めて、きっちり反省させてやりたくなるよ。とにかく——ほら、この特別許可券を受け取ってくれ。","nextNodeIds":[740330418]},{"nodeId":740330418,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":627101042,"text":"#これは、{NICKNAME}とパイモンが受け取ってください。","nextNodeIds":[740330419]},{"nodeId":740330419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1663964586,"text":"えっ？全部オイラたちがもらっていいのか？","nextNodeIds":[740330420]},{"nodeId":740330420,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3290725410,"text":"もちろんです。","nextNodeIds":[740330421]},{"nodeId":740330421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3732399762,"text":"へへっ。じゃあ、全部もらっちゃうぞ。あとでラグ＆ボーンショップにいいものがないか、見に行ってみようぜ！","nextNodeIds":[740330422]},{"nodeId":740330422,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":1871481834,"text":"そうだ。迷惑をかけた詫びといっちゃなんだが、この新鮮な健康ドリンクを何本かあげよう。ぜひ飲んでみてくれ。","nextNodeIds":[740330423]},{"nodeId":740330423,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3972883610,"text":"新鮮な…健康ドリンク？","nextNodeIds":[740330424]},{"nodeId":740330424,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":2109374858,"text":"ああ、「純潔の水」より全然ヘルシーだぜ！","nextNodeIds":[740330425,740330428]},{"nodeId":740330425,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1577289690,"text":"じゃあ、一杯もらおうかな。","nextNodeIds":[740330426]},{"nodeId":740330426,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3998789354,"text":"（おい！キャタピラーがさっき忠告してただろ。飲まないほうがいいぞ…）","nextNodeIds":[740330427]},{"nodeId":740330427,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4118604122,"text":"#{NICKNAME}の言ったことは忘れてくれ！ここに来る前にオイラたち…その、飲み物をたくさん飲んできたからさ！","nextNodeIds":[740330431]},{"nodeId":740330431,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2330239858,"text":"本当に残念だなぁ～、こんな素晴らしい健康ドリンクが飲めないなんて。また今度、試させてくれ！","nextNodeIds":[740330432]},{"nodeId":740330432,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":1924908130,"text":"そっか、そいつは残念だ。分かった、また今度オレのところに来てくれ。必ずごちそうしてやるから。","nextNodeIds":[740330433]},{"nodeId":740330433,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":3413812474,"text":"じゃあ、先に失礼させてもらおう。コブレンツのやつを探しに行かないと…","nextNodeIds":[740330434]},{"nodeId":740330434,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":765517826,"text":"ボクも他に用事があるので、ここで失礼します。特別許可券については、どうか気にしないでください。<color=#00E1FFFF>手がかりが見つかったら、黒板</color>に貼ります。また会いましょう。","nextNodeIds":[740330435]},{"nodeId":740330435,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1438308394,"text":"おう、またな！","nextNodeIds":[]},{"nodeId":740330428,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2350475458,"text":"フォンタをお願い。","nextNodeIds":[740330429]},{"nodeId":740330429,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":87845946,"text":"あるにはあるが…なんだ？オレの健康ドリンクじゃダメなのか？これはな…","nextNodeIds":[740330430]},{"nodeId":740330430,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3379227034,"text":"#{NICKNAME}はそういう意味で言ったんじゃないぞ！ただ…ここに来る前にオイラたち、飲み物をたくさん飲んできたんだ。だから、今はもう入らなくって…","nextNodeIds":[740330431]},{"nodeId":740330413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1166074954,"text":"まあまあかな。","nextNodeIds":[740330414]},{"nodeId":740330414,"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","textMapHash":2455272690,"text":"ほう…？いいセンスしてるじゃないか。","nextNodeIds":[740330415]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7403304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133408795"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"},{"LNHLPKELCAL":["74025","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21076"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7403301,7403304],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21076,"speakerName":"ミトゥル","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174033],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3335790246,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE"