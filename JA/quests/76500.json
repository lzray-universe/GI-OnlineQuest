500,"showRandomTalkCount":0},"dialogs":[{"nodeId":765000101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1889574514,"text":"#{NICKNAME}！早く早く！こっちに来てくれ！すっごくいいものを見せてやるぞ！","nextNodeIds":[765000102]},{"nodeId":765000102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":454497290,"text":"じゃじゃーん！見ろよ、このいろんな物が売られてる市場で、苦労して手に入れたお宝だ！","nextNodeIds":[765000103,765000104]},{"nodeId":765000103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4122266698,"text":"この写真機…なんだか味があるね。","nextNodeIds":[765000106]},{"nodeId":765000106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3847131474,"text":"これを売ってた不思議な店主によると、この写真機はフォンテーヌの超有名な写真家——ピエール・ルブランが数十年前に使ってたものらしいぞ！","nextNodeIds":[765000107]},{"nodeId":765000107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1075243562,"text":"これで撮った写真はどれも大人気で、よく『スチームバード新聞』の一面を飾ってたみたいだぜ！","nextNodeIds":[765000108]},{"nodeId":765000108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":38385138,"text":"#{NICKNAME}もこのすっごい写真機を使えば、世に名を残せるぐらいの名作を撮れるかもしれないだろ！もしかしたら、高値で売れる可能性だってあるぞ！","nextNodeIds":[765000109,765000112]},{"nodeId":765000109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3083308538,"text":"この写真機…かなり高かったでしょ？","nextNodeIds":[765000110]},{"nodeId":765000110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":385963842,"text":"えへへっ、大丈夫だぞ！オイラ、「へそくり」をそれなりに貯めてるからな！","nextNodeIds":[765000111]},{"nodeId":765000111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2070543338,"text":"#{NICKNAME}が喜んでくれるなら、これしきのモラ、どうってことないぜ。","nextNodeIds":[765000116,765000117]},{"nodeId":765000116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":202977466,"text":"ありがとう、パイモン。気に入ったよ。","nextNodeIds":[765000118]},{"nodeId":765000118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2447804538,"text":"えへへ！気に入ってくれてよかったぜ！ちょうど新しい土地に来たことだし、面白いものをいっぱい見れるはずだよな。それを片っ端から撮ってやろうぜ！","nextNodeIds":[765000119]},{"nodeId":765000119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3831021106,"text":"新しいアルバムもちゃんと用意してあるぞ。気が利くだろ！","nextNodeIds":[765000120]},{"nodeId":765000120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":709133242,"text":"よーし、一緒に面白い場所を探しに行こうぜ！出発しんこーう！","nextNodeIds":[]},{"nodeId":765000117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3245981666,"text":"これでいい写真を撮れるよう頑張るよ。","nextNodeIds":[765000118]},{"nodeId":765000112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1789721506,"text":"悪徳商人に騙されたりしてない？","nextNodeIds":[765000113]},{"nodeId":765000113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":808175554,"text":"安心しろ！詐欺られないように、すっごく頼もしい機械技師に見てもらったからな。写真家のルブランが使ってたもので間違いないぞ！","nextNodeIds":[765000114]},{"nodeId":765000114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1313263914,"text":"しかも、その機械技師が写真機を解体した時、内部に小さくルブランのイニシャルが彫ってあったんだ。動かぬ証拠だぜ！","nextNodeIds":[765000115]},{"nodeId":765000115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":367454786,"text":"ふふん！それに、オイラはおまえのガイドとして頼りになる存在だからな。やるときはやるんだ！","nextNodeIds":[765000116,765000117]},{"nodeId":765000104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1646422018,"text":"パイモン、骨董品でも売ろうとしてるの？","nextNodeIds":[765000105]},{"nodeId":765000105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1361113090,"text":"違うぞ！これはおまえのために用意したサプライズプレゼントだ！","nextNodeIds":[765000106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","B