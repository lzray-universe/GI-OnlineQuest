E_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":1204,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7611501],"talks":[{"talkId":7611501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7611501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7611501,"initDialog":761150101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1316,1317],"performCfg":"QuestDialogue/WQ/NodKrai_76115/Q7611501","priority":5,"questId":76115,"showRandomTalkCount":0},"dialogs":[{"nodeId":761150101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2855799506,"text":"あれ？ネフェル、ヤフォダ！なんでこんなとこにいるんだ？","nextNodeIds":[761150102]},{"nodeId":761150102,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2861459562,"text":"仕事にきまってるだろ。これまでなかなか手がかりが掴めなかった賞金首を、ついに見つけたんだ。","nextNodeIds":[761150103]},{"nodeId":761150103,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3148886034,"text":"ヤフォダから、賞金首である「裂けアゴ」のハルクのことと、これまでに「秘聞の館」が突き止めた情報について教えてもらった…","nextNodeIds":[761150104]},{"nodeId":761150104,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4190496194,"text":"結論から言おう。本物の隠者ドーヴェントはほぼ間違いなく殺されてる。そして、今隠者の小屋を占拠してるのは賞金首の「裂けアゴ」のハルクだ。","nextNodeIds":[761150105]},{"nodeId":761150105,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2437288754,"text":"ヤフォダが見つけた日誌の断片も、ドーヴェントがすべての事情を知った上でハルクを引き取ったことを証明してる。","nextNodeIds":[761150106]},{"nodeId":761150106,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1390871274,"text":"驚くことでもない…ハルクはまた昔の悪癖が出ちまったのさ。ドーヴェントを始末して、彼の身分を盗んだんだ。","nextNodeIds":[761150107]},{"nodeId":761150107,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2598145018,"text":"調査した時、顔を合わせたわけじゃないけど…小屋の中にいるあいつがドーヴェントさんなわけないよ。","nextNodeIds":[761150108]},{"nodeId":761150108,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2598324010,"text":"隠者を名乗ってれば、いくらおかしなことをしてても疑われないしね。あのマスクは修行のためなんかじゃない。きっと顎の傷痕を隠すためのものだ。","nextNodeIds":[761150109]},{"nodeId":761150109,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2984887330,"text":"行方不明の行商人のほうだけど、やっぱり、最悪殺されてるかもしれないね…","nextNodeIds":[761150110]},{"nodeId":761150110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3720400010,"text":"こんな悪事を働いておいて、そのうえさらに恩を仇で返すなんて、いったいどんな悪党だよ…","nextNodeIds":[761150111]},{"nodeId":761150111,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1383208610,"text":"あたしの推測では、「流浪の輪」の商品窃盗事件はハルクとは無関係だ。犯行の動機が薄すぎるからね。","nextNodeIds":[761150112]},{"nodeId":761150112,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3626950746,"text":"十年間、やつは法を犯していなかった。盗んだ商品に、やつが苦労して築き上げたすべてを捨てるほどの価値があったと思うかい？あたしはそう思わない。","nextNodeIds":[761150113]},{"nodeId":761150113,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1982582002,"text":"なら、少し仮説を立ててみようじゃないか。","nextNodeIds":[761150114]},{"nodeId":761150114,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1179914770,"text":"知ってのとおり、事件後、やつはアトラス号の残骸付近に戻って、宝探しに来たトレジャーハンターを襲った。人が窮地に陥ると元いた場所に戻ろうとするのは、一種の本能だ。","nextNodeIds":[761150115]},{"nodeId":761150115,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2181046898,"text":"やつがまだアトラス号で舵手を務めていたときは、名声も富もそこまで値打ちがなかった。でもね、「流浪の輪」に加わった後はどうだい？","nextNodeIds":[761150116]},{"nodeId":761150116,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2900314842,"text":"十年ものあいだ法を犯していなかったにもかかわらず、窃盗事件がひとたび起きれば、人々は依然として疑いの目と言葉を投げかけてくる——","nextNodeIds":[761150117]},{"nodeId":761150117,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1968151034,"text":"それ以上に耐え難かったのは、出自が同じなのに、単なる無名の男だったジュヤニが上手くやっていることだったのかもしれない…","nextNodeIds":[761150118]},{"nodeId":761150118,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1983312306,"text":"ジュヤニこそが犯人だって糾弾は、誰の心にも届かなかった…","nextNodeIds":[761150119]},{"nodeId":761150119,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4276193506,"text":"そうしてやつは失意と怒りの中で、一つ目の過ちを犯した。あの事件は、やつの人生のターニングポイントだったんだろう。","nextNodeIds":[761150120]},{"nodeId":761150120,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3251063978,"text":"隠者の小屋で起きた事も、似たようなきっかけがあったんだと思うよ…ほんの些細な食い違いが、致命的な衝突を引き起こすことはある。","nextNodeIds":[761150121]},{"nodeId":761150121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":224161642,"text":"#{NICKNAME}、こんな危険なやつを野放しにするわけにはいかないよな？","nextNodeIds":[761150122,761150123]},{"nodeId":761150122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2146757490,"text":"#{M#俺}{F#私}に任せて。","nextNodeIds":[761150124]},{"nodeId":761150124,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4052686546,"text":"#{NICKNAME}が願い出てくれたことだし、ヤフォダには休んでもらおうかね。","nextNodeIds":[761150125]},{"nodeId":761150125,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":430656994,"text":"あたいもけっこう頑張ったからな！遠慮なく休ませてもらうよ。","nextNodeIds":[761150126]},{"nodeId":761150126,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4191802194,"text":"さて、ここまでの仮説が正しいかどうかは、やつに会えば分かることだろう。","nextNodeIds":[]},{"nodeId":761150123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":773642042,"text":"賞金のため？どっちにしてもやるけど。","nextNodeIds":[761150124]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":1204,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7611502,"order":2,"stepDescription":"隠者の小屋へ向かう","stepDescTextMapHash":2236330188,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHP