am":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267205,"initDialog":726720501,"nextRandomTalks":[],"nextTalks":[],"npcId":[3041],"performCfg":"","priority":5,"questId":72672,"showRandomTalkCount":0},"dialogs":[{"nodeId":726720501,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":3608100410,"text":"若紫に会った？","nextNodeIds":[726720502]},{"nodeId":726720502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2543175994,"text":"「四方八方の網」について…","nextNodeIds":[726720503]},{"nodeId":726720503,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":1670350770,"text":"「四方八方の網」…いい響きね。でも、あの術は…","nextNodeIds":[726720504]},{"nodeId":726720504,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2985834610,"text":"本当に人の外形を捉えられるの？","nextNodeIds":[726720505]},{"nodeId":726720505,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":4213260122,"text":"それは…不可能よ。","nextNodeIds":[726720506]},{"nodeId":726720506,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":966252138,"text":"そのような陰陽術はただ記載されているだけで、具体的な使い方はとっくに失われているの。","nextNodeIds":[726720507]},{"nodeId":726720507,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":3007501722,"text":"若紫にあげた術は、動物の外形しか捉えられない。","nextNodeIds":[726720508]},{"nodeId":726720508,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":699005306,"text":"どうして若紫に教えなかったの…","nextNodeIds":[726720509]},{"nodeId":726720509,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":1750140330,"text":"私はただ、若紫にあるメッセージを世間に届けてもらいたいだけなの。","nextNodeIds":[726720510]},{"nodeId":726720510,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":72863002,"text":"「万端珊瑚探偵所の所長は、惟神陰陽術を参考に、人に真実を語らせる網の研究を誰かに頼んでいる」","nextNodeIds":[726720511]},{"nodeId":726720511,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":3551646426,"text":"失われた惟神陰陽術、万端珊瑚探偵所、それと動物の外形を確実に捉える網。","nextNodeIds":[726720512]},{"nodeId":726720512,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":2757489202,"text":"これらの要素が合わされば、現実味を帯びている凄そうな「巷の伝説」になるわ。","nextNodeIds":[726720513]},{"nodeId":726720513,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":3082084586,"text":"普通の人にとっては、単なる「巷の伝説」という面白い話に過ぎない。けれど、何か企んでる犯人にとっては、そう簡単に忘れられる話ではないでしょ。","nextNodeIds":[726720514]},{"nodeId":726720514,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2520868834,"text":"なるほど…","nextNodeIds":[726720515]},{"nodeId":726720515,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":3983803042,"text":"それと、もう一つの理由は…若紫が「最強の陰陽術式」をくれってしつこく言ってきたから。","nextNodeIds":[726720516]},{"nodeId":726720516,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":1488672930,"text":"そんなものはないって言ったけど、全然信じてくれなかったわ。仕方なく、この陰陽術で彼女をごまかしたの。","nextNodeIds":[726720517]},{"nodeId":726720517,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3939054610,"text":"若紫が誰にも言わなかったらどうする？","nextNodeIds":[726720518]},{"nodeId":726720518,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":3953243786,"text":"それはない。若紫が秘密を守ったことは一度もないからね。若紫のことならもう知り尽くしてるわよ…","nextNodeIds":[726720519]},{"nodeId":726720519,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":1275087946,"text":"とにかく、協力してくれてありがとう。これは礼として受け取って。","nextNodeIds":[726720520]},{"nodeId":726720520,"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","textMapHash":1074806002,"text":"もう若紫が新しい陰陽術式を聞いて来ないといいんだけど…私は探偵であって陰陽師じゃないんだから…","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267205,0],"PAINLIBBLD