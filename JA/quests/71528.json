rName":"煙緋","textMapHash":1690131146,"text":"ばあやが「荒瀧煌々虫相撲大修行」の経緯を聞いて、「グゥオパァーが弟子を取るかもしれない」ことをとても面白がっていた…","nextNodeIds":[716666012]},{"nodeId":716666012,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":2285872594,"text":"ばあやの友人にたまたま、花壇の霓裳花を手入れする園芸装置をたくさん作ってくれた人がいるんだ。その装置の名は「花羽葉月神機」。","nextNodeIds":[716666013]},{"nodeId":716666013,"roleType":"TALK_ROLE_NPC","speakerId":30469,"speakerName":"「超弩級強者の神級随行料理人」","textMapHash":3933131370,"text":"「花羽葉月神機」は色々な動物に姿を変えて、その環境に自然に溶け込むことができるんだ。リス、蝶、ヤマガラ、もちろんオニカブトムシもね。","nextNodeIds":[716666014]},{"nodeId":716666014,"roleType":"TALK_ROLE_NPC","speakerId":30469,"speakerName":"「超弩級強者の神級随行料理人」","textMapHash":3612125570,"text":"だから師匠がグゥオパァーに「花羽葉月神機」を一つくれて、装置がオニカブトムシに擬態して戦うことになったの。","nextNodeIds":[716666015]},{"nodeId":716666015,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":344853634,"text":"本当にただの園芸装置なのか？","nextNodeIds":[716666016]},{"nodeId":716666016,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2496317378,"text":"香菱の師匠はピンばあや…ピンばあやの友達…ピンばあやの友達！","nextNodeIds":[716666017,716666018]},{"nodeId":716666017,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3313299690,"text":"誰だっけ？","nextNodeIds":[716666019]},{"nodeId":716666019,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1453464298,"text":"装置がオニカブトムシに擬態できるわけがねぇだろ！まさか、グゥオパァー兄貴は俺らの実力を試そうと、わざと弱いやつを使って戦ったのか？","nextNodeIds":[716666020]},{"nodeId":716666020,"roleType":"TALK_ROLE_NPC","speakerId":30468,"speakerName":"「花角玉将」","textMapHash":42835042,"text":"やはり気をつけたほうが良いよ、鬼王。俺はあのメカオニカブトムシから殺気を感じ取れない…あるいは、深くて底が知れないみたいだ。","nextNodeIds":[716666021]},{"nodeId":716666021,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":2811851674,"text":"装置は生きてねぇから、殺気を感じられないのは当然だ。","nextNodeIds":[716666022]},{"nodeId":716666022,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":653356290,"text":"コホンッ、確かにグゥオパァー兄貴はすごく強ぇけどよ、強者にも自分に合った武器や仲間が必要だ。俺様と「赤紅一杵」のコンビは簡単にはいかないぜ！","nextNodeIds":[716666023]},{"nodeId":716666023,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":4206847762,"text":"さあ、戦いを始めるぞ！一つ一つの攻撃で、グゥオパァー兄貴に俺らの実力を証明してやる！","nextNodeIds":[716666024]},{"nodeId":716666024,"roleType":"TALK_ROLE_NPC","speakerId":30470,"speakerName":"「天地鳴動·超弩級強者」","textMapHash":2402237930,"text":"——♪","nextNodeIds":[]},{"nodeId":716666018,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1911752594,"text":"ネタバレしないで…","nextNodeIds":[716666019]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166660,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30470"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7152802,"order":2,"stepDescription":"「天地鳴動·超弩級強者」と戦う","stepDescTextMapHash":3461095476,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152803,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30470"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166662],"talks":[{"talkId":7166662,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],