ype":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4005403,"initDialog":400540301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1034],"performCfg":"QuestDialogue/EQ/RongCaiJi_40054/Q4005403","priority":5,"questId":40054,"showRandomTalkCount":0},"dialogs":[{"nodeId":400540301,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":4268631170,"text":"容彩祭が開かれる間、遠国監察一帯は娯楽小説の主な展示会場となる予定じゃ。","nextNodeIds":[400540302]},{"nodeId":400540302,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":434713242,"text":"多数の商業作品や同人作品が頒布されるだけでなく、限定特典や抽選会、新刊即売会といったイベントも豊富に行われる予定じゃ。","nextNodeIds":[400540303]},{"nodeId":400540303,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":3176260042,"text":"万国商会の前にあるこの小さな広場は祭りの期間中「五歌仙広場」と呼ばれる。近くの店舗には、娯楽小説に関連した特別商品も売り出されるゆえ、決して見逃すでないぞ。","nextNodeIds":[400540304]},{"nodeId":400540304,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":982343738,"text":"わぁ…なんて言うか、随分と変わった祭りって言うか、違った次元のすごさを感じるぜ…","nextNodeIds":[400540305]},{"nodeId":400540305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1410339778,"text":"娯楽小説みが強いね。","nextNodeIds":[400540306]},{"nodeId":400540306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3584716570,"text":"あれ？神子、広場の中心にある真っ白い板は、なにをするためのものなんだ？","nextNodeIds":[400540307]},{"nodeId":400540307,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":249714970,"text":"うむ、それは…","nextNodeIds":[400540308]},{"nodeId":400540308,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":1310376042,"text":"八重様から頼りになる助っ人が来てくださると伺っていましたが、やはり貴方がたでしたか。","nextNodeIds":[400540309]},{"nodeId":400540309,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":1542535570,"text":"旅人さん、パイモンさん、お久しぶりですね。元気にしていましたか？","nextNodeIds":[400540310]},{"nodeId":400540310,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2764354826,"text":"綾人！今回の容彩祭には、綾人も直々に出るのか。でも、おまえってすごく忙しいんじゃないのか？","nextNodeIds":[400540311]},{"nodeId":400540311,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":826495394,"text":"祭りの準備は社奉行の義務なのです。それに八重様ご自身が、容彩祭のために心血を注いでいらっしゃるのですから、私が出向かない訳にもいかないでしょう。","nextNodeIds":[400540312]},{"nodeId":400540312,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":908683370,"text":"ふふっ、綾人、妾たちの仲じゃ。そんなに畏まるでない。","nextNodeIds":[400540313]},{"nodeId":400540313,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":780804690,"text":"今ちょうど、ここの展示板について話しておったところじゃ。これは童たちの任務とも関係がある。汝が詳しく説明してやれ。","nextNodeIds":[400540314]},{"nodeId":400540314,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":468671858,"text":"すでにお二方は、容彩祭が五歌仙の伝説に基づいたものであるとお聞きになったことでしょう。この五つの展示板は、彼らの姿を描くためのものなのです。","nextNodeIds":[400540315]},{"nodeId":400540315,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":4097888466,"text":"この容彩祭は、稲妻の鎖国令が解除されて以来、初の大型祭典となります。それだけでなく、文化や芸術に関連した祭りでもある。","nextNodeIds":[400540316]},{"nodeId":400540316,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":1187697906,"text":"ですから社奉行では他国の文化人を何名か稲妻にご招待しました。","nextNodeIds":[400540317]},{"nodeId":400540317,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":682256946,"text":"例えば、こちらの肖像画については、遥々モンドから画家をお招きして描いていただく予定です。","nextNodeIds":[400540318]},{"nodeId":400540318,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":969949186,"text":"客人方の稲妻における食事や宿泊の手配は、我々社奉行がお手伝いします。しかし異郷の地では、どうしても慣れないことがあるかもしれません。","nextNodeIds":[400540319]},{"nodeId":400540319,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":1661642178,"text":"そんな時、稲妻に詳しく、テイワットの他国にも通じる方に案内をお願いできれば、こちらとしても大助かりなのですが…","nextNodeIds":[400540320,400540321]},{"nodeId":400540320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3141664002,"text":"分かった。","nextNodeIds":[400540322]},{"nodeId":400540322,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":1856404770,"text":"はい。お二方には港口から客人を万国商会まで招いていただき、彼らの希望に沿った手助けをして差し上げてほしいのです。","nextNodeIds":[400540323]},{"nodeId":400540323,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":3995899458,"text":"客人方の乗る船の詳しい情報については、この「到着時刻表」に記載されています。ここに載っている時間通りに波止場へ向かってください。","nextNodeIds":[400540324]},{"nodeId":400540324,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":455615626,"text":"さて、もうこんな時間じゃ。妾は編集たちとの会議があるゆえ、先に行かせてもらうぞ。","nextNodeIds":[400540325]},{"nodeId":400540325,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":4132222618,"text":"祭り期間中、八重堂の編集はほとんどが遠国監察の近くにおる。何か用事があれば、直接訪ねるがよい。","nextNodeIds":[400540326]},{"nodeId":400540326,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":739612618,"text":"今回の祭りは三奉行協同でことに当たっており、対処しなければならない事が山積みなのです。ですので私もこれで失礼いたします。客人のこと、どうかよろしくお願いします。","nextNodeIds":[]},{"nodeId":400540321,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1756656546,"text":"#これが{M#俺}{F#私}たちの任務だね。","nextNodeIds":[400540322]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAO