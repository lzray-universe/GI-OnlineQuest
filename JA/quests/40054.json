{"mainQuestId":40054,"title":"菫庭の風雅な盛会","description":"","titleTextMapHash":1682196567,"descTextMapHash":0,"mainQuestExcel":{"mainQuestId":40054,"titleTextMapHash":1682196567,"title":"菫庭の風雅な盛会","descTextMapHash":4190636494,"description":"","chapterId":10065,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":2012,"luaPath":"Actor/Quest/EQ40054","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":2012,"chapterId":10065,"descTextMapHash":4190636494,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":40054,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":4098668089,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/EQ40054","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[140054],"series":10065,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[40055],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":1682196567,"type":"EQ","unlockDescTextMapHash":1198574894}},"flow":[{"subQuestId":4005401,"order":1,"stepDescription":"稲妻のキャサリンと会話する","stepDescTextMapHash":1334905012,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4005401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3004"],"NOCCOBOFKHP":3,"OFE