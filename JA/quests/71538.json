:false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7153802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7153801,"initDialog":715380101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30684],"performCfg":"QuestDialogue/WQ/Liyue_71538/Q7153801","priority":5,"questId":71538,"showRandomTalkCount":0},"dialogs":[{"nodeId":715380101,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":2585856282,"text":"旅人、海灯祭を祝して。","nextNodeIds":[715380102,715380103]},{"nodeId":715380102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3670321266,"text":"えっと…なにか事件でも起きたの？","nextNodeIds":[715380104]},{"nodeId":715380104,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":863308642,"text":"無理やり休暇を与えられた。","nextNodeIds":[715380105]},{"nodeId":715380105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3396967202,"text":"無理やり…？","nextNodeIds":[715380106]},{"nodeId":715380106,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":4130619962,"text":"執律庭の規定によれば、年度の終わりまでには全員が休暇を全て消費しなければならない。","nextNodeIds":[715380107]},{"nodeId":715380107,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":4289297186,"text":"でも、今年度の休暇日集計後、私が一日も休暇を取っていないことに気づかれた。それで…","nextNodeIds":[715380108,715380109]},{"nodeId":715380108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3852518490,"text":"特巡隊って大変なんだね…","nextNodeIds":[715380110]},{"nodeId":715380110,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":1461225218,"text":"いや、特巡隊には交代休暇制度がある。だが私は特巡隊の隊長として、常駐しなければならない。","nextNodeIds":[715380111]},{"nodeId":715380111,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":3094451274,"text":"それに、対応すべき緊急事態もあり、いつの間にか…休暇のことを忘れていた。","nextNodeIds":[715380112]},{"nodeId":715380112,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":2082873690,"text":"もともと休暇など、私にとってはどうでもいいことだ。いっそ休みなどなくていいと言ったら、急に全員が騒ぎ出して…","nextNodeIds":[715380113]},{"nodeId":715380113,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":864837250,"text":"これはハッキリ明文化された規則なのだから、特巡隊が規則を破るわけにはいかないなどと言って、絶対休みを取るよう言われたのだ。","nextNodeIds":[715380114]},{"nodeId":715380114,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":2422195122,"text":"特巡隊によく来る共律官までが横やりを入れてきて、船のチケットまで取られてしまった。璃月はちょうど海灯祭の時期だから、休暇を過ごすならここがいいと…","nextNodeIds":[715380115]},{"nodeId":715380115,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":2690203466,"text":"とはいえ、璃月は確かにいい場所だ。翹英荘から帰ってきたばかりだが、あそこの茶葉で作ったお菓子はどれも美味しかった。","nextNodeIds":[715380116]},{"nodeId":715380116,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":2369996370,"text":"お菓子を大量に買ったから、うちの者たちにも食べてもらいたい。璃月の風習に従って、祝灯状も贈り物に添えたいのだが——","nextNodeIds":[715380117]},{"nodeId":715380117,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":1040665226,"text":"こういうのは得意ではなくてな。どうやってもおかしな感じになってしまう。","nextNodeIds":[715380118]},{"nodeId":715380118,"roleType":"TALK_ROLE_NPC","speakerId":30684,"speakerName":"シュヴルーズ","textMapHash":1476085506,"text":"旅人はどう作ればいいか、分かるか？","nextNodeIds":[715380119]},{"nodeId":715380119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3392307066,"text":"アドバイスしてあげる…","nextNodeIds":[]},{"nodeId":715380109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3793214690,"text":"特巡隊の人ってみんなそんな感じなの？","nextNodeIds":[715380110]},{"nodeId":715380103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":117330218,"text":"仕事しにきたように見えないけど…？","nextNodeIds":[715380104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30684"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7153803,"order":3,"stepDescription":"シュヴルーズと一緒に祝灯状を完成させる","stepDescTextMapHash":1978173084,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2036,71538],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["30684"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_N