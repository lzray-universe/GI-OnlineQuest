D_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468401,"initDialog":746840101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30551],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_74684/Q7468401","priority":5,"questId":74684,"showRandomTalkCount":0},"dialogs":[{"nodeId":746840101,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":365293138,"text":"二人とも、こないだは本当にお疲れ様。最初の目的とは多少ズレてしまったが、色々と収穫のある良い旅だったよ。","nextNodeIds":[746840102,746840103]},{"nodeId":746840102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3676989402,"text":"爽快な戦いができた。","nextNodeIds":[746840104]},{"nodeId":746840104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3824691002,"text":"「色々と収穫」っていうより、むしろ教訓になったんじゃないか？","nextNodeIds":[746840105]},{"nodeId":746840105,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":662568506,"text":"そうかもね。絆を結ぶなんてこと、すぐにできるようなものじゃない。それに今回のように色んな相手に挑むんじゃなく、どれか一つに絞って、そいつに集中すべきだった。","nextNodeIds":[746840106]},{"nodeId":746840106,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":1995703626,"text":"ナタだって、そういう過程を経てるしね。古龍の国から今のように人と竜が互いに信じ合い、仲間になって共に暮らす状態になるまで、どれだけ長い時間を要したか…","nextNodeIds":[746840107]},{"nodeId":746840107,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":1484816202,"text":"はぁ、このせっかちな性格がいけなかったというわけか。魔物なら、自分を負かした相手に多少なりとも敬意を持つと思って、今回のようなやり方を選んだんだけど。","nextNodeIds":[746840108]},{"nodeId":746840108,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":82726250,"text":"最初からコツコツと時間をかけて——例えば毎日エサをやって、少しずつ近づいていけば、成功率をもっと上げられたかもしれない。","nextNodeIds":[746840109]},{"nodeId":746840109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1216260658,"text":"まぁ確かに、理屈的にはそうかもしれないな。でも、そもそもおまえが選んだ相手たちは、そこら辺の猫とか犬じゃないんだぞ。","nextNodeIds":[746840110]},{"nodeId":746840110,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":3690604594,"text":"そうだね。でもあの魔物たちは、私から見るとナタの竜に似たところがあった。だから、あいつらを選んだんだ。","nextNodeIds":[746840111]},{"nodeId":746840111,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":1510503874,"text":"だって、そうすればナタの友人たちに冒険譚を聞かせる時、私の成し遂げたことがいかにすごいか理解しやすいんじゃないかと思って。","nextNodeIds":[746840112]},{"nodeId":746840112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3051949082,"text":"あいつらのどこがナタの竜に似てるんだ？…う～ん、エンシェントヴィシャップは似てるかもしれないけど。","nextNodeIds":[746840113]},{"nodeId":746840113,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":1674272730,"text":"何を言ってる？他のやつらにも似てるところはあるだろ？色とか…","nextNodeIds":[746840114]},{"nodeId":746840114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":945414674,"text":"その理屈で行くなら、スライムもナタの竜に似てるって言えるだろ！","nextNodeIds":[746840115]},{"nodeId":746840115,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":264660338,"text":"ふむ、スライムは元素生物で、竜も元素生物だ…確かに一理ある。もしかしたら、スライムには竜になれる可能性が秘められてるのかもしれない…","nextNodeIds":[746840116]},{"nodeId":746840116,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":1708302906,"text":"ってことは、やはりスライムから絆を結ぶべきだったのか？","nextNodeIds":[746840117,746840119]},{"nodeId":746840117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2924614346,"text":"計画の規模が一気に縮んだ。","nextNodeIds":[746840118]},{"nodeId":746840118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1670353002,"text":"実現する難易度もだいぶ下がったな。","nextNodeIds":[746840121]},{"nodeId":746840121,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":2241645498,"text":"ははっ、とにかく何事も試してみないとね！","nextNodeIds":[746840122]},{"nodeId":746840122,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":2168599218,"text":"今回は二人のおかげで助かった。いつかまた会った時には、冒険の仲間ができていて、それから物語の「主人公」を名乗れるようにもなっていたいと思うよ。","nextNodeIds":[746840123]},{"nodeId":746840123,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":127370474,"text":"じゃ、君たちもどうか良い旅を！","nextNodeIds":[]},{"nodeId":746840119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1869284922,"text":"少なくともスライムのほうがリスクは低い。","nextNodeIds":[746840120]},{"nodeId":746840120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":736048562,"text":"あくまで比較してって話だろ？野外でスライムに囲まれただけで、手も足も出ない新米冒険者を散々見てきたじゃんか。","nextNodeIds":[746840121]},{"nodeId":746840103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1769031458,"text":"相手が強すぎた…","nextNodeIds":[746840104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30551"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":6},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4}],