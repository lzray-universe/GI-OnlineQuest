akerId":20341,"speakerName":"烏帽子","textMapHash":1899100418,"text":"夜になれば、天から降り落ちる三つの光の柱が見えるでしょう。その光の柱が指し示す場所こそ、天光の差し込む処です。","nextNodeIds":[722750410]},{"nodeId":722750410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2214485626,"text":"えっと、言ってることがよくわからないんだけど…","nextNodeIds":[722750411]},{"nodeId":722750411,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":2156024482,"text":"すみません、海祇大御神の筋書きではそのように書いてあるのです…このような複雑な示唆は、すでに伝統のようなものでして。","nextNodeIds":[722750412]},{"nodeId":722750412,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":3133721554,"text":"とにかく…試練の場にいる地走官はみな変わり者ばかり。扉を通って行かなければ、何をされるか分かりません。","nextNodeIds":[722750413]},{"nodeId":722750413,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":3332842154,"text":"あなたがすべての障害を乗り越え、承認を得て戻ってくることをここで願っています。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["16","1"],"PAINLIBBLDK":"QUEST_EXEC_CHANGE_MAP_AREA_STATE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["20341","11","2"],"NOCCOBOFKHP":5,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_SHOW_OR_HIDE_NPC"}}},{"subQuestId":7227502,"order":4,"stepDescription":"挑戦をクリアする","stepDescTextMapHash":1570389108,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7226807,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST