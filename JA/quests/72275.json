false,"talkIds":[7227502],"talks":[{"talkId":7227502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7227506","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7227502,"initDialog":722750201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20341],"performCfg":"","priority":5,"questId":72275,"showRandomTalkCount":0},"dialogs":[{"nodeId":722750201,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":2688283874,"text":"これであなたは、すべての地走官の承認を得ました。彼らは海祇の意志を代表しています。つまり、あなたはすべてを知る権利を得たということです。","nextNodeIds":[722750202]},{"nodeId":722750202,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":1402093674,"text":"あなたは海祇の民を救った救世主であり、海祇に認められたお方。あなたはすべてを知るべきでしょう。","nextNodeIds":[722750203]},{"nodeId":722750203,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":2407644906,"text":"ですが、これらの真相は決して外の者に漏らさないでください。","nextNodeIds":[722750204]},{"nodeId":722750204,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":2713528890,"text":"何か知りたいことはございますか？","nextNodeIds":[722750205,722750206,722750207,722750208,722750209]},{"nodeId":722750205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3614039186,"text":"アビサルヴィシャップについて…","nextNodeIds":[722750210]},{"nodeId":722750210,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":4144132338,"text":"アビサルヴィシャップは原初の元素生物です。長いこと深海で生息していたため、天が振りかざす力に支配されることはありませんでした。","nextNodeIds":[722750211]},{"nodeId":722750211,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":1940622514,"text":"アビサルヴィシャップはとても賢く、進化することに長けています。我々との戦いの歴史においても、他の元素に進化した品種が確認されています。","nextNodeIds":[722750212]},{"nodeId":722750212,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":612884154,"text":"もしもアビサルヴィシャップが言語を会得した場合、リザードマンに進化してもおかしくはありません。","nextNodeIds":[722750213]},{"nodeId":722750213,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":929019386,"text":"「聖土化」とは、アビサルヴィシャップの生息地の拡大を意味します。つまり、三界にある原初の元素力が強くなるということです。","nextNodeIds":[722750214]},{"nodeId":722750214,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":1527416474,"text":"我々にできるのは、海祇大御神の生命力でやつらの第二眷属を呼び覚まし、荒れ狂う元素力を変換させること、それだけです。","nextNodeIds":[722750204]},{"nodeId":722750206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3725404210,"text":"海祇大御神について…","nextNodeIds":[722750215]},{"nodeId":722750215,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":826127170,"text":"海祇大御神はその厄運から、「天の秩序」の管轄外であるこの場所に落ちました。","nextNodeIds":[722750216]},{"nodeId":722750216,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":1403955194,"text":"このことは、我々白夜国の民にとって間違いなく幸運でした。我々のために数々のことを成してくれたのですから。","nextNodeIds":[722750217]},{"nodeId":722750217,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":3139090794,"text":"しかし我々と接触したことにより、あの方は自身が誕生するよりも前の真相に触れてしまったのです。それにより天からの勅令を受け、自らを犠牲にすることを余儀なくされました。","nextNodeIds":[722750218]},{"nodeId":722750218,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":1033837434,"text":"その犠牲の真相を、誰にも知られてはなりませんでした…そうすることでしか、白夜の民は新たな「七の秩序」の下で生きることを許されなかったのです。","nextNodeIds":[722750204]},{"nodeId":722750207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2392151866,"text":"日月よりも前のことについて…","nextNodeIds":[722750219]},{"nodeId":722750219,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":890699938,"text":"白夜国が海淵へと落ちる前、統一された文明は確かに存在していました。","nextNodeIds":[722750220]},{"nodeId":722750220,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":636993162,"text":"そして大戦が起こることで、天は崩落し、地は裂開。この土地もその時、漆黒の海淵へと落ちたのです。","nextNodeIds":[722750221]},{"nodeId":722750221,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":4073834458,"text":"天の秩序は、このことを知る者が大地に残っていることを望みませんでした。我々も帰路を探そうと試みましたが、失敗に終わっています。","nextNodeIds":[722750222]},{"nodeId":722750222,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":3689325898,"text":"それから長い時を経て、ようやく天の禁令の力が弱まり、海祇大御神がここに落ちたのです。","nextNodeIds":[722750204]},{"nodeId":722750208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4267552946,"text":"大日御輿について…","nextNodeIds":[722750223]},{"nodeId":722750223,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":1937468786,"text":"大日御輿は賢者·アブラクサスが設計した建造物で、海淵に光をもたらす力があります。","nextNodeIds":[722750224]},{"nodeId":722750224,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":1825335338,"text":"それ以外にも、様々な機能を有しています。","nextNodeIds":[722750225]},{"nodeId":722750225,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":3723495618,"text":"あれは、実に優れたものです。","nextNodeIds":[722750204]},{"nodeId":722750209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1466376762,"text":"他に用はない。","nextNodeIds":[722750226]},{"nodeId":722750226,"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","textMapHash":386556218,"text":"はい。淵下宮で起こったことについては、永遠の秘密。どうか心の中にしまっておいてくださいね。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7227502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7219816","2"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_FINISH","LNHLPKELCAL":["20341","11","2"],"NOCCOBOFKHP":5,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_SHOW_OR_HIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7227501,7227502,7227503,7227504],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":20341,"speakerName":"烏帽子","count":50},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[172275],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":534744278,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"