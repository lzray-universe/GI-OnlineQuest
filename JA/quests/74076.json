"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3321023090,"text":"うーん、答えがだんだん抽象的になってきてるんだな。","nextNodeIds":[740760212]},{"nodeId":740760212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2264222786,"text":"キャタピラー、セイモア、この答えの謎が解けるか？","nextNodeIds":[]}]},{"talkId":7407603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7407602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7407205","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["7407205","0","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_A_AND_ETCOR","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7407603,"initDialog":740760301,"nextRandomTalks":[],"nextTalks":[7407604],"npcId":[21048,20995,5303],"performCfg":"QuestDialogue/WQ/Fontaine_74076/Q7407603","priority":5,"questId":74076,"showRandomTalkCount":0},"dialogs":[{"nodeId":740760301,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3214022746,"text":"あとはここだけですね。","nextNodeIds":[740760302]},{"nodeId":740760302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3851558250,"text":"今までの探索はぜんぶ収穫なしだったよな…","nextNodeIds":[740760303]},{"nodeId":740760303,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":4129328026,"text":"ええ。でも、ここの入り口は閉じていましたから、まだボクたちにもチャンスがあるってことですよ。","nextNodeIds":[740760304]},{"nodeId":740760304,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":2507401306,"text":"競争相手はまだここのなぞなぞを解いていないようですね。","nextNodeIds":[740760305]},{"nodeId":740760305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1969656642,"text":"でも、オイラたちの競争相手って誰なんだろうな？","nextNodeIds":[740760306]},{"nodeId":740760306,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":1825529338,"text":"たとえ数百年の歳月の中で水仙十字結社が復興できずに沈黙に陥っているとしても、ボクの持つあらゆる知識に意義があるとするなら…今までの状況とも照らし合わせれば——","nextNodeIds":[740760307]},{"nodeId":740760307,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":1164389954,"text":"おそらくジェイコブでしょう。","nextNodeIds":[740760308]},{"nodeId":740760308,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":899707506,"text":"セイモアをいじめた悪いやつ？そんなものを手に入れてどうするつもり…？","nextNodeIds":[740760309]},{"nodeId":740760309,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3039452514,"text":"彼の目的はおそらくボクたちと同じです。水仙十字聖剣を作る材料を探しているんでしょう。","nextNodeIds":[740760310]},{"nodeId":740760310,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3821878386,"text":"水仙十字結社は地下の国と古代フォンテーヌの神秘主義哲学によって、物質世界に必要な四種類の架空物質を再現しました。","nextNodeIds":[740760311]},{"nodeId":740760311,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":1985950666,"text":"理解できません。","nextNodeIds":[740760312]},{"nodeId":740760312,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":1824865970,"text":"神秘的なものはそもそも、体験によってのみ作用するんです。元素力以上に、普通の枠にはまらないものだとも言えます。","nextNodeIds":[740760313]},{"nodeId":740760313,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":2879906418,"text":"数十年前、私は教令院素論派の入門から中級教材を記録しましたが、元素力はさほど神秘的なものではありませんでした。","nextNodeIds":[740760314]},{"nodeId":740760314,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3467295834,"text":"そうですか。とにかく結論から言えば、フォンテーヌに伝わる古来からの手法と地下の古国の技術の結晶というわけです。","nextNodeIds":[740760315]},{"nodeId":740760315,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":2636319194,"text":"そうして世界には「記憶」、「願い」、「霊魂」、「人格」という四種の物{RUBY#[D]サブスタンス}質が現れました。","nextNodeIds":[740760316]},{"nodeId":740760316,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":1398460730,"text":"複数の解釈を避けるため、「記憶」「願い」「霊魂」「人格」にそれぞれピースを分けて考えましょう。","nextNodeIds":[740760317]},{"nodeId":740760317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2831148186,"text":"どうしてそんなもので聖剣を作るんだ？","nextNodeIds":[740760318]},{"nodeId":740760318,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":2420630050,"text":"水仙十字結社の神秘主義哲学では、神殿は宇宙の縮図であり、メンバーは神々の代行者であり、聖油は鍛え抜かれた意志ですからね。","nextNodeIds":[740760319]},{"nodeId":740760319,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":2156806002,"text":"そして聖剣はすべてを切り開く「理性」です。これは完璧なる人の意志から生まれる必要があります。","nextNodeIds":[740760320]},{"nodeId":740760320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1636562434,"text":"うさんくさいな。","nextNodeIds":[740760321]},{"nodeId":740760321,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3327856962,"text":"まあまあ、神秘主義哲学とはこういうものですよ。類似性のあるものは何でも取り入れて、それが魔法になった暁には、すべての偽りが真実に変わるんです。","nextNodeIds":[740760322]},{"nodeId":740760322,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3023294634,"text":"とにかく、ボクたちの競争相手はなぞなぞを解いていません。または、解けたものの、「解答」はできなかったということなのでしょう。ジェイコブが相手なら、後者だと思います。","nextNodeIds":[740760323]},{"nodeId":740760323,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":1651326994,"text":"ここの碑文に書いてあります。「絶対に離れることはなく」…「一瞬で生まれ、何時も相いれず、永遠の眠りにもつきそう」…","nextNodeIds":[740760324]},{"nodeId":740760324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1670706810,"text":"最後の一句は——「原初の一滴」だってさ。","nextNodeIds":[740760325]},{"nodeId":740760325,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":1731865866,"text":"今までの数箇所にもこういうなぞなぞがあったはずですよ。答えは覚えてますか？","nextNodeIds":[740760326]},{"nodeId":740760326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3232480722,"text":"「影」。","nextNodeIds":[740760327]},{"nodeId":740760327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":525053114,"text":"「命」。","nextNodeIds":[740760328]},{"nodeId":740760328,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3319867338,"text":"「愛」。","nextNodeIds":[740760329]},{"nodeId":740760329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":43253290,"text":"うーん、答えがだんだん抽象的になってきてるんだな。","nextNodeIds":[740760330]},{"nodeId":740760330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3234469210,"text":"キャタピラー、セイモア、この答えの謎が解けるか？","nextNodeIds":[]}]},{"talkId":7407604,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7407602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7407604,"initDialog":740760401,"nextRandomTalks":[],"nextTalks":[],"npcId":[21048,5303,20995],"performCfg":"QuestDialogue/WQ/Fontaine_74076/Q7407604","priority":4,"questId":74076,"showRandomTalkCount":0},"dialogs":[{"nodeId":740760401,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3433052434,"text":"ボク、「原初の一滴」っていう言葉で一つ思いつきました…","nextNodeIds":[740760402]},{"nodeId":740760402,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":2524391082,"text":"世界創造後の最初の雨に似ていると思ったんです。古代フォンテーヌも水仙十字結社も好みそうなアイデアですよ。","nextNodeIds":[740760403]},{"nodeId":740760403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2940315754,"text":"そんなの見つかるわけないじゃないか！","nextNodeIds":[740760404]},{"nodeId":740760404,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":4112468066,"text":"いえ、その雨のしずくは水の中に溶けてしまった…つまり、水の雫はどれも最初の一滴なんです。","nextNodeIds":[740760405]},{"nodeId":740760405,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3916244370,"text":"原始の神が大きな可能性をばらまいたお陰で、ボクたち一人ひとりの体内に神聖な成分があるように。","nextNodeIds":[740760406]},{"nodeId":740760406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2288107754,"text":"でもそんなにシンプルな答えだったら、先に来てた例のあいつだって、簡単に解答できたんじゃないのか？","nextNodeIds":[740760407]},{"nodeId":740760407,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":1091639770,"text":"確かに。なら、きっと違うんでしょう。","nextNodeIds":[740760408]},{"nodeId":740760408,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3472297386,"text":"でもまあ、正しい答えでなかったとしても、いい答えですね。なぞなぞの出題者はロマンを解してくれないとは思いますけど。","nextNodeIds":[740760409]},{"nodeId":740760409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1201927274,"text":"ロマンティックだから通してくれるなんて思ってたら、出題者に「セキュリティーのことを全然わかってない」って笑われるぞ！","nextNodeIds":[740760410]},{"nodeId":740760410,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":296898562,"text":"私は答えられません。「原初の一滴」の検索結果：1200件。","nextNodeIds":[740760411]},{"nodeId":740760411,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":3279152738,"text":"「伝説によればこの世界における原初の一滴とも言える酒は風神が…」","nextNodeIds":[740760412,740760414]},{"nodeId":740760412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2471631506,"text":"わかった、もういいよ。","nextNodeIds":[740760413]},{"nodeId":740760413,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":4117664234,"text":"かしこまりました。","nextNodeIds":[740760416]},{"nodeId":740760416,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":1803142162,"text":"このことなら…あたし、知ってるかも。","nextNodeIds":[740760417]},{"nodeId":740760417,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":2457486498,"text":"伝説によると、純水精霊は先代水神の最初の涙でね。","nextNodeIds":[740760418]},{"nodeId":740760418,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":3042601426,"text":"大地の最初の涙は、最初の純水精霊が人間を理解したときに流したものだったんだって。","nextNodeIds":[740760419]},{"nodeId":740760419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2238622218,"text":"世界最初の涙って言うと、一番初めに生まれた人間の赤ん坊が泣いたときに落としたものじゃないのか？","nextNodeIds":[740760420]},{"nodeId":740760420,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":1839297186,"text":"動物の涙は塩分を排出するためのものだからね。その平和な時代には、人間は生まれた時でさえ笑いながら息をしてたらしいよ。","nextNodeIds":[740760421]},{"nodeId":740760421,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":907743018,"text":"——そう、伝説ではそう言われてる。","nextNodeIds":[740760422]},{"nodeId":740760422,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":3051630402,"text":"赤子が泣くことと動物が排塩することはどちらもよく似た非感情的行為だと思います。","nextNodeIds":[740760423]},{"nodeId":740760423,"roleType":"TALK_ROLE_NPC","speakerId":5303,"speakerName":"セイモア","textMapHash":2651379314,"text":"赤子が泣くことには二つの理由があります。一つ目は外界からの刺激のため、二つ目は肺に素早く空気を入れるためです。スメールの生論派教材によれば…","nextNodeIds":[740760424]},{"nodeId":740760424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3267011858,"text":"じゃあ答えは、純水精霊？","nextNodeIds":[740760425]},{"nodeId":740760425,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3708867866,"text":"じゃあ前に来たやつは、正しく解答できなかったのかもな。","nextNodeIds":[740760426,740760428]},{"nodeId":740760426,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3541741682,"text":"最後の無駄あがきをしてみよう。","nextNodeIds":[740760427]},{"nodeId":740760427,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2414422090,"text":"望みのありそうな方向性だと思うぞ！","nextNodeIds":[740760430]},{"nodeId":740760430,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":877395194,"text":"ボクの水仙十字結社に対する理解から考えても、合理的だと思います。","nextNodeIds":[740760431]},{"nodeId":740760431,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":1306056762,"text":"どこかで夢を見ている「赤の女王」、心にもないことばかり言う「夢の中の存在」。","nextNodeIds":[740760432]},{"nodeId":740760432,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":184318114,"text":"おまえの言うことって、なぞなぞより難しいぞ。","nextNodeIds":[740760433]},{"nodeId":740760433,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":4101729170,"text":"いいじゃないですか、もう最後の瀬戸際なんですから。何はともあれ、最後には、なぞなぞの答えが明らかになりますよ。","nextNodeIds":[740760434]},{"nodeId":740760434,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3262565426,"text":"アン、じゃあお願い。","nextNodeIds":[740760435]},{"nodeId":740760435,"roleType":"TALK_ROLE_NPC","speakerId":20995,"speakerName":"アン","textMapHash":4180131298,"text":"うん、やってみるよ。万一あたしが失敗したら、すぐに他の答えを考えて。","nextNodeIds":[740760436]},{"nodeId":740760436,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2823526530,"text":"開いたぞ！","nextNodeIds":[740760437]},{"nodeId":740760437,"roleType":"TALK_ROLE_NPC","speakerId":21048,"speakerName":"キャタピラー","textMapHash":3719603970,"text":"絶対に最後のピースを手に入れないといけません。そうでないと、聖剣が水仙十字結社の手に渡ってしまいますから。","nextNodeIds":[]},{"nodeId":740760428,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":925046594,"text":"望みのありそうな方向性だと思う！","nextNodeIds":[740760429]},{"nodeId":740760429,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3693116194,"text":"風神の酒の話で無駄にあがくよりずっといいぜ！","nextNodeIds":[740760430]},{"nodeId":740760414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1788561786,"text":"よし、じゃあモンドに行って…","nextNodeIds":[740760415]},{"nodeId":740760415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":452031226,"text":"最後の悪あがきなら、もうちょっと望みのある方向にしろよ！","nextNodeIds":[740760416]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7407604,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3390402","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_MAP_LAYER_UNLOCK_STATE"},{"LNHLPKELCAL":["3","133404642,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":41010003,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":4101,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_5109:2407.476,313.980,3516.598]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7407603,"order":4,"stepDescription":"象限内のギミックを解く","stepDescTextMapHash":970609740,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7407603_FINISH"},{"BFGALAINLMD":0,"LNHLPKELCAL":[133404126,126015],"PAINLIBBLDK":"QUEST_CONTENT_GADGET_STATE_CHANGE","PPFLKMOMKAI":"201"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_5110:2374.555,328.808,3383.107]","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"7407603_FINI