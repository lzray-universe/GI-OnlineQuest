,{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4142201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4142201,"initDialog":414220101,"nextRandomTalks":[],"nextTalks":[],"npcId":[10367],"performCfg":"QuestDialogue/EQ/Water_41422/Q4142201","priority":5,"questId":41422,"showRandomTalkCount":0},"dialogs":[{"nodeId":414220101,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":1753316690,"text":"もうローデシアと話し合いをした。","nextNodeIds":[414220102]},{"nodeId":414220102,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":362685002,"text":"彼女は私たち純水精霊の中でも最も有名で、最も強い。でも彼女は先代の水神に思いを寄せ、フォンテーヌから逃げ出した。","nextNodeIds":[414220103]},{"nodeId":414220103,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":2243187402,"text":"私ももうフォンテーヌに帰れない。あなたたちに全部話す。","nextNodeIds":[414220104]},{"nodeId":414220104,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":3617848082,"text":"私たち純水精霊は大陸中の川や渓谷の水のなかに散らばってる。そのほとんどがフォンテーヌからのスパイ。","nextNodeIds":[414220105]},{"nodeId":414220105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1248711162,"text":"えっ！？水神はなにか企んでるのか？","nextNodeIds":[414220106]},{"nodeId":414220106,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":854378114,"text":"先代はなにも企んでなかった。ただ水を通して、大陸中のみんなを繋ごうとしただけ。でも彼女がなくなってから、多くの精霊はフォンテーヌとの繋がりを切った。","nextNodeIds":[414220107]},{"nodeId":414220107,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":4238571106,"text":"最強のローデシアでさえ、新たな水神を認めなかった。かつての夢を抱くしかなかった。ローデシアは、静かなる水が欲しいだけ。","nextNodeIds":[414220108]},{"nodeId":414220108,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":2786224266,"text":"でも彼女は私のことをフォンテーヌから来た刺客だと勘違いした。だから敵意を向け、川を苦くして、私を消滅しようとした。","nextNodeIds":[414220109]},{"nodeId":414220109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2640630370,"text":"でもおまえはまだ小さいから、そんなことする必要ないだろ？","nextNodeIds":[414220110]},{"nodeId":414220110,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":2406190242,"text":"純水精霊の意識は、悪意のある雑念と融合すると簡単に崩壊する。","nextNodeIds":[414220111]},{"nodeId":414220111,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":1614810530,"text":"私はローデシアを慕ってる。だから水スライムを通して、フォンテーヌから少しずつここにたどり着いた。","nextNodeIds":[414220112]},{"nodeId":414220112,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":2564346794,"text":"任務を執行する刺客を除けば、私みたいに執着する純水精霊は他にいない。","nextNodeIds":[414220113]},{"nodeId":414220113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":304712450,"text":"それは、とてもすごいな…","nextNodeIds":[414220114]},{"nodeId":414220114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2675321466,"text":"#でもオイラも、いつか{NICKNAME}と一緒に七国を全部旅するんだ。オイラと比べたら、まだまだだな。","nextNodeIds":[414220115]},{"nodeId":414220115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1971259986,"text":"オイ。","nextNodeIds":[414220116]},{"nodeId":414220116,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":59335570,"text":"もう話し合いをしたから、水の苦みはもうすぐ消える。最後に彼女から聞かれた。軽策の水に溶け込みたいかどうか。","nextNodeIds":[414220117]},{"nodeId":414220117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3523347602,"text":"だからオイラたちに別れを告げに来たのか？","nextNodeIds":[414220118]},{"nodeId":414220118,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":844825570,"text":"まだ話すことがある。一緒に清泉町にきて。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4142201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q41422_Search_Pos"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":4142202,"order":3,"stepDescription":"清泉町に行ってフィンチじいさんと会話する","stepDescTextMapHash":4288891796,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4142202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["165001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUID