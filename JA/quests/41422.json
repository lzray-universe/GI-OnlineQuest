showRandomTalkCount":0},"dialogs":[{"nodeId":414220401,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":1141095762,"text":"私たちの愛情表現は、お互いの水を融合させること。そうすれば、お互いの意識を繋げることができる。","nextNodeIds":[414220402]},{"nodeId":414220402,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":3621776978,"text":"でもこの世界の他の命は、そう簡単には理解できない。だから私たちはそれらを観察、研究、真似、変化してきた。今やそれらに変化した姿も、私たちの一部となっている。","nextNodeIds":[414220403]},{"nodeId":414220403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4164921114,"text":"エンドラーが小川を眺めながら、難しい話をしてるぞ。","nextNodeIds":[414220404]},{"nodeId":414220404,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":311596130,"text":"昔の私は、これからの命をどう過ごすか考えたことがなかった。ローデシアと一つになればいいと思ってた。","nextNodeIds":[414220405]},{"nodeId":414220405,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":3188318906,"text":"でもローデシアはまったく嬉しそうに見えなかった。彼女も分かってる、自分は只々水が腐敗するのを待っているだけだと。","nextNodeIds":[414220406,414220407]},{"nodeId":414220406,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":757954018,"text":"じゃあエンドラーは？","nextNodeIds":[414220408]},{"nodeId":414220408,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":5127450,"text":"ローデシアも清泉町の彼女も、私に彼女たちの道を歩ませたくないらしい。といっても、フォンテーヌでの生き方はもっと耐えられないだろう。","nextNodeIds":[414220409]},{"nodeId":414220409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3270994234,"text":"おまえたちの命は不思議だ。オイラもなにを言えばいいか分からない…でも、やっぱり楽しく生きる方がいいとオイラは思うぞ。","nextNodeIds":[414220410]},{"nodeId":414220410,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":3267858826,"text":"だから、私は先人たちが歩んだことのない道を選ぶ。あなたたちとの旅は楽しかった、これからも毎日楽しくいたい。","nextNodeIds":[414220411]},{"nodeId":414220411,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":3047144746,"text":"あなたたちと旅がしたい。生命の流れが海に着く前に見る花と雲を、果てのない空を、この目で確と見届けたい。","nextNodeIds":[414220412,414220413]},{"nodeId":414220412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1826637754,"text":"もちろん歓迎するよ。","nextNodeIds":[414220415]},{"nodeId":414220415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":513316562,"text":"#こうなると、{NICKNAME}と一緒に七国を旅することが、オイラの独占じゃなくなったな。","nextNodeIds":[]},{"nodeId":414220413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":412161402,"text":"パイモンと替えるか。","nextNodeIds":[414220414]},{"nodeId":414220414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1103132434,"text":"おい！","nextNodeIds":[414220415]},{"nodeId":414220407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4109259274,"text":"だから彼女を断ったの？","nextNodeIds":[414220408]}]},{"talkId":4142206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["4142204","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"