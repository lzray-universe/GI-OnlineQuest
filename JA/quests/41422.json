4220202]},{"nodeId":414220202,"roleType":"TALK_ROLE_NPC","speakerId":165001,"speakerName":"フィンチじいさん","textMapHash":2854101250,"text":"おっと、びっくりしたよ。","nextNodeIds":[414220203]},{"nodeId":414220203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":251344754,"text":"エンドラーの学習能力はすごいから、びっくりするのも無理はない。","nextNodeIds":[414220204]},{"nodeId":414220204,"roleType":"TALK_ROLE_NPC","speakerId":165001,"speakerName":"フィンチじいさん","textMapHash":910468298,"text":"いや、ただ…フィンチと呼んでくれるところが、彼女に似ててな…","nextNodeIds":[414220205]},{"nodeId":414220205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2190612130,"text":"あっ…","nextNodeIds":[414220206]},{"nodeId":414220206,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":1130126282,"text":"「毎日、ふらふらと前へ進む子供がいる。この世を見定め、自らの一部にする——」","nextNodeIds":[414220207]},{"nodeId":414220207,"roleType":"TALK_ROLE_NPC","speakerId":165001,"speakerName":"フィンチじいさん","textMapHash":1454865082,"text":"「子供は前へ進み、一生の時を過ごす。」","nextNodeIds":[414220208]},{"nodeId":414220208,"roleType":"TALK_ROLE_NPC","speakerId":165001,"speakerName":"フィンチじいさん","textMapHash":1154102282,"text":"その詩は知ってる。","nextNodeIds":[414220209]},{"nodeId":414220209,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":484138170,"text":"私たちとあなたたちの命には大きな違いがある。だから生きている内、互いに理解することはできないだろう。","nextNodeIds":[414220210]},{"nodeId":414220210,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":950263282,"text":"でも私たちの命は、同じものでもある。常に新しい物事や転機を受け入れて、海へと流れる。","nextNodeIds":[414220211]},{"nodeId":414220211,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":2971393722,"text":"彼女はこう言った——「夜空の星々がすべて消える時、すべての小川と夢は同じ海へと流れ込む。その時、我らは再会するだろう。」","nextNodeIds":[414220212]},{"nodeId":414220212,"roleType":"TALK_ROLE_NPC","speakerId":165001,"speakerName":"フィンチじいさん","textMapHash":1354665090,"text":"…あぁ。","nextNodeIds":[414220213]},{"nodeId":414220213,"roleType":"TALK_ROLE_NPC","speakerId":10367,"speakerName":"エンドラー","textMapHash":1821532338,"text":"生命の流れはまだ続く。あなたも立ち止まらず、前へ進んで。","nextNodeIds":[414220214]},{"nodeId":414220214,"roleType":"TALK_ROLE_NPC","speakerId":165001,"speakerName":"フィンチじいさん","textMapHash":1485450178,"text":"はははっ、彼女らしいな。まだ俺を子供だと思ってる言い方だ。","nextNodeIds":[414220215]},{"nodeId":414220215,"roleType":"TALK_ROLE_NPC","speakerId":165001,"speakerName":"フィンチじいさん","textMapHash":3641062418,"text":"少し、ひとりにさせてくれ。","nextNodeIds":[414220216]},{"nodeId":414220216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3846587082,"text":"#{NICKNAME}、コナーに伝えてこよう。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4142202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["165001"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":4142203,"order":4,"stepDescription":"アカツキワイナリーに行ってコナーに尋ねる","stepDescTextMapHash":2058117620,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4142203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["152901"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[4142203,4142205],"talks":[{"t