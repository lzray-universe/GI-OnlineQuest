,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7266304","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7266302,"initDialog":726630201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3200,1005],"performCfg":"QuestDialogue/WQ/Daoqi_72663/Q7266302","priority":5,"questId":72663,"showRandomTalkCount":0},"dialogs":[{"nodeId":726630201,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":814390578,"text":"ここよ。当時、父が最後に海に出た場所がここなの。今日と同じような夜でね、あの日以来、父には会えてない…","nextNodeIds":[726630202]},{"nodeId":726630202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3776552514,"text":"そっか、それは寂しいな…鯨井さんの願いはお父さんにもう一回会うことか？","nextNodeIds":[726630203]},{"nodeId":726630203,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":147213042,"text":"あははっ、確かに会いたいけど、海の民はいつの日か海に帰るの。","nextNodeIds":[726630204]},{"nodeId":726630204,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":1828568562,"text":"私の願いは、父を超える漁師になることよ。","nextNodeIds":[726630205]},{"nodeId":726630205,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":3430108074,"text":"小さい頃、父と一緒に海に出たいと思ってたの。でも父はいつも母に私を預けてた。時には近所の男の子を連れて行くこともあったのよ。それなのに、私を連れて行こうとはしなかった。","nextNodeIds":[726630206]},{"nodeId":726630206,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":3459029802,"text":"父はいつもね、こう言ってたの。「椛、海辺に来てないで、女の子らしいことをやりなさい。」「船の上ではしゃぐよりも、そのお金で袴でも買いなさい。」と…","nextNodeIds":[726630207]},{"nodeId":726630207,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":1788925626,"text":"私は悔しかった。なんで？女の子らしいことって何？","nextNodeIds":[726630208]},{"nodeId":726630208,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":2817105186,"text":"飴を買ったり、花を摘んだり、お姫様ごっこしたり？","nextNodeIds":[726630209]},{"nodeId":726630209,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":1897737386,"text":"じゃあなんで冒険に行ったり、海に出たりしちゃいけないの？","nextNodeIds":[726630210]},{"nodeId":726630210,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":1513559458,"text":"私はそんなのいや。だから父が離れてから、私は漁師の生業を始めた。","nextNodeIds":[726630211]},{"nodeId":726630211,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":121225514,"text":"父が探索できなかった海域は、私が探索する。父が捕まえられなかった大物は、私が捕まえる。","nextNodeIds":[726630212]},{"nodeId":726630212,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":4223995418,"text":"「鯨井」流の釣り技術は、私が継ぐ。「鯨井」家の漁師の名は、私が轟かせる。","nextNodeIds":[726630213]},{"nodeId":726630213,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":526251338,"text":"たとえ「海中月」がただの伝説だとしても、私は歩みを止めない。","nextNodeIds":[726630214]},{"nodeId":726630214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3837962834,"text":"うん、きっと成功するよ。","nextNodeIds":[726630215]},{"nodeId":726630215,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":2159589082,"text":"ありがとう。","nextNodeIds":[726630216]},{"nodeId":726630216,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":3631455722,"text":"伝説の魚がいないなら、願いを海に捨てるわ。きっと、父も見届けてくれる。","nextNodeIds":[726630217]},{"nodeId":726630217,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":517712746,"text":"君たちは、何か願いはある？一緒にやってみない？願いを書いて、漂流瓶に入れて力強く投げるの。きっといつの日か叶うわよ。","nextNodeIds":[726630218]},{"nodeId":726630218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3203827802,"text":"えっ——そういうのもあるのか？","nextNodeIds":[726630219]},{"nodeId":726630219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4216172634,"text":"でもオイラ、願いがいっぱいあるから…どれを書いたらいいか悩む！","nextNodeIds":[726630220]},{"nodeId":726630220,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":988451226,"text":"手助け本当にありがとう！感謝してもしきれないわね。これはほんのちょっとのお礼よ、受け取ってもらえると嬉しい…","nextNodeIds":[726630221]},{"nodeId":726630221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4235705682,"text":"わぁ——見ろよ、なんだあれ！","nextNodeIds":[726630222]},{"nodeId":726630222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2470561786,"text":"すごく大きな魚の群れだ！しかも光ってる。オイラたちの漂流瓶を気に入ったみたいだ！","nextNodeIds":[726630223]},{"nodeId":726630223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2332700378,"text":"みんな集まってると、なんか海の中に、でっかい月があるみたいだな！","nextNodeIds":[726630224]},{"nodeId":726630224,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":951427762,"text":"こ…これは、「月光魚」…","nextNodeIds":[726630225]},{"nodeId":726630225,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":591649682,"text":"あっ！分かった…分かったわ！なるほど、これが「海中月」だったのね！","nextNodeIds":[726630226]},{"nodeId":726630226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":719724826,"text":"えっ？これが「海中月」なのか？","nextNodeIds":[726630227]},{"nodeId":726630227,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":3683202354,"text":"そう、忘れもしない。このキラキラと輝く月光…あの時の「海中月」も、嘉瑋が漂流瓶を投げてから現れたの！","nextNodeIds":[726630228]},{"nodeId":726630228,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":340308098,"text":"道理でこんな長い月日、誰も「海中月」を捕まえられなかったのね！","nextNodeIds":[726630229]},{"nodeId":726630229,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":580257794,"text":"だってそれは、「月光魚」の群れだったから。","nextNodeIds":[726630230]},{"nodeId":726630230,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":130480850,"text":"でも意外ね、「月光魚」って…こんな漂流瓶が好きだったの？","nextNodeIds":[726630231]},{"nodeId":726630231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":832017474,"text":"えへへ、もしかしたら、人々が漂流瓶に託した願いが好きなのかもな。","nextNodeIds":[726630232]},{"nodeId":726630232,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":1316661682,"text":"あははっ！だったら、私、鯨井椛が全部釣り上げてみせるわ！","nextNodeIds":[726630233]},{"nodeId":726630233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2128839514,"text":"オイラも！オイラも！","nextNodeIds":[726630234]},{"nodeId":726630234,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":3479050298,"text":"それなら、私の釣り竿を君たちにあげるわ。これは鯨井家が「海中月」を捕まえるために作った特製の釣り竿よ。","nextNodeIds":[726630235]},{"nodeId":726630235,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":3804031386,"text":"感謝の気持ちを表すにはほど遠いけど、心からのお礼よ。","nextNodeIds":[726630236]},{"nodeId":726630236,"roleType":"TALK_ROLE_NPC","speakerId":3200,"speakerName":"鯨井椛","textMapHash":2039469530,"text":"それを使って、「月光魚」を全部釣り上げてちょうだい！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7266302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133213365","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["133212564","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["3","401"],"PAINLIBBLDK":"QUEST_EXEC_UNLOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH"