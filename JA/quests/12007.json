0311,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":268491970,"text":"……","nextNodeIds":[120070312]},{"nodeId":120070312,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2419589762,"text":"ふぅ。","nextNodeIds":[120070313]},{"nodeId":120070313,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1386821970,"text":"旅人さん、パイモンさん、大変お待たせしました。","nextNodeIds":[120070314]},{"nodeId":120070314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4129907178,"text":"全然待ってないぞ、読むのが早すぎる！","nextNodeIds":[120070315]},{"nodeId":120070315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3434114106,"text":"手記は読み終わったの？","nextNodeIds":[120070316]},{"nodeId":120070316,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3427851402,"text":"はい、すべて読み終えました。","nextNodeIds":[120070317]},{"nodeId":120070317,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":402490354,"text":"この手記に書かれた真実は、貴方がたにも共有すべきものだと思います。","nextNodeIds":[120070318]},{"nodeId":120070318,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2375541754,"text":"内容は、思っていたものとはまったく違っていましたが…","nextNodeIds":[120070319]},{"nodeId":120070319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1524612906,"text":"違う？狐神使の手記じゃなかったのか？","nextNodeIds":[120070320]},{"nodeId":120070320,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3825570826,"text":"狐神使ではございませんでした。","nextNodeIds":[120070321]},{"nodeId":120070321,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3653413818,"text":"「椿」さんの正体は…","nextNodeIds":[120070322]},{"nodeId":120070322,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3117317634,"text":"私のお母様でございます。","nextNodeIds":[120070323]},{"nodeId":120070323,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":774832282,"text":"えっ！？","nextNodeIds":[120070324]},{"nodeId":120070324,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3620502714,"text":"驚きますよね…私もです…しかし、この手記の最初にはこう書かれていました。","nextNodeIds":[120070325]},{"nodeId":120070325,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":584864418,"text":"「椿は普段の私と同じでありながら異なる存在。私が椿である時だけ、神里華代ではなくただの平凡な女の子になれる。」","nextNodeIds":[120070326]},{"nodeId":120070326,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":943036874,"text":"「以下のすべては、椿としての私の生活を記録しただけのもの。」","nextNodeIds":[120070327]},{"nodeId":120070327,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2390385938,"text":"手記の中に書かれていたのは、お母様が日常で経験した出来事や考えでした…私たちが「椿」だと思っていた女性も、お母様の考えでしかなかったのです。","nextNodeIds":[120070328]},{"nodeId":120070328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":728444914,"text":"それって、服の裁断図も異国料理も…","nextNodeIds":[120070329]},{"nodeId":120070329,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3785907258,"text":"はい、すべて私のお母様が試したかったことのようです。","nextNodeIds":[120070330]},{"nodeId":120070330,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":4251072818,"text":"貴方がたにとっては不思議に思うかもしれません。しかし私からすれば、お母様のこのような振る舞いはよく理解できます。","nextNodeIds":[120070331]},{"nodeId":120070331,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2942268434,"text":"それどころか、実は…私もそのような一面を持っているのです…","nextNodeIds":[120070332]},{"nodeId":120070332,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1923558634,"text":"手記を読んだ時、自分の考えがすべて人に見透かされているのではないかと思うほど、そこには私と同じ気持ちが書いてあり、あっけにとられてしまいました…","nextNodeIds":[120070333]},{"nodeId":120070333,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4015378866,"text":"綾華…","nextNodeIds":[120070334]},{"nodeId":120070334,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1152198914,"text":"お母様がお父様に嫁いでから、ずっと神里家の主母としてすべての事務を担当してきました。高貴な身分である社奉行では、管理すべき点が多々あったのでしょう。","nextNodeIds":[120070335]},{"nodeId":120070335,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3099509082,"text":"それだけでなく、お母様の一言一行は神里家を代表していました。人々から常に注目を浴びせられていたと思います。そのような状況の中、自分のやりたいことをする時間もなかったはず…","nextNodeIds":[120070336]},{"nodeId":120070336,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1108757906,"text":"両親が亡くなった後、お兄様と私は神里家のすべてを引き継ぎました。その中で遭遇した数々の困難は、他の方には想像できないかもしれません…","nextNodeIds":[120070337]},{"nodeId":120070337,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":137641978,"text":"私が面倒事に遭った時、いつもこう思うのです——お母様も以前このようなことを経験したのでしょうか？お母様ならこのことをどう対処したのだろうかと。","nextNodeIds":[120070338]},{"nodeId":120070338,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3087723090,"text":"お母様と離れ、長い時間が経ったからかもしれません。私の記憶に残っているお母様は、威厳ある高貴な一面だけです。","nextNodeIds":[120070339]},{"nodeId":120070339,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3157664714,"text":"……","nextNodeIds":[120070340]},{"nodeId":120070340,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":472771642,"text":"しかし…これはいけないことなのです。","nextNodeIds":[120070341]},{"nodeId":120070341,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":393193866,"text":"この手記を読んだ時、気付きました…お母様も私と同じように、どれほど大きな責任を背負っていても、結局はただの人であると。","nextNodeIds":[120070342]},{"nodeId":120070342,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2102351770,"text":"綺麗なお着物を好み、各地の美食を食べ、見たこともない美しい風景を見る…それらに憧れていたのです。","nextNodeIds":[120070343]},{"nodeId":120070343,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3791085050,"text":"もしかすると、貴方がたはそのようなことを稚拙に思うかもしれません。しかし…私はたしかにそのような考えを持っています。神里綾華としてではなく、普通の女の子として生きるという想いを。","nextNodeIds":[120070344]},{"nodeId":120070344,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":724939866,"text":"お母様が書いていました、稲妻の民たちの間で行われるお祭りにずっと参加したかったと。天気のいい夜に家から遠くを眺めると、たまにお祭りの灯りが見えると。","nextNodeIds":[120070345]},{"nodeId":120070345,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":894993202,"text":"私も見たことがあります！夜空を照らす灯りが…とても綺麗なんです…とても賑やかで、そこの治安を心配するほど。","nextNodeIds":[120070346]},{"nodeId":120070346,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1837119170,"text":"しかし、私たちの立場では、やみくもにお祭りに参加することはできません。特に両親がいた時代は、社奉行と人々の関係はそれほど親しいものではありませんでした…","nextNodeIds":[120070347]},{"nodeId":120070347,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":947919970,"text":"私たちを止める人がいなくとも、突然社奉行の人間が群衆の中に現れれば、皆さんに注目されることでしょう。いったいこれから何が始まるのかと思うはずです。","nextNodeIds":[120070348]},{"nodeId":120070348,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2934711754,"text":"お母様は人々がそうしてかしこまるのを嫌っていました。皆さんにお祭りの楽しさと自由を味わってもらえることを望んでいたのです…人々の邪魔をしたくない上に、あまり余暇もない方でした。そのため、一度もお祭りに行ったことがなかったようです。","nextNodeIds":[120070349]},{"nodeId":120070349,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3930844002,"text":"そうだったのか…じゃあ、あの裁断図に描いてあった服って、祭りに行く時に着る服だったってことか？","nextNodeIds":[120070350]},{"nodeId":120070350,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3679017690,"text":"はい。お祭りでは異国からの料理も売られることがあったので、それも味わってみたかったのでしょう。","nextNodeIds":[120070351]},{"nodeId":120070351,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3193825354,"text":"こういうことを言うのは少々相応しくないかもしれませんが…お母様も意外と乙女な一面を持っていたのですね。うふふ。","nextNodeIds":[120070352]},{"nodeId":120070352,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":648583978,"text":"相応しくないなんてことないぞ！おまえのお母さんは、かわいくて責任感のある人だとオイラは思う！","nextNodeIds":[120070353]},{"nodeId":120070353,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":497371538,"text":"……","nextNodeIds":[120070354]},{"nodeId":120070354,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3570809194,"text":"知らず知らずのうちに、私がお母様の代わりに願いを叶えていたのですね。しかしお祭りに行くことだけは、私もできません。","nextNodeIds":[120070355]},{"nodeId":120070355,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1080242970,"text":"どうやら…お母様のためにそれを行う機会もないようです…","nextNodeIds":[120070356,120070357]},{"nodeId":120070356,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1534952410,"text":"もう十分やったよ。","nextNodeIds":[120070358]},{"nodeId":120070358,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":674965554,"text":"はい、分かっています。","nextNodeIds":[120070359]},{"nodeId":120070359,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3968298530,"text":"…ありがとうございます。この一件で、私もいくつかのことに気付けました。","nextNodeIds":[120070360]},{"nodeId":120070360,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1784486882,"text":"お母様と私、色々と通ずる点があるようです。お母様が直面したことは、私も同じく向き合うべきこと。","nextNodeIds":[120070361]},{"nodeId":120070361,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3356743362,"text":"お母様は実現できない願いを「椿」に託した…私…決めました。","nextNodeIds":[120070362]},{"nodeId":120070362,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3214352586,"text":"えっ！まさかおまえも…","nextNodeIds":[120070363]},{"nodeId":120070363,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1456960586,"text":"いえ、私は…","nextNodeIds":[120070364]},{"nodeId":120070364,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2893701290,"text":"この方法を使うつもりはございません。ただ…新しい目標ができました。悔いのない毎日を送りたいと思います。","nextNodeIds":[120070365]},{"nodeId":120070365,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3177755482,"text":"その…旅人さん、私…えっと…","nextNodeIds":[120070366]},{"nodeId":120070366,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1324186058,"text":"ふぅ…落ち着いて、気をしっかりと…","nextNodeIds":[120070367]},{"nodeId":120070367,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1644209754,"text":"私たちのお祭りに興味はございますか？","nextNodeIds":[120070368]},{"nodeId":120070368,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":893350970,"text":"告知を見た時からずっと行きたかったんだ！綾華も興味あるんだろ？","nextNodeIds":[120070369]},{"nodeId":120070369,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1603832010,"text":"綾華も祭りに行ったことないんだよね？","nextNodeIds":[120070370]},{"nodeId":120070370,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3038121018,"text":"はい、あの…笑わないでくださいね。私も…昔、同じような悩みを抱えていたんです…しかし、今はもう吹っ切れました。","nextNodeIds":[120070371]},{"nodeId":120070371,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":1526354906,"text":"私は自分の願いを叶えるために、心に忠実に生きようと思います。貴方でしたら、きっと私のわがままを責めることはないですよね…","nextNodeIds":[120070372]},{"nodeId":120070372,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":3109195778,"text":"その…私と一緒に…お祭りに行ってくれませんか！","nextNodeIds":[120070373]},{"nodeId":120070373,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3574128034,"text":"よろこんで。","nextNodeIds":[120070374]},{"nodeId":120070374,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":989441090,"text":"行く行く！祭りって美味いもんがたくさんあるだろ？それと楽しい遊びもな、へへっ！","nextNodeIds":[120070375]},{"nodeId":120070375,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":474175474,"text":"…よかった、お二方、感謝します！","nextNodeIds":[120070376]},{"nodeId":120070376,"roleType":"TALK_ROLE_NPC","speakerId":1013,"speakerName":"神里綾華","textMapHash":2824551018,"text":"今から行けば、まだ間に合うかもしれません。","nextNodeIds":[120070377]},{"nodeId":120070377,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2725606274,"text":"そうだな、今日は最終日だったよな？じゃあ、さっそく行ってみようぜ！","nextNodeIds":[]},{"nodeId":120070357,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":136626338,"text":"綾華のせいじゃない。","nextNodeIds":[120070358]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1200703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133209019,1"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1013","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1200712,"order":12,"stepDescription":"","stepDescTextMapHash":3261353292,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1200712,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1200712,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133220078"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"E