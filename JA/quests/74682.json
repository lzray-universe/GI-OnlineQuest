ONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7468201,"initDialog":746820101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30551],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_74682/Q7468201","priority":5,"questId":74682,"showRandomTalkCount":0},"dialogs":[{"nodeId":746820101,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":868130290,"text":"遂にこの日が来たか…","nextNodeIds":[746820102]},{"nodeId":746820102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2603661170,"text":"子供の頃のあの夢はどうなった？","nextNodeIds":[746820103]},{"nodeId":746820103,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":2502148290,"text":"大人になってからようやく、当時レンジャー長が難しい顔をしていた理由が分かったよ…","nextNodeIds":[746820104]},{"nodeId":746820104,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":2520063978,"text":"コホン…とにかく、少なくとも試しはした。","nextNodeIds":[746820105]},{"nodeId":746820105,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":1849200050,"text":"それに、未加工の爆炎樹の実を持ってマッシュラプトルに近づいてはいけないことも思い知らされたよ…","nextNodeIds":[746820106]},{"nodeId":746820106,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":3518266858,"text":"焦げた匂いを嗅いだ時にはもう遅かった。危うくやつがばらまく胞子に呑み込まれるところだったよ。","nextNodeIds":[746820107]},{"nodeId":746820107,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":3257629514,"text":"キノコンとキノシシはまったく違う種だっていうのにね、それをつい忘れてしまう。","nextNodeIds":[746820108]},{"nodeId":746820108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3228044570,"text":"たしかに。そういえばキノコンって、キノコ類なんだよな？","nextNodeIds":[746820109]},{"nodeId":746820109,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":3981775570,"text":"ああ。スープに入れると、これまた美味しくてね。","nextNodeIds":[746820110]},{"nodeId":746820110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":651554330,"text":"あー…えっと、やっぱり今日の挑戦相手の話に戻そうぜ。","nextNodeIds":[746820111]},{"nodeId":746820111,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":3434755498,"text":"どう料理するかはまだ…おっと！そうだ、「交渉」の話だったね。失礼した。","nextNodeIds":[746820112]},{"nodeId":746820112,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":3293838482,"text":"原海アベラントの頂点に立つ、二つの覇者の物語を聞いたことはあるだろうか？物語では、千年真珠の海駿を描写する際、「孤高」や「高潔」といった言葉がよく使われてる。","nextNodeIds":[746820113]},{"nodeId":746820113,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":826122090,"text":"それに比べて、鉄甲熔炎帝王は名前からして厄介そうだ。強くて乱暴な感じがするだろ？","nextNodeIds":[746820114]},{"nodeId":746820114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":463229306,"text":"なんだ。てっきり強いほうを選ぶと思ってたぜ。前に「冒険譚を語るなら、やはりそれなりに手ごわい相手を選ばないと」って言ってたし。","nextNodeIds":[746820115]},{"nodeId":746820115,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":2547332850,"text":"鉄甲熔炎帝王は確かに強いが、しょせんは重甲ヤドカニ。それに比べて、千年真珠の海駿は飛べる海{RUBY#[D]タツノコ}馬だぞ！","nextNodeIds":[746820116,746820118]},{"nodeId":746820116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2851719770,"text":"だったら、天馬と呼ぶべきかも？","nextNodeIds":[746820117]},{"nodeId":746820117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3479125602,"text":"いや、気になるのはそこかよ！？","nextNodeIds":[746820119]},{"nodeId":746820119,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":2148320618,"text":"とにかく、あれに一度またがることができたら…","nextNodeIds":[746820120]},{"nodeId":746820120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1224035314,"text":"わかったよ。考えを変えるつもりはないってことだな。","nextNodeIds":[746820121]},{"nodeId":746820121,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":4017276762,"text":"せっかく来たんだ、何もせずに帰るわけにはいかないだろ？準備ができたら、さっそく出発しよう。","nextNodeIds":[746820122,746820123]},{"nodeId":746820122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3131991698,"text":"準備できた。","nextNodeIds":[]},{"nodeId":746820123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":930747978,"text":"他に用事があるから、またあとで。","nextNodeIds":[746820124]},{"nodeId":746820124,"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","textMapHash":3565268042,"text":"ああ。じゃあ、ここで待ってるよ。","nextNodeIds":[]},{"nodeId":746820118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1805984954,"text":"#{M#俺}{F#私}からすると大差はない…","nextNodeIds":[746820119]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30551"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468201],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30551,"speakerName":"ランジット","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":5}],"raw":{"ANDJNFLIDIJ":"PL