Id":74509,"showRandomTalkCount":0},"dialogs":[{"nodeId":745090101,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":687137658,"text":"しばらくして、パイモンと一緒に「ちびチエキノコン大合戦」の開催場所にやってきた…","nextNodeIds":[745090102]},{"nodeId":745090102,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2834666986,"text":"やっほー！「才知と勇猛の双子星」、あなたたちったらまた「ちびチエキノコン大合戦」をしに来たんですか！","nextNodeIds":[745090103]},{"nodeId":745090103,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2843440386,"text":"アンジェニーナさんは任務があるようで、先に執律庭へ帰りましたよ。この先は私がお付き合いいたしますね。","nextNodeIds":[745090104]},{"nodeId":745090104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2000855242,"text":"左右加さん、おかえり！","nextNodeIds":[745090105]},{"nodeId":745090105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1600865194,"text":"ハニヤーに会ったとき、ずいぶん面食らったけど、左右加さんもド派手だな。その服は…元気いっぱいだ…","nextNodeIds":[745090106]},{"nodeId":745090106,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":3026159434,"text":"元気があるのはいいことですよ。仕事はまだまだたくさん残ってますからね。すぐエネルギー切れになるわけにはいかないんです。","nextNodeIds":[745090107]},{"nodeId":745090107,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":4032363578,"text":"斧を振るうように、難題を一つ一つ切り捨てるんです。えへへっ！","nextNodeIds":[745090108,745090109]},{"nodeId":745090108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1113161170,"text":"新聞社の件は忙しい？","nextNodeIds":[745090110]},{"nodeId":745090110,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2634722498,"text":"計画は着々と進んでます。こんな目新しいイベントは結構注目されるんです。新聞社も大々的な宣伝チャンスを逃すまいとしてますよ！","nextNodeIds":[745090111]},{"nodeId":745090111,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2900716122,"text":"新聞の一面は逃しましたけど、最近イベントの人気が右肩上がりなのは一目瞭然です。","nextNodeIds":[745090112]},{"nodeId":745090112,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":1798318810,"text":"それは確かね。最近、「ちびチエキノコン大合戦」を遊ぶためにここを訪れる一般市民が増え続けているわ。","nextNodeIds":[745090113]},{"nodeId":745090113,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2738108218,"text":"「ちびチエキノコン」をどんな編成にすれば効率よく勝てるかについて、議論し始めた人も多いのよ。","nextNodeIds":[745090114]},{"nodeId":745090114,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":3216850322,"text":"しかも、「ゴールド流星」と「シルバー伴星」を捜してる人もいるって話も聞いたわ。あなたたちと一戦交えて、達人のお手並みを拝見したいみたいね。","nextNodeIds":[745090115,745090116]},{"nodeId":745090115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":207946346,"text":"ははっ！達人は闇雲に手を出さないよ！","nextNodeIds":[745090117]},{"nodeId":745090117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3605666250,"text":"ハニヤーと左右加さんが挑んでくるってんなら話は別だけどな。おまえらは昔なじみだし、オイラたちの戦略をよく理解してんだろ？","nextNodeIds":[745090118]},{"nodeId":745090118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1429487674,"text":"おまえらとの対戦こそ…テクニックが一番試されると思うぞ！","nextNodeIds":[745090119]},{"nodeId":745090119,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2019860834,"text":"そこまで言うなら…私たちで戦ってみるべきですね？","nextNodeIds":[745090120]},{"nodeId":745090120,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2715702418,"text":"よく考えれば、前回直接戦ったのは第一回「サウマラタ蓮杯テイマー大会」のときでしたね。私はちょちょいのちょいで叩きのめされたんでした。","nextNodeIds":[745090121]},{"nodeId":745090121,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":1073029386,"text":"ちょっと懐かしいですね…あの後、私とハニヤーには色々ありましたし、変わったこともたくさんあります。あなたたちもきっとそうでしょう…","nextNodeIds":[745090122]},{"nodeId":745090122,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2147818834,"text":"でも二人が持つ…凛とした勇気と恐れ知らずの豪気は、今も変わらず水晶のように美しく頑丈です！","nextNodeIds":[745090123]},{"nodeId":745090123,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2772709706,"text":"思えば、「チエキノコン布陣」を準備した後に、あなたたちと組むと決めた私たちの目利きは大正解だったと言えますね！","nextNodeIds":[745090124]},{"nodeId":745090124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2566579050,"text":"左右加さん…急にしみじみしちゃってるぜ。これが…作家特有の職業病ってやつなのか？","nextNodeIds":[745090125,745090126]},{"nodeId":745090125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2181363250,"text":"#{M#俺}{F#私}も懐かしいよ。","nextNodeIds":[745090127]},{"nodeId":745090127,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":2733323226,"text":"そうですね！なんて素敵なセリフでしょう！","nextNodeIds":[745090128]},{"nodeId":745090128,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":631079794,"text":"それでは期待してますよ。こっちはゲームデザイナーの一人として、とっても強力な切り札を用意してるんですから。","nextNodeIds":[745090129]},{"nodeId":745090129,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":265996546,"text":"左右加、あれを使うの？","nextNodeIds":[745090130]},{"nodeId":745090130,"roleType":"TALK_ROLE_NPC","speakerId":30416,"speakerName":"左右加","textMapHash":1538945914,"text":"そうです。私が盛り上げ、ハニヤーが強靭な敵を指揮します。そうしてあなたたちともう一度、骨のある戦いを繰り広げるのです！","nextNodeIds":[745090131]},{"nodeId":745090131,"roleType":"TALK_ROLE_NPC","speakerId":30419,"speakerName":"ハニヤー","textMapHash":2431405842,"text":"それじゃ、よろしく頼むわよ。「ゴールド流星」に「シルバー伴星」！","nextNodeIds":[745090132,745090133]},{"nodeId":745090132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":891715226,"text":"任せて！","nextNodeIds":[745090134]},{"nodeId":745090134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2660457442,"text":"#ずいぶんと久々だよな。こうして{NICKNAME}がまたハニヤーと勝負するって考えたら…オイラも気分が上がってきたぜ。","nextNodeIds":[745090135]},{"nodeId":745090135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":384484618,"text":"でも、今回は純粋なお遊びの勝負だ。楽しまないとな！","nextNodeIds":[]},{"nodeId":745090133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3840639754,"text":"さあ、始めよう！","nextNodeIds":[745090134]},{"nodeId":745090126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1860902146,"text":"これからも新しい思い出を作ろう！","nextNodeIds":[745090127]},{"nodeId":745090116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3289353866,"text":"へぇー…わざわざ自分から負けに行くんだ。","nextNodeIds":[745090117]},{"nodeId":745090109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3782345018,"text":"イベントの広告は順調？","nextNodeIds":[745090110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30419"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7450902,"order":99,"stepDescription":"翌日の午前中まで待つ（6~12時）","stepDescTextMapHash":3456344356,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"6,12"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"6,12"}],"trigg