1320105]},{"nodeId":751320105,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":4035201506,"text":"一つ目は東側、英雄の伝説が描かれた壁画に潜む影が徐々に浮かび上がります。","nextNodeIds":[751320106]},{"nodeId":751320106,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":1476676706,"text":"二つ目は西側の謎海の上。漆黒の化身が、まるで鬱陶しいインコのごとく、黒夜の主の話を真似しています。","nextNodeIds":[751320107]},{"nodeId":751320107,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":571441666,"text":"三つ目は崖の下。絶滅するはずだった色褪せた霧が、灰燼の都で再び蠢き始めました…","nextNodeIds":[751320108]},{"nodeId":751320108,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":1334099458,"text":"異邦の勇士よ…漆黒の敵が徘徊するところ、そしてすべてを侵食する敵に、くれぐれもご用心ください。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133509454"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21755"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7513202,"order":3,"stepDescription":"","stepDescTextMapHash":1971889908,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q7513202"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QU