7513205","priority":3,"questId":75132,"showRandomTalkCount":0},"dialogs":[{"nodeId":751320501,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":3506726322,"text":"漆黒の敵が徘徊するところ、そしてすべてを侵食する敵に、くれぐれもご用心ください。","nextNodeIds":[751320502]},{"nodeId":751320502,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":242923122,"text":"異邦の勇士よ…聞きたいことはありますか…？","nextNodeIds":[751320503,751320506,751320509,751320512]},{"nodeId":751320503,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1087601458,"text":"英雄の壁画について…","nextNodeIds":[751320504]},{"nodeId":751320504,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":3769305546,"text":"東側の光り輝く木の揺れる洞窟の中で、ウォーベンを持った語り部がこう言いました——過去の物語には恐怖が潜んでいると。","nextNodeIds":[751320505]},{"nodeId":751320505,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":359078586,"text":"もしかしたら、その暗影が物語を利用し、逃げる道を探しているのかもしれません…","nextNodeIds":[751320502]},{"nodeId":751320506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1124480610,"text":"謎海の上について…","nextNodeIds":[751320507]},{"nodeId":751320507,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":1063170426,"text":"西側の霧に覆われた島は、かつて祭祀の聖地であり、ずっと昔、イクトミ竜族と契約を結んだ者の住む場所でもありました。","nextNodeIds":[751320508]},{"nodeId":751320508,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":2579655306,"text":"しかし、その中から泥が湧き出し、聖地は漆黒の深穴と化したあげく、封印され忘れ去られました…ああ、あの狡猾な敵は簡単には諦めないでしょう…","nextNodeIds":[751320502]},{"nodeId":751320509,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":931920114,"text":"色褪せた霧について…","nextNodeIds":[751320510]},{"nodeId":751320510,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":2093750090,"text":"かつてオシカ・ナタと呼ばれた古都が滅びた際に生じた汚れた霧であり、本来は封印されたものです…しかし、歳月と忘却は大敵と言わざるを得ません…","nextNodeIds":[751320511]},{"nodeId":751320511,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":1993403274,"text":"もしも…ああ…もしも誰かが、再びあの色褪せた霧を消し去ってくれたら…","nextNodeIds":[751320502]},{"nodeId":751320512,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2540609986,"text":"特にない。","nextNodeIds":[751320513]},{"nodeId":751320513,"roleType":"TALK_ROLE_NPC","speakerId":21756,"speakerName":"ラクガキの中の意志","textMapHash":3985095410,"text":"ああ…どうかお忘れなきよう。くれぐれも…お気を付けください…","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513206,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["21755"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7513206,"order":7,"stepDescription":"","stepDescTextMapHash":1956559236,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7513206,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["21755"],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7513206],"talks":[{"talkId":7513206,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":f