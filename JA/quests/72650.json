AL":["30054","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7265001],"talks":[{"talkId":7265001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7265001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7265001,"initDialog":726500101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30054],"performCfg":"QuestDialogue/WQ/Daoqi_72650/Q7265001","priority":5,"questId":72650,"showRandomTalkCount":0},"dialogs":[{"nodeId":726500101,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":797513266,"text":"どうも。渋川と申す、武道流派「心流」の宗主じゃ。","nextNodeIds":[726500102]},{"nodeId":726500102,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":4203649058,"text":"外国からの旅人とお見受けする。どうじゃ、「心流」に興味はあるのか？","nextNodeIds":[726500103,726500104]},{"nodeId":726500103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3724280458,"text":"「心流」…？","nextNodeIds":[726500106]},{"nodeId":726500106,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":401189658,"text":"とにかく、これはわしの独創の技。岩蔵流、喜多院流、そして外国の「西風剣術」のような武器を扱う流派と違って、「心流」を磨き、また「心流」で武芸を磨くことがこの技の奥旨じゃ。","nextNodeIds":[726500107]},{"nodeId":726500107,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":1225072026,"text":"若いころ海外を流浪し武道を研鑽した時に、ナタの者の「拳闘術」を観察したことがある。この流派の武道は練習をする時、仮想の敵と戦うのじゃ。","nextNodeIds":[726500108]},{"nodeId":726500108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1932800674,"text":"「仮想の敵」？","nextNodeIds":[726500109]},{"nodeId":726500109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3988305026,"text":"「空想の友達」を殴るって意味だ。","nextNodeIds":[726500110]},{"nodeId":726500110,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":2670607466,"text":"左様。敵の行動を空想し、その空想に対して反応を取る。現地の者に「影拳斗」と呼ばれるこの練習法を、わしは高く評価しておる。","nextNodeIds":[726500111]},{"nodeId":726500111,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":2602842634,"text":"「心流」はこのような修行を最大限に発揮した無制限格闘流派じゃ。わしの指導があれば、どんな仮想の敵も再現できる。","nextNodeIds":[726500112]},{"nodeId":726500112,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":2386158698,"text":"スライムから落武者まで、スネージナヤの異人戦士でさえ可能じゃ。心流を心得ておれば、容易にそれと戦う場面を再現して、己の腕を磨ける。","nextNodeIds":[726500113]},{"nodeId":726500113,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":3037284546,"text":"因みにじゃが、史上最強の生き物は恐らく「雷晶蝶」じゃな。岩蔵流先代の永胤が以前わしの「心流」を借りて人型の雷晶蝶に挑んだことあるのじゃが、十秒も持たなかった。","nextNodeIds":[726500114]},{"nodeId":726500114,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":1639501586,"text":"相手だけでなく、天気と装置、「地脈異常」までも、心流を通して再現できる。これほど実用的な技術もないだろう。","nextNodeIds":[726500115]},{"nodeId":726500115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":613132802,"text":"心流ってそんなにすごいのか。なら、何で渋川さんが人を探してるんだ？","nextNodeIds":[726500116]},{"nodeId":726500116,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":2949348218,"text":"わしの心流があまりにも…現実に近すぎてのう。仮想の敵と戦う時も、傷を負ったりする弟子がおって。","nextNodeIds":[726500128]},{"nodeId":726500128,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":648034298,"text":"「心流」が幻想した「剣」は手足を切り落とす。そして、心流が幻想した「炎銃」も身を貫く。","nextNodeIds":[726500117]},{"nodeId":726500117,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":584092250,"text":"じゃから、だんだんと、武道に専念しない者は怖がり心流を離れた。そして、武道馬鹿どもは心流を掴んではならぬから、わしに追い出されたんじゃ。","nextNodeIds":[726500118,726500119]},{"nodeId":726500118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1629025994,"text":"そんなにすごいんだ？","nextNodeIds":[726500120]},{"nodeId":726500120,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":668924338,"text":"いかにも。お主、心流と何らかの縁があるようじゃが、わしの「心流」を試してみてはどうじゃ？","nextNodeIds":[726500121,726500122]},{"nodeId":726500121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":21026890,"text":"面白い…","nextNodeIds":[726500124]},{"nodeId":726500124,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":2702895338,"text":"とにかく、興味が湧いたら目の前の足場を心流の「土俵」と思うが良い。","nextNodeIds":[726500125]},{"nodeId":726500125,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":1191767826,"text":"わしが、お主にぴったりの「心流戦場」を作ってやるから…","nextNodeIds":[726500126]},{"nodeId":726500126,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":1466940258,"text":"但し、怪我をするでないぞ。何せ…","nextNodeIds":[726500127]},{"nodeId":726500127,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":207760450,"text":"「心流」は残酷なものじゃから。","nextNodeIds":[]},{"nodeId":726500122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3355951890,"text":"興味ない。","nextNodeIds":[726500123]},{"nodeId":726500123,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":3660972290,"text":"そうか。惜しいな。","nextNodeIds":[726500124]},{"nodeId":726500119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":268630682,"text":"そんなに怖いんだ？","nextNodeIds":[726500120]},{"nodeId":726500104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4097065890,"text":"興味ない。","nextNodeIds":[726500105]},{"nodeId":726500105,"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","textMapHash":2571883522,"text":"#そう言うな。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}、立っている姿といい、乱れのない息といい、長年「武」の道を歩んできたに違いないだろう？","nextNodeIds":[726500106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7265001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30054","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7265001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30054,"speakerName":"渋川","count":19},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":7},{"roleType":