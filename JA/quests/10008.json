e":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1000809","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1000801,"initDialog":100080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1011],"performCfg":"QuestDialogue/WQ/Mengde_10008/Q1000801","priority":5,"questId":10008,"showRandomTalkCount":0},"dialogs":[{"nodeId":100080101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3018754298,"text":"レザー！","nextNodeIds":[100080102]},{"nodeId":100080102,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":3135114178,"text":"懐かしい匂い…お前たちか。","nextNodeIds":[100080103]},{"nodeId":100080103,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":1681677458,"text":"最近、どうだ？","nextNodeIds":[100080104]},{"nodeId":100080104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2294363026,"text":"へへっ、うまくいってるぜ。そうだ、レザー。オイラたちが来たら、王狼がいなくなっちゃったけど、なにを話してたんだ？","nextNodeIds":[100080105]},{"nodeId":100080105,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":919112370,"text":"狩りをする。オレは…領主を説得してた。","nextNodeIds":[100080106]},{"nodeId":100080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3799442106,"text":"狩り？","nextNodeIds":[100080107]},{"nodeId":100080107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2005243530,"text":"（もしかして、これがレザーの「課題」なのか？）","nextNodeIds":[100080108]},{"nodeId":100080108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1441204546,"text":"もしかして狼たちは、また食べるものがなくなったから、狩りを始めるってことか？","nextNodeIds":[100080109,100080110]},{"nodeId":100080109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2524344122,"text":"トラバサミをもらおう…","nextNodeIds":[100080111]},{"nodeId":100080111,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":1766950706,"text":"違う…今回の狩り…腹減ってるからじゃない…","nextNodeIds":[100080112]},{"nodeId":100080112,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":382574690,"text":"今回は…敵を殺すため。黒狼の群れ…縄張りを占領…変な臭い、どんどん広がる…","nextNodeIds":[100080113]},{"nodeId":100080113,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":747132330,"text":"森を浄化…敵を狩る。","nextNodeIds":[100080114]},{"nodeId":100080114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":664418106,"text":"それで、王狼はオッケーしてくれたのか？あの時、王狼はこう言ってたろ…","nextNodeIds":[100080115]},{"nodeId":100080115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1159710898,"text":"えっと、どんな感じだっけ…コホンッ、「レザー、おまえは討伐に加わるな。これは狼の問題だ。」","nextNodeIds":[100080116]},{"nodeId":100080116,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":528233122,"text":"……","nextNodeIds":[100080117]},{"nodeId":100080117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4061368666,"text":"あ、悪気はなかったんだ…ごめんな、レザー…","nextNodeIds":[100080118]},{"nodeId":100080118,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":3516691826,"text":"大丈夫。オレ、「ルピカ」と一緒。それに、師匠…領主と話す方法、教えてくれた。","nextNodeIds":[100080119]},{"nodeId":100080119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2748923738,"text":"リサさんが教えてくれた…領主と話す方法？","nextNodeIds":[100080120]},{"nodeId":100080120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1419083346,"text":"あっ、わかったぞ！説得する方法のことだな。じゃあ、さっきもう王狼を説得したのか？","nextNodeIds":[100080121]},{"nodeId":100080121,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":3635293394,"text":"うん、話すの、すごく疲れる。でも…うまくいった。","nextNodeIds":[100080122]},{"nodeId":100080122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1514169314,"text":"あの頑固なデカ狼を説得するなんて、すごいぞ！","nextNodeIds":[100080123]},{"nodeId":100080123,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":1210336282,"text":"黒狼の群れは、世界の敵。師匠が言ってた…これは、狼の問題じゃない。世界の問題。師匠、正しい。領主も…認めた。","nextNodeIds":[100080124]},{"nodeId":100080124,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":1649431434,"text":"でも…だから、狼たちは関わらない。これは…「オレ」と「黒狼の群れ」との戦い…","nextNodeIds":[100080125]},{"nodeId":100080125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":912071770,"text":"へへっ、じゃあオイラたちも手伝おうぜ！あの変な獣域ハウンドたち、前から気に入らなかったんだ！","nextNodeIds":[100080126]},{"nodeId":100080126,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":630690586,"text":"あ…ありがとう。お前たちが助けてくれたら…きっとうまくいく。","nextNodeIds":[100080127]},{"nodeId":100080127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1121034954,"text":"でも、どうやって狩りを始めればいいんだ？","nextNodeIds":[100080128]},{"nodeId":100080128,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":761227570,"text":"オレたち…獲物を罠に追い込むみたいに、黒狼の群れ、ここに追い込む…","nextNodeIds":[100080129]},{"nodeId":100080129,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":2308781834,"text":"領主が…閉じ込めてくれる。オレたちで…片付ける。","nextNodeIds":[100080130]},{"nodeId":100080130,"roleType":"TALK_ROLE_NPC","speakerId":1011,"speakerName":"レザー","textMapHash":12631506,"text":"…準備できたら、話かけてくれ。そしたら、狩り、始める。","nextNodeIds":[100080401]},{"nodeId":100080401,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1818202410,"text":"今すぐ行こう！","nextNodeIds":[]},{"nodeId":100080110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3461799026,"text":"イノシシは十分大きくなった。","nextNodeIds":[100080111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1000801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20301,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1011"],"NOCCOBOFKHP":20301,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1000810,"order":4,"stepDescription":"アビスの魔物を狩る","stepDescTextMapHash":2757031852,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20301,0],"PAINLIBBLDK":"QUEST_CONTENT_PRESENT_AT_SPECIFIC_SCENE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_13718:2007.607,258.172,-321.971,0.000,343.902,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20301,0],"PAINLIBBLDK":"QUEST_CONTENT_PRESENT_AT_SPECIFIC_SCENE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNL