TalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351701,"initDialog":735170101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342,30343],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351701","priority":5,"questId":73517,"showRandomTalkCount":0},"dialogs":[{"nodeId":735170101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2235319122,"text":"…つまり結論から言えば、やはり「対ウェネト殺蟲大砲」に頼る必要があったんだな？","nextNodeIds":[735170102]},{"nodeId":735170102,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1613037954,"text":"ぜんぶひっくるめないで！それから「僕の意見を素直に受け入れればよかったのに」みたいな顔をするのもやめて！","nextNodeIds":[735170103,735170104]},{"nodeId":735170103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1815440186,"text":"なんでまた始まったの？","nextNodeIds":[735170105]},{"nodeId":735170105,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2617021866,"text":"あっ、冒険者さん！あのね、私、この事件の原因を解明したのよ！","nextNodeIds":[735170106]},{"nodeId":735170106,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3723986650,"text":"——ウェネトが地下で頻繁に活動していることが原因で、この地域の元素エネルギーに乱れが生じているの。","nextNodeIds":[735170107]},{"nodeId":735170107,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3747694962,"text":"そして乱れたエネルギーが、今度は逆にウェネトの習性に影響を与えて、大地を暴れまわらせる…そんな風にして、環境バランスの崩壊が加速してるってわけ。","nextNodeIds":[735170108]},{"nodeId":735170108,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1288218730,"text":"「対ウェネト殺蟲大砲」のチャージ装置に効率異常が発生したのも、ここの元素エネルギーが乱れているからだったのよ。","nextNodeIds":[735170109]},{"nodeId":735170109,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2462642514,"text":"だろうと思ったよ。僕の設計した機械が、これほど簡単に故障なんかするはずないんだ！","nextNodeIds":[735170110]},{"nodeId":735170110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3920206034,"text":"使用環境を考慮しなかったっていうのは、設計の問題じゃないのか…？","nextNodeIds":[735170111,735170112]},{"nodeId":735170111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3273955410,"text":"ウェネトの過度な活発化が原因なら…","nextNodeIds":[735170113]},{"nodeId":735170113,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1966745938,"text":"つまり、あれだけ回り道して、結局たどり着いたのは最初と同じ結論ってわけか？","nextNodeIds":[735170114]},{"nodeId":735170114,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2034555482,"text":"何をやるのか知ることと、何故それをやるのかを知ることは全然別ものよ。学者のくせして、それくらいのことも分からないっていうの？それに、私の推論はまだ終わってないわよ。","nextNodeIds":[735170115]},{"nodeId":735170115,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":943069690,"text":"一般的には、環境の安定性を保つために、大自然は自ら個体群の生態とその行為を制限するものよ。","nextNodeIds":[735170116]},{"nodeId":735170116,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":599667394,"text":"だけど、今回は乱れたエネルギーによって、このバランス機能が無効化され、また同時にウェネトを異常に活発化させた…","nextNodeIds":[735170117]},{"nodeId":735170117,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":4011222194,"text":"つまり、元素環境さえ通常状態に戻れば、ウェネトの動きを抑えられる。ちょっと時間が経てば、このバランスも自然に回復してくれるはずよ。","nextNodeIds":[735170118]},{"nodeId":735170118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1319434922,"text":"元素エネルギーの調整ってことか？そんなこと、どうやってやるんだよ？","nextNodeIds":[735170119]},{"nodeId":735170119,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1430182186,"text":"そうね、まずは元素エネルギーが最も溜まっている「ノード」がどこなのか計算する。加えて、エネルギーの流れを導くことのできる装置を使えば…","nextNodeIds":[735170120]},{"nodeId":735170120,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2167951362,"text":"…溜まったエネルギーを外に導けるわ。あとは大自然の自己調整に任せていいと思う。","nextNodeIds":[735170121]},{"nodeId":735170121,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1888101154,"text":"「ノード」の場所は既に計算できていて、すぐ近くよ。そしてエネルギーの流れを導く装置なら、私たちは既に持ってるはず…","nextNodeIds":[735170122]},{"nodeId":735170122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3198179322,"text":"まさか…対ウェネト殺蟲大砲のこと？","nextNodeIds":[735170123]},{"nodeId":735170123,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3717834874,"text":"ご明察。「対ウェネト殺蟲大砲」なら、周りの元素エネルギーを吸収して、一気に発射できるわ。","nextNodeIds":[735170124]},{"nodeId":735170124,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2128421114,"text":"これからの計画だけど、そこに「対ウェネト殺蟲大砲」を設置して、昨日の手順を一通りやればいいと思うの。","nextNodeIds":[735170125]},{"nodeId":735170125,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":354391170,"text":"でも、その間も魔物やウェネトを引き付けてしまうでしょうから…まあ、場合に応じて数を減らすのも、自然調整の進捗を加速につながると思うわ。","nextNodeIds":[735170126]},{"nodeId":735170126,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2425555130,"text":"——つまり結論から言うと、やはり「対ウェネト殺蟲大砲」でやつらに一発かます必要があると？","nextNodeIds":[735170127]},{"nodeId":735170127,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":593950130,"text":"ちょっと…！その「僕の意見を素直に受け入れればよかったのに」って顔をやめてったら！","nextNodeIds":[]},{"nodeId":735170112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3030689194,"text":"解決策はやっぱりウェネトを倒すこと？","nextNodeIds":[735170113]},{"nodeId":735170104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2511287538,"text":"今度はなんのために言い争ってるの？","nextNodeIds":[735170105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173517],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":878525902,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/V3.6SandSworm/Q7351701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":