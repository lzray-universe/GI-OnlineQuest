gonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4017302","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4017301,"initDialog":401730101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1094],"performCfg":"QuestDialogue/EQ/V5.2ActivityCeremony_40173/Q4017301","priority":5,"questId":40173,"showRandomTalkCount":0},"dialogs":[{"nodeId":401730101,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2554140298,"text":"みんな集まったみたいね。","nextNodeIds":[401730102]},{"nodeId":401730102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":602678050,"text":"よう、シトラリ！","nextNodeIds":[401730103]},{"nodeId":401730103,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":4230033770,"text":"族長から儀式用の剣を借りてきたの。これがないとできないコトがあるのよね。","nextNodeIds":[401730104]},{"nodeId":401730104,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1642370034,"text":"今日何をすべきか、ちゃーんと覚えてるでしょうね？","nextNodeIds":[401730105]},{"nodeId":401730105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1558549642,"text":"もちろんだぜ。ルラが目覚めるのを待つんだよな。起きたら、一体なにがあったんだって問い詰めてやるぞ。","nextNodeIds":[401730106]},{"nodeId":401730106,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":4087622618,"text":"僕もばあちゃんに言われた通り、必要なものを全部用意してきた。","nextNodeIds":[401730107]},{"nodeId":401730107,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":4045502922,"text":"バッチリね。おしゃべりはこれくらいにして、始めましょう。","nextNodeIds":[401730108]},{"nodeId":401730108,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1172557186,"text":"シトラリは「厄水の災い」という名の儀式用の剣を召喚した。","nextNodeIds":[401730109]},{"nodeId":401730109,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1164090154,"text":"秘されし煙のうちより、捧げたてまつらん。月無き夜には星々を、風の無ければ夢の花輪をたてまつらん。","nextNodeIds":[401730110]},{"nodeId":401730110,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2769765346,"text":"死の主に捧げたてまつる。落ちよ、落ちよ、ただ落ちよ。三度、帰りて、また三度。","nextNodeIds":[401730111]},{"nodeId":401730111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3108465034,"text":"うわぁ——なんかの呪文か？急に寒くなったぞ！なにか来るのか！？","nextNodeIds":[401730112]},{"nodeId":401730112,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":1460479266,"text":"静かに。ばあちゃんを邪魔してはいけない。","nextNodeIds":[401730113]},{"nodeId":401730113,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3779146146,"text":"我ら祭司たる王の裔、遠き昔の契りによりて、夜の帳を引き裂かん。","nextNodeIds":[401730114]},{"nodeId":401730114,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2977691738,"text":"我、シトラリがここに告ぐ。我が名はアー・クルバティ、我は末地の主なり。","nextNodeIds":[401730115]},{"nodeId":401730115,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":1706515194,"text":"……","nextNodeIds":[401730116]},{"nodeId":401730116,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":659096274,"text":"見ろ…！ルラのスピリットが戻ってきた。体に向かってる。","nextNodeIds":[401730117]},{"nodeId":401730117,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3162110154,"text":"燧石の刃を持ちて、夜の帳に突き立てん。未だ亡者にあらぬ魂を我が名において追放す。\\n","nextNodeIds":[401730118]},{"nodeId":401730118,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1451237466,"text":"ルラよ！我が命に従いて、炎天の大地、汝の道へと戻れ！","nextNodeIds":[401730119]},{"nodeId":401730119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2021882690,"text":"う…うまくいったのか？","nextNodeIds":[401730120]},{"nodeId":401730120,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":1894582290,"text":"うぅ…あれ？ここは…？あなたたちは…","nextNodeIds":[401730121]},{"nodeId":401730121,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":2275241682,"text":"うわあっ——黒曜石の老婆！じゃなくて…シトラリ大祭司さま！どうかお許しを！！","nextNodeIds":[401730122]},{"nodeId":401730122,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2234140306,"text":"このガキンチョ、自分がナニをしでかしたのか、よーく分かっているようね？","nextNodeIds":[401730123]},{"nodeId":401730123,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":741668394,"text":"あとちょっとで戻れなくなるところだったのよ？自分を抜け殻にして、そんなに面白い？","nextNodeIds":[401730124]},{"nodeId":401730124,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":3656540778,"text":"も、申し訳ありません…罰を受けます。","nextNodeIds":[401730125]},{"nodeId":401730125,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3467077434,"text":"あら？ホンキかしら？なら早く家に帰って両親に別れを告げるコトね。こう言うのよ。","nextNodeIds":[401730126]},{"nodeId":401730126,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2992422946,"text":"「父さん、母さん、さようなら。抜け殻としての人生が楽しいから、石像になって、百年間、黒曜石の老婆の家の門番をするんだ。」ってね！","nextNodeIds":[401730127]},{"nodeId":401730127,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":1983473370,"text":"嫌です！本当にすみませんでした！助けてくださってありがとうございます、シトラリ大祭司さま！","nextNodeIds":[401730128]},{"nodeId":401730128,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1190602130,"text":"フン、お礼は孫に言ってちょうだい。このコが異変に気付いてなかったら、クビを突っ込まなかっただろうし。","nextNodeIds":[401730129]},{"nodeId":401730129,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":1968843834,"text":"礼はいい、ルラ。口ではああ言っているが、ばあちゃんも僕たちも責めたりしない。","nextNodeIds":[401730130]},{"nodeId":401730130,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3597796778,"text":"君は騙されたんだろ？悪いのは、すべて谷中ってやつだ。","nextNodeIds":[401730131]},{"nodeId":401730131,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":1148474194,"text":"いや…谷中さんは関係ないよ。ぼくがやってみたかったんだ。","nextNodeIds":[401730132]},{"nodeId":401730132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1791637114,"text":"え？","nextNodeIds":[401730133]},{"nodeId":401730133,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":2531509746,"text":"スピリットが多く残ってる物を媒体にする方法を教えてくれたのは確かに谷中さんだけど、やるって決めたのはこのぼくだ。あの人はぼくを騙したりなんてしていないよ。","nextNodeIds":[401730134]},{"nodeId":401730134,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":998868066,"text":"ごめん、全部ぼくのせいだ。","nextNodeIds":[401730135]},{"nodeId":401730135,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":114830298,"text":"フン、かなり洗脳されちゃってるのね。","nextNodeIds":[401730136]},{"nodeId":401730136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2126805194,"text":"えっと…じゃあ、あの欠片はそいつが持ってきたものなのか？","nextNodeIds":[401730137]},{"nodeId":401730137,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":153451762,"text":"ああ、燼寂海と関係のある宝物だと言ってたよ。","nextNodeIds":[401730138]},{"nodeId":401730138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3485717042,"text":"どう見てもおまえを利用してるじゃないか！そんなの、おまえに霊視をさせるために決まってるだろ！","nextNodeIds":[401730139]},{"nodeId":401730139,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":420136394,"text":"でも、ぼくは霊感音痴だからなんの巫術も使えない…そんなぼくをどうやって利用するんだ？","nextNodeIds":[401730140]},{"nodeId":401730140,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":3657320418,"text":"ぼくみたいな人は、ただ座って瞑想しても一生スピリットを感知できない。","nextNodeIds":[401730141]},{"nodeId":401730141,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":2835386890,"text":"でも、谷中さんは別の方法で無理やり巫術を使えるようにすれば、例えば自分に大量のスピリットを浴びせれば、それを捉えるチャンスがあるかもしれないって。だから…","nextNodeIds":[401730142]},{"nodeId":401730142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2341450554,"text":"そんな方法、無茶だろ！シトラリがいなかったら、本当に戻れなくなってたんだぞ！","nextNodeIds":[401730143]},{"nodeId":401730143,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":2209188546,"text":"ごめん…本当に申し訳ない…でも、みんな才能があるのにぼくだけ何もできなくて…ぼくはただ、みんなと同じになりたかっただけなんだ…","nextNodeIds":[401730144]},{"nodeId":401730144,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3986655442,"text":"気持ちは分かる…","nextNodeIds":[401730145]},{"nodeId":401730145,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":4284660786,"text":"大して努力しなくても立派なキャベツになる種もあれば、どれだけ頑張っても芽が出ない種もある。","nextNodeIds":[401730146]},{"nodeId":401730146,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":2788804658,"text":"理由は僕も分からないけど、たぶんそれが人生ってやつなんだろう。どうにもできないことは、たくさんあるんだ。","nextNodeIds":[401730147]},{"nodeId":401730147,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":2349651442,"text":"こんなことを言っても役に立たないかもしれないけど。でも、受け入れるしかないんだ。","nextNodeIds":[401730148]},{"nodeId":401730148,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3914891306,"text":"ひとまず、お話はここまでにしましょう。まずはマトーラのところで検査してもらわないと。","nextNodeIds":[]}]},{"talkId":4017307,"talkConfig":{"checkActionAfter":false,