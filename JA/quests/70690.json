ND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7069002,"initDialog":706900201,"nextRandomTalks":[],"nextTalks":[],"npcId":[15181,1007],"performCfg":"QuestDialogue/WQ/Hexenzirkel_70690/Q7069002","priority":5,"questId":70690,"showRandomTalkCount":0},"dialogs":[{"nodeId":706900201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":859540898,"text":"ふぅ、やっと最後の一山だぞ。","nextNodeIds":[706900202]},{"nodeId":706900202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3680103066,"text":"いったいどんな本なんだ…『ヒルチャールのサバイバル術』？ヒルチャールって本は読まないだろ？それに『トリックフラワー栽培ガイド』って、誰がそんなもの育てたいと思うんだよ！","nextNodeIds":[706900203]},{"nodeId":706900203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3957955538,"text":"これは『小さな魔女の辞典』…うーん、名前からして怪しいぞ。それに、こっちはもう整理したはずだよな。この本って見た覚えあるか？","nextNodeIds":[706900204,706900206]},{"nodeId":706900204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2392244226,"text":"目録にはないみたい。","nextNodeIds":[706900205]},{"nodeId":706900205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1338188178,"text":"魔女って聞くと、どうしても思い浮かぶのは…","nextNodeIds":[706900207]},{"nodeId":706900207,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":1192531250,"text":"あら、私を探してるの？","nextNodeIds":[706900208]},{"nodeId":706900208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1598030162,"text":"えっ？アリス！？どこから現れたんだ？","nextNodeIds":[706900209]},{"nodeId":706900209,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":3138049954,"text":"パイモンは気づいてないかもしれないけど、私が急に現れたわけじゃない。あの辞典を開いた瞬間から、あなたたちは魔女の「領域」に入ってるの。","nextNodeIds":[706900210]},{"nodeId":706900210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2775362914,"text":"うわぁ、やっぱり！あの本、なんか変だと思ったんだ！","nextNodeIds":[706900211]},{"nodeId":706900211,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":916600250,"text":"ふふ、『小さな魔女と消えない炎』っていう物語を読んだことはある？","nextNodeIds":[706900212,706900214]},{"nodeId":706900212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3266520970,"text":"どこかで読んだことがあるような…","nextNodeIds":[706900213]},{"nodeId":706900213,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":2421606794,"text":"それなら説明しやすいね。内容は全然関係ないけど、この本は一応、あの物語のために作られた辞典ってことになるんだ。","nextNodeIds":[706900216]},{"nodeId":706900216,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":912481810,"text":"そんなふうに説明されたら、余計にわからなくなったぞ！","nextNodeIds":[706900217]},{"nodeId":706900217,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":389426026,"text":"うーん、どこから話せばいいかしら…魔女会が三首会談でファルカに「約束」をしたことは知ってるよね？","nextNodeIds":[706900218]},{"nodeId":706900218,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":2033506122,"text":"「モンドが最も助けを必要とする時、魔女たちはこの地に戻り、モンドの力になると。」","nextNodeIds":[706900219]},{"nodeId":706900219,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":920783746,"text":"でも、大人しく危機が訪れるのを待つなんて、魔女会らしくない。","nextNodeIds":[706900220]},{"nodeId":706900220,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":2274253842,"text":"「物語の終盤になって突然英雄が現れるよりも、事前に伏線を張っておいたほうが納得できる」って、Mも言ってた。","nextNodeIds":[706900221]},{"nodeId":706900221,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":2482939554,"text":"それに危機がいつ訪れるかなんて、誰にも分からないもの。来世かもしれないし、明日かもしれない。準備はしておかないと！","nextNodeIds":[706900222]},{"nodeId":706900222,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":3099687226,"text":"だから魔女たちにこの辞典を書いてもらったんだ。もちろん、例の物語本を口実にしてね。そうでもしないと、みんな集まってくれないから。","nextNodeIds":[706900223,706900224]},{"nodeId":706900223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2733118306,"text":"大変だったんだね。","nextNodeIds":[706900225]},{"nodeId":706900225,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":2379602938,"text":"簡単に言うと、この辞典には、バービーの水占の盤を見た魔女たちが作った、モンドの人々のための「課題」がたくさん載ってるの。","nextNodeIds":[706900226]},{"nodeId":706900226,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":3727064122,"text":"共通の目標のために、仲間たちと一緒に困難を乗り越えて成長する…それこそ、危機が訪れる前にできる最良の準備。","nextNodeIds":[706900227]},{"nodeId":706900227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3892655266,"text":"それって、なんかとんでもないことが起こるみたいに聞こえるぞ！","nextNodeIds":[706900228]},{"nodeId":706900228,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":2539303786,"text":"そんなことは言ってないよ。ただ「仲間」と言っても、モンドのみんなにとって仲間と呼べる人物は、一人しかいないかもしれないね。","nextNodeIds":[706900229,706900230]},{"nodeId":706900229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":375745522,"text":"なるほど、やっと分かった。","nextNodeIds":[706900231]},{"nodeId":706900231,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4101530306,"text":"もしかして、最初からこの話にオイラたちを巻き込もうとしてたのか？","nextNodeIds":[706900232]},{"nodeId":706900232,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":3758258690,"text":"えぇ？まさかこんなことになるなんて、思ってもみなかった。","nextNodeIds":[706900233]},{"nodeId":706900233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2941599162,"text":"うぅ、ズルいぞ、アリス…","nextNodeIds":[706900234]},{"nodeId":706900234,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":1539473730,"text":"ふふっ。でもこんな重要なものを、軽々しくテイワットに持ち込むわけにはいかないでしょ？","nextNodeIds":[706900235]},{"nodeId":706900235,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":1781836994,"text":"だから「木を隠すなら森の中」って言葉にならうことにしたの。これらの本は、注目されないように、わざわざ私が図書館に寄贈したんだ。","nextNodeIds":[706900236]},{"nodeId":706900236,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":1416998794,"text":"別に悪いことじゃないしね。あなたたちにとっても、仲間に会える良い機会になるんだし、私を助けると思って、ね？","nextNodeIds":[706900237]},{"nodeId":706900237,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1037197746,"text":"まったく、おまえには敵わないな。でも、モンドのみんなを助けられるなら、オイラたち、協力するぞ。","nextNodeIds":[706900238]},{"nodeId":706900238,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":33030506,"text":"この辞典はオイラたちが預かっとくぜ。今度みんなに会う時、本の中の「課題」を届けてあげよう。","nextNodeIds":[706900239]},{"nodeId":706900239,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":4284500338,"text":"本当にありがとう。それじゃあ、あまり長居はしないでおくね。仲間たちと楽しく過ごせるよう、祈ってるよ！","nextNodeIds":[]},{"nodeId":706900230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":786901066,"text":"最初からこうなる気がしてた。","nextNodeIds":[706900231]},{"nodeId":706900224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4234145338,"text":"#それで、この本は{M#俺}{F#私}たちと何か関係あるの？","nextNodeIds":[706900225]},{"nodeId":706900214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2198005394,"text":"聞いたことすらない。","nextNodeIds":[706900215]},{"nodeId":706900215,"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","textMapHash":4118960066,"text":"読んだことがなくても大丈夫。その物語のために作られた辞典ってことになってはいるけど、内容はまったく関係ないと言っていいくらいだから。","nextNodeIds":[706900216]},{"nodeId":706900206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2747028978,"text":"魔女と言えば…","nextNodeIds":[706900207]}]}],"questNarration":[],"talkIds":[7069001,7069002],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":15181,"speakerName":"アリス","count":19},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","count":12},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName"