:[{"nodeId":706900101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3677244522,"text":"うわぁ、本がいっぱいだ！","nextNodeIds":[706900102]},{"nodeId":706900102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":957349546,"text":"図書館で本を整理するだけなのに、特級の依頼だって言われたから、オイラも覚悟はしてたけど…","nextNodeIds":[706900103]},{"nodeId":706900103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":569035586,"text":"それにしたって、これはすごすぎるぞ…","nextNodeIds":[706900104]},{"nodeId":706900104,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3032339834,"text":"あら、可愛い子ちゃん、それにパイモンちゃんも。モンドに戻ってくる時間ができたの？","nextNodeIds":[706900105]},{"nodeId":706900105,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1612290410,"text":"もしかしてお姉さんのことが恋しくなっちゃって、わざわざ会いに来てくれたのかしら？","nextNodeIds":[706900106,706900108]},{"nodeId":706900106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1871214306,"text":"その通りだよ。","nextNodeIds":[706900107]},{"nodeId":706900107,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2722630890,"text":"しばらく見ないうちに、ずいぶん口が達者になったわね。","nextNodeIds":[706900109]},{"nodeId":706900109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":632903218,"text":"やっと見つけたぞ、リサさん。てっきり今日はいないのかと思ってたぜ。","nextNodeIds":[706900110]},{"nodeId":706900110,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1602418738,"text":"ふふっ、今日はもともと働くつもりはなかったのよ。でも、キャサリンから「ようやく誰かが図書館の重要な依頼を受けてくれた」って聞いたものだから、ちょっと様子を見に来たの。","nextNodeIds":[706900111]},{"nodeId":706900111,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1494091370,"text":"あっ、もしかして…依頼を受けてくれたのはあなたたち？","nextNodeIds":[706900112,706900113]},{"nodeId":706900112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2057815658,"text":"そのとおり。","nextNodeIds":[706900114]},{"nodeId":706900114,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3736053234,"text":"それなら本当に助かるわ。見ての通り、最近とある匿名希望の支援者さんが、図書館に大量の本を寄贈してくれたの。","nextNodeIds":[706900115]},{"nodeId":706900115,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2223014962,"text":"目録をざっと確認したけど、どれも図書館にはなかった新しい本ばかり。","nextNodeIds":[706900116]},{"nodeId":706900116,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":381333554,"text":"それにジャンルも様々で、かなり厄介な禁書も何冊か混じっていたわ…こうなってくると、適当に誰かを呼んで雑用を頼むわけにもいかないでしょ？","nextNodeIds":[706900117]},{"nodeId":706900117,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2363085346,"text":"それで本当に困っていたの…本の分類と整理を全てお姉さん一人でしていたら、どれだけ時間がかかるか分からないもの。","nextNodeIds":[706900118]},{"nodeId":706900118,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":933624890,"text":"でも、あなたたちが来てくれたなら安心だわ。","nextNodeIds":[706900119]},{"nodeId":706900119,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2610158002,"text":"アフタヌーンティーをご馳走したいところだけど、この状況だとそれも難しそうね。","nextNodeIds":[706900120]},{"nodeId":706900120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3075040066,"text":"大丈夫だぞ！リサさんの依頼なら、オイラたちに任せてくれ！","nextNodeIds":[706900121]},{"nodeId":706900121,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2622337122,"text":"パイモンちゃんは優しいわね。それじゃあ、ここはあなたたちにお願いするわ。邪魔にならないよう、わたくしはここで失礼するわね。","nextNodeIds":[]},{"nodeId":706900113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1076739850,"text":"ここには他に誰もいないでしょ？","nextNodeIds":[706900114]},{"nodeId":706900108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2999895834,"text":"さっそく本題に入ろう。","nextNodeIds":[706900109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7069002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1004","201004014,1"],"