Count":0},"dialogs":[{"nodeId":735070101,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":1348447626,"text":"#「ゴールド流星」の{NICKNAME}に「シルバー伴星」のパイモン…久しぶりね。","nextNodeIds":[735070102]},{"nodeId":735070102,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":2150370322,"text":"相変わらず元気そうじゃない！","nextNodeIds":[735070103,735070106]},{"nodeId":735070103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4085813442,"text":"また会ったね！","nextNodeIds":[735070104]},{"nodeId":735070104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2863894122,"text":"おまえ、ハ…ハニヤー！それに責任感が超強い…バルフォアじゃないか？","nextNodeIds":[735070105]},{"nodeId":735070105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1153695418,"text":"まさか、またオルモス港で会えるなんて思わなかったぜ！","nextNodeIds":[735070114]},{"nodeId":735070114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2704980306,"text":"ところで、ハニヤーとバルフォアはこんなところでなにしてるんだ？ここって確か、「フラワーゼリー」の屋台があったんだよな…","nextNodeIds":[735070115]},{"nodeId":735070115,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":2979328762,"text":"これはこれは、大英雄のお二人さんじゃないか！君たちの声を聞いてるだけで、なんだか俺も自信が湧いてくるぜ。","nextNodeIds":[735070116]},{"nodeId":735070116,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":1797609482,"text":"さて、お二人に仕事の成果を報告する時だ。","nextNodeIds":[735070117]},{"nodeId":735070117,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":3585044050,"text":"前回、お二人は「サウマラタ蓮杯テイマー大会」のチャンピオンとして、大会の開催を一旦休止し、教令院に「叡智宝珠」を改良させた。","nextNodeIds":[735070118]},{"nodeId":735070118,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":2221112650,"text":"お二人はまだ、こいつの知らせを待ってるかい？","nextNodeIds":[735070119]},{"nodeId":735070119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2635233066,"text":"おう！進展があったら、レイラかセノ、それか担当の学者が知らせに来てくれるはずだぜ！","nextNodeIds":[735070120,735070121]},{"nodeId":735070120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3252717314,"text":"パイモンはこんなこと分からないもんね。","nextNodeIds":[735070122]},{"nodeId":735070122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2709830074,"text":"そうなんだよな。オイラたちが聞いたところで役に立てないし、むしろ邪魔になっちゃうかもしれないだろ…","nextNodeIds":[735070123]},{"nodeId":735070123,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":2338421274,"text":"君たちはずいぶん落ち着いてるな！それに慎重だ。俺なんか、前回の大会の盛り上がりをしょっちゅう思い出しては、うずうずしちまって…","nextNodeIds":[735070124]},{"nodeId":735070124,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":1070765882,"text":"それでこないだ、教令院の関係者に何とか状況を聞いたんだが…そしたら詳しい返答が帰ってきたんだ——","nextNodeIds":[735070125]},{"nodeId":735070125,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":4050536858,"text":"今んとこ、改良版「叡智宝珠」は未だに理論段階で、生産までには、まだまだ時間がかかるらしい。","nextNodeIds":[735070126]},{"nodeId":735070126,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":1417913290,"text":"だが、第一回の大会の話題性は薄れて、だんだん忘れ去られつつある。このまま大会の影響力を無駄にしていちゃいけない。","nextNodeIds":[735070127]},{"nodeId":735070127,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":2982554706,"text":"そこで、俺はハニヤーさんを見つけだして、新しい「テーマイベント」を開催することにしたんだ。","nextNodeIds":[735070128]},{"nodeId":735070128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":484624082,"text":"「テーマイベント」？","nextNodeIds":[735070129]},{"nodeId":735070129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3198188642,"text":"もしかして、机の上にある…このキノコンの形をした駒のことか？","nextNodeIds":[735070130]},{"nodeId":735070130,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":2614278058,"text":"そうよ。","nextNodeIds":[735070131]},{"nodeId":735070131,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":71440650,"text":"バルフォアさんは次の大会のために、ずっと新しい案を準備してたわ。資金調達に走り回って、ビジネスの勉強のために璃月にまで行って来たのよ。","nextNodeIds":[735070132]},{"nodeId":735070132,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":1116039978,"text":"璃月で経営を学んでいたときに、彼は「機関棋譚」という新しいゲームに出会った。","nextNodeIds":[735070133]},{"nodeId":735070133,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":1608689122,"text":"それでバルフォアさんは、「機関棋譚」をスメールで開催する権利を買い取って、私を顧問に雇い——目新しいゲームを一緒に企画したってわけ。","nextNodeIds":[735070134]},{"nodeId":735070134,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":1767460698,"text":"その名も「チエキノコン布陣」。","nextNodeIds":[735070135]},{"nodeId":735070135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1838019930,"text":"「チエキノコン布陣」？","nextNodeIds":[735070136]},{"nodeId":735070136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2529530202,"text":"待てよ、当ててやるぜ…今回はキノコンを指揮して、色んな機関と戦えって言うんだろ！","nextNodeIds":[735070137]},{"nodeId":735070137,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":2110993058,"text":"はは、さすが「シルバー伴星」だ。一発正解だな！","nextNodeIds":[735070138]},{"nodeId":735070138,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":3600172138,"text":"俺が思うに、このゲームは理解しやすいし、広めやすい。とんでもない将来性を秘めてるんだ。","nextNodeIds":[735070139]},{"nodeId":735070139,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":2336103122,"text":"「テイマー大会」の派生ゲームという名目で流行らせられれば、みんなに大会を覚えてもらえるし、期待してもらえる。","nextNodeIds":[735070140]},{"nodeId":735070140,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":2146367666,"text":"そしたら、次の大会を開催する時、より沢山の選手と観客を集められるだろう？","nextNodeIds":[735070141]},{"nodeId":735070141,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":118558818,"text":"もちろん、これにはまずお二人の許可が必要だ。何せ、今や大会の決定権を握っているのは君たちだからな。","nextNodeIds":[735070142,735070143]},{"nodeId":735070142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3100611266,"text":"試す価値はあると思う！","nextNodeIds":[735070144]},{"nodeId":735070144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3184058410,"text":"#そうだな。オイラも{NICKNAME}も、ビジネスのことはよくわかんないけど、バルフォアの言ったことは筋が通ってると思うぞ！","nextNodeIds":[735070145]},{"nodeId":735070145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":541843962,"text":"これはハニヤーとバルフォアが一緒に頑張った結果なんだし、おまえたちの才能を信じてるから、思い切ってやってみてくれ！","nextNodeIds":[735070146]},{"nodeId":735070146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":955233482,"text":"オイラはまだプレイしたわけじゃないけど、きっと沢山の人がハマってくれると思うぞ！","nextNodeIds":[735070147]},{"nodeId":735070147,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":3340130938,"text":"そう言ってくれてよかった！お二人さんから許可も得たことだし、これからは思い切って「チエキノコン布陣」を広められるぜ。","nextNodeIds":[735070148]},{"nodeId":735070148,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":3286243314,"text":"現在、「チエキノコン布陣」はまだテスト段階にある。試遊してくれた人からの意見を集めて、改良を重ねなくちゃならないんだ。","nextNodeIds":[735070149]},{"nodeId":735070149,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":3681405674,"text":"テイワットで流行りのゲームを数十種も熟知する「ゴールド流星」にも遊んでもらえれば、きっと的確なアドバイスがもらえると思うんだが！","nextNodeIds":[735070150]},{"nodeId":735070150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4294452482,"text":"#よし行け、{NICKNAME}！おまえの得意分野の一つだぜ！","nextNodeIds":[735070151,735070152]},{"nodeId":735070151,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3218809578,"text":"なんか指揮されたような…","nextNodeIds":[735070153]},{"nodeId":735070153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2015317370,"text":"でも、その…もう一つハニヤーに聞きたいことがあるんだけど…","nextNodeIds":[735070154]},{"nodeId":735070154,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":4288436986,"text":"ポコポコビーニーたちのこと？","nextNodeIds":[735070155]},{"nodeId":735070155,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2303223482,"text":"その通りだ！キノコンの仲間たちが恋しいんだ。あいつらは今、どうしてるんだ？","nextNodeIds":[735070156]},{"nodeId":735070156,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":4152945730,"text":"安心して。みんな元気で、気ままな毎日を生きてるわ！","nextNodeIds":[735070157]},{"nodeId":735070157,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":4211820258,"text":"テンテンヨーヨー獣と百雷遮羅は、<color=#00E1FFFF>オルモス港の北にある私の仮住まい</color>にいる。前回の参加者がしばらく世話をしてくれているの。","nextNodeIds":[735070158]},{"nodeId":735070158,"roleType":"TALK_ROLE_NPC","speakerId":30318,"speakerName":"ハニヤー","textMapHash":4236490282,"text":"ポコポコビーニーと喜炎はすぐ近くにいるから、一緒に遊んであげるといいわ、「シルバー伴星」さん。","nextNodeIds":[735070159]},{"nodeId":735070159,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2286062370,"text":"#近くにいるんだな！じゃあ{NICKNAME}、あとでおまえが新しいゲームを遊んでる間、オイラはポコポコビーニーと遊んでくるぜ！","nextNodeIds":[735070160,735070161]},{"nodeId":735070160,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":913548922,"text":"行ってらっしゃい！","nextNodeIds":[735070162]},{"nodeId":735070162,"roleType":"TALK_ROLE_NPC","speakerId":30319,"speakerName":"バルフォア","textMapHash":3937628106,"text":"それじゃあ早速、「ゴールド流星」にテスト版「チエキノコン布陣」を体験していただこう！","nextNodeIds":[]},{"nodeId":735070161,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1502783850,"text":"#{M#俺}{F#私}もすぐ行くから！","nextNodeIds":[735070162]},{"nodeId":735070152,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":161498226,"text":"うん、「ゴールド流星」出撃！","nextNodeIds":[735070153]},{"nodeId":735070143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3026646834,"text":"色々と骨を折らせたね！","nextNodeIds":[735070144]},{"nodeId":735070121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3507374370,"text":"#{M#俺}{F#私}には分からないから、口出ししない。","nextNodeIds":[735070122]},{"nodeId":735070106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":576575506,"text":"#{M#君}{F#あなた}たちは？","nextNodeIds":[735070107]},{"nodeId":735070107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2543549834,"text":"#{NICKNAME}、なに言ってるんだよ？","nextNodeIds":[735070108]},{"nodeId":735070108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":477438162,"text":"前、「サウマラタ蓮杯テイマー大会」に参加して、キノコンの仲間たちと楽しく遊んだだろ！","nextNodeIds":[735070109]},{"nodeId":735070109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4294180482,"text":"ハニヤーはそのとき知り合った友達じゃないか。で、バルフォアは一番責任感に溢れてた大会のスタッフだったんだ。","nextNodeIds":[735070110]},{"nodeId":735070110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3757339010,"text":"まさか、キノコンの仲間の「ポコポコビーニー」とか「テンテンヨーヨー獣」のことも忘れちゃったのか？","nextNodeIds":[735070111,735070112]},{"nodeId":735070111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1353052258,"text":"あっ！思い出した！","nextNodeIds":[735070113]},{"nodeId":735070113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2618019426,"text":"ったく、びっくりさせるなよな。医者に見せたほうがいいかと思っちゃったぞ。","nextNodeIds":[735070114]},{"nodeId":735070112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1051048498,"text":"ははっ、冗談冗談！","nextNodeIds":[735070113]}]},{"talkId":7350704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonT