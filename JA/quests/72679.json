e,"talkIds":[7267901],"talks":[{"talkId":7267901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7267902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["72675","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7267901,"initDialog":726759801,"nextRandomTalks":[],"nextTalks":[],"npcId":[3159],"performCfg":"QuestDialogue/WQ/Inazuma_72675/Q7267598","priority":5,"questId":72679,"showRandomTalkCount":0},"dialogs":[{"nodeId":726759801,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":1334624266,"text":"ぬ、お前か。かなりの腕前だな…それにその「シャシンキ」も。立派な大妖狸になれたのに、狸じゃなかったのが実に残念だ。","nextNodeIds":[726759802]},{"nodeId":726759802,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":1078226860,"text":"まあ、とは言え吾輩の半分程度だがな。","nextNodeIds":[726759803,726759809,726759814]},{"nodeId":726759803,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1193274362,"text":"匂いについて…","nextNodeIds":[726759804]},{"nodeId":726759804,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":3164503482,"text":"初めて来た時、誰かが作ってくれた妖狸飯を食べただろ。","nextNodeIds":[726759805]},{"nodeId":726759805,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":2322746450,"text":"我ら妖狸一族は変化に長けている。あのクソ狐と勝負したとき、花見坂に丸ごと変身したこともある。まあ、惜しいことに最後には見抜かれたがな。","nextNodeIds":[726759806]},{"nodeId":726759806,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":3078291234,"text":"これは当時「偽花見坂事件」と呼ばれ、『隠神大囃子』という本にもなったから、有名なはず…ぬ、今はもう誰も知らないのか？","nextNodeIds":[726759807]},{"nodeId":726759807,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":3561204562,"text":"とにかく、吾輩たちの変化の術は卓越している。完璧すぎるがゆえに、同族を「気配」で区別する必要があるのだ。そうしないと、間違ってしまうからな。","nextNodeIds":[726759808]},{"nodeId":726759808,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":2954762082,"text":"お前らに飯を作った奴があのクソ狐じゃないなら、いったい誰なんだ？我ら妖狸の匂いを熟知し、法術が使える者はそう多くないはずだが…","nextNodeIds":[]},{"nodeId":726759809,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1088920682,"text":"修行について…","nextNodeIds":[726759810]},{"nodeId":726759810,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":3266424202,"text":"吾輩が吉法師と同じような年の頃、大妖狸「九百九」の十八ヶ所の旧跡を訪ねたことがある。そこは、かつて彼が妖狸の法術を世に知らしめた場所だ。","nextNodeIds":[726759811]},{"nodeId":726759811,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":302273282,"text":"例えば、影向参道で山鉾巡行をし、歌いながら山に登ったりな。彼は大御所様に変化したこともあるんだぞ。あれは本当に見事だった！","nextNodeIds":[726759812]},{"nodeId":726759812,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":3642363178,"text":"他の名所…遠く離れた海祇島の曚雲神社で、九百九は古代の大将惡王に変化したことがある。彼はその時、とある巫女に会わせろと言って、大騒ぎを起こしたのだ。","nextNodeIds":[726759813]},{"nodeId":726759813,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":168364626,"text":"要するに、小狸たちも狸の正道から外れてはいけない、ということだ。修行を重ねて初めて、一人前の強き大妖狸になれるのだからな。","nextNodeIds":[]},{"nodeId":726759814,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":2212622986,"text":"さらばだ。","nextNodeIds":[726759815]},{"nodeId":726759815,"roleType":"TALK_ROLE_NPC","speakerId":3159,"speakerName":"五百蔵","textMapHash":912449418,"text":"達者でぬ。吉法師は任せたぞ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267805,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7267901,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7267901,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"fini