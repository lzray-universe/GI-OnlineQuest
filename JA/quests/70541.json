Id":[30531],"performCfg":"QuestDialogue/WQ/V4.5CatCafe_70539/Q7054101","priority":5,"questId":70541,"showRandomTalkCount":0},"dialogs":[{"nodeId":705410101,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"「橙色騎士」","textMapHash":2276624042,"text":"にゃうー。","nextNodeIds":[705410102]},{"nodeId":705410102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2149067874,"text":"へへっ、橙色騎士もだいぶいい子になったな！","nextNodeIds":[705410103]},{"nodeId":705410103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1066973090,"text":"これからも、心やさしい、いい子でいろよ。みんなと幸せに暮らすんだぞ。","nextNodeIds":[705410104]},{"nodeId":705410104,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3703414650,"text":"わ、私もこの子の頭と耳を触ってみたいです…！","nextNodeIds":[705410105]},{"nodeId":705410105,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":3601440130,"text":"暴れていないときは、本当にいい子なんだけど…目の上にある傷は一体どうしたのかしら？","nextNodeIds":[705410106]},{"nodeId":705410106,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2738802962,"text":"復元ポーションの残留痕跡からして、橙色騎士は恐らくここにいるはずだ。","nextNodeIds":[705410107]},{"nodeId":705410107,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1168029754,"text":"ん？旅人とパイモン…それに、シスターロサリア。そちらの方は冒険者かい？","nextNodeIds":[705410108]},{"nodeId":705410108,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":921488090,"text":"どうやら、みんなすでに橙色騎士と友達になったみたいだね。","nextNodeIds":[705410109]},{"nodeId":705410109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1592949258,"text":"わぁ、アルベドじゃないか！？久しぶりだな！会えて嬉しいぜ。その…おまえの探してる場所って、ここで間違いないのか？","nextNodeIds":[705410110]},{"nodeId":705410110,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2199319074,"text":"調査小隊の隊長さんが動物保護施設を訪ねてくるだなんて、一体どんなご用かしら？","nextNodeIds":[705410111]},{"nodeId":705410111,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3212031234,"text":"隊長？騎士団の隊長さんなんですか？何の前触れもなしにそんなに偉い方がいらっしゃるなんて…おもてなしの用意が、何も…","nextNodeIds":[705410112]},{"nodeId":705410112,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":423011402,"text":"いえ、そ、そうじゃなくて…「ネコモコの城」は運営許可も下りた、ちゃんとした施設なんです！","nextNodeIds":[705410113]},{"nodeId":705410113,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":2336799866,"text":"保護施設の監査だと誤解したヴァレリナは、慌てて騎士団発行の書類を持って来ると、アルベドに「ネコモコの城」の運営目的について一生懸命説明した…\\n彼女は「調査小隊」の名前に度肝を抜かれたようだ。実際には、調査小隊は都市管理関連の仕事は担当していないのだが…","nextNodeIds":[705410114]},{"nodeId":705410114,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1793207666,"text":"緊張する必要はないよ。ボクはただ、部下の仕事に手を貸しているだけだ。今回訪ねてきたのは、その猫のためだよ。","nextNodeIds":[705410115]},{"nodeId":705410115,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3103530450,"text":"先日、「臨時猫隊員·症例No.3『橙色騎士』」が、世話係の武器官を気絶させ、城門まで逃げたところで、行方が分からなくなっていたんだ。","nextNodeIds":[705410116]},{"nodeId":705410116,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2259647546,"text":"「騎士団の紋章を身に着けた、調査小隊所属の大きな猫が城内で騒ぎを起こした」と知られれば、あまりいい影響にはならないだろう？だから、早めに事態を収めたほうがいいと思ってね。","nextNodeIds":[705410117]},{"nodeId":705410117,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"「橙色騎士」","textMapHash":1002010802,"text":"にゃー…","nextNodeIds":[705410118,705410119]},{"nodeId":705410118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":856677706,"text":"調査小隊の猫だったの？","nextNodeIds":[705410120]},{"nodeId":705410120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2633887146,"text":"橙色騎士が調査小隊の騎士を気絶させたのかよ！さっき、こいつの名前の前に、長ったらしい称号みたいなのをつけてたけど…なにか事情でもあるのか？","nextNodeIds":[705410121]},{"nodeId":705410121,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1713265738,"text":"実は二ヶ月前にも、橙色騎士は野外で迷子になってしまったんだ。その時トリックフラワーの蜜を食べてしまったらしくて、身体が三倍のサイズに膨れ上がってしまってね…ただ、詳しい原因は現時点ではまだ分かっていない。","nextNodeIds":[705410122]},{"nodeId":705410122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2797554994,"text":"三倍…！？普通のサイズの猫だって、怒り出したらけっこう怖いのに…三倍のサイズって言うと、ヒルチャールにだって襲い掛かれそうだぞ！","nextNodeIds":[705410123]},{"nodeId":705410123,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":1274721482,"text":"そう…道理であんなに緊張してたわけだわ。","nextNodeIds":[705410124]},{"nodeId":705410124,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2673127994,"text":"猫にとって…いや、すべての野生生物にとって、身体が大きいことにさほどメリットはないのよ。むしろ、目立ちやすくなるうえ、動きも鈍くなりがちで…","nextNodeIds":[705410125]},{"nodeId":705410125,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":1122867826,"text":"敵にすぐ見つかってしまうという危険に常に晒され、捕獲者に攻撃される頻度も上がることになる。つまり、極度の恐怖の中で生きることになるのよ…","nextNodeIds":[705410126]},{"nodeId":705410126,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":338512322,"text":"その通りだよ。調査小隊の拠点近くで橙色騎士を見つけたとき、身体は傷だらけで、かなり怯えていた。相当つらい目に遭ってきたんだろうね。","nextNodeIds":[705410127]},{"nodeId":705410127,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3343123266,"text":"そんな…可哀そうに…私、この子に攻撃されたって、もう悲しいなんて思いません。だって、私がもしこの子の立場だったら、きっと見知らぬ人や動物を警戒してたはずですから。","nextNodeIds":[705410128]},{"nodeId":705410128,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1776377578,"text":"いや、既に問題は解決したから、心配しないでくれ。前に、錬金薬の影響を消すことのできる復元ポーションを開発したんだけど、そのポーションで「橙色騎士」を元の姿にかなり近づけることができた。","nextNodeIds":[705410129]},{"nodeId":705410129,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2095655602,"text":"普通の猫と比べればまだ大きいけど、少なくとも生活に支障はなくなったし、騎士たちも交代で世話ができるようになった。","nextNodeIds":[705410130]},{"nodeId":705410130,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":4147146378,"text":"橙色騎士というのは、クレーがこの子の色に因んで付けてあげた名前だよ。みんなもぴったりの名前だと思って、スカーフまで作ってあげたんだ。","nextNodeIds":[705410131]},{"nodeId":705410131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1007356586,"text":"へへっ、示し合わせたわけでもないのに、おんなじ名前を思いつくなんて、オイラたち息ぴったりだな！","nextNodeIds":[705410132]},{"nodeId":705410132,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"「橙色騎士」","textMapHash":4069378042,"text":"にゃーん。","nextNodeIds":[705410133]},{"nodeId":705410133,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3027575426,"text":"でも、後遺症かな？橙色騎士は人に会うたび、ひどく緊張して警戒態勢に入るものだから、武器官や信号官たちは毎回大変な目に遭わされていたよ。クレーもしょっちゅう拠点に来られるわけじゃないしね。","nextNodeIds":[705410134]},{"nodeId":705410134,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2371069314,"text":"そんなこの子が、二人にこんなに懐くなんてね。小隊のみんなも、この様子を見たらきっと驚くと思うよ。","nextNodeIds":[705410135]},{"nodeId":705410135,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":11731274,"text":"それはもう——偉大なる救世主、栄誉騎士さんとネコネコ白魔法使いさんの手にかかれば！","nextNodeIds":[705410136]},{"nodeId":705410136,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":4106319554,"text":"どれだけ凶暴だった猫も、二人としばらく一緒に遊べばすぐに大人しくなって、可愛い一面を見せてくれるんですよ！","nextNodeIds":[705410137]},{"nodeId":705410137,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2965990506,"text":"そうか。なら、旅人とパイモン、橙色騎士を引き取る気はないかい？","nextNodeIds":[705410138]},{"nodeId":705410138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":586557714,"text":"えっ？いいのか？でも、橙色騎士はおまえの小隊の猫隊員なんじゃないのか？","nextNodeIds":[705410139]},{"nodeId":705410139,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1042717498,"text":"実は「臨時猫隊員」という肩書きもその場しのぎでつけたものでね。元々、順調に回復したら、責任をもって引き取ってくれる人を探すつもりだったんだ。","nextNodeIds":[705410140]},{"nodeId":705410140,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2513372234,"text":"調査小隊は騎士団の作戦部隊の一つだから、この子にとって理想的な居場所とは言えないと思う。","nextNodeIds":[705410141]},{"nodeId":705410141,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2214583370,"text":"顔馴染みの騎士が出動するたびに、拠点に残された橙色騎士は不安になってしまうだろうし、かと言って、隊と一緒に行動させれば、再びこの子を恐怖に晒してしまう。","nextNodeIds":[705410142]},{"nodeId":705410142,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2644740458,"text":"賢明な判断だと思うわ。","nextNodeIds":[705410143]},{"nodeId":705410143,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":806906562,"text":"一度恐怖に襲われた子は、できるだけ刺激から遠ざけてあげたたほうがいいでしょうね。完全に心が癒えるまで、少しずつトラウマを取り除いてあげないといけないわ。","nextNodeIds":[705410144]},{"nodeId":705410144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2829314274,"text":"じゃあ、塵歌壺にあったかい猫ハウスを作って、住んでもらうのはどうだ？あそこなら魔物にいじめられる心配もないし、安心して幸せに暮らせるぜ！","nextNodeIds":[705410145]},{"nodeId":705410145,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"「橙色騎士」","textMapHash":1468866082,"text":"にゃおー！","nextNodeIds":[705410146,705410147]},{"nodeId":705410146,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":646906018,"text":"うん！新しいペットは猫で決まり！","nextNodeIds":[705410148]},{"nodeId":705410148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":460547506,"text":"ホントにありがとな、アルベド！","nextNodeIds":[705410149]},{"nodeId":705410149,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3504425730,"text":"気にしないでくれ。暇があれば、橙色騎士を連れて拠点に寄ってくれると嬉しい。この子の元気な姿を、調査小隊のみんなにも見せてあげてほしいんだ。","nextNodeIds":[705410150]},{"nodeId":705410150,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":105569154,"text":"なんて感動的な場面…最高の猫ちゃん引き取りシーンを見届けることができて、本当によかったです。「ネコモコの城」で保護された動物が新しい家族を見つけた、最初の事例ですよ！","nextNodeIds":[705410151]},{"nodeId":705410151,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":1056680650,"text":"ちょっと、私の頭巾で涙を拭わないでよ…","nextNodeIds":[705410152]},{"nodeId":705410152,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":3855965874,"text":"ところで、シスターロサリアが動物と交流するのが好きだったとは、少し意外だね…","nextNodeIds":[705410153]},{"nodeId":705410153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3852896738,"text":"たしかにな。でも、なんとなくだけど…ロサリアには猫に親しまれる、なにかがあるような気がするぞ。本人でさえそれに気づいてないから、表に出てないだけでさ。","nextNodeIds":[705410154]},{"nodeId":705410154,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1966103098,"text":"雪大福もロサリアに懐いてたし、そのあと橙色騎士がやって来たばかりの時も、ロサリアが落ち着かせてやったんだからな！","nextNodeIds":[705410155]},{"nodeId":705410155,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":1526462546,"text":"コホン…私はただ、そばで見ていただけよ。","nextNodeIds":[705410156]},{"nodeId":705410156,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3057476354,"text":"私…ひらめいちゃいました、ロサリアさん！この数日間、栄誉騎士さんとネコネコ白魔法使いさんから、猫ちゃんと仲良くなるテクニックを色々教えていただきましたが…","nextNodeIds":[705410157]},{"nodeId":705410157,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3387646882,"text":"施設の事前準備期間をもうしばらく延長して、オープン前にひとまず学んだことを実戦してみます！えっと…「見習いネコネコ魔法使い」目指して、頑張ります…！","nextNodeIds":[705410158]},{"nodeId":705410158,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":2116330794,"text":"なので、「ネコモコの城」が正式にオープンしたら、どうか運営を助けていただけませんか？モンド全土の野良猫を一緒に助けてあげましょう！","nextNodeIds":[705410159]},{"nodeId":705410159,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1373679346,"text":"ロサリア、引き続きヴァレリナに手を貸してやるだろ？…猫を助ける魔法使いとシスターのコンビ、なかなか良さそうじゃないか！","nextNodeIds":[705410160]},{"nodeId":705410160,"roleType":"TALK_ROLE_NPC","speakerId":30520,"speakerName":"ロサリア","textMapHash":2823293954,"text":"…ま、いいわ。特に面倒なこともなくて、結構暇な仕事だし…引き続き傍観するのも悪くなさそうね。","nextNodeIds":[705410161]},{"nodeId":705410161,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":190897266,"text":"ボクは動物の保護事業に関してはあまり詳しくないけど、どうやら、重要な節目を迎えたみたいだね。おめでとう。","nextNodeIds":[705410162]},{"nodeId":705410162,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":4219082010,"text":"困っている野良猫を見かけたらここに連れてくるよう、他の騎士たちにも伝えておくよ。","nextNodeIds":[705410163]},{"nodeId":705410163,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":993891682,"text":"本当に、本当に、ありがとうございます！皆さんにはご用意できる限りの報酬をお渡ししますのでっ！","nextNodeIds":[705410164]},{"nodeId":705410164,"roleType":"TALK_ROLE_NPC","speakerId":30531,"speakerName":"ヴァレリナ","textMapHash":3552164762,"text":"お陰様で、「ネコモコの城」の事前準備も何とかうまくいきそうです。正式にオープンするときは、ぜひ皆さんにテープカットをお願いしますね！","nextNodeIds":[705410165]},{"nodeId":705410165,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2160718066,"text":"モラもたっぷりもらえたし、橙色騎士も引き取れたし…オイラ、すっごくいい気分だぜ！","nextNodeIds":[705410166]},{"nodeId":705410166,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":924161442,"text":"「ネコモコの城」がオープンする日が、今から楽しみだな！","nextNodeIds":[705410167]},{"nodeId":705410167,"roleType":"TALK_ROLE_NPC","speakerId":30530,"speakerName":"「橙色騎士」","textMapHash":1395283306,"text":"にゃおーん！","nextNodeIds":[]},{"nodeId":705410147,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3122138018,"text":"うん！橙色騎士を新居に迎えよう！","nextNodeIds":[705410148]},{"nodeId":705410119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":145800154,"text":"だから騎士団の紋章をつけてたんだ…","nextNodeIds":[705410120]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[1090_1:-0.084,0.000,8.221]"],"NOCCOBOFKHP":1090,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7054101],"speakerC