{"mainQuestId":70541,"title":"「橙色騎士」入隊！","description":"「ネコネコ救世主」と称されたあなたとパイモンの尽力のおかげで、大型ネコのお客さんはようやく大人しくなった…\\nしかし、このお客さんの姿を見れば分かる。どうやらまだまだ物語がありそうだ…","titleTextMapHash":4221595823,"descTextMapHash":1437120502,"mainQuestExcel":{"mainQuestId":70541,"titleTextMapHash":4221595823,"title":"「橙色騎士」入隊！","descTextMapHash":1437120502,"description":"「ネコネコ救世主」と称されたあなたとパイモンの尽力のおかげで、大型ネコのお客さんはようやく大人しくなった…\\nしかし、このお客さんの姿を見れば分かる。どうやらまだまだ物語がありそうだ…","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_ACTIVITY","activeMode":"PLAY_MODE_SINGLE","activityId":5183,"luaPath":"Actor/Quest/WQ70541","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5183,"chapterId":0,"descTextMapHash":1437120502,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":70541,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3821157737,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ70541","mainQuestTag":"MAINQUEST_TAG_ACTIVITY","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[170541],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[33486],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":4221595823,"type":"WQ","unlockDescTextMapHash":1858165166}},"flow":[{"subQuestId":7054101,"order":1,"stepDescription":"「ネコモコの城」に行く","stepDescTextMapHash":3094819980,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7054101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOH