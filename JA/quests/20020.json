1405,"speakerName":"アナ","textMapHash":2108755594,"text":"なるほど、なるほど…","nextNodeIds":[200200102]},{"nodeId":200200102,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3886153314,"text":"お兄ちゃん、この植物の料理以外の使い道、知ってる？","nextNodeIds":[200200103]},{"nodeId":200200103,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"アンソニー","textMapHash":1798175210,"text":"そんなの俺が知るわけないだろ…","nextNodeIds":[200200104]},{"nodeId":200200104,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"アンソニー","textMapHash":3959754674,"text":"俺が知ってるのは、これがどこで採れるかと、食べられるかどうかってことだけだ。","nextNodeIds":[200200105]},{"nodeId":200200105,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3042044098,"text":"うーん…じゃあ私、自分で見に行ってくる。心配しないで。植物を採ってくるだけで、魔物に近づいたりしないから。","nextNodeIds":[200200106]},{"nodeId":200200106,"roleType":"TALK_ROLE_NPC","speakerId":1408,"speakerName":"アンソニー","textMapHash":896942370,"text":"はぁ…ちゃんと分かってるならいいけど。","nextNodeIds":[200200107]},{"nodeId":200200107,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":17360906,"text":"分かってるってば。じゃあ、今日はちょっと遅くなるね。","nextNodeIds":[200200108,200200109]},{"nodeId":200200108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":93900986,"text":"まだ訓練してるの？","nextNodeIds":[200200110]},{"nodeId":200200110,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3433023626,"text":"旅人さん！ちょうどよかった。今、野外の植物を観察しに行こうとしてたところなの。","nextNodeIds":[200200111]},{"nodeId":200200111,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3674452266,"text":"冒険者はよく野宿するから、食料を探すのも大事な能力だってサイリュスさんが言ってた。","nextNodeIds":[200200112]},{"nodeId":200200112,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":1336706034,"text":"だから、まずは野外の植物を観察して、場所とか特徴を記録してから、ゆっくり覚えていこうと思ったんだ。","nextNodeIds":[200200113]},{"nodeId":200200113,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":1414644794,"text":"そしたら、もし野外で食料を探すことになっても、どれが食べられるものか分かるでしょ。","nextNodeIds":[200200114]},{"nodeId":200200114,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3141470378,"text":"でも…文字だけじゃ、さすがに分かりにくいかな。","nextNodeIds":[200200115]},{"nodeId":200200115,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3866370354,"text":"旅人さん、確かあなた「写真機」って道具を持ってたよね？","nextNodeIds":[200200116]},{"nodeId":200200116,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":212369474,"text":"その「写真機」で、何種類かの植物の生息環境を撮ってきてもらえないかな？","nextNodeIds":[200200117]},{"nodeId":200200117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":907059642,"text":"問題ない。","nextNodeIds":[200200118]},{"nodeId":200200118,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":1014038050,"text":"じゃあ、ドドリアン、イグサ、セシリアの花の生息環境を記録してきて。","nextNodeIds":[200200119]},{"nodeId":200200119,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":225133210,"text":"それから、標本にして保存したいから、その三種類の植物自体も採ってきてほしいな。","nextNodeIds":[200200120]},{"nodeId":200200120,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":2558277378,"text":"植物の生息環境を記録した写真と、本物の植物標本、それに詳しい文字での説明…","nextNodeIds":[200200121]},{"nodeId":200200121,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3034048058,"text":"私の「冒険者植物ノート」、きっといいものになるよ！","nextNodeIds":[200200122]},{"nodeId":200200122,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":675302930,"text":"それじゃお願いね、旅人さん。","nextNodeIds":[200200123]},{"nodeId":200200123,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":926256810,"text":"ドドリアンは清泉町の泉でたくさん採れるよ。それからイグサは奔狼領で見つかるはず。","nextNodeIds":[200200124]},{"nodeId":200200124,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":2753397906,"text":"セシリアの花は…もちろん星拾いの崖ね。","nextNodeIds":[200200125]},{"nodeId":200200125,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":3315875082,"text":"私は他の場所で引き続き植物を観察してるね。","nextNodeIds":[200200126]},{"nodeId":200200126,"roleType":"TALK_ROLE_NPC","speakerId":1405,"speakerName":"アナ","textMapHash":2843887866,"text":"写真を撮り終えたら、城内で落ち合いましょ。","nextNodeIds":[]},{"nodeId":200200109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4216004866,"text":"訓練はどうなった？","nextNodeIds":[200200110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2002001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_START","LNHLPKELCAL":["1405"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2002029,"order":2,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2002024,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[2002015],"talks":[{"talkId":2002015,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{