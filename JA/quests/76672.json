kerId":1005,"speakerName":"パイモン","textMapHash":3429221938,"text":"よし、これで終わりだ。拠点がすっかり新しくなったな。","nextNodeIds":[766720102]},{"nodeId":766720102,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3462190850,"text":"はい、拠点周辺の防備も改修が完了しました。これなら魔物だろうと、悪意に満ちた敵だろうと、簡単にはここを攻められないはずです。","nextNodeIds":[766720103]},{"nodeId":766720103,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":1311645738,"text":"灯台には、半月分の燃料が備蓄してあります。これだけあれば、たとえワイルドハントの魔物が押し寄せても、援軍が到着するまで持ち堪えられるはずです。","nextNodeIds":[766720104]},{"nodeId":766720104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1672108786,"text":"もうそこまで考えてるの？","nextNodeIds":[766720105]},{"nodeId":766720105,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":2483405346,"text":"あはは、つい最悪の状況を考えてしまいました…ですが備えは大切です。","nextNodeIds":[766720106]},{"nodeId":766720106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3841931698,"text":"とにかく拠点はできたんだし、これで一休みできるな！","nextNodeIds":[766720107]},{"nodeId":766720107,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3141437834,"text":"はい。なので一度、家に帰ろうかと。義父さんにもしばらく会えていませんし。","nextNodeIds":[766720108]},{"nodeId":766720108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":954574330,"text":"家に？そっか。ずっとここにいるから、おまえの家がピラミダにあるってこと、すっかり忘れてたぞ。","nextNodeIds":[766720109]},{"nodeId":766720109,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":1548559674,"text":"よかったら一緒に行きませんか？お二人にはお世話になりましたし、ぜひおもてなしをさせてください。","nextNodeIds":[766720110]},{"nodeId":766720110,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3679112258,"text":"パイモンさんが言っていた食事用の車両はこちらにも配備しましたが、やはり料理をするなら自宅のほうが便利ですから。","nextNodeIds":[766720111]},{"nodeId":766720111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1300220658,"text":"おいしいものを作ってくれるのか？じゃあ遠慮なく！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7667201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1324"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7667202,"order":2,"stepDescription":"ピラミダにあるイルーガの家へ向かう","stepDescTextMapHash":89719196,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7667202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_361100040:5225.431,340.113,9401.865,0.000,156.440,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7667202],"talks":[{"talkId":7667202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7667202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7667202,"initDialog":766720202,"nextRandomTalks":[],"nextTalks":[],"npcId":[15526],"performCfg":"QuestDialogue/WQ/NodKrai_76671/Q7667202","priority":5,"questId":76672,"showRandomTalkCount":0},"dialogs":[{"nodeId":766720202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":460420970,"text":"ホワイトベリークルムカケに、燻製フィッシュステーキ…ベリーとお肉のソテーに、夜廻りのスープまで…こんなにご馳走が並んでたら、食べきれないぞ！","nextNodeIds":[766720203]},{"nodeId":766720203,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":837862954,"text":"うーん…ライトキーパーたちの夕食と同じ量を用意したので、三人で食べるには少し多すぎたかもしれませんね。","nextNodeIds":[766720204]},{"nodeId":766720204,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3910846266,"text":"まあ大丈夫です、ゆっくり食べていてください。僕は義父さんのところへ少し顔を出してきますので。夜までここにいらしてもらっても構いませんよ。","nextNodeIds":[766720205,766720206]},{"nodeId":766720205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":294435050,"text":"こんなに料理が上手だったなんて…","nextNodeIds":[766720208]},{"nodeId":766720208,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":2951901418,"text":"実は、隊長になる前はよくみんなの食事を作っていたんです。ただ、最近はそういった時間がなかなか取れなくて。","nextNodeIds":[766720209]},{"nodeId":766720209,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3246539586,"text":"ピラミダには、本当に色々な場所から人が来ていて、食の好みもそれぞれ違います。ですから、どんな味付けの料理も一通り作れないと、みんなに楽しんでもらえないんです。","nextNodeIds":[766720210]},{"nodeId":766720210,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3815853178,"text":"今回はお二人の好みがあまり分からなかったので、色々なスタイルのものを作ってみました。どれかお口に合うものはありましたか？ぜひ教えてください。","nextNodeIds":[766720211,766720214]},{"nodeId":766720211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4010979770,"text":"#パイモンが好きなものは、{M#俺}{F#私}も好き。","nextNodeIds":[766720212]},{"nodeId":766720212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1497999994,"text":"なんだよ、それ！言っとくけど、あのベリーとお肉のソテーはオイラが先に目をつけたんだからな！横取りするなよ！","nextNodeIds":[766720213]},{"nodeId":766720213,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":2466048666,"text":"あはは、ご心配なく。足らなければ、もっと作りますから。僕の大事な隊員を空腹にはしておけません。","nextNodeIds":[766720216]},{"nodeId":766720216,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":1019748442,"text":"口で何と言おうと、好きなものを食べた時の幸せそうな表情は、嘘をつきませんから。","nextNodeIds":[766720217]},{"nodeId":766720217,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3212016514,"text":"みんなの幸せそうな笑顔を見ること以上に、嬉しいことなんてありません。","nextNodeIds":[766720218]},{"nodeId":766720218,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":1888820058,"text":"もしみんなを笑顔にできるなら、ライトキーパーとしての責務を果たすことも、美味しい料理を振る舞うことも、僕は喜んで引き受けます。","nextNodeIds":[766720219]},{"nodeId":766720219,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3630858250,"text":"お二人からすると些細なことかもしれませんが、これが僕の偽りなき願いです…","nextNodeIds":[766720220,766720221]},{"nodeId":766720220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3801903586,"text":"そんな風に自分を卑下しないで。","nextNodeIds":[766720222]},{"nodeId":766720222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3975301066,"text":"そうだぞ！みんなのために、こんなに色々やってきたんだ。絶対みんな感謝してるって！おまえが自分のことを悪く言ってばかりいたら、逆に怒るかもしれないぜ！","nextNodeIds":[766720223]},{"nodeId":766720223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1365466826,"text":"少なくとも、オイラと旅人が怒るからな！","nextNodeIds":[766720224]},{"nodeId":766720224,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":3197504138,"text":"あはは、ありがとうございます。さて、食事と関係のない話はここまでにしましょう。どうぞ料理を召し上がってください。","nextNodeIds":[]},{"nodeId":766720221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":506292898,"text":"ここまでできるなんて十分すごい。","nextNodeIds":[766720222]},{"nodeId":766720214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1298697082,"text":"イルーガの手料理なら何でも好き。","nextNodeIds":[766720215]},{"nodeId":766720215,"roleType":"TALK_ROLE_NPC","speakerId":1324,"speakerName":"イルーガ","textMapHash":2155350610,"text":"お世辞なんて言う必要ありませんよ。ですがそう言ってもらえると、もっと君の口に合う料理を作りたくなりますね。","nextNodeIds":[766720216]},{"nodeId":766720206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":566449050,"text":"パイモンなら食べきれる。","nextNodeIds":[766720207]},{"nodeId":766720207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":155335306,"text":"もちろんだぞ！せっかく作ってくれたんだから、ちゃんと全部食べなくっちゃな！それにしても、イルーガがこんなに料理上手だったなんて、びっくりだぜ！","nextNodeIds":[766720208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7667202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133611065","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["7667201","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCE