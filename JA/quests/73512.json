":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351201,"initDialog":735120101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342,30343],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351201","priority":5,"questId":73512,"showRandomTalkCount":0},"dialogs":[{"nodeId":735120101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":405861882,"text":"おお、ありがとう！勇敢な冒険者よ！","nextNodeIds":[735120102]},{"nodeId":735120102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":790633026,"text":"よかったよかった…さほど時間が経っていなかったからか、パーツはあまり壊されていない…少し修理すれば…","nextNodeIds":[735120103]},{"nodeId":735120103,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":793770,"text":"ヴィナヤックは機械を夢中でいじり始めた…","nextNodeIds":[735120104]},{"nodeId":735120104,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":450743322,"text":"…ヴィナヤック？","nextNodeIds":[735120105]},{"nodeId":735120105,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":823908290,"text":"ああ…もうすぐだから！あと少しだ！","nextNodeIds":[735120106]},{"nodeId":735120106,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3823300522,"text":"——ヴィ·ナ·ヤック！","nextNodeIds":[735120107]},{"nodeId":735120107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1476075410,"text":"うああっ！シュリヤ？いつからここに？","nextNodeIds":[735120108]},{"nodeId":735120108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2399252218,"text":"#{M#君}{F#あなた}がパーツをいじり始めた頃から…","nextNodeIds":[735120109]},{"nodeId":735120109,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3495412642,"text":"ここには魔物がいるから危険だって、君が言ったんだろ？どうしてその君までここに来た？","nextNodeIds":[735120110]},{"nodeId":735120110,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2116802722,"text":"…私たちのパーツが心配になっただけ。任務が終わらなくて、私まで教令院に戻れなくなるって事態を避けるためよ！","nextNodeIds":[735120111]},{"nodeId":735120111,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2895224418,"text":"はっ、思った通りだ——これを見てくれ、全部回収したぞ。帰ってさらに調整すれば、組み立て始められる。","nextNodeIds":[735120112]},{"nodeId":735120112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1187309522,"text":"そういえば、なんの機械のパーツなんだ？","nextNodeIds":[735120113]},{"nodeId":735120113,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3133278650,"text":"おっと、紹介し忘れてしまっていたな——これは「対ウェネト殺蟲大砲」さ。僕たちの学生時代の卒業プロジェクトだったぞ！","nextNodeIds":[735120114]},{"nodeId":735120114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1639739226,"text":"——なんでそんなマイナーなテーマなんだよ！","nextNodeIds":[735120115]},{"nodeId":735120115,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3423501002,"text":"君も卒業課題に取り組んだことがあれば、理由がわかったはずだよ…コホン、とにかくそれは重要じゃない。","nextNodeIds":[735120116]},{"nodeId":735120116,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1751090450,"text":"改めて自己紹介させて。私はアムリタ学院を卒業した学者で、シュリヤというの。専攻は砂漠生物学と環境学よ。","nextNodeIds":[735120117]},{"nodeId":735120117,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2092375018,"text":"…そしてこっちの機械バカはクシャレワー学院出身の学者で、専攻は応用ギミック術。","nextNodeIds":[735120118]},{"nodeId":735120118,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2534405402,"text":"——僕の名はヴィナヤックだ。先ほどはありがとう。","nextNodeIds":[735120119]},{"nodeId":735120119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3871760082,"text":"専攻がぜんぜん違うじゃないか…そんなんで協力関係を結べるのか？","nextNodeIds":[735120120]},{"nodeId":735120120,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3042753586,"text":"そこなのよね…そもそも、研究計画のためにこいつと卒業課題に取り組むって決めたこと自体が、間違いなく私の学生時代の一番大きな間違いだったのよ…","nextNodeIds":[735120121]},{"nodeId":735120121,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3101547578,"text":"そんなことないと思うけど。ほら、互いに無事卒業できたじゃないか？","nextNodeIds":[735120122]},{"nodeId":735120122,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1902824146,"text":"はっ、おっしゃる通りね！同級生たちより何年遅れたか、思い出させてやりましょうか？","nextNodeIds":[735120123]},{"nodeId":735120123,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1123465434,"text":"それでもちゃんと卒業はできただろ？去年ようやく計画が通った人もいるって聞いたぞ。","nextNodeIds":[735120124]},{"nodeId":735120124,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":4031506578,"text":"ああ…もうたくさん！こんな無意味な言い争いは、学生時代に散々味わったので充分よ！","nextNodeIds":[735120125]},{"nodeId":735120125,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":4132167650,"text":"けど毎回、君のほうが先に言い出すんじゃないか…","nextNodeIds":[735120126]},{"nodeId":735120126,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":527638266,"text":"はぁ？初めてプロトタイプを作る時だって——","nextNodeIds":[735120127,735120128]},{"nodeId":735120127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2074963826,"text":"ストップストップ！","nextNodeIds":[735120129]},{"nodeId":735120129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":320315194,"text":"まったく…こんなに仲が悪いとはな。教令院はどうしておまえら二人にこの件を任せたんだよ…","nextNodeIds":[735120130]},{"nodeId":735120130,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3065049954,"text":"はぁ、教令院に任せてもらった、とは言えないけどね…実は、この件はもともと、うちの学院のクナルが責任を持って管理していたことなの。","nextNodeIds":[735120160]},{"nodeId":735120160,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3094283362,"text":"彼は私たちの先生の、そのまた先生だとも言えるわ。当時、私たちの卒論の答弁も聞きに来てくれたのよ。","nextNodeIds":[735120161]},{"nodeId":735120161,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":755740914,"text":"もしかするとその時に、「学院の若者がなんとかウェネト砲を作ったことがある」って印象を与えちゃったのかもね。","nextNodeIds":[735120162]},{"nodeId":735120162,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1764982978,"text":"そんなこんなで今回、「若者をもっと輝かせるべきだ！」とか何とか言って、この件の解決を無理矢理私たちに任せたってわけ。","nextNodeIds":[735120163]},{"nodeId":735120163,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3544108106,"text":"お互い卒業してから、連絡もろくに取ってないって言うのに…","nextNodeIds":[735120131]},{"nodeId":735120131,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1310520706,"text":"僕の指導教員まで彼の説得に心を動かされてしまった…だが、これはこの「対ウェネト殺蟲大砲」の名を再び世に轟かせるチャンスだ！","nextNodeIds":[735120132]},{"nodeId":735120132,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3742966522,"text":"組み立てが終わったら、あの虫ケラどもを懲らしめてやるぞ！","nextNodeIds":[735120133]},{"nodeId":735120133,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":880784618,"text":"まーた始まった、この機械バカが。…でも私も、砂漠の生態バランスを維持するために、これらのウェネトが暴れる原因を究明したいの。","nextNodeIds":[735120134]},{"nodeId":735120134,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3252475666,"text":"冒険者さん、あなたって凄腕なんでしょう。私たちが砂漠に滞在している間、身の安全のためにあなたを雇えないかな？","nextNodeIds":[735120135,735120136]},{"nodeId":735120135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1531039826,"text":"充分なモラをお持ちなら何でもどうぞ。","nextNodeIds":[735120137]},{"nodeId":735120137,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":148965138,"text":"安心して。今回の任務については、他のサポートはともかく、経費だけは十分に用意してくれてるから…機械をアップグレードするために、誰かさんがその大半を使ってるけど。","nextNodeIds":[735120138]},{"nodeId":735120138,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3091404858,"text":"そ、それはすべて必要な出費だ！…というか君、そうやって普通に喋れるんじゃないか。なんで僕と話すときはいつもツンツンしてるんだよ？","nextNodeIds":[735120139]},{"nodeId":735120139,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1398669738,"text":"——ッ、それは話す対象にきちんと接する価値があるかどうかによって決めることなの！","nextNodeIds":[735120140]},{"nodeId":735120140,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2521601714,"text":"はぁ、こいつら、また始まったぞ…","nextNodeIds":[735120141,735120142]},{"nodeId":735120141,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4239121258,"text":"後で好きなだけケンカしていいから…","nextNodeIds":[735120143]},{"nodeId":735120143,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1654185402,"text":"あっ…ごめん。学生時代からの癖でつい…","nextNodeIds":[735120144]},{"nodeId":735120144,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3982325410,"text":"これらのパーツはまずアアル村に運んでさらに調整しないといけないから、単純計算で、早くても組み立ては明日になるでしょう？","nextNodeIds":[735120145]},{"nodeId":735120145,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":417934314,"text":"私たちの計画では、付近にウェネトが出没する場所に、「対ウェネト殺蟲大砲」を設置することになってるのよ。","nextNodeIds":[735120146]},{"nodeId":735120146,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":4036453154,"text":"設置音で他の魔物を引き寄せてしまうかもしれないから——その時が来たら、あなたの出番よ。","nextNodeIds":[735120147,735120148]},{"nodeId":735120147,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1727504794,"text":"問題ない。","nextNodeIds":[735120149]},{"nodeId":735120149,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2299061010,"text":"さあ、シュリヤ。もうさっきの続きを話していいだろう？僕が使った経費にはちゃんと正当な理由があるんだぞ。","nextNodeIds":[735120150]},{"nodeId":735120150,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1404099922,"text":"あなたッ…！まだ言うのね？いいわ！とことん付き合ってあげる！","nextNodeIds":[]},{"nodeId":735120148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3334094602,"text":"また明日。","nextNodeIds":[735120149]},{"nodeId":735120142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":471150994,"text":"まず仕事内容を説明してくれない？","nextNodeIds":[735120143]},{"nodeId":735120136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3127676834,"text":"このくらい、お安い御用。","nextNodeIds":[735120137]},{"nodeId":735120128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2214799546,"text":"もういい加減にして。","nextNodeIds":[735120129]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133309822","1"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[]