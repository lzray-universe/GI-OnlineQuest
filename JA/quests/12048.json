1034],"performCfg":"QuestDialogue/LQ/Mizuki_12048/Q1204801","priority":5,"questId":12048,"showRandomTalkCount":0},"dialogs":[{"nodeId":120480101,"roleType":"TALK_ROLE_NPC","speakerId":3210,"speakerName":"百日白白音","textMapHash":991504002,"text":"あっ、お客様、受付はこちらになります！","nextNodeIds":[120480102]},{"nodeId":120480102,"roleType":"TALK_ROLE_NPC","speakerId":3211,"speakerName":"柴葉紫","textMapHash":1982951130,"text":"こんなに人が大勢来るなんて…何か特別な日だったかしら？こうなるって知ってたら、人数制限をしてたのに…","nextNodeIds":[120480103]},{"nodeId":120480103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2301916482,"text":"おおっ、江村一玄斎の件が解決したおかげか、お店が大繁盛してるぞ。紫と白音も体調がだいぶ良くなったみたいだな！","nextNodeIds":[120480104]},{"nodeId":120480104,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":3969502202,"text":"おはよう、旅人、パイモン。予約しに来たのかな？","nextNodeIds":[120480105]},{"nodeId":120480105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1120801498,"text":"おう！さっそく今日お願いできるか？","nextNodeIds":[120480106]},{"nodeId":120480106,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":3568977506,"text":"じゃあ、二人にもう一枚、特別招待券を用意するよ。うちの貴賓だからね。","nextNodeIds":[120480107]},{"nodeId":120480107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1570087610,"text":"やった！オイラ、今度は美味しい食事からでもいいか？","nextNodeIds":[120480108]},{"nodeId":120480108,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":982866218,"text":"…おや、先日手を引くよう助言したばかりじゃったが、まさかこれほどまでに人で賑わっておるとは…あやうく繁盛店を捨てさせるところじゃったな。妾を恨んだりしておらぬか？","nextNodeIds":[120480109]},{"nodeId":120480109,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":99970650,"text":"恨むも何も、はなから神子の助言なんて検討にも入れてない。","nextNodeIds":[120480110]},{"nodeId":120480110,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":899651890,"text":"その口ぶり、相変わらずじゃのう。","nextNodeIds":[120480111]},{"nodeId":120480111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1072226602,"text":"またいきなり現れたな…","nextNodeIds":[120480112]},{"nodeId":120480112,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":3505085986,"text":"お早う、童たち。ゆうべの夜景はどうじゃった？","nextNodeIds":[120480113]},{"nodeId":120480113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4232085130,"text":"覗いてたの？","nextNodeIds":[120480114]},{"nodeId":120480114,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":244747458,"text":"覗く？あの木は鳴神大社の下にあるのじゃぞ？まさか、鳴神大社を引っ越せとでも？","nextNodeIds":[120480115]},{"nodeId":120480115,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":3431053242,"text":"「宮司様」、ここにはどのような御用件で？","nextNodeIds":[120480116]},{"nodeId":120480116,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":3728851258,"text":"ふむ…ただの散歩じゃよ。ついでに天領奉行からの知らせを伝えにな。","nextNodeIds":[120480117]},{"nodeId":120480117,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":2133520354,"text":"ゆうべ、瑞希のとこの一族が水中から引き上げたあやつじゃが、一命を取り留めたぞ。じゃが、精神が子供の頃にまで戻ってしまったようじゃ。","nextNodeIds":[120480118]},{"nodeId":120480118,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":2280770306,"text":"その程度で済んでよかったよ…それから神子にもお礼を言わせて。昨日の件を無事解決できたのは、キミのおかげだ。","nextNodeIds":[120480119]},{"nodeId":120480119,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":596142122,"text":"ほう？","nextNodeIds":[120480120]},{"nodeId":120480120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":678395386,"text":"な、何も言ってないよ…","nextNodeIds":[120480121]},{"nodeId":120480121,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":2677939082,"text":"キミとあたしの間で心の内を隠しきれないのは、いつも決まって神子のほうなんだぞ。","nextNodeIds":[120480122]},{"nodeId":120480122,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":2145824658,"text":"キミに対する劣等感や対抗心といった感情はもちろんある。むしろ、この二つの感情があるからこそ、今の事業を経営する活力を得られた。","nextNodeIds":[120480123]},{"nodeId":120480123,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":30345962,"text":"劣等感があたしを常に冷静にさせ、対抗心があたしの背中を押し続けてくれる。こういう負の感情も今や自分の中では上手く扱えてるから、キミがそこまで気を遣う必要はない。","nextNodeIds":[120480124]},{"nodeId":120480124,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":3256643498,"text":"はぁ…最初から互いにハッキリ言っておれば、童たちも行ったり来たりせずに済んだようじゃな。","nextNodeIds":[120480125]},{"nodeId":120480125,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":1623206042,"text":"旅人の行動にはちゃんと意味があったよ。「宮司様」の都合も考えないとね。","nextNodeIds":[120480126]},{"nodeId":120480126,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":1296905026,"text":"あの江村一玄斎は大勢の信者を集めた。彼の正体が明らかになる前に、鳴神大社の宮司様が軽率に介入して圧力をかけたら…","nextNodeIds":[120480127]},{"nodeId":120480127,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":1475260930,"text":"騒がしい信者たちが鳴神大社の名誉にどれだけの影響を及ぼしてたかは計り知れない。だから、宮司様は表向きに口を出さなくてよかったんだ。","nextNodeIds":[120480128]},{"nodeId":120480128,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":346322066,"text":"無論、妾もその可能性については考えておった。じゃが、やはり妾にとって気掛かりだったのは友の気持ち。だからこそ、あのような回りくどい方法を取ったのじゃ。","nextNodeIds":[120480129]},{"nodeId":120480129,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":418692442,"text":"神子…","nextNodeIds":[120480130]},{"nodeId":120480130,"roleType":"TALK_ROLE_NPC","speakerId":1034,"speakerName":"八重神子","textMapHash":129573082,"text":"相変わらず、面白いが可愛げのないやつじゃのう…やはり汝の悩みを妾が先回りして心配する必要なぞなかったようじゃ。","nextNodeIds":[120480131]},{"nodeId":120480131,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":2380159842,"text":"…あたしだって悩みはある。でも、悩みにはそれぞれほぐし方があるの。","nextNodeIds":[120480132]},{"nodeId":120480132,"roleType":"TALK_ROLE_NPC","speakerId":1097,"speakerName":"夢見月瑞希","textMapHash":3957292922,"text":"新しい招待券だよ、受け取って。","nextNodeIds":[]}]},{"ta