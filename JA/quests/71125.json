:6,"questId":71125,"showRandomTalkCount":0},"dialogs":[{"nodeId":711250101,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":1884586426,"text":"パトリック、もうやめよう！この実験の方向性は、科学院の指示を完全に背いてしまっている…","nextNodeIds":[711250102]},{"nodeId":711250102,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2783965522,"text":"科学院の指示？審査の書類に書かれた「本プロジェクトでは、経済面を含む諸々の効果が見込める技術の実用化を図るべきだ」ってやつか？","nextNodeIds":[711250103]},{"nodeId":711250103,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":700346002,"text":"彼らは、儲かるかどうかが知りたいだけだろ？そんなことはほっといて、私たちは引き続き実験を行ってデータを集めればいい。アナトール、振晶を買うためにも経費をもう少しくれないか…","nextNodeIds":[711250104]},{"nodeId":711250104,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":2578912178,"text":"経費はもう残り少ない。もし使い果たしたら、実験の協力者を雇うモラはどこから捻出するんだ？君が直接実験に参加するつもりか？","nextNodeIds":[711250105]},{"nodeId":711250105,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":521915258,"text":"覚えてるか、アナトール？「実験の野外実施における研究監督員は、必要時に研究者の研究を手伝わなければならない…」んだぞ。","nextNodeIds":[711250106]},{"nodeId":711250106,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":1979427674,"text":"実験のほうはアナトールに任せた。それに、結構な額の旅費をもらってるんだろ？少しばかり食事を抜けば…","nextNodeIds":[711250107]},{"nodeId":711250107,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":1616079866,"text":"おいおい、経費を捻出するために同僚に苦労を押し付けるつもりか。まったくパトリック、なんてことを考えるんだ！この経費は、僕が腌篤鮮を食べるために残しといたモラだ。君みたいなひどいやつには絶対に渡さない！","nextNodeIds":[711250108]},{"nodeId":711250108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":33068386,"text":"そうだそうだ！仕事は手を抜いてもいいけど、食事を抜くなんて絶対にダメだぞ！","nextNodeIds":[711250109]},{"nodeId":711250109,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":94793482,"text":"ああ、まさにその通り。","nextNodeIds":[711250110]},{"nodeId":711250110,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":1884591850,"text":"おや…ああ、やっぱり。深い真理を語る人が現れたと思ったら、君はかの有名な…","nextNodeIds":[711250111]},{"nodeId":711250111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2137600634,"text":"おう！オイラがかの有名なパイモンだ！","nextNodeIds":[711250112]},{"nodeId":711250112,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":1205772010,"text":"#じゃあ、こちらがかの有名な{NICKNAME}だな。","nextNodeIds":[711250113,711250114]},{"nodeId":711250113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1791146914,"text":"#{M#俺}{F#私}がかの有名な旅人！","nextNodeIds":[711250116]},{"nodeId":711250116,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":1679082978,"text":"とにかく、パイモンの言う通り、食費を節約するわけにはいかない！","nextNodeIds":[711250117]},{"nodeId":711250117,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":4145297234,"text":"じゃあ、どうすればいいのさ？モラ不足で実験ができなければ、「経済面を含む『諸々』の効果」の代わりに、私の「悲惨な人生」そのものが現実になる！","nextNodeIds":[711250118]},{"nodeId":711250118,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3166409794,"text":"はぁ…","nextNodeIds":[711250119]},{"nodeId":711250119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2065109266,"text":"ああ、そういうことだったのか。フォンテーヌ人二人がここでなにしてるんだろって、さっきから気になってたんだけど…","nextNodeIds":[711250120]},{"nodeId":711250120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1489360090,"text":"「モラモラ」の研究をしてたんだな？へへっ、それってもしかしてモラが永遠に湧き出てくる研究なのか？","nextNodeIds":[711250121]},{"nodeId":711250121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2104505354,"text":"#わぁ、{M#俺}{F#私}もその研究に混ぜて。","nextNodeIds":[711250122]},{"nodeId":711250122,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3583969490,"text":"そんな研究してるわけないだろ！だが、今の「諸々」の研究が、いずれ「モラモラ」に繋がると私は信じてる…","nextNodeIds":[711250123]},{"nodeId":711250123,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":3257595642,"text":"そのためには、まず経費の問題をどうにかしないと。それから、売れる発明品の設計も…","nextNodeIds":[711250124]},{"nodeId":711250124,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":92023738,"text":"ゴホンッ、偉大な発明は偉大な研究の副産物に過ぎない…研究をしていれば、奇抜な発明のアイデアがエイのように脳皮質から飛び出てくるはずだ…","nextNodeIds":[711250125]},{"nodeId":711250125,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":3872486594,"text":"確かに、そうだったら万々歳だけど。","nextNodeIds":[711250126]},{"nodeId":711250126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1835037322,"text":"ちょっと待った。なんだか、だんだん気になってきたぞ。いったいどんな研究をしてるんだ？","nextNodeIds":[711250127]},{"nodeId":711250127,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2861311106,"text":"ん？ああ、「振晶」という特殊な鉱石に関する研究をしてるんだよ。この「振晶」は、以前いろんな鉱石の性質をテストするときに発見した璃月の鉱石だ。","nextNodeIds":[711250128]},{"nodeId":711250128,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":913765234,"text":"「振晶」には、「発振晶」と「受振晶」という二種類がある。","nextNodeIds":[711250129]},{"nodeId":711250129,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3158246306,"text":"「発振晶」は特定の刺激を受けるとエネルギーを放出し、「受振晶」が共鳴を起こす。それによって特殊な効果が現れるんだ。","nextNodeIds":[711250130]},{"nodeId":711250130,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":1981448546,"text":"たしかに面白い現象だが、鉱石研究に対するフォンテーヌ科学院の態度は…ある理由によって、前よりも熱が冷めてる。","nextNodeIds":[711250131]},{"nodeId":711250131,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":3802938882,"text":"それにレモンドさんは、この研究プロジェクトに「経済効果」がないと考えてるらしい。まあ、一言で言えば、モラにならないってことだ。","nextNodeIds":[711250132]},{"nodeId":711250132,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3353913410,"text":"まったく、なんて浅はかなんだ！","nextNodeIds":[711250133]},{"nodeId":711250133,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":4144698290,"text":"はぁ…てなわけで、パトリックの経費申請はうやむやにされてね。経費の代わりに手に入ったのは、栄誉称号だけだ。","nextNodeIds":[711250134]},{"nodeId":711250134,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3746205234,"text":"最初は、この栄誉称号が信用の証明書代わりになって、北国銀行でモラを借りられるんじゃないかとも思ったんだが…","nextNodeIds":[711250135]},{"nodeId":711250135,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":2582709218,"text":"フォンテーヌ科学院のエンジニアって聞いたとたん、北国銀行の職員の口元に浮かんでいた笑みが春の雪のように融けてなくなった。","nextNodeIds":[711250136]},{"nodeId":711250136,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":56000458,"text":"まあ、科学院の人たちが昔から何度も使ってきた手法だから、通用するほうがおかしい。","nextNodeIds":[711250137]},{"nodeId":711250137,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":3600632402,"text":"見ての通り——経費は底をついて、実験に協力してくれる冒険者も雇えない…それに、設計や発明のアイデアも皆無って状況だ。","nextNodeIds":[711250138]},{"nodeId":711250138,"roleType":"TALK_ROLE_NPC","speakerId":30322,"speakerName":"アナトール","textMapHash":1304304098,"text":"そもそも、繁雑な工程を要する実験と実験場を準備する傍ら、発明品の設計を…しかも経費もない状況で異郷に身を置きながら進めるなんてこと、とてもじゃないが難易度が高い。","nextNodeIds":[711250139]},{"nodeId":711250139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2841194274,"text":"#そうだったのか。なぁ{NICKNAME}、オイラたちが手を貸してやろうぜ！","nextNodeIds":[711250140]},{"nodeId":711250140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2309030978,"text":"パイモンに大発明家になってもらおう！","nextNodeIds":[711250141]},{"nodeId":711250141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1467929850,"text":"発明のことはよくわかんないけど、実験の部分ならオイラたちも手伝えるんじゃないか？","nextNodeIds":[711250142]},{"nodeId":711250142,"roleType":"TALK_ROLE_NPC","speakerId":30152,"speakerName":"パトリック","textMapHash":3085128794,"text":"ほ、本当に手を貸してくれるのか？","nextNodeIds":[]},{"nodeId":711250114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1554848426,"text":"#{M#俺}{F#私}はそれよりもうちょい有名！","nextNodeIds":[711250115]},{"nodeId":711250115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1350404162,"text":"こんなことで張り合ってどうすんだよ！","nextNodeIds":[711250116]}]},{"talkId":7112503,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7405379","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7112501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":7112503,"initDialog":711250301,"nextRandomTalks":[],"nextTalks":[7112505],"npcId":[30152,30322],"performCfg":"QuestDialogue/WQ/CrystalLink3_71125/Q7112503","priority":5,"questId":71125,"showRandomTalkCount":0},"dialogs":[{"nodeId":711250301,"roleType":"TALK_ROLE_