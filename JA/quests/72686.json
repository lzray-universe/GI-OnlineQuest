01","priority":5,"questId":72686,"showRandomTalkCount":0},"dialogs":[{"nodeId":726860101,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":3120580866,"text":"名を聞いても？","nextNodeIds":[726860102]},{"nodeId":726860102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4116108994,"text":"#{NICKNAME}。","nextNodeIds":[726860103]},{"nodeId":726860103,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":2699771074,"text":"承知した、その名を覚えておこう。では、武者の誇りをかける覚悟はできたか？","nextNodeIds":[726860104,726860105]},{"nodeId":726860104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1295004850,"text":"えっ、いきなりどういうこと？","nextNodeIds":[726860106]},{"nodeId":726860106,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":950359706,"text":"うん？お前は決闘に来た武者ではないのか？","nextNodeIds":[726860107]},{"nodeId":726860107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":259251338,"text":"そんな話、まったく聞いてない。","nextNodeIds":[726860108]},{"nodeId":726860108,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":3943919226,"text":"何だと？「孤刀争逐」のことを知らないのか？","nextNodeIds":[726860109]},{"nodeId":726860109,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":1341072506,"text":"そんなはずは…知らせは貼っておいたというのに。","nextNodeIds":[726860110]},{"nodeId":726860110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1156039130,"text":"それ、どこに貼ってあるんだ？","nextNodeIds":[726860111]},{"nodeId":726860111,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":2868243178,"text":"ここだ。","nextNodeIds":[726860112]},{"nodeId":726860112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1669094618,"text":"そんなとこに貼っても意味ないだろ。こんな宣伝で人が来るのかよ！","nextNodeIds":[726860113]},{"nodeId":726860113,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":1652301818,"text":"ふん、社奉行が「容彩祭で刀を振り回すのは不適切だ」と言ったからだ。俺は離島で決闘するのを禁じられた上に、チラシを貼ることさえ禁止された。","nextNodeIds":[726860114]},{"nodeId":726860114,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":1799852570,"text":"それゆえ、ここを決闘の場として選んだ。チラシも近くに貼るしかない状況だった。","nextNodeIds":[726860115]},{"nodeId":726860115,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":1464014938,"text":"だが、試合を申し込みに来た武者はすでに四人いる。お前を加えれば、五人になるな。","nextNodeIds":[726860116]},{"nodeId":726860116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2229819786,"text":"#それでもここに来る人がいるなんて、変わったやつもいるんだな。そういえば、{NICKNAME}はなんでここに来たんだっけ。オイラ、なんで来たか全然覚えてないんだけど…","nextNodeIds":[726860117]},{"nodeId":726860117,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":1639993282,"text":"決闘のことを知らずにこの島へと辿り着くとは。お前はきっと、強い武道精神を持った勇士に違いない。","nextNodeIds":[726860118]},{"nodeId":726860118,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":2213652586,"text":"武に熱い想いを抱く者が引かれ合うのは、この世の常というもの。驚く必要はない。","nextNodeIds":[726860119]},{"nodeId":726860119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":941766522,"text":"どこの世界にそんな常識があんだよ！","nextNodeIds":[726860120]},{"nodeId":726860120,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":3049978586,"text":"ふふ、どうだ？参加する気はあるか？","nextNodeIds":[726860121]},{"nodeId":726860121,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":1032935314,"text":"もし他の四人の参加者に勝てたら、もちろん賞金をやろう。","nextNodeIds":[726860122]},{"nodeId":726860122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1897974586,"text":"考えてみる。","nextNodeIds":[726860123]},{"nodeId":726860123,"roleType":"TALK_ROLE_NPC","speakerId":30167,"speakerName":"安彦太郎","textMapHash":21954394,"text":"承知した。では、ゆっくりと考えるといい。","nextNodeIds":[]},{"nodeId":726860105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人",