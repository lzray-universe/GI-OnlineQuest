ter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7320401","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7320401,"initDialog":732040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4233],"performCfg":"QuestDialogue/WQ/Sumeru_73204/Q7320401","priority":5,"questId":73204,"showRandomTalkCount":0},"dialogs":[{"nodeId":732040101,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3980781090,"text":"小童二人がここで何をしておる？お前らもわしを「石植え」爺だと、笑いに来たか？","nextNodeIds":[732040102]},{"nodeId":732040102,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3268417882,"text":"わしは元気だ。村人の心配なぞいらん。","nextNodeIds":[732040103]},{"nodeId":732040103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1687518330,"text":"うわ、いきなりそこまで敵視しなくてもいいじゃないか。","nextNodeIds":[732040104]},{"nodeId":732040104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2902524042,"text":"誤解だ。オイラたちはアアル村の人間じゃないし、笑いに来たわけでもないぞ。","nextNodeIds":[732040105,732040107]},{"nodeId":732040105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3618710642,"text":"ただの通りすがり。","nextNodeIds":[732040106]},{"nodeId":732040106,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":2841359130,"text":"通りすがりだと？ふむ…","nextNodeIds":[732040110]},{"nodeId":732040110,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3602399162,"text":"普段は知り合いしかここには来やせん。あいつらはここの苗畑は諦めろとか、村に帰ろとか言ってくるのだ。","nextNodeIds":[732040111]},{"nodeId":732040111,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3802619898,"text":"それに何人かのクソガキが、よくここに来てはいたずらをしていきおる。","nextNodeIds":[732040112]},{"nodeId":732040112,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":322183690,"text":"お前たちのような格好は初めて見るな。若造たちは何者だ？","nextNodeIds":[732040113,732040116]},{"nodeId":732040113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":232392034,"text":"肉親を探している旅人。","nextNodeIds":[732040114]},{"nodeId":732040114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":185657618,"text":"そうだ。この目標のために、オイラたちは長い道のりを歩いてきたんだぞ。冒険しながら探してる。","nextNodeIds":[732040115]},{"nodeId":732040115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1485849762,"text":"#{NICKNAME}は、正義感のあるやつなんだ。","nextNodeIds":[732040119]},{"nodeId":732040119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2764037122,"text":"オイラたちは一人暮らしの老人をいじめるなんてこと、絶対しないぞ。","nextNodeIds":[732040120]},{"nodeId":732040120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3705542914,"text":"だからじいちゃん、心配するな。オイラたちは悪いやつじゃないぞ。","nextNodeIds":[732040121]},{"nodeId":732040121,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":2288528586,"text":"コホン、若造相手に謝るのは小恥ずかしいが、わしがよく見ておらんで、悪かったな。","nextNodeIds":[732040122]},{"nodeId":732040122,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":695022738,"text":"若造たちよ、このアファンは心から詫びる。","nextNodeIds":[732040123]},{"nodeId":732040123,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":2936525658,"text":"若いのに、自力で生きとるとは大したもんだ。わしの若い頃より立派だぞ。","nextNodeIds":[732040124]},{"nodeId":732040124,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":884928058,"text":"さっき言っとったことが本当ならば、ひとつお前たちに依頼してもいいか。わしじゃ解決できん問題があるのだ。","nextNodeIds":[732040125]},{"nodeId":732040125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1866385194,"text":"おっ？これは仕事の依頼ってやつか？","nextNodeIds":[732040126]},{"nodeId":732040126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3153221138,"text":"どんな問題？","nextNodeIds":[732040127]},{"nodeId":732040127,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3369572378,"text":"わしは二か所、苗畑を切り開いた。ここはそのうちの一つだ。もう一つは村の西の方にある。","nextNodeIds":[732040128]},{"nodeId":732040128,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":2849259482,"text":"だが、わしも年を取って、この頃は一人で世話しきれんでな。何日も行っとらんうちに、もう一つの苗畑が真っ黒い変なやつに荒らされてしもうた。","nextNodeIds":[732040129]},{"nodeId":732040129,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3850654610,"text":"とても危険で、危く帰ってこれんところだった。それで、あの地に行くのがずっと怖いのだ。","nextNodeIds":[732040130]},{"nodeId":732040130,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3787792634,"text":"今の一番の望みは、これからも花を育てられるように、苗畑の土をよくしたいということだ。","nextNodeIds":[732040131]},{"nodeId":732040131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":56622754,"text":"#複雑じゃなさそうだな。どうだ？{NICKNAME}。この依頼、引き受けてみるか？","nextNodeIds":[732040132]},{"nodeId":732040132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1262354866,"text":"いいよ。","nextNodeIds":[732040133]},{"nodeId":732040133,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3086818082,"text":"苗畑は村の西にある。道を間違えんでくれよ。","nextNodeIds":[732040134]},{"nodeId":732040134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2279802762,"text":"大丈夫だって、安心しろ！","nextNodeIds":[]},{"nodeId":732040116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2607946026,"text":"世界を探索する冒険者。","nextNodeIds":[732040117]},{"nodeId":732040117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1593234682,"text":"そうだ。オイラたちは高い山や、大きい湖をたくさん越えて、スメールにやってきたんだぞ。","nextNodeIds":[732040118]},{"nodeId":732040118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4182606090,"text":"オイラたちは…あれ、なんていったっけ。えっと…気宇壮大な冒険者だ。","nextNodeIds":[732040119]},{"nodeId":732040107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3219953594,"text":"ここで花を植えている人がいると聞いて。","nextNodeIds":[732040108]},{"nodeId":732040108,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":2465549818,"text":"そうだ。わしが植えたのは花だ。石ころなぞではない。","nextNodeIds":[732040109]},{"nodeId":732040109,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":1331333434,"text":"さっきはてっきり…ああ、どこから話せばいいか…","nextNodeIds":[732040110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_IND