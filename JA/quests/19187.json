D_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1918719,"initDialog":191871901,"nextRandomTalks":[],"nextTalks":[],"npcId":[1081],"performCfg":"QuestDialogue/COOP/CoopLynette/Q1918719","priority":5,"questId":19187,"showRandomTalkCount":0},"dialogs":[{"nodeId":191871901,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":4207680626,"text":"警察隊が駆けつけるまでは、私がここを見張ってる。安心しろ、もうこいつらに逃げるチャンスはない。","nextNodeIds":[191871902,191871903]},{"nodeId":191871902,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2660995970,"text":"もう一つ気になることが…","nextNodeIds":[191871904]},{"nodeId":191871904,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":2142908538,"text":"それは…本件の原料には真っ当な用途も色々ある。「偽造ロシ」の製造だけに使用するものではない。だから即座に違法とは言い切れない。","nextNodeIds":[191871905]},{"nodeId":191871905,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":3789637426,"text":"通常、港での押収は一時的なものだ。様々な申告をして承認が下りなければ、元の船に戻されることになる。エロルディは返還される前に、原料をすり替えたのだろう。","nextNodeIds":[191871906]},{"nodeId":191871906,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":4173566394,"text":"原料を運んできた外国の船にも、彼女が事前に連絡をしていたはずだ。だからすり替えられた貨物を受け取っても、何も言わなかった。","nextNodeIds":[191871907]},{"nodeId":191871907,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":1050113786,"text":"その犯行についても我々が引き続き捜査する。エロルディが捕まった今となっては、余罪の解明も時間の問題だ。","nextNodeIds":[]},{"nodeId":191871903,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1994344026,"text":"エロルディが原料をすり替えた方法は？","nextNodeIds":[191871904]}]},{"talkId":1918720,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1918705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1918720,"initDialog":191872001,"nextRandomTalks":[],"nextTalks":[],"npcId":[1071],"performCfg":"QuestDialogue/COOP/CoopLynette/Q1918720","priority":5,"questId":19187,"showRandomTalkCount":0},"dialogs":[{"nodeId":191872001,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":849462658,"text":"今日は「真面目モード」の時間が過去最高を記録したんじゃない？…実に珍しいね。一体誰のためなのかな？","nextNodeIds":[191872002,191872003]},{"nodeId":191872002,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":802831186,"text":"もう一つ気になることが…","nextNodeIds":[191872004]},{"nodeId":191872004,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":4010511914,"text":"うん…今までに得た手がかりからすると、「偽造ロシ」は最初、フォンテーヌで小規模に流通していたようだ。その小さな商いが次第に大規模な密輸に変わっていた。","nextNodeIds":[191872005]},{"nodeId":191872005,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":573231882,"text":"最初に流通したのは、ピエールが初期に製造した在庫品のはずだ。でもその稚拙な犯罪は、すぐに警察であるエロルディにバレた。","nextNodeIds":[191872006]},{"nodeId":191872006,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":4112574410,"text":"エロルディはそこに一攫千金と、別人になって新しい暮らしを手に入れるチャンスを見出した。それで彼の初期の犯行を密かに隠蔽して…","nextNodeIds":[191872007]},{"nodeId":191872007,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":1224538170,"text":"ベノワの名前で手紙を書いた。集めた犯罪の証拠と巨額の儲けをエサに、自分の今後の計画に協力するようピエールを脅したんだ。","nextNodeIds":[191872008]},{"nodeId":191872008,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":2321732754,"text":"ただ残念ながら、リネットに出会ってしまった。あの子は普段考えるのが好きじゃなさそうに見えるけど、「真面目モード」になると誰よりも鋭いんだ。","nextNodeIds":[191872009]},{"nodeId":191872009,"roleType":"TALK_ROLE_NPC","speakerId":1071,"speakerName":"リネ","textMapHash":725724610,"text":"…でもそのモードだと「エネルギー消費」が激しい。こっちはまだしばらく調書で時間が掛かるから、妹の「チャージ」は君に任せたよ。","nextNodeIds":[]},{"nodeId":191872003,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3171043650,"text":"ピエールはどうやって仲間に加わったの？","nextNodeIds":[191872004]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[108301,191870501],"PAINLIBBLDK":"QUEST_CONTENT_MAIN_COOP_ENTER_SAVE_POINT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133401830"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"gu