rformCfg":"QuestDialogue/AQ/NodKrai_6028/Q602803","priority":5,"questId":6028,"showRandomTalkCount":0},"dialogs":[{"nodeId":60280301,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"ラウマ","textMapHash":638752914,"text":"どうだ？傷口は痛むか？","nextNodeIds":[60280302]},{"nodeId":60280302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2408274082,"text":"……","nextNodeIds":[60280303]},{"nodeId":60280303,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2089443682,"text":"使えそうな薬を用意してもらった。必要なら飲むといい。","nextNodeIds":[60280304,60280305]},{"nodeId":60280304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1047464754,"text":"ありがとう…","nextNodeIds":[60280306]},{"nodeId":60280306,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":628052258,"text":"あのあと、アリスさんとこんな通話をしたんだ——","nextNodeIds":[60280307]},{"nodeId":60280307,"roleType":"TALK_ROLE_NPC","speakerId":1321,"speakerName":"アリス","textMapHash":3909697546,"text":"ドットーレのやつ…魔女会の意識をよそに向けるために、テイワットの境界で大きな騒ぎを起こしたみたい。","nextNodeIds":[60280308]},{"nodeId":60280308,"roleType":"TALK_ROLE_NPC","speakerId":1321,"speakerName":"アリス","textMapHash":1051269794,"text":"私はてっきり、世界の外から来たアビスの力がまたテイワットに干渉してるのかと思ったんだけど…","nextNodeIds":[60280309]},{"nodeId":60280309,"roleType":"TALK_ROLE_NPC","speakerId":1321,"speakerName":"アリス","textMapHash":2467964746,"text":"でも、ドゥリンちゃんたちがナド・クライの虚影に干渉できたことを知って、それがテイワットの内側から来たものだって気づいたの。","nextNodeIds":[60280310]},{"nodeId":60280310,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":326211394,"text":"それでも結局、ボクたちは虚影の運命を変えられなかった…","nextNodeIds":[60280311]},{"nodeId":60280311,"roleType":"TALK_ROLE_NPC","speakerId":1321,"speakerName":"アリス","textMapHash":4168786730,"text":"たしかに、あなたたちはあの虚影の結末を変えられなかったけど、ある「変数」があなたに蓄積されたのよ。","nextNodeIds":[60280312]},{"nodeId":60280312,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":1815154866,"text":"「変数」？","nextNodeIds":[60280313]},{"nodeId":60280313,"roleType":"TALK_ROLE_NPC","speakerId":1321,"speakerName":"アリス","textMapHash":3878818986,"text":"そう。たとえば、本来は知るはずもなかった情報を手に入れたり、普段は思いつかない考えが湧いたりすることも「変数」の一種なの。","nextNodeIds":[60280314]},{"nodeId":60280314,"roleType":"TALK_ROLE_NPC","speakerId":1321,"speakerName":"アリス","textMapHash":1498029058,"text":"もちろん、無数の可能性を前にしたら、それは些細なものかもしれない。でも意図的に「変数」を積み重ねれば、話は変わってくる。","nextNodeIds":[60280315]},{"nodeId":60280315,"roleType":"TALK_ROLE_NPC","speakerId":1321,"speakerName":"アリス","textMapHash":2092246506,"text":"その大量の「変数」が、この夜、旅人たちが転移の扉を開けたときに、ドットーレが陰謀を実行するための必要な条件になっていたの。","nextNodeIds":[60280316]},{"nodeId":60280316,"roleType":"TALK_ROLE_NPC","speakerId":1322,"speakerName":"ニコ","textMapHash":1008200650,"text":"けれど、ドットーレがいったい何をしたのかは、あたしたちにも分からないわ。","nextNodeIds":[60280317]},{"nodeId":60280317,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":2694013314,"text":"ああ。俺たちはコロンビーナの現状を把握する必要がある。","nextNodeIds":[60280318]},{"nodeId":60280318,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":1485717330,"text":"——こんな話をしたんだ。","nextNodeIds":[60280319]},{"nodeId":60280319,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":3137638946,"text":"ドットーレは姿を消したが、少なくともコロンビーナは彼の手中に落ちていない。","nextNodeIds":[60280320]},{"nodeId":60280320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1184464210,"text":"状況はみんなが思ってるより悪いかも…","nextNodeIds":[60280321]},{"nodeId":60280321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":836592306,"text":"えっ…","nextNodeIds":[60280322,60280323]},{"nodeId":60280322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1474343426,"text":"彼女は「博士」の計画を阻止するために…","nextNodeIds":[60280324]},{"nodeId":60280324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1016684890,"text":"なんだって！？","nextNodeIds":[60280325]},{"nodeId":60280325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3021738314,"text":"飛び込んだところを誰も見てないの？","nextNodeIds":[60280326]},{"nodeId":60280326,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":341987002,"text":"オイラたちは「博士」がなにか力を使ったあと、コロンビーナと同時に消えたところしか見てないぞ。あと、おまえが空から海に落っこちてくるところだな…","nextNodeIds":[60280327]},{"nodeId":60280327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2821479058,"text":"#（そっか…「博士」が時間を止めたとき、{M#俺}{F#私}だけが自由に動けてたから——）","nextNodeIds":[60280328]},{"nodeId":60280328,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1629305066,"text":"（みんなにとって、あの戦いとコロンビーナの決断は一瞬のことでしかないんだ。）","nextNodeIds":[60280329]},{"nodeId":60280329,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3880026866,"text":"#（あれが「三つの月」の権能…？{M#俺}{F#私}が影響を受けなかったのは…「降臨者」だから？）","nextNodeIds":[60280330]},{"nodeId":60280330,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":642629698,"text":"つまり、コロンビーナは自ら「月の扉」を開き、レリルとソリンディスがかつて足を踏み入れた謎の空間に落ちた…ってことかい？","nextNodeIds":[60280331]},{"nodeId":60280331,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":1460569642,"text":"厄介なことになったな…","nextNodeIds":[60280332]},{"nodeId":60280332,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":3691948082,"text":"……","nextNodeIds":[60280333,60280334]},{"nodeId":60280333,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1767051354,"text":"ドットーレがずっと姿を見せなかったのは…","nextNodeIds":[60280335]},{"nodeId":60280335,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":2459207906,"text":"ということは「三月の出現」も、月の狩人の出現も…ドットーレが裏で操っていたということだね。","nextNodeIds":[60280336]},{"nodeId":60280336,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":1632041610,"text":"アリスさんの話によると、彼は自分の運命を超えて、神にしか成し得ない実験をしようとしているらしい。","nextNodeIds":[60280337]},{"nodeId":60280337,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":3638378082,"text":"…狂気の沙汰としか言いようがない。","nextNodeIds":[60280338]},{"nodeId":60280338,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1081388586,"text":"そういえば、笠っちはどこいったんだ？","nextNodeIds":[60280339]},{"nodeId":60280339,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":2466193722,"text":"アリスさんと連絡を取った後、心当たりがあるって言って、ドド通話機を持って一人で調査に出かけたよ。","nextNodeIds":[60280340]},{"nodeId":60280340,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":3954751786,"text":"出かけるとき、すごく怖い顔をしてた…笠っちがあんな顔してるところ、ボクは見たことない…","nextNodeIds":[60280341]},{"nodeId":60280341,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":986870706,"text":"（怒りと悔しさのせいかな。ドットーレを十二分に警戒してたのに、結局いいようにやられてしまったから。）","nextNodeIds":[60280342]},{"nodeId":60280342,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1758464578,"text":"#（そういう意味では、{M#俺}{F#私}も同じだ…）","nextNodeIds":[60280343]},{"nodeId":60280343,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":2857564842,"text":"戻ったよ。","nextNodeIds":[60280344]},{"nodeId":60280344,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":2041236978,"text":"笠っち！","nextNodeIds":[60280345]},{"nodeId":60280345,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":1069292938,"text":"ヒュペルボレイアの虚影ともう一度話して、ようやくはっきりした。","nextNodeIds":[60280346]},{"nodeId":60280346,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":4293005338,"text":"あいつらに、通話機の向こうにいるニコと歴史の解釈が一致しているか試させたんだ。そしたら、案の定あいつらの語る歴史は、ニコの記憶と違っていた。","nextNodeIds":[60280347]},{"nodeId":60280347,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1245274890,"text":"どうなってんだ？ニコが間違って覚えてるわけないよな…","nextNodeIds":[60280348]},{"nodeId":60280348,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":3264477834,"text":"あの虚影たちが騙されているからさ。あいつらの歴史には、存在しないはずの救世主がいる。","nextNodeIds":[60280349]},{"nodeId":60280349,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":2981632314,"text":"その救世主は、そいつらのために偽りの空に新たな月を作り、月神を連れ帰ると約束した。","nextNodeIds":[60280350]},{"nodeId":60280350,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":3750813146,"text":"そしてやつらは愚かなことに、救世主が必要とする月に関する知識を、すべて洗いざらい教えてしまったんだ。","nextNodeIds":[60280351]},{"nodeId":60280351,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":3785601010,"text":"明らかにドットーレの仕業だろう。","nextNodeIds":[60280352]},{"nodeId":60280352,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"ラウマ","textMapHash":2972260570,"text":"ヒュペルボレイアの遺跡で、虚影が歴史について語るのを聞いたが、ニコさんはその中に誤りがあると言っておった…","nextNodeIds":[60280353]},{"nodeId":60280353,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1523045442,"text":"でも、ドットーレはあの扉の中に入れないはずだぞ！","nextNodeIds":[60280354]},{"nodeId":60280354,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":2926488298,"text":"そう、あいつは中に入っていない。ニコが言うには、これは同じ時代の虚影の因果に干渉したことで引き起こされた異常事態らしい。","nextNodeIds":[60280355]},{"nodeId":60280355,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":3834459354,"text":"つまりドットーレが積み重ねた「変数」は、あいつと会ったことのない虚影にも影響を与えられるほど巨大なものなのさ。","nextNodeIds":[60280356]},{"nodeId":60280356,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1440479714,"text":"記憶違いじゃなく、改ざんされていたってことか。","nextNodeIds":[60280357]},{"nodeId":60280357,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":3892307306,"text":"これこそドットーレがあらゆる手段を使って築き上げた「可能性」だ。あいつは変数を知識に変え、その身に積み重ねた。","nextNodeIds":[60280358]},{"nodeId":60280358,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":420117866,"text":"そして、祈月の夜の当日…あいつはその知識を使って、本当に「偽物の月」を作り出したんだ。","nextNodeIds":[60280359]},{"nodeId":60280359,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":969814802,"text":"そんなことできるもんなのか？","nextNodeIds":[60280360]},{"nodeId":60280360,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":3184233234,"text":"正確には月そのものを作ったんじゃなく、術式の感知を騙したんだ。","nextNodeIds":[60280361]},{"nodeId":60280361,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":2712041354,"text":"術式はクーヴァキで月の位置を感知する。「偽物の月」が天外の霜月よりもさらに月らしいものであれば…","nextNodeIds":[60280362]},{"nodeId":60280362,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":4250013082,"text":"ゲートはコロンビーナを「偽物の月」に送る——つまり、ドットーレの元に送るんだ！","nextNodeIds":[60280363]},{"nodeId":60280363,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":187179586,"text":"ドットーレがコロンビーナを制御下に置いた後も、転送の術は維持されたままだった。そしてあいつは少女の力を操り、二つの月髄を奪ったのさ。","nextNodeIds":[60280364]},{"nodeId":60280364,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"ラウマ","textMapHash":277505450,"text":"あの時、月髄は私たちの目の前で忽然と消えた…遺跡を出たときにはもう手遅れであった。","nextNodeIds":[60280365]},{"nodeId":60280365,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":4196900066,"text":"そうして、ドットーレは三つの月の力をすべて集めたのだな。","nextNodeIds":[60280366]},{"nodeId":60280366,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4241251506,"text":"オイラたち…これからどうすればいいんだ…","nextNodeIds":[60280367]},{"nodeId":60280367,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":3511668034,"text":"前に女皇陛下に伝えた懸念がやはり現実のものとなったか。陛下の判断を仰ぎたいところだが、それをただ待つだけでは遅い…","nextNodeIds":[60280368]},{"nodeId":60280368,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":793873170,"text":"私たちを友人と見なしてくれたのは、ファデュイ執行官の「少女」ではなく、コロンビーナ・ハイポセレニアだ。","nextNodeIds":[60280369]},{"nodeId":60280369,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":3264942938,"text":"このような一刻を争う状況で、女皇陛下がなおも執行官同士の戦いを禁じるというのなら…","nextNodeIds":[60280370]},{"nodeId":60280370,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":509948458,"text":"私は自身の心に従い、「ペルヴェーレ」として戦おう。","nextNodeIds":[60280371]},{"nodeId":60280371,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1882515146,"text":"アルレッキーノ…","nextNodeIds":[60280372]},{"nodeId":60280372,"roleType":"TALK_ROLE_NPC","speakerId":1080,"speakerName":"「召使」","textMapHash":2654076018,"text":"時間が惜しい。先に失礼させていただく。","nextNodeIds":[60280373]},{"nodeId":60280373,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":872241938,"text":"アルレッキーノも冷静でいられなくなってるみたいだな…","nextNodeIds":[60280374]},{"nodeId":60280374,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":953114362,"text":"#（こうなったのは、自分の責任だと思ってるのかも。それは{M#俺}{F#私}も同じだ…）","nextNodeIds":[60280375]},{"nodeId":60280375,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":2607031170,"text":"……","nextNodeIds":[60280376]},{"nodeId":60280376,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":3244054594,"text":"……","nextNodeIds":[60280377]},{"nodeId":60280377,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":3750916474,"text":"おいおい、揃いも揃ってそんな暗くなってどうする。いいか、一つ言っておきたいことがある。","nextNodeIds":[60280378]},{"nodeId":60280378,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":1608679386,"text":"たしかに事態は最悪だ。","nextNodeIds":[60280379]},{"nodeId":60280379,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":1747916850,"text":"ドットーレは騎士なら誰もが忌み嫌うような方法で、一時的な勝利を掴んだ。","nextNodeIds":[60280380]},{"nodeId":60280380,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":2378049866,"text":"魔女ですら、あいつが「変数」を使って運命を変えたって言う。はっはっは、だがな、俺はそう思っちゃいない。","nextNodeIds":[60280381]},{"nodeId":60280381,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":159884602,"text":"テイワットの運命は決まってると、いろんな人から聞いてきた。それは確かに事実らしい。だが、どうしてドットーレの運命だけが特別だって言える？","nextNodeIds":[60280382]},{"nodeId":60280382,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":1434721202,"text":"あいつが「変数」を積み重ねられるなら、俺たちにだってできるはずだろう？","nextNodeIds":[60280383]},{"nodeId":60280383,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":1810866178,"text":"お前までそんな落ち込んでどうする——遠路はるばる訪れた旅人。","nextNodeIds":[60280384]},{"nodeId":60280384,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":473013546,"text":"まだ終わっちゃいない。","nextNodeIds":[60280385,60280386]},{"nodeId":60280385,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1380479298,"text":"うん。","nextNodeIds":[60280387]},{"nodeId":60280387,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":1106598938,"text":"お前は一人じゃない。ここにいる全員が自分を責めてる。しゃべってるやつも、黙ってるやつもな。","nextNodeIds":[60280388]},{"nodeId":60280388,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":658125514,"text":"だが、そのまま肘掛椅子に座って日向ぼっこできるようなやつは、この中にいない。","nextNodeIds":[60280389]},{"nodeId":60280389,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":3219112722,"text":"倒れてもすぐに立ち上がる。これぞ騎士道だ！栄誉騎士、お前は立派なモンドの騎士だろう！","nextNodeIds":[60280390]},{"nodeId":60280390,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3662209570,"text":"うん…","nextNodeIds":[60280391]},{"nodeId":60280391,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":792515154,"text":"ファルカの言う通りだ！まだ終わってないぞ！","nextNodeIds":[60280392]},{"nodeId":60280392,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1449619210,"text":"ドットーレをボコボコにしてやろうぜ！今まで受けた仕打ちをまとめて返してやる！","nextNodeIds":[60280393]},{"nodeId":60280393,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":1877379362,"text":"その意気だ。","nextNodeIds":[60280394]},{"nodeId":60280394,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":3966911314,"text":"他のやつらはどう思う？","nextNodeIds":[60280395]},{"nodeId":60280395,"roleType":"TALK_ROLE_NPC","speakerId":1315,"speakerName":"ラウマ","textMapHash":1277120026,"text":"私はクーヴァキでコロンビーナさんの行方を調べよう。ここで諦めるつもりはない。","nextNodeIds":[60280396]},{"nodeId":60280396,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3440181042,"text":"ナド・クライで起きたことなら、秘聞の館はなんだって知れる。情報の提供は任しとくれ。","nextNodeIds":[60280397]},{"nodeId":60280397,"roleType":"TALK_ROLE_NPC","speakerId":1312,"speakerName":"イネファ","textMapHash":551836826,"text":"カチャカチャ・クルムカケ工房も全力で支援します。私とアイノは、ドットーレの今回の作戦を分析して、突破口を調べるつもりです。","nextNodeIds":[60280398]},{"nodeId":60280398,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":213479418,"text":"アリスさんとニコさんは、テイワットの境界で突然起きた災害を解決しないといけないから、しばらく帰ってこれないけど…","nextNodeIds":[60280399]},{"nodeId":60280399,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":3063525490,"text":"二人ともすごく怒ってたよ。ボクとアルベドは魔女会の代理人として、ドットーレに対抗するよう言いつけられた。","nextNodeIds":[60280401]},{"nodeId":60280401,"roleType":"TALK_ROLE_NPC","speakerId":1018,"speakerName":"アルベド","textMapHash":530864050,"text":"準備はいいかい？いろいろと調査が必要だ。さっそく行動に移ろう。","nextNodeIds":[60280402]},{"nodeId":60280402,"roleType":"TALK_ROLE_NPC","speakerId":1320,"speakerName":"ドゥリン","textMapHash":1917904914,"text":"頑張るよ。","nextNodeIds":[60280403]},{"nodeId":60280403,"roleType":"TALK_ROLE_NPC","speakerId":1065,"speakerName":"#{REALNAME[ID(1)|HOSTONLY(true)]}","textMapHash":3027479946,"text":"僕はドットーレの手口を知っているから、彼の次の行動を予測してみよう。調査も手伝うつもりだ。","nextNodeIds":[60280404]},{"nodeId":60280404,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":4173679362,"text":"よし、一応の役割分担は決まったな。","nextNodeIds":[60280405]},{"nodeId":60280405,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":3827075322,"text":"俺はフリンズとイルーガに連絡して、ライトキーパーに味方になってもらえるよう、マスター・ライトキーパーを説得してほしいと伝える。","nextNodeIds":[60280406]},{"nodeId":60280406,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":3087649018,"text":"同時に、ナド・クライの西風騎士にも指示を出す。ライトキーパーや他の組織と連携して、ここの住民の安全を守ろう。","nextNodeIds":[60280407,60280408]},{"nodeId":60280407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1674449498,"text":"わかった…","nextNodeIds":[60280409]},{"nodeId":60280409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3185984570,"text":"そうだそうだ！どんとこい、だぞ！","nextNodeIds":[60280410]},{"nodeId":60280410,"roleType":"TALK_ROLE_NPC","speakerId":1310,"speakerName":"ファルカ","textMapHash":3951956450,"text":"よし。いっちょ気合い入れていくぞ、お前ら。","nextNodeIds":[]},{"nodeId":60280408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":485372034,"text":"すべてを迎え撃つ準備を進めよう。","nextNodeIds":[60280409]},{"nodeId":60280386,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":545806338,"text":"自分を責めないと、許せそうになくて…","nextNodeIds":[60280387]},{"nodeId":60280334,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3691533498,"text":"この計画を準備するためだったんだ…","nextNodeIds":[60280335]},{"nodeId":60280323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2289147906,"text":"「月の影」に飛び込んだ。","nextNodeIds":[60280324]},{"nodeId":60280305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2820545642,"text":"今すぐこれからのことを話そう…","nextNodeIds":[60280306]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNH