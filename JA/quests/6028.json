pHash":3177831154,"text":"うん、忘れないよ。みんな、私のためにいろいろしてくれてありがとう。","nextNodeIds":[60280220]},{"nodeId":60280220,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":3422390434,"text":"あと、これも覚えておいてほしいな———「昼も夜も、月光が我らを結ばん」。","nextNodeIds":[60280221]},{"nodeId":60280221,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":4254157914,"text":"ふぅ…じゃあ…さようなら、みんな。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[602802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20296,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["3","1874"],"PAINLIBBLDK":"QUEST_EXEC_LOCK_POINT"},{"LNHLPKELCAL":["6001","2"],"PAINLIBBLDK":"QUEST_EXEC_SET_OPEN_STATE_V2"},{"LNHLPKELCAL":["3","133606262,5"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["6309;6321;6322","1;0;0"],"PAINLIBBLDK":"QUEST_EXEC_MODIFY_WEATHER_AREA"},{"LNHLPKELCAL":["6002","0"],"PAINLIBBLDK":"QUEST_EXEC_SET_OPEN_STATE_V2"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[20296_1:128.524,28.074,851.809,0.000,89.461,0.000]"],"NOCCOBOFKHP":20296,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":602804,"order":4,"stepDescription":"仲間たちと対策を話し合う","stepDescTextMapHash":1146027604,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[602803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"