Ids":[3580105]},{"nodeId":3580105,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2074632419,"text":"かわいいわね。","nextNodeIds":[3580106]},{"nodeId":3580106,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":4264469275,"text":"ただ、タイミングがあまり良くないわ…","nextNodeIds":[3580107]},{"nodeId":3580107,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":513836891,"text":"風魔龍が目覚めてからずっと、このモンド周辺をうろついているの。ここ一帯に大きな混乱をもたらしているわ。","nextNodeIds":[3580108]},{"nodeId":3580108,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3210583515,"text":"おまけに今のモンドは、元素の流れと地脈の循環が子猫ちゃんが遊んだ後の毛糸玉みたいになっていてね。","nextNodeIds":[3580109]},{"nodeId":3580109,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2851134571,"text":"魔法使いにとっては最悪な状況よ…肌も気分も調子悪いわ…","nextNodeIds":[3580110]},{"nodeId":3580110,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":2843996075,"text":"それがなければ、尋ね人の張り紙を出すよりも、騎士団がもっと効率のいい方法で君たちを助けられるのだが。","nextNodeIds":[3580111]},{"nodeId":3580111,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":3141303843,"text":"もうしばらくモンドに留まっていてくれ。西風騎士団が問題を解決してみせるから。","nextNodeIds":[3580112,3580114]},{"nodeId":3580112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3557129147,"text":"騎士団に丸投げするわけにはいかない。","nextNodeIds":[3580113]},{"nodeId":3580113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2968614235,"text":"オイラも手伝うぞ！","nextNodeIds":[3580116]},{"nodeId":3580116,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":404453579,"text":"じゃあ、作戦を練るとするか。","nextNodeIds":[3580117]},{"nodeId":3580117,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":1812449515,"text":"風魔龍がモンドに攻めてきたことで、逆に災いを終結させるきっかけを与えてくれた。","nextNodeIds":[3580118]},{"nodeId":3580118,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":2390732043,"text":"それとリサの魔法で探査したところ、モンドを包む暴風の源が分かったんだ。","nextNodeIds":[3580119]},{"nodeId":3580119,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":1291594403,"text":"ほぅ？どこなんだ…？","nextNodeIds":[3580120]},{"nodeId":3580120,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3147200667,"text":"放棄された<color=#00E1FFFF>「四風守護」の神殿</color>よ。","nextNodeIds":[3580121]},{"nodeId":3580121,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":482447755,"text":"風魔龍があの暴風を引き起こせたのは、そこに残った力のせいなの。","nextNodeIds":[3580122]},{"nodeId":3580122,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":2618077571,"text":"私たちの目標は、放棄された四つの神殿のうち、この<color=#00E1FFFF>三つ</color>だ。","nextNodeIds":[3580123]},{"nodeId":3580123,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":211192819,"text":"三つだけの理由については…みんなも分かっていると思うが。","nextNodeIds":[3580124]},{"nodeId":3580124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2912617667,"text":"分からないんだけど。","nextNodeIds":[3580125,3580126]},{"nodeId":3580125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1752905259,"text":"モンド人だけが分かる暗黙の了解かも…","nextNodeIds":[3580127]},{"nodeId":3580127,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":2158555899,"text":"西風騎士のみんな、時間は限られている。","nextNodeIds":[3580128]},{"nodeId":3580128,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":126098059,"text":"暴風が猛威を振るっている今、守るだけでは意味がない。","nextNodeIds":[3580129]},{"nodeId":3580129,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":2826187115,"text":"この災害がさらなる拡大をする前に、<color=#00E1FFFF>神殿の遺跡</color>へと向かおう。","nextNodeIds":[]},{"nodeId":3580126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2404335267,"text":"あとでまた聞こう…","nextNodeIds":[3580127]},{"nodeId":3580114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1258747075,"text":"騎士団に任せた。宿屋はどちらに？","nextNodeIds":[3580115]},{"nodeId":3580115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":257699403,"text":"おい、サボるなよ。オイラたちも手を貸すべきだぞ。","nextNodeIds":[3580116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[35801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1004","201004902,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1006"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[35724,35801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[100358],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3824461879,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[306,307,308],"GMENNHMBBOH":[],"HCJHEADFCAO":1001,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBM