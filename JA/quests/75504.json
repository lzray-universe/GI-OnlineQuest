TalkCount":0},"dialogs":[{"nodeId":755040101,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2559064714,"text":"おお！戻ってきたか、君たち！","nextNodeIds":[755040102]},{"nodeId":755040102,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":298317106,"text":"その目つきを見るに、各地の風景や物産を心ゆくまで眺め、インスピレーションを得てきたようだね？","nextNodeIds":[755040103]},{"nodeId":755040103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1284434346,"text":"まあまあかな…でもなかなか楽しかったぞ！","nextNodeIds":[755040104]},{"nodeId":755040104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":333866986,"text":"決まった目標があって、今までは目に入ってなかった細かいところに気づけたし…","nextNodeIds":[755040105]},{"nodeId":755040105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":881480578,"text":"かなり見識が広がって、素材がたくさん集まったよな？","nextNodeIds":[755040106,755040107]},{"nodeId":755040106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":735636474,"text":"ただ、ラクガキに使えるかは分からない。","nextNodeIds":[755040108]},{"nodeId":755040108,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3605042570,"text":"まあ、そう焦らなくてもいいさ！私も君たちに、ナタを一度回っただけですぐに前衛の何たるかを理解してもらおうとは思っていないよ。","nextNodeIds":[755040109]},{"nodeId":755040109,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2712104106,"text":"では、君たちが得た見聞を教えてくれるかい？","nextNodeIds":[755040110]},{"nodeId":755040110,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":30609,"speakerName":"暗転","textMapHash":3168289586,"text":"ラクガキ指南書に記録した内容と、撮影した様々な写真を「カラフルノロマ」に見せた…","nextNodeIds":[755040111]},{"nodeId":755040111,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":2353279234,"text":"なんてことだ…君たちの撮影センス…絶妙じゃないか！？","nextNodeIds":[755040112]},{"nodeId":755040112,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3548769290,"text":"まさか、写真機の扱いにこうも長けてるとは思わなかったよ。無意識のうちに最高の構図を選び出しているようだ。","nextNodeIds":[755040113]},{"nodeId":755040113,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3194183082,"text":"なら、過分なアドバイスはかえって悪い影響を及ぼすだろう。私がちょっと導くだけで、君たちはすぐにでもアイデアを広げられるはずだ。","nextNodeIds":[755040114]},{"nodeId":755040114,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":670259610,"text":"さあ、私の手記を受け取ってくれ。今後の旅で時間があるときに目の前の景色に合わせてこれを読めば、迫力満点の構図が浮かび上がるはずさ！","nextNodeIds":[755040115]},{"nodeId":755040115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":982906370,"text":"えっ？てっきりオイラたちの写真を一枚一枚分析して…前衛的理念をレクチャーしてくれるもんだと思ってたぞ！","nextNodeIds":[755040116]},{"nodeId":755040116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":125459826,"text":"それにオイラもラクガキをしてみたかったんだけどな…","nextNodeIds":[755040117]},{"nodeId":755040117,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3927051650,"text":"いや、もともと才能がある君たちなら、自分の力で学ぶことができる！","nextNodeIds":[755040118]},{"nodeId":755040118,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":480193746,"text":"独学で才能を開花させられる天才に向かって、教科書どおりの几帳面なラクガキの手法を教えては、成長を妨げてしまうかもしれない。","nextNodeIds":[755040119]},{"nodeId":755040119,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":757642762,"text":"だから、私は全責任を持つ指導教員かつ案内人という立場から、君たちに助言を与える先輩になろうと思う。","nextNodeIds":[755040120]},{"nodeId":755040120,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1423617346,"text":"二人のインスピレーションが湧き上がり機が熟したら、ラクガキ用の塗料缶を手に、大いに本領を発揮するといい！","nextNodeIds":[755040121]},{"nodeId":755040121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":579488882,"text":"オイラたちって、そんな才能もあったのか！","nextNodeIds":[755040122]},{"nodeId":755040122,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1732992394,"text":"へへっ…今まで画家とか映影監督の依頼をたくさん受けてきたけど、無駄じゃなかったってことだな！","nextNodeIds":[755040123,755040124]},{"nodeId":755040123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":804381610,"text":"ありがとう。","nextNodeIds":[755040125]},{"nodeId":755040125,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":1335892850,"text":"ああ。でも気張りすぎないようにね。君たちの才能があれば、自分なりの理解をもって前衛芸術の要点を掴むことができるはずさ！","nextNodeIds":[755040126]},{"nodeId":755040126,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3264181010,"text":"私は普段「謎煙の主」でラクガキユニオン総本部の建設準備を進めている。もし聞きたいことがあったら、いつでも来てくれて構わないよ。","nextNodeIds":[755040127]},{"nodeId":755040127,"roleType":"TALK_ROLE_NPC","speakerId":30609,"speakerName":"「カラフルノロマ」","textMapHash":3248345810,"text":"君たちのためにラクガキ用装備のセットを用意して待っていよう！","nextNodeIds":[755040128]},{"nodeId":755040128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":755435290,"text":"おう。ラクガキユニオンの総本部は「謎煙の主」に建てられるんだな。覚えとくぜ…それじゃあ頑張れよー！","nextNodeIds":[755040129,755040130]},{"nodeId":755040129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1200535130,"text":"とっても楽しかった！","nextNodeIds":[755040131]},{"nodeId":755040131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3751332130,"text":"時間ができたら、「カラフルノロマ」の手記を読んでオイラたちの芸術的思考をもっと磨いてみようぜ！","nextNodeIds":[755040132]},{"nodeId":755040132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1873405506,"text":"そのうち、本当にラクガキと絵描きの達人になって、その才能で臨時収入を稼げるかもしれないぞ？","nextNodeIds":[]},{"nodeId":755040130,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1812289466,"text":"また今度！","nextNodeIds":[755040131]},{"nodeId":755040124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3039804250,"text":"理解を深められるよう、頑張るよ。","nextNodeIds":[755040125]},{"nodeId":755040107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2264484154,"text":"もっと前衛的な理念を磨かないと。","nextNodeIds"