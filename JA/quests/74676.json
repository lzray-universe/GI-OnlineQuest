{"mainQuestId":74676,"title":"強者と迷宮に思い馳せて","description":"モンドの不思議な秘境の近くで、ある友人と再会した。彼女は何か特別なイベントを準備しているようだ…","titleTextMapHash":228880471,"descTextMapHash":3492331990,"mainQuestExcel":{"mainQuestId":74676,"titleTextMapHash":228880471,"title":"強者と迷宮に思い馳せて","descTextMapHash":3492331990,"description":"モンドの不思議な秘境の近くで、ある友人と再会した。彼女は何か特別なイベントを準備しているようだ…","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5199,"luaPath":"Actor/Quest/WQ74676","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5199,"chapterId":0,"descTextMapHash":3492331990,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":74676,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":3022163697,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ74676","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[174676],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":228880471,"type":"WQ","unlockDescTextMapHash":4072626518}},"flow":[{"subQuestId":7467601,"order":1,"stepDescription":"モンド城のガーデンへ向かう","stepDescTextMapHash":3058635532,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30323"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467601],"talks":[{"talkId":7467601,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7467601","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467601,"initDialog":746760101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30323],"performCfg":"QuestDialogue/WQ/BulletHell_74676/Q7467601","priority":5,"questId":74676,"showRandomTalkCount":0},"dialogs":[{"nodeId":746760101,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":563239362,"text":"ふふふ…予感がします…","nextNodeIds":[746760102]},{"nodeId":746760102,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1825005682,"text":"数多の困難を乗り越え、やっと二人の伝説の物語が始まった地に辿り着きました。きっと私の努力は実り…","nextNodeIds":[746760103]},{"nodeId":746760103,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":3835193450,"text":"#必ずや運命も味方になってくれるはず。もうすぐ{M#彼たち}{F#彼女たち}と再会させてくれるでしょう！","nextNodeIds":[746760104]},{"nodeId":746760104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":288166050,"text":"こいつ、なにぶつぶつ言ってんだろ？服装からすると、モンドの人じゃなさそうだけど…もしかして稲妻からここまで来たのかな？","nextNodeIds":[746760105]},{"nodeId":746760105,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":494669986,"text":"あっ！さっそく現れてくれるなんて！「才知と勇猛の双子星」！さあ、一緒に再会を喜び合いましょう！","nextNodeIds":[746760106,746760108]},{"nodeId":746760106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3786015418,"text":"久しぶり！","nextNodeIds":[746760107]},{"nodeId":746760107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3700738490,"text":"あれ、左右加さんじゃないか！まさかモンドで会えるなんてな！","nextNodeIds":[746760111]},{"nodeId":746760111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3832640442,"text":"でも、おまえってハニヤーと一緒にずっと大会の準備をしてたよな？なんでまた一人でモンドに来たんだ？","nextNodeIds":[746760112]},{"nodeId":746760112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1793051338,"text":"それに…本がたくさん置いてあるけど…もしかして、道行く人に小説を宣伝してたとか？","nextNodeIds":[746760113]},{"nodeId":746760113,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":128226874,"text":"ええ、実は——","nextNodeIds":[746760114]},{"nodeId":746760114,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1263115354,"text":"八重堂の編集者たちに追われていまして…","nextNodeIds":[746760115]},{"nodeId":746760115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":491111354,"text":"追われてる！？","nextNodeIds":[746760116]},{"nodeId":746760116,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":3025748714,"text":"あっ、心配しないでください。そういう意味じゃありませんから。編集者たちがあらゆる手段で原稿を催促してくるんです。まあ、私のためを思ってのことでしょうけど。","nextNodeIds":[746760117]},{"nodeId":746760117,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":2723693298,"text":"一応、かつてヒット作を出した娯楽小説作家ですし、読者の期待に応えるためにも作品を生み出し続け、人気を保つ必要があります。","nextNodeIds":[746760118]},{"nodeId":746760118,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1013257818,"text":"読者はものすごい勢いで本を読んでいますしね。だから、私も必死に書き続けないと、どんどん世に出される新作に埋もれてしまうんです…","nextNodeIds":[746760119]},{"nodeId":746760119,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":2206897194,"text":"でも、キノコンの仲間たちとの物語をさくっと書き終えてしまうのは忍びなくて…。いい小説は時間をかけて構想を練り、磨いていきたいですから。","nextNodeIds":[746760120]},{"nodeId":746760120,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":830401290,"text":"できれば、あの物語は最後までしっかり書いた後に、何度も推敲して公開したいんです。毎回締め切りに追われるような連載形式ではなく…","nextNodeIds":[746760121]},{"nodeId":746760121,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":2082127714,"text":"そこで、読者に私の存在を覚えていてもらうために、比較的書きやすい物語を執筆して、当分の主力作品にしようと考えたわけです。","nextNodeIds":[746760122,746760123]},{"nodeId":746760122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3707528402,"text":"大変だね…","nextNodeIds":[746760124]},{"nodeId":746760124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2256800770,"text":"そうだったのか…娯楽小説の作家ってすごく楽な仕事だと思ってたぜ…","nextNodeIds":[746760125]},{"nodeId":746760125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":286992170,"text":"あっちこっち遊び歩きながら、調べたりアイデアを探したりして、ヒラメキがあったら一気に書き上げて——で、モラをわんさか稼いで、ハッピーに暮らしてるもんだと…","nextNodeIds":[746760126]},{"nodeId":746760126,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":21347226,"text":"そういうのは、天才肌の作家さんに限った話ですね。ほとんどの作家は、その日に書くべき章の構想を立てたり取材したりするだけで、疲れ果ててしまいます。","nextNodeIds":[746760127]},{"nodeId":746760127,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":4232296898,"text":"そして書いていると、ある時点で必ず行き詰まります。私もご多分に漏れず…でないと、巷の噂を信じてモンドまで来たりしませんよ。","nextNodeIds":[746760128,746760129]},{"nodeId":746760128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3766488434,"text":"その巷の噂ってのが重要みたいだね？","nextNodeIds":[746760130]},{"nodeId":746760130,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1409659658,"text":"その通り！今回は画像と放送装置を取り入れて、視覚と聴覚で楽しめる、立体的な閲覧体験ができる小説を作りたいと考えています！","nextNodeIds":[746760131]},{"nodeId":746760131,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1377683362,"text":"この新しい作品のテーマは「最強無敵の迷宮冒険」——","nextNodeIds":[746760132]},{"nodeId":746760132,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1523481610,"text":"邪悪な魔術師が作った迷宮に迷い込んでしまった、不思議な能力を持つ無敵の強者が、複雑な仕掛けや罠を突破して、迷宮の奥深くに隠された秘密に辿り着くと…","nextNodeIds":[746760133]},{"nodeId":746760133,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":3749541074,"text":"続きは、まだ考え中です…","nextNodeIds":[746760134]},{"nodeId":746760134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2727772722,"text":"そんな！せっかくワクワクしてたのに！","nextNodeIds":[746760135]},{"nodeId":746760135,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":3661913490,"text":"物語の伏線や展開の速度は、またじっくり考えますが…","nextNodeIds":[746760136]},{"nodeId":746760136,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":143194898,"text":"連載作品で最も大切なのは、いかに読者の心を掴むかです——つまり、迷宮で遭遇する様々な困難こそが鍵となります。","nextNodeIds":[746760137]},{"nodeId":746760137,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1786899402,"text":"そんな折に、ちょうどモンドに不思議な装置が大量にある秘境が存在すると聞き、すぐ駆けつけたんです。そして、秘境の中を詳しく調べてみました…","nextNodeIds":[746760138]},{"nodeId":746760138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2809404898,"text":"相変わらずスゴい行動力だな…で、迷宮で遭遇する困難について、なにかヒントは見つかったのか？","nextNodeIds":[746760139]},{"nodeId":746760139,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":732202114,"text":"ヒントはありましたが、解き方でつまずいてしまいまして…このままでは書き上げるのが難しそうです。","nextNodeIds":[746760140]},{"nodeId":746760140,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":852851114,"text":"普通の装置だというのにコテンパンにやられ、ハニヤーさんは服までボロボロになってしまいました。なんとか情報を集めて、物語の肝心な段落は書けたものの…","nextNodeIds":[746760141]},{"nodeId":746760141,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":2411229954,"text":"「強者」でもなければ、特別な能力も持っていない私では、具体的な対策は思いつけません。","nextNodeIds":[746760142]},{"nodeId":746760142,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":968486418,"text":"ですが、名高い「才知と勇猛の双子星」のお二人なら、きっと造作もないはず！","nextNodeIds":[746760143]},{"nodeId":746760143,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":767066730,"text":"でも、オイラたちだって万能ってわけじゃないぞ。なんでオイラたちのことを思い出したんだ？","nextNodeIds":[746760144]},{"nodeId":746760144,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":2419971818,"text":"それはですね…あらゆる分野の人材に依頼するのは無理でしょう？ですから、いろんな「強者」を知っている方に、秘境の探索を協力してもらえたらと考えたんです。","nextNodeIds":[746760145]},{"nodeId":746760145,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":402547042,"text":"#私が知ってる中で{NICKNAME}さんは、広い見識と人脈を持っています。なおかつ、テイワットで一番の人気者ですから！","nextNodeIds":[746760146]},{"nodeId":746760146,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":3964283010,"text":"私が書いた物語に沿って、文字や写真、そして想像から構成された世界に浸り、最高の状態に入れば…","nextNodeIds":[746760147]},{"nodeId":746760147,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":1909575170,"text":"必要な能力を持つ強者を思い浮かべることで、その方がどう迷宮の危険を対処するのかを想像できるはずです！","nextNodeIds":[746760148,746760149]},{"nodeId":746760148,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1635344546,"text":"#えっと、その役を{M#俺}{F#私}が？","nextNodeIds":[746760150]},{"nodeId":746760150,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2973822234,"text":"面白そうだな！小説の文字と写真を頼りに想像するなんて、オイラたちも作家になったみたいだぜ。これまでにやったことのない体験だな。","nextNodeIds":[746760151]},{"nodeId":746760151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":30638770,"text":"オイラたちの知り合いが、仕掛けだらけの秘境にどう立ち向かうか…想像しただけでも、斬新な物語になりそうだぜ。","nextNodeIds":[746760152]},{"nodeId":746760152,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":2853089914,"text":"でしょう？やはり、あなたたちこそ最適な人選です！一緒に物語を完成させれば、きっと大ヒット間違いなしですよ！","nextNodeIds":[746760153]},{"nodeId":746760153,"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","textMapHash":3621878826,"text":"そうなったら、共同執筆者にあなたたちの名前を入れましょう。原稿料も山分けです！","nextNodeIds":[746760154]},{"nodeId":746760154,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1004326786,"text":"へへっ、気前がいいな！さすがオイラたちのダチだぜ！","nextNodeIds":[746760155]},{"nodeId":746760155,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3135636002,"text":"よ～し、気合を入れてやろうぜ！","nextNodeIds":[]},{"nodeId":746760149,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4186639066,"text":"#確かに{M#俺}{F#私}が適任かも…","nextNodeIds":[746760150]},{"nodeId":746760129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":301058122,"text":"机の上の本と関係がある感じ？","nextNodeIds":[746760130]},{"nodeId":746760123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":174324458,"text":"まあ、仕方ないね…","nextNodeIds":[746760124]},{"nodeId":746760108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":368273274,"text":"どちらさま…？","nextNodeIds":[746760109]},{"nodeId":746760109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3968478682,"text":"う～ん、どっかで見たことあるような…もしかして、左右加さんか？","nextNodeIds":[746760110]},{"nodeId":746760110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1801042386,"text":"ほら、覚えてないか？左右加さんは前にキノコン大会で知り合った作家だぞ。ハニヤーとオイラたちを手伝って、キノコンたちの面倒を見てくれたやつだ。","nextNodeIds":[746760111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30323"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30323,"speakerName":"左右加","count":31},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":8}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174676],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3492331990,"CHECNJEMEFE":{"30323":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/BulletHell_74676/Q7467601","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD