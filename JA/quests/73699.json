y":5,"questId":73699,"showRandomTalkCount":0},"dialogs":[{"nodeId":736990101,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":3097638506,"text":"おや——これまでの訓練を順調にクリアしたみたいネ。","nextNodeIds":[736990102]},{"nodeId":736990102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2400800626,"text":"クリアはしたけど、ソルシュが…","nextNodeIds":[736990103]},{"nodeId":736990103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1270194642,"text":"何百年か前のウェネトの結晶を見た時は、何百年保存されてきたとは言え、いつかは跡形もなく消えてしまう…","nextNodeIds":[736990104]},{"nodeId":736990104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1877316970,"text":"とか言ってたくせに、自分の頌歌がボロボロになって世に伝えられる話になると、手のひらを返すみたいに態度が急変したぞ。","nextNodeIds":[736990105]},{"nodeId":736990105,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":1064343538,"text":"ふん、当然デショ？私の功績…いえ、つまり我ら花霊の功績は、永遠に残るモノ。いつ消え失せるかも分からない存在と、比べられる筋合いはありマセン。","nextNodeIds":[736990106]},{"nodeId":736990106,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":239574474,"text":"保存がきかないというのは、きっと保存方法に問題があるハズ。先輩はそれを私に悟らせるために、ウェネトの結晶を改めて観察させてくださったんですよネ？","nextNodeIds":[736990107]},{"nodeId":736990107,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":239368234,"text":"なるほど、ソルシュはそういう風に考えてたのネ。それはそれで面白い考えだと思うワ。","nextNodeIds":[736990108]},{"nodeId":736990108,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":1220165786,"text":"先輩にとって、花霊一族の名声は重要ではないのデスか？","nextNodeIds":[736990109]},{"nodeId":736990109,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":1310621706,"text":"そうネェ、人類の間で伝えられるような名声なら、あまり気にしてはいないかしら。だって、今のスケプティック団はつまらないにも程があるもノ。","nextNodeIds":[736990110]},{"nodeId":736990110,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":1244680346,"text":"#勿論、{NICKNAME}やパイモンのような面白い人が、人類の中にもう少し増えているのであれば、話は別だけれど。","nextNodeIds":[736990111]},{"nodeId":736990111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3643779274,"text":"へへ、ズルヴァーンに褒められたぜ。","nextNodeIds":[736990112,736990115]},{"nodeId":736990112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4000810354,"text":"やった！先輩、お褒めにあずかり光栄です！","nextNodeIds":[736990113]},{"nodeId":736990113,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3904538010,"text":"ま…待ちなさいヨ、あなたの先輩じゃないデショ！","nextNodeIds":[736990114]},{"nodeId":736990114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1058470722,"text":"なんだよソルシュ、けち臭いな。ズルヴァーンはここの長老で大先輩なんだから、オイラたちが先輩って呼んだっておかしくないだろ？","nextNodeIds":[736990117]},{"nodeId":736990117,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":1157705002,"text":"さて、本題に戻りましょう…ソルシュにとって、人間の世界における名声は重要、ということネ。ちょうど次の訓練は、あなたにぴったりかもしれないわネ。","nextNodeIds":[736990118]},{"nodeId":736990118,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":1458332050,"text":"では、吉報を待っているワ。","nextNodeIds":[]},{"nodeId":736990115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2274571546,"text":"「面白い」って褒め言葉？","nextNodeIds":[736990116]},{"nodeId":736990116,"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","textMapHash":2247083562,"text":"あら、私からすれば、褒め言葉ヨ。","nextNodeIds":[736990117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7369901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4284"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUES