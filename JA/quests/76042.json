pcId":[1316,1317],"performCfg":"QuestDialogue/WQ/NodKrai_76042/Q7604201","priority":5,"questId":76042,"showRandomTalkCount":0},"dialogs":[{"nodeId":760420101,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":375643866,"text":"トレジャーハンターが、海賊船の残骸を漁っている最中に幽霊に襲われた…なんつーか、三流のエンタメ小説みたいな話だな。","nextNodeIds":[760420102]},{"nodeId":760420102,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1788492138,"text":"殴られたやつらも、言ってることが滅茶苦茶だし…これじゃ本当か嘘か分からないぞ。","nextNodeIds":[760420103]},{"nodeId":760420103,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3540817026,"text":"海賊船の話、ヤフォダも知ってたんだね？","nextNodeIds":[760420104]},{"nodeId":760420104,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2839304026,"text":"うん。小さい頃だったけど、アトラス号の話はすごかったもん。","nextNodeIds":[760420105]},{"nodeId":760420105,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":543399938,"text":"いい子にしてないと、『盾女』ロヴィーサが捕まえにくるぞ。『狂人』グレティルがお前を海に投げ捨てて、魚の餌にしてしまうぞ——！","nextNodeIds":[760420106]},{"nodeId":760420106,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":485188066,"text":"昔、そんな話で脅かされたな。まあ、あたいはちっとも怖くなかったけど。","nextNodeIds":[760420107]},{"nodeId":760420107,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":552933234,"text":"ふっ、そういうことなら今回の任務の適任者はあんたしかいないね。","nextNodeIds":[760420108]},{"nodeId":760420108,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2139058602,"text":"…えっ！？","nextNodeIds":[760420109]},{"nodeId":760420109,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1541179282,"text":"わかったよ…ちょっと遠いけど、調査してみる。","nextNodeIds":[760420110]},{"nodeId":760420110,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2781245218,"text":"（あの海域は沈没船が多くて、たまに宝物を掘り出すやつがいるんだよな。もしかしたら、あたいも…）","nextNodeIds":[760420111]},{"nodeId":760420111,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":195655762,"text":"宝探しに夢中になって仕事を疎かにしないようにね。","nextNodeIds":[760420112]},{"nodeId":760420112,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2492295570,"text":"わ、わかってるって姐さん！さっさと終わらせて戻ってくるよ！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7604202,"order":2,"stepDescription":"ケラティの眼付近の浜辺へ行って調査する","stepDescTextMapHash":321859156,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7604202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7604203,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_360700162:2427.007,200.211,8921.929,0.000,212.566,0.000]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7604202,7604203],"talks":[{"talkId":7604202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7604202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7602007","3","","",""],"type":"QUEST_COND_QUEST_STATE_NOT_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7604202,"initDialog":760420201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"QuestDialogue/WQ/NodKrai_76042/Q7604202","priority":5,"questId":76042,"showRandomTalkCount":0},"dialogs":[{"nodeId":760420201,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":161148706,"text":"その身なり…宝探しにきたトレジャーハンターか？あんたらのような人間はしょっちゅうやってくるが、飽きもせずによくもまあ…","nextNodeIds":[760420202]},{"nodeId":760420202,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1853337778,"text":"じいさん、鋭いな。同業者がここでひどい目に遭ったらしくてさ。しかも幽霊に襲われたとかって騒ぎ立ててるんだ。","nextNodeIds":[760420203]},{"nodeId":760420203,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":234740250,"text":"あたいは幽霊も祟りも信じてないから、本当に人を襲う幽霊なんかがいるのか、確かめにきたんだよ…もちろん、同業者が手に入れそびれた宝物を見つけられたらもっといいけどな。","nextNodeIds":[760420204]},{"nodeId":760420204,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":3483185218,"text":"じいさん、教えてくれ。あいつらの言ってた人を襲う幽霊って一体なんなんだ？","nextNodeIds":[760420205]},{"nodeId":760420205,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":402252962,"text":"人を襲う幽霊などおらん。ぶたれるのが人なら、ぶつほうも人に決まっとるわい。じゃがなあ、あれは確かに悪鬼のような人間じゃった。生きてはいるが…とっくに死んでおるのかもな。","nextNodeIds":[760420206]},{"nodeId":760420206,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":3361893506,"text":"…は？じいさん、何言って…","nextNodeIds":[760420207]},{"nodeId":760420207,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2176968194,"text":"でたらめなどではないぞ。アトラス号を知っておるか？","nextNodeIds":[760420208]},{"nodeId":760420208,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1325376402,"text":"知ってるよ。でも沈んじまったんだろ？このすぐ近くで。","nextNodeIds":[760420209]},{"nodeId":760420209,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1314544458,"text":"あの船で最も価値のあるお宝——それはレッド・ミラーが残した「偉大なる財宝」を見つけるためのしるしだ。ま、今まで誰も見つけたことはないけどな。","nextNodeIds":[760420210]},{"nodeId":760420210,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2485451474,"text":"詳しいのう。","nextNodeIds":[760420211]},{"nodeId":760420211,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":474568994,"text":"へへっ、これでもプロだからね。ん？つまり、人を襲ってるやつはアトラス号と関係してるってことか？","nextNodeIds":[760420212]},{"nodeId":760420212,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":832598346,"text":"その通りじゃ。あの海難事故は凄惨なものじゃったが、生存者も少なからずいた。「裂けアゴ」のハルクなんかも、そのうちの一人じゃな。アトラス号で名を轟かせた海賊は、もはや彼一人となった。","nextNodeIds":[760420213]},{"nodeId":760420213,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1843945042,"text":"聞いた話では、数年はスネージナヤ・グラードで働いたのちに、どこかのキャラバンで仕事をしとったそうじゃ。じゃが最近は、ナシャタウンで何かをしでかしたようで、キャラバンも彼を敬遠しとる。","nextNodeIds":[760420214]},{"nodeId":760420214,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":625173458,"text":"その日、数人のトレジャーハンターがアトラス号の残骸付近を探しているとき、「裂けアゴ」のハルクがそれを目撃し、彼らに襲いかかったんじゃ。","nextNodeIds":[760420215]},{"nodeId":760420215,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1890960554,"text":"もともとやつの船だったんだ…沈んでも思い入れがあるんだろうな。","nextNodeIds":[760420216]},{"nodeId":760420216,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":426054802,"text":"そうじゃな。海難事故があってから、彼は二度と船に乗ることはなかったらしい。海賊なんてもってのほかじゃろう。じゃが、彼のような人間がまともな職で生計を立てるというのは、そう簡単なことでもない。","nextNodeIds":[760420217]},{"nodeId":760420217,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2133461594,"text":"昔…アトラス号に「世話」になった連中は、ただじゃ引き下がれないだろうな。","nextNodeIds":[760420218]},{"nodeId":760420218,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1072335554,"text":"でも全部自分で選んだことなんだし、人のせいにしちゃいけないだろ。自分の選択には責任を負うもんだ。","nextNodeIds":[760420219]},{"nodeId":760420219,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1670662010,"text":"人は生きていれば過ちを犯すこともある。大事なのは、すぐに軌道修正することじゃ。ハルクは舵手だというのに、こう何度も道を誤るとはのう…","nextNodeIds":[760420220]},{"nodeId":760420220,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":107339906,"text":"つまり、ハルクはナシャタウンで問題を起こして戻ってきたのか。そいつにとって終わりの地であり、始まりの地でもあるここに。","nextNodeIds":[760420221]},{"nodeId":760420221,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":3897420490,"text":"でも、そいつはまた間違った選択をした。","nextNodeIds":[760420222]},{"nodeId":760420222,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":4241402418,"text":"人の本質は変わらんということじゃな。彼はここで多くの人を傷つけ…逃げ上手な魚のようにすっかり姿を消してしまいおった。","nextNodeIds":[760420223]},{"nodeId":760420223,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3919227178,"text":"ナシャタウンの「フラッグシップ」も指名手配しておるそうじゃ。多くの人が念入りにやつを探しているのに、髪の毛一本見つからん。","nextNodeIds":[760420224]},{"nodeId":760420224,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2686783490,"text":"じいさん、魚は釣れてないみたいだけど、情報通なんだな。","nextNodeIds":[760420225]},{"nodeId":760420225,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":313285050,"text":"ふん、口が達者な嬢ちゃんじゃのう…もう一ついいことを教えてやろう。アトラス号の残骸はあそこじゃ。運試ししてみるがいい。","nextNodeIds":[760420226]},{"nodeId":760420226,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":998211218,"text":"運試し？もしやつがいきなりどっかから現れて襲ってきたら、じいさんが助けてくれるのかよ？","nextNodeIds":[760420227]},{"nodeId":760420227,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3355477282,"text":"何をいう、わしはただの釣り人だぞ…どうやって助けろと言うんじゃ。せいぜい近くまで一緒に行って道案内をするくらいじゃな…どうせここでは魚も釣れんからのう。","nextNodeIds":[760420228]},{"nodeId":760420228,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1647376594,"text":"はあ、そうだよな。大丈夫、勝てなかったらずらかればいいんだ。あたいは逃げるのは大得意だからな。","nextNodeIds":[]}]},{"talkId":7604203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7604202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7602007","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7604203,"initDialog":760420301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"QuestDialogue/WQ/NodKrai_76042/Q7604203","priority":5,"questId":76042,"showRandomTalkCount":0},"dialogs":[{"nodeId":760420301,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3488607946,"text":"その身なり…宝探しにきたトレジャーハンターか？あんたらのような人間はしょっちゅうやってくるが、飽きもせずによくもまあ…","nextNodeIds":[760420302]},{"nodeId":760420302,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":3191496930,"text":"じいさん、鋭いな。同業者がここでひどい目に遭ったらしくてさ。しかも幽霊に襲われたとかって騒ぎ立ててるんだ。","nextNodeIds":[760420303]},{"nodeId":760420303,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1361869402,"text":"あたいは幽霊も祟りも信じてないから、本当に人を襲う幽霊なんかがいるのか、確かめにきたんだよ…もちろん、同業者が手に入れそびれた宝物を見つけられたらもっといいけどな。","nextNodeIds":[760420304]},{"nodeId":760420304,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":413127778,"text":"じいさん、教えてくれ。あいつらの言ってた人を襲う幽霊って一体なんなんだ？","nextNodeIds":[760420305]},{"nodeId":760420305,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":891098898,"text":"ここには幽霊がおるんじゃ。","nextNodeIds":[760420306]},{"nodeId":760420306,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2490982338,"text":"はぁ！？ほんとにいるのかよ！","nextNodeIds":[760420307]},{"nodeId":760420307,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":93108058,"text":"いや、実際に見たのは人が人を襲っている光景じゃ。まあ、確かに悪鬼のようなやつじゃったな。生きてるようで、とっくに死んでおるのかもしれん。","nextNodeIds":[760420308]},{"nodeId":760420308,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2391267114,"text":"…は？じいさん、何言って…","nextNodeIds":[760420309]},{"nodeId":760420309,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":967028322,"text":"でたらめなどではないぞ。アトラス号を知っておるか？","nextNodeIds":[760420310]},{"nodeId":760420310,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1543236234,"text":"知ってるよ。でも沈んじまったんだろ？このすぐ近くで。","nextNodeIds":[760420311]},{"nodeId":760420311,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":2310594882,"text":"あの船で最も価値のあるお宝…それはレッド・ミラーが残した「偉大なる財宝」を見つけるためのしるしだ。","nextNodeIds":[760420312]},{"nodeId":760420312,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":46131042,"text":"詳しいようじゃの。そのしるしなら、小さな白いやつを連れた金髪の冒険者が、前に見つけていったぞ。","nextNodeIds":[760420313]},{"nodeId":760420313,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":1270959618,"text":"（は？それってまさか…うーん、でも今は仕事が優先だな。）","nextNodeIds":[760420314]},{"nodeId":760420314,"roleType":"TALK_ROLE_NPC","speakerId":1317,"speakerName":"ヤフォダ","textMapHash":449753306,"text":"へへっ、これでもプロだからね。ん？つまり、人を襲ってるやつはアトラス号と関係してるってことか？","nextNodeIds":[760420315]},{"nodeId":760420315,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2172020362,"text":"その通りじゃ。あの海難事故は凄惨なものじゃったが、生存者も少なからずいた。「裂けアゴ」のハルクなんかも、そのうちの一人じゃな。アトラス号で名を轟かせた海賊は、もはや彼一人となった。","nextNodeIds":[760420316]},{"nodeId":760420316,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":656451434,"text":"聞いた話では、