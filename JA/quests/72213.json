odeId":722130113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1531494938,"text":"彼が欲しいのはお金だと思う…","nextNodeIds":[722130114]},{"nodeId":722130114,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":96598754,"text":"お金？それは「賽銭箱」に入れるものじゃにゃいのか？そんなものが好きだにゃんて、人間は変だにゃ。","nextNodeIds":[722130115]},{"nodeId":722130115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4906394,"text":"お金は重要。","nextNodeIds":[722130116]},{"nodeId":722130116,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":2796841482,"text":"ふん、主もこれまでうちをたくさん助けてくれた、主のことは信じる。あとで、あいつとも話をするにゃ。","nextNodeIds":[722130117]},{"nodeId":722130117,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1250743274,"text":"だけど今、石人間はもう石を叩いたりしていにゃい。短い木の棒を持ってる。何をしようとしてるかは分からにゃい。","nextNodeIds":[722130118]},{"nodeId":722130118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3110255706,"text":"木の棒？彫刻ってかなづちとか彫刻刀を使うんじゃないのか？","nextNodeIds":[722130119]},{"nodeId":722130119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2769961122,"text":"まさか道具が壊れたんじゃ…","nextNodeIds":[722130120]},{"nodeId":722130120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3344251346,"text":"#{NICKNAME}、大島さんのところに行ってみよう！なにか手伝えることがあるかもしれない。","nextNodeIds":[]}]},{"talkId":7221302,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGr