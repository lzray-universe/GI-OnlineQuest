LK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":102804,"initDialog":10280401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1030],"performCfg":"QuestDialogue/AQ/Liyue5_1028/Q102804","priority":5,"questId":1028,"showRandomTalkCount":0},"dialogs":[{"nodeId":10280401,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":2674928434,"text":"うん？おかしい、どうなってやがんだ。","nextNodeIds":[10280402]},{"nodeId":10280402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1654382626,"text":"オイラたち…戻ってきちゃったのか？","nextNodeIds":[10280403]},{"nodeId":10280403,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":2067747978,"text":"ここ、さっき通った場所だよな？","nextNodeIds":[10280404]},{"nodeId":10280404,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":4242268666,"text":"ふむ、出発地点のようだな。","nextNodeIds":[10280405]},{"nodeId":10280405,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1159724338,"text":"俺らは道を間違えてねぇはずだ。ずっと出口を目指して進んでた、道を戻ったりもしてねぇ。","nextNodeIds":[10280406]},{"nodeId":10280406,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":371425378,"text":"ええ、私もそう思うわ。","nextNodeIds":[10280407]},{"nodeId":10280407,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1130714890,"text":"旅人、俺ら道を間違えてねぇよな？","nextNodeIds":[10280408]},{"nodeId":10280408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2101873050,"text":"うん、方向は正しいと思う。","nextNodeIds":[10280409]},{"nodeId":10280409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3171732794,"text":"う～ん、どういうことなんだ…","nextNodeIds":[10280410]},{"nodeId":10280410,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":517574546,"text":"そういやぁ、稲妻にはこんな話がある。商人が夜道を歩いてると、狸が妖術で同じところを一晩中彷徨わせるらしい。夜が明けるまで抜け出せないとか…","nextNodeIds":[10280411]},{"nodeId":10280411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1870147282,"text":"鬼打牆のことだな、オイラも知ってるぞ。","nextNodeIds":[10280412]},{"nodeId":10280412,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":2890752482,"text":"なら、話が早え。つまり、俺たちは今そういうのに遭遇したってことだ。","nextNodeIds":[10280413]},{"nodeId":10280413,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1376918122,"text":"だが、心配いらねぇ。俺様には邪気を払える助っ人がいるからな。こういう時は、そいつを呼べばいい。","nextNodeIds":[10280414]},{"nodeId":10280414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1825577410,"text":"一斗って鬼なのに、邪気を払える友達がいるんだな…なんていうか、肝が据わってるな。","nextNodeIds":[10280415]},{"nodeId":10280415,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":4272941930,"text":"鈍いとこが、親分が楽しく生きていけてる理由だから。","nextNodeIds":[10280416]},{"nodeId":10280416,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":4232489802,"text":"いでよッ、丑雄！","nextNodeIds":[10280417]},{"nodeId":10280417,"roleType":"TALK_ROLE_NPC","speakerId":12544,"speakerName":"丑雄","textMapHash":3572517162,"text":"モォ——！","nextNodeIds":[10280418]},{"nodeId":10280418,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":3985213458,"text":"こいつが荒瀧派の隠れ構成員、丑雄だ。","nextNodeIds":[10280419]},{"nodeId":10280419,"roleType":"TALK_ROLE_NPC","speakerId":12544,"speakerName":"丑雄","textMapHash":3502707786,"text":"モォモォ。","nextNodeIds":[10280420]},{"nodeId":10280420,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":2928324490,"text":"おっ、丑雄が挨拶してるみてぇだぜ。お前ら、こいつのことは丑雄か丑兄貴って呼んでやってくれ。丑雄は道を探すのが得意なんだ、こいつに案内してもらえば一発だぜ。","nextNodeIds":[10280421]},{"nodeId":10280421,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3757369842,"text":"隠れ構成員なんていたのね…","nextNodeIds":[10280422]},{"nodeId":10280422,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":4198183314,"text":"私には頼りなさそうに見えるんだが。","nextNodeIds":[10280423]},{"nodeId":10280423,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2895124162,"text":"さあ、どうでしょうね。","nextNodeIds":[10280424]},{"nodeId":10280424,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1402861962,"text":"いけ、丑雄！俺たちのために道を切り開け。","nextNodeIds":[10280425]},{"nodeId":10280425,"roleType":"TALK_ROLE_NPC","speakerId":12544,"speakerName":"丑雄","textMapHash":2995563706,"text":"モォ——！","nextNodeIds":[10280426]},{"nodeId":10280426,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":3751672290,"text":"丑雄は隠された出口がないか探し始めた…","nextNodeIds":[10280427]},{"nodeId":10280427,"roleType":"TALK_ROLE_NPC","speakerId":12544,"speakerName":"丑雄","textMapHash":3174151994,"text":"モ…モモ…モォ！","nextNodeIds":[10280428]},{"nodeId":10280428,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":3416695994,"text":"うん？ふむふむ…ああ！？なんだって！？","nextNodeIds":[10280429]},{"nodeId":10280429,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2846359106,"text":"どうしたんだ？","nextNodeIds":[10280430]},{"nodeId":10280430,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1128484722,"text":"道に沿って全部探したらしいが、出口がないらしい。","nextNodeIds":[10280431]},{"nodeId":10280431,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1101245266,"text":"いや、入れるのに出られないわけがねぇ。クソッ…俺様が見てくる。","nextNodeIds":[10280432]},{"nodeId":10280432,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":1309236594,"text":"気付いたか？最初、私たちは上のほうから落ちてきた。つまり、高いところに出入口があったはずだ…それが今はなくなっている。","nextNodeIds":[10280433]},{"nodeId":10280433,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":724453866,"text":"一体、これはどういうことだ？","nextNodeIds":[10280434]},{"nodeId":10280434,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":2792495418,"text":"この地底の建物は、思ったほど単純ではないようだな。","nextNodeIds":[10280435]},{"nodeId":10280435,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":1923497090,"text":"…この辺りを調べてみましょう。","nextNodeIds":[10280436]},{"nodeId":10280436,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2605328578,"text":"この辺、岩壁だらけだな。もしかして…オイラたちが勘違いしてるだけで、本当は落ちてきてなんかいないんじゃないか？","nextNodeIds":[10280437]},{"nodeId":10280437,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":3899688762,"text":"おい、なんだ？怖くなったのか？","nextNodeIds":[10280438]},{"nodeId":10280438,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":999525586,"text":"べ、別にオイラは怖がってなんかないぞ！","nextNodeIds":[10280439]},{"nodeId":10280439,"roleType":"TALK_ROLE_NPC","speakerId":12544,"speakerName":"丑雄","textMapHash":1393627730,"text":"モォ——","nextNodeIds":[10280440]},{"nodeId":10280440,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":2832581586,"text":"お前が怖がってんのを、丑雄は感じ取ってるみたいだぜ。心配すんな、もし怖けりゃ言え。俺たちが守ってやる。","nextNodeIds":[10280441]},{"nodeId":10280441,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2819169482,"text":"#パイモン、{M#俺}{F#私}もついてる。","nextNodeIds":[10280442]},{"nodeId":10280442,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1215207858,"text":"#立ち止まっててもしょうがねぇ。もう一度探すぞ。忍、お前は恩人と一緒にいろ、俺様は{NICKNAME}とパイモンを連れて行く。","nextNodeIds":[10280443]},{"nodeId":10280443,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":3330304762,"text":"分かった。みんな、くれぐれも気を付けてくれ。","nextNodeIds":[10280444]},{"nodeId":10280444,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":4150152122,"text":"恩人だなんて大げさな、私のことは煙緋でいい。それにしてもさすが荒瀧派の親分だ、一斗さんは統率力に優れているんだな。","nextNodeIds":[10280445]},{"nodeId":10280445,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":69430410,"text":"それほどでもねぇよ。それから俺様に「さん」なんていらねぇぜ、一斗って呼んでくれ。お前らとは仲間になるって約束したんだ、助け合わねぇとな。パイモン、怖いなら俺様が目を覆ってやるぜ。","nextNodeIds":[10280446]},{"nodeId":10280446,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1853833378,"text":"一行は分かれて周りを調べたが、収穫はなかった…","nextNodeIds":[10280447]},{"nodeId":10280447,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":4231979362,"text":"…ちっ。","nextNodeIds":[10280448]},{"nodeId":10280448,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2035960258,"text":"本当に出口がないなんて。","nextNodeIds":[10280449]},{"nodeId":10280449,"roleType":"TALK_ROLE_NPC","speakerId":12544,"speakerName":"丑雄","textMapHash":10243010,"text":"モォ！","nextNodeIds":[10280450]},{"nodeId":10280450,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1835239274,"text":"一体どうなってんだここは。","nextNodeIds":[10280451]},{"nodeId":10280451,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":2633335098,"text":"親分、そっちはどうだった？","nextNodeIds":[10280452]},{"nodeId":10280452,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4043946218,"text":"収穫はなかった。","nextNodeIds":[10280453]},{"nodeId":10280453,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":2405703978,"text":"それに、さっきちらっとだが、人影を数人見た気がする…角の生えた化けもんとか出てこなけりゃいいが。","nextNodeIds":[10280454]},{"nodeId":10280454,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2138266874,"text":"冗談なんか言ってる場合じゃないけど、おまえだって角の生えた鬼だろ！","nextNodeIds":[10280455]},{"nodeId":10280455,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1337627834,"text":"そうじゃねぇ！俺様が言ってんのは、姿が消えたりするほうの化けもんだよ。","nextNodeIds":[10280456]},{"nodeId":10280456,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2910993554,"text":"うん？一斗、おまえまさか…お化けが怖いのか？","nextNodeIds":[10280457]},{"nodeId":10280457,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":4088573706,"text":"あらら、バレてしまったみたいだな、親分。","nextNodeIds":[10280458]},{"nodeId":10280458,"roleType":"TALK_ROLE_NPC","speakerId":1044,"speakerName":"荒瀧一斗","textMapHash":1851391794,"text":"そ、そそ、そんなわけねぇだろ！デタラメ言うな！","nextNodeIds":[10280459]},{"nodeId":10280459,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":401070162,"text":"へへっ、一斗の反応を見てたら、急に怖くなくなってきたぞ…おい、牛使い野郎、怖いならオイラ様が目を覆ってやるぜ。","nextNodeIds":[10280460]},{"nodeId":10280460,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":461300858,"text":"……","nextNodeIds":[10280461]},{"nodeId":10280461,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":3850809354,"text":"どうやら、他にやることを探して、この緊迫した空気を和らげないと。","nextNodeIds":[10280462]},{"nodeId":10280462,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":976534730,"text":"（あれ？横で忍が石を拾って、ポケットから枝とスミレウリを取り出した…ん？）","nextNodeIds":[10280463]},{"nodeId":10280463,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":637019234,"text":"塩少々…コショウ少々。","nextNodeIds":[10280464]},{"nodeId":10280464,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3982490098,"text":"スミレウリを焼いてるの？","nextNodeIds":[10280465]},{"nodeId":10280465,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":1569696642,"text":"ああ。焼きスミレウリだ、美味しいから食べてみてくれ。","nextNodeIds":[10280466]},{"nodeId":10280466,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3336643042,"text":"分かった。","nextNodeIds":[10280467]},{"nodeId":10280467,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":2638620794,"text":"あ…塩味と甘めの味付けの二種類あるんだが、どっちがいい？","nextNodeIds":[10280468]},{"nodeId":10280468,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2307423194,"text":"両方ともいける。","nextNodeIds":[10280469]},{"nodeId":10280469,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":3971323106,"text":"そうか、じゃあ二つやろう。このような状況だからこそ、心の平穏を保つのは大事だ。","nextNodeIds":[10280470]},{"nodeId":10280470,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":1745387282,"text":"もし私の推測が正しければ、ここには私と親分が知ってはいけない秘密があるんだろう。安心してくれ、親分が首を突っ込まないようにしておくから。","nextNodeIds":[10280471]},{"nodeId":10280471,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":2863144018,"text":"おっ、食べ物を焼いているのか。","nextNodeIds":[10280472]},{"nodeId":10280472,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":3831472442,"text":"煙緋さんもどうだ？","nextNodeIds":[10280473]},{"nodeId":10280473,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":3859952450,"text":"いや、私はお腹が空いてないから、後でいい。","nextNodeIds":[10280474]},{"nodeId":10280474,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":2112242786,"text":"そう言えば、忍と会うのは久しぶりだね。","nextNodeIds":[10280475]},{"nodeId":10280475,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":1774915674,"text":"ああ。前に会ったのは、私が璃月の学校に通っていた時のことだ。煙緋さんが先生の代わりに授業してくれた。","nextNodeIds":[10280476]},{"nodeId":10280476,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":417135754,"text":"授業…ああ、思い出した。たしか、冬だったか。","nextNodeIds":[10280477]},{"nodeId":10280477,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":472367298,"text":"みんな、煙緋さんの授業はとても面白いと言っていたよ。そう考えると…私は煙緋さんのことを先輩と呼んだほうがよさそうだ。","nextNodeIds":[10280478]},{"nodeId":10280478,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":2208109114,"text":"うん、悪くない呼び方だね、気に入ったよ！","nextNodeIds":[10280479]},{"nodeId":10280479,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":321319338,"text":"まさか、後輩とこのような問題に巻き込まれるとは思ってなかった。これもある種の縁というものだろう。","nextNodeIds":[10280480]},{"nodeId":10280480,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2949154458,"text":"煙緋は授業もできるんだ、すごい。","nextNodeIds":[10280481]},{"nodeId":10280481,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":2583339466,"text":"ああ。しかも、面白い知識を教えてくれるから、学生の中でもかなり人気があったんだ。","nextNodeIds":[10280482]},{"nodeId":10280482,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":2717931898,"text":"はははっ、忍はお世辞が上手だ。","nextNodeIds":[10280483]},{"nodeId":10280483,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3925777338,"text":"全員、ここにいたのね。","nextNodeIds":[10280484]},{"nodeId":10280484,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":3680816698,"text":"夜蘭、手分けして探したんだが、出口は見つからなかった。そっちは収穫あったか？","nextNodeIds":[10280485]},{"nodeId":10280485,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":3307550162,"text":"なかったわ。","nextNodeIds":[10280486]},{"nodeId":10280486,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":1501756482,"text":"それから…あまりこれは言いたくないのだけど、心して聞いてくれるかしら？","nextNodeIds":[10280487]},{"nodeId":10280487,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2200953586,"text":"もし、このまま道が見つからなかったら、しばらく地下で過ごすことになるわ。","nextNodeIds":[10280488]},{"nodeId":10280488,"roleType":"TALK_ROLE_NPC","speakerId":1030,"speakerName":"煙緋","textMapHash":756532186,"text":"…やはりそうなるか。","nextNodeIds":[10280489]},{"nodeId":10280489,"roleType":"TALK_ROLE_NPC","speakerId":1049,"speakerName":"久岐忍","textMapHash":1986065506,"text":"…分かった。","nextNodeIds":[10280490]},{"nodeId":10280490,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":2916455386,"text":"でも、入ることができて、出ることのできない地下空間なんてあり得ない…引き続き、試行錯誤してみるつもりよ。","nextNodeIds":[10280491]},{"nodeId":10280491,"roleType":"TALK_ROLE_NPC","speakerId":1048,"speakerName":"夜蘭","textMapHash":740217170,"text":"みんなも出口に繋がりそうな場所を見つけたら、安全に気を配りながら調べてみてちょうだい。","nextNodeIds":[10280492]},{"nodeId":10280492,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2144266938,"text":"（そういえば、魈もこの場所にいる。困ったことがあれば名前を呼んでくれって言われた…）","nextNodeIds":[10280493]},{"nodeId":10280493,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash