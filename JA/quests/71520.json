{"mainQuestId":71520,"title":"制御不能な実験規模","description":"何があったのか、ずっと璃月の郊外に立ってため息を吐いているスメールの学者がいる。ため息を吐く学者はこれまでにもたくさん見てきたが、こんな場所に一人でいるなんて、一体どうしたのだろうか…","titleTextMapHash":3335523575,"descTextMapHash":3799290982,"mainQuestExcel":{"mainQuestId":71520,"titleTextMapHash":3335523575,"title":"制御不能な実験規模","descTextMapHash":3799290982,"description":"何があったのか、ずっと璃月の郊外に立ってため息を吐いているスメールの学者がいる。ため息を吐く学者はこれまでにもたくさん見てきたが、こんな場所に一人でいるなんて、一体どうしたのだろうか…","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_GUIDE","activeMode":"PLAY_MODE_SINGLE","activityId":5138,"luaPath":"Actor/Quest/WQ71520","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":5138,"chapterId":0,"descTextMapHash":3799290982,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":71520,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2476226625,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ71520","mainQuestTag":"MAINQUEST_TAG_GUIDE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":false,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[171520],"series":0,"showRedPoint":true,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":3335523575,"type":"WQ","unlockDescTextMapHash":3636575734}},"flow":[{"subQuestId":7152001,"order":1,"stepDescription":"ため息を吐く学者と会話する","stepDescTextMapHash":3106321932,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7152001],"talks":[{"talkId":7152001,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7152001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7152001,"initDialog":715200101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30225,1005],"performCfg":"QuestDialogue/WQ/Liyue_71520/Q7152001","priority":5,"questId":71520,"showRandomTalkCount":0},"dialogs":[{"nodeId":715200101,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":4254275442,"text":"む、無理だ…予定の研究課題はとても完成させられそうにない。仕方ない…こうなったら実験の規模を縮小するしか…指導教員にはどう切り出せばいいんだ…","nextNodeIds":[715200102]},{"nodeId":715200102,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1749642610,"text":"「先生、実験が難航しているんです。必要な材料も全く手に入りませんし、どれだけ頭を絞っても必要な実験環境を整えられそうにありません…」","nextNodeIds":[715200103]},{"nodeId":715200103,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":2466466330,"text":"…この言い訳は下手くそすぎる。きっと指導教員に突き返されるだろうな…","nextNodeIds":[715200104]},{"nodeId":715200104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2693012570,"text":"なら、研究課題を完成させられないから、方向性を変えたいって、ちゃんと正直に指導教員に言ったほうがいいぞ！","nextNodeIds":[715200105]},{"nodeId":715200105,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3980804666,"text":"う、うわっ、人の独り言にいきなり入ってくるなよ。","nextNodeIds":[715200106]},{"nodeId":715200106,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":824953114,"text":"あれ、君たちか。ほら、僕だよ。覚えてないかい？生論派の学者ジャミだ。","nextNodeIds":[715200107,715200109]},{"nodeId":715200107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1929267738,"text":"あ、前に研究計画書で散々苦しんでた…","nextNodeIds":[715200108]},{"nodeId":715200108,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":4277439578,"text":"そうそう、そのジャミだよ。終わりのない研究計画書に追い詰められて、草神様に謁見する寸前までいった生論派の学者さ。","nextNodeIds":[715200111]},{"nodeId":715200111,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1091056058,"text":"…はぁ、とにかく、君たちのアドバイスはありがたいけど、研究がここまで進んできちゃって、今更引くに引けない感じなんだ…研究を中止したら、きっと指導教員に三枚おろしにされてしまう…","nextNodeIds":[715200112]},{"nodeId":715200112,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1241360850,"text":"いや、それだけじゃない…その後、干されて組織標本にされて、生論派の実験室に飾られるんだ。「指導教員の期待を裏切ったジャミ」って説明文付きでね。","nextNodeIds":[715200113]},{"nodeId":715200113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":558196050,"text":"教令院の奇妙な都市伝説がまた増えそうだな。うーん…本当にそんな指導教員がいるのか…？","nextNodeIds":[715200114]},{"nodeId":715200114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1218817418,"text":"大げさすぎ…","nextNodeIds":[715200115]},{"nodeId":715200115,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":201520554,"text":"ハハ、標本になって、後輩学者たちに教訓を与えるのも、悪くないかもね…","nextNodeIds":[715200116]},{"nodeId":715200116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3382018514,"text":"うわっ、めちゃくちゃネガティブになっちゃってるじゃないか。","nextNodeIds":[715200117]},{"nodeId":715200117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1200023962,"text":"ところで、なんで研究を中止できないんだ…？だって、無理なものは無理だろ？","nextNodeIds":[715200118]},{"nodeId":715200118,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1613182002,"text":"ちょっと状況が複雑でね。正直なところ、完成させられないってわけでもないんだ…過去に似たような実験を行ったことがあるけど、かなりの成果を上げられたし…","nextNodeIds":[715200119]},{"nodeId":715200119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":604660330,"text":"お、いいことじゃないか！じゃあその実験も続けて進めればいいんじゃないのか！","nextNodeIds":[715200120]},{"nodeId":715200120,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":4250069458,"text":"はぁ、以前の実験が大成功したことが問題なんだ。学院はこの課題に大いに期待を寄せているし、指導教員も珍しく褒めてくれた。","nextNodeIds":[715200121]},{"nodeId":715200121,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1954413290,"text":"あのタヌキじじいが満面の笑みで、「ジャミ、頑張りなさい。きっとできると信じている」とまで言ってくれたんだ。","nextNodeIds":[715200122,715200123]},{"nodeId":715200122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":121509378,"text":"いいことじゃない…","nextNodeIds":[715200124]},{"nodeId":715200124,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1788690658,"text":"はぁ、皆に褒められてすっかり舞い上がってしまった僕は、空前絶後の研究を成し遂げてみんなに披露しようと決心したわけさ！","nextNodeIds":[715200125]},{"nodeId":715200125,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1058806562,"text":"ちょうど、学院からまた新しい実験の予算が下りてきた。","nextNodeIds":[715200126]},{"nodeId":715200126,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":498635218,"text":"それで、僕はその予算を使ってここに最高の実験場を建てた。最先端のマテリアルで実験環境を整え、最高品質の観測機材を揃えた。全部で、本当にかなりの資金が掛かったんだ。","nextNodeIds":[715200127]},{"nodeId":715200127,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1193648082,"text":"もちろん、当時は意気揚々と「最高レベルのものでお願いします」とまで言った。","nextNodeIds":[715200128]},{"nodeId":715200128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4008680586,"text":"へへ、その気持ちはオイラもわかるぜ。レストランで注文する時に、「この店で最高の料理を持ってきてくれ！」って言う時と似たような気分だろうな。","nextNodeIds":[715200129]},{"nodeId":715200129,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1966705642,"text":"そうなんだ…そんな気分の虜になってしまったせいで、いつの間に、費用はどんどん膨れ上がって…実験の規模も物凄いものになってしまった。","nextNodeIds":[715200130]},{"nodeId":715200130,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1290610490,"text":"そういうわけで、実験自体がとてもじゃないけど僕一人の手には負えないものになったってだけじゃなく、実験場の維持費を捻出するために、アシスタントを雇う余裕もなくなってしまった…","nextNodeIds":[715200131]},{"nodeId":715200131,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3983873498,"text":"でも今更実験の規模を縮小したいなんて言い出したら、きっとマハマトラに予算の使い道を指摘され、僕が私腹を肥やしているんじゃないかって怪しまれるに違いない。","nextNodeIds":[715200132]},{"nodeId":715200132,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":4176294130,"text":"ハハ、マハマトラに怪しまれるぐらいなら、いっそのこと今すぐ帰って自首したほうがいい…自首する前に、ランバド酒場で豪華な最後の晩餐を楽しもう。","nextNodeIds":[715200133]},{"nodeId":715200133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4243182594,"text":"「この店で最高の料理を頼む！」","nextNodeIds":[715200134]},{"nodeId":715200134,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3031920986,"text":"わ！オイラたちも一緒に行っていいか？…って、違う！おまえ、自分の実験をもう少しなんとかしてみろよ！","nextNodeIds":[715200135]},{"nodeId":715200135,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3969994834,"text":"何に困ってるんだ？オイラたちに言ってみろ！","nextNodeIds":[715200136]},{"nodeId":715200136,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3859174402,"text":"もっとモラがほしい…","nextNodeIds":[715200137]},{"nodeId":715200137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3428232258,"text":"#おっ、{NICKNAME}。あそこにちょうちょがいるぞ。行ってみようぜ。","nextNodeIds":[715200138,715200139]},{"nodeId":715200138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2565228954,"text":"空飛ぶトカゲかも！","nextNodeIds":[715200140]},{"nodeId":715200140,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1744567770,"text":"#ちょっと待ってくれ。最後まで話を聞いてくれよ。モラがほしいのは実験を手伝う観察員を雇うためなんだ。{NICKNAME}、パイモン！","nextNodeIds":[715200141]},{"nodeId":715200141,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1804041738,"text":"もし君たちが実験を手伝ってくれるなら、観察員を雇わなくて済む。実験が終わったら、返品できる機材は全部返して、余ったモラを報酬として…","nextNodeIds":[715200142]},{"nodeId":715200142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3628167682,"text":"#…なるほどな。{NICKNAME}、おまえはどうだ？","nextNodeIds":[715200143]},{"nodeId":715200143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":689641162,"text":"そういう事情なら。","nextNodeIds":[715200144]},{"nodeId":715200144,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2264076890,"text":"でもジャミ、いろいろ話は聞かせてもらったけど、おまえのいう実験の観察員って、いったい何をすればいいんだ？","nextNodeIds":[715200145]},{"nodeId":715200145,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3938425938,"text":"実は僕の研究課題は、色んな生物の戦闘時における動作の欠陥なんだ。研究材料を集めるためには、様々な生物と戦いながら、写真を撮る必要がある。","nextNodeIds":[715200146]},{"nodeId":715200146,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1270531154,"text":"…どうりで観察員を雇うのに大金が掛かるワケだぜ。","nextNodeIds":[715200147]},{"nodeId":715200147,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3438533274,"text":"一定の危険が伴うのは事実だけど。はぁ、二人に無理強いするつもりはないさ。今後もし生論派の実験室に寄る機会があったら、標本になった僕に花でも手向けてくれ…","nextNodeIds":[715200148]},{"nodeId":715200148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1089226834,"text":"わかったわかった。戦闘ならお安い御用だけど…でも、戦闘中に写真を撮るとなると、考えるだけで面倒くさいぞ…","nextNodeIds":[715200149]},{"nodeId":715200149,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1640673874,"text":"大丈夫だ。そんな時こそ僕が配合した「フェーイズポーション」の出番さ。","nextNodeIds":[715200150]},{"nodeId":715200150,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":559420226,"text":"これは実験場で効果を発揮する薬で、実験場でこれを飲めば、「主観的な」時間感覚がとてもゆっくりになるんだ。","nextNodeIds":[715200151]},{"nodeId":715200151,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3745965994,"text":"元々避けられない攻撃はやっぱり避けられないんだけどね。ハハ、少なくとも撮影の角度を調整するために十分な時間は稼げるはずだ。","nextNodeIds":[715200152]},{"nodeId":715200152,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":498422722,"text":"その口ぶりだと、「怪我するのはどうせ避けられないから、せめていい写真を撮ってくれ！」って意味に聞こえるけどな。","nextNodeIds":[715200153]},{"nodeId":715200153,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1956846730,"text":"大丈夫さ。二人は見るからに百戦錬磨っぽいし、危険なことは起こらないだろう。","nextNodeIds":[715200154]},{"nodeId":715200154,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":3440538410,"text":"でも…写真がよく撮れることよりも、二人の安全のほうが大事だって思ってるよ。これは本心だ。","nextNodeIds":[715200155]},{"nodeId":715200155,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1810712298,"text":"うん、気を付ける！","nextNodeIds":[715200156]},{"nodeId":715200156,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":1863341306,"text":"うぅ、僕のなけなしの学術界での名声を守れるかどうかは、二人の手に掛かっている！","nextNodeIds":[]},{"nodeId":715200139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2167197506,"text":"行こう、パイモン！","nextNodeIds":[715200140]},{"nodeId":715200123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3515346250,"text":"みんなの優しさが問題ってこと？","nextNodeIds":[715200124]},{"nodeId":715200109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1263818634,"text":"…誰だっけ？","nextNodeIds":[715200110]},{"nodeId":715200110,"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","textMapHash":2363446834,"text":"研究テーマを選び間違えたせいで、実験に追い詰められていたジャミさ。そうだ、「ため息をつく教令院の学者」ジャミ、ってあだ名までついてただろ。","nextNodeIds":[715200111]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7152001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30225"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7152001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30225,"speakerName":"ジャミ","count":32},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":10}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171520],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3799290982,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ