g":10230201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10261],"performCfg":"QuestDialogue/AQ/Liyue3_1023/Q102302","priority":5,"questId":1023,"showRandomTalkCount":0},"dialogs":[{"nodeId":10230201,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1126368409,"text":"「案内人」としての使命を果たしたのに、なぜ自ら火中に飛び込むんだい？","nextNodeIds":[10230202]},{"nodeId":10230202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3518548553,"text":"ん？誰だ！","nextNodeIds":[10230203]},{"nodeId":10230203,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3175763801,"text":"君たちが「ファデュイ」なら、女皇から報酬を貰えるかもしれないが。","nextNodeIds":[10230204]},{"nodeId":10230204,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":2367923585,"text":"残念ながら、今の君たちはただの邪魔者だよ。","nextNodeIds":[10230205,10230208]},{"nodeId":10230205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2341231433,"text":"どうしてここを知ってる？","nextNodeIds":[10230206]},{"nodeId":10230206,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1080516673,"text":"どこから話そうかな？遠回りは俺のスタイルじゃなかったんだけど、まさか璃月に着いた途端に岩神が死んで、その亡骸まで隠されるなんてね。","nextNodeIds":[10230207]},{"nodeId":10230207,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1416155313,"text":"でも君たちの「送仙儀式」のおかげで、面倒事になる前に情報を掴めた。","nextNodeIds":[10230211]},{"nodeId":10230211,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3286765345,"text":"ハッ…モラの製造を止めてまで「仙祖の亡骸」を隠すだなんて…七星も本気だな。","nextNodeIds":[10230212]},{"nodeId":10230212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1068270841,"text":"ま、まさかおまえも「神の心」を狙ってるのか？","nextNodeIds":[10230213]},{"nodeId":10230213,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3427791713,"text":"ファデュイの第十一位の執行官として、俺は氷の女皇の意志に従う。","nextNodeIds":[10230214]},{"nodeId":10230214,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1710211681,"text":"女皇が欲するものは、必ず手に入れる。","nextNodeIds":[10230215,10230216]},{"nodeId":10230215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1360019193,"text":"許さない。","nextNodeIds":[10230217]},{"nodeId":10230217,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":133344065,"text":"誰かの許しはいらない。本気なら俺を止めてみろ。","nextNodeIds":[10230218]},{"nodeId":10230218,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1020618945,"text":"取引や駆け引きの時間は終わった…小細工を使うのは好きじゃないが、女皇のために俺は我慢したよ。","nextNodeIds":[10230219]},{"nodeId":10230219,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":741649953,"text":"ここからは、もっと単純で楽しいことをしよう…","nextNodeIds":[10230220]},{"nodeId":10230220,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":2048942697,"text":"「戦い」だ。","nextNodeIds":[10230221]},{"nodeId":10230221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1815283761,"text":"戦い？まさかケンカが好きなのか？","nextNodeIds":[10230222]},{"nodeId":10230222,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":2677908417,"text":"ハハハッ、そうだね。","nextNodeIds":[10230223]},{"nodeId":10230223,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3837132937,"text":"「淑女」はモンドの大聖堂で神を襲い、そして足早に姿を消した。","nextNodeIds":[10230224]},{"nodeId":10230224,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":855873441,"text":"君と戦うよりも氷雪で君の行動を封じたのは、戦いの音で騎士たちが集まるのを忌避したからだ。","nextNodeIds":[10230225]},{"nodeId":10230225,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3445119233,"text":"強者に対して、彼女は利益や勝ち負け、その後の影響を優先する…","nextNodeIds":[10230226]},{"nodeId":10230226,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3299280401,"text":"だが俺が「執行官」になった最大の楽しみは、強者と戦える点にある。","nextNodeIds":[10230227]},{"nodeId":10230227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":278245281,"text":"モンドの時みたいに、思い通りにはさせないぞ！","nextNodeIds":[10230228]},{"nodeId":10230228,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":2510736753,"text":"ああ、やってみるといいさ。旅人、俺は君を殺さない。俺は戦闘の快楽を味わいたいだけなんだ、付き合ってくれ。","nextNodeIds":[10230229]},{"nodeId":10230229,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3564233817,"text":"君は俺に勝てない、だから勝ち負けではなく、俺と同じ戦いを楽しめばいい。そう言えば理解できるかな？","nextNodeIds":[10230230]},{"nodeId":10230230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2158060753,"text":"勝てない？それはどうかな。","nextNodeIds":[10230231]},{"nodeId":10230231,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":4075140257,"text":"ハハハハハッ！","nextNodeIds":[10230232]},{"nodeId":10230232,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":4015596265,"text":"よしっ！君もその気なら、俺を楽しませてくれよ。","nextNodeIds":[]},{"nodeId":10230216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":973866561,"text":"「仙祖の亡骸」に近づけさせない。","nextNodeIds":[10230217]},{"nodeId":10230208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":244078537,"text":"まだ遅くはない、阻止してみせる。","nextNodeIds":[10230209]},{"nodeId":10230209,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":221742697,"text":"君たちのおかげで俺は苦労せず、ここを見つけられたけど…","nextNodeIds":[10230210]},{"nodeId":10230210,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1409161673,"text":"今さら俺を止めようと？無駄だよ。","nextNodeIds":[10230211]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[102302,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["20101","220101001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIF