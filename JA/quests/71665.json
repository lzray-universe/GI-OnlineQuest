ARGET","LNHLPKELCAL":["30545"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166501],"talks":[{"talkId":7166501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7166501","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166501,"initDialog":716650101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30545],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_71665/Q7166501","priority":5,"questId":71665,"showRandomTalkCount":0},"dialogs":[{"nodeId":716650101,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3776212818,"text":"おっと、やっと来てくれたな。君が「主人公」だろうか？","nextNodeIds":[716650102,716650104]},{"nodeId":716650102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3202864858,"text":"#そう、{M#俺}{F#私}こそが主人公。","nextNodeIds":[716650103]},{"nodeId":716650103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1836587914,"text":"えっと、その質問の意図が全然わかんないんだけど…","nextNodeIds":[716650105]},{"nodeId":716650105,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3840997162,"text":"おっと、すまんすまん。つい先を急いでしまった。依頼を出す時にも、まず簡潔な言葉で依頼内容を説明すべきだと言われたというのに。","nextNodeIds":[716650106]},{"nodeId":716650106,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":1554484810,"text":"私はランジット、創作料理の道を歩むシェフだ。爆炎樹と仲良くなりたいと思ってるんだが、あいにく向こうにその気はないようでね…","nextNodeIds":[716650107]},{"nodeId":716650107,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":942335594,"text":"火の玉を吐いたり、地面を叩きつけたりしてくる。まったく手も足も出ないから、物語の主人公になれるような冒険者に手伝ってもらいたいんだ。","nextNodeIds":[716650108,716650110]},{"nodeId":716650108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2523097578,"text":"分かった、任せて。","nextNodeIds":[716650109]},{"nodeId":716650109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1935179922,"text":"こんなむちゃくちゃな依頼をあっさり引き受けるなよ！","nextNodeIds":[716650111]},{"nodeId":716650111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1400377370,"text":"おまえ、本気なのか？創作料理のシェフが爆炎樹と仲良くなりたいだなんて…どう考えてもおかしいだろ！？","nextNodeIds":[716650112]},{"nodeId":716650112,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":500944842,"text":"そうか？確かに爆炎樹は植物なのに少し乱暴だが…物は試しって言うだろ？","nextNodeIds":[716650113]},{"nodeId":716650113,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":1650978242,"text":"爆炎樹以外にも、エンシェントヴィシャップ、マッシュラプトル、それに千年真珠の海駿とも仲良くなる予定だ！","nextNodeIds":[716650114]},{"nodeId":716650114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4158306570,"text":"…うわー、ますますむちゃくちゃだな。なんでそんなことを思うようになったんだよ？","nextNodeIds":[716650115]},{"nodeId":716650115,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":4268528666,"text":"ああ。実は、少し前にナタに行ってきたんだ…","nextNodeIds":[716650116]},{"nodeId":716650116,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3595479322,"text":"あそこは本当に不思議な場所だよ。あの新鮮さを喩えるなら、初めて激辛カレーを食べて、全身に汗をかいた時の感じと言えばいいだろうか。","nextNodeIds":[716650117]},{"nodeId":716650117,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":4275089410,"text":"舌がとっくに限界だというのに、手が止まらないんだ…","nextNodeIds":[716650118]},{"nodeId":716650118,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3068995826,"text":"…そうそう、その時にナタで友人をたくさん作ってね。岩登りを教えてくれたり、温泉に連れていってくれたりと、いいやつらばっかりだったよ。","nextNodeIds":[716650119]},{"nodeId":716650119,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":2102661402,"text":"知ってるか？ナタ人——特にその戦士は、自分らの竜の姿を模した服を身にまとってるんだ。その恰好はまるで本物の竜のように逞しくってね！","nextNodeIds":[716650120]},{"nodeId":716650120,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":1009163746,"text":"そこで、私もナタの友人の帽子にならって作ってみた。どうだ？悪くないだろ？","nextNodeIds":[716650121]},{"nodeId":716650121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1606808586,"text":"えっと…たしかに特徴的な帽子だな。でも、その帽子だけじゃ、なにもわからないぞ。","nextNodeIds":[716650122]},{"nodeId":716650122,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":223490954,"text":"それもそうだろう。なぜなら私には、竜の仲間がいないからな！","nextNodeIds":[716650123]},{"nodeId":716650123,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":1479766570,"text":"はぁ…私にも竜の仲間がいてくれたら…。だが私はナタ人じゃないし、あの国に長居しても落ち着くことはできない。","nextNodeIds":[716650124]},{"nodeId":716650124,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":514244730,"text":"そこでだ。ナタ以外の場所でも、竜の代わりになる仲間を探そうと決めたんだ！可能かどうかは別として、少なくとも次にナタに行く時の話のネタにはなるだろう！","nextNodeIds":[716650125]},{"nodeId":716650125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2013513538,"text":"だとしても、もう少し相手を選んだほうがいいんじゃないか…？","nextNodeIds":[716650126]},{"nodeId":716650126,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3510855586,"text":"ん？ぴったりじゃないか？ほら、ナタの竜とも似てるし、しかも強いだろ！","nextNodeIds":[716650127]},{"nodeId":716650127,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":4226723162,"text":"駄獣を仲間にする程度じゃ自慢にはならないからね。ナタの友人に冒険譚を語るなら、やはりそれなりに手ごわい相手を選ばないと！","nextNodeIds":[716650128]},{"nodeId":716650128,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":2650375978,"text":"ただ残念なのは、私じゃ「主人公」になれない点だ…昼も夜も関係なく怒ってるやつらを落ち着かせるのは、そう簡単なことじゃない。","nextNodeIds":[716650129]},{"nodeId":716650129,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3439567298,"text":"だが経験豊富な冒険者なら、こういうのが得意だろ？もちろん、私も近くでサポートする。網で捕まえるのも、料理を振る舞うのも私に任せくれ。","nextNodeIds":[716650130]},{"nodeId":716650130,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3575615898,"text":"だから、未来の仲間たちと正面から「交涉」するのは君に任せた！「主人公」よ！","nextNodeIds":[716650131]},{"nodeId":716650131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2200400578,"text":"なんで危険なことを全部主人公にやらせるんだよ！","nextNodeIds":[716650132,716650134]},{"nodeId":716650132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3420290674,"text":"苦労に見合った報酬をくれるといいけど…","nextNodeIds":[716650133]},{"nodeId":716650133,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3928930210,"text":"それはもちろん！報酬については心配不要だ。","nextNodeIds":[716650136]},{"nodeId":716650136,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":3225588290,"text":"よし！そうと決まれば、さっそく出発しようか？鍋は用意してあるし、装備のメンテナンスもパッチリ。きっと上手くいくだろう！","nextNodeIds":[716650137,716650138]},{"nodeId":716650137,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":184141762,"text":"うん、行こう。","nextNodeIds":[]},{"nodeId":716650138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4125386938,"text":"他に用事があるから、またあとで。","nextNodeIds":[716650139]},{"nodeId":716650139,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":2216183266,"text":"ああ。じゃあ、ここで待ってるよ。","nextNodeIds":[]},{"nodeId":716650134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":105975570,"text":"「理屈責め」のあと交流するんだね、了解。","nextNodeIds":[716650135]},{"nodeId":716650135,"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","textMapHash":2937745658,"text":"ああ、その通りだよ。","nextNodeIds":[716650136]},{"nodeId":716650110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":846505994,"text":"説明が簡潔すぎて、全然理解できなかった。","nextNodeIds":[716650111]},{"nodeId":716650104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":638459650,"text":"何を言ってるの…？","nextNodeIds":[716650105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30545"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7166501],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30545,"speakerName":"ランジット","count":24},