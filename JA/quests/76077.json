rId":7016,"speakerName":"サリーン","textMapHash":805258986,"text":"これがお探しの本です。ネフェルさん、どうぞご確認を。","nextNodeIds":[760770102]},{"nodeId":760770102,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":484114,"text":"さて、どれどれ…へぇ…なんて偶然だろうね。この本に書いてある物語は、ちょうどあの『ロバになった人』だよ。","nextNodeIds":[760770103]},{"nodeId":760770103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1623399370,"text":"ネフェル？彼女も依頼を受けるんだ？","nextNodeIds":[760770104]},{"nodeId":760770104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":964840522,"text":"いや、どう考えてもあいつは依頼を受ける側じゃなくて、誰かに任せる側だろ？","nextNodeIds":[760770105,760770106]},{"nodeId":760770105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2190560218,"text":"まあ…確かにそっか。","nextNodeIds":[760770107]},{"nodeId":760770107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1091772258,"text":"おまえな、ヤフォダの仕事を奪ってやるなよ…","nextNodeIds":[760770108]},{"nodeId":760770108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2089427938,"text":"でもネフェルのやつ、冒険者協会にどんな依頼を出したんだろ？ちょっと気になるな…","nextNodeIds":[760770109,760770110]},{"nodeId":760770109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1463172250,"text":"話が落ち着いたら、聞いてみよう。","nextNodeIds":[760770111]},{"nodeId":760770111,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1640583506,"text":"間違いない…これは確かにあたしが探してた本だ。さすがは冒険者協会、大したもんだね。こんな昔に失われた物語をよく見つけてくれたよ。","nextNodeIds":[760770112]},{"nodeId":760770112,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":675688274,"text":"ははっ、それも冒険者たちが頑張ったおかげですよ。","nextNodeIds":[760770113]},{"nodeId":760770113,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":4081846946,"text":"探している間は紆余曲折ありましたが、最終的にスネージナヤのある収集家がこの本の写しを持っていることを突き止めまして。","nextNodeIds":[760770114]},{"nodeId":760770114,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1286008218,"text":"砂漠の物語がスネージナヤにまで伝わってるとは、面白い。","nextNodeIds":[760770115]},{"nodeId":760770115,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1324934354,"text":"礼を言うよ。約束通り、この本の報酬はきちんと払わせてもらう。","nextNodeIds":[760770116]},{"nodeId":760770116,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":619670090,"text":"それと、この依頼は引き続き公開したままにしてもらえるかい？優先度も高めにしてほしい。必要な費用は、すべてあたしが払う。","nextNodeIds":[760770117]},{"nodeId":760770117,"roleType":"TALK_ROLE_NPC","speakerId":7016,"speakerName":"サリーン","textMapHash":2547748906,"text":"もちろんです。ネフェルさんとの取引は冒険者協会にとっても光栄なことですから。さっそく手配してきますので、私はお先に失礼します。","nextNodeIds":[760770118]},{"nodeId":760770118,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2600179322,"text":"旅人、パイモン。話は終わったよ。好奇心を満たしたいのなら応えてあげよう。","nextNodeIds":[760770119,760770120]},{"nodeId":760770119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":734738186,"text":"#{M#俺}{F#私}たちに気づいてたの？","nextNodeIds":[760770121]},{"nodeId":760770121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1969831026,"text":"オイラの声まで聞こえてたのか？さすがネフェルだぞ…","nextNodeIds":[760770122]},{"nodeId":760770122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3695790682,"text":"何か依頼を出したの？","nextNodeIds":[760770123]},{"nodeId":760770123,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3986691066,"text":"まあ似たようなものだね。でも、あたしと冒険者協会の長期協力って言ったほうが正しい。","nextNodeIds":[760770124]},{"nodeId":760770124,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2061468722,"text":"さあ、秘聞の館でお茶でもしよう。ここは物語を語るのにふさわしくないからね。","nextNodeIds":[]},{"nodeId":760770120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2935712794,"text":"目がいいんだね…","nextNodeIds":[760770121]},{"nodeId":760770110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2864846914,"text":"今は邪魔をしないほうが良さそう。","nextNodeIds":[760770111]},{"nodeId":760770106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":558787954,"text":"楽な依頼なら、今度受けてみようかな。","nextNodeIds":[760770107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["1316"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7607702,"order":2,"stepDescription":"ネフェルと共に「秘聞の館」に戻る","stepDescTextMapHash":4224573932,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[1205_32:-5.423,0.291,-48.909,0.000,238.763,0.000]","10"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[7607702],"talks":[{"talkId":7607702,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7607702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7607702,"initDialog":760770201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1316],"performCfg":"QuestDialogue/WQ/NodKrai_76077/Q7607702","priority":5,"questId":76077,"showRandomTalkCount":0},"dialogs":[{"nodeId":760770201,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3636772210,"text":"…おや、ヤフォダはまだ戻ってないみたいだね。","nextNodeIds":[760770202]},{"nodeId":760770202,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3112291154,"text":"ここでちょっと待っててくれ。お茶を淹れてくるよ。","nextNodeIds":[760770203]},{"nodeId":760770203,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"アシュル","textMapHash":2193588122,"text":"ニャー","nextNodeIds":[760770204]},{"nodeId":760770204,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2525204026,"text":"アシュル、よしよし。","nextNodeIds":[760770205]},{"nodeId":760770205,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"アシュル","textMapHash":2435645554,"text":"ニャ、ニャニャ。","nextNodeIds":[760770206]},{"nodeId":760770206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":129460466,"text":"へへっ、アシュルはいい子だな～ほら、お手。","nextNodeIds":[760770207]},{"nodeId":760770207,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"アシュル","textMapHash":651994746,"text":"にゃ？","nextNodeIds":[760770208]},{"nodeId":760770208,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":919355882,"text":"お待たせ、お茶の用意ができたよ。ミルクと砂糖はそこにあるから、必要ならどうぞ。","nextNodeIds":[760770209]},{"nodeId":760770209,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2540045218,"text":"アシュルはあんたたちによく懐いてるみたいだね。あたしがこの子を拾ったときは、まるでライオンのように暴れてたのに。","nextNodeIds":[760770210]},{"nodeId":760770210,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1149936602,"text":"あたし以外、ほとんど誰も触れなかったんだよ。迂闊に近づくと、大抵はこいつの爪と牙で追い払われたものさ。","nextNodeIds":[760770211]},{"nodeId":760770211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2599082626,"text":"アシュルってそんなに暴れん坊だったのか？今の姿からは想像もつかないな。","nextNodeIds":[760770212]},{"nodeId":760770212,"roleType":"TALK_ROLE_NPC","speakerId":7143,"speakerName":"アシュル","textMapHash":471692786,"text":"ニャ、ニャニャ？ニャ…","nextNodeIds":[760770213]},{"nodeId":760770213,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1608214274,"text":"もう随分と昔のことさ。当時、あたしとこいつはナド・クライに来たばかりだった。","nextNodeIds":[760770214]},{"nodeId":760770214,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":389426186,"text":"あたしたちには頼れるものが何もなくってね。あの時のナド・クライで生き延びるためには、牙を剥くしかなかったんだ。","nextNodeIds":[760770215]},{"nodeId":760770215,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1376449818,"text":"…もう、そんな必要はないけどね。","nextNodeIds":[760770216]},{"nodeId":760770216,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2377405746,"text":"さて、今はあんたたちの好奇心を満たしてあげる時間だよ。あたしと冒険者協会の「長期協力」に興味があるんだったね？","nextNodeIds":[760770217,760770218]},{"nodeId":760770217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2937223866,"text":"ネフェルが冒険者協会に依頼するなんて…","nextNodeIds":[760770219]},{"nodeId":760770219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2733291762,"text":"ネフェルが他の人を頼らないといけないなんて、よっぽどすごい宝物なんじゃないか？","nextNodeIds":[760770220]},{"nodeId":760770220,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1427762802,"text":"大事なものではあるけど、宝物かどうかは人によるね。","nextNodeIds":[760770221]},{"nodeId":760770221,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1376546362,"text":"ほら、冒険者協会に探してもらったのはこの本だよ。見てみるといい。","nextNodeIds":[760770222]},{"nodeId":760770222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3332532258,"text":"読んだ感じ、スメールの童話っぽいな…","nextNodeIds":[760770223,760770224]},{"nodeId":760770223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2094238178,"text":"これが宝物の手がかりなの？","nextNodeIds":[760770225]},{"nodeId":760770225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3548106882,"text":"えっ？また謎解きと宝探しか？じゃあ応援してるぞ！たぶん、オイラには解けないだろうから…","nextNodeIds":[760770226]},{"nodeId":760770226,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2074587754,"text":"そういうんじゃないよ。これは、スメールの砂漠に伝わるごく普通の物語さ。宝の在り処が記されてるわけでもなければ、隠された暗号もない。","nextNodeIds":[760770227]},{"nodeId":760770227,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1260771106,"text":"あたしがわざわざ探してたのはね、父と関係してるからだよ。","nextNodeIds":[760770228]},{"nodeId":760770228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2948257538,"text":"ネフェルのお父さん…","nextNodeIds":[760770229]},{"nodeId":760770229,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1191345082,"text":"そう。以前、父のことを「紹介」しただろう？あたしたちがどんな運命を辿ったかも覚えてるはずだ。","nextNodeIds":[760770230]},{"nodeId":760770230,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":848800706,"text":"災厄を呼ぶ「戦利品」を持ち帰り、村が黄砂に呑み込まれる前…父はよくあたしに物語を聞かせてくれた。","nextNodeIds":[760770231]},{"nodeId":760770231,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3910017482,"text":"もちろん、当時のスメールの状況はあんたたちも知ってるだろう。温かくて知恵に溢れた物語は、雨林の幸運な子たちだけが聞ける特権だった。","nextNodeIds":[760770232]},{"nodeId":760770232,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2419844962,"text":"防砂壁で隔てられた砂漠の民にとって、知恵と温情は贅沢品だ。","nextNodeIds":[760770233]},{"nodeId":760770233,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3928765322,"text":"彼らが語り継いできた物語の、唯一にして最も重要な役割…それは子供たちに生きる方法を教えることだ。","nextNodeIds":[760770234]},{"nodeId":760770234,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3528764562,"text":"たとえば、食べ物を粗末にすればサソリになり、水を大切にしない人は舌を失う…","nextNodeIds":[760770235]},{"nodeId":760770235,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1407071258,"text":"それから善良は美徳だが、他人を簡単に信じてしまえば災いを招く。騙してもいいが、バレないことが前提だ…とかね。","nextNodeIds":[760770236]},{"nodeId":760770236,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2245138,"text":"でも父は、こういう物語に感化された「典型的な砂漠の人間」になってほしくなかったようだ。","nextNodeIds":[760770237]},{"nodeId":760770237,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1666777866,"text":"集めた物語を脚色して、もっとこう…温かい物語に変えていた。","nextNodeIds":[760770238]},{"nodeId":760770238,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4245814202,"text":"父の物語では、嘘つきはロバになり、好き嫌いをする子供は歯が痛くなり…人殺しは崖から落ちる運命にあった。","nextNodeIds":[760770239]},{"nodeId":760770239,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1780548722,"text":"その気持ち、ちょっとわかるぞ。誰だって自分の子供には立派に育ってほしいって、思うはずだもんな…","nextNodeIds":[760770240]},{"nodeId":760770240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":493510682,"text":"ネフェルはそういう物語が好きなの？","nextNodeIds":[760770241]},{"nodeId":760770241,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":229238962,"text":"あたし？","nextNodeIds":[760770242]},{"nodeId":760770242,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3394825618,"text":"ああ。当時のあたしは好きだったよ。毎晩、父が寝かしつけのために聞かせてくれる物語を心待ちにしてた。","nextNodeIds":[760770243]},{"nodeId":760770243,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":15464890,"text":"昼になると、あたしはその本を持って外に出て、他の子供に聞かせるんだ。","nextNodeIds":[760770244]},{"nodeId":760770244,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":384469466,"text":"みんな、あたしを羨ましがってた。どこへ行っても子供たちがついてきて、物語を聞くために何でもしてくれた。","nextNodeIds":[760770245]},{"nodeId":760770245,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4206608762,"text":"すべてが終わりを迎える、その時までね…父も友人も部族の人も、そして物語も、黄砂の下に埋もれてしまった。","nextNodeIds":[760770246]},{"nodeId":760770246,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1981079034,"text":"……","nextNodeIds":[760770247]},{"nodeId":760770247,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1096307514,"text":"その後、あたしは教令院に行った。そこで、物語の「原作」をいくつか読んだんだ。","nextNodeIds":[760770248]},{"nodeId":760770248,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3827660746,"text":"詐欺師は一度も罰せられない。なぜなら騙される愚か者が悪いから。殺人犯はいつも逃げ延びる。なぜならそいつの手にしか剣がないから。","nextNodeIds":[760770249]},{"nodeId":760770249,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1037584738,"text":"好き嫌いする子供は…水を無駄にした子供と同じようにトカゲに変えられ、永遠に岩の下で縮こまっていた。","nextNodeIds":[760770250]},{"nodeId":760770250,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":913855554,"text":"その時ようやく気づいたのさ。父はあたしをずっと「騙して」いたことに。その筆で、温もりのある世界を描いていたんだ。","nextNodeIds":[760770251]},{"nodeId":760770251,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3648758114,"text":"けれど父はもういない。その偽りの世界は滅んだ。あたしは真相と向き合うべきだと思ったよ。","nextNodeIds":[760770252]},{"nodeId":760770252,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1950112450,"text":"幸い、あたしは要領が良くてね。すぐ「砂漠の人間」になれたよ——父が望まなかった存在にね。","nextNodeIds":[760770253]},{"nodeId":760770253,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4252547658,"text":"その後は嘘、欺瞞、復讐、破滅。砂漠で何万回も繰り返されてきた展開が続く。あんたたちもよく知ってるものだよ。","nextNodeIds":[760770254,760770255]},{"nodeId":760770254,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1881401922,"text":"ネフェルが物語を集めてるのは…","nextNodeIds":[760770256]},{"nodeId":760770256,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":781095730,"text":"そうなるね。あの人が自分の娘にどれだけの嘘をついていたのか、あたしは知りたい。それだけだよ。","nextNodeIds":[760770257]},{"nodeId":760770257,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2630249418,"text":"この世界でたった一人、父に騙された人間として、その詐欺を書き留める義務があると思ってる。だって、あの人は詐欺師として無名すぎるからね。","nextNodeIds":[760770258]},{"nodeId":760770258,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3992121754,"text":"それに、トキの王トートもあたしのこの行動を歓迎してくれてるはずだよ。","nextNodeIds":[760770259]},{"nodeId":760770259,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1534779410,"text":"「真偽を見定める道具を探せ」って言ったのは、他でもないトートなんだから。","nextNodeIds":[760770260]},{"nodeId":760770260,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1906477410,"text":"父が脚色した物語は、幼いあたしが世界をどう見るか、その基盤を作った。","nextNodeIds":[760770261]},{"nodeId":760770261,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2281672018,"text":"そして、物語の本当の結末を知って…ふふっ、この世界の真の姿をより深く理解できるようになった。","nextNodeIds":[760770262]},{"nodeId":760770262,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4035294242,"text":"あたしにとって、これらの物語は確かに「真偽を見定める」手助けになったのさ。","nextNodeIds":[760770263]},{"nodeId":760770263,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2546851674,"text":"こうして集めていくことで、トキの王が求めてる答えに繋がるかもしれない。","nextNodeIds":[760770264]},{"nodeId":760770264,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1573129538,"text":"だから、ナド・クライで落ち着いた後、あたしは様々なルートを使って、父が話してくれた物語の原作を探すことにした。","nextNodeIds":[760770265]},{"nodeId":760770265,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2083200330,"text":"でもこれら物語のほとんどは、砂漠の民が口で語り継いできたもので、文字として残っていない。","nextNodeIds":[760770266]},{"nodeId":760770266,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":733834370,"text":"それに今はナド・クライにいるし、この足で砂漠に残る人たちを訪ねることも難しい。","nextNodeIds":[760770267]},{"nodeId":760770267,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2986496994,"text":"ヤフォダに任せようかとも思ったけど…元々うちは人手不足だからね。それはやめたよ。","nextNodeIds":[760770268]},{"nodeId":760770268,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1213038450,"text":"だから、無数の冒険者を抱える冒険者協会と長期の協力関係を結んだのさ。","nextNodeIds":[760770269]},{"nodeId":760770269,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2394349290,"text":"砂漠の民の物語を届けてくれたら、それに見合う報酬を支払う。そうだね…ちょっとした手助けをすることもある。","nextNodeIds":[760770270]},{"nodeId":760770270,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4103532218,"text":"サリーンはあたしの条件を快く受け入れ、すぐに合意してくれた。結果として、この協力関係はとても満足のいくものになってる。","nextNodeIds":[760770271]},{"nodeId":760770271,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3122977850,"text":"それで…さっき手に入れた物語は…","nextNodeIds":[760770272]},{"nodeId":760770272,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3030358322,"text":"ああ、これは父があたしに話してくれた最後の物語で、唯一どこも脚色がされてなかった物語でもある。","nextNodeIds":[760770274]},{"nodeId":760770274,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":772914522,"text":"ずっと嘘をついてきたその人は、初めて物語を正しく語った後、黄砂に埋もれてしまった。","nextNodeIds":[760770288]},{"nodeId":760770288,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":420507538,"text":"はあ…この物語の中にこんな一節がある——「彼は心の奥底から善良であり、これは何ものにも代えがたい知恵である」ってね。皮肉にもほどがあるって思わないかい？","nextNodeIds":[760770275]},{"nodeId":760770275,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3839964698,"text":"この物語に興味があるなら、写しをあげよう。","nextNodeIds":[760770276]},{"nodeId":760770276,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3088892226,"text":"ちなみに旅人、あんたも冒険者だったね？","nextNodeIds":[760770277,760770278]},{"nodeId":760770277,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1390936234,"text":"えっ？あっ、うん…","nextNodeIds":[760770279]},{"nodeId":760770279,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3720588250,"text":"あんたはずっと世界を旅していて、知識が豊富だってことも知ってる。","nextNodeIds":[760770280]},{"nodeId":760770280,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":4204850818,"text":"だからさ、その気があったら、長期的な協力関係を結んでみないかと思ってね。どうだい？","nextNodeIds":[760770281]},{"nodeId":760770281,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":2465178178,"text":"もし旅の途中で、スメールの砂漠の人間にまつわる物語を手に入れたら、あたしに届けてくれないかい？その時は満足のいく報酬を支払おう。","nextNodeIds":[760770282]},{"nodeId":760770282,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3346376514,"text":"オイラたちをここに来させたのは、それを言うためだったんだな！","nextNodeIds":[760770283,760770284]},{"nodeId":760770283,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2914881162,"text":"ネフェルはやっぱり依頼する側だった…","nextNodeIds":[760770285]},{"nodeId":760770285,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":1544954186,"text":"ふふっ、じゃあ実り多い協力関係になることを願ってるよ。","nextNodeIds":[760770286]},{"nodeId":760770286,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":91195754,"text":"…それにしても、どうしてヤフォダはまだ戻らないんだろうね。","nextNodeIds":[760770287]},{"nodeId":760770287,"roleType":"TALK_ROLE_NPC","speakerId":1316,"speakerName":"ネフェル","textMapHash":3652191882,"text":"あの子が受けた依頼、そんなに難しいんだろうか？","nextNodeIds":[]},{"nodeId":760770284,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3499682770,"text":"#やっぱり{M#俺}{F#私}って、依頼から逃れられない…","nextNodeIds":[760770285]},{"nodeId":760770278,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2745042642,"text":"どうして急にそんなことを…？","nextNodeIds":[760770279]},{"nodeId":760770255,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2218942690,"text":"原作がどうなってるか知りたいから？","nextNodeIds":[760770256]},{"nodeId":760770224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3491494954,"text":"この中に何か謎解きがあるの？","nextNodeIds":[760770225]},{"nodeId":760770218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3412524930,"text":"きっと、何か大事なものを探してるんだね。","nextNodeIds":[760770219]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7607702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[1205_32:-5.423,0.291,-48.909,0.000,238.763,0.000]","10"],"NOCCOBOFKHP":1205,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[