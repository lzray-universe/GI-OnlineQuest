0105]},{"nodeId":700300105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2760961586,"text":"いやいや、重佐副船長、おまえのことならもちろん覚えてるぞ。こいつ、また冗談を言ってるんだ、ははは。","nextNodeIds":[700300106]},{"nodeId":700300106,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":1028585522,"text":"おっと——なんだ、そうだったのか！まあ、なにしろ俺は「死兆星」号の副船長だしな…","nextNodeIds":[700300107]},{"nodeId":700300107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2145502650,"text":"コホン、何か手伝ってほしいの？","nextNodeIds":[700300108]},{"nodeId":700300108,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":3884743938,"text":"あぁ、いや、実は俺のことじゃなくて、うちの船隊に滞在してる万葉の兄ちゃんのことだ。","nextNodeIds":[700300109]},{"nodeId":700300109,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":2515298458,"text":"お前さんも覚えてるよな？稲妻から帰港する時、あいつも俺たちと一緒に帰ることを選んだだろ。","nextNodeIds":[700300110]},{"nodeId":700300110,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":4100520778,"text":"璃月へと戻る途中、あいつはどうも機嫌が良かったみたいで、航海中にみんなと詩を読んだり、歌を作ったりしてさ。","nextNodeIds":[700300111]},{"nodeId":700300111,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":1431979690,"text":"ただ残念なことに、俺たちの船じゃ北斗姉さんから小月まで、あいつのように…その…えーと…","nextNodeIds":[700300112,700300114]},{"nodeId":700300112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":560712122,"text":"趣！","nextNodeIds":[700300113]},{"nodeId":700300113,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":2286378122,"text":"そうそう！趣！あいつのように趣の分かるやつはいないんだ。","nextNodeIds":[700300116]},{"nodeId":700300116,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":2814252082,"text":"そのせいか璃月に着いた途端、あいつは船から降りて、色んなところを見て回るためどこかに行っちまった。ずっと船にいたし、きっと退屈してたんだろう。","nextNodeIds":[700300117]},{"nodeId":700300117,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":1958293898,"text":"でも離れて間もなく、あいつからお前さんの行方を気に留めるよう連絡が届いた。","nextNodeIds":[700300118]},{"nodeId":700300118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1386395554,"text":"トラブルでもあったの？","nextNodeIds":[700300119]},{"nodeId":700300119,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":3135575330,"text":"詳しいことは分からんが、お前さんに会ったら自分のとこに来て欲しいと伝言を頼まれた。","nextNodeIds":[700300120]},{"nodeId":700300120,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":1959800914,"text":"あの感じからして大したことじゃなさそうな気もするが、でも些細なことだったら、旅人に頼む必要もないだろ？","nextNodeIds":[700300121]},{"nodeId":700300121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1549992866,"text":"#オイラたち、些細なことでもよく手伝ってるよな、{NICKNAME}？","nextNodeIds":[700300122,700300123,700300124]},{"nodeId":700300122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3167381242,"text":"うん、ハトの餌やりとか。","nextNodeIds":[700300125]},{"nodeId":700300125,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":300840026,"text":"おお——それは意外だな、そんなことまで手伝ってるとは。","nextNodeIds":[700300126]},{"nodeId":700300126,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":667746402,"text":"どうりで北斗姉さんがお前さんのことを高く買ってるわけだ。北斗姉さんが言うようにお前さんは「人情」に厚いんだろうな。","nextNodeIds":[700300127]},{"nodeId":700300127,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":3433301546,"text":"おっと！ついお喋りしすぎた。早く万葉の兄ちゃんのとこに行ってやってくれ。あいつは多分、璃月港の北側にいるはずだ。","nextNodeIds":[700300128]},{"nodeId":700300128,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":898062298,"text":"俺は船隊のこともある、この辺で失礼するよ。じゃあ、気をつけてな！","nextNodeIds":[]},{"nodeId":700300123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2872228650,"text":"うん、レストランの配達とか。","nextNodeIds":[700300125]},{"nodeId":700300124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":996593034,"text":"うん、掃除とか。","nextNodeIds":[700300125]},{"nodeId":700300114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1537617282,"text":"変わった感性！","nextNodeIds":[700300115]},{"nodeId":700300115,"roleType":"TALK_ROLE_NPC","speakerId":2433,"speakerName":"重佐","textMapHash":2796983058,"text":"いやいや、趣と言うべきだな！あいつのように趣の分かるやつはいないんだ。","nextNodeIds":[700300116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2433"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7003003,"order":3,"stepDescription":"璃月港の北側に向かい、万葉を探す","stepDescTextMapHash":3553789436,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q70030KazuhaStart","25"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7003003,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":