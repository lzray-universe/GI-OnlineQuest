DANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30247"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7367901],"talks":[{"talkId":7367901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7367901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["2016","2016017","1","",""],"type":"QUEST_COND_ACTIVITY_CLIENT_COND"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7367901,"initDialog":736790101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30247,30259],"performCfg":"QuestDialogue/WQ/Mengde_73679/Q7367901","priority":5,"questId":73679,"showRandomTalkCount":0},"dialogs":[{"nodeId":736790101,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"エドモンド","textMapHash":683770466,"text":"旅人、来てくれたか。ふぅ…これでやっと一安心だぜ。","nextNodeIds":[736790102]},{"nodeId":736790102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4280087218,"text":"わぁ、エドモンドにファーラビ。おまえら、なんで急に雪山に来たんだ？ここで合流したいってメッセージには、すっごくびっくりしたぞ。","nextNodeIds":[736790103]},{"nodeId":736790103,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":1780315778,"text":"はは、ちょっと急だけど、「思いもよらない研究目標」が現れたから、どうしてもこのチャンスを逃したくなくて。","nextNodeIds":[736790104]},{"nodeId":736790104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":438004530,"text":"「思いもよらない研究目標」？","nextNodeIds":[736790105]},{"nodeId":736790105,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":123047962,"text":"そうなんだ。エドモンドさんは、雪山のふもとで巨大な動物の足跡を見つけたことがあると言ってた。それで、ここ二日の捜索を経て、僕たちはこの辺りで同じような足跡を見つけたんだ。","nextNodeIds":[736790106]},{"nodeId":736790106,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":731986178,"text":"旅人、ここには絶対とんでもなくデカい雪のイノシシが住んでいると、僕は確信してる！","nextNodeIds":[736790107]},{"nodeId":736790107,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":3317336842,"text":"そいつの毛と血液のサンプルを入手できれば、雪のイノシシという種族の生存状況や、雪のイノシシが山のふもとに現れる原因を突き止めることにかなり役立つはずだ。","nextNodeIds":[736790108]},{"nodeId":736790108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2376259530,"text":"ってことは、今日の目標は、その巨大な雪のイノシシ狩りなのか？","nextNodeIds":[736790109]},{"nodeId":736790109,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"エドモンド","textMapHash":1724391090,"text":"いや、狩りじゃない。俺たち狩人の間では、巨大な雪のイノシシはドラゴンスパインの真の主であり、狩ってはいけないという伝説があるんだ。","nextNodeIds":[736790110]},{"nodeId":736790110,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"エドモンド","textMapHash":104329690,"text":"でも、研究目的なら、ちょっとの間行動不能にさせるくらいなら、大丈夫だよな？ファーラビくん、しっかりやってくれよ。","nextNodeIds":[736790111]},{"nodeId":736790111,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":3962666826,"text":"うん、安心してくれ。最近、モンドの収穫の季節にイノシシ襲撃が多発する状況を知って、実は色々と考えたんだ。","nextNodeIds":[736790112]},{"nodeId":736790112,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":3412385794,"text":"もしかしたら、イノシシというテーマを深く研究することは、みんなの問題解決にも繋げられるんじゃないかってね。","nextNodeIds":[736790113]},{"nodeId":736790113,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":4165915610,"text":"生物研究の重要な目的の一つは、そいつらと共存することだからさ。","nextNodeIds":[736790114]},{"nodeId":736790114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1733585258,"text":"へへ、このブリーズブリュー祭の旅では、収穫がいっぱいあったみたいだな。","nextNodeIds":[736790115]},{"nodeId":736790115,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":2553784186,"text":"うん。美味しいお酒を飲めるだけじゃなく、親切な友人や努力する目標も見つけられた。でもまあ、感慨深い話は下山の後にしよう。","nextNodeIds":[736790116]},{"nodeId":736790116,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"エドモンド","textMapHash":1417317698,"text":"旅人、あの雪のイノシシの足跡の大きさから見ると、俺は多分相手にならないからここに残る。ここはお前のようなプロにしか任せられないぞ。","nextNodeIds":[736790117]},{"nodeId":736790117,"roleType":"TALK_ROLE_NPC","speakerId":30259,"speakerName":"エドモンド","textMapHash":1477526354,"text":"でも、あいつを呼び寄せる餌と捕獲装置を用意しといたから安心してくれ。きっと役に立つはずだ。","nextNodeIds":[736790118]},{"nodeId":736790118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2760099290,"text":"うん。任せて。","nextNodeIds":[736790119]},{"nodeId":736790119,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":1100549610,"text":"旅人、準備が出来たら、餌に火をつけて、雪の大イノシシを呼び寄せるよ。","nextNodeIds":[736790120,736790121]},{"nodeId":736790120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2322234066,"text":"準備はできてる。雪の大イノシシ！","nextNodeIds":[]},{"nodeId":736790121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2828455098,"text":"ちょっと待って、まだ準備できてない。","nextNodeIds":[736790122]},{"nodeId":736790122,"roleType":"TALK_ROLE_NPC","speakerId":30247,"speakerName":"ファーラビ","textMapHash":4234960922,"text":"大丈夫、ゆっくり準備してくれ。何せ、僕たちの相手はあのデカブツだからね。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7367901,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30247"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7367902,"order":2,"stepDescription":"雪のイノシシ王を捕獲する","stepDescTextMapHash":657411556,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2016,103],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30268"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[2016,103],"PAINLIBBLDK":"QUEST_CONTENT_ACTIVITY_TRIGGER_UPDATE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QU