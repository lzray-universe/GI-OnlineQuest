xtNodeIds":[706790102,706790104]},{"nodeId":706790102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4215125186,"text":"#えーと、{M#君}{F#あなた}は…？","nextNodeIds":[706790103]},{"nodeId":706790103,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":1544089986,"text":"ガイガックスだ！ほら、風の行方のだよ…覚えてるかい？","nextNodeIds":[706790106]},{"nodeId":706790106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2498923354,"text":"そうそう、そんな名前だったな！","nextNodeIds":[706790107]},{"nodeId":706790107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3469062930,"text":"完全に思い出した！","nextNodeIds":[706790108]},{"nodeId":706790108,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":527255994,"text":"まったく覚えてないって顔をしてるがな…","nextNodeIds":[706790109]},{"nodeId":706790109,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":940436778,"text":"ま、そんな話はさておき、これを見てくれ。この「風の行方」のことなら覚えてるはずだ。","nextNodeIds":[706790110]},{"nodeId":706790110,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":125585210,"text":"以前、君がテストを手伝ってくれたとき、色々アドバイスしてくれただろ？どれもいいアイデアだったから、ほとんど採用させてもらった。","nextNodeIds":[706790111]},{"nodeId":706790111,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":374421530,"text":"そして、ルールや遊び方にもう一度…いや、正確には何度も手を加えた。","nextNodeIds":[706790112,706790113]},{"nodeId":706790112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4183398570,"text":"分かりにくかったりしない？","nextNodeIds":[706790114]},{"nodeId":706790114,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":2040441658,"text":"安心してくれ。きっと新しくなった遊び方を気に入ってくれるはずだ。さっそくだが、ルールを簡単に説明させてもらおう。","nextNodeIds":[706790115]},{"nodeId":706790115,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":2887963938,"text":"まず、新しいバージョンの「風の行方」には、「発信機」というものを加えてみた。","nextNodeIds":[706790116]},{"nodeId":706790116,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":4117664098,"text":"レンジャーは「発信機」を四つ起動することで、ハンターに勝ち、勝利を手にできる！","nextNodeIds":[706790117]},{"nodeId":706790117,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":2060550626,"text":"一方、ハンターがやるべきことは…前と同じで、すべてのレンジャーを捕まえたら勝ちだ。","nextNodeIds":[706790118]},{"nodeId":706790118,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":1850122578,"text":"ただし、今回の「風の行方」では、レンジャーがハンターに捕まったら、そのまま退場するのではなく、「監視エリア」と呼ばれる場所に放り込まれる。","nextNodeIds":[706790119]},{"nodeId":706790119,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":3633759682,"text":"一定時間経つか、もしくは他のレンジャーに助けてもらうことによって、捕まったレンジャーは「監視エリア」から逃げ出すことができる。そして、ハンターとの勝負を続けることができるんだ。","nextNodeIds":[706790120]},{"nodeId":706790120,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":3705866698,"text":"ただし、一回捕まった人が再度捕まったら…今度こそアウトになる。","nextNodeIds":[706790121,706790122]},{"nodeId":706790121,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":210868874,"text":"ちょっと難しそう…","nextNodeIds":[706790123]},{"nodeId":706790123,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":1920717682,"text":"安心してくれ。複雑に聞こえるが、何回か遊んでみれば、すぐに覚えられるさ。","nextNodeIds":[706790124,706790126]},{"nodeId":706790124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1561819146,"text":"遊んでみる。","nextNodeIds":[706790125]},{"nodeId":706790125,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":1035589514,"text":"よし！こっちに来てくれ…","nextNodeIds":[]},{"nodeId":706790126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3214402354,"text":"他に用事がある。","nextNodeIds":[706790127]},{"nodeId":706790127,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":1190010658,"text":"そうか。時間があったらまた来てくれ。俺はしばらくここにいるから。","nextNodeIds":[]},{"nodeId":706790122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":369721834,"text":"新しく追加されたルールが多すぎ…","nextNodeIds":[706790123]},{"nodeId":706790113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3825712410,"text":"変なルールとか付け足してないよね？","nextNodeIds":[706790114]},{"nodeId":706790104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2940696530,"text":"#{M#君}{F#あなた}は…風の行方の！","nextNodeIds":[706790105]},{"nodeId":706790105,"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","textMapHash":1192376618,"text":"ああ、ガイガックスだ！俺の名前よりも風の行方のほうが印象に残ってるのは、まぁ本望ではあるが…","nextNodeIds":[706790106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067901,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7067901],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30051,"speakerName":"ガイガックス","count":17},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2204335182,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k_