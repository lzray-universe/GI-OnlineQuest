andomTalkCount":0},"dialogs":[{"nodeId":715300101,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":1685367306,"text":"#海灯祭を祝して。{M#お兄さん}{F#お姉さん}、それにお嬢ちゃん…","nextNodeIds":[715300102]},{"nodeId":715300102,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":245051002,"text":"おや、あんたたちは前に嘉明に会いに来た有名人じゃないか？","nextNodeIds":[715300103]},{"nodeId":715300103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":485372346,"text":"おまえ、前に会ったよな。嘉明と一緒に遊んでたやつだろ！","nextNodeIds":[715300104]},{"nodeId":715300104,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":1256748850,"text":"そうそう。覚えててくれたのか。俺ってばツイてる！","nextNodeIds":[715300105]},{"nodeId":715300105,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":2728763986,"text":"あんたたちは達人で、何でもできるんだってな。毎日ぶらっとチ虎岩まで買い物に行くんだけど、道中でよくあんたたちの評判を耳にするんだ。","nextNodeIds":[715300106,715300107]},{"nodeId":715300106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3127069826,"text":"#そう、{M#俺}{F#私}は何でもできる！","nextNodeIds":[715300108]},{"nodeId":715300108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":539058922,"text":"お、おい！オイラにだって食べる以外の才能があるぞ！","nextNodeIds":[715300109]},{"nodeId":715300109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2392825386,"text":"えと…そうだな…他になにができるかっていうと…","nextNodeIds":[715300110]},{"nodeId":715300110,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":2765710370,"text":"そうだ！普通の人は浮かんだりできないもんな。あんたは白くてふわふわで、まるで小さな鳩仙人みたいだ！","nextNodeIds":[715300111]},{"nodeId":715300111,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":411253194,"text":"飛べるだけでもすごいさ。物を運ぶのも便利だし、楽に動ける。しっかり友だちを助けてやれよな。","nextNodeIds":[715300112,715300113]},{"nodeId":715300112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2699650410,"text":"パイモンは鳩仙人だったの！","nextNodeIds":[715300114]},{"nodeId":715300114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3836042618,"text":"#鳩の仙人が本当にいるかって話は置いといて…オイラ、いつも{NICKNAME}のことを手伝ってるぞ。","nextNodeIds":[715300115]},{"nodeId":715300115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2213016098,"text":"#たとえば、高いとこから落ちた時とか、オイラが{NICKNAME}を引っ張って、ぶつかってもあんまり痛くないようにしてやったり…","nextNodeIds":[715300116]},{"nodeId":715300116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2832804050,"text":"#そんなに力があるわけじゃないから、強くは引っ張れないけどな…。オイラが本物の鳩仙人なら、{NICKNAME}が風の翼を使う時に引っ張って、もっと遠くまで運んでやるのに！","nextNodeIds":[715300117]},{"nodeId":715300117,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":1547805786,"text":"たくさん練習すればいいさ。俺と嘉明の獣舞みたいにな。一緒に練習する時間が長くなればなるほど、気持ちが通じて、息がぴったり合うようになるぞ！","nextNodeIds":[715300118]},{"nodeId":715300118,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":1915773194,"text":"ちょうど、新しくておもしろい遊びを考えたんだ。「ドッシン獣舞劇」っていうんだけど、やってみるか？","nextNodeIds":[715300119]},{"nodeId":715300119,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":1880244162,"text":"息を合わせる練習にもなるし、獣舞劇の理解にも役立つぞ！","nextNodeIds":[715300120]},{"nodeId":715300120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4026357818,"text":"「ドッシン獣舞劇」？まさかおまえのそばにあるおっきなぬいぐるみか…？","nextNodeIds":[715300121]},{"nodeId":715300121,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":837780586,"text":"その通り！","nextNodeIds":[715300122]},{"nodeId":715300122,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":1979589138,"text":"本格的な獣舞劇は習得するのが難しい。プロに教えてもらっても、合わなかったり、根性がなかったりしたら続かない。","nextNodeIds":[715300123]},{"nodeId":715300123,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":1816870754,"text":"だから、獣舞劇の舞の一部に手を加えた。道具を換えて、このゲームを作ったんだ。","nextNodeIds":[715300124]},{"nodeId":715300124,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":970601554,"text":"ちょうど海灯祭だし、みんなを楽しませたくてさ。食前の運動、食後の消化にってとこだな！","nextNodeIds":[715300125]},{"nodeId":715300125,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":51572818,"text":"この衣装を着て、誰が一番多く餅茶を入手できるか競うんだ。ぶつかり合いっこもできて楽しいぞ！","nextNodeIds":[715300126]},{"nodeId":715300126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3147388442,"text":"おもしろそうだな。でも、そんなおっきな衣装を着て誰かと遊ぶなんて、オイラの体力じゃちょっと無理そうだぞ…","nextNodeIds":[715300127]},{"nodeId":715300127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2182356370,"text":"#{NICKNAME}はこの手のゲームが得意だろ！オイラはまず隣で見学して学んどくぜ。","nextNodeIds":[715300128,715300129]},{"nodeId":715300128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2886240570,"text":"うん。じゃあ踊ってみる！","nextNodeIds":[715300130]},{"nodeId":715300130,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":857998634,"text":"あれ？鳩仙人は自分でやらないのか？ちょっと残念だな…","nextNodeIds":[715300131]},{"nodeId":715300131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":762744722,"text":"#大丈夫だぞ。オイラと{NICKNAME}はず～っと一緒に旅してきたんだし、これからだってそうだ。息を合わせる訓練をするチャンスなんてたっくさんあるぜ！","nextNodeIds":[715300132]},{"nodeId":715300132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4134969170,"text":"#それに見てるだけでも、{NICKNAME}と息を合わせるコツを色々掴めると思うぞ。","nextNodeIds":[715300133]},{"nodeId":715300133,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":3117143794,"text":"ハハッ！あんたたちは仲がいいんだな。羨ましいくらいだ！","nextNodeIds":[715300134]},{"nodeId":715300134,"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","textMapHash":573913610,"text":"#じゃあ、有名人の{M#お兄さん}{F#お姉さん}に「ドッシン獣舞劇」を体験してもらおうか。小さな鳩仙人も楽しんで見てくれよな！","nextNodeIds":[]},{"nodeId":715300129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2260397522,"text":"うん。じゃあぶつかってみる！","nextNodeIds":[715300130]},{"nodeId":715300113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":210958218,"text":"変なあだ名が増えたね！","nextNodeIds":[715300114]},{"nodeId":715300107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":720202698,"text":"パイモンは食べる達人だよね！","nextNodeIds":[715300108]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7153001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30457"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7153001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30457,"speakerName":"遐慶","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171530],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":912702366,"CHECNJEMEFE":{"30457":[4010]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Liyue_71530/Q7153001","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO"