ty":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7422402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7422402,"initDialog":742240201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21083],"performCfg":"QuestDialogue/WQ/Fontaine_74224/Q7422402","priority":5,"questId":74224,"showRandomTalkCount":0},"dialogs":[{"nodeId":742240201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2023791018,"text":"あれっ？タイユフェールさんじゃないか？また会えるなんてな！","nextNodeIds":[742240202]},{"nodeId":742240202,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":2830621666,"text":"これはこれは、冒険者さんに助手さん。先日はお名前を伺いそびれていましたが…","nextNodeIds":[742240203]},{"nodeId":742240203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2926233450,"text":"#オイラはパイモン、こっちは{NICKNAME}だぞ。こないだは「海螺の響き」で大昔の曲を演奏するのを手伝ってくれてありがとうな！","nextNodeIds":[742240204]},{"nodeId":742240204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":294102458,"text":"ところでタイユフェールさんは、なんでペトリコールに来てるんだ？","nextNodeIds":[742240205]},{"nodeId":742240205,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":3069026378,"text":"こちらも同じことを聞こうと思っていたところです…私は風のうわさを聞いて、駆けつけたんです。まぁ、あなたたちは冒険者だから、先に着いていても不思議じゃありませんね。","nextNodeIds":[742240206]},{"nodeId":742240206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4191638042,"text":"うわさって、なんのうわさだよ？","nextNodeIds":[742240207]},{"nodeId":742240207,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":4290506306,"text":"ペトリコールといえば、最近一番アツいニュースは「あれ」に決まってるじゃありませんか。","nextNodeIds":[742240208,742240209]},{"nodeId":742240208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2988689762,"text":"#{M#俺}{F#私}たちが偶然世界を救ったこと？","nextNodeIds":[742240210]},{"nodeId":742240210,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":964275730,"text":"えっ、何を言ってるんですか？もちろん、伝説の色褪せた城が再び発見されたってニュースですよ。","nextNodeIds":[742240211]},{"nodeId":742240211,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":4134574890,"text":"色褪せた城に関する最後の記録は、一番新しいものでも数百年前のものだったんです。てっきり、あなたたちもそのためにここへ来たのかと！","nextNodeIds":[742240212]},{"nodeId":742240212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2766697978,"text":"それもまぁ、オイラたちに関係あるっちゃあるんだけどな…","nextNodeIds":[742240213]},{"nodeId":742240213,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":1613940066,"text":"あなたたちもご存知でしょう？色褪せた城は、かつてフォンテーヌの歴史上でもっとも重要な音楽家だったボエティウスが所有していたものです。","nextNodeIds":[742240214]},{"nodeId":742240214,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":1989730290,"text":"ボエティウスが創作した歌劇も、彼がまとめた古レムリアの譜面も…音楽史上、特別な位置づけにあるものばかりです。","nextNodeIds":[742240215]},{"nodeId":742240215,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":1479583474,"text":"彼がかつて住んだ城というからにはきっと、大量の資料が残されているはずです。それは私たち音楽家協会の人間にとって、とても重要な文献です…！","nextNodeIds":[742240216]},{"nodeId":742240216,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":2043164562,"text":"ですから、報せを聞いてすぐ駆けつけてきたんです。ほかの冒険者たちよりも先に、重要な文献を確保したいですからね。","nextNodeIds":[742240217]},{"nodeId":742240217,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":963196650,"text":"あなたたちに先を越されるとは思いませんでした。","nextNodeIds":[742240218]},{"nodeId":742240218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1027968210,"text":"（どうする？ボエティウスは実はとんでもない悪人で、音楽を利用して悪事を働いたんだぞって教えてやったほうがいいんじゃないか…）","nextNodeIds":[742240219]},{"nodeId":742240219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2295461098,"text":"（でも、もし本当のことを知ったら、悲しむかなぁ…）","nextNodeIds":[742240220,742240221]},{"nodeId":742240220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3927649298,"text":"「楽章」にもう悪いことはできない。","nextNodeIds":[742240222]},{"nodeId":742240222,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":2263907122,"text":"…なにをひそひそ話しているんですか？もしかして、もう古代の譜面を見つけてしまったとか？","nextNodeIds":[742240223]},{"nodeId":742240223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2400888586,"text":"あのさ、もし…もしもだぞ？ボエティウスがすっごく悪いやつだとしたら、それでもあいつが残した譜面が欲しいと思うか？","nextNodeIds":[742240224]},{"nodeId":742240224,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":1288252802,"text":"うーん…あなたの言う「すっごく悪い」がどういうことなのかは分かりませんが、ボエティウスが歴史上に素晴らしい名声を残したのは、音楽に関することだけですから。","nextNodeIds":[742240225]},{"nodeId":742240225,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":3352788330,"text":"彼の残したロマン主義歌劇『漂流の異邦人』からもわかるでしょう？彼はこの世を去る直前までレムリアの再興を諦めることなく、新生フォンテーヌを敵視していたんです。","nextNodeIds":[742240226]},{"nodeId":742240226,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":948695626,"text":"それに歴史学者の話によれば、フォンテーヌが興ったばかりの頃にあった戦乱も、彼と関わりがあるとか…","nextNodeIds":[742240227]},{"nodeId":742240227,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":239012746,"text":"でも、それと音楽における成果とはまったく別の話でしょう？彼の創作した音楽に誤った歴史が描かれていたとしても、その芸術的価値を否定することはできません。","nextNodeIds":[742240228]},{"nodeId":742240228,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":1804475418,"text":"それに、私にとってはそれも歴史の一部ですからね。純粋な芸術が、悪事に利用されることもある——音楽家の端くれとして胸に刻むだけですよ。","nextNodeIds":[742240229,742240231]},{"nodeId":742240229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4164546570,"text":"#{M#君}{F#あなた}なら、悪事には使わないと思う。","nextNodeIds":[742240230]},{"nodeId":742240230,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":784968634,"text":"ふふっ、私はただの研究者に過ぎませんよ。古のメロディーを聴きたいと、心の底から願っているだけのね。","nextNodeIds":[742240233]},{"nodeId":742240233,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":248434458,"text":"ところで…こうして会ったのも縁ですから、ちょっと力を貸していただけませんか？","nextNodeIds":[742240234]},{"nodeId":742240234,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":663854202,"text":"この前協力して差し上げたことへの、お返しだと思って！","nextNodeIds":[742240235,742240237,742240239]},{"nodeId":742240235,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":68508322,"text":"報酬はいらないって言ってたくせに…","nextNodeIds":[742240236]},{"nodeId":742240236,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":3027766146,"text":"ふふっ、とにかく、決まりってことでいいですね？","nextNodeIds":[742240240]},{"nodeId":742240240,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":3756652802,"text":"ともかく…先ほどちらっとお話ししましたが、私は著名な歌劇『漂流の異邦人』の失われた譜面を探すためにここへ来ました。","nextNodeIds":[742240241]},{"nodeId":742240241,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":2110200618,"text":"ルッジェロという人が残した数百年前の記録によると、それは色褪せた城のどこかにしまわれているそうです。もし手伝ってもらえると、とても助かります。","nextNodeIds":[742240242]},{"nodeId":742240242,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":2487563330,"text":"遺跡探索のような仕事は私よりも、あなたたちの専門でしょう？","nextNodeIds":[742240243]},{"nodeId":742240243,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2704501050,"text":"#{NICKNAME}、どうしてもって感じだし…手伝ってやろうぜ。どうせその譜面にはもう「あの力」は残ってないしな。","nextNodeIds":[742240244]},{"nodeId":742240244,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":154469842,"text":"それは…承諾してもらえたってことでいいですよね？良かった！","nextNodeIds":[742240245]},{"nodeId":742240245,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":2655727810,"text":"ではお願いしますね。お帰りになるまで、私は町で朗報を待っていますから。","nextNodeIds":[]},{"nodeId":742240237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3423479122,"text":"報酬はもらうけど…","nextNodeIds":[742240238]},{"nodeId":742240238,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":92389010,"text":"もちろん報酬はお渡ししますよ。別に音楽家協会はお金に困っていませんからね。","nextNodeIds":[742240240]},{"nodeId":742240239,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2956799954,"text":"こうなると思った…","nextNodeIds":[742240240]},{"nodeId":742240231,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4132599514,"text":"正論だね。","nextNodeIds":[742240232]},{"nodeId":742240232,"roleType":"TALK_ROLE_NPC","speakerId":21083,"speakerName":"タイユフェール","textMapHash":3017087114,"text":"ふふ、単なる一個人の見解ですよ。","nextNodeIds":[742240233]},{"nodeId":742240221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1493221474,"text":"きちんと説明するにはちょっと…","nextNodeIds":[742240222]},{"nodeId":742240209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3832642850,"text":"ペトリコール全体が催眠にかかってること？","nextNodeIds":[742240210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7422402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133413062"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA