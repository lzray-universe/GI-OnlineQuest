eType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","textMapHash":3901114842,"text":"はははっ、それは…まあ…良いものよりも良いものだろう！なんてったって彫刻は、「永遠の記念」なんだから、はははっ！","nextNodeIds":[722160213]},{"nodeId":722160213,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1198047138,"text":"違う。「永遠の記念」じゃないにゃ。","nextNodeIds":[722160214]},{"nodeId":722160214,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3929343634,"text":"うちは、響が帰ってくる道の途中でもし迷ったら、うちの形をした石を見つけられると思ったのにゃ。","nextNodeIds":[722160215]},{"nodeId":722160215,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1390659498,"text":"そしたら、響もここにたどり着ける。迷ったりもしにゃい。","nextNodeIds":[722160216]},{"nodeId":722160216,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","textMapHash":318461450,"text":"そ、そうだったのか。代理宮司様は本当にその「響」って人のことを気にかけてるんだな。","nextNodeIds":[722160217]},{"nodeId":722160217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2074266818,"text":"寝子…","nextNodeIds":[722160218]},{"nodeId":722160218,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1265889738,"text":"響はいつ帰ってくるかわからにゃい。それに響と百目鬼が言っていたにゃ、うちの形をした石ができたとき、良いことが起こると。","nextNodeIds":[722160219]},{"nodeId":722160219,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1622969802,"text":"ところで、石人間、まだうちにしてほしいことはにゃいか？","nextNodeIds":[722160220]},{"nodeId":722160220,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","textMapHash":3063506906,"text":"いや、別にない…雑談はここまでにして、代理宮司様、いま最後の部分を削るぜ！","nextNodeIds":[722160221]},{"nodeId":722160221,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","textMapHash":2360013250,"text":"いち…にの…さん！","nextNodeIds":[722160222]},{"nodeId":722160222,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","textMapHash":2828553946,"text":"こ、この雲、これはいったい…","nextNodeIds":[722160223,722160224]},{"nodeId":722160223,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":584019282,"text":"猫の形になった…","nextNodeIds":[722160225]},{"nodeId":722160225,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":997439426,"text":"響にゃ。","nextNodeIds":[722160226]},{"nodeId":722160226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2513758818,"text":"えっ？","nextNodeIds":[722160227]},{"nodeId":722160227,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","textMapHash":3022177898,"text":"響？","nextNodeIds":[722160228]},{"nodeId":722160228,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":690929458,"text":"にゃにゃっ！きっと響にゃ！響が言っていたにゃ！良いことが必ず起こるにゃ！","nextNodeIds":[722160229]},{"nodeId":722160229,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1942883810,"text":"響が言っていた、その石ができれば、良いことが起こる！","nextNodeIds":[722160230]},{"nodeId":722160230,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1072777522,"text":"よかった、よかったにゃ！響が言っていたことは本当だったにゃ！","nextNodeIds":[722160231]},{"nodeId":722160231,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3964052650,"text":"響はきっと帰ってくる！","nextNodeIds":[722160232]},{"nodeId":722160232,"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","textMapHash":1425421690,"text":"お…おう！はははっ、なんのことか分からないが、その様子からして、良いことみたいだな。","nextNodeIds":[722160233]},{"nodeId":722160233,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1996411642,"text":"寝子…","nextNodeIds":[722160234]},{"nodeId":722160234,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1256533210,"text":"主らのおかげで、神社もキレイになった。","nextNodeIds":[722160235]},{"nodeId":722160235,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":87796738,"text":"「賽銭箱」も直った。","nextNodeIds":[722160236]},{"nodeId":722160236,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3727697386,"text":"「絵馬掛け」も直った。","nextNodeIds":[722160237]},{"nodeId":722160237,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3663820466,"text":"うちの形をした石も作った。きっとこれで、響も帰ってくるにゃ。","nextNodeIds":[722160238]},{"nodeId":722160238,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":580030434,"text":"それに、百目鬼、蛇目、それと響の友達たち、みんな響と一緒に帰ってくるにゃ。","nextNodeIds":[722160239]},{"nodeId":722160239,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1309217530,"text":"主は本当にいいやつにゃ！飯よりもいいやつにゃ！響も主のこときっと気に入るにゃ！","nextNodeIds":[722160240]},{"nodeId":722160240,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1417108658,"text":"うち、あの子らを呼んできて、響のことを伝えるにゃ。それと、これからたくさんの人が神社に来ることも。きちんとあの子らに説明しないといけにゃい…","nextNodeIds":[722160241]},{"nodeId":722160241,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3676405938,"text":"すべて事前に準備しないといけないにゃ…","nextNodeIds":[722160242]},{"nodeId":722160242,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3543456138,"text":"響…にゃおーん！よかった、よかったにゃ！","nextNodeIds":[]},{"nodeId":722160224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":943381386,"text":"いったいどういうこと…","nextNodeIds":[722160225]}]},{"talkId":7221603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":