,""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370401,"initDialog":737040101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30549],"performCfg":"QuestDialogue/WQ/EffigyChallenge_V5_73704/Q7370401","priority":5,"questId":73704,"showRandomTalkCount":0},"dialogs":[{"nodeId":737040101,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3513175234,"text":"よーし、今日も新たな希望に満ちた一日だ！さ、二人とも今すぐ出発するか？","nextNodeIds":[737040102]},{"nodeId":737040102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2329239482,"text":"新たな希望って…じゃあ、エンシェントヴィシャップとの交流は失敗したってことか？","nextNodeIds":[737040103]},{"nodeId":737040103,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":4239683490,"text":"失敗したとは…言ってくれるね。ケンカだって、一種の交流なんだよ。","nextNodeIds":[737040104]},{"nodeId":737040104,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":80236706,"text":"その視点で見れば、私たちは素直で深い交流をした仲。その過程で互いの立場を充分に理解したんだ。","nextNodeIds":[737040105]},{"nodeId":737040105,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3151786554,"text":"こんな言葉があるだろ——「雨降って地固まる」って。","nextNodeIds":[737040106,737040108]},{"nodeId":737040106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2810871274,"text":"こうなる予想はしてた…","nextNodeIds":[737040107]},{"nodeId":737040107,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3997687754,"text":"それでも、何事も試さないと分からないだろ？","nextNodeIds":[737040110]},{"nodeId":737040110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4236873874,"text":"要するに、まだ諦めてないってことだよな…？","nextNodeIds":[737040111]},{"nodeId":737040111,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3375852794,"text":"ああ。それに実を言うと、マッシュラプトルに乗ってスメール中を旅するのが、子供の頃の夢の一つだったんだよ…","nextNodeIds":[737040112]},{"nodeId":737040112,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":1381134146,"text":"けど大人たちは、馬鹿な夢を持つのはやめなさいとしか言ってくれなかった。レンジャー長に聞いても、難しい顔をしながら危険な真似はよせと言う始末…","nextNodeIds":[737040113]},{"nodeId":737040113,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3045286578,"text":"だから、私は非現実的な夢を諦め、他の子供たちと同じように大人になった。唯一思い切ったことをしてるのは、食材のチョイスだけだ…","nextNodeIds":[737040114]},{"nodeId":737040114,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3566351306,"text":"たまに思い出すことがあるよ、子供の頃にそんな夢を持ってたなって。でも、それは手の届かないところにある幻想のようで…まるで伝説の中のアランナラみたいなんだ。","nextNodeIds":[737040115]},{"nodeId":737040115,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":2958478706,"text":"もしアランナラが本当にいたら、私にも彼らが見えた時期があったのだろうか？もしあったなら、一体いつから見えなくなって、いつ忘れてしまったのだろう？","nextNodeIds":[737040116]},{"nodeId":737040116,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":4124267010,"text":"私がナタにいたとき、こんな物語を聞いた——クントゥルっていうやつが、父の犯した過ちのせいで、太陽に嫌われたという話だ。","nextNodeIds":[737040117]},{"nodeId":737040117,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3023103074,"text":"「太陽に好かれないクントゥル」は部族でも嫌われていて、もちろん仲間になってくれる竜もいなかった。","nextNodeIds":[737040118]},{"nodeId":737040118,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3058612026,"text":"だが彼は落ち込まず、父に対しても、運命に対しても愚痴ひとつこぼさなかった。そして、努力で証明してみせた。自分は一族の一番強い戦士にも劣らないってことをね。","nextNodeIds":[737040119]},{"nodeId":737040119,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":1752983554,"text":"最後に、彼は勇気と知恵を駆使して偉業を成し遂げた。イクトミ竜に仲間として認められただけでなく、一族の英雄にもなったんだ。","nextNodeIds":[737040120]},{"nodeId":737040120,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":1563954922,"text":"彼の物語を聞いて、私も子供の頃の夢を取り戻す勇気が湧いてきた。","nextNodeIds":[737040121]},{"nodeId":737040121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1796130738,"text":"そんな理由があったのか…","nextNodeIds":[737040122]},{"nodeId":737040122,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":562217826,"text":"だから、マッシュラプトルと正面から「交渉」するのは君に頼んだよ！","nextNodeIds":[737040123]},{"nodeId":737040123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":969487442,"text":"結局オイラたちにやらせるのかよ！","nextNodeIds":[737040124]},{"nodeId":737040124,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":1542260434,"text":"今の私の実力では、マッシュラプトルの相手なんて到底務まらないからね…けど、ちゃんとサポートはする。何かあったら、いつでも呼んでくれ！","nextNodeIds":[737040125]},{"nodeId":737040125,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":3929381218,"text":"さあ、さっそく行こうか！","nextNodeIds":[737040126,737040127]},{"nodeId":737040126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3658938202,"text":"うん、行こう。","nextNodeIds":[]},{"nodeId":737040127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":140000890,"text":"他に用事があるから、またあとで。","nextNodeIds":[737040128]},{"nodeId":737040128,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":1355412178,"text":"ああ。じゃあ、ここで待ってるよ。","nextNodeIds":[]},{"nodeId":737040108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2465460890,"text":"ケンカしてるのはこっちだけど。","nextNodeIds":[737040109]},{"nodeId":737040109,"roleType":"TALK_ROLE_NPC","speakerId":30549,"speakerName":"ランジット","textMapHash":368542946,"text":"さすがは本物の冒険者だよ。素人の私でも分かる。君、だいぶケンカ慣れしてるだろ？","nextNodeIds":[737040110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370401,0