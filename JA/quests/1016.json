UEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["101609","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":101601,"initDialog":10160101,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/AQ/Liyue1_1016/Q101601","priority":6,"questId":1016,"showRandomTalkCount":0},"dialogs":[{"nodeId":10160101,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":956408297,"text":"ああ、来たか。注文は俺がしておいた。","nextNodeIds":[10160102]},{"nodeId":10160102,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2808036737,"text":"この「三杯酔」はモンドの酒場とは違うぞ。ここの店主は、ジュースのような「空気の読めない」注文を断るからな。","nextNodeIds":[10160103]},{"nodeId":10160103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2771516305,"text":"つまり、今回はお酒が飲める！？","nextNodeIds":[10160104]},{"nodeId":10160104,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3369960121,"text":"だから、お前には酒醸団子を注文しておいた。","nextNodeIds":[10160105]},{"nodeId":10160105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":820149385,"text":"ハハッ、そうなるよね…","nextNodeIds":[10160106]},{"nodeId":10160106,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"田饒舌","textMapHash":1481580945,"text":"…皆様さえよろしければ、凝光様の「群玉閣」のお話を再開いたしますよ。","nextNodeIds":[10160107]},{"nodeId":10160107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2553982073,"text":"おおっ、講談師がいるぞ！いい雰囲気の店だな。","nextNodeIds":[10160108]},{"nodeId":10160108,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2945007273,"text":"市場での評判を得るには、美味しい酒の他にも環境が大事だ。","nextNodeIds":[10160109]},{"nodeId":10160109,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2263685385,"text":"しかし、ここで言う「環境」と、『テイワット観光ガイド』に書かれるような酒場の「環境」は別物だ。","nextNodeIds":[10160110]},{"nodeId":10160110,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"田饒舌","textMapHash":3958481329,"text":"皆様ご存知の通り、この港の上には雲上の宮殿、煙霞の行宮があります。","nextNodeIds":[10160111]},{"nodeId":10160111,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"田饒舌","textMapHash":2635664953,"text":"天へ届くかの如し所業とはいかなものでしょう？ご覧ください、これこそが凝光様が築いた天へと通ずる産業でございます。","nextNodeIds":[10160112]},{"nodeId":10160112,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"田饒舌","textMapHash":2221009297,"text":"晴れた日に、宮殿から外を眺めれば——","nextNodeIds":[10160113]},{"nodeId":10160113,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"田饒舌","textMapHash":855083257,"text":"絶景かな！璃月港の景色の大半を一望できます…","nextNodeIds":[10160201]},{"nodeId":10160201,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"田饒舌","textMapHash":402353481,"text":"考えてみてください、紙切れとは言え、凝光様が策を練るために用いた「考え」にどれほどの価値がおありか。","nextNodeIds":[10160202]},{"nodeId":10160202,"roleType":"TALK_ROLE_NPC","speakerId":214801,"speakerName":"田饒舌","textMapHash":2980590625,"text":"それが一枚や二枚、少しでも多く手に入れば、凝光様の指の隙間から零れ落ちる利益を同業者よりも享受できる…","nextNodeIds":[10160203]},{"nodeId":10160203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3543104369,"text":"「天権」凝光…最近、この名前をよく耳にするよな。","nextNodeIds":[10160204]},{"nodeId":10160204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":588739273,"text":"璃月の人は彼女の話をするし、「ファデュイ」は彼女を嫌うし、「仙祖の亡骸」を隠したのも彼女みたいだし、「迎仙儀式」でも一回見たような…","nextNodeIds":[10160205]},{"nodeId":10160205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1703035521,"text":"一体どんな人なんだろう？","nextNodeIds":[10160207]},{"nodeId":10160207,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":1319330193,"text":"やっと見つけました、「絶雲の間から帰ってきた者」。","nextNodeIds":[10160208]},{"nodeId":10160208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":338850665,"text":"誰だ？","nextNodeIds":[10160209]},{"nodeId":10160209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2561605441,"text":"パイモン、行こう…！","nextNodeIds":[10160210]},{"nodeId":10160210,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":3350347393,"text":"待ってください。私は千岩軍でも、あなたたちを捕まえに来た者でもありません。","nextNodeIds":[10160211]},{"nodeId":10160211,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":3439300841,"text":"確かに「璃月七星」の使者ですが——私は甘雨、月海亭の秘書です。あなたたちに会うためここに来ました。","nextNodeIds":[10160212,10160213]},{"nodeId":10160212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3823197393,"text":"使者？","nextNodeIds":[10160214]},{"nodeId":10160214,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":1913804257,"text":"正確に言いますと、本職は「七星」全員の秘書ですが、今回は一時的に凝光様の特使として参りました。","nextNodeIds":[10160215]},{"nodeId":10160215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1518542001,"text":"おお、噂をすれば…凝光の使者が現れた。","nextNodeIds":[10160216]},{"nodeId":10160216,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":3328646489,"text":"絶雲の間から帰ってきた者…この場で礼儀が十分に行き届いていないことお許しください。","nextNodeIds":[10160217]},{"nodeId":10160217,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":120430697,"text":"しかし、私が持ってきたこの手紙は凝光様が「天権」として、正式に出された招待状です。","nextNodeIds":[10160218]},{"nodeId":10160218,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":2632324937,"text":"あなたを「空中宮殿」に招待いたします。","nextNodeIds":[10160219]},{"nodeId":10160219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2213716337,"text":"招待状…だって？","nextNodeIds":[10160220]},{"nodeId":10160220,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":1481012377,"text":"そうです。凝光様はこう言いました。","nextNodeIds":[10160221]},{"nodeId":10160221,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":956435025,"text":"#「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}を連れてきなさい。」","nextNodeIds":[10160222]},{"nodeId":10160222,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":1159862401,"text":"#「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}に会うわ。」","nextNodeIds":[10160223]},{"nodeId":10160223,"roleType":"TALK_ROLE_NPC","speakerId":1015,"speakerName":"甘雨","textMapHash":4184286097,"text":"#「群玉閣で、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}と一緒に…繁雑な暗流の糸を一本ずつ断ち切るから。」","nextNodeIds":[]},{"nodeId":10160213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3741421929,"text":"秘書？","nextNodeIds":[10160214]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["10005","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10232"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":101606,"order":6,"stepDescription":"","stepDescTextMapHash":1677916374,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101606,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR