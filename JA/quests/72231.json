0102]},{"nodeId":722310102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":484664402,"text":"でも、どこにいるか分からない…","nextNodeIds":[]}]},{"talkId":7223102,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7223101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7223102,"initDialog":722310201,"nextRandomTalks":[],"nextTalks":[],"npcId":[3180,3181],"performCfg":"","priority":5,"questId":72231,"showRandomTalkCount":0},"dialogs":[{"nodeId":722310201,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":664640842,"text":"確かに、「響」…「浅瀬神社」…「百目鬼」…どれも気になるわね。","nextNodeIds":[722310202,722310207]},{"nodeId":722310202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1478573658,"text":"いつからいたの…","nextNodeIds":[722310203]},{"nodeId":722310203,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1283913498,"text":"島でこんなに大きな騒ぎがあったら、来ない方がおかしいでしょ。","nextNodeIds":[722310204]},{"nodeId":722310204,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1598643130,"text":"それと、説明しなきゃいけないことがあるの。","nextNodeIds":[722310205]},{"nodeId":722310205,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1309610778,"text":"大祐、話してちょうだい。","nextNodeIds":[722310206]},{"nodeId":722310206,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":14872834,"text":"あっ…分かったよ、悦子。その、僕が言いたいことは…このセイライ島に関することなんだ…","nextNodeIds":[722310208]},{"nodeId":722310208,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":2674824826,"text":"セイライ島の歴史はとても古く、様々な調査を行った協会でも、有用な情報がまったく見つかっていない…","nextNodeIds":[722310209]},{"nodeId":722310209,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":1356056346,"text":"協会の資料によると、数百年前のここは、「海賊」が集まる場所だったみたいだ。当時、幕府が全面的に海賊を片付け、島の住民たちを別の場所に移住させた…","nextNodeIds":[722310210]},{"nodeId":722310210,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":1929402554,"text":"その「百目鬼」とは、たぶん、当時幕府と正面から対峙した海賊の頭である「赤穂百目鬼」のことだ。書類にもはっきりと名前が記録されている。","nextNodeIds":[722310211]},{"nodeId":722310211,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":2940166050,"text":"協会が僕たちに渡した資料によると、この「赤穂百目鬼」は海賊の船隊を指揮し、海上で幕府と戦っていたという。","nextNodeIds":[722310212]},{"nodeId":722310212,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":51617498,"text":"彼の船隊は幕府に制圧され、セイライ島に逃げてきた…","nextNodeIds":[722310213]},{"nodeId":722310213,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":1866421674,"text":"だが、幕府の船隊が彼を追撃しようとした時、突然セイライ島に原因不明の雷が落ちた。","nextNodeIds":[722310214]},{"nodeId":722310214,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":238505994,"text":"赤穂百目鬼の船隊と幕府の船隊は、その雷に当たり…そのまま消息を絶った…","nextNodeIds":[722310215]},{"nodeId":722310215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1335948730,"text":"雷…","nextNodeIds":[722310216]},{"nodeId":722310216,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":3607919658,"text":"後は私から話すわ…このことに関する最大の疑問点は、突如現れた雷にある。","nextNodeIds":[722310217]},{"nodeId":722310217,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1112138938,"text":"赤穂百目鬼の船隊は雷のせいでほぼ壊滅した…でも幕府がセイライ島に手配した船隊も、同じようにほとんど壊滅したの。そうして鳴神島に撤退し、船隊の再編までとても長い時間をかけたらしいわ。","nextNodeIds":[722310218]},{"nodeId":722310218,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":2171377242,"text":"いくらなんでもタイミングが良すぎるのよ、この雷が落ちた時が。そう…まるで…誰かに操られていたかのように。","nextNodeIds":[722310219]},{"nodeId":722310219,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":2671997370,"text":"わざと封印が解かれたあの「鎮め石」のことを、まだ覚えているでしょ。","nextNodeIds":[722310220]},{"nodeId":722310220,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":24655818,"text":"そして、その「鎮め石」を封印したら、島の雷も収まった。","nextNodeIds":[722310221]},{"nodeId":722310221,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":2207231946,"text":"安易な推測はできるだけ避けたいけど…これらは、多かれ少なかれ関連していると思うの。","nextNodeIds":[722310222]},{"nodeId":722310222,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":1229484842,"text":"その、寝子さまに聞いてみるってのは…","nextNodeIds":[722310223]},{"nodeId":722310223,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":896469314,"text":"それはやめた方がいいと思う…資料では百目鬼は失踪したと書かれているけど、あんな雷に当たったんじゃ、たぶんもう…","nextNodeIds":[722310224]},{"nodeId":722310224,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1312212402,"text":"私たちは引き続きこの島で探索をして、このことに関する手がかりも見つけたいと思ってる。しばらく経ってから、協会へ報告しに行くわ。","nextNodeIds":[722310225]},{"nodeId":722310225,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1034573770,"text":"ふふ、旅人、もしかしたら、その時はまた一緒に仕事できるかもね。","nextNodeIds":[722310226]},{"nodeId":722310226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3954822882,"text":"その時はよろしく。","nextNodeIds":[722310227]},{"nodeId":722310227,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":2273573482,"text":"ええ、よろしくね。","nextNodeIds":[722310228]},{"nodeId":722310228,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1655517370,"text":"大祐、準備をしなさい。引き続き探索計画を練るわよ。","nextNodeIds":[722310229]},{"nodeId":722310229,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":1876088626,"text":"えっと…悦子、寝子さまは…","nextNodeIds":[722310230]},{"nodeId":722310230,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":2118272730,"text":"以前と同じように、その猫に接するといいわ。","nextNodeIds":[722310231]},{"nodeId":722310231,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":4289157970,"text":"でもこれだけは覚えておいて。言ってはならないことは、決して口にしないように。","nextNodeIds":[722310232]},{"nodeId":722310232,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":986140530,"text":"あの猫…今、とっても嬉しそうにしてる。空気を壊すようなことは言っちゃだめよ。","nextNodeIds":[722310233]},{"nodeId":722310233,"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","textMapHash":4290932466,"text":"分かったよ、悦子！えへへ、やっぱり君って…","nextNodeIds":[722310234]},{"nodeId":722310234,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":2590804138,"text":"…ただ、より効率的に依頼をこなすためよ。早く仕事に戻りなさい。","nextNodeIds":[722310235]},{"nodeId":722310235,"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","textMapHash":1357739242,"text":"セイライ島…どうやらまだまだ秘密があるみたいね…","nextNodeIds":[]},{"nodeId":722310207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":400163578,"text":"何か知ってるの？","nextNodeIds":[722310208]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7223101,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7223101,7223102],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3180,"speakerName":"悦子","count":20},{"roleType":"TALK_ROLE_NPC","speakerId":3181,"speakerName":"大祐","count":11},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5},{"roleType":"TALK_ROLE_NPC","speakerId":3182,"speakerName":"大島純平","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1414956910,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_ALL","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":722310101,"ILHDCGDKKKA":"T