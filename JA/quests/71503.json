oy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150301,"initDialog":715030101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181,30183,30184],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150301","priority":15,"questId":71503,"showRandomTalkCount":0},"dialogs":[{"nodeId":715030101,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4227011106,"text":"#ちょうどいいところに来てくれた、{NICKNAME}。今どうすれば「プルシナスパイク」を中に運べるか話し合っていたところなんだ。","nextNodeIds":[715030102]},{"nodeId":715030102,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4128952346,"text":"ただ、ここの状況は私たちが思っていたよりもずっと悪い。","nextNodeIds":[715030103]},{"nodeId":715030103,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":3848545250,"text":"ゴホッ…だめだ、黒泥が多い上に、引き寄せられた魔物も多い。中に運ぶのは無理そうだ。","nextNodeIds":[715030104]},{"nodeId":715030104,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":3247480082,"text":"どうやって先に進めばいいのか、皆目見当も付かない…","nextNodeIds":[715030105]},{"nodeId":715030105,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"図","textMapHash":1695323162,"text":"ここから坑道の中までまだ遠い。手を貸してくれ、もう一回試してみるぞ。","nextNodeIds":[715030106]},{"nodeId":715030106,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"図","textMapHash":4058090378,"text":"それでも無理だったら、外に行って仲間たちを呼ぼう！","nextNodeIds":[715030107]},{"nodeId":715030107,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"図","textMapHash":694883098,"text":"ただの荷運びだ。この採掘スターである俺がつるはしをひょいっと振れば、山を丸々くりぬける。層岩巨淵にいる魔物なんて屁でもない。","nextNodeIds":[715030108]},{"nodeId":715030108,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":631405954,"text":"見栄を張るな。咳を我慢してるせいで、顔が真っ赤じゃないか。","nextNodeIds":[715030109]},{"nodeId":715030109,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"図","textMapHash":1672234978,"text":"でたらめを言うな、そんなことは…ゴホッ、ゴホッゴホッ…","nextNodeIds":[715030110]},{"nodeId":715030110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1406059130,"text":"これ以上、先に進まないほうがいい。","nextNodeIds":[715030111]},{"nodeId":715030111,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3395780658,"text":"この黒泥との接触が長引けば、大変なことになる。それに中には魔物も多い。危険すぎる。","nextNodeIds":[715030112]},{"nodeId":715030112,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"図","textMapHash":3408133250,"text":"し…しかし、前にこの機器を鉱区に置いたことで、きれいになったのを俺たちも見た。","nextNodeIds":[715030113]},{"nodeId":715030113,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"図","textMapHash":2334467386,"text":"もし、ゴホッ…もし坑道に存在するこの黒泥をすぐ解決できるのなら…","nextNodeIds":[715030114]},{"nodeId":715030114,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2998317258,"text":"今は速さを求める状況じゃない。問題の処理にしろ、実験にしろ、準備と考察をせず軽々に進めたら、一つのミスで命に関わることになる。","nextNodeIds":[715030115]},{"nodeId":715030115,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2276159538,"text":"「命が一番大切である」——これは「教令院」の実験室にある操作マニュアルの基本規則の一つだ。","nextNodeIds":[715030116]},{"nodeId":715030116,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":881094010,"text":"だから、「教令院」の学者である私は、そういった行動を見て見ぬふりはできない。","nextNodeIds":[715030117]},{"nodeId":715030117,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":70350970,"text":"はぁ、でも僕たちがここで手を止めたら…この大量にある黒泥はどうなる？","nextNodeIds":[715030118]},{"nodeId":715030118,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":448761362,"text":"もし、この黒泥がもっと魔物を引き寄せたら…たとえこちらが二十人増えても…ゴホッ、中には運べなくなる。","nextNodeIds":[715030119]},{"nodeId":715030119,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":82975170,"text":"そうだな…","nextNodeIds":[715030120]},{"nodeId":715030120,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3463630754,"text":"なら、ここでスパイクを起動しよう…","nextNodeIds":[715030121]},{"nodeId":715030121,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":586103522,"text":"ここで起動？","nextNodeIds":[715030122]},{"nodeId":715030122,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2607813106,"text":"そう。さっき黒泥が湧き出るスピードを目視で計測してみた。昨日の鉱区よりは速いが、黒泥の核心エリアではないから、これなら除去スピードのほうが上回る。","nextNodeIds":[715030123]},{"nodeId":715030123,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2711807314,"text":"層岩巨淵の魔物が黒泥に引き寄せられたのも、きっとそのエネルギーに影響を受けたからだ。","nextNodeIds":[715030124]},{"nodeId":715030124,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3765818490,"text":"#ここでスパイクを起動して周囲の黒泥の影響を抑え込めば、{NICKNAME}も行動しやすくなるだろう。","nextNodeIds":[715030125]},{"nodeId":715030125,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1365272194,"text":"黒泥を除去すれば、魔物もここに集まらなくなるはずだ。そうなったら、運搬を再開しよう。","nextNodeIds":[715030126]},{"nodeId":715030126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2518152410,"text":"そうしよう。","nextNodeIds":[715030127]},{"nodeId":715030127,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2080625362,"text":"二人とも、まずは拠点に戻って休んでくれ。この先もまだ君たちに頼みたいことはあるからね。","nextNodeIds":[715030128]},{"nodeId":715030128,"roleType":"TALK_ROLE_NPC","speakerId":30184,"speakerName":"図","textMapHash":1590143650,"text":"俺は大丈夫だ。これしきのことで…ゴホッ、この採掘スターは休まない。魔物を片付けるだけだ、俺も手伝おう！","nextNodeIds":[715030129]},{"nodeId":715030129,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":824291250,"text":"無理するな、君のことなら分かってるから。","nextNodeIds":[715030130]},{"nodeId":715030130,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":3415570706,"text":"#この人はあの噂の{NICKNAME}だ。{M#彼}{F#彼女}に任せれば、僕たちが心配する必要もないだろう。","nextNodeIds":[715030131]},{"nodeId":715030131,"roleType":"TALK_ROLE_NPC","speakerId":30183,"speakerName":"昊","textMapHash":3658525970,"text":"#{NICKNAME}、周囲の黒泥と魔物の片付けは君に任せるよ。","nextNodeIds":[715030132,715030133]},{"nodeId":715030132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2383528210,"text":"分かった。","nextNodeIds":[715030134]},{"nodeId":715030134,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2292977554,"text":"#そうだ。{NICKNAME}、この辺りは黒泥だらけで、思っていたよりも状況が悪い…","nextNodeIds":[715030135]},{"nodeId":715030135,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4090987506,"text":"黒泥の周りには魔物がいっぱいいるから、気を付けてほしい…","nextNodeIds":[715030136]},{"nodeId":715030136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1539748770,"text":"うん、気を付けるよ。","nextNodeIds":[715030137]},{"nodeId":715030137,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":991872874,"text":"いや、私が言いたいのは、「プルシナスパイク」に被害が出ないよう気を付けてほしいという意味だ。","nextNodeIds":[715030138]},{"nodeId":715030138,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3027142554,"text":"君の実力を信じてはいるが…それでも、「プルシナスパイク」は精密で繊細、そして偉大な機器だ…","nextNodeIds":[715030139]},{"nodeId":715030139,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":934381042,"text":"スパイクを傷つけないよう、十分に気を付けてほしい。","nextNodeIds":[]},{"nodeId":715030133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2368851242,"text":"安心して任せて。","nextNodeIds":[715030134]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150301,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["166001689","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7150302,"order":3,"stepDescription":"「プルシナスパイク」を起動する","stepDescTextMapHash":1674178724,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q71503"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7150302_guide","30"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q71503"}],"triggerCond":[],"exec