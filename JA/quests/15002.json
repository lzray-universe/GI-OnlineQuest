d":15002,"showRandomTalkCount":0},"dialogs":[{"nodeId":150020201,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":3425380546,"text":"旅人、パイモン。","nextNodeIds":[150020202]},{"nodeId":150020202,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1349752266,"text":"キィニチ！？こんなところで会うなんて！オイラたち、おまえの話をしてたんだぜ。","nextNodeIds":[150020203]},{"nodeId":150020203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":486688474,"text":"こんにちは、また会ったね。","nextNodeIds":[150020204]},{"nodeId":150020204,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":549921778,"text":"単刀直入に聞く。トリニダードの依頼を受けたらしいな？","nextNodeIds":[150020205]},{"nodeId":150020205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1845148850,"text":"えっ！あの…廻焔の夜のことか？えっと…トリニダードは元々おまえに頼みたかったらしいんだけど…でも…まあ…なんていうか…","nextNodeIds":[150020206]},{"nodeId":150020206,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":758528954,"text":"そう動揺しないでいい。ひとつ言っておきたいことがあってな——トリニダードは本当の目的を隠してるかもしれない。あいつは山の王の問題を永久的に解決させようとしているんだ。","nextNodeIds":[150020207]},{"nodeId":150020207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":871604386,"text":"永久的に解決？もう廻焔の夜をやらなくてもいいようにするってことか？","nextNodeIds":[150020208]},{"nodeId":150020208,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":4184295106,"text":"ああ。あいつはお前らの手を借り、山の王を夜神の国に帰すつもりのようだ。","nextNodeIds":[150020209]},{"nodeId":150020209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":869841610,"text":"夜神の国に帰す…？","nextNodeIds":[150020210]},{"nodeId":150020210,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":903566458,"text":"つまり、山の王を殺そうとしてる。","nextNodeIds":[150020211]},{"nodeId":150020211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":501548426,"text":"ひっ！そんな物騒な言い方すんなよ…でも、それってほんとなのか？なんだか信じられないけど…","nextNodeIds":[150020212]},{"nodeId":150020212,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":3022907146,"text":"なんだ、もっと遠回しに言ってほしかったのか？ふむ…","nextNodeIds":[150020213]},{"nodeId":150020213,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":3687425282,"text":"おそらく、トリニダードはこう考えてる…お前らに山の王を倒してもらおうとな。","nextNodeIds":[150020214]},{"nodeId":150020214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":11657594,"text":"そんな…だって、山の王はおまえたちにとって、「生きた栄誉」なんだろ！？","nextNodeIds":[150020215]},{"nodeId":150020215,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":3567454442,"text":"その栄誉の裏には代償が伴う。","nextNodeIds":[150020216]},{"nodeId":150020216,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":536236882,"text":"ああ。山の王は私たちにとって「生きた栄誉」だ。しかし、その栄誉には代償が伴う。","nextNodeIds":[150020217]},{"nodeId":150020217,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":3504402842,"text":"ナンナのような件は、何も今回が初めてではない…","nextNodeIds":[150020218]},{"nodeId":150020218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":398202186,"text":"竜のナンナが引き金になってる？","nextNodeIds":[150020219]},{"nodeId":150020219,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":1476684602,"text":"ああ。ナンナのような件は、これからも続くだろう。","nextNodeIds":[150020220]},{"nodeId":150020220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":631086770,"text":"でも…それで山の王を殺すのか？極端すぎるぞ…","nextNodeIds":[150020221]},{"nodeId":150020221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3631328906,"text":"どうやって山の王を殺すの？","nextNodeIds":[150020222]},{"nodeId":150020222,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":1923490698,"text":"アビスに汚染された山の王は、通常の災害とは異なる存在だ。数百年にわたり、邪悪な力の侵蝕を受けてきた山の王の身体は、もはやアビスと一体化してると言っていい。","nextNodeIds":[150020223]},{"nodeId":150020223,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":660566202,"text":"アビスの力は山の王を狂わせた元凶だが、同時にその命も繋ぎ止めてる。つまり、アビスの力を完全に取り除けば、山の王は永遠の眠りに落ちるということだ。","nextNodeIds":[150020224]},{"nodeId":150020224,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":417366442,"text":"過去の儀式では、アビスの力を半分ほど取り除くことで、山の王を死なせることなく、目覚めさせない折衷案を取ってきた。","nextNodeIds":[150020225]},{"nodeId":150020225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2705884498,"text":"確かに、具体的にどれくらい取り除けばいいか言われてなかったな…でも後で詳細を話すって言ってたけど…","nextNodeIds":[150020226]},{"nodeId":150020226,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":2360893458,"text":"なら、すぐ分かるだろう。","nextNodeIds":[150020227]},{"nodeId":150020227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":339474746,"text":"…もし本当に山の王を殺そうとしてるなら、オイラたち、どうすればいいんだ？","nextNodeIds":[150020228,150020229]},{"nodeId":150020228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2206746762,"text":"厄介な依頼を引き受けちゃったみたい。","nextNodeIds":[150020230]},{"nodeId":150020230,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":1563604642,"text":"少しばかり刺激が強かったようだな。とりあえず知らないふりをするといい。トリニダードとの話が終わったら、族長のところに来てくれ。","nextNodeIds":[150020231]},{"nodeId":150020231,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":4136943146,"text":"取引がしたい。","nextNodeIds":[150020232]},{"nodeId":150020232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":19755866,"text":"取引？","nextNodeIds":[150020233]},{"nodeId":150020233,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":3377851306,"text":"ああ、悪くない報酬を出すつもりだ。お前らも多くの疑問を抱えてるだろう。それに答えるいい機会にもなる。","nextNodeIds":[150020234]},{"nodeId":150020234,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":791133338,"text":"分かった、あとで行くよ。","nextNodeIds":[150020235]},{"nodeId":150020235,"roleType":"TALK_ROLE_NPC","speakerId":1088,"speakerName":"キィニチ","textMapHash":407681986,"text":"ああ、待ってる。","nextNodeIds":[]},{"nodeId":150020229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2192824402,"text":"今から辞退しても間に合う？","nextNodeIds":[150020230]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1500202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133502316"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_9398:-2189.381,243.899,8449.425,0.000,261.032,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1500201,"order":2,"stepDescription":"トリニダードの家に行く","stepDescTextMapHash":1716509380,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1500201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["14145"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[1500201],"talks":[{"talkId":1500201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1500201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1500201,"initDialog":150020101,"nextRandomTalks":[],"nextTalks":[],"npcId":[14145],"performCfg":"QuestDialogue/LQ/Kinich_15002/Q1500201","priority":5,"questId":15002,"showRandomTalkCount":0},"dialogs":[{"nodeId":150020101,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":3453035130,"text":"異邦の強者よ、よく来てくれた。ゆっくり休めただろうか？","nextNodeIds":[150020102]},{"nodeId":150020102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4079281858,"text":"ま…まあな！","nextNodeIds":[150020103]},{"nodeId":150020103,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":135495914,"text":"ならよかった。こちらの準備も順調だ。あんたの功績を耳にしたやつらもそれなりにいてな。族長を含め、みんな承認してくれたよ。","nextNodeIds":[150020104]},{"nodeId":150020104,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":2562578954,"text":"儀式は「マリポ」の継承者が執り行うべきだと主張する者もいたが、そういった考えはあまりに古い。私たちは時代と共に変わっていかなければね。","nextNodeIds":[150020105]},{"nodeId":150020105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":609371202,"text":"キィニチもやりたくないみたいだしな…","nextNodeIds":[150020106]},{"nodeId":150020106,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":908086546,"text":"ああ。さて、さっそく儀式の詳細を説明しよう。","nextNodeIds":[150020107]},{"nodeId":150020107,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":661997834,"text":"昨日は導火の儀式について伝えたが、今日教えるのは山の王を浄化する方法だ。","nextNodeIds":[150020108]},{"nodeId":150020108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":8514282,"text":"どうやって浄化するの？","nextNodeIds":[150020109]},{"nodeId":150020109,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":1751611290,"text":"簡単さ、聖火を使えばいい。私たちは長年儀式をやってきたおかげで、その作業に慣れている。あんたにとっても、そう難しいものじゃないだろう。","nextNodeIds":[150020110]},{"nodeId":150020110,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":2447241682,"text":"そして肝心なのは、聖火を使ってなるべく多くのアビスの力を取り除くことだ。そうすれば山の王の眠りを確実に維持できる。","nextNodeIds":[150020111]},{"nodeId":150020111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3205630082,"text":"本当に眠らせておくのが目的なんだよな…？","nextNodeIds":[150020112]},{"nodeId":150020112,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":247402106,"text":"もちろん。過去の儀式では、遊火者がいくら力を尽くしてもアビスのエネルギーを一部しか取り除けなかった。この儀式を定期的に行わないといけない理由もそのためだ。","nextNodeIds":[150020113]},{"nodeId":150020113,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":450473666,"text":"その点、あんたはアビスに対抗することにおいて経験豊富。昨日も聖火を見事に使いこなしていたしな。","nextNodeIds":[150020114]},{"nodeId":150020114,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":1342905274,"text":"あんたなら、山の王の体内にあるアビスのエネルギーをすべて取り除けるかもしれない。そうすれば、私たちはこれから長いこと、脅威に怯えずに済む。","nextNodeIds":[150020115]},{"nodeId":150020115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2208746954,"text":"旅人…","nextNodeIds":[150020116]},{"nodeId":150020116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":969848450,"text":"分かった。他に注意すべきことは？","nextNodeIds":[150020117]},{"nodeId":150020117,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":3951212466,"text":"こちらの要求を聞いても動じないとは、相当自信があるようだな、ハハッ。","nextNodeIds":[150020118]},{"nodeId":150020118,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":3524640586,"text":"他に注意すべき点はない。儀式は三日後だ、時間になったらまた知らせよう。","nextNodeIds":[150020119]},{"nodeId":150020119,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":177116258,"text":"それまで手が空いているのなら、集落を回ってみるといい。他の重役たちも、あんたの顔をみんなに見せておきたいと思っている。","nextNodeIds":[150020120]},{"nodeId":150020120,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":1416063282,"text":"ああ、あとこれはついででいいんだが…もし部族の人が悩んでいたら、手を貸してやってくれると助かる。","nextNodeIds":[150020121]},{"nodeId":150020121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2618620682,"text":"みんなの悩みごとも解決しなくちゃいけないのか？それって追加料金をもらうべきなんじゃ…","nextNodeIds":[150020122]},{"nodeId":150020122,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":1894013826,"text":"ハハッ、ちょっとした提案さ。あんたみたいな英雄は、部族内での評判を集めておくべきだろう？","nextNodeIds":[150020123]},{"nodeId":150020123,"roleType":"TALK_ROLE_NPC","speakerId":14145,"speakerName":"トリニダード","textMapHash":3626783602,"text":"ここ数日は私も集落にいる。もし何かあれば、いつでも私のところに来てくれ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1500201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerC