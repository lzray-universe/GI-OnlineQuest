:5,"questId":19153,"showRandomTalkCount":0},"dialogs":[{"nodeId":191530901,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":286924362,"text":"なるほど…","nextNodeIds":[191530902]},{"nodeId":191530902,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1759824170,"text":"分析を聞かせて。","nextNodeIds":[191530903]},{"nodeId":191530903,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":3357674130,"text":"うん。まず、カタユンさんが提供してくれた情報から、仙霊の正体はルタワヒスト学院の学生だってことが分かった。","nextNodeIds":[191530904]},{"nodeId":191530904,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":512626554,"text":"外部の人間である可能性はほぼ排除できる。なぜなら、管理者に知られずに、あの二冊の本を持ち出すことはできないから。","nextNodeIds":[191530905]},{"nodeId":191530905,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":4256213570,"text":"次に、不思議な超能力のことはいったん置いておいて、目撃された場所はすべて、私たちの学院が星象観測の地点として推奨しているところなの。","nextNodeIds":[191530906]},{"nodeId":191530906,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1336048394,"text":"つまり…仙霊は研究をしてて、しかもその内容は私と似てる。","nextNodeIds":[191530907]},{"nodeId":191530907,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":3071300746,"text":"私が出した質問は簡単なものじゃないのに、その日のうちに返信してくれた。似たような予備知識を把握してる証拠だよ。","nextNodeIds":[191530908]},{"nodeId":191530908,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":2519158882,"text":"それなら、この推測を基に、星象観測の地点で仙霊を待てばいいと思うの。","nextNodeIds":[191530909,191530910]},{"nodeId":191530909,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":564855138,"text":"いい考え。","nextNodeIds":[191530911]},{"nodeId":191530911,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":731509026,"text":"ほ、褒めすぎだよ…実は、もっと別の理由があるの。今までずっと考えていた推測がね。","nextNodeIds":[191530912]},{"nodeId":191530912,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":2184078658,"text":"でもそれは重要じゃない。とりあえず行ってみましょう。手がかりがあるとはいえ、結論が出るかどうかはまだ分からないから…","nextNodeIds":[191530913]},{"nodeId":191530913,"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":2704413290,"text":"どうしてそう思うのかは…仙霊が来なかったら、教えてあげる。","nextNodeIds":[]},{"nodeId":191530910,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1965381514,"text":"これだけ推理する力があるなら、論文を完成させるのも問題ないはず。","nextNodeIds":[191530911]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"1915304"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1817080066,"text":"おしゃべりしているうちに、とても長い時間が経った。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1623675482,"text":"知恵の殿堂に忍び込むとか、色んな超能力があるという伝説はどういうこと？"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":789710458,"text":"仙霊がいたずらをするってどういうこと？"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3437123322,"text":"#{M#君}{F#あなた}が仙霊だったんだね。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1318487538,"text":"（えっと、確かこうだったよね…）"}],"talkIds":[1915308,1915309],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","count":18},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":7},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","count":1}],"raw":{"ANDJNFLID