"",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406302,"initDialog":740630201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5219],"performCfg":"QuestDialogue/Q7406302","priority":5,"questId":74063,"showRandomTalkCount":0},"dialogs":[{"nodeId":740630201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3967276050,"text":"あれ？なんでここに写真機が？","nextNodeIds":[740630202]},{"nodeId":740630202,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":1662704162,"text":"「スクープあるところに写真機あり」——って聞いたことない？","nextNodeIds":[740630203,740630206]},{"nodeId":740630203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2689744650,"text":"聞いたことあるような。","nextNodeIds":[740630204]},{"nodeId":740630204,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":1904895634,"text":"私が今作った言葉なんだけど、どこで聞いたの？","nextNodeIds":[740630205]},{"nodeId":740630205,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":550067018,"text":"はぁ、やっぱりこの世に新しいものなんてないのね。何を言っても、何を書いても…それは他の人のマネになってしまうんだもの。","nextNodeIds":[740630208]},{"nodeId":740630208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":950682866,"text":"写真機はあるけど、スクープはどこ？","nextNodeIds":[740630209]},{"nodeId":740630209,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":2191487962,"text":"スクープは…釣りみたいなものよ。辛抱強く待って、正確なタイミングで正しい判断をすることで初めて、大きな魚が釣れ…","nextNodeIds":[740630210]},{"nodeId":740630210,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":1081378186,"text":"あ、いえ、大きなスクープが釣れるって言いたかったの。あれ？それもなんか違うかも。まあいっか！","nextNodeIds":[740630211,740630213]},{"nodeId":740630211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":16716322,"text":"素人っぽいね。記者じゃないでしょ？","nextNodeIds":[740630212]},{"nodeId":740630212,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":553137514,"text":"ブッブー、不正解！私はアマチュアの記者よ。","nextNodeIds":[740630222]},{"nodeId":740630222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2852927418,"text":"ところで、アマチュア記者がどうしてこんなところにいるんだよ？","nextNodeIds":[740630223]},{"nodeId":740630223,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":2788491034,"text":"先輩から与えられた課題をこなすためよ——「メロピデ要塞の看守のリアルな仕事風景を写真機に収める」っていうね！","nextNodeIds":[740630224]},{"nodeId":740630224,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":2677815306,"text":"でも、規則通りに関連書類を用意してたら時間があまりにもかかっちゃってね…これを見れば分かると思うけど…","nextNodeIds":[740630225]},{"nodeId":740630225,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":864482178,"text":"ネリーは書類の山を取り出した。様々な項目とサインがびっしり書いてあり、目を通しただけでめまいがしてきた…","nextNodeIds":[740630226]},{"nodeId":740630226,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":1221032266,"text":"この一連の手続きを済ませてたら、看守の当直時間を逃しちゃって。釣りに例えるなら、今は釣れる魚がいない状態ってわけ…","nextNodeIds":[740630227]},{"nodeId":740630227,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3135549130,"text":"えっ？でもここの看守って、別に一人だけじゃないだろ？","nextNodeIds":[740630228]},{"nodeId":740630228,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":1785992306,"text":"うん。でも、どうせなら白金秘蔵型を釣りたいじゃない？基礎能力型とか水域清掃員とかだと、ちょっとインパクトに欠けるし…それにそんなんで課題をクリアしても、先輩は絶対褒めてくれないと思うから。","nextNodeIds":[740630229,740630230]},{"nodeId":740630229,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":311143410,"text":"成果が欲しいなら、選り好みしないほうが…","nextNodeIds":[740630233]},{"nodeId":740630233,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":872790002,"text":"そうよね、自分の実力を受け入れないと。それに実力を超えた魚を釣ろうなんて考えちゃいけない…うぅ、私ってダメな漁師…あ、いや違った、ダメなアマチュア記者…","nextNodeIds":[740630234]},{"nodeId":740630234,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":2921470842,"text":"よし、弱音を吐くのはここまでにして、元気を出さないと！もしお二人の都合がよければ…ちょっと手伝ってくれないかな？ね、お願い！報酬は払うから！","nextNodeIds":[740630235]},{"nodeId":740630235,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":124177090,"text":"き、切り替えが早いな…手伝いの内容にもよるけど、まずはなにをしてほしいか教えてくれないか？","nextNodeIds":[740630236]},{"nodeId":740630236,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":3183639506,"text":"あそこにいる看守が見える？彼の名はグランヴィル。私の見立てだと、彼に関するスクープはメンテマシナリーの態勢制御者と同等の価値があると思うの…","nextNodeIds":[740630237]},{"nodeId":740630237,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":3278225314,"text":"彼の写真を撮れば、きっと良い記事が書けるはず。そうすれば、先輩も何も言うことないでしょ？","nextNodeIds":[740630238]},{"nodeId":740630238,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":3276118946,"text":"でもあの人、全然こっちに来ないのよ！だからさ、写真を撮るのにベストな位置まで連れてきてくれない？","nextNodeIds":[740630239,740630241]},{"nodeId":740630239,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":241048370,"text":"自分で状況を説明して、来てもらえば？","nextNodeIds":[740630240]},{"nodeId":740630240,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":3119070842,"text":"そんなことしたら、きっとカメラが気になって固いポーズを取っちゃうわ。それって不自然になっちゃうでしょ？","nextNodeIds":[740630243]},{"nodeId":740630243,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":2739628026,"text":"私の作戦はこうよ——まずは拡声器をオフにする。そしてグランヴィルに、拡声器が故障したから見てもらいたいって報告するの。","nextNodeIds":[740630244]},{"nodeId":740630244,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":3866317490,"text":"そうすればきっと、メロピデ要塞の看守が活躍する瞬間を捉えることができるわ！","nextNodeIds":[740630245]},{"nodeId":740630245,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":306058050,"text":"課題をクリアできるかは、この作戦にかかってるの！お願い、助けて！","nextNodeIds":[740630246]},{"nodeId":740630246,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3535764170,"text":"#難しくはなさそうだな。{NICKNAME}、助けてやろうぜ。","nextNodeIds":[]},{"nodeId":740630241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":986995954,"text":"写真機を持って、彼のところに行けば？","nextNodeIds":[740630242]},{"nodeId":740630242,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":3373218418,"text":"えっと…こっちの背景のほうがピッタシなのよ。それに、もし彼が写真機に気づいたら、きっと気になって、固いポーズを取っちゃうわ…","nextNodeIds":[740630243]},{"nodeId":740630230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1196920266,"text":"頑張って待ち続けて。じゃあ…","nextNodeIds":[740630231]},{"nodeId":740630231,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":1324088394,"text":"も、もう行っちゃうの？本当に？その…助けてくれたりは…？","nextNodeIds":[740630232]},{"nodeId":740630232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":662406386,"text":"えっと…白金秘蔵型を望んでるんだろ？でも、オイラたちの手でそれを出せるわけじゃないからな。","nextNodeIds":[740630233]},{"nodeId":740630213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2050546650,"text":"#スクープはさておき、{M#俺}{F#私}も釣りが好き。","nextNodeIds":[740630214]},{"nodeId":740630214,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":3852066970,"text":"本当？よかったぁ。実は私、釣りに関しては初心者でね。ちょうど聞きたいことがあったの。例えば、メンテマシナリーを釣って噛まれたりしたら…君はどうする？","nextNodeIds":[740630215,740630216,740630217]},{"nodeId":740630215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1556070210,"text":"そのまま逃がす。","nextNodeIds":[740630219]},{"nodeId":740630219,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":1815682306,"text":"なるほど。それが君の選択なのね。ふむ、参考になったわ。覚えておくよ。","nextNodeIds":[740630220]},{"nodeId":740630220,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":2550915170,"text":"…って、どうして急に釣りの話になってるの？会話をリードするのがとても上手なのね！どうやらアマチュア記者として、まだまだ学ぶべきことがたくさんあるみたい…","nextNodeIds":[740630221]},{"nodeId":740630221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":134388946,"text":"釣りの話はおまえが先に始めたんだろ！","nextNodeIds":[740630222]},{"nodeId":740630216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2737144130,"text":"ボコボコにして分からせる。","nextNodeIds":[740630219]},{"nodeId":740630217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3579598546,"text":"料理してパイモンに食べさせる。","nextNodeIds":[740630218]},{"nodeId":740630218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1791911266,"text":"#おい！{NICKNAME}の料理の腕は信じてるけど、あれはどう見ても食べられるもんじゃないだろ！","nextNodeIds":[740630219]},{"nodeId":740630206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":705335858,"text":"聞いたことない。","nextNodeIds":[740630207]},{"nodeId":740630207,"roleType":"TALK_ROLE_NPC","speakerId":5219,"speakerName":"ネリー","textMapHash":4128565106,"text":"おお！じゃあ、今はじめて聞いたってことだ？もし他のところでこの言葉を使う場合は、必ず引用元をつけるようにね！引用元は「私」だから！","nextNodeIds":[740630208]}]},{"talkId":7406307,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":fa