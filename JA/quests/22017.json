se,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2201705","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":2201705,"initDialog":220170501,"nextRandomTalks":[],"nextTalks":[],"npcId":[3033,3032],"performCfg":"","priority":5,"questId":22017,"showRandomTalkCount":0},"dialogs":[{"nodeId":220170501,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"茂","textMapHash":191194850,"text":"この小説？確か文章が優れていて、筋書きもしっかりしていた。編集者たちも満場一致で褒めていたから、当時はとても売れていたな。","nextNodeIds":[220170502]},{"nodeId":220170502,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":1472193226,"text":"…そうなの？","nextNodeIds":[220170503]},{"nodeId":220170503,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":1627115930,"text":"でも、この小説はストーリーと設定の厳密性にこだわり過ぎて、広がりに欠けていた。だから、結局は読者が既に知っている展開を繰り返すことになっていたと思うんだけど。","nextNodeIds":[220170504]},{"nodeId":220170504,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":1896572738,"text":"だから、どんどん新鮮さがなくなり、次第に読者を失っていった。そして最終的には、読者をすべて失い、打ち切りになってしまった。","nextNodeIds":[220170505]},{"nodeId":220170505,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":2011702362,"text":"設定も物語も、厳しく制限されたら、どれも一緒になってしまう。そして生気のない淀んだ水のように、読者たちから見捨てられてしまう。","nextNodeIds":[220170506]},{"nodeId":220170506,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":3037428938,"text":"僕の小説がこんな風になるのは嫌だ！いい物語にはまず、際立った特別なものが必要なんだ！","nextNodeIds":[220170507]},{"nodeId":220170507,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":3858435090,"text":"それに、もし…もし作家自身ですら物語に興味を持たなかったら、どうやって読者を感動させるんだ？","nextNodeIds":[220170508]},{"nodeId":220170508,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":3522608906,"text":"茂さん！","nextNodeIds":[220170509]},{"nodeId":220170509,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"茂","textMapHash":2884189370,"text":"わ、分かったよ…","nextNodeIds":[220170510]},{"nodeId":220170510,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"茂","textMapHash":176002034,"text":"そんな深く考えていたなんて、思ってなかったよ。流石『鬼武道』の作者だ。","nextNodeIds":[220170511]},{"nodeId":220170511,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"茂","textMapHash":984185834,"text":"実は、僕も君を制限したくないんだよ。でも、想像力や創作意欲が過剰で、作品を台無しにしてしまった作家をたくさん見てきたからね…","nextNodeIds":[220170512]},{"nodeId":220170512,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"茂","textMapHash":3585986378,"text":"順吉、君は作家として、創作についてどう思ってるんだい？","nextNodeIds":[220170513]},{"nodeId":220170513,"roleType":"TALK_ROLE_NPC","speakerId":3032,"speakerName":"順吉","textMapHash":1588726858,"text":"僕は創作意欲が一番大事だと思う。創作意欲がない作家は、人を感動させる作品なんてきっと作り出せない。","nextNodeIds":[220170514]},{"nodeId":220170514,"roleType":"TALK_ROLE_NPC","speakerId":3033,"speakerName":"茂","textMapHash":1235843690,"text":"でも僕は、作家にとって一番大事なものは、創作意欲に対する自制心の方だと思う。","nextNodeIds":[220170515,220170516]},{"nodeId":220170515,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":509648554,"text"