{"mainQuestId":76114,"title":"様子のおかしい隠者","description":"レンポ島の北部、空寂回廊の東側に住まう隠者ドーヴェントは、かつて定期的にナシャタウンの友人を訪ねていた。しかし最近ではナシャタウンを訪れるどころか、わざわざ家に来てくれた客人ももてなさず、閉じこもっているという。服装や生活習慣もずいぶん変わったようだ…もう一つ気になるのはある行商人の話で、隠者を定期的に訪ねていた行商仲間が、その最後の訪問以来、行方が分からなくなっているそうなのだ…真相を明らかにするには直接会いに行くのが一番かもしれない。","titleTextMapHash":2726539367,"descTextMapHash":3022631014,"mainQuestExcel":{"mainQuestId":76114,"titleTextMapHash":2726539367,"title":"様子のおかしい隠者","descTextMapHash":3022631014,"description":"レンポ島の北部、空寂回廊の東側に住まう隠者ドーヴェントは、かつて定期的にナシャタウンの友人を訪ねていた。しかし最近ではナシャタウンを訪れるどころか、わざわざ家に来てくれた客人ももてなさず、閉じこもっているという。服装や生活習慣もずいぶん変わったようだ…もう一つ気になるのはある行商人の話で、隠者を定期的に訪ねていた行商仲間が、その最後の訪問以来、行方が分からなくなっているそうなのだ…真相を明らかにするには直接会いに行くのが一番かもしれない。","chapterId":0,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/WQ76114","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":0,"descTextMapHash":3022631014,"EPJHBBICPCA":true,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":76114,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_CLIENT_ONLY","IGHALKGCHAB":3083374953,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/WQ76114","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":true,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":0,"rewardIdList":[176114],"series":0,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2726539367,"type":"WQ","unlockDescTextMapHash":1992924758}},"flow":[{"subQuestId":7611401,"order":1,"stepDescription":"「秘聞の館」に行く","stepDescTextMapHash":941000668,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7611401,0],"PAINLIBBLDK"