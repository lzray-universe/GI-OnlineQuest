speakerId":5005,"speakerName":"イサドラ","textMapHash":1985216210,"text":"ありがとうございます。はぁ、マーナさん…この三か月で私が出会った優しい人は、あなたと旅人さんの二人だけです。","nextNodeIds":[240020410]},{"nodeId":240020410,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":2768093106,"text":"他のみんなは私に怒鳴ったり、仕事を催促したりするばかりで…","nextNodeIds":[240020411]},{"nodeId":240020411,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1368515970,"text":"いえ…愚痴をこぼす暇なんかありません。早く仕事に戻らないと、またカイザーさんにうるさく言われます…","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["43030"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_DAILY_TASK"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[2400201,2400202,2400204],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","count":33},{"roleType":"TALK_ROLE_NPC","speakerId":5045,"speakerName":"マーナ","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":true,"CBBBCAKOFGO":3036716686,"CHECNJEMEFE":{"5005":[1280],"5053":[1200]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/IQ/Fontaine_24002/Q2400201"