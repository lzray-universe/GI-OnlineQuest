05"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400201],"talks":[{"talkId":2400201,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2400201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2400201,"initDialog":240020101,"nextRandomTalks":[],"nextTalks":[],"npcId":[5005],"performCfg":"QuestDialogue/IQ/Fontaine_24002/Q2400201","priority":5,"questId":24002,"showRandomTalkCount":0},"dialogs":[{"nodeId":240020101,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":2895888210,"text":"あれ？どこにいったのかしら？まずいわ…","nextNodeIds":[240020102]},{"nodeId":240020102,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1818130210,"text":"もう一回書くなんて絶対無理。","nextNodeIds":[240020103]},{"nodeId":240020103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4209582714,"text":"何か失くしちゃったの？","nextNodeIds":[240020104]},{"nodeId":240020104,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1661122866,"text":"ええ、本当に私が失くしただけなら助かるのですが…私はポジティブですので。","nextNodeIds":[240020105,240020106]},{"nodeId":240020105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":672253266,"text":"それって…ポジティブって言える？","nextNodeIds":[240020107]},{"nodeId":240020107,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":3594866386,"text":"はは…私が探していたのは半年間のオフィスの会計帳簿なんです。","nextNodeIds":[240020108]},{"nodeId":240020108,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1827550306,"text":"すぐにカイザーさんに提出しなければいけないというのに、なんと五ページ分も抜けていることに気が付きました。","nextNodeIds":[240020109]},{"nodeId":240020109,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":2569334146,"text":"しかも、その五ページにはそれぞれ違う月の、かなりの量の支出の内訳が書かれていました。","nextNodeIds":[240020110]},{"nodeId":240020110,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1876660434,"text":"その数ヶ月分の請求書がないことに、ついさっき最終チェックをしていて気が付いたんですが…","nextNodeIds":[240020111]},{"nodeId":240020111,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":3280123770,"text":"それがもし不注意で失くしたのではなく、最初から作成していなかったとしたら…私はどうやって経費の総額を計算したんでしょう？","nextNodeIds":[240020112]},{"nodeId":240020112,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1839125058,"text":"ううっ…もうこれ以上考えるのは怖い…もしも、私のミスで漏れていたら、きっとカドメさんに過去十年分の帳簿をもう一回チェックさせられます…","nextNodeIds":[240020113]},{"nodeId":240020113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":98651618,"text":"すごく深刻な事態みたいだね…","nextNodeIds":[240020114]},{"nodeId":240020114,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1854248066,"text":"そうなんです。もしそれらの請求書が会計から漏れたり、紛失したままだったら、来月にはかなりの部署が資金問題で大騒ぎになるでしょうから。","nextNodeIds":[240020115]},{"nodeId":240020115,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":4137492450,"text":"本当に困りました…昨日は徹夜してまで帳簿作りを終わらせて、それで今朝パレ·メルモニアに持ってきたんです。","nextNodeIds":[240020116]},{"nodeId":240020116,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1146242562,"text":"でもそろそろ着くという頃にカモメの群れに驚いて、つい手元が…","nextNodeIds":[240020117]},{"nodeId":240020117,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":270057170,"text":"はぁ、その時に失くしてしまったのかもしれません。","nextNodeIds":[240020118,240020119]},{"nodeId":240020118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3429495450,"text":"探してあげるよ。","nextNodeIds":[240020120]},{"nodeId":240020120,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":3683987626,"text":"手伝っていただけるんですか？それは助かります…！では、道に沿って探してみましょう。","nextNodeIds":[240020121]},{"nodeId":240020121,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":2465412714,"text":"特に機密情報の書かれた書類ではありませんから、見つかったら安心して拾ってくださいね。","nextNodeIds":[240020122]},{"nodeId":240020122,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":1689345194,"text":"あ、そうだ！来る時に、警官のマーナさんにも会ったんです。彼女がカモメたちを追い払ってくれて。","nextNodeIds":[240020123]},{"nodeId":240020123,"roleType":"TALK_ROLE_NPC","speakerId":5005,"speakerName":"イサドラ","textMapHash":4109286498,"text":"彼女に請求書を見ていないか聞いてみましょう。","nextNodeIds":[]},{"nodeId":240020119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":760355426,"text":"一緒に探そう。","nextNodeIds":[240020120]},{"nodeId":240020106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1603581514,"text":"ものを失くしたのが「いいこと」？","nextNodeIds":[240020107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5005"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2400202,"order":2,"stepDescription":"マーナと会話する","stepDescTextMapHash":3514423884,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2400202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2400202],"talks":[{"talkId":2400202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":