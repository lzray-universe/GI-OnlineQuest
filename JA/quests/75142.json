65],"performCfg":"QuestDialogue/WQ/Natlan_75142/Q7514205","priority":5,"questId":75142,"showRandomTalkCount":0},"dialogs":[{"nodeId":751420501,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3671641482,"text":"聖山様はお腹の具合を悪くしてるから、毎日いろんなものを吐き出してるの。見たらわかるでしょ！いま集落の外に行くのは危ないよ！","nextNodeIds":[751420502]},{"nodeId":751420502,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":2186778010,"text":"昔、おじさんが話してくれたお話の中で「火山の具合が悪い時は、みんなで何度か叩けば治る」って言ってたもんな。おれの手じゃ小さすぎるけど…","nextNodeIds":[751420503]},{"nodeId":751420503,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":3408766698,"text":"大人たちの手なら絶対大丈夫なのに、おれたちを集落の外に行かせないために、わざと叩きに行かないんだよ。","nextNodeIds":[751420504]},{"nodeId":751420504,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":1672281922,"text":"あははっ、トゥゼーはそんな風に思ってたの？ふふっ、でも聖山様を治すためには…部族の大人全員で行かなきゃ無理だよ。","nextNodeIds":[751420505]},{"nodeId":751420505,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":1125656218,"text":"でも大人たちはみんな忙しいんだから。例えば、ヴァレサお姉ちゃんは果樹園の世話をしないといけないでしょ？みーんな時間のある時じゃないと、聖山様は叩きにいけないの。","nextNodeIds":[751420506]},{"nodeId":751420506,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":1673964370,"text":"そりゃそうだけど…はぁ、大人たちの仕事が終わるのを待つしかないか…","nextNodeIds":[751420507]},{"nodeId":751420507,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":2923902018,"text":"そう。だから、それまでは大人たちのいう通り、集落から出ないようにしましょ？","nextNodeIds":[751420508]},{"nodeId":751420508,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":4256698626,"text":"…わかった。","nextNodeIds":[751420509]},{"nodeId":751420509,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3015844922,"text":"どうしたんだ？叩く…とか聞こえたけど。","nextNodeIds":[751420510]},{"nodeId":751420510,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":3653061330,"text":"あ、えっと…","nextNodeIds":[751420511]},{"nodeId":751420511,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":3834095202,"text":"外から来た変なやつに部族の秘密を話しちゃいけない、って話をしてたんだ。","nextNodeIds":[751420512]},{"nodeId":751420512,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3290473978,"text":"火山を叩いて治すのって秘密なの…？","nextNodeIds":[751420513]},{"nodeId":751420513,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":4119919338,"text":"な、なんだよ。全部聞いてたんじゃねえか！","nextNodeIds":[751420514]},{"nodeId":751420514,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":437870514,"text":"トゥゼーの声が大きすぎるんだよ。今度から内緒話をするときは、こしょこしょ話ね。","nextNodeIds":[751420515]},{"nodeId":751420515,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":3103083418,"text":"わかったよ…えっ。でも、そ、それ、めちゃくちゃ近くならねえか！？","nextNodeIds":[751420516]},{"nodeId":751420516,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":770074690,"text":"あははっ、そうかもね。えっと…こんにちは、異郷のお客さん。わたしはトゥナイアで、こっちがおばかのトゥゼーです。","nextNodeIds":[751420517]},{"nodeId":751420517,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":692095930,"text":"またおれのこと「ばか」って言った…","nextNodeIds":[751420518]},{"nodeId":751420518,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3055863594,"text":"豊穣の邦へようこそ、テペトル仔竜も…あれっ、聖山様の具合が悪いからかな…集落にはよその竜を退ける「符石」があるはずなのに…","nextNodeIds":[751420519]},{"nodeId":751420519,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":1818236906,"text":"へへっ、符石も叩いて治してやらないとな！","nextNodeIds":[751420520]},{"nodeId":751420520,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3812154994,"text":"今一番叩いて治さないといけないのはトゥゼーの頭のほうじゃない？…はぁ、お二人が悪い人じゃなさそうでよかったです…","nextNodeIds":[751420521]},{"nodeId":751420521,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":1979582626,"text":"それで、お二人はどうしてここへ？","nextNodeIds":[751420522]},{"nodeId":751420522,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2236645658,"text":"トゥナイアとトゥゼーに自己紹介をして、\\n聖山に入る目的を説明した…","nextNodeIds":[751420523]},{"nodeId":751420523,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3867882378,"text":"「聖山に入りたい」、ですか…難しいと思いますよ。大人たちはいつも「聖山は危険な場所だから気軽に入るな」って言ってますし…","nextNodeIds":[751420524]},{"nodeId":751420524,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3890858570,"text":"でも、異郷のお客さんが聖山に入りたがるなんて、きっと何か理由があるんですよね。","nextNodeIds":[751420525]},{"nodeId":751420525,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":413814178,"text":"うーん…聖山に入ったことがある人なら知ってますよ。","nextNodeIds":[751420526]},{"nodeId":751420526,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":2709415258,"text":"お、おれも知ってるぞ！","nextNodeIds":[751420527]},{"nodeId":751420527,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2790260266,"text":"えっ、でも…聖山って部族の大事な場所なんだろ？そんな気軽にオイラたちに教えちゃっていいのか？","nextNodeIds":[751420528]},{"nodeId":751420528,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":779583146,"text":"「聖山」っていうのは、遥か昔のウォーベンに載っていた呼び方をそのまま使ってるだけです…わたしたちにとっては、「聖火競技場」のほうが神聖ですよ。","nextNodeIds":[751420529]},{"nodeId":751420529,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":2097781050,"text":"入っちゃいけないのは、ただ危ないからってだけですよ。","nextNodeIds":[751420530]},{"nodeId":751420530,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":2147304602,"text":"しかも、昔火山の中を探索するために、「談議室」が探検隊を組んだこともあるんだぜ！へへ、おれも大きくなったら絶対遊びに行くんだ！","nextNodeIds":[751420531]},{"nodeId":751420531,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3578298266,"text":"もう、危ないって何回言ったらわかるの…","nextNodeIds":[751420532]},{"nodeId":751420532,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3126358394,"text":"うーん…わたしも詳しくは知らないんですけど、よかったら<color=#00E1FFFF>エンポゾお爺ちゃん</color>に聞いてみてください。きっと喜んで助けてくれると思います。","nextNodeIds":[751420533]},{"nodeId":751420533,"roleType":"TALK_ROLE_NPC","speakerId":21765,"speakerName":"トゥゼー","textMapHash":3701609994,"text":"暇そうにぶらぶらしてるエンポゾ爺ちゃんか…？それより<color=#00E1FFFF>キモシー</color>に聞いた方が早いぜ。へへっ、キモシーはおれのおじさんなんだ。昔探検隊のメンバーだったんだぞ。","nextNodeIds":[751420534]},{"nodeId":751420534,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3061205378,"text":"エンポゾお爺ちゃんは暇でぶらぶらしてるわけじゃないの。うーん、片方は<color=#00E1FFFF>山の南側にある採掘現場</color>、もう片方は<color=#00E1FFFF>村の西側にあるテフラ遺跡</color>にいます…ただ…","nextNodeIds":[751420535]},{"nodeId":751420535,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3169001186,"text":"案内してあげたいところなんですが、今は聖山様の活動期なので…わたしたちは一緒に行けないんです…","nextNodeIds":[751420536]},{"nodeId":751420536,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4092448290,"text":"大丈夫だ。いろいろ教えてくれただけで十分だぞ！","nextNodeIds":[751420537]},{"nodeId":751420537,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3770939442,"text":"#{REALNAME[ID(2)|SHOWHOST(true)]}！戻ってこーい！出発するぞ！","nextNodeIds":[751420538]},{"nodeId":751420538,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":1337070970,"text":"キュイ！","nextNodeIds":[751420539]},{"nodeId":751420539,"roleType":"TALK_ROLE_NPC","speakerId":21766,"speakerName":"トゥナイア","textMapHash":3515827450,"text":"えへへ、かわいいですね。しっぽに巻いてあるスカーフが素敵。聖山様が眠ったら、部族の外で一緒に遊びましょう！","nextNodeIds":[751420540]},{"nodeId":751420540,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3454462522,"text":"もちろん！今度は遊ぼうな！","nextNodeIds":[]}]},{"talkId":7514207,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7514201","1","