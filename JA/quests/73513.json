lkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351301,"initDialog":735130101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30343,30342],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351301","priority":5,"questId":73513,"showRandomTalkCount":0},"dialogs":[{"nodeId":735130101,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":838661434,"text":"…だ、か、ら、どうしてリベットまでオーダーメイドにする必要があるわけ？そんなことしたって性能がそれほど上がるはずないでしょうが！","nextNodeIds":[735130102]},{"nodeId":735130102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":4230168042,"text":"——リベット装甲ってのは妙論派のロマンだろ！","nextNodeIds":[735130103]},{"nodeId":735130103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3913606754,"text":"まさか…昨日からずっと争ってたの？","nextNodeIds":[735130104]},{"nodeId":735130104,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1499491258,"text":"ああ、来たんだね。そういうわけじゃないさ。実は経費の問題については、昨日すでに話し終わってるんだ。","nextNodeIds":[735130105]},{"nodeId":735130105,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":916515818,"text":"はぁっ…今は他の問題について話し合ってたの。だけどいつの間にか、また経費のことに戻っちゃってたみたい…","nextNodeIds":[735130106]},{"nodeId":735130106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1149992250,"text":"他の問題？","nextNodeIds":[735130107]},{"nodeId":735130107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3809678578,"text":"パーツを繋ぐための接続溝を、光が反射するほど磨き上げたのに、シュリヤのやつ、今度はなんと「計画を中止したい」ときた！","nextNodeIds":[735130108]},{"nodeId":735130108,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3739384762,"text":"中止じゃないわ！しばらく中断するだけ！","nextNodeIds":[735130109]},{"nodeId":735130109,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1292022738,"text":"環境パラメータが少し変なのよ。気付いてないの？このまま設置すれば、装置のチャージ効率は予想を遥かに下回ってしまう。","nextNodeIds":[735130110]},{"nodeId":735130110,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1446315498,"text":"このエリアにいったい何が起きているのかをまず解明して、すべての影響を与える要素を排除してから、計画通り組み立てましょう…","nextNodeIds":[735130111]},{"nodeId":735130111,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1869915914,"text":"理想化された環境と実際の環境が合わない、なんて状況はいくらでもある。そこまでいちいち気にする必要はないだろう。","nextNodeIds":[735130112]},{"nodeId":735130112,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3573436010,"text":"僕は設計図を作った時から許容範囲をちゃんと考慮に入れてるんだ。これしきの影響、なんてことない。","nextNodeIds":[735130113]},{"nodeId":735130113,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":183511674,"text":"だいたい、やってみて初めて、実際に問題のある部分を見出せるってこともあるんだから。","nextNodeIds":[735130114]},{"nodeId":735130114,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3712168946,"text":"——つまり、それがあのとき二号機の実験を強行して爆発に至った理由ってわけ？","nextNodeIds":[735130115]},{"nodeId":735130115,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":108758386,"text":"そ、それとこれとは話が違うだろ！あの時の僕はまだ許容量を残すことを意識していなかったから…","nextNodeIds":[735130116]},{"nodeId":735130116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3332238050,"text":"…もっと安全な実験方法はないの？","nextNodeIds":[735130117]},{"nodeId":735130117,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1785405706,"text":"そうだな…砲塔の発射機能を閉じて、そのチャージプロセスだけを模擬実験するとか？","nextNodeIds":[735130118]},{"nodeId":735130118,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1532136010,"text":"…ダメ。あなたを信用できないわ。やはりここは砲塔の点火モジュールごと外しましょう。私が保管しててあげる。その状態なら他のパーツをいくらでも入れていいわよ。","nextNodeIds":[735130119]},{"nodeId":735130119,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1351158226,"text":"点火モジュールを外すだって？——そしたらこの「対ウェネト殺蟲大砲」がただの形だけのものになってしまうじゃないか！","nextNodeIds":[735130120]},{"nodeId":735130120,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3141359466,"text":"チャージ機能を実験するだけって言ったでしょ？あなた、やっぱり発射する気だったのね！","nextNodeIds":[735130121]},{"nodeId":735130121,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":622597954,"text":"ッ…その…","nextNodeIds":[735130122,735130123]},{"nodeId":735130122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1716359570,"text":"じゃあ、まずは発射機能を閉じよう。","nextNodeIds":[735130124]},{"nodeId":735130124,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":89659178,"text":"はぁ…組み立てテストのつもりでやろう。","nextNodeIds":[735130125]},{"nodeId":735130125,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":3003374154,"text":"もっと早くこうするべきだったのよ…設置の途中にたくさんの魔物が引き付けられてくるでしょうから、その時は頼むわよ、冒険者さん。","nextNodeIds":[]},{"nodeId":735130123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3022181882,"text":"とりあえず、まずは形だけでも作ろう。","nextNodeIds":[735130124]}]}],"conditions":{"finis