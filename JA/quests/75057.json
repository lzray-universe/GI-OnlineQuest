E_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":273081090,"text":"おいおい、ひどいこと言うなよ。","nextNodeIds":[750013206]},{"nodeId":750013206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":370061770,"text":"#どうだ！言っただろ？{NICKNAME}はすごいって！","nextNodeIds":[750013207]},{"nodeId":750013207,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3954406522,"text":"キュイッ！","nextNodeIds":[750013208]},{"nodeId":750013208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1515450778,"text":"#へへっ、{REALNAME[ID(2)|SHOWHOST(true)]}もすごいって思っただろ？","nextNodeIds":[750013209]},{"nodeId":750013209,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":336818538,"text":"#{NICKNAME}、素晴らしき異邦の勇士よ。君はアビスの影響を受けていないな？","nextNodeIds":[750013210,750013211]},{"nodeId":750013210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3891678098,"text":"平気だよ、アビスなんて…","nextNodeIds":[750013212]},{"nodeId":750013212,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":47746706,"text":"#部族で最強とうたわれる勇士ですら、アビスと対峙する際は十二分に気を引き締める必要があるというのに…やはり{NICKNAME}はただ者ではないな。","nextNodeIds":[750013213]},{"nodeId":750013213,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1950289850,"text":"今回のことを題材に執筆すれば、サンハジが記録した物語よりも素晴らしいものができあがるだろうな。","nextNodeIds":[750013214]},{"nodeId":750013214,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":374761546,"text":"キュウ…？","nextNodeIds":[750013215]},{"nodeId":750013215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1223461146,"text":"サンハジが誰なのかわからないけど、すごい人なのか？","nextNodeIds":[750013216]},{"nodeId":750013216,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1845816618,"text":"はは！すべての「部族の語り部」にとって、謎煙の主のサンハジは尊敬に値する人物だ…","nextNodeIds":[750013217]},{"nodeId":750013217,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":199741338,"text":"だが今は差し迫った状況だ。こんど時間ができたらサンハジの物語を教えてやろう！","nextNodeIds":[750013218]},{"nodeId":750013218,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":375017802,"text":"よし。では次の浮上した「陰縫いの針」のもとへ向かおう。急ぎ問題を解決すれば、今夜にも執筆に取りかかれる！","nextNodeIds":[750013219]},{"nodeId":750013219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":178062026,"text":"出発だ！","nextNodeIds":[750013220]},{"nodeId":750013220,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":633529314,"text":"キュイッ！","nextNodeIds":[]},{"nodeId":750013211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3838175554,"text":"今のところはなんとも。","nextNodeIds":[750013212]}]},{"talkId":7505704,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7505702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7500107","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7505704,"initDialog":750010801,"nextRandomTalks":[],"nextTalks":[],"npcId":[],"performCfg":"","priority":5,"questId":75057,"showRandomTalkCount":0},"dialogs":[{"nodeId":750010801,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":4049480306,"text":"ふむ、恐ろしい物音が聞こえたから少々様子を見に来てみれば…","nextNodeIds":[750010802]},{"nodeId":750010802,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3882787258,"text":"「余計な事を考えるなティトゥ、大したことない」…ここへ来るまで自分にそう言い聞かせていたというのに、実際にはこれほど大変なことが起こっていたとはな！","nextNodeIds":[750010803]},{"nodeId":750010803,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":4223399330,"text":"キュイッ！","nextNodeIds":[750010804]},{"nodeId":750010804,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2065495922,"text":"こんなところに小さなテペトル竜が…君がこの二人の異邦人をここへ導いたのか？","nextNodeIds":[750010805]},{"nodeId":750010805,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1859955674,"text":"それに、この「陰縫いの針」は…まさか君たちが地面へ押し込んだのか？","nextNodeIds":[750010806,750010809]},{"nodeId":750010806,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2487428954,"text":"もしかして…穴を開けちゃいけなかった？","nextNodeIds":[750010807]},{"nodeId":750010807,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3158071626,"text":"#え？なぁ{NICKNAME}、オイラたちまずいことしちゃったんじゃ…なら目撃者が一人しかいない今のうちに…","nextNodeIds":[750010808]},{"nodeId":750010808,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":624416114,"text":"#ははっ、怖いことを言ってくれるな。それはさほど深刻な問題ではないし、むしろ助かったくらいだ。ところで、そこの{M#少年}{F#少女}が{NICKNAME}なのはわかったが、君はなんという名前だ？","nextNodeIds":[750010813]},{"nodeId":750010813,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3059334498,"text":"キュイッ！","nextNodeIds":[750010814]},{"nodeId":750010814,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2164683186,"text":"#この子は{REALNAME[ID(2)|SHOWHOST(true)]}。","nextNodeIds":[750010815]},{"nodeId":750010815,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3857691746,"text":"うむ、私の名はティトゥ、部族で物語を伝{RUBY#[S]語り部}える者だ。そして谷間にあるこの石柱たちを「見守って」いる存在でもある。","nextNodeIds":[750010816]},{"nodeId":750010816,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1770757434,"text":"君たちが穴を開けたこの石柱は、三本ある小さな「陰縫いの針」のうちの一本で、私の監視対象なのだ。","nextNodeIds":[750010817]},{"nodeId":750010817,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3513134346,"text":"か、監視…やっぱりオイラたちがあの石柱とかいうのをいじると、ナタの人たちが損害賠償を求めてくるんだな。","nextNodeIds":[750010818]},{"nodeId":750010818,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1619964186,"text":"うう…そうだって知ってたら本名を明かさなかったのに。","nextNodeIds":[750010819]},{"nodeId":750010819,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1829845426,"text":"賠償か…「ティトゥは、このような方法で目の前の人物を脅迫すれば、目的を達成できるかもしれないと思いついた…」","nextNodeIds":[750010820]},{"nodeId":750010820,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1448572642,"text":"そういう展開だとすれば、このような描写を挟むべきだな…","nextNodeIds":[750010821]},{"nodeId":750010821,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3794141450,"text":"キュ…？","nextNodeIds":[750010822]},{"nodeId":750010822,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2621524610,"text":"ああ、すまない。つい物語のことを考えていた。私は部族で昔話を{RUBY#[D]語り部}伝えるのを任されていて、何年も物語を語り続けてきたのだよ。しかし最近は、自分で新しい物語を考える必要が出てきてな。","nextNodeIds":[750010823]},{"nodeId":750010823,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3743147522,"text":"ここ数日、常にその事で悩んでいたところ「陰縫いの針」にも問題が生じてしまった。古い言葉にあるように、本当に人が不運だと竜も不運になるのだな。","nextNodeIds":[750010824]},{"nodeId":750010824,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2927875770,"text":"コホン…別に君たちを脅迫するつもりなどない。もし本当にそのつもりなら、頭の中で考えているフレーズをわざわざ口に出したりしないだろう？","nextNodeIds":[750010825]},{"nodeId":750010825,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3160100730,"text":"この状況を見てくれ。互いに名乗り合っても揉め事は起きていない。つまり私たちはすでに友人同士ということではないか。","nextNodeIds":[750010826]},{"nodeId":750010826,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":448308002,"text":"それで、その友人の頼みを少しばかり聞いてもらえないか。","nextNodeIds":[750010827]},{"nodeId":750010827,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4082577274,"text":"ば…賠償を求められるんじゃなければ。","nextNodeIds":[750010828]},{"nodeId":750010828,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3707325186,"text":"もちろんそのようなことはしない。どこから話すべきか…そうだな、君たちは谷を通り抜けるとき、金色の模様が刻まれた巨大な固体燃素の塊を見なかったか？","nextNodeIds":[750010829]},{"nodeId":750010829,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1832557250,"text":"このエリアの中心にあるから、見逃すことはないと思うが。","nextNodeIds":[750010830,750010831]},{"nodeId":750010830,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4008633122,"text":"あるような…","nextNodeIds":[750010833]},{"nodeId":750010833,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2528275610,"text":"私が言わんとしていたのは、その大石柱に関係することだ…あの大石柱は部族の人々に「陰縫いの針」と呼ばれているのだが、最近いくつか問題が生じていてな。","nextNodeIds":[750010834]},{"nodeId":750010834,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2472837338,"text":"正直なところ君たちに会う前は、大石柱のことはもう諦めようと思っていたのだ。「『陰縫いの針』の問題が解決できなかったら、災難で部族が滅ぶ物語を書いても構わないのだから…」と自分自身に言い聞かせていたよ。","nextNodeIds":[750010835]},{"nodeId":750010835,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1960865594,"text":"待てよ…ただの石柱がどうして部族が滅びるのと関係があるんだ…","nextNodeIds":[750010836]},{"nodeId":750010836,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":166834210,"text":"それにさっきから言ってる「陰縫いの針」や、オイラたちが穴を開けた小さな「陰縫いの針」って、どっちも大石柱のことだよな。なんでそんな呼び方をしてるんだ？","nextNodeIds":[750010837]},{"nodeId":750010837,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3876724722,"text":"キュ…？","nextNodeIds":[750010838]},{"nodeId":750010838,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":52848490,"text":"#ああ、{NICKNAME}とパイモンは異邦人だから、もっと詳しく説明しなければならないな。これは部族に伝わる伝説に関係しているのだ。","nextNodeIds":[750010839]},{"nodeId":750010839,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1490394674,"text":"物語によると、大霊が「陰縫いの針」をここに吊るしたのは火山大王の陰を縫い付けるためだという…","nextNodeIds":[750010840]},{"nodeId":750010840,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":186332658,"text":"しかし真の歴史はこうだ。「あの柱の下にはこの地のアビスが封印されている」。","nextNodeIds":[750010841]},{"nodeId":750010841,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":274510226,"text":"ナタの物語はほとんどがそうだ。警告のために語られ、レトリックとメタファーで装飾されている。","nextNodeIds":[750010842]},{"nodeId":750010842,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1065409562,"text":"待てよ！下にいるのは封印されたアビスだって！？","nextNodeIds":[750010843]},{"nodeId":750010843,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2421282698,"text":"そうだ。そして最近、三本の小さな「陰縫いの針」のうち二本が浮上した。もし三本目の柱も浮き上がれば、底にある不吉なものが潮のように押し寄せてくるかもしれない。","nextNodeIds":[750010844]},{"nodeId":750010844,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3469369106,"text":"だから予想外に、君たちがその一本を押し込んだのを見て喜んだのだ。もちろん君たちに賠償を求めるつもりなどない。","nextNodeIds":[750010845]},{"nodeId":750010845,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":3392557850,"text":"その代わりと言ってはなんだが、もう一本の小さな「陰縫いの針」も押し込んではくれないだろうか？","nextNodeIds":[750010846]},{"nodeId":750010846,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2010593098,"text":"#うーん…どうする、{NICKNAME}…？","nextNodeIds":[750010847,750010848]},{"nodeId":750010847,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4223440458,"text":"…アビスのことなら、放っておけない。","nextNodeIds":[750010849]},{"nodeId":750010849,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3864025586,"text":"キュイッ！","nextNodeIds":[750010850]},{"nodeId":750010850,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3002387426,"text":"#わかった。{REALNAME[ID(2)|SHOWHOST(true)]}も賛成してるみたいだしな。","nextNodeIds":[750010851]},{"nodeId":750010851,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":1165659114,"text":"おお…暗闇が支配する時に必ず火の光が現れるように、危機には必ず素晴らしい英雄が立ち上がるんだな、ははっ。人類の可能性とは、こういう時にこそ非常に輝く。","nextNodeIds":[750010852]},{"nodeId":750010852,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":236780842,"text":"#これも素晴らしい物語の題材になるかもしれんな。{NICKNAME}、君は物語の中の英雄でも持ち合わせていない気質を備えているようだ。期待しているぞ。","nextNodeIds":[750010853]},{"nodeId":750010853,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2307150434,"text":"では行こう、英雄たちよ。浮上した「陰縫いの針」を確かめるために。","nextNodeIds":[]},{"nodeId":750010848,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3415125148,"text":"#{M#俺}{F#私}たちにできる事があるんじゃ？","nextNodeIds":[750010849]},{"nodeId":750010831,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3217435202,"text":"特に覚えていない…","nextNodeIds":[750010832]},{"nodeId":750010832,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":2150591170,"text":"そうか？あれはかなり目立つと思っていたが…まぁいいだろう。","nextNodeIds":[750010833]},{"nodeId":750010809,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3076903066,"text":"#パイモンが主犯。{M#俺}{F#私}は従っただけ…","nextNodeIds":[750010810]},{"nodeId":750010810,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2146362362,"text":"うわっ！いつもそういうこと言うよな。さすがのオイラも怒るぞ！","nextNodeIds":[750010811]},{"nodeId":750010811,"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","textMapHash":4174625714,"text":"#ははっ、そんなに緊張しないでくれたまえ。むしろ安心したよ。ところで、そこの小さなお嬢さんはパイモンと言うのだな。こちらの{M#少年}{F#少女}の名前は？","nextNodeIds":[750010812]},{"nodeId":750010812,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2534202170,"text":"#{NICKNAME}だよ。","nextNodeIds":[750010813]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7505702,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7505703,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7505704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7500101","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7505701,7505702,7505704],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":6131,"speakerName":"ティトゥ","count":39},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count