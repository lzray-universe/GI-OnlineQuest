e":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7327901,"initDialog":732790101,"nextRandomTalks":[],"nextTalks":[],"npcId":[4292,20846],"performCfg":"QuestDialogue/WQ/Sumeru_73279/Q7327901","priority":5,"questId":73279,"showRandomTalkCount":0},"dialogs":[{"nodeId":732790101,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":535075714,"text":"おお、旅人。尊き「ジンニーの主」、よく来てくれた。歓迎しよう。","nextNodeIds":[732790102]},{"nodeId":732790102,"roleType":"TALK_ROLE_NPC","speakerId":20846,"speakerName":"リルパァール","textMapHash":162020890,"text":"はぁ、砂漠の奴隷がまた一人、めでたいことですわ。我が主よ…まあ、構いません。あなたにはご自身の考えがあるのでしょうから、お任せしますわ。","nextNodeIds":[732790103]},{"nodeId":732790103,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":3763021866,"text":"時間があったら、一度私のところに来てくれないか…明月と雨露を渇望するかのように、君の来訪を待ちわびていよう。","nextNodeIds":[732790104]},{"nodeId":732790104,"roleType":"TALK_ROLE_NPC","speakerId":20846,"speakerName":"リルパァール","textMapHash":4215184698,"text":"そんなにへりくだった言い方だと、裏があると思われる。はっきり言ったほうがいいと思うけれど。","nextNodeIds":[732790105]},{"nodeId":732790105,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":240728114,"text":"そ…そうか。ジンニーの主よ…確かに君に頼みがあるんだ。","nextNodeIds":[732790106]},{"nodeId":732790106,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":2716187474,"text":"ははっ、大したことじゃないんだが…私の猟鷹「タッドラー」が…どうも危険な状況にあるみたいでね。","nextNodeIds":[732790107]},{"nodeId":732790107,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":3694057626,"text":"まったく…私の足腰がしっかりしていれば、君に頼むこともなかったんだが。","nextNodeIds":[732790108]},{"nodeId":732790108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3517998298,"text":"なるほど。つまり、オイラたちがそいつを助けに行ったら、そのお礼にモラをたくさんくれて、それからお祝いにたらふくごちそうを振る舞ってくれる、ってことだろ！な？","nextNodeIds":[732790109]},{"nodeId":732790109,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":2303532858,"text":"えっ…そ、そうだ。","nextNodeIds":[732790110]},{"nodeId":732790110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1480201506,"text":"そういうことなら、オイラたちに任せとけ！","nextNodeIds":[732790111]},{"nodeId":732790111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3445006490,"text":"こういうときは、頭が冴えてるよね…","nextNodeIds":[732790112]},{"nodeId":732790112,"roleType":"TALK_ROLE_NPC","speakerId":20846,"speakerName":"リルパァール","textMapHash":1899238122,"text":"はぁ…では、この欲張りのおチビちゃんをお腹いっぱい食べさせるために、そうしましょう。","nextNodeIds":[732790113]},{"nodeId":732790113,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":3084094114,"text":"ありがとう…それじゃあ、頼んだよ。","nextNodeIds":[732790114]},{"nodeId":732790114,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":2733663874,"text":"ああ…それとタッドラーが最後にいた場所はここだ。印をつけてあげよう…","nextNodeIds":[732790115]},{"nodeId":732790115,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":1975169090,"text":"君たちに探してもらいたい人の名前はタッドラー…彼女は背が高く、肌が黒くて、淡い色の長髪で、長弓を携えている…えーと、これくらい情報があれば十分だろう。","nextNodeIds":[732790116]},{"nodeId":732790116,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":3061313570,"text":"どう、覚えられそうかい？","nextNodeIds":[732790117]},{"nodeId":732790117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1043345018,"text":"おう…背が高くて、肌の黒い女性。淡い色をした長髪で、長弓を持ってるんだな！へへっ、記憶力には自信があるんだ！","nextNodeIds":[732790118]},{"nodeId":732790118,"roleType":"TALK_ROLE_NPC","speakerId":4292,"speakerName":"マシーラ","textMapHash":2096567338,"text":"ああ…黄砂と数々の困難を乗り越えられるよう、君たちを導く風があらんことを願おう。","nextNodeIds":[732790119]},{"nodeI