NE"},"isHidden":false,"talkIds":[7304801],"talks":[{"talkId":7304801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7304801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7304801,"initDialog":730480101,"nextRandomTalks":[],"nextTalks":[],"npcId":[20711,1005],"performCfg":"QuestDialogue/WQ/Sumeru_73048/Q7304801","priority":5,"questId":73048,"showRandomTalkCount":0},"dialogs":[{"nodeId":730480101,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":3913011754,"text":"なんと懐かしい。前回このような光景を見たのは、数百年前になるか…この目で再びヴァナラーナの夢郷を見られたのも、キミたちのおかげだ。","nextNodeIds":[730480102]},{"nodeId":730480102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1514354002,"text":"わぁ！おまえってずいぶん長生きなんだな…","nextNodeIds":[730480103,730480104]},{"nodeId":730480103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":335842642,"text":"アランナラが「年」って言うのを初めて聞いた…","nextNodeIds":[730480105]},{"nodeId":730480105,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":3729580002,"text":"そうだろうか？それはワタシが多くの記憶と知識を吸収したからかもしれない。夢郷の中のヴァナラーナには昼も夜もなく、すべてが平穏だ。","nextNodeIds":[730480106]},{"nodeId":730480106,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":744127386,"text":"その上、ワタシたちの寿命は長い。ゆえに、ワタシたちは「時間」の概念が希薄なんだ。ワタシたちは樹木の成長、花の盛り、月の昇り降りで時間の流れを測る。","nextNodeIds":[730480107]},{"nodeId":730480107,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":2166896386,"text":"ウツァヴ祭を行う以上、ビージャの実が必要なのだろう？","nextNodeIds":[730480108]},{"nodeId":730480108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3729868194,"text":"うん…そういえば、ビージャの実って一体なんなんだ？前にアランラジャとアランマも、あまり教えてくれなかったけど。","nextNodeIds":[730480109]},{"nodeId":730480109,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":2026273322,"text":"#キミたちはすでにアランナラの友達だ。ならば、アランラカラリの原理は聞いたことがあるだろう。ナラ{NICKNAME}、パイモン、分かるかい？","nextNodeIds":[730480110]},{"nodeId":730480110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":920756170,"text":"アランラナは記憶の力だって…","nextNodeIds":[730480111]},{"nodeId":730480111,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":1555131522,"text":"アランラナ？懐かしい、元気だろうか。アイツは少しそそっかしいが、きっとキミを友達と思ったから教えたのだろう。","nextNodeIds":[730480112]},{"nodeId":730480112,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":1261269058,"text":"ビージャの実は記憶と夢を抽出して実る果実、ワタシたちアランナラにとって、もっとも貴重なものの結晶だ。果実とは言うが、希望の種でもある。","nextNodeIds":[730480113]},{"nodeId":730480113,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":3227826698,"text":"誰かを助けたいという願いだけを、ビージャの実は叶えることができる。キミたちと今回ビージャの実を求めるアランナラには、誰かを助けたいという願いがあるのだろう？","nextNodeIds":[730480114,730480115]},{"nodeId":730480114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2097839330,"text":"ラナを助けたい。","nextNodeIds":[730480116]},{"nodeId":730480116,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":1019634674,"text":"#うん、ならば問題ない。ナラ{NICKNAME}がアランナラの友達ならば、これを受け取ってくれ。","nextNodeIds":[730480117,730480118]},{"nodeId":730480117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4237346314,"text":"これは…","nextNodeIds":[730480119]},{"nodeId":730480119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":188674946,"text":"小さな花…この前、アランラナやアランナキンたちも花をくれたっけ…","nextNodeIds":[730480120]},{"nodeId":730480120,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":2821447930,"text":"そうだったか。長い時が経ったが、この習慣は変わっていないようでよかった。","nextNodeIds":[730480121]},{"nodeId":730480121,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":4148218394,"text":"#以前、ワタシはアランラジャ、アランジ…そしてアランパカティたちと一緒に、ナラヴァルナに花を贈ったことがある。{M#カノジョ}{F#カレ}はワタシたちの大事な友達だった。","nextNodeIds":[730480122]},{"nodeId":730480122,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":3424702314,"text":"この花はアランナラの友情の証。そしてこの花を受け取った者は、アランナラとの友情を認めたことになる。","nextNodeIds":[730480123]},{"nodeId":730480123,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":2252386898,"text":"ワタシたちアランナラは口下手だ。ゆえにワタシたちにとって、ヒト類の友達が花を受け取ってくれることは、とても誇るべきことだ。","nextNodeIds":[730480124]},{"nodeId":730480124,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":283783754,"text":"#多くのナラ{NICKNAME}の物語を聞いたが、キミもワタシの大切な友達だと言える。キミがワタシの花を受け取ってくれるのは光栄なことだ。ありがとう。","nextNodeIds":[730480125,730480126]},{"nodeId":730480125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1523939554,"text":"どういたしまして。","nextNodeIds":[730480127]},{"nodeId":730480127,"roleType":"TALK_ROLE_NPC","speakerId":20711,"speakerName":"アランムフクンダ","textMapHash":559864170,"text":"#必ずまた会おう。その時はナラ{NICKNAME}、パイモン、ワタシの家に来てほしい。","nextNodeIds":[730480128]},{"nodeId":730480128,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2054808690,"text":"あ、消えた…","nextNodeIds":[730480129]},{"nodeId":730480129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3694610338,"text":"なんか変わったアランナラだったな！まあいいや、他のアランナラにも会いに行こうぜ！","nextNodeIds":[]},{"nodeId":730480126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1102223802,"text":"こちらこそありがとう。","nextNodeIds":[730480127]},{"nodeId":730480118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":276557618,"text":"ありがたく受け取るよ。","nextNodeIds":[730480119]},{"nodeId":730480115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4060831594,"text":"アランラナは友達を助けようとしてる。","nextNodeIds":[730480116]},{"nodeId":730480104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2876224378,"text":"他のアランナラとは時間の概念が違う…","nextNodeIds":[730480105]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7304801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}]