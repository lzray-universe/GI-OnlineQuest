m":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7303803,"initDialog":730380301,"nextRandomTalks":[],"nextTalks":[],"npcId":[4198,1005,20647],"performCfg":"QuestDialogue/WQ/Sumeru_73038/Q7303803","priority":5,"questId":73038,"showRandomTalkCount":0},"dialogs":[{"nodeId":730380301,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":3676579778,"text":"うーん…","nextNodeIds":[730380302]},{"nodeId":730380302,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3618720050,"text":"意識が戻った…？","nextNodeIds":[730380303,730380304]},{"nodeId":730380303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2992451858,"text":"聞こえる？","nextNodeIds":[730380305]},{"nodeId":730380305,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2328188586,"text":"#あれ？私、また寝ちゃったんですね…ここは？{NICKNAME}、パイモン、無事でよかった！死域にやられてないか心配してたんですよ。それに…","nextNodeIds":[730380306]},{"nodeId":730380306,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2475094674,"text":"アランラナ？アランラナだよね…","nextNodeIds":[730380307]},{"nodeId":730380307,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":2643587066,"text":"やあ、ナラの友達。","nextNodeIds":[730380308]},{"nodeId":730380308,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1249262210,"text":"ずっとずっと待ってたんだよ…ずっとずっと、あなたに会う日を夢見てた…","nextNodeIds":[730380309]},{"nodeId":730380309,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":3840464338,"text":"森で迷子になった夢を見たの。家の方角もパパやママの居場所も分からなくて泣き続ける私の声を聞いて、あなたが来てくれた。そして歌を聞かせてくれた…","nextNodeIds":[730380310]},{"nodeId":730380310,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":771951530,"text":"それで私たちは親友になった。私はしょっちゅう森に来てはあなたと遊んだ。あなたは私に花をくれて、いろんなこと、たくさんの森の秘密を教えてくれた。","nextNodeIds":[730380311]},{"nodeId":730380311,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":891912970,"text":"星茸はお星さまが地上に落とした影だよとか、サウマラタ蓮が咲くのを見たら…","nextNodeIds":[730380312]},{"nodeId":730380312,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":4136045234,"text":"サウマラタ蓮が咲くのを見たら、次に月が昇るまで幸運が続く。","nextNodeIds":[730380313]},{"nodeId":730380313,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1472504522,"text":"そう、それ！それから…","nextNodeIds":[730380314]},{"nodeId":730380314,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":4256682818,"text":"私はヴィマラ村のみんなのために、早く大人になって頼りがいのあるレンジャー長になりたいと夢見た。でも頼りがいのある大人は、森の精霊の童話を信じない。","nextNodeIds":[730380315]},{"nodeId":730380315,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1646276594,"text":"私はあなたを忘れる夢を見た。アランナラの物語は、イッサムたちが信じてる子供のおとぎ話だと思い込んだの。森は木が生い茂るだけの場所、魔法なんかないって…","nextNodeIds":[730380316]},{"nodeId":730380316,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2598975194,"text":"さっき目覚めた時、あなたを忘れてたらどうしようと思ってすごく怖かった…でもそれはただの夢だった！またあなたに会えて、ほんとによかった！","nextNodeIds":[730380317]},{"nodeId":730380317,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":3739307010,"text":"アランラナ、どこ行ってたの！ずっと待ってたんだよ、あなたが森に連れてってくれるのを…あなたと一緒にいる時にしか見えない、謎めいた秘密の森に行きたかったんだから…","nextNodeIds":[730380318]},{"nodeId":730380318,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":3966808178,"text":"ごめん。アランラナはもう忘れてしまった。","nextNodeIds":[730380319]},{"nodeId":730380319,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1006100746,"text":"えっ…？","nextNodeIds":[730380320]},{"nodeId":730380320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3048252418,"text":"えっと…ラナ、アランラナを責めないであげてくれ。実はさ…","nextNodeIds":[730380321]},{"nodeId":730380321,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":450768842,"text":"「…おまえを捜してる時に、アランラナに遭遇したんだ。」とアランラナに説明した…","nextNodeIds":[730380322]},{"nodeId":730380322,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":365955666,"text":"マウティーマ稠林の菌、雨の果ての戦闘。遺跡巨像の内部、薔薇の小曲。兄妹を演じるアランナラ、愉快なウツァヴ祭の光景…\\nアランナラと過ごした日々の物語を、ゆっくりラナとアランラナに語って聞かせた。","nextNodeIds":[730380323]},{"nodeId":730380323,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2784374690,"text":"忘れてたのは、私の方だったんですね…","nextNodeIds":[730380324]},{"nodeId":730380324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4196641058,"text":"ビージャの実は記憶が凝縮してできたもの…二人で遊んだ記憶はアランラナにとってすごく大切なものだったんだろう。だから治療の途中で、昔の思い出がよみがえったんだ…","nextNodeIds":[730380325]},{"nodeId":730380325,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2357083922,"text":"#{NICKNAME}、パイモン…ありがとうございます。私のせいで、大変な思いをさせてしまいましたね…","nextNodeIds":[730380326,730380328]},{"nodeId":730380326,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1409761146,"text":"ううん、色々得るものも多かった。","nextNodeIds":[730380327]},{"nodeId":730380327,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3499888594,"text":"ああ、そうだな！それに感謝するなら、アランラナやアランマにしてくれ！","nextNodeIds":[730380329]},{"nodeId":730380329,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":414283130,"text":"ありがとう…ごめんね、アランラナ…","nextNodeIds":[730380330]},{"nodeId":730380330,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":669120562,"text":"ううっ…私、あなたのこと忘れちゃってた…私のこと、嫌いになったよね…","nextNodeIds":[730380331]},{"nodeId":730380331,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":1445839778,"text":"分からない。アランラナはもう忘れた。","nextNodeIds":[730380332]},{"nodeId":730380332,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":102144338,"text":"でも、いいんだ。覚えてた頃のアランラナが、記憶を捨てることを選んだ。今のアランラナは分かった。キミは一番大事なナラ、思い出よりずっと大事。","nextNodeIds":[730380333]},{"nodeId":730380333,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1413588322,"text":"えっと…こんな風に言うと、アランラナに失礼かもしれないけど…","nextNodeIds":[730380334]},{"nodeId":730380334,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1090772226,"text":"#アランラジャたちが言ってた。アランナラはすごく長生きだって。だからまだまだこれから、いっぱい楽しい思い出が作れると思う。オイラと{NICKNAME}みたいにさ！","nextNodeIds":[730380335]},{"nodeId":730380335,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":583651242,"text":"ええ…私たちには、まだまだ時間があります。また一緒に森の大きさ、世界の広さ、未来の壮大さを知ることができます。","nextNodeIds":[730380336]},{"nodeId":730380336,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":3241041234,"text":"うん。","nextNodeIds":[730380337]},{"nodeId":730380337,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":346783466,"text":"#マラーナ…死域の問題は、私が眠っている間にほぼ解決してくださったんですね。{NICKNAME}、パイモン、それにたくさんのアランナラたち…本当にありがとうございます。","nextNodeIds":[730380338]},{"nodeId":730380338,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2837456458,"text":"ちょっとワガママですけど、アランラナと一緒に旅ができたらなぁ…なんて。でもヴィマラ村の子供たちがまた危険な目に遭ったらと思うと…","nextNodeIds":[730380339]},{"nodeId":730380339,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":849370370,"text":"忘れるとこだった。まだ悪党の問題が解決してないんだった…","nextNodeIds":[730380340]},{"nodeId":730380340,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2077925994,"text":"悪党の正体なら、目星がついてる。","nextNodeIds":[730380341]},{"nodeId":730380341,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2575165146,"text":"えっ、誰のことだ？う～ん、なんでオイラは知らないんだ…","nextNodeIds":[730380342]},{"nodeId":730380342,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":3575307746,"text":"で、誰なんですか？ここを出る前に、きっちり懲らしめてやらないと！","nextNodeIds":[730380343,730380344]},{"nodeId":730380343,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3066874546,"text":"任せて。","nextNodeIds":[730380345]},{"nodeId":730380345,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2807947298,"text":"分かりました…","nextNodeIds":[730380346]},{"nodeId":730380346,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2874098378,"text":"#私、{NICKNAME}を信じます。","nextNodeIds":[730380347]},{"nodeId":730380347,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1120352234,"text":"ただ、こんな風に言うのも変ですけど…その悪党がもたらしたのって、悪いことばかりじゃないんです。子供たちが迷子にならなかったら、私も森のパトロールを増やしたりしなかったですし——","nextNodeIds":[730380348]},{"nodeId":730380348,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2908882618,"text":"パトロールを増やさなかったら、あの時あの場所でキノコンに遭うこともなかった。あなたとパイモンはまっすぐで優しくて、困ってる人を放っておけないタイプだから…","nextNodeIds":[730380349]},{"nodeId":730380349,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1338146210,"text":"#だから、私は{NICKNAME}やパイモンと知り合えた。色々手伝ってもらって、助けてもらった上に、大事な友達にまで再会させてくれた…","nextNodeIds":[730380350]},{"nodeId":730380350,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2333899594,"text":"#ありがとう、{NICKNAME}。ありがとう、パイモン。","nextNodeIds":[730380351]},{"nodeId":730380351,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2051994762,"text":"いいってことよ！でも「ラナお姉さん」がいなくなったら、イッサムやカブス、スダッベが悲しむだろうな…","nextNodeIds":[730380352]},{"nodeId":730380352,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":4182561450,"text":"#あの子たちは本当は強い子なんですよ。それに{NICKNAME}{M#お兄さん}{F#お姉さん}とも知り合えましたし。私だってそのうち戻ってきますから！","nextNodeIds":[730380353]},{"nodeId":730380353,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2267993498,"text":"#そう、絶対に戻ってくる。そして、あの子たちにたくさんの物語を話して、アランラナをみんなに紹介します。前に{NICKNAME}を紹介したみたいに。","nextNodeIds":[730380354]},{"nodeId":730380354,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":161379178,"text":"そっか…ならよかった。もう戻らないつもりかと思って心配したぞ…","nextNodeIds":[730380355]},{"nodeId":730380355,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1153907610,"text":"アランラナ、私と一緒に旅してくれる？","nextNodeIds":[730380356]},{"nodeId":730380356,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":3135255802,"text":"アランラナもそうしたい。","nextNodeIds":[730380357]},{"nodeId":730380357,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":1090762186,"text":"あなたは私のために、いろんなことを忘れた。でもパイモンの言う通り、私たちはまた一緒にたくさんの思い出を作って、あなたの心に空いた穴を塞げる。","nextNodeIds":[730380358]},{"nodeId":730380358,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2642703210,"text":"私はラナ、友達になってくれる？","nextNodeIds":[730380359]},{"nodeId":730380359,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":2035515258,"text":"うん。ナララナ、今までも、これからもずっと友達。","nextNodeIds":[730380360]},{"nodeId":730380360,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":902778826,"text":"ん？これは…","nextNodeIds":[730380361]},{"nodeId":730380361,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":3164250706,"text":"ラナの胸から、心弾むような暖かく、細かくて明るい光が放たれる。\\n彼女は試しに手で遮ろうとしたが、光源はまるで意識があるかのように彼女の手に入り込んだ。\\n光がゆっくりと消えていった後、彼女の手に現れたのは、精緻な装飾品であった。","nextNodeIds":[730380362]},{"nodeId":730380362,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":701263154,"text":"神の目だ。","nextNodeIds":[730380363]},{"nodeId":730380363,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2587985858,"text":"こういう場面を直接に見るのって初めてだよな…","nextNodeIds":[730380364]},{"nodeId":730380364,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2299900586,"text":"神が私の願いを聞き届けてくださったんでしょうね…","nextNodeIds":[730380365]},{"nodeId":730380365,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":2057293858,"text":"#よし、これがあれば旅行中も安心ですね！死域の残党に遭遇しても、自分で解決できます。私の戦う姿が、{NICKNAME}みたいに恰好よければいいのですが。","nextNodeIds":[730380366]},{"nodeId":730380366,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":534113242,"text":"まだやることがいっぱい残ってますし、みんなにも挨拶しないと。それにティナリ先輩にも、旅行の件を伝えないといけません。","nextNodeIds":[730380367]},{"nodeId":730380367,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":381734498,"text":"#パイモン、アランラナ、ありがとう。{NICKNAME}、ありがとう。","nextNodeIds":[730380368]},{"nodeId":730380368,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":159782210,"text":"#ありがとう。金色のナラ{NICKNAME}、パイモン。アランラナは覚えてないけど、キミたちはきっといいナラだ。アランラナをナララナに引き合わせてくれて、嬉しかった。","nextNodeIds":[730380369,730380372]},{"nodeId":730380369,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1667443466,"text":"#{M#君}{F#あなた}たちに出会えてよかった。","nextNodeIds":[730380370,730380371]},{"nodeId":730380370,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1301699986,"text":"どうか気をつけて。","nextNodeIds":[730380373]},{"nodeId":730380373,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1088648970,"text":"ラナ、アランラナ…旅の無事を祈ってるぞ。あと、オイラたちのこと忘れるなよ！","nextNodeIds":[730380374]},{"nodeId":730380374,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":393878362,"text":"「吹き荒れる風に耐え、雪を振り払い、身を震わせるような寒さを乗り越え、茹だるような炎天下を歩む…」","nextNodeIds":[730380375]},{"nodeId":730380375,"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","textMapHash":3966543234,"text":"#昔、こんな詩を聞いたことがあります。次に会う時には、きっと今より強くなっていますから。{NICKNAME}、パイモン、絶対また会いましょうね！","nextNodeIds":[730380376]},{"nodeId":730380376,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":600839554,"text":"また必ず会おう！","nextNodeIds":[]},{"nodeId":730380371,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3041636530,"text":"旅でたくさんの収穫があるといいね。","nextNodeIds":[730380373]},{"nodeId":730380372,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1228651130,"text":"さようなら。","nextNodeIds":[730380373]},{"nodeId":730380344,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2927046674,"text":"まだ具体的な証拠はない…","nextNodeIds":[730380345]},{"nodeId":730380328,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2797048522,"text":"お礼なら、アランラナやアランマに言って。","nextNodeIds":[730380329]},{"nodeId":730380304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2925252098,"text":"もう大丈夫そう。","nextNodeIds":[730380305]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7303803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["3","133301592,2;133301593,2;133301594,2;133301595,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["101812","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7303801,7303802,7303803],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":4198,"speakerName":"ラナ","count":38},{"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","count":22},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":20},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":16},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","count":2},{"roleType":"TA