domTalkCount":0},"dialogs":[{"nodeId":730380101,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":2836983682,"text":"アシュヴァッタの樹…おかしい。アシュヴァッタの樹はここにはないはず。金色のナラ、白いふわふわ…アランラナは知らない。でもどこかで会った気もする。キミたちは誰？","nextNodeIds":[730380102]},{"nodeId":730380102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2658067698,"text":"アランラナ、ほんとに忘れちゃったんだ…","nextNodeIds":[730380103]},{"nodeId":730380103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2806723210,"text":"#オイラはパイモン、こいつは{NICKNAME}。","nextNodeIds":[730380104]},{"nodeId":730380104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1747515146,"text":"#{M#俺}{F#私}たちはアランラナの友達。","nextNodeIds":[730380105]},{"nodeId":730380105,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":2915555298,"text":"うん。アランラナはキミたちを信じる。キミたちからは善良な雰囲気を感じる…","nextNodeIds":[730380106]},{"nodeId":730380106,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":2776639026,"text":"アランラナは理解した。心に穴みたいなものがある。大事な記憶が逃げ出したんだ。でもアシュヴァッタの樹に会って、キミたちに会って、また色々分かった。","nextNodeIds":[730380107]},{"nodeId":730380107,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":669566090,"text":"さっき見たけど、キミたち「ビージャの実」を手に入れたね？友達を助けるため、アランラナはいろんなことを忘れた。それでアシュヴァッタの樹に実をつけてもらった。","nextNodeIds":[730380108]},{"nodeId":730380108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1860866002,"text":"アランラナは賢いな…「友達」のこと、まだ覚えてるか？","nextNodeIds":[730380109]},{"nodeId":730380109,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":1111992042,"text":"覚えてない。でもいい。キミたちはビージャの実を持ってる。それこそキミたちがアランラナの信じる友達であり、アシュヴァッタの樹が認めたナラである証拠。","nextNodeIds":[730380110]},{"nodeId":730380110,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":2586510442,"text":"お願い。ビージャの実をアランラナの助けたい友達に届けて。","nextNodeIds":[730380111,730380113]},{"nodeId":730380111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":493280050,"text":"分かった、任せて。","nextNodeIds":[730380112]},{"nodeId":730380112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":664260802,"text":"アランラナも一緒に行こう！友達も、きっとおまえに会いたがってるはずだ！","nextNodeIds":[730380114]},{"nodeId":730380114,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":1214197074,"text":"……","nextNodeIds":[730380115]},{"nodeId":730380115,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":3957530010,"text":"アランラナはやめておく。アランラナはもう忘れた。アランラナが自分を忘れたと知ったら、友達が悲しむ。アランラナは友達を大事にしないと思われる。","nextNodeIds":[730380116]},{"nodeId":730380116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3339907586,"text":"アランラナが助けようとしてる友達は、すごくいい人…いいナラだ。アランラナがそいつを忘れても、きっとまた友達になろうって言ってくれる。","nextNodeIds":[730380117]},{"nodeId":730380117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1820879042,"text":"だから一緒に行こう。な？","nextNodeIds":[730380118]},{"nodeId":730380118,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":3946986442,"text":"…うん。","nextNodeIds":[730380119]},{"nodeId":730380119,"roleType":"TALK_ROLE_NPC","speakerId":20647,"speakerName":"アランラナ","textMapHash":3956558290,"text":"分かった。アランラナはキミたちを信じる。キミたちは友達。","nextNodeIds":[]},{"nodeId":730380113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":184541298,"text":"一緒に行こう。","nextNodeIds":[730380114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7303801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","