:["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150102,"initDialog":715010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150102","priority":15,"questId":71501,"showRandomTalkCount":0},"dialogs":[{"nodeId":715010201,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1849449626,"text":"まさか、ここの環境がこんなにも特殊だとは…こうなると、「プルシナスパイク」のエネルギーシステムは…","nextNodeIds":[715010202]},{"nodeId":715010202,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2546270306,"text":"#ん？{NICKNAME}にパイモンじゃないか。実に久しぶりだ。なんで君たちが層岩巨淵に…？","nextNodeIds":[715010203]},{"nodeId":715010203,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3871004706,"text":"そういえばへディーヴから聞いたけど、層岩巨淵で探検隊を色々助けたんだって？","nextNodeIds":[715010204]},{"nodeId":715010204,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2838248098,"text":"でも今、層岩巨淵の環境は以前よりも悪化していて、危険に満ちている。あまり歩き回らないほうがいい。","nextNodeIds":[715010205]},{"nodeId":715010205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1982370162,"text":"#{M#君}{F#あなた}は？","nextNodeIds":[715010206]},{"nodeId":715010206,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4032829026,"text":"少し前に会ってるだろ？","nextNodeIds":[715010207]},{"nodeId":715010207,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4032018386,"text":"会うたび、確かに色々と迷惑をかけてはいるが…知らないふりをすることはないだろう。","nextNodeIds":[715010208]},{"nodeId":715010208,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":454930178,"text":"まぁいい、改めて自己紹介をするよ。私はスメール「教令院」の学者のホッセイニ。以前は、「エネルギー原盤」の研究をするため、稲妻へと考察しに行っていた。","nextNodeIds":[715010209]},{"nodeId":715010209,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2004434314,"text":"だが現在、研究経費を使い切ってしまってね。スメールに帰らざるを得ない状況になってる…","nextNodeIds":[715010210]},{"nodeId":715010210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3488482986,"text":"あっ、オイラ少しだけ覚えてるぞ…","nextNodeIds":[715010211]},{"nodeId":715010211,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3146996994,"text":"私のことを思い出してくれたかい？","nextNodeIds":[715010212]},{"nodeId":715010212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3249328770,"text":"おまえは——たしか「原盤マン」だよな！","nextNodeIds":[715010213]},{"nodeId":715010213,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1057883898,"text":"…いや、「原盤マン」でないことだけは断言できる…","nextNodeIds":[715010214]},{"nodeId":715010214,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1545813266,"text":"とにかく、スメールへ帰る道中、同じく「教令院」の学者であるへディーヴから依頼を受けた。彼には以前、研究経費のことで少し世話になっていてね…","nextNodeIds":[715010215]},{"nodeId":715010215,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1993151354,"text":"だから、彼の抱えている問題を解決するため、層岩巨淵まで来たんだ。","nextNodeIds":[715010216]},{"nodeId":715010216,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3601108930,"text":"こっちの説明はこれで十分かな。それで君たちは？なんでこの時期に層岩巨淵へ？","nextNodeIds":[715010217,715010218]},{"nodeId":715010217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2316248522,"text":"へディーヴの依頼を受けた…","nextNodeIds":[715010219]},{"nodeId":715010219,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":873450594,"text":"おお、君たちがそうだったのか。へディーヴが誰かに協力してもらおうと言った時、少し心配だったんだが…","nextNodeIds":[715010220]},{"nodeId":715010220,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4270355290,"text":"でも、君たちなら安心だ。","nextNodeIds":[715010221]},{"nodeId":715010221,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1725517210,"text":"もし今回、層岩巨淵に湧いている黒泥を解決するのが私一人だけだったら、かなり手間がかかっていただろう。君たちが協力してくれるなら、問題を解決できる確率も…少し高くなる。","nextNodeIds":[715010222]},{"nodeId":715010222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2503845362,"text":"どうすればいい？","nextNodeIds":[715010223]},{"nodeId":715010223,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2821250138,"text":"「プルシナスパイク」は知ってるかい？地脈を乱す力を放出できる機器だ。","nextNodeIds":[715010224]},{"nodeId":715010224,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3391406954,"text":"私の推測では、黒泥の湧き出るところに「プルシナスパイク」を配置すれば、地脈の活動が乱れ、黒泥を取り除くことができる。","nextNodeIds":[715010225]},{"nodeId":715010225,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":922094626,"text":"えっと、黒泥と地脈になんの関係があるんだ？","nextNodeIds":[715010226]},{"nodeId":715010226,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2806249386,"text":"あれらの黒泥は地脈の変動を受けてここに現れた。地脈と関係がある可能性は極めて高い…それが私とへディーヴが話し合って出した結論だ。","nextNodeIds":[715010227]},{"nodeId":715010227,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2331444290,"text":"だから、プルシナスパイクを使って乱すことにより、ここの地脈と外を繋ぐ出口を閉じれば、黒泥が湧き出るのを止めることができる。","nextNodeIds":[715010228]},{"nodeId":715010228,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2054199626,"text":"なるほど…","nextNodeIds":[715010229]},{"nodeId":715010229,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":918537722,"text":"しかし、今まではプルシナスパイクで「地脈を乱していた」だけ…「完全に封鎖する」のはこれが初の試みだ。","nextNodeIds":[715010230]},{"nodeId":715010230,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3494786394,"text":"私は計算をして、プルシナスパイクのパラメータを調整した。理論上では失敗しないはず。","nextNodeIds":[715010231]},{"nodeId":715010231,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1634684378,"text":"ただ理論はあくまで理論に過ぎない。実験を行ってそれを検証する必要がある。先ほど私は試運転をするつもりでいたんだが、実験にはリスクが付きものだから…","nextNodeIds":[715010232]},{"nodeId":715010232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":623770522,"text":"#{M#俺}{F#私}がやってみるよ…","nextNodeIds":[715010233]},{"nodeId":715010233,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3976561154,"text":"うん…それなら、君に任せたよ。","nextNodeIds":[715010234]},{"nodeId":715010234,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":201503762,"text":"私も隣で観測しよう。","nextNodeIds":[]},{"nodeId":715010218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3073638706,"text":"手伝いに来た…","nextNodeIds":[715010219]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["166001687","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7150103,"order":3,"stepDescription":"「プルシナスパイク」を起動する","stepDescTextMapHash":3379606260,"finishConds":[{"BFGALAINLMD":1,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_LUA_NOTIFY","PPFLKMOMKAI":"Q71501"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEB