e":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":true,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_OR","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_MAIN","id":2301752,"initDialog":230175001,"nextRandomTalks":[],"nextTalks":[],"npcId":[12700],"performCfg":"","priority":5,"questId":23017,"showRandomTalkCount":0},"dialogs":[{"nodeId":230175001,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":3542525690,"text":"あら？んー…何か聞きたいことでも？","nextNodeIds":[230175002]},{"nodeId":230175002,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":504762858,"text":"どうやってガルシアさんと知り合ったの？","nextNodeIds":[230175003]},{"nodeId":230175003,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":632265842,"text":"ずいぶんストレートね？それが冒険者のスタイルかしら。","nextNodeIds":[230175004]},{"nodeId":230175004,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":794943978,"text":"ガルシアと知り合ったのは…私の劇団の団長が、彼を帳簿整理に雇ったからよ。","nextNodeIds":[230175005]},{"nodeId":230175005,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":4049889586,"text":"アハハ…正直、あんなに劇団の雰囲気に合わない人、初めて見たわ。","nextNodeIds":[230175006]},{"nodeId":230175006,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":3640082970,"text":"私たちが演奏して、踊って、お酒を飲んで、歌を歌ってる間、彼と路通は端っこで黙々と計算をしてるわけ。","nextNodeIds":[230175007]},{"nodeId":230175007,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":2780729594,"text":"ある日、彼が変な服を着ていることに気づいたの。その服には何かの図案が描いてあるみたいだったわ。","nextNodeIds":[230175008]},{"nodeId":230175008,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":2439047890,"text":"興味があったから、何の図案か聞いてみたの。そしたら彼、これは機械の設計図だっていうのね。","nextNodeIds":[230175009]},{"nodeId":230175009,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":3044283690,"text":"服に描いたのは、外でその機械について議論していた時、紙とペンが見つからなかったからで…","nextNodeIds":[230175010]},{"nodeId":230175010,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":2283668314,"text":"だから彼は、炭で直接自分の服に図を描いて説明したんですって。","nextNodeIds":[230175011]},{"nodeId":230175011,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":2350178154,"text":"その後、私たちは彼の洗えてない服と機械について、ずっと話してたわ。もちろん、ほとんどの時間は彼がしゃべって、私が聞いていたんだけど。","nextNodeIds":[230175012]},{"nodeId":230175012,"roleType":"TALK_ROLE_NPC","speakerId":12700,"speakerName":"ジャーヤ","textMapHash":1203417234,"text":"ふふ、本当におかしな人よね。でも同時に…そう、魅力的な人でもあるわ。","nextNodeIds":[]}]}],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"ガルシア","textMapHash":3500298162,"text":"（マナー、マナー！ああ、マナーを忘れてはいけない！）"},{"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"路通","textMapHash":910290258,"text":"（先生に顔がけいれんしてるって教えてあげたほうがいいのかな…？）"}],"talkIds":[2301701,2301702,2301703,2301704,230175