"","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":37304,"initDialog":3730401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/AQ/Mengde2_373/Q37304","priority":0,"questId":373,"showRandomTalkCount":0},"dialogs":[{"nodeId":3730401,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1537163995,"text":"ふぅ…風向きの影響を受けるのは龍だけじゃないようだね…","nextNodeIds":[3730402]},{"nodeId":3730402,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2002684955,"text":"そうだ、さっき誰かに龍の過去を教えてもらったって言ってたね？","nextNodeIds":[]},{"nodeId":3730405,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1792472179,"text":"…そうだったのかい？リサという人は、そういう風に思ってるんだ。","nextNodeIds":[3730406]},{"nodeId":3730406,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":575537787,"text":"そう、ここまで来たのは双方が武力行使をし始めたからさ。","nextNodeIds":[3730407]},{"nodeId":3730407,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1544381259,"text":"でも彼の最初の憎しみは、人々が「四風守護」を祀らなくなったからじゃない。","nextNodeIds":[3730408]},{"nodeId":3730408,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":4177956579,"text":"…あれは自然に生まれた憎しみなんかじゃないんだ。腐食された後の産物だよ。","nextNodeIds":[3730409]},{"nodeId":3730409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1200805195,"text":"ふ、腐食？","nextNodeIds":[3730410]},{"nodeId":3730410,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":520152603,"text":"心臓に流れ込んだ黒い血が彼を苦しめ、何年もの間、穏やかに眠れていないんだ。","nextNodeIds":[3730411]},{"nodeId":3730412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":123812747,"text":"アビスの魔術師？聞いたことがない…","nextNodeIds":[3730413]},{"nodeId":3730414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1916335859,"text":"モンドで聞いたような…","nextNodeIds":[3730415]},{"nodeId":3730411,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2496011467,"text":"だから今回、目覚めた彼の精神がアビスの魔術師の呪いによって腐食してしまった。","nextNodeIds":[3730412,3730414]},{"nodeId":3730413,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3733915779,"text":"人ならざる者によって結成されたアビス教団、人類の敵となる組織だよ。","nextNodeIds":[3730416]},{"nodeId":3730415,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1789544035,"text":"そうさ、人ならざる者によって結成されたアビス教団、人類の敵となる組織だよ。","nextNodeIds":[3730416]},{"nodeId":3730416,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2601009187,"text":"彼らのことはよく知らないけど、人間の世界に対して深い悪意を持つことだけは知っている。","nextNodeIds":[3730417]},{"nodeId":3730417,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3399386235,"text":"荒野のヒルチャールも、ヤツらの指揮で動き、ヤツらの手足となってるんだ。","nextNodeIds":[3730418]},{"nodeId":3730418,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3001524547,"text":"ここに来るまで、ボクもトワリンと同じ呪いに蝕まれていた。","nextNodeIds":[3730419]},{"nodeId":3730419,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3049045003,"text":"でも、今ボクたちのいる場所は「英雄の象徴」、モンドの全ての源だ。","nextNodeIds":[3730420]},{"nodeId":3730420,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2383464955,"text":"木々のすき間から流れる風は心地よく、ボクの好きな匂いがする…","nextNodeIds":[3730421]},{"nodeId":3730421,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3847405563,"text":"君と一緒に木陰の下にいると、龍の涙が浄化された時みたいに、ボクの中にある毒が消えていくんだ…","nextNodeIds":[3730422]},{"nodeId":3730423,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1064696867,"text":"うん…だいぶ良くなったよ。","nextNodeIds":[3730424]},{"nodeId":3730424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2011665659,"text":"それで、おまえは