QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7600801],"talks":[{"talkId":7600801,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_COMMON","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7600801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7600801,"initDialog":760080101,"nextRandomTalks":[],"nextTalks":[],"npcId":[7109],"performCfg":"QuestDialogue/WQ/NodKrai_76008/Q7600801","priority":5,"questId":76008,"showRandomTalkCount":0},"dialogs":[{"nodeId":760080101,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":2422304282,"text":"あ、月光があなた方の前途を照らしますように！あなたたちも月の{RUBY#[D]クータル様}少女に祈りを捧げにきたの？","nextNodeIds":[760080102]},{"nodeId":760080102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1158714402,"text":"祈りって…ここにある彫像の前で祈るってことか？すごくでっかい彫像だよな…","nextNodeIds":[760080103]},{"nodeId":760080103,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":838711794,"text":"ふふ、きれいでしょう？この「新月の像」は500年前の詠月使様が自ら彫ったもので、月の{RUBY#[D]クータル様}少女の最初のお姿を象ったと言われているわ。","nextNodeIds":[760080104]},{"nodeId":760080104,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":205999578,"text":"月の{RUBY#[D]クータル様}少女の誕生や、彼女が月下の世界で行った奇怪な出来事については…私はただの侍祭だから、省略させて貰うけど。","nextNodeIds":[760080105]},{"nodeId":760080105,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":110199234,"text":"とにかく、ここは月の{RUBY#[D]クータル様}少女へ祈りを捧げる巡礼の道の最終地点よ。お祈りのために来たんじゃなくても、クータル様のお恵みを感じていってもらえると嬉しいわ。","nextNodeIds":[760080106]},{"nodeId":760080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4025058258,"text":"なるほどな…ん？待てよ。ここが最終地点なのか？じゃあ、あそこに見えるすごそうな柱はなんなんだ？","nextNodeIds":[760080107]},{"nodeId":760080107,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":2034408354,"text":"ふふ…あれは実は柱じゃないの。あの下は「初諭の庭」。500年前の詠月使様の命令で封じられた古い聖地よ。","nextNodeIds":[760080108]},{"nodeId":760080108,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":3401891570,"text":"ある意味では…「霜月の子」の禁域と言えるかしら？その詠月使様の封印で今は誰も入れないから、近づかない方がいいと思うわよ。","nextNodeIds":[760080109]},{"nodeId":760080109,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":575864410,"text":"あと、あそこにあるあの巨大なやつだけど…実は前に空から降ってきたの。月の{RUBY#[D]クータル様}少女のご加護のおかげか、幸い怪我人は出なかったけど…","nextNodeIds":[760080110]},{"nodeId":760080110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3911964026,"text":"えっ、欠片だって？","nextNodeIds":[760080111]},{"nodeId":760080111,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":4058623842,"text":"ええ。あの時、空から巨大な欠片がいくつか落ちてきたの。そのうちの一つが<color=#00E1FFFF>下のキャンプ</color>に落ちて…あなたたちも、ここに来る時に見たでしょう？","nextNodeIds":[760080112]},{"nodeId":760080112,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":3644696938,"text":"他のものについては、たぶんすべて<color=#00E1FFFF>西</color>に落下したはず…","nextNodeIds":[760080113]},{"nodeId":760080113,"roleType":"TALK_ROLE_NPC","speakerId":7109,"speakerName":"エベリナ","textMapHash":3128074458,"text":"いずれにしても、二人がここに来たのはきっとクータル様のお導きによるものだわ。たとえお祈りに来たんじゃなくても、月光があなたたちの前途を祝福しますように。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7600801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7601101,2],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["7109"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7600802,"order":2,"stepDescription":"","stepDescTextMapHash":101330916,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7601401,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":["[3_11086:1750.008,175.931,10511.670]","30"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkId