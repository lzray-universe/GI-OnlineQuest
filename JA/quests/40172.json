gue/EQ/V5.2ActivityCeremony_40172/Q4017204","priority":5,"questId":40172,"showRandomTalkCount":0},"dialogs":[{"nodeId":401720401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":9036202,"text":"新しいのが出てきたぞ！これは…地図だ！","nextNodeIds":[401720402]},{"nodeId":401720402,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3492302762,"text":"地図？どこのだ？","nextNodeIds":[401720403]},{"nodeId":401720403,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2998746138,"text":"これは、まさか燼寂海の…","nextNodeIds":[401720404]},{"nodeId":401720404,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1930475706,"text":"燼寂海！？","nextNodeIds":[401720405]},{"nodeId":401720405,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2585749162,"text":"ワタシの知る限りでは、あの戦いの後、燼寂海は荒れ果てたトコロになった。ううん、あの戦いがあったからこそ、あそこは燼寂海になったのかも。","nextNodeIds":[401720406]},{"nodeId":401720406,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3480096018,"text":"魔物と戦士が灰となって、戦場を埋め尽くした。時にはどこからともなく恐ろしい叫び声が聞こえる。時には天まで届くほどの炎が、叫び声を飲み込むコトもある。","nextNodeIds":[401720407]},{"nodeId":401720407,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3155059058,"text":"あそこの未知の危険と秘密は、数百年もの間、ジブンのチカラを証明したい、トップレベルの冒険者たちを引き寄せた。でも彼らのほとんどが戻らなかった。","nextNodeIds":[401720408]},{"nodeId":401720408,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2160065802,"text":"だいたい二、三十年前だったかしら、燼寂海の異変に気づいた人がいたの。山のように巨大な黒いイキモノが移動してるのを見たそうよ。","nextNodeIds":[401720409]},{"nodeId":401720409,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1010502290,"text":"でもトツゼン、そこ一帯がすべて消えてしまった。何が起きたのかは、誰にも分からない。謎に満ちた伝説の地は、こうして無くなったの。","nextNodeIds":[401720410]},{"nodeId":401720410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1419586986,"text":"消えただって！？","nextNodeIds":[401720411]},{"nodeId":401720411,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1416733178,"text":"ええ。ワタシの記憶が正しければ、燼寂海が消えたのは、まさにこの地図が示すトコロなの。","nextNodeIds":[401720412]},{"nodeId":401720412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":893373106,"text":"それってどこなの？","nextNodeIds":[401720413]},{"nodeId":401720413,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":743907074,"text":"ナタの一番西、すべての部族から離れたトコロよ。昔は一般人が集団で暮らせるようなトコロじゃなかった。燼寂海が消えて、ようやく人が住めるような場所になったの。","nextNodeIds":[401720414]},{"nodeId":401720414,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":663747250,"text":"って言っても、どれも聞いたハナシだから、ワタシも行ったコトはない。","nextNodeIds":[401720415]},{"nodeId":401720415,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2138406506,"text":"人はそういうものよ。年を取っていくと、冒険心が薄れていく。","nextNodeIds":[401720416]},{"nodeId":401720416,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3643237538,"text":"ばあちゃんは遠出が面倒なだけだろう。","nextNodeIds":[401720417]},{"nodeId":401720417,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1803660754,"text":"待って、スピリットが集まり出した！欠片とウォーベンに向かってきてる！","nextNodeIds":[401720418]},{"nodeId":401720418,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":776119530,"text":"……","nextNodeIds":[401720419]},{"nodeId":401720419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1994986938,"text":"おおっ！ルラの体がまた動いたぞ！","nextNodeIds":[401720420]},{"nodeId":401720420,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2472186202,"text":"今度は激しく反応してる…もしかして、燼寂海の場所が知りたかったの？","nextNodeIds":[401720421]},{"nodeId":401720421,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":615208234,"text":"僕も感じる。スピリットが集まってこっちに近づいてくる。","nextNodeIds":[401720422]},{"nodeId":401720422,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":730897346,"text":"ひぃっ、トリハダが立ってきたぞ。","nextNodeIds":[401720423]},{"nodeId":401720423,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3990469066,"text":"効いたみたいね。","nextNodeIds":[401720424]},{"nodeId":401720424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3590768370,"text":"じゃあ、もうルラを起こしていいか？","nextNodeIds":[401720425]},{"nodeId":401720425,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1840962114,"text":"今日はまだダメ。スピリットをカラダに戻すのって、水をビンに入れるみたいにカンタンにはいかないの。","nextNodeIds":[401720426]},{"nodeId":401720426,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":4275404530,"text":"儀式用の剣を用意して、他の準備もしないと。大体二日くらいかかるかしら。","nextNodeIds":[401720427]},{"nodeId":401720427,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3178570154,"text":"でも、安心して。スピリットがもう戻ってきてるから、あと一歩よ。じゃあ、また二日後に会いましょう。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4017204,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1096"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":3578674226,"text":"それと同時にオロルンはスピリットの織り機を使って、シトラリが見たものをウォーベンに記録していく。"},{"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":114448426,"text":"すぐに一枚のウォーベンが出来上がった。"}],"talkIds":[4017201,4017202,4017203,4017204],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1096,"speaker