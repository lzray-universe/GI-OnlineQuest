tDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4017202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4017201,"initDialog":401720101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1094],"performCfg":"QuestDialogue/EQ/V5.2ActivityCeremony_40172/Q4017201","priority":5,"questId":40172,"showRandomTalkCount":0},"dialogs":[{"nodeId":401720101,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2706963538,"text":"みんな、調子はどう？","nextNodeIds":[401720102]},{"nodeId":401720102,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":2249091874,"text":"ああ、ばあちゃんか。","nextNodeIds":[401720103]},{"nodeId":401720103,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1835439898,"text":"いい知らせはなさそうね。","nextNodeIds":[401720104]},{"nodeId":401720104,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3995670954,"text":"ばあちゃんは何でもお見通しだな。旅人が霊をたくさん集めてきてくれたけど、ルラらしきものはなかった。","nextNodeIds":[401720105]},{"nodeId":401720105,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1815233906,"text":"ま、その顔を見ればね。気にしないで。しらみつぶしにやる方法はタイヘンだし、そんなものよ。","nextNodeIds":[401720106]},{"nodeId":401720106,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3346981402,"text":"ルラの状態は安定しているけど、このまま待っていても、良くならない。","nextNodeIds":[401720107]},{"nodeId":401720107,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":565038258,"text":"こっちは少し進展があったから安心して。ルラのご両親によると、この間、彼にある友人ができたそうなの。それからというもの、出かけたら何日も戻ってこないコトがよくあるみたい。","nextNodeIds":[401720108]},{"nodeId":401720108,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":181803282,"text":"ご両親がナイショでその後をつけて行ってみたら、例の友人と何かをしてたのを見たって言ってた。","nextNodeIds":[401720109]},{"nodeId":401720109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2392641970,"text":"その友達を見たの？","nextNodeIds":[401720110]},{"nodeId":401720110,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3161326586,"text":"そうよ。谷中という男で、服装から察するに稲妻の人みたいだったって。","nextNodeIds":[401720111]},{"nodeId":401720111,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":760242514,"text":"谷中さん、これでいいかい？","nextNodeIds":[401720112]},{"nodeId":401720112,"roleType":"TALK_ROLE_NPC","speakerId":14277,"speakerName":"淵上","textMapHash":791017042,"text":"古書で学んだ知識によると、アレルギーには減感作療法というものがある。過敏の逆、鈍感つまり霊感音痴にも使えると思わないか？","nextNodeIds":[401720113]},{"nodeId":401720113,"roleType":"TALK_ROLE_NPC","speakerId":14277,"speakerName":"淵上","textMapHash":1961741938,"text":"お前はかわいそうなことに霊感が全くない。だがそんなお前でも、スピリットに多く曝されれば、改善するのではないだろうか。これは俺流の減感作療法、いや増感作療法だ…","nextNodeIds":[401720114]},{"nodeId":401720114,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":1831900970,"text":"…本当に大丈夫なのか？","nextNodeIds":[401720115]},{"nodeId":401720115,"roleType":"TALK_ROLE_NPC","speakerId":14277,"speakerName":"淵上","textMapHash":3070113010,"text":"霊感音痴のお前のことだ。無理やり巫術を使えばどうなるか、俺よりよく知っているんじゃないか。どうするかは、お前次第だがな。","nextNodeIds":[401720116]},{"nodeId":401720116,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":394880714,"text":"分かった…もう一つ質問があるんだけど、谷中さんはどうしてぼくを助けようとしてくれるんだ？","nextNodeIds":[401720117]},{"nodeId":401720117,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":1003631906,"text":"ぼくみたいなやつは部族での地位も低いし、まともな恩返しもできないのに。","nextNodeIds":[401720118]},{"nodeId":401720118,"roleType":"TALK_ROLE_NPC","speakerId":14277,"speakerName":"淵上","textMapHash":2092751818,"text":"恩返し？俺の顔をよ～く見てくれ。なんて書いてある？","nextNodeIds":[401720119]},{"nodeId":401720119,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":2519931890,"text":"えっと…なんて？","nextNodeIds":[401720120]},{"nodeId":401720120,"roleType":"TALK_ROLE_NPC","speakerId":14277,"speakerName":"淵上","textMapHash":722711090,"text":"「優しい」。","nextNodeIds":[401720121]},{"nodeId":401720121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1732864402,"text":"ええっ！そいつがルラの体質を変えようとしてたってことか？なんで稲妻人が？","nextNodeIds":[401720122]},{"nodeId":401720122,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":1452481802,"text":"ぶっ飛んだ発想だな。本当に効くのか？","nextNodeIds":[401720123]},{"nodeId":401720123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1455754362,"text":"ルラの今の様子だと、失敗したんだろうな。","nextNodeIds":[401720124]},{"nodeId":401720124,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3900850978,"text":"フン、遠い昔、部族で行われてたコトもあるけど、成功率が低いうえ、危なすぎるから、だんだん禁止されるようになった方法ね。","nextNodeIds":[401720125]},{"nodeId":401720125,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":244862938,"text":"それに谷中の目的は、そう単純なものじゃないハズ。ルラのアクシデントの後、ソイツは姿を消してるんだもの。","nextNodeIds":[401720126]},{"nodeId":401720126,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3041913002,"text":"ルラのご両親からもらった住所をたよりに二人の溜まり場に行ったけど、そこには明らかにスピリットが残ってた。それと、こんなのも見つけたの。","nextNodeIds":[401720127]},{"nodeId":401720127,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":2586762866,"text":"それは…？","nextNodeIds":[401720128]},{"nodeId":401720128,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1408031114,"text":"欠片よ…武器や儀式の道具のね。","nextNodeIds":[401720129]},{"nodeId":401720129,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3071461738,"text":"キミも分かるでしょ？かなり古い物だけど、スピリットが多く残ってる。","nextNodeIds":[401720130]},{"nodeId":401720130,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1259378162,"text":"ルラはきっと、これを媒体にしたのよ。あの霊感音痴がどうして霊視できたのか、これで説明がつく。","nextNodeIds":[401720131]},{"nodeId":401720131,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":90769642,"text":"待って。この感覚、なんか懐かしい。僕の古名と関係がありそうだ…","nextNodeIds":[401720132]},{"nodeId":401720132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":228488922,"text":"オロルンの古名？それって古名の欠片なのか？","nextNodeIds":[401720133]},{"nodeId":401720133,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":237161634,"text":"いや…先代の古名の持ち主が残したものだと思う。","nextNodeIds":[401720134]},{"nodeId":401720134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":828189426,"text":"サンハジの物なの？","nextNodeIds":[401720135]},{"nodeId":401720135,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2760203674,"text":"気になってムズムズしてきた。さっそくこれを媒体に霊視しましょ！","nextNodeIds":[401720136]},{"nodeId":401720136,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4022812666,"text":"じゃ、前と同じように、旅人がスピリットの織り機を使って、シトラリの見たビジョンをウォーベンに記録すればいいんだな。","nextNodeIds":[401720137]},{"nodeId":401720137,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1434699850,"text":"いいえ、今回は旅人じゃなくて、オロルンに任せる。","nextNodeIds":[401720138]},{"nodeId":401720138,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3662513002,"text":"どうして？","nextNodeIds":[401720139]},{"nodeId":401720139,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2050831890,"text":"保険よ。","nextNodeIds":[401720140]},{"nodeId":401720140,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2713485202,"text":"キミはスピリットについて旅人よりもよく知ってる。これがサンハジの遺物なら、もしものコトがあったとしても、キミならうまく対応できるハズ。","nextNodeIds":[401720141]},{"nodeId":401720141,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":1863488642,"text":"分かった…ほら、言っただろう、パイモン。ばあちゃんは旅人に一目置いていて、危ないことから遠ざけるんだ。","nextNodeIds":[401720142]},{"nodeId":401720142,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":2657983290,"text":"孫の扱いは雑なのに。","nextNodeIds":[401720143]},{"nodeId":401720143,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":834265730,"text":"このコったら、何ブツブツ言ってるのかしら？","nextNodeIds":[401720144]},{"nodeId":401720144,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3977755082,"text":"なんでもない。ばあちゃん、もう始められる。","nextNodeIds":[401720145]},{"nodeId":401720145,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2936374194,"text":"それじゃ、始めましょ。","nextNodeIds":[401720149]},{"nodeId":401720146,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":880477370,"text":"そうして、シトラリは謎の欠片を媒体に、二度目の霊視を始めた。","nextNodeIds":[401720147]},{"nodeId":401720149,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":63732858,"text":"できたんだな！これは…壊れた弓が、燃えてるみたいだぞ…","nextNodeIds":[401720150]},{"nodeId":401720150,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":2392591434,"text":"見ろ。弓の一部が、欠片と少し似ていないか？","nextNodeIds":[401720151]},{"nodeId":401720151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":73602194,"text":"ホントだ！弓の持ち手の部分が…","nextNodeIds":[401720152]},{"nodeId":401720152,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":939997866,"text":"ばあちゃんの家のウォーベンで、この弓に似たものを見たことがある…","nextNodeIds":[401720153]},{"nodeId":401720153,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":4044822362,"text":"…ええ、これはサンハジが燼寂海の戦いで使った弓よ。この欠片は、本当にサンハジの遺物のようね。","nextNodeIds":[401720154]},{"nodeId":401720154,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":196343402,"text":"さすが、サンハジだ。遺物のスピリットは不安定だが、さっきは何ともなかった。旅人なら記録をしても大丈夫だったと思う。","nextNodeIds":[401720155]},{"nodeId":401720155,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3778560658,"text":"さすが英雄って感じだな！残されたものが後世の人にこんなに影響を与えちゃうなんて…","nextNodeIds":[401720156]},{"nodeId":401720156,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":4180152042,"text":"あの谷中ってやつの目的はホントに霊感音痴の治療なのかしら？別にナニかある気がするのよね。","nextNodeIds":[401720157]},{"nodeId":401720157,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":802039498,"text":"それはオイラも気になってたぞ。さっき弓の絵を見たけど…まさか…そいつ、他の欠片を探してるのか？","nextNodeIds":[401720158]},{"nodeId":401720158,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":1447965370,"text":"サンハジのものとは言え、もうバラバラだから、全部集めても大して役には立たないだろう。","nextNodeIds":[401720159]},{"nodeId":401720159,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":1182742674,"text":"それに、どうしてわざわざ霊感音痴を選んだの？やるだけムダなのに。","nextNodeIds":[401720160]},{"nodeId":401720160,"roleType":"TALK_ROLE_NPC","speakerId":14603,"speakerName":"ルラ","textMapHash":1085368178,"text":"……","nextNodeIds":[401720161]},{"nodeId":401720161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1477147226,"text":"えっ？今ルラが動いたぞ！","nextNodeIds":[401720162]},{"nodeId":401720162,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":4253498442,"text":"どれどれ…ルラのスピリットがさらに欠片に集まり出してる…","nextNodeIds":[401720163]},{"nodeId":401720163,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":3602926386,"text":"ってことは、ばあちゃんのやり方は間違っていないということだな。確かにルラのスピリットが引き寄せられている。","nextNodeIds":[401720164]},{"nodeId":401720164,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":718255866,"text":"それなら、彼のカラダとこの欠片を媒体にして、もう一度試しましょ。","nextNodeIds":[401720165]},{"nodeId":401720165,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":1312440874,"text":"頼んだ、ばあちゃん。僕も頑張るから。","nextNodeIds":[401720166]},{"nodeId":401720166,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":260358642,"text":"#今度は{M#俺}{F#私}がスピリットの織り機を動かすよ。","nextNodeIds":[401720167]},{"nodeId":401720167,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":2093849266,"text":"キミもやりたくてウズウズしてきたの？","nextNodeIds":[401720168]},{"nodeId":401720168,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1394389130,"text":"交代で一回ずつ、そしたら公平だろ？","nextNodeIds":[401720169]},{"nodeId":401720169,"roleType":"TALK_ROLE_NPC","speakerId":1094,"speakerName":"オロルン","textMapHash":18191922,"text":"安全性は確認できてるから、危険はないはずだ。","nextNodeIds":[401720170]},{"nodeId":401720170,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":3544256762,"text":"うん…","nextNodeIds":[401720171]},{"nodeId":401720171,"roleType":"TALK_ROLE_NPC","speakerId":1096,"speakerName":"シトラリ","textMapHash":556045866,"text":"分かった、旅人がそう言うなら。準備できたら言ってちょうだい。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4017201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KED