","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7905314,"initDialog":790531401,"nextRandomTalks":[],"nextTalks":[],"npcId":[13247],"performCfg":"QuestDialogue/WQ/Penumbra_79041/Q7905314","priority":6,"questId":79053,"showRandomTalkCount":0},"dialogs":[{"nodeId":790531401,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":1705748354,"text":"おや？お二人ともどうかしましたか？何やら聞きたいことがあるご様子ですね。","nextNodeIds":[790531402]},{"nodeId":790531402,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":62118290,"text":"もし「ヴェルーリヤ·ミラージュ」について何か聞きたいのなら、私に聞くのが大正解ですよ。私にとって「ヴェルーリヤ·ミラージュ」は、手のひらの水の模様のように詳しいことですから…","nextNodeIds":[790531403,790531405]},{"nodeId":790531403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1201072098,"text":"み、水の模様ってシワ？","nextNodeIds":[790531404]},{"nodeId":790531404,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":812285626,"text":"ただの比喩ですよ！私にシワなんかできるわけないじゃないですか！","nextNodeIds":[790531407]},{"nodeId":790531407,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":393531474,"text":"それよりも、オイラたち楽園でこんな手紙を拾ったんだ！","nextNodeIds":[790531408]},{"nodeId":790531408,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1504039394,"text":"イディアならきっと、これがどこから来たものか知ってるよな？","nextNodeIds":[790531409]},{"nodeId":790531409,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":3840403090,"text":"そりゃあもちろん、そのような手紙は一目で…あれ、こんな手紙は初めてですね…","nextNodeIds":[790531410]},{"nodeId":790531410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2024882410,"text":"手のひらの水の模様が、すごくボヤけてるみたいだな…","nextNodeIds":[790531411]},{"nodeId":790531411,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":3702540202,"text":"こ、これは明らかに私の隙を狙って、誰かがこっそり埋めたものです。見たことがないのも仕方ありません。","nextNodeIds":[790531412]},{"nodeId":790531412,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":4133440346,"text":"それに内容を読む限り、手紙というよりも遺書や記録のように思えますね。一体誰のものでしょうか…手紙のこの雰囲気、どこかで覚えがあるような気が…","nextNodeIds":[790531413]},{"nodeId":790531413,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":74935066,"text":"「蜃楼玉匣」と関係してる？","nextNodeIds":[790531414]},{"nodeId":790531414,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":1871210498,"text":"あっ！そう言われると確かにそうですね。これは「蜃楼玉匣」を持ち込んだおじいさんが残したものです…あれは、まだ私が瓶の中に来て間もない頃のことでした。","nextNodeIds":[790531415]},{"nodeId":790531415,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":3802367530,"text":"あのおじいさんは稲妻の人で、ここに来てすぐ「ここは願いが叶う場所か？」と聞いてきたのです。そして、彼は自分を昔の戦場に送り返して欲しいと言ってきました…","nextNodeIds":[790531416]},{"nodeId":790531416,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":1322680450,"text":"なんとか説明しようとしたのですが…彼は秘境に入ってきた時点で身体がかなり悪かったようです。ここまでの道のりも長かったことで、精神もかなりすり減らしてるようでした…","nextNodeIds":[790531417]},{"nodeId":790531417,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":830051890,"text":"彼はただひたすらに「お願いだ、俺をあの日に戻してくれ…」、「俺をあの戦争の中に送り返してくれ…」みたいなことを言い続けていましたよ。","nextNodeIds":[790531418]},{"nodeId":790531418,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":333503106,"text":"だから、私は瓶の中の蜃境を使って…彼が想像する戦場を模倣しました。","nextNodeIds":[790531419]},{"nodeId":790531419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1706530994,"text":"ああ、それで手紙には「やっとここへ戻れた」って書いてあったのか…","nextNodeIds":[790531420]},{"nodeId":790531420,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":4042864634,"text":"それは蜃境だったはずの場所が、ぼんやりしている間にいきなり記憶の中の戦場になったせいかもしれませんね。戦場は恐ろしいものでしたけど、彼はすごく楽しそうに笑ってました。","nextNodeIds":[790531421]},{"nodeId":790531421,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":879154898,"text":"死の間際にそんな恐ろしい光景を見たい人がいるなんて不思議ですよね…","nextNodeIds":[790531422,790531423]},{"nodeId":790531422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":361221050,"text":"彼からすると他に意味があるのかも…","nextNodeIds":[790531424]},{"nodeId":790531424,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":4232147346,"text":"私にはよく分かりません。でも彼は最後まですごく満足そうにしてましたよ。","nextNodeIds":[790531425]},{"nodeId":790531425,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":4026192874,"text":"もしあのシチュエーションで叶えたい願いがあったのなら、それを抱き続けてきた時間はきっと大変なものだったでしょうね。","nextNodeIds":[790531426]},{"nodeId":790531426,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":4166747122,"text":"コアホイールが再び回るようにした時、「蜃楼玉匣」にはかなり助けられました。この秀家さんには感謝しないといけませんね。","nextNodeIds":[]},{"nodeId":790531423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1436016266,"text":"そのほうが刺激的かも。","nextNodeIds":[790531424]},{"nodeId":790531405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2150570906,"text":"本当に？見せて！","nextNodeIds":[790531406]},{"nodeId":790531406,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":3411331730,"text":"た、ただの比喩ですから。あなたの手相と同じで、何も面白くなんてないですよ。","nextNodeIds":[790531407]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7905314,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_G