"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2201101],"talks":[{"talkId":2201101,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2201101","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2201101,"initDialog":220110101,"nextRandomTalks":[],"nextTalks":[],"npcId":[3107],"performCfg":"","priority":5,"questId":22011,"showRandomTalkCount":0},"dialogs":[{"nodeId":220110101,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":1287293058,"text":"困りました…いったい誰がこのような噂を…","nextNodeIds":[220110102]},{"nodeId":220110102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2496374658,"text":"どんな噂？","nextNodeIds":[220110103]},{"nodeId":220110103,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":363036834,"text":"神社のおみくじに関することです。","nextNodeIds":[220110104]},{"nodeId":220110104,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":2539051586,"text":"「おみくじを引く」という言葉の意味をご存じでしょうか？簡単に言えば、おみくじを通して吉凶を占う行為のことを言います。","nextNodeIds":[220110105]},{"nodeId":220110105,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":1397854850,"text":"おみくじに書かれた内容によって、人々は未来に関する簡単な予言を知ることができます。","nextNodeIds":[220110106]},{"nodeId":220110106,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":3692888594,"text":"いい内容のくじを引いた場合は問題ありませんが、悪いくじを引いた場合は、神社に結び、凶をその場に留めるようお願いするのです。","nextNodeIds":[220110107]},{"nodeId":220110107,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":3941534858,"text":"しかし…誰が言い出したのかは分かりませんが…悪い内容のくじを木の上に放ってやれば、神様が優先的に厄払いをしてくれる、という噂が流れているのです。","nextNodeIds":[220110108]},{"nodeId":220110108,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":3966553610,"text":"しかも、放った場所が高ければ高いほど、すぐに幸運が訪れ、凶運が消え去るのだとか…全くもって根拠のないふざけた事を！","nextNodeIds":[220110109]},{"nodeId":220110109,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":532979858,"text":"その後、噂はどんどん広まり、今度はおみくじだけではなく、木に向かってモラを投げる人まで出てきたのです。","nextNodeIds":[220110110]},{"nodeId":220110110,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":1507904258,"text":"そして、投げたモラが木の頂上に止まれば、神様が答えてくれるのだとか。願いが叶うだけでなく、一年中の幸運をもたらしてくれると噂されているのです。","nextNodeIds":[220110111,220110114]},{"nodeId":220110111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":898769386,"text":"本当にそうなるの？","nextNodeIds":[220110112]},{"nodeId":220110112,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":2363725730,"text":"あり得ません！神様が答えてくれるかどうかは別として…モラを投げるだなんてとんでもない。モラって全部同じ見た目をしていますよね？","nextNodeIds":[220110113]},{"nodeId":220110113,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":1867515850,"text":"神様にモラを一枚ずつ拾って、判別してもらうつもりなのでしょうか？","nextNodeIds":[220110116]},{"nodeId":220110116,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":2559224626,"text":"幸運を求める気持ちは分かりますが、そうやって上に物を投げても、祝福には繋がりません。","nextNodeIds":[220110117]},{"nodeId":220110117,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":1750685642,"text":"それに、放られたおみくじなどは、風に吹かれてあちこちに落ちてしまっています。","nextNodeIds":[220110118]},{"nodeId":220110118,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":604141682,"text":"私も片付けようとしましたが、運動が苦手で…片付けられないばかりか、どうやって降りればいいのかもわからず、苦労しました…","nextNodeIds":[220110119]},{"nodeId":220110119,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":4145991866,"text":"しかし、放っておくわけにはいきません…旅人、屋根に登って、掃除を手伝ってくれませんか？","nextNodeIds":[220110120,220110122]},{"nodeId":220110120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2835930370,"text":"任せて。","nextNodeIds":[220110121]},{"nodeId":220110121,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":132244746,"text":"ではこの件は旅人、あなたにお願いします。もしおみくじを見つけた場合、集めて私に渡してください。","nextNodeIds":[]},{"nodeId":220110122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3686623490,"text":"集めたおみくじはどうするの？","nextNodeIds":[220110123]},{"nodeId":220110123,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":3471759050,"text":"蛍美さんによれば、おみくじは…皆様が引いた「運気」なんだそうです。","nextNodeIds":[220110124]},{"nodeId":220110124,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":818590466,"text":"勝手に捨てるのは不謹慎なので、集めた後は、規則に従ってあるべき場所に保管するつもりです。","nextNodeIds":[220110125]},{"nodeId":220110125,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":3224526562,"text":"はぁ、もし皆様が最初からルールを守っていれば、こんな面倒なことにはならなかったのに…","nextNodeIds":[220110126]},{"nodeId":220110126,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":899691890,"text":"ではこの件は旅人、あなたにお願いします。もしおみくじを見つけた場合、集めて私に渡してください。","nextNodeIds":[]},{"nodeId":220110114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2094217666,"text":"しっかりと説明したら？","nextNodeIds":[220110115]},{"nodeId":220110115,"roleType":"TALK_ROLE_NPC","speakerId":3107,"speakerName":"麻紀","textMapHash":4287437018,"text":"そのような人が多すぎて、私一人では説明が追いつかないのです…","nextNodeIds":[220110116]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2201101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3107","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2201102,"order":2,"stepDescription":"屋上に行って片付ける","stepDescTextMapHash":507803876,"finishConds":[{"BFGALAINLMD":3,"LNHLPKELCAL":[100883,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""},{"BFGALAINLMD":3,"LNHLPKELCAL":[100884,0],"PAINLIBBLDK":"QUEST_CONTENT_OBTAIN_ITEM","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["Q22011GreatT