[{"nodeId":745040101,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":2631994786,"text":"君たち、そんなに楽しみなんか？","nextNodeIds":[745040102]},{"nodeId":745040102,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":471435986,"text":"こっそり教えてやるけどな、俺に言わせりゃ、今回の企画には期待せえへんほうがいいで。こんなことに時間を割くぐらいやったら、ルポート時計店に行って遊んだほうがマシやで。","nextNodeIds":[745040103]},{"nodeId":745040103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1115493498,"text":"うわっ！それっておまえの心の声か？ぽろっと言っちまって大丈夫なのかよ？","nextNodeIds":[745040104]},{"nodeId":745040104,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3795819674,"text":"しーっ、静かに。人に聞かれたらまずい。俺があっちから派遣されてきたスパイやって思われたら大変やで。","nextNodeIds":[745040105]},{"nodeId":745040105,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":1576878378,"text":"はぁ、この話はこの辺で止めとこう。俺は一介の雇われの身やからな。やっぱ仕事の話に戻ろか。","nextNodeIds":[745040106]},{"nodeId":745040106,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":1535320938,"text":"まず、今回の企画におけるデータ収集は大きく二つに分かれてる。俺とアルボンがそれぞれ一つずつ担当してるんや。","nextNodeIds":[745040107]},{"nodeId":745040107,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":624317834,"text":"俺が担当してるデータ収集は、決闘代理人の戦闘力をシミュレートするためのものや。君には戦闘プロジェクトにトライしてほしいんやで。","nextNodeIds":[745040108]},{"nodeId":745040108,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":103116258,"text":"俺らは野外で魔物の集まる場所を見つけて、その近くにデータ記録の装置を設置したんや。君らはそいつらを片付けてくれればいい。","nextNodeIds":[745040109]},{"nodeId":745040109,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3315322362,"text":"具体的な位置はすでに地図に記しておいた。他の注意事項については、このハンドブックに書いてあるから、後で確認してや。","nextNodeIds":[745040110]},{"nodeId":745040110,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":1824806658,"text":"他に質問はあるか？","nextNodeIds":[745040111]},{"nodeId":745040111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3715710570,"text":"特に質問はない。","nextNodeIds":[745040112]},{"nodeId":745040112,"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","textMapHash":3945716778,"text":"ほな、データ収集がうまくいくことを祈ってるやで。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30412"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7450401],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30412,"speakerName":"アルベール","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":1},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174504],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":634963854,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74504/Q7450401","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],