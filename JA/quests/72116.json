,{"nodeId":721160123,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"グザヴィエ","textMapHash":279376618,"text":"それじゃあ、「晶化骨髄」を3つ頼む。全部集めたら、俺のところに持って来てほしい。","nextNodeIds":[]},{"nodeId":721160113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2613497450,"text":"正式な名前が別にあるかと思ってた…","nextNodeIds":[721160114]},{"nodeId":721160114,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"グザヴィエ","textMapHash":3111599938,"text":"「応急浄化器」が正式な名前だが？","nextNodeIds":[721160115]},{"nodeId":721160115,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"グザヴィエ","textMapHash":142899490,"text":"あ…製品コードと製造年月日の正式コードのことか？","nextNodeIds":[721160116]},{"nodeId":721160116,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"グザヴィエ","textMapHash":2777374826,"text":"こういう応急措置に、そういったのはいらないだろう。","nextNodeIds":[721160117]},{"nodeId":721160107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1793009394,"text":"それも「緊急措置」の一種？","nextNodeIds":[721160108]},{"nodeId":721160108,"roleType":"TALK_ROLE_NPC","speakerId":3162,"speakerName":"グザヴィエ","textMapHash":1296844338,"text":"まあな。ただ通常の顧客対応では、この技術を提供してないんだがな…","nextNodeIds":[721160109]}]},{"talkId":7211603,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityLi