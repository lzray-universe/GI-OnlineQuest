Ids":[705060206]},{"nodeId":705060206,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":2340852258,"text":"最近、自分の足りない点をよく反省することがある。仕事の効率も能力も…あらゆる面で改善の余地があると。","nextNodeIds":[705060207]},{"nodeId":705060207,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":1112081914,"text":"私のストレスが、きっと知らない間にリサにも影響を与えてしまっていたんだろう…","nextNodeIds":[705060208]},{"nodeId":705060208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":973648034,"text":"全然分かってないんじゃないかな…","nextNodeIds":[705060209]},{"nodeId":705060209,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":4249676906,"text":"えっ？","nextNodeIds":[705060210]},{"nodeId":705060210,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":698459042,"text":"そうね。ほら、可愛い子ちゃんだって分かっているみたいよ。","nextNodeIds":[705060211]},{"nodeId":705060211,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":618623570,"text":"あなたがあまりにも疲れた顔をしていたから、一緒にお酒やお茶を飲んで、楽しいことで息抜きをしようと思っただけ。","nextNodeIds":[705060212]},{"nodeId":705060212,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1909531434,"text":"それなのに、ここでもあなたは仕事のことばかり考えているんだもの。そんなんじゃ、わたくしだって悲しくなるわ。","nextNodeIds":[705060213]},{"nodeId":705060213,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3366307042,"text":"ずっと気を張り詰めていたら、いつか倒れてしまうわよ。","nextNodeIds":[705060214]},{"nodeId":705060214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1303599658,"text":"その通り。","nextNodeIds":[705060215]},{"nodeId":705060215,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":1188572650,"text":"#{NICKNAME}、君もそう思うのか？","nextNodeIds":[705060216]},{"nodeId":705060216,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":2340448050,"text":"はぁ、どうやら…息抜きすることを学ぶのが、私にとって一番の課題のようだ。","nextNodeIds":[705060217]},{"nodeId":705060217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2646781562,"text":"璃月には「一張一弛」という言葉がある。","nextNodeIds":[705060218]},{"nodeId":705060218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1636324826,"text":"ああ！仕事をする時はしっかり仕事をして、休む時にはゆっくり休む。わかりやすく言えば、おまえら二人を足して二で割ったような感じがちょうどいいな！","nextNodeIds":[705060219]},{"nodeId":705060219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1967450946,"text":"変な例え…","nextNodeIds":[705060220]},{"nodeId":705060220,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":324439514,"text":"ふふっ…","nextNodeIds":[705060221]},{"nodeId":705060221,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":1259846162,"text":"な、なるほど…","nextNodeIds":[705060222]},{"nodeId":705060222,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":3932423578,"text":"ありがとう。酒場は飲み物を飲むだけでなく、気分まで明るくしてくれる場所だったのだな。だから、リサとガイアは酒場が好きなんだろう。","nextNodeIds":[705060223]},{"nodeId":705060223,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3366284546,"text":"ええ、そうね。でもそれは、バーテンダーが誰かにもよるわよ。","nextNodeIds":[705060224]},{"nodeId":705060224,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":90543346,"text":"今日は可愛い子ちゃんのおかげで、ジンを説得できたわ。あなたの口がとても上手だからでしょうね。","nextNodeIds":[705060225,705060226]},{"nodeId":705060225,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":404785130,"text":"そんなことない。","nextNodeIds":[705060227]},{"nodeId":705060227,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2382236858,"text":"ふふっ、それじゃあ、わたくしたちはこれで。","nextNodeIds":[705060228]},{"nodeId":705060228,"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","textMapHash":1635007538,"text":"機会があれば、またここに来て息抜きをしようと思う。","nextNodeIds":[705060229]},{"nodeId":705060229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":262625210,"text":"ああ！じゃあな！","nextNodeIds":[]},{"nodeId":705060226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3046900042,"text":"役に立てたなら良かった。","nextNodeIds":[705060227]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7050602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1068,50],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE_RANGE","PPFLKMOMKAI":"Q7050204_Play"}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1006"],"NOCCOBOFKHP":1068,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7050601,7050602],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","count":17},{"roleType":"TALK_ROLE_NPC","speakerId":1006,"speakerName":"ジン","count":15},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":6}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170506],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":622976590,"CHECNJEMEFE":{"1006":[8010],"1007":[8010]},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[70507],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70506/Q7050601","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"