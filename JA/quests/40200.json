ue/EQ/V5.8YLYZ_40200/Q4020001","priority":5,"questId":40200,"showRandomTalkCount":0},"dialogs":[{"nodeId":402000101,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":2593563026,"text":"素敵な夜景ね…","nextNodeIds":[402000102]},{"nodeId":402000102,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":741044146,"text":"爽やかなロマリタイムフラワーの香り、街角の香水店から漂う芳香、そして濃厚なコーヒー豆の匂いが夜風の中で溶け合い、ゆったりとした雰囲気を醸し出している。","nextNodeIds":[402000103]},{"nodeId":402000103,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":3758016498,"text":"屋上テラスのある酒場でもあれば、炭酸入りの葡萄酒を注文して、最高のほろ酔い気分を堪能できたんだけど…","nextNodeIds":[402000104,402000105]},{"nodeId":402000104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2832619890,"text":"穏やかな休暇なんだし、飲もう！","nextNodeIds":[402000106]},{"nodeId":402000106,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":1906705482,"text":"そうね…じゃあ一緒に探しに行きましょう。隠れ家的な酒場なら、裏メニューとかもあるかもしれないわね？","nextNodeIds":[402000107]},{"nodeId":402000107,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":3806804850,"text":"でもその前に…カブリエール商会が開いているうちに、この衣装に合う香水を一緒に選んでくれない？","nextNodeIds":[402000108]},{"nodeId":402000108,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":2102122314,"text":"精密な時計や、遊び心のあるクロックワークの調度品、それに技巧を凝らした独特なアクセサリー…あそこなら、見応えのある品を沢山置いているわ。","nextNodeIds":[402000109,402000110]},{"nodeId":402000109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":398499002,"text":"一仕事終えて買い物したくなったの？","nextNodeIds":[402000111]},{"nodeId":402000111,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":1326062210,"text":"テイワット屈指の見識があって、審美眼にも優れた旅人が付き合ってくれるんだもの。この機会にしっかり意見をもらわないとね…","nextNodeIds":[402000112]},{"nodeId":402000112,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":981989818,"text":"うん…満足よ。本当に素晴らしい異国の旅になったわ。","nextNodeIds":[402000113]},{"nodeId":402000113,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":1206889578,"text":"あと数日休暇があれば、もっとのんびりできたんだけど…","nextNodeIds":[402000114,402000115]},{"nodeId":402000114,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3978645834,"text":"休暇を楽しむって言ってなかった？","nextNodeIds":[402000116]},{"nodeId":402000116,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":2112875754,"text":"仕方ないわ。次の仕事が待っているから。","nextNodeIds":[402000117]},{"nodeId":402000117,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":1819082258,"text":"今回の事件に関する正式な報告書を書いたら、より優れた貨物の通関体制を構築するために、次の任務地点まで向かわないといけないの——","nextNodeIds":[402000118]},{"nodeId":402000118,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":1675361490,"text":"ナド・クライにね。","nextNodeIds":[402000119,402000120]},{"nodeId":402000119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2285674122,"text":"#{M#俺}{F#私}たちの次の目的地もそこだよ。","nextNodeIds":[402000121]},{"nodeId":402000121,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":4120766882,"text":"心配ないわ。ただ情報提供者と会って、今後の協力案について確認するだけよ。あとは、お互いにどこまで干渉するか決めたりね。","nextNodeIds":[402000122]},{"nodeId":402000122,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":2220207778,"text":"詳しい話はまた今度しましょう。せっかくだから、今回のフォンテーヌ旅行を記念して、一緒に写真を撮らない？","nextNodeIds":[402000123,402000124]},{"nodeId":402000123,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1059575066,"text":"調査の指導をしてくれた記念に。","nextNodeIds":[402000125]},{"nodeId":402000125,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":2571324706,"text":"そうね、君みたいな新進気鋭のエージェントになら背中を任せられるわ。","nextNodeIds":[402000126]},{"nodeId":402000126,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":2768856210,"text":"じゃあ、今回大活躍してくれた総合映像記録器を使って、大切な一枚を残しましょうか。","nextNodeIds":[402000127]},{"nodeId":402000127,"roleType":"TALK_ROLE_NPC","speakerId":2613,"speakerName":"夜蘭","textMapHash":2003749978,"text":"次にナド・クライで会った時も、今回みたいに君と仕事ができることを願っているわ。","nextNodeIds":[]},{"nodeId":402000124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3026436362,"text":"見事な連携で事件を解決した記念に。","nextNodeIds":[402000125]},{"nodeId":402000120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2539650858,"text":"何か緊急事態でもあったの？","nextNodeIds":[402000121]},{"nodeId":402000115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1914916698,"text":"また仕事に戻らないといけないの？","nextNodeIds":[402000116]},{"nodeId":402000110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":52447834,"text":"ちょうど購買欲が湧いてきた！","nextNodeIds":[402000111]},{"nodeId":402000105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2859499338,"text":"大事件を解決したんだし、飲もう！","nextNodeIds":[402000106]}]},{"talkId":4020002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4020001","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"para