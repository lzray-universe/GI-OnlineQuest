erId":1005,"speakerName":"パイモン","textMapHash":1445962210,"text":"全ての写真に、オイラたちが一緒に経験した物語が詰まってるんだからな。オイラにとっては、かけがえのない作品だぜ。","nextNodeIds":[765070115]},{"nodeId":765070115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4248299650,"text":"今後…えーっと、ほかのところで冒険する時にこの楽しい日々を思い出したら、きっと楽しい気分になれるぜ。","nextNodeIds":[765070116]},{"nodeId":765070116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1078140002,"text":"これからも一緒に、沢山写真を撮ろうね！","nextNodeIds":[765070117]},{"nodeId":765070117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1789944066,"text":"おう！じゃあ約束だな。次のアルバムは、今よりもっと素敵にするぞ！オイラたちだけの思い出をもっともっと作ろうな！","nextNodeIds":[]},{"nodeId":765070112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2742769602,"text":"重要なのは過程を楽しむことだよ。","nextNodeIds":[765070113]},{"nodeId":765070107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4205739682,"text":"「非常用資金」のおかげだね。","nextNodeIds":[765070108]},{"nodeId":765070103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1465622466,"text":"写真の中には、それぞれ思い出が隠されてるね。","nextNodeIds":[765070104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7650701","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_13271:1645.395,227.809,9477.359]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7650701],"spe