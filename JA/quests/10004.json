"KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[20300_1:456.223,37.757,6063.426,0.000,193.437,0.000]"],"NOCCOBOFKHP":20300,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[1000402],"talks":[{"talkId":1000402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":true,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1000402","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1000402,"initDialog":100040201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10095],"performCfg":"QuestDialogue/WQ/Mengde_10004/Q1000402","priority":5,"questId":10004,"showRandomTalkCount":0},"dialogs":[{"nodeId":100040201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4001882378,"text":"ふぅ～、夏の思い出がいっぱい詰まった方法で来ると、気分もさっぱりするな！","nextNodeIds":[100040202]},{"nodeId":100040202,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":3956128636,"text":"ここが地下の古国——カーンルイアの門なんでしょうか。","nextNodeIds":[100040203]},{"nodeId":100040203,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2070768002,"text":"きっとその裏には、多くの秘密や悲しみが隠されているのでしょうね。","nextNodeIds":[100040204]},{"nodeId":100040204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":545796138,"text":"二通目の手紙を読んでみようぜ。","nextNodeIds":[100040205]},{"nodeId":100040205,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":4019188146,"text":"そうしましょう。えっと…番号が二の封筒は…これですね。","nextNodeIds":[100040206]},{"nodeId":100040206,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":4092752570,"text":"「経典を解するは道を見るにあらず。智の水を持って知恵の渇きを癒やすべし——スメールの古い言葉だ。この地には『焚真の天象』と呼ばれる現象がある。」","nextNodeIds":[100040207]},{"nodeId":100040207,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":1151096994,"text":"「でも『焚真の天象』は、あまりにも真理を渇望したため、最終的に燃え上がってしまった。『渇真』と呼んだほうが、本質に近いかもしれん。」","nextNodeIds":[100040208]},{"nodeId":100040208,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":4046380426,"text":"「地下の古国の記録によると、カーンルイアには鏡のように澄んだ地底湖がいくつかあり、真の宇宙の星々を映していたのだそうだ。」","nextNodeIds":[100040209]},{"nodeId":100040209,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":188640834,"text":"「これはまさに、水によって開かれた『渇真の天象』が、偽りの空を越え、外の宇宙とつながっているからだ。」","nextNodeIds":[100040210]},{"nodeId":100040210,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":647171858,"text":"そういうことでしたか！","nextNodeIds":[100040211]},{"nodeId":100040211,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":2038048074,"text":"「偽りの空を突き抜けて初めて、宇宙の星々の引力や影響を観測できる。そして、これら世界の外のパラメータをもって初めて、世界の運命を算出できるんだよ。」","nextNodeIds":[100040212]},{"nodeId":100040212,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":1280232858,"text":"「カーンルイアの門の前で、『渇真の天象』を一度開くこと——これがわしの与える課題だ。」","nextNodeIds":[100040213]},{"nodeId":100040213,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2145682034,"text":"後は、おばばが算出した儀式と方法ですね。","nextNodeIds":[100040214]},{"nodeId":100040214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3599008922,"text":"そうみたいだな。この惑星の軌道とか符文とかのことは、オイラさっぱりわからないぞ。","nextNodeIds":[100040215]},{"nodeId":100040215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3263846210,"text":"モナ、今すぐ試してみるか？","nextNodeIds":[100040216]},{"nodeId":100040216,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":4107284370,"text":"認めたくはありませんが、頭の中でおばばが開発した儀式のパラメータを計算してみたところ、どうやら本当に可能なようです。","nextNodeIds":[100040217]},{"nodeId":100040217,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":1988690474,"text":"今、私はやる気も気合も十分です。それに、このまま戻れば一日分の宿泊費を無駄にしてしまいます。今やらずして、いつやるというのですか！始めましょう！","nextNodeIds":[100040218]},{"nodeId":100040218,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":3447007650,"text":"すべての恒星に通じる使者たちよ、黄と赤の道を治める放浪者たちよ、そして天上の輝ける兄たちよ——","nextNodeIds":[100040219]},{"nodeId":100040219,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2068565058,"text":"空虚の洞、曲がりくねった道。私、アストローギスト・モナ・メギストスは、ここに水をもって調和を配す。","nextNodeIds":[100040220]},{"nodeId":100040220,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":710540722,"text":"知恵と真理をもって渇きを癒す。私、アストローギスト・モナ・メギストスが、星々の顕現を命ずる。","nextNodeIds":[100040221]},{"nodeId":100040221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4141881578,"text":"う、うまくいったのか…？","nextNodeIds":[100040222]},{"nodeId":100040222,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1085573274,"text":"うわっ、なんかいっぱい魔物が出てきたぞ！","nextNodeIds":[100040223]},{"nodeId":100040223,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":3115149538,"text":"どうやら完全には成功しなかったようですね。結果としては、ほんの一瞬開いただけで、この魔物たちは「渇真の天象」を通って現れたのです。","nextNodeIds":[100040224]},{"nodeId":100040224,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2436192482,"text":"ああ、本当に腹が立ちますね。真実の星空を少しも見られませんでした。こうなったら、あなたたちに怒りをぶつけるしかありませんね。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1000402,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20300,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[20300_1:456.223,37.757,6063.426,0.000,193.437,0.000]"],"NOCCOBOFKHP":20300,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":1000403,"order":4,"stepDescription":"カーンルイアの門に向かう","stepDescTextMapHash":1860689068,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[20300,0],"PAINLIBBLDK":"QUEST_CONTENT_PRESENT_AT_SPECIFIC_SCENE","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_14908:2189.999,212.51