alkCount":0},"dialogs":[{"nodeId":100040101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":169852378,"text":"モナ、モナ！おまえにお届け物を持ってきたぞ！","nextNodeIds":[100040102]},{"nodeId":100040102,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":1459819866,"text":"パイモンに旅人、とても元気そうですね。","nextNodeIds":[100040103]},{"nodeId":100040103,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2257381466,"text":"それで、私に何を届けてくれるのです？簡単かつすぐお金になるようなお仕事の依頼だと、大変助かるのですが。","nextNodeIds":[100040104]},{"nodeId":100040104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3970616074,"text":"たしか…おまえの先生が出した「課題」だったはずだぞ。","nextNodeIds":[100040105]},{"nodeId":100040105,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":1736496066,"text":"そんなもの、欲しくありません！…いや、そう言い切るのもよくないですね。人というものは、やはり向上心を持つべきですから。","nextNodeIds":[100040106]},{"nodeId":100040106,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":990866026,"text":"でも、どうせ人のことを振り回すようなものなのでしょうね。おばばのことは、よく分かっていますから。","nextNodeIds":[100040107]},{"nodeId":100040107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1630984802,"text":"とりあえず見てみるか？","nextNodeIds":[100040108]},{"nodeId":100040108,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":251716650,"text":"この本…特に変わったところはないようですね。","nextNodeIds":[100040109]},{"nodeId":100040109,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":889746346,"text":"あっ、何通か手紙が落ちてきました。","nextNodeIds":[100040110]},{"nodeId":100040110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1632640738,"text":"もしかして和解の手紙か？","nextNodeIds":[100040111]},{"nodeId":100040111,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2732566234,"text":"番号の書かれた手紙が三通ですね。うーん、まず一つ目を開けてみましょう。","nextNodeIds":[100040112]},{"nodeId":100040112,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":964100418,"text":"課題の内容なら人に見られても問題ないはずです。一緒に見てみましょう。","nextNodeIds":[100040113]},{"nodeId":100040113,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":1075158410,"text":"「久しぶりだね。わしもすっかり、足が不自由になってきた…」","nextNodeIds":[100040114]},{"nodeId":100040114,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":1742413234,"text":"ふん、情に訴えようというわけですか。せめて、もう少し感情を込めてほしいですね。","nextNodeIds":[100040115]},{"nodeId":100040115,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":1548040922,"text":"「以前、おまえを追いかけていた時のことだ。おまえは逃げながら、水元素の虚影でわしの注意を引こうとしていた。あの時の光景は、今でもはっきり覚えておるよ。」","nextNodeIds":[100040116]},{"nodeId":100040116,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":3019313290,"text":"「おまえがいなくなった今は、一日中、揺り椅子に身を任せるばかりで、運動不足になってしまった。」","nextNodeIds":[100040117]},{"nodeId":100040117,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":4143103802,"text":"お——ば——ば——","nextNodeIds":[100040118]},{"nodeId":100040118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":239769314,"text":"やっぱり見るのやめる？","nextNodeIds":[100040119]},{"nodeId":100040119,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":4118451490,"text":"「余計な話はさておきだ…おまえは王国…ひいては世界の運命をどう測ったらいいか、知りたくはないかい？」","nextNodeIds":[100040120]},{"nodeId":100040120,"roleType":"TALK_ROLE_NPC","speakerId":16024,"speakerName":"バーべロス","textMapHash":1024988826,"text":"「スメールへ向かい、地下の国の門を探すんだ。そこで二通目の手紙を開けるがいい。」","nextNodeIds":[100040121]},{"nodeId":100040121,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":3352992706,"text":"どうやらおばばの理論体系は、さらに進歩を遂げたようですね。これは…私に本物の技を教えようとしているということでしょうか。","nextNodeIds":[100040122]},{"nodeId":100040122,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2027590370,"text":"本当に、年を取りましたね。","nextNodeIds":[100040123]},{"nodeId":100040123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1716623658,"text":"おまえたち、なんだか変な師弟関係だな。感情の話になるとケンカして、学問の話になるとしんみりして…","nextNodeIds":[100040124]},{"nodeId":100040124,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3588733858,"text":"それにしても、このスメールにある地下の国の門って…まさか、あれのことか？","nextNodeIds":[100040125]},{"nodeId":100040125,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":3787760266,"text":"何か手がかりがあるのですか？","nextNodeIds":[100040126]},{"nodeId":100040126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":499041218,"text":"オイラたち、たぶんおまえの先生が言ってた場所がどこにあるのか知ってるぞ。","nextNodeIds":[100040127]},{"nodeId":100040127,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":1712636786,"text":"最高ですね。これで私が調査する時間を節約できますし、間接的にガイド料や宿泊費も浮くことになります——かなりの額ですよ。","nextNodeIds":[100040128]},{"nodeId":100040128,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":1660367826,"text":"もう一瞬だって待てません。さっそく出発です。","nextNodeIds":[100040129]},{"nodeId":100040129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1858357930,"text":"さっき交通費について触れなかったけど、まさか…？","nextNodeIds":[100040130]},{"nodeId":100040130,"roleType":"TALK_ROLE_NPC","speakerId":10095,"speakerName":"モナ","textMapHash":2520600762,"text":"ええ、いつもの方法で向かいます。さあ、行きましょう。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1000401,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_13649:2191.674,211.988,-875.241]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"