rceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7150201,"initDialog":715020101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30181],"performCfg":"QuestDialogue/WQ/TheChasmChallenge/Q7150201","priority":15,"questId":71502,"showRandomTalkCount":0},"dialogs":[{"nodeId":715020101,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4133105010,"text":"来てくれたか。","nextNodeIds":[715020102]},{"nodeId":715020102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4204784346,"text":"おう、手伝いに来たぞ！","nextNodeIds":[715020103]},{"nodeId":715020103,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3078827258,"text":"今、「プルシナスパイク」をチェックしているところだ。璃月の鉱夫たちは逞しいよ。たった二人だけで、このスパイクをここまで運んでくれるなんて。","nextNodeIds":[715020104]},{"nodeId":715020104,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":727406594,"text":"ただ、「プルシナスパイク」は繊細なパーツを含んでいる。運送時にその影響を受けていないか確かめないといけない…当然、理論上は問題がないはずだけど。","nextNodeIds":[715020105]},{"nodeId":715020105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3462948994,"text":"#前回も理論上は問題ないとか言ってたけど、オイラと{NICKNAME}は大変な目に遭ったぞ！","nextNodeIds":[715020106]},{"nodeId":715020106,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1959152570,"text":"コホン、理論と現実には違いが生じるものだ。でも、君が来る前にすべてチェックしたから大丈夫。","nextNodeIds":[715020107]},{"nodeId":715020107,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":487602362,"text":"準備はもう終わったから、あとは起動させるのみ。元素力で「プルシナスパイク」に初期の駆動力を与えずとも、継続的にチャージされるようになってる。","nextNodeIds":[715020108,715020109]},{"nodeId":715020108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":26889114,"text":"初期の駆動力が必要ない？","nextNodeIds":[715020110]},{"nodeId":715020110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1293265682,"text":"そう、以前は稲妻の環境に適応させるため、雷元素でチャージして動作するように改造した。","nextNodeIds":[715020111]},{"nodeId":715020111,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1147651362,"text":"でも、あれは「プルシナスパイク」が持つ本来の起動方法ではない。","nextNodeIds":[715020112]},{"nodeId":715020112,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":644112026,"text":"元々「プルシナスパイク」はこのような環境で動作することを想定している。この黒泥がそのエネルギー源だ。","nextNodeIds":[715020113]},{"nodeId":715020113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":378000882,"text":"黒泥がエネルギーを供給するの？","nextNodeIds":[715020114]},{"nodeId":715020114,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1728563626,"text":"そういうことだ。つまり「プルシナスパイク」なら、今回の件を見事解決できるってわけさ。","nextNodeIds":[715020115]},{"nodeId":715020115,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1784474650,"text":"考えてみてくれ。今、層岩巨淵で起きている「湧き出す黒泥」をどうにかするには、「病状」と「病巣」という二つの側面から問題を解決しなければならない。","nextNodeIds":[715020116]},{"nodeId":715020116,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1219196138,"text":"その「病巣」とは…","nextNodeIds":[715020117,715020119]},{"nodeId":715020117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4192108034,"text":"地脈？","nextNodeIds":[715020118]},{"nodeId":715020118,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4278744458,"text":"その通り。「病巣の治療」をするには、地脈にある黒泥が湧き出る部分を封鎖する必要がある。","nextNodeIds":[715020122]},{"nodeId":715020122,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1560424610,"text":"でも地脈を封鎖しただけでは、既に湧き出ている黒泥をすべて解決したことにはならない。","nextNodeIds":[715020123]},{"nodeId":715020123,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1878905258,"text":"「プルシナスパイク」は黒泥のエネルギーを吸い取り、その汚染性を減らすことができる。つまりこれが「病状の治療」になるというわけだ。","nextNodeIds":[715020124]},{"nodeId":715020124,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3992756058,"text":"地脈から湧き出る黒泥が「プルシナスパイク」にエネルギーを供給し、そして「プルシナスパイク」が動作することで、黒泥が湧き出る地脈を封鎖できる…","nextNodeIds":[715020125]},{"nodeId":715020125,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":4028210506,"text":"長いこと黒泥の影響を受けてきた魔物たちも、そのエネルギーが無くなれば急激に弱体化するはずだ…","nextNodeIds":[715020126]},{"nodeId":715020126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2949131474,"text":"おお！これで黒泥と地脈や魔物の問題を全部解決できるな！","nextNodeIds":[715020127]},{"nodeId":715020127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":47588210,"text":"オイラが思ってたよりずっとすごいものだったんだな、この「プルプルスパイク」！","nextNodeIds":[715020128]},{"nodeId":715020128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":655536738,"text":"「プルシナスパイク」だ…","nextNodeIds":[715020129]},{"nodeId":715020129,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3756072506,"text":"プルシナ先輩は本当に偉大だよ。まるでこのスパイクも、こういった問題を解決するために作られたかのような感じがする。","nextNodeIds":[715020130]},{"nodeId":715020130,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3753301810,"text":"もし推測通り事が運んで、この湧き出る黒泥を解決できれば、貴重な実験事例になるかもしれない…","nextNodeIds":[715020131]},{"nodeId":715020131,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2374280762,"text":"もしかすると、この「プルシナスパイク」の研究を通じて、プルシナ先輩がどうやって機器で地脈に影響を与えているのか、その原理を解明できるなんてことも…そうしたら、今までに見たことないものをたくさん発見できるに違いない！","nextNodeIds":[715020132]},{"nodeId":715020132,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":532399834,"text":"この研究課題はかなりの価値がある。あぁ…この研究で「教令院」の「カビカバス賞」を受賞できたらいいけど。","nextNodeIds":[715020133,715020134]},{"nodeId":715020133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1745979954,"text":"カビカバス賞？","nextNodeIds":[715020135]},{"nodeId":715020135,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2410459810,"text":"これは「教令院」が若き学者へと贈る特別な賞だ。","nextNodeIds":[715020136]},{"nodeId":715020136,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":472147698,"text":"毎年、学院の賢者たちがその年に提出された研究レポートを読んで、投票で受賞者を決めている。","nextNodeIds":[715020137]},{"nodeId":715020137,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1104696026,"text":"受賞資格のある者は40歳以下で、研究している課題が画期的、かつ優れた革新力を持ち、自己啓発を怠らない人に限られる。","nextNodeIds":[715020138]},{"nodeId":715020138,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2883479842,"text":"40歳までに「カビカバス賞」を受賞した学者は皆その後、スメールの学術界に名が知れ渡っているんだ。","nextNodeIds":[715020139]},{"nodeId":715020139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3029771282,"text":"そんなにすごいのか！","nextNodeIds":[715020140]},{"nodeId":715020140,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":481265754,"text":"すぐに「プルシナスパイク」を起動しよう。これで鉱区に湧いた黒泥を取り除ければいいが。","nextNodeIds":[715020141]},{"nodeId":715020141,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":364334274,"text":"#ただ、{NICKNAME}、気を付けてほしい。「プルシナスパイク」は偉大な機械だが、それゆえ精密で壊れやすい。","nextNodeIds":[715020142]},{"nodeId":715020142,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":953421266,"text":"もし動作中に衝撃を受けたり、黒泥に覆われたりしたら、スパイクは直ちに自動停止する。より深刻なダメージを回避するためにね。","nextNodeIds":[715020143]},{"nodeId":715020143,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1853385082,"text":"だから、チャージ中は黒泥と近づいてくる魔物たちに気を付けてくれ。","nextNodeIds":[]},{"nodeId":715020134,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3082206954,"text":"それって何？","nextNodeIds":[715020135]},{"nodeId":715020119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3120746426,"text":"湧き出る黒泥？","nextNodeIds":[715020120]},{"nodeId":715020120,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":361991914,"text":"いや、湧き出る黒泥は表面的な問題に過ぎない。その根本は地脈にある黒泥が湧き出る部分だ。","nextNodeIds":[715020121]},{"nodeId":715020121,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2239476770,"text":"だから「病巣の治療」とは、つまり「プルシナスパイク」で地脈を封鎖するということになる。","nextNodeIds":[715020122]},{"nodeId":715020109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3127707258,"text":"継続的にチャージされる？","nextNodeIds":[715020110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["166001688","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE