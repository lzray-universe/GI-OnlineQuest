riority":5,"questId":74678,"showRandomTalkCount":0},"dialogs":[{"nodeId":746780101,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":246553210,"text":"私闘だ私闘だ！引っ捕らえろー！","nextNodeIds":[746780102]},{"nodeId":746780102,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1681940722,"text":"危険な秘境を発見しておきながら、すぐに執律庭に報告せず、勝手に調査して武力を行使するなんて…どうかしてるよ！","nextNodeIds":[746780103]},{"nodeId":746780103,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"コスタンティン","textMapHash":2919382770,"text":"おおおお役人様ッ！第一に私はフォンテーヌ廷におりません。第二に相手は魔物です。それでも逮捕されるんですか？","nextNodeIds":[746780104]},{"nodeId":746780104,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":3426337738,"text":"じゃあ君は冒険者協会の登録メンバーなの？","nextNodeIds":[746780105]},{"nodeId":746780105,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"コスタンティン","textMapHash":1846557842,"text":"いいえ…私は身体能力が足りなくて、試験に落ちたので…","nextNodeIds":[746780106]},{"nodeId":746780106,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":3552438730,"text":"じゃあ、フォンテーヌ域内で武器を使う必要があるって、事前に執律庭に届け出た？","nextNodeIds":[746780107]},{"nodeId":746780107,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"コスタンティン","textMapHash":445955802,"text":"そんなことまで？武器を使うのにも届け出が必要なんですか？","nextNodeIds":[746780108]},{"nodeId":746780108,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1754336618,"text":"もちろんだよ！でなきゃ誰でも勝手にフォンテーヌでケンカできることになって、執律庭はお飾りになっちゃうでしょ。","nextNodeIds":[746780109]},{"nodeId":746780109,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":2958436834,"text":"届け出の情報がなかったら、警備ロボは武器を持っておかしなことばかりしてる君みたいなやつを侵入者と見なすんだから気をつけてよね！","nextNodeIds":[746780110]},{"nodeId":746780110,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1972689362,"text":"自分を見てごらんよ——まるでフォンテーヌ人に変装してるみたいだ。逮捕されても仕方ないでしょ？","nextNodeIds":[746780111]},{"nodeId":746780111,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"コスタンティン","textMapHash":3976377194,"text":"これは誤算だった…！作家でありながら取材が不十分で、重要な基本設定を見落としてしまうとは…作家失格だ！","nextNodeIds":[746780112,746780113]},{"nodeId":746780112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":814157354,"text":"#{M#俺}{F#私}たちはいつも勝手に秘境を調査してるけど？","nextNodeIds":[746780114]},{"nodeId":746780114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":299984018,"text":"オイラたちはとっくに冒険者になってるから、問題ないんじゃないか？","nextNodeIds":[746780115]},{"nodeId":746780115,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":2998394034,"text":"あれ？君たち二人も来てたんだね。よっ、有名人！","nextNodeIds":[746780116]},{"nodeId":746780116,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1710689410,"text":"コホン、私はアンジェニーナ。長年野外で見張りをしてきたベテラン警察隊員だよ。ちょっと前に近くをパトロールしてたら、このおっちょこちょいを見つけて…","nextNodeIds":[746780117]},{"nodeId":746780117,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1622902418,"text":"ここでうろちょろしていた理由については彼から聞いたよ。この奇妙な秘境のこともね。さらに君たち二人もこの「剣舞」に参加したって聞いたけど。","nextNodeIds":[746780118]},{"nodeId":746780118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3425988258,"text":"うっ！","nextNodeIds":[746780119,746780120]},{"nodeId":746780119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1166743210,"text":"#{M#俺}{F#私}たちは秘境で楽しく遊んでただけ。","nextNodeIds":[746780121]},{"nodeId":746780121,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":2223171970,"text":"もちろんそんなことしない。むしろ逆だよ。君たちは正義のために勇敢に行動する立派な冒険者だから、報奨金をあげる！","nextNodeIds":[746780122]},{"nodeId":746780122,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":2863118674,"text":"今回私たちが取り締まっているのは「無申告で勝手に武力を行使している」って件だけだからね。こいつを捕まえて戻っても、ただ口頭で注意するだけだよ。","nextNodeIds":[746780123]},{"nodeId":746780123,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1597002818,"text":"彼も決定的な大犯罪を犯したってわけじゃないから、もちろん重い罰を受けることはない。","nextNodeIds":[746780124]},{"nodeId":746780124,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"コスタンティン","textMapHash":1783847722,"text":"罰金を払えと言われても、モラはそんなに出せないかもしれません…","nextNodeIds":[746780125]},{"nodeId":746780125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3561727762,"text":"まあまあ！","nextNodeIds":[746780126]},{"nodeId":746780126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3171573402,"text":"コスタンティンの話は大げさだけど、別に悪いやつじゃないぞ…ただ、いい小説を書こうとして、華麗な戦いの表現に夢中になってるだけなんだ。","nextNodeIds":[746780127]},{"nodeId":746780127,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1618545634,"text":"聞いた？二人の有名人が君の肩を持ってくれてるよ…もう二度とこんな過ちは犯さないようにね、そそっかしい善人さん！","nextNodeIds":[746780128]},{"nodeId":746780128,"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"コスタンティン","textMapHash":1320919682,"text":"次は必ず十分な事前準備をしてから、現地取材に来ます！","nextNodeIds":[746780129]},{"nodeId":746780129,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":3485226698,"text":"とにかく、こっちは規則通りに処理するよ。まず執律庭に連れて戻って、よく言い聞かせるから。","nextNodeIds":[746780130]},{"nodeId":746780130,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":173674378,"text":"しばらくしたら、他の警察隊員が駆けつけて、この秘境を取り締まることになる…","nextNodeIds":[746780131]},{"nodeId":746780131,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":1193667098,"text":"でも、君たち二人がいてくれるなら、この秘境も脅威にはならないな。","nextNodeIds":[746780132]},{"nodeId":746780132,"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","textMapHash":3528945562,"text":"ねえねえ、もしまだ興味があるなら、引き続き中で戦って、もっと魔物を倒してくれないかな…この後の警察隊員の仕事も減るから、大助かりだよ！","nextNodeIds":[746780133]},{"nodeId":746780133,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":168438458,"text":"結局いつのまにか「正義のために勇敢に戦う善人」になって、剣舞作家と執律庭の両方から報酬をもらうことになっちゃったぜ…骨折り損にならなくて済んだ…よな？","nextNodeIds":[]},{"nodeId":746780120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3249487090,"text":"#{M#俺}{F#私}たちも一緒に連行されるの？","nextNodeIds":[746780121]},{"nodeId":746780113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":260094674,"text":"#{M#俺}{F#私}たちも届け出なんてしてないよね？","nextNodeIds":[746780114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30483"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7467801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30421,"speakerName":"アンジェニーナ","count":18},{"roleType":"TALK_ROLE_NPC","speakerId":30483,"speakerName":"コスタンティン","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[174678],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1304660854,"CHECNJEMEFE":{"30421":[1230]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/GoalChallenge_74678/Q7467801","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":