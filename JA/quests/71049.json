ram":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7104902","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7104902,"initDialog":710490201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1627],"performCfg":"","priority":5,"questId":71049,"showRandomTalkCount":0},"dialogs":[{"nodeId":710490201,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":4144906570,"text":"すみませんがまだ用事がありまして、他にご用があれば後ほど伺いますね！","nextNodeIds":[710490202,710490207,710490212]},{"nodeId":710490202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4191670434,"text":"層岩巨淵について…","nextNodeIds":[710490203]},{"nodeId":710490203,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":1613971858,"text":"ああっ、私ったら…層岩巨淵の事情もご説明せずに、依頼を託すなんて！失礼しました！","nextNodeIds":[710490204]},{"nodeId":710490204,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":2778491338,"text":"実は私も詳しくはないのですが、事の起こりは数年前でした…あそこの鉱夫が変なものを掘り出して…それが何なのか、私たちは知らないし、聞く勇気もありませんでした。","nextNodeIds":[710490205]},{"nodeId":710490205,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":2397387794,"text":"輝山庁が七星に報告した後、凝光様の秘書が調査隊を派遣しました。そして調査隊が戻ったら、安全上の懸念があると言って、鉱坑を封鎖したんです…","nextNodeIds":[710490206]},{"nodeId":710490206,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":416228962,"text":"そうして今の層岩巨淵になったというわけです。盛露庁のお方たちは毎日、いつ再開できるか尋ねています。ですが、七星がどうしても許可してくれないんですから、焦りながらも待つしかありません…","nextNodeIds":[]},{"nodeId":710490207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3607287818,"text":"沐寧について…","nextNodeIds":[710490208]},{"nodeId":710490208,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":1463173682,"text":"ええ、彼の生家は盛露庁でも屈指の陶磁器商なんです。でも彼自身は家の商売には興味がなく、ただただ食べたり遊んだりするのが好きで…","nextNodeIds":[710490209]},{"nodeId":710490209,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":3170986674,"text":"経営もモラの管理も全く分からないものですから、借金もかなり抱えています…家族は彼が家の評判を落とすかもしれないと心配し、彼を総務司に送り込んだんです。責任感ある立場に置いて鍛えようとしているみたいで…","nextNodeIds":[710490210]},{"nodeId":710490210,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":3743106482,"text":"ちょうど総務司も層岩巨淵を監視する盛露庁の専門家が必要だったので、彼を雇いました。","nextNodeIds":[710490211]},{"nodeId":710490211,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":2946545770,"text":"まあ、いい事だと思いますよ。私の父も、層岩巨淵は修行の場だと言ってました。父は若い頃、あの鉱区に入ったことがあって…","nextNodeIds":[]},{"nodeId":710490212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1083860466,"text":"また後で。","nextNodeIds":[710490213]},{"nodeId":710490213,"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","textMapHash":1561566226,"text":"ええ、いってらっしゃい。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7104405,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7104405,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[800402,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["101697","1"],"PAINLIBBLDK":"QUEST_EXEC_DEL_PACK_ITEM"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2061"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7104902],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1627,"speakerName":"阿旭","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3793208814,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_RANK_ZERO_WQ","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIIDBOAG":false,"IEFDIICFIJK":710490201,"ILHD