,"speakerId":1055,"speakerName":"ドリー","textMapHash":3291605834,"text":"またまた、サングマハベイ様の情報販売のお時間ですの！","nextNodeIds":[735220102]},{"nodeId":735220102,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"ドリー","textMapHash":1171271106,"text":"お二人とも、最新の情報はいかがです？ふむふむ。今回の情報はそんなに重要じゃありませんから、たったの五十万モラで結構ですわよ！","nextNodeIds":[735220103]},{"nodeId":735220103,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"ドリー","textMapHash":2480963458,"text":"前の価格と比べたらなんと半分！本当にお買い得ですわね！","nextNodeIds":[735220104]},{"nodeId":735220104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4236984018,"text":"タダでいいよね？","nextNodeIds":[735220105]},{"nodeId":735220105,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"ドリー","textMapHash":2224354642,"text":"オホンッ、一気にゼロまで値下げ交渉されるとは、さすがに予想外でしたわ…","nextNodeIds":[735220106]},{"nodeId":735220106,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"ドリー","textMapHash":810229746,"text":"ですが…私は優しいサングマハベイ様。興味があるのでしたら、タダで教えて差し上げますの。ただし、絶対に口外してはダメですわよ。","nextNodeIds":[735220107]},{"nodeId":735220107,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"ドリー","textMapHash":2805316442,"text":"二十年前、ある参加者は大会に出た後、性格が急に豹変したそうなのです！","nextNodeIds":[735220108]},{"nodeId":735220108,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"ドリー","textMapHash":1424570922,"text":"それに、アアル村で彼を見たという人もいたらしいんですのよ。でも、最後は一体どこに行ったのかしら？","nextNodeIds":[735220109]},{"nodeId":735220109,"roleType":"TALK_ROLE_NPC","speakerId":1055,"speakerName":"ドリー","textMapHash":1777570746,"text":"さて、無料の情報はここまで。続きが聞きたければ、二百万モラを頂戴しますの。毎度ありありですわあ！","nextNodeIds":[735220110]},{"nodeId":735220110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":21089994,"text":"どう考えても割に合わないだろ！？オイラたちでアアル村に行って、聞いてみようぜ！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1055"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7352202,"order":2,"stepDescription":"アアル村にいる内情を知る者と話す","stepDescTextMapHash":1662268396,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7352202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30356"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7352202,7352203],"talks":[{"talkId":7352202,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352202,"initDialog":735220201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30356],"performCfg":"QuestDialogue/WQ/Sumeru_73522/Q7352202","priority":5,"questId":73522,"showRandomTalkCount":0},"dialogs":[{"nodeId":735220201,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":3611599514,"text":"二十年前か…確かにさる若者が来ておったのう。","nextNodeIds":[735220202]},{"nodeId":735220202,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":6479858,"text":"あの時、生活は今よりずっと苦しかった。貧困、病、無知…私たちはいつもそうしたものに悩まされておった。","nextNodeIds":[735220203]},{"nodeId":735220203,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":1931516674,"text":"あの若者は教令院の出身で、明るい未来があるにも関わらず、喜んでここで辛い生活を共にしてくれた。","nextNodeIds":[735220204]},{"nodeId":735220204,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":288902330,"text":"彼は私たちに知識を、砂嵐と魔物に対応する方法を教えてくれた。自分のお金で薬をたくさん買ってくれて、病人の看病まで自ら買って出たのじゃ。","nextNodeIds":[735220205]},{"nodeId":735220205,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":147230786,"text":"なんだか、すっごくいい人だったみたいだな！","nextNodeIds":[735220206]},{"nodeId":735220206,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":2250626458,"text":"そうとも…ただ、よい人に限って短命なのが世の常じゃ。","nextNodeIds":[735220207]},{"nodeId":735220207,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":656470458,"text":"彼はいつも眉をひそめていたけど、その理由は誰にもわからなかった。そしてみなは、もしかして彼がここを離れようとしているのでは？と推測し始めたんじゃ。何せここは貧しかったからのう。彼をちゃんともてなしてやることもできなかった。","nextNodeIds":[735220208]},{"nodeId":735220208,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":2242633658,"text":"ただ、彼は元から少し気が触れていたのだという人も多くいた。例えば、自分が小さい頃に不思議な生物に文字を教えたと、子供たちに話していたとか。","nextNodeIds":[735220209]},{"nodeId":735220209,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":3728772514,"text":"そして後になって、彼は村を離れて砂漠へ調査に出かけたんじゃ。何を探しているのか聞いたら、彼はナガ…なんとか団の人と話すのだと言った。","nextNodeIds":[735220210]},{"nodeId":735220210,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":2719397794,"text":"最終的に、流砂で命を落としたらしい。聞いた話によれば、彼は調査の途中で流砂に囚われたキャラバンに出会ったそうじゃ。多くの人を救ったものの、彼自身は帰らぬ人に…","nextNodeIds":[735220211]},{"nodeId":735220211,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":2378122634,"text":"当時、家には書きかけの手紙があった。彼が自分の子供にあてたものじゃ。彼が亡くなった後も、私の息子はあの手紙をずっと持っていた。いつか、彼に代わって子供に渡す機会があるかもしれないってね。","nextNodeIds":[735220212]},{"nodeId":735220212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":525669754,"text":"その手紙…まだ持ってるのか？","nextNodeIds":[735220213]},{"nodeId":735220213,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":2112319482,"text":"いや、それがもうないんじゃ…","nextNodeIds":[735220214]},{"nodeId":735220214,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":2038982898,"text":"生活のために、息子は傭兵になった。そして数年前の戦いで命を落とし、持ち物は全て奪われてしまった。","nextNodeIds":[735220215]},{"nodeId":735220215,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":4187451274,"text":"あれから、もうそんなに経つかね。彼の子供は、無事に育っているのじゃろうか？彼のことを、恨んだりしていないじゃろうか？","nextNodeIds":[735220216]},{"nodeId":735220216,"roleType":"TALK_ROLE_NPC","speakerId":30356,"speakerName":"リシュティ","textMapHash":978931418,"text":"そんなこと、もう誰にもわからないだろうがねえ。私ももう年だ。そう遠くないうちに、さっぱり忘れてしまうかもしれないね。","nextNodeIds":[]}]},{"talkId":7352203,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7352202","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7352203,"initDialog":735220301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1055],"performCfg":"QuestDialogue/WQ/Sumeru_73522/Q7352203","priority":5,"questId":73522,"showRandomTalkCount":0},"dialogs":[{"nodeId":735220301,"roleType":"TALK_ROLE_NPC","speakerI