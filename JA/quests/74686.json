y":5,"questId":74686,"showRandomTalkCount":0},"dialogs":[{"nodeId":746860101,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":3665259402,"text":"ごきげんよう、大冒険者さん。","nextNodeIds":[746860102]},{"nodeId":746860102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":416994474,"text":"スーパーエディター様と呼んで。","nextNodeIds":[746860103]},{"nodeId":746860103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1390754378,"text":"広告エキスパートと呼んで。","nextNodeIds":[746860104]},{"nodeId":746860104,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":3074731130,"text":"ははっ、コマーシャル制作が退屈じゃなかったみたいでよかった！貴重な再会の時なのに、つまらないことをさせてしまったかと少し心配していたから、ほっとしたよ。","nextNodeIds":[746860105]},{"nodeId":746860105,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":1868463642,"text":"いつも好きな時に会えるわけじゃないからな。世界を股にかける冒険者を見つけるのなんか、空から星をもぎ取るようなものさ。","nextNodeIds":[746860106]},{"nodeId":746860106,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":2660468050,"text":"こうしてカフェでばったり出会えることもあれば、誰に聞こうが行方を追えないこともあるからなぁ。","nextNodeIds":[746860107]},{"nodeId":746860107,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":4053383642,"text":"良く言えば、お前に会うたびに波乱万丈な物語を聞けて、退屈しない。悪く言えば、どの出会いが最後の出会いになるかわからない。","nextNodeIds":[746860108,746860109]},{"nodeId":746860108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3109948922,"text":"そこまでひどくないでしょ？","nextNodeIds":[746860110]},{"nodeId":746860110,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":1655412338,"text":"ははっ、わかったよ。このまま愚痴り続けたら、よく特集が組まれる寂しい一人暮らしのおじいちゃんみたいになってしまうな。","nextNodeIds":[746860111]},{"nodeId":746860111,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":66566218,"text":"手元のコマーシャルの依頼はほぼ撮影が完了したから、今度は次の長編のために頭を抱えないと。会えない間も、お互い夢のために頑張ろう！","nextNodeIds":[746860112]},{"nodeId":746860112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1566943994,"text":"そうだね。","nextNodeIds":[746860113]},{"nodeId":746860113,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":1714875250,"text":"ああ、でもやはりこれだけは伝えたい——いつか一緒にご飯でも食べよう！場所はフォンテーヌじゃなくても構わない。","nextNodeIds":[746860114]},{"nodeId":746860114,"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","textMapHash":1434766410,"text":"鹿狩り、万民堂、ランバド酒場…キャンプや狩りでも構わないさ…俺がついて行けさえすれば…とにかく、連絡を待っているぞ！","nextNodeIds":[]},{"nodeId":746860109,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2404937530,"text":"ちょくちょく会いに来るよ。","nextNodeIds":[746860110]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7468601,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30771"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7468601],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30771,"speakerName":"グザヴィエ","count":9},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174686],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1114793846,"CHECNJEMEFE":{"30771":[1190]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Fontaine_74686/Q7468601