se,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4014602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4014601,"initDialog":401460101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30501],"performCfg":"QuestDialogue/EQ/V4.5AlchemySim_40146/Q4014601","priority":5,"questId":40146,"showRandomTalkCount":0},"dialogs":[{"nodeId":401460101,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":2285192914,"text":"こんにちは、スメールから来た旅商人のアテフェだよ。お会いできてすっごく光栄！","nextNodeIds":[401460102]},{"nodeId":401460102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2053317450,"text":"えっ、そんなに遠くから来てくれたのか！いつの間にか、オイラたちのお店ってこんなに有名になってたんだな？","nextNodeIds":[401460103,401460105]},{"nodeId":401460103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1945600178,"text":"パイモンのおかげだね。","nextNodeIds":[401460104]},{"nodeId":401460104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1465656162,"text":"えっへん、今おまえの目の前にいるのは、期待の新星、トップセールスのパイモンだぜ！","nextNodeIds":[401460106]},{"nodeId":401460106,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":1405083122,"text":"あははっ、確かに最近、君たちが錬金薬を売ってるって話は、情報通の商人たちの間じゃ噂になってるよ。","nextNodeIds":[401460107]},{"nodeId":401460107,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":131983994,"text":"こういう珍しい商品に関しては、ほとんどの人がリスクを冒したくないって考える。","nextNodeIds":[401460108]},{"nodeId":401460108,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":2938945850,"text":"でも私からすれば…大儲けしたいなら、チャンスを逃すわけにはいかない！","nextNodeIds":[401460109]},{"nodeId":401460109,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":4269172410,"text":"今、一般人はまだ錬金薬のことをそんなに知らないけど、営業手段に合わせて販路を広めれば、どんどんモラが入ってくることは間違いないと思うよ！","nextNodeIds":[401460110]},{"nodeId":401460110,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":2121007474,"text":"一気に名をあげれば、十倍の値段でも売れるかもしれない…へへっ、今回の商売が成功したら、今年いっぱいは休めるだろうね。","nextNodeIds":[401460111]},{"nodeId":401460111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2936683642,"text":"十倍！本気で言ってるのか？","nextNodeIds":[401460112]},{"nodeId":401460112,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":1042674570,"text":"ははっ、誰かが喜んで買ってくれる限りは、どんなに高くても問題ない。それが「互いの合意の上」ってやつだよ。","nextNodeIds":[401460113]},{"nodeId":401460113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4045534746,"text":"その発言…モラのことしか頭にないやつのことを思い出しちゃったぞ…","nextNodeIds":[401460114]},{"nodeId":401460114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3427518770,"text":"えっと、スメールから来たって言ってたよな。まさかドリーと知り合いとかじゃないよな？","nextNodeIds":[401460115]},{"nodeId":401460115,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":1504827394,"text":"ドリーっていうと…もしかしてドリー·サングマハベイ様のこと？あの方と知り合いなの？","nextNodeIds":[401460116,401460117]},{"nodeId":401460116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2937945434,"text":"#彼女は{M#俺}{F#私}の友達。","nextNodeIds":[401460118]},{"nodeId":401460118,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":1495795154,"text":"すごい！私、サングマハベイ様のファンなの。あの方のビジネスセンスとモラに対する執着は、ずっと私の励みになってるんだ…！","nextNodeIds":[401460119]},{"nodeId":401460119,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":1497744994,"text":"昔、アルカサルザライパレスを訪れる機会に恵まれたことがあるけど…本当に立派で美しい邸宅だったな。","nextNodeIds":[401460120]},{"nodeId":401460120,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":4200809386,"text":"いつか私もあの方みたいに、数えきれないほどのモラを手に入れたい…へへへ…","nextNodeIds":[401460121]},{"nodeId":401460121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2098717114,"text":"うぅ…完全に夢の世界に浸っちゃってるぞ。","nextNodeIds":[401460122,401460124]},{"nodeId":401460122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3578858042,"text":"成功を祈るよ。","nextNodeIds":[401460123]},{"nodeId":401460123,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":1877097018,"text":"ありがとう！","nextNodeIds":[401460126]},{"nodeId":401460126,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":1423145450,"text":"それじゃ、大儲けの方法について話そうか。","nextNodeIds":[401460127]},{"nodeId":401460127,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":3208850834,"text":"シンプルな話だよ。定期的に仕入れに来るから、必要なポーションを作ってくれれば、私がそれを他の場所に売ってきてあげる！","nextNodeIds":[401460128]},{"nodeId":401460128,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":233829714,"text":"協力してくれるなら、販売するものについて詳しく話し合おう。","nextNodeIds":[401460129,401460131]},{"nodeId":401460129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":635352042,"text":"リクエストを確認する。","nextNodeIds":[401460130]},{"nodeId":401460130,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":4125055410,"text":"私の勘だと…今回必要なのはこういうポーションだよ。","nextNodeIds":[]},{"nodeId":401460131,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2588066674,"text":"また今度にしよう。","nextNodeIds":[401460132]},{"nodeId":401460132,"roleType":"TALK_ROLE_NPC","speakerId":30501,"speakerName":"アテフェ","textMapHash":2089699458,"text":"お金儲けのチャンスは、