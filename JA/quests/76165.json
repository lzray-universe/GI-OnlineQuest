,"",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7616502,"initDialog":761650201,"nextRandomTalks":[],"nextTalks":[],"npcId":[7647],"performCfg":"","priority":5,"questId":76165,"showRandomTalkCount":0},"dialogs":[{"nodeId":761650201,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":3922255346,"text":"あ、こんにちは。私はパトリチェフ、ライトキーパーの物資事務官です。ご用件をお伺いします。","nextNodeIds":[761650202]},{"nodeId":761650202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3773192386,"text":"「凛風の馬」のパトリチェフ？","nextNodeIds":[761650203]},{"nodeId":761650203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3814752826,"text":"「凛風の馬」？ああ、この前見かけた変な光景か…","nextNodeIds":[761650204]},{"nodeId":761650204,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":1245323674,"text":"はい、以前その分隊に所属していました。「凛風の馬」…懐かしい名前です。まさかあなたの口からそんな名前が出るとは思いませんでした。なぜ…？","nextNodeIds":[761650205,761650208]},{"nodeId":761650205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2157149386,"text":"#{M#俺}{F#私}たち、前にキプマキの崖の下に行ったことがあって。","nextNodeIds":[761650206]},{"nodeId":761650206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":829908194,"text":"そうだそうだ、オイラたちはあそこでワイルドハントを片付けたんだぞ。","nextNodeIds":[761650207]},{"nodeId":761650207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1824286034,"text":"それで、「凛風の馬」のライトキーパーとワイルドハントが戦った時の光景を見たんだ…","nextNodeIds":[761650210]},{"nodeId":761650210,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":3283610154,"text":"まさか本当にそんなことがあるなんて…","nextNodeIds":[761650211]},{"nodeId":761650211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2109881410,"text":"本当だぞ！オイラたちの目で見たんだからな！","nextNodeIds":[761650212]},{"nodeId":761650212,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":2583610458,"text":"ああ…ここ数年、キプマキの崖で犠牲になった私の同僚たちの姿を見かけたという人がよくいるんです。だから今でも、よくそこに行っています…墓参りも兼ねて。","nextNodeIds":[761650213]},{"nodeId":761650213,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":538378642,"text":"でも私は一度も…一度も彼らを見ることはできませんでした。ずいぶん時が過ぎて、私を慰めるための作り話だと思っていましたが…","nextNodeIds":[761650214]},{"nodeId":761650214,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":4039064986,"text":"まさかあなたたちが本当に会えたなんて…でも、どうして私が行った時は、みんな会いに出てきてくれないんでしょうね…","nextNodeIds":[761650215,761650217]},{"nodeId":761650215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1454540066,"text":"まだその時じゃないんだよ。","nextNodeIds":[761650216]},{"nodeId":761650216,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":3259822842,"text":"そうかもしれませんね…でも、確かにそこにいることは分かっています。たとえそれが一筋の思い出や一片の虚ろな影だとしても、私には十分です…","nextNodeIds":[761650219]},{"nodeId":761650219,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":3546936026,"text":"とにかく、教えてくださって本当にありがとうございます。私にとっては、本当に大切なことなんです…","nextNodeIds":[761650220]},{"nodeId":761650220,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":3684534362,"text":"今ここに立てているのは彼らのおかげですが…もう一度キプマキの崖の下で彼らと共に戦えたらと、願ってしまいます。","nextNodeIds":[761650221]},{"nodeId":761650221,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":2939205690,"text":"でも…いつか、必ずまた彼らと再会できる日が来るはずです。","nextNodeIds":[]},{"nodeId":761650217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1373324250,"text":"辛い事を思い出してほしくなかったのかも…","nextNodeIds":[761650218]},{"nodeId":761650218,"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","textMapHash":4126939426,"text":"はぁ…最後まで共に戦った時間が、どうして辛いものだったはずがありましょう…","nextNodeIds":[761650219]},{"nodeId":761650208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2904576402,"text":"#{M#俺}{F#私}たちは「凛風の馬」のライトキーパーを見た…","nextNodeIds":[761650209]},{"nodeId":761650209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4230626234,"text":"うん、影しか残ってなかったけど…でもその影にはワイルドハントと戦ってた姿が映ってたんだ…","nextNodeIds":[761650210]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7616502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7616501,7616502],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":7647,"speakerName":"パトリチェフ","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":8},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":360780206,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"","ANDJNFLI