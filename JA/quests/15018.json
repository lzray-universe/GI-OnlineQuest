346,"text":"えへへ、あれは「エコーアリーナ」って言うんだぁ。わたしたちがいろんな大会を開催してる場所なんだよ。","nextNodeIds":[150180803]},{"nodeId":150180803,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":855986026,"text":"ここまで案内してくれてありがとう。","nextNodeIds":[150180804]},{"nodeId":150180804,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":72603002,"text":"どういたしまして～！これくらい朝飯前だよ。","nextNodeIds":[150180815]},{"nodeId":150180815,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":2246588866,"text":"ゆっくりここを案内してあげたいところだけど、実は一回お家に帰らないといけないんだ～","nextNodeIds":[150180816]},{"nodeId":150180816,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2162233418,"text":"なにか大事な用事でも思い出したのか？さっきヒルチャールが現れたときも、かなり急いでたみたいだったけど…","nextNodeIds":[150180817]},{"nodeId":150180817,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1519778922,"text":"もしかして邪魔しちゃった？","nextNodeIds":[150180818]},{"nodeId":150180818,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":2543952146,"text":"ぜんぜん大丈夫だよ、時間にも余裕あったし！でもこれはわたしにとって、すご～く重要なことなんだ。トレーニング後の一番大切なこと、それは…ご飯を食べることだよ！","nextNodeIds":[150180805]},{"nodeId":150180805,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":2149340074,"text":"お腹が空いたら力が出なくなるし、目まいもしちゃう。それから頭がふらふらして変なことばっかり考えるし、身体に悪いことだらけでしょ？だから、絶対に気をつけないとダメなんだよ。","nextNodeIds":[150180806]},{"nodeId":150180806,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":920981242,"text":"ほんとごめんねぇ！どうしてもわたし、今すぐ、今すぐご飯を食べなきゃ！きみたちも早くご飯を食べてね！","nextNodeIds":[150180807]},{"nodeId":150180807,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":387005722,"text":"それじゃ、あとでまた「エコーアリーナ」で会おう。バイバーイ！","nextNodeIds":[150180808]},{"nodeId":150180808,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":633028786,"text":"ヴァレサのやつ、もう行っちゃったぞ…","nextNodeIds":[150180809]},{"nodeId":150180809,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":244044970,"text":"なんていうか、不思議な子だったな。ふわふわしてるかと思えば、すごい勢いがあったり…","nextNodeIds":[150180810]},{"nodeId":150180810,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1028265570,"text":"これぞ「青春」だ。","nextNodeIds":[150180811]},{"nodeId":150180811,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1768827890,"text":"「これぞ『青春』だ」——って、急に年寄りみたいなこと言うなよ！オイラもおまえもまだ若いだろ！","nextNodeIds":[150180812]},{"nodeId":150180812,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4132656058,"text":"ヴァレサも帰っちゃったことだし、オイラたちだけでこの辺をぶらぶらしてみようぜ。「エコーアリーナ」にはあとで行こう。","nextNodeIds":[150180813]},{"nodeId":150180813,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1959967106,"text":"あんなに高いところなら、きっと見晴らしも最高なはずだぞ！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1501808,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133515136","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["1501801","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_10439:-2662.970,281.297,10097.400,0.000,310.043,0.000]"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[1501801,1501802,1501803,1501804,1501805,1501808],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","count":35},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":31},{"roleType":"TALK