e,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4003303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4003303,"initDialog":400330301,"nextRandomTalks":[],"nextTalks":[],"npcId":[3042],"performCfg":"QuestDialogue/EQ/Dog1_40033/Q4003303","priority":5,"questId":40033,"showRandomTalkCount":0},"dialogs":[{"nodeId":400330301,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3008866138,"text":"お疲れ様でした！よかったです！これで数が足りるはず…","nextNodeIds":[400330302]},{"nodeId":400330302,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":106610946,"text":"おや？いくつか足りません…","nextNodeIds":[400330303]},{"nodeId":400330303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2456384650,"text":"えっ、そんな…なんかどうやっても終わらない気が…","nextNodeIds":[400330304]},{"nodeId":400330304,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2959777866,"text":"確かに、事件調査には根気が必要な時もあります。もし方向性を間違えてしまえば、今までの苦労が無駄になってしまうでしょう。","nextNodeIds":[400330305]},{"nodeId":400330305,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1348719162,"text":"少なくとも今はたくさんの動物たちを取り戻せました。方向性は合っていると思います。","nextNodeIds":[400330306]},{"nodeId":400330306,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":25496610,"text":"ただ、何か手がかりを見逃しているか、まだ思いついていない点があるのかもしれません。ですが、きっとそれも一時的なものでしょう。","nextNodeIds":[400330307]},{"nodeId":400330307,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3445495874,"text":"あっ、わかったぞ！それって、ピキーンって感覚が足りないってことだよな！","nextNodeIds":[400330308]},{"nodeId":400330308,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2559358474,"text":"ピキーンという感覚…そうですね、そうとも言えるでしょう。私たちの進展は決して遅いものではありません、それも旅人さんとパイモンさんのおかげです。そこまで気に病む必要はありませんよ。","nextNodeIds":[400330309,400330310]},{"nodeId":400330309,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2975378418,"text":"（パイモンの言葉が分かるなんて…）","nextNodeIds":[400330311]},{"nodeId":400330311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4167579066,"text":"えへへ、おまえの言うことってすごく正しいと思うぞ。","nextNodeIds":[400330312]},{"nodeId":400330312,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":753277322,"text":"そんなことはありませんよ。ただ事件の調査で培ってきた経験に過ぎません。","nextNodeIds":[400330313]},{"nodeId":400330313,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2450296922,"text":"謎が深まるほど、探求する価値が高くなります。","nextNodeIds":[400330314]},{"nodeId":400330314,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3093612914,"text":"ただ残念ながら、今は他に情報がありません…","nextNodeIds":[400330315]},{"nodeId":400330315,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1286247194,"text":"こうしましょう。私は先に珊瑚所長に今の状況を報告してきます。","nextNodeIds":[400330316]},{"nodeId":400330316,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2844779170,"text":"珊瑚所長ならきっと、私たちが思いつかなかった点を見つけられるはずです。","nextNodeIds":[400330317]},{"nodeId":400330317,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2062737762,"text":"おう！おまえの言うことは正しいから、言う通りにするぜ！","nextNodeIds":[400330318]},{"nodeId":400330318,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2903319154,"text":"では決まりですね。またいつもの場所で落ち合いましょう。","nextNodeIds":[400330319]},{"nodeId":400330319,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2995959794,"text":"もし私がまた何かの事情で来られない時は、直接珊瑚所長を訪ねてください。","nextNodeIds":[]},{"nodeId":400330310,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1732494858,"text":"（龍二はもうパイモンを理解してる…）","nextNodeIds":[400330311]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[4003303,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3042"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[4003301,4003303,4003351,4003352],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","count":28},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4},{"roleType":"TALK_ROLE_NPC","speakerId":3041,"speakerName":"珊瑚","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":503723374,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/EQ/Dog1_40033/Q4003301","ANDJN