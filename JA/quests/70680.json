"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7068001,"initDialog":706800101,"nextRandomTalks":[],"nextTalks":[],"npcId":[9500],"performCfg":"QuestDialogue/WQ/Wolf_70680/Q7068001","priority":5,"questId":70680,"showRandomTalkCount":0},"dialogs":[{"nodeId":706800101,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":1479566706,"text":"お客さん、こっちこっち。","nextNodeIds":[706800102]},{"nodeId":706800102,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":2193604562,"text":"いい知らせがあるんだ。ちょっと遅くなっちゃったけど…新しい舞台を用意できたぞ！","nextNodeIds":[706800103]},{"nodeId":706800103,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":1928346394,"text":"観客に素晴らしいショーを披露したお客さんは、絵の世界の扉を開く鍵を入手できる…","nextNodeIds":[706800104]},{"nodeId":706800104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":396653402,"text":"待て待て！物語の本の次は絵の世界なのか？この場所、ますますワケがわからなくなってきたぞ…","nextNodeIds":[706800105]},{"nodeId":706800105,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":120146530,"text":"言いたいことは分かるぞ！でも、物語の本でこんな話を読んだことがあるんだ——マジシャンが観客にタネ明かしするのは、観客の楽しみを奪うことだって。","nextNodeIds":[706800106]},{"nodeId":706800106,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":3815328394,"text":"だから、分からないくらいがちょうどいいんだ。魔女の姉ちゃんの魔法は愛と同じで、考えるんじゃなくて感じるものなんだよ。","nextNodeIds":[706800107]},{"nodeId":706800107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1335584058,"text":"まぁそう言われると、納得できるような…でも絵の世界の舞台は、前の舞台とどう違うんだ？","nextNodeIds":[706800108]},{"nodeId":706800108,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":3475602010,"text":"絵の世界にはルールがたくさんあるんだ。新しい舞台では「友情」と「信頼」関係が試される。物語によくあるテーマだな！","nextNodeIds":[706800109]},{"nodeId":706800109,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":575995610,"text":"そして試練を乗り越えた人は、魔女の姉ちゃんから小さな祝福をもらえる…","nextNodeIds":[706800110]},{"nodeId":706800110,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2355395082,"text":"えっ？幸運を呼ぶおまじないとかか？だったら…","nextNodeIds":[706800111,706800112]},{"nodeId":706800111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1322220682,"text":"気軽に願い事をしないほうがいい…","nextNodeIds":[706800113]},{"nodeId":706800113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1882965010,"text":"うっ！たしかに、気軽に願い事なんてしちゃいけないよな…","nextNodeIds":[706800114]},{"nodeId":706800114,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":12768306,"text":"絵の具はもう額縁に落とされた。魔女の姉ちゃんがくれる小さな祝福ももう秘密じゃない。","nextNodeIds":[706800115]},{"nodeId":706800115,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":3784458498,"text":"お客さん！準備ができたら、絵の世界の舞台に入ってみてくれ。","nextNodeIds":[706800116]},{"nodeId":706800116,"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","textMapHash":2183980730,"text":"「口笛を吹いて、悩みを忘れて、勇気を胸に抱くんだ！」——物語の登場人物が新しい冒険へ出るときみたいにな！","nextNodeIds":[]},{"nodeId":706800112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1842533066,"text":"たぶん違うと思う、それに…","nextNodeIds":[706800113]}]}],"questNarration":[],"talkIds":[7068001],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":9500,"speakerName":"子オオカミ","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":4},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170680],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3468494710,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJ