507,"showRandomTalkCount":0},"dialogs":[{"nodeId":715070101,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2190732074,"text":"この効果は私が思っていたよりもずっと良い。現象もデータもすべて記録されている…","nextNodeIds":[715070102]},{"nodeId":715070102,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2317812626,"text":"そして何より重要なのが、ここの黒泥がすべて取り除かれた点だ。","nextNodeIds":[715070103]},{"nodeId":715070103,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3473200346,"text":"ただ、うん…","nextNodeIds":[715070104]},{"nodeId":715070104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3369452466,"text":"なんでまだ不満そうな顔してるんだ？鉱区がきれいになったんだし、いいことじゃないか？","nextNodeIds":[715070105]},{"nodeId":715070105,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2333889858,"text":"いや…前にヘディーヴと一緒に分析した時、黒泥を出している地脈の出口は鉱区にあるという結論に至ったんだ。","nextNodeIds":[715070106]},{"nodeId":715070106,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1344550898,"text":"だが、地脈の出口がそう簡単にきれいになるはずがない。つまり、その出口は他にあることになる…","nextNodeIds":[715070107]},{"nodeId":715070107,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1646577458,"text":"鉱区を除いて、今回黒泥が湧き出たことで影響を受けたエリアは…","nextNodeIds":[715070108]},{"nodeId":715070108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":905461482,"text":"前線坑道。","nextNodeIds":[715070109]},{"nodeId":715070109,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2541270586,"text":"そう…黒泥を出している地脈の出口は坑道のエリアにあるということだ。坑道はここより狭いし、黒泥も溜まりやすい。つまり、魔物を引き寄せやすく、より深刻な問題に発展する可能性がある。","nextNodeIds":[715070110]},{"nodeId":715070110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":101723930,"text":"だが、私は「プルシナスパイク」を信じている。","nextNodeIds":[715070111]},{"nodeId":715070111,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3665776362,"text":"これはプルシナ先輩が作った偉大な機器なのだから。","nextNodeIds":[715070112]},{"nodeId":715070112,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3479467514,"text":"でも、まずは修理をしないといけない。それが終わったら、約束した鉱夫たちが下りて来るのを待ち、スパイクを坑道まで運ぶ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7150701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30181"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7150701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":1},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1522884222,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_ACTIVITY","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[71503],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/TheChasmChallenge/Q7150701","ANDJNFLIDIJ":"PLAY_MODE_HOST","AOLKCANJCMJ":15,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJ