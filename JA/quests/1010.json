riorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["101005","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":101005,"initDialog":10100501,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/AQ/Liyue1_1010/Q101005","priority":6,"questId":1010,"showRandomTalkCount":0},"dialogs":[{"nodeId":10100501,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":245316945,"text":"紹介するよ。こちらは稼業人で、「往生堂」の客卿、鍾離先生だ。","nextNodeIds":[10100502,10100503]},{"nodeId":10100502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2104485113,"text":"稼業人！？","nextNodeIds":[10100504]},{"nodeId":10100504,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":2560311633,"text":"うん、璃月で「往生堂」のような仕事は、どうしても「稼業人」との商売を避けられないからね。","nextNodeIds":[10100505]},{"nodeId":10100505,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3023357329,"text":"俺たちファデュイは、こういう…影の下を歩くお友達と付き合うのが好きなんだよ。","nextNodeIds":[10100506]},{"nodeId":10100506,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3936516025,"text":"影の下を歩く…","nextNodeIds":[10100507]},{"nodeId":10100507,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2951253737,"text":"初めまして。お前たちがモンドで活躍した噂を耳にしたことがある。","nextNodeIds":[10100508]},{"nodeId":10100508,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2511924001,"text":"稼業人…影…人を「往生」…あっ！まさか、「往生堂」っていうのは…","nextNodeIds":[10100509]},{"nodeId":10100509,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3706025633,"text":"そうだ、お前の想像通りだ。","nextNodeIds":[10100510]},{"nodeId":10100510,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2382279825,"text":"ひぃ——！","nextNodeIds":[10100511]},{"nodeId":10100511,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2501377625,"text":"「往生堂」とは葬儀業者で、人々を安心して極楽浄土へと送り出すためにある。","nextNodeIds":[10100512]},{"nodeId":10100512,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3957749753,"text":"あ、あれ。","nextNodeIds":[10100513]},{"nodeId":10100513,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":499157529,"text":"ははっ、まさか鍾離先生が殺し屋かと思ったのかな？","nextNodeIds":[10100514]},{"nodeId":10100514,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3002635177,"text":"ファデュイのお友達の中には確かに殺し屋はたくさんいるけど、「往生堂」は違うよ…少なくとも表向きはね。","nextNodeIds":[10100515]},{"nodeId":10100515,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3852559433,"text":"表向き…","nextNodeIds":[10100516]},{"nodeId":10100516,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3752901913,"text":"一応「稼業人」だからね、詳細は言えない。とにかく、君たちに紹介した理由は…","nextNodeIds":[10100517]},{"nodeId":10100517,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":755822081,"text":"俺なら、お前たちに岩王帝君の仙体に会わせられる。","nextNodeIds":[10100518]},{"nodeId":10100518,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1203917537,"text":"なんだって！？","nextNodeIds":[10100519]},{"nodeId":10100519,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1700080913,"text":"ははっ、驚くことはないよ。「天権」凝光の企みのせいで、岩神の仙体は隠されてしまったけど…まあ、まずは鍾離先生の話を聞こう。","nextNodeIds":[10100520]},{"nodeId":10100520,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3516369393,"text":"岩王帝君は仙人たちの祖だが、仙人の一人だ。璃月数千年の歴史を見ていくと、仙人が去っていく傾向は紛れもない事実としてある。","nextNodeIds":[10100521]},{"nodeId":10100521,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":4292128473,"text":"なぜなら時代が変わったからだ——絶雲の間を訪れた時、そういう変化をお前たちも感じただろう。","nextNodeIds":[10100522,10100523]},{"nodeId":10100522,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1808513817,"text":"確かに、仙人たちは璃月を離れている。","nextNodeIds":[10100525]},{"nodeId":10100525,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2971341129,"text":"見ての通り、仙人の時代は遠ざかりつつあり、人の時代こそが徐々に現実となりつつあるんだ。","nextNodeIds":[10100526]},{"nodeId":10100526,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2539693233,"text":"昔、仙人が去ると盛大な儀式が執り行われていた。それが璃月の伝統だ。しかし、今回の件については七星までもがその伝統を蔑ろにしている…見ていられない。","nextNodeIds":[10100527]},{"nodeId":10100527,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3962949457,"text":"何せ「神殺し事件」だから…","nextNodeIds":[10100528]},{"nodeId":10100528,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2826637113,"text":"そうだよ、真犯人もまだ捕まってない。","nextNodeIds":[10100529]},{"nodeId":10100529,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1479543969,"text":"神殺し事件…それについて「往生堂」は気になどしていない。「往生堂」が気にしているのは、仙人を迎える迎仙儀式が盛大に行われている反面、去った仙人を送る送仙儀式が放置されている。","nextNodeIds":[10100530]},{"nodeId":10100530,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3847921169,"text":"旅人よ、「公子」殿からお前のことを聞いた。お前は風神の友人なのだろう…俺と共に、岩神を送る儀式の準備をしてくれないか？","nextNodeIds":[10100531,10100534,10100536]},{"nodeId":10100531,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2678779753,"text":"少し考えさせて…","nextNodeIds":[10100532]},{"nodeId":10100532,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3262616129,"text":"#うーん…{NICKNAME}、よく考えてみても、他に方法はなさそうだぞ…","nextNodeIds":[10100533]},{"nodeId":10100533,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":626072353,"text":"そうだよ、これ以上考えても結果は同じだ。","nextNodeIds":[10100539]},{"nodeId":10100539,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1364785081,"text":"「天権」凝光…彼女は帝君の仙体を見ることを禁じた。無事、七神を訪ねたいのなら、君にはこの方法しか残ってない。","nextNodeIds":[10100540]},{"nodeId":10100540,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2213450617,"text":"その通りだ。「送仙儀式」に参加することだけが、岩神の体に会うことのできる唯一の機会だろう。","nextNodeIds":[10100541]},{"nodeId":10100541,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2292722449,"text":"それしか方法がないみたいだ。","nextNodeIds":[10100542]},{"nodeId":10100542,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3671840705,"text":"ああ、納得したのなら、俺についてこい。詳細は歩きながら話そう。","nextNodeIds":[10100543]},{"nodeId":10100543,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":665412137,"text":"（黑屏、鍾離出门）","nextNodeIds":[10100544]},{"nodeId":10100544,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1529889825,"text":"よしっ、これで俺の橋渡しとしての役目は終わった。どう？なかなかの結果だろう？","nextNodeIds":[10100545]},{"nodeId":10100545,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":1122494473,"text":"さあ、行くなら早くした方がいい、俺のことは気にしないで。ここで数杯いただいて…ついでに「箸」の使い方でも練習してるから。","nextNodeIds":[]},{"nodeId":10100534,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":743403089,"text":"準備を手伝ってもいい…","nextNodeIds":[10100535]},{"nodeId":10100535,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":995899153,"text":"賢明な判断だ。","nextNodeIds":[10100539]},{"nodeId":10100536,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":39909473,"text":"「公子」の口数が多すぎる。","nextNodeIds":[10100537]},{"nodeId":10100537,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":190829521,"text":"へえ？「稼業人」のルールだと、それは口封じを意味する言葉だけど…面白い、剣を抜け、いざここで——","nextNodeIds":[10100538]},{"nodeId":10100538,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":2607759361,"text":"冗談だよ。本題に戻るよ。","nextNodeIds":[10100539]},{"nodeId":10100523,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1118951417,"text":"七神の岩神も、仙人？","nextNodeIds":[10100524]},{"nodeId":10100524,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":701845881,"text":"岩神には様々な尊名がある。契約の神、商業の神、武神、モラクス、岩王帝君…その中に「仙人」ももちろん含まれている。","nextNodeIds":[10100525]},{"nodeId":10100503,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":10145705,"text":"往生堂？","nextNodeIds":[10100504]}]},{"talkId":10100501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["101005","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["101006","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":10100501,"initDialog":10100580,"nextRandomTalks":[],"nextTalks":[],"npcId":[10200],"performCfg":"QuestDialogue/AQ/Liyue1_1010/Q10100501","priority":6,"questId":1010,"showRandomTalkCount":0},"dialogs":[{"nodeId":10100580,"roleType":"TALK_ROLE_NPC","speakerId":10200,"speakerName":"「公子」","textMapHash":3326083993,"text":"「箸」…難しいな…","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101005,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMO