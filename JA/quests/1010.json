type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":101006,"initDialog":10100601,"nextRandomTalks":[],"nextTalks":[],"npcId":[10232],"performCfg":"QuestDialogue/AQ/Liyue1_1010/Q101006","priority":6,"questId":1010,"showRandomTalkCount":0},"dialogs":[{"nodeId":10100601,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":130022953,"text":"旅人、「神が去った城」をその身で感じた後、璃月という「神のいる地」を訪れ、お前はどう感じた？","nextNodeIds":[10100602,10100605]},{"nodeId":10100602,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2863121697,"text":"モンドの雰囲気の方が好き。","nextNodeIds":[10100603]},{"nodeId":10100603,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":740223169,"text":"なるほど…お前はそういう種類の旅人か。それも悪くない。","nextNodeIds":[10100604]},{"nodeId":10100604,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":910186177,"text":"しかし、「神のいる地」には3700年の歴史がある、お前はまだ全てを経験したわけではないかもしれない。","nextNodeIds":[10100607]},{"nodeId":10100607,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":3096198401,"text":"「送仙儀式」を準備する過程も、お前の旅の一部となり、お前の見聞を広めることになるだろう。","nextNodeIds":[10100608]},{"nodeId":10100608,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1152176305,"text":"璃月は七国で最も繁栄している国であり、神の鎮座や七星の統治がある。それゆえ、「ファデュイ」の外交手段の多くは、璃月では通用しない。","nextNodeIds":[10100609]},{"nodeId":10100609,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1469883921,"text":"七星の一人である凝光は、常にファデュイを警戒している。おそらく、それこそ「公子」が「往生堂」の力を借りた理由かもしれないな。","nextNodeIds":[10100610]},{"nodeId":10100610,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":297661233,"text":"うーん…「送仙儀式」は、「公子」にとって何のメリットがあるんだ？","nextNodeIds":[10100611]},{"nodeId":10100611,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":2699179673,"text":"それは知らないし、知りたくもない。俺にとって、「ファデュイ」はあくまで資金援助をするだけの存在だ。俺の望みは、璃月の伝統が人々に忘れられないことにある。","nextNodeIds":[10100612]},{"nodeId":10100612,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1653419801,"text":"（鍾離交给主角一个钱袋）","nextNodeIds":[10100613]},{"nodeId":10100613,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1628797321,"text":"これは「公子」が提供してくれた最初の資金だ。使い切ったら、彼に報告してまた資金をもらうといい。","nextNodeIds":[10100614]},{"nodeId":10100614,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2855485465,"text":"おおっ…","nextNodeIds":[10100615]},{"nodeId":10100615,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":732520097,"text":"さあ、行こう。儀式の準備の第一歩は…神に釣り合う最高品質の<color=#00E1FFFF>「夜泊石」</color>を見つけ出すことだ。","nextNodeIds":[]},{"nodeId":10100605,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":801904745,"text":"璃月の方が気に入った。","nextNodeIds":[10100606]},{"nodeId":10100606,"roleType":"TALK_ROLE_NPC","speakerId":10232,"speakerName":"鍾離","textMapHash":1395874209,"text":"ああ、「神のいる地」には3700年の歴史がある。これは七国の中でも最も古い。","nextNodeIds":[10100607]}]},{"talkId":10100501,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["101005","3",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":