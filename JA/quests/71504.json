xtNodeIds":[715040105]},{"nodeId":715040105,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2705361002,"text":"それに、解決策も思いついた。レポートの提出期限を伸ばす口実を考えるより、「プルシナスパイク」を運ぶ方法のほうがよっぽど楽だ。","nextNodeIds":[715040106]},{"nodeId":715040106,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3305936146,"text":"黒泥は地面を覆っているだけ。つまり、空中に浮いていれば問題ない。熱気球で坑道の中を運ぼう。","nextNodeIds":[715040107]},{"nodeId":715040107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4115553434,"text":"そっか、たしかに熱気球はいい方法だな！","nextNodeIds":[715040108]},{"nodeId":715040108,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":263961322,"text":"これで黒泥の問題はある程度解決できる。ただ、黒泥があまりにも多く、通路を塞いでしまった場合は、熱気球の進行に影響を及ぼすだろう。","nextNodeIds":[715040109]},{"nodeId":715040109,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3442768834,"text":"それに、黒泥の周りには引き寄せられた魔物もいる…","nextNodeIds":[715040110]},{"nodeId":715040110,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":464692778,"text":"この辺りは君たちに任せるしかない。","nextNodeIds":[715040111]},{"nodeId":715040111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3274165754,"text":"#安心しろ、オイラと{NICKNAME}が手を組めば、熱気球に近づいてくる魔物たちなんてちょちょいのちょいだ！","nextNodeIds":[715040112,715040113]},{"nodeId":715040112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":141326682,"text":"じゃあ、あとはパイモンに任せるよ。","nextNodeIds":[715040114]},{"nodeId":715040114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3001442418,"text":"オ、オイラは隣でおまえを応援する役だから…","nextNodeIds":[715040115]},{"nodeId":715040115,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3580627602,"text":"ハハハ…ゴホッ、ゴホッ…ゴホッ…","nextNodeIds":[715040116]},{"nodeId":715040116,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":1490342570,"text":"ちょっと笑っただけで咳が止まらなくなるなんて…とにかく、熱気球の準備をするため、図と昊が「プルシナスパイク」の梱包を手伝ってくれている。","nextNodeIds":[715040117]},{"nodeId":715040117,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":3614047418,"text":"元々は自分で「プルシナスパイク」を梱包するつもりだったが、ほんの少し立っていただけで、手が震えるほど咳き込んでしまってね。","nextNodeIds":[715040118]},{"nodeId":715040118,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":130371194,"text":"本当に恥ずかしい限りだ。どうやらこれからは学術研究だけでなく、体も鍛えなければならないようだ。","nextNodeIds":[715040119]},{"nodeId":715040119,"roleType":"TALK_ROLE_NPC","speakerId":30181,"speakerName":"ホッセイニ","textMapHash":2344545818,"text":"早く彼らのところに行ってあげてほしい。","nextNodeIds":[]},{"nodeId":715040113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3629271282,"text":"この剣はしばらくパイモンに預けとくよ。","nextNodeIds":[715040114]}]},{"talkId":7150405,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7150401","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param