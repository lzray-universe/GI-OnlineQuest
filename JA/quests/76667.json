],"performCfg":"","priority":5,"questId":76667,"showRandomTalkCount":0},"dialogs":[{"nodeId":766670101,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":2242200930,"text":"…うぅ…ホワイトベリーを多めに用意しとけばよかった。","nextNodeIds":[766670102,766670103]},{"nodeId":766670102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1083442178,"text":"（この前、たしかここでラウマが…）","nextNodeIds":[766670104]},{"nodeId":766670104,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":1329854586,"text":"#{NICKNAME}さん、こんにちは。「饗月の膳」を受け取りにいらしたの？申し訳ないけど、少し待ってもらえる？","nextNodeIds":[766670105]},{"nodeId":766670105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4159698482,"text":"「饗月の膳」って？","nextNodeIds":[766670106]},{"nodeId":766670106,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":827650842,"text":"ん？前にも受け取ったことがあるでしょう？ああ、あの時はラウマ様から受け取ったから、名前を知らなかったのかしら。","nextNodeIds":[766670107]},{"nodeId":766670107,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":2778145810,"text":"饗月の膳というのは、「霜月の子」が必要な人たちに無償で配る食事のことよ。","nextNodeIds":[766670108]},{"nodeId":766670108,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":3331775906,"text":"昔から「霜月の子」には助けを必要とする人たちに手を差し伸べる伝統があってね。最初はヒーシ島の周辺に限ってたけど…","nextNodeIds":[766670109]},{"nodeId":766670109,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":249235114,"text":"ラウマ様のご指示とみんなの努力のおかげで、「饗月の膳」を配るエリアもだんだん広がっていったの。","nextNodeIds":[766670110]},{"nodeId":766670110,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":3105278882,"text":"月神の祝福をもっと多くの人に届けるためよ…そうそう、ラウマさまはこうおっしゃってた…","nextNodeIds":[766670111]},{"nodeId":766670111,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":3151305906,"text":"「最初に摘んだ稀なる果実は、月の祭壇に捧げよ。此れは神への供物ではなく、迷える狩人へ残す…」","nextNodeIds":[766670112]},{"nodeId":766670112,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":3612154058,"text":"残す…あら、何だったかしら。","nextNodeIds":[766670113]},{"nodeId":766670113,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":692799994,"text":"コホン、とにかく！この店は「饗月の膳」の主な配給所の一つで、ほとんど私一人で切り盛りしているのよ。すごいでしょう？","nextNodeIds":[766670114]},{"nodeId":766670114,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":2521353554,"text":"ナシャタウンで「饗月の膳」を配ってると、いろいろ大変なこともあるけど…でも、ラウマ様のおっしゃる通り、困ってる人をもっとたくさん助けられると信じているわ。","nextNodeIds":[766670115]},{"nodeId":766670115,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":3265459666,"text":"でも…昨日は、食材が入った箱の蓋をちゃんと閉めておかなかったせいで、朝起きたら鳥たちにめちゃくちゃにされて、全部だめになってしまったの。","nextNodeIds":[766670116]},{"nodeId":766670116,"roleType":"TALK_ROLE_NPC","speakerId":7058,"speakerName":"リーリキ","textMapHash":398633146,"text":"辛うじて残ったホワイトベリーじゃ、全然足りないし…はぁ、どうすれば…","nextNodeIds":[]},{"nodeId":766670103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2606266914,"text":"（食事を配ってた…）","nextNodeIds":[766670104]}]},{"talkId":7666705,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_M