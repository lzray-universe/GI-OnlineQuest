360302]},{"nodeId":401360302,"roleType":"TALK_ROLE_NPC","speakerId":30445,"speakerName":"会場の司会者","textMapHash":2651572978,"text":"『二銃士』です！","nextNodeIds":[401360303]},{"nodeId":401360303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3956782202,"text":"オイラたちだ！ほんとにオイラたちが獲ったぞ！","nextNodeIds":[401360304]},{"nodeId":401360304,"roleType":"TALK_ROLE_NPC","speakerId":2604,"speakerName":"神里綾華","textMapHash":4131855658,"text":"おめでとうございます、グザヴィエさん。","nextNodeIds":[401360305]},{"nodeId":401360305,"roleType":"TALK_ROLE_NPC","speakerId":30435,"speakerName":"グザヴィエ","textMapHash":1761926242,"text":"まさか、お…俺が…皆さん、本当にありがとう！","nextNodeIds":[401360306]},{"nodeId":401360306,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"フリーナ","textMapHash":1948867242,"text":"フフン、フォンテーヌのエンタメ界を見る僕の目に狂いはなかったことが証明されたね。","nextNodeIds":[401360307]},{"nodeId":401360307,"roleType":"TALK_ROLE_NPC","speakerId":30445,"speakerName":"会場の司会者","textMapHash":3939821202,"text":"それでは『二銃士』のプロデューサー·グザヴィエさん、ステージへどうぞ！","nextNodeIds":[401360308]},{"nodeId":401360308,"roleType":"TALK_ROLE_NPC","speakerId":30435,"speakerName":"グザヴィエ","textMapHash":585043386,"text":"ありがとうございます…我々の作品を認めてくださったことに、心から感謝いたします。この場で、特にお礼を申し上げたいのは——","nextNodeIds":[401360309]},{"nodeId":401360309,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":3903656290,"text":"時が経つのは早いものだ。","nextNodeIds":[401360310]},{"nodeId":401360310,"roleType":"TALK_ROLE_NPC","speakerId":2604,"speakerName":"神里綾華","textMapHash":1001873394,"text":"ええ。シュヴルーズから銃の持ち方を教わったのが、ほんの二、三日前のことのように思えます。","nextNodeIds":[401360311]},{"nodeId":401360311,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":3326072002,"text":"またフォンテーヌに来てくれるか？","nextNodeIds":[401360312]},{"nodeId":401360312,"roleType":"TALK_ROLE_NPC","speakerId":2604,"speakerName":"神里綾華","textMapHash":1575231962,"text":"もちろんです。私はこの街が好きですもの。新しいものが見きれないほどありますからね。","nextNodeIds":[401360313]},{"nodeId":401360313,"roleType":"TALK_ROLE_NPC","speakerId":2604,"speakerName":"神里綾華","textMapHash":501667962,"text":"シュヴルーズも稲妻に来てくださいますか？","nextNodeIds":[401360314]},{"nodeId":401360314,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":1136794162,"text":"…今までそんなこと考えもしなかった。だが、これから考えてみよう。","nextNodeIds":[401360315]},{"nodeId":401360315,"roleType":"TALK_ROLE_NPC","speakerId":2604,"speakerName":"神里綾華","textMapHash":285447570,"text":"貴方が訪れるのをお待ちしております。その時はぜひうちに遊びにいらしてください。お茶菓子をご馳走いたします。","nextNodeIds":[401360316]},{"nodeId":401360316,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":3922032538,"text":"ああ、また連絡を取り合おう。","nextNodeIds":[401360317]},{"nodeId":401360317,"roleType":"TALK_ROLE_NPC","speakerId":1082,"speakerName":"千織","textMapHash":2491444154,"text":"君の望み通りってわけね？","nextNodeIds":[401360318]},{"nodeId":401360318,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":3117979698,"text":"貴方もそろそろ稲妻に戻るべきでは？","nextNodeIds":[401360319]},{"nodeId":401360319,"roleType":"TALK_ROLE_NPC","speakerId":1082,"speakerName":"千織","textMapHash":4230692994,"text":"「小倉屋」のほうはどうなの？","nextNodeIds":[401360320]},{"nodeId":401360320,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":1832026946,"text":"万事順調ですよ。","nextNodeIds":[401360321]},{"nodeId":401360321,"roleType":"TALK_ROLE_NPC","speakerId":1082,"speakerName":"千織","textMapHash":3431703626,"text":"じゃ、彼女によろしく伝えといて。","nextNodeIds":[401360322]},{"nodeId":401360322,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":3137639074,"text":"承知しました。","nextNodeIds":[401360323]},{"nodeId":401360323,"roleType":"TALK_ROLE_NPC","speakerId":1082,"speakerName":"千織","textMapHash":3150514050,"text":"島に雷雨が降らなくなったそうね。","nextNodeIds":[401360324]},{"nodeId":401360324,"roleType":"TALK_ROLE_NPC","speakerId":1047,"speakerName":"神里綾人","textMapHash":1704809714,"text":"争いもなくなりました。平和で安定していますよ。","nextNodeIds":[401360325]},{"nodeId":401360325,"roleType":"TALK_ROLE_NPC","speakerId":1082,"speakerName":"千織","textMapHash":1135209050,"text":"それはよかった。生地を干すのにぴったりなお天気になったみたい。","nextNodeIds":[401360326]},{"nodeId":401360326,"roleType":"TALK_ROLE_NPC","speakerId":30435,"speakerName":"グザヴィエ","textMapHash":3673332210,"text":"——名前を挙げたすべての方々に、もう一度感謝の意を。あなたたちがこの舞台まで連れてきてくれました。これは皆さんと一緒に作った映影です。","nextNodeIds":[401360327]},{"nodeId":401360327,"roleType":"TALK_ROLE_NPC","speakerId":30435,"speakerName":"グザヴィエ","textMapHash":1282995938,"text":"またメンバー全員の賛同を得て、正式にグザヴィエ撮影クルーを「ガンズフィルムカンパニー」と名づけました！","nextNodeIds":[401360328]},{"nodeId":401360328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3321656898,"text":"おお、ああやって高らかに叫ぶとかっこいいな！","nextNodeIds":[401360329]},{"nodeId":401360329,"roleType":"TALK_ROLE_NPC","speakerId":30445,"speakerName":"会場の司会者","textMapHash":1463722778,"text":"では続いて「ガンズフィルムカンパニー」の皆さま、ステージでの記念撮影にお集まりください！","nextNodeIds":[401360330]},{"nodeId":401360330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":986991946,"text":"おっ！記念撮影の時間まで用意してあるのか！","nextNodeIds":[401360331]},{"nodeId":401360331,"roleType":"TALK_ROLE_NPC","speakerId":30435,"speakerName":"グザヴィエ","textMapHash":1809265170,"text":"フリーナ監督、あなたこそがこのトロフィーを掲げるのに相応しいお方だと思います。","nextNodeIds":[401360332]},{"nodeId":401360332,"roleType":"TALK_ROLE_NPC","speakerId":1073,"speakerName":"フリーナ","textMapHash":1096366002,"text":"え？い、いやだよ…そんな恥ずかしい…","nextNodeIds":[401360333]},{"nodeId":401360333,"roleType":"TALK_ROLE_NPC","speakerId":1081,"speakerName":"シュヴルーズ","textMapHash":3129508354,"text":"監督ほどふさわしい人はいない。","nextNodeIds":[401360334]},{"nodeId":401360334,"roleType":"TALK_ROLE_NPC","speakerId":2604,"speakerName":"神里綾華","textMapHash":1834836282,"text":"ええ、適役です。","nextNodeIds":[401360335]},{"nodeId":401360335,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":127180162,"text":"フリーナしかいない。","nextNodeIds":[401360336]},{"nodeId":401360336,"roleType":"TALK_ROLE_NPC","speakerId":1082,"speakerName":"千織","textMapHash":6223