TYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30673"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166901,7166902],"talks":[{"talkId":7166901,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166901","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7166901,"initDialog":716690101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30673],"performCfg":"QuestDialogue/WQ/AnimalView_71669/Q7166901","priority":5,"questId":71669,"showRandomTalkCount":0},"dialogs":[{"nodeId":716690101,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1064416882,"text":"#{NICKNAME}、職員から聞いたよ。発信装置をつけた動物を全部見つけたってね。","nextNodeIds":[716690102]},{"nodeId":716690102,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":2762393890,"text":"驚いたよ。だって、警戒心の強い動物もいただろう？そういう子は初めて見る人が近づくと、すぐに逃げてしまう。","nextNodeIds":[716690103]},{"nodeId":716690103,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":4082635026,"text":"しかし、君が近づいても逃げなかったってことだ。本当に不思議だよ。","nextNodeIds":[716690104,716690105]},{"nodeId":716690104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3666254106,"text":"動物に好かれるタイプだから。","nextNodeIds":[716690106]},{"nodeId":716690106,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3734394362,"text":"ははっ、羨ましいな。","nextNodeIds":[716690107]},{"nodeId":716690107,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":4209428186,"text":"職員と一緒に動物に餌をやりに行ったことがあるけど、吠えられたり噛まれたりで大変だったよ、私は…","nextNodeIds":[716690112]},{"nodeId":716690112,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1194104794,"text":"まだ腕のあちこちに傷跡が残ってて、痛いんだ。","nextNodeIds":[716690113]},{"nodeId":716690113,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1518852258,"text":"まぁ、動物に懐かれるタイプじゃないのは残念だけど…可愛い子たちが元気に生きてるのを見れれば、それで満足さ。","nextNodeIds":[716690114]},{"nodeId":716690114,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3472358970,"text":"里親になってくれた人たちも、きっと同じ気持ちだろう。動物たちの自由な暮らしを見守りつつ、よりよい環境を整えてあげたいと願っている。","nextNodeIds":[716690115]},{"nodeId":716690115,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1786174514,"text":"多くの冒険者にとって、野生動物は重要な食材の一つだってことは知ってるし、「アニマルトゥギャザー」としても、会員に狩りを禁止させようなどとは思っていない。","nextNodeIds":[716690116]},{"nodeId":716690116,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":601508282,"text":"だが、動物の乱獲には反対している。もし皆がその原則を守ることができれば、きっと周りの環境もより豊かで美しいものになるだろう。","nextNodeIds":[716690117]},{"nodeId":716690117,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1773598570,"text":"#{NICKNAME}にも、会員としてぜひこの原則に賛同していただきたいものだ。","nextNodeIds":[716690118,716690120]},{"nodeId":716690118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3648497690,"text":"うん、同感だよ。","nextNodeIds":[716690119]},{"nodeId":716690119,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":785175330,"text":"見識の広い君なら、きっとそう言ってくれると思ったよ。","nextNodeIds":[716690122]},{"nodeId":716690122,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":61804946,"text":"他人に考えるきっかけを与えることができたら、今の活動に意味はあると思ってるんだ。","nextNodeIds":[716690123]},{"nodeId":716690123,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":2919737834,"text":"「アニマルトゥギャザー」の次のイベントでも、君に会えることを願っているよ。","nextNodeIds":[716690124]},{"nodeId":716690124,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1304728386,"text":"それまで腕に新たな傷を増やさないよう頑張るつもりだ、ははっ。","nextNodeIds":[]},{"nodeId":716690120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1825683442,"text":"ノーコメントで…","nextNodeIds":[716690121]},{"nodeId":716690121,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":672945794,"text":"ああ、強要するつもりはない。だが、動物に手を下す前に、一度立ち止まって考えてほしい——個人としてはそう願っている。","nextNodeIds":[716690122]},{"nodeId":716690105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2221366018,"text":"これぞ、冒険者の才能。","nextNodeIds":[716690106]}]},{"talkId":7166902,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","",