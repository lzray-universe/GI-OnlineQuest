248947,"text":"どうして？","nextNodeIds":[3081409]},{"nodeId":3081409,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":916529859,"text":"たぶん…「憎しみ」だと思うわ。","nextNodeIds":[3081410]},{"nodeId":3081410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2100359723,"text":"憎しみ…？","nextNodeIds":[3081411]},{"nodeId":3081411,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":756362147,"text":"モンドに対する憎しみよ。","nextNodeIds":[3081412]},{"nodeId":3081412,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1941740123,"text":"その憎しみを風よりも強い力にし、そして彼は魔龍になった…","nextNodeIds":[3081413]},{"nodeId":3081413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1052012859,"text":"でも、「四風守護」だったのに、なんで…","nextNodeIds":[3081414]},{"nodeId":3081414,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":732620955,"text":"なんで守るべき都市を憎むようになったんだ？","nextNodeIds":[3081415]},{"nodeId":3081415,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1309719403,"text":"……","nextNodeIds":[3081416]},{"nodeId":3081416,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1883468571,"text":"モンドの人間としては、とても言いにくいわね。","nextNodeIds":[3081417]},{"nodeId":3081417,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2830776859,"text":"これを読むといいわ…百年以上も前の出来事よ。","nextNodeIds":[]},{"nodeId":3081408,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3869950011,"text":"彼はどうしてそこまで？","nextNodeIds":[3081409]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[30814,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[3,0],"PAINLIBBLDK":"QUEST_CONTENT_ENTER_MY_WORLD","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1003,0],"PAINLIBBLDK":"QUEST_CONTENT_FAIL_DUNGEON","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["3"]