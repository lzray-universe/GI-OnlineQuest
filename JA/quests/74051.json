:"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7405103,"initDialog":740510301,"nextRandomTalks":[],"nextTalks":[],"npcId":[13489,13491,13490],"performCfg":"QuestDialogue/WQ/Fontaine_74051/Q7405103","priority":5,"questId":74051,"showRandomTalkCount":0},"dialogs":[{"nodeId":740510301,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":2895567698,"text":"映影機が無傷で良かったわ。中の映影も壊されてない…","nextNodeIds":[740510328]},{"nodeId":740510328,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":3734387954,"text":"はあ、助かったわ…また最初から撮り直しかと思っちゃった。","nextNodeIds":[740510302,740510303]},{"nodeId":740510302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1746717714,"text":"どうしてここで撮影を？","nextNodeIds":[740510329]},{"nodeId":740510303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4083106434,"text":"フォンテーヌ人じゃないみたいだけど。","nextNodeIds":[740510329]},{"nodeId":740510329,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":3401506346,"text":"この件は話すと長くなるんだけどね…","nextNodeIds":[740510305]},{"nodeId":740510304,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":2354786802,"text":"単刀直入に説明すると、私たち三人は璃月の「翹英荘」から来たのよ。","nextNodeIds":[740510305]},{"nodeId":740510305,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":1969142890,"text":"村の人たちのほとんどは茶葉を作って生計を立ててるんだけど、私たちは…茶葉の生産には興味がないの…","nextNodeIds":[740510306]},{"nodeId":740510306,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":3654123426,"text":"だから鞍替えをして、村の茶葉商人のために宣伝用の映影を記録してるってわけ。","nextNodeIds":[740510307]},{"nodeId":740510307,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"弈豊","textMapHash":1056186930,"text":"実は茶葉を作っている人が多すぎて、もともと私たちがやってた商売じゃとても周りに敵わないんです。","nextNodeIds":[740510308]},{"nodeId":740510308,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"興曄","textMapHash":1951241202,"text":"店で雇ってたやり手の従業員もぱらぱらよそに移ってっちゃって。それで、これ以上商売を続けようがなくなっちゃったんですよねー。","nextNodeIds":[740510309]},{"nodeId":740510309,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":159610058,"text":"あんたたち…もっといい感じの話はできないわけ！？","nextNodeIds":[740510310]},{"nodeId":740510310,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":1951713890,"text":"私たちだって、村の茶葉の宣伝用映影を撮って、結構稼いできたじゃない。","nextNodeIds":[740510311]},{"nodeId":740510311,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"弈豊","textMapHash":61797730,"text":"ええ…ですが、最近村では他の連中まで同じことをやり始めてしまいまして。","nextNodeIds":[740510312]},{"nodeId":740510312,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"興曄","textMapHash":3177685770,"text":"とある映影では歌なんかも入ってて…すごかったな～。","nextNodeIds":[740510313]},{"nodeId":740510313,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":2775420946,"text":"そこで私たちは、専門家のアドバイスをもらおうと思ってフォンテーヌにやってきたわけ！","nextNodeIds":[740510314]},{"nodeId":740510314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1416505034,"text":"つまりフォンテーヌに撮影を学びにきたの？","nextNodeIds":[740510315]},{"nodeId":740510315,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":774186426,"text":"そうよ。フォンテーヌでガイサートっていう「映影専門家」を見つけたの。","nextNodeIds":[740510316]},{"nodeId":740510316,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":554110946,"text":"彼は光と影を使って表現するのが上手なんだけど…なんて言ったかしら？","nextNodeIds":[740510317]},{"nodeId":740510317,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"弈豊","textMapHash":161516138,"text":"「叙述」です。","nextNodeIds":[740510318]},{"nodeId":740510318,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":4177414938,"text":"そう！光と影で「叙述」するの。","nextNodeIds":[740510319]},{"nodeId":740510319,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":3134499298,"text":"ガイサート先生の指導があれば、翹英荘で一番の映影を撮影することができるはずよ！","nextNodeIds":[740510320]},{"nodeId":740510320,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"興曄","textMapHash":2863200994,"text":"社長ぉ、先月は璃月で一番の映影を撮る…って言ってませんでした？","nextNodeIds":[740510321]},{"nodeId":740510321,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":2270014410,"text":"商売というものは、将来への期待値を適度に調整するのが大事なのよ…あなたに何がわかるの？","nextNodeIds":[740510322]},{"nodeId":740510322,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":738726514,"text":"とにかく助かったわ、旅人さん。これを受け取って。","nextNodeIds":[740510323]},{"nodeId":740510323,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":2738443930,"text":"興曄、弈豊、すぐに準備しなさい！今日中にサンプルを撮り終えてガイサート先生のところへ見せに行くわよ。","nextNodeIds":[740510324]},{"nodeId":740510324,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":1856159618,"text":"ライティングに注意しなさい！レンズは…光源に向けて、高級感のある光を演出するの！","nextNodeIds":[740510325]},{"nodeId":740510325,"roleType":"TALK_ROLE_NPC","speakerId":13489,"speakerName":"邱社長","textMapHash":747182738,"text":"例の本を読んだでしょう？光と影には質感を——質感ってわかる？","nextNodeIds":[740510326]},{"nodeId":740510326,"roleType":"TALK_ROLE_NPC","speakerId":13490,"speakerName":"興曄","textMapHash":3491579450,"text":"社長、たしかにガイサート先生の本は全部読みましたけどー…","nextNodeIds":[740510327]},{"nodeId":740510327,"roleType":"TALK_ROLE_NPC","speakerId":13491,"speakerName":"弈豊","textMapHash":1847110346,"text":"このレンズじゃ、どう頑張っても光の質感については高級感の出しようがありませんよ…","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7405103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133402044"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC