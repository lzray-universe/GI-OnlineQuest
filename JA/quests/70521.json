RuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["7052102","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7052101,"initDialog":705210101,"nextRandomTalks":[],"nextTalks":[],"npcId":[1029,1002,30234],"performCfg":"QuestDialogue/WQ/Vintage_70521/Q7052101","priority":5,"questId":70521,"showRandomTalkCount":0},"dialogs":[{"nodeId":705210101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3272326050,"text":"エウルアとアンバー！おまえたちも遊びに来たのか！","nextNodeIds":[705210102]},{"nodeId":705210102,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":229870354,"text":"探したわ。","nextNodeIds":[705210103]},{"nodeId":705210103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2346829666,"text":"えっ？わざわざオイラたちに会いに来たのか？","nextNodeIds":[705210104]},{"nodeId":705210104,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":941401114,"text":"もちろんだよ。あんたたちのお店ってば、すっかり有名だからみんな噂してるよ。","nextNodeIds":[705210105]},{"nodeId":705210105,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":2723324498,"text":"「栄誉騎士と小さな白い助っ人が『西風ヒューヒューチャリティー連盟』っていうお店でいろんなお宝を売っている。しかも不思議なプレゼントつき、見逃せない！」ってね。","nextNodeIds":[705210106]},{"nodeId":705210106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2366287322,"text":"なんだよ、結局オイラ「小さな白い助っ人」になっちゃったぞ…でもお店を評価してくれてるみたいだし、嬉しいな！","nextNodeIds":[705210107,705210108]},{"nodeId":705210107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3566364866,"text":"お客さんたちのおかげだね。","nextNodeIds":[705210109]},{"nodeId":705210109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1443686826,"text":"そういえば、ずっとエウルアとアンバーを見かけなかったけど、二人とも出かけてたのか？","nextNodeIds":[705210110]},{"nodeId":705210110,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":1971780402,"text":"えへへっ、あたしたちには仕事があるからね。","nextNodeIds":[705210111]},{"nodeId":705210111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":212578298,"text":"えっ？ずっと仕事してたのか？","nextNodeIds":[705210112,705210113]},{"nodeId":705210112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2596110338,"text":"祭りの日も休みはないの？","nextNodeIds":[705210114]},{"nodeId":705210114,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":3987747882,"text":"正確に言うと、私とアンバーは騎士団の「半休暇メンバー」なの。","nextNodeIds":[705210115]},{"nodeId":705210115,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":65968138,"text":"ブリュー祭の期間中は、ドーンマンポートとモンド城間をキャラバンが頻繁に移動するため、警戒を強める必要があるのよ。","nextNodeIds":[705210116]},{"nodeId":705210116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":614382482,"text":"魔物や悪党に襲われるからか？","nextNodeIds":[705210117]},{"nodeId":705210117,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":1958502442,"text":"ええ、そうよ。遊撃小隊の任務は、その二か所の間を巡回すること…","nextNodeIds":[705210118]},{"nodeId":705210118,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":3984353162,"text":"キャラバンの後を追い、貨物を守る。さらには率先して攻撃を仕掛けたり、怪しい場所を調査したりして、脅威を事前に取り除くってわけ。","nextNodeIds":[705210119]},{"nodeId":705210119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":214556098,"text":"なんだか大変そうだな。もしかして…ブリュー祭が終わるまでずっと仕事なのか？","nextNodeIds":[705210120]},{"nodeId":705210120,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":2669454194,"text":"そんなことないわ。交代制でやっているからね。","nextNodeIds":[705210121]},{"nodeId":705210121,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":853553570,"text":"一組は見回り、一組は休憩、一組は予備隊として待機するの。","nextNodeIds":[705210122]},{"nodeId":705210122,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":3617545330,"text":"これを一定の周期で交代しているわ。","nextNodeIds":[705210123]},{"nodeId":705210123,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":2665522874,"text":"エウルアは経験豊富な隊長だからね。エウルアの的確な指示のおかげで、厳しい任務もこなすことができたんだ。","nextNodeIds":[705210124]},{"nodeId":705210124,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":47854170,"text":"別に、褒めるほどのことではないわ…","nextNodeIds":[705210125,705210127]},{"nodeId":705210125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2523913074,"text":"すごい熱意だね、偵察騎士。","nextNodeIds":[705210126]},{"nodeId":705210126,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":1092008586,"text":"へへっ、今度機会があったら、エウルアが隊長になったばかりの頃の話をしてあげる、すごいんだから。","nextNodeIds":[705210129]},{"nodeId":705210129,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":3304096474,"text":"コホン…実はちゃんと用事があってきたんだ。エウルア、説明をお願い。","nextNodeIds":[705210130]},{"nodeId":705210130,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":2990957666,"text":"ええ、君たちに「騎士団特製北地のスモークチキン」四十人前と、「西風の加護つきお肉ツミツミ」四十人前を用意してほしいの…","nextNodeIds":[705210131]},{"nodeId":705210131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4101246314,"text":"とんでもない量だな！一度にこんな注文するのか？","nextNodeIds":[705210132]},{"nodeId":705210132,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2283184306,"text":"まさか…騎士団でパーティーを開くつもりだな？どうして誰もオイラたちを招待してくれないんだ。","nextNodeIds":[705210133]},{"nodeId":705210133,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":2824577306,"text":"あはは、そんな盛大なものじゃなくて、エウルアが隊員たちを労うためなんだ。","nextNodeIds":[705210134]},{"nodeId":705210134,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":1483961346,"text":"ええ…遊撃小隊のメンバーは日ごろから体力の消耗が激しいから、一回の食事で…四、五人前は食べるのよ。","nextNodeIds":[705210135]},{"nodeId":705210135,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":3465875074,"text":"それに、最近は古参の隊員が一人復帰することになってね。だから、この機にお祝いしようと思って。","nextNodeIds":[705210136]},{"nodeId":705210136,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":1894227594,"text":"他で何か買うよりも、資金を君たちのお店で使えば、チャリティーのためにもなるでしょ。","nextNodeIds":[705210137]},{"nodeId":705210137,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":986234506,"text":"おおっ！一石二鳥のナイス判断だな！","nextNodeIds":[705210138]},{"nodeId":705210138,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2090142538,"text":"まいどあり！","nextNodeIds":[705210139]},{"nodeId":705210139,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1346677778,"text":"そうだ…エウルアの言う「古参の隊員」って、まさか前に会った…","nextNodeIds":[705210140]},{"nodeId":705210140,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":2076614746,"text":"前線で活躍している測量士のミカよ。大団長と遠征に出る前は、ずっとうちの隊の主力だったの。","nextNodeIds":[705210141]},{"nodeId":705210141,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":269742650,"text":"やっぱりあいつのことか！あの恥ずかしがり屋の騎士が、そんなにすごいやつだったなんて！","nextNodeIds":[705210142,705210143]},{"nodeId":705210142,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1700670154,"text":"#{M#俺}{F#私}たちを怖がってるみたいだった。","nextNodeIds":[705210144]},{"nodeId":705210144,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":1301836554,"text":"ミカは決してあんたたちを怖がってたわけじゃないよ。若干遠回しだけど、それもあんたたちに対する「敬意」の表れなの。","nextNodeIds":[705210145]},{"nodeId":705210145,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":1207754674,"text":"彼は強い人には独特の個性があると思い込んでいてね。その人たちを知り、考えを理解した上で、より深いコミュニケーションを図るの。","nextNodeIds":[705210146]},{"nodeId":705210146,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":3290065450,"text":"こうすることで、気兼ねなく会話できるようになるみたい。","nextNodeIds":[705210147]},{"nodeId":705210147,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":3906214130,"text":"最初は私とアンバーに対しても同じ感じだったわ。私たちのことをよく知ってから、だんだんと自然体でいられるようになったの。","nextNodeIds":[705210148]},{"nodeId":705210148,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":124105762,"text":"そういうことだったのか…ミカって本当に変わったやつだな…","nextNodeIds":[705210149,705210150]},{"nodeId":705210149,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4099738258,"text":"覚えておく。","nextNodeIds":[705210151]},{"nodeId":705210151,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":917722562,"text":"ええ。今度時間があったら、もっと接してみるといいわ。","nextNodeIds":[705210152]},{"nodeId":705210152,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":64171010,"text":"君は騎士団の重要人物。私は彼の上官として、お互いの誤解を防ぐ義務があるからね。","nextNodeIds":[705210153]},{"nodeId":705210153,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3396614498,"text":"えへへ、そんなに弁解しなくても大丈夫だぞ。エウルアがあいつのために言ってるってことは、オイラたちにも十分伝わってるから。","nextNodeIds":[705210154]},{"nodeId":705210154,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":3661996122,"text":"あっ、エウルア、あたしの分も払ってくれたの？","nextNodeIds":[705210155]},{"nodeId":705210155,"roleType":"TALK_ROLE_NPC","speakerId":1002,"speakerName":"アンバー","textMapHash":3360047114,"text":"あたしは遊撃小隊のメンバーじゃないし、別で払うよ。","nextNodeIds":[705210156]},{"nodeId":705210156,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":420973666,"text":"君の分も私が奢るから、遠慮しなくていいわ。","nextNodeIds":[705210157]},{"nodeId":705210157,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":319352698,"text":"注文された料理を渡すと、二人は礼を言って帰って行った。","nextNodeIds":[705210158]},{"nodeId":705210158,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4018315994,"text":"へへっ、エウルアとアンバーのおかげで、一気に前日と同じ分のモラを稼げたな！","nextNodeIds":[705210159]},{"nodeId":705210159,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":2290445482,"text":"栄誉騎士、パイモン！朗報だ——","nextNodeIds":[705210160]},{"nodeId":705210160,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":3723835346,"text":"二人のおかげで、予想を遥かに上回る資金が集まった！大成功だよ！","nextNodeIds":[705210161]},{"nodeId":705210161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":829311690,"text":"へへん、どんなトラブルが起きてもきっと乗り越えられるって、オイラ言っただろ！","nextNodeIds":[705210162,705210163]},{"nodeId":705210162,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2053550954,"text":"みんなお疲れさま。","nextNodeIds":[705210164]},{"nodeId":705210164,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":2379434098,"text":"お店がうまくいったのは、二人の指導のおかげだよ。","nextNodeIds":[705210165]},{"nodeId":705210165,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":171802058,"text":"収益はすでにチャリティー資金の担当者に渡してある。今回のチャリティーイベントもこれで無事終了だ。","nextNodeIds":[705210166]},{"nodeId":705210166,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":3138400178,"text":"感謝の気持ちを込めて、二人に報酬を贈ろう。さあ、受け取ってくれ。","nextNodeIds":[705210167]},{"nodeId":705210167,"roleType":"TALK_ROLE_NPC","speakerId":30234,"speakerName":"ベルンハルト","textMapHash":3289815522,"text":"もうお店を開くのも怖くないぞ。今後もぜひ一緒に仕事をしてほしい！","nextNodeIds":[705210168]},{"nodeId":705210168,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2946741698,"text":"おう、オイラもかなりいい経験になったぞ！","nextNodeIds":[705210169]},{"nodeId":705210169,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1325875946,"text":"またこんな機会があったら、挑戦してみようぜ！","nextNodeIds":[]},{"nodeId":705210163,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3106160274,"text":"ベルンハルトもお疲れさま。","nextNodeIds":[705210164]},{"nodeId":705210150,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1043089634,"text":"もうだいぶ慣れた。","nextNodeIds":[705210151]},{"nodeId":705210143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":41319874,"text":"ほとんど話すことなく逃げられた。","nextNodeIds":[705210144]},{"nodeId":705210127,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1099563970,"text":"さすがです、エウルア隊長。","nextNodeIds":[705210128]},{"nodeId":705210128,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":2610775210,"text":"君たち、そんな風にからかって、いったい何の真似？祭りの雰囲気にでも影響されたのかしら？","nextNodeIds":[705210129]},{"nodeId":705210113,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2576674770,"text":"持ち場から離れられないの？","nextNodeIds":[705210114]},{"nodeId":705210108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2824844674,"text":"良かった。","nextNodeIds":[705210109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7052102","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["3","695,696"],"PAINLIBBLDK":"QUEST_EXEC_LOCK_POINT"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN