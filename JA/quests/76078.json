OLE_NPC","speakerId":1314,"speakerName":"フリンズ","textMapHash":3521098394,"text":"その肉体は清められ、炎は再び燃え上がり…ナド・クライを守ると誓った新たなライトキーパーの手に渡るでしょう。","nextNodeIds":[760780207]},{"nodeId":760780207,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":3463130026,"text":"フリンズはランプを綺麗にすると、大事そうにしまった。","nextNodeIds":[760780208]},{"nodeId":760780208,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"フリンズ","textMapHash":3762269458,"text":"恐らく、だからワイルドハントは完全に消えなかったんでしょう。本部の人が回収に来るまでの間、一時的に僕がこのランプを保管します。","nextNodeIds":[760780209]},{"nodeId":760780209,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"フリンズ","textMapHash":2680806146,"text":"…おや、ランプの下になにかあるようですね。","nextNodeIds":[760780210]},{"nodeId":760780210,"roleType":"TALK_ROLE_NPC","speakerId":1314,"speakerName":"フリンズ","textMapHash":4052067394,"text":"これもこの同僚の形見でしょう。ランプと一緒に保管すべきかもしれません。","nextNodeIds":[]}]},{"talkId":7607805,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["7608102","2","","",""],"type":"TALK_EXEC_SET_QUEST_GLOBAL_VAR"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7607804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["0","2","76078","",""],"type":"QUEST_CON