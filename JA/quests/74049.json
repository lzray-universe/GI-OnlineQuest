ONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7404903,"initDialog":740490301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5315],"performCfg":"QuestDialogue/WQ/Fontaine_74049/Q7404903","priority":5,"questId":74049,"showRandomTalkCount":0},"dialogs":[{"nodeId":740490301,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":840749506,"text":"#{NICKNAME}はほんとにすごいね。グロテスクなメカを、「ドカン」って一発できれいなパーツに変えちゃった。","nextNodeIds":[740490302]},{"nodeId":740490302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":423531962,"text":"これでもう花畑は荒らされないはず。","nextNodeIds":[740490303]},{"nodeId":740490303,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2464924906,"text":"うん、ちょっと荒らされちゃったとはいえ、残った花はまだ元気みたいだしな。もう荒らしに来るブリーチャープリムスもいないから、コスンツァーナの花もきっとすくすく育つぜ。","nextNodeIds":[740490304]},{"nodeId":740490304,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":939817738,"text":"よかった…でも、いい勉強になったよ。大切なお花は、大事に大事にお世話しなくちゃね。","nextNodeIds":[740490305]},{"nodeId":740490305,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":3632085050,"text":"#{NICKNAME}とパイモンは…異国のお花をプレゼントしてくれた上に、あたしのお花畑も守ってくれた。コスンツァーナ、なんてお礼したらいいか…","nextNodeIds":[740490306]},{"nodeId":740490306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1113241474,"text":"そんなに気をつかわなくていいぞ。","nextNodeIds":[740490307]},{"nodeId":740490307,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":811903402,"text":"#そうだ、あたしが摘んできたこのお花も、すごく貴重なんだよ！これを{NICKNAME}とパイモンにあげる！","nextNodeIds":[740490308]},{"nodeId":740490308,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":516966026,"text":"#おお！そんなに貴重な花なら、{NICKNAME}も花畑を作って植えてみたらどうだ…","nextNodeIds":[740490309]},{"nodeId":740490309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1517983586,"text":"って、これ…タイダルガじゃないか！タイダルガも花なのか？","nextNodeIds":[740490310]},{"nodeId":740490310,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":3432422378,"text":"タイダルガは植物で、きれいだから、もちろん花のうちに入るよ。人間の「生物学」によるとね。一流のガーデナーになるために、ちょっと勉強したんだ、ふふん。","nextNodeIds":[740490311]},{"nodeId":740490311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3572467154,"text":"なんか間違ってる気がするけど、オイラもその辺の分類学の理論についてはよく分からないからな…","nextNodeIds":[740490312]},{"nodeId":740490312,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":701607890,"text":"これからもがんばって、もっともっとすごいガーデナーになるね。人間に聞いたけど、一流のガーデナーは新しい品種のお花を育てて、「園芸品評会」に持っていくんだって。","nextNodeIds":[740490313]},{"nodeId":740490313,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":1254494738,"text":"あたしも新しい品種を育てて、「園芸品評会」で「賞」をもらいたいな。","nextNodeIds":[740490314]},{"nodeId":740490314,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2717792714,"text":"意気込みはいいけど…説明しにくい誤解がまだまだあるような…","nextNodeIds":[740490315]},{"nodeId":740490315,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1036997722,"text":"園芸品評会に参加するってことは、自分で育てた新品種を人間の鑑賞用に持って行くってことだろ？","nextNodeIds":[740490316]},{"nodeId":740490316,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2328621690,"text":"コスンツァーナの感覚とか審美眼って、人間とはかけ離れてるからな…コスンツァーナが育てる新品種の花は、人間の目には変な感じに映るんじゃないか？","nextNodeIds":[740490317]},{"nodeId":740490317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1017457154,"text":"彼女のガーデナー人生が気になるんだね。","nextNodeIds":[740490318]},{"nodeId":740490318,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1972959042,"text":"そりゃそうだろ！オイラはコスンツァーナのガーデニングの先生だからな。もしコスンツァーナが出場して受賞できたら、オイラも鼻が高いしな。","nextNodeIds":[740490319,740490323]},{"nodeId":740490319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":455265394,"text":"賞のことは気にしないで。楽しむのが大事。","nextNodeIds":[740490320]},{"nodeId":740490320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":233199682,"text":"…それもそうだよな！コスンツァーナが自分で育てた花がきれいだと思っていれば、それで十分だ！他人の評価なんて、そんなに重要なもんじゃないぞ。","nextNodeIds":[740490321]},{"nodeId":740490321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":452038666,"text":"だからおまえは花畑の世話をして、きれいな花を見て、毎日楽しく過ごすんだぞ！","nextNodeIds":[740490322]},{"nodeId":740490322,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":2073351042,"text":"ウン！あたし、異国のお花をすくすく育てるね！","nextNodeIds":[]},{"nodeId":740490323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2346183450,"text":"少なくとも最初の一歩は踏み出せたね。","nextNodeIds":[740490324]},{"nodeId":740490324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":130760130,"text":"そうだな。それにコスンツァーナが育てる品種はフツーじゃないかもしれないけど、独創的なものが好きな人もいるからな。","nextNodeIds":[740490325]},{"nodeId":740490325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1661358098,"text":"コスンツァーナ、新品種ができたら、真っ先にオイラたちに教えてくれよ！","nextNodeIds":[740490326]},{"nodeId":740490326,"roleType":"TALK_ROLE_NPC","speakerId":5315,"speakerName":"コスンツァーナ","textMapHash":2983850674,"text":"#もちろん。パイモンと{NICKNAME}はあたしのこと、いっぱい助けてくれたもん！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7404903,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["7404901","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GG