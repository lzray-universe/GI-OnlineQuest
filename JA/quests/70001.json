,{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7000102,"initDialog":700010201,"nextRandomTalks":[],"nextTalks":[],"npcId":[152501],"performCfg":"","priority":5,"questId":70001,"showRandomTalkCount":0},"dialogs":[{"nodeId":700010201,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":1612421602,"text":"旅人、また会ったわね。城内の雰囲気にはもう慣れた？","nextNodeIds":[700010202]},{"nodeId":700010202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2426596386,"text":"すごく好きな雰囲気。","nextNodeIds":[700010203]},{"nodeId":700010203,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":3022571786,"text":"そう、よかった。でも…雰囲気とかけ離れたことだけど、風花祭に関することを君に依頼したいの。","nextNodeIds":[700010204]},{"nodeId":700010204,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":1431105586,"text":"いえ、正確には、「あの方」からの依頼ね。","nextNodeIds":[700010205]},{"nodeId":700010205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2207487090,"text":"今は人に依頼できないんじゃ…","nextNodeIds":[700010206]},{"nodeId":700010206,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":3240663786,"text":"それは心配しないで。今回の依頼は、風花祭の掟に入らないから。","nextNodeIds":[700010207]},{"nodeId":700010207,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":595534938,"text":"君も気づいてると思うけど、毎年の風花祭はとても賑やかで、人もすごく多い。みんな祭りを楽しんでるの。西風騎士団も秩序を守るためにとても忙しく働いてる…","nextNodeIds":[700010208]},{"nodeId":700010208,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":3371131482,"text":"無防備な群衆、忙しい西風騎士、宝盗団にとっては絶好のチャンスね。","nextNodeIds":[700010209]},{"nodeId":700010209,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":952129130,"text":"「あの方」の情報によると、いくつかの宝盗団のメンバーがすでに城内に忍び込んだらしい。城内で風花祭を祝うふりをしてるけど、実際は計画のための調査よ。","nextNodeIds":[700010210]},{"nodeId":700010210,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":2139851146,"text":"もし騎士団が大掛かりな捜査を始めると、気づかれて取り逃がす。それに祭りの雰囲気も壊してしまう。でも彼らを放ってはおけない…","nextNodeIds":[700010211]},{"nodeId":700010211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2974135714,"text":"#だから{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}に？","nextNodeIds":[700010212]},{"nodeId":700010212,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":383957586,"text":"そう、今回も「あの方」からの名指しよ。彼が言うには、君が最も適任らしいの。","nextNodeIds":[700010213]},{"nodeId":700010213,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":4088109658,"text":"それじゃ、本題に戻るわね。私が仕入れた情報によると、宝盗団たちは身分を示すための<color=#00E1FFFF>小包</color>を持っているらしい。それに、身分を確認する時は<color=#00E1FFFF>暗号</color>を使う。","nextNodeIds":[700010214]},{"nodeId":700010214,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":2732683354,"text":"<color=#00E1FFFF>「風の花が舞い、人々が見る。」</color>","nextNodeIds":[700010215,700010216]},{"nodeId":700010215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1979136074,"text":"覚えやすい…","nextNodeIds":[700010217]},{"nodeId":700010217,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":1682567242,"text":"この暗号が合えば、城内に忍び込んだ宝盗団ということね。それに彼らの口から、野外の拠点の情報も聞き出せるかもしれないわ。","nextNodeIds":[700010218]},{"nodeId":700010218,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":3579128490,"text":"情報を聞き出したら、ついでに倒してきてちょうだい。","nextNodeIds":[700010219]},{"nodeId":700010219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":189067522,"text":"どうして騎士団に任せないの？","nextNodeIds":[700010220]},{"nodeId":700010220,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":645011258,"text":"祭りの秩序を守るために、騎士団はもういっぱいいっぱいなの。","nextNodeIds":[700010221]},{"nodeId":700010221,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":3910797922,"text":"なるべく手助けした方が、彼らのためになるわ。","nextNodeIds":[700010222]},{"nodeId":700010222,"roleType":"TALK_ROLE_NPC","speakerId":152501,"speakerName":"ヴァル","textMapHash":3326090330,"text":"じゃあお願いね、「栄誉騎士」。","nextNodeIds":[]},{"nodeId":700010216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2276928610,"text":"やつらの風格らしい。","nextNodeIds":[700010217]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7000102,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["152501"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7000106,"order":4,"stepDescription":"","stepDescTextMapHash":878942820,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7000104,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7000104,7000108],"talks":[{"talk