":[{"nodeId":746500101,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":2531209770,"text":"いい天気ね。そう思わない？","nextNodeIds":[746500102,746500103]},{"nodeId":746500102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3909015186,"text":"そうだね…","nextNodeIds":[746500104]},{"nodeId":746500104,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":4006038986,"text":"もし仕事の日の天気が毎日こんなにキュートだったら、最高なのに。","nextNodeIds":[746500105]},{"nodeId":746500105,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":4189794802,"text":"仕事といえば…あなた、「人生いろいろ」欄の「トラブルキラー」職の面接に来たんでしょう？","nextNodeIds":[746500106,746500108]},{"nodeId":746500106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":250106234,"text":"うん。","nextNodeIds":[746500107]},{"nodeId":746500107,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":1366497866,"text":"素晴らしいわ。あなた、「トラブルキラー」っていう言葉に疑問を抱かないなんて。言葉の使い方に関してイーサンの好みは少し変わってるけど、シンプルで分かりやすいのよね。","nextNodeIds":[746500111]},{"nodeId":746500111,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":4031154738,"text":"まあ、それはさておき…あなたは仕事を探しているけど、うちの新聞の「人生いろいろ」欄に助けを求めに来たわけじゃない…そう私が推理した方法が気になるかしら？","nextNodeIds":[746500112]},{"nodeId":746500112,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":2171260306,"text":"観察よ。スチームバード新聞に助けを求める市民の顔はどれも気が気でなさそうな様子なの。でも、あなたの足取りはすごく軽くて、表情もリラックスしていた。","nextNodeIds":[746500113]},{"nodeId":746500113,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":4248242490,"text":"フフッ、幸せな人はみんな似たような感じでね。でも、不運な人はそれぞれ違った負のオーラをまとっているわ。","nextNodeIds":[746500114]},{"nodeId":746500114,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":3359886218,"text":"まあ、安心してちょうだい。「人生いろいろ」欄の投稿者が直面している問題ってさほど大きいものじゃないし、手を焼くこともないと思うわ。","nextNodeIds":[746500115]},{"nodeId":746500115,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":997661818,"text":"さて、それじゃ今回の依頼内容を見てみましょうか。どれ…","nextNodeIds":[]},{"nodeId":746500108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":745608938,"text":"「トラブルキラー」…？","nextNodeIds":[746500109]},{"nodeId":746500109,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":1141075938,"text":"まあ、そうなるわよね。「トラブルキラー」って言い方、あんまり品がないからうちの新聞のセンスとは合わないし…","nextNodeIds":[746500110]},{"nodeId":746500110,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":3425079714,"text":"ふむ…イーサンの言葉選びと文章力には、改善の余地があるわね。","nextNodeIds":[746500111]},{"nodeId":746500103,"roleType":"TALK_ROLE_NPC","speakerId":5042,"speakerName":"ユーフラシア","textMapHash":3911430682,"text":"とっても気持ちいいわ。","nextNodeIds":[746500104]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7465001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5042"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7465002,"order":2,"stepDescription":"ユーフラシアと会話する","stepDescTextMapHash":3924649396,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7465002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPK