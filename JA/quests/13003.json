,"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1300303,"initDialog":130030301,"nextRandomTalks":[],"nextTalks":[],"npcId":[1050,12686],"performCfg":"QuestDialogue/LQ/Tighnari1_13003/Q1300303","priority":5,"questId":13003,"showRandomTalkCount":0},"dialogs":[{"nodeId":130030301,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4117629770,"text":"ティナリ——","nextNodeIds":[130030302]},{"nodeId":130030302,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":1285583154,"text":"しー、静かに。","nextNodeIds":[130030303]},{"nodeId":130030303,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":123016682,"text":"フジモドキ、ジンチョウゲ科ジンチョウゲ属。著しい抗けいれん効果があり、麻酔粉として使用することができる…","nextNodeIds":[130030304]},{"nodeId":130030304,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2875019042,"text":"両組の実験データによって、魚に対して特に毒性があることがわかった、と…ちゃんと記録しておかなくちゃ。","nextNodeIds":[130030305]},{"nodeId":130030305,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"カカタ","textMapHash":1078157530,"text":"グル！","nextNodeIds":[130030306]},{"nodeId":130030306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2991449530,"text":"カカタ！？","nextNodeIds":[130030307]},{"nodeId":130030307,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"カカタ","textMapHash":3308000658,"text":"グル！グル！","nextNodeIds":[130030308]},{"nodeId":130030308,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2195134066,"text":"静かにしてって言ったのに。植物はちっとも気にしないだろうけど僕の耳には響くんだ。","nextNodeIds":[130030309]},{"nodeId":130030309,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":858217306,"text":"おまえ、カカタを解体しなかったのか？","nextNodeIds":[130030310]},{"nodeId":130030310,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":142814802,"text":"解体してどうするの？","nextNodeIds":[130030311]},{"nodeId":130030311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":552424682,"text":"だっておまえ、「教令院のルール」だって言ったじゃないか…","nextNodeIds":[130030312]},{"nodeId":130030312,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2955702242,"text":"なるほど、こんな朝早くに僕を邪魔しに来たのは、そのためだったんだね。まあ、昨日ちゃんと説明しなかった僕も悪いか。","nextNodeIds":[130030313]},{"nodeId":130030313,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":4108371154,"text":"僕が言いたかったのは、教令院のルールでは研究成果は全て破棄することになっているから、あの場所を教令院に見つからないようにしようってこと。","nextNodeIds":[130030314]},{"nodeId":130030314,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1433079602,"text":"ティナリがあそこに残ったのは…","nextNodeIds":[130030315]},{"nodeId":130030315,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2966199050,"text":"とりあえずカカタを修理してたんだよ。昔教令院にいた時、素論派の授業を履修したことがあるんだ。まさか役に立つ日が来るなんて思わなかったけどね。","nextNodeIds":[130030316]},{"nodeId":130030316,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2986691458,"text":"それから、カカタと一緒にアバッドイを埋葬してきた。実験資料の一部は記念として持ち帰って来たけど、ほとんどは燃やして深く埋めたよ。証拠隠滅のためにね。","nextNodeIds":[130030317]},{"nodeId":130030317,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":1892987858,"text":"僕は教令院の人間じゃないし、あそこのルールなんか知ったこっちゃない。それよりも、今はアビディアの森のレンジャー長として、森の生命たちを守る義務がある。","nextNodeIds":[130030318]},{"nodeId":130030318,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":1875385858,"text":"この世に生まれた命には必ず意味がある。カカタも例外じゃない。存在する以上、勝手に捨てたり壊したりするべきじゃないんだ。","nextNodeIds":[130030319]},{"nodeId":130030319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2632752170,"text":"へへっ！良かったぜ！","nextNodeIds":[130030320]},{"nodeId":130030320,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"カカタ","textMapHash":2839178554,"text":"グルル？","nextNodeIds":[130030321]},{"nodeId":130030321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1014320178,"text":"でも、ティナリは今、「命」って言ったよな。ってことは、もうカカタのことを「真の生命」だって認めたのか？","nextNodeIds":[130030322]},{"nodeId":130030322,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2094876514,"text":"あくまでも可能性の話だよ。何しろアバッドイを「修理」しようとした挙動は、解明が難しいからね。","nextNodeIds":[130030323]},{"nodeId":130030323,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":3051827394,"text":"アバッドイが残した実験記録だって、氷山の一角でしかない。彼がどれだけのコマンドを設定していたのかは、誰にも分からない。","nextNodeIds":[130030324]},{"nodeId":130030324,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":3629303226,"text":"もしかしたらカカタは単純にコマンドから生じた不具合のせいで、ああいう行動をとったのかもしれないしね。","nextNodeIds":[130030325]},{"nodeId":130030325,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":3268633898,"text":"だから厳密には、カカタが真の生命だとはまだ言えない。でも、可能性がある以上——僕はそれを信じたいんだ。","nextNodeIds":[130030326]},{"nodeId":130030326,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"カカタ","textMapHash":857765162,"text":"グル！","nextNodeIds":[130030327]},{"nodeId":130030327,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":1026843730,"text":"ちなみに、僕はこの研究テーマを続けることにはほとんど興味がない。連れて来たのも、単にここが隠れ家として優れているからだ。","nextNodeIds":[130030328]},{"nodeId":130030328,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":387128730,"text":"でもまあ、実験のアシスタントとして働いてもらうのもいいかな。少なくとも、実験記録くらいはこなしてくれそうだしね。","nextNodeIds":[130030329]},{"nodeId":130030329,"roleType":"TALK_ROLE_NPC","speakerId":1050,"speakerName":"ティナリ","textMapHash":2326355954,"text":"君はどう思う？","nextNodeIds":[130030330]},{"nodeId":130030330,"roleType":"TALK_ROLE_NPC","speakerId":12686,"speakerName":"カカタ","textMapHash":646502842,"te