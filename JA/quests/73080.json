type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7308002,"initDialog":730800201,"nextRandomTalks":[],"nextTalks":[],"npcId":[20593],"performCfg":"QuestDialogue/WQ/Sumeru_73080/Q7308002","priority":5,"questId":73080,"showRandomTalkCount":0},"dialogs":[{"nodeId":730800201,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2711384746,"text":"いつから俺を疑い始めた？スダッベとイッサムが俺のことを話したからか？","nextNodeIds":[730800202]},{"nodeId":730800202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1946696130,"text":"#{M#君}{F#あなた}が{M#俺}{F#私}の名前を知ってたから。","nextNodeIds":[730800203]},{"nodeId":730800203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1972311346,"text":"#ラナは{M#俺}{F#私}の名前を{M#君}{F#あなた}に言わなかった。","nextNodeIds":[730800204]},{"nodeId":730800204,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2176053708,"text":"もしかしたら、俺は耳がいいだけかもしれない。ラナがアマディアおじいさんに君を紹介した時、ちょうど名前を聞いたんだ。","nextNodeIds":[730800205]},{"nodeId":730800205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2480531690,"text":"アマディアおじいさんにも名前を言ってない。","nextNodeIds":[730800206]},{"nodeId":730800206,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":939542658,"text":"…油断したか。だがこのテイワットで、情報の早い組織はファデュイの他にも冒険者協会がある。なぜ俺を冒険者だと思わなかった？","nextNodeIds":[730800207,730800210]},{"nodeId":730800207,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":171947594,"text":"#{M#君}{F#あなた}は{M#俺}{F#私}をよく知ってるようだった。","nextNodeIds":[730800208]},{"nodeId":730800208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2199974978,"text":"神の目なしでも元素力が使えると知ってた。","nextNodeIds":[730800209]},{"nodeId":730800209,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2611241722,"text":"君は各地で冒険しているから有名人だろう。たとえファデュイじゃなくても、知っているはずだ…とにかく、俺がファデュイである証拠を君は持っていないんじゃないか。","nextNodeIds":[730800212]},{"nodeId":730800212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3424809762,"text":"そう、でもそれはどうでもいいこと。","nextNodeIds":[730800213]},{"nodeId":730800213,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3874017834,"text":"ああ、君の言う通りだ。「証拠」を重視するのは法律だけ。そして鋭敏な猟犬は、怪しい匂いを追うことで獲物を見つけられることを理解している。","nextNodeIds":[730800214]},{"nodeId":730800214,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":4043212666,"text":"もちろん、賢い猟犬は追跡の途中で悪龍に遭遇するのを防ぐため、嗅いではいけない匂いを避けようとする。しかし、君の経歴から見るに、自分の身の安全だけを考える人ではないようだ。","nextNodeIds":[730800215]},{"nodeId":730800215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1208449178,"text":"ラナにパトロールしないよう警告したのは…","nextNodeIds":[730800216]},{"nodeId":730800216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2939580546,"text":"ファデュイの行動を邪魔させないため。","nextNodeIds":[730800217]},{"nodeId":730800217,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2420765706,"text":"…それも理由の一つだ。だがそれより、それが原因で彼女に怪我をしてほしくなかったんだ。他のファデュイは俺と違って、彼女にも、ヴィマラ村にも何の感情を抱いていないからな。","nextNodeIds":[730800218]},{"nodeId":730800218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":306877394,"text":"#「アルフォンソ」、{M#君}{F#あなた}は一体何者なの？","nextNodeIds":[730800219]},{"nodeId":730800219,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":779268058,"text":"血縁者に付けられた名は、すでに氷雪の中で失われた。「壁炉の家」から与えられた名は、トロフィン·スネージヴィッチだ。","nextNodeIds":[730800220]},{"nodeId":730800220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3960302698,"text":"壁炉の家のスネージヴィッチ…","nextNodeIds":[730800221]},{"nodeId":730800221,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":348316378,"text":"…その反応から見るに、君は少し心当たりがあるようだな。俺の「兄弟姉妹」に会ったことがあったか。","nextNodeIds":[730800222]},{"nodeId":730800222,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":1282406186,"text":"ああ、誰に会ったとか、そいつの状況とかは教えないでくれ。彼らが君に正体を明かしたということは…","nextNodeIds":[730800223]},{"nodeId":730800223,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2193765210,"text":"陛下を裏切ったということなのだろう、もし今も元気であればの話だがな。すでに亡くなっていたら…はぁ、そんな話は聞きたくもない。","nextNodeIds":[730800224]},{"nodeId":730800224,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2642761258,"text":"壁炉の家は「召使」様が設立した孤児院だ。壁炉の家で生活している子供たちは全員、血縁者がいない。だが、俺たちにはもっと大切な「兄弟姉妹」がいる。","nextNodeIds":[730800225]},{"nodeId":730800225,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2237737346,"text":"大きくなると、素質のある子供は特別部隊に入るための訓練を受け、各地に潜伏し命令を待つ。残念ながら、俺は「素質のある子供」と判断された。","nextNodeIds":[730800226]},{"nodeId":730800226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3640876698,"text":"#{M#君}{F#あなた}が受けた命令は？","nextNodeIds":[730800227]},{"nodeId":730800227,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3549176738,"text":"「アランナラ」を捕獲することだ。これは「博士」様からの命令だった——アランナラと夢、死域との繋がりを研究するためだそうだ。","nextNodeIds":[730800228]},{"nodeId":730800228,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":1663587178,"text":"「夢」と「死域」を兵器化するのは、あの方の研究テーマの一つらしい。もちろん俺も、君に倒されたファデュイも、あの方にとっては「研究資源」だ。","nextNodeIds":[730800229]},{"nodeId":730800229,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3321597922,"text":"俺たちはアランナラに会うことができない。でもカブス、スダッベ、そしてイッサムたちには…アランナラと友達になる資格がある。","nextNodeIds":[730800230]},{"nodeId":730800230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1192222762,"text":"子供を誘拐して、アランナラを誘い出した。","nextNodeIds":[730800231]},{"nodeId":730800231,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2431961530,"text":"そうだ。そして、アランナラは本当に現れた。しかし、アランナラの力は本当に不思議なものだな。厳重に警備されたキャンプから、誰にも気づかれず子供を救出するとは…","nextNodeIds":[730800232]},{"nodeId":730800232,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":409717778,"text":"「博士」様は本当に、すごいものに目をつけたようだ。ハハハハッ…","nextNodeIds":[730800233]},{"nodeId":730800233,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":1138895922,"text":"#俺からも質問がある、{NICKNAME}。なぜアランナラは、カブスとスダッベが誘拐されたこと、そして助け出された記憶を消したのだ？自分の正体を知られたくなかったのか？","nextNodeIds":[730800234]},{"nodeId":730800234,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1366399602,"text":"怖かったことを覚えていてほしくないから。","nextNodeIds":[730800235]},{"nodeId":730800235,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1308333834,"text":"将来、暴力に頼って欲しくないから。","nextNodeIds":[730800236]},{"nodeId":730800236,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3329267866,"text":"そうか…あのアランナラ…「アランラナ」といったか？ラナの名前によく似た良い名前だ。機会があれば、「ありがとう」と伝えておいてくれ。","nextNodeIds":[730800237]},{"nodeId":730800237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3076850226,"text":"どうしてお礼を？","nextNodeIds":[730800238]},{"nodeId":730800238,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3848551714,"text":"ヴィマラ村は、俺にとって本当に家みたいなところでな。ラナとイッサムは、俺が本来持つべき家族のような存在…カブスとスダッベも、大切な弟と妹だ。","nextNodeIds":[730800239]},{"nodeId":730800239,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":4267768306,"text":"あいつらには健やかに成長して、真っ当で優しい大人になってほしい。","nextNodeIds":[730800240]},{"nodeId":730800240,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2154023698,"text":"だから、俺の「仕事」を邪魔はしたが、アランラナがしてくれたことには感謝している…","nextNodeIds":[730800241]},{"nodeId":730800241,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3034230762,"text":"…ああ、やっと分かった。君がパイモンを立ち去らせたように、子供たちもこんな暗くて卑しいことを知らないほうがいい。","nextNodeIds":[730800242]},{"nodeId":730800242,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3826016818,"text":"「若者よ、幼少期に胸を躍らせ、幸せを感じ、望むことをやって、見たいものを見るがいい。しかし、暗き日々も忘れてはいけない…」","nextNodeIds":[730800243]},{"nodeId":730800243,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":3542999970,"text":"…これは壁炉の家の教えだ。大人は必ず暗闇に直面する。だから、幼い時から備えておくべきなんだ。そうすれば、自分と大切な人を守ることができる。","nextNodeIds":[730800244]},{"nodeId":730800244,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":829309898,"text":"もしかしたら、君たちのやり方も一理あるかもしれない。俺が壁炉の家で育ち、ヴィマラ村に駐留する特別部隊の一人にならなければ…もし俺がヴィマラ村の生まれだったら、どれほどよかったか。","nextNodeIds":[730800245]},{"nodeId":730800245,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4249212450,"text":"そんなことを言っても、何の意味もない。","nextNodeIds":[730800246]},{"nodeId":730800246,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":4075664946,"text":"ああ、分かっている。ただ、残念でならないんだ。「トロフィン·スネージヴィッチ」ではなく、ずっと「アルフォンソ」のままでいたい。俺は、イッサムの本当のお兄さんになりたい。","nextNodeIds":[730800247]},{"nodeId":730800247,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":4206573682,"text":"しかし善人になりたくとも、俺は組織の人間だ。ラナの家族、子供たちの家族になりたかったが、俺にはすでに裏切ることのできない「家」がある。","nextNodeIds":[730800248]},{"nodeId":730800248,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":41632682,"text":"君は多くの仲間を持ち、執行官様に匹敵するほどの実力を持つが、どの都市や国にも属していない。騎士であるものの、自由な栄誉騎士である君には理解できないだろう…","nextNodeIds":[730800249,730800251]},{"nodeId":730800249,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":483720266,"text":"理解できるよ。","nextNodeIds":[730800250]},{"nodeId":730800250,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1035547082,"text":"#でも、{M#君}{F#あなた}のしたことは許されない。","nextNodeIds":[730800253]},{"nodeId":730800253,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":1178216978,"text":"話したいことは以上だ。さあ、俺をどうするつもりだ？","nextNodeIds":[730800254,730800262]},{"nodeId":730800254,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1531991802,"text":"#この村に近づかず、{M#俺}{F#私}の前にも現れないで。","nextNodeIds":[730800255]},{"nodeId":730800255,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":1733395482,"text":"…そうか、分かった。この先、君の前には現れない。あとファデュイに戻るつもりもない。俺の任務は失敗したからな、「兄弟姉妹」に恥をかかせることになる。","nextNodeIds":[730800256]},{"nodeId":730800256,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":4063596402,"text":"イッサムはずっと、「アルフォンソ」お兄さんの帰りを待つだろうな…","nextNodeIds":[730800257,730800259]},{"nodeId":730800257,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":642269354,"text":"もう行って。パイモンが戻ってくる。","nextNodeIds":[730800258]},{"nodeId":730800258,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":1745014778,"text":"それじゃあな。いや、永遠にさよならだ。","nextNodeIds":[]},{"nodeId":730800259,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":103772866,"text":"（戦闘）考えが変わった。","nextNodeIds":[730800260]},{"nodeId":730800260,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":55867850,"text":"#悪者にふさわしい結末が、何なのか分かった…ただ黙って待つつもりはない。たとえ相手が{NICKNAME}で、たとえ俺に勝算がなくとも、俺は全力で戦う。なぜなら…","nextNodeIds":[730800261]},{"nodeId":730800261,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":396936402,"text":"俺は善の中の悪、薬の中の毒、子羊の中の狼、黄金の杯にある水銀…俺の名はスネージヴィッチ。さあ、来いッ！","nextNodeIds":[]},{"nodeId":730800262,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4034224082,"text":"（戦闘）アランラナとある約束をした…","nextNodeIds":[730800263]},{"nodeId":730800263,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1009951346,"text":"悪者を必ず懲らしめるって。","nextNodeIds":[730800264]},{"nodeId":730800264,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":4060892066,"text":"#悪者にふさわしい結末が、何なのか分かった…ただ黙って待つつもりはない。たとえ相手が{NICKNAME}で、たとえ俺に勝算がなくとも、俺は全力で戦う。なぜなら…","nextNodeIds":[730800265]},{"nodeId":730800265,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":2437595170,"text":"俺は善の中の悪、薬の中の毒、子羊の中の狼、黄金の杯にある水銀…俺の名はスネージヴィッチ。さあ、来いッ！","nextNodeIds":[]},{"nodeId":730800251,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1925887946,"text":"理解できない。","nextNodeIds":[730800252]},{"nodeId":730800252,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2528363514,"text":"#それに、{M#君}{F#あなた}を理解しようとも思わない。","nextNodeIds":[730800253]},{"nodeId":730800210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":529010194,"text":"#{M#君}{F#あなた}はファデュイの状況に詳しい。","nextNodeIds":[730800211]},{"nodeId":730800211,"roleType":"TALK_ROLE_NPC","speakerId":20593,"speakerName":"アルフォンソ","textMapHash":1130848818,"text":"ファデュイが悪事を働いているなんてことは、この大陸にいる人であれば多かれ少なかれ耳にしたことあるだろう…とにかく、俺がファデュイである証拠を君は持っていないんじゃないか。","nextNodeIds":[730800212]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7308003,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7308004,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","L