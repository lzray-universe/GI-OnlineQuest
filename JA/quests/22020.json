":220200114,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1490156442,"text":"しかし…今日は所長から別件の調査も頼まれていて、時間的に少し厳しいんです…","nextNodeIds":[220200115]},{"nodeId":220200115,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3083419674,"text":"旅人、このお菓子をあの三方に渡してくれませんか？","nextNodeIds":[220200116,220200118]},{"nodeId":220200116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2032863586,"text":"任せて。","nextNodeIds":[220200117]},{"nodeId":220200117,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3233056314,"text":"手伝ってくれてありがとうございます。","nextNodeIds":[220200121]},{"nodeId":220200121,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3576476770,"text":"ここには三つのお菓子があります。天野さん、安藤さん、それに大和田さんにお願いします。","nextNodeIds":[220200122]},{"nodeId":220200122,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4292898394,"text":"大和田さん？","nextNodeIds":[220200123]},{"nodeId":220200123,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":1483560250,"text":"彼も昔の同僚でした。私が奉行所から離れる前は、お世話になっていました。","nextNodeIds":[220200124]},{"nodeId":220200124,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":896957842,"text":"以前連続窃盗事件を処理していた時、奉行所にいた彼に助けてもらったんです。","nextNodeIds":[220200125]},{"nodeId":220200125,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":565008242,"text":"それではこの件はお任せします。終わったら、ここでまたお会いしましょう。","nextNodeIds":[]},{"nodeId":220200118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":149138378,"text":"#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が贈った方がいい。","nextNodeIds":[220200119]},{"nodeId":220200119,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":4010245818,"text":"いえ…やはり所長の依頼の方が重要なので…","nextNodeIds":[220200120]},{"nodeId":220200120,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":211110370,"text":"時間がある時にまたあのお三方にあいさつしに行きます。","nextNodeIds":[220200121]},{"nodeId":220200110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":396188802,"text":"珊瑚が考えた策だね…","nextNodeIds":[220200111]},{"nodeId":220200106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1466033298,"text":"#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちが力になったわけじゃないの？","nextNodeIds":[220200107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2202001,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3042","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":2202002,"order":2,"stepDescription":"天野と安藤と会話する","stepDescTextMapHash":447798588,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2202002,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["3046","SELECT_NPC_NONE"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[2202002],"talks":[{"talkId":2202002,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontB