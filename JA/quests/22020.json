,""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2202005,"initDialog":220200501,"nextRandomTalks":[],"nextTalks":[],"npcId":[3042],"performCfg":"","priority":5,"questId":22020,"showRandomTalkCount":0},"dialogs":[{"nodeId":220200501,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":877315330,"text":"お疲れ様です、旅人。プレゼントは…無事渡せましたか？","nextNodeIds":[220200502,220200503]},{"nodeId":220200502,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":586588402,"text":"全部珊瑚に指示されたの？","nextNodeIds":[220200504]},{"nodeId":220200504,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3517682770,"text":"き…気付いてしまいました？ごめんなさい…プレゼントの件は、所長の指示です。","nextNodeIds":[220200505]},{"nodeId":220200505,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":654556218,"text":"所長は、当時の事件を完全に解決し、真犯人を明らかにするためには、あなたの力が必要不可欠だと言っていました。","nextNodeIds":[220200506,220200510]},{"nodeId":220200506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":733306338,"text":"事件はまだ解決していないの？","nextNodeIds":[220200507]},{"nodeId":220200507,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2206868458,"text":"ええ。当時、所長は「犯人」を見つけ出した時に、何もかもが…完璧すぎたと言っていました。","nextNodeIds":[220200508]},{"nodeId":220200508,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":222443274,"text":"所長が調査を始めた後、手がかりや証拠、犯行動機が自ずと手に入ったそうなんですが、それら全てがある人物を指していたのです。","nextNodeIds":[220200509]},{"nodeId":220200509,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":3604655218,"text":"結局、奉行所はその人物を犯人として扱いましたが、所長は「真犯人は別にいる」と信じています。","nextNodeIds":[220200514]},{"nodeId":220200514,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":4063897666,"text":"彼女が私を雇ってくれたのも、その事件を解決する機会を得るためだったのでしょう。","nextNodeIds":[220200515]},{"nodeId":220200515,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1043344474,"text":"#しかし、{M#俺}{F#私}に何ができるというのでしょう…","nextNodeIds":[220200516]},{"nodeId":220200516,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2067152602,"text":"所長の考えていることは…私にはよく分かりません。しかし以前、稲妻にずっといるせいか、見識が狭くなったと所長は言っていました…","nextNodeIds":[220200517]},{"nodeId":220200517,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2073209986,"text":"もし博識で自由奔放な協力者がいたら、その人が事件解決の突破口を開いてくれるかもしれません。","nextNodeIds":[220200518]},{"nodeId":220200518,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2738495762,"text":"旅人、所長が求めている協力者とは、あなたのことなのではないかと私は推測しています。","nextNodeIds":[220200519,220200521]},{"nodeId":220200519,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2863952154,"text":"#じゃあ{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も「探偵」だね？","nextNodeIds":[220200520]},{"nodeId":220200520,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":428683930,"text":"もちろん、手伝っていただけるのであれば。","nextNodeIds":[220200523]},{"nodeId":220200523,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":306493154,"text":"いずれにしても、色々と助けてもらいましたので、今回の報酬を先に受け取ってください。","nextNodeIds":[220200524]},{"nodeId":220200524,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3406922066,"text":"それも珊瑚から指示されたこと？","nextNodeIds":[220200525]},{"nodeId":220200525,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":2768715946,"text":"いいえ、今回は私自身の気持ちです。","nextNodeIds":[220200526]},{"nodeId":220200526,"roleType":"TALK_ROLE_NPC","speakerId":3042,"speakerName":"龍二","textMapHash":705937866,"text":"改めて感謝申し上げます。もしよろしければ、また遊びに来てください。所長もきっと歓迎するでしょう。",