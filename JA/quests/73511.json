ONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351103,"initDialog":735110301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351103","priority":5,"questId":73511,"showRandomTalkCount":0},"dialogs":[{"nodeId":735110301,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1369725610,"text":"この角度から潜入して、地形をうまく利用して隠れる…太陽の角度がこれより低ければ…僕がこれより速ければ…はぁ、やはり無理だ！","nextNodeIds":[735110302]},{"nodeId":735110302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1856574234,"text":"何の計算？","nextNodeIds":[735110303]},{"nodeId":735110303,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1315784610,"text":"「正面から魔物と接触せずにパーツを回収できるルート」さ…ウェネトのせいで、僕のお宝パーツが全部辺りの魔物の群れに吹き飛ばされてしまった…","nextNodeIds":[735110304]},{"nodeId":735110304,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1644222418,"text":"——ってうわっ！誰だ君たち？いつからここにいた！","nextNodeIds":[735110305]},{"nodeId":735110305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3248727362,"text":"ずっと隣でぶつぶつ言ってるのを聞いてた…","nextNodeIds":[735110306]},{"nodeId":735110306,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1141232442,"text":"安心しろ！オイラたちは悪いやつなんかじゃないぞ。オイラたち、おまえの仲間に頼まれてきたんだ！","nextNodeIds":[735110307]},{"nodeId":735110307,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":142463234,"text":"仲間だと？まさかシュリヤのやつか？いやいや、あいつは僕が魔物に捕まっても知らないって言ってたから…","nextNodeIds":[735110308]},{"nodeId":735110308,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3853575738,"text":"あっ——わかったぞ。あいつが君たちにパーツの回収を頼んだってことだな！","nextNodeIds":[735110309]},{"nodeId":735110309,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","text