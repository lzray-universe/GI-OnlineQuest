[745140114]},{"nodeId":745140114,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":553375066,"text":"もちろん！キャンバスは私の魂なんだから、手放すわけないでしょ。","nextNodeIds":[745140115]},{"nodeId":745140115,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":217975186,"text":"実は、私が描いた絵がフォンテーヌでまあまあ売れててさ。こっちの作家から、小説の表紙を描いてほしいって依頼ももらってるんだ。","nextNodeIds":[745140116]},{"nodeId":745140116,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":1740075146,"text":"でも…小説に挿絵を入れる習慣はないみたいなんだよね。なんでだろう…","nextNodeIds":[745140117]},{"nodeId":745140117,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":1155909082,"text":"#そうだ、{NICKNAME}！ここで会ったのも何かの縁ってことで…素材探しを手伝ってくれないかな？","nextNodeIds":[745140118,745140120]},{"nodeId":745140118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1466145194,"text":"いいよ。","nextNodeIds":[745140119]},{"nodeId":745140119,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":150814442,"text":"ありがとう！君が手を貸してくれるなら安心だよ。","nextNodeIds":[745140123]},{"nodeId":745140123,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":170746466,"text":"ちょっと待ってね…作家さんから受けた依頼はいくつかあって…","nextNodeIds":[]},{"nodeId":745140120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3402098330,"text":"いいけど、その代わり大人しくしててね。","nextNodeIds":[745140121]},{"nodeId":745140121,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":263237682,"text":"うん、分かった。あのマシナリーとかいうのに、私は手も足も出ないけど…","nextNodeIds":[745140122]},{"nodeId":745140122,"roleType":"TALK_ROLE_NPC","speakerId":30567,"speakerName":"朝霧","textMapHash":3698016962,"text":"変な魔物を倒すことなら、君の右に出る人はいないでしょ！","nextNodeIds":[745140123]},{"nodeId":745140108,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":115492618,"text":"手紙を送って確かめようかな。","nextNodeIds":[745140109]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPK