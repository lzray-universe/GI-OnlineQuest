:[730810313]},{"nodeId":730810313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4227834202,"text":"それは知り合いって言うのか…？","nextNodeIds":[730810314]},{"nodeId":730810314,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"アランカヴィ","textMapHash":702265530,"text":"では、どうやって知り合いになるんだ？ナラのように「紹介」して「握手」するのか？","nextNodeIds":[730810315]},{"nodeId":730810315,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"アランマ","textMapHash":3910946026,"text":"ううん、パイモンが言いたいことは分かる。ナラは一緒にご飯を食べて、一緒に「お宝」を探して初めて知り合いになる。そうだよね？","nextNodeIds":[730810316,730810317,730810318]},{"nodeId":730810316,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4043922266,"text":"いや、そう簡単に表せることでは…","nextNodeIds":[730810321]},{"nodeId":730810321,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"アランカヴィ","textMapHash":230516074,"text":"物語を知りさえすれば、それで知り合いだ。アランナラの世界は歌の世界、夢の世界だからな。","nextNodeIds":[730810322]},{"nodeId":730810322,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"アランマ","textMapHash":2125602114,"text":"#うん、アランカヴィの言う通り。アランナラにとっては、ナラ{NICKNAME}の描いた歌を聞いたり、夢にナラ{NICKNAME}を見たりすれば、それで知り合いさ。","nextNodeIds":[730810323]},{"nodeId":730810323,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":751145618,"text":"まあ、それはもう置いとこうぜ…なんせ、オイラたちはもうアランナラの友達だからな！","nextNodeIds":[730810324]},{"nodeId":730810324,"roleType":"TALK_ROLE_NPC","speakerId":20825,"speakerName":"アランマとアランカヴィ","textMapHash":4202010802,"text":"友達！","nextNodeIds":[730810325,730810327]},{"nodeId":730810325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1582730962,"text":"友達！","nextNodeIds":[730810328]},{"nodeId":730810328,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2941924594,"text":"おう、オイラたちウツァヴ祭をするんだ。アランカヴィも準備を手伝ってくれないか！","nextNodeIds":[730810329]},{"nodeId":730810329,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"アランカヴィ","textMapHash":2088174266,"text":"やはりそうか。ビージャの実が必要なんだな？もうアランヤサとアランダサ、アランシュティガに「アシュヴァッタ堂」を探しに行かせてあるぞ。","nextNodeIds":[730810330]},{"nodeId":730810330,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1616529034,"text":"よく分かったな…でも、なんでおまえたちもアシュヴァッタ堂がどこにあるか知らないんだ？","nextNodeIds":[730810331]},{"nodeId":730810331,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"アランマ","textMapHash":3450168938,"text":"アシュヴァッタ堂はとても神聖な場所だから、普段行かないんだ。すべての記憶がサルバの中で混ざり合うまで、ヴァサラの樹を夢の中で静かに眠らせるためにね。","nextNodeIds":[730810332]},{"nodeId":730810332,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"アランカヴィ","textMapHash":2969899602,"text":"森はすべてを記憶する。すべての美しいことは消えない。すべての苦しみも、すべての美しいことの養分になる…","nextNodeIds":[730810333]},{"nodeId":730810333,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"アランカヴィ","textMapHash":64746450,"text":"とにかく、アランヤサとアランダサ、アランシュティガたちは外でアシュヴァッタ堂を探している。アランマ、オマエも手伝いに行ってくるんだ。","nextNodeIds":[730810334]},{"nodeId":730810334,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"アランマ","textMapHash":1782535066,"text":"#うん、分かった、行ってくるよ。ナラ{NICKNAME}にパイモン、森で会ったらまた一緒に冒険しよう！","nextNodeIds":[730810335]},{"nodeId":730810335,"roleType":"TALK_ROLE_NPC","speakerId":20656,"speakerName":"アランカヴィ","textMapHash":3444834338,"text":"#よしよし。会えて嬉しかったぞ、ナラ{NICKNAME}とパイモン！","nextNodeIds":[]},{"nodeId":730810327,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2928454810,"text":"そろそろ本題を…","nextNodeIds":[730810328]},{"nodeId":730810317,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3903316786,"text":"なんと言うか…","nextNodeIds":[730810321]},{"nodeId":730810318,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2867429954,"text":"パイモンと一緒に食事や宝探しをしてきた。","nextNodeIds":[730810319]},{"nodeId":730810319,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1395712986,"text":"おう！オイラたちは知り合いを越えて、最高の仲間だ！","nextNodeIds":[730810320]},{"nodeId":730810320,"roleType":"TALK_ROLE_NPC","speakerId":20646,"speakerName":"アランマ","textMapHash":2883923698,"text":"#ナラ{NICKNAME}とパイモン、すごい！","nextNodeIds":[730810321]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7308103,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[0,0],"PAINLIBBLDK":"QUEST_CONTENT_GAME_TIME_TICK","PPFLKMOMKAI":"0,24"}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["20656"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7308104,"order":3,"stepDescription":"「アシュヴァッタ堂」を探して探索する","stepDescTextMapHash":374538276,"finishConds":[{"BFGALAINLMD":3,"LNHLPKELCAL":[7308104,0],"PAINLIBBLDK":"QUEST_CONTENT_ADD_QUEST_PROGRESS","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"},"isHidden":false,"talkIds":[7308104],"talks":[{"talkId":7308104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_E