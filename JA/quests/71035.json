3]},{"nodeId":710350313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2750683234,"text":"まさか…銅雀さんの彫像を狙ってるんじゃないよな？","nextNodeIds":[710350314]},{"nodeId":710350314,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":4014861170,"text":"とんでもない！そんなバチ当たりなこと、考える訳ないじゃないですか！","nextNodeIds":[710350315]},{"nodeId":710350315,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3536117986,"text":"じゃあ、何が目的？","nextNodeIds":[710350316]},{"nodeId":710350316,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":2782220578,"text":"私はただ…お寺を修繕したいだけなんです。","nextNodeIds":[710350317]},{"nodeId":710350317,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":472314106,"text":"今日来たのも、お寺の現状を確認し、必要な建材を買うためでした。","nextNodeIds":[710350318]},{"nodeId":710350318,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":2964318618,"text":"まさか途中で宝盗団に狙われ、逃げ回るはめになるとは思いませんでしたが。","nextNodeIds":[710350319]},{"nodeId":710350319,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1288997850,"text":"そして、逃げているうちに道に迷ってしまい、その後のことは見ての通りです。","nextNodeIds":[710350320]},{"nodeId":710350320,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3021137266,"text":"とりあえず、お寺で詳しく話を聞こう。","nextNodeIds":[710350321]},{"nodeId":710350321,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":2653965546,"text":"そうですね。ここで話すのもなんですし、お寺へ向かいましょう。","nextNodeIds":[710350322]},{"nodeId":710350322,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":3104059058,"text":"詳しいことは、そこに着いてからで。","nextNodeIds":[710350323]},{"nodeId":710350323,"roleType":"TALK_ROLE_NPC","speakerId":10204,"speakerName":"魈","textMapHash":2501669714,"text":"先に行くがいい。我は他に用がある。","nextNodeIds":[710350324]},{"nodeId":710350324,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2451965634,"text":"え？行っちゃうのか？","nextNodeIds":[710350325]},{"nodeId":710350325,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2219528818,"text":"もう…いなくなっちゃった…","nextNodeIds":[]},{"nodeId":710350308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1636775370,"text":"覚えてる。","nextNodeIds":[710350309]},{"nodeId":710350309,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":4225698362,"text":"それはよかった。","nextNodeIds":[710350310]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["12326"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7103507,"order":7,"stepDescription":"銅雀の彫像の在り処に戻る","stepDescTextMapHash":2532799876,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103507,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7103503_N10204_310701425","20"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[],"talks":[],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103507,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":