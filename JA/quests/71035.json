lkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7103508","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7103504,"initDialog":710350401,"nextRandomTalks":[],"nextTalks":[],"npcId":[12326,1005],"performCfg":"QuestDialogue/WQ/Liyue_71035/Q7103504","priority":5,"questId":71035,"showRandomTalkCount":0},"dialogs":[{"nodeId":710350401,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":4147721114,"text":"このお寺、相変わらずの荒れ具合ですね…","nextNodeIds":[710350402]},{"nodeId":710350402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":383215634,"text":"それで、どうして急にお寺の修繕なんかしようと思ったんだ？","nextNodeIds":[710350403]},{"nodeId":710350403,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":3752397114,"text":"コホンッ、話すと長くなってしまうのですが…","nextNodeIds":[710350404]},{"nodeId":710350404,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":2584725058,"text":"私は仙人を演じるため、さまざまな参考資料を集めてきました…","nextNodeIds":[710350405]},{"nodeId":710350405,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1966071482,"text":"あの日、私は仙人の教訓を肝に銘じ、正しき道に立ち返ることを誓いましたよね？そして、家にある参考資料をすべて捨てようと思ったのです。","nextNodeIds":[710350406]},{"nodeId":710350406,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1911946722,"text":"しかし、参考資料を破棄しようとした時、あることを思いつきました。その資料と私がかつて使った人を騙す手段を整理して、人々に配ってみようと。","nextNodeIds":[710350407]},{"nodeId":710350407,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":3409728618,"text":"そうすれば、詐欺の防止に貢献できるかもしれないと思いました。","nextNodeIds":[710350408]},{"nodeId":710350408,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1897777762,"text":"意外にも、私が作った冊子は多くの人の役に立つことができました。総務司からも礼を言われたほどです。","nextNodeIds":[710350409]},{"nodeId":710350409,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":4020107786,"text":"すると、私が書いた内容だけでなく、違う内容もそこに追加して欲しいとの依頼が来ました…","nextNodeIds":[710350410]},{"nodeId":710350410,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":512522202,"text":"それで、かなりの報酬をいただくことになったのです。","nextNodeIds":[710350411]},{"nodeId":710350411,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":3385262618,"text":"また私はその冊子だけでなく、「護法夜叉」に関する本も書いています。","nextNodeIds":[710350412]},{"nodeId":710350412,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1892070186,"text":"目的はもちろん、「護法夜叉」の物語を世に広めることです。","nextNodeIds":[710350413]},{"nodeId":710350413,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1926547058,"text":"こうすることで、私の民俗学の知識を正しいことに活かすことができると考えました。","nextNodeIds":[710350414]},{"nodeId":710350414,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":2053042986,"text":"この「銅雀」に縁のあるお寺も、「護法夜叉」に関する本を執筆する時に発見したものです。","nextNodeIds":[710350415]},{"nodeId":710350415,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":3647946802,"text":"このお寺は夜叉である「銅雀」を祀るため、ご先祖様が建てたという記録が残っています。","nextNodeIds":[710350416]},{"nodeId":710350416,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1766335906,"text":"やっとの思いで見つけたのですが、まさかこのように荒れ果てたお寺だとは想像もしていませんでした。","nextNodeIds":[710350417]},{"nodeId":710350417,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1826521074,"text":"私は悩んだ末、お寺の修繕にかかるお金を自ら捻出することにしました。","nextNodeIds":[710350418]},{"nodeId":710350418,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":711150674,"text":"なにせ、こうして正しい道に戻れたのも、仙人のおかげですからね。","nextNodeIds":[710350419]},{"nodeId":710350419,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":2003329858,"text":"お寺の修繕も、これまで私が犯してきた悪事の償いになります。","nextNodeIds":[710350420]},{"nodeId":710350420,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1485631066,"text":"うーん…嘘はついてないみたいだな…","nextNodeIds":[710350421]},{"nodeId":710350421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1762228138,"text":"#{NICKNAME}、おまえはどう思う？","nextNodeIds":[710350422,710350424]},{"nodeId":710350422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":839638650,"text":"たぶん嘘じゃなさそう。","nextNodeIds":[710350423]},{"nodeId":710350423,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":3390370178,"text":"たぶんとはなんですか。正真正銘、本当のことです！","nextNodeIds":[710350426]},{"nodeId":710350426,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":1664919674,"text":"はぁ、まあいいです。好きに思ってくれて構いません…","nextNodeIds":[710350427]},{"nodeId":710350427,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":4097522890,"text":"まだ信じられないのでしたら、修繕が始まった頃にまた見に来てください。","nextNodeIds":[]},{"nodeId":710350424,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2973950978,"text":"前は詐欺師だったし…","nextNodeIds":[710350425]},{"nodeId":710350425,"roleType":"TALK_ROLE_NPC","speakerId":12326,"speakerName":"平安","textMapHash":3839317346,"text":"でも、今はもう違います！私は仙人の前で誓いを立て、真人間になりましたからね！","nextNodeIds":[710350426]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7103504,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions"