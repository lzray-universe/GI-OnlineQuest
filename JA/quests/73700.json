aram":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7370006,"initDialog":737000601,"nextRandomTalks":[],"nextTalks":[],"npcId":[13210],"performCfg":"QuestDialogue/WQ/Sumeru_73697/Q7370006","priority":5,"questId":73700,"showRandomTalkCount":0},"dialogs":[{"nodeId":737000601,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1996814290,"text":"静かだな…誰もいない。","nextNodeIds":[737000602]},{"nodeId":737000602,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3782890458,"text":"ラシュヌがいるにしても、きっと静かにしてるんでしょうネ。","nextNodeIds":[737000603]},{"nodeId":737000603,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2485706306,"text":"うん、でもあいつがいるんだったら音量を抑えないとな。あいつ、いつも眠そうだし、前回オイラたちのコリュの太鼓に起こされたときも、ちょっと不機嫌そうだったぞ。","nextNodeIds":[737000604]},{"nodeId":737000604,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3898012386,"text":"無口なやつほど怒ると怖いって言うけど、怒り爆発モードのラシュヌはどんな感じなんだろうな…","nextNodeIds":[737000605]},{"nodeId":737000605,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2493694610,"text":"だったら、我が「謁賛主」が一番怖いんじゃナイかしら？","nextNodeIds":[737000606]},{"nodeId":737000606,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3469568002,"text":"え？こいつのことはオイラが一番知ってるぜ。無口なやつだけど、すっごく優しいもんな？","nextNodeIds":[737000607,737000609]},{"nodeId":737000607,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":72672338,"text":"じゃあ本気で怒るよ。うがーーー！！！","nextNodeIds":[737000608]},{"nodeId":737000608,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":338430874,"text":"ほら、ちっとも怖くないだろ。","nextNodeIds":[737000611]},{"nodeId":737000611,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":1207589226,"text":"まあいいワ、そろそろ本題に戻りまショ。","nextNodeIds":[737000612]},{"nodeId":737000612,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3572510474,"text":"あなたたちの目の前にあるのは「バルソム」という木で、ラシュヌはこの木の眷属なノ。でも、彼女は今ここにはいナイ。","nextNodeIds":[737000613]},{"nodeId":737000613,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":806555930,"text":"それでそれで？","nextNodeIds":[737000614]},{"nodeId":737000614,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":1842673930,"text":"それでおしまい。ラシュヌと「バルソム」については、特に補足事項ナシ。","nextNodeIds":[737000615]},{"nodeId":737000615,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4085563674,"text":"何か隠してる感じがするぞ…あ、そうだ、コリュの太鼓についてだけど…","nextNodeIds":[737000616]},{"nodeId":737000616,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2527608266,"text":"な、何も隠したりなんかしてないわヨ。コリュの太鼓については…あなたたちだって見たことあるデショ？","nextNodeIds":[737000617]},{"nodeId":737000617,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2111386834,"text":"たしか、あの時ラシュヌがコリュの太鼓をあちこちに捨てたって言ったら、ナセジュナがびっくりしてたよな。","nextNodeIds":[737000618]},{"nodeId":737000618,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":578541842,"text":"オイラの記憶が正しければ、あのときソルシュはあたふたして、ナセジュナの質問に答えられなかったんだったよな。","nextNodeIds":[737000619]},{"nodeId":737000619,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1299699778,"text":"今考えたら、スケプティック団の文献や書籍って本当にでたらめなんじゃないのか？","nextNodeIds":[737000620]},{"nodeId":737000620,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3681789994,"text":"楽譜通りの演奏でラシュヌを起こせはした。","nextNodeIds":[737000621]},{"nodeId":737000621,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1109985642,"text":"うーん、ズルヴァーンがスケプティック団を信用しないのも分かる気がするぜ。よく考えたら、あいつらって本当に役に立ってるのかよ？あいつらから手に入れた手がかりだって半分は嘘だったし…","nextNodeIds":[737000622]},{"nodeId":737000622,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":301766690,"text":"う…うぅ…","nextNodeIds":[737000623]},{"nodeId":737000623,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":1857164138,"text":"確かに今のスケプティック団には当てにならない団員がいくらかいるワ。でも、どんな立派な大木でも、枯れた枝や葉っぱぐらいあるものデショ？","nextNodeIds":[737000624]},{"nodeId":737000624,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2761566466,"text":"そういう枯れた枝葉が全部落ちてしまえば、の…残るのはきっと、ちゃんとした…はぁ…","nextNodeIds":[737000625]},{"nodeId":737000625,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":51779186,"text":"…どうしてスケプティック団は今みたいな状態になっちゃったのかしら？","nextNodeIds":[737000626]},{"nodeId":737000626,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1067116250,"text":"#{M#俺}{F#私}もそれが知りたい。","nextNodeIds":[737000627]},{"nodeId":737000627,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3988114938,"text":"スケプティック団の人間とずっと一緒にいたせいで、かえって彼らの色んな変化に気づくことができなかったワ…","nextNodeIds":[737000628]},{"nodeId":737000628,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2648244090,"text":"あなたたちのような、よその人間と話して初めて、もう過去のスケプティック団とは全然違うんだってことが分かったワ。","nextNodeIds":[737000629]},{"nodeId":737000629,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3457618018,"text":"何百年も経ってるし、「スケプティック団」っていう名前こそ変わってないけど、メンバーは何世代も交代してるわけだからな。","nextNodeIds":[737000630]},{"nodeId":737000630,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":3140754914,"text":"私の追い求める名声も、人間の「謁賛主」によって伝承されるハズの名声も、最後には同じ結果になるのかしら…何もかもが変わって、最後に残るのは、空虚な称号だけ。","nextNodeIds":[737000631]},{"nodeId":737000631,"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","textMapHash":2666207210,"text":"先輩が私に悟らせたかったのはこういうことなノ？そんなハズ…でも…","nextNodeIds":[737000632]},{"nodeId":737000632,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2854574482,"text":"…おい、そんなに落ち込むなよ。ズルヴァーンも…そういう意味じゃなかったのかもしれないし…","nextNodeIds":[737000633]},{"nodeId":737000633,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2379895410,"text":"ソルシュが落ち込んでるのを見たら、なんかオイラまで申し訳ない気持ちになってきたぞ…後でズルヴァーンに慰めてもらおう。","nextNodeIds":[]},{"nodeId":737000609,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2584576626,"text":"……","nextNodeIds":[737000610]},{"nodeId":737000610,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1977997138,"text":"#…何か言えよ！{NICKNAME}！じっと黙りこくってると本当にちょっと怖いぞ…","nextNodeIds":[737000611]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7370006,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7370006_N13210"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7370001,7370006],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":16},{"roleType":"TALK_ROLE_NPC","speakerId":13210,"speakerName":"ソルシュ","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":4284,"speakerName":"ズルヴァーン","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[173700],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":904683118,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[73701],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"Ques