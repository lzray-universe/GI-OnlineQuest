","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":7419102,"initDialog":741910201,"nextRandomTalks":[],"nextTalks":[],"npcId":[21462,21355],"performCfg":"QuestDialogue/WQ/Fontaine_74191/Q7419102","priority":5,"questId":74191,"showRandomTalkCount":0},"dialogs":[{"nodeId":741910201,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":2935772298,"text":"陛下、陛下、大丈夫ですか？まさかまた夢をご覧になったのですか…？","nextNodeIds":[741910202]},{"nodeId":741910202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1201305002,"text":"騒がしいな。何があった…","nextNodeIds":[741910203]},{"nodeId":741910203,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":2498799698,"text":"市民たちがホールに集まっています。陛下にお聞きしたいことがあるようです。","nextNodeIds":[741910204]},{"nodeId":741910204,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":1695149194,"text":"最近、「フォボス」のメロディーが何度も途切れていますから、市民たちは疑問に思っているのでしょう。","nextNodeIds":[741910205]},{"nodeId":741910205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3423699418,"text":"そうするしかないのだ…","nextNodeIds":[741910206]},{"nodeId":741910206,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":4271217546,"text":"もちろん、陛下のご判断を信じます。最近の出来事は私も耳にしましたが…「フォボス」に何かあったのですか？","nextNodeIds":[741910207]},{"nodeId":741910207,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":2415286554,"text":"全人類の幸せのために、「フォボス」は一人ひとりに道を作ったはずです。無限に近い「シビラ」の計算力に頼れば、何も問題などないはずではないのですか…？","nextNodeIds":[741910208]},{"nodeId":741910208,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3849587506,"text":"メロディーの中に悲鳴を聞いた…","nextNodeIds":[741910209]},{"nodeId":741910209,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":2507806194,"text":"まさか、誰かがこっそり「フォボス」の楽譜を書き換えたのですか？いいえ、陛下や我々調律師以外に、それができる人はいないでしょう…","nextNodeIds":[741910210]},{"nodeId":741910210,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":4024087994,"text":"まさか、あの予言者は何かを隠していたのでしょうか…？いいえ、あり得ません。彼女はすでに己の命を捧げ、彼女の予言も水の主によって証明されました。私心など挟めるはずもない…","nextNodeIds":[741910211]},{"nodeId":741910211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1225289866,"text":"あるいは、私心がなかったからこそ…","nextNodeIds":[741910212]},{"nodeId":741910212,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":1293996594,"text":"今は、誰もが「フォボス」の判断に頼っています。もし「フォボス」に何か問題が起これば、民衆たちは混乱に陥るでしょう…","nextNodeIds":[741910213,741910214]},{"nodeId":741910213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3418519138,"text":"盲信者たちのところに行ってくれ…","nextNodeIds":[741910215]},{"nodeId":741910215,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":3960423690,"text":"つまり、不測の事態を防ぐために、私のメロディーを大楽章から引き離すということですか？","nextNodeIds":[741910216]},{"nodeId":741910216,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":3247573962,"text":"しかし…それはまだ早いのではないでしょうか。私の魂はまだ偉大な運命に耐えられるほど強くないかもしれません…","nextNodeIds":[741910217,741910218]},{"nodeId":741910217,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3350124026,"text":"信じている。","nextNodeIds":[741910219]},{"nodeId":741910219,"roleType":"TALK_ROLE_NPC","speakerId":21355,"speakerName":"カッシオドル","textMapHash":2557387890,"text":"…分かりました。覚悟はすでにできています。それが陛下の願いなら、叶えて差し上げましょう。","nextNodeIds":[741910220,741910221]},{"nodeId":741910220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3460902434,"text":"「ウラノポリス」、未来の都…","nextNodeIds":[741910222]},{"nodeId":741910222,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":2223454810,"text":"「██████」が去った後、あなたは金色の回廊を通り抜ける。議論の声が次第に大きくなってくる。\\nあなたがホールの真ん中にある壇上に登ると、あたりはようやく静かになった。","nextNodeIds":[741910223]},{"nodeId":741910223,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":293317314,"text":"偉大なる至尊よ、どうかお告げを…","nextNodeIds":[741910224]},{"nodeId":741910224,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":3501978258,"text":"近頃、「フォボス」のメロディーが聞こえないせいで、市民は恐怖と困惑の最中にいました。","nextNodeIds":[741910225]},{"nodeId":741910225,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":4206581714,"text":"偉大な計画は順調に進み…影に潜む蛮族はどんどん消されていき、汚染された水域もイコルで浄化されたというのに…","nextNodeIds":[741910226]},{"nodeId":741910226,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":1025714586,"text":"陛下は何故、意味もなく尊き戦争を止めようとなさっているのですか？","nextNodeIds":[741910227]},{"nodeId":741910227,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":575778018,"text":"私には考えがある。","nextNodeIds":[741910228]},{"nodeId":741910228,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":1142111338,"text":"偉大なる至尊、あなた様の権威に逆らうつもりはありません。ですが、蛮族には十分に慈悲深くなさっていると思います。","nextNodeIds":[741910229]},{"nodeId":741910229,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":3621578722,"text":"私たちは偉大な秩序をもたらしました。黄金の秩序に組み込まれようとする者に、レムリアの扉はいつも開かれています。","nextNodeIds":[741910230]},{"nodeId":741910230,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":2398915402,"text":"しかし、あの蛮族たちはどうでしょう？彼らは我々の高塔を壊し、我々の楽師を殺しました。彼らの魂では、救われるべきではありません。","nextNodeIds":[741910231]},{"nodeId":741910231,"roleType":"TALK_ROLE_NPC","speakerId":21462,"speakerName":"ボエティウス","textMapHash":552426138,"text":"我々は赤い血で荒れ果てた大地を浄化しています。そして、秩序と文明というものは滅んだあとに生まれ変わるのです。愚かな種族にとって、これは至高の恩賜と言えるでしょう。","nextNodeIds":[741910232]},{"nodeId":741910232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1602455058,"text":"そんなこと