st":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7114403","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7114403,"initDialog":711440301,"nextRandomTalks":[],"nextTalks":[],"npcId":[30601],"performCfg":"QuestDialogue/WQ/4.7_guaiwuduitui_71144/Q7114403","priority":5,"questId":71144,"showRandomTalkCount":0},"dialogs":[{"nodeId":711440301,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":450417874,"text":"#盤石を彫ったような顔立ち、並々ならぬその雰囲気…さては、君が噂の智将{NICKNAME}だな？","nextNodeIds":[711440302]},{"nodeId":711440302,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":2628317458,"text":"その名はかねがね伺っていた。冒険者協会を通して君に会議への出席依頼の手紙を出そうと考えていたところだったが、まさか君から察して来てくれるとは。","nextNodeIds":[711440303,711440304]},{"nodeId":711440303,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1775311922,"text":"智将？","nextNodeIds":[711440305]},{"nodeId":711440305,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2773735242,"text":"#す、すごくかしこまった言い方だな。{NICKNAME}のことを…プロの戦士だとでも思ってるのか？","nextNodeIds":[711440306]},{"nodeId":711440306,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":858647930,"text":"戦士というだけではない。五つの国を渡り歩きながら、数え切れないほどの魔物や強者と戦ったその実績は、各国の部隊によって記録され、繰り返し分析されている。","nextNodeIds":[711440307]},{"nodeId":711440307,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":1125170466,"text":"西風騎士団、千岩軍、幕府の武士、三十人団、そして執律庭に至るまで、各所の作戦部隊は君の戦力と策略について最高の評価を下している——","nextNodeIds":[711440308]},{"nodeId":711440308,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":3685538370,"text":"#「{NICKNAME}は、前線での戦いはもちろん、後方の指揮も務められるほどの十分な才能の持ち主だ。可能ならば、積極的に手を組むべきである。」","nextNodeIds":[711440309]},{"nodeId":711440309,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":4030456290,"text":"というわけで、千岩軍の参謀部を代表して君に伺いたい。五国共同で開催する兵棋演習で、上級顧問を務めてくれないだろうか？","nextNodeIds":[711440310]},{"nodeId":711440310,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":701592210,"text":"上級顧問にはそれに相応しい額の報酬を支払う。参加期間中の給与は、千岩軍隊長と同じくらいになるだろう。","nextNodeIds":[711440311]},{"nodeId":711440311,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1453887202,"text":"さすが千岩軍…話し方までドストレートだな…それにしても、隊長レベルの報酬ってたしかに魅力的だぞ…","nextNodeIds":[711440312,711440313]},{"nodeId":711440312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":964288930,"text":"でも、まだ状況を把握できてない。","nextNodeIds":[711440314]},{"nodeId":711440314,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":3515378226,"text":"案ずるな。これから君たちに説明しよう。","nextNodeIds":[711440315]},{"nodeId":711440315,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":4158268338,"text":"君たちも知っている通り、テイワットの荒野をうろつく魔物の数は未だ多く、短時間で根絶やしにすることは難しい。","nextNodeIds":[711440316]},{"nodeId":711440316,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":4134994394,"text":"魔物の脅威に効率よく対応するため、近隣諸国の部隊は、よく見かける魔物の情報をまとめている。その脅威レベルを細かく評価し、一部をお互い共有しているんだ。","nextNodeIds":[711440317]},{"nodeId":711440317,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":2404352778,"text":"そして千岩軍の参謀部では、盤上の駒を様々な魔物に見立て、それらとの戦いを想定することで、できる限り各種魔物の戦力を分析しようと試みている。","nextNodeIds":[711440318]},{"nodeId":711440318,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":1088260458,"text":"今回の「合同演習」には様々な作戦部隊が参加していてな。色々な角度から駒を駆使し、最適な魔物討伐の方法を研究しているんだ。","nextNodeIds":[711440319]},{"nodeId":711440319,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":588955306,"text":"#{NICKNAME}はどの部隊にも所属していないし、類まれなる戦術の天才。分析において新たな視点を与えてくれるに違いない。演習の幅も効率も大いに向上するだろう。","nextNodeIds":[711440320]},{"nodeId":711440320,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":663834194,"text":"なんとなくわかってきた気がするぞ。ええと、つまり…一番安全で有効な魔物の倒し方を話し合うために、会議を開くってことだな？","nextNodeIds":[711440321]},{"nodeId":711440321,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2188328386,"text":"やっとオイラたちがよく知ってる分野の話になったぞ！オイラたち、色んな場所で危険なやつらにたくさん遭遇してきたし、それに棋戯とかのボードゲームも遊んだことがあるぜ！","nextNodeIds":[711440322]},{"nodeId":711440322,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":586317986,"text":"前みたいにゲームをやるだけで、いろんな国の安全を守るための手助けができて、報酬までもらえるなら…一石{RUBY#[D]いっせきたちょう}多鳥じゃないか？","nextNodeIds":[711440323,711440325]},{"nodeId":711440323,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1516459386,"text":"気軽に遊びながら大いに貢献！","nextNodeIds":[711440324]},{"nodeId":711440324,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":2306776170,"text":"ああ、その勢いだ。淡々と挑戦に立ち向かい、息をするように腕を振って危機を解決する…","nextNodeIds":[711440327]},{"nodeId":711440327,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":1741240898,"text":"盤面の準備はできているから、いつでも演習を開始できる。君の才能が光る戦略の立て方を、ぜひ拝見させていただきたい！","nextNodeIds":[]},{"nodeId":711440325,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":559713978,"text":"今回は真剣に取り組んだほうがよさそう…","nextNodeIds":[711440326]},{"nodeId":711440326,"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","textMapHash":411487698,"text":"そう気を張らないでくれ。普段魔物と戦うときと同じ心構えで十分だ。君はいかなる波乱にも動じないと、みな口を揃えて称えているぞ。","nextNodeIds":[711440327]},{"nodeId":711440313,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3603823066,"text":"兵棋演習について全く知らない…","nextNodeIds":[711440314]},{"nodeId":711440304,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2337603306,"text":"会議？","nextNodeIds":[711440305]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7114403,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30601"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7114403],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30601,"speakerName":"蘇定","count":16},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":5}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171144],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3618623022,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":true,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/4.7_guaiwuduitui_71144/Q7114403","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":5,"BKDENCDKDEE":"","BPIIFMJLJAJ":[],"DAMGEPEMGNO":false,"DBACCKDPONG":[],"DIAFFIANKPH":false,"DKOMBMCJMMN":false,"EFBOKHEHKJM":[],"EIDINNIHMHD":false,"EKANPNMEFMG":[],"ENDBMMDPPAH":[],"FALLCBHGKON":"LOGIC_NONE","GEPGLHFDBNF":[],"GLJMLHNKKKO":"TALK_BEGIN_MANUAL","HJFLPAICAEO":false,"HNFEAICLPLM":[],"HPPIPDNHFJG":false,"IBGGIID