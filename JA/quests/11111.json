,"",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1111105,"initDialog":111110501,"nextRandomTalks":[],"nextTalks":[],"npcId":[1021],"performCfg":"QuestDialogue/LQ/Hutao1_11111/Q1111105","priority":5,"questId":11111,"showRandomTalkCount":0},"dialogs":[{"nodeId":111110501,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":2607875706,"text":"どう、呪いが祓われた気がしませんか？","nextNodeIds":[111110502]},{"nodeId":111110502,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":3139488466,"text":"します、これ以上にないすっきりした気持ちです！凄く清々しい！","nextNodeIds":[111110503]},{"nodeId":111110503,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":3390920426,"text":"ありがとうございました。それからそこの旅人さんも！あなたたちが助けてくれなければ、私は呪いで死んでいたでしょう。","nextNodeIds":[111110504]},{"nodeId":111110504,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":4261522034,"text":"じゃあ、今ならもう言っていいですね——","nextNodeIds":[111110505]},{"nodeId":111110505,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":167185258,"text":"テッテテー！騙されました！","nextNodeIds":[111110506]},{"nodeId":111110506,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":1094496098,"text":"え？な、なんですか？","nextNodeIds":[111110507]},{"nodeId":111110507,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":4065977402,"text":"一般人には分からないでしょうけど、これはただの地脈鎮石で、魔物を引き寄せるものなんです。","nextNodeIds":[111110508]},{"nodeId":111110508,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":2027904218,"text":"あの魔物たちも呪いの具現化じゃなくて、本物の魔物です。","nextNodeIds":[111110509]},{"nodeId":111110509,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":161574802,"text":"あれれ？おかしいですねぇ。何もしてないのに、具合が良くなるだなんて、なんででしょうね？","nextNodeIds":[111110510]},{"nodeId":111110510,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":2660448282,"text":"ま、まさか…実は呪いにかけられてないってこと？","nextNodeIds":[111110511]},{"nodeId":111110511,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":1423448986,"text":"では、どうして病気に？","nextNodeIds":[111110512]},{"nodeId":111110512,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":1834739018,"text":"風邪を引いたか、食あたりか、はたまた心理的なものか…私的には最後のやつがよくある原因だと思いますよ。","nextNodeIds":[111110513]},{"nodeId":111110513,"roleType":"TALK_ROLE_NPC","speakerId":10343,"speakerName":"孟","textMapHash":1411350650,"text":"まさかそんなことが…","nextNodeIds":[111110514]},{"nodeId":111110514,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":3063477578,"text":"こんな原因、思いもしませんでした。と、とにかくありがとうございました。","nextNodeIds":[111110515]},{"nodeId":111110515,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3893068642,"text":"礼には及びませんよ、これからはそんなに疑心暗鬼にならないように。私も毎回こんな方法できませんから。","nextNodeIds":[111110516]},{"nodeId":111110516,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":4285882130,"text":"人生とは短きもの、生きている内に生を謳歌してください。","nextNodeIds":[111110517]},{"nodeId":111110517,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":3913870050,"text":"その一言は…少しモヤモヤしますが。","nextNodeIds":[111110518]},{"nodeId":111110518,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":2484023098,"text":"で、では僕はこれで。ご迷惑をおかけしました。","nextNodeIds":[111110519]},{"nodeId":111110519,"roleType":"TALK_ROLE_NPC","speakerId":10343,"speakerName":"孟","textMapHash":1285753314,"text":"どうやら狼兄貴が原因じゃなかったんですね。少しほっとしました。しかし、狼兄貴の行方が分からない以上、事態は変わっていません…","nextNodeIds":[111110520]},{"nodeId":111110520,"roleType":"TALK_ROLE_NPC","speakerId":10343,"speakerName":"孟","textMapHash":3560976378,"text":"一段落しましたし、引き続き狼兄貴を探しに行きませんか？","nextNodeIds":[111110521]},{"nodeId":111110521,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":2334421266,"text":"その必要はないと思うよ。","nextNodeIds":[111110522]},{"nodeId":111110522,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3289480794,"text":"だって、もう本人が来てるから。","nextNodeIds":[111110523]},{"nodeId":111110523,"roleType":"TALK_ROLE_NPC","speakerId":10343,"speakerName":"孟","textMapHash":267218042,"text":"狼、狼兄貴——！？","nextNodeIds":[111110524]},{"nodeId":111110524,"roleType":"TALK_ROLE_NPC","speakerId":10344,"speakerName":"狼兄貴","textMapHash":1174915890,"text":"あ、あの…ごめんなさい、お邪魔だったかな…","nextNodeIds":[111110525]},{"nodeId":111110525,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1069385826,"text":"あれが狼兄貴？なんで子供なんだ！？","nextNodeIds":[111110526]},{"nodeId":111110526,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3209286682,"text":"幽霊だもの、当時の姿のままなのは当然だよ。","nextNodeIds":[111110527]},{"nodeId":111110527,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":248733474,"text":"えっと、「狼兄貴」って名前とのギャップが大きすぎるんだけど。","nextNodeIds":[111110528]},{"nodeId":111110528,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3490260714,"text":"往生堂に連れて行こう。やるべきことがたくさん待ってる。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1111105,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133107140"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHP