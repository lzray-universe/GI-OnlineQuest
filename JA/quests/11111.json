NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1111102,"initDialog":111110201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10366],"performCfg":"QuestDialogue/LQ/Hutao1_11111/Q1111102","priority":5,"questId":11111,"showRandomTalkCount":0},"dialogs":[{"nodeId":111110201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1112777266,"text":"なあ、コソコソしてなにをする気なんだ？","nextNodeIds":[111110202]},{"nodeId":111110202,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":2956520746,"text":"何もしないよ、ただここで待ってるだけ。","nextNodeIds":[111110203]},{"nodeId":111110203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":616652690,"text":"はあ！？","nextNodeIds":[111110204]},{"nodeId":111110204,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3645605890,"text":"まさか魔神の呪いとか本当に信じてるの？あんなもの、とっくになくなってるよ！","nextNodeIds":[111110205]},{"nodeId":111110205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2682325002,"text":"じゃあ、なんでここに？","nextNodeIds":[111110206]},{"nodeId":111110206,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3367896682,"text":"あの二人を見たでしょ。一人は自分が呪いにかけられたと、もう一人は自分の友達が悪鬼になったと思い込んでる。それで二人とも人の話を聞き入れられない状態になってる。","nextNodeIds":[111110207]},{"nodeId":111110207,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":1082918194,"text":"はぁ、だから言ったの。一般人は何も知るべきじゃないって。","nextNodeIds":[111110208]},{"nodeId":111110208,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3403179386,"text":"こういうことで冷静さを失う人をたくさん見てきた。あの人たちを落ち着かせるためには、あの人たちが思い込んでいるものを見せてあげるしかない。","nextNodeIds":[111110209]},{"nodeId":111110209,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3003722514,"text":"鬼を信じてる人の目の前で、鬼を退治する。","nextNodeIds":[111110210]},{"nodeId":111110210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4003960746,"text":"えっと…子供をあやすのと同じ感じか…","nextNodeIds":[111110211,111110213]},{"nodeId":111110211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1557240674,"text":"一般人に世の真実を教えてあげたら？","nextNodeIds":[111110212]},{"nodeId":111110212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2150427338,"text":"そうだぞ、恐怖が未知から来てるものなら、その方がいいと思う。","nextNodeIds":[111110216]},{"nodeId":111110216,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":874467858,"text":"そんなの、真実を告げても事態が良くなる保証がないからに決まってるでしょ。","nextNodeIds":[111110217]},{"nodeId":111110217,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3554638426,"text":"「境界」に近づいた人を離れさせる。心理的な問題は、心理的な手法で対処するのが一番。","nextNodeIds":[111110218]},{"nodeId":111110218,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2051183866,"text":"それもそうだな…じゃあ、呪いのことはどう言うんだ？","nextNodeIds":[111110219]},{"nodeId":111110219,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3274830018,"text":"「夜叉」の歴史って、聞いたことある？","nextNodeIds":[111110220,111110221]},{"nodeId":111110220,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":513549018,"text":"聞いたことない。","nextNodeIds":[111110222]},{"nodeId":111110222,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3872421450,"text":"その昔、彼らは魔神と激しく戦った。魔神は敗れたけど、怨嗟はずっと残り続けた。","nextNodeIds":[111110223]},{"nodeId":111110223,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3834807714,"text":"その怨嗟が疫病となり、人々を蝕んだ。人々はそれを、「魔神が下した呪い」だと信じて疑わなかったの。","nextNodeIds":[111110224]},{"nodeId":111110224,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3781709914,"text":"たくさんの命が疫病によって奪われ、死んだ体を媒介に疫病はどんどん拡散していった。","nextNodeIds":[111110225]},{"nodeId":111110225,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":4030649026,"text":"後になって、人々はやっと疫病の拡散を阻止する方法を見つけたの。空気を浄化し、死骸を焼く。そして初めてそれを行ったのが、この「往生堂」の創始者なの。","nextNodeIds":[111110226]},{"nodeId":111110226,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2342520250,"text":"そ、そうだったのか。","nextNodeIds":[111110227]},{"nodeId":111110227,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":2442247610,"text":"うん、それから何年か経ち、疫病は完全に消滅した。","nextNodeIds":[111110228]},{"nodeId":111110228,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":1550266082,"text":"同じような出来事を、「往生堂」は何回も処理してきた。そのおかげで璃月の生と死の均衡を保ってきたの。","nextNodeIds":[111110229]},{"nodeId":111110229,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":1714426970,"text":"簡単に言えば、私たちは「守り人」。人々を見守り、人じゃないものも見守る、へへ。","nextNodeIds":[111110230,111110231]},{"nodeId":111110230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2254676130,"text":"これが「生と死の境界を維持する」こと？","nextNodeIds":[111110232]},{"nodeId":111110232,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3318721682,"text":"だから、「呪い」は全部気のせいなの。もちろん、昔本当にあったことも、一般人には絶対言わないけど。","nextNodeIds":[111110233]},{"nodeId":111110233,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":1493110346,"text":"少しここで待ちましょう。あとでこの地脈鎮石を使って一芝居打つから。","nextNodeIds":[111110234]},{"nodeId":111110234,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":3320835050,"text":"やっと来ましたか、ちょうど今準備が終わったところですよ。","nextNodeIds":[111110235]},{"nodeId":111110235,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":989413570,"text":"見てください、これが邪を払う特殊な装置。あなたの体から呪いを吸い出し、具現化します。","nextNodeIds":[111110236]},{"nodeId":111110236,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":1794031842,"text":"危険は及ばないから安心してください、この旅人さんは百戦錬磨の実力の持ち主だから。","nextNodeIds":[111110237,111110238]},{"nodeId":111110237,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1487502130,"text":"やっぱり。","nextNodeIds":[111110239]},{"nodeId":111110239,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":596941650,"text":"あっ、そうだった、言うの忘れてた。あはは、まあ大丈夫でしょ。","nextNodeIds":[111110240]},{"nodeId":111110240,"roleType":"TALK_ROLE_NPC","speakerId":10345,"speakerName":"洛成","textMapHash":1767289258,"text":"これで本当に解決するんですか？","nextNodeIds":[111110241]},{"nodeId":111110241,"roleType":"TALK_ROLE_NPC","speakerId":10343,"speakerName":"孟","textMapHash":3543482058,"text":"堂主を信じろ、あの人は性格こそ変わってるが、やる時はしっかりやる。","nextNodeIds":[111110242]},{"nodeId":111110242,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":2957097458,"text":"ちょっと、「変わってる」なんて単語で私を語らないでよ？少なくとも天真爛漫で無邪気って言って！","nextNodeIds":[111110243]},{"nodeId":111110243,"roleType":"TALK_ROLE_NPC","speakerId":1021,"speakerName":"胡桃","textMapHash":1010494306,"text":"とりあえず、さっそく始めましょう！新入り、装置を起動して。","nextNodeIds":[]},{"nodeId":111110238,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":290905322,"text":"戦うなんて聞いてない。","nextNodeIds":[111110239]},{"nodeId":111110231,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":730627226,"text":"そんな歴史があるとは思わなかった。","nextNodeIds":[111110232]},{"nodeId":111110221,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1484349234,"text":"少しならある。","nextNodeIds":[111110222]},{"nodeId":111110213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3552271322,"text":"パイモンは今年で何歳？","nextNodeIds":[111110214]},{"nodeId":111110214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1855755442,"text":"どうしていきなりそんなことを聞くんだ！","nextNodeIds":[111110215]},{"nodeId":111110215,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3439440890,"text":"それより、なんで皆に本当のことを言わないんだ、そっちの方が気になるぞ！","nextNodeIds":[111110216]}]},{"talkId":1111106,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":