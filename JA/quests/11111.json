{"mainQuestId":11111,"title":"存在なき人を探せ","description":"胡桃を手伝うために冒険者協会へ向かったが、意外にも彼女の目的が往生堂の「業務開拓」であったことを知る。生と死の話題をちっとも避けない彼女は、自分なりの理があったが、あなたはどうにも納得できなかった。あなたが疑いを胡桃に告げると彼女は驚きながら、「業務開拓」はとっくに終わっていて今は狼兄貴という人物を探さなければならないと言い出す。","titleTextMapHash":2109944287,"descTextMapHash":2993707934,"mainQuestExcel":{"mainQuestId":11111,"titleTextMapHash":2109944287,"title":"存在なき人を探せ","descTextMapHash":2993707934,"description":"胡桃を手伝うために冒険者協会へ向かったが、意外にも彼女の目的が往生堂の「業務開拓」であったことを知る。生と死の話題をちっとも避けない彼女は、自分なりの理があったが、あなたはどうにも納得できなかった。あなたが疑いを胡桃に告げると彼女は驚きながら、「業務開拓」はとっくに終わっていて今は狼兄貴という人物を探さなければならないと言い出す。","chapterId":2018,"mainQuestTag":"MAINQUEST_TAG_NONE","activeMode":"PLAY_MODE_SINGLE","activityId":0,"luaPath":"Actor/Quest/LQ11111","mainQuestRaw":{"activeMode":"PLAY_MODE_SINGLE","activityId":0,"chapterId":2018,"descTextMapHash":2993707934,"EPJHBBICPCA":false,"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GMENNHMBBOH":[{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0},{"actionType":"NONE","id":0}],"id":11111,"IELNANBAMLH":"QUEST_PAUSE_RES_DESTROY_NONE","IGHALKGCHAB":2404945449,"LEFIHLHODBM":[],"luaPath":"Actor/Quest/LQ11111","mainQuestTag":"MAINQUEST_TAG_NONE","MHHFFHCLDKI":false,"PEDANLIDLGE":0,"PEFIFLDHPEE":true,"recommendLevel":0,"repeatable":false,"resId":2018,"rewardIdList":[111111],"series":11110,"showRedPoint":false,"showType":"QUEST_SHOW","specialShowCondIdList":[],"specialShowQuestId":0,"specialShowRewardId":[],"suggestTrackMainQuestList":[11112],"suggestTrackOutOfOrder":false,"taskID":0,"titleTextMapHash":2109944287,"type":"LQ","unlockDescTextMapHash":922335710}},"flow":[{"subQuestId":1111101,"order":1,"stepDescription":"往生堂に帰って孟から状況を理解する","stepDescTextMapHash":3026159284,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1111101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SC