dialogs":[{"nodeId":726950101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":533276874,"text":"バートランド！","nextNodeIds":[726950102]},{"nodeId":726950102,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":565357250,"text":"#{NICKNAME}とパイモンか。ちょうどいいところに来た。","nextNodeIds":[726950103]},{"nodeId":726950103,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1257057290,"text":"俺が発明した唯一無二のマシン…「大工機」が、君の集めた素材を処理し終えた。","nextNodeIds":[726950104]},{"nodeId":726950104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1653850010,"text":"結果はどうだった？","nextNodeIds":[726950105]},{"nodeId":726950105,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2989889434,"text":"この俺が作ったマシンだ、問題はない！こう見えて、フォンテーヌでしっかりと腕を磨いてきたからな。","nextNodeIds":[726950106]},{"nodeId":726950106,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2811906378,"text":"俺もれっきとしたフォンテーヌ人だ。精密機械を作るのと操作する点において、俺たち以上に詳しい者などこの世にいない。","nextNodeIds":[726950107]},{"nodeId":726950107,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1034895898,"text":"前回は、ちょっと慌ててただけなんだ。それに、試運転の材料を集めてくれる人もいなかった。だから爆発した。だが、今回は違う！","nextNodeIds":[726950108]},{"nodeId":726950108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2165975674,"text":"そ、そっか…","nextNodeIds":[726950109]},{"nodeId":726950109,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3566691130,"text":"もし今回のおもちゃまで爆発したら、俺の残された貯金と人生も爆発することになるだろう。","nextNodeIds":[726950110]},{"nodeId":726950110,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1248985218,"text":"俺のことは信じなくてもいい。だが、残りの人生を賭けた俺の覚悟だけは信じてくれ！","nextNodeIds":[726950111]},{"nodeId":726950111,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3619076130,"text":"オイラ、おもちゃの製造がこんなに覚悟のいる仕事だと思わなかったぜ…","nextNodeIds":[726950112]},{"nodeId":726950112,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":462258602,"text":"さあ、次の工程に入ろう。","nextNodeIds":[726950113]},{"nodeId":726950113,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2515804226,"text":"だがその前に質問しよう。三つの工程のうち、すでに終わっているのは「原材料収集」だ。","nextNodeIds":[726950114]},{"nodeId":726950114,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3168983330,"text":"では、次に行うのは「コア収集」と「チャージ収集」、どっちだと思う？","nextNodeIds":[726950115,726950118]},{"nodeId":726950115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":562351402,"text":"「コア収集」…","nextNodeIds":[726950116]},{"nodeId":726950116,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1258000506,"text":"おめでとう…と言いたところだが不正解だ。もし本当にコアを収集していたら、俺の人生を破滅に導いた功績は、君のものになっていただろう。","nextNodeIds":[726950117]},{"nodeId":726950117,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2677462394,"text":"正解は、「元素チャージ」だ。","nextNodeIds":[726950121]},{"nodeId":726950121,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3038139282,"text":"とにかく…「元素チャージ」を行うには、「素材収集器」を持って元素の影響を受け続ける必要がある。","nextNodeIds":[726950122]},{"nodeId":726950122,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":3328848658,"text":"例えば、水元素を収集したければ、「素材収集器」を持ったまま川に一定時間いればいい。雷元素を収集したければ…","nextNodeIds":[726950123]},{"nodeId":726950123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2174305882,"text":"雷に打たれればいいのか？","nextNodeIds":[726950124]},{"nodeId":726950124,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":786539434,"text":"そう、君たちは冒険者だからね…","nextNodeIds":[726950125]},{"nodeId":726950125,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2910173650,"text":"冒険者の強靱さを信じているよ。","nextNodeIds":[726950126]},{"nodeId":726950126,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1840078402,"text":"信じてるって強靱さのことだったの…","nextNodeIds":[726950127]},{"nodeId":726950127,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2356957986,"text":"本当のことを言うと、元素生物に触れるのがもっとも良い方法なんだ。以前、稲妻を旅した時に、元素生物がよく出没する場所を三つほど調べておいた…","nextNodeIds":[726950128]},{"nodeId":726950128,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2796793530,"text":"もし助手が見つからなかったら、自分でこっそりそこに行って、元素生物に触れるつもりだった。","nextNodeIds":[726950129]},{"nodeId":726950129,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2803816866,"text":"それはさすがに危険だと思うぞ…","nextNodeIds":[726950130]},{"nodeId":726950130,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":2896654882,"text":"でも、今は君たちがいる。そこに行って、元素生物を探してみるといい。","nextNodeIds":[726950131]},{"nodeId":726950131,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":1379496114,"text":"「元素チャージ」は任せたよ！","nextNodeIds":[]},{"nodeId":726950118,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":563192906,"text":"「チャージ収集」…","nextNodeIds":[726950119]},{"nodeId":726950119,"roleType":"TALK_ROLE_NPC","speakerId":30187,"speakerName":"バートランド","textMapHash":876517882,"text":"ふははっ、惜しいな。正しくは「チャージ収集」ではなく「元素チャージ」だ。まさか、どっちも不正解だなんて思わなかっただろう？","nextNodeIds":[726950120]},{"nodeId":726950120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2432672858,"text":"ムカつく笑い方だな…","nextNodeIds":[726950121]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7269501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_