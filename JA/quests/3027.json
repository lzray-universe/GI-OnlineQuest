:"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":302701,"initDialog":30261705,"nextRandomTalks":[],"nextTalks":[],"npcId":[1056],"performCfg":"QuestDialogue/AQ/Sumeru3_3027/Q302701","priority":5,"questId":3027,"showRandomTalkCount":0},"dialogs":[{"nodeId":30261705,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1539638066,"text":"そう。何か知りたいことでもあるの？","nextNodeIds":[30261706,30261717,30261729,30261735,30261743]},{"nodeId":30261706,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":560912282,"text":"「アーカーシャ」について…","nextNodeIds":[30261707]},{"nodeId":30261717,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1387859394,"text":"#あの日、{M#俺}{F#私}が寝た後に起こった事について…","nextNodeIds":[30261718]},{"nodeId":30261729,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4225652578,"text":"「散兵」について…","nextNodeIds":[30261730]},{"nodeId":30261735,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":842355658,"text":"次の旅の地点、フォンテーヌについて…","nextNodeIds":[30261736]},{"nodeId":30261790,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2909874106,"text":"#{M#俺}{F#私}の{M#妹}{F#兄}の情報について…","nextNodeIds":[30261762]},{"nodeId":30261743,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2843474954,"text":"もう他にはない。","nextNodeIds":[30261744]},{"nodeId":30261707,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":752336170,"text":"あの件以降、アーカーシャは元のようには運行しなくなったわ。","nextNodeIds":[30261708]},{"nodeId":30261708,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":155694394,"text":"総合的に判断した結果、アーカーシャを止めることにしたの。","nextNodeIds":[30261709]},{"nodeId":30261709,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2950690250,"text":"でも、これは決して悪いことではない。元々アーカーシャの運行は止めるつもりだったから。","nextNodeIds":[30261710]},{"nodeId":30261710,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":4210711186,"text":"アーカーシャによって知識を管理することは、元より人々の好奇心を制限し可能性を消し去ってしまう。これはスメールにとって、よくないと私は思うの。","nextNodeIds":[30261711]},{"nodeId":30261711,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":83229050,"text":"今はまだアーカーシャを失ったことに違和感を覚える人々もいるわ。だけど、すぐに今の生活のほうが良くて、彼らにとって相応しいと気付けるはずよ。","nextNodeIds":[30261712]},{"nodeId":30261712,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":666758402,"text":"そしてスメールの今後についてだけど…私は再び教令院の実権を握ろうと思うの。","nextNodeIds":[30261713]},{"nodeId":30261713,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3565869058,"text":"元いた賢者はすでに受けるべき罰を受けた。そして新たな賢者はまだ選出されていない。この件は、私が直々に監督するわ。","nextNodeIds":[30261714]},{"nodeId":30261714,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3050279850,"text":"新たな世代の六大賢者には、より学術の方面に長けていてほしいわね。今のスメールにはそういったリーダーが必要だから。","nextNodeIds":[30261715]},{"nodeId":30261715,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1446747218,"text":"それから、キングデシェレトの民と砂漠区域の住民たちは、これまで長いこと不当な待遇を受けてきた。","nextNodeIds":[30261716]},{"nodeId":30261716,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1579411026,"text":"もうすでにこれについては対応を進めているわ。何を再建するにも時間は必要だけど、文化、友情、信頼…これらすべて、この先きっと再び得られると思う。","nextNodeIds":[30261705]},{"nodeId":30261718,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2917615394,"text":"「博士」のせいであなたが眠った後、何が起こったのか知りたいのね？","nextNodeIds":[30261719]},{"nodeId":30261719,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2503658474,"text":"「博士」は神の心を奪ったの？","nextNodeIds":[30261720]},{"nodeId":30261720,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2369259618,"text":"その通りよ…第三位とそれより上のファデュイ執行官は、神にも匹敵する実力を持っているわ。あの状況では、私は彼の相手にならなかった。","nextNodeIds":[30261721]},{"nodeId":30261721,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1943480962,"text":"でも、形勢は劣っていたけれど、「博士」と対等の取引ができたの。","nextNodeIds":[30261722]},{"nodeId":30261722,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":399703730,"text":"あなたも覚えているでしょ。あなたの運命を変えた——「天理」を。","nextNodeIds":[30261723]},{"nodeId":30261723,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":4222373458,"text":"事実、「天理」は五百年前のカーンルイアの災い以降、今の今まで沈黙を保っている。だからそれを利用して、博士を脅したの。","nextNodeIds":[30261724]},{"nodeId":30261724,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2597870698,"text":"もしも私がこの神の心を破壊すれば、「天理」を呼び覚ますかもしれないってね。ただの憶測に過ぎなかったけど、彼を抑えることに成功したわ。","nextNodeIds":[30261725]},{"nodeId":30261725,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":680908338,"text":"「法則」に関わるようなレベルの破壊を、「天理」も黙って見過ごすわけがないから。","nextNodeIds":[30261726]},{"nodeId":30261726,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3811627250,"text":"私が神の心で何を交換したかについてだけど…","nextNodeIds":[30261727]},{"nodeId":30261727,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":4223440154,"text":"「博士」に対する罰、そして知恵の神である私でさえ断れないような「知識」よ。","nextNodeIds":[30261728]},{"nodeId":30261730,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3200851226,"text":"彼はずっと意識を失ったままなの。だから羽毛を一枚隠すように、彼のことを隠しておいたわ。","nextNodeIds":[30261731]},{"nodeId":30261731,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":327326226,"text":"あなたが彼のことを不安視するのは分かるけれど、「かつて神になった」彼の体には、とても有用な特質がいくつか残ったの。","nextNodeIds":[30261732]},{"nodeId":30261732,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3229860666,"text":"心配しないで。彼が悪さをしないよう、私が見張っておくから。","nextNodeIds":[30261733]},{"nodeId":30261733,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2230137426,"text":"それから、彼の体にはいくつか謎があるわ。私の視点から見るとはっきりしているけれど、彼自身にはかえって分からないみたい。","nextNodeIds":[30261734]},{"nodeId":30261734,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3447985322,"text":"これから先のことは、彼の運次第ね。","nextNodeIds":[30261705]},{"nodeId":30261736,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1872061594,"text":"あそこに行くのね。「正義」の国、フォンテーヌへ。","nextNodeIds":[30261737]},{"nodeId":30261737,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1050040002,"text":"私が知っている限りでは、あの国の運営は正義に関する審判のシステムの上に成り立っているわ。","nextNodeIds":[30261738]},{"nodeId":30261738,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":384465242,"text":"そいつらの神が民を審判するのか？","nextNodeIds":[30261739]},{"nodeId":30261739,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":4170810834,"text":"いいえ、フォンテーヌには最高審判官が一人いるの。一般的には、神である「フォカロルス」が直々に審判に参加することはないわ。","nextNodeIds":[30261740]},{"nodeId":30261740,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":4026092762,"text":"でも…すべての審判において、フォカロルスが欠席することはほぼ皆無。彼女はただ、あの雰囲気に酔いしれているだけのようね。","nextNodeIds":[30261741]},{"nodeId":30261741,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":996597418,"text":"そして神である彼女も、最終判決に影響を与える権利を残しているわ。","nextNodeIds":[30261742]},{"nodeId":30261742,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2289502194,"text":"とにかく、うん…非常に個性的な神よ。","nextNodeIds":[30261705]},{"nodeId":30261784,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":179923178,"text":"ええ。もう少ししたら、あなたも出発して、スメールを離れるのよね？","nextNodeIds":[30261785]},{"nodeId":30261785,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":555216802,"text":"私はあなたを待ち構えている運命にとても興味があるわ。観測されることができず、この世界に記録されることもない旅…","nextNodeIds":[30261786]},{"nodeId":30261786,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1976260626,"text":"前に運命は究極の知識だと言ったけど、あなたの未来は「究極の運命」ね。","nextNodeIds":[30261787]},{"nodeId":30261787,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2148857114,"text":"おまえに出会えてよかったぜ、ナヒーダ。","nextNodeIds":[30261788]},{"nodeId":30261788,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3819746434,"text":"私こそ、あなたたちが来てくれたことに心から感謝しないと。","nextNodeIds":[30261789]},{"nodeId":30261789,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":128130106,"text":"さて、とりあえずお話はここまでにしましょう。今後また私に会いたくなったら、その時はあなたたちの夢に現れるかもしれないわね。","nextNodeIds":[]},{"nodeId":30261762,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3656964946,"text":"私の触れられる記録の中では、あなたの血縁者は突如としてカーンルイアに現れたの…","nextNodeIds":[30261763]},{"nodeId":30261763,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3177834378,"text":"#カーンルイアの災いの後、{M#彼女}{F#彼}はテイワット各国を巡る旅に出た。","nextNodeIds":[30261764]},{"nodeId":30261764,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2510074002,"text":"#でも{M#彼女}{F#彼}の旅が終わりに近づいた時、世界樹にある{M#彼女}{F#彼}についての記録がいきなりぼやけたの…","nextNodeIds":[30261765]},{"nodeId":30261765,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3537841202,"text":"ぼやけた？なにかに遭遇したのかな？","nextNodeIds":[30261766]},{"nodeId":30261766,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":4050065602,"text":"#確かなのは、誰かが何らかの理由で意図的に{M#彼女}{F#彼}の「運命」を隠しているということよ…","nextNodeIds":[30261767]},{"nodeId":30261767,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2835325226,"text":"そして、それが出来る者は…並外れた力を持っているに違いない。","nextNodeIds":[30261768]},{"nodeId":30261768,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4014414242,"text":"まさか「アビス」と関係が…","nextNodeIds":[30261769]},{"nodeId":30261769,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":44559058,"text":"でもこの情報からじゃ、なんでこいつの血縁者がこの世界の人なのかを説明できないな…","nextNodeIds":[30261770]},{"nodeId":30261770,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3949662554,"text":"ひとつ特筆すべき点があるわ。私の知る限り…ファデュイの情報システムにおいても、彼らはあなたの血縁者を「降臨者」の範疇には含めていないということよ。","nextNodeIds":[30261771]},{"nodeId":30261771,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":594784674,"text":"「降臨者」？","nextNodeIds":[30261772]},{"nodeId":30261772,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2399150362,"text":"…降臨者ってなんだ？そんな概念、初めて聞いたぞ…","nextNodeIds":[30261773]},{"nodeId":30261773,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":3947722970,"text":"私が神の心でファデュイといったい何の情報を交換したか、あなたも気になるはずよね？","nextNodeIds":[30261774]},{"nodeId":30261774,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1884115202,"text":"その中の非常に重要な一部こそ、この世界の「降臨者」…この世界に属さない外来的存在のことよ。","nextNodeIds":[30261775]},{"nodeId":30261775,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1640309442,"text":"旅人、あなたはテイワットの「第四降臨者」なの。","nextNodeIds":[30261776]},{"nodeId":30261776,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2231106442,"text":"第四…？","nextNodeIds":[30261777]},{"nodeId":30261777,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1357191266,"text":"えっ？それってつまり、ファデュイの情報によれば…こいつの血縁者を除いて、これまでに三人の「降臨者」が他にもいたってことか？","nextNodeIds":[30261778]},{"nodeId":30261778,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":216889738,"text":"ええ。私が推測する限り、「第一降臨者」は今の「天理」だと思うわ。","nextNodeIds":[30261779]},{"nodeId":30261779,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":1763480082,"text":"そして他の降臨者の存在については、まだ時間をかけて「考証」する必要がある。","nextNodeIds":[30261780]},{"nodeId":30261780,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1232377322,"text":"なんか…とんでもない情報をいっぱい聞いた気がするぞ…","nextNodeIds":[30261781]},{"nodeId":30261781,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":4087723378,"text":"でも、これら情報を教えても、あなたたちの抱えるすべての疑問を解くことはできないのでしょう？知恵の神として、恥ずかしい限りね…","nextNodeIds":[30261782]},{"nodeId":30261782,"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","textMapHash":2628015674,"text":"私も数々の疑問が心に残っていて、時間をかけて整理する必要があるわ。","nextNodeIds":[30261783]},{"nodeId":30261783,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2128879242,"text":"#{M#俺}{F#私}も…時間をかけて考えたい。","nextNodeIds":[30261705]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1075,0],"PAINLIBBLDK":"QUEST_CONTENT_LEAVE_SCENE","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[302701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1056,"speakerName":"ナヒーダ","count":49},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":3885672502,"CHECNJEMEFE":{"12952":[4121]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":