oy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7351801","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7351801,"initDialog":735180101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30342,30343],"performCfg":"QuestDialogue/WQ/V3.6SandSworm/Q7351801","priority":5,"questId":73518,"showRandomTalkCount":0},"dialogs":[{"nodeId":735180101,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":983713002,"text":"チャージ装置の動きが前よりスムーズになった…君の言う通り、この区域の元素環境が、少しずつ通常状態にまで回復してきているんだろう。","nextNodeIds":[735180102]},{"nodeId":735180102,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3945650298,"text":"…ウェネトによる影響も、少し経てば消えてしまうだろうな。","nextNodeIds":[735180103]},{"nodeId":735180103,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2507896258,"text":"はいはいはい、あなたの宝物の「対ウェネト殺蟲大砲」のおかげね。さあ、任務結果を報告して、各自帰宅するとしましょう。","nextNodeIds":[735180104]},{"nodeId":735180104,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":4112677538,"text":"——僕たちの「対ウェネト殺蟲大砲」だ。シュリヤ、これが僕たち二人の共同成果であることを、僕は一度も忘れたことはないぞ。","nextNodeIds":[735180105]},{"nodeId":735180105,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3046592610,"text":"…昔はかなり言い争っていたが、君なしでは、僕もこれが完成する日を迎えることはできなかった。","nextNodeIds":[735180106]},{"nodeId":735180106,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1005053306,"text":"こ…こんな時にいきなり何を言い出すのよ！何よ、報告であなたのことを褒めてほしいわけ？","nextNodeIds":[735180107]},{"nodeId":735180107,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":585497386,"text":"まあ、ふと思っただけだよ。この数日のことって、その時の状況とけっこう似てるだろ。言い争ったり試行錯誤したりはしてたけど、結局は問題をちゃんと解決できた。","nextNodeIds":[735180108]},{"nodeId":735180108,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2845327746,"text":"——それに、認めざるを得ないのは、最後はやはり、いつも君の解決策のほうが効率がいいと言う点だ。","nextNodeIds":[735180109]},{"nodeId":735180109,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":991744002,"text":"私は…その…それほどでもないわよ…","nextNodeIds":[735180110]},{"nodeId":735180110,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2335264754,"text":"…正直、あなたの考えもちゃんと正しかったわよ。実際、「対ウェネト殺蟲大砲」の実験をしないことには、私もこれらのデータを入手できなかったわけで…","nextNodeIds":[735180111]},{"nodeId":735180111,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":2019555066,"text":"「歯車を一つ交換するだけで機械は修理できるかもしれない。しかし一番難しいのは、どうやってその歯車を見つけ出すかということだ…」、先生の言葉が、今頃になって分かった気がするよ。","nextNodeIds":[735180112]},{"nodeId":735180112,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":1728656210,"text":"君がいてくれて本当によかった、シュリヤ。","nextNodeIds":[735180113]},{"nodeId":735180113,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":2923725634,"text":"ええ…君もね…","nextNodeIds":[735180114]},{"nodeId":735180114,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3239779970,"text":"#どういうことだ？{NICKNAME}、この二人の空気が、急におかしくなったぞ？","nextNodeIds":[735180115,735180116]},{"nodeId":735180115,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1373905178,"text":"パイモン…","nextNodeIds":[735180117]},{"nodeId":735180117,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1123578698,"text":"コホン！昔、卒業プロジェクトのことで関係があんなに悪くなったのは、お互いに未熟すぎたせいってことね。","nextNodeIds":[735180118]},{"nodeId":735180118,"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","textMapHash":3686876458,"text":"そうだな。振り返ってみると、さほど大きなトラブルもなかったのに…","nextNodeIds":[735180119]},{"nodeId":735180119,"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","textMapHash":1283182338,"text":"その——今度、一緒にカフェに行かない？今回の報告レポートについて相談するために。","nextNodeIds":[]},{"nodeId":735180116,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3788603058,"text":"それ以上聞かないで。","nextNodeIds":[735180117]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7351801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30342"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7351801],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30342,"speakerName":"ヴィナヤック","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":30343,"speakerName":"シュリヤ","count":7},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":2},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":1}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","