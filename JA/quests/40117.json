2490211170,"text":"…あのね、ガイアお兄ちゃん。前にお話しの続きを教えてくれるって、約束してくれたでしょ。瓶の中のジンニーの物語。","nextNodeIds":[401171302]},{"nodeId":401171302,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":241759130,"text":"いいぜ。そうだな…前はどこまで話した？","nextNodeIds":[401171303]},{"nodeId":401171303,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":4159991050,"text":"クレー覚えてるよ、「魔瓶」の中から出てきた「ジンニー」が、瓶を開けた牧童をがぶっと食べようとするところ。","nextNodeIds":[401171304]},{"nodeId":401171304,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":3523558978,"text":"そうだったな。悪いジンニーが口を大きく開けた瞬間——牧童は突然閃いた…","nextNodeIds":[401171305]},{"nodeId":401171305,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":3080987346,"text":"ボンボン爆弾をジンニーの口に投げたの？","nextNodeIds":[401171306]},{"nodeId":401171306,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":456242154,"text":"ははっ、もしもそのとき牧童の近くにボンボン爆弾があれば、きっとそうしただろうな。","nextNodeIds":[401171307]},{"nodeId":401171307,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":3995942362,"text":"だが、牧童は爆弾を見たこともなかったから、ジンニーにこう言うしかなかったんだ。","nextNodeIds":[401171314]},{"nodeId":401171314,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":2775676338,"text":"「待ってくれ。お前の体はこんなにデカいのに、本当にその瓶の中から出てきたのか？この目で見ない限り、そんなデタラメ信じないぞ！」ってさ。","nextNodeIds":[401171308]},{"nodeId":401171308,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":2996877026,"text":"ジンニーはかんかんになって、こう言った——「ぐぬぬ、牧童め。汝ごときに舐められてたまるか。」","nextNodeIds":[401171309]},{"nodeId":401171309,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":4228829058,"text":"そしてジンニーは瓶の中へと潜り込んだ。それを見た牧童は、たちまち栓で瓶の口を封じてしまったんだ…","nextNodeIds":[401171310]},{"nodeId":401171310,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":3012527994,"text":"やった！これで悪いジンニーも二度と出てこられないね！","nextNodeIds":[401171311]},{"nodeId":401171311,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":1174258258,"text":"でも…ずっと瓶みたいな小さなところに閉じ込められちゃうんだよね…悪いジンニーはちゃんと眠れるのかな？","nextNodeIds":[401171312]},{"nodeId":401171312,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":3982909762,"text":"悪いことをして、捕まったから閉じ込められちまったんだぜ。","nextNodeIds":[401171313]},{"nodeId":401171313,"roleType":"TALK_ROLE_NPC","speakerId":1004,"speakerName":"ガイア","textMapHash":3933882490,"text":"だから——悪いことをしても閉じ込められたくなかったら、一番肝心なのは捕まらないことなんだ。","nextNodeIds":[401171314]}]},{"talkId":4011714,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4011701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4011714,"initDialog":401171401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1051,1029],"performCfg":"QuestDialogue/EQ/Penumbra_40117/Q4011714","priority":5,"questId":40117,"showRandomTalkCount":0},"dialogs":[{"nodeId":401171401,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":859568498,"text":"クレーから聞いたんだけど、あっちにはすごく不思議なレールがあるらしいよ。それに「すごくすごく面白いびゅんびゅん爆速車」も。","nextNodeIds":[401171402]},{"nodeId":401171402,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":2122928490,"text":"それって、あの「スリリングで刺激的な」レールに沿って、「一切制限なしの」猛スピードで走る乗り物のことかしら…","nextNodeIds":[401171403]},{"nodeId":401171403,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":51675466,"text":"そうそう、それだ。真下に向かって走ることもあるらしい。体の重さがなくなったみたいに宙に浮かぶんだって。","nextNodeIds":[401171404]},{"nodeId":401171404,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":4123337218,"text":"そうなの？走行中にクレーのリュックの紐が解けてしまって、ガイアがその場ですぐ蓋を閉じてあげなかったら、ボンボン爆弾が全部空に飛んで行ってしまうところだったって聞いたけど。","nextNodeIds":[401171405]},{"nodeId":401171405,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":1990964842,"text":"えっ！？その話だと…たいぶ危なそうかも…","nextNodeIds":[401171406]},{"nodeId":401171406,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":1277504202,"text":"仕方ないわね…そんなに乗りたいのなら、時間を見つけて一緒に乗ってあげるわ。","nextNodeIds":[401171407]},{"nodeId":401171407,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":2945166106,"text":"えっ？エウルア、どうして急に…","nextNodeIds":[401171408]},{"nodeId":401171408,"roleType":"TALK_ROLE_NPC","speakerId":1029,"speakerName":"エウルア","textMapHash":4290333778,"text":"君の思考なんて、だだ漏れだから…でも言っておくけど、私は物を拾ったりしてあげないから、事前に持ち物は全部預けておいてちょうだい。","nextNodeIds":[401171409]},{"nodeId":401171409,"roleType":"TALK_ROLE_NPC","speakerId":1051,"speakerName":"コレイ","textMapHash":3229736186,"text":"うん、うん！","nextNodeIds":[]}]},{"talkId":4011715,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["4011701","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":4011715,"initDialog":401171501,"nextRandomTalks":[],"nextTalks":[],"npcId":[13247],"performCfg":"QuestDialogue/EQ/Penumbra_40117/Q4011715","priority":5,"questId":40117,"showRandomTalkCount":0},"dialogs":[{"nodeId":401171501,"roleType":"TALK_ROLE_NPC","speakerId":13247,"speakerName":"イディア","textMapHash":2841389466,"text":"自信満々にアリスさんと約束したばかりなのに、蜃境がこんな大騒ぎになっちゃうなんて…","nextNodeIds":