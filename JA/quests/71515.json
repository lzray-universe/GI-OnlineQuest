e":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3971943378,"text":"「港内北埠頭にて上演中」…うぅ、この通知、ちょっと曖昧すぎやしないか？なにが上演するのか、誰がやるのかまったくわからないぞ。","nextNodeIds":[715150102]},{"nodeId":715150102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1969934626,"text":"上演場所を探してみるか。もし見つからなかったら、通行人に聞いてみようぜ。","nextNodeIds":[715150103]},{"nodeId":715150103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":575482338,"text":"あっちに人がたくさんいる。","nextNodeIds":[715150104]},{"nodeId":715150104,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2956304770,"text":"あっ、本当だ。あんなに大勢集まってるってことは、上演を観に来た人たちかもな。","nextNodeIds":[715150105]},{"nodeId":715150105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2768646290,"text":"聞いてみよう。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["Q7151501_guide","0"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7151502,"order":2,"stepDescription":"通行人を尋ねる","stepDescTextMapHash":3830258388,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30308"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7151502],"talks":[{"talkId":7151502,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7151502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7151502,"initDialog":715150201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30308],"performCfg":"QuestDialogue/WQ/SeaLampV3_71515/Q7151502","priority":5,"questId":71515,"showRandomTalkCount":0},"dialogs":[{"nodeId":715150201,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":1381449050,"text":"「万事順調、平安慶賀…♪」","nextNodeIds":[715150202]},{"nodeId":715150202,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1639575754,"text":"こんにちは。","nextNodeIds":[715150203]},{"nodeId":715150203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1922307082,"text":"ちょっと聞きたいんだけど、今からここでなにか上演されるのか？","nextNodeIds":[715150204]},{"nodeId":715150204,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":1456088498,"text":"うん、もうすぐ紙映{RUBY#[S]ジーインシー}戯をやるんだ。君たちもそれを観に来たの？","nextNodeIds":[715150205,715150206]},{"nodeId":715150205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4256857762,"text":"『紙映戯』っていうんだ。","nextNodeIds":[715150207]},{"nodeId":715150207,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":2813500874,"text":"違うよ、紙映戯と璃月劇は別物なんだ。","nextNodeIds":[715150208]},{"nodeId":715150208,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":2974948242,"text":"慶興、劇がもうすぐ始まるから、しゃべらないで。おじさんに迷惑がかかっちゃうでしょ。","nextNodeIds":[715150209]},{"nodeId":715150209,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":1674373042,"text":"あ、うん。紙映戯がどんなものかは、二人も観たらわかるはずだよ。","nextNodeIds":[715150210]},{"nodeId":715150210,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":3690661058,"text":"…お客さんたち、今日お見せするのは、虬髯公の物語だ。","nextNodeIds":[715150211]},{"nodeId":715150211,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1981161378,"text":"先に言っておくが、厠に行きたい人や飲み物を買いたい人がいるなら、事前に行くことをおすすめする。劇が始まったら、もう待ってはくれないからな。","nextNodeIds":[715150212]},{"nodeId":715150212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3550661114,"text":"（この劇、『虬髯公』っていうのか。ぜんぜん聞いたことない物語だな。）","nextNodeIds":[715150213]},{"nodeId":715150213,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":2037573490,"text":"しーっ、小声で話しても聞こえてるよ。静かに観てて。話すのは外題を選ぶときだけだよ。","nextNodeIds":[715150214]},{"nodeId":715150214,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":485913234,"text":"うぅ…ごめん。","nextNodeIds":[715150215]},{"nodeId":715150215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":899119602,"text":"外題？","nextNodeIds":[715150216]},{"nodeId":715150216,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":2902928450,"text":"虬髯公のお話はすっごく長いから、全部やると時間がかかるんだ。だからおじさんはいつも、みんなにどの章を観たいか選んでもらってるんだよ…","nextNodeIds":[715150217]},{"nodeId":715150217,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":1226363466,"text":"慶興！おじさんの劇の声が聞こえなくなるだろ！","nextNodeIds":[715150218]},{"nodeId":715150218,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":328984458,"text":"わかったよ、もう絶対に話さないから。","nextNodeIds":[715150219]},{"nodeId":715150219,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1746868314,"text":"みんな、今日は『全本虬髯公』のどの物語が聞きたいかな？","nextNodeIds":[715150220]},{"nodeId":715150220,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":3932893482,"text":"『投山』か、それとも『拝仙』？もしくは『縛鬼』か『登天』？","nextNodeIds":[715150221]},{"nodeId":715150221,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":2811220098,"text":"外題を言ってくれさえすれば、おじさんにできない劇はないよ！","nextNodeIds":[715150222]},{"nodeId":715150222,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":3460413554,"text":"ぼく、虬髯公と妖魔の戦いが観たい！すっごくかっこよくて、必ず勝つやつ。","nextNodeIds":[715150223]},{"nodeId":715150223,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":367803066,"text":"『拝仙』と『縛鬼』はもう何回も観ただろ、飽きないのか？ぼくは虬髯公が家に帰って妹に会う場面が観たいな。","nextNodeIds":[715150224]},{"nodeId":715150224,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":389930546,"text":"虬髯公に妹なんかいたっけ？その話は知らないし、観たことないな…","nextNodeIds":[715150225]},{"nodeId":715150225,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1034494266,"text":"どうやら、このお客さんは通のようだね。『奔郷』を選ぶ人はとても少ないんだ。通じゃないと、存在すら知らないことが多い。","nextNodeIds":[715150226]},{"nodeId":715150226,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":2384800306,"text":"よし、ちょうど海灯祭だし、妖魔や鬼怪に関することはやめて、情人がいかにして眷属になったかについて話そう。","nextNodeIds":[715150227]},{"nodeId":715150227,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1250559218,"text":"この場面に登場する役は三人だ。みんな知ってる虬髯公以外にも、意氷という孤独な女性が一人。そして、南風という君子が一人いる。","nextNodeIds":[715150228]},{"nodeId":715150228,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2501711050,"text":"#{NICKNAME}、おまえ理解できたか？オイラ、なんだかこんがらがってきたぜ。","nextNodeIds":[715150229]},{"nodeId":715150229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2001895074,"text":"今からやるのって、虬髯公って人の物語なんだよな？でも聞いた感じ、その主人公以外にも他の人がいるみたいだ。","nextNodeIds":[715150230]},{"nodeId":715150230,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1932701370,"text":"でも、オイラたちの目の前にいる役者は一人だけ…えっと、それと…屏風が一つあるな？どうやって劇をやるんだろ。","nextNodeIds":[715150231]},{"nodeId":715150231,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":1986778442,"text":"あっ、ここに紙映戯を観たことがない人がいるよ。","nextNodeIds":[715150232]},{"nodeId":715150232,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":2011719914,"text":"お？そこのお客さん、この分身もできない応公が、どうやって一人で劇を演じるのか聞きたいのか？","nextNodeIds":[715150233]},{"nodeId":715150233,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":3341883722,"text":"実はな、紙映戯は璃月劇ほどの工夫はないが、独特な特徴があるのさ。","nextNodeIds":[715150234]},{"nodeId":715150234,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":687980298,"text":"璃月劇はすべて現実の役者が演じるが、紙映戯の役者はすべて紙でできてるんだ。","nextNodeIds":[715150235]},{"nodeId":715150235,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":2706748402,"text":"あっちの劇台は木で作られたものだが、こっちのは木枠の上に薄い紙を敷いたもの。まあ、どれも紙でできてるから、紙映戯っていうんだけどな。","nextNodeIds":[715150236]},{"nodeId":715150236,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":945378682,"text":"そして、語り手は俺だが、演じるのは俺じゃない。もうすぐ、その三名の紙役者を観られるよ。","nextNodeIds":[715150237]},{"nodeId":715150237,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":1596536930,"text":"おじさん、この人たち、たぶん虬髯公も知らないはずだよ。だから、まず虬髯公について話してよ。いつも冒頭で話すあれ…","nextNodeIds":[715150238]},{"nodeId":715150238,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":900134610,"text":"あれは前説っていうんだ。ぼくも大好きなんだ。おじさん、話してよ。","nextNodeIds":[715150239]},{"nodeId":715150239,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":2712502594,"text":"前説！前説！","nextNodeIds":[715150240]},{"nodeId":715150240,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1671420234,"text":"その言葉を聞き、世を正そうとする志を抱くも、無力なことに天下は邪気に包まれていた。","nextNodeIds":[715150241]},{"nodeId":715150241,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":3218235434,"text":"その者の名は桓光。世の不平に苦しみ、山々に姿を消した男。","nextNodeIds":[715150242]},{"nodeId":715150242,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1930190818,"text":"だが偶然にも、彼はある仙人の弟子となった。それから姿を変え、真っ黒な髭を生やし、虬髯公と名乗った。","nextNodeIds":[715150243]},{"nodeId":715150243,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1143776658,"text":"仙人の命を受け、剣をもってして魑魅魍魎を打ち倒し追い払う。","nextNodeIds":[715150244]},{"nodeId":715150244,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1109182794,"text":"虬髯公は長きにわたって修行を積み、ついに悟りを得た。だが仙家の洞府に戻ろうとした時、仙人から己の過去を呼び起こされる。","nextNodeIds":[715150245]},{"nodeId":715150245,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":4281685210,"text":"なんと、彼には妹がいた。まだ俗世と縁が切れたわけではなかったのだ。妹の名は意氷、孤独で貧しく、頼れる者もいない。","nextNodeIds":[715150246]},{"nodeId":715150246,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":2572234010,"text":"兄の人生は悲惨なものだった、そう思っていた妹は、まさか兄が故郷に帰ってくるなど想像だにしなかっただろう。その後どうなったかは…","nextNodeIds":[715150247]},{"nodeId":715150247,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":212725522,"text":"このあとすぐ、お楽しみに！","nextNodeIds":[715150248]},{"nodeId":715150248,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":2510867058,"text":"わーい！ほらほら、ボーっとしてないで、はやく拍手しなきゃ。","nextNodeIds":[715150249,715150250]},{"nodeId":715150249,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3325888762,"text":"素晴らしい！","nextNodeIds":[715150251]},{"nodeId":715150251,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3707555882,"text":"拍手する決まりがあるのか…？わ、わかったよ…","nextNodeIds":[715150252]},{"nodeId":715150252,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":2705152794,"text":"ありがとう。本来なら役者を出して劇を続けるべきなんだが、お二人ともまだ困惑しているようだね。","nextNodeIds":[715150253]},{"nodeId":715150253,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":2239656378,"text":"いっそのこと、こちらに来て演出の指揮を手伝ってくれないか。","nextNodeIds":[715150254]},{"nodeId":715150254,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":1678533842,"text":"そうすれば、これをより深く理解できるし、役者をこの舞台上で存分に動かすことができるようにもなる。いかがかな？","nextNodeIds":[715150255]},{"nodeId":715150255,"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","textMapHash":4033107338,"text":"えーっ、なんでぼくじゃないの。紙映戯はぼくのほうがよく知ってるから、ぼくを選んでよ！","nextNodeIds":[715150256]},{"nodeId":715150256,"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","textMapHash":2408220154,"text":"もう何回もやったことあるだろ。騒がないで静かに観てろって。","nextNodeIds":[715150257]},{"nodeId":715150257,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3710897770,"text":"わかった。","nextNodeIds":[715150258]},{"nodeId":715150258,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4211036362,"text":"演出の指揮を手伝うのか？なんだか新鮮だな、オイラもいいぜ！","nextNodeIds":[715150259]},{"nodeId":715150259,"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","textMapHash":3609484938,"text":"では、お客さん方は少々お待ちを。お二人の準備が終わったら、すぐに開演するよ。","nextNodeIds":[]},{"nodeId":715150250,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":591822914,"text":"（拍手する）","nextNodeIds":[715150251]},{"nodeId":715150206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3726174874,"text":"それって璃月劇なの？","nextNodeIds":[715150207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7151502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30308"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7151501,7151502],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30306,"speakerName":"応公","count":25},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":11},{"roleType":"TALK_ROLE_NPC","speakerId":30308,"speakerName":"慶興","count":10},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":9},{"roleType":"TALK_ROLE_NPC","speakerId":30307,"speakerName":"和声","count":9}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[171515],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1492941654,"CHECNJEMEFE":{"30306":[4260],"30307":[1060],"30308":[5010]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBB