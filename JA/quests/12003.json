,"performCfg":"QuestDialogue/LQ/Xingqiu1_12003/Q1200304","priority":5,"questId":12003,"showRandomTalkCount":0},"dialogs":[{"nodeId":120030401,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3303316630,"text":"さて終幕だ、君たちもいてくれないと話にならない。","nextNodeIds":[120030402]},{"nodeId":120030402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2676175358,"text":"そんなこと言って、オイラたちがあちこち走り回ってる間、おまえはなにしてたんだ？","nextNodeIds":[120030403]},{"nodeId":120030403,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":2283545950,"text":"それは…もちろん、きちんと『神霄折戟録』を読んで、素敵な時間を過ごしたよ。","nextNodeIds":[120030404]},{"nodeId":120030404,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3231495654,"text":"神戟と邪剣、弥耳と未央…","nextNodeIds":[120030405]},{"nodeId":120030405,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":2275190806,"text":"5巻までの展開は「奇妙」であり、「摩訶不思議」と表現していいが、この6巻を表す言葉は見つからない。","nextNodeIds":[120030426]},{"nodeId":120030426,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3547426790,"text":"こんな奇書を書けるのは、この世に彼しかいないだろう。","nextNodeIds":[120030427]},{"nodeId":120030427,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4062566614,"text":"で、それが茂才公の件と何か関係があるのか？","nextNodeIds":[120030406]},{"nodeId":120030406,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3952275230,"text":"感服しただけさ。だって、「予想外」っていうのは珍しいことだから。","nextNodeIds":[120030407,120030409]},{"nodeId":120030407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":136829894,"text":"何もかも予想通りってわけだ。","nextNodeIds":[120030408]},{"nodeId":120030408,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3677834878,"text":"僕の予想が叶ったのは、君の協力のおかげだよ。","nextNodeIds":[120030411]},{"nodeId":120030411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":102714974,"text":"な、なんだ！？この「オイラだけ分からない」みたいな展開は！","nextNodeIds":[120030412]},{"nodeId":120030412,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2564820070,"text":"じゃ、じゃあ、倉庫に行けば面白いものが見れるっていうのは？","nextNodeIds":[120030413]},{"nodeId":120030413,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":1346204654,"text":"考えてみるといい。茂才公が璃月港を探しても石珀が1つも買えない状況を。","nextNodeIds":[120030414]},{"nodeId":120030414,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3411200054,"text":"材料がなければ、契約は果たせない。契約を果たせなければ、「ファデュイ」を敵に回す。","nextNodeIds":[120030415]},{"nodeId":120030415,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":2480912526,"text":"そして、「飛雲商会」の名を聞いた彼はきっと腹を立てるだろう。","nextNodeIds":[120030416]},{"nodeId":120030416,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3984743470,"text":"茂才公には金と勢力がある、そして彼はこんな扱いを受けたことがない。","nextNodeIds":[120030417]},{"nodeId":120030417,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":926347878,"text":"鬱憤を晴らすにせよ、問題を解決するにせよ、彼は…","nextNodeIds":[120030418]},{"nodeId":120030418,"roleType":"TALK_ROLE_NPC","speakerId":162601,"speakerName":"茂才公","textMapHash":1260007430,"text":"お前たちだな！お前たちが常九の肩を持ったせいで！","nextNodeIds":[120030419]},{"nodeId":120030419,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":582361230,"text":"ほら、噂をすれば。","nextNodeIds":[120030420]},{"nodeId":120030420,"roleType":"TALK_ROLE_NPC","speakerId":162601,"speakerName":"茂才公","textMapHash":3808709950,"text":"こんなに走り回っても石珀がどこにもないと思ったら、「飛雲商会」が動いていたか。","nextNodeIds":[120030421]},{"nodeId":120030421,"roleType":"TALK_ROLE_NPC","speakerId":162601,"speakerName":"茂才公","textMapHash":4281529142,"text":"希少な鉱石でもないのに品切れになるまで買い込むとは、俺を狙っているのか？","nextNodeIds":[120030422]},{"nodeId":120030422,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":4085457046,"text":"狙うも何も、僕は恩返しをしているだけだ。それに助けが必要な人がいれば、助太刀に入るのが当たり前だろう。","nextNodeIds":[120030423]},{"nodeId":120030423,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":1635896670,"text":"このままで終わると思うな、と言ったのはそっちの人だしね。","nextNodeIds":[120030424]},{"nodeId":120030424,"roleType":"TALK_ROLE_NPC","speakerId":162601,"speakerName":"茂才公","textMapHash":1446207582,"text":"フン、身の程を知らない馬鹿め、これ以上言っても無駄だな。","nextNodeIds":[120030425]},{"nodeId":120030425,"roleType":"TALK_ROLE_NPC","speakerId":162601,"speakerName":"茂才公","textMapHash":3236843326,"text":"さあ、お願いします。ここの石珀を全て奪ってやってください！","nextNodeIds":[]},{"nodeId":120030409,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2568208102,"text":"本は面白かった？","nextNodeIds":[120030410]},{"nodeId":120030410,"roleType":"TALK_ROLE_NPC","speakerId":10045,"speakerName":"行秋","textMapHash":3678974838,"text":"面白かったよ…こっちも華々しい終わりを迎えられることを願ってるよ。","nextNodeIds":[120030411]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[1200304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["12"],"PAINLIBBLDK":"QUEST_EXEC_GRANT_TRIAL_AVATAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["10045"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":1200305,"order":3,"stepDescription":"茂才公に協力するファデュイを倒す","stepDescTextMapHash":1826471680,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[133107003,0],"PAINLIBBLDK":"QUEST_CONTENT_CLEAR_GROUP_MONSTER","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLN