:[],"npcId":[4232,4233],"performCfg":"QuestDialogue/WQ/Sumeru_73209/Q7320904","priority":8,"questId":73209,"showRandomTalkCount":0},"dialogs":[{"nodeId":732090426,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":226500778,"text":"「ローズよローズ、叶えておくれ、私の願いを。」","nextNodeIds":[732090427]},{"nodeId":732090427,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3937946178,"text":"「花は石から咲き誇り、ゴールデンローズは私に歌う。」","nextNodeIds":[732090401]},{"nodeId":732090401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3605996178,"text":"金色のローズって、やっぱりキレイだな。咲いてるところを見ると、気分もパッと明るくなるぞ。","nextNodeIds":[732090402]},{"nodeId":732090402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1605108570,"text":"ここ数日の苦労は無駄じゃなかった。嬉しいぜ！","nextNodeIds":[732090403,732090404]},{"nodeId":732090403,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1608348730,"text":"願いがやっと叶ったね。","nextNodeIds":[732090405]},{"nodeId":732090405,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3012168746,"text":"最後に、わしもいいことが一つできた。シャフカットおじさん、あなたの願いはわしが叶えてやったぞ。","nextNodeIds":[732090406]},{"nodeId":732090406,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":156821098,"text":"彼に見てもらえなくて、残念でしたね。","nextNodeIds":[732090407]},{"nodeId":732090407,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":148059162,"text":"サバーフ、それは違う。ローズの歌の最後のくだりを覚えておるか？","nextNodeIds":[732090408]},{"nodeId":732090408,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":1911732514,"text":"「私を支える土はない。歌だけが支えてくれる。」","nextNodeIds":[732090409]},{"nodeId":732090409,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":2203164810,"text":"「歌は牙を剥く運命に勝ち、私の結末に勝ち——」","nextNodeIds":[732090410]},{"nodeId":732090410,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":3887646290,"text":"「私に勝ち、私の時間に勝ち、永遠に止まぬ消失に勝つだろう。」","nextNodeIds":[732090411]},{"nodeId":732090411,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":21790258,"text":"シャフカットおじさんの人生も、ゴールデンローズも、彼が作ったこの歌も…こうしてわしらの中に残った。","nextNodeIds":[732090412]},{"nodeId":732090412,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":3906831626,"text":"ええ、そうですね。彼は消失に勝った人です。","nextNodeIds":[732090413]},{"nodeId":732090413,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":3287101970,"text":"シャフカットさんのお話を教えてくれてありがとうございます。これは私にとって、とても大事なことです。","nextNodeIds":[732090414]},{"nodeId":732090414,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":2888303642,"text":"彼は私よりも前にいた追放者です。彼の生活の痕跡を見ると、まるで自分が時空を超えたような気がして…","nextNodeIds":[732090415]},{"nodeId":732090415,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":3436761298,"text":"シャフカットさんのことだけではなく、自分のことも見ているような感じがするのです。","nextNodeIds":[732090416]},{"nodeId":732090416,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":605248346,"text":"彼と何かを話すことはできませんが、彼の心残りとともに生きていくことはできます。","nextNodeIds":[732090417]},{"nodeId":732090417,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":3773632026,"text":"彼の分も頑張って生きていくことで、最終的には私も救われるでしょう。","nextNodeIds":[732090418,732090419]},{"nodeId":732090418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3751424218,"text":"幸せを祈ってる。","nextNodeIds":[732090420]},{"nodeId":732090420,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":749379002,"text":"貴方たちと出会えて本当に良かったです。ここでの生活も悪くないと感じられるようになりました。","nextNodeIds":[732090421]},{"nodeId":732090421,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":3357805242,"text":"ローズはやはり、幸せをもたらしてくれる花ですね。アファンお爺さん、これからはもっと頑張って、さらにたくさんのローズを育てましょう。","nextNodeIds":[732090422]},{"nodeId":732090422,"roleType":"TALK_ROLE_NPC","speakerId":4233,"speakerName":"アファン","textMapHash":2616349898,"text":"ははは、じゃあ、約束だ。","nextNodeIds":[732090423]},{"nodeId":732090423,"roleType":"TALK_ROLE_NPC","speakerId":4232,"speakerName":"サバーフ","textMapHash":1573695274,"text":"ええ、頑張りますわ。","nextNodeIds":[]},{"nodeId":732090419,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3001382562,"text":"諦めないでね。","nextNodeIds":[732090420]},{"nodeId":732090404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2120976466,"text":"すべては報われた。","nextNodeIds":[732090405]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320904,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["73223","4"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["73275","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["4233"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7320905,"order":6,"stepDescription":"","stepDescTextMapHash":3528489996,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7320905,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUI