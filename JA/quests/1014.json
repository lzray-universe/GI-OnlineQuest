ewTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["101403","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_LOCAL","id":101403,"initDialog":10140301,"nextRandomTalks":[],"nextTalks":[],"npcId":[209301],"performCfg":"QuestDialogue/AQ/Liyue1_1014/Q101403","priority":6,"questId":1014,"showRandomTalkCount":0},"dialogs":[{"nodeId":10140301,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":1169465505,"text":"若者は体がよく動いていいのう。こんなにすぐ見つかるとは…","nextNodeIds":[10140302,10140305,10140308]},{"nodeId":10140302,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":989013185,"text":"おばあさんは仙人なのか？","nextNodeIds":[10140303]},{"nodeId":10140303,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3840482025,"text":"仙人…その二文字を他人から言われたのは久方ぶりじゃ。","nextNodeIds":[10140304]},{"nodeId":10140304,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3209493793,"text":"ばあやが仙人かどうかは、もう分かっとるじゃろ？","nextNodeIds":[10140312]},{"nodeId":10140312,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2222600241,"text":"むぅ…わかったような、わからないような。でも、おばあちゃん…この鈴もっていっていいのか？","nextNodeIds":[10140313]},{"nodeId":10140313,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1459534689,"text":"変だと思わない？岩王帝君にあんなことがあったばかりなのに、鈴を取りにくるなんて…","nextNodeIds":[10140314]},{"nodeId":10140314,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":121704297,"text":"おかしな子じゃ。今まで、この璃月港からどれだけの仙人が去り、その度にどんな波風が立ったか知らないじゃろう。","nextNodeIds":[10140315]},{"nodeId":10140315,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3952027289,"text":"しかし、そのどれもがしきたりに従って「送仙儀式」を行ってきた。ならば、今回も行うというのが筋じゃ。","nextNodeIds":[10140316]},{"nodeId":10140316,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":2696857649,"text":"「犯人探し」ばかりして、「送仙儀式」を疎かにするなぞ本末転倒。","nextNodeIds":[10140317]},{"nodeId":10140317,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":4220568401,"text":"今この時、鈴を借りに来た者が現れたのは、きっと旧友の誰かが耐え切れなくなって、立ち上がったからじゃろう。","nextNodeIds":[10140318]},{"nodeId":10140318,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":1928718121,"text":"だから、ばあやは鈴を渡す、当然じゃ。","nextNodeIds":[10140319,10140322]},{"nodeId":10140319,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2836317225,"text":"もし「旧友」が鈴を返さなかったら？","nextNodeIds":[10140320]},{"nodeId":10140320,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3034292249,"text":"返さない？ほぉっほぉっ、仮にそうなったら、ばあやが直接行って返してもらうさ。","nextNodeIds":[10140321]},{"nodeId":10140321,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":49186745,"text":"ずいぶんとご無沙汰しとるし、お茶でもしながら世間話するのもよいじゃろう。","nextNodeIds":[10140326]},{"nodeId":10140326,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3184809641,"text":"さあ、鈴は渡したしお行き。","nextNodeIds":[10140327]},{"nodeId":10140327,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":1278942281,"text":"それと、あなたたちにお使いを頼んだ人に伝言を頼みたい…","nextNodeIds":[10140328]},{"nodeId":10140328,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":2646115513,"text":"時間があったら、お茶をしに来てほしい。ばあやの持ち物は少ないが、急須くらいは持っておる。","nextNodeIds":[10140329]},{"nodeId":10140329,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":690093689,"text":"おう！伝えておく、ありがとな！","nextNodeIds":[]},{"nodeId":10140322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3734222217,"text":"この鈴、くれない？","nextNodeIds":[10140323]},{"nodeId":10140323,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3229067609,"text":"おい！これはおばあちゃんのだぞ！用事が済んだら返さないと！","nextNodeIds":[10140324]},{"nodeId":10140324,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3585142017,"text":"ほぉっほぉっ、素直な子じゃ。欲しいならそのまま持っとるといい。","nextNodeIds":[10140325]},{"nodeId":10140325,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3789085369,"text":"でも、この鈴は寂しがり屋でね、いつの間にかこっそりばあやの元に戻ってるかもしれないよ。","nextNodeIds":[10140326]},{"nodeId":10140305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4196600089,"text":"「璃月七星」の方だよね。","nextNodeIds":[10140306]},{"nodeId":10140306,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":3194086257,"text":"「璃月七星」…昔、ばあやとその仲間があの子たちのことを手伝っておったが、最近はそれもなくなったのう。","nextNodeIds":[10140307]},{"nodeId":10140307,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":327798641,"text":"ここ数年、彼らはよく頑張ってくれとるよ。ばあやたちは安心して任せられる。","nextNodeIds":[10140312]},{"nodeId":10140308,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4175028321,"text":"まさかファデュイの…","nextNodeIds":[10140309]},{"nodeId":10140309,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":1717425697,"text":"ファデュイ？ほぉっほぉっ、この子は想像力が豊かだね。何を考えてるんだい？","nextNodeIds":[10140310]},{"nodeId":10140310,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":2218099273,"text":"ばあやは年寄りだから、ああいう部外者とは関わりたくないよ。","nextNodeIds":[10140311]},{"nodeId":10140311,"roleType":"TALK_ROLE_NPC","speakerId":209301,"speakerName":"ピンばあや","textMapHash":1966532129,"text":"でも、彼らの手がもう少し伸びてきたら、それも避けられないかもしれないねぇ。","nextNodeIds":[10140312]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[101403,0],"PAINL