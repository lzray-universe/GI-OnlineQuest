am":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7067202,"initDialog":706720201,"nextRandomTalks":[],"nextTalks":[],"npcId":[13276],"performCfg":"QuestDialogue/WQ/Mengde_70672/Q7067202","priority":5,"questId":70672,"showRandomTalkCount":0},"dialogs":[{"nodeId":706720201,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4070196402,"text":"あれ…酒場に変わったヤツがいるぞ！","nextNodeIds":[706720202]},{"nodeId":706720202,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":1850330546,"text":"はい？","nextNodeIds":[706720203]},{"nodeId":706720203,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1414157962,"text":"見ろ！でっかいヤマガラだ！","nextNodeIds":[706720204]},{"nodeId":706720204,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":3304314634,"text":"ヤマガラではありません。私の名前は…","nextNodeIds":[706720205]},{"nodeId":706720205,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2214884082,"text":"おや…そう言われると、自分の名前さえ…思い出せませんね。とりあえず、マルとお呼びください。","nextNodeIds":[706720206]},{"nodeId":706720206,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2527984186,"text":"マル…モンドで一度も見たことない気がするけど…","nextNodeIds":[706720207]},{"nodeId":706720207,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":1564747594,"text":"むしろ、モンドで出会うほうが不思議と言えるでしょう。実を言うと、私は璃月から来たのです。","nextNodeIds":[706720208]},{"nodeId":706720208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3635985514,"text":"へぇ、そうだったのか…でも、なんでマルは璃月からモンドのキャッツテールに来たんだ？","nextNodeIds":[706720209,706720212]},{"nodeId":706720209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":624875210,"text":"飲み物を買いに来たの？","nextNodeIds":[706720210]},{"nodeId":706720210,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":1081533458,"text":"確かに璃月とここの飲み物にどんな違いがあるか味わってみたい気持ちはありますが、今日やって来たのは依頼のためなんです。","nextNodeIds":[706720211]},{"nodeId":706720211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1422157146,"text":"依頼？","nextNodeIds":[706720214]},{"nodeId":706720214,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":1868181954,"text":"ふむ…僭越ながら私の推測によると、あなたが噂の旅人さんとお見受けいたします。実は、今回の件はあなたとも少し関係しているのです。","nextNodeIds":[706720215]},{"nodeId":706720215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1634046866,"text":"#{M#俺}{F#私}と？","nextNodeIds":[706720216]},{"nodeId":706720216,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":117383842,"text":"はい。すでにお気づきかと思いますが、「七聖召喚」が流行り出してから、ご友人を招待して酒場で対戦するのが一つの楽しみとなりました。","nextNodeIds":[706720217]},{"nodeId":706720217,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2685984626,"text":"ですが招待を受けた場合、わざわざ遠くから酒場に来なければなりません。それを大変だと感じた依頼人から、仙術を使って壺の中のような小さな部屋を作って欲しいと頼まれたのです。","nextNodeIds":[706720218]},{"nodeId":706720218,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2400864922,"text":"招待を受けてここに来ようとする人は、瞬きもしないうちに、部屋の中に現れることができます。","nextNodeIds":[706720219]},{"nodeId":706720219,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":4053517162,"text":"それにより、その部屋を使って自由にご友人を招待して対戦できますし、招待された人の手間も省けます。","nextNodeIds":[706720220]},{"nodeId":706720220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1101877914,"text":"おおっ！めちゃくちゃ便利だな！","nextNodeIds":[706720221]},{"nodeId":706720221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3969193746,"text":"でも…ここってマーガレットの酒場だし、仙術を使って改造したなんて知られたら、怒られるんじゃないか？","nextNodeIds":[706720222]},{"nodeId":706720222,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":4286221354,"text":"いえ…その点については大丈夫です。そもそも、部屋自体はキャッツテールにあるわけではありません。それに、当然ながら酒場のオーナーの許可もいただいています。","nextNodeIds":[706720223]},{"nodeId":706720223,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":3215560490,"text":"「あら、璃月の仙術って便利ね。酒場の面積を二倍にしてもらってもいいかしら？」と言われましたが…残念ながら、私の仙術では無理でした。","nextNodeIds":[706720224]},{"nodeId":706720224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2859261282,"text":"マ、マーガレットが言いそうなことだな。","nextNodeIds":[706720225]},{"nodeId":706720225,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2609764658,"text":"配置が終わった後にどうやってあなたたちに説明するか悩んでいましたが、ちょうどここでお会いできてよかったです。","nextNodeIds":[706720226]},{"nodeId":706720226,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2410593922,"text":"では、始めさせていただきます。","nextNodeIds":[706720227]},{"nodeId":706720227,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2577550698,"text":"はい、これでいいでしょう。","nextNodeIds":[706720228]},{"nodeId":706720228,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2335398042,"text":"わぁ！これでいいのか？璃月の仙術って不思議なんだな！","nextNodeIds":[706720229]},{"nodeId":706720229,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2356032458,"text":"さて…お二人とは何らかの縁を感じますね。もしかしたら今後、またお会いする機会があるかもしれません。ですが、今後のことはまた後日ということで。","nextNodeIds":[706720230]},{"nodeId":706720230,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":3819039634,"text":"では、この部屋を思う存分使って、各地のご友人を招待して対戦してみてください。","nextNodeIds":[706720231]},{"nodeId":706720231,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":3287348074,"text":"あっ…言いそびれるところでした。酒場のおチビちゃんからの伝言です——","nextNodeIds":[706720232]},{"nodeId":706720232,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":868083866,"text":"「『七聖召喚』を楽しんでくれ！」とのことでした。","nextNodeIds":[]},{"nodeId":706720212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3539297818,"text":"カードゲームをしに来たの？","nextNodeIds":[706720213]},{"nodeId":706720213,"roleType":"TALK_ROLE_NPC","speakerId":13276,"speakerName":"マル","textMapHash":2049682362,"text":"当たらずといえども遠からずですね。カードゲームをやりに来たわけではありませんが、確かにカードと少し関係があります…","nextNodeIds":[706720233]},{"nodeId":706720233,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1577592978,"text":"マルが仙術を駆使して酒場を改築し、対戦招待ボードを作り変えた。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""},{"BFGALAINLMD":0,"LNHLPKELCAL":[7067205,3],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_STATE_EQUAL","PPFLKMOMKAI":""}],"triggerCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7165401,1],"PAINLIBBLDK":"QUEST_CONTENT_QUEST_GLOBAL_VAR_EQUAL","PPFLKMOMKAI":""}],"execActions":[{"LNHLPKELCAL":["7067201","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["1076","201076001"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["13276"],"NOCCOBOFKHP":1076,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7067205,"order":5,"stepDescription":"","stepDescTextMapHash":0,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7067205,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"N