alkCount":0},"dialogs":[{"nodeId":760350101,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":182811738,"text":"（コロンビーナ…いないのかな？）","nextNodeIds":[760350102]},{"nodeId":760350102,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2937254682,"text":"私に何か用？","nextNodeIds":[760350103]},{"nodeId":760350103,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3120347586,"text":"うわっ！","nextNodeIds":[760350104,760350105]},{"nodeId":760350104,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":843542242,"text":"びっくりした…","nextNodeIds":[760350106]},{"nodeId":760350106,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":1565822514,"text":"キミの気配がしたから、後ろから近づけないか試してみたの。","nextNodeIds":[760350107]},{"nodeId":760350107,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2035160250,"text":"よっぽど暇なんだな…","nextNodeIds":[760350108]},{"nodeId":760350108,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":3034950114,"text":"え…そう見える？ファデュイにいた頃と変わらないけど…でも確かに、あの頃も特にやることはなかったかな。","nextNodeIds":[760350109]},{"nodeId":760350109,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":4235009698,"text":"女皇様が必要としてたのは「月神」の力だけ。神の心を手に入れるようにって指示は受けてなかった。","nextNodeIds":[760350110]},{"nodeId":760350110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1171460962,"text":"普段は何してる？","nextNodeIds":[760350111]},{"nodeId":760350111,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":1601644106,"text":"散歩したり、月を眺めたり…たまに歌を歌ったり。でもサンドローネから、歌うのをやめなさいって言われてから、あまり歌わなくなった。","nextNodeIds":[760350112]},{"nodeId":760350112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3963517762,"text":"サンドローネって、歌が好きじゃないのか？","nextNodeIds":[760350113]},{"nodeId":760350113,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2509595066,"text":"ううん。上手だって言ってくれたよ。ただ、私がファデュイに入ったばかりの頃は、私の歌を聞くとほかの人が緊張しちゃうからって…","nextNodeIds":[760350114]},{"nodeId":760350114,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":827036170,"text":"知らない人からすると、私が何か能力を使ってるんじゃないかと誤解するかもって。","nextNodeIds":[760350115]},{"nodeId":760350115,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4225279098,"text":"なるほどな…なんとなくわかる気がするぜ。","nextNodeIds":[760350116]},{"nodeId":760350116,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2728954122,"text":"もう一つあるよ。サンドローネはたいてい夜中に研究をして昼間は寝てるんだけど、私が歌うと昼寝ができないんだって。","nextNodeIds":[760350117]},{"nodeId":760350117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3226057746,"text":"（本当の理由はこっちだろうね。）","nextNodeIds":[760350118]},{"nodeId":760350118,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2944223186,"text":"だから、夜中にサンドローネの部屋の前で歌うようにしたんだけど、それでも追い出されてしまったの。","nextNodeIds":[760350119]},{"nodeId":760350119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1685862690,"text":"……","nextNodeIds":[760350120]},{"nodeId":760350120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3484568274,"text":"ほかの人とは仲良くしてた？","nextNodeIds":[760350121]},{"nodeId":760350121,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2165102474,"text":"「仲良く」…？うーん…アルレッキーノと会ったばかりの頃、彼女は私と「仲良く」なりたかったみたいで…","nextNodeIds":[760350122]},{"nodeId":760350122,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":1495001986,"text":"いつも足音も立てずに後ろから近づいてきてた。さっきの私みたいにね…ちょっと試したかっただけだ、って言ってた。","nextNodeIds":[760350123]},{"nodeId":760350123,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":576087938,"text":"だから私もそのゲームをやってみてたんだけど、いつもかなり離れたところで気づかれちゃうの。","nextNodeIds":[760350124]},{"nodeId":760350124,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":3079510842,"text":"仕方ないから「月」の力を借りて…その時初めて後ろから驚かすことに成功したんだ。でも、その日を境に彼女はそのゲームをしなくなっちゃった。","nextNodeIds":[760350125]},{"nodeId":760350125,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1766098362,"text":"（そもそもそれ、アルレッキーノは「ゲーム」のつもりじゃなかっただろ…）","nextNodeIds":[760350126]},{"nodeId":760350126,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":636011266,"text":"「博士」からも、「光界の力」の研究に手を貸してほしいって時々言われたよ。","nextNodeIds":[760350127]},{"nodeId":760350127,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2793171042,"text":"何回か付き合ったけど、クーヴァキを使ってこれを叩きなさいとか、あれを操作しなさいとかばっかりで…つまらなかったからすぐに行かなくなった。","nextNodeIds":[760350128,760350129]},{"nodeId":760350128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1214052466,"text":"過去のことを聞かせてくれるなんて…","nextNodeIds":[760350130]},{"nodeId":760350130,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":1166764490,"text":"うん、「家出」中だけど、楽しい思い出もあったから。","nextNodeIds":[760350131]},{"nodeId":760350131,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":3860236482,"text":"アルレッキーノとサンドローネは優しかった。それから…","nextNodeIds":[760350132]},{"nodeId":760350132,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":1624128794,"text":"……","nextNodeIds":[760350133]},{"nodeId":760350133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2645559778,"text":"（誰か思い出したのかな…）","nextNodeIds":[760350134]},{"nodeId":760350134,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2220397410,"text":"手を出して。","nextNodeIds":[760350135,760350136]},{"nodeId":760350135,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2665292034,"text":"…ん？","nextNodeIds":[760350137]},{"nodeId":760350137,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":397924530,"text":"ロザリンに言われたことがあるんだ…感謝の気持ちはちゃんと伝えなさいって。","nextNodeIds":[760350138]},{"nodeId":760350138,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":1745719394,"text":"今日は話を聞いてくれてありがとう。","nextNodeIds":[760350139]},{"nodeId":760350139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2707063138,"text":"どういたしまして。","nextNodeIds":[760350140]},{"nodeId":760350140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":721342298,"text":"（これは…月神の祝福？）","nextNodeIds":[760350141]},{"nodeId":760350141,"roleType":"TALK_ROLE_NPC","speakerId":1318,"speakerName":"「少女」","textMapHash":2760163482,"text":"今日はここまでにしておきましょう。","nextNodeIds":[760350142]},{"nodeId":760350142,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":60421554,"text":"きゅ、急だな！","nextNodeIds":[760350143,760350144]},{"nodeId":760350143,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":124903866,"text":"しーっ…パイモン…","nextNodeIds":[760350145]},{"nodeId":760350145,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1787113538,"text":"そっか。じゃ、今日はそろそろ引き上げよう。","nextNodeIds":[]},{"nodeId":760350144,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2636940178,"text":"いろいろ思い出したのかも…","nextNodeIds":[760350145]},{"nodeId":760350136,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":458575002,"text":"…どうしたの？","nextNodeIds":[760350137]},{"nodeId":760350129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2168507218,"text":"今日はご機嫌みたいだね。","nextNodeIds":[760350130]},{"nodeId":760350105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2662881002,"text":"突然後ろから出てこないでよ…","nextNodeIds":[760350106]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7603501,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":[],"PAINLIBBL