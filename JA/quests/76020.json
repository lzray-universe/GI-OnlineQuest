kReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7602007","","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["7602006","2","","",""],"type":"QUEST_COND_QUEST_STATE_NOT_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_AND","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7602001,"initDialog":760200101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"","priority":5,"questId":76020,"showRandomTalkCount":0},"dialogs":[{"nodeId":760200101,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":893968442,"text":"今日も収穫ナシか…","nextNodeIds":[760200102,760200105,760200112,760200117]},{"nodeId":760200102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2313546954,"text":"何してるの？","nextNodeIds":[760200103]},{"nodeId":760200103,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3239447466,"text":"釣りじゃ。今のとこ、魚じゃない変なものばかり釣れとるがな。","nextNodeIds":[760200104]},{"nodeId":760200104,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2250973218,"text":"もし沈没船の小物なんかが釣れれば、行商人が買い取ってくれるんじゃがな。前に釣り上げた靴なんか…おっと、あんまり話すと魚が逃げちまうな。","nextNodeIds":[]},{"nodeId":760200105,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3068970674,"text":"この辺りで何か気になったことはない？","nextNodeIds":[760200106]},{"nodeId":760200106,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":839518914,"text":"さては、宝探しじゃな？月の東、太陽の西にしかない「偉大なる財宝」なんてものは…聞いただけで、ここにはないとわかるじゃろう。","nextNodeIds":[760200107]},{"nodeId":760200107,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1391488618,"text":"ああ、そう言えば、ここは昔から船の海難事故が多い場所なんじゃ。沈没船の中には確かに価値のあるものもあるかもしれんがな、見つけ出すのはそう簡単じゃないぞ。","nextNodeIds":[760200108]},{"nodeId":760200108,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2449804538,"text":"これは酒場で生き残った船乗りから聞いた話なんじゃが…その夜は月もないのに、荒れ狂う大波の中に光る物が見えたんじゃと。","nextNodeIds":[760200109]},{"nodeId":760200109,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2717346370,"text":"間違いなく隻眼のケラティに違いないと言っておったのう。月さえも飲み込む怪物が、海の巨蛇と縄張り争いをしておったのじゃと。","nextNodeIds":[760200110]},{"nodeId":760200110,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3214614602,"text":"その後は長いこと、このあたり一帯が、まるでインク壺をひっくり返したみたいに真っ黒じゃったわい。どの船も怖がって、通らんようになってのう…みんな、水底の亡霊に引きずり込まれるんじゃないかと震え上がっとったもんじゃ。","nextNodeIds":[760200111]},{"nodeId":760200111,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1244830394,"text":"今でもその亡霊たちがこの辺りを彷徨ってるという噂があるが、まあ、子供を怖がらせるにはちょうどいい話じゃろう？そんな根も葉もない戯言は信じとらんよ。","nextNodeIds":[]},{"nodeId":760200112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1568061426,"text":"この木について…","nextNodeIds":[760200113]},{"nodeId":760200113,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3773493490,"text":"この木はちょっと不気味でのう。元々ここいらには渦が出るもんでな、船乗りたちはケラティの眼と呼んでおったんじゃが、ある日突然、この木が生えてきおったんじゃ。","nextNodeIds":[760200114]},{"nodeId":760200114,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3268231482,"text":"あの頃起きたおかしなことと言えば、それだけじゃなかったのう。考えてみれば、石っころが空から降ってきた後のことじゃ…もしかしたら、この木も石っころと同じように天外から来たのやもしれんな。","nextNodeIds":[760200115]},{"nodeId":760200115,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":27765986,"text":"たびたび見かけるキラキラした小物も、珍しいものばかりじゃ。ひょっとして、新種の魚でもおるのかもしれんと思って、運試しに来とるんじゃ。","nextNodeIds":[760200116]},{"nodeId":760200116,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":438149858,"text":"もともとは、わしの釣り仲間も一緒に来とったんじゃが…妙な歌声が聞こえると言い出しおってな、怖じ気づいて来なくなってしもうた。半分霜月の子なんじゃが、悪癖はまるっきり、そのものじゃわい。","nextNodeIds":[]},{"nodeId":760200117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1349485634,"text":"邪魔したね。","nextNodeIds":[760200118]},{"nodeId":760200118,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3711303042,"text":"構わん構わん。どうせ魚の影も見えんからの。","nextNodeIds":[]}]},{"talkId":7602007,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7602007","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7602007,"initDialog":760200701,"nextRandomTalks":[],"nextTalks":[],"npcId":[21924],"performCfg":"QuestDialogue/WQ/NodKrai_76020/Q7602007","priority":5,"questId":76020,"showRandomTalkCount":0},"dialogs":[{"nodeId":760200701,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3621538282,"text":"まったく…妙な話じゃ。","nextNodeIds":[760200702]},{"nodeId":760200702,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3683210226,"text":"今の、見たか？さっきこの木が、ぱあっと光りおったんじゃ。それに、この小さいのも…残念ながら魚ではなかったがのう。","nextNodeIds":[760200703]},{"nodeId":760200703,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4115830298,"text":"ってことは、真ん中のやつってこの木の根っこなのか？仕組みはよくわかんないけど、キラキラしてて、さっきのくすんだ感じよりずっとキレイだぞ。","nextNodeIds":[760200704]},{"nodeId":760200704,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":1915828482,"text":"これまでの経緯を語った…","nextNodeIds":[760200705]},{"nodeId":760200705,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2747866450,"text":"信じがたいが…わしを騙すためにわざわざ嘘をつく理由もなかろう。どうやら、半分霜月の子の釣り友が言っておったことは本当だったようじゃな。","nextNodeIds":[760200706]},{"nodeId":760200706,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":3302812394,"text":"じゃが、それがどうした。所詮は過去の残影に過ぎん。やつらがどんな歌を歌おうと、何を語ろうと、わしら生きる者が生きた魚を釣るのに、関係などありはせん。","nextNodeIds":[760200707]},{"nodeId":760200707,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":2617216834,"text":"さて、話は戻るが…あんたらも宝探しをしておるんじゃろ？さっき、これを釣り上げたんじゃ…","nextNodeIds":[760200708]},{"nodeId":760200708,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1381854570,"text":"これ…<color=#00E1FFFF>「識者の証」</color>か？ただの鳥の羽に見えるけど…","nextNodeIds":[760200709]},{"nodeId":760200709,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":1345427578,"text":"馴染みの行商人の話じゃと、<color=#00E1FFFF>「識者の証」</color>を五つ集めれば、月の東、太陽の西に埋められた「偉大なる財宝」が見つかるそうじゃ。本当かどうかは知らんがな。","nextNodeIds":[760200710]},{"nodeId":760200710,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":4127112986,"text":"実際、多くのトレジャーハンターがそれを信じ込み、我先にと飛びついていく。","nextNodeIds":[760200711]},{"nodeId":760200711,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2824878178,"text":"た、宝物だもんな！オイラも興味あるぞ！","nextNodeIds":[760200712]},{"nodeId":760200712,"roleType":"TALK_ROLE_NPC","speakerId":21924,"speakerName":"イルマリ","textMapHash":470720378,"text":"もしあと二十ほど若かければ、わしもあるいは…いや、若返ったとしても、やっぱり釣りが一番じゃわい。とはいえ、今日も手ぶらで帰る羽目になりそうじゃがな。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7602007,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[3_11410:2189.326,200.406,8783.789,0.00