:"まあ、ある意味では…","nextNodeIds":[230130124]},{"nodeId":230130124,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"路通","textMapHash":4192444994,"text":"その通りです。","nextNodeIds":[230130125]},{"nodeId":230130125,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"ガルシア","textMapHash":49377778,"text":"路通くん、我々には…ええと、まだお金が残っていたかな？","nextNodeIds":[230130126]},{"nodeId":230130126,"roleType":"TALK_ROLE_NPC","speakerId":20658,"speakerName":"路通","textMapHash":1523670562,"text":"こちらの旅人さんに報酬を払っても、まあなんとかやっていけると信じていますよ。","nextNodeIds":[230130127]},{"nodeId":230130127,"roleType":"TALK_ROLE_NPC","speakerId":20657,"speakerName":"ガルシア","textMapHash":1095868354,"text":"じゃあ決まりだ！頼む、旅人さん。スライムの液体を集めてきてくれ。","nextNodeIds":[]},{"nodeId":230130107,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2964887266,"text":"どうしてここに？","nextNodeIds":[230130108]}]},{"talkId":2301311,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2301301","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["42020","1","0","",""],"type":"QUEST_COND_DAILY_TASK_VAR_GT"},{"param":["",""