":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["[3_10477:-3051.298,234.129,9908.278,0.000,111.730,0.000]","80"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"},"isHidden":false,"talkIds":[1503104],"talks":[{"talkId":1503104,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["1503107","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":1503104,"initDialog":150310401,"nextRandomTalks":[],"nextTalks":[],"npcId":[1098],"performCfg":"QuestDialogue/LQ/Varesa_15031/Q1503104","priority":5,"questId":15031,"showRandomTalkCount":0},"dialogs":[{"nodeId":150310401,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":600754698,"text":"すごい収穫だな！遊像の眼がたくさん手に入ったし、それに火を噴くようなやつまであるぞ。","nextNodeIds":[150310402]},{"nodeId":150310402,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":421803554,"text":"うん。それは「マグマイタチ」の鱗甲だね。燃素を噴射できるから、びゅんびゅん動けるんだよ～","nextNodeIds":[150310403]},{"nodeId":150310403,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":355144178,"text":"昔お父さんから教わったんだけど、普段は火山の中に住んでる生き物なんだって。こうして出会えたのはとってもラッキーなんだ。","nextNodeIds":[150310404]},{"nodeId":150310404,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":2004313530,"text":"この鱗甲、もしかしたら遊像の眼よりも高温を出せるかも。へへっ、これで十分そうだねぇ～","nextNodeIds":[150310405]},{"nodeId":150310405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2585291690,"text":"すごくいい戦いぶりだったよ。","nextNodeIds":[150310406]},{"nodeId":150310406,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":3983720106,"text":"あはは…どんなに戦いたくないと思ってても、ちゃんと意識を切り替えられるよう、いろんな方法を考えたんだ。","nextNodeIds":[150310407]},{"nodeId":150310407,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":3036104466,"text":"わたし、いろんな英雄のお話を読むのが好きなんだけど、前にも言ったように一番好きなのがフィエテナさまでね——","nextNodeIds":[150310408]},{"nodeId":150310408,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":1823168314,"text":"そのトレードマークが仮面だったから、物語の描写を参考に同じようなものを作ったの。","nextNodeIds":[150310409]},{"nodeId":150310409,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":1207475386,"text":"仮面をつけて、わたし自身がフィエテナさまになったって信じ込むとね、その顔に泥を塗るわけにはいかないってなって、勇気が湧いてくるんだぁ！","nextNodeIds":[150310410]},{"nodeId":150310410,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":2808399650,"text":"でも、これじゃあフィエテナさまの後ろに隠れてるみたいだよね…","nextNodeIds":[150310411]},{"nodeId":150310411,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3447350314,"text":"なるほどな。","nextNodeIds":[150310412,150310413]},{"nodeId":150310412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1021476802,"text":"でも効果はある。","nextNodeIds":[150310414]},{"nodeId":150310414,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":4143199010,"text":"本当？けど…","nextNodeIds":[150310415]},{"nodeId":150310415,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":1024249722,"text":"いつかは仮面を外して、自分に向き合わなきゃ。","nextNodeIds":[150310416]},{"nodeId":150310416,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":3655942746,"text":"ただ、その一歩がなかなか踏み出せないの。気づくと、またこの仮面の力に頼っちゃう…わたし、この先もずっとそうなんじゃないかって不安で…","nextNodeIds":[150310417,150310418]},{"nodeId":150310417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3552408922,"text":"でもキノコの調査を決心したのは自分だよ。","nextNodeIds":[150310419]},{"nodeId":150310419,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":200822250,"text":"そうそう！決めたのは他でもない、ヴァレサ自身だろ！勇気ある決断こそが冒険では大切なことなんだ。戦うのなんて冒険の一部に過ぎないぞ！","nextNodeIds":[150310420]},{"nodeId":150310420,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":1011634178,"text":"そうなんだね…","nextNodeIds":[150310421]},{"nodeId":150310421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1345452530,"text":"ヴァレサはもう十分前に進めてるぜ。焦らなくて大丈夫だ！","nextNodeIds":[150310422]},{"nodeId":150310422,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":1409860522,"text":"うん。いつも励ましてくれてありがとう。それにいろいろ教えてくれるし、二人には感謝してもしきれないよ～！","nextNodeIds":[150310423]},{"nodeId":150310423,"roleType":"TALK_ROLE_NPC","speakerId":1098,"speakerName":"ヴァレサ","textMapHash":3117563082,"text":"よぉ～し！もっともっと成長して、英雄の名前に隠れず、自分の名前と向き合えるようになってみせる！","nextNodeIds":[150310424]},{"nodeId":150310424,"roleType":"TALK_ROLE_NPC","speakerId":1098,"s