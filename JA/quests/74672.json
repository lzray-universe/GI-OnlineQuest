rue,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7467201","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7467201,"initDialog":746720101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30423],"performCfg":"QuestDialogue/WQ/Fontaine_74672/Q7467201","priority":5,"questId":74672,"showRandomTalkCount":0},"dialogs":[{"nodeId":746720101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4018314882,"text":"あれ？シャルロットじゃないか？","nextNodeIds":[746720102]},{"nodeId":746720102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":161750770,"text":"レピーヌ·ポーリーンとなにか話してるみたいだぞ…","nextNodeIds":[746720103]},{"nodeId":746720103,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3095328370,"text":"お、お願いです、シャルロットさん！いや、シャルロット様…お願いですから、冗談だと言ってください！","nextNodeIds":[746720104]},{"nodeId":746720104,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3744452938,"text":"「プクプク獣の変装をし、警備ロボの目を逃れ、犯罪へ」…この事件は事実ですよね！？","nextNodeIds":[746720105]},{"nodeId":746720105,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3308377658,"text":"「画像認識」技術のために、私は貯金を使い果たしたうえ、銀行から大金を借りたんです！","nextNodeIds":[746720106]},{"nodeId":746720106,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2521645186,"text":"この通り、土下座でもしますから！！！","nextNodeIds":[746720107]},{"nodeId":746720107,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1887234634,"text":"レピーヌ·ポーリーンさん、落ち着いてください…","nextNodeIds":[746720108]},{"nodeId":746720108,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":2515706074,"text":"研究に対するあなたの熱い思いと…えーっと…大口発注への渇望は理解できますが…","nextNodeIds":[746720109]},{"nodeId":746720109,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1702166042,"text":"しかし…あれは間違いなく小説です。誰かが趣味で創作して、匿名で投稿した報道記事風の物語なんです。","nextNodeIds":[746720110,746720111]},{"nodeId":746720110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":570661834,"text":"事件？","nextNodeIds":[746720112]},{"nodeId":746720112,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":152096522,"text":"うわ…オイラわかったかもだぞ…","nextNodeIds":[746720113]},{"nodeId":746720113,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2083614674,"text":"もしかして、レピーヌ·ポーリーンが前に『スチームバード新聞』で読んだ記事って…","nextNodeIds":[746720114]},{"nodeId":746720114,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1702426922,"text":"編集者たちが会議で話し合っているのをこの耳で聞いたんですから。編集者たちも、あの小説が民衆に誤解を与えるんじゃないかって懸念して、わざわざ執律庭に問い合わせまでしたんですよ。","nextNodeIds":[746720115]},{"nodeId":746720115,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1841857266,"text":"しかし思いのほか、執律庭はあの小説が気に入ったみたいで…偽情報が潜在的犯罪者の耳に入れば、目立つ被り物での犯行を誘導できるかもって…","nextNodeIds":[746720116]},{"nodeId":746720116,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1088203178,"text":"警備ロボの識別能力は、ベテランの警察と肩を並べるほどだから、そんな犯罪を見逃すはずがありません。却って犯行を目立たせるだけ…","nextNodeIds":[746720117]},{"nodeId":746720117,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1275272338,"text":"小説が掲載されてからというもの、数多くの「プクプク獣怪盗」、「巨大赤カンムリガラ」に「フライムマン」たちが執律庭によって逮捕されました。","nextNodeIds":[746720118]},{"nodeId":746720118,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3039548858,"text":"あの小説が治安維持の一助となったのは事実ですが、まさかあなたのような研究員まで引っ掛かるとは…しかも多額の投資までしていたなんて…","nextNodeIds":[746720119]},{"nodeId":746720119,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2890609698,"text":"うっ…ああああああ…","nextNodeIds":[746720120]},{"nodeId":746720120,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":658450674,"text":"うぅ…レピーヌ·ポーリーンの研究の動機が…うそっぱちの物語だったなんて…","nextNodeIds":[746720121]},{"nodeId":746720121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1495566778,"text":"ってことは、オイラたちの分け前もなくなっちゃったのか…じゃなくて、あいつの投資は全部無駄になっちゃったのか？","nextNodeIds":[746720122]},{"nodeId":746720122,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":213881354,"text":"旅人とパイモン、戻ってきたのね！","nextNodeIds":[746720123]},{"nodeId":746720123,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":2430884218,"text":"近くで取材してたら、偶然レピーヌ·ポーリーンさんに出会ってね。彼女の研究のことと、君たちのことも聞いたよ。","nextNodeIds":[746720124]},{"nodeId":746720124,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3268265778,"text":"私も、「画像認識技術」の宣伝文を書いてって頼まれたの。原稿料とレンズの見本まで渡されてね。","nextNodeIds":[746720125]},{"nodeId":746720125,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":413645466,"text":"でも残念なことに、彼女の期待も、君たちの努力も無駄になってしまった…君たちにギャラを払わないといけないって彼女は頭を抱えてたわ…慰めの言葉はかけたけど、すぐには受け入れられないだろうね。","nextNodeIds":[746720126]},{"nodeId":746720126,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3726714226,"text":"オイラたちもこんなことは初めてだぞ…","nextNodeIds":[746720127]},{"nodeId":746720127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2243371970,"text":"うーん…その作家はただ面白い物語を書きたかっただけだろうし…執律庭のやり方だって、確かにフォンテーヌの治安維持の役には立ったもんな…","nextNodeIds":[746720128,746720129]},{"nodeId":746720128,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":244810330,"text":"誰のせいでもない。","nextNodeIds":[746720130]},{"nodeId":746720130,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":2430048930,"text":"ちょ、ちょっと！レピーヌ·ポーリーンさん、何してるんですか！？","nextNodeIds":[746720131]},{"nodeId":746720131,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2094008106,"text":"警備ロボと一戦やるんです。それからエピクレシス歌劇場に行って、メロピデ要塞に住民登録をしようと思います。","nextNodeIds":[746720132]},{"nodeId":746720132,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3785949834,"text":"そしたら、借金を返さずに済むでしょう。そう、それが生き延びるための唯一の方法…","nextNodeIds":[746720133]},{"nodeId":746720133,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":59125266,"text":"早まりすぎです！あなたが警備ロボと戦ったって、彼らの外装さえ破れないでしょう！？せいぜい執律庭で数日過ごした後、借金は借金で返さなきゃいけないんですよ！","nextNodeIds":[746720134]},{"nodeId":746720134,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":4000787626,"text":"…それより、この技術に一体いくら注ぎ込んだんですか？","nextNodeIds":[746720135]},{"nodeId":746720135,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":352336586,"text":"…二十七…万モラ…","nextNodeIds":[746720136]},{"nodeId":746720136,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1947843170,"text":"えーっと、メロピデ要塞に逃げ込むほどの額でもなさそうですけど…？","nextNodeIds":[746720137]},{"nodeId":746720137,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3420950594,"text":"旧フォンテーヌ科学院の外注設備エンジニアに過ぎない私にとっては、何年も掛けて一生懸命貯めてきた貯金なんです！","nextNodeIds":[746720138]},{"nodeId":746720138,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3732578954,"text":"それに、失ったのは貯金だけではありません。私が思い描いてきた「画像認識」の輝かしい未来も、億万長者になる夢も、何もかもが消えてしまいました！","nextNodeIds":[746720139]},{"nodeId":746720139,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":555883082,"text":"ふっ…へへ…はは…うぅ…","nextNodeIds":[746720140]},{"nodeId":746720140,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":633312378,"text":"私の人生も台無しです。","nextNodeIds":[746720141]},{"nodeId":746720141,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3740975026,"text":"コホンッ！そう落ち込まないでください。レピーヌ·ポーリーンさん、私に一つ提案があります。","nextNodeIds":[746720142]},{"nodeId":746720142,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3020251946,"text":"よく見てみたら、先ほど渡してくれた見本——「画像認識サンプル収集撮影レンズ」は、より正確に収集し分析するための特別設計がなされているようですね。","nextNodeIds":[746720143]},{"nodeId":746720143,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":257803442,"text":"本来の機能とは別に、素早くフォーカスを変えられるこのレンズは、きっと記者たちの役に立つと思いますよ。フォンテーヌ新聞業界の進化を推し進める力になるかもしれません！","nextNodeIds":[746720144]},{"nodeId":746720144,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":107460770,"text":"ですから、あなたのこれまでの研究は決して無駄ではありません。思いがけない分野ですごい真価を発揮できるかもしれませんよ！","nextNodeIds":[746720145]},{"nodeId":746720145,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":4059759466,"text":"ほ、本当ですか？","nextNodeIds":[746720146]},{"nodeId":746720146,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":2801127946,"text":"もちろんです！こう見えても『スチームバード新聞』で経験を積んできた記者ですよ。同業者たちが仕事でどんな課題を抱えてるのか、よく分かってます。","nextNodeIds":[746720147]},{"nodeId":746720147,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":2046662474,"text":"ですから、まずは気を取り直してください。その後レンズの量産について考えましょう。記者の仲間たちにもあなたのレンズのことを紹介して、取引先をあたってみますから。","nextNodeIds":[746720148]},{"nodeId":746720148,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2871449290,"text":"こんな幸運が訪れるとは…","nextNodeIds":[746720149]},{"nodeId":746720149,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3879257866,"text":"もしかしたら…「撮影設備」発展のチャンスを掴めるかも？それで大口発注が来たら、億万長者になるのも夢じゃない！","nextNodeIds":[746720150]},{"nodeId":746720150,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2263431146,"text":"ええと…もう少し資金を借り入れたほうがいいでしょうか？撮影設備戦争を勝ち抜くためには、いち早くレンズを改善して、市場を先取りしないと！","nextNodeIds":[746720151]},{"nodeId":746720151,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4125490114,"text":"レピーヌ·ポーリーン、夢ばっか見てないで…まずは一歩ずつ進んでいこうぜ。全財産を注ぎ込んで、一夜にして金持ちになるなんて野望はやめたほうがいいぞ…","nextNodeIds":[746720152,746720153]},{"nodeId":746720152,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3911746090,"text":"野望が大きいほど、失望も大きい。","nextNodeIds":[746720154]},{"nodeId":746720154,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":4159595890,"text":"ええ…もし知り合いの伝手で、画像認識の設備を必要としてる工房に売ることができたら、もう少しモラを集めることができるわ…ああ、もっと早く考え付けばよかった！","nextNodeIds":[746720155]},{"nodeId":746720155,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":688712026,"text":"善は急げ！一刻も早く！","nextNodeIds":[746720156]},{"nodeId":746720156,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2210841890,"text":"あっ、もう行っちゃったぞ！","nextNodeIds":[746720157]},{"nodeId":746720157,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":244707698,"text":"オイラたちの話、全然聞いてないじゃんかよ！","nextNodeIds":[746720158]},{"nodeId":746720158,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1870890690,"text":"まあ…少し分かる気もするわ。「インスピレーションと情熱が沸き上がったとき、仕事のことしか頭にないから、人の話が入ってこない」んだよね…新人記者にもそういうタイプが多いの。","nextNodeIds":[746720159]},{"nodeId":746720159,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":2236901682,"text":"心配しないで。今回の出来事を記事にするつもりよ。レピーヌ·ポーリーンさんの様子も時々見に行ってあげるから。","nextNodeIds":[746720160]},{"nodeId":746720160,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1854972746,"text":"彼女の研究はきっと記者たちの役に立つと思うわ。彼女が軌道から踏み外すことなく、できるだけ早くレンズの大量生産にこぎつけられるように、私もアドバイスしてあげるつもりよ。","nextNodeIds":[746720161]},{"nodeId":746720161,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":691868442,"text":"そしたら、オイラたちも安心だぜ！","nextNodeIds":[746720162,746720163]},{"nodeId":746720162,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1107153314,"text":"さすがはシャルロット！","nextNodeIds":[746720164]},{"nodeId":746720164,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":1006262754,"text":"そうだ、このサンプルレンズは君たちにあげるわ！ほら、君たちってあっちこっちを旅してるでしょ？","nextNodeIds":[746720165]},{"nodeId":746720165,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":816608258,"text":"すごいツールは、すごい人の手に使われて初めてその真価を発揮する。きっと君たちが使ったほうが、素晴らしい瞬間をたくさん記録できると思うわ。","nextNodeIds":[746720166]},{"nodeId":746720166,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1653260434,"text":"ありがとな、シャルロット！","nextNodeIds":[746720167]},{"nodeId":746720167,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3393647626,"text":"分け前はなくなったけど、無駄足にはならなかったぜ！","nextNodeIds":[746720168]},{"nodeId":746720168,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3463348690,"text":"大したことないよ！私も特ダネを仕入れることができたしね！","nextNodeIds":[746720169]},{"nodeId":746720169,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3719323218,"text":"「特殊なニーズがあったからとはいえ、新聞報道と文学作品の境界線はできるだけ線引きさせたほうがいい。」","nextNodeIds":[746720170]},{"nodeId":746720170,"roleType":"TALK_ROLE_NPC","speakerId":1070,"speakerName":"シャルロット","textMapHash":3658539258,"text":"レピーヌ·ポーリーンさんみたいな…善良な市民が不幸な目に遭うことが二度とないよう、編集部にちゃんと話しとくわ！","nextNodeIds":[]},{"nodeId":746720163,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":593820754,"text":"さすがは新聞社のエース！","nextNodeIds":[746720164]},{"nodeId":746720153,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1636565530,"text":"一歩ずつ前に進むのが、成功の近道。","nextNodeIds":[746720154]},{"nodeId":746720129,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1197467314,"text":"傷ついたのはレピーヌ·ポーリーンだけ。","nextNodeIds":[746720130]},{"nodeId":746720111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3710701402,"text":"小説？","nextNodeIds":[746720112]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467201,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30423"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7467202,"order":3,"stepDescription":"シャルロットと会話する","stepDescTextMapHash":3202529100,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7467202,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["1070"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7467202],"talks":[{"talk