,"questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["2300303","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2300304,"initDialog":230030401,"nextRandomTalks":[],"nextTalks":[],"npcId":[4004],"performCfg":"QuestDialogue/IQ/Sumeru_23003/Q2300304","priority":5,"questId":23003,"showRandomTalkCount":0},"dialogs":[{"nodeId":230030401,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":4242800506,"text":"お前たちには世話になった。今日はじゃんじゃん好きなものを頼むといい！ハハハッ！","nextNodeIds":[230030402]},{"nodeId":230030402,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":195800538,"text":"大儲けしたみたいだな！","nextNodeIds":[230030403]},{"nodeId":230030403,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2476857722,"text":"一般人には大金だろうが…このハティム様にとっちゃ、はした金みたいなもんだ。","nextNodeIds":[230030404]},{"nodeId":230030404,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3958436074,"text":"俺は取引所で何十年も勝負してきたベテランだ。先物に興味があるなら、ちょっとした秘訣を教えてやってもいいぞ。","nextNodeIds":[230030405]},{"nodeId":230030405,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1944672586,"text":"それが、この前約束したボーナスだ。まぁそう遠慮するな！","nextNodeIds":[230030406]},{"nodeId":230030406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1868892130,"text":"えぇ、ボーナスってそれかぁ？そんなの別に欲しくないぞ…","nextNodeIds":[230030407]},{"nodeId":230030407,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2788477018,"text":"#だって{M#俺}{F#私}たち、先物取引なんてしないし…","nextNodeIds":[230030408]},{"nodeId":230030408,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3102916226,"text":"いやいや、もちろんモラはきちんと支払う！だが、それよりこのハティム様のアドバイスの方がよほど価値があると思うぞ！","nextNodeIds":[230030409]},{"nodeId":230030409,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2986372002,"text":"じゃあ…いっこ質問だけど、ほんとにスライムの先物取引ってあるのか？","nextNodeIds":[230030410]},{"nodeId":230030410,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4057546962,"text":"べ、別にお金儲けがしたいわけじゃないぞ！ちょっと、聞いてみただけだ！","nextNodeIds":[230030411]},{"nodeId":230030411,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2258683922,"text":"うーむ、先物取引の対象になるのは、市場で流通している商品だ。つまり、スライムの液体が市場で小麦粉やミルクくらい大量に流通していれば、取引対象になることもありえる。","nextNodeIds":[230030412]},{"nodeId":230030412,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1395317058,"text":"前にも言った通り、スライムの液体を先物取引の対象にしようとすれば、野外のスライムは根こそぎ狩られかねない。","nextNodeIds":[230030413]},{"nodeId":230030413,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1457193162,"text":"スライムを専門に飼育して、スライムの液体を持続的に大量生産する集団や個人が出現するかもしれない。","nextNodeIds":[230030414]},{"nodeId":230030414,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":3666674498,"text":"そうなれば、スライムの液体の価格も高騰するかもな…","nextNodeIds":[230030415]},{"nodeId":230030415,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4221324810,"text":"うぅ…スライムの液体を買うだけなのに、やけに複雑なんだな…","nextNodeIds":[230030416]},{"nodeId":230030416,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2668146994,"text":"#や、やっぱり直接{NICKNAME}にスライムを倒してもらおう…","nextNodeIds":[230030417]},{"nodeId":230030417,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2508884322,"text":"金運の申し子、お前はなにか質問はないのか？","nextNodeIds":[230030418]},{"nodeId":230030418,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2266534306,"text":"どうやって「千金料理」を考案したの？","nextNodeIds":[230030419]},{"nodeId":230030419,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2101207682,"text":"おお、さすがだな。ズバッと金儲けの神髄に切り込んできやがった。","nextNodeIds":[230030420]},{"nodeId":230030420,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":1010424218,"text":"「考案」したというか…「千金料理」は長きにわたる先物人生の「賜物」というべきだな。","nextNodeIds":[230030421]},{"nodeId":230030421,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2970635026,"text":"先物取引は常に波乱万丈だ…だが「千金料理」があれば、投資という船の舵をがっちり握っていられる！","nextNodeIds":[230030422,230030423]},{"nodeId":230030422,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3783836586,"text":"結局根拠はないんだ…","nextNodeIds":[230030424]},{"nodeId":230030424,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":852050770,"text":"おっと、話はあとだ。ほら！どんどん食え！今後も、どうかよろしく頼むぞ！","nextNodeIds":[230030425]},{"nodeId":230030425,"roleType":"TALK_ROLE_NPC","speakerId":4004,"speakerName":"ハティム","textMapHash":2086909442,"text":"シャワルマサンドは食ったか？スメールの郷土料理なんだ、食べとかないと損だぞ！ハハハッ…","nextNodeIds":[230030426]},{"nodeId":230030426,"roleType":"TALK_ROLE_BLACK_SCREEN","speakerId":null,"speakerName":"暗転","textMapHash":1151945754,"text":"ハティムに美味しいご飯をご馳走してもらった…","nextNodeIds":[]},{"nodeId":230030423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1813962418,"text":"どうにか安心したいだけでしょ…","nextNodeIds":[230030424]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2300304,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["1072","201072001,1"],"PAINLIBBL