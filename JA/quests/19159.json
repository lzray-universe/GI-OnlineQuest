EST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_POINT","LNHLPKELCAL":["C1915902_N10000005"],"NOCCOBOFKHP":1073,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[{"roleType":"TALK_ROLE_NPC","speakerId":12910,"speakerName":"アザム","textMapHash":3897766962,"text":"（あまり心配しなくてもいい…よな？）"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4035878082,"text":"「大工機」のことは知ってる？"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3622462978,"text":"四つの軌道の変移の状況について説明して。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1039907890,"text":"三つの軌道の変移に関する演算法則の応用状況を簡単に説明して。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":2499935746,"text":"今からノートを書くから、気になる質問があったら、書きながら答えるよ。マルチタスクは慣れてるから。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1782882530,"text":"あ、そうだ。ノートは渡すよう頼んだけど、あたしの存在は言わないでよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1092641594,"text":"どうして？"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":2165278714,"text":"うーん。簡単に言えば、あの子にはコンプレックスがあるから、もしもう一人の「レイラ」のほうが全部うまく処理できるって知ったら…"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1245793930,"text":"あの子は今までの努力が無意味だと思って、自暴自棄になっちゃうかもしれない。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":3701504634,"text":"タフな子だけど、いくら強くたって自分に苦しめられるのは耐えられないわ。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1062373978,"text":"あの子がだんだん弱っていったら、いずれあたしの存在もなくなっちゃう。そしたら、誰もあの子を助けられない。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2038089274,"text":"今の状態も、けしていいとは言えない。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1423695274,"text":"ちょっとずつだけど、よくなってきてるんじゃない？君も見てるでしょ、あの子の努力を。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":3837823330,"text":"あたしの知識はあの子から来たもの。そしてあたしが見せた能力は、あの子が十分に休んでて、内面も健康だったときの理想的な状態を象徴してるの。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":3522870458,"text":"教令院のような天才が集まる場所であっても、あの子はとても優秀だってあたしは思ってる。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1272628778,"text":"ただ、成長っていうのは少しずつするものだから、焦ってもしょうがない。あたしはいつだってあの子を信じて、サポートしていくつもりよ。"},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4255229618,"text":"#{M#君}{F#あなた}がいたからこそ、あの子はドン底に落ちなかった。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":2633268698,"text":"あはは、たとえドン底に落ちても、あの子は自虐しながら這い上がってくると思うよ。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":988014202,"text":"信じて。だってそういう子だから。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":1684687482,"text":"よし。指導教員が質問しそうな問題は全部書いた。次はあの子を褒めて励ます言葉を書くわ。"},{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","textMapHash":2518415162,"text":"もちろん、署名なしで。約束を忘れないでね。"}],"talkIds":[1915908],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":512,"speakerName":"レイラ","count":14},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":12910,"speakerName":"アザム","count":2}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4182453406,"CHECNJEMEFE":{"12910":[1120]},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":3015,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField"