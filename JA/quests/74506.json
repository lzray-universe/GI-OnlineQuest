450602","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7450602,"initDialog":745060201,"nextRandomTalks":[],"nextTalks":[],"npcId":[30423],"performCfg":"QuestDialogue/WQ/Fontaine_74506/Q7450602","priority":5,"questId":74506,"showRandomTalkCount":0},"dialogs":[{"nodeId":745060201,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":1868829818,"text":"写真をいっっっぱい撮って…サンプルをたっっっぷり集めて…モラをジャブジャブ稼ぎまくる！","nextNodeIds":[745060202]},{"nodeId":745060202,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":1143057346,"text":"あら！とんでもない大物が来ましたね！","nextNodeIds":[745060203]},{"nodeId":745060203,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3786069218,"text":"こんにちは！もしよろしければ、あなた方の写真を撮らせていただいてもよろしいでしょうか？","nextNodeIds":[745060204]},{"nodeId":745060204,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1729729042,"text":"えっ…オイラたちに言ってんのか？いま、オイラたちの写真を撮りたいって言ってたよな？","nextNodeIds":[745060205,745060206]},{"nodeId":745060205,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3811150722,"text":"写真くらいなら別にいいけど…","nextNodeIds":[745060207]},{"nodeId":745060207,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3804107322,"text":"へへっ…オイラたちの写真を撮りたがる人がいるなんて、オイラたちもすっかり有名人だな。","nextNodeIds":[745060208]},{"nodeId":745060208,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3137677770,"text":"言っとくけど、もしオイラたちの写真を個人使用以外で使うんだったら、フォンテーヌのスタイルに従ってちゃんと…ぎゃ、ぎゃる？ぎゃら？を支払ってもらうからな！","nextNodeIds":[745060209]},{"nodeId":745060209,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2687880426,"text":"もちろんです！お二人の写真を撮れることは私にとって光栄なことです。写真一枚で百五十万モラはどうでしょう、貴き最高の冒険者コンビさん？","nextNodeIds":[745060210]},{"nodeId":745060210,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1344364882,"text":"うんうん、そうこなくっちゃ！","nextNodeIds":[745060211]},{"nodeId":745060211,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1277208778,"text":"——って、ええ！？ちょっと待て、いくらだって？百五十万モラ？オイラの聞き間違いじゃないよな！？","nextNodeIds":[745060212]},{"nodeId":745060212,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":139607554,"text":"写真一枚で百五十万モラだなんて…ちょっと大げさじゃないか？オイラたちの肖像ってそんなに価値あんのかよ？","nextNodeIds":[745060213,745060214]},{"nodeId":745060213,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3995687754,"text":"さあさあ、いっぱい撮っていいよ！","nextNodeIds":[745060215]},{"nodeId":745060215,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2084023650,"text":"あははっ！百五十万モラくらい、なんてことありません！","nextNodeIds":[745060216]},{"nodeId":745060216,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3589084786,"text":"もし私と組む気があるなら、写真機でパシャパシャ撮影するだけで…九桁ものモラを稼ぐのだって朝飯前ですよ！","nextNodeIds":[745060217]},{"nodeId":745060217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":315745978,"text":"九桁だと…一、十、百、千…十万、百万、千万…お…こ、こここんなに稼げるのか！？","nextNodeIds":[745060218,745060219]},{"nodeId":745060218,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":674928714,"text":"でたらめな数字！","nextNodeIds":[745060220]},{"nodeId":745060220,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3622623130,"text":"そうだ！全部でっち上げだろ！いくらオイラでも信じないぞ！","nextNodeIds":[745060221]},{"nodeId":745060221,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":631445474,"text":"まさか、おまえ詐欺師とかじゃないだろうな？さては、オイラたちの名前で詐欺を働こうと企んでるんだろ？","nextNodeIds":[745060222]},{"nodeId":745060222,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2786681298,"text":"詐欺？はは、なんと、ばっちり計画の主旨を当てられましたね——","nextNodeIds":[745060223]},{"nodeId":745060223,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2782036754,"text":"しかし、その正反対ですよ。詐欺を働く悪党共を、テイワットから完全に駆逐することが目的です！そしたらあなたたちにたっぷりギャラを払えますよ！","nextNodeIds":[745060224]},{"nodeId":745060224,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":316192562,"text":"ちょ、ちょっと待て！オイラさっぱり話についてけないぞ…おまえは道端で写真を撮ってただけだろ。なのに、なんで犯罪撲滅みたいな話に繋がるんだ？","nextNodeIds":[745060225]},{"nodeId":745060225,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2604772354,"text":"その質問に答えるためには、人々がついつい見過ごしがちな、警備ロボによる「ターゲット認識」機能についてお話ししなければなりません。","nextNodeIds":[745060226]},{"nodeId":745060226,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2699822954,"text":"当たり前のことですが、警備ロボが犯罪行為を制圧するためには、まず相手が犯罪者かどうかを判断しなければなりませんよね？","nextNodeIds":[745060227]},{"nodeId":745060227,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":1243595210,"text":"善良な人を悪者だと誤解したり、あるいは武器を持った犯罪者を見逃したりしたら、大変な事態になるでしょう！","nextNodeIds":[745060228]},{"nodeId":745060228,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2750304130,"text":"例えば、漁師の手に握られている釣竿を長槍に見誤ったり、パイプに見せかけた武器に気付けなかったりしたらいけません！","nextNodeIds":[745060229]},{"nodeId":745060229,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1523451634,"text":"一理あるかもな…","nextNodeIds":[745060230]},{"nodeId":745060230,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3172917426,"text":"もし私が猫や犬、ヤマガラやハト、もしくはプクプク獣の被り物をして、遊園地のマスコットのような格好で現れたら…警備ロボはどう出るでしょうか？","nextNodeIds":[745060231,745060232]},{"nodeId":745060231,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1157285594,"text":"遊園地？","nextNodeIds":[745060233]},{"nodeId":745060233,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2676471226,"text":"そ、それは反則だぞ！","nextNodeIds":[745060234]},{"nodeId":745060234,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":228070730,"text":"うぅ、おまえが言った動物はどれも可愛いから、警備ロボは攻撃したりしないだろ！それに、そもそもプクプク獣が街に現れることなんてないだろうし…","nextNodeIds":[745060235]},{"nodeId":745060235,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3540088890,"text":"ピンポン！よくぞ答えてくれました！","nextNodeIds":[745060236]},{"nodeId":745060236,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2445240898,"text":"実際、街にいる警備ロボは、猫や犬、ヤマガラやハト、特にプクプク獣をターゲットにすることはありません。識別するとき、それらをスキップするのです。","nextNodeIds":[745060237]},{"nodeId":745060237,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3914756946,"text":"装置稼働効率の観点から、遭遇する可能性が極めて低い生物をターゲットリストから除くことは、確かに稼働効率の上昇に有効ですからね。","nextNodeIds":[745060238]},{"nodeId":745060238,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3737299290,"text":"以前『スチームバード新聞』にこんな記事が掲載されていました。「入念な観察で警備ロボの弱点に気づいた複数の犯罪者が、プクプク獣に変装し、窃盗を働いた…」","nextNodeIds":[745060239]},{"nodeId":745060239,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3767166138,"text":"「彼らを空気扱いした警備ロボは、その犯罪行為を阻止することは一切なかった。」","nextNodeIds":[745060240,745060241]},{"nodeId":745060240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3477640362,"text":"なんて狡猾な！","nextNodeIds":[745060242]},{"nodeId":745060242,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4053914690,"text":"プクプク獣に変装して泥棒しただって？しかも警備ロボはそれを見逃したのか？","nextNodeIds":[745060243]},{"nodeId":745060243,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1690019874,"text":"よく考えてみたらムカつくけど、なんか怖くもあるよな…もしそいつらがものを盗むだけじゃ満足しないで、もっと悪いことをしようとしたら…まずいだろ！","nextNodeIds":[745060244]},{"nodeId":745060244,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":213429834,"text":"ですので、これは画像認識を巡る戦いなのです。しかも、犯罪者たちの偽装技術が上達するにつれ、この戦いは激しさを増していき、やがて技術戦争へと変貌するでしょう！","nextNodeIds":[745060245]},{"nodeId":745060245,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":1152438626,"text":"フォンテーヌの治安のために、「画像認識学」エンジニアであるこの私が…一刻も早く力を発揮しなければなりません！","nextNodeIds":[745060246]},{"nodeId":745060246,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":3550834946,"text":"私は今、様々な画像サンプルを収集している最中です。大量のサンプルから、簡潔かつ高い効率と正確性を両立させた画像認識のロジックを導き出し、ロジックをプログラムした小型補助装置を製作する予定です——","nextNodeIds":[745060247]},{"nodeId":745060247,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":281015474,"text":"製作した小型補助装置をクロックワーク·マシナリーに組み込めば、偽装を見破り、犯罪行為を正確に判断できる能力が備わるようになります。","nextNodeIds":[745060248]},{"nodeId":745060248,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":4106265530,"text":"計画通りにいけば、理想的な治安効果を維持するために、パレ·メルモニアはすべての警備ロボをアップグレードするはず…とてつもないビジネスチャンスなのです！","nextNodeIds":[745060249,745060250]},{"nodeId":745060249,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":667802258,"text":"だから街で写真を撮ってたんだ？","nextNodeIds":[745060251]},{"nodeId":745060251,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2002757594,"text":"オイラ、ピンと来ちゃったぞ…普通おまえみたいな研究職はフィールドワークが苦手だから、せいぜい街中でサンプルを集めるだけだろ…","nextNodeIds":[745060252]},{"nodeId":745060252,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3078780226,"text":"オイラたちに協力を提案したのも、サンプルの数を増やすために、オイラたちを使い走りにして色んな写真を撮ってきてほしいから、じゃないのか？","nextNodeIds":[745060253]},{"nodeId":745060253,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":1580769058,"text":"コホンッ…その通りです！私のニーズを読み取る勘の鋭さ、流石は最高の冒険者コンビですね。","nextNodeIds":[745060254]},{"nodeId":745060254,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2883828762,"text":"さあ、私のプロジェクトに参加しませんか？「画像認識」のプロとして、共に犯罪者たちの手口を暴こうじゃありませんか！","nextNodeIds":[745060255]},{"nodeId":745060255,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":1331166474,"text":"あなたたちは私と一緒に「画像認識」の革新へと至る道筋を見つけ、フォンテーヌの技術の発展と治安のために貢献できるのです。富と名声を手に入れる絶好のチャンスですよ！","nextNodeIds":[745060256]},{"nodeId":745060256,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3905930914,"text":"うん…まぁ…聞いた感じだと、たしかに価値のある研究みたいだな…","nextNodeIds":[745060257]},{"nodeId":745060257,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1920706002,"text":"たとえモラの分け前を考えなくても、放ってはおけないぜ…悪事を働いたうえに、プクプク獣に濡れ衣まで着せる悪党を、これ以上増やしちゃいけないからな！","nextNodeIds":[745060258,745060259]},{"nodeId":745060258,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":47924058,"text":"放ってはおけない！","nextNodeIds":[745060260]},{"nodeId":745060260,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2873931666,"text":"その勢いです！パートナーシップの成立ですね！","nextNodeIds":[745060261]},{"nodeId":745060261,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":4266807570,"text":"では、この「画像認識サンプル収集機」の予備機をお渡しします。この中には私が特別に製作した記録装置と分析装置…それに自作のマニュアルが搭載されています。","nextNodeIds":[745060262]},{"nodeId":745060262,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":2841735578,"text":"事前に各地の資料を見比べたうえで、重要なサンプルの特徴を整理しマニュアルにまとめておきました。それに従って写真を撮ってきていただければ結構です！どうです、難しくないでしょう？","nextNodeIds":[745060263]},{"nodeId":745060263,"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","textMapHash":116362946,"text":"「画像認識」戦争の勝利と、大量発注の未来のために…力を合わせて頑張りましょう！","nextNodeIds":[]},{"nodeId":745060259,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1969763298,"text":"モラの分け前をもらえたら、なおよし！","nextNodeIds":[745060260]},{"nodeId":745060250,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3460047930,"text":"サンプルの数が足りない気がする…","nextNodeIds":[745060251]},{"nodeId":745060241,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1986759002,"text":"卑劣すぎる！","nextNodeIds":[745060242]},{"nodeId":745060232,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3083478754,"text":"被り物？","nextNodeIds":[745060233]},{"nodeId":745060219,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3377476706,"text":"そんなの絶対に嘘だ！","nextNodeIds":[745060220]},{"nodeId":745060214,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2373106106,"text":"なんか怪しい…","nextNodeIds":[745060215]},{"nodeId":745060206,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2265305474,"text":"個人使用以外で使うなら有料だよ…","nextNodeIds":[745060207]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7450602,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133401172"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["7450601","1"],"PAINLIBBLDK":"QUEST_EXEC_SET_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30423"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7450602],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30423,"speakerName":"レピーヌ·ポーリーン","c