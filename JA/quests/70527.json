alse,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7052702","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7052701,"initDialog":705270101,"nextRandomTalks":[],"nextTalks":[],"npcId":[30159,1419],"performCfg":"QuestDialogue/WQ/Mengde_70527/Q7052701","priority":5,"questId":70527,"showRandomTalkCount":0},"dialogs":[{"nodeId":705270101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4218013794,"text":"こんにちはー！どうしたんだ？なにか美味しいもんの話でもしてるのか？","nextNodeIds":[705270102,705270103]},{"nodeId":705270102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1473084714,"text":"こんにちは。サラ、ナザファリン。","nextNodeIds":[705270107]},{"nodeId":705270107,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"サラ","textMapHash":1740716674,"text":"またお会いしましたね、お二人とも。確かに食べ物に関する話をしていたのですが…はぁ…","nextNodeIds":[705270108]},{"nodeId":705270108,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2899869594,"text":"なにがあったんだ？言ってみろよ。オイラたちが手伝えることかもしれないぞ！","nextNodeIds":[705270109]},{"nodeId":705270109,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":608795674,"text":"#美味しいもんに関係することなら、オイラたち絶対に黙って見てるだけなんてことはしないからな！えへへ、そうだろ、{NICKNAME}？","nextNodeIds":[705270110,705270111]},{"nodeId":705270110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2521971282,"text":"そう、美味しいもののために！","nextNodeIds":[705270112]},{"nodeId":705270112,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":2990036226,"text":"ああ、クラクサナリデビ様よ。このお二人は、相変わらずとてもお優しいのですね。","nextNodeIds":[705270113]},{"nodeId":705270113,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":1475915690,"text":"前回、困っていたところをお二人に助けていただいた後、私はスメールに戻って、璃月の調味料市場に関する研究レポートをまとめました。","nextNodeIds":[705270114]},{"nodeId":705270114,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":133712314,"text":"ただ、それがまさか有名なサングマハベイ様のお眼鏡にかなうとは思ってもいませんでした。彼女は私が研究した調味料のレシピを買い取りたいと、そうおしゃってくださったのです。","nextNodeIds":[705270115]},{"nodeId":705270115,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":3184547954,"text":"あの心優しい大商人は、今後の研究にも出資してくれるとおっしゃってくれました！ああ、なんと幸運でしょう！私は迷うことなく、すぐそれに応じました。","nextNodeIds":[705270116]},{"nodeId":705270116,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":1080086042,"text":"そして、友人のパルヴァネにもこのことを手紙で伝えました。彼女も私の決断を応援してくれています。","nextNodeIds":[705270117]},{"nodeId":705270117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3564114922,"text":"つまり、今はモンドで調味料の研究をしてるってことか？","nextNodeIds":[705270118]},{"nodeId":705270118,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":1080580570,"text":"ええ、パイモン様は話の要点を掴むのが早いですね。本来なら、今ごろはもうモンドで調味料の研究を始めている予定だったのですが、ただ…","nextNodeIds":[705270119]},{"nodeId":705270119,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"サラ","textMapHash":2129142506,"text":"ナザファリンさんは、鹿狩りに協力してもらいたいそうです。こちらが出す料理にその秘密のレシピを入れて、お客さんに食べていただきたいと…","nextNodeIds":[705270120]},{"nodeId":705270120,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"サラ","textMapHash":1382775098,"text":"ですが鹿狩りには、レストランとしての基準があります。新たな調味料を入れてしまえば、多くの常連さんから苦情を言われてしまうでしょう…","nextNodeIds":[705270121]},{"nodeId":705270121,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"サラ","textMapHash":2801935426,"text":"はぁ…実はお二人がここに来るまで、私たちは何度も話し合いをしたのですが、特に良い案も出てこず…","nextNodeIds":[705270122]},{"nodeId":705270122,"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"サラ","textMapHash":3806745258,"text":"ジン団長なら、こういう複雑な問題を解決するのが得意そうなので、お願いしてみようかとも考えましたが…","nextNodeIds":[705270123]},{"nodeId":705270123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":20029578,"text":"待て待て！ジン団長は忙しいから、こんな些細なことで迷惑かけちゃダメだぞ！こういうのは、オイラたちに任せとけ！","nextNodeIds":[705270124]},{"nodeId":705270124,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":3925512770,"text":"ああ、以前も言いましたが、お二人はやはりこのナザファリンを救いに来た大英雄なのですね！","nextNodeIds":[705270125]},{"nodeId":705270125,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":3092262298,"text":"助かりました。それでは、さっそくこの鍋をお受け取りください。","nextNodeIds":[705270126]},{"nodeId":705270126,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":2548008154,"text":"前回と同じように調味料を作り、料理に加えた後、ご友人に試食してもらえればと思います。","nextNodeIds":[705270127]},{"nodeId":705270127,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2697237842,"text":"へへっ、じゃあ前と同じで、まずはこの最高の仲間であるオイラが試食してやるぜ。","nextNodeIds":[]},{"nodeId":705270111,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3483200154,"text":"まあ、パイモンのために。","nextNodeIds":[705270112]},{"nodeId":705270103,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2616321770,"text":"こんにちは。この人は…","nextNodeIds":[705270104]},{"nodeId":705270104,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":827580746,"text":"こんにちは。ああ、クラクサナリデビ様よ。この方々は、私のことを覚えていらっしゃらないのでしょうか？","nextNodeIds":[705270105]},{"nodeId":705270105,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":2134486642,"text":"私の存在など、まるで砂粒のように…風に吹き飛ばされてしまったと…","nextNodeIds":[705270106]},{"nodeId":705270106,"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","textMapHash":1087573602,"text":"ですが、私は覚えております。以前、お二人に璃月で調味料作りを手伝っていただいたこと、それから皆さんに試食をしていただいたご恩を！","nextNodeIds":[705270107]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7052701,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30159"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7052701],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":30159,"speakerName":"ナザファリン","count":12},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":6},{"roleType":"TALK_ROLE_NPC","speakerId":1419,"speakerName":"サラ","count":5},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":4}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[170527],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":2954578566,"CHECNJEMEFE":{"30159":[1170]},"CJPLOBIFHLG":"MAINQUEST_TAG_GUIDE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP":[{"<DLGBBMLABOA>k__BackingField":0,"ABDCADBLCFC":0,"AIMIPKGBAHC":"QuestDialogue/WQ/Mengde_70527/Q7052701","ANDJNFLIDIJ":"PLAY_MODE_SINGLE","AOLKCANJCMJ":