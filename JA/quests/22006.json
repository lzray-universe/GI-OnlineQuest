iorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["2200606","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_LOCAL","id":2200607,"initDialog":220060701,"nextRandomTalks":[],"nextTalks":[],"npcId":[2211],"performCfg":"","priority":3,"questId":22006,"showRandomTalkCount":0},"dialogs":[{"nodeId":220060701,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"ソラヤー","textMapHash":1225904605,"text":"玉盤が壊れてなくてよかった。","nextNodeIds":[220060702,220060706]},{"nodeId":220060702,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":98132829,"text":"襲われた時、どうして渡さなかったの？","nextNodeIds":[220060703]},{"nodeId":220060703,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"ソラヤー","textMapHash":895928653,"text":"文物はね、学者の研究、芸術家の参考、そして展示品としての使い道があるんだけど…","nextNodeIds":[220060704]},{"nodeId":220060704,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"ソラヤー","textMapHash":373824117,"text":"泥棒に売られることは絶対にダメ、それは文物を侮辱するだけでなく、歴史を踏みにじることと同じだよ。","nextNodeIds":[220060705]},{"nodeId":220060705,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"ソラヤー","textMapHash":2399331829,"text":"文物を侮辱し、歴史を踏みにじるのを私は絶対に許さない。","nextNodeIds":[]},{"nodeId":220060706,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2890348717,"text":"この玉盤…","nextNodeIds":[220060707]},{"nodeId":220060707,"roleType":"TALK_ROLE_NPC","speakerId":2211,"speakerName":"ソラヤー","textMapHash":336395845,"text":"ん？君もこの玉盤に興味があるの？興味があるのはその価値？それとも値段？","nextNodeIds"