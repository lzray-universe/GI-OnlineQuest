8,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":762464410,"text":"あれは一体…","nextNodeIds":[710500809]},{"nodeId":710500809,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":288282354,"text":"簡単な話なんだが、どう説明すればいいのかな。そうだな、そのヴィシャップ·岩に何か特別なところはなかったかい…","nextNodeIds":[710500810]},{"nodeId":710500810,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":396672962,"text":"例えば、元素付着の属性が水だった、とか？","nextNodeIds":[710500811,710500813]},{"nodeId":710500811,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3755920482,"text":"そうだったかも…","nextNodeIds":[710500812]},{"nodeId":710500812,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":2046998418,"text":"読みが当たったな。","nextNodeIds":[710500816]},{"nodeId":710500816,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":1672362970,"text":"あのヴィシャップ·岩は水元素を操ることができるはずだ。","nextNodeIds":[710500817]},{"nodeId":710500817,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":1726227706,"text":"層岩巨淵の地下水は水元素の含有量が高いから、特に密集している場所には君が釣り上げた水草のようなものが生まれる。","nextNodeIds":[710500818]},{"nodeId":710500818,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3112249098,"text":"ヴィシャップ·岩も、もちろん水に親しむ生物であれば層岩巨淵に生きている他のやつらも同じだ——水元素を多く含むこの水草を食べることで、自分の力を上げている。","nextNodeIds":[710500819]},{"nodeId":710500819,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":2942797362,"text":"だから、あれの正体は…水元素を多く含む水草だ！","nextNodeIds":[710500820]},{"nodeId":710500820,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2360686762,"text":"ただの水草か…","nextNodeIds":[710500821]},{"nodeId":710500821,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3992708986,"text":"うん、水草なんだ。でも元素の含有量がそんなに高い水草と言うのは…","nextNodeIds":[710500822]},{"nodeId":710500822,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3542048882,"text":"純粋で巨大なエネルギーが水源に影響を及ぼさない限り、普通の環境では生えることはまずない…何より、これらの水草は…","nextNodeIds":[710500823]},{"nodeId":710500823,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":1827978650,"text":"いつか意識を芽生えさせて元素生物になるかもしれない。研究する価値はあるね。","nextNodeIds":[]},{"nodeId":710500813,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1227017770,"text":"見なかった…","nextNodeIds":[710500814]},{"nodeId":710500814,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":963536522,"text":"#まさか解決するスピードが速すぎて気付かなかったのか…すごいね、さすが伝説の{NICKNAME}だ。","nextNodeIds":[710500815]},{"nodeId":710500815,"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","textMapHash":3628371882,"text":"でも俺の推測が正しければ…","nextNodeIds":[710500816]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7105008,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_UI","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["2618"],"NOCCOBOFKHP":6,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7105005,7105008],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":2618,"speakerName":"ヘディーヴ","count":26},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":8}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[171051],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":4093805998,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],