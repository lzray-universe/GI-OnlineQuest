lse,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406802","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406802,"initDialog":740680201,"nextRandomTalks":[],"nextTalks":[],"npcId":[5222,5221],"performCfg":"QuestDialogue/Q7406802","priority":5,"questId":74068,"showRandomTalkCount":0},"dialogs":[{"nodeId":740680201,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1079441194,"text":"えっと…ここの最後のセリフなんだけど、「それがまさか、敵の淀んだ両目に映っているのが、復讐に歪んだ私自身の顔だなんて…」","nextNodeIds":[740680202]},{"nodeId":740680202,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3700068594,"text":"いやいや、ここで急にこれまでの復讐を後悔するなんておかしいでしょ。それにここまで共犯者たちをきっぱり片付けてたのに、主謀者に対しては急に同情するなんて…","nextNodeIds":[740680203]},{"nodeId":740680203,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3734412906,"text":"こ、これにはちゃんと伏線があるんだ。ほら、実は毎回復讐が終わるたびに、彼女は敵の惨状を目の当たりにしては、少しずつ動揺してる。","nextNodeIds":[740680204]},{"nodeId":740680204,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":2665781930,"text":"何しろ、復讐のために人生を賭けるなんて、決していいことじゃないからね…","nextNodeIds":[740680205]},{"nodeId":740680205,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":788403130,"text":"ダメよ、こんなオチじゃ納得できないわ。この展開じゃ、きっと指をさされて鼻で笑われるわよ…","nextNodeIds":[740680206]},{"nodeId":740680206,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":2370182178,"text":"自分の好みで判断しないでくれ。","nextNodeIds":[740680207]},{"nodeId":740680207,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3152317874,"text":"はぁ、またそう言って…あなたこそ、上から目線で観客を「説教」しようなんて考えないで。あっ、そこにちょうど観客がいるじゃない。","nextNodeIds":[740680208]},{"nodeId":740680208,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1002106386,"text":"そこの金髪のあなた、お名前は？","nextNodeIds":[740680209]},{"nodeId":740680209,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2440677506,"text":"#{NICKNAME}。","nextNodeIds":[740680210]},{"nodeId":740680210,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":4179159578,"text":"こんにちは、そこに座ってるということは、きっと劇を見るのが好きなんでしょ？よかった。まずは自己紹介するわね、私はメイヤー。","nextNodeIds":[740680211]},{"nodeId":740680211,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":4249293826,"text":"で、こちらはフォルモン。","nextNodeIds":[740680212]},{"nodeId":740680212,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":4174073986,"text":"どうも…","nextNodeIds":[740680213]},{"nodeId":740680213,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1226759186,"text":"私たちはかの有名な——","nextNodeIds":[740680214]},{"nodeId":740680214,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":2316745930,"text":"？","nextNodeIds":[740680215]},{"nodeId":740680215,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":124756514,"text":"もう、ここは合わせる場面でしょ。私たちはかの有名な「劇団三枚券」！","nextNodeIds":[740680216]},{"nodeId":740680216,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":2090247450,"text":"わ、分かったよ。ご覧の通り、俺たちはかの有名な「劇団三枚券」だ…","nextNodeIds":[740680217]},{"nodeId":740680217,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":549207314,"text":"ふふっ、まぁ実は全然有名じゃないんだけどね。常駐劇団員も私たち二人だけなの。","nextNodeIds":[740680218]},{"nodeId":740680218,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":136739130,"text":"だったら、最初っからそう自己紹介すればいいでしょ。それに、ロシェル拡声器で俺が「著名な演出家」って宣伝したのも、俺は許可してなかったんだけど…","nextNodeIds":[740680219]},{"nodeId":740680219,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":340913858,"text":"ただの宣伝の手段でしょ。それに、フォルモンならいつかきっと、著名な演出家になるって信じてるから。","nextNodeIds":[740680220]},{"nodeId":740680220,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":1810815402,"text":"はぁ、やめてくれ。俺は趣味で演出をやってるだけなんだから…","nextNodeIds":[740680221]},{"nodeId":740680221,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":2699916202,"text":"フォルモンは才能があるのよ。もしかしたら、いつかエピクレシス歌劇場の舞台に上がれるかもしれないわ。","nextNodeIds":[740680222]},{"nodeId":740680222,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":29977778,"text":"ははっ、そう褒めるなって…いや、それならもう上がっただろう！あそこで審判を受けたから、ここにいるんだし！","nextNodeIds":[740680223]},{"nodeId":740680223,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3624407434,"text":"#うっ…それもそうね。とにかく、{NICKNAME}、私たちは『モンテ·メア女伯』という劇のリハーサルをしてるの。そのオチについて、他の人の意見が聞きたくって。","nextNodeIds":[740680224,740680226]},{"nodeId":740680224,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4019459666,"text":"劇のことはよく分からない…","nextNodeIds":[740680225]},{"nodeId":740680225,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3943036410,"text":"いいのよ。むしろ、劇は本来みんなに観てもらうためのものなんだから、良ければ良いと、つまらなければつまらないと言ってちょうだい。理論が分からないと意見を出しちゃダメなんて決まりないんだから。","nextNodeIds":[740680228]},{"nodeId":740680228,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3706007754,"text":"#さあ、フォルモン、私たちの劇を{NICKNAME}に観てもらいましょ！","nextNodeIds":[740680229]},{"nodeId":740680229,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":1994900226,"text":"コホンッ…じゃあ、始めよっか。「人は言う、諸悪を治せる薬は二つしかない、一つは時間、もう一つは沈黙だと…」","nextNodeIds":[740680230]},{"nodeId":740680230,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2407627426,"text":"「人は言う、諸悪を治せる薬は二つしかない、一つは時間、もう一つは沈黙だと…」\\n物語は「モンテ·メア」という流刑地から始まる。\\nジュリエットという女性は、許婚を残忍な姿で殺害され、自分も罠に陥り追放された。\\nだが、燃え盛る憎しみの炎を胸に抱く彼女は、時間と沈黙に屈しなかった。\\nいつの日か、彼女はこの地から脱出し、仇敵たちにその代償を払わせるのだ…！","nextNodeIds":[740680231]},{"nodeId":740680231,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":3097421226,"text":"不思議な巡り合わせで、彼女は「モンテ·メア」を抜け出し、山の中の宝物まで手に入れた。\\n彼女は、次々と過去の仇を討った。\\nしかし復讐の快感へと溺れるにつれ、だんだんと優しい心を失っていってしまう。\\n過去の仇敵の惨状を目にした彼女は、果たしてそれに気づくのだろうか？\\nもしかすると…最後の瞬間、暗殺の刃がターゲットから逸れたのは、それが理由なのかもしれない…","nextNodeIds":[740680232]},{"nodeId":740680232,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3066281394,"text":"ジュリエット…どうして君が——ジュリエット？","nextNodeIds":[740680233]},{"nodeId":740680233,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1143439850,"text":"ええ。そうよ、私。驚いた？私の許婚を手に掛けて、私を「モンテ·メア」に追放したあの時、こんなことになるとは思ってもなかったでしょう！","nextNodeIds":[740680234]},{"nodeId":740680234,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":476535322,"text":"なっ…こ、この悪女めッ！思い出した。思い出したよ…","nextNodeIds":[740680235]},{"nodeId":740680235,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":1676685562,"text":"二週間前の法廷で、君は「1ポンドの肉が元金で、血と余った肉が利子だ」と言って、アントニオを死なせた！","nextNodeIds":[740680236]},{"nodeId":740680236,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":1561202434,"text":"彼は真っ青になり法廷で倒れ、周りの人はその心臓が止まるのを見ているしかなかった。","nextNodeIds":[740680237]},{"nodeId":740680237,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3366204554,"text":"…ふん、偽証した男も、数年前に犯した罪も、その利子をようやく、この私が取り返すの。このような結末を辿るのだって、まさに自業自得！","nextNodeIds":[740680238]},{"nodeId":740680238,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":4181224442,"text":"主演のラウールも、どうしてか劇場のシャンデリアが落下して押しつぶされた…","nextNodeIds":[740680239]},{"nodeId":740680239,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3785404338,"text":"彼が甘い言葉で騙していなければ、私と許婚もあなたたちの罠にはまることはなかったでしょうね？","nextNodeIds":[740680240]},{"nodeId":740680240,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":715238994,"text":"つまり…君が僕に近づいたのも、真夜中にナイフが飛び出るよう、僕の機械式置き時計を改造して命を奪うためだったのか！","nextNodeIds":[740680241]},{"nodeId":740680241,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":2170201698,"text":"その通りよ。","nextNodeIds":[740680242]},{"nodeId":740680242,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3407560210,"text":"ジュリエット、どうか許してくれ…アントニオの死後、彼の妻が後追い自殺をしたのを知ってるか。残された幼子二人が泣き叫ぶのを、きっと君は見ていないのだろう…","nextNodeIds":[740680243]},{"nodeId":740680243,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3610192338,"text":"君は、本当にそんな光景を見たいと？ラウールのことを思い出してみてくれ。粉々になった遺骨をかき集める彼の母親は、白髪になり、やつれ、悲しみに暮れていた。","nextNodeIds":[740680244]},{"nodeId":740680244,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":1071033354,"text":"この身の罪が深いことは重々承知している。しかし、僕たちが君の許嫁を殺したのは、彼が僕たちの兄弟を殺したからだ…","nextNodeIds":[740680245]},{"nodeId":740680245,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":203259154,"text":"そんなの嘘よ！全部嘘に決まっているわ！","nextNodeIds":[740680246]},{"nodeId":740680246,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":4088388562,"text":"信じるかどうかは君次第だ。ああ、ジュリエット。罪の鎖は僕たちを、如何に険しくそびえ立つ運命の柱に縛り付けたのだろうか！","nextNodeIds":[740680247]},{"nodeId":740680247,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":1478713970,"text":"もし復讐で君が解放されるのなら、そのナイフを僕の胸に突き刺すといい！だが、僕が保証しよう——復讐しても楽になることはない…ただ虚しい苦しみに陥るだけだと。","nextNodeIds":[740680248]},{"nodeId":740680248,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3870542138,"text":"この哀れな僕を見てくれ。僕は誰よりもそれを理解している…","nextNodeIds":[740680249]},{"nodeId":740680249,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3049158858,"text":"そんな…一日中、酒に溺れて苦しむこの男が、私の決意を揺るがすの…？復讐さえすれば、解放されると思っていたのに…","nextNodeIds":[740680250]},{"nodeId":740680250,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":774788218,"text":"それがまさか、敵の淀んだ両目に映っているのが、復讐に歪んだ私自身の顔だなんて…","nextNodeIds":[]},{"nodeId":740680226,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":895489810,"text":"他はともかく、意見ならたくさんある。","nextNodeIds":[740680227]},{"nodeId":740680227,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1600771746,"text":"そ、そう。でも、しょっちゅう意見を出してる人もちょっと…まあ、大丈夫。今は意見が必要だから、いくらでも歓迎よ。","nextNodeIds":[740680228]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406802,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}},{"subQuestId":7406803,"order":3,"stepDescription":"メイヤーと会話する","stepDescTextMapHash":2776257092,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5222"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7406803],"talks":[{"talkId":7406803,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7406803","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406803,"initDialog":740680301,"nextRandomTalks":[],"nextTalks":[],"npcId":[5222,5221],"performCfg":"QuestDialogue/Q7406803","priority":5,"questId":74068,"showRandomTalkCount":0},"dialogs":[{"nodeId":740680301,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1107296394,"text":"#さっ、{NICKNAME}、ここよ…ここがまさに検討しなきゃいけないところなの。","nextNodeIds":[740680302]},{"nodeId":740680302,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1902409634,"text":"ここからの展開には、二つの方向性があるわ。一つは、ヒロインのジュリエットが復讐を諦めて、手に入れた宝物を持って世界中を旅し、楽しく暮らすというもの。","nextNodeIds":[740680303]},{"nodeId":740680303,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":2030690258,"text":"もう一つは、ジュリエットは復讐を果たしたけど、やっぱり虚しさを覚え、全財産を寄付した後、許婚と出会った場所で孤独死するというもの。","nextNodeIds":[740680304]},{"nodeId":740680304,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1136286674,"text":"どう、観客としてはどっちの結末のほうがいいかしら？","nextNodeIds":[740680305,740680312]},{"nodeId":740680305,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2966571554,"text":"復讐を諦めるのもある種の解放…","nextNodeIds":[740680306]},{"nodeId":740680306,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3469999434,"text":"えっ、本当に？","nextNodeIds":[740680307]},{"nodeId":740680307,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":37035578,"text":"ほら、言っただろ。観客は分かってくれるって。目の前にジェロームっていう、復讐に成功したけど不幸な例がいるんだから。","nextNodeIds":[740680308]},{"nodeId":740680308,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":261281674,"text":"「仇さえ討てれば、自分は幸せになれる」っていう考えは、本人にとっちゃ間違いじゃない。でも幸せは作り出すものであって、復讐という破滅へと導く方法では手に入らないんだよ。","nextNodeIds":[740680309]},{"nodeId":740680309,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":419654378,"text":"復讐で幸せは得られない。得られるのは罪に溺れる快感だけ。その快感が消えて、道を見失ってしまえば…人は虚しくなる。","nextNodeIds":[740680310]},{"nodeId":740680310,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3326304218,"text":"復讐すると同時に、復讐以外の救いの道も探さないといけない。これってさ、とても重要なことだと思うんだ！","nextNodeIds":[740680311]},{"nodeId":740680311,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1766563890,"text":"うーん…確かに一理あるわ。ちょっと悔しいけど。","nextNodeIds":[740680318]},{"nodeId":740680318,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3151137218,"text":"#ふぅ…ありがとう、{NICKNAME}。あなたの意見はとても貴重なものだったわ！","nextNodeIds":[740680319]},{"nodeId":740680319,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3966508098,"text":"うん…確かにこうして検討してみると、最後のオチもまだブラッシュアップする余地がありそうだね。うまく表現できればいいけど…","nextNodeIds":[740680320]},{"nodeId":740680320,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3695707530,"text":"#ふふっ、正式な公演が決まったら、{NICKNAME}もぜひ観に来てね。きっとあなたの想像を超える結末になると思うから！","nextNodeIds":[740680321,740680322]},{"nodeId":740680321,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2279950242,"text":"ほ、本当に…？","nextNodeIds":[740680323]},{"nodeId":740680323,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":2045161610,"text":"うふふ…まだブラッシュアップの途中だから、どうなるかは分からないけどね…","nextNodeIds":[740680324]},{"nodeId":740680324,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":531913418,"text":"#じゃあ、わざわざ{NICKNAME}にそう言わなくてもいいでしょ…","nextNodeIds":[740680325]},{"nodeId":740680325,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":3949068674,"text":"#これも一種の宣伝よ。そうそう、{NICKNAME}、意見をくれたお礼にこれをあげるわ。また遊びに来てね。","nextNodeIds":[]},{"nodeId":740680322,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1322212466,"text":"いい意味で想像を超えてくれるのかな…","nextNodeIds":[740680323]},{"nodeId":740680312,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4173909642,"text":"もちろん復讐を果たす！","nextNodeIds":[740680313]},{"nodeId":740680313,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":1334084218,"text":"#ほらほら、{NICKNAME}も私と同じ考えなのよ。","nextNodeIds":[740680314]},{"nodeId":740680314,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":939031898,"text":"物語全体を通して、ジェロームこそが復讐の「カギ」になってるの。もしその復讐を果たせなかったら、「カギ」としての役割を果たせず、物足りない感じになってしまうわ。","nextNodeIds":[740680315]},{"nodeId":740680315,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3005892730,"text":"うーん…","nextNodeIds":[740680316]},{"nodeId":740680316,"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","textMapHash":808476618,"text":"「仇敵の現状から復讐した後の苦しみや虚しさを想像させる」のと、「復讐を果たした後に訪れる苦しみや虚しさを感じさせる」のとでは、観客への説得力が違うでしょ？","nextNodeIds":[740680317]},{"nodeId":740680317,"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","textMapHash":3386511666,"text":"それもそうか…","nextNodeIds":[740680318]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406803,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133408159","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"},{"LNHLPKELCAL":["74025","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5222"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7406802,7406803],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5222,"speakerName":"メイヤー","count":36},{"roleType":"TALK_ROLE_NPC","speakerId":5221,"speakerName":"フォルモン","count":30},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":7},{"roleType":"TALK_ROLE_NEED_CLICK_BLAC