":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7280305,"initDialog":728030501,"nextRandomTalks":[],"nextTalks":[],"npcId":[3001],"performCfg":"QuestDialogue/WQ/Daoqi_72803/Q7280305","priority":5,"questId":72803,"showRandomTalkCount":0},"dialogs":[{"nodeId":728030501,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":1582466466,"text":"翔太？浮かない顔してるわね、誰かにいじめられたの？","nextNodeIds":[728030502]},{"nodeId":728030502,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":691080458,"text":"七月姉さん、城内のみんなが祠に供え物を捧げて、神様にお祈りをしてることは知ってるよね？","nextNodeIds":[728030503]},{"nodeId":728030503,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":820951882,"text":"心を込めて祠に供え物を捧げれば、神様も応えてくれて、願いが叶う…そうだよね？","nextNodeIds":[728030504]},{"nodeId":728030504,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":2331955162,"text":"あら？どうしていきなりそんなことを…何かあったの？","nextNodeIds":[728030505]},{"nodeId":728030505,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1128104210,"text":"事の経緯はこう…","nextNodeIds":[728030507]},{"nodeId":728030507,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":2668338170,"text":"まったく…そんな考えを持ってたから、あんなに積極的に供え物を捧げてたのね…","nextNodeIds":[728030508]},{"nodeId":728030508,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":2626643698,"text":"うん！誠心誠意、神様に供え物を捧げてたんだけど、供え物が誰かに取られちゃって…。これじゃ、神様もきっと僕を責めて、もう守ってくれないよ…","nextNodeIds":[728030509]},{"nodeId":728030509,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":3878019986,"text":"もう…安心して、神様はそんなことくらいで怒らないわ。","nextNodeIds":[728030510]},{"nodeId":728030510,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":1164484642,"text":"そ、そうなの？ならよかった…","nextNodeIds":[728030511]},{"nodeId":728030511,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":510957186,"text":"でも同様に、神様は供え物で誰かを守ったりしない。","nextNodeIds":[728030512]},{"nodeId":728030512,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":1464613714,"text":"えっ？","nextNodeIds":[728030513]},{"nodeId":728030513,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":295324002,"text":"みんなが供え物を捧げたり、神様のご加護を祈ったりするのは、自分の願いを叶えてほしいからじゃなくて、「自信」を持つためなの。","nextNodeIds":[728030514]},{"nodeId":728030514,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":883445986,"text":"自信？","nextNodeIds":[728030515]},{"nodeId":728030515,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":80314674,"text":"「神様の前で言ったからには、頑張ってやり遂げないといけない。」","nextNodeIds":[728030516]},{"nodeId":728030516,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":1195943010,"text":"「神様のご加護があれば、努力は必ず報われる。」","nextNodeIds":[728030517]},{"nodeId":728030517,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":437018642,"text":"そういう「自信」を持つことで、自分の願いに向かって全力で進むことができるの。それが、みんなが祠にお祈りをしに行く理由よ。","nextNodeIds":[728030518]},{"nodeId":728030518,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":1959604546,"text":"だって…結局は人々の努力によって決まるの。もし神様に祈ってばかりで、自分で行動しなかったら、神様が助けたいと思ってもできないでしょ。","nextNodeIds":[728030519]},{"nodeId":728030519,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":3736128474,"text":"で、でも！この前祠に供え物を捧げたら、神様が助けてくれたんだ！","nextNodeIds":[728030520]},{"nodeId":728030520,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":415491434,"text":"あの火災とか、強くなりたいおじさんとか、僕の漫画とか…","nextNodeIds":[728030521,728030522]},{"nodeId":728030521,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2067924978,"text":"（まだ神様のこと…）","nextNodeIds":[728030523]},{"nodeId":728030523,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":3924647562,"text":"ええ…確かに。どうやらこの神様は願いを直接叶えてくれるみたいね…","nextNodeIds":[728030524]},{"nodeId":728030524,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":2526509426,"text":"でも、今回は試験もなくなってなかったし、僕をいじめる彼女もいなくなってなかった。毎日僕に勉強しろってしつこく言ってくる…","nextNodeIds":[728030525]},{"nodeId":728030525,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":3626583898,"text":"うーん、ちょっと待って。その「いじめ」をする人って、名前は何？いつ現れたの？","nextNodeIds":[728030526]},{"nodeId":728030526,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":74791786,"text":"彼女の…名前は…えっと…なんだっけ？えっと…","nextNodeIds":[728030527]},{"nodeId":728030527,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":3810620810,"text":"一緒に入学して…いや違う、僕よりも先に…いや後だったっけ？","nextNodeIds":[728030528]},{"nodeId":728030528,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":1504416162,"text":"おかしいな…なんか、思い出せない。分かるのは毎日僕に勉強しろって言う女の子が一人いるってことだけ…","nextNodeIds":[728030529]},{"nodeId":728030529,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":3036907490,"text":"うん、どうやら、神様は今回も願いを聞いて、試験の手伝いをしてるのね。","nextNodeIds":[728030530]},{"nodeId":728030530,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":1117630618,"text":"そ、それって、僕に勉強をさせるために神様が手配した人ってこと！？","nextNodeIds":[728030531]},{"nodeId":728030531,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":3309721082,"text":"い、いやだ！勉強したくないし、試験もやりたくない！","nextNodeIds":[728030532]},{"nodeId":728030532,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":2275128826,"text":"うわっ！あいつが来た！あそこ、あそこから来てる！","nextNodeIds":[728030533,728030534]},{"nodeId":728030533,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3491386546,"text":"どこ？","nextNodeIds":[728030535]},{"nodeId":728030535,"roleType":"TALK_ROLE_NPC","speakerId":3045,"speakerName":"翔太","textMapHash":2007679994,"text":"#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、彼女が見えないの！？手に試験用紙をたくさん持ってる！うわぁ！やめて！","nextNodeIds":[728030536]},{"nodeId":728030536,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":1699147282,"text":"どうやら、この神様はけっこう熱心なのね。","nextNodeIds":[728030537,728030538]},{"nodeId":728030537,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3769449162,"text":"この神様は気ままなんだね…","nextNodeIds":[728030539]},{"nodeId":728030539,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":4113558986,"text":"でも、神様が勉強を見てくれるなら、あの子も順調に試験を通過できるでしょ。","nextNodeIds":[728030540]},{"nodeId":728030540,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":1238382106,"text":"あの子がいつも祠の前で祈ってるから、神様もうんざりしたのね…","nextNodeIds":[728030541]},{"nodeId":728030541,"roleType":"TALK_ROLE_NPC","speakerId":3001,"speakerName":"弥生七月","textMapHash":2392190722,"text":"あれ、ちょっと待って。この道に葉っぱなんて、さっきまでなかったはず…","nextNodeIds":[]},{"nodeId":728030538,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":281997474,"text":"神様がやるようなことじゃないと思う…","nextNodeIds":[728030539]},{"nodeId":728030534,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3299983458,"text":"全然見えない。","nextNodeIds":[728030535]},{"nodeId":728030522,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1650540410,"text":"（全然分かってくれない…）","nextNodeIds":[728030523]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7280305,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["133220075","1"],"PAINLIBBLDK":"QUEST_EXE