"],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7608203,"initDialog":760820301,"nextRandomTalks":[],"nextTalks":[],"npcId":[21903],"performCfg":"","priority":5,"questId":76082,"showRandomTalkCount":0},"dialogs":[{"nodeId":760820301,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1040221346,"text":"ホラガイ団について…","nextNodeIds":[760820302]},{"nodeId":760820302,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":2586634,"text":"#えっ？ホラガイ団のことが知りたいの？ま、{M#お兄さん}{F#お姉さん}はもう仲間みたいなもんだし、教えてあげてもいいよ。","nextNodeIds":[760820303]},{"nodeId":760820303,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":3193481882,"text":"#アタシたちは…そうだな、同じ道を歩む同年代の「助け合いの会」とでもいうべきかな。年齢で言うと、実は{M#お兄さん}{F#お姉さん}は入会資格ないんだけどね…","nextNodeIds":[760820304]},{"nodeId":760820304,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":3048188290,"text":"でも、ナシャタウンで助けが必要になったら、いつでも言って！アタシにできることなら力になるよ！","nextNodeIds":[]}]},{"talkId":7608204,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7601120","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NOT","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7608204,"initDialog":760820401,"nextRandomTalks":[],"nextTalks":[7608205,7608206],"npcId":[21903],"performCfg":"","priority":5,"questId":76082,"showRandomTalkCount":0},"dialogs":[{"nodeId":760820401,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2529546130,"text":"さっきのおかしな人について…","nextNodeIds":[760820402]},{"nodeId":760820402,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":724074466,"text":"ああ、あの紫色の祭司のこと？手を出してこないってことは、少なくとも今は敵じゃない。できるだけ関わらないようにしよう。","nextNodeIds":[760820403]},{"nodeId":760820403,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":3112428138,"text":"好奇心は命取りになる。カーチャ姉さんも、霜月の変人たちにはできるだけ近づかないようにって言ってたし。アタシみたいな大怪盗でさえ、あいつらに捕まって月神の生贄にされるとこだったんだからね。","nextNodeIds":[760820404]},{"nodeId":760820404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1092618482,"text":"生贄！？","nextNodeIds":[760820405]},{"nodeId":760820405,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":2503071618,"text":"そうだよ。あいつら本当にイカれてて、いろんな人の血を…うーん、思い出しただけでゾッとする。この話はやめよう。","nextNodeIds":[760820406]},{"nodeId":760820406,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":787515138,"text":"アタシを捕まえたのが右も左も分からない小娘でよかったよ。いくつかお話を聞かせてあげたら解放してくれたんだ。でなきゃ今ごろ…","nextNodeIds":[760820407]},{"nodeId":760820407,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":526494858,"text":"#べ、別にそこまで怖がってないんだからね。大怪盗が怖がりじゃ、やっていけないでしょ。ただ、あいつらにはなるべく関わらないほうがいいって、{M#お兄さん}{F#お姉さん}に忠告してるだけ。","nextNodeIds":[760820408]},{"nodeId":760820408,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":1142797082,"text":"あっ、そうだ、情報源について伝えるの忘れるところだった。霜月の子の件に関してはヒディンバお姉さんから聞いたんだ。","nextNodeIds":[760820409]},{"nodeId":760820409,"roleType":"TALK_ROLE_NPC","speakerId":21903,"speakerName":"マイテ","textMapHash":3288184602,"text":"ヒディンバお姉さんに用があるなら…まだナシャタウンの近くにいるはずだから、ちょっと聞けば、すぐに見つかると思うよ。","nextNodeIds":[]}]},{"talkId":7608205,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":true,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_HOST","beginCond":[{"param":["7601901","1","","",""],"type":"QUEST_COND_QUEST_GLOBAL_VAR_EQUAL"},{"param":