"","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7406704,"initDialog":740670401,"nextRandomTalks":[],"nextTalks":[],"npcId":[5252],"performCfg":"QuestDialogue/Q7406704","priority":5,"questId":74067,"showRandomTalkCount":0},"dialogs":[{"nodeId":740670401,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2114314370,"text":"おっ、また会ったな。実は自分と賭けをしてたんだ——ここに来てくれるのが、君たちか他の人かってな。","nextNodeIds":[740670402,740670404]},{"nodeId":740670402,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1504004858,"text":"勝ったの、負けたの？","nextNodeIds":[740670403]},{"nodeId":740670403,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":4089711394,"text":"ははっ、勝つにせよ負けるにせよ、どっちも私さ。","nextNodeIds":[740670406]},{"nodeId":740670406,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2606339818,"text":"なんで拡声器であんなことしたんだよ？ガルヴァーヤに捕まったら、マズいんじゃないか？おまえ、あいつのことが怖いんだろ？","nextNodeIds":[740670407]},{"nodeId":740670407,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2604240770,"text":"怖いだって？そんなわけないだろう。ただ捕まったら面倒ってだけさ。それに彼女はほとんど管理エリアにいる。特別な理由がない限り、生産エリアのトラブルには首を突っ込まないはずだ。","nextNodeIds":[740670408]},{"nodeId":740670408,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":3690722714,"text":"それから、どうして拡声器であんなことをしたのかというと——ここでの暮らしがあまりにも退屈だからさ。","nextNodeIds":[740670409]},{"nodeId":740670409,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2032459210,"text":"今ならテイヤールの気持ちが分かるよ。彼もきっと生活があまりに退屈だったから、ああやってしょっちゅう楽しみを探してたんだろうな。言ってみれば、私は彼の真似をしてるだけに過ぎない。","nextNodeIds":[740670410]},{"nodeId":740670410,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":1196512970,"text":"君たちにだって、そういう友達がいるだろう？頭の中が奇妙な考えでいっぱいで、たまにどう反応したらいいか分からない、ヘンなことをしでかす友達が。","nextNodeIds":[740670411,740670412]},{"nodeId":740670411,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":405828330,"text":"確かにいる。","nextNodeIds":[740670413]},{"nodeId":740670413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3972089890,"text":"う～ん、おまえの考えってよくわからないな。ここでの生活が退屈で、しかもそういう友達がいるんだろ？だったら、どうしてさっさとメロピデ要塞から出ていかないんだよ？もしかして、実はおまえって重罪人なのか…？","nextNodeIds":[740670414]},{"nodeId":740670414,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":907877810,"text":"いや、出ていこうと思えば、いつでも出ていけるんだ。でも私は、自分の意志でここに残ってる。","nextNodeIds":[740670415]},{"nodeId":740670415,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":1266614978,"text":"だって、ここでの暮らしは外よりずっといいだろ？天気の心配をしなくていいし、生活も規則正しい。それに…複雑な問題だって考えずに済む。","nextNodeIds":[740670416]},{"nodeId":740670416,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":247096554,"text":"あのラノールって娘がなんともうらやましいよ。もし私が彼女だったら、絶対にここを離れるなんて選択はしないだろうな。外の世界を知らないままでいたかった。","nextNodeIds":[740670417,740670419]},{"nodeId":740670417,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":592166698,"text":"#それは{M#君}{F#あなた}が外の世界を知ってるから。","nextNodeIds":[740670418]},{"nodeId":740670418,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":3916250834,"text":"まあ、それは確かにそうだな。判断するには、比較対象が必要だ。君の言う通りだろう。","nextNodeIds":[740670421]},{"nodeId":740670421,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1801844986,"text":"でもここにずっといたら、友達に会えないんじゃないか？友達がこっちに来てくれない限りは…","nextNodeIds":[740670422]},{"nodeId":740670422,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":1635695874,"text":"いや、ここにいることは別に問題にはならないんだ。問題は、もう友達はいないってことのほうなんでね。","nextNodeIds":[740670423]},{"nodeId":740670423,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":1502151450,"text":"はぁ、この手の話題は正直苦手なんだが…","nextNodeIds":[740670424]},{"nodeId":740670424,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":3417318946,"text":"まだ彼らがいた頃——私たちの研究はあまり注目されておらず、経費の申請にも苦労していた。けどそれでも、その日々を辛いと思うことはなかった。","nextNodeIds":[740670425]},{"nodeId":740670425,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":3040079794,"text":"ただその後、予想外のことや事故が相次いで起きた…サー·ビュトールは病死。それに中央実験室は爆発してしまった。テイヤールも、その事故で亡くなったんだ。","nextNodeIds":[740670426]},{"nodeId":740670426,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":600050650,"text":"クビになった人もいたよ…まあ、彼の話はやめておこう。","nextNodeIds":[740670427]},{"nodeId":740670427,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":4127869994,"text":"とにかく、どれも私じゃどうしようもないことだった…けどね、メロピデ要塞での生活は簡単なんだ。私じゃ対応できないような問題もない。","nextNodeIds":[740670428]},{"nodeId":740670428,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":1122441802,"text":"あったとしても、私以外の誰かが心配してくれる、ははっ。だから、今の生活には何の不満もない。ただ…誰かと昔の話がしたいだけなんだ。","nextNodeIds":[740670429,740670430]},{"nodeId":740670429,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1069964338,"text":"その気持ち、分かる。","nextNodeIds":[740670431]},{"nodeId":740670431,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2744490482,"text":"今日は君たちと話ができてよかったよ…ありがとう。この特別許可券をやろう。ラグ＆ボーンショップで一杯おごったとでも思ってくれ。","nextNodeIds":[740670432]},{"nodeId":740670432,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":80390602,"text":"#乾杯、{NICKNAME}——さあ、そこの小さなレディも笑ってくれ。いい一日を過ごせるよう祈ってるよ。","nextNodeIds":[]},{"nodeId":740670430,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2971984970,"text":"#{M#君}{F#あなた}の選択を尊重するよ。","nextNodeIds":[740670431]},{"nodeId":740670419,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3187613826,"text":"軽々しく他の人を評価しないほうがいい。","nextNodeIds":[740670420]},{"nodeId":740670420,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":4106262986,"text":"ああ、それもそうだな。私も彼女のことをよく知ってるわけじゃないし、本人がどう考えてるのかも分からない。","nextNodeIds":[740670421]},{"nodeId":740670412,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1096674514,"text":"いや、いないかな。","nextNodeIds":[740670413]},{"nodeId":740670404,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4072326562,"text":"どうして自分と賭けなんてしたの？","nextNodeIds":[740670405]},{"nodeId":740670405,"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","textMapHash":2456642778,"text":"いい質問だ。でも答えは簡単——ここじゃ、こんな無意味な賭けに付き合ってくれる人がいないからさ。","nextNodeIds":[740670406]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7406704,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["74025","1"],"PAINLIBBLDK":"QUEST_EXEC_INC_QUEST_GLOBAL_VAR"},{"LNHLPKELCAL":["133408161","0"],"PAINLIBBLDK":"QUEST_EXEC_UNREGISTER_DYNAMIC_GROUP"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["5252"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7406704],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":5252,"speakerName":"クランツ","count":21},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":8},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":3}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_ALL","BEGCMMJKCFC":[174067],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1417626718,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FO