am":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7053502","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7053502,"initDialog":705350201,"nextRandomTalks":[],"nextTalks":[],"npcId":[10090,1007],"performCfg":"QuestDialogue/WQ/Fishblaster_70535/Q7053502","priority":5,"questId":70535,"showRandomTalkCount":0},"dialogs":[{"nodeId":705350201,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":1186683514,"text":"うん、分かった！","nextNodeIds":[705350202]},{"nodeId":705350202,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":2800011514,"text":"でも…やっぱりお魚はドカーンしたてが一番でしょ。火の上でちょっと焼いたら、パリッと香ばしくって、すごく美味しいんだよ！","nextNodeIds":[705350203]},{"nodeId":705350203,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":4084674690,"text":"心配しないで、クレーちゃん。ジンからとっくに聞いてるわ。","nextNodeIds":[705350204]},{"nodeId":705350204,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3944581690,"text":"もう「鹿狩り」に注文してあるから、ここ数日の間に湖で釣ったばかりの新鮮な魚をシェフが選んでくれるはずよ。きっとすぐ料理してくれるわ。","nextNodeIds":[705350205]},{"nodeId":705350205,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1239838986,"text":"クレーちゃんの大好きな調味料とソース、それから私が用意した特製のおやつもあるのよ。きっとクレーちゃんが魚をドカーンしたときと同じくらい美味しいはずよ。","nextNodeIds":[705350206]},{"nodeId":705350206,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":1635749666,"text":"うん！じゃあリサおば…リサお姉ちゃんの言うこと聞く！","nextNodeIds":[705350207]},{"nodeId":705350207,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":2921978594,"text":"しばらくはクレー、「ドドコドッカン冒険記」で遊ぶのに集中する！お魚をドカーンしたりしないし、アルベドお兄ちゃんのお友だちにも迷惑かけたりしないよ！","nextNodeIds":[705350208]},{"nodeId":705350208,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":3129581706,"text":"#あ！じゃあクレー、栄誉騎士のお{M#兄}{F#姉}ちゃんとパイモンちゃんを探しに行く！","nextNodeIds":[705350209]},{"nodeId":705350209,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1258219146,"text":"へへっ、誰がオイラたちを探すって？","nextNodeIds":[705350210,705350211]},{"nodeId":705350210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":537764914,"text":"二人が一緒にいるのは珍しいね。","nextNodeIds":[705350212]},{"nodeId":705350212,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":1878490050,"text":"#栄誉騎士のお{M#兄}{F#姉}ちゃん！それにパイモンちゃん！","nextNodeIds":[705350213]},{"nodeId":705350213,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":1524377610,"text":"クレー、ちょうど二人のことを考えてたところだったんだよ。そしたら二人が現れたの！何かの魔法がクレーの代わりに、二人に伝えてくれたのかな？","nextNodeIds":[705350214]},{"nodeId":705350214,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2161242,"text":"あら？可愛い子ちゃんとパイモンちゃん。ちょうどいいときに来たわね。手紙を書く手間が省けたわ。","nextNodeIds":[705350215,705350216]},{"nodeId":705350215,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4188210610,"text":"クレーの心に応えて召喚されて来たんだよ！","nextNodeIds":[705350217]},{"nodeId":705350217,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2239246298,"text":"オイラたち、ちょうど暇してたから、図書館で本でも探して読もうかと思ってたんだけど…「ドドコドッカン冒険記」ってなんだ？その辺の本よりも、めちゃくちゃ面白そうだぞ！","nextNodeIds":[705350218]},{"nodeId":705350218,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":1583097778,"text":"リサお姉ちゃんが作ってくれた新しいゲームだよ。名前はクレーたちで一緒に考えたの。パイモンちゃん、一回で覚えられるなんて、頭がいいんだね！","nextNodeIds":[705350219]},{"nodeId":705350219,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":436589658,"text":"リサさんって、ゲームまで作れるのかよ！オイラ、リサさんのこと…本の虫タイプの博学だと思ってたぞ！","nextNodeIds":[705350220]},{"nodeId":705350220,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2235481450,"text":"ふふ、ただ学生時代の暇つぶしのゲーム「ゴロゴロ炸裂キノコ」をもとに、少し改造しただけよ。そんなに手間はかかってないわ…","nextNodeIds":[705350221]},{"nodeId":705350221,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1571817618,"text":"クレーちゃんがこの「特別期間」を楽しく過ごせるなら、あと何種類か作ってもいいわ。","nextNodeIds":[705350222]},{"nodeId":705350222,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3850691322,"text":"「特別期間」？","nextNodeIds":[705350223]},{"nodeId":705350223,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1814965218,"text":"そうだ、思い出したぞ。さっきアルベドの友だちの話もしてたよな？近頃モンドでなにかあったのか？","nextNodeIds":[705350224]},{"nodeId":705350224,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1455848866,"text":"今回のアクシデントは、大きいとも小さいとも言えないけど…とにかく、慎重な対処が必要ね。","nextNodeIds":[705350225]},{"nodeId":705350225,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2781271330,"text":"最近、シードル湖にスメールから来た外来種の魚が現れたの。放っておいて、好き勝手に繁殖を許せば、モンドにおける水域の生態を脅かすかもしれない。","nextNodeIds":[705350226]},{"nodeId":705350226,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":474814554,"text":"幸いなことに、クレーちゃんがこっそり逃げ出して外で遊んでいたときに、見たことのない魚を発見したの。そう…それで、二匹ほど捕まえてきてくれたおかげで、ガイアに聞くことができたのよ。","nextNodeIds":[705350227]},{"nodeId":705350227,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":60062722,"text":"あのとき見つけていなければ、一般人がそれらを発見した頃には、在来種の魚は目立たない隅っこに追いやられてしまっていたかもしれないわ。","nextNodeIds":[705350228]},{"nodeId":705350228,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":136052034,"text":"もし水中生物の群れに変化が生じ、シードル湖の水質も影響を受けて、酒造業にまで影響が及んでしまったら…それはもはやモンド経済に関わる大問題になる。","nextNodeIds":[705350229]},{"nodeId":705350229,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":3246644290,"text":"へへっ、今回はクレーのお手柄なんだ！ジン団長もこのことを聞いて、特別にクレーを褒めてくれたの！","nextNodeIds":[705350230,705350231]},{"nodeId":705350230,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2116959450,"text":"お手柄だったね、クレー！","nextNodeIds":[705350232]},{"nodeId":705350232,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4031708738,"text":"そんなことがあったのか…それにしても、危ないとこだったな！","nextNodeIds":[705350233]},{"nodeId":705350233,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1488236330,"text":"今は調査小隊から人をやって、シードル湖の観測をしているところよ。「侵入者」さんたちの巣窟を見つけ出すためにね。","nextNodeIds":[705350234]},{"nodeId":705350234,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":221564490,"text":"そして、その間「侵入者」さんたちを驚かせることのないよう、クレーちゃんは「宝物」を持って走り回っちゃいけない、ってことになったの。","nextNodeIds":[705350235]},{"nodeId":705350235,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3020214146,"text":"調査小隊の使っている装置はとても敏感で、湖周辺の一定距離内で爆発があれば、観測に影響を及ぼしてしまうのよ。","nextNodeIds":[705350236]},{"nodeId":705350236,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2338856170,"text":"でもジンが、ずっと城の中に閉じ込められていると、クレーちゃんがきっと退屈するって言うものだから。","nextNodeIds":[705350237]},{"nodeId":705350237,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":825895882,"text":"アルベドは遊撃小隊の実験型装備を改良するのに忙しいし、ガイアもちょうど出張中で…お姉ちゃんであるわたくしのところに、この子の面倒を見るって任務が降ってきたというワケ…","nextNodeIds":[705350238]},{"nodeId":705350238,"roleType":"TALK_ROLE_NPC","speakerId":10090,"speakerName":"クレー","textMapHash":358583682,"text":"#今はもう退屈じゃないよ！リサお姉ちゃんが「ドドコドッカン冒険記」を発明してくれたんだ。クレー、すごく楽しみ！栄誉騎士のお{M#兄}{F#姉}ちゃんとパイモンちゃんと一緒に遊びたい！","nextNodeIds":[705350239,705350240]},{"nodeId":705350239,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1926995418,"text":"一緒に遊ぼう！","nextNodeIds":[705350241]},{"nodeId":705350241,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":412260498,"text":"ええ、「ドドコドッカン冒険記」の遊戯台は、お庭のところにあるわ。「鹿狩り」で注文したメニューも、そこに届くはずよ。","nextNodeIds":[705350242]},{"nodeId":705350242,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":2368208794,"text":"美味しいお料理とお花の香り、そしてそよ風を楽しみながら、クレーちゃんと遊ぶ…こんなに貴重な機会はないんだから、心ゆくまで楽しんでこなくちゃダメよ～","nextNodeIds":[705350243]},{"nodeId":705350243,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3992152106,"text":"あれ？ってことは、リサさんはオイラたちと一緒に行かないのか？","nextNodeIds":[705350244]},{"nodeId":705350244,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":1455295994,"text":"ゲームの作者であるわたくしが参加するのは、ちょっとズルくないかしら。あなたたちがゲームを遊ぶときのサプライズ感に、影響が出てしまうでしょう？","nextNodeIds":[705350245]},{"nodeId":705350245,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3158307498,"text":"それに図書館司書として、わたくしはまだ職場にいなきゃいけないわ。基本的な責務を果たすためにね。","nextNodeIds":[705350246]},{"nodeId":705350246,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3301818586,"text":"なんか、外に出ないための口実を探してるように聞こえるぞ…","nextNodeIds":[705350247]},{"nodeId":705350247,"roleType":"TALK_ROLE_NPC","speakerId":1007,"speakerName":"リサ","textMapHash":3707960354,"text":"さあ、いい子のみんなは安心してクレーちゃんと遊んできてちょうだい。","nextNodeIds":[705350248,705350249]},{"nodeId":705350248,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3043710650,"text":"うん、心配しないで。リサお姉ちゃん！","nextNodeIds":[705350250]},{"nodeId":705350250,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3551442466,"text":"わかった、じゃあまたあとでな、リサさん！","nextNodeIds":[]},{"nodeId":705350249,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3529577450,"text":"ううっ、大変だね。リサお姉ちゃん！","nextNodeIds":[705350250]},{"nodeId":705350240,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":975594778,"text":"日が暮れるまで遊ぼう！","nextNodeIds":[705350241]},{"nodeId":705350231,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2956580178,"text":"ジン団長が褒めてくれたんだ！","nextNodeIds":[705350232]},{"nodeId":705350216,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3522051834,"text":"偶然の魔法が呼びに来てくれたんだよ！","nextNodeIds":[705350217]},{"nodeId":705350211,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":658373930,"text":"何か大事な約束をしたみたいだね？","nextNodeIds":[705350212]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053502,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[1004_234:-16.567,0.000,10.811,0.000,214.556,0.000]","10"],"NOCCOBOFKHP":1004,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}},{"subQuestId":7053503,"order":3,"stepDescription":"庭に行く","stepDescTextMapHash":2720102404,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7053503,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLN