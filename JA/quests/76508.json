unt":0},"dialogs":[{"nodeId":765080101,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1455176402,"text":"「流泉の衆」でイベントでもやってるのか？観光客が増えてる気がするぞ？","nextNodeIds":[765080102]},{"nodeId":765080102,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3977064010,"text":"あそこにスメールから来たっぽい人がいるな…ダンスのパフォーマンスか？","nextNodeIds":[765080103]},{"nodeId":765080103,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":4167486106,"text":"おっと！これはこれは、偉大なる大英雄さんと、キュートな参謀のパイモンじゃないか！","nextNodeIds":[765080104]},{"nodeId":765080104,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":4168183578,"text":"あなたはあたしの最も敬愛する戦士で、武術と舞踊に長けた勇者…そして人生を楽しむ達人だ——会えて嬉しいよ。","nextNodeIds":[765080105]},{"nodeId":765080105,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3140329314,"text":"ん？どこかで見たような…","nextNodeIds":[765080106]},{"nodeId":765080106,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":774612178,"text":"#それに、{NICKNAME}はダンスも踊れるって。なんで知ってるんだ？","nextNodeIds":[765080107]},{"nodeId":765080107,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1063101722,"text":"そりゃもちろん、聖火競技場で踊ってるのを見たからさ。","nextNodeIds":[765080108]},{"nodeId":765080108,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2640550042,"text":"#記念写真を撮った後、あたしは隅っこのほうでちび竜ビスケットを食べながら{NICKNAME}の祝福の舞を見てたんだ。","nextNodeIds":[765080109]},{"nodeId":765080109,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1763405178,"text":"#ダンスってのは気楽に、自分を解き放つのが一番だ。{NICKNAME}のダンスは、見ていて一緒に踊りたくなったよ！","nextNodeIds":[765080110,765080112]},{"nodeId":765080110,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2618502978,"text":"思い出した！","nextNodeIds":[765080111]},{"nodeId":765080111,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":4037753082,"text":"光栄だよ！","nextNodeIds":[765080114]},{"nodeId":765080114,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1465311954,"text":"さて、話を戻そうか。ご覧の通り、スメールの友人たちが遊びに来てくれてるんだ。","nextNodeIds":[765080115]},{"nodeId":765080115,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":3152362114,"text":"そこでムトタやアミナ、パカル、そしてムアラニと話し合った結果、「花翼の集」、「こだまの子」、「流泉の衆」合同でスメールの客人をもてなすことにした。","nextNodeIds":[765080116]},{"nodeId":765080116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1027482954,"text":"「エルマイト旅団」の傭兵も結構いるみたいだな…","nextNodeIds":[765080117]},{"nodeId":765080117,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1962087322,"text":"へへ、砂漠を旅してる時に殴り合った勢いで友達になったとかか？","nextNodeIds":[765080118]},{"nodeId":765080118,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2298940914,"text":"あはは、だいたいそんな感じ。でも殴り合ったのはあたしたちじゃない。","nextNodeIds":[765080119]},{"nodeId":765080119,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2221785866,"text":"千尋の砂漠の南でバーベキューをしてたら凶暴な赤鷲が群がってきちゃってね。あたしたちが腹いっぱいになって動けなくなった隙を突いて襲いかかって来たのさ…","nextNodeIds":[765080120]},{"nodeId":765080120,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2017832634,"text":"これがずる賢いやつらでねぇ…苦戦した末に手も足も出ず、あっちは慣れ親しんだ地形を利用して攻めてくるもんだから、あたしたちは疲弊して撤退するしかなかったんだ。","nextNodeIds":[765080121]},{"nodeId":765080121,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2819744938,"text":"するとそこに傭兵の一団が現われて、赤鷲に向かって不思議な剣舞をやってみせた。","nextNodeIds":[765080122]},{"nodeId":765080122,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":3579153874,"text":"すると赤鷲の群れは通じ合ったみたいに、どこかへ消えてくれたんだ。","nextNodeIds":[765080123]},{"nodeId":765080123,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2487541530,"text":"け、剣舞で赤鷲を追い払ったのか？","nextNodeIds":[765080124,765080125]},{"nodeId":765080124,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1221859186,"text":"怪しい舞が怖くて逃げたんじゃ…","nextNodeIds":[765080126]},{"nodeId":765080126,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1602368906,"text":"不思議だろ？あたしたちもその舞の秘密が気になって仕方がなくってさ。","nextNodeIds":[765080127]},{"nodeId":765080127,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":3237700866,"text":"キャンプを撤収した後みんなで派手に飲み食いした後、ダンスのテクニックについて色々話したんだ…","nextNodeIds":[765080128]},{"nodeId":765080128,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2440773562,"text":"途中で他の魔物や野獣が邪魔しに来るようなら、みんなで立ち向かってさ！","nextNodeIds":[765080129]},{"nodeId":765080129,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1279979178,"text":"二週間もしないうちに命を預け合えるほどの戦友…あと、ダンス仲間になったよ。","nextNodeIds":[765080130]},{"nodeId":765080130,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1145791146,"text":"別れる前に、今後は互いのホームを訪ね合って「ダンス交流会」を続けて行こうって約束したんだ。今回はその初の試みってわけさ。","nextNodeIds":[765080131]},{"nodeId":765080131,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":367016322,"text":"#なあ{NICKNAME}、スメールとナタのダンス交流イベントだなんて…こんなの初めてだよな？","nextNodeIds":[765080132,765080133]},{"nodeId":765080132,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3652107194,"text":"確かに新しいね。","nextNodeIds":[765080134]},{"nodeId":765080134,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1282260122,"text":"せっかくの機会だし、あたしたちに指導しておくれよ。","nextNodeIds":[765080135]},{"nodeId":765080135,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2850077842,"text":"ムアラニもいるよ。あたしたちの中でもとりわけ明るくて…いわばダンサーの顔だ。","nextNodeIds":[765080136]},{"nodeId":765080136,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2809622282,"text":"あと「エルマイト旅団」の友人は、リーダー兼アドバイザーとして現地の有名な踊り子を雇ったらしい。それも大金をはたいてね。","nextNodeIds":[765080137]},{"nodeId":765080137,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1250276098,"text":"二人も知ってる踊り子じゃないかね？","nextNodeIds":[765080138]},{"nodeId":765080138,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4005405770,"text":"誰か分かった気がするぞ。へへっ、後で驚かせてやろうっと…","nextNodeIds":[765080139,765080140]},{"nodeId":765080139,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2392445530,"text":"いいよ、参加する！","nextNodeIds":[765080141]},{"nodeId":765080141,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":2605459154,"text":"あははっ！ますます盛り上がりそうだね。ムアラニの言葉を借りて言えば、ビッグウェーブ！ってやつだ。","nextNodeIds":[765080142]},{"nodeId":765080142,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":1599138426,"text":"さあ、ひとまずタラネに会いに行こう。","nextNodeIds":[]},{"nodeId":765080140,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3538773346,"text":"そんなイベント、見逃せない！","nextNodeIds":[765080141]},{"nodeId":765080133,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2912261754,"text":"見てみたい。","nextNodeIds":[765080134]},{"nodeId":765080125,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3086322786,"text":"もともと知り合いだったとか？","nextNodeIds":[765080126]},{"nodeId":765080112,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":744958474,"text":"次に会う時は覚えてる。","nextNodeIds":[765080113]},{"nodeId":765080113,"roleType":"TALK_ROLE_NPC","speakerId":30891,"speakerName":"ヌスタ","textMapHash":3796490650,"text":"今のあたしじゃ力不足ってことだね。胸を張れるような実績もないし、もっと頑張らないと！","nextNodeIds":[765080114]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7650801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":