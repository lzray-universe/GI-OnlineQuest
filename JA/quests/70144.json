e":"玉霞","textMapHash":203489514,"text":"これはいつ雪山に現れたのかしら…","nextNodeIds":[701440105]},{"nodeId":701440105,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2820846962,"text":"調査ありがとう。このことは協会に報告しておくわ。これは報酬よ、ご苦労様。","nextNodeIds":[]}]},{"talkId":7014402,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_NONE","heroTalk":"TALK_HERO_LOCAL","id":7014402,"initDialog":701440201,"nextRandomTalks":[],"nextTalks":[],"npcId":[1665],"performCfg":"","priority":5,"questId":70144,"showRandomTalkCount":0},"dialogs":[{"nodeId":701440201,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":381955618,"text":"何か依頼があるの？","nextNodeIds":[701440202]},{"nodeId":701440202,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":694144834,"text":"依頼？あぁ君か、ちょうどよかった。いま経験豊富な冒険者を探してたの。奇妙な寒流を調べてもらうためにね。","nextNodeIds":[701440203]},{"nodeId":701440203,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2906797770,"text":"寒流？","nextNodeIds":[701440204]},{"nodeId":701440204,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2695363002,"text":"そう。以前とあるチームが経験豊富な冒険者たちを引き連れて山に入ったの。進んだルートは最も安全で、危険なエリアも全部回避した。","nextNodeIds":[701440205]},{"nodeId":701440205,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2368281346,"text":"でも、何が起きたか知らないけど、途中でいきなり激しい寒流に遭遇して、拠点に引き返した。","nextNodeIds":[701440206]},{"nodeId":701440206,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":3592694466,"text":"戻ってきた冒険者によると、彼らが歩いた道にその強さの寒流が発生する可能性はなかったらしいの。それに、発生した寒流がいきなりすぎて、とてもじゃないけど自然現象とは思えなかったみたい。","nextNodeIds":[701440207]},{"nodeId":701440207,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2638084226,"text":"その後、山で考察していた人たちからの報告や調査の結果、その寒流の発生源を特定できたわ。","nextNodeIds":[701440208]},{"nodeId":701440208,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2088401698,"text":"でも、度重なる調査で、調査チームの冒険者たちはみんな凍傷になったり体力を失ったりしてこの拠点で休んでるの。これ以上調査に配置できる人員は…","nextNodeIds":[701440209]},{"nodeId":701440209,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":3370812226,"text":"旅人、もしよかったらだけど、私たちの代わりにあの極寒の元凶を調べてきてもらえないかしら？","nextNodeIds":[701440210,701440212]},{"nodeId":701440210,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2511728890,"text":"任せて。","nextNodeIds":[701440211]},{"nodeId":701440211,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":3174174466,"text":"じゃあお願いね。あの極寒は尋常じゃないから、万全な準備を忘れずに。","nextNodeIds":[701440215]},{"nodeId":701440215,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2248644858,"text":"じゃあ、そこの調査をお願いね。","nextNodeIds":[]},{"nodeId":701440212,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4066288850,"text":"報酬は…","nextNodeIds":[701440213]},{"nodeId":701440213,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":2826905258,"text":"あら、素直ね。心配しないで、協会は冒険者を無下にしない。報酬を準備して拠点で待ってるわ。","nextNodeIds":[701440214]},{"nodeId":701440214,"roleType":"TALK_ROLE_NPC","speakerId":1665,"speakerName":"玉霞","textMapHash":44027922,"text":"具体的な報酬内容は…調査結果次第ね。それがルールだもの。君も分かるわよね？","nextNodeIds":[701440215]}]},{"talkId":7014403,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_ALL","beginCond":[{"param":["99902","3","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":[""