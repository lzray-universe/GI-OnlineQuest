:["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2205005,"initDialog":220500501,"nextRandomTalks":[],"nextTalks":[],"npcId":[3189],"performCfg":"QuestDialogue/WQ/Inazuma_22050/Q2205005","priority":5,"questId":22050,"showRandomTalkCount":0},"dialogs":[{"nodeId":220500501,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":823162578,"text":"ここで少し休むにゃ、うち疲れたにゃ。","nextNodeIds":[220500502]},{"nodeId":220500502,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":2472938738,"text":"でも、本当に響が言っていたのと同じだったにゃ。","nextNodeIds":[220500503]},{"nodeId":220500503,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1102345738,"text":"異なる島は、それぞれまったく違うにゃ。それに、こんなに高いところに神社があるなんて、人間は高いところが怖くにゃいのか？","nextNodeIds":[220500504]},{"nodeId":220500504,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1637944354,"text":"やっぱりうちの浅瀬神社の方がいいにゃ。","nextNodeIds":[220500505]},{"nodeId":220500505,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":246103970,"text":"でも、響はいったいどこにいるにゃ…","nextNodeIds":[220500506]},{"nodeId":220500506,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":19120586,"text":"まだ探す？","nextNodeIds":[220500507]},{"nodeId":220500507,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":2815578250,"text":"疲れたにゃ。また今度にするにゃ。","nextNodeIds":[220500508]},{"nodeId":220500508,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2957168562,"text":"また今度があるのかよ！","nextNodeIds":[220500509]},{"nodeId":220500509,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":2769178122,"text":"もちろんにゃ。響はうちにたくさんの物語を話したにゃ。海辺の物語、木が多い場所の物語、あと「狐様」の物語。","nextNodeIds":[220500510]},{"nodeId":220500510,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":2023325322,"text":"これらの物語は、うちもよく覚えてるにゃ。","nextNodeIds":[220500511]},{"nodeId":220500511,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1431037098,"text":"でもいま一番重要なのは、家に帰ることにゃ。浅瀬神社には宮司が必要にゃ。","nextNodeIds":[220500512]},{"nodeId":220500512,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3122719274,"text":"とにかく、主らはうちと一緒に帰るにゃ。","nextNodeIds":[]}]},{"talkId":2205007,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":true,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["2205006","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2205007,"initDia