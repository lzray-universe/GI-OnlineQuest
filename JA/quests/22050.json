:["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":2205004,"initDialog":220500401,"nextRandomTalks":[],"nextTalks":[],"npcId":[3105,3189],"performCfg":"QuestDialogue/WQ/Inazuma_22050/Q2205004","priority":5,"questId":22050,"showRandomTalkCount":0},"dialogs":[{"nodeId":220500401,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":532081074,"text":"こんにちは、遠くからいらした旅人さん。「鳴神大社」へようこそ。","nextNodeIds":[220500402]},{"nodeId":220500402,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":2650475866,"text":"悩みや願いがあるのなら、ここでおみくじを引いてみてはいかがでしょう。雷神様が祝福してくれますよ。","nextNodeIds":[220500403]},{"nodeId":220500403,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1873192314,"text":"オイラたち、おみくじを引きに来たんじゃないんだ。聞きたいことがあって…","nextNodeIds":[220500404]},{"nodeId":220500404,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":4199151378,"text":"聞きたいこと？はい…どうぞおっしゃってください。","nextNodeIds":[220500405]},{"nodeId":220500405,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3947676114,"text":"事の経緯は…","nextNodeIds":[220500406]},{"nodeId":220500406,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":1490479570,"text":"浅瀬神社の…響？まさか「浅瀬響」ですか…","nextNodeIds":[220500407]},{"nodeId":220500407,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1577922610,"text":"そうにゃ！響は「浅瀬響」にゃ！主は響を知ってるのかにゃ？今どこにいるにゃ？","nextNodeIds":[220500408]},{"nodeId":220500408,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":4036648506,"text":"えぇ…えっ！？猫がしゃべった…私の聞き間違いでしょうか…","nextNodeIds":[220500409]},{"nodeId":220500409,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1272056834,"text":"人間は相変わらず驚くのが好きにゃ…うちがしゃべるのがそんなにおかしいのかにゃ？","nextNodeIds":[220500410]},{"nodeId":220500410,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":2657440282,"text":"主、響を知ってるのか？今どこにいるにゃ？","nextNodeIds":[220500411]},{"nodeId":220500411,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":754119250,"text":"猫に質問されるのは、なんだか変な感じがしますね…","nextNodeIds":[220500412]},{"nodeId":220500412,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":2312447522,"text":"しかし、もし本当にあの「浅瀬響」を探しているのなら、探す場所を間違えてますよ…","nextNodeIds":[220500413]},{"nodeId":220500413,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3912290866,"text":"えっ？","nextNodeIds":[220500414]},{"nodeId":220500414,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2014787842,"text":"探す場所を…間違えてる？","nextNodeIds":[220500415]},{"nodeId":220500415,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":1496000474,"text":"神社に残った数少ない保存状態の良い書籍で、彼女の名前を目にしたことがあります。彼女は浅瀬神社の最後の代…","nextNodeIds":[220500416]},{"nodeId":220500416,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":1278392890,"text":"約四、五百年前、「影向役者三人組」という言い伝えがありました。浅瀬響、惟神晴之介、御輿長正はかつて影向山で、影向天狗に教えを請いました。","nextNodeIds":[220500417]},{"nodeId":220500417,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":1490817042,"text":"その間、浅瀬は我々の神社でも見習いをしたことがあり、狐斎宮様とも親交を深めました。しかし、最後は…","nextNodeIds":[220500418]},{"nodeId":220500418,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":56066818,"text":"彼ら三人は結局、書籍にも詳しく記録されていない「災厄」をきっかけに、それぞれ別の道を歩みました。うわさでは、惟神は海を渡って璃月へ行き、より強大な「仙家道法」を学びに行ったそうです。","nextNodeIds":[220500419]},{"nodeId":220500419,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":2906371226,"text":"御輿は稲妻城へ戻り、幕府に仕えました。そして浅瀬は…","nextNodeIds":[220500420,220500421]},{"nodeId":220500420,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3676163242,"text":"セイライ島に戻った…","nextNodeIds":[220500422]},{"nodeId":220500422,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":3174476842,"text":"ええ、そうです。しかし参考にできる資料がとても少なく、具体的な状況は不明のままです。","nextNodeIds":[220500423]},{"nodeId":220500423,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1538753202,"text":"ちょっと待って…","nextNodeIds":[220500424]},{"nodeId":220500424,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":474545298,"text":"うーん…四、五百年前ってことは、響はすごく昔の人ってことだよな。","nextNodeIds":[220500425]},{"nodeId":220500425,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4179613842,"text":"じゃあ寝子は四、五百歳の猫ってことか！？","nextNodeIds":[220500426]},{"nodeId":220500426,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":154918258,"text":"にゃ？うちはよくわからにゃい。「四、五百歳」とはどういう意味にゃ？","nextNodeIds":[220500427]},{"nodeId":220500427,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":4008485282,"text":"うちは人間じゃないから、そんなことを気にする必要はにゃい。うちは太陽と月が昇ることだけを知っていればいいにゃ。気分が悪いときは、一眠りすればいい。","nextNodeIds":[220500428]},{"nodeId":220500428,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":956535250,"text":"羨ましい…","nextNodeIds":[220500429,220500431]},{"nodeId":220500429,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":214165442,"text":"パイモンも似たようなものでしょ。","nextNodeIds":[220500430]},{"nodeId":220500430,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1100314914,"text":"おい！失礼だな、オイラは毎日おまえの心配で忙しいんだぞ！","nextNodeIds":[220500433]},{"nodeId":220500433,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":4071258698,"text":"主らの言ってること、うちにはわからにゃい。そんなことより、響はどこにゃ？","nextNodeIds":[220500434]},{"nodeId":220500434,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":4059735882,"text":"浅瀬響なら、おそらくもう…","nextNodeIds":[220500435]},{"nodeId":220500435,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2626113122,"text":"響はここにいない。","nextNodeIds":[220500436]},{"nodeId":220500436,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2155193234,"text":"そ、そうだぞ。響はたぶん他の場所に行ってるんだ。","nextNodeIds":[220500437]},{"nodeId":220500437,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":1171430538,"text":"……","nextNodeIds":[220500438]},{"nodeId":220500438,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":619336338,"text":"そうか。","nextNodeIds":[220500439]},{"nodeId":220500439,"roleType":"TALK_ROLE_NPC","speakerId":3189,"speakerName":"「寝子」","textMapHash":3697550786,"text":"なら仕方ないにゃ。色んなところを駆けまわるなんて、響は本当に子供っぽいにゃ。","nextNodeIds":[220500440]},{"nodeId":220500440,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":902448970,"text":"何はともあれ、ありがとう、巫女お姉さん！","nextNodeIds":[220500441]},{"nodeId":220500441,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3531714554,"text":"#じゃあ{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちはこれで。","nextNodeIds":[220500442]},{"nodeId":220500442,"roleType":"TALK_ROLE_NPC","speakerId":3105,"speakerName":"稲城蛍美","textMapHash":2045214866,"text":"はい…もし何か手助けが必要でしたら、遠慮なくお申し付けください。","nextNodeIds":[]},{"nodeId":220500431,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":854871178,"text":"猫の寿命ってそんなに長いの？","nextNodeIds":[220500432]},{"nodeId":220500432,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":200478994,"text":"普通はそうじゃないけど…","nextNodeIds":[220500433]},{"nodeId":220500421,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":409570810,"text":"浅瀬神社に戻った…","nextNodeIds":[220500422]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[2205004,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCon