[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":true,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":true,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["7166804","2","","",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_AUTO","heroTalk":"TALK_HERO_MAIN","id":7166804,"initDialog":716680401,"nextRandomTalks":[],"nextTalks":[],"npcId":[30672,30673],"performCfg":"QuestDialogue/WQ/AnimalView_71668/Q7166804","priority":5,"questId":71668,"showRandomTalkCount":0},"dialogs":[{"nodeId":716680401,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3692584002,"text":"よし、これらの食べ物は専用の箱に入れて届けるよ。","nextNodeIds":[716680402]},{"nodeId":716680402,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":373972314,"text":"動物たちはそれぞれ習性が違うから、檻に閉じ込めるようなことはしない。プロの飼育員を招いて、動物を追跡しながら、随時健康状態をチェックしてる。","nextNodeIds":[716680403]},{"nodeId":716680403,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3236498762,"text":"動物のいる場所を特定するのはかなり難しいから、ラミヤさんの開発した「すりこみの鏡」って特殊な道具を使うといい。","nextNodeIds":[716680404]},{"nodeId":716680404,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":2249459378,"text":"この分野については、私よりも専門家の彼女から直接説明してもらったほうがいいだろう。","nextNodeIds":[716680405]},{"nodeId":716680405,"roleType":"TALK_ROLE_NPC","speakerId":30672,"speakerName":"ラミヤ","textMapHash":1203812258,"text":"ええ。じゃあ、ちょっと説明させてもらうね。","nextNodeIds":[716680406]},{"nodeId":716680406,"roleType":"TALK_ROLE_NPC","speakerId":30672,"speakerName":"ラミヤ","textMapHash":1123348138,"text":"「すりこみの鏡」の開発に使われた技術はアーカーシャに関係したものだけど、具体的な原理を説明するとなると、ちょっと難しいわ。でも、安全性についてはテスト済みだから、安心してちょうだい。","nextNodeIds":[716680407]},{"nodeId":716680407,"roleType":"TALK_ROLE_NPC","speakerId":30672,"speakerName":"ラミヤ","textMapHash":669471858,"text":"動物の体には小型の発信装置がつけてあるの。その信号を鏡が読み取って、動物の視野が映るという仕組みになっているわ。","nextNodeIds":[716680408]},{"nodeId":716680408,"roleType":"TALK_ROLE_NPC","speakerId":30672,"speakerName":"ラミヤ","textMapHash":3274985354,"text":"装置にはいろいろ改善点があるけど、今のところ、動いている動物の位置を特定する分には十分役立つはずよ。","nextNodeIds":[716680409]},{"nodeId":716680409,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3280682842,"text":"…と、こんな感じだ。準備ができたら、いつでも「アニマルトゥギャザー」に参加してくれ！","nextNodeIds":[716680410]},{"nodeId":716680410,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3637013122,"text":"やることは「すりこみの鏡」を使って動物を探すこと。動物たちも、里親のプレゼントも、君が見つけてくれるのを待ってるよ。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166804,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCI