":[{"nodeId":716680101,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3936717450,"text":"動物救助会「アニマルトゥギャザー」へようこそ。","nextNodeIds":[716680102]},{"nodeId":716680102,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2761599114,"text":"こんにちは。","nextNodeIds":[716680104]},{"nodeId":716680104,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1830329530,"text":"#ああ、君は{NICKNAME}だね。こんにちは。","nextNodeIds":[716680105]},{"nodeId":716680105,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3948886954,"text":"うちの商会でイベントをやってるんだけど、興味はあるかい？","nextNodeIds":[716680106]},{"nodeId":716680106,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":316091570,"text":"どんなイベント？","nextNodeIds":[716680107]},{"nodeId":716680107,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1407647818,"text":"飛雲商会が出資している「アニマルトゥギャザー」という動物救助会に加入して、居場所を失った、あるいは絶滅の危機に瀕した動物を引き取るというものだ。","nextNodeIds":[716680108]},{"nodeId":716680108,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3796993378,"text":"飛雲商会は世界各地のボランティアと手を取り、居場所を失った動物と里親を繋ぐことで、動物の問題の解決を図っている。","nextNodeIds":[716680109]},{"nodeId":716680109,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3972083050,"text":"ここ数年、救助会も成長してきた。ラミヤさんのような学者とも手を組み、絶滅危惧種の保護といった分野にも目を向けている。","nextNodeIds":[716680110]},{"nodeId":716680110,"roleType":"TALK_ROLE_NPC","speakerId":30672,"speakerName":"ラミヤ","textMapHash":1812794602,"text":"私の研究成果をこの分野にも活かすことができて、とても嬉しいわ。","nextNodeIds":[716680111]},{"nodeId":716680111,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1161991962,"text":"ははっ、こちらこそ、君と手を組むことができて嬉しいよ。","nextNodeIds":[716680112]},{"nodeId":716680112,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3901699114,"text":"ボランティアの皆さん、そしてラミヤさんみたいに先見の明を持つ研究員の方々のおかげで、動物たちに居場所を用意したり、絶滅の危機から守ったりできているのだから。","nextNodeIds":[716680113]},{"nodeId":716680113,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":2238456154,"text":"璃月だけじゃなく、モンドやスメールなど、飛雲商会が活躍している国に「アニマルトゥギャザー」の動物保護拠点はあるんだ。","nextNodeIds":[716680114]},{"nodeId":716680114,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":2959797258,"text":"ボランティアの皆さんに感謝を伝えると同時に、「アニマルトゥギャザー」の仲間をもっと増やすために、このイベントを企画したんだ。","nextNodeIds":[716680115]},{"nodeId":716680115,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":4069284770,"text":"動物保護エリアに行けば、あの子たちの暮らしを確認できるし、プレゼントももらえるよ。","nextNodeIds":[716680116]},{"nodeId":716680116,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":3575017954,"text":"プレゼントは救助会の職員や里親の方々が共に用意したものだ。もちろん、プレゼントを受け取る側も他の里親にあげるプレゼントを用意する必要がある。","nextNodeIds":[716680117]},{"nodeId":716680117,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":2866504810,"text":"プレゼントは一旦担当者が回収したあと、前の里親に届ける。プレゼントと言っても、高額である必要はまったくない。気持ちが大切なんだ。","nextNodeIds":[716680118]},{"nodeId":716680118,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":4244766178,"text":"#どうだい。{NICKNAME}、参加してみるかい？","nextNodeIds":[716680119,716680120]},{"nodeId":716680119,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3157664042,"text":"ちょっと様子見させて。","nextNodeIds":[716680121]},{"nodeId":716680121,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":251329626,"text":"素晴らしい。君みたいな有名人に参加してもらえて嬉しいよ。","nextNodeIds":[716680122]},{"nodeId":716680122,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1552930194,"text":"プレゼントの用意ができたら、私に渡してくれればいい。イベントが終わったら、職員が里親のところに届ける段取りになっている。","nextNodeIds":[716680123]},{"nodeId":716680123,"roleType":"TALK_ROLE_NPC","speakerId":30673,"speakerName":"振塵","textMapHash":1886191058,"text":"あ、そうだ。これまで里親と接してきた経験からすると、地域の特産に興味を持つ人やグルメ好きな人が結構いる。","nextNodeIds":[]},{"nodeId":716680120,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":814679138,"text":"参加したい。","nextNodeIds":[716680121]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166801,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30673"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"}}},{"subQuestId":7166802,"order":2,"stepDescription":"適切なプレゼントを渡す","stepDescTextMapHash":698214532,"finishConds":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7166802,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_ITEM_GIVING","PPFLKMOMKAI":""}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["30673"],"NOCCOBOFKHP":3,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_NPC"},"isHidden":false,"talkIds":[7166802,7166806],"talks":[{"talkId":7166802,"talkConfig":{"checkActionAfter":false,"crowdLOD0List":[],"decoratorID":0,"disableTalkReview":false,"dontBlockDaily":false,"enableCameraDisplacement":false,"extraLoadMarkId":[],"finishExec":[{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"},{"param":["","","","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"is