",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"},{"param":["","","","",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":7518101,"initDialog":751810101,"nextRandomTalks":[],"nextTalks":[],"npcId":[21809],"performCfg":"QuestDialogue/WQ/Natlan_75181/Q7518101","priority":5,"questId":75181,"showRandomTalkCount":0},"dialogs":[{"nodeId":751810101,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":2699500242,"text":"まるでかつての思い出が目の前に浮かびあがるかのようだ。","nextNodeIds":[751810102]},{"nodeId":751810102,"roleType":"TALK_ROLE_NEED_CLICK_BLACK_SCREEN","speakerId":null,"speakerName":"","textMapHash":74758354,"text":"何層にも重なる高台の上で、無数の計算図形が分光経路の変化に合わせて、絶えず流転する…\\n集まった燃素の流れは巨大な圧力によって、制御可能な高温の球体と化した。\\n「成功だ！」周囲の同胞たちが歓喜にどよめいた。\\nしかし、星を鋳るに匹敵するこの偉業を成し遂げた主導者は、さも自分はまったくの無関係であるかのように、実験場の外側に立っていた。","nextNodeIds":[751810103]},{"nodeId":751810103,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":2740261786,"text":"おめでとうございます、本当に小さな星体と等価な物を作り出せたのですね…「擬似群星」。ふっ、空や月を新たに鋳るに匹敵する偉業です。","nextNodeIds":[751810104]},{"nodeId":751810104,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":349968426,"text":"「あの方」がまだこの世にいらっしゃれば、翼を収めて、貴方に頭を垂れたやもしれませぬな。","nextNodeIds":[751810105]},{"nodeId":751810105,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":3595128946,"text":"「…そなたの協力があれば、もっと早く実現しただろうに。」","nextNodeIds":[751810106]},{"nodeId":751810106,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":4109590770,"text":"私はこれっぽっちも興味が持てませんので。","nextNodeIds":[751810107]},{"nodeId":751810107,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":1329608922,"text":"「…それでもお前は手を貸すべきだった、ククルカン。かつて我々は『すべてを奪う者』の使者を、最も深い山谷の割れ目に追いやった。しかし、その主が目覚めた時——」","nextNodeIds":[751810108]},{"nodeId":751810108,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":2466327258,"text":"「我々の種族に、滅亡の災いが訪れるだろう。」","nextNodeIds":[751810109]},{"nodeId":751810109,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":1472711930,"text":"偉大なものですね。このようなもので、哀れな貴方の同胞を守ろうとは…","nextNodeIds":[751810110]},{"nodeId":751810110,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":404789722,"text":"「『我々』の哀れな同胞だ。」","nextNodeIds":[751810111]},{"nodeId":751810111,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":3670809794,"text":"「これはただの始まりに過ぎぬ。余に残された時間は残り僅かだ。漆黒の影が余を完全に覆う前に、すべての龍の裔に新たな道を示さなければならぬ。」","nextNodeIds":[751810112]},{"nodeId":751810112,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":3853217050,"text":"彼ら自身に探してもらったほうがいいかもしれませんよ…僭越ながら言わせていただきますが、貴方の作ろうとなさっている道は、我々の種族にとって少し狭すぎる気がいたします。","nextNodeIds":[751810113]},{"nodeId":751810113,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":1013573794,"text":"「時には狭い道を通る必要もある。特に残された時間が僅かになり…待つ行為が贅沢と化した時はな。」","nextNodeIds":[751810114]},{"nodeId":751810114,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":2285211866,"text":"「待つのはもううんざりだ。ククルカン、いつかそなたも余を理解し、余と同じ決断をするだろう。残された時間が僅かになった時に…」","nextNodeIds":[751810115]},{"nodeId":751810115,"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","textMapHash":1056878762,"text":"…我が王、我が兄…生まれた日を同じくする創造主よ。それだけは同意しかねます。","nextNodeIds":[751810116]},{"nodeId":751810116,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2739302634,"text":"えっと、今のって…大きな炎の玉が作られた時の光景だよな…？","nextNodeIds":[751810117]},{"nodeId":751810117,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":593063522,"text":"パイモンにも見えたの？","nextNodeIds":[751810118]},{"nodeId":751810118,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":4243546290,"text":"おう、今回はオイラにもはっきり見えたぞ…あの時、このケーキの台の周りに集まってたのは、昔ここで暮らしてた龍だったんだな…","nextNodeIds":[751810119]},{"nodeId":751810119,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":625955746,"text":"変だな。さっきの二人は誰だったんだろう？","nextNodeIds":[751810120]},{"nodeId":751810120,"roleType":"TALK_ROLE_NPC","speakerId":21460,"speakerName":"#{REALNAME[ID(2)|SHOWHOST(true)]}","textMapHash":3298990450,"text":"キュ…キュイ…","nextNodeIds":[751810121]},{"nodeId":751810121,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1655219810,"text":"とにかく、ここの「擬似群星」の封印は解けたってことでいいんだよな！","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[7518101,0],"PAINLIBBLDK":"QUEST_CONTENT_COMPLETE_TALK","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[{"LNHLPKELCAL":["101","610104035,2"],"PAINLIBBLDK":"QUEST_EXEC_REFRESH_GROUP_SUITE"},{"LNHLPKELCAL":["101","610102175"],"PAINLIBBLDK":"QUEST_EXEC_NOTIFY_GROUP_LUA"}],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_SCENE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_TARGET","LNHLPKELCAL":["[101_64:-466.034,939.147,-247.885]"],"NOCCOBOFKHP":101,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_ENABLE","PAINLIBBLDK":"QUEST_GUIDE_LOCATION"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[7518101],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":21806,"speakerName":"液体燃素に浸かる","count":13},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":4},{"roleType":"TALK_ROLE_NEED_CLICK_BLA