ment":false,"extraLoadMarkId":[],"finishExec":[{"param":["","",""],"type":"TALK_EXEC_NONE"},{"param":["","",""],"type":"TALK_EXEC_NONE"}],"forceNpcNotDestroy":false,"heroRuleId":0,"ignoreDragonTalkRule":false,"isEnableNoBlackInter":false,"linkBehaviorGrpId":0,"loadType":"TALK_NORMAL_QUEST","lockGameTime":false,"lowPriority":false,"newTalkFinishTime":false,"onlyQuestNpc":false,"participantId":[],"prePerformCfg":"","questIdleTalk":false,"randomTalkPos":0,"randomTalkPriorityList":[],"removeDuplicatedRandomTalk":false,"stayFreeStyle":false,"talkMarkHideList":[],"talkMarkType":"TALK_MARK_NONE","activeMode":"PLAY_MODE_SINGLE","beginCond":[{"param":["40001","2",""],"type":"QUEST_COND_STATE_EQUAL"},{"param":["","",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"},{"param":["",""],"type":"QUEST_COND_NONE"}],"beginCondComb":"LOGIC_NONE","beginWay":"TALK_BEGIN_MANUAL","heroTalk":"TALK_HERO_MAIN","id":39607,"initDialog":3960701,"nextRandomTalks":[],"nextTalks":[],"npcId":[1001],"performCfg":"QuestDialogue/AQ/Mengde3_396/Q39607","priority":5,"questId":400,"showRandomTalkCount":0},"dialogs":[{"nodeId":3960701,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3596392219,"text":"ボクに聞きたいことがあったら、今聞いておくれ。ボクは吟遊詩人だからね、ずっと同じ場所には留まらないよ。","nextNodeIds":[3960702,3960707,3960715,3960727,3960741]},{"nodeId":3960702,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1803569907,"text":"トワリンについて…","nextNodeIds":[3960703]},{"nodeId":3960703,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":730349595,"text":"トワリン…彼は最後まで「四風守護」としての責任を忘れなかった。","nextNodeIds":[3960704]},{"nodeId":3960704,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":4026710923,"text":"だからボクは、彼からその責任を取っ払って、そしてボクの考える「自由」を彼に押し付けたくないんだ。","nextNodeIds":[3960705]},{"nodeId":3960705,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3432289667,"text":"——トワリン自身に、自由の意味を理解して、選んでほしい。","nextNodeIds":[3960706]},{"nodeId":3960706,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3722998899,"text":"だってボクも神になる前は、こうしてある友人に…「自由の意味」を教わったから。","nextNodeIds":[3960701]},{"nodeId":3960707,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2640600707,"text":"アビス教団について…","nextNodeIds":[3960708]},{"nodeId":3960708,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1185571347,"text":"うん？ガイアが言った情報か…","nextNodeIds":[3960709]},{"nodeId":3960709,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3970074139,"text":"#…なるほど、アビス教団の「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」という人が、トワリンの腐食を計画したんだね？","nextNodeIds":[3960710]},{"nodeId":3960710,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1199266715,"text":"#トワリンをアビス教団の戦いの道具にするつもりだったのかな。でも、アビス教団に「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」がいるなんて聞いたことがないね…","nextNodeIds":[3960711,3960712]},{"nodeId":3960711,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2110788811,"text":"教団の古参じゃないみたいだ。","nextNodeIds":[3960713]},{"nodeId":3960713,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3888698683,"text":"ボクもそうだと思う。","nextNodeIds":[3960714]},{"nodeId":3960714,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":4236300771,"text":"#でも、その最近になって出てきた「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」は、どうやってアビス教団を率いるポジションにまで上り詰めたんだろう…？","nextNodeIds":[3960701]},{"nodeId":3960712,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1054501763,"text":"教団の新入りなのかな…","nextNodeIds":[3960713]},{"nodeId":3960715,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":1300671659,"text":"「淑女」について…","nextNodeIds":[3960716]},{"nodeId":3960716,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2006769275,"text":"さっきのファデュイの執行官、「神の心」を手に入れたらすぐに撤退したな。","nextNodeIds":[3960717]},{"nodeId":3960717,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1088585123,"text":"それは「騎士団の目撃者」を作らないためだ。","nextNodeIds":[3960718]},{"nodeId":3960718,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":3635427251,"text":"だってこんなことをして証拠でも残してしまったら、西風騎士団との外交関係を断絶したと宣言したも同然だからね。","nextNodeIds":[3960719]},{"nodeId":3960719,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2455570363,"text":"こんなことをしたくせに、よくもモンドの盟友を続けてられるよな！？","nextNodeIds":[3960720]},{"nodeId":3960720,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":695540923,"text":"はぁ…アビス教団の脅威に対抗するために、七国の人々は同盟を結ぶべきだったのに。","nextNodeIds":[3960721]},{"nodeId":3960721,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":4105838515,"text":"「ファデュイ」は七国最強を誇る武力を持っている、それを天空のライアーの窃盗、神の力の強奪に使って、龍災に乗じて騎士団に圧をかけるなんて…","nextNodeIds":[3960722]},{"nodeId":3960722,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1124318651,"text":"あっ、「天空のライアー」といえば…あの時、ディルックの旦那もその名前を口にしてた気がする。","nextNodeIds":[3960723]},{"nodeId":3960723,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":1846024427,"text":"「ファデュイ」が七国を闊歩し、西風騎士団の脅威となったのは、この11人の執行官が原因だ、って言ったよな。","nextNodeIds":[3960724]},{"nodeId":3960724,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1256382931,"text":"そう、さっきボクが言ったように彼らは氷の神から権力を授かり、普通の人間を遥かに凌駕する力を手に入れた。","nextNodeIds":[3960725]},{"nodeId":3960725,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1534723843,"text":"「氷の女皇」…もう500年も会っていないな。彼女は一体何を考え、そして何を企んでいるのだろうか？","nextNodeIds":[3960726]},{"nodeId":3960726,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2302855531,"text":"今回の件の真相は、君の七神を探す旅に、未知の影響を与えるかもしれない…","nextNodeIds":[3960701]},{"nodeId":3960727,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4252629123,"text":"神について…","nextNodeIds":[3960728]},{"nodeId":3960728,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2501252283,"text":"さっきも言ったように、「神の目」の所有者は、この世界で「原神」と呼ばれ、天空の島に登る資格がある。","nextNodeIds":[3960729]},{"nodeId":3960729,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":4007426411,"text":"「神の心」はより上位の元素制御中枢で、七神の座を象徴するものだよ。","nextNodeIds":[3960730]},{"nodeId":3960730,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":491966179,"text":"#ごめんね、ボクも七神のうちの誰が君の{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTER]}をさらったか知らないんだ。","nextNodeIds":[3960731]},{"nodeId":3960731,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1419278691,"text":"あっ、そういえば、ボクも七神の一柱として、まだ自分の容疑を晴らせていない…！","nextNodeIds":[3960732,3960734]},{"nodeId":3960732,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":3955386723,"text":"ウェンティはあの神と全然違うよ。","nextNodeIds":[3960733]},{"nodeId":3960733,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3604264435,"text":"でも、「吟遊野郎」の姿は一つの化身だし、見た目で判断しちゃだめだぞ——","nextNodeIds":[3960734]},{"nodeId":3960734,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":227379563,"text":"長い付き合いだから、疑う必要はない。","nextNodeIds":[3960735]},{"nodeId":3960735,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2897361899,"text":"#あははっ、確かにボクたちいいコンビだったね。そうだ、君が{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTER]}を見つけたら、新しい「四風守護」になってみない？","nextNodeIds":[3960736]},{"nodeId":3960736,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":4143196571,"text":"それは…","nextNodeIds":[3960737]},{"nodeId":3960737,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":2388546563,"text":"#うん？{NICKNAME}、なんだか興味がないみたいだな？","nextNodeIds":[3960738]},{"nodeId":3960738,"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","textMapHash":3643865483,"text":"吟遊野郎！「四風守護」になれば、人から美味いお供え物が貰えるって言うなら…オイラがやってもいいぞ？","nextNodeIds":[3960739]},{"nodeId":3960739,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":2658548915,"text":"あっははは…","nextNodeIds":[3960701]},{"nodeId":3960741,"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","textMapHash":2301107483,"text":"もう大丈夫。","nextNodeIds":[3960742]},{"nodeId":3960742,"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","textMapHash":1507500963,"text":"じゃあ、早く<color=#00E1FFFF>璃月</color>に行くといい。今年の「迎仙儀式」を見逃したら、また1年待つことになるからね。","nextNodeIds":[]}]}],"conditions":{"finishCond":[{"BFGALAINLMD":0,"LNHLPKELCAL":[40001,0],"PAINLIBBLDK":"QUEST_CONTENT_FINISH_PLOT","PPFLKMOMKAI":""}],"triggerCond":[],"execActions":[],"guide":{"BEALNDJFMMC":"QUEST_GUIDE_IN_SCENE_STYLE_NONE","BJKFMDGPIBN":"QUEST_GUIDE_INDICATOR_STYLE_NONE","CCLPMCLNLBJ":"NONE","CJHEDKCIHPA":0,"EMAIGPLHEJH":"QUEST_GUIDE_LAYER_NONE","GGJOHCAJAPP":0,"HFNCMGLBNGO":"","IDLNFDCEJLG":"QUEST_GUIDE_AREA_STYLE_DEFAULT","KCFINIEBBBG":0,"KEDGDANLBHP":"","KNMAMMFJAOB":"QUEST_GUIDE_STYLE_NONE","LNHLPKELCAL":[],"NOCCOBOFKHP":0,"OFEBJNGBEPL":"QUEST_GUIDE_AUTO_NONE","PAINLIBBLDK":"QUEST_GUIDE_NONE"}}}],"unmappedTalks":[],"questNarration":[],"talkIds":[39607],"speakerCounts":[{"roleType":"TALK_ROLE_NPC","speakerId":1001,"speakerName":"ウェンティ","count":24},{"roleType":"TALK_ROLE_PLAYER","speakerId":null,"speakerName":"旅人","count":10},{"roleType":"TALK_ROLE_NPC","speakerId":1005,"speakerName":"パイモン","count":7}],"raw":{"ANDJNFLIDIJ":"PLAY_MODE_SINGLE","BEGCMMJKCFC":[],"BHCBFLFOGJN":0,"BPEIDGPCLGA":false,"CBBBCAKOFGO":1914682679,"CHECNJEMEFE":{},"CJPLOBIFHLG":"MAINQUEST_TAG_NONE","CMDGLJAOFOJ":[],"EPJHBBICPCA":false,"FBEFCEJCBIK":{},"FFOAGHNMJKJ":0,"FNFALGGACGA":"","FOKHPBAGMPB":"","GBFMDJLKJBF":[],"GMENNHMBBOH":[],"HCJHEADFCAO":0,"IBEGAHMEABP"